new file mode 100644
index 000000000..5f84d10e3
--- /dev/null
+++ b/tests/unit_tests/common/test_upstream_patches.py
@@ -0,0 +1,80 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""upstream_patches 的行为级验证：fs 读写锁跨 task 释放补丁。
+
+补丁目标 openjiuwen 是外部依赖。锁 bug 的完整触发条件是 agent 场景的
+**并发**文件访问（多协程对同一文件交替 acquire/release 时 filelock 按
+task 校验持锁才失配）——单进程顺序 read 往返（本测试形态）在补丁前后
+都通过，无法在本仓单测里复现「补丁前失败」。因此：
+
+- 本文件只验证补丁的**应用面**（幂等、应用后行为正常、上游已修自动跳过）；
+- 「补丁前问题如实暴露」由评测 session_health 统计覆盖（whl 原样环境
+  实测单例 9 次失败工具调用 vs 打补丁后 0 次，2026-11-02 smoke 对照）；
+- 上游修复落地后本补丁自动 no-op，补丁与本文件一并删除。
+"""
+from __future__ import annotations
+
+import asyncio
+import inspect
+from pathlib import Path
+
+from jiuwenswarm.common.upstream_patches import (
+    _patched,
+    patch_openjiuwen_rwlock_release,
+)
+
+
+def _lock_cls():
+    from openjiuwen.core.sys_operation.local._async_read_write_lock import (
+        HybridAsyncReadWriteLock,
+    )
+    return HybridAsyncReadWriteLock
+
+
+def _release_uses_create_task() -> bool:
+    """依赖当前的 _release_file 是否仍是 create_task 转发实现（上游未修）。"""
+    fn = _lock_cls()._release_file
+    return "create_task" in inspect.getsource(fn)
+
+
+def _read_roundtrip(lock_file: Path) -> str:
+    """跑一次完整的 read()：持锁 → 退出 → 释放。返回 'ok' 或错误摘要。"""
+    async def _run() -> str:
+        lock = _lock_cls()(lock_file)
+        try:
+            async with lock.read(timeout=5):
+                pass
+            return "ok"
+        except Exception as exc:  # noqa: BLE001 —— 错误摘要即断言素材
+            return f"{type(exc).__name__}: {str(exc)[:120]}"
+        finally:
+            await lock.close()
+
+    return asyncio.run(_run())
+
+
+def test_patch_is_idempotent() -> None:
+    patch_openjiuwen_rwlock_release()
+    patch_openjiuwen_rwlock_release()
+    assert "openjiuwen.rwlock_release" in _patched
+
+
+def test_read_release_after_patch_no_error(tmp_path: Path) -> None:
+    """补丁应用后，read() 退出时的文件锁释放必须在当前 task 完成（不再报错）。"""
+    patch_openjiuwen_rwlock_release()
+    assert _read_roundtrip(tmp_path / "rwlock-test.db") == "ok"
+
+
+def test_patch_noop_when_upstream_fixed(monkeypatch) -> None:
+    """上游已修（实现不再含 create_task）时补丁自动跳过，类不被替换。"""
+    cls = _lock_cls()
+    original = cls._release_file
+
+    async def _fixed_release(self: object) -> None:  # 上游修复形态
+        await self._file.release()  # type: ignore[attr-defined]
+
+    monkeypatch.setattr(cls, "_release_file", _fixed_release)
+    _patched.discard("openjiuwen.rwlock_release")  # 重置幂等标记以走判定分支
+    patch_openjiuwen_rwlock_release()
+    assert cls._release_file is _fixed_release  # 未被补丁替换
+    assert "openjiuwen.rwlock_release" in _patched  # 记为已处理（no-op）
+    monkeypatch.setattr(cls, "_release_file", original)  # 还原，不影响其他测试
