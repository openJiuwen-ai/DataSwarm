+# ---------------------------------------------------------------------------
+# digest.canonical_json / sha256_hex
+# ---------------------------------------------------------------------------
+
+class TestDigest:
+    def test_key_order_independence(self):
+        assert digest.canonical_json({"a": 1, "b": {"y": [1, 2], "x": None}}) == \
+               digest.canonical_json({"b": {"x": None, "y": [1, 2]}, "a": 1})
+
+    def test_unicode_and_compact(self):
+        s = digest.canonical_json({"k": "中文", "n": None})
+        # 紧凑分隔符（无空白）+ ensure_ascii=False（中文原样输出）
+        assert s == '{"k":"中文","n":null}'
+
+    def test_float_is_repr_text(self):
+        assert digest.canonical_json(0.1 + 0.2) == '"0.30000000000000004"'
+
+    def test_tuple_normalized_as_array(self):
+        assert digest.canonical_json((1, (2,))) == "[1,[2]]"
+
+    def test_noncontract_type_rejected(self):
+        with pytest.raises(TypeError):
+            digest.canonical_json({"t": datetime.now()})
+
+    def test_nan_inf_folded_not_crash(self):
+        assert "<invalid-float:" in digest.canonical_json(float("nan"))
+
+    def test_digest_short_length_and_stability(self):
+        a = digest.digest_obj({"x": [1, 2]})
+        b = digest.digest_obj({"x": [1, 2]})
+        assert a == b and len(a) == 16
+
