+def test_update_source_probe_uses_merged_config(monkeypatch, workspace_env):
+    """编辑时密码留空：探测拿到的 config 须含沿用旧密码（服务端合并后再探测）。"""
+    existing = {
+        "source_id": "edit_doris",
