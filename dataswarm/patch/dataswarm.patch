+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { PanelRightClose, Pencil } from 'lucide-react';
+import type { ScheduleType, WorkflowDefinition } from '../types/orchestration';
+import { orchestrationApi, type WorkflowInput } from '../api/orchestrationApi';
+import { useListQuery } from '../hooks/useListQuery';
+import { HifiButton, IconButton } from './shared/Hifi';
+import { Button, inputClass, toast } from './shared/Ui';
+import { CopyableId } from './WorkflowRunUi';
+import { WorkflowScheduleFields } from './WorkflowScheduleFields';
+
+type EditableField = 'name' | 'description' | 'schedule';
+
+function getScheduleTypeLabelKey(scheduleType: ScheduleType): string {
+  if (scheduleType === 'none') return 'dataAsset.wfForm.scheduleNone';
+  if (scheduleType === 'once') return 'dataAsset.wfForm.scheduleOnce';
+  return 'dataAsset.wfForm.scheduleCron';
+}
+
+function WorkflowFieldEditor({
+  field,
+  label,
+  workflow,
+  onCancel,
+  onSaved,
+}: {
+  field: EditableField;
+  label: string;
+  workflow: WorkflowDefinition;
+  onCancel: () => void;
+  onSaved: (workflow: WorkflowDefinition) => void;
+}) {
+  const { t } = useTranslation();
+  const [value, setValue] = useState(field === 'name' ? workflow.name : (workflow.description ?? ''));
+  const [scheduleType, setScheduleType] = useState<ScheduleType>(workflow.schedule_type);
+  const [cron, setCron] = useState(workflow.schedule_cron ?? '');
+  const [onceAt, setOnceAt] = useState(workflow.schedule_once_at ?? '');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const save = async () => {
+    if (busy) return;
+    if (field === 'name' && !value.trim()) {
+      setError(t('dataAsset.wfForm.nameRequired'));
+      return;
+    }
+    if (field === 'schedule') {
+      if (scheduleType === 'cron' && !cron.trim()) {
+        setError(t('dataAsset.wfForm.cronRequired'));
+        return;
+      }
+      if (scheduleType === 'once' && !onceAt.trim()) {
+        setError(t('dataAsset.wfForm.onceAtRequired'));
+        return;
+      }
+    }
+    const input: WorkflowInput =
+      field === 'schedule'
+        ? {
+            schedule_type: scheduleType,
+            schedule_cron: scheduleType === 'cron' ? cron.trim() : '',
+            schedule_once_at: scheduleType === 'once' ? onceAt.trim() : '',
+          }
+        : { [field]: value.trim() };
+    setError(null);
+    setBusy(true);
+    try {
+      const updated = await orchestrationApi.updateWorkflow(workflow.workflow_id, input);
+      onSaved(updated);
+      toast.success(t('dataAsset.wfForm.updated', { name: updated.name }));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <form
+      className="dd-inline-editor"
+      aria-label={label}
+      aria-busy={busy}
+      onSubmit={(event) => {
+        event.preventDefault();
+        void save();
+      }}
+      onKeyDown={(event) => {
+        if (event.key === 'Escape' && !event.nativeEvent.isComposing) {
+          event.preventDefault();
+          event.stopPropagation();
+          if (!busy) onCancel();
+        }
+      }}
+    >
+      <fieldset disabled={busy}>
+        {field === 'schedule' ? (
+          <WorkflowScheduleFields
+            scheduleType={scheduleType}
+            cron={cron}
+            onceAt={onceAt}
+            onScheduleTypeChange={setScheduleType}
+            onCronChange={setCron}
+            onOnceAtChange={setOnceAt}
+            autoFocus
+          />
+        ) : field === 'name' ? (
+          <input
+            className={inputClass}
+            aria-label={label}
+            value={value}
+            onChange={(event) => setValue(event.target.value)}
+            placeholder={t('dataAsset.wfForm.namePlaceholder')}
+            autoFocus
+          />
+        ) : (
+          <textarea
+            className={inputClass}
+            aria-label={label}
+            value={value}
+            onChange={(event) => setValue(event.target.value)}
+            placeholder={t('dataAsset.wfForm.descriptionPlaceholder')}
+            rows={4}
+            autoFocus
+          />
+        )}
+      </fieldset>
+      {error && (
+        <div role="alert" className="dd-error">
+          {error}
+        </div>
+      )}
+      <div className="dd-inline-editor-actions">
+        <button type="submit" className="da-btn da-btn-primary" disabled={busy} aria-busy={busy}>
+          {busy && <span className="da-link-spinner" aria-hidden="true" />}
+          {t('common.save')}
+        </button>
+        <HifiButton variant="default" disabled={busy} onClick={onCancel}>
+          {t('common.cancel')}
+        </HifiButton>
+      </div>
+    </form>
+  );
+}
+
+export function WorkflowDetails({
+  workflow,
+  nodeCount,
+  onCollapse,
+  onUpdated,
+}: {
+  workflow: WorkflowDefinition;
+  nodeCount: number;
+  onCollapse: () => void;
+  onUpdated: (workflow: WorkflowDefinition) => void;
+}) {
+  const { t } = useTranslation();
+  const [editing, setEditing] = useState<EditableField | null>(null);
+  const lastEdited = useRef<EditableField | null>(null);
+  const editButtons = useRef<Partial<Record<EditableField, HTMLButtonElement | null>>>({});
+  useEffect(() => {
+    if (!editing && lastEdited.current) editButtons.current[lastEdited.current]?.focus();
+  }, [editing]);
+  const labels = {
+    name: t('dataAsset.wfForm.name'),
+    description: t('dataAsset.development.description'),
+    schedule: t('dataAsset.development.scheduleSettings'),
+  };
+  const editButton = (field: EditableField) => (
+    <button
+      ref={(button) => {
+        editButtons.current[field] = button;
+      }}
+      type="button"
+      className="da-icon-btn dd-field-edit"
+      title={t('dataAsset.wfForm.editField', { field: labels[field] })}
+      aria-label={t('dataAsset.wfForm.editField', { field: labels[field] })}
+      disabled={editing !== null}
+      onClick={() => {
+        lastEdited.current = field;
+        setEditing(field);
+      }}
+    >
+      <Pencil size={14} />
+    </button>
+  );
+  const editor = (field: EditableField) => (
+    <WorkflowFieldEditor
+      field={field}
+      label={labels[field]}
+      workflow={workflow}
+      onCancel={() => setEditing(null)}
+      onSaved={(updated) => {
+        onUpdated(updated);
+        setEditing(null);
+      }}
+    />
+  );
+  const load = useCallback(async () => {
+    const result = await orchestrationApi.listInstances({
+      ref_type: 'workflow',
+      ref_id: workflow.workflow_id,
+      limit: 1,
+      offset: 0,
+    });
+    return { items: [], total: result.total };
+  }, [workflow.workflow_id]);
+  const count = useListQuery(load);
+  let runCount: string | number = '—';
+  if (count.hasLoaded) runCount = count.total;
+  else if (count.loading) runCount = t('common.loading');
+  return (
+    <aside className="dd-side-panel" aria-label={t('dataAsset.development.workflowDetails')}>
+      <header className="dd-panel-header">
+        <h2>{t('dataAsset.development.workflowDetails')}</h2>
+        <IconButton title={t('dataAsset.development.collapseDetails')} onClick={onCollapse}>
+          <PanelRightClose size={18} />
+        </IconButton>
+      </header>
+      <div className="dd-panel-body">
+        <h3>{t('dataAsset.development.basicInfo')}</h3>
+        <dl className="dd-detail-fields">
+          <div>
+            <dt>{t('dataAsset.wfForm.name')}</dt>
+            <dd>
+              {editing === 'name' ? (
+                editor('name')
+              ) : (
+                <div className="dd-editable-field">
+                  {workflow.name}
+                  {editButton('name')}
+                </div>
+              )}
+            </dd>
+          </div>
+          <div>
+            <dt>{t('dataAsset.development.workflowId')}</dt>
+            <dd>
+              <CopyableId value={workflow.workflow_id} />
+            </dd>
+          </div>
+          <div>
+            <dt>{t('dataAsset.development.owner')}</dt>
+            <dd>{workflow.owner || '—'}</dd>
+          </div>
+          <div>
+            <dt>{t('dataAsset.development.description')}</dt>
+            <dd>
+              {editing === 'description' ? (
+                editor('description')
+              ) : (
+                <div className="dd-editable-field">
+                  {workflow.description || '—'}
+                  {editButton('description')}
+                </div>
+              )}
+            </dd>
+          </div>
+        </dl>
+        <div className="dd-section-label">
+          <h3>{t('dataAsset.development.scheduleSettings')}</h3>
+          {editing !== 'schedule' && editButton('schedule')}
+        </div>
+        {editing === 'schedule' ? (
+          editor('schedule')
+        ) : (
+          <dl className="dd-detail-fields">
+            <div>
+              <dt>{t('dataAsset.development.scheduleType')}</dt>
+              <dd>{t(getScheduleTypeLabelKey(workflow.schedule_type))}</dd>
+            </div>
+            {workflow.schedule_type !== 'none' && (
+              <div>
+                <dt>
+                  {t(
+                    workflow.schedule_type === 'once'
+                      ? 'dataAsset.development.scheduledAt'
+                      : 'dataAsset.development.cron',
+                  )}
+                </dt>
+                <dd>{workflow.schedule_type === 'once' ? workflow.schedule_once_at : workflow.schedule_cron}</dd>
+              </div>
+            )}
+          </dl>
+        )}
+        <h3>{t('dataAsset.development.executionInfo')}</h3>
+        <dl className="dd-detail-fields">
+          <div>
+            <dt>{t('dataAsset.development.nodes')}</dt>
+            <dd>{nodeCount}</dd>
+          </div>
+          <div>
+            <dt>{t('dataAsset.wfList.runHistory')}</dt>
+            <dd>{runCount}</dd>
+          </div>
+        </dl>
+        {count.error && (
+          <div role="alert" className="dd-error">
+            {count.error}
+            <Button onClick={() => void count.reload()}>{t('common.retry')}</Button>
+          </div>
+        )}
+      </div>
+    </aside>
+  );
+}
