index 000000000..d4ceea10f
--- /dev/null
+++ b/tests/unit_tests/web/test_metric_term_binding.py
@@ -0,0 +1,382 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""指标 ↔ 术语绑定两条链路单测（界面绑定 + Ossie 导入解析）。
+
+目标是让分析侧漏斗的条件④（术语链到唯一 published 指标）真正有燃料，
+所以最后一组是**端到端**：绑定落库 → 分析侧图补全（元数据推导路）拿到
+term → metric 链 → 短路判定 eligible。
+
+设计：``docs/archive/delivered/data-analysis-flow-shortcut-design.md`` + 本轮绑定链路补充。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.glossary import db as glossary_db
+from jiuwenswarm.channels.web.dataagent.metrics import api_v2, graph_projection, store, versioning
+from jiuwenswarm.channels.web.dataagent.metrics.errors import DefinitionError, MetricNotFound
+from jiuwenswarm.channels.web.dataagent.metrics.model import MAP_CANDIDATE, MAP_CONFIRMED
+from tests.unit_tests.web.conftest import WORKSPACE
+
+PREFIX = "/api/dataagent/metrics/v2"
+GMV = "commerce.gmv"
+
+
+# ==========================================================================
+# 夹具
+# ==========================================================================
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, _length):
+        return self._data
+
+
+class FakeHandler:
+    """最小 handler 面（照 test_metrics_v2_api.py 的模式）。"""
+
+    def __init__(self, path: str, body: dict | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        self.headers = {"Content-Length": str(len(json.dumps(body))) if body else "0"}
+        self.rfile = _FakeRfile(json.dumps(body).encode() if body else b"")
+        self.status = None
+        self.payload = None
+
+    def _write_json(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+    def _query_arg(self, parsed, name):
+        return {k: v[0] for k, v in parse_qs(parsed.query).items()}.get(name)
+
+
+@pytest.fixture()
+def bound(e2e):
+    """e2e 环境 + 导入演示指标 + 一个真实术语。
+
+    指标走 Ossie 导入（当前唯一的建模入口），**不发布**——绑定要能在
+    「已导入未发布」状态下工作，这是建模流程里最常见的顺序。
+    """
+    from tests.unit_tests.web.conftest import OSSIE_EXAMPLE
+
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE,
+        datasource_resolver=lambda alias: e2e["business_ref"])
+    term = glossary_db.create_term({
+        "name": "商品交易总额", "definition": "∑订单实付金额（排除取消单）",
+        "synonyms": ["GMV", "成交额"],
+    })
+    return {"term": term, "e2e": e2e}
+
+
+def _term_id(bound) -> str:
+    return bound["term"]["term_id"]
+
+
+# ==========================================================================
+# 链路一：界面绑定（term_id 引用 + 直接 confirmed）
+# ==========================================================================
+
+def test_bind_term_creates_confirmed_mapping(bound):
+    """人点选即确认——不需要第二轮 confirm，且 target_ref 存 term_id。"""
+    result = versioning.bind_term(WORKSPACE, GMV, _term_id(bound), bound_by="alice")
+    assert result["created"] is True
+    mapping = result["mapping"]
+    assert mapping["relation_type"] == "measuresConcept"
+    assert mapping["target_ref"] == _term_id(bound)      # 不是自由文本
+    assert mapping["status"] == MAP_CONFIRMED
+    assert mapping["confirmed_by"] == "alice"
+    assert result["warnings"] == []
+
+
+def test_bind_term_idempotent(bound):
+    """重复绑定不重复建行（同组视为更新）。"""
+    first = versioning.bind_term(WORKSPACE, GMV, _term_id(bound))
+    second = versioning.bind_term(WORKSPACE, GMV, _term_id(bound))
+    assert first["created"] is True and second["created"] is False
+    revision = versioning._target_revision(WORKSPACE, GMV)
+    mine = [m for m in store.list_concept_maps(revision.revision_id)
+            if m.relation_type == "measuresConcept" and m.target_ref == _term_id(bound)]
+    assert len(mine) == 1
+
+
+def test_bind_term_rejects_unknown_and_deprecated(bound):
+    with pytest.raises(DefinitionError, match="不存在"):
+        versioning.bind_term(WORKSPACE, GMV, "term-does-not-exist")
+
+    deprecated = glossary_db.create_term({"name": "旧口径", "definition": "废弃"})
+    glossary_db.delete_term(deprecated["term_id"])      # 软删 → status=deprecated
+    with pytest.raises(DefinitionError, match="已废弃"):
+        versioning.bind_term(WORKSPACE, GMV, deprecated["term_id"])
+
+
+def test_bind_term_unknown_metric(bound):
+    with pytest.raises(MetricNotFound):
+        versioning.bind_term(WORKSPACE, "no.such.metric", "t1")
+
+
+def test_bind_term_warns_on_multi_metric(bound):
+    """一个术语绑多个指标 → 提示分析无法直达（不阻断）。"""
+    versioning.bind_term(WORKSPACE, GMV, _term_id(bound))
+    other = store.list_defs(WORKSPACE)
+    second_key = next(d.metric_key for d in other if d.metric_key != GMV)
+    result = versioning.bind_term(WORKSPACE, second_key, _term_id(bound))
+    assert any("term_multi_metric" in w for w in result["warnings"])
+
+
+def test_unbind_term_idempotent(bound):
+    versioning.bind_term(WORKSPACE, GMV, _term_id(bound))
+    assert versioning.unbind_term(WORKSPACE, GMV, _term_id(bound))["removed"] is True
+    assert versioning.unbind_term(WORKSPACE, GMV, _term_id(bound))["removed"] is False
+
+
+def test_list_terms_of_marks_resolved(bound):
+    versioning.bind_term(WORKSPACE, GMV, _term_id(bound))
+    listed = versioning.list_terms_of(WORKSPACE, GMV)
+    mine = [t for t in listed["terms"] if t["term_id"] == _term_id(bound)]
+    assert len(mine) == 1
+    assert mine[0]["resolved"] is True
+    assert mine[0]["name"] == "商品交易总额"
+    assert mine[0]["status"] == MAP_CONFIRMED
+
+
+def test_list_terms_of_unresolved_free_text(bound):
+    """历史 Ossie 自由文本引用解析不到 → resolved=False（图上连不出 Term 边）。"""
+    revision = versioning._target_revision(WORKSPACE, GMV)
+    store.create_concept_map(store.ConceptMapping(
+        mapping_id=store.new_id("map"), workspace_id=WORKSPACE,
+        revision_id=revision.revision_id, relation_type="measuresConcept",
+        target_ref="urn:ossie:concept/unknown", status=MAP_CANDIDATE,
+        evidence="ossie:subject_iri"))
+    entries = versioning.list_terms_of(WORKSPACE, GMV)["terms"]
+    unresolved = [e for e in entries if e["target_ref"] == "urn:ossie:concept/unknown"]
+    assert unresolved and unresolved[0]["resolved"] is False
+
+
+# ==========================================================================
+# 引用解析（两种形态一份实现）
+# ==========================================================================
+
+def test_resolve_term_by_id_and_by_name(bound):
+    term_id = _term_id(bound)
+    assert graph_projection.resolve_term(term_id)["term_id"] == term_id        # term_id 直查
+    assert graph_projection.resolve_term("商品交易总额")["term_id"] == term_id   # 名字全等
+    assert graph_projection.resolve_term("GMV")["term_id"] == term_id          # 别名全等
+    assert graph_projection.resolve_term("近似的名字") is None                  # 不做模糊
+    assert graph_projection.resolve_term("") is None
+
+
+def test_glossary_term_node_id_matches_write_side_format(bound):
+    """投影侧节点 ID 必须与 glossary 写侧/分析读侧同格式，否则图上连不上。"""
+    node_id = graph_projection._glossary_term_node_id(WORKSPACE, _term_id(bound))
+    assert node_id == f"term:{WORKSPACE}:{_term_id(bound)}"
+
+
+# ==========================================================================
+# 链路二：Ossie 导入（写侧解析 + 修订继承）
+# ==========================================================================
+
+def test_import_resolves_concept_to_term_id(bound, monkeypatch):
+    """导入时自由文本 → term_id；解析不到的进 unresolved_concepts 让人看见。
+
+    状态仍是 candidate——机器从自由文本猜的，绝不自动确认。
+    """
+    from jiuwenswarm.channels.web.dataagent.metrics import ossie as ossie_mod
+    from tests.unit_tests.web.conftest import OSSIE_EXAMPLE
+
+    def _fake_candidates(model, workspace_id, by_key):
+        revision_id = next(iter(by_key.values())).revision_id
+        return [
+            store.ConceptMapping(
+                mapping_id=store.new_id("map"), workspace_id=workspace_id,
+                revision_id=revision_id, relation_type="measuresConcept",
+                target_ref="商品交易总额", status=MAP_CANDIDATE,
+                evidence="ossie:subject_iri"),
+            store.ConceptMapping(
+                mapping_id=store.new_id("map"), workspace_id=workspace_id,
+                revision_id=revision_id, relation_type="measuresConcept",
+                target_ref="urn:ossie:concept/nope", status=MAP_CANDIDATE,
+                evidence="ossie:subject_iri"),
+        ]
+
+    monkeypatch.setattr(ossie_mod, "candidate_mappings", _fake_candidates)
+    outcome = versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE,
+        datasource_resolver=lambda alias: bound["e2e"]["business_ref"])
+
+    assert outcome["unresolved_concepts"] == ["urn:ossie:concept/nope"]
+    stored = []
+    for metric in store.list_defs(WORKSPACE):
+        for revision in store.list_revisions(metric.metric_id):
+            stored.extend(m for m in store.list_concept_maps(revision.revision_id)
+                          if m.relation_type == "measuresConcept")
+    resolved = [m for m in stored if m.target_ref == _term_id(bound)]
+    assert resolved, "自由文本应被解析成 term_id 存库"
+    assert resolved[0].status == MAP_CANDIDATE          # 不自动确认
+    assert "解析到术语" in resolved[0].evidence
+    unresolved = [m for m in stored if m.target_ref == "urn:ossie:concept/nope"]
+    assert unresolved and "unresolved" in unresolved[0].evidence
+
+
+def test_carry_over_confirmed_term_map_to_new_revision(bound):
+    """口径改了是新修订——已确认的术语绑定必须继承，否则静默丢绑定。"""
+    versioning.bind_term(WORKSPACE, GMV, _term_id(bound), bound_by="alice")
+    old_revision = versioning._target_revision(WORKSPACE, GMV).revision_id
+
+    carried = versioning._carry_over_term_maps(WORKSPACE, GMV, "rev-new-001")
+    assert len(carried) == 1
+    copied = store.get_concept_map(carried[0])
+    assert copied.revision_id == "rev-new-001"
+    assert copied.target_ref == _term_id(bound)
+    assert copied.status == MAP_CONFIRMED            # 继承后仍是确认态
+    assert "继承" in copied.evidence
+    # 原修订的绑定不动
+    assert store.find_concept_map(old_revision, "measuresConcept", _term_id(bound)) is not None
+
+
+def test_carry_over_is_idempotent(bound):
+    versioning.bind_term(WORKSPACE, GMV, _term_id(bound))
+    versioning._carry_over_term_maps(WORKSPACE, GMV, "rev-new-002")
+    assert versioning._carry_over_term_maps(WORKSPACE, GMV, "rev-new-002") == []
+
+
+# ==========================================================================
+# API 端点
+# ==========================================================================
+
+def test_api_bind_unbind_and_list(bound):
+    term_id = _term_id(bound)
+    handler = FakeHandler(f"{PREFIX}/metrics/{GMV}/terms",
+                          {"term_id": term_id, "bound_by": "alice"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.status == 200
+    assert handler.payload["mapping"]["status"] == MAP_CONFIRMED
+    assert handler.payload["term"]["name"] == "商品交易总额"
+
+    handler = FakeHandler(f"{PREFIX}/metrics/{GMV}/terms")
+    api_v2.handle_get(handler, handler.parsed)
+    assert handler.status == 200
+    assert term_id in [t["term_id"] for t in handler.payload["terms"]]
+
+    handler = FakeHandler(f"{PREFIX}/metrics/{GMV}/terms",
+                          {"term_id": term_id, "action": "unbind"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.status == 200 and handler.payload["removed"] is True
+
+
+def test_api_bind_requires_term_id(bound):
+    handler = FakeHandler(f"{PREFIX}/metrics/{GMV}/terms", {"bound_by": "alice"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.status == 400 and "term_id" in handler.payload["detail"]
+
+
+def test_api_bind_unknown_term_maps_to_4xx(bound):
+    handler = FakeHandler(f"{PREFIX}/metrics/{GMV}/terms", {"term_id": "nope"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert 400 <= handler.status < 500
+
+
+# ==========================================================================
+# 端到端：绑定 → 分析侧漏斗条件④通过（本轮工作的目标）
+# ==========================================================================
+
+def test_binding_feeds_analysis_shortcut(bound, monkeypatch):
+    """绑定 + 发布后，分析侧（元数据推导路）拿到 term→metric 链 → 短路 eligible。
+
+    不依赖 Neo4j：推导路直接读 concept_map，所以不必等重投影；但**只认已
+    发布修订**（分析口径必须是 published），所以绑定后要 publish。
+    """
+    from jiuwenswarm.channels.web.dataagent.analysis import graph_expand, shortcut
+    from jiuwenswarm.channels.web.dataagent.analysis.model import RecallHit, RoadResult
+
+    versioning.bind_term(WORKSPACE, GMV, _term_id(bound), bound_by="alice")
+    revision = versioning._target_revision(WORKSPACE, GMV)
+    versioning.publish_release(
+        WORKSPACE, [revision.revision_id], label="t1",
+        require_binding_verified=False)
+
+    # 图不可用 → 元数据推导路接管（一等回退）
+    monkeypatch.setattr(graph_expand, "from_environment",
+                        lambda: (_ for _ in ()).throw(RuntimeError("neo4j down")))
+
+    term_hit = RecallHit(
+        kind="term", entity_id=_term_id(bound), label="商品交易总额",
+        channels=[("lexical", 0.9)], matched_on=["alias"], rrf_score=1 / 61,
+        payload={"term_id": _term_id(bound), "name": "商品交易总额",
+                 "definition": "∑订单实付金额（排除取消单）", "synonyms": ["GMV"]})
+    term_road = RoadResult("term", (term_hit,), "ok", raw_count=1)
+
+    expansion = graph_expand.expand({"terms": term_road}, WORKSPACE, {})
+    assert expansion.graph_path == "metadata_fallback"
+    assert GMV in [hit.entity_id for hit in expansion.metrics], \
+        "绑定+发布后推导路应给出 term→metric 链"
+
+    verdict = shortcut.term_shortcut_verdict(term_road, expansion)
+    assert verdict.eligible is True, f"条件未过: {verdict.reasons}"
+    assert verdict.metric_hit.entity_id == GMV
+    assert verdict.term["name"] == "商品交易总额"
+
+
+def test_unbound_term_is_gap_term(bound, monkeypatch):
+    """没绑定时该术语进 gap_terms（出口·提示建模的依据）。"""
+    from jiuwenswarm.channels.web.dataagent.analysis import graph_expand, shortcut
+    from jiuwenswarm.channels.web.dataagent.analysis.model import RecallHit, RoadResult
+
+    monkeypatch.setattr(graph_expand, "from_environment",
+                        lambda: (_ for _ in ()).throw(RuntimeError("neo4j down")))
+    term_hit = RecallHit(
+        kind="term", entity_id=_term_id(bound), label="商品交易总额",
+        channels=[("lexical", 0.9)], matched_on=["alias"], rrf_score=1 / 61,
+        payload={"term_id": _term_id(bound), "name": "商品交易总额",
+                 "definition": "∑订单实付金额", "synonyms": []})
+    term_road = RoadResult("term", (term_hit,), "ok", raw_count=1)
+    expansion = graph_expand.expand({"terms": term_road}, WORKSPACE, {})
+
+    verdict = shortcut.term_shortcut_verdict(term_road, expansion)
+    assert verdict.eligible is False
+    assert shortcut.REASON_NO_LINK in verdict.reasons
+    gaps = shortcut.gap_terms(term_road, expansion)
+    assert [g["name"] for g in gaps] == ["商品交易总额"]
+
+
+# ==========================================================================
+# 发布时继承（闭「绑定后又发布新修订」的顺序漏洞）
+# ==========================================================================
+
+def test_publish_carries_binding_from_previous_revision(bound):
+    """已发布 rev1 → 绑定（落 rev1）→ 发布新修订 rev2：rev2 必须继承到绑定。
+
+    这是用户实测踩到的断链：界面读 rev1 仍显示「已绑定」，但分析侧看
+    current=rev2 没有绑定 → no_published_metric_link。
+    """
+    from dataclasses import replace as dc_replace
+
+    term_id = _term_id(bound)
+    rev1 = versioning._target_revision(WORKSPACE, GMV)
+    versioning.publish_release(WORKSPACE, [rev1.revision_id], label="v1",
+                               require_binding_verified=False)
+    versioning.bind_term(WORKSPACE, GMV, term_id, bound_by="alice")
+    assert store.find_concept_map(rev1.revision_id, "measuresConcept", term_id) is not None
+
+    # 新口径修订（模拟重导入产生的新版本），绑定**不在**它身上
+    rev2 = dc_replace(rev1, revision_id="rev-gmv-002", revision_no=rev1.revision_no + 1,
+                      status="candidate", definition_hash="hash-002",
+                      definition_ref=f"{rev1.definition_ref}+1")
+    store.create_revision(rev2)
+    assert store.find_concept_map("rev-gmv-002", "measuresConcept", term_id) is None
+
+    versioning.publish_release(WORKSPACE, ["rev-gmv-002"], label="v2",
+                               require_binding_verified=False)
+    carried = store.find_concept_map("rev-gmv-002", "measuresConcept", term_id)
+    assert carried is not None, "发布时应从上一修订继承术语绑定"
+    assert carried.status == MAP_CONFIRMED
+
+    # 链在分析侧仍然通（current 已指向 rev2）
+    listed = versioning.list_terms_of(WORKSPACE, GMV)
+    assert listed["revision_id"] == "rev-gmv-002"
+    assert term_id in [t["term_id"] for t in listed["terms"]]
