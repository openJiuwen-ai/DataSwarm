+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Expanded source catalog search must not execute MySQL metadata SQL."""
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.databases import service
+from jiuwenswarm.channels.web.dataagent.datasource import registry, store
+from jiuwenswarm.common import db_connector
+
+
+@pytest.mark.parametrize(
+    "scheme", ["postgresql", "hologres", "sqlserver", "mongodb", "redis", "hbase", "ddl", "duckdb"]
+)
+def test_expanded_sources_search_their_catalog_without_querying(monkeypatch, scheme):
+    ref = f"{scheme}://catalog-test"
+    seen = []
+
+    def tables(actual):
+        seen.append(actual)
+        return {"tables": ["public.Orders", "public.order_items", "public.customers"]}
+    monkeypatch.setattr(db_connector, "tables", tables)
+    monkeypatch.setattr(
+        db_connector, "query", lambda *args, **kwargs: pytest.fail("catalog search must not execute SQL")
+    )
+    result = service.search_tables(ref, "ORDER", top_k=1)
+    assert result["ok"] is True
+    assert result["results"] == [{"table_name": "public.Orders"}]
+    assert seen == [ref]
+    assert service.search_tables(ref, "ORDER", top_k=0)["results"] == []
+
+
+def test_saved_ddl_can_be_searched_without_data_query(tmp_path, monkeypatch):
+    meta = f"sqlite://{tmp_path / 'meta.db'}"
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", meta)
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    config = {
+        "ddl_text": "CREATE TABLE Orders (id INT PRIMARY KEY); CREATE TABLE Customers (id INT);",
+        "dialect": "postgres",
+    }
+    ref = registry.get_source_type("ddl").build_ref(config)
+    try:
+        store.insert_source("search-ddl", "ddl", "search", config, ref)
+        result = service.search_tables(ref, "order")
+        assert result["ok"] is True
+        assert result["results"] == [{"table_name": "Orders"}]
+        assert service.search_tables(ref, "' OR 1=1 --")["results"] == []
+    finally:
+        db_connector._invalidate(meta, read_only=True)
+        db_connector._invalidate(meta, read_only=False)
+
+
+def test_expanded_catalog_failures_are_reported(monkeypatch):
+    def fail(ref):
+        raise RuntimeError("catalog unavailable")
+    monkeypatch.setattr(db_connector, "tables", fail)
+    assert service.search_tables("redis://h:6379/0", "order") == {
+        "ok": False, "error": "catalog unavailable", "query": "order", "db_ref": "redis://h:6379/0",
+    }
