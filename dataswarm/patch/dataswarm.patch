index 000000000..577c00312
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/analysis/execute.py
@@ -0,0 +1,295 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/execute.py —— L3 统一执行前 guard 组合 + 执行委托。
+
+guard 顺序（方案 L3③）：撤销状态 → 只读单语句 → 授权 → 结构兼容复验 →
+行数上限，全过才委托 ``sql/service.run_sql``（source_id 通道自带 workspace
+校验与截断 envelope）。CSV 落盘由编排层脚本完成（服务端不产文件）。
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+import sqlglot
+
+from jiuwenswarm.common import workspace_context
+from jiuwenswarm.common.dialect_registry import sqlglot_dialect
+
+from ..connectors.sql_guard import validate_read_only_sql
+from ..metrics.guard import out_of_scope_tables
+from ..sql import service as sql_service
+from .checks import temp_scope_tables_of, uses_temp_scope
+from .model import (
+    CHECK_FAIL,
+    CHECK_PASS,
+    GROUNDING_G1,
+    GROUNDING_G2,
+    GROUNDING_G3,
+    NON_AUTHORITY_NO_PROVIDER,
+    CheckResult,
+)
+
+logger = logging.getLogger(__name__)
+
+# 执行行数上限（方案：执行器另设超时、行数与成本上限）
+DEFAULT_EXECUTE_LIMIT = 500
+MAX_EXECUTE_LIMIT = 5000
+
+
+def execute_request(body: dict[str, Any]) -> dict[str, Any]:
+    """统一执行（execute 端点入口）。
+
+    Args:
+        body: ``{"analysis_id"?, "component_id"?, "sql", "source_id"?,
+        "db_ref"?, "selected"?[{metric_key}], "temp_scope"?, "limit"?}``；
+        或编译产物通道 ``{"compile_query_id", "sql_template", "params",
+        "selected", ...}``（compile 端点产出——服务端按追溯记录验证并重导出
+        可执行 SQL，客户端不提交可执行文本）。
+
+    Returns:
+        ``{"ok", "rows", "columns", "row_count", "truncated", "elapsed_ms",
+        "db_ref", "grounding_level", "non_authoritative_reasons", "guard"}``——
+        guard 失败时 ``ok=False`` 且带 ``guard`` 明细（不再执行）；编译产物
+        通道验证通过时产物标 ``authoritative=true`` / ``grounding_level=G1``。
+        临时 scope 查询成功时附 ``semantic_collection``，返回回流任务或跳过原因。
+    """
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    compile_query_id = str(body.get("compile_query_id") or "")
+    sql_template = str(body.get("sql_template") or "")
+    compiled_channel = bool(compile_query_id or sql_template)
+    if compiled_channel:
+        if not (compile_query_id and sql_template):
+            raise ValueError("compile_query_id 与 sql_template 必须成对提供")
+        verify_detail = _verify_compile_record(
+            workspace_id, compile_query_id, sql_template)
+        if verify_detail is not None:
+            return _blocked(sql_template, [
+                CheckResult("compile_record", CHECK_FAIL, verify_detail).to_dict()])
+        from ..metrics import service as metric_service
+
+        sql = metric_service.inline_params(
+            sql_template, tuple(body.get("params") or ()))
+    else:
+        sql = str(body.get("sql") or "").strip()
+        if not sql:
+            raise ValueError("sql 不能为空")
+    limit = max(1, min(int(body.get("limit") or DEFAULT_EXECUTE_LIMIT), MAX_EXECUTE_LIMIT))
+    source_id = str(body.get("source_id") or "")
+    db_ref = str(body.get("db_ref") or "")
+
+    guard: list[dict[str, str]] = []
+
+    # ---- guard 1：撤销状态（选定指标任一非 published → 拒绝执行）----
+    revoked = _revoked_selected(workspace_id, body.get("selected") or ())
+    if revoked:
+        guard.append(CheckResult(
+            "revocation", CHECK_FAIL,
+            f"指标 {revoked} 已撤销或非 published——撤销立即阻断新执行").to_dict())
+        return _blocked(sql, guard)
+    guard.append(CheckResult("revocation", CHECK_PASS, "").to_dict())
+
+    # ---- guard 2：只读单语句 ----
+    source_type = _source_type_of(source_id, db_ref)
+    try:
+        validate_read_only_sql(sql, source_type=source_type)
+        guard.append(CheckResult("read_only", CHECK_PASS, "").to_dict())
+    except Exception as exc:  # noqa: BLE001 —— QueryValidationError 等，统一挡下
+        guard.append(CheckResult("read_only", CHECK_FAIL, str(exc)).to_dict())
+        return _blocked(sql, guard)
+
+    # ---- guard 3：授权（source → db_ref 必须归属当前 workspace）----
+    if _authorized_ref(workspace_id, source_id, db_ref) is None:
+        guard.append(CheckResult(
+            "authorization", CHECK_FAIL,
+            f"数据源 {source_id or db_ref} 不在当前工作空间授权范围内").to_dict())
+        return _blocked(sql, guard)
+    guard.append(CheckResult("authorization", CHECK_PASS, "").to_dict())
+
+    # ---- guard 4：结构兼容复验（引用对象 ⊆ 当前快照 ∪ 临时 scope）----
+    scope_detail = _structure_compatible(sql, body.get("temp_scope") or {}, source_type=source_type)
+    if scope_detail is not None:
+        guard.append(CheckResult("structure_compatibility", CHECK_FAIL, scope_detail).to_dict())
+        return _blocked(sql, guard)
+    guard.append(CheckResult("structure_compatibility", CHECK_PASS, "").to_dict())
+
+    # ---- 委托统一执行通道 ----
+    result = sql_service.run_sql(
+        db_ref or None, sql, limit=limit,
+        workspace_id=workspace_id, source_id=source_id or None)
+    result.setdefault("ok", False)
+    result["analysis_id"] = str(body.get("analysis_id") or "")
+    result["component_id"] = str(body.get("component_id") or "")
+    result["guard"] = guard
+    if compiled_channel:
+        # 编译产物：构造即正确（compiler 当第一个 Provider）——G1 + 权威，
+        # 免六项口径检查；guard（撤销/只读/授权/结构）照常复验
+        result["grounding_level"] = GROUNDING_G1
+        result["definition_grounded"] = True
+        result["query_semantics_verified"] = True
+        result["authoritative"] = True
+        result["non_authoritative_reasons"] = []
+        return result
+    # 产物标注（LLM 生成路径 P0 全部非权威）：引用了临时 scope 对象 → G3；
+    # 否则按快照归属 G2（G1 资格由 check 端点判定——execute 不重复六项口径检查）
+    temp_tables = temp_scope_tables_of(body.get("temp_scope"))
+    uses_temp = _uses_temp_scope(sql, temp_tables, source_type=source_type)
+    selected = body.get("selected") or []
+    reasons = [NON_AUTHORITY_NO_PROVIDER]
+    if uses_temp:
+        reasons.append("temporary_scope")
+    result["grounding_level"] = GROUNDING_G3 if uses_temp else GROUNDING_G2
+    result["non_authoritative_reasons"] = reasons
+    # G1 资格：带 selected 且未用临时 scope 时重跑程序化推导（sqlglot 毫秒级）——
+    # 修复 check=G1 但 execute 降级 G2 的不一致（同 SQL 同指标，等级必须一致）
+    if result.get("ok") and selected and not uses_temp:
+        try:
+            from . import checks as analysis_checks
+
+            check_outcome = analysis_checks.check_request({
+                "sql": sql, "selected": selected,
+                "temp_scope": body.get("temp_scope") or None,
+                "time": body.get("time"),
+            })
+            result["grounding_level"] = check_outcome["grounding_level"]
+            result["non_authoritative_reasons"] = check_outcome["non_authoritative_reasons"]
+            result["grounding_checks"] = check_outcome["checks"]
+        except Exception as exc:  # noqa: BLE001 —— 推导失败保底 G2，不阻断执行
+            result["grounding_derive_error"] = f"{type(exc).__name__}: {exc}"
+    # 探索发现异步回流增量采集（方案：新发现触发增量采集，下次不再需要临时 scope）
+    if result.get("ok") and uses_temp and source_id:
+        result["semantic_collection"] = _trigger_incremental_collection(source_id, workspace_id)
+    return result
+
+
+def _trigger_incremental_collection(source_id: str, workspace_id: str) -> dict:
+    """临时 scope 执行成功后返回可追踪的采集任务或明确的跳过原因。
+
+    语义服务负责后台采集与工作空间内同源任务复用；此处只做轻量启动，
+    不为不支持的源额外创建线程。启动失败作为响应附加状态，不改变查询结果。
+    """
+    from ..datasource.service import trigger_semantic_collection
+
+    return trigger_semantic_collection(source_id, workspace_id, trigger_type="query_feedback")
+
+
+def _verify_compile_record(workspace_id: str, query_id: str,
+                           sql_template: str) -> str | None:
+    """编译追溯记录验证：存在、workspace 一致、权威、模板一致。
+
+    编译通道的信任根是 ``dw_metric_queries`` 追溯记录（compile 端点写入），
+    而不是客户端回传——模板与记录不符即拒（产物被改写或版本漂移）。
+
+    Returns:
+        验证失败原因；通过返回 None。
+    """
+    from ..metrics import store
+
+    record = store.get_query(query_id)
+    if record is None:
+        return f"编译追溯记录 {query_id} 不存在（产物过期或未经过 compile 端点）"
+    if str(record.get("workspace_id") or "") != workspace_id:
+        return "编译追溯记录不属于当前工作空间"
+    if not record.get("authoritative"):
+        return "编译追溯记录非权威产物"
+    if str(record.get("generated_sql") or "") != sql_template:
+        return "SQL 模板与编译追溯记录不一致（产物被改写或版本漂移）"
+    return None
+
+
+def _uses_temp_scope(
+    sql: str, temp_tables: dict[str, list[str]], source_type: str = "mysql",
+) -> bool:
+    """SQL 引用对象是否落在临时 scope 内（G3 判定；扫描原子共用 checks.uses_temp_scope）。"""
+    if not temp_tables:
+        return False
+    try:
+        parsed = sqlglot.parse_one(sql, read=sqlglot_dialect(source_type))
+    except Exception:  # noqa: BLE001 —— 解析失败在 guard 已拦，这里保守 False
+        return False
+    return uses_temp_scope(parsed, temp_tables)
+
+
+def _blocked(sql: str, guard: list[dict[str, str]]) -> dict[str, Any]:
+    return {"ok": False, "error": "guard_blocked", "guard": guard,
+            "sql": sql, "row_count": 0, "rows": [], "columns": []}
+
+
+def _revoked_selected(workspace_id: str, selected) -> str | None:
+    """选定指标任一撤销/归档/非 published → 返回该 metric_key。"""
+    from ..metrics import store
+
+    release_revoked: bool | None = None  # 惰性回源一次：无有效候选不查 release
+    for item in selected or ():
+        if not isinstance(item, dict):
+            continue
+        metric_key = str(item.get("metric_key") or "")
+        if not metric_key:
+            continue
+        if store.published_revision_of(workspace_id, metric_key) is None:
+            return metric_key
+        if release_revoked is None:
+            release = store.get_active_release(workspace_id)
+            release_revoked = release is not None and release.status == "revoked"
+        if release_revoked:
+            return metric_key
+    return None
+
+
+def _source_type_of(source_id: str, db_ref: str) -> str:
+    """执行目标类型（guard 方言与只读判定用）。"""
+    if source_id:
+        try:
+            from ..datasource import store as ds_store
+
+            workspace_id = workspace_context.current_workspace().workspace_id
+            source = ds_store.find_source(source_id, workspace_id=workspace_id or None)
+            if source and source.get("source_type"):
+                return str(source["source_type"])
+        except Exception as exc:  # noqa: BLE001 —— 查不到按默认 mysql 方言
+            logger.debug("source %s 类型查询失败，按默认方言处理: %s",
+                         source_id, type(exc).__name__)
+    ref = (db_ref or "").split("://", 1)[0]
+    return ref or "mysql"
+
+
+def _authorized_ref(workspace_id: str, source_id: str, db_ref: str) -> str | None:
+    """source/db_ref 归属校验（business 角色）；返回规范化 ref 或 None。"""
+    try:
+        if source_id:
+            from ..datasource import store as ds_store
+
+            source = ds_store.find_source(source_id, workspace_id=workspace_id or None)
+            if source and source.get("db_ref"):
+                return workspace_context.validate_ref_in_workspace(
+                    workspace_id, "business", str(source["db_ref"]))
+        if db_ref:
+            return workspace_context.validate_ref_in_workspace(workspace_id, "business", db_ref)
+    except Exception:  # noqa: BLE001 —— 校验失败按未授权处理
+        return None
+    return None
+
+
+def _structure_compatible(
+    sql: str, temp_scope: dict[str, Any], source_type: str = "mysql",
+) -> str | None:
+    """结构兼容复验：SQL 引用对象 ⊆ 当前快照 ∪ 临时 scope。
+
+    Returns:
+        不兼容时返回越界明细；兼容返回 None。无快照时（源未采集）退化为
+        只验临时 scope（探索链路合法路径）。
+    """
+    from .checks import _snapshot_scope_tables
+
+    try:
+        parsed = sqlglot.parse_one(sql, read=sqlglot_dialect(source_type))
+    except Exception as exc:  # noqa: BLE001 —— 解析失败在只读 guard 已拦，这里兜底
+        return f"SQL 解析失败: {exc}"
+    temp_tables = temp_scope_tables_of(temp_scope)
+    snapshot_tables = _snapshot_scope_tables()
+    union_tables = set(snapshot_tables) | set(temp_tables)
+    if not union_tables:
+        return None  # 无快照无临时 scope：探索链路由授权/只读兜底
+    violations = [f"表 {name}" for name in out_of_scope_tables(parsed, union_tables)]
+    if violations:
+        return "、".join(violations)
+    return None
