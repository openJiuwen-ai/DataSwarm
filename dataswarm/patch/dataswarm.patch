+// handleNavigate 切回任务（chat）tab 时必须复位侧边栏收起态：任务侧边栏收起后整体隐藏
+// （宽度 0、收起按钮随之不可见），切回 tab 的复位是唯一展开入口——这行曾在 DataSwarm
+// delta 演进中丢失，导致「收起 → 切走 → 切回」后任务列表永远无法展开（2026-11-03 修复）。
+// 参照 navRemountKey.test.mjs 的源码扫描守卫模式，防止再次无声丢失。
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const appPath = join(dirname(fileURLToPath(import.meta.url)), '..', 'src', 'App.tsx');
+const source = readFileSync(appPath, 'utf8');
+
+function handleNavigateBody() {
+  const start = source.indexOf('const handleNavigate = useCallback(');
+  assert.ok(start !== -1, 'App.tsx 应定义 handleNavigate');
+  const end = source.indexOf('\n  );', start);
+  assert.ok(end !== -1, 'handleNavigate 回调应正常闭合');
+  return source.slice(start, end);
+}
+
+test("handleNavigate 的 nav === 'chat' 分支必须复位侧边栏收起态", () => {
+  const body = handleNavigateBody();
+  const chatBranch = body.match(/if \(nav === 'chat'\) \{([\s\S]*?)\n {6}\}/);
+  assert.ok(chatBranch, "handleNavigate 应有 nav === 'chat' 分支");
+  assert.ok(
+    chatBranch[1].includes('setConversationSidebarCollapsed(false)'),
+    "nav === 'chat' 分支必须调 setConversationSidebarCollapsed(false)：任务侧边栏收起后整体隐藏，"
+      + '切回 tab 的复位是唯一展开入口，缺失则收起后任务列表永远无法展开',
+  );
+});
