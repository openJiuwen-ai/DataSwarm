+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""在工作空间元数据库的 dw_datasources 表持久化数据源配置。
+
+存储目标由 workspace_context.metadata_db_ref 决定，可通过
+JIUWENSWARM_DATASOURCE_DB 显式覆盖。跨库读写复用 orchestration/db.py，
+表结构由 deploy/schema/ddl 中的脚本幂等初始化。
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import threading
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+)
+
+
+_TABLE = "dw_datasources"
+_init_lock = threading.Lock()
+_initialized_refs: set[str] = set()
+# 记录同线程正在初始化的元库，避免凭据回读再次获取 _init_lock。
+# 完整服务器 ref 可形成 ensure_system_schema → parse_db_ref → find_credentials
+# → _ensure_table 的重入链；元库自身凭据应由 ref/config/env 提供。
+_ensuring_ref = threading.local()
+
+
+def _resolve_db_ref(workspace_id: str | None = None) -> str:
+    """数据源注册库 = 工作空间元数据库；env 覆盖优先（测试/部署）。
+
+    不回退全局 datasources.db（防串库）。
+    """
+    configured = os.environ.get("JIUWENSWARM_DATASOURCE_DB", "").strip()
+    if configured:
+        return configured if "://" in configured else f"sqlite://{configured}"
+    from jiuwenswarm.common import workspace_context
+
+    if workspace_id:
+        return workspace_context.metadata_db_ref(workspace_id)
+    return workspace_context.current_workspace().metadata_db_ref
+
+
+def _ensure_table(meta_ref: str) -> None:
+    """幂等初始化数据源表，并检查存量表是否需要备注列迁移。
+
+    使用 description 列探测：缺列会进入完整初始化路径，触发
+    _ensure_description_column；已初始化的元库仍需通过该检查。
+    """
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+    # 外层正在初始化同一元库时不重复建表，也不再次获取锁。
+    # 元库尚不可读时，凭据查找保留外层使用的 ref/config/env 来源。
+    if getattr(_ensuring_ref, "ref", None) == meta_ref:
+        return
+
+    with _init_lock:
+        if meta_ref in _initialized_refs:
+            conn = _connect(meta_ref)
+            try:
+                _fetch_dicts(conn, f"SELECT description FROM {_TABLE} LIMIT 1")
+                return
+            except Exception:
+                _initialized_refs.discard(meta_ref)
+            finally:
+                conn.close()
+        _ensuring_ref.ref = meta_ref
+        try:
+            ensure_system_schema(meta_ref)
+            _ensure_description_column(meta_ref)
+        finally:
+            _ensuring_ref.ref = None
+        conn = _connect(meta_ref)
+        try:
+            _fetch_dicts(conn, f"SELECT description FROM {_TABLE} LIMIT 1")
+        except Exception as exc:
+            raise RuntimeError(f"metadata schema missing {_TABLE}: {exc}") from exc
+        finally:
+            conn.close()
+        _initialized_refs.add(meta_ref)
+
+
+def _ensure_description_column(meta_ref: str) -> None:
+    """存量库幂等加 description 列（首装新 DDL 库 no-op）。双方言。"""
+    from jiuwenswarm.common import db_connector
+
+    try:
+        cols = {c.get("name") for c in
+                db_connector.schema(meta_ref, _TABLE).get("columns", [])}
+    except Exception:
+        return  # 探测失败不阻断：新 DDL 建的表本就有该列
+    if "description" in cols:
+        return
+    is_sqlite = db_connector.parse_db_ref(meta_ref).get("type") == "sqlite"
+    col_type = "TEXT" if is_sqlite else "VARCHAR(500)"
+    conn = _connect(meta_ref)
+    try:
+        _exec(conn, f"ALTER TABLE `{_TABLE}` ADD COLUMN `description` {col_type} NULL")
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _now() -> str:
+    return timeutil.now_iso()
+
+
+def _row_to_source(row: dict) -> dict:
+    """DB 行 → 业务 dict（config JSON 解析 + 基础字段）。"""
+    config: dict = {}
+    raw = row.get("config")
+    if raw:
+        try:
+            config = json.loads(raw) if isinstance(raw, str) else dict(raw)
+        except (json.JSONDecodeError, TypeError):
+            config = {}
+    return {
+        "source_id": row.get("source_id", ""),
+        "source_type": row.get("source_type", ""),
+        "name": row.get("name") or row.get("source_id", ""),
+        "description": str(row.get("description") or ""),
+        "config": config,
+        "db_ref": row.get("db_ref", ""),
+        "enabled": bool(row.get("enabled", True)),
+        "config_version": int(row.get("config_version") or 1),
+        "created_at": row.get("created_at", ""),
+        "updated_at": row.get("updated_at", ""),
+    }
+
+
+def list_sources(workspace_id: str | None = None) -> list[dict]:
+    """列出该工作空间注册的 UI 数据源（config 原样返回，脱敏由 service 层处理）。"""
+    meta_ref = _resolve_db_ref(workspace_id)
+    _ensure_table(meta_ref)
+    conn = _connect(meta_ref)
+    try:
+        rows = _fetch_dicts(conn, f"SELECT * FROM {_TABLE} ORDER BY source_id")
+        return [_row_to_source(r) for r in rows]
+    finally:
+        conn.close()
+
+
+def get_source(source_id: str, workspace_id: str | None = None) -> dict | None:
+    return _get_source_in(_resolve_db_ref(workspace_id), source_id)
+
+
+def _get_source_in(meta_ref: str, source_id: str) -> dict | None:
+    _ensure_table(meta_ref)
+    conn = _connect(meta_ref)
+    try:
+        row = _fetch_one_dict(
+            conn, f"SELECT * FROM {_TABLE} WHERE source_id = ?", (source_id,)
+        )
+        return _row_to_source(row) if row else None
+    finally:
+        conn.close()
+
+
+def find_source(source_id: str, workspace_id: str | None = None) -> dict | None:
+    """跨空间查找数据源（消费语义：绑定/探测/浏览可用其他空间注册的源）。
+
+    优先当前/指定空间元库，未命中遍历其余空间；任何异常按未找到处理。
+    """
+    try:
+        meta_ref = _resolve_db_ref(workspace_id)
+        source = _get_source_in(meta_ref, source_id)
+        if source:
+            return source
+        from jiuwenswarm.common import workspace_context
+
+        for context in workspace_context.list_workspaces():
+            if context.metadata_db_ref == meta_ref:
+                continue
+            source = _get_source_in(context.metadata_db_ref, source_id)
+            if source:
+                return source
+    except Exception:
+        return None
+    return None
+
+
+def find_local_source(source_id: str, workspace_id: str | None = None) -> dict | None:
+    """Find a source only in the selected workspace metadata database."""
+    try:
+        return _get_source_in(_resolve_db_ref(workspace_id), source_id)
+    except Exception:
+        return None
+
+
+def insert_source(source_id: str, source_type: str, name: str,
+                  config: dict, db_ref: str, workspace_id: str | None = None,
+                  description: str = "") -> dict:
+    """插入数据源。source_id 已存在时抛 ValueError（service 层转错误 dict）。"""
+    meta_ref = _resolve_db_ref(workspace_id)
+    _ensure_table(meta_ref)
+    now = _now()
+    conn = _connect(meta_ref)
+    try:
+        existing = _fetch_one_dict(
+            conn, f"SELECT source_id FROM {_TABLE} WHERE source_id = ?", (source_id,)
+        )
+        if existing:
+            raise ValueError(f"source_id already exists: {source_id}")
+        _exec(
+            conn,
+            f"INSERT INTO {_TABLE} (source_id, source_type, name, description, config, db_ref, "
+            "created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+            (source_id, source_type, name, str(description or ""), json.dumps(config, ensure_ascii=False),
+             db_ref, now, now),
+        )
+        conn.commit()
+        return {"source_id": source_id, "db_ref": db_ref, "created_at": now}
+    finally:
+        conn.close()
+
+
+def update_source_row(source_id: str, source_type: str, name: str,
+                      config: dict, db_ref: str, workspace_id: str | None = None,
+                      description: str = "") -> dict:
+    """整行更新（config 由 service 层完成密码保留合并后传入）。"""
+    meta_ref = _resolve_db_ref(workspace_id)
+    _ensure_table(meta_ref)
+    now = _now()
+    conn = _connect(meta_ref)
+    try:
+        existing = _fetch_one_dict(
+            conn, f"SELECT source_id FROM {_TABLE} WHERE source_id = ?", (source_id,)
+        )
+        if not existing:
+            raise ValueError(f"source not found: {source_id}")
+        _exec(
+            conn,
+            f"UPDATE {_TABLE} SET source_type = ?, name = ?, description = ?, config = ?, "
+            "db_ref = ?, updated_at = ? WHERE source_id = ?",
+            (source_type, name, str(description or ""), json.dumps(config, ensure_ascii=False),
+             db_ref, now, source_id),
+        )
+        conn.commit()
+        return {"source_id": source_id, "db_ref": db_ref, "updated_at": now}
+    finally:
+        conn.close()
+
+
+def delete_source_row(source_id: str, workspace_id: str | None = None) -> None:
+    """删除数据源。不存在时抛 ValueError。"""
+    meta_ref = _resolve_db_ref(workspace_id)
+    _ensure_table(meta_ref)
+    conn = _connect(meta_ref)
+    try:
+        existing = _fetch_one_dict(
+            conn, f"SELECT source_id FROM {_TABLE} WHERE source_id = ?", (source_id,)
+        )
+        if not existing:
+            raise ValueError(f"source not found: {source_id}")
+        _exec(conn, f"DELETE FROM {_TABLE} WHERE source_id = ?", (source_id,))
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def find_credentials(db_type: str, host: str, port: int, database: str,
+                     workspace_id: str | None = None) -> dict:
+    """查当前空间凭据，仅对精确绑定的业务引用允许跨空间补全。
+
+    元库连接自身使用配置/环境凭据，不依赖尚待连接或初始化的注册表。
+    保留本地元库不可用时的既有回退；已保存配置损坏/冲突则明确拒绝。
+    """
+    db_ref = f"{db_type}://{host}:{port}/{database}"
+    if getattr(_ensuring_ref, "ref", None) == db_ref:
+        return {}
+    try:
+        meta_ref = _resolve_db_ref(workspace_id)
+        if meta_ref == db_ref:
+            return {}
+        credentials = _find_credentials_in(meta_ref, db_type, host, port, database)
+    except _SavedSourceConfigError:
+        raise
+    except Exception:
+        return {}
+    if credentials:
+        return credentials
+    if os.environ.get("JIUWENSWARM_DATASOURCE_DB", "").strip():
+        return {}
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        context = (workspace_context.resolve(workspace_id) if workspace_id
+                   else workspace_context.current_workspace())
+    except workspace_context.WorkspaceContextError:
+        return {}
+    if not context.workspace_id or context.business_db_ref != db_ref:
+        return {}
+    config = find_config_by_ref(db_ref, db_type, workspace_id=context.workspace_id)
+    return _credentials_from_config(db_type, config) if config is not None else {}
+
+
+class _SavedSourceConfigError(ValueError):
+    """A saved configuration cannot safely determine connection credentials."""
+
+
+def _saved_config(row: dict) -> dict:
+    raw = row.get("config")
+    try:
+        config = json.loads(raw) if isinstance(raw, str) else raw
+    except (json.JSONDecodeError, TypeError):
+        raise _SavedSourceConfigError("invalid saved datasource configuration") from None
+    if not isinstance(config, dict):
+        raise _SavedSourceConfigError("invalid saved datasource configuration")
+    return config
+
+
+def find_config_by_ref(db_ref: str, source_type: str,
+                       workspace_id: str | None = None) -> dict | None:
+    """Resolve local settings, or the exact business ref bound from another space.
+
+    A reference identifies a dataset rather than a source ID. Multiple saved
+    sources with different configs are ambiguous and must not pick credentials
+    by row order. An empty config is distinct from an unregistered reference.
+    Explicit metadata overrides stay within that store. Without an override,
+    the normal unique-workspace default is supported; cross-space fallback is
+    allowed only for the selected workspace's exact bound business reference.
+    """
+    from jiuwenswarm.common import workspace_context
+
+    workspace_id = workspace_id or workspace_context.selected_workspace_id()
+    if os.environ.get("JIUWENSWARM_DATASOURCE_DB", "").strip():
+        return _find_config_in(_resolve_db_ref(workspace_id), db_ref, source_type)
+    if workspace_id:
+        context = workspace_context.resolve(workspace_id)
+    else:
+        try:
+            context = workspace_context.current_workspace()
+        except (workspace_context.WorkspaceNotConfigured, workspace_context.WorkspaceContextRequired):
+            # Standalone refs without a resolvable workspace retain their
+            # self-contained config; do not search arbitrary metadata stores.
+            return None
+        if not os.environ.get("JIUWENSWARM_ORCH_DB", "").strip() and context.business_db_ref != db_ref:
+            # A standalone file/remote ref is not implicitly part of the default
+            # workspace. Only its bound source may read that metadata store.
+            return None
+    meta_ref = context.metadata_db_ref
+    config = _find_config_in(meta_ref, db_ref, source_type)
+    if config is not None:
+        return config
+    if not context.workspace_id or context.business_db_ref != db_ref:
+        return None
+    # Binding authorizes this exact ref, not the rest of another workspace.
+    # Collect all matches so equivalent copies work and conflicting settings
+    # fail closed rather than depending on workspace iteration order.
+    found = None
+    visited = {meta_ref}
+    for candidate in workspace_context.list_workspaces():
+        if candidate.metadata_db_ref in visited:
+            continue
+        visited.add(candidate.metadata_db_ref)
+        candidate_config = _find_config_in(candidate.metadata_db_ref, db_ref, source_type)
+        if candidate_config is None:
+            continue
+        if found is not None and candidate_config != found:
+            raise _SavedSourceConfigError("ambiguous saved datasource reference across bound source workspaces")
+        found = candidate_config
+    return found
+
+
+def _find_config_in(meta_ref: str, db_ref: str, source_type: str) -> dict | None:
+    # Resolving a reference is read-only. Do not initialize/migrate unrelated
+    # metadata schemas just to look for optional persisted connection settings.
+    conn = _connect(meta_ref)
+    try:
+        try:
+            rows = _fetch_dicts(
+                conn, f"SELECT config FROM {_TABLE} WHERE db_ref = ? AND source_type = ?",
+                (db_ref, source_type),
+            )
+        except Exception as exc:
+            # A standalone/YAML workspace need not have a datasource registry.
+            # Connection/auth failures still propagate; do not silently swap to
+            # global credentials when the configured metadata store is down.
+            original = getattr(exc, "orig", exc)
+            state = getattr(original, "sqlstate", None) or getattr(original, "pgcode", None)
+            code = original.args[0] if original.args else None
+            message = str(original).lower()
+            missing_registry = re.search(
+                r"(?:no such table:\s*|unknown table\s*|(?:table|relation)\s+)[`'\"\[\]\w.]*\bdw_datasources\b",
+                message,
+            ) and any(marker in message for marker in (
+                "no such table", "doesn't exist", "does not exist", "unknown table",
+            ))
+            if state == "42P01" or code == 1146 or (state is None and missing_registry):
+                return None
+            raise
+        configs = [_saved_config(row) for row in rows]
+        if not configs:
+            return None
+        if any(config != configs[0] for config in configs[1:]):
+            raise _SavedSourceConfigError("ambiguous saved datasource reference in source workspace")
+        return configs[0]
+    finally:
+        conn.close()
+
+
+def _find_credentials_in(meta_ref: str, db_type: str, host: str, port: int, database: str) -> dict:
+    _ensure_table(meta_ref)
+    config = _find_config_in(meta_ref, f"{db_type}://{host}:{port}/{database}", db_type)
+    return _credentials_from_config(db_type, config) if config is not None else {}
+
+
+def _credentials_from_config(db_type: str, config: dict) -> dict:
+    creds: dict[str, str | int] = {
+        "user": str(config.get("user", "")),
+        "password": str(config.get("password", "")),
+    }
+    # Explicit empty options prevent unrelated process defaults changing modes.
+    if db_type == "sqlserver":
+        creds["driver"] = str(config.get("driver") or "")
+        creds["trusted_connection"] = config.get("trusted_connection", False)
+    if db_type == "doris":
+        be_host = str(config.get("be_host", "")).strip()
+        if be_host:
+            creds["be_host"] = be_host
+        be_port_raw = config.get("be_http_port")
+        if be_port_raw not in (None, ""):
+            try:
+                creds["be_http_port"] = int(be_port_raw)
+            except (TypeError, ValueError):
+                pass
+    return creds
