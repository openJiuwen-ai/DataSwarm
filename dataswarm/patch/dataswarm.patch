+def _wait_instance(instance_id: str, *, timeout_s: float = 1800.0, interval: float = 2.0,
+                   base: str = "") -> tuple[dict, bool]:
+    """轮询 GET /instances/{id} 至终态（§5.3）。
+
+    Returns:
+        (最终实例载荷, 是否终态)。超时返回 ({"status": <当前>, "timed_out": True}, False)；
+        404 等错误直接返回该错误载荷且视为终止（不再轮询）。
+    """
+    deadline = time.monotonic() + max(timeout_s, 0.05)
+    while True:
+        result = _call_api("GET", f"/orchestration/instances/{urllib.parse.quote(str(instance_id), safe='')}",
+                           base=base)
+        status = result.get("status") if isinstance(result, dict) else None
+        if result.get("http_code") == 404 or (status == "error" and "http_code" in result):
+            return result, True  # 明确错误（如 not_found），终止轮询
+        if status in _TERMINAL_STATUSES:
+            return result, True
+        if time.monotonic() >= deadline:
+            return {**result, "timed_out": True}, False
+        time.sleep(max(interval, 0.01))
+
+
+def _call_api(method: str, path: str, query_params: dict | None = None,
+              body: dict | None = None, base: str = "", *,
+              absolute_path: bool = False) -> dict:
+    """调用 dataagent REST API。
+
+    absolute_path=True 时 path 为完整 API 路径（如 /api/inspection/persist），
+    不再拼接 /api/dataagent 前缀。
+    """
+    base = base or _DEFAULT_BASE
+    # workspace 注入兜底（收敛点）：wait 等特判分支不经过通用 query 组装，历史上
+    # 两次漏传 workspace（json_body 一次、instance wait 一次）→ 多工作空间下必挂
+    # 400 WORKSPACE_CONTEXT_REQUIRED。未显式携带才注入；absolute_path 路由沿用
+    # 通用分支的"不注入"约定（inspection 等由 json_body 分支自行注入）。
+    _ws = _ACTIVE_WORKSPACE_ID
+    if _ws and not absolute_path and not (query_params or {}).get("workspace_id"):
+        query_params = {**(query_params or {}), "workspace_id": _ws}
+    url = f"{base}{path}" if absolute_path else f"{base}/api/dataagent{path}"
+    if query_params:
+        qs = {k: v for k, v in query_params.items() if v is not None}
+        if qs:
+            url += "?" + urllib.parse.urlencode(qs)
+
+    if method == "GET":
+        req = urllib.request.Request(url)
+    else:
+        data = json.dumps(body or {}, ensure_ascii=False).encode("utf-8")
+        req = urllib.request.Request(url, data=data, method=method)
+        req.add_header("Content-Type", "application/json; charset=utf-8")
+    # 对话链路透传会话标识（bash 工具注入的 env）：服务端写操作成功后按会话推送
+    # chat.struct_change 事件（docs/archive/delivered/chat-struct-change-push-plan.md §4.1）。
+    # 无脑携带（只读请求多一个 header 无副作用），非对话场景（手工 CLI）该 env 为空即不带。
+    _sid = os.environ.get("JIUWENSWARM_SESSION_ID", "").strip()
+    if _sid:
+        req.add_header("X-Jiuwen-Session-Id", _sid)
+
+    try:
+        with urllib.request.urlopen(req, timeout=30) as resp:
+            return json.loads(resp.read().decode("utf-8"))
+    except urllib.error.HTTPError as e:
+        try:
+            err_body = json.loads(e.read().decode("utf-8"))
+        except Exception:
+            err_body = {"error": str(e)}
+        # 回显请求实际携带的 query：stderr 横幅只反映本地 env 解析结果，不等于
+        # 请求参数（Agent 曾据此误判 --workspace-id 已生效而反复重试）。
+        sent_qs = {k: v for k, v in (query_params or {}).items() if v is not None}
+        return {"status": "error", "http_code": e.code, "sent_query": sent_qs, **err_body}
+    except urllib.error.URLError as e:
+        return {"status": "error", "error": f"connection failed: {e.reason}",
+                "hint": "is the web server running on " + base + "?"}
+    except Exception as e:
+        return {"status": "error", "error": str(e)}
+
+
+def _datasource_config_path() -> Path:
+    """数据源配置文件路径：收口 db_connector 唯一实现（env 优先；main() 已注入 release 默认 ~/.dataswarm）。"""
+    from jiuwenswarm.common import db_connector
+
+    return db_connector._datasource_config_path()
+
+
+def _local_ref_name(db_ref: str, *, file_stem: bool = False) -> str:
+    """Read a public database label without resolving connection credentials."""
+    from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+    kind = db_type_of_ref(db_ref)
+    rest = db_ref.split("://", 1)[-1]
+    if kind in {"sqlite", "duckdb"}:
+        location = urllib.parse.unquote(rest.partition("?")[0])
+        if kind == "duckdb" and "://" in location:
+            return ""
+        path = Path(location)
+        return path.stem if kind == "duckdb" and file_stem else path.name
+    body = rest.partition("?")[0].partition("#")[0].rstrip("/")
+    if "/" in body:
+        return urllib.parse.unquote(body.rsplit("/", 1)[-1])
+    if kind in {"doris", "mysql", "ddl"} and not any(
+        marker in body for marker in ("@", ":")
+    ):
+        return body if body != "meta" else ""
+    return ""
+
+
+def _local_datasource_current(workspace_id: str | None = None) -> dict:
+    """读 datasource.yaml 解析当前工作空间数据源（本地解析，不打 HTTP）。
+
+    多工作空间（P4-1）：default_db/dialect/biz_database 一律从 workspace_context
+    解析出的 business_db_ref 派生（决策八：收口唯一解析实现），不再单独正则读
+    yaml 顶层 default_db——多工作空间下两者会互相矛盾。返回的 db-ref 字段
+    （business_db_ref/metadata_db_ref）保留原始形态供脚本使用；脱敏摘要由
+    _sanitize_summary 生成（打印通道不用原始 URI）。
+    """
+    from jiuwenswarm.common import workspace_context
+    from jiuwenswarm.common import dialect_registry
+    ctx = workspace_context.resolve(workspace_id)
+    default_db = ctx.business_db_ref or "doris://"
+    is_sqlite = default_db.startswith("sqlite://") or (
+        "://" not in default_db and default_db.lower().endswith(".db")
+    )
+    # 方言推导唯一真相源在 dialect_registry（方言收敛批次 2-G6）；
+    # sqlite 裸 .db 路径（无 scheme）registry 解析不了，先判 is_sqlite。
+    if is_sqlite:
+        dialect = "sqlite"
+    else:
+        try:
+            from jiuwenswarm.common.ref_codec import codec_for
+
+            kind = dialect_registry.db_type_of_ref(default_db)
+            codec_for(kind)  # Validate the scheme without decoding credentials.
+            dialect = dialect_registry.sqlglot_dialect(kind)
+        except ValueError:
+            dialect = "doris"
+
+    # 业务库名：从 ref 自带库名取；省略库名时回退 config 段（yaml 解析失败静默留空）。
+    # duckdb 文件源：库名 = location 文件/目录 stem（目录源=目录名，单文件=文件名去后缀），
+    # 不能走 rsplit("/")——query 串（?source_type=...）会被当库名的一部分。
+    biz_database = _local_ref_name(default_db, file_stem=True)
+    if not biz_database:
+        cfg_path = _datasource_config_path()
+        if cfg_path.is_file():
+            try:
+                import yaml
+                data = yaml.safe_load(cfg_path.read_text(encoding="utf-8")) or {}
+                database_key = "metadata_database" if default_db.endswith("://meta") else "database"
+                if dialect == "doris":
+                    doris_cfg = data.get("doris") or {}
+                    biz_database = doris_cfg.get(database_key, "") or ""
+                elif dialect == "mysql":
+                    biz_database = (data.get("mysql") or {}).get(database_key, "") or ""
+            except Exception:
+                pass
+
+    return {
+        "workspace_id": ctx.workspace_id,
+        "business_db_ref": ctx.business_db_ref,
+        "metadata_db_ref": ctx.metadata_db_ref,
+        "default_db": default_db,
+        "dialect": dialect,
+        "is_sqlite": is_sqlite,
+        "biz_database": biz_database,
+        "config_path": str(_datasource_config_path()),
+        "summary": _sanitize_summary(ctx),
+    }
+
+
+def _sanitize_summary(ctx) -> str:
+    """决策八-4：workspace=<id> business={type,database} metadata={type,database} 脱敏摘要。"""
+    from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+    return (f"workspace={ctx.workspace_id or 'default'} "
+            f"business={db_type_of_ref(ctx.business_db_ref)}:{_local_ref_name(ctx.business_db_ref)} "
+            f"metadata={db_type_of_ref(ctx.metadata_db_ref)}:{_local_ref_name(ctx.metadata_db_ref)}")
+
+
+def _local_datasource_meta(workspace_id: str | None = None) -> dict:
+    """本地解析系统元数据库 db-ref（不打 HTTP）。
+
+    多工作空间（P4-1）：workspace 解析出的 metadata_db_ref 优先；env
+    JIUWENSWARM_ORCH_DB 覆盖（legacy sqlite 开发）时才走 orchestration 的
+    全局解析（此时与 workspace 无关）。两者不一致时输出 conflict 标记（9.4）。
+    """
+    from jiuwenswarm.common import workspace_context
+    ctx = workspace_context.resolve(workspace_id)
+    from jiuwenswarm.channels.web.orchestration.db import _resolve_metadata_db_ref
+
+    meta_ref = _resolve_metadata_db_ref()
+    # env 覆盖（legacy）不等于 workspace 元库：显式标记，防静默混用
+    conflict = meta_ref != ctx.metadata_db_ref
+    is_sqlite = meta_ref.startswith("sqlite://")
+    return {
+        "workspace_id": ctx.workspace_id,
+        "business_db_ref": ctx.business_db_ref,
+        "metadata_db_ref": ctx.metadata_db_ref,
+        "meta_db_ref": meta_ref,
+        "dialect": "sqlite" if is_sqlite else "doris",
+        "is_sqlite": is_sqlite,
+        "summary": _sanitize_summary(ctx),
+        **({"orch_env_override": True} if conflict else {}),
+    }
+
+
+def _resolve_default_db_ref(workspace_id: str | None = None) -> str:
+    """db_ref 缺省时的回退 ref（P4-1：感知 workspace，不再静默落默认元库）。
+
+    取当前工作空间业务库（未绑源/多空间缺上下文时大声失败）；仅非 workspace
+    系的意外异常兜底回退系统元数据库 ref（防 CLI 意外崩溃，正常路径不走）。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        ctx = workspace_context.resolve(workspace_id)
+        if not ctx.business_db_ref:
+            raise workspace_context.WorkspaceBusinessNotBound(ctx.workspace_id)
+        return ctx.business_db_ref
+    except workspace_context.WorkspaceContextError:
+        if workspace_context.list_workspaces() and len(workspace_context.list_workspaces()) > 1:
+            raise  # 多工作空间：大声失败
+        raise
+    except Exception:
+        pass
+    from jiuwenswarm.channels.web.orchestration.db import _resolve_metadata_db_ref
+
+    return _resolve_metadata_db_ref()
+
+
+def _db_name_from_ref(db_ref: str | None) -> str | None:
+    """从 db-ref 提取库名（供 databases 组 --db 缺省时推导）。
+
+    - doris://dbname / mysql://dbname（指针自带库名）→ dbname
+    - doris://host:port/dbname → dbname
+    - duckdb://… → location 文件/目录名（文件源单"库"）
+    - sqlite://… → "main"（SQLite 单文件库无库名概念，{db} 只是 URL 占位；
+      服务端 resolve_db_ref 优先用 query 的 db_ref，不再要求显式 --db）
+    - doris:// / doris://meta → None（库名在 config 段，不本地猜测）
+    """
+    if not db_ref or "://" not in db_ref:
+        return None
+    scheme, rest = db_ref.split("://", 1)
+    if scheme == "duckdb":
+        from jiuwenswarm.common import db_connector
+
+        spec = db_connector.parse_db_ref(db_ref)
+        return spec.get("database") or Path(spec.get("location", "")).name or None
+    if scheme == "sqlite":
+        return "main"
+    if scheme not in ("doris", "mysql"):
+        return None
+    if not rest or rest.strip() == "meta":
+        return None
+    if "/" not in rest:
+        return rest
+    return rest.partition("/")[2] or None
+
+
+_SQL_ACTIONS = ("run", "explain", "ddl")
+
+
+def _shim_sql_positional(argv: list[str]) -> list[str]:
+    """宽容解析模型常猜的简写：`dwcli sql "<SQL>"` → `dwcli sql run --sql "<SQL>"`。
+
+    ROUTES 里 sql 组是 {run, explain, ddl} 三动作子命令，但模型经常直接
+    `dwcli sql "SHOW DATABASES"`（把 SQL 当位置参数）或 `dwcli sql run "SELECT …"`
+    （动作后裸 SQL），argparse 报 invalid choice / missing --sql，模型重试浪费
+    轮次。此处把动作位或首段非 flag 位置参数识别为 SQL 文本重写为 --sql 形式；
+    写操作交由服务端只读护栏拒绝并提示走 `sql ddl --confirm`。
+    """
+    if len(argv) < 2 or argv[0] != "sql":
+        return argv
+    if argv[1] in ("-h", "--help"):
+        return argv
+    if argv[1].startswith("-"):
+        # `sql --sql "<SQL>"`：漏写动作 → 补 run（模型高频形态，
+        # argparse 报 invalid choice: --sql 会误导读模型以为语法不对）
+        return [argv[0], "run", *argv[1:]]
+    if argv[1] in _SQL_ACTIONS:
+        # 动作后裸 SQL：sql run "SELECT 1" --db-ref x → sql run --sql "SELECT 1" --db-ref x
+        if len(argv) >= 3 and not argv[2].startswith("-"):
+            return [argv[0], argv[1], "--sql", *argv[2:]]
+        return argv
+    # 动作位是 SQL 文本：分段收集（位置段并入 SQL；--flag 及其值原样保留）
+    sql_tokens: list[str] = []
+    rest: list[str] = []
+    i = 1
+    while i < len(argv):
+        tok = argv[i]
+        if tok.startswith("--"):
+            rest.append(tok)
+            if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
+                rest.append(argv[i + 1])
+                i += 2
+                continue
+        else:
+            sql_tokens.append(tok)
+        i += 1
+    if not sql_tokens:
+        return argv
+    return ["sql", "run", "--sql", " ".join(sql_tokens), *rest]
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="dwcli",
+        description="数仓建仓 CLI — HTTP 客户端，调 /api/dataagent/*",
+    )
+    parser.add_argument("--workspace-id", default=os.environ.get("JIUWENSWARM_WORKSPACE_ID", ""),
+                        help="workspace id")
+    parser.add_argument("--base", default="",
+                        help="覆盖 DWAGENT_BASE（缺省自动发现：WEB_API_PORT 等 env 端口 > 16173/30002/19002/5173 逐个探测）")
+
+    sub = parser.add_subparsers(dest="group", help="子命令组")
+
+    for group_name, actions in ROUTES.items():
+        grp_parser = sub.add_parser(group_name, help=f"{group_name} 操作")
+        # 全局选项在每个子命令组上重复注册：argparse 只认"直接父级"的参数，
+        # 不重复注册的话 `dwcli datasource --workspace-id x current` 这类形态会报
+        # unrecognized arguments（全局 --workspace-id 必须紧跟 prog 名才被主 parser 吃到）。
+        # default=SUPPRESS：命令行未出现时不写 namespace——否则 None 会覆盖全局
+        # 参数已从 env JIUWENSWARM_WORKSPACE_ID 解析出的值（argparse 嵌套陷阱）。
+        grp_parser.add_argument("--workspace-id", dest="workspace_id",
+                                default=argparse.SUPPRESS,
+                                help="workspace id（组级，等价全局 --workspace-id）")
+        act_sub = grp_parser.add_subparsers(dest="action", help=f"{group_name} 子操作")
+
+        for act_name, route in actions.items():
+            act_parser = act_sub.add_parser(act_name, help=f"{group_name} {act_name}")
+            # 动作级注册：`dwcli datasource current --workspace-id x` 最常用形态。
+            # ROUTES query 里登记的 workspace_id 会跳过（下方循环），此处统一注册防重复。
+            # default=SUPPRESS 同组级：未显式传参时保留全局从 env 解析的值。
+            act_parser.add_argument("--workspace-id", dest="workspace_id",
+                                    default=argparse.SUPPRESS,
+                                    help="workspace id（多工作空间；解析链 本参数 > env > 服务端默认）")
+
+            # path 变量（如 table）。databases 组的 db 可从 --db-ref 推导（指针
+            # 自带库名，如 doris://olist），缺省不强制必填，main 里推导兜底
+            for pv in route.get("path_vars", []):
+                inferable = group_name == "databases" and pv == "db"
+                act_parser.add_argument(f"--{pv.replace('_','-')}",
+                                        required=not inferable,
+                                        default=None,
+                                        help=f"路径变量 {pv}"
+                                        + ("（缺省时从 --db-ref 推导）" if inferable else ""))
+
+            # query 参数
+            for q in route.get("query", []):
+                if q == "workspace_id":
+                    continue  # 已在动作级统一注册（上方），防重复定义
+                act_parser.add_argument(f"--{q.replace('_','-')}", default=None,
+                                        help=f"查询参数 {q}")
+
+            # body 参数
+            for b in route.get("body", []):
+                if b == "confirm":
+                    continue  # flag 单独处理
+                if b == "workspace_id":
+                    continue  # 已在动作级统一注册（上方），防重复定义
+                act_parser.add_argument(f"--{b.replace('_','-')}", default=None,
+                                        help=f"请求体参数 {b}")
+                # 文本内容参数（sql/code）支持从文件读原文：多行/含反引号内容经 shell
+                # 引号内联会被 cmd 拆散（Windows），统一写文件后 --sql-file/--code-file 传
+                if b in ("sql", "code"):
+                    act_parser.add_argument(f"--{b.replace('_','-')}-file", default=None,
+                                            help=f"请求体参数 {b} 从文件读原文（多行 SQL/代码推荐，避免 shell 引号拆散）")
+
+            # flag（布尔）
+            for f in route.get("flag", []):
+                act_parser.add_argument(f"--{f.replace('_','-')}", action="store_true",
+                                        help=f"标志 {f}")
+
+            # 整体 JSON body 命令（§6.1：--json-file <path> / - = stdin）
+            if route.get("json_body"):
+                act_parser.add_argument("--json-file", default=None,
+                                        help="整体 JSON body：文件路径或 '-'（stdin）")
+
+    return parser
+
+
+def main(argv=None) -> None:
+    if argv is None:
+        argv = sys.argv[1:]
+    # release 形态默认对齐 dataswarm_boot：dwcli 不经 boot 入口，裸跑（无 env）时
+    # 数据目录回退 ~/.dataswarm 而非基座 ~/.jiuwenswarm，否则 datasource 等本地路由
+    # 读错配置目录。setdefault 语义：显式 env 永远优先。
+    os.environ.setdefault("JIUWENSWARM_DATA_DIR", str(Path.home() / ".dataswarm"))
+    argv = _shim_sql_positional(list(argv))
+    parser = _build_parser()
+    args = parser.parse_args(argv)
+
+    if not args.group or not args.action:
+        parser.print_help()
+        sys.exit(2)
+
+    group = args.group
+    action = args.action
+    # _emit 的回显摘要按解析后的 workspace 取（决策八-4）；
+    # _call_api 的 query 注入兜底同源（wait/json_body 等特判分支不再各自维护）。
+    # env JIUWENSWARM_WORKSPACE_ID 是 AgentServer 给 bash 子进程注入的会话工作空间
+    # （workspace_context.current_workspace 解析链同源）——skill 脚本链
+    # （analysis_flow → dwcli_client → dwcli）不显式传 --workspace-id 时靠它兜底，
+    # 否则 HTTP 请求无 workspace 上下文，服务端 _with_workspace 落到全局默认空间，
+    # execute guard 会把「源确实绑定了本空间」误判为不在授权范围（ST run 实测）。
+    _ws = (getattr(args, "workspace_id", None)
+           or os.environ.get("JIUWENSWARM_WORKSPACE_ID", "").strip() or None)
+    _emit._workspace_id = _ws
+    global _ACTIVE_WORKSPACE_ID
+    _ACTIVE_WORKSPACE_ID = _ws
+    route = ROUTES.get(group, {}).get(action)
+    if not route:
+        _emit({"error": f"unknown route: {group} {action}"})
+        sys.exit(2)
+
+    # 本地伪路由：不走 HTTP，直接本地解析
+    if route.get("local"):
+        from jiuwenswarm.common import workspace_context
+        if group == "datasource" and action == "current":
+            try:
+                _emit(_local_datasource_current(args.workspace_id or None))
+            except workspace_context.WorkspaceContextRequired as exc:
+                # 多工作空间缺上下文：列出可用项引导显式传参，不给 traceback
+                _emit({"error": str(exc),
+                       "error_code": exc.code,
+                       "workspaces": exc.workspace_ids})
+                sys.exit(2)
+            return
+        if group == "datasource" and action == "meta":
+            try:
+                _emit(_local_datasource_meta(args.workspace_id or None))
+            except workspace_context.WorkspaceContextRequired as exc:
+                _emit({"error": str(exc),
+                       "error_code": exc.code,
+                       "workspaces": exc.workspace_ids})
+                sys.exit(2)
+            return
+        _emit({"error": f"unimplemented local route: {group} {action}"})
+        sys.exit(2)
+
+    base = args.base or ""
+
+    # 整体 JSON body 命令（§6.1：--json-file / stdin）
+    if route.get("json_body"):
+        jf = getattr(args, "json_file", None)
+        if not jf:
+            _emit({"error": "该命令需要 --json-file <path> 或 -（stdin）"})
+            sys.exit(2)
+        try:
+            body = _read_json_body(jf)
+        except (OSError, ValueError) as exc:
+            _emit({"error": str(exc)})
+            sys.exit(2)
+        # workspace_id 注入 body（setdefault，不覆盖调用方显式值）：服务端
+        # _with_workspace 只认 query/header，body 型 workspace_id 由各端点自行读取。
+        _ws = getattr(args, "workspace_id", None)
+        if body is not None and _ws and "workspace_id" not in body:
+            body["workspace_id"] = _ws
+        # query 同步注入：_with_workspace 的 workspace 解析只看 query/header，body 里的
+        # workspace_id 救不了 400（json_body 路由曾因此必挂——多工作空间环境一律报
+        # "workspace_id is required"，Agent 被迫弃用 dwcli 改手写 urllib 直调）。
+        json_query_params = {"workspace_id": _ws} if _ws else None
+        path = route["path"]
+        for pv in route.get("path_vars", []):
+            val = getattr(args, pv, None)
+            if val is None and group == "databases" and pv == "db":
+                val = _db_name_from_ref(getattr(args, "db_ref", None))
+            if val is not None:
+                path = path.replace(f"{{{pv}}}", urllib.parse.quote(str(val), safe=""))
+            else:
+                _emit({"error": f"缺少路径变量 --{pv.replace('_', '-')}："
+                       "db-ref 未自带库名（如 doris:// 或 sqlite://…），请显式传入"})
+                sys.exit(2)
+        result = _call_api(route["method"], path, json_query_params, body, base=base,
+                           absolute_path=route.get("absolute_path", False))
+        _emit(result)
+        sys.exit(_exit_code_for(result))
+
+    # instance wait：轮询至终态
+    if route.get("wait"):
+        try:
+            interval = float(getattr(args, "interval", None) or 2.0)
+            timeout_s = float(getattr(args, "timeout", None) or 1800.0)
+        except ValueError:
+            _emit({"error": "interval/timeout 必须是数字"})
+            sys.exit(2)
+        out, terminal = _wait_instance(args.id, timeout_s=timeout_s, interval=interval, base=base)
+        _emit(out)
+        sys.exit(0 if terminal and out.get("status") == "success" else 1 if terminal else 2)
+
+    # 收集 query params
+    query_params = {}
+    for q in route.get("query", []):
+        val = getattr(args, q, None)
+        if val is not None:
+            query_params[q] = val
+        elif q == "db_ref" and route.get("auto_default_ref"):
+            query_params[q] = _resolve_default_db_ref(getattr(args, "workspace_id", None))
+    # 全局 --workspace-id：对所有 HTTP 路由生效（P4-1）。ROUTES 已登记 workspace_id
+    # 的路由按正常 query 处理；未登记的路由统一在此注入，防静默吞参（历史陷阱）。
+    _ws = getattr(args, "workspace_id", None)
+    if _ws and "workspace_id" not in query_params and not route.get("absolute_path", False):
+        query_params["workspace_id"] = _ws
+    try:
+        query_params = _convert_ints(query_params, _INT_PARAM_NAMES)
+    except ValueError as exc:
+        _emit({"error": f"参数类型错误: {exc}"})
+        sys.exit(2)
+
+    # databases 组未传 --db-ref 时补当前工作空间业务库：fetch-flow.md 承诺
+    # 「--db-ref 可整段省略」，旧实现必报「缺少路径变量 --db」并 exit 2
+    # （dacomp 三会话实证：list-tables 全部失败）。
+    if group == "databases" and not query_params.get("db_ref"):
+        try:
+            default_ref = _resolve_default_db_ref(getattr(args, "workspace_id", None))
+        except Exception:  # noqa: BLE001 —— 解析失败保持原行为（下方报缺参）
+            default_ref = ""
+        if default_ref:
+            query_params["db_ref"] = default_ref
+
+    # 收集 path vars → 替换 path 中的 {var}
+    path = route["path"]
+    missing_pv = None
+    for pv in route.get("path_vars", []):
+        val = getattr(args, pv, None)
+        # databases 组的 db 缺省时从 --db-ref 推导（指针自带库名，如 doris://olist）
+        if val is None and group == "databases" and pv == "db":
+            val = _db_name_from_ref(query_params.get("db_ref") or getattr(args, "db_ref", None))
+        if val is not None:
+            path = path.replace(f"{{{pv}}}", urllib.parse.quote(str(val), safe=""))
+        else:
+            missing_pv = pv
+    if missing_pv:
+        _emit({"error": f"缺少路径变量 --{missing_pv.replace('_', '-')}："
+               "db-ref 未自带库名（如 doris:// 或 sqlite://…），请显式传入"})
+        sys.exit(2)
+
+    # 收集 body（值支持 @file 前缀，§6.1；文本参数 sql/code 另支持 --sql-file/--code-file 读原文）
+    body = {}
+    for b in route.get("body", []):
+        if b == "confirm":
+            body["confirm"] = getattr(args, "confirm", False)
+            continue
+        val = getattr(args, b, None)
+        if val is None and b in ("sql", "code"):
+            file_attr = getattr(args, f"{b}_file", None)
+            if file_attr is not None:
+                try:
+                    val = Path(file_attr).read_text(encoding="utf-8")
+                except OSError as exc:
+                    _emit({"error": f"读取 --{b}-file 失败: {exc}"})
+                    sys.exit(2)
+        if val is not None:
+            try:
+                body[b] = _resolve_value(val)
+            except (OSError, ValueError) as exc:
+                _emit({"error": str(exc)})
+                sys.exit(2)
+            if b in _JSON_BODY_PARAM_NAMES and isinstance(body[b], str):
+                try:
+                    body[b] = json.loads(body[b])
+                except json.JSONDecodeError as exc:
+                    _emit({"error": f"请求体参数 {b} 必须是合法 JSON: {exc}"})
+                    sys.exit(2)
+        elif b == "role":
+            body[b] = "business"
+        elif b == "db_ref" and route.get("auto_default_ref"):
+            body[b] = _resolve_default_db_ref(getattr(args, "workspace_id", None))
+
+    # flag
+    for f in route.get("flag", []):
+        body[f] = getattr(args, f, False)
+
+    # json_body 路由：workspace_id 注入 body（setdefault，不覆盖调用方显式值）。
+    # 服务端 _with_workspace 只认 query/header，POST body 的 workspace_id 由
+    # 各端点自行读取（dashboard import-from-report 等场景）。
+    if body and getattr(args, "workspace_id", None) and "workspace_id" not in body:
+        body["workspace_id"] = getattr(args, "workspace_id")
+
+    result = _call_api(route["method"], path, query_params, body or None, base=base,
+                       absolute_path=route.get("absolute_path", False))
+    _emit(result)
+    sys.exit(_exit_code_for(result))
+
+
+def _exit_code_for(result: dict) -> int:
+    """退出码映射（§6.1）：0 成功；1 业务失败（HTTP 4xx/5xx 或 ok:false）；2 连接/参数错误。"""
+    if result.get("status") != "error":
+        return 0
+    if "http_code" in result:
+        return 1
+    return 2
+
+
+if __name__ == "__main__":
+    main()
