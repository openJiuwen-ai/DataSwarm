+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { ensureDatasourceWorkspaceId, responseBelongsToCurrentWorkspace } from '../../../stores/datasourceWorkspaceStore';
+
+export interface KnowledgeAsset {
+  asset_id: string;
+  asset_type: string;
+  title: string;
+  content: string;
+  status: string;
+  revision: number;
+  scope?: Record<string, unknown>;
+  source?: Record<string, unknown>;
+  conflicts?: Array<{ asset_id: string; kind: string; title?: string; content?: string; status?: string; evidence?: string; name?: string }>;
+}
+
+export interface KnowledgeDocument {
+  version_id: string;
+  document_id: string;
+  source_id: string;
+  name: string;
+  sha256: string;
+  status: string;
+  created_at: string;
+  updated_at: string;
+  path?: string;
+  chunk_count?: number | null;
+  character_count?: number | null;
+  extraction_status?: string | null;
+  extraction_error?: string | null;
+  extraction_failed_batches?: number | null;
+}
+
+/** 后端错误 → 中文引导文案（技术细节保留在括号里，方便排查）。 */
+function friendlyError(payload: Record<string, unknown>, statusText: string): Error {
+  const raw = String(payload.detail ?? payload.error ?? statusText);
+  if (raw.includes('workspace_id is required') || raw.includes('WORKSPACE_CONTEXT')) {
+    return new Error('当前部署配置了多个工作空间，请先在数据源管理中选定工作空间后再使用业务知识');
+  }
+  if (raw === 'workspace_changed') {
+    return new Error('工作空间已切换，列表正在按新空间刷新');
+  }
+  if (raw.includes('doc_already_exists') || raw.includes('40901')) {
+    return new Error('同名文档已存在，请勿重复导入');
+  }
+  if (raw.includes('rule requires reviewed applicability')) {
+    return new Error('该规则未绑定适用范围。请编辑条目：绑定适用的指标/术语/表列/维度/场景，或声明为全工作空间生效');
+  }
+  if (raw.includes('mapping requires physical targets')) {
+    return new Error('该映射未绑定物理目标。请编辑条目：绑定来源表或列（如 orders.customer_state）');
+  }
+  if (raw.includes('need an authority link') || raw.includes('alignment decision')) {
+    return new Error('该候选发布前需权威对齐。术语留空会自动对齐（同名术语优先，否则新建术语）；'
+      + '指标需先在指标系统完成建模，再发布对齐');
+  }
+  if (raw.includes('must be modeled and published through the existing OSSIE')) {
+    return new Error('指标候选必须先在指标系统建模并发布（指标=SQL 口径，列名给不了），再对齐 metric:<key> 发布');
+  }
+  if (raw.includes('evidence no longer matches') || raw.includes('source document version is unavailable')) {
+    return new Error('该条目的证据已与源文档不一致（文档可能被删除或重新导入），请重新导入文档或编辑修正');
+  }
+  if (raw.includes('published assets are immutable')) {
+    return new Error('已发布的知识不可直接修改，请新建一条候选版本');
+  }
+  if (raw.includes('unresolved knowledge conflicts')) {
+    return new Error('存在未解决的冲突，请在条目上填写冲突处理结论后再评审');
+  }
+  return new Error(raw);
+}
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  const workspaceId = await ensureDatasourceWorkspaceId();
+  // url 可能已带 query（listAssets/listDocuments 的分页参数）——追加须判 & 还是 ?，
+  // 双问号会让 workspace_id 被吞、请求落到 default 空间（两页空列表的根因）。
+  const target = workspaceId
+    ? `${url}${url.includes('?') ? '&' : '?'}workspace_id=${encodeURIComponent(workspaceId)}`
+    : url;
+  const response = await fetch(target, {
+    ...init,
+    headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const payload = await response.json().catch(() => ({})) as Record<string, unknown>;
+  if (!response.ok) throw friendlyError(payload, response.statusText);
+  if (!responseBelongsToCurrentWorkspace(payload, workspaceId)) throw new Error('workspace_changed');
+  return payload as T;
+}
+
+export interface RetiredSource {
+  document_version_id: string;
+  name: string;
+  count: number;
+}
+
+export interface AssetListResult {
+  assets: KnowledgeAsset[];
+  total: number;
+  page: number;
+  page_size: number;
+  status_counts?: Record<string, number>;
+  type_counts?: Record<string, number>;
+}
+
+function buildQuery(params: Record<string, string | number | undefined>): string {
+  const search = new URLSearchParams();
+  for (const [key, value] of Object.entries(params)) {
+    if (value === undefined || value === '') continue;
+    if (typeof value === 'number' && value <= 0) continue;
+    search.set(key, String(value));
+  }
+  const query = search.toString();
+  return query ? `?${query}` : '';
+}
+
+export const knowledgeApi = {
+  listAssets: (params?: { status?: string; type?: string; page?: number; pageSize?: number }) =>
+    request<AssetListResult>(`/api/dataagent/knowledge/assets${buildQuery({
+      status: params?.status, type: params?.type, page: params?.page, page_size: params?.pageSize,
+    })}`),
+  parse: (path: string, sourceId: string) =>
+    request<{ version_id: string; quality: { chunk_count: number } }>('/api/dataagent/knowledge/documents/parse', {
+      method: 'POST', body: JSON.stringify({ path, source_id: sourceId }),
+    }),
+  upload: (file: File, sourceId: string) => new Promise<{ version_id: string; quality: { chunk_count: number } }>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onerror = () => reject(new Error('文件读取失败'));
+    reader.onload = async () => {
+      try {
+        const dataUrl = String(reader.result ?? '');
+        const contentBase64 = dataUrl.split(',', 2)[1] ?? '';
+        resolve(await request('/api/dataagent/knowledge/documents/upload', {
+          method: 'POST', body: JSON.stringify({ file_name: file.name, content_base64: contentBase64, source_id: sourceId }),
+        }));
+      } catch (error) { reject(error); }
+    };
+    reader.readAsDataURL(file);
+  }),
+  /** 批量提交后台抽取：立即返回，状态由文档列表轮询反映。 */
+  extractBatch: (versionIds: string[]) =>
+    request<{ queued: string[]; skipped: Array<{ version_id: string; reason: string }> }>(
+      '/api/dataagent/knowledge/documents/extract',
+      { method: 'POST', body: JSON.stringify({ version_ids: versionIds }) },
+    ),
+  extract: (versionId: string) =>
+    request<{ candidates: KnowledgeAsset[]; invalid_candidates: unknown[]; status?: string;
+      failed_batches?: Array<{ evidence_ids: string[]; reason: string }> }>(
+      `/api/dataagent/knowledge/documents/${encodeURIComponent(versionId)}/candidates/extract`, { method: 'POST', body: '{}' },
+    ),
+  createAsset: (payload: { asset_type: string; title: string; content: string; scope?: Record<string, unknown> }) =>
+    request<{ asset: KnowledgeAsset }>('/api/dataagent/knowledge/assets', {
+      method: 'POST', body: JSON.stringify({ ...payload, source: { origin: 'manual' } }),
+    }),
+  update: (assetId: string, payload: { title?: string; content?: string; scope?: Record<string, unknown>; source?: Record<string, unknown> }) =>
+    request<{ asset: KnowledgeAsset }>(`/api/dataagent/knowledge/assets/${encodeURIComponent(assetId)}/update`, {
+      method: 'POST', body: JSON.stringify(payload),
+    }),
+  transition: (assetId: string, action: 'approve' | 'publish' | 'retire', resolution = '') =>
+    request<{ asset: KnowledgeAsset }>(`/api/dataagent/knowledge/assets/${encodeURIComponent(assetId)}/transition`, {
+      method: 'POST', body: JSON.stringify({ action, resolution }),
+    }),
+  /** 已退役条目按来源文档聚合（供「按文档清理」下拉）。 */
+  retiredSources: () => request<{ sources: RetiredSource[] }>('/api/dataagent/knowledge/retired/sources'),
+  /** 物理清理已退役条目（审计事件保留）；三种条件至少给一个。 */
+  purgeRetired: (payload: { older_than_days?: number; document_version_id?: string; all?: boolean }) =>
+    request<{ deleted: number; asset_ids: string[] }>('/api/dataagent/knowledge/retired/purge', {
+      method: 'POST', body: JSON.stringify(payload),
+    }),
+  /** 提交知识派生后台任务（L1 schema 正则 + L2 LLM 深化）；绑定数据源时服务端也会自动触发。 */
+  runDerivation: () => request<{ status: string }>(
+    '/api/dataagent/knowledge/schema-enrichment/run', { method: 'POST', body: '{}' }),
+  listDocuments: (params?: { page?: number; pageSize?: number }) =>
+    request<{ documents: KnowledgeDocument[]; total: number; page: number; page_size: number }>(
+      `/api/dataagent/knowledge/documents${buildQuery({ page: params?.page, page_size: params?.pageSize })}`),
+  deleteDocument: (versionId: string) =>
+    request<{ version_id: string; retired_candidates: string[]; retire_failed: string[] }>(
+      `/api/dataagent/knowledge/documents/${encodeURIComponent(versionId)}`, { method: 'DELETE' }),
+};
