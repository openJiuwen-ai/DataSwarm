+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Unit tests for the dw-report skill.
+
+覆盖 SKILL.md 元信息、目录布局、图表 option、HTML 渲染、内联装配与产物门禁。
+"""
+from __future__ import annotations
+
+import importlib
+import json
+import re
+from pathlib import Path
+
+import pandas as pd
+import pytest
+import yaml
+
+SKILL_DIR = (
+    Path(__file__).resolve().parents[3]
+    / "jiuwenswarm"
+    / "resources"
+    / "agent"
+    / "workspace"
+    / "skills"
+    / "dw-report"
+)
+SCRIPTS = SKILL_DIR / "scripts"
+ASSETS = SKILL_DIR / "assets"
+
+
+def _parse_skill_md(path: Path) -> dict:
+    text = path.read_text(encoding="utf-8")
+    match = re.match(r"^---\s*\n(.*?)\n---\s*\n?(.*)", text, re.DOTALL)
+    assert match, f"SKILL.md frontmatter not found in {path}"
+    return yaml.safe_load(match.group(1)) or {}
+
+
+@pytest.fixture
+def modules(monkeypatch):
+    """加载 dw-report 的脚本模块（charts / render / inline / verify）。"""
+    monkeypatch.syspath_prepend(str(SCRIPTS))
+    return {
+        "options": importlib.import_module("charts.options"),
+        "page": importlib.import_module("render.page"),
+        "blocks": importlib.import_module("render.blocks"),
+        "resolver": importlib.import_module("resolver"),
+        "inline": importlib.import_module("inline_assets"),
+        "verify": importlib.import_module("verify"),
+    }
+
+
+def test_frontmatter():
+    meta = _parse_skill_md(SKILL_DIR / "SKILL.md")
+    assert meta["name"] == "dw-report"
+    assert meta["description"]
+    assert meta["allowed_tools"] == ["code", "bash", "read_file", "write_file"]
+
+
+def test_layout():
+    assert (SKILL_DIR / "SKILL.md").is_file()
+    for name in ("schema.md", "blocks.md", "quality.md", "themes.md"):
+        assert (SKILL_DIR / "reference" / name).is_file()
+    assert (SCRIPTS / "dw_report.py").is_file()
+    assert (SCRIPTS / "charts" / "options.py").is_file()
+    assert (SCRIPTS / "render" / "page.py").is_file()
+    assert (ASSETS / "echarts.min.js").is_file()
+
+
