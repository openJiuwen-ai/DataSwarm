+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""glossary/api.py —— 术语库 HTTP API（/api/dataagent/glossary）。
+
+对齐 builder/controller.py 的 is_route/_split/_read_body 模式。底层 HTTP
+网关只把 GET/POST 分发进 dataagent（app_web.py do_PUT/do_DELETE 仅走代理），
+更新与软删用 POST 子动作表达。
+
+写路径钩子（方案 P0 §7.1）：单条 CRUD 落库后调 sync.publish_term 实时同步
+双投影；import 后走一次 reconcile（幂等批量对账）。sync 状态随响应透出，
+不影响写操作的成功语义。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import unquote
+
+from . import db, recall, sync
+
+_PREFIX = "/api/dataagent/glossary"
+
+
+def is_route(path: str) -> bool:
+    """Return whether a path belongs to glossary APIs."""
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    return path[len(_PREFIX):].rstrip("/").split("/")
+
+
+def _read_body(handler) -> dict | None:
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except ValueError:
+        return None
+    if not length:
+        return {}
+    try:
+        body = json.loads(handler.rfile.read(length).decode("utf-8"))
+    except ValueError:
+        return None
+    return body if isinstance(body, dict) else None
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    try:
+        if len(parts) == 2 and parts[1] == "terms":
+            keyword = handler._query_arg(parsed, "keyword") or None
+            status = handler._query_arg(parsed, "status") or None
+            include_deprecated = (handler._query_arg(parsed, "include_deprecated") or "") in {"1", "true"}
+            terms = db.list_terms(keyword, status, include_deprecated)
+            handler._write_json(200, {"terms": terms})
+            return
+        if len(parts) == 3 and parts[1] == "terms":
+            term = db.get_term(unquote(parts[2]))
+            if not term:
+                handler._write_json(404, {"error": "not_found"})
+                return
+            term["vector_count"] = sync.vector_count(term["term_id"])
+            handler._write_json(200, term)
+            return
+        # GET /resolve —— 召回测试观测（三级召回明细，设计 §6.4）
+        if len(parts) == 2 and parts[1] == "resolve":
+            query = handler._query_arg(parsed, "q") or ""
+            limit = int(handler._query_arg(parsed, "limit") or 10)
+            handler._write_json(200, recall.resolve(query, limit))
+            return
+    except ValueError as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:  # noqa: BLE001
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = _read_body(handler)
+    if body is None:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        # POST /terms —— 新建
+        if len(parts) == 2 and parts[1] == "terms":
+            term = db.create_term(body)
+            handler._write_json(200, {"term": term, "sync": sync.publish_term(term)})
+            return
+        # POST /terms/import —— 批量导入
+        if len(parts) == 3 and parts[1] == "terms" and parts[2] == "import":
+            items = body.get("items")
+            if not isinstance(items, list) or not items:
+                handler._write_json(400, {"error": "bad_request", "detail": "items 必须是非空数组"})
+                return
+            result = db.import_terms(items)
+            result["sync"] = sync.reconcile()
+            handler._write_json(200, result)
+            return
+        # POST /reindex | /reconcile —— 运维兜底
+        if len(parts) == 2 and parts[1] == "reindex":
+            handler._write_json(200, sync.reindex())
+            return
+        if len(parts) == 2 and parts[1] == "reconcile":
+            handler._write_json(200, sync.reconcile())
+            return
+        # POST /terms/{term_id}/update | /delete
+        if len(parts) == 4 and parts[1] == "terms" and parts[3] in {"update", "delete"}:
+            term_id = unquote(parts[2])
+            if parts[3] == "update":
+                updated = db.update_term(term_id, body)
+                if not updated:
+                    handler._write_json(404, {"error": "not_found"})
+                    return
+                handler._write_json(200, {"term": updated, "sync": sync.publish_term(updated)})
+                return
+            removed = db.delete_term(term_id)
+            if not removed:
+                handler._write_json(404, {"error": "not_found"})
+                return
+            handler._write_json(200, {"term": removed, "sync": sync.publish_term(removed, deleted=True)})
+            return
+    except ValueError as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:  # noqa: BLE001
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
