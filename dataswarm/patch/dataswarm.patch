+# ==========================================================================
+# G1 全绿路径
+# ==========================================================================
+
+def test_g1_full_pass(semantic_env):
+    sql = ("SELECT orders.region, SUM(orders.amount_cny) AS gmv FROM orders "
+           "WHERE orders.pay_status = 'paid' "
+           "AND orders.paid_at >= '2026-07-01' AND orders.paid_at < '2026-10-01' "
+           "GROUP BY orders.region")
+    result = checks.check_request(_body(sql))
+    assert result["grounding_level"] == "G1"
+    assert result["definition_grounded"] is True
+    assert result["authoritative"] is False
+    assert result["non_authoritative_reasons"] == ["no_semantic_provider"]
+    assert _check_of(result, "scope_membership")["status"] == "pass"
+    assert _check_of(result, "tables_columns_subset_binding")["status"] == "pass"
+    assert _check_of(result, "groupby_subset_whitelist")["status"] == "pass"
+    assert _check_of(result, "fixed_filters_present")["status"] == "pass"
+    assert _check_of(result, "time_boundary_shape")["status"] == "pass"
