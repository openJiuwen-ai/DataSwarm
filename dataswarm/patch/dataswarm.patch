@@ -0,0 +1,323 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""指标 Neo4j 投影与发布链路测试（深集成 P2）。
+
+覆盖 graph_projection（投影构建/先删后写/脱敏守卫/跨 namespace 边降级）、
+semantic_link.ensure_semantic_refs（严格单一通道三态）与 reproject 运维入口。
+图适配器一律用同事 InMemorySemanticaAdapter（绝连真实 Neo4j——单测红线）。
+"""
+from __future__ import annotations
+
+import json
+
+from jiuwenswarm.channels.web.dataagent.metrics import graph_projection, semantic_link, store, versioning
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, WORKSPACE, write_published_snapshot
+
+GMV = "commerce.gmv"
+AOV = "commerce.aov"
+
+
+def _publish(e2e, *, confirm: bool = True) -> dict:
+    """导入 +（可选）确认 + 写语义快照 + 发布（注入 InMemory 图适配器）。"""
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    if confirm:
+        for revision_id in revision_ids:
+            for mapping in store.list_concept_maps(revision_id, status="candidate"):
+                if mapping.relation_type in ("numerator", "denominator"):
+                    versioning.confirm_mapping(mapping.mapping_id, confirmed_by="proj-test")
+    write_published_snapshot(e2e)
+    release = versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+        label="proj", published_by="t")
+    return {"release": release, "revision_ids": revision_ids}
+
+
+def _projection_of(adapter) -> tuple:
+    """InMemory adapter 里当前 staged 的 projection（nodes, edges）。"""
+    stage_id = (f"{graph_projection.metrics_namespace(WORKSPACE)}/staging/"
+                f"{adapter.published[graph_projection.metrics_namespace(WORKSPACE)]}")
+    _ns, _version, projection = adapter.stages[stage_id]
+    return projection.nodes, projection.edges
+
+
+# ==========================================================================
+# 投影形态与脱敏
+# ==========================================================================
+def test_projection_nodes_carry_metric_identity_without_raw_expression(e2e):
+    """Metric 单节点带身份/口径摘要属性，绝无表达式原文。"""
+    _publish(e2e)
+    nodes, _edges = _projection_of(e2e["graph_adapter"])
+    by_id = {n.id: n for n in nodes}
+    gmv_id = graph_projection.metric_node_id(WORKSPACE, GMV)
+    assert gmv_id in by_id, "GMV 节点必须存在"
+    props = by_id[gmv_id].properties
+    assert props["metricKey"] == GMV
+    assert props["displayName"]
+    assert props["definitionHash"]
+    assert props["authority"] == "dataswarm"
+    assert props["releaseId"]
+    # 脱敏红线：公式摘要是合法形态（SUM(订单金额)），拦的是可执行 SQL 原文
+    blob = json.dumps({n.id: n.properties for n in nodes}, ensure_ascii=False)
+    for forbidden in ("CASE WHEN", "SELECT ", "sqlite://", "password"):
+        assert forbidden not in blob, f"{forbidden} 泄漏进指标图"
+
+
+def test_projection_edges_confirm_relations_only(e2e):
+    """confirmed 映射 → dependsOn/numerator/denominator；candidate 不投影。"""
+    _publish(e2e, confirm=False)
+    # 未确认：AOV 的 numerator/denominator 候选不产边
+    _nodes, edges = _projection_of(e2e["graph_adapter"])
+    assert not [e for e in edges if e.type in ("numerator", "denominator")]
+
+    _publish(e2e, confirm=True)  # 同一 e2e 环境二次发布（幂等场景见下）
+    _nodes2, edges2 = _projection_of(e2e["graph_adapter"])
+    kinds = {(e.source, e.type, e.target) for e in edges2}
+    aov_id = graph_projection.metric_node_id(WORKSPACE, AOV)
+    gmv_id = graph_projection.metric_node_id(WORKSPACE, GMV)
+    assert (aov_id, "numerator", gmv_id) in kinds
+    assert (aov_id, "denominator",
+            graph_projection.metric_node_id(WORKSPACE, "commerce.paid_order_count")) in kinds
+
+
+# ==========================================================================
+# 先删后写（整 namespace 替换）与幂等
+# ==========================================================================
+def test_publish_deletes_namespace_before_write(e2e):
+    """整 namespace 先删后写：delete_calls 必须先于 stage 出现，且全量替换。"""
+    adapter = e2e["graph_adapter"]
+    _publish(e2e)
+    assert adapter.delete_calls, "发布必须先清空 metrics namespace"
+    assert all(ns == graph_projection.metrics_namespace(WORKSPACE)
+               for ns, _ids in adapter.delete_calls)
+
+    nodes1, _ = _projection_of(adapter)
+    _publish(e2e)  # 二次发布（幂等）
+    assert len(adapter.delete_calls) == 2, "每次发布都要整 namespace 替换"
+    nodes2, _ = _projection_of(adapter)
+    assert {n.id for n in nodes1} == {n.id for n in nodes2}, "同指标集幂等"
+
+
+# ==========================================================================
+# 跨 namespace 边：协议未落地 → 降级；落地 → 直写
+# ==========================================================================
+def test_cross_edges_degrade_without_protocol(e2e):
+    """InMemory（无 create_cross_edges）→ cross_edges_unsupported，发布照常成功。"""
+    outcome = _publish_and_get_outcome(e2e)
+    assert outcome["status"] == "published"
+
+
+def _publish_and_get_outcome(e2e) -> dict:
+    _publish(e2e)
+    release = store.get_active_release(WORKSPACE)
+    assert release is not None
+    return {"status": release.projection_status}
+
+
+def test_cross_edges_written_when_protocol_available(e2e):
+    """适配器实现 create_cross_edges 后：usesTable/timeField 跨边直写。"""
+
+    class _CrossCapableAdapter:
+        """包一层 InMemory + create_cross_edges 记录（协议落地的替身）。"""
+
+        def __init__(self, inner) -> None:
+            self.inner = inner
+            self.cross_calls: list = []
+
+        def __getattr__(self, name):
+            return getattr(self.inner, name)
+
+        def create_cross_edges(self, namespace, edges):
+            self.cross_calls.append((namespace, list(edges)))
+            return {"created": len(edges), "missed": 0}
+
+    wrapper = _CrossCapableAdapter(e2e["graph_adapter"])
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="cross-test")
+    write_published_snapshot(e2e)
+    versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=wrapper, label="cross", published_by="t")
+
+    assert wrapper.cross_calls, "协议可用时跨 namespace 边必须直写"
+    _ns, edges = wrapper.cross_calls[0]
+    kinds = {e.type for e in edges}
+    assert "usesTable" in kinds
+    assert "timeField" in kinds
+    # 端点是 physical 稳定 ID（tbl:/col: 前缀）
+    targets = [e.target for e in edges]
+    assert all(t.startswith(("tbl:", "col:")) for t in targets if t)
+    assert any(t.startswith("tbl:mysql:biz_sales:app.orders") for t in targets)
+
+
+def test_cross_edges_skipped_when_snapshot_missing(e2e):
+    """快照解析不到（源未采集）→ 不产悬空跨边，发布照常。"""
+    import sqlite3
+
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="miss-test")
+    # 不写语义快照 → 发布时 ensure_semantic_refs 降级 + 跨边无锚点
+    with sqlite3.connect(str(e2e["tmp_path"] / "meta.db")) as conn:
+        conn.execute("DELETE FROM dw_semantic_snapshots")
+    release = versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+        label="no-snapshot", published_by="t")
+    assert release.status == "published"
+    assert any("semantic_not_collected" in w
+               for w in (release.manifest or {}).get("schema_warnings", []))
+
+
+# ==========================================================================
+# ensure_semantic_refs：严格单一通道三态
+# ==========================================================================
+def test_ensure_semantic_refs_verifies_against_snapshot(e2e):
+    """快照全存在 → 绑定 verified + refs 记录（源/快照锚点）。"""
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revisions = [r.revision_id for m in store.list_defs(WORKSPACE)
+                 for r in store.list_revisions(m.metric_id)]
+    bindings_by_revision = {rid: store.list_bindings(rid) for rid in revisions}
+    write_published_snapshot(e2e)
+
+    warnings: list[str] = []
+    refs = semantic_link.ensure_semantic_refs(WORKSPACE, bindings_by_revision, warnings)
+    assert refs == [{"source_id": "biz_sales", "snapshot_id": "snapshot-biz_sales-001"}]
+    assert not warnings
+    for bindings in bindings_by_revision.values():
+        for binding in bindings:
+            updated = next(b for b in store.list_bindings(binding.revision_id)
+                           if b.binding_id == binding.binding_id)
+            assert updated.verify_status == "verified"
+
+
+def test_ensure_semantic_refs_fails_when_source_not_collected(e2e):
+    """源未采集 → 绑定 failed(semantic_not_collected) + warning，不抛。"""
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revisions = [r.revision_id for m in store.list_defs(WORKSPACE)
+                 for r in store.list_revisions(m.metric_id)]
+    bindings_by_revision = {rid: store.list_bindings(rid) for rid in revisions}
+
+    warnings: list[str] = []
+    refs = semantic_link.ensure_semantic_refs(WORKSPACE, bindings_by_revision, warnings)
+    assert refs == []
+    assert any("semantic_not_collected" in w for w in warnings)
+    for bindings in bindings_by_revision.values():
+        for binding in bindings:
+            updated = next(b for b in store.list_bindings(binding.revision_id)
+                           if b.binding_id == binding.binding_id)
+            assert updated.verify_status == "failed"
+            assert "semantic_not_collected" in (updated.verify_detail or "")
+
+
+def test_ensure_semantic_refs_fails_on_column_drift(e2e):
+    """表列在快照中缺失（结构漂移）→ 绑定 failed + warning，不抛。"""
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revisions = [r.revision_id for m in store.list_defs(WORKSPACE)
+                 for r in store.list_revisions(m.metric_id)]
+    # 采集快照后，业务库加一列并重写快照不含该列（模拟绑定声明了快照没有的列）：
+    # 直接构造——绑定列集里塞一个快照没有的列
+    write_published_snapshot(e2e)
+    bindings_by_revision = {rid: store.list_bindings(rid) for rid in revisions}
+    first_binding = next(b for bindings in bindings_by_revision.values() for b in bindings)
+    import dataclasses
+
+    drifted = dataclasses.replace(
+        first_binding,
+        column_map={**first_binding.column_map, "no_such_column": "no_such_column"})
+    warnings: list[str] = []
+    refs = semantic_link.ensure_semantic_refs(
+        WORKSPACE, {first_binding.revision_id: [drifted]}, warnings)
+    assert any("binding_columns_missing" in w for w in warnings)
+    # 单 binding 漂移不影响其他源 refs 判定：本例只有一源，其表校验先过、列校验
+    # 挂 → 绑定 failed，refs 不记
+    assert refs == []
+    updated = next(b for b in store.list_bindings(first_binding.revision_id)
+                   if b.binding_id == first_binding.binding_id)
+    assert updated.verify_status == "failed"
+
+
+# ==========================================================================
+# 发布失败语义：投影失败不阻断发布（reproject 可修）
+# ==========================================================================
+def test_projection_failure_does_not_block_publish(e2e):
+    """图适配器炸 → release 照常 published + projection_status=failed。"""
+
+    class _BrokenAdapter:
+        def delete_graph_nodes(self, *a, **k):
+            raise RuntimeError("neo4j connection refused")
+
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    write_published_snapshot(e2e)
+    release = versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=_BrokenAdapter(),
+        label="broken", published_by="t")
+    assert release.status == "published"
+    assert release.projection_status == "failed"
+    stored = store.get_release(release.release_id)
+    assert stored.projection_status == "failed"
+    assert "neo4j connection refused" in (stored.error_message or "")
+
+    # reproject 修复：换好适配器重投影 → release 行不改（幂等），图重写
+    outcome = graph_projection.reproject_workspace(WORKSPACE, adapter=e2e["graph_adapter"])
+    assert outcome["node_count"] > 0
+    assert store.get_release(release.release_id).status == "published"
+
+
+def test_glossary_exact_match_links_concept_term(e2e):
+    """measuresConcept 精确命中 glossary 术语 → 跨边指向 term 稳定 ID。"""
+    import sqlite3
+
+    # 建 glossary 表 + 插一个与概念 target_ref 同名的术语
+    ddl_dir = None
+    from pathlib import Path
+
+    ddl_dir = Path(__file__).resolve().parents[3] / "deploy" / "schema" / "ddl"
+    with sqlite3.connect(str(e2e["tmp_path"] / "meta.db")) as conn:
+        for ddl_file in sorted(ddl_dir.glob("dw_ontology_terms.ddl.sqlite.sql")):
+            conn.execute(ddl_file.read_text(encoding="utf-8").strip())
+        conn.execute(
+            "INSERT INTO dw_ontology_terms (term_id, name, definition, synonyms, status,"
+            " owner, source, tags, fingerprint, created_at, updated_at)"
+            " VALUES ('term-1', 'Order', '订单本体', '[]', 'active', 't', 'manual',"
+            " '', 'fp', '2026-10-12', '2026-10-12')")
+
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    write_published_snapshot(e2e)
+    # Ossie 样例的 subject（如 …/commerce/Order）会产 measuresConcept 候选；
+    # 未确认映射不投影——这里直接验证 _glossary_term_node_id 的匹配逻辑
+    assert graph_projection._glossary_term_node_id(WORKSPACE, "Order") == \
+        f"term:{WORKSPACE}:term-1"
+    assert graph_projection._glossary_term_node_id(WORKSPACE, "OrderX") is None, \
+        "模糊命中不得产边（只做精确全等）"
+    release = versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+        label="glossary", published_by="t")
+    assert release.projection_status == "published"
