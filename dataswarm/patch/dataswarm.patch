+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""semantica.py 图读侧单测（阶段 D：read_neighbors 协议）。
+
+- InMemory：publish 保留投影后可读——方向/边型过滤、对端节点属性、跨
+  namespace 边遍历、limit、非法 direction 拒绝
+- GraphBuilder（Neo4j）：假 _store 捕获 Cypher 形状（参数化 id、无方向
+  分支拼装），Python 侧方向/边型过滤与对端属性选择
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.semantic.graph import (
+    GraphEdge,
+    GraphNode,
+    GraphProjection,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.semantica import (
+    GraphBuilderSemanticaAdapter,
+    InMemorySemanticaAdapter,
+)
+
+
+def _publish(adapter: InMemorySemanticaAdapter, namespace: str, version: str,
+             nodes: list[GraphNode], edges: list[GraphEdge]) -> None:
+    stage_id = adapter.stage(namespace, version, GraphProjection(nodes=nodes, edges=edges))
+    adapter.validate(stage_id)
+    adapter.publish(stage_id)
+
+
+def _physical_graph() -> tuple[list[GraphNode], list[GraphEdge]]:
+    nodes = [
+        GraphNode("tbl:mysql:src:shop.orders", "SourceTable", {"name": "orders"}),
+        GraphNode("col:mysql:src:shop.orders.amount_cny", "SourceColumn", {"name": "amount_cny"}),
+        GraphNode("col:mysql:src:shop.orders.region", "SourceColumn", {"name": "region"}),
+    ]
+    edges = [
+        GraphEdge("tbl:mysql:src:shop.orders", "col:mysql:src:shop.orders.amount_cny",
+                  "hasColumn", {}),
+        GraphEdge("tbl:mysql:src:shop.orders", "col:mysql:src:shop.orders.region",
+                  "hasColumn", {}),
+    ]
+    return nodes, edges
+
+
+# ==========================================================================
+# InMemory 读侧
+# ==========================================================================
+
+def test_inmemory_read_after_publish():
+    adapter = InMemorySemanticaAdapter()
+    nodes, edges = _physical_graph()
+    _publish(adapter, "physical/default/src", "v1", nodes, edges)
+    records = adapter.read_neighbors(["tbl:mysql:src:shop.orders"], direction="out")
+    assert {r["target"] for r in records} == {
+        "col:mysql:src:shop.orders.amount_cny",
+        "col:mysql:src:shop.orders.region",
+    }
+    # 对端节点属性带上
+    assert all(r["node_properties"].get("name") for r in records)
+
+
+def test_inmemory_direction_and_type_filters():
+    adapter = InMemorySemanticaAdapter()
+    nodes, edges = _physical_graph()
+    _publish(adapter, "physical/default/src", "v1", nodes, edges)
+    # in 方向：从列看表
+    records = adapter.read_neighbors(["col:mysql:src:shop.orders.region"], direction="in")
+    assert [r["source"] for r in records] == ["tbl:mysql:src:shop.orders"]
+    assert records[0]["direction"] == "in"
+    # 边型白名单：hasColumn 之外的边被滤掉
+    records = adapter.read_neighbors(
+        ["tbl:mysql:src:shop.orders"], edge_types=["usesColumn"])
+    assert records == []
+
+
+def test_inmemory_reads_cross_namespace_edges():
+    """跨 namespace 边（publish 的 graph 之外）同样可读——L2 图补全的关键路径。"""
+    adapter = InMemorySemanticaAdapter()
+    nodes, edges = _physical_graph()
+    _publish(adapter, "physical/default/src", "v1", nodes, edges)
+    adapter.create_cross_edges("metrics/default", [
+        GraphEdge("metric:mysql:src:commerce.gmv",
+                  "col:mysql:src:shop.orders.amount_cny", "usesColumn",
+                  {"logical": "amount"}),
+    ])
+    records = adapter.read_neighbors(
+        ["col:mysql:src:shop.orders.amount_cny"], direction="in")
+    sources = {r["source"] for r in records}
+    assert "metric:mysql:src:commerce.gmv" in sources
+    by_type = {r["type"]: r for r in records}
+    assert by_type["usesColumn"]["edge_properties"] == {"logical": "amount"}
+
+
+def test_inmemory_limit_and_invalid_direction():
+    adapter = InMemorySemanticaAdapter()
+    nodes = [GraphNode(f"n{i}", "T", {}) for i in range(5)]
+    edges = [GraphEdge("n0", f"n{i}", "rel", {}) for i in range(1, 5)]
+    _publish(adapter, "ns", "v1", nodes, edges)
+    assert len(adapter.read_neighbors(["n0"], limit=2)) == 2
+    with pytest.raises(ValueError, match="direction"):
+        adapter.read_neighbors(["n0"], direction="sideways")
+
+
+def test_inmemory_unpublished_namespace_not_readable():
+    adapter = InMemorySemanticaAdapter()
+    assert adapter.read_neighbors(["anything"]) == []
+
+
+# ==========================================================================
+# GraphBuilder（Neo4j）读侧：假 store 捕获 Cypher
+# ==========================================================================
+
+class FakeStore:
+    """捕获 execute_query 的 Cypher/参数并返回预置 records。"""
+
+    def __init__(self, records: list[dict]):
+        self.records = records
+        self.calls: list[tuple[str, dict]] = []
+
+    def execute_query(self, query, parameters):
+        self.calls.append((query, dict(parameters)))
+        return {"records": self.records}
+
+
+def _graph_builder(store: FakeStore) -> GraphBuilderSemanticaAdapter:
+    adapter = GraphBuilderSemanticaAdapter.__new__(GraphBuilderSemanticaAdapter)
+    adapter._store = store
+    adapter._builder_type = object
+    adapter._stages = {}
+    return adapter
+
+
+def test_graph_builder_cypher_shape_and_python_filtering():
+    store = FakeStore([
+        # 命中：gmv -usesColumn-> amount（seed 为 target 端，in 方向）
+        {"source": "metric:gmv", "target": "col:amount", "rel_type": "usesColumn",
+         "edge_properties": {}, "source_properties": {"name": "gmv"},
+         "target_properties": {"name": "amount"}},
+        # 边型不符：被 Python 侧滤掉
+        {"source": "tbl:orders", "target": "col:amount", "rel_type": "hasColumn",
+         "edge_properties": {}, "source_properties": {}, "target_properties": {}},
+        # 两端都不在 seeds：Cypher 已滤（此处模拟漏网），Python 再兜一层
+        {"source": "tbl:x", "target": "col:y", "rel_type": "usesColumn",
+         "edge_properties": {}, "source_properties": {}, "target_properties": {}},
+    ])
+    adapter = _graph_builder(store)
+    records = adapter.read_neighbors(
+        ["col:amount"], edge_types=["usesColumn"], direction="in")
+    assert len(records) == 1
+    assert records[0]["source"] == "metric:gmv"
+    assert records[0]["direction"] == "in"
+    # 对端 = source 侧（in 方向时对端是 source 节点）
+    assert records[0]["node_properties"] == {"name": "gmv"}
+    # Cypher 形状：id 参数化 + 无方向分支拼装
+    query, params = store.calls[0]
+    assert "$ids" in query and "$cap" in query
+    assert params["ids"] == ["col:amount"]
+    assert "MATCH (a)-[r]->(b)" in query
+
+
+def test_graph_builder_out_direction_prefers_target_endpoint():
+    store = FakeStore([
+        {"source": "metric:gmv", "target": "col:amount", "rel_type": "usesColumn",
+         "edge_properties": {}, "source_properties": {"name": "gmv"},
+         "target_properties": {"name": "amount"}},
+    ])
+    adapter = _graph_builder(store)
+    records = adapter.read_neighbors(["metric:gmv"], direction="out")
+    assert records[0]["node_properties"] == {"name": "amount"}
+
+
+def test_graph_builder_rejects_illegal_edge_type():
+    adapter = _graph_builder(FakeStore([]))
+    with pytest.raises(ValueError, match="illegal relationship type"):
+        adapter.read_neighbors(["x"], edge_types=["usesColumn; DROP"])
+
+
+def test_graph_builder_empty_ids_short_circuits():
+    store = FakeStore([])
+    adapter = _graph_builder(store)
+    assert adapter.read_neighbors([], direction="both") == []
+    assert store.calls == []
