+
+await build({
+  entryPoints: ['src/features/_shared/ui/Feedback.tsx'],
+  outfile: 'node_modules/.cache/feedback-confirm/Feedback.mjs',
+  bundle: true,
+  packages: 'external',
+  platform: 'node',
+  format: 'esm',
+  loader: { '.css': 'empty' },
+});
+const dom = new JSDOM('<!doctype html><html><body><div id="root"></div></body></html>');
+for (const [key, value] of Object.entries({
+  window: dom.window,
+  document: dom.window.document,
+  HTMLElement: dom.window.HTMLElement,
+  IS_REACT_ACT_ENVIRONMENT: true,
+})) {
+  Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+}
+const { act, createElement } = await import('react');
+const { createRoot } = await import('react-dom/client');
+const { ConfirmHost, confirmDialog } = await import('../node_modules/.cache/feedback-confirm/Feedback.mjs');
+const resources = {};
+for (const language of ['zh', 'en']) {
+  resources[language] = { translation: JSON.parse(await readFile(`src/i18n/locales/${language}.json`, 'utf8')) };
+}
+await i18next.use(initReactI18next).init({ lng: 'zh', resources });
+
+test('shared confirmation keeps translated actions and resolution behavior', async () => {
+  const root = createRoot(document.getElementById('root'));
+  await act(async () => root.render(createElement(ConfirmHost)));
+  try {
