+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/plan.py —— L2④ QueryPlan 程序校验（LLM 提议，程序校验）。
+
+校验项（方案计划门禁）：
+- 结构：必需字段、component_id 唯一、component ≤ 5（超出在计划阶段拆批）；
+- 引用存在性：selected_metrics ⊆ 候选榜；dimensions ⊆ 选定指标维度白名单；
+  filters.field ⊆ schema 子包列集；
+- 依赖：depends_on 引用存在的 component 且无环；
+- 过滤值：未命中维值候选的过滤标 ``pending``（待确认——L3 不得当作已确认值）。
+
+校验**不裁决**计划质量（拆分是否合理由模型负责），只守引用与结构边界；
+400 + 逐项 errors 供模型修正后重提（≤2 次由编排层预算控制）。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from .model import (
+    ComponentFilter,
+    PlanComponent,
+    QueryPlan,
+)
+from .open_analysis import (
+    CLOSED_MAX_COMPONENTS,
+    OPEN_MAX_COMPONENTS,
+    normalize_open_plan,
+    validate_open_plan,
+)
+
+# 方案预算：closed 计划 component ≤ CLOSED_MAX_COMPONENTS（5），超出在计划阶段拆批或请用户收窄
+
+_ALLOWED_FILTER_OPS = {"=", "!=", "<>", ">", ">=", "<", "<=", "IN", "NOT IN", "LIKE"}
+
+# 时间字段必需键（dimension/start/end_exclusive；grain/timezone 可选）
+_TIME_REQUIRED_KEYS = ("dimension", "start", "end_exclusive")
+
+
+def parse_and_validate(
+    payload: dict[str, Any],
+    candidate_metric_keys: set[str],
+    scope_tables: dict[str, list[str]],
+    *,
+    material_ids: set[str] | None = None,
+) -> tuple[QueryPlan | None, list[dict[str, str]]]:
+    """解析 + 校验 QueryPlan。
+
+    Args:
+        payload: 请求体的 ``plan`` 段（components/uncovered/...）。
+        candidate_metric_keys: 候选指标集（含直发 + 图补全；selected 只能从中选）。
+        scope_tables: schema 子包的表列白名单（表名 → 列名列表）。
+
+    Returns:
+        ``(plan, errors)``——plan 为 None 时 errors 非空（400 回喂）。
+    """
+    errors: list[dict[str, str]] = []
+    if not isinstance(payload, dict):
+        return None, [{"component_id": "", "field": "plan", "message": "plan 必须是对象"}]
+    # 开放分析契约校验后再规范化；closed 默认保持旧计划兼容。
+    errors.extend({"component_id": "", **error} for error in validate_open_plan(payload, material_ids=material_ids))
+    if errors:
+        return None, errors
+    payload = normalize_open_plan(payload)
+    analysis_id = str(payload.get("analysis_id") or "")
+    question = str(payload.get("question") or "")
+    if not question:
+        errors.append({"component_id": "", "field": "question", "message": "question 必填"})
+    source_id = str(payload.get("source_id") or "")
+    release_id = str(payload.get("release_id") or "active")
+
+    components_raw = payload.get("components") or []
+    if not isinstance(components_raw, list) or not components_raw:
+        errors.append({"component_id": "", "field": "components", "message": "components 不能为空"})
+        return None, errors
+    max_components = OPEN_MAX_COMPONENTS if payload["mode"] == "open" else CLOSED_MAX_COMPONENTS
+    if len(components_raw) > max_components:
+        errors.append({
+            "component_id": "", "field": "components",
+            "message": f"component 数 {len(components_raw)} 超上限 {max_components}，请拆批或收窄问题",
+        })
+
+    all_columns = {column for columns in scope_tables.values() for column in columns}
+    components: list[PlanComponent] = []
+    seen_ids: set[str] = set()
+    for raw in components_raw:
+        component, component_errors = _parse_component(
+            raw, candidate_metric_keys, all_columns)
+        errors.extend(component_errors)
+        if component is None:
+            continue
+        if component.component_id in seen_ids:
+            errors.append({
+                "component_id": component.component_id, "field": "component_id",
+                "message": "component_id 重复"})
+            continue
+        seen_ids.add(component.component_id)
+        components.append(component)
+
+    # 依赖引用 + 无环
+    for component in components:
+        for dep in component.depends_on:
+            if dep not in seen_ids:
+                errors.append({
+                    "component_id": component.component_id, "field": "depends_on",
+                    "message": f"依赖 {dep} 不在计划内"})
+    _check_acyclic(components, errors)
+
+    if errors:
+        return None, errors
+    plan = QueryPlan(
+        analysis_id=analysis_id or "",
+        question=question,
+        source_id=source_id,
+        release_id=release_id,
+        components=tuple(components),
+        uncovered=tuple(str(item) for item in payload.get("uncovered") or []),
+        mode=payload["mode"],
+        facets=tuple(payload["facets"]),
+        coverage=dict(payload.get("coverage") or {}),
+        budget=dict(payload.get("budget") or {}),
+    )
+    return plan, []
+
+
+def _parse_component(
+    raw: dict[str, Any],
+    candidate_metric_keys: set[str],
+    all_columns: set[str],
+) -> tuple[PlanComponent | None, list[dict[str, str]]]:
+    """单 component 解析 + 字段级校验。"""
+    errors: list[dict[str, str]] = []
+    component_id = str(raw.get("component_id") or "")
+    text = str(raw.get("text") or "")
+    if not component_id:
+        errors.append({"component_id": "", "field": "component_id", "message": "component_id 必填"})
+    if not text:
+        errors.append({"component_id": component_id, "field": "text", "message": "text 必填"})
+
+    selected = tuple(str(key) for key in raw.get("selected_metrics") or ())
+    for key in selected:
+        if key not in candidate_metric_keys:
+            errors.append({
+                "component_id": component_id, "field": "selected_metrics",
+                "message": f"指标 {key} 不在候选榜内（只能从候选中选定）"})
+    # 派生指标（报告层计算，不进口径检查——同样须在候选榜内）
+    derived = tuple(str(key) for key in raw.get("derived_metrics") or ())
+    for key in derived:
+        if key not in candidate_metric_keys:
+            errors.append({
+                "component_id": component_id, "field": "derived_metrics",
+                "message": f"派生指标 {key} 不在候选榜内（只能从候选中选定）"})
+
+    dimensions = tuple(str(dim) for dim in raw.get("dimensions") or ())
+    # 维度须在 schema 列集内（指标维度白名单的强校验在 check 阶段——
+    # groupby_subset_whitelist 按 selected_metrics 逐一核对）
+    for dim in dimensions:
+        normalized = dim.split(".")[-1]
+        if dim not in all_columns and normalized not in all_columns:
+            errors.append({
+                "component_id": component_id, "field": "dimensions",
+                "message": f"维度 {dim} 不在 schema 子包列集内"})
+    time_raw = raw.get("time")
+    time_dict: dict[str, Any] | None = None
+    if time_raw is not None:
+        if not isinstance(time_raw, dict):
+            errors.append({"component_id": component_id, "field": "time", "message": "time 必须是对象"})
+        else:
+            for key in _TIME_REQUIRED_KEYS:
+                if not str(time_raw.get(key) or "").strip():
+                    errors.append({
+                        "component_id": component_id, "field": f"time.{key}",
+                        "message": f"time.{key} 必填（快照/无时间维数据可整体省略 time 字段，"
+                                   "不要把非日期列伪造为时间维度）"})
+            time_dict = dict(time_raw)
+
+    filters: list[ComponentFilter] = []
+    for raw_filter in raw.get("filters") or []:
+        if not isinstance(raw_filter, dict):
+            errors.append({"component_id": component_id, "field": "filters", "message": "filters 每项必须是对象"})
+            continue
+        field = str(raw_filter.get("field") or "")
+        op = str(raw_filter.get("op") or "=").upper()
+        if not field:
+            errors.append({"component_id": component_id, "field": "filters.field", "message": "过滤字段必填"})
+        if op not in _ALLOWED_FILTER_OPS:
+            errors.append({
+                "component_id": component_id, "field": "filters.op",
+                "message": f"过滤操作符 {op!r} 不在白名单内"})
+        # 过滤字段应在 schema 列集内（表名列名都收——模型可能给「表.列」形态）
+        normalized = field.split(".")[-1]
+        if field not in all_columns and normalized not in all_columns:
+            errors.append({
+                "component_id": component_id, "field": "filters.field",
+                "message": f"过滤字段 {field} 不在 schema 子包列集内"})
+        status = str(raw_filter.get("status") or "confirmed")
+        if status not in ("confirmed", "pending"):
+            status = "confirmed"
+        filters.append(ComponentFilter(
+            field=field, op=op, value=raw_filter.get("value"),
+            status=status, value_source=str(raw_filter.get("value_source") or "")))
+
+    if errors:
+        return None, errors
+    component = PlanComponent(
+        component_id=component_id,
+        text=text,
+        selected_metrics=selected,
+        derived_metrics=derived,
+        dimensions=dimensions,
+        time=time_dict,
+        filters=tuple(filters),
+        depends_on=tuple(str(dep) for dep in raw.get("depends_on") or ()),
+        output=str(raw.get("output") or ""),
+        role=raw["role"],
+        facet_id=raw["facet_id"],
+        required=raw["required"],
+        priority=raw["priority"],
+        evidence_requirement=raw["evidence_requirement"],
+        material_refs=tuple(raw["material_refs"]),
+    )
+    return component, []
+
+
+def _check_acyclic(components: list[PlanComponent], errors: list[dict[str, str]]) -> None:
+    """depends_on 无环检查（DFS 三色标记）。"""
+    graph = {c.component_id: list(c.depends_on) for c in components}
+    state: dict[str, int] = {}  # 0=未访问 1=在栈 2=完成
+
+    def visit(node: str, path: list[str]) -> bool:
+        state[node] = 1
+        for dep in graph.get(node, ()):
+            if state.get(dep) == 1:
+                cycle = " -> ".join([*path, node, dep])
+                errors.append({
+                    "component_id": node, "field": "depends_on",
+                    "message": f"依赖成环: {cycle}"})
+                return False
+            if state.get(dep, 0) == 0 and dep in graph and not visit(dep, [*path, node]):
+                return False
+        state[node] = 2
+        return True
+
+    for node in graph:
+        if state.get(node, 0) == 0 and not visit(node, []):
+            return
diff --git a/jiuwenswarm/channels/web/dataagent/analysis/recall.py b/jiuwenswarm/channels/web/dataagent/analysis/recall.py
