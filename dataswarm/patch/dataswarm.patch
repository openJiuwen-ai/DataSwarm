+++ b/jiuwenswarm/channels/web/dataagent/analysis/recall.py
@@ -0,0 +1,491 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/recall.py —— L1 四路召回（纯召回，不组织上下文、不打分路由）。
+
+四路并列（术语/指标/schema/维值），每路内部词法 + 向量双通道：
+
+- **术语路**：当前 workspace 内有效术语（glossary 三级召回内核——alias/向量/
+  LIKE 档位 name 0.9 / synonyms 0.7 / definition 0.25），top 5；
+- **指标路**：active release 内 published 修订（store.search_defs 词法档位
+  name > metric_key > synonyms + EMB 向量），top 10；draft/candidate 不入范围；
+- **schema 路**：published 快照（semantic_link 的词法 label 0.80/comment 0.40
+  + FAISS 向量），命中列 top 30，只作选表信号；只读快照不直连活库；
+- **维值路**：快照内维值字典（repository.recall_value_dict，全等/子串 +
+  码表注释别名），top 5，带所属列；P0 仅词法（向量后置）。
+
+打分契约：通道内原始分卡门槛 → RRF 融合 → 空结果原样传 L2（附通道状态
+ok/no_hit/unavailable，L1 不决定执行分支）。
+"""
+from __future__ import annotations
+
+import contextvars
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any, Callable
+
+from ..metrics import embedding, store
+from ..metrics import semantic_link
+from ..semantic import repository as semantic_repository
+from .model import (
+    ANALYSIS_SCHEMA_LIMIT,
+    CHANNEL_NO_HIT,
+    CHANNEL_OK,
+    CHANNEL_STALE,
+    CHANNEL_UNAVAILABLE,
+    LEXICAL_FLOOR,
+    METRICS_LIMIT,
+    TERMS_LIMIT,
+    VALUE_EXACT_SCORE,
+    VALUE_LEXICAL_SCORE,
+    VALUE_VECTOR_SCORE,
+    VECTOR_FLOOR,
+    VALUES_LIMIT,
+    RecallHit,
+    RoadResult,
+    rrf_fuse,
+)
+
+# 四路路名（``recall_all`` 的 roads 取值；串行短路第一级只要 "terms"）
+ROADS = ("terms", "metrics", "schema", "values")
+
+# 注入 schema 路的术语扩展词上限（对齐 nl2sql 表召回的 ≤5 词；
+# search_terms 内部另留 3 席不被问题分词挤掉）
+GLOSSARY_INJECT_LIMIT = 5
+
+
+def recall_all(
+    question: str,
+    workspace_id: str,
+    *,
+    source_ids: list[str] | None = None,
+    roads: tuple[str, ...] | None = None,
+    glossary_terms: list[str] | None = None,
+) -> dict[str, RoadResult]:
+    """四路召回（首路与 recall_more 共用入口）。
+
+    Args:
+        question: 问题原句（首轮）或 component 文本（再召回轮）。
+        workspace_id: 工作空间。
+        source_ids: 限定数据源（维值路/向量反查用）；None 表示全部源。
+        roads: 只跑指定路（取值见 :data:`ROADS`）；None 跑全部四路。串行
+            短路第一级只跑 ``("terms",)``，判定不过时补跑其余三路——已跑的
+            术语路结果由调用方复用，不重跑。
+        glossary_terms: 术语路命中的规范名/别名，注入 schema 路词法检索词
+            （nl2sql 式桥接增益：「成交规模」经术语桥出 GMV 才 LIKE 得到
+            gmv 表）。缺席只是少一份增益，不影响 schema 路本身。
+
+    Returns:
+        ``{"terms": RoadResult, "metrics": RoadResult, "schema": RoadResult,
+        "values": RoadResult}``——只含 ``roads`` 指定的键。
+
+    Raises:
+        ValueError: ``roads`` 含未知路名（拼错不静默空跑）。
+    """
+    if roads is not None:
+        unknown = sorted(set(roads) - set(ROADS))
+        if unknown:
+            raise ValueError(f"未知召回路: {unknown}（可选 {list(ROADS)}）")
+    wanted = set(roads) if roads is not None else set(ROADS)
+    jobs: dict[str, Callable[[], RoadResult]] = {
+        "terms": lambda: _recall_terms(question),
+        "metrics": lambda: _recall_metrics(question, workspace_id),
+        "schema": lambda: _recall_schema(
+            question, workspace_id,
+            extra_terms=tuple(glossary_terms or ())[:GLOSSARY_INJECT_LIMIT]),
+        # F-048 ②：workspace_id 此前漏传（合并吞参），维值向量通道被静默关闭
+        "values": lambda: _recall_values(question, source_ids, workspace_id),
+    }
+    todo = [(road, jobs[road]) for road in ROADS if road in wanted]
+    out: dict[str, RoadResult] = {}
+    if len(todo) <= 1:
+        for road, job in todo:
+            out[road] = job()
+        return out
+    # 多路并行（F-048 ③）：各路只读不写共享态、DB 每调用新建连接、FAISS
+    # 搜索线程安全。workspace 上下文是 ContextVar——线程池不自动传播，
+    # 逐 job 快照注入（同一 Context 不可并发 run，故每 job 各 copy 一份）。
+    with ThreadPoolExecutor(max_workers=len(todo)) as pool:
+        futures = [(road, pool.submit(contextvars.copy_context().run, job))
+                   for road, job in todo]
+        for road, future in futures:
+            out[road] = future.result()
+    return out
+
+
+def glossary_words(term_road: RoadResult) -> list[str]:
+    """术语路命中 → schema 路词法注入词（规范名 + 别名，去重保序）。"""
+    words: list[str] = []
+    for hit in term_road.hits:
+        for word in [str(hit.payload.get("name") or hit.label),
+                     *[str(syn) for syn in hit.payload.get("synonyms") or ()]]:
+            if word and word not in words:
+                words.append(word)
+    return words[:GLOSSARY_INJECT_LIMIT]
+
+
+# ==========================================================================
+# 术语路
+# ==========================================================================
+
+def _recall_terms(question: str) -> RoadResult:
+    """术语路：glossary 三级召回内核 → 词法(alias/like 档位) + 向量两通道 RRF。"""
+    warnings: list[str] = []
+    try:
+        from ..glossary import recall as glossary_recall
+
+        resolved = glossary_recall.resolve(question, limit=20)
+    except Exception as exc:  # noqa: BLE001 —— 术语库不可用：降级为空路不阻断
+        warnings.append(f"glossary_unavailable:{type(exc).__name__}")
+        return RoadResult("term", (), CHANNEL_UNAVAILABLE, tuple(warnings))
+
+    lexical: list[RecallHit] = []
+    vector: list[RecallHit] = []
+    for match in resolved.get("matches") or ():
+        term = match.get("term") or {}
+        term_id = str(term.get("term_id") or "")
+        if not term_id or str(term.get("status") or "active") != "active":
+            continue
+        scores = match.get("scores") or {}
+        # 词法通道 = max(alias 1.0, like 档位分)——alias 是确定性全词命中
+        lex_score = max(float(scores.get("alias") or 0.0),
+                        float(scores.get("like") or 0.0))
+        vec_score = float(scores.get("vector") or 0.0)
+        payload: dict[str, Any] = {
+            "term_id": term_id,
+            "name": str(term.get("name") or ""),
+            "definition": str(term.get("definition") or ""),
+            "synonyms": list(term.get("synonyms_list") or []),
+            # 命中的问句片段（LIKE 档有，向量档为空）——歧义判定要区分
+            # 「同一个词命中多个术语」与「问句提了多个不同术语」
+            "matched_token": str(match.get("matched_token") or ""),
+        }
+        if lex_score >= LEXICAL_FLOOR:
+            hit = RecallHit(
+                kind="term", entity_id=term_id, label=payload["name"],
+                channels=[("lexical", round(lex_score, 4))],
+                matched_on=[str(match.get("match_type") or "lexical")],
+                payload=payload)
+            lexical.append(hit)
+        if vec_score >= VECTOR_FLOOR:
+            hit = RecallHit(
+                kind="term", entity_id=term_id, label=payload["name"],
+                channels=[("vector", round(vec_score, 4))],
+                matched_on=["emb"],
+                payload=payload)
+            vector.append(hit)
+
+    fused = rrf_fuse({"lexical": lexical, "vector": vector})[:TERMS_LIMIT]
+    # stale = 向量通道缺席/索引滞后（glossary resolve 的 degraded 标志）但词法面
+    # 仍工作——结果来自降级检索面；unavailable 仅整路失败（术语库崩）
+    if resolved.get("degraded"):
+        status = CHANNEL_UNAVAILABLE if not lexical and not fused else CHANNEL_STALE
+    else:
+        status = CHANNEL_OK if fused else CHANNEL_NO_HIT
+    for warning in resolved.get("warnings") or ():
+        warnings.append(str(warning))
+    raw_count = len(resolved.get("matches") or ())
+    return RoadResult("term", tuple(fused), status, tuple(warnings), raw_count=raw_count)
+
+
+# ==========================================================================
+# 指标路
+# ==========================================================================
+
+def _recall_metrics(question: str, workspace_id: str) -> RoadResult:
+    """指标路：词法档位（store.search_defs）+ EMB 向量，published 修订限定。"""
+    warnings: list[str] = []
+    lexical: list[RecallHit] = []
+    raw_lexical: list[tuple[str, float]] = []
+    try:
+        for metric, score, via in store.search_defs(workspace_id, question, limit=20):
+            raw_lexical.append((metric.metric_key, score))
+            if score < LEXICAL_FLOOR:
+                continue
+            revision = store.published_revision(metric)
+            if revision is None:
+                continue  # draft/candidate/archived 不入范围（红线）
+            lexical.append(RecallHit(
+                kind="metric", entity_id=metric.metric_key,
+                label=revision.display_name or metric.name,
+                channels=[("lexical", round(score, 4))],
+                matched_on=[f"lexical:{via}" if via else "lexical"],
+                payload={"metric_key": metric.metric_key,
+                         "revision_id": revision.revision_id,
+                         "display_name": revision.display_name or metric.name}))
+    except Exception as exc:  # noqa: BLE001 —— 元库不可用：空路降级
+        warnings.append(f"metric_lexical_failed:{type(exc).__name__}")
+
+    vector = _metric_vector_hits(question, workspace_id, warnings)
+    fused = rrf_fuse({"lexical": lexical, "vector": vector})[:METRICS_LIMIT]
+    # 向量通道已配置但索引空/构建失败（emb_unavailable=未部署不算退化）→ stale
+    emb_degraded = any(
+        w.startswith(("emb_index_empty", "emb_build_failed")) for w in warnings)
+    if "metric_lexical_failed" in " ".join(warnings) and not fused:
+        status = CHANNEL_UNAVAILABLE
+    elif emb_degraded:
+        status = CHANNEL_STALE
+    elif fused:
+        status = CHANNEL_OK
+    elif lexical or vector:
+        status = CHANNEL_NO_HIT  # 有候选但全被门槛/发布态过滤
+    else:
+        status = CHANNEL_NO_HIT
+    return RoadResult("metric", tuple(fused), status, tuple(warnings),
+                      raw_count=len(raw_lexical) + len(vector))
+
+
+def _metric_vector_hits(
+    question: str, workspace_id: str, warnings: list[str]
+) -> list[RecallHit]:
+    """指标 EMB 向量通道：多向量查询（整句 + jieba 短语）对指标文档向量。"""
+    if not embedding.emb_available():
+        if embedding.WARN_UNAVAILABLE not in warnings:
+            warnings.append(embedding.WARN_UNAVAILABLE)
+        return []
+    outcome = embedding.query_vectors(question)
+    if not outcome.ok:
+        if (outcome.error or embedding.WARN_UNAVAILABLE) not in warnings:
+            warnings.append(outcome.error or embedding.WARN_UNAVAILABLE)
+        return []
+    index = embedding.load_or_build(
+        workspace_id=workspace_id, scope_id="metric-head",
+        docs=embedding.metric_docs(workspace_id), warnings=warnings)
+    if index is None:
+        return []
+    ranked = embedding.rank(index, outcome.vectors)
+    by_key: dict[str, RecallHit] = {}
+    for metric_key, score, _text_idx in ranked:
+        if score < VECTOR_FLOOR:
+            continue
+        metric = store.get_def_by_key(workspace_id, metric_key)
+        if metric is None:
+            continue
+        revision = store.published_revision(metric)
+        if revision is None:
+            continue
+        by_key.setdefault(metric_key, RecallHit(
+            kind="metric", entity_id=metric_key,
+            label=revision.display_name or metric.name,
+            channels=[("vector", round(score, 4))],
+            matched_on=["emb"],
+            payload={"metric_key": metric_key,
+                     "revision_id": revision.revision_id,
+                     "display_name": revision.display_name or metric.name}))
+    return sorted(by_key.values(), key=lambda h: (-_score_of(h, "vector"), h.entity_id))
+
+
+def _score_of(hit: RecallHit, channel: str) -> float:
+    for name, score in hit.channels:
+        if name == channel:
+            return score
+    return 0.0
+
+
+# ==========================================================================
+# schema 路
+# ==========================================================================
+
+def _recall_schema(question: str, workspace_id: str,
+                   extra_terms: tuple[str, ...] = ()) -> RoadResult:
+    """schema 路：快照词法 + FAISS 向量（published 快照，列级 top 30）。
+
+    Args:
+        question: 问题原句 / 成分文本。
+        workspace_id: 工作空间。
+        extra_terms: 术语扩展词（整词进词法检索，不切 2-gram）——第三级
+            schema 探索的关键增益：字面不像但经术语桥接能命中的表。
+    """
+    warnings: list[str] = []
+    refs, snapshots = semantic_link.current_snapshots(warnings)
+    if not refs or not snapshots:
+        return RoadResult("column", (), CHANNEL_UNAVAILABLE,
+                          (*warnings, "semantic_not_collected"))
+
+    terms = semantic_link.search_terms(question, extra_terms=extra_terms)
+    lexical_hits = semantic_link.lexical_schema_hits(snapshots, terms, limit=50)
+    lexical: list[RecallHit] = []
+    for schema_hit in lexical_hits:
+        if schema_hit.score < LEXICAL_FLOOR:
+            continue
+        lexical.append(RecallHit(
+            kind="column" if schema_hit.node_type == "col" else "table",
+            entity_id=schema_hit.node_id, label=schema_hit.label,
+            channels=[("lexical", round(schema_hit.score, 4))],
+            matched_on=[f"schema:{mark}" for mark in schema_hit.matched_on],
+            payload={"logical": schema_hit.logical, "node_type": schema_hit.node_type}))
+
+    vector: list[RecallHit] = []
+    emb_hits, emb_warnings = semantic_link.emb_schema_hits(workspace_id, question, snapshots)
+    for warning in emb_warnings:
+        if warning not in warnings:
+            warnings.append(warning)
+    for node_id, (score, via) in emb_hits.items():
+        if score < VECTOR_FLOOR:
+            continue
+        attributes = semantic_link.node_attributes(snapshots, node_id)
+        if attributes is None:
+            continue  # 快照刚轮换/列已删——不伪造命中
+        _, logical, node_type = attributes
+        vector.append(RecallHit(
+            kind="column" if node_type == "col" else "table",
+            entity_id=node_id, label=logical,
+            channels=[("vector", round(score, 4))],
+            matched_on=["schema:emb"] + ([f"emb_via:{via}"] if via else []),
+            payload={"logical": logical, "node_type": node_type}))
+
+    fused = rrf_fuse({"lexical": lexical, "vector": vector})[:ANALYSIS_SCHEMA_LIMIT]
+    # 快照在但 FAISS 向量已配置而索引空/失败（emb_unavailable=未部署不算）→ stale
+    emb_degraded = any(
+        w.startswith(("emb_index_empty", "emb_build_failed", "semantic_vector",
+                      "vector_recall"))
+        for w in warnings)
+    if emb_degraded:
+        status = CHANNEL_STALE
+    else:
+        status = CHANNEL_OK if fused else CHANNEL_NO_HIT
+    return RoadResult("column", tuple(fused), status, tuple(warnings),
+                      raw_count=len(lexical_hits) + len(emb_hits))
+
+
+# ==========================================================================
+# 维值路
+# ==========================================================================
+
+def _recall_values(question: str, source_ids: list[str] | None,
+                   workspace_id: str) -> RoadResult:
+    """维值路：字典词法（分词全等/子串）+ 向量双通道 RRF，带所属列。
+
+    向量通道解决跨语言/简称鸿沟（「圣保罗」↔ 'SP'）——语料 = 字典值文本，
+    按源懒构建（scope 键钉 snapshot 轮换），规模受 metrics EMB 上限约束；
+    通道不可用只降级词法，不阻断。workspace_id 必传：漏传即向量通道缺失
+    （F-048 ②教训），签名不给默认值让它当场炸。
+    """
+    warnings: list[str] = []
+    if not source_ids:
+        # 未指定源：取当前工作空间全部 enabled 源（语义快照存在的）
+        refs, _snapshots = semantic_link.current_snapshots(warnings)
+        source_ids = [ref.source_id for ref in refs]
+        if not source_ids:
+            return RoadResult("value", (), CHANNEL_UNAVAILABLE, tuple(warnings))
+    tokens = _value_tokens(question)
+
+    # ---- 词法通道（分 token 全等/子串）----
+    merged: dict[str, RecallHit] = {}
+    for source_id in source_ids:
+        for token in tokens:
+            try:
+                rows = semantic_repository.recall_value_dict(
+                    source_id, token, limit=VALUES_LIMIT)
+            except Exception as exc:  # noqa: BLE001 —— 单源字典读失败跳过
+                warnings.append(f"value_dict_failed:{source_id}:{type(exc).__name__}")
+                continue
+            for row in rows:
+                value_id = row["value_id"]
+                hit = merged.get(value_id)
+                if hit is None:
+                    merged[value_id] = RecallHit(
+                        kind="value", entity_id=value_id, label=row["value_text"],
+                        channels=[(f"lexical:{row['match_type']}",
+                                   VALUE_EXACT_SCORE if row["match_type"] == "exact" else VALUE_LEXICAL_SCORE)],
+                        matched_on=[f"value:{row['match_type']}"],
+                        payload={
+                            "value": row["value_text"],
+                            "column_id": row["column_id"],
+                            "table_id": row["table_id"],
+                            "snapshot_id": row["snapshot_id"],
+                            "token": token,
+                        })
+    lexical = list(merged.values())
+
+    # ---- 向量通道（跨语言/简称；按源懒构建索引）----
+    vector = _value_vector_hits(question, source_ids, workspace_id, warnings)
+
+    fused = rrf_fuse({"lexical": lexical, "vector": vector})
+    hits = sorted(fused, key=lambda h: (
+        -max((VALUE_EXACT_SCORE if name.split(":")[-1] == "exact" else
+              (VALUE_LEXICAL_SCORE if name.startswith("lexical") else VALUE_VECTOR_SCORE))
+             for name, _ in h.channels),
+        h.entity_id,
+    ))
+    # 字典在但向量通道已配置而索引空/失败（emb_unavailable=未部署不算）→ stale
+    emb_degraded = any(
+        w.startswith(("emb_index_empty", "emb_build_failed", "value_dict_texts_failed"))
+        for w in warnings)
+    status = CHANNEL_STALE if emb_degraded else (CHANNEL_OK if hits else CHANNEL_NO_HIT)
+    return RoadResult("value", tuple(hits[:VALUES_LIMIT]),
+                      status, tuple(warnings),
+                      raw_count=len(lexical) + len(vector))
+
+
+def _value_vector_hits(
+    question: str, source_ids: list[str], workspace_id: str, warnings: list[str]
+) -> list[RecallHit]:
+    """维值向量通道：字典值文本的 FAISS 召回（跨语言/简称）。"""
+    if not workspace_id:
+        return []
+    if not embedding.emb_available():
+        if embedding.WARN_UNAVAILABLE not in warnings:
+            warnings.append(embedding.WARN_UNAVAILABLE)
+        return []
+    outcome = embedding.query_vectors(question)
+    if not outcome.ok:
+        reason = outcome.error or embedding.WARN_UNAVAILABLE
+        if reason not in warnings:
+            warnings.append(reason)
+        return []
+    hits: list[RecallHit] = []
+    for source_id in source_ids:
+        try:
+            docs = semantic_repository.list_value_dict_texts(source_id)
+        except Exception as exc:  # noqa: BLE001 —— 字典读失败降级该源
+            warnings.append(f"value_dict_texts_failed:{source_id}:{type(exc).__name__}")
+            continue
+        if not docs:
+            continue
+        snapshot_tag = ""
+        try:
+            rows = semantic_repository.get_value_dict_rows([source_id], [docs[0][0]])
+            snapshot_tag = rows[0].get("snapshot_id", "") if rows else ""
+        except Exception:  # noqa: BLE001 —— snapshot 标记缺失不阻断
+            snapshot_tag = ""
+        index = embedding.load_or_build(
+            workspace_id=workspace_id,
+            scope_id=f"value-dict-{source_id}-{snapshot_tag}",
+            docs=docs, warnings=warnings)
+        if index is None:
+            continue
+        ranked = embedding.rank(index, outcome.vectors, limit=VALUES_LIMIT)
+        if not ranked:
+            continue
+        by_id = {
+            row["value_id"]: row
+            for row in semantic_repository.get_value_dict_rows(
+                [source_id], [key for key, _score, _idx in ranked])
+        }
+        for value_id, score, _text_idx in ranked:
+            if score < VECTOR_FLOOR:
+                continue  # 通道内门槛（打分契约：低分不参与融合）
+            row = by_id.get(value_id)
+            if row is None:
+                continue  # 快照轮换间隙——不伪造命中
+            hits.append(RecallHit(
+                kind="value", entity_id=value_id, label=row["value_text"],
+                channels=[("vector", round(score, 4))],
+                matched_on=["value:emb"],
+                payload={
+                    "value": row["value_text"],
+                    "column_id": row["column_id"],
+                    "table_id": row["table_id"],
+                    "snapshot_id": row["snapshot_id"],
+                }))
+    hits.sort(key=lambda h: (-_score_of(h, "vector"), h.entity_id))
+    return hits
+
+
+def _value_tokens(question: str) -> list[str]:
+    """问句 → 维值匹配 token 列表（ASCII 整词 + 中文 2-gram；长度 ≥2）。
+
+    复用 glossary recall 的分词口径（跨模块私有 import 有先例）——
+    维值是短枚举值，token 匹配面必须与术语 LIKE 档同刻度。
+    """
+    from ..glossary.recall import tokenize
+
+    return [token for token in tokenize(question) if len(token) >= 2][:12]
