+# --------------------------------------------------------------------------
+# sql 简写 shim：模型常猜 `dwcli sql "<SQL>"` / `dwcli sql run "<SQL>"`（把 SQL
+# 当位置参数），argparse 报 invalid choice。shim 重写为 `sql run --sql "<SQL>"`。
+# --------------------------------------------------------------------------
+class TestSqlPositionalShim:
+    def test_shim_bare_sql_as_action(self):
+        """`sql "SHOW DATABASES"` → `sql run --sql "SHOW DATABASES"`。"""
+        assert dwcli._shim_sql_positional(["sql", "SHOW DATABASES"]) == \
+            ["sql", "run", "--sql", "SHOW DATABASES"]
+
+    def test_shim_bare_sql_with_flags(self):
+        """SQL 段与 --flag 混排：非 flag 位置段并成 SQL，flag 原样保留。"""
+        assert dwcli._shim_sql_positional(
+            ["sql", "SELECT 1", "--db-ref", "doris://x", "--limit", "10"]
+        ) == ["sql", "run", "--sql", "SELECT 1", "--db-ref", "doris://x", "--limit", "10"]
+
+    def test_shim_action_then_bare_sql(self):
+        """`sql run "SELECT 1"` → `sql run --sql "SELECT 1"`。"""
+        assert dwcli._shim_sql_positional(["sql", "run", "SELECT 1"]) == \
+            ["sql", "run", "--sql", "SELECT 1"]
+
+    def test_shim_noop_on_normal_forms(self):
+        """正规写法零改动：动作后无裸参数 / 已带 --sql / 非 sql 组。"""
+        assert dwcli._shim_sql_positional(["sql", "run", "--sql", "SELECT 1"]) == \
+            ["sql", "run", "--sql", "SELECT 1"]
+        assert dwcli._shim_sql_positional(["sql", "explain", "--sql", "SELECT 1"]) == \
+            ["sql", "explain", "--sql", "SELECT 1"]
+        assert dwcli._shim_sql_positional(["sql", "ddl", "--sql", "CREATE …", "--confirm"]) == \
+            ["sql", "ddl", "--sql", "CREATE …", "--confirm"]
+        assert dwcli._shim_sql_positional(["databases", "list"]) == ["databases", "list"]
+        assert dwcli._shim_sql_positional(["sql", "-h"]) == ["sql", "-h"]
+
+    def test_shim_fills_missing_action_for_flag_form(self):
+        """`sql --sql "<SQL>"` 漏写动作 → 补 run（模型高频形态）。"""
+        assert dwcli._shim_sql_positional(["sql", "--sql", "SELECT 1"]) == \
+            ["sql", "run", "--sql", "SELECT 1"]
+        assert dwcli._shim_sql_positional(
+            ["sql", "--sql", "SELECT 1", "--db-ref", "sqlite://x"]) == \
+            ["sql", "run", "--sql", "SELECT 1", "--db-ref", "sqlite://x"]
+
+    def test_end_to_end_bare_sql_reaches_api(self, monkeypatch):
+        """端到端：`sql "SHOW DATABASES"` 经 main 走到 POST /sql/run。"""
+        captured = {}
+
+        def fake_call(method, path, query=None, body=None, base="", **kwargs):
+            captured.update(method=method, path=path, body=body)
+            return {"ok": True, "rows": []}
+
+        monkeypatch.setattr(dwcli, "_call_api", fake_call)
+        monkeypatch.setattr(dwcli, "_resolve_default_db_ref",
+                            lambda workspace_id=None: "doris://data_swarm")
+        with pytest.raises(SystemExit) as exc:
+            dwcli.main(["sql", "SHOW DATABASES"])
+        assert exc.value.code == 0
+        assert captured["method"] == "POST" and captured["path"] == "/sql/run"
+        assert captured["body"]["sql"] == "SHOW DATABASES"
+        assert captured["body"]["db_ref"] == "doris://data_swarm"
+
