+def test_plan_open_mode_rejected_when_disabled(af, workspace, monkeypatch, tmp_path):
+    """mode=open + 开关关 → SystemExit 指引改 closed（指令层兜底闸门）。"""
+    monkeypatch.setattr(af, "_open_analysis_enabled", lambda: False)
+    plan_file = tmp_path / "plan.json"
+    plan_file.write_text(json.dumps({"mode": "open", "question": "经营复盘",
+                                     "components": []}, ensure_ascii=False),
