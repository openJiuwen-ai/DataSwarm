+++ b/jiuwenswarm/channels/web/dataagent/analysis/graph_expand.py
@@ -0,0 +1,581 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/graph_expand.py —— L2①a 图补全（定向遍历，非泛洪）。
+
+入口节点（Term / Metric / SourceTable / SourceColumn / 维值列）按
+「入口类型 × 边 × 方向 → 补哪个子包」规则扩展，**不取 N 跳内所有节点**。
+
+图读双路（方案 P0 的一致性兜底）：
+
+- **图读路**（首选）：``read_neighbors`` 读跨 namespace 边
+  （measuresConcept / usesTable / usesColumn / timeField / canGroupBy）。
+  已知脆弱性：physical namespace 重投影的 DETACH DELETE 会连带删掉
+  metrics→physical 跨层边（边挂在被删节点上），直到 metrics 重投影才恢复；
+- **元数据库推导路**（一等回退，非降级补丁）：P0 全部跨层边都可从
+  ``dw_metric_bindings`` + ``dw_metric_concept_map`` 重建——图缺席时 L2
+  质量不降级为零，只损失「边即证据」的观测面。
+
+读侧纪律：图只用来**发现候选 ID**；指标/术语/列进入上下文前一律按
+元数据库/快照回源复验（失败丢弃并记 warning）。schema 内横向扩展
+（同表列 / join 边）直接读快照——快照本来就是 schema 真相源。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from ..glossary import db as glossary_db
+from ..metrics import store
+from ..metrics.graph_projection import (
+    EDGE_CAN_GROUP_BY,
+    EDGE_MEASURES_CONCEPT,
+    EDGE_TIME_FIELD,
+    EDGE_USES_COLUMN,
+    EDGE_USES_TABLE,
+    metric_node_id,
+)
+from ..semantic.semantica import from_environment
+from .model import GRAPH_MEASURES_PREFIX, RecallHit, RoadResult
+
+# 图读上限：单次图补全的边数上限（防大图泛洪）
+_GRAPH_LIMIT = 200
+
+
+# ---------------------------------------------------------------------------
+# 绑定列引用方言（col::{table}.{column}）——显式构造/解析（E4）
+#
+# 与素材 node_id 的单冒号方言（col:/tbl:/view:，投影节点 ID）是**两个约定**：
+# 绑定方言携带物理尾段（来自指标绑定的 source_table/column_map），只在
+# 图扩展的 usesColumn 边生成与回源解析使用；knowledge/publication 的 scope
+# 解析只认裸 table.column 与素材方言，绑定方言不进入。
+# ---------------------------------------------------------------------------
+BINDING_COLUMN_PREFIX = "col::"
+
+
+def binding_column_id(table: str, column: str) -> str:
+    """构造绑定列引用 ``col::{table}.{column}``（均物理尾段）。"""
+    return f"{BINDING_COLUMN_PREFIX}{table}.{column}"
+
+
+def binding_column_logical(column_id: str) -> str | None:
+    """解析绑定列引用 → ``table.column`` 逻辑名；非本方言返回 None。"""
+    if not column_id.startswith(BINDING_COLUMN_PREFIX):
+        return None
+    return column_id[len(BINDING_COLUMN_PREFIX):]
+
+
+@dataclass
+class Expansion:
+    """图补全产物——全部是**候选**，交 rerank 层排序，不直接进上下文包。
+
+    ``graph_path`` 记录跨层边获取走了哪条路（评审可观测）：
+    ``graph_read``（Neo4j read_neighbors）/ ``metadata_fallback``（元数据库
+    推导——图不可用或读失败时的一等回退）。``dropped`` 是回源复验失败的
+    候选（图读到但元数据库/快照验不过——半写状态的直接证据）。
+    """
+
+    metrics: list[RecallHit] = field(default_factory=list)
+    # 补全指标（matched_on 带 graph: 前缀，区分直发/补全）
+    columns: list[RecallHit] = field(default_factory=list)
+    # 补全列/表（绑定带出、同表展开、join 对端）
+    tables: list[str] = field(default_factory=list)          # 表 node_id
+    terms: list[dict[str, Any]] = field(default_factory=list)
+    # 补全术语口径（指标 → measuresConcept → 术语）
+    joins: list[dict[str, Any]] = field(default_factory=list)
+    # 涉及 join 边（{left, right, level, status, cardinality, confidence}）
+    graph_status: str = "ok"                                 # ok | unavailable
+    graph_path: str = ""                                     # graph_read | metadata_fallback
+    dropped: list[dict[str, str]] = field(default_factory=list)
+    # 回源复验丢弃：[{kind, id, reason}]
+    warnings: list[str] = field(default_factory=list)
+    knowledge_assets: list[dict[str, Any]] = field(default_factory=list)
+    knowledge_trace: dict[str, Any] = field(default_factory=dict)
+
+
+def expand(
+    recall_results: dict[str, RoadResult],
+    workspace_id: str,
+    snapshots: dict[str, Any],
+    *,
+    seed_bound_columns: bool = False,
+    knowledge_versions: dict[str, Any] | None = None,
+    source_ids: list[str] | None = None,
+) -> Expansion:
+    """L2①a 定向遍历：四路召回命中 → 跨层补全候选。
+
+    Args:
+        recall_results: ``recall_all`` 的返回（terms/metrics/schema/values
+            四路）；缺键按空路处理（串行短路第一级只传术语路）。
+        workspace_id: 工作空间。
+        snapshots: ``semantic_link.current_snapshots`` 的快照集（横向扩展与
+            回源复验的依据；不可用时横向扩展降级为仅命中列自身）。
+        seed_bound_columns: 指标绑定带出的表列是否参与 schema 横向扩展
+            （同表全列 + join 边）。默认 False 保持完整召回路径原语义
+            （横向扩展只从 schema 直发命中出发）；**串行短路路径必须 True**
+            ——那条路没有 schema 直发命中，不种子化则 join 边恒空，多表
+            口径的 SQL 无从写起。
+
+    Returns:
+        :class:`Expansion`——metrics/columns 是带来源标记的候选 RecallHit。
+    """
+    expansion = Expansion()
+    term_ids = [str(hit.payload.get("term_id") or hit.entity_id)
+                for hit in recall_results.get("terms", RoadResult("term", (), "unavailable")).hits]
+    metric_keys = [hit.entity_id for hit in
+                   recall_results.get("metrics", RoadResult("metric", (), "unavailable")).hits]
+    schema_hits = list(recall_results.get("schema", RoadResult("column", (), "unavailable")).hits)
+    column_ids = [hit.entity_id for hit in schema_hits if hit.kind == "column"]
+    table_ids = [hit.entity_id for hit in schema_hits if hit.kind == "table"]
+    # 维值命中：值 → 所属列（纵向）
+    value_column_ids = [str(hit.payload.get("column_id") or "")
+                        for hit in recall_results.get("values", RoadResult("value", (), "unavailable")).hits
+                        if hit.payload.get("column_id")]
+
+    # Knowledge is a first-class seed, before metrics/columns are expanded.
+    if any(name in recall_results for name in ("mappings", "rules")):
+        from ..knowledge.expansion import seed_refs
+        try:
+            linked = seed_refs(recall_results, workspace_id, knowledge_versions or {}, source_ids)
+        except Exception as exc:  # noqa: BLE001 — preserve base recall with explicit missing knowledge status
+            linked = {"assets": [], "path": "unavailable", "edges": [], "dropped": [],
+                      "metric_keys": set(), "term_ids": set(), "column_ids": set(), "table_ids": set(),
+                      "warnings": [f"knowledge_expansion_unavailable:{type(exc).__name__}"]}
+        expansion.knowledge_assets = linked["assets"]
+        # asset_count/unbound 把「知识命中但 scope 未绑定物理对象」显性化——
+        # 命中却零边 = 治理欠账（发布门禁生效前的存量），前端据此标注待治理
+        expansion.knowledge_trace = {
+            "path": linked["path"], "edges": linked["edges"],
+            "asset_count": len(linked["assets"]),
+            "unbound": bool(linked["assets"]) and not linked["edges"],
+        }
+        expansion.dropped.extend(linked["dropped"])
+        expansion.warnings.extend(linked["warnings"])
+        for key in linked["metric_keys"]:
+            _add_metric_candidate(expansion, workspace_id, key, "graph:knowledge:appliesTo")
+        metric_keys += [hit.entity_id for hit in expansion.metrics]
+        for term_id in linked["term_ids"]:
+            term = glossary_db.get_term(term_id)
+            if term and term.get("status") == "active":
+                expansion.terms.append(term)
+                term_ids.append(term_id)
+        for node_id in linked["column_ids"] | linked["table_ids"]:
+            _add_column_candidate(expansion, snapshots, node_id, "graph:knowledge:appliesTo")
+        column_ids += [hit.entity_id for hit in expansion.columns]
+        table_ids += list(expansion.tables)
+
+    # ---- 跨层边：图读优先，元数据库推导一等回退 ----
+    cross: dict[str, list[dict[str, Any]]] = _cross_edges(
+        workspace_id, term_ids, metric_keys, column_ids, expansion)
+    # 列/表入口 → 指标（usesColumn/usesTable 反查）
+    for source_id, edge_type in cross.get("column_to_metrics", []):
+        _add_metric_candidate(expansion, workspace_id, source_id,
+                              f"graph:{edge_type}")
+    # 术语入口 → 指标（measuresConcept 反查）
+    for term_id, metric_key in cross.get("term_to_metrics", []):
+        _add_metric_candidate(expansion, workspace_id, metric_key,
+                              f"{GRAPH_MEASURES_PREFIX}:{term_id}")
+    if expansion.knowledge_assets:
+        # Knowledge -> term -> metric -> bindings is a directed dependency chain.
+        added_keys = [hit.entity_id for hit in expansion.metrics if hit.entity_id not in metric_keys]
+        if added_keys:
+            dependencies = _cross_edges(workspace_id, [], added_keys, [], expansion)
+            cross["metric_to_terms"].extend(dependencies.get("metric_to_terms", []))
+            cross["metric_to_columns"].extend(dependencies.get("metric_to_columns", []))
+    # 指标入口 → 术语（measuresConcept）
+    for term in cross.get("metric_to_terms", []):
+        if term not in expansion.terms:
+            expansion.terms.append(term)
+    # 指标入口 → 绑定表列（usesTable/usesColumn/timeField/canGroupBy）
+    for column_id, edge_type in cross.get("metric_to_columns", []):
+        _add_column_candidate(expansion, snapshots, column_id, f"graph:{edge_type}")
+
+    # ---- schema 内横向扩展（快照真相源）：同表列 + 维值所属列 + join 对端 ----
+    seed_columns = column_ids + value_column_ids
+    seed_tables = list(table_ids)
+    if seed_bound_columns or expansion.knowledge_assets:
+        # 短路路径：指标绑定带出的列/表即 scope 种子（无 schema 直发命中可用）
+        seed_columns += [hit.entity_id for hit in expansion.columns]
+        seed_tables += list(expansion.tables)
+    _expand_schema_neighborhood(expansion, snapshots, seed_columns, seed_tables)
+    return expansion
+
+
+# ==========================================================================
+# 跨层边获取（图读 + 推导双路）
+# ==========================================================================
+
+def _cross_edges(
+    workspace_id: str,
+    term_ids: list[str],
+    metric_keys: list[str],
+    column_ids: list[str],
+    expansion: Expansion,
+) -> dict[str, list[Any]]:
+    """跨层边获取：先图读，图不可用退元数据库推导。
+
+    Returns:
+        ``{"column_to_metrics": [(col_node_id, edge_type)...],
+        "term_to_metrics": [(term_id, metric_key)...],
+        "metric_to_terms": [术语 dict...],
+        "metric_to_columns": [(col_node_id, edge_type)...]}``。
+    """
+    adapter = None
+    try:
+        adapter = from_environment()
+    except Exception:  # noqa: BLE001 —— Neo4j 未配置/不可达：推导路接管
+        expansion.graph_status = "unavailable"
+        expansion.graph_path = "metadata_fallback"
+        expansion.warnings.append("graph_unavailable")
+    if adapter is not None:
+        try:
+            expansion.graph_path = "graph_read"
+            return _cross_edges_from_graph(adapter, workspace_id, term_ids, metric_keys, column_ids)
+        except Exception as exc:  # noqa: BLE001 —— 图读失败退推导（一等回退）
+            expansion.graph_status = "unavailable"
+            expansion.graph_path = "metadata_fallback"
+            expansion.warnings.append(f"graph_read_failed:{type(exc).__name__}")
+    return _cross_edges_from_metadata(workspace_id, term_ids, metric_keys, column_ids)
+
+
+def _cross_edges_from_graph(
+    adapter: Any,
+    workspace_id: str,
+    term_ids: list[str],
+    metric_keys: list[str],
+    column_ids: list[str],
+) -> dict[str, list[Any]]:
+    """图读路：read_neighbors 定向遍历跨 namespace 边。"""
+    result: dict[str, list[Any]] = {
+        "column_to_metrics": [], "term_to_metrics": [],
+        "metric_to_terms": [], "metric_to_columns": [],
+    }
+    # 列入口：in 方向命中 usesColumn/usesTable/timeField/canGroupBy（指标→列）
+    if column_ids:
+        records = adapter.read_neighbors(
+            column_ids,
+            edge_types=[EDGE_USES_COLUMN, EDGE_USES_TABLE, EDGE_TIME_FIELD, EDGE_CAN_GROUP_BY],
+            direction="in", limit=_GRAPH_LIMIT)
+        for record in records:
+            metric_key = str(record["node_properties"].get("metricKey") or "")
+            if metric_key:
+                result["column_to_metrics"].append((metric_key, record["type"]))
+    # 术语入口：in 方向 measuresConcept（指标→术语）
+    term_nodes = [f"term:{workspace_id}:{term_id}" for term_id in term_ids]
+    if term_nodes:
+        records = adapter.read_neighbors(
+            term_nodes, edge_types=[EDGE_MEASURES_CONCEPT],
+            direction="in", limit=_GRAPH_LIMIT)
+        for record in records:
+            metric_key = str(record["node_properties"].get("metricKey") or "")
+            if metric_key:
+                # 边是 Metric→Term：术语在**对端**（direction=in 时 seed 在
+                # target 端）。按前缀挑术语节点而不是认死 source/target——
+                # 取错端会把 metric_key 当 term_id，链判定永远匹配不上
+                # （实测现象：图可用时短路恒不触发，图挂掉反而正常）。
+                result["term_to_metrics"].append(
+                    (_term_id_of(_term_node_of(record)), metric_key))
+    # 指标入口：out 方向全部跨层边
+    metric_nodes = [metric_node_id(workspace_id, key) for key in metric_keys]
+    if metric_nodes:
+        records = adapter.read_neighbors(
+            metric_nodes,
+            edge_types=[EDGE_USES_COLUMN, EDGE_USES_TABLE, EDGE_TIME_FIELD,
+                        EDGE_CAN_GROUP_BY, EDGE_MEASURES_CONCEPT],
+            direction="out", limit=_GRAPH_LIMIT)
+        for record in records:
+            target = record["target"]
+            if record["type"] == EDGE_MEASURES_CONCEPT:
+                term = _term_by_node_id(target)
+                if term is not None:
+                    result["metric_to_terms"].append(term)
+            else:
+                result["metric_to_columns"].append((target, record["type"]))
+    return result
+
+
+def _cross_edges_from_metadata(
+    workspace_id: str,
+    term_ids: list[str],
+    metric_keys: list[str],
+    column_ids: list[str],
+) -> dict[str, list[Any]]:
+    """元数据库推导路（一等回退）：bindings + concept_map 重建跨层关系。"""
+    result: dict[str, list[Any]] = {
+        "column_to_metrics": [], "term_to_metrics": [],
+        "metric_to_terms": [], "metric_to_columns": [],
+    }
+    published = _published_metrics(workspace_id)
+    wanted_terms = set(term_ids)
+
+    for metric_key, (_metric, revision) in published.items():
+        bindings = store.list_bindings(revision.revision_id)
+        # 指标 → 绑定表列
+        if metric_key in metric_keys:
+            for binding in bindings:
+                table_name = (binding.source_table or "").split(".")[-1]
+                for physical in binding.column_map.values():
+                    result["metric_to_columns"].append(
+                        (binding_column_id(table_name, physical.split(".")[-1]), "usesColumn"))
+        # 术语 ↔ 指标（concept_map confirmed）
+        for mapping in store.list_concept_maps(revision.revision_id, status="confirmed"):
+            if mapping.relation_type != EDGE_MEASURES_CONCEPT:
+                continue
+            term = _term_by_ref(mapping.target_ref)
+            if term is None:
+                continue
+            if term.get("term_id") in wanted_terms:
+                result["term_to_metrics"].append((term["term_id"], metric_key))
+            if metric_key in metric_keys:
+                result["metric_to_terms"].append(term)
+    # 列 → 指标（绑定列名匹配，推导路拿不到列级 node_id 就按列名配对）
+    result["column_to_metrics"] = _pair_column_metrics(published, column_ids)
+    return result
+
+
+def _pair_column_metrics(
+    published: dict[str, tuple[Any, Any]], column_ids: list[str]
+) -> list[Any]:
+    """推导路列→指标配对：绑定列名与入口列名匹配（node_id 尾段）。"""
+    pairs: list[Any] = []
+    wanted = {_column_name_of(node_id) for node_id in column_ids if node_id}
+    if not wanted:
+        return pairs
+    for metric_key, (_metric, revision) in published.items():
+        for binding in store.list_bindings(revision.revision_id):
+            for physical in binding.column_map.values():
+                if physical.split(".")[-1] in wanted:
+                    pairs.append((metric_key, "usesColumn"))
+                    break
+            else:
+                continue
+            break
+    return pairs
+
+
+def _published_metrics(workspace_id: str) -> dict[str, tuple[Any, Any]]:
+    """当前 workspace 全部 published 修订（推导路全扫面——P0 指标量级可控）。"""
+    return {metric.metric_key: (metric, revision)
+            for metric, revision in store.list_effective_published(workspace_id)}
+
+
+# ==========================================================================
+# 候选构造与回源复验
+# ==========================================================================
+
+def _add_metric_candidate(expansion: Expansion, workspace_id: str, metric_key: str, via: str) -> None:
+    """图/推导给出的指标候选——回源 store 复验（published 才保留）。"""
+    if not metric_key:
+        return
+    for hit in expansion.metrics:
+        if hit.entity_id == metric_key:
+            if via not in hit.matched_on:
+                hit.matched_on.append(via)
+            return
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None or metric.status == "archived" or not metric.current_revision_id:
+        expansion.dropped.append({"kind": "metric", "id": metric_key,
+                                  "reason": "definition_missing_or_archived"})
+        expansion.warnings.append(f"graph_metric_dropped:{metric_key}")
+        return
+    revision = store.published_revision(metric)
+    if revision is None:
+        expansion.dropped.append({"kind": "metric", "id": metric_key,
+                                  "reason": "revision_not_published"})
+        expansion.warnings.append(f"graph_metric_dropped:{metric_key}")
+        return
+    expansion.metrics.append(RecallHit(
+        kind="metric", entity_id=metric_key,
+        label=revision.display_name or metric.name,
+        matched_on=[via],
+        payload={"metric_key": metric_key, "revision_id": revision.revision_id,
+                 "display_name": revision.display_name or metric.name}))
+
+
+def _add_column_candidate(
+    expansion: Expansion, snapshots: dict[str, Any], column_id: str, via: str
+) -> None:
+    """列/表候选——回源快照复验（存在且 active 才保留）。
+
+    ``usesTable`` 带出的是表 node_id（tbl:/view: 前缀）——计入触及表而非列。
+    """
+    if not column_id:
+        return
+    logical = binding_column_logical(column_id)
+    if logical is not None:
+        # Metadata bindings carry table.column rather than a projected node ID.
+        # Resolve only a unique active snapshot column; never guess across sources.
+        matches = [column.node_id for snapshot in snapshots.values() for table in snapshot.tables
+                   if table.status == "active" for column in table.columns if column.status == "active"
+                   and f"{table.name}.{column.name}" == logical]
+        if len(matches) != 1:
+            expansion.dropped.append({"kind": "column", "id": column_id,
+                                      "reason": "binding_column_missing_or_ambiguous"})
+            return
+        column_id = matches[0]
+    if column_id.startswith(("tbl:", "view:")):
+        if _snapshot_table_exists(snapshots, column_id):
+            if column_id not in expansion.tables:
+                expansion.tables.append(column_id)
+        else:
+            expansion.dropped.append({"kind": "table", "id": column_id,
+                                      "reason": "not_in_published_snapshot"})
+            expansion.warnings.append(f"graph_table_dropped:{column_id}")
+        return
+    if any(hit.entity_id == column_id for hit in expansion.columns):
+        return
+    attributes = _snapshot_column(snapshots, column_id)
+    if attributes is None:
+        expansion.dropped.append({"kind": "column", "id": column_id,
+                                  "reason": "not_in_published_snapshot_or_inactive"})
+        expansion.warnings.append(f"graph_column_dropped:{column_id}")
+        return
+    table, column = attributes
+    expansion.columns.append(RecallHit(
+        kind="column", entity_id=column_id,
+        label=f"{table.name}.{column.name}",
+        matched_on=[via],
+        payload={"logical": f"{table.name}.{column.name}", "node_type": "col"}))
+
+
+def _expand_schema_neighborhood(
+    expansion: Expansion,
+    snapshots: dict[str, Any],
+    column_ids: list[str],
+    table_ids: list[str],
+) -> None:
+    """schema 横向扩展（快照真相源）：命中列 → 同表全列 + join 对端表。
+
+    维值命中列同样进入（值 → 所属列纵向），值本身作为过滤候选由
+    context_pack 附到列上，不在这里处理。
+    """
+    tables: dict[str, Any] = {}
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            tables[table.node_id] = table
+    touched_tables: dict[str, Any] = {}
+    for column_id in column_ids:
+        # col:mysql:{source}:{db}.{tbl}.{col} → 找所属表
+        for table in tables.values():
+            if any(column.node_id == column_id for column in table.columns):
+                touched_tables[table.node_id] = table
+                break
+    for table_id in table_ids:
+        if table_id in tables:
+            touched_tables[table_id] = tables[table_id]
+
+    for table in touched_tables.values():
+        if table.node_id not in expansion.tables:
+            expansion.tables.append(table.node_id)
+        for column in table.columns:
+            if column.status != "active":
+                continue
+            if any(hit.entity_id == column.node_id for hit in expansion.columns):
+                continue
+            expansion.columns.append(RecallHit(
+                kind="column", entity_id=column.node_id,
+                label=f"{table.name}.{column.name}",
+                matched_on=["schema:same_table"],
+                payload={"logical": f"{table.name}.{column.name}", "node_type": "col"}))
+        # join 边（带证据等级）：与已触及表的 join 进白名单
+        for snapshot in snapshots.values():
+            for join in snapshot.joins:
+                if table.node_id in (join.left_table_id, join.right_table_id):
+                    _add_join_edge(expansion, join)
+
+
+def _add_join_edge(expansion: Expansion, join: Any) -> None:
+    key = (join.left_column_id, join.right_column_id)
+    for existing in expansion.joins:
+        if (existing.get("left"), existing.get("right")) == key:
+            return
+    expansion.joins.append({
+        "left": join.left_column_id,
+        "right": join.right_column_id,
+        "level": join.level,
+        "status": join.status,
+        "cardinality": join.cardinality,
+        "confidence": join.confidence,
+    })
+
+
+def _snapshot_column(snapshots: dict[str, Any], column_id: str):
+    """快照回源复验：列存在且 active → (所属表, 列)。"""
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            for column in table.columns:
+                if column.node_id == column_id:
+                    if column.status != "active":
+                        return None
+                    return table, column
+    return None
+
+
+def _snapshot_table_exists(snapshots: dict[str, Any], table_id: str) -> bool:
+    """快照回源复验：表存在。"""
+    return any(
+        table.node_id == table_id
+        for snapshot in snapshots.values()
+        for table in snapshot.tables
+    )
+
+
+# ==========================================================================
+# 小工具
+# ==========================================================================
+
+def _term_id_of(node_id: str) -> str:
+    """term:{ws}:{term_id} → term_id。"""
+    parts = node_id.split(":", 2)
+    return parts[2] if len(parts) == 3 else node_id
+
+
+def _term_node_of(record: dict[str, Any]) -> str:
+    """图读记录的两端里挑出术语节点 id（``term:`` 前缀），缺则回退 target。"""
+    for key in ("target", "source"):
+        value = str(record.get(key) or "")
+        if value.startswith("term:"):
+            return value
+    return str(record.get("target") or "")
+
+
+def _term_by_node_id(node_id: str) -> dict[str, Any] | None:
+    """术语节点 id 回源 glossary 复验（active 才保留）。"""
+    try:
+        term_id = _term_id_of(node_id)
+        for term in glossary_db.list_terms():
+            if str(term.get("term_id") or "") == term_id:
+                if term.get("status") == "deprecated":
+                    return None
+                return {
+                    "term_id": term_id,
+                    "name": str(term.get("name") or ""),
+                    "definition": str(term.get("definition") or ""),
+                    "synonyms": list(term.get("synonyms_list") or []),
+                }
+    except Exception:  # noqa: BLE001 —— 术语库不可用按未命中
+        return None
+    return None
+
+
+def _term_by_ref(target_ref: str) -> dict[str, Any] | None:
+    """``concept_map.target_ref`` → 术语（term_id 直查 / 名字全等，一份实现）。
+
+    解析规则与图投影侧共用 :func:`metrics.graph_projection.resolve_term`——
+    界面绑定链路存 term_id、Ossie 链路存自由文本，两种形态都要认。
+    """
+    from ..metrics.graph_projection import resolve_term
+
+    term = resolve_term(target_ref)
+    if term is None or not term.get("term_id"):
+        return None
+    return {
+        "term_id": str(term.get("term_id") or ""),
+        "name": str(term.get("name") or ""),
+        "definition": str(term.get("definition") or ""),
+        "synonyms": list(term.get("synonyms_list")
+                         or glossary_db.parse_synonyms(term.get("synonyms"))),
+    }
+
+
+def _column_name_of(node_id: str) -> str:
+    """col:...:{db}.{tbl}.{col} → col（尾段）。"""
+    return node_id.rsplit(".", 1)[-1] if "." in node_id else node_id
