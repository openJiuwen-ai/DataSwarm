+def _query_stub(responses: dict[str, list[dict]]):
+    """按 SQL 片段匹配返回预置结果（未匹配抛错走单列跳过分支）。"""
+    def _query(db_ref, sql, limit=None):
+        for fragment, rows in responses.items():
+            if fragment in sql:
+                return rows
+        raise RuntimeError(f"unexpected sql: {sql}")
+
+    return _query
+
