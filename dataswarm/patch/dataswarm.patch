+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Redis/HBase/HDFS 的离线契约与扫描护栏检查。
+
+使用纯函数和受控客户端验证引擎映射、ref、逻辑表语法及扫描边界。
+本脚本不连接服务；真实实例结果及其边界见各批验收记录。
+"""
+import sys
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (
+    get_engine, registered_engines,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R
+from jiuwenswarm.common import db_connector as dbc
+
+TARGETS = ("redis", "hbase", "hdfs")
+PASS, FAIL, SKIP = [], [], []
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+# ======================================================================
+print("\n########## 门 A：声明与校验 ##########")
+
+
+def a_declared_availability():
+    types = {t["type_id"]: t for t in R.list_source_types()}
+    for tid in TARGETS:
+        entry = types[tid]
+        adapter = R.get_source_type(tid)
+        assert adapter.released is True, tid
+        assert entry["available"] == (not adapter.missing_requirements), entry
+        assert entry["fields"], f"{tid} 无表单字段"
+        assert R.get_source_type(tid).requires, f"{tid} 未声明 requires"
+    return "redis/hbase/hdfs 已放开；可用性与驱动状态一致，字段与 requires 齐备"
+
+
+def a_engine_reuse_is_real():
+    """验证源类型映射到声明的 sampled 或 staged 引擎。"""
+    expected = {
+        "redis": "sampled",      # 采样建模引擎
+        "hbase": "sampled",      # 同上
+        "hdfs": "staged",        # 远端文件暂存引擎
+    }
+    types = {t["type_id"]: t for t in R.list_source_types()}
+    for tid, engine in expected.items():
+        assert types[tid]["engine"] == engine, (tid, types[tid]["engine"], engine)
+        assert get_engine(engine), engine
+    return f"三个类型复用 sampled/staged；现有引擎 {registered_engines()}"
+
+
+def a_hdfs_inherits_ftp_wholesale():
+    """HDFS 通过 FtpAdapter 复用暂存契约，协议配置独立声明。"""
+    from jiuwenswarm.channels.web.dataagent.datasource.registry import (
+        FtpAdapter, HdfsAdapter,
+    )
+
+    assert issubclass(HdfsAdapter, FtpAdapter)
+    own = {n for n, v in vars(HdfsAdapter).items()
+           if callable(v) and not n.startswith("__")}
+    assert own <= {"build_ref"}, f"hdfs 自带了多余逻辑: {own}"
+    adapter = R.get_source_type("hdfs")
+    assert adapter.protocols == ("webhdfs",), adapter.protocols
+    return f"仅覆写 build_ref；协议={adapter.protocols}"
+
+
+def a_validate_rules():
+    # redis：必须显式声明逻辑表，且拒绝全键扫描
+    redis = R.get_source_type("redis")
+    base = {"host": "127.0.0.1", "port": 6379}
+    expect_raises(lambda: redis.validate(base), ValueError, "redis 缺 datasets")
+    expect_raises(lambda: redis.validate({**base, "datasets": "hash:*"}),
+                  ConnectorError, "redis 全键扫描")
+    expect_raises(lambda: redis.validate({**base, "datasets": "list:foo"}),
+                  ConnectorError, "redis 不支持的结构类型")
+    redis.validate({**base, "datasets": "hash:order:*,stream:events,zset:top"})
+
+    # hbase
+    hbase = R.get_source_type("hbase")
+    expect_raises(lambda: hbase.validate({}), ValueError, "hbase 缺 host")
+    hbase.validate({"host": "h", "port": 9090})
+
+    # hdfs：继承 ftp 的校验（含 path 穿越拦截）
+    hdfs = R.get_source_type("hdfs")
+    ok = {"protocol": "webhdfs", "host": "h", "user": "hdfs",
+          "path": "/warehouse/*.parquet", "format": "parquet"}
+    hdfs.validate(ok)
+    expect_raises(lambda: hdfs.validate({**ok, "path": "/a/../../etc/*.parquet"}),
+                  ValueError, "hdfs path 含 ..")
