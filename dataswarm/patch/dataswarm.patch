@@ -0,0 +1,104 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Governance SQL contracts; SQLite execution below is not vendor acceptance."""
+from __future__ import annotations
+
+import sqlite3
+from unittest.mock import MagicMock
+
+import pytest
+
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+
+
+@pytest.mark.parametrize("kind", ["postgresql", "postgres", "hologres", "sqlserver", "sqlite"])
+def test_non_mysql_identifiers_are_not_translated_to_backticks(kind):
+    sql = 'SELECT "MixedCase" FROM "Sales"."Orders"'
+    assert dbc._translate_sql(sql, kind) == sql
+
+
+def test_mysql_translation_preserves_string_contents_and_doris_properties():
+    sql = '''SELECT "col", '{"key":"value"}', '?' FROM "t" -- "comment"'''
+    assert dbc._translate_sql(sql, "mysql") == '''SELECT `col`, '{"key":"value"}', '?' FROM `t` -- "comment"'''
+    ddl = 'CREATE TABLE "t" ("id" BIGINT) PROPERTIES("replication_num"="1")'
+    assert dbc._translate_sql(ddl, "doris") == 'CREATE TABLE `t` (`id` BIGINT) PROPERTIES("replication_num"="1")'
+
+
+def test_sqlserver_retains_odbc_question_binds_and_literal_percent():
+    original = "SELECT ? AS [value], '?' AS [literal?], '50%' AS pct -- ?"
+    sql, values = dbc._format_sql(original, (7,), "sqlserver")
+    assert sql == original and values == (7,)
+
+
+@pytest.mark.parametrize("kind", ["mysql", "doris", "postgresql", "hologres"])
+def test_percent_drivers_preserve_native_binds_and_literal_question_marks(kind):
+    sql = "SELECT '?', '50%', a % 3 FROM t WHERE x=? AND y=%s -- ? and 10%"
+    actual, values = dbc._format_sql(sql, (1, 2), kind)
+    assert actual == "SELECT '?', '50%%', a %% 3 FROM t WHERE x=%s AND y=%s -- ? and 10%%"
+    assert values == [1, 2]
+
+
+def test_postgres_dollar_and_escape_strings_do_not_consume_binds():
+    sql = r'''SELECT $$? ' " $$, $tag$?$tag$, E'it\'s ?' FROM "t" WHERE "x"=?'''
+    actual, values = dbc._format_sql(sql, (8,), "postgresql")
+    assert actual == sql[:-1] + "%s" and values == [8]
+
+
+@pytest.mark.parametrize("kind", ["mysql", "postgresql"])
+def test_named_percent_params_keep_the_dict(kind):
+    sql, values = dbc._format_sql("SELECT %(v)s, '50%'", {"v": 1}, kind)
+    assert sql == "SELECT %(v)s, '50%%'" and values == {"v": 1}
+
+
+@pytest.mark.parametrize("kind", ["sqlserver"])
+@pytest.mark.parametrize("method", ["query", "query_dict"])
+@pytest.mark.parametrize("sql", ["UPDATE orders SET amount=0", "DROP TABLE orders",
+                                 "SELECT 1 INTO new_table", "SELECT 1; SELECT 2"])
+def test_new_sql_family_readonly_guard_rejects_before_acquiring(monkeypatch, kind, method, sql):
+    acquire = MagicMock(side_effect=AssertionError("must not acquire"))
+    monkeypatch.setattr(dbc, "_acquire", acquire)
+    with pytest.raises(QueryValidationError):
+        getattr(dbc, method)(f"{kind}://h:1234/db", sql)
+    acquire.assert_not_called()
+
+
+def sqlite_backing(monkeypatch, kind):
+    executed = []
+
+    def acquire(*args, **kwargs):
+        conn = sqlite3.connect(":memory:")
+        conn.execute("CREATE TABLE orders(id INTEGER)")
+        conn.executemany("INSERT INTO orders VALUES(?)", [(i,) for i in range(5)])
+        conn.execute("CREATE TABLE dual(dummy INTEGER)")
+        conn.execute("INSERT INTO dual VALUES(1)")
+        conn.set_trace_callback(executed.append)
+        return conn, {"type": kind}
+    monkeypatch.setattr(dbc, "_acquire", acquire)
+    monkeypatch.setattr(dbc, "_is_duckdb", lambda ref: False)
+    monkeypatch.setattr(dbc, "_invalidate", lambda *args, **kwargs: None)
+    return executed
+
+
+@pytest.mark.parametrize("kind", ["sqlserver"])
+@pytest.mark.parametrize("method", ["query", "query_dict"])
+def test_vendor_fetch_limit_does_not_append_mysql_limit(monkeypatch, kind, method):
+    executed = sqlite_backing(monkeypatch, kind)
+    result = getattr(dbc, method)(f"{kind}://h:1234/db", "SELECT id FROM orders ORDER BY id", limit=2)
+    if method == "query":
+        assert result["rows"] == [[0], [1]] and result["truncated"] is True
+    else:
+        assert result == [{"id": 0}, {"id": 1}]
+    assert all("LIMIT" not in sql.upper() for sql in executed)
+
+
+@pytest.mark.parametrize("kind", ["sqlserver"])
+@pytest.mark.parametrize("method", ["query", "query_dict"])
+def test_positional_binds_execute_without_touching_quoted_question(monkeypatch, kind, method):
+    sqlite_backing(monkeypatch, kind)
+    result = getattr(dbc, method)(
+        f"{kind}://h:1234/db", '''SELECT ? AS "Value", '?' AS "Literal" FROM dual''', (7,), limit=2
+    )
+    if method == "query":
+        assert result["columns"] == ["Value", "Literal"] and result["rows"] == [[7, "?"]]
+    else:
+        assert result == [{"Value": 7, "Literal": "?"}]
