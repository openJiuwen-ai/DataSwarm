+            datasource_alias="other_csv", datasource_ref=other_ref,
+            source_table="t", verify_status="verified"))
+    finally:
+        workspace_context.reset(token)
+
+    existing = {
+        "source_id": "moved_csv",
+        "source_type": "csv",
+        "config": {"path": biz_dir},
