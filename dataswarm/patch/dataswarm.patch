+#!/usr/bin/env bash
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+# ===========================================================================
+# JiuwenSwarm 前端构建脚本（Git Bash / WSL）
+#
+# 用法：
+#   ./build_web.sh          构建（tsc 类型检查 + vite build）
+#   ./build_web.sh dev      仅启动 vite dev server（开发热更新，不产物）
+#   ./build_web.sh clean    清理 dist 后再构建
+#
+# 构建产物：jiuwenswarm/channels/web/frontend/dist
+# 后端 app_web.py serve 的就是这个 dist 目录，改完源码必须构建才生效。
+# ===========================================================================
+set -euo pipefail
+
+# 切到项目根（脚本所在目录）
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"  # 脚本在 scripts/, 根在上一级
+cd "$SCRIPT_DIR"
+
+FRONTEND_DIR="jiuwenswarm/channels/web/frontend"
+DIST_DIR="$FRONTEND_DIR/dist"
+ACTION="${1:-build}"
+
+# ---------------------------------------------------------------------------
+# 颜色
+# ---------------------------------------------------------------------------
+if [[ -t 1 ]]; then
+  C_RESET="\033[0m"; C_INFO="\033[1;34m"; C_OK="\033[1;32m"
+  C_WARN="\033[1;33m"; C_ERR="\033[1;31m"
+else
+  C_RESET=""; C_INFO=""; C_OK=""; C_WARN=""; C_ERR=""
+fi
+
+log()   { echo -e "${C_INFO}[*]${C_RESET} $1"; }
+ok()    { echo -e "${C_OK}[v]${C_RESET} $1"; }
+warn()  { echo -e "${C_WARN}[!]${C_RESET} $1"; }
+err()   { echo -e "${C_ERR}[x]${C_RESET} $1"; }
+
+# ---------------------------------------------------------------------------
+# 前置检查
+# ---------------------------------------------------------------------------
+if [[ ! -d "$FRONTEND_DIR" ]]; then
+  err "前端目录不存在: $FRONTEND_DIR"
+  exit 1
+fi
+cd "$FRONTEND_DIR"
+
+if ! command -v npm >/dev/null 2>&1; then
+  err "未找到 npm，请先安装 Node.js"
+  exit 1
+fi
+
+if [[ ! -d node_modules ]]; then
+  log "node_modules 缺失，先安装依赖..."
+  npm install
+fi
+
+# ---------------------------------------------------------------------------
+# 构建
+# ---------------------------------------------------------------------------
+do_build() {
+  log "开始构建前端（tsc + vite build）..."
+  # prebuild 会自动生成 agent 文件夹；build = tsc 类型检查 + vite 打包
+  if npm run build; then
+    echo
+    ok "构建成功"
+    log "产物目录: $DIST_DIR"
+    # 列出产物体积，方便确认
+    if [[ -d dist ]]; then
+      size=$(du -sh dist 2>/dev/null | cut -f1 || echo "?")
+      log "dist 体积: $size"
+    fi
+    echo
+    ok "后端 app_web.py serve 的即此 dist，重启 web 服务后生效：./restart.sh restart"
+  else
+    err "构建失败，请检查上方报错"
+    exit 1
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# 分发
+# ---------------------------------------------------------------------------
+case "$ACTION" in
+  build)
+    do_build
+    ;;
+  clean)
+    log "清理旧 dist..."
+    rm -rf "$DIST_DIR"
+    ok "已清理"
+    do_build
+    ;;
+  dev)
+    log "启动 vite dev server（Ctrl+C 退出）..."
+    log "开发服务器默认 http://127.0.0.1:5173，热更新不产出 dist"
+    npm run dev
+    ;;
+  *)
+    echo "用法: ./build_web.sh [build|dev|clean]"
+    echo "  build    构建（默认，tsc + vite build）"
+    echo "  clean    清理 dist 后再构建"
+    echo "  dev      启动 vite dev server（开发热更新）"
+    exit 1
+    ;;
+esac
