+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Real SFTP acceptance: AsyncSSH server vs product's Paramiko client.
+
+Usage: python tests/acceptance/datasource/batch12/verify_gates.py <fixture_dir>
+Requires test-only asyncssh. No shell, port forwarding, or public listener.
+The server and its temporary files are closed even when the gates fail.
+Protocol reference: https://asyncssh.readthedocs.io/en/latest/#sftp-server
+"""
+import asyncio
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import time
+
+import asyncssh
+
+
+class AuthServer(asyncssh.SSHServer):
+    def begin_auth(self, username):
+        return True
+
+    def password_auth_supported(self):
+        return True
+
+    def validate_password(self, username, password):
+        return username == "dsuser" and password == "dspass"
+
+
+async def main():
+    fixture = Path(sys.argv[1]).resolve()
+    gate = Path(__file__).resolve().parents[1] / "batch4" / "verify_gates.py"
+    with tempfile.TemporaryDirectory(prefix="dataswarm-sftp-") as directory:
+        root = Path(directory) / "data"
+        root.mkdir()
+        for suffix in ("csv", "json", "parquet"):
+            target = root / f"fact_orders.{suffix}"
+            shutil.copy2(fixture / target.name, target)
+            # An old remote mtime verifies that cache TTL does not remove a fetched file.
+            old = time.time() - 30 * 24 * 3600
+            os.utime(target, (old, old))
+        (root / "directory.csv").mkdir()  # Must not be downloaded as a file.
+        # The trust anchor is produced locally with the fixture server's key,
+        # never learned by connecting to an unverified network endpoint.
+        host_key = asyncssh.generate_private_key("ssh-rsa")
+        async with await asyncssh.create_server(
+            AuthServer, "127.0.0.1", 0,
+            server_host_keys=[host_key],
+            sftp_factory=lambda channel: asyncssh.SFTPServer(channel, chroot=str(root)),
+        ) as server:
+            known_hosts = Path(directory) / "known_hosts"
+            public_key = host_key.export_public_key("openssh").decode("ascii").strip()
+            known_hosts.write_text(f"[127.0.0.1]:{server.get_port()} {public_key}\n", encoding="ascii")
+            env = dict(os.environ, DATASOURCE_ACCEPTANCE_PROTOCOL="sftp",
+                       SFTP_USER="dsuser", SFTP_PASSWORD="dspass", PYTHONUTF8="1",
+                       SFTP_KNOWN_HOSTS=str(known_hosts))
+            env.pop("SFTP_HOST_KEY_SHA256", None)
+            with tempfile.TemporaryDirectory(prefix="dataswarm-sftp-cache-") as cache:
+                env["JIUWENSWARM_STAGED_CACHE"] = cache
+                print(f"Real AsyncSSH SFTP server: 127.0.0.1:{server.get_port()}", flush=True)
+                process = await asyncio.create_subprocess_exec(
+                    sys.executable, str(gate), str(server.get_port()), str(root), env=env,
+                )
+                try:
+                    code = await asyncio.wait_for(process.wait(), timeout=180)
+                except BaseException:
+                    process.kill()
+                    await process.wait()
+                    raise
+        return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(asyncio.run(main()))
