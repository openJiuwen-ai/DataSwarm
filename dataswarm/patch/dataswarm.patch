+        _make_target("cron", cron="0 2 * * *", ref_id="due_one"),
+        _make_target("cron", cron="0 2 * * *", ref_id="not_due"),
+    ])
+    # due_one: 上次远在昨天前 → due；not_due: 上次刚触发 → not due
+
+    def fake_last(rt, rid):
+        return "2026-08-28T16:00:00+0800" if rid == "due_one" else "2026-08-29T08:30:00+0800"
+    monkeypatch.setattr(scheduler.orch_db, "last_instance_ts", fake_last)
+    monkeypatch.setattr(scheduler.orch_db, "mark_once_fired", lambda *_a, **_k: None)
+
+    def fake_create(rt, rid, **_kw):
