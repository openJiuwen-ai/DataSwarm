+# ======================================================================
+print("\n########## 门 B：建模与暂存 ##########")
+
+
+def b_staging_fetches_real_files():
+    clear_cache_for("stage-test", HDFS_CONFIG["path"])
+    conn = connector_for(source_id="stage-test")
+    report = conn.stage()
+    assert report["fetched"] >= 1, report
+    local = Path(report["files"][0])
+    assert local.is_file(), local
+    remote_size = (DATA / "fact_orders.csv").stat().st_size
+    assert local.stat().st_size == remote_size, (
+        f"暂存文件大小与源不一致: {local.stat().st_size} != {remote_size}"
+    )
+    return f"经 WebHDFS 取回 {len(report['files'])} 个文件，字节数与源一致（{remote_size:,}）"
+
+
+def b_incremental_skips_unchanged():
+    clear_cache_for("incr-test", HDFS_CONFIG["path"])
+    conn = connector_for(source_id="incr-test")
+    first = conn.stage()
+    second = conn.stage()
+    assert first["fetched"] >= 1, first
+    assert second["fetched"] == 0, f"第二次仍在下载: {second}"
+    assert second["skipped"] >= 1, second
+    return (f"首次 fetched={first['fetched']}，"
+            f"再次 fetched={second['fetched']}/skipped={second['skipped']}")
+
+
+def b_307_redirect_is_real_and_followed():
+    """先禁止自动跳转，确认 OPEN 返回指向 DataNode 端口的 307。
+
+    随后验证产品 fetcher 跟随跳转并取回完整文件。
+    """
+    import requests
+
+    url = f"http://127.0.0.1:{PORT}/webhdfs/v1{HDFS_DIR}/fact_orders.csv"
+    params = {"op": "OPEN", "user.name": USER}
+    raw = requests.get(url, params=params, allow_redirects=False, timeout=30)
+    assert raw.status_code == 307, f"NameNode 未回 307，而是 {raw.status_code}"
+    location = raw.headers.get("Location", "")
+    assert location, f"307 没带 Location: {dict(raw.headers)}"
+    dn_port = urllib.parse.urlparse(location).port
+    assert dn_port and dn_port != PORT, f"Location 没指向 DataNode: {location}"
+
+    # fetcher 跟随重定向后必须拿到完整字节（allow_redirects=True 的那条路）
+    clear_cache_for("redirect-test", HDFS_CONFIG["path"])
+    report = connector_for(source_id="redirect-test").stage()
+    got = Path(report["files"][0]).stat().st_size
+    want = (DATA / "fact_orders.csv").stat().st_size
+    assert got == want, f"跟随重定向后字节不全: {got} != {want}"
+    return (f"NameNode 回 307 → DataNode:{dn_port}；"
+            f"fetcher 跟随后字节完整（{want:,}）")
+
+
+def b_modification_time_unit_is_milliseconds():
+    """modificationTime 从毫秒转换为秒，并检查绝对时间范围。
+
+    增量指纹比较可能在单位始终错误时仍通过，因此单独验证时间单位。
+    """
+    files = fetcher_for().list_files(HDFS_CONFIG["path"])
+    assert files, "LISTSTATUS 没返回文件"
+    path, size, mtime = files[0]
+    now = time.time()
+    assert 0 < mtime < now + 86400, (
+        f"mtime={mtime}（≈{time.strftime('%Y-%m-%d', time.gmtime(min(mtime, 2 ** 31)))}）"
+        f" 不是秒——毫秒没除 1000？"
+    )
+    assert now - mtime < 30 * 86400, f"mtime={mtime} 太旧，不像刚上传的文件"
+    assert size == (DATA / "fact_orders.csv").stat().st_size, size
+    return (f"mtime={time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(mtime))}"
+            f"（毫秒已正确换算）；size 与源一致")
+
+
+def b_listing_skips_directories():
+    """LISTSTATUS 会把子目录一并返回，必须按 type == FILE 过滤。"""
+    parent = fetcher_for().list_files("/warehouse/*")
+    assert parent == [], f"目录项被当成文件: {parent}"
+    here = fetcher_for().list_files(f"{HDFS_DIR}/*")
+    names = sorted(Path(p).name for p, _, _ in here)
+    assert len(here) >= 3, here
+    return f"上一级只含目录→返回空；{HDFS_DIR} 下 {len(here)} 个文件 {names}"
+
+
+def b_cache_stays_in_controlled_root():
+    report = connector_for(source_id="root-test").stage()
+    root = cpaths.staged_cache_root()
+    for item in report["files"]:
+        resolved = Path(item).resolve()
+        assert root in resolved.parents, f"缓存逃出受控根目录: {resolved}"
+    cache_dir = Path(report["cache_dir"]).name
+    assert len(cache_dir) == 16 and all(c in "0123456789abcdef" for c in cache_dir)
+    return f"缓存落在 {root} 下，子目录为 16 位哈希"
+
+
+def b_catalog_and_schema():
+    conn = connector_for()
+    datasets = dataset_names(conn.catalog())
+    assert datasets, "catalog 为空"
+    sch = conn.schema(datasets[0])
+    names = [c["name"] for c in sch["columns"]]
+    for want in ("order_id", "order_date", "order_amt", "channel_name"):
+        assert want in names, names
+    assert "partition_key" in sch and "primary_key" in sch, list(sch)
+    assert dr.sqlglot_dialect("hdfs") == "duckdb", dr.sqlglot_dialect("hdfs")
+    got = {n: dr.logical_type("hdfs", t)
+           for n, t in ((c["name"], c["type"]) for c in sch["columns"])}
+    assert got["order_amt"] == dr.NUMERIC, got["order_amt"]
+    assert got["channel_name"] == dr.TEXT, got["channel_name"]
+    assert got["order_date"] == dr.TIME, got["order_date"]
+    return f"数据集 {datasets}，{len(names)} 列；方言归一 duckdb，逻辑类型正确"
+
+
+def b_governance_path():
+    """通路 B/C：治理 / 血缘 / 知识派生走 db_connector，不是 connectors。"""
+    ref = R.get_source_type("hdfs").build_ref(HDFS_CONFIG)
+    spec = dbc.parse_db_ref(ref)
+    assert spec["source_type"] == "hdfs", spec
+    assert spec["location"] == f"webhdfs://127.0.0.1:{PORT}{HDFS_CONFIG['path']}", spec
+
+    names = dbc.tables(ref)["tables"]
+    assert "fact_orders" in names, names
+    cols = dbc.schema(ref, "fact_orders")["columns"]
+    assert len(cols) == 7, cols
+    by = {c["name"]: c for c in cols}
+    assert set(by) >= {"order_id", "order_amt", "channel_name"}, list(by)
+
+    # WebHDFS 默认端口为 9870，不继承 FTP 的默认端口。
+    no_port = {**spec, "location": f"webhdfs://127.0.0.1{HDFS_CONFIG['path']}"}
+    assert dbc._staged_config_from_location(no_port)["port"] == 9870
+    return (f"db_connector.tables={names}，schema {len(cols)} 列；"
+            f"不带端口的 location 补成 9870（原先错成 21）")
+
+
+def b_knowledge_candidates():
+    from jiuwenswarm.channels.web.dataagent.knowledge import schema_candidates as sc
+
+    ref = R.get_source_type("hdfs").build_ref(HDFS_CONFIG)
+    cols = dbc.schema(ref, "fact_orders")["columns"]
+    hits = {}
+    for col in cols:
+        hit = sc._classify("fact_orders", col, "hdfs")
+        if hit:
+            hits[col["name"]] = (hit["asset_type"], hit["rule"])
+    assert hits["order_amt"] == ("metric", "quantity"), hits
+    assert hits["channel_name"] == ("term", "dimension"), hits
+    assert hits["order_date"] == ("term", "time"), hits
+    return f"经 WebHDFS 的真实列派生 {len(hits)} 条候选，覆盖三条规则"
+
+
+check("B1", "真实 WebHDFS 取文件", b_staging_fetches_real_files)
+check("B2", "增量拉取跳过未变文件", b_incremental_skips_unchanged)
+check("B3", "307 重定向真实且被跟随", b_307_redirect_is_real_and_followed)
+check("B4", "modificationTime 毫秒单位", b_modification_time_unit_is_milliseconds)
+check("B5", "LISTSTATUS 跳过目录项", b_listing_skips_directories)
+check("B6", "缓存受控且防穿越", b_cache_stays_in_controlled_root)
+check("B7", "catalog / schema / 逻辑类型", b_catalog_and_schema)
+check("B8", "治理通路 db_connector 打通", b_governance_path)
+check("B9", "知识候选分类（经 WebHDFS）", b_knowledge_candidates)
+
+blocked("B10", "知识候选落库",
+        "分类规则已验（B9），但写入 dw_business_knowledge 需元数据库；"
+        "同前几批：默认元数据库为 doris 且本仓缺知识表 DDL。")
