+
+# --------------------------------------------------------------------------
+# _tick：扫描 + 派发（端到端胶水）
+# --------------------------------------------------------------------------
+def test_tick_fires_only_due_targets(monkeypatch):
+    """_tick 扫到 2 个目标，只 due 的那个被 fire。now 直接注入（_tick 支持可选 now 参数）。"""
+    tz = ZoneInfo(_TZ)
