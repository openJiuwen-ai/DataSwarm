+def test_update_source_blocked_when_probe_fails(monkeypatch, workspace_env):
+    """编辑库型源探测失败 → 阻断，无 update 调用。"""
+    existing = {
+        "source_id": "edit_doris",
+        "source_type": "doris",
+        "config": {k: v for k, v in DORIS_PARAMS.items() if k not in ("source_id", "type")},
