+    # 已含 "JSON"（任意大小写）时原样返回，不重复追加
+    assert _ensure_json_keyword("Output ONLY JSON per schema") == "Output ONLY JSON per schema"
+
+
+def test_generate_typed_guarantees_json_keyword_in_prompt():
+    sent = []
+
+    class _Choice:
+        finish_reason = "stop"
+        message = SimpleNamespace(content='{"assets": [{"title": "t"}]}', reasoning_content="")
+
+    class _FakeOpenAI:
