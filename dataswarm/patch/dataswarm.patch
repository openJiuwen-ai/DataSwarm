+    ods_file_infos = [
+        files_by_name[e["file"]] for e in selected if e["file"] in files_by_name
+    ]
+    ods_tables = [
+        render.render_ods_plan_table(biz, info, dialect=dialect) for info in ods_file_infos
+    ]
