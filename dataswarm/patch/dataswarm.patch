+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Opt-in daily scheduler hook for semantic collection."""
+from __future__ import annotations
+
+import os
+from datetime import datetime
+
+from jiuwenswarm.channels.web.dataagent.datasource import store as datasource_store
+
+from . import service
+from .adapters import metadata_adapter_for
+
+
+def tick(now: datetime) -> int:
+    """Start due runs for enabled sources with supported metadata collectors."""
+    if os.environ.get("DATAAGENT_SEMANTIC_P0_ENABLED", "0").strip().lower() not in {"1", "true", "yes"}:
+        return 0
+    try:
+        schedule_hour = int(os.environ.get("DATAAGENT_SEMANTIC_SCHEDULE_HOUR", "2"))
+        schedule_minute = int(os.environ.get("DATAAGENT_SEMANTIC_SCHEDULE_MINUTE", "0"))
+    except ValueError:
+        return 0
+    if now.hour != schedule_hour or now.minute != schedule_minute:
+        return 0
+    started = 0
+    for source in datasource_store.list_sources():
+        if not source.get("enabled", True):
+            continue
+        try:
+            metadata_adapter_for(source)
+        except ValueError:
+            continue
+        recent = service.list_runs(source["source_id"], limit=10)
+        already_started = any(
+            str(run.get("trigger_type")) == "daily"
+            and str(run.get("started_at") or "").startswith(now.date().isoformat())
+            for run in recent
+        )
+        if already_started:
+            continue
+        service.start_run({"source_id": source["source_id"], "trigger_type": "daily"})
+        started += 1
+    return started
