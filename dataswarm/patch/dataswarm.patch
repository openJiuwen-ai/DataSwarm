index 000000000..b8a6bfc7b
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/versioning/crud.py
@@ -0,0 +1,389 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning/crud.py —— 指标/修订的创建、更新、删除（含构建与重投影）（自 versioning.py 巨石按用例拆分，纯搬运）。
+
+发布语义见包门面 docstring（versioning/__init__.py）。
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import _now
+
+from .. import ossie as ossie_mod
+from .. import store
+from .ossie_import import _carry_over_term_maps
+from ..errors import DefinitionError, MetricNotFound
+from ..model import (
+    BINDING_UNBOUND,
+    BINDING_VERIFIED,
+    METRIC_TYPE_ATOMIC,
+    METRIC_TYPE_RATIO,
+    METRIC_TYPES,
+    REVISION_CANDIDATE,
+    REVISION_PUBLISHED,
+    Binding,
+    ExpressionSpec,
+    MetricDef,
+    MetricRevision,
+)
+
+
+# ==========================================================================
+# 手动建指标 / 改口径 / 改身份 / 删除
+# ==========================================================================
+def _text_list(raw: Any) -> tuple[str, ...]:
+    """把逗号分隔字符串或数组统一成去空白的字符串元组。"""
+    if isinstance(raw, str):
+        parts = raw.replace("，", ",").split(",")
+    elif isinstance(raw, (list, tuple)):
+        parts = [str(item) for item in raw]
+    else:
+        return ()
+    return tuple(part.strip() for part in parts if part.strip())
+
+
+def _revision_payload(payload: dict[str, Any]) -> dict[str, Any]:
+    """新建指标允许 ``{metric_key, name, revision: {...}, binding: {...}}``
+    或扁平写法；统一取口径字段所在的 dict。"""
+    nested = payload.get("revision")
+    return nested if isinstance(nested, dict) else payload
+
+
+def _build_revision(
+    workspace_id: str,
+    metric_key: str,
+    metric_id: str,
+    revision_no: int,
+    payload: dict[str, Any],
+    *,
+    target_db_type: str = "",
+    default_display_name: str = "",
+    previous: MetricRevision | None = None,
+) -> MetricRevision:
+    """由表单载荷构造 candidate 修订（表达式解析复用 Ossie 链路）。
+
+    载荷缺失的冷门字段（datatype / fixed_filters / timezone / calendar /
+    additivity / subject_iri / zero_denominator / 表达式方言）从上一修订继承：
+    表单没有这些输入，若一律取默认值，新建修订会静默丢掉 Ossie 导入时
+    携带的口径约束。
+
+    Raises:
+        DefinitionError: 必填字段缺失、ratio 依赖数不为 2、或口径自校验失败。
+    """
+    def held(key: str, carried: Any, fallback: Any) -> Any:
+        """载荷显式给了就用载荷，否则继承上一修订，再否则用默认值。"""
+        if key in payload:
+            return payload[key]
+        return carried if previous is not None else fallback
+
+    metric_type = str(payload.get("metric_type") or METRIC_TYPE_ATOMIC)
+    if metric_type not in METRIC_TYPES:
+        raise DefinitionError(
+            f"metric_type={metric_type!r} 非法（支持 {', '.join(sorted(METRIC_TYPES))}）")
+    expression_text = str(payload.get("expression") or "").strip()
+    dialect = str(
+        payload.get("expression_dialect")
+        or (previous.expression.resolved_dialect if previous else "")
+        or "ANSI_SQL")
+    resolved_dialect, raw_expression = ossie_mod.resolve_dialect(
+        {dialect: expression_text} if expression_text else {}, target_db_type)
+    if raw_expression:
+        parsed, unparsed = ossie_mod.parse_expression(raw_expression, resolved_dialect)
+    else:
+        parsed, unparsed = None, "无表达式"
+    dependencies = _text_list(payload.get("dependencies"))
+    if metric_type == METRIC_TYPE_RATIO and len(dependencies) != 2:
+        raise DefinitionError(
+            "ratio 指标必须恰好声明 2 个 dependencies（按顺序为分子、分母）")
+    zero_denominator = str(held(
+        "zero_denominator",
+        previous.zero_denominator if previous else "", "") or "").strip()
+    if metric_type == METRIC_TYPE_RATIO and zero_denominator not in ("", "null", "zero"):
+        raise DefinitionError("zero_denominator 只支持 null / zero / 空")
+    fixed_filters_raw = held(
+        "fixed_filters", previous.fixed_filters if previous else (), ())
+    additivity_raw = held("additivity", previous.additivity if previous else {}, {})
+    revision = MetricRevision(
+        revision_id=store.new_id("rev"),
+        metric_id=metric_id,
+        workspace_id=workspace_id,
+        revision_no=revision_no,
+        metric_type=metric_type,
+        datatype=str(held("datatype", previous.datatype if previous else "", "") or ""),
+        unit=str(payload.get("unit") or ""),
+        display_name=str(
+            payload.get("display_name") or payload.get("name") or default_display_name),
+        synonyms=_text_list(payload.get("synonyms")),
+        expression=ExpressionSpec(
+            resolved_dialect=resolved_dialect,
+            dialects={dialect: expression_text} if expression_text else {},
+            parsed=parsed,
+            unparsed_reason=unparsed,
+        ),
+        fixed_filters=tuple(
+            dict(item) for item in fixed_filters_raw or ()
+            if isinstance(item, dict)),
+        time_dimension=str(payload.get("time_dimension") or "").strip(),
+        allowed_dimensions=_text_list(payload.get("allowed_dimensions")),
+        time_grains=_text_list(payload.get("time_grains")),
+        timezone=str(held("timezone", previous.timezone if previous else "", "") or ""),
+        calendar=str(held("calendar", previous.calendar if previous else "", "") or ""),
+        dependencies=dependencies,
+        zero_denominator=zero_denominator,
+        additivity={
+            str(key): str(value) for key, value in additivity_raw.items()
+        } if isinstance(additivity_raw, dict) else {},
+        subject_iri=str(held(
+            "subject_iri", previous.subject_iri if previous else "", "") or ""),
+        status=REVISION_CANDIDATE,
+        source_type="manual",
+        definition_ref=f"dataswarm:metric:{workspace_id}:{metric_key}@r{revision_no}",
+    )
+    revision = replace(revision, definition_hash=revision.compute_definition_hash())
+    revision.validate()
+    return revision
+
+
+def _create_binding(
+    workspace_id: str, revision: MetricRevision, raw: Any
+) -> Binding | None:
+    """按表单载荷落一条物理绑定。
+
+    未填任何绑定字段时返回 None（允许先存口径、后补绑定）；只填了一部分
+    （选数据源但没填表，反之亦然）直接报错，不落半条绑定。
+
+    Raises:
+        DefinitionError: 绑定字段不完整。
+    """
+    if not isinstance(raw, dict) or not raw:
+        return None
+    alias = str(raw.get("datasource_alias") or "").strip()
+    source_table = str(raw.get("source_table") or "").strip()
+    column_map_raw = raw.get("column_map")
+    if not alias and not source_table and not column_map_raw:
+        return None
+    if not alias or not source_table:
+        raise DefinitionError("绑定需要同时提供 datasource_alias 与 source_table")
+    db_ref = ossie_mod.default_datasource_resolver(workspace_id)(alias)
+    column_map = {
+        str(key): str(value) for key, value in column_map_raw.items()
+    } if isinstance(column_map_raw, dict) else {}
+    if not column_map and revision.expression.parsed:
+        # 恒等映射：逻辑列名 → 同名列（与 Ossie 数据集字段绑定同构）
+        column_map = {
+            ref.split(".")[-1]: ref.split(".")[-1]
+            for ref in revision.expression.parsed.fields
+        }
+    binding = Binding(
+        binding_id=store.new_id("bnd"),
+        revision_id=revision.revision_id,
+        workspace_id=workspace_id,
+        datasource_alias=alias,
+        datasource_ref=db_ref or "",
+        source_table=source_table,
+        column_map=column_map,
+        verify_status=BINDING_VERIFIED if db_ref else BINDING_UNBOUND,
+        verify_detail="" if db_ref else f"数据源别名 {alias!r} 未解析到已注册的 datasource",
+        verified_at=_now() if db_ref else "",
+        created_at=_now(),
+    )
+    store.create_binding(binding)
+    return binding
+
+
+def _previous_revision(metric: MetricDef) -> MetricRevision | None:
+    """指标当前生效修订；未发布时回退到最新一版。"""
+    if metric.current_revision_id:
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is not None:
+            return revision
+    revisions = store.list_revisions(metric.metric_id)
+    return revisions[0] if revisions else None
+
+
+def create_metric(
+    workspace_id: str,
+    payload: dict[str, Any],
+    *,
+    target_db_type: str = "",
+) -> dict[str, Any]:
+    """手动新建指标（身份 + 第一个 candidate 修订 + 绑定 + 依赖候选映射）。
+
+    Args:
+        workspace_id: 工作空间。
+        payload: ``{metric_key, name, description?, owner?, revision: {...},
+            binding: {...}}``；也接受口径字段平铺的写法。
+        target_db_type: 目标业务库类型（决定表达式方言偏好）。
+
+    Returns:
+        ``{"metric", "revision", "binding", "candidate_mappings"}``。
+
+    Raises:
+        DefinitionError: key/名称缺失、key 已存在、口径或绑定非法。
+    """
+    metric_key = str(payload.get("metric_key") or "").strip()
+    name = str(payload.get("name") or "").strip()
+    if not metric_key:
+        raise DefinitionError("metric_key 必填")
+    if not name:
+        raise DefinitionError("name 必填")
+    if store.get_def_by_key(workspace_id, metric_key) is not None:
+        raise DefinitionError(
+            f"指标 {metric_key} 已存在——改口径请新建修订，改名称请编辑指标")
+    metric = store.create_def(
+        workspace_id=workspace_id, metric_key=metric_key, name=name,
+        description=str(payload.get("description") or ""),
+        owner=str(payload.get("owner") or ""))
+    revision_payload = _revision_payload(payload)
+    revision = _build_revision(
+        workspace_id, metric_key, metric.metric_id, 1, revision_payload,
+        target_db_type=target_db_type, default_display_name=name)
+    store.create_revision(revision)
+    binding = _create_binding(workspace_id, revision, payload.get("binding"))
+    mappings = ossie_mod.candidate_mappings_for(
+        workspace_id, revision,
+        dependencies=revision.dependencies,
+        metric_type=revision.metric_type,
+        subject_iri=revision.subject_iri)
+    for mapping in mappings:
+        store.create_concept_map(mapping)
+    return {
+        "metric": metric,
+        "revision": revision,
+        "binding": binding,
+        "candidate_mappings": [m.mapping_id for m in mappings],
+    }
+
+
+def create_revision(
+    workspace_id: str,
+    metric_key: str,
+    payload: dict[str, Any],
+    *,
+    target_db_type: str = "",
+) -> dict[str, Any]:
+    """为既有指标新建 candidate 修订（口径变更的唯一入口）。
+
+    新修订继承上一修订的物理绑定（载荷未带绑定时）与已确认术语绑定，
+    并按 dependencies 重新生成候选映射。
+
+    Returns:
+        ``{"revision", "binding", "carried_term_maps", "candidate_mappings"}``。
+
+    Raises:
+        MetricNotFound: 指标不存在。
+        DefinitionError: 口径或绑定非法。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    previous = _previous_revision(metric)
+    revision = _build_revision(
+        workspace_id, metric_key, metric.metric_id,
+        store.next_revision_no(metric.metric_id), payload,
+        target_db_type=target_db_type,
+        default_display_name=(previous.display_name if previous else "") or metric.name,
+        previous=previous)
+    store.create_revision(revision)
+    store.touch_def(metric.metric_id)
+    binding = _create_binding(workspace_id, revision, payload.get("binding"))
+    if binding is None and previous is not None:
+        # 未显式带绑定 → 继承上一修订（新修订发布后仍能取数）
+        for old in store.list_bindings(previous.revision_id):
+            copied = replace(
+                old, binding_id=store.new_id("bnd"),
+                revision_id=revision.revision_id, created_at=_now())
+            store.create_binding(copied)
+            binding = binding or copied
+    mappings = ossie_mod.candidate_mappings_for(
+        workspace_id, revision,
+        dependencies=revision.dependencies,
+        metric_type=revision.metric_type,
+        subject_iri=revision.subject_iri)
+    for mapping in mappings:
+        store.create_concept_map(mapping)
+    carried = _carry_over_term_maps(workspace_id, metric_key, revision.revision_id)
+    return {
+        "revision": revision,
+        "binding": binding,
+        "carried_term_maps": carried,
+        "candidate_mappings": [m.mapping_id for m in mappings],
+    }
+
+
+def update_metric(
+    workspace_id: str, metric_key: str, payload: dict[str, Any]
+) -> MetricDef:
+    """更新指标身份的可变字段（name / description / owner）。
+
+    Raises:
+        MetricNotFound: 指标不存在。
+        DefinitionError: name 传了空值。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    name: str | None = None
+    if "name" in payload:
+        name = str(payload.get("name") or "").strip()
+        if not name:
+            raise DefinitionError("name 不能为空")
+    updated = store.update_def(
+        metric.metric_id,
+        name=name,
+        description=str(payload.get("description") or "")
+        if "description" in payload else None,
+        owner=str(payload.get("owner") or "") if "owner" in payload else None,
+    )
+    return updated or metric
+
+
+def delete_metric(
+    workspace_id: str, metric_key: str, *, force: bool = False
+) -> dict[str, Any]:
+    """删除指标并级联清理修订 / 绑定 / 候选映射。
+
+    已发布指标删除会影响在线取数与语义图，默认拒绝；``force=True`` 时删除
+    并尽力重投影（失败只汇报，不回滚删除——元数据库是真相源）。
+
+    Raises:
+        MetricNotFound: 指标不存在。
+        DefinitionError: 指标已发布且未传 force。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    revisions = store.list_revisions(metric.metric_id)
+    published = any(rev.status == REVISION_PUBLISHED for rev in revisions)
+    if published and not force:
+        raise DefinitionError(
+            f"指标 {metric_key} 已发布，删除会影响在线取数与语义图投影；"
+            "确认影响后以 force=true 强制删除")
+    counts = {"revisions": 0, "bindings": 0, "mappings": 0}
+    for revision in revisions:
+        counts["bindings"] += store.delete_bindings_for_revision(revision.revision_id)
+        counts["mappings"] += store.delete_concept_maps_for_revision(revision.revision_id)
+    counts["revisions"] = store.delete_revisions_for_metric(metric.metric_id)
+    store.delete_def(metric.metric_id)
+    projection = {"status": "not_required", "detail": ""}
+    if published:
+        projection = _reproject_after_delete(workspace_id)
+    return {"metric_key": metric_key, **counts, "projection": projection}
+
+
+def _reproject_after_delete(workspace_id: str) -> dict[str, str]:
+    """删除已发布指标后尽力重投影，把图上的孤儿节点清掉。"""
+    try:
+        from .. import graph_projection
+
+        outcome = graph_projection.reproject_workspace(workspace_id)
+        return {
+            "status": "ok",
+            "detail": f"重投影完成：{outcome.get('node_count', 0)} 节点 /"
+                      f"{outcome.get('edge_count', 0)} 边",
+        }
+    except Exception as exc:  # noqa: BLE001 —— 投影失败不阻断删除（可手动重投影）
+        return {"status": "failed", "detail": str(exc)[:300]}
+
+
