+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""onboard.py —— 成员一键入职：remotes / 分支 / 依赖 / 速查一条龙。
+
+前置（GitCode 上手动完成，脚本不代建）：
+    1. fork 开发合入仓 DataIntell/DataSwarm → 你的开发 fork
+    2. fork 交付合入仓 openJiuwen/DataSwarm → 你的交付 fork
+    3. git clone <你的开发 fork> && cd <克隆目录>
+
+用法:
+    python scripts/dataswarm/fork/onboard.py [--skip-setup] [--dev-fork-url URL] [--mr-fork-url URL]
+
+两个 fork 地址**不写死**（各成员自建，地址因人而异）：
+    dev-fork: --dev-fork-url > 既有 dev-fork remote > origin（clone 源即开发 fork）
+    mr-fork:  --mr-fork-url > 既有 mr-fork remote > 询问输入
+
+步骤（幂等，可重复执行）:
+1. 校验 git 与本仓根目录
+2. 补齐 remotes：dev-hub / dev-fork / mr-hub / mr-fork / baseline（命名约定见 fork_config.yaml）
+3. 本地 develop_oss：从 dev-hub/develop_oss 切出；首次推 dev-fork
+4. 浅 fetch 基线 tag（fork_config.baseline.ref）
+5. 安装依赖：setup_dev.py（uv sync + 前端 npm install；--skip-setup 可跳过）
+6. 打印日常工作流速查
+
+约定见 .claude/rules/branch-model.md。
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from _fork_lib import (  # noqa: E402
+    ForkError,
+    dev_hub_branch,
+    load_config,
+)
+
+if sys.stdout.encoding and sys.stdout.encoding.lower() not in ("utf-8", "utf8"):
+    sys.stdout.reconfigure(encoding="utf-8")
+    sys.stderr.reconfigure(encoding="utf-8")
+
+GIT = shutil.which("git") or "git"
+
+
+def git(*args: str, check: bool = True) -> subprocess.CompletedProcess:
+    proc = subprocess.run([GIT, *args], cwd=REPO_ROOT, capture_output=True)
+    if check and proc.returncode != 0:
+        raise ForkError(f"git {' '.join(args)}\n{proc.stderr.decode('utf-8', errors='replace').strip()}")
+    return proc
+
+
+def out(proc: subprocess.CompletedProcess) -> str:
+    return proc.stdout.decode("utf-8", "replace").strip()
+
+
+def remote_urls() -> dict[str, str]:
+    """{remote 名: url}（`git remote -v` 行格式：name url (fetch|push)）。"""
+    urls: dict[str, str] = {}
+    for line in out(git("remote", "-v")).splitlines():
+        parts = line.split()
+        if len(parts) >= 2 and parts[0] not in urls:
+            urls[parts[0]] = parts[1]
+    return urls
+
+
+def ensure_remote(name: str, url: str, existing: dict[str, str]) -> None:
+    if name in existing:
+        print(f"[=] remote {name}: {existing[name]}")
+        return
+    git("remote", "add", name, url)
+    print(f"[+] remote {name}: {url}")
+
+
+def _is_shared(url: str) -> bool:
+    """共享合入仓/基线仓（openJiuwen / DataIntell 组织）——不是个人 fork。"""
+    return re.search(r"[:/](openJiuwen|DataIntell)/", url) is not None
+
+
+def resolve_dev_fork(args: argparse.Namespace, existing: dict[str, str]) -> str:
+    """开发 fork 地址（不写死）：--dev-fork-url > 既有 dev-fork > origin（非共享仓时）。
+
+    clone 源就是成员开发 fork——onboard 前它是 origin，随后改名 dev-fork。
+    """
+    if args.dev_fork_url:
+        return args.dev_fork_url
+    if "dev-fork" in existing:
+        return existing["dev-fork"]
+    origin = existing.get("origin", "")
+    if origin and not _is_shared(origin):
+        return origin
+    raise ForkError(
+        "无法确定你的开发 fork 地址（成员自建，勿写死）：\n"
+        "  用法：python scripts/dataswarm/fork/onboard.py --dev-fork-url git@gitcode.com:<你>/DataSwarm.git")
+
+
+def resolve_mr_fork(args: argparse.Namespace, existing: dict[str, str]) -> str:
+    """交付 fork 地址（不写死）：--mr-fork-url > 既有 mr-fork > 询问输入。"""
+    if args.mr_fork_url:
+        return args.mr_fork_url
+    if "mr-fork" in existing:
+        return existing["mr-fork"]
+    try:
+        answer = input("[?] 你的交付 fork 地址（fork 自 openJiuwen/DataSwarm，如 git@gitcode.com:<你>/DataSwarm_Opensource.git）: ").strip()
+    except EOFError:
+        answer = ""
+    if not answer:
+        raise ForkError(
+            "无法确定你的交付 fork 地址：\n"
+            "  用法：python scripts/dataswarm/fork/onboard.py --mr-fork-url git@gitcode.com:<你>/<你的交付fork>.git")
+    return answer
+
+
+def adopt_origin_as_dev_fork(existing: dict[str, str]) -> dict[str, str]:
+    """clone 源 origin 即开发 fork——改名 dev-fork，腾出 origin 语义（新模型不用 origin）。"""
+    if "origin" not in existing:
+        return existing
+    if "dev-fork" not in existing:
+        git("remote", "rename", "origin", "dev-fork")
+        print("[+] remote origin → dev-fork（clone 源即你的开发 fork）")
+    else:
+        git("remote", "remove", "origin")
+        print("[-] remote origin 移除（开发 fork 已用 dev-fork 名义配置）")
+    return remote_urls()
+
+
+def ensure_develop_oss(cfg: dict) -> str:
+    """本地 develop_oss：从 dev-hub 切出（跟踪 dev-fork，fork 缺分支时首推）。"""
+    branch = dev_hub_branch(cfg)
+    current = out(git("symbolic-ref", "--quiet", "--short", "HEAD", check=False))
+    if current == branch:
+        return current
+    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
+        raise ForkError("工作区有未提交改动——先提交/清理再切换")
+    has_local = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}",
+                    check=False).returncode == 0
+    if not has_local:
+        print(f"[*] 从 dev-hub/{branch} 切出 {branch} ...")
+        git("checkout", "-b", branch, "--track", f"dev-hub/{branch}")
+        # 首次入职：开发 fork 上还没有该分支则补推
+        if not out(git("ls-remote", "--heads", "dev-fork", branch, check=False)):
+            git("push", "-u", "dev-fork", branch)
+            print(f"[OK] dev-fork 已补推 {branch}")
+    else:
+        git("checkout", branch)
+        print(f"[=] 已切换到 {branch}")
+    return branch
+
+
+def print_cheatsheet(cfg: dict) -> None:
+    branch = dev_hub_branch(cfg)
+    archive = cfg.get("archive", {}).get("branch", "MR")
+    hub_branch = cfg.get("mr_hub", {}).get("branch", "develop")
+
+    def row(cmd: str, note: str) -> None:
+        print(f"  {cmd:<38}# {note}")
+
+    print("\n[OK] 入职完成。先自检：")
+    row("git remote -v", "五个 remote 齐全")
+    row("git status -sb", f"当前 {branch}，跟踪 dev-fork/{branch}")
+    row(f"git tag -l {cfg['baseline']['ref']}", "基线 tag 可见")
+    row("uv run pytest tests/unit_tests/ -q", "环境可用")
+    print("\n日常开发：")
+    print(f"  改码:     {branch} 上直接改 → ruff/pytest 验证 → 提交（中文 Conventional Commits）")
+    print(f"  推送:     git push dev-fork {branch}")
+    print(f"  开发 MR:  GitCode 创建 dev-fork:{branch} → dev-hub:{branch}（人工合入；勿直接推 dev-hub）")
+    print(f"  同步共源: git pull dev-hub {branch}（合入后同步别人改动）")
+    print("\n交付归档（专员/稳定点，勿日常操作）：")
+    print("  归档:     python scripts/dataswarm/fork/archive_delta.py --anchor <commit> --push")
+    print(f"            → 生成 mr-fork:{archive}（单 commit 重挂）")
+    print(f"  交付 MR:  GitCode 创建 mr-fork:{archive} → mr-hub:{hub_branch}（人工评审；脚本不自动创建 MR）")
+    print(f"  等价门禁: python scripts/dataswarm/fork/verify_equivalence.py --archive-ref mr-fork/{archive}")
+    print("\n其他：")
+    print("  基线升级: python scripts/dataswarm/fork/sync_baseline.py <新tag>")
+    print("  规则:     .claude/rules/branch-model.md（先读）")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="成员一键入职：remotes + develop_oss + 依赖 + 速查")
+    ap.add_argument("--skip-setup", action="store_true", help="跳过依赖安装（uv sync / npm install）")
+    ap.add_argument("--dev-fork-url", default=None, help="你的开发 fork 地址（缺省取 clone 源/既有 remote）")
+    ap.add_argument("--mr-fork-url", default=None, help="你的交付 fork 地址（缺省询问）")
+    args = ap.parse_args()
+
+    if git("rev-parse", "--show-toplevel", check=False).returncode != 0:
+        raise ForkError("当前目录不是 git 仓库——先 clone 你的开发 fork")
+
+    cfg = load_config()
+    existing = remote_urls()
+    dev_fork_url = resolve_dev_fork(args, existing)
+    existing = adopt_origin_as_dev_fork(existing)
+
+    ensure_remote("dev-fork", dev_fork_url, existing)
+    ensure_remote("dev-hub", cfg["dev_hub"]["repo"], existing)
+    ensure_remote("mr-hub", cfg["mr_hub"]["repo"], existing)
+    mr_fork_url = resolve_mr_fork(args, existing)
+    ensure_remote("mr-fork", mr_fork_url, existing)
+    ensure_remote("baseline", cfg["baseline"]["repo"], existing)
+
+    print("[*] fetch dev-hub ...")
+    git("fetch", "dev-hub", check=False)
+
+    ensure_develop_oss(cfg)
+
+    from _fork_lib import ensure_baseline_tag  # noqa: PLC0415
+    ensure_baseline_tag(cfg["baseline"]["ref"])
+    print(f"[=] 基线 tag {cfg['baseline']['ref']} 已在本地（浅）")
+
+    if args.skip_setup:
+        print("[skip] 依赖安装（--skip-setup）")
+    else:
+        proc = subprocess.run([sys.executable, str(REPO_ROOT / "scripts" / "dataswarm" / "fork" / "setup_dev.py")])
+        if proc.returncode != 0:
+            raise ForkError(f"setup_dev.py 退出码 {proc.returncode}")
+
+    print_cheatsheet(cfg)
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except ForkError as exc:
+        print(f"[FAIL] {exc}", file=sys.stderr)
+        sys.exit(2)
