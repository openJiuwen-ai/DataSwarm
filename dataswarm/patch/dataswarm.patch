+          </Button>
+        </div>
+      </div>
+
+      {store.dimensions.length === 0 ? (
+        <EmptyState
+          icon={<Filter size={32} />}
+          title={dashboardTexts.dimension.emptyTitle}
+          hint={dashboardTexts.dimension.emptyHint}
+          actionLabel={`+ ${dashboardTexts.dimension.create}`}
+          onAction={() => setCreating(true)}
+        />
+      ) : (
+        <Panel title={`共 ${store.dimensions.length} 个维度`}>
+          <Table headers={headers} rows={rows} />
+        </Panel>
+      )}
+
+      {(creating || editing) && (
+        <DimensionFormDrawer
+          dimension={editing}
+          onClose={() => { setCreating(false); setEditing(null); }}
+          onSaved={() => { setCreating(false); setEditing(null); }}
+        />
+      )}
+    </div>
+  );
+}
