@@ -0,0 +1,668 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Document versions and evidence extraction.
+
+Parsing/chunking reuse Semantica 0.7 modules; the distillation LLM call goes
+through the project-owned provider in ``extraction_llm`` (gateway protocol
+aware, local typed validation), not Semantica's provider layer.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import base64
+import uuid
+from dataclasses import asdict
+from pathlib import Path
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import _connect, _exec, _fetch_dicts, _fetch_one_dict, _now
+from jiuwenswarm.common import workspace_context
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+from . import store
+
+_MD_LINE_PREFIX = re.compile(r"(?:#{1,6}|[-*+]|\d{1,3}\.)[ \t]+")
+_HEADING_LINE = re.compile(r"^#{1,6}[ \t]+(.+?)\s*$", re.MULTILINE)
+
+
+def _normalized_with_positions(value: str) -> tuple[str, list[int]]:
+    """Strip markdown marks (emphasis/inline code/heading and list prefixes) and
+    collapse whitespace, keeping each output character's original-text offset."""
+    out: list[str] = []
+    positions: list[int] = []
+    pending_space = False
+    at_line_start = True
+    i, length = 0, len(value)
+    while i < length:
+        ch = value[i]
+        if ch == "\n":
+            at_line_start = True
+            pending_space = bool(out)
+            i += 1
+            continue
+        if at_line_start:
+            match = _MD_LINE_PREFIX.match(value, i)
+            if match:
+                i = match.end()
+                continue
+            at_line_start = False
+        if ch in "*`~":
+            i += 1
+            continue
+        if ch.isspace():
+            pending_space = bool(out)
+            i += 1
+            continue
+        if pending_space and out:
+            out.append(" ")
+            positions.append(i)
+            pending_space = False
+        out.append(ch)
+        positions.append(i)
+        i += 1
+    return "".join(out), positions
+
+
+def _locate_quote(text: str, quote: str) -> tuple[int, int]:
+    """Byte-exact ``find`` first; then markdown-insensitive fallback.
+
+    LLMs routinely drop markdown marks (``**``/backticks/list numbering) when
+    quoting "verbatim", so bolded definitions — usually the most important
+    ones — fail a byte-exact search. The fallback normalizes both sides and
+    maps the hit back onto original-text offsets. Returns ``(-1, -1)`` when
+    unmatched; quotes normalizing to under 2 characters are treated as
+    unmatched (too short to trust a fuzzy hit).
+    """
+    pos = text.find(quote)
+    if pos >= 0:
+        return pos, pos + len(quote)
+    normalized_text, positions = _normalized_with_positions(text)
+    normalized_quote, _ = _normalized_with_positions(quote)
+    if len(normalized_quote) < 2:
+        return -1, -1
+    hit = normalized_text.find(normalized_quote)
+    if hit < 0 or hit + len(normalized_quote) > len(positions):
+        return -1, -1
+    return positions[hit], positions[hit + len(normalized_quote) - 1] + 1
+
+
+def _heading_sections(text: str) -> list[tuple[int, str]]:
+    """Markdown heading anchors ``[(offset, title)]``.
+
+    Semantica's StructuralChunker emits no ``section`` metadata, so sections
+    are derived here from the parsed text itself.
+    """
+    return [(match.start(), match.group(1).strip()) for match in _HEADING_LINE.finditer(text)]
+
+
+def _section_at(sections: list[tuple[int, str]], position: int) -> str:
+    current = ""
+    for start, title in sections:
+        if start > position:
+            break
+        current = title
+    return current
+
+
+def _import_root() -> Path:
+    """Allowed import root: explicit JIUWENSWARM_KNOWLEDGE_IMPORT_DIR first,
+    else ``<runtime data root>/knowledge-imports`` (JIUWENSWARM_DATA_DIR-aware).
+
+    The fallback follows ``get_user_workspace_dir`` like db_connector: a hardcoded
+    ``~/.jiuwenswarm`` would route isolated dataswarm uploads to the base directory.
+    An empty/blank env value is ignored (Path("") would resolve to the CWD).
+    """
+    explicit = os.environ.get("JIUWENSWARM_KNOWLEDGE_IMPORT_DIR", "").strip()
+    if explicit:
+        return Path(explicit).expanduser().resolve()
+    return (get_user_workspace_dir() / "knowledge-imports").expanduser().resolve()
+
+
+def parse(path: str | Path, *, source_id: str = "") -> dict[str, Any]:
+    if source_id:
+        from ..datasource import store as datasource_store
+        source = datasource_store.get_source(source_id, store._workspace())
+        if not source or not source.get("enabled", True):
+            raise ValueError("source_id is not enabled in the current workspace")
+    file_path = Path(path).expanduser().resolve()
+    if not file_path.is_file():
+        raise ValueError("document path must point to an existing file")
+    allowed_root = _import_root()
+    allowed_root.mkdir(parents=True, exist_ok=True)
+    try:
+        file_path.relative_to(allowed_root)
+    except ValueError as exc:
+        raise ValueError(f"document must be inside configured import directory: {allowed_root}") from exc
+    if file_path.suffix.lower() not in {".pdf", ".docx", ".doc", ".html", ".htm", ".txt", ".text", ".md", ".markdown"}:
+        raise ValueError("unsupported document extension")
+    if file_path.stat().st_size > 30 * 1024 * 1024:
+        raise ValueError("document exceeds 30 MiB import limit")
+    try:
+        from semantica.parse import DocumentParser
+        from semantica.split import StructuralChunker
+    except ImportError as exc:
+        raise RuntimeError("Semantica is required for document parsing") from exc
+    file_type = "text" if file_path.suffix.lower() in {".md", ".markdown"} else None
+    parsed = DocumentParser().parse_document(file_path, file_type=file_type)
+    text = str(parsed.get("text") or parsed.get("full_text") or parsed.get("content") or "")
+    if not text.strip():
+        raise ValueError("Semantica returned no document text")
+    digest = hashlib.sha256(file_path.read_bytes()).hexdigest()
+    doc_id = f"doc_{hashlib.sha256((store._workspace() + ':' + str(file_path)).encode()).hexdigest()[:16]}"
+    existing = _find_version_by_hash(digest, source_id)
+    if existing:
+        return existing
+    chunks = StructuralChunker(respect_headers=True, respect_sections=True, max_chunk_size=1800).chunk(text)
+    sections = _heading_sections(text)
+    evidence = []
+    for index, chunk in enumerate(chunks):
+        start, end = int(chunk.start_index), int(chunk.end_index)
+        chunk_text = text[start:end]
+        # A chunk may open with the newline before its heading line, so section
+        # attribution anchors on the first non-whitespace character.
+        body_offset = start + len(chunk_text) - len(chunk_text.lstrip())
+        evidence.append({"evidence_id": f"ev_{digest[:12]}_{index:04d}", "start": start, "end": end,
+                         "text": chunk_text,
+                         "section": chunk.metadata.get("section") or _section_at(sections, body_offset),
+                         "chunk_index": index})
+    parsed_structure = {key: value for key, value in parsed.items() if key not in {"text", "content", "full_text"}}
+    if len(json.dumps(parsed_structure, ensure_ascii=False, default=str)) > 12 * 1024 * 1024:
+        parsed_structure = {"metadata": parsed.get("metadata") or {}, "structure_truncated": True}
+    payload = {"document_id": doc_id, "version_id": f"dv_{uuid.uuid4().hex[:24]}", "text": text,
+               "metadata": parsed.get("metadata") or {}, "parsed_structure": parsed_structure, "evidence": evidence,
+               "source": {"path": str(file_path), "name": file_path.name, "sha256": digest,
+                          "source_id": source_id, "parser": "semantica.DocumentParser@0.7",
+                          "chunker": "semantica.StructuralChunker@0.7"},
+               "quality": {"character_count": len(text), "chunk_count": len(evidence)}}
+    _persist_document(payload)
+    return payload
+
+
+def upload_and_parse(file_name: str, content_base64: str, *, source_id: str = "") -> dict[str, Any]:
+    """Write a browser upload beneath the configured import root, then invoke Semantica."""
+    name = Path(file_name).name
+    if not name or name in {".", ".."}:
+        raise ValueError("file_name is invalid")
+    try:
+        content = base64.b64decode(content_base64, validate=True)
+    except (ValueError, TypeError) as exc:
+        raise ValueError("content_base64 is invalid") from exc
+    if not content or len(content) > 30 * 1024 * 1024:
+        raise ValueError("upload must be between 1 byte and 30 MiB")
+    root = _import_root()
+    upload_dir = root / "uploads"
+    upload_dir.mkdir(parents=True, exist_ok=True)
+    digest = hashlib.sha256(content).hexdigest()
+    destination = upload_dir / f"{digest[:20]}-{name}"
+    if not destination.exists():
+        destination.write_bytes(content)
+    return parse(destination, source_id=source_id)
+
+
+def _find_version_by_hash(digest: str, source_id: str = "") -> dict | None:
+    """Content-hash idempotency: a repeated import returns the existing version."""
+    store._ensure()
+    conn = _connect()
+    try:
+        row = _fetch_one_dict(conn, "SELECT payload_json FROM dw_knowledge_documents "
+                                  "WHERE workspace_id=? AND sha256=? AND source_id=? ORDER BY created_at DESC",
+                              (store._workspace(), digest, source_id))
+        return json.loads(row["payload_json"]) if row else None
+    finally:
+        conn.close()
+
+
+def _persist_document(payload: dict) -> None:
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    workspace = workspace_context.current_workspace()
+    ensure_system_schema(workspace.metadata_db_ref)
+    conn = _connect()
+    try:
+        _exec(conn, "INSERT INTO dw_knowledge_documents "
+              "(version_id,workspace_id,document_id,source_id,name,sha256,status,payload_json,created_at,updated_at) "
+              "VALUES (?,?,?,?,?,?,?,?,?,?)",
+              (payload["version_id"], store._workspace(), payload["document_id"],
+               payload["source"]["source_id"], payload["source"]["name"], payload["source"]["sha256"],
+               "candidate", json.dumps(payload, ensure_ascii=False), _now(), _now()))
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _extraction_status(version_id: str, payload: dict) -> str | None:
+    """读取抽取状态；把服务重启后残留的 queued/running 收敛为 failed。
+
+    后台任务只存在于当前进程的内存队列：列表读到排队/执行中、但内存里已无
+    对应任务时，说明进程重启把它丢了，落 failed 让用户重跑，避免永远转圈。
+    """
+    extraction = payload.get("extraction") or {}
+    status = extraction.get("status")
+    if status in {"queued", "running"}:
+        from .extraction_jobs import is_pending
+        if not is_pending(store._workspace(), version_id):
+            extraction["status"] = "failed"
+            extraction["error"] = "服务重启导致后台抽取中断，请重跑"
+            payload["extraction"] = extraction
+            _save_extraction(payload)
+            return "failed"
+    return status
+
