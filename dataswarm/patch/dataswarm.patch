+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type {
+  ColumnLineageArtifact,
+  Database,
+  LineageArtifact,
+  PreviewResult,
+  TableDetail,
+  TableInfo,
+} from '../types/metadata';
+
+import {
+  ensureDatasourceWorkspaceId,
+  responseBelongsToCurrentWorkspace,
+} from '../../../stores/datasourceWorkspaceStore';
+
+async function request<T>(url: string, signal?: AbortSignal): Promise<T> {
+  // 多工作空间（P2-4）：数据管理/血缘 API 统一注入当前 workspace_id
+  const wsId = await ensureDatasourceWorkspaceId();
+  const requestAt = wsId;
+  const target = wsId ? `${url}${url.includes('?') ? '&' : '?'}workspace_id=${encodeURIComponent(wsId)}` : url;
+  const response = await fetch(target, { headers: { Accept: 'application/json' }, signal });
+  const payload = (await response.json().catch(() => ({}))) as Record<string, unknown>;
+  if (!response.ok) {
+    throw new Error(
+      typeof payload.error === 'string' ? payload.error : `${response.status} ${response.statusText}`,
+    );
+  }
+  if (!responseBelongsToCurrentWorkspace(payload, requestAt)) {
+    throw new Error('workspace_changed');
+  }
+  return payload as T;
+}
+
+export const metadataApi = {
+  listDatabases: () => request<{ databases: Database[] }>('/api/dataagent/databases'),
+  listTables: (db: string) =>
+    request<{ tables: TableInfo[] }>(`/api/dataagent/databases/${encodeURIComponent(db)}/tables`),
+  getTable: (db: string, table: string, signal?: AbortSignal) =>
+    request<TableDetail>(
+      `/api/dataagent/databases/${encodeURIComponent(db)}/tables/${encodeURIComponent(table)}`,
+      signal,
+    ),
+  getPreview: (db: string, table: string, offset = 0, limit = 10) =>
+    request<PreviewResult>(
+      `/api/dataagent/databases/${encodeURIComponent(db)}/tables/${encodeURIComponent(table)}/preview?offset=${offset}&limit=${limit}`,
+    ),
+  getLineage: (db: string) =>
+    request<LineageArtifact>(`/api/dataagent/lineage/${encodeURIComponent(db)}`),
+  getColumnLineage: (db: string, table: string, signal?: AbortSignal) =>
+    request<ColumnLineageArtifact>(
+      `/api/dataagent/lineage/${encodeURIComponent(db)}/tables/${encodeURIComponent(table)}/columns`,
+      signal,
+    ),
+};
