+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Local HTTP-dispatch regressions for saved non-SQL source workspace lookup.
+
+Real temporary SQLite registry/metadata and real DDL connector are used. Only
+background enrichment and semantic scheduling are intercepted to avoid LLM calls or tasks
+outliving the fixture.
+"""
+from __future__ import annotations
+
+import io
+import json
+import sqlite3
+from functools import partial
+from pathlib import Path
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+from jiuwenswarm.common import db_connector as dbc, workspace_context as wc, workspace_store
+from jiuwenswarm.channels.web.dataagent import api
+from jiuwenswarm.channels.web.dataagent.datasource import store
+from jiuwenswarm.channels.web.dataagent.knowledge import schema_enrichment
+from jiuwenswarm.channels.web.dataagent.semantic import service as semantic_service
+
+
+class Handler:
+    def __init__(self, body, workspace_id=None):
+        raw = json.dumps(body).encode("utf-8")
+        self.rfile = io.BytesIO(raw)
+        self.headers = {"Content-Length": str(len(raw))}
+        if workspace_id:
+            self.headers["X-Workspace-Id"] = workspace_id
+        self.response = None
+
+    @staticmethod
+    def _query_arg(parsed, key):
+        return (parse_qs(parsed.query).get(key) or [""])[0]
+
+    def _write_json(self, status, body):
+        self.response = (status, body)
+
+
+def post(route, body, workspace_id=None):
+    handler = Handler(body, workspace_id)
+    api.handle_post(handler, urlparse("/api/dataagent/" + route))
+    assert handler.response is not None
+    status, result = handler.response
+    assert status == 200, result
+    return result
+
+
+@pytest.fixture
+def isolated_workspaces(tmp_path, monkeypatch):
+    config = tmp_path / "datasource.yaml"
+    config.write_text("{}\n", encoding="utf-8")
+    monkeypatch.setattr(workspace_store, "_config_dir", lambda: tmp_path)
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: tmp_path / "workspaces.db")
+    monkeypatch.setattr(wc, "_config_path", lambda: config)
+    monkeypatch.setattr(dbc, "_DATASOURCE_CONFIG", config)
+    monkeypatch.setattr(store, "_initialized_refs", set())
+    monkeypatch.setattr(dbc, "_SOURCE_CREDS_CACHE", {})
+    for key in ("JIUWENSWARM_DATASOURCE_DB", "JIUWENSWARM_ORCH_DB", "JIUWENSWARM_WORKSPACE_ID"):
+        monkeypatch.delenv(key, raising=False)
+    root = Path(__file__).resolve().parents[3]
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(root / "deploy" / "schema"))
+    submitted = []
+
+    def capture_submit(workspace_id, *, db_ref="", source_id=""):
+        submitted.append({"workspace_id": workspace_id, "db_ref": db_ref, "source_id": source_id})
+        return {"status": "queued"}
+    monkeypatch.setattr(schema_enrichment, "submit", capture_submit)
+    semantic_runs = []
+    def capture_semantic_run(source_id, workspace_id, *, trigger_type):
+        semantic_runs.append({"workspace_id": workspace_id, "source_id": source_id,
+                              "trigger_type": trigger_type})
+        return {"run_id": f"captured-semantic-{len(semantic_runs)}", "status": "queued"}
+    monkeypatch.setattr(semantic_service, "start_run_for_binding",
+                        partial(capture_semantic_run, trigger_type="binding"))
+    monkeypatch.setattr(semantic_service, "start_run_for_query",
+                        partial(capture_semantic_run, trigger_type="query_feedback"))
+    token = wc.set_current(None)
+    try:
+        yield {"derivations": submitted, "semantic_runs": semantic_runs}
+    finally:
+        dbc.close_all()
+        wc.reset(token)
+
+
+def create_and_update(workspace_id, header=True):
+    body = {"source_id": "local_ddl", "type": "ddl", "workspace_id": workspace_id,
+            "ddl_text": "CREATE TABLE orders (order_id BIGINT PRIMARY KEY)", "dialect": "postgres"}
+    created = post("datasource/create", body, workspace_id if header else None)
+    assert created["ok"] is True and created["bound"] is True
+    assert created["schema_derivation"] == {"status": "queued"}
+    assert created["semantic_collection"] == {
+        "status": "queued", "run_id": "captured-semantic-1", "run_status": "queued"}
+    updated = post("datasource/update", {**body, "ddl_text":
+                   "CREATE TABLE orders (order_id BIGINT PRIMARY KEY, amount DECIMAL(12,2))"},
+                   workspace_id if header else None)
+    assert updated["ok"] is True and updated["db_ref"] != created["db_ref"]
+    return updated["db_ref"]
+
+
+def assert_metadata(result):
+    assert result["ok"] is True, result
+    assert result["table_count"] == 1 and result["tables"][0]["table"] == "orders"
+    assert {col["name"] for col in result["tables"][0]["columns"]} == {"order_id", "amount"}
+
+
+def test_explicit_workspace_header_restores_saved_ddl_after_service_update(isolated_workspaces):
+    workspace_store.create_workspace("Owner", workspace_id="owner")
+    ref = create_and_update("owner")
+    assert_metadata(post("databases/schema-snapshot", {"db_ref": ref}, "owner"))
+    assert wc.selected_workspace_id() is None, "HTTP context must reset after dispatch"
+    assert isolated_workspaces["semantic_runs"] == [
+        {"workspace_id": "owner", "source_id": "local_ddl", "trigger_type": "binding"}]
+
+
+def test_implicit_single_workspace_restores_saved_ddl_after_service_update(isolated_workspaces):
+    workspace_store.create_workspace("Only workspace", workspace_id="only")
+    ref = create_and_update("only", header=False)
+    assert wc.current_workspace().workspace_id == "only" and wc.selected_workspace_id() is None
+    assert store.get_source("local_ddl")["db_ref"] == ref
+    assert_metadata(post("databases/schema-snapshot", {"db_ref": ref}))
+    assert isolated_workspaces["semantic_runs"] == [
+        {"workspace_id": "only", "source_id": "local_ddl", "trigger_type": "binding"}]
+
+
+def test_cross_workspace_bind_restores_saved_ddl_from_source_owner(isolated_workspaces):
+    workspace_store.create_workspace("Owner", workspace_id="owner")
+    workspace_store.create_workspace("Consumer", workspace_id="consumer")
+    ref = create_and_update("owner")
+    bound = post("datasource/bind", {"source_id": "local_ddl", "workspace_id": "consumer"}, "consumer")
+    assert bound["ok"] is True and bound["db_ref"] == ref
+    assert bound["schema_derivation"] == {"status": "queued"}
+    assert isolated_workspaces["derivations"][-1] == {"workspace_id": "consumer", "db_ref": ref, "source_id": "local_ddl"}
+    assert bound["semantic_collection"] == {
+        "status": "queued", "run_id": "captured-semantic-2", "run_status": "queued"}
+    assert isolated_workspaces["semantic_runs"] == [
+        {"workspace_id": workspace, "source_id": "local_ddl", "trigger_type": "binding"}
+        for workspace in ("owner", "consumer")]
+    assert wc.validate_ref_in_workspace("consumer", "business", ref) == ref
+    assert store.find_source("local_ddl", workspace_id="consumer")["db_ref"] == ref
+    assert store.get_source("local_ddl", workspace_id="consumer") is None
+    assert_metadata(post("databases/schema-snapshot", {"db_ref": ref}, "consumer"))
+
+
+def saved_redis_pair():
+    owner = workspace_store.create_workspace("Owner", workspace_id="owner")
+    consumer = workspace_store.create_workspace("Consumer", workspace_id="consumer")
+    ref = "redis://test.invalid:6379/2"
+    config = {"host": "test.invalid", "port": 6379, "db": 2,
+              "password": "private-owner-password", "datasets": "hash:orders:*"}
+    store.insert_source("redis-source", "redis", "Saved Redis", config, ref, workspace_id="owner")
+    return owner, consumer, ref, config
+
+
+@pytest.mark.parametrize("binding", ["", "redis://test.invalid:6379/3", "redis://test.invalid:6379/2/"])
+def test_other_workspace_is_not_read_without_exact_binding(isolated_workspaces, monkeypatch, binding):
+    owner, consumer, ref, config = saved_redis_pair()
+    workspace_store.update_business_ref("consumer", binding)
+    original = store._connect
+    visited = []
+
+    def connect(meta_ref):
+        visited.append(meta_ref)
+        assert meta_ref == consumer["metadata_db_ref"], "Unbound lookup must not read another workspace"
+        return original(meta_ref)
+    monkeypatch.setattr(store, "_connect", connect)
+    assert store.find_config_by_ref(ref, "redis", workspace_id="consumer") is None
+    assert visited == [consumer["metadata_db_ref"]]
+
+
+def test_bound_lookup_does_not_initialize_missing_registries(isolated_workspaces, monkeypatch):
+    owner, consumer, ref, config = saved_redis_pair()
+    workspace_store.update_business_ref("consumer", ref)
+    monkeypatch.setattr(
+        store, "_ensure_table", lambda *args: pytest.fail("Lookup must not initialize or migrate metadata")
+    )
+    assert store.find_config_by_ref(ref, "redis", workspace_id="consumer") == config
+    with sqlite3.connect(consumer["metadata_db_ref"].removeprefix("sqlite://")) as connection:
+        assert connection.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall() == []
+
+
+@pytest.mark.parametrize("conflicting", [False, True])
+def test_bound_lookup_requires_equal_configs_across_all_source_owners(isolated_workspaces, conflicting):
+    owner, consumer, ref, config = saved_redis_pair()
+    workspace_store.create_workspace("Second owner", workspace_id="other")
+    second = {**config, "password": "different-private-password"} if conflicting else dict(config)
+    store.insert_source("second", "redis", "Second", second, ref, workspace_id="other")
+    workspace_store.update_business_ref("consumer", ref)
+    if conflicting:
+        with pytest.raises(ValueError, match="ambiguous") as error:
+            store.find_config_by_ref(ref, "redis", workspace_id="consumer")
+        assert config["password"] not in str(error.value) and second["password"] not in str(error.value)
+    else:
+        assert store.find_config_by_ref(ref, "redis", workspace_id="consumer") == config
+
+
+def test_bound_lookup_propagates_source_metadata_connection_failure(isolated_workspaces, monkeypatch):
+    owner, consumer, ref, config = saved_redis_pair()
+    workspace_store.update_business_ref("consumer", ref)
+    original = store._connect
+
+    def connect(meta_ref):
+        if meta_ref == owner["metadata_db_ref"]:
+            raise ConnectionError("source metadata unavailable")
+        return original(meta_ref)
+    monkeypatch.setattr(store, "_connect", connect)
+    with pytest.raises(ConnectionError, match="source metadata unavailable"):
+        store.find_config_by_ref(ref, "redis", workspace_id="consumer")
+
+
+@pytest.mark.parametrize("env_key", ["JIUWENSWARM_DATASOURCE_DB", "JIUWENSWARM_ORCH_DB"])
+def test_explicit_metadata_override_does_not_search_workspace_registries(
+    isolated_workspaces, tmp_path, monkeypatch, env_key
+):
+    owner, consumer, ref, config = saved_redis_pair()
+    workspace_store.update_business_ref("consumer", ref)
+    override = f"sqlite://{tmp_path / 'override.db'}"
+    monkeypatch.setenv(env_key, override)
+    original = store._connect
+
+    def connect(meta_ref):
+        assert meta_ref == override, "Explicit override must not fall back to registered workspaces"
+        return original(meta_ref)
+    monkeypatch.setattr(store, "_connect", connect)
+    assert store.find_config_by_ref(ref, "redis") is None
+
+
+def test_unselected_multiple_workspaces_do_not_open_metadata(isolated_workspaces, monkeypatch):
+    owner, consumer, ref, config = saved_redis_pair()
+    monkeypatch.setattr(
+        store, "_connect", lambda *args: pytest.fail("Unselected multiple workspaces must not search metadata")
+    )
+    assert store.find_config_by_ref(ref, "redis") is None
+
+
+def test_standalone_ref_does_not_open_unrelated_implicit_workspace(isolated_workspaces, monkeypatch):
+    workspace_store.create_workspace("Only", workspace_id="only")
+    workspace_store.update_business_ref("only", "ddl://0123456789abcdef")
+    monkeypatch.setattr(
+        store, "_connect", lambda *args: pytest.fail("Standalone source must not connect to unrelated metadata")
+    )
+    assert store.find_config_by_ref("redis://test.invalid:6379/2", "redis") is None
+
+
+def test_invalid_workspace_registry_is_not_hidden_as_missing_source(isolated_workspaces, monkeypatch):
+    def invalid():
+        raise wc.WorkspaceContextError("invalid custom workspace registry")
+    monkeypatch.setattr(wc, "_workspace_records", invalid)
