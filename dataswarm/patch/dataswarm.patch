+def _start_automatic_run(source_id: str, workspace_id: str, trigger_type: str) -> dict:
+    """Return explicit non-start reasons while keeping binding/query success independent."""
+    unavailable = {"status": "source_not_available", "reason": "source_not_available",
+                   "warnings": ["source_not_available"]}
