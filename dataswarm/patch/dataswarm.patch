+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_concept_map WHERE mapping_id = ?", (mapping_id,))
+            deleted = bool(getattr(cursor, "rowcount", 0))
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
+def get_concept_map(mapping_id: str, *, conn: Any = None) -> ConceptMapping | None:
+    """按主键取映射。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c, "SELECT * FROM dw_metric_concept_map WHERE mapping_id = ?", (mapping_id,))
+        return _row_to_mapping(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def set_concept_map_status(
+    mapping_id: str,
+    status: str,
+    *,
+    confirmed_by: str = "",
+    conn: Any = None,
+) -> None:
+    """改映射状态；``confirmed`` 时记录确认人与时间。"""
+    c, own = _conn_or(conn)
+    confirmed_at = _now() if status == "confirmed" else None
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_concept_map SET status = ?, confirmed_by = ?,"
+                " confirmed_at = ? WHERE mapping_id = ?",
+                (status, confirmed_by, confirmed_at, mapping_id),
+            )
+            _commit_if_own(c, own)
