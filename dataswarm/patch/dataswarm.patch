@@ -0,0 +1,223 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import { useEffect, useRef, useState } from 'react';
+import { toPng } from 'html-to-image';
+import { Download, Search } from 'lucide-react';
+import { useDataManagementStore } from '../../store/dataManagementStore';
+import type { Layer } from '../../types/metadata';
+import { LineageGraph } from '../../../_shared/lineage/LineageGraph';
+import { NodeDetailCard } from './NodeDetailCard';
+import { TableColumnLineage } from './TableColumnLineage';
+
+const ALL_LAYERS: Layer[] = ['ODS', 'DWD', 'DWS', 'ADS', 'OTHER'];
+const DEFAULT_LAYERS: Set<Layer> = new Set(ALL_LAYERS);
+
+type LineageMode = 'table' | 'column';
+
+export function LineageView() {
+  const { selectedDb, selectedTable } = useDataManagementStore();
+  const [mode, setMode] = useState<LineageMode>('table');
+  return <LineageContent key={JSON.stringify([selectedDb, selectedTable])} mode={mode} onModeChange={setMode} />;
+}
+
+function LineageContent({ mode, onModeChange }: { mode: LineageMode; onModeChange: (mode: LineageMode) => void }) {
+  const { t } = useTranslation();
+  const store = useDataManagementStore();
+  const { lineage, selectedDb, selectedTable } = store;
+
+  const [searchTerm, setSearchTerm] = useState('');
+  const [searchInput, setSearchInput] = useState('');
+  const [layerFilter, setLayerFilter] = useState<Set<Layer>>(DEFAULT_LAYERS);
+  const [selected, setSelected] = useState('');
+  const canvasRef = useRef<HTMLDivElement>(null);
+
+  // 搜索框防抖 300ms
+  useEffect(() => {
+    const t = window.setTimeout(() => setSearchTerm(searchInput), 300);
+    return () => window.clearTimeout(t);
+  }, [searchInput]);
+
+  // 进入血缘 tab / 换库换表 remount 时都重新拉取：血缘随任务执行持续写入，
+  // 只在首次加载会让人以为数据不更新（要整页刷新才能看到新边）。
+  useEffect(() => {
+    if (selectedDb) void store.loadLineage();
+  }, [selectedDb, store.loadLineage]);
+
+  // 左树点选的表是聚焦基准：在图中则高亮该表上下游链路；
+  // 不在图中（暂无血缘）清空聚焦，避免残留高亮把全图压暗
+  useEffect(() => {
+    if (!selectedTable) return;
+    setSelected(lineage?.graph.nodes.some((n) => n.table === selectedTable) ? selectedTable : '');
+  }, [selectedTable, lineage]);
+
+  // 卡片展示的表：聚焦节点优先，否则跟随左树选中表（中性态也展示库表情况）
+  const cardTable = selected || selectedTable;
+
+  const toggleLayer = (layer: Layer) => {
+    setLayerFilter((cur) => {
+      const next = new Set(cur);
+      if (next.has(layer)) next.delete(layer);
+      else next.add(layer);
+      if (!next.size) next.add(layer);
+      return next;
+    });
+  };
+
+  const onExportPng = () => {
+    const el = canvasRef.current;
+    if (!el) return;
+    const backgroundColor = getComputedStyle(el).backgroundColor;
+    void toPng(el, {
+      pixelRatio: 2,
+      backgroundColor,
+      filter: (node) => !(node instanceof Element && node.classList.contains('react-flow__controls')),
+    }).then((url) => {
+      const a = document.createElement('a');
+      a.href = url;
+      a.download = `lineage-${selectedTable || 'graph'}.png`;
+      a.click();
+    });
+  };
+
+  const onExportJson = () => {
+    const data = {
+      nodes: lineage?.graph.nodes ?? [],
+      edges: lineage?.graph.edges ?? [],
+    };
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = `lineage-${selectedTable || 'graph'}.json`;
+    a.click();
+    URL.revokeObjectURL(url);
+  };
+
+  return (
+    <div>
+      <div className="dm-lineage-toolbar">
+        {mode === 'table' && (
+          <>
+            <div className="dm-lineage-search">
+              <Search size={14} aria-hidden="true" />
+              <input
+                type="search"
+                placeholder={t('dataManagement.lineage.search')}
+                aria-label={t('dataManagement.lineage.search')}
+                value={searchInput}
+                onChange={(e) => setSearchInput(e.target.value)}
+              />
+            </div>
+            <div className="dm-layer-checks">
+              {ALL_LAYERS.map((layer) => (
+                <label key={layer} className="dm-layer-check">
+                  <input type="checkbox" checked={layerFilter.has(layer)} onChange={() => toggleLayer(layer)} />
+                  {layer === 'OTHER' ? t('dataManagement.otherLayer') : layer}
+                </label>
+              ))}
+            </div>
+          </>
+        )}
+        <div className="dm-lineage-mode" role="group" aria-label={t('dataManagement.lineage.mode')}>
+          <button type="button" aria-pressed={mode === 'table'} onClick={() => onModeChange('table')}>
+            {t('dataManagement.lineage.table')}
+          </button>
+          <button type="button" aria-pressed={mode === 'column'} onClick={() => onModeChange('column')}>
+            {t('dataManagement.lineage.column')}
+          </button>
+        </div>
+      </div>
+      {mode === 'column' ? (
+        cardTable ? (
+          <TableColumnLineage key={JSON.stringify([selectedDb, cardTable])} db={selectedDb} table={cardTable} />
+        ) : (
+          <div className="dm-column-lineage-state">{t('dataManagement.selectTable')}</div>
+        )
+      ) : (
+        <>
+          <div className="dm-canvas" ref={canvasRef}>
+            {lineage ? (
+              <div style={{ height: '100%' }}>
+                <LineageGraph
+                  nodes={lineage.graph.nodes}
+                  edges={lineage.graph.edges}
+                  layerFilter={layerFilter}
+                  searchTerm={searchTerm}
+                  selected={selected}
+                  onSelect={setSelected}
+                  controlsPosition="bottom-right"
+                  extraControls={<LineageDownload onExportPng={onExportPng} onExportJson={onExportJson} />}
+                />
+              </div>
+            ) : (
+              <div className="dm-canvas-loading">{t('dataManagement.loading')}</div>
+            )}
+          </div>
+
+          {cardTable && <NodeDetailCard table={cardTable} onClose={selected ? () => setSelected('') : undefined} />}
+        </>
+      )}
+    </div>
+  );
+}
+
+function LineageDownload({ onExportPng, onExportJson }: { onExportPng: () => void; onExportJson: () => void }) {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(false);
+  const rootRef = useRef<HTMLDivElement>(null);
+  const triggerRef = useRef<HTMLButtonElement>(null);
+
+  useEffect(() => {
+    if (!open) return;
+    const onPointerDown = (event: PointerEvent) => {
+      if (event.target instanceof Node && !rootRef.current?.contains(event.target)) setOpen(false);
+    };
+    document.addEventListener('pointerdown', onPointerDown);
+    return () => document.removeEventListener('pointerdown', onPointerDown);
+  }, [open]);
+
+  const download = (exportFile: () => void) => {
+    setOpen(false);
+    triggerRef.current?.focus();
+    exportFile();
+  };
+
+  return (
+    <div
+      ref={rootRef}
+      className="dm-lineage-download"
+      onBlur={(event) => {
+        if (!event.currentTarget.contains(event.relatedTarget)) setOpen(false);
+      }}
+      onKeyDown={(event) => {
+        if (event.key === 'Escape' && open) {
+          event.stopPropagation();
+          setOpen(false);
+          triggerRef.current?.focus();
+        }
+      }}
+    >
+      <button
+        type="button"
+        className="react-flow__controls-button"
+        ref={triggerRef}
+        onClick={() => setOpen((value) => !value)}
+        title={t('dataManagement.lineage.download')}
+        aria-label={t('dataManagement.lineage.download')}
+        aria-expanded={open}
+      >
+        <Download size={16} aria-hidden="true" />
+      </button>
+      {open && (
+        <div className="dm-lineage-download-options" role="group" aria-label={t('dataManagement.lineage.download')}>
+          <button type="button" onClick={() => download(onExportPng)}>
+            {t('dataManagement.lineage.exportPng')}
+          </button>
+          <button type="button" onClick={() => download(onExportJson)}>
+            {t('dataManagement.lineage.exportJson')}
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
