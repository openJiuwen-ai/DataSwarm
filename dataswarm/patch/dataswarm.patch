+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { orchestrationApi } from '../api/orchestrationApi';
+import type { NodeInput, TaskDefinition, WorkflowDefinition } from '../types/orchestration';
+import { Button, StatusBadge } from './shared/Ui';
+import { WorkflowRuns } from './WorkflowRuns';
+import { useDatasourceWorkspaceStore } from '../../../stores/datasourceWorkspaceStore';
+import './shared/dataAsset.css';
+import './dataDevelopment.css';
+import './WorkflowRunPage.css';
+
+/** Existing public run URL and conversation preview share the detail page's run content. */
+export function WorkflowRunPage({ instanceId }: { instanceId: string }) {
+  const { t } = useTranslation();
+  // embed 模式（对话侧变更事件面板 iframe）：只渲染运行内容本体，无页头控件
+  const embed = new URLSearchParams(window.location.search).get('embed') === '1';
+  const workspaceId = useDatasourceWorkspaceStore((state) => state.currentWorkspaceId);
+  const [loaded, setLoaded] = useState<{ workflow: WorkflowDefinition; tasks: TaskDefinition[] } | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  useEffect(() => {
+    document.documentElement.classList.add('workflow-run-document');
+    return () => document.documentElement.classList.remove('workflow-run-document');
+  }, []);
+  useEffect(() => {
+    let active = true;
+    setLoaded(null);
+    setError(null);
+    const load = async () => {
+      try {
+        const instance = await orchestrationApi.getInstance(instanceId);
+        if (instance.ref_type !== 'workflow') throw new Error(t('workflowRun.wrongType'));
+        const [workflow, tasks] = await Promise.all([
+          orchestrationApi.getWorkflow(instance.ref_id),
+          orchestrationApi.allTasks(),
+        ]);
+        if (active) setLoaded({ workflow, tasks });
+      } catch (cause) {
+        if (active) setError(cause instanceof Error ? cause.message : String(cause));
+      }
+    };
+    void load();
+    return () => {
+      active = false;
+    };
+  }, [instanceId, workspaceId, attempt, t]);
+  const draft = useMemo<NodeInput[]>(
+    () =>
+      (loaded?.workflow.nodes ?? []).map((node) => ({
+        node_id: node.node_id,
+        task_id: node.task_id,
+        node_name: node.node_name ?? '',
+        group_name: node.group_name ?? '',
+        upstream_nodes: node.upstream_nodes,
+        wait_review: !!node.wait_review,
+        order_index: node.order_index,
+      })),
+    [loaded],
+  );
+  return (
+    <main className={embed ? 'workflow-run-page dd-editor workflow-run-page--embed' : 'workflow-run-page dd-editor'}>
+      {!embed && (
+        <header className="workflow-run-header">
+          <h1>{loaded?.workflow.name ?? t('workflowRun.title')}</h1>
+          {loaded && (
+            <StatusBadge status={loaded.workflow.status} label={t(`dataAsset.status.${loaded.workflow.status}`)} />
+          )}
+        </header>
+      )}
+      {error ? (
+        <div className="dd-error" role="alert">
+          {error}
+          <Button onClick={() => setAttempt((value) => value + 1)}>{t('common.retry')}</Button>
+        </div>
+      ) : loaded ? (
+        <WorkflowRuns
+          key={`${workspaceId}:${instanceId}`}
+          workflowId={loaded.workflow.workflow_id}
+          draft={draft}
+          tasks={loaded.tasks}
+          instanceId={instanceId}
+          showOverview={false}
+          onSelectInstance={(id) => {
+            if (id === instanceId) return;
+            window.history.pushState(
+              window.history.state,
+              '',
+              `/workflow-runs/${encodeURIComponent(id)}${window.location.search}`,
+            );
+            window.dispatchEvent(new Event('jiuwen:routechange'));
+          }}
+        />
+      ) : (
+        <div className="dd-loading" role="status">
+          {t('workflowRun.loading')}
+        </div>
+      )}
+    </main>
+  );
+}
