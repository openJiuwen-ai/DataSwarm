@@ -0,0 +1,53 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/_db.py —— 共享连接与主键工具（new_id / _conn_or / _commit_if_own / 写锁）（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+import json
+import threading
+import uuid
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+)
+
+
+
+_write_lock = threading.Lock()
+
+
+def new_id(prefix: str) -> str:
+    """生成 ``<prefix>_<uuid12>`` 形式的主键。"""
+    return f"{prefix}_{uuid.uuid4().hex[:12]}"
+
+
+def _conn_or(conn: Any) -> tuple[Any, bool]:
+    """返回 (连接, 是否本函数自建)。自建的需要调用方提交与关闭。"""
+    if conn is not None:
+        return conn, False
+    return _connect(), True
+
+
+def _commit_if_own(conn: Any, own: bool) -> None:
+    if own:
+        conn.commit()
+
+
+def _parse_json_dict(raw: Any) -> dict[str, Any]:
+    """把 JSON 串或 dict 统一成 dict；无法解析时返回空 dict（不抛）。"""
+    if not raw:
+        return {}
+    if isinstance(raw, dict):
+        return raw
+    if not isinstance(raw, str):
+        return {}
+    try:
+        parsed = json.loads(raw)
+    except json.JSONDecodeError:
+        return {}
+    return parsed if isinstance(parsed, dict) else {}
