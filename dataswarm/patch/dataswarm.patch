+"""inspection_service 服务端化单测（方案 §4：persist/findings/fix persist + annotate 归一化）。
+
+新功能档 TDD：本测试表达"服务端化后"的正确契约，跑前应为红（模块未建），
+inspection_service.py 建成后转绿。覆盖：
+  - persist_run：写 dw_inspection_runs/findings，含 annotate 归一化（UID 缺失行被 skip 计数）
+  - query_findings：按 run_id + selector/keyword 检索
+  - get_finding_detail：单条 finding
+  - persist_fixes：写 dw_inspection_fixes（fix.py 的 _persist_fix_rows 上收）
+  - 版本化 schema：body 带 schema_version
+"""
+from __future__ import annotations
+
+import json
+from datetime import datetime, timedelta
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web import inspection_service as svc
+
+
+# --------------------------------------------------------------------------
+# Fake db_connector：记录调用、返回可控结果
+# --------------------------------------------------------------------------
+class _FakeConn:
+    def __init__(self):
+        self.executed: list[tuple] = []  # (sql, params)
+        self.commit_calls = 0
+        self.rowcount = 0
+
+    def cursor(self):
+        return self
+
+    def execute(self, sql, params=None):
+        self.executed.append((sql, params))
+
+    def executemany(self, sql, seq):
+        self.executed.append((sql, list(seq)))
+
+    def commit(self):
+        self.commit_calls += 1
+
+    def rollback(self):
+        pass
+
+    def close(self):
+        pass
+
+
+class _FakeConnector:
+    def __init__(self):
+        self._conn = _FakeConn()
+        self.query_dict_result: list[dict] = []
+        self.query_dict_calls: list[tuple] = []
+        self.acquire_calls: list[tuple] = []
+        self.schema_calls: list[tuple] = []  # (db_ref, table)
+        self.schema_columns: list[str] = []  # 返回的列名（缺 llm_* 时触发 ALTER）
+        self.execute_calls: list[tuple] = []  # (db_ref, sql) —— ensure_review_columns 的 ALTER
+
+    def _acquire(self, db_ref, read_only=True):
+        self.acquire_calls.append((db_ref, read_only))
+        return self._conn, {"type": "sqlite", "path": ":memory:"}
+
+    def schema(self, db_ref, table):
+        self.schema_calls.append((db_ref, table))
+        return {"columns": [{"name": n} for n in self.schema_columns]}
+
+    def execute(self, db_ref, sql, params=None, commit=False):
+        self.execute_calls.append((db_ref, sql))
+        return {"rowcount": 0}
+
+    def parse_db_ref(self, db_ref):
+        # 测试用：sqlite:///test.db → {type, path}
+        if "://" not in (db_ref or ""):
+            return {"type": "sqlite", "path": db_ref or ""}
+        scheme, rest = db_ref.split("://", 1)
+        if scheme == "sqlite":
+            rest = rest[1:] if len(rest) >= 3 and rest[0] == "/" and rest[2] == ":" else rest
+            return {"type": "sqlite", "path": rest}
+        return {"type": scheme, "host": "h", "port": 3306, "database": "d"}
+
+    def _cursor(self, conn):
+        return conn
+
+    def _release(self, conn):
+        pass
+
+    def query_dict(self, db_ref, sql, params=None, limit=None):
+        self.query_dict_calls.append((db_ref, sql, params, limit))
+        return self.query_dict_result
+
+
+@pytest.fixture
+def patch_connector(monkeypatch):
+    fake = _FakeConnector()
+    monkeypatch.setattr(svc, "dc", fake)
+    return fake
+
+
+def _sample_result(tmp_path: Path) -> dict:
+    """构造一个最小 run_pipeline result（含一个 schema finding 产物文件）。
+
+    finding 已带 finding_uid（由 run_pipeline._normalize_artifact 标注，
+    persist_run 只读已标注的 uid，不做 annotate）。
+    """
+    findings_file = tmp_path / "schema_findings.json"
+    findings_file.write_text(json.dumps({
+        "findings": [
+            {"id": "NUL-001", "category": "NULL", "severity": "error",
+             "finding_uid": "schema:NUL:t1:id:NUL-001:abcd1234",
+             "finding_fingerprint": "fingerprint1",
+             "object": {"table": "t1", "column": "id"},
+             "summary": "col id nullable", "fix_hint": {"strategy": "NOT NULL"},
+             "evidence": {"nulls": 5}, "detail": {"rows": 10}},
+        ]
+    }), encoding="utf-8")
+    return {
+        "meta": {"run_id": "run-2026", "run_at": "2026-08-31T10:00:00+08:00",
+                 "db": "sqlite:///test.db", "session_id": "sess-1"},
+        "status": "completed",
+        "schema_findings": str(findings_file),
