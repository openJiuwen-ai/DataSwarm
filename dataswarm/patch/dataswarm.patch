+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 高保真共享 UI 原语（模块作用域 .da-*，见 dataAsset.css）。
+// 规格：Pixso「数据开发」帧——按钮 pill（主=黑底/次=白底灰边）、表格行内蓝色链接、
+// 状态点（16px 圆内 10px 实心）、执行器彩字（SQL/Python）。
+// 表格与分页统一用项目公共组件（components/ui/Table、Pagination），本文件不再自造。
+// 交互约定不变：破坏性操作走 confirmDialog，异步动作 loading 防重复点。
+
+import type { ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { RefreshCw, Search, X } from 'lucide-react';
+
+/* ---- 按钮（页头操作位） ---- */
+
+export function HifiButton({
+  children,
+  onClick,
+  variant = 'primary',
+  disabled,
+  loading = false,
+}: {
+  children: ReactNode;
+  onClick?: () => void;
+  variant?: 'primary' | 'default';
+  disabled?: boolean;
+  loading?: boolean;
+}) {
+  return (
+    <button
+      type="button"
+      className={`da-btn ${variant === 'primary' ? 'da-btn-primary' : 'da-btn-default'}`}
+      onClick={onClick}
+      disabled={disabled || loading}
+      aria-busy={loading || undefined}
+    >
+      {loading && <span className="da-link-spinner" aria-hidden="true" />}
+      {children}
+    </button>
+  );
+}
+
+/* ---- 表格行内链接动作（上线/调试/日志…） ---- */
+
+export function LinkAction({
+  children,
+  onClick,
+  loading = false,
+  disabled,
+  title,
+}: {
+  children: ReactNode;
+  onClick?: () => void;
+  loading?: boolean;
+  disabled?: boolean;
+  title?: string;
+}) {
+  return (
+    <button
+      type="button"
+      className="da-link"
+      onClick={onClick}
+      disabled={disabled || loading}
+      title={title}
+      aria-busy={loading || undefined}
+    >
+      {loading && <span className="da-link-spinner" aria-hidden="true" />}
+      {children}
+    </button>
+  );
+}
+
+/* ---- 状态点 ----
+   definition（定义态）：文本 var(--color-text-primary) + 彩色点（草稿灰/已发布绿）
+   runtime（实例态）：12px 彩色文本 + 彩色点（运行中 var(--color-tag-info-text)） */
+
+const STATUS_TONE: Record<string, string> = {
+  draft: 'var(--color-border-strong)',
+  published: 'var(--color-feedback-success)',
+  queued: 'var(--color-text-placeholder)',
+  running: 'var(--color-feedback-running)',
+  success: 'var(--color-feedback-success)',
+  failed: 'var(--color-feedback-danger)',
+  timeout: 'var(--color-feedback-danger)',
+  paused: 'var(--color-feedback-warning)',
+  waiting_review: 'var(--color-feedback-warning)',
+  skipped: 'var(--color-text-placeholder)',
+  cancelled: 'var(--color-text-placeholder)',
+};
+
+export function HifiStatus({
+  status,
+  label,
+  variant = 'definition',
+}: {
+  status: string;
+  label: string;
+  variant?: 'definition' | 'runtime';
+}) {
+  const tone = STATUS_TONE[status] ?? STATUS_TONE.draft;
+  return (
+    <span
+      className="da-status"
+      data-size={variant === 'runtime' ? 'sm' : undefined}
+      style={variant === 'runtime' ? { color: tone } : { color: 'var(--color-text-primary)' }}
+    >
+      <span className="da-status-dot" style={{ color: tone }} aria-hidden="true" />
+      {label}
+    </span>
+  );
+}
+
+/* ---- 执行器类型（多色标签：SQL var(--color-tag-info-surface)/var(--color-tag-info-text)、Python var(--color-feedback-queued-subtle)/var(--color-feedback-queued)） ---- */
+export function ExecutorTag({ type }: { type: string }) {
+  const t = type.toLowerCase();
+  return (
+    <span className="da-tag" data-type={t === 'python' ? 'python' : undefined}>
+      {t.toUpperCase()}
+    </span>
+  );
+}
+
+/* ---- 实例状态多色标签（12px 彩字 + 状态色约 12% 混白底，r=2） ----
+   规格样例（2-1/4-1 状态列）：Running var(--color-tag-info-surface)/var(--color-tag-info-text)；其余状态设计稿未给出配色，
+   决策：同一组件按状态色统一推导（bg = 状态色 12% 混白，fg = 状态色）。 */
+
+const TAG_TONE: Record<string, { bg: string; fg: string }> = {
+  running: { bg: 'var(--color-tag-info-surface)', fg: 'var(--color-tag-info-text)' },
+  queued: { bg: 'var(--color-feedback-queued-subtle)', fg: 'var(--color-feedback-queued)' },
+  waiting_review: { bg: 'var(--color-feedback-warning-subtle)', fg: 'var(--color-feedback-warning)' },
+  paused: { bg: 'var(--color-feedback-warning-subtle)', fg: 'var(--color-feedback-warning)' },
+  success: { bg: 'var(--color-feedback-success-subtle)', fg: 'var(--color-feedback-success)' },
+  failed: { bg: 'var(--color-feedback-danger-subtle)', fg: 'var(--color-feedback-danger)' },
+  timeout: { bg: 'var(--color-feedback-danger-subtle)', fg: 'var(--color-feedback-danger)' },
+  skipped: { bg: 'var(--color-surface-muted)', fg: 'var(--color-text-weak)' },
+  cancelled: { bg: 'var(--color-surface-muted)', fg: 'var(--color-text-weak)' },
+};
+
+export function HifiTag({ status, label }: { status: string; label: string }) {
+  const tone = TAG_TONE[status] ?? TAG_TONE.skipped;
+  return (
+    <span className="da-tag" style={{ background: tone.bg, color: tone.fg }}>
+      {label}
+    </span>
+  );
+}
+
+/* ---- 搜索框 / 图标按钮（工具条） ---- */
+
+export function SearchBox({
+  value,
+  onChange,
+  placeholder,
+  onCompositionChange,
+}: {
+  onCompositionChange?: (composing: boolean) => void;
+  value: string;
+  onChange: (v: string) => void;
+  placeholder: string;
+}) {
+  const { t } = useTranslation();
+  return (
+    <div className="da-search">
+      <Search size={14} aria-hidden="true" />
+      <input
+        onCompositionStart={() => onCompositionChange?.(true)}
+        onCompositionEnd={() => onCompositionChange?.(false)}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        placeholder={placeholder}
+        aria-label={placeholder}
+      />
+      {value && (
+        <button type="button" onClick={() => onChange('')} aria-label={t('common.clear')} title={t('common.clear')}>
+          <X size={14} />
+        </button>
+      )}
+    </div>
+  );
+}
+
+export function IconButton({
+  onClick,
+  title,
+  loading = false,
+  children,
+}: {
+  onClick?: () => void;
+  title: string;
+  loading?: boolean;
+  children: ReactNode;
+}) {
+  return (
+    <button type="button" className="da-icon-btn" onClick={onClick} disabled={loading} title={title} aria-label={title}>
+      {loading ? <RefreshCw size={14} className="da-spin" aria-hidden="true" /> : children}
+    </button>
+  );
+}
