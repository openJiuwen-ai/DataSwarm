+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 实例列表共享 util：耗时计算 + 活跃状态判定。供实例页（InstanceListPage）使用。
+
+import type { Instance } from '../../types/orchestration';
+
+/** 活跃（非终态、会推进的）实例状态 */
+export const ACTIVE_INSTANCE_STATUSES: ReadonlySet<string> = new Set(['queued', 'running', 'waiting_review']);
+/** 可取消的实例状态（非终态） */
+export const CANCELLABLE_INSTANCE_STATUSES: ReadonlySet<string> = new Set([
+  'queued',
+  'running',
+  'paused',
+  'waiting_review',
+]);
+
+/** 计算耗时：finished - started，返回人类可读字符串；未完成返回 '—'（由调用方 i18n 替代时传 fallback）。 */
+export function instanceDuration(started: string | null, finished: string | null, status?: string): string | null {
+  if (!started || (!finished && status && ['success', 'failed', 'cancelled', 'skipped'].includes(status))) return null;
+  const start = new Date(started).getTime();
+  const end = finished ? new Date(finished).getTime() : Date.now();
+  if (Number.isNaN(start) || Number.isNaN(end)) return null;
+  const secs = Math.max(0, Math.round((end - start) / 1000));
+  if (secs < 60) return `${secs}s`;
+  const m = Math.floor(secs / 60);
+  const s = secs % 60;
+  return `${m}m${s}s`;
+}
+
+export function formatDateTime(iso: string | null): string {
+  return iso ? iso.slice(0, 19).replace('T', ' ') : '—';
+}
+
+export function isActiveInstance(inst: Instance): boolean {
+  return ACTIVE_INSTANCE_STATUSES.has(inst.status);
+}
