+    新增 skill dw-demo / 新增 skill 专项测试 / 改 tests/t_base.py / 新增前端测试 /
+    改 docs（sync 类）/ 新增 fork 工具配置与同步清单（随 scripts/ 整树同步）
+    """
+    mrfork_bare = tmp_path / "mrfork.git"
+    mrhub_bare = tmp_path / "mrhub.git"
+    git(["init", "--bare", "-q", str(mrfork_bare)], tmp_path)
+    git(["init", "--bare", "-q", str(mrhub_bare)], tmp_path)
+    repo = tmp_path / "repo"
+    git(["init", "-q", "-b", "develop_oss", str(repo)], tmp_path)
+
+    write(repo, "jiuwenswarm/a.py", "base\n")
+    write(repo, "tests/t_base.py", "t\n")
+    write(repo, "tests/unit_tests/__init__.py", "")
+    write(repo, "jiuwenswarm/resources/agent/workspace/skills/old-skill/SKILL.md", "old\n")
+    write(repo, "docs/guide.md", "doc\n")
+    write(repo, "scripts/run.sh", "run\n")
+    write(repo, "README.md", "readme\n")
+    write(repo, "drop.txt", "drop\n")
+    git(["add", "-A"], repo)
+    commit(repo, "baseline")
+    git(["tag", "base0.1"], repo)
