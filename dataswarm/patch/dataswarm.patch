+    assert hits, f"真实 parquet 列一条候选都没派生出来: {[c['name'] for c in columns]}"
+    # 三条规则路径都要跑到：数值指标 / 文本维度 / 时间维度
+    assert hits["order_amt"][:2] == ("metric", "quantity"), hits
+    assert hits["channel_name"][:2] == ("term", "dimension"), hits
+    assert hits["order_date"][:2] == ("term", "time"), hits
+    # 技术列与主键不产生候选
