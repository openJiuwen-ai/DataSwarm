+    isActive,
+    activeSessionId,
+    messages,
+    isThinking,
+    contextCompressionRuntime,
+    contextCompressionSummary,
+    historyLoadedPages,
+    historyLoadingMore,
+    historyPrepending,
+    teamHumanShareCommands.length,
+    updateHistoryLayoutSnapshot,
