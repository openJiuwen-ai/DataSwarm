+++ b/jiuwenswarm/channels/web/dataagent/connectors/sqlalchemy_connector.py
@@ -0,0 +1,216 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""SQLAlchemy 关系型数据库连接器。"""
+
+from __future__ import annotations
+
+import time
+import hashlib
+import json
+from threading import RLock
+from typing import Any
+
+from .base import (
+    Connector,
+    SourceDefinition,
+    build_catalog,
+    build_schema,
+    register_engine,
+)
+from .errors import ConnectorDependencyError, ConnectorError
+from .sql_guard import validate_read_only_sql
+
+try:
+    from sqlalchemy import create_engine, inspect, text
+    from sqlalchemy.engine import URL, Engine
+except ImportError:  # pragma: no cover - exercised in minimal installations
+    create_engine = inspect = text = None
+    URL = Engine = Any
+
+
+_ENGINE_CACHE: dict[tuple[str, int, str], Any] = {}
+_ENGINE_LOCK = RLock()
+
+
+def _require_sqlalchemy() -> None:
+    if create_engine is None:
+        raise ConnectorDependencyError("SQLAlchemy is not installed")
+
+
+def _url_for(source: SourceDefinition) -> Any:
+    _require_sqlalchemy()
+    config = source.config
+    source_type = source.source_type
+    if source_type in {"postgresql", "postgres", "hologres"}:
+        # Hologres 复用 PG 驱动，但默认端口为 80。
+        # URL 参数需与 db_connector 的 PostgreSQL codec 保持一致。
+        driver = "postgresql+psycopg"
+        port = int(config.get("port") or (80 if source_type == "hologres" else 5432))
+    elif source_type in {"mysql", "mariadb", "doris", "starrocks"}:
+        driver = "mysql+pymysql"
+        port = int(config.get("port") or 3306)
+    elif source_type == "sqlserver":
+        driver = "mssql+pyodbc"
+        port = int(config.get("port") or 1433)
+    elif source_type == "oracle":
+        driver = "oracle+oracledb"
+        port = int(config.get("port") or 1521)
+    elif source_type == "sqlite":
+        database = str(config.get("path") or config.get("database") or "")
+        return URL.create("sqlite", database=database)
+    else:
+        raise ConnectorError(f"unsupported SQLAlchemy source type: {source_type}")
+    query = {}
+    database = str(config.get("database") or "")
+    username = str(config.get("user") or "")
+    password = str(config.get("password") or "")
+    if source_type == "sqlserver":
+        query["driver"] = str(config.get("driver") or "ODBC Driver 18 for SQL Server")
+        if "\\" in str(config.get("host") or ""):
+            # A named instance resolves its own endpoint; appending a TCP port
+            # breaks LocalDB and SQL Browser instance discovery.
+            port = None
+        if str(config.get("trusted_connection", "")).strip().lower() in {"true", "1", "yes"}:
+            username = password = None
+            query["Trusted_Connection"] = "yes"
+    if config.get("ssl_mode"):
+        query["sslmode"] = str(config["ssl_mode"])
+    return URL.create(
+        driver,
+        username=username,
+        password=password,
+        host=str(config.get("host") or ""),
+        port=port,
+        database=database,
+        query=query,
+    )
+
+
+@register_engine("sqlalchemy")
+class SQLAlchemyConnector(Connector):
+    engine = "sqlalchemy"
+
+    def __init__(self, source: SourceDefinition):
+        self.source = source
+
+    def _engine(self) -> Any:
+        _require_sqlalchemy()
+        fingerprint = hashlib.sha256(
+            json.dumps(self.source.config, sort_keys=True, default=str).encode("utf-8")
+        ).hexdigest()
+        key = (self.source.source_id, self.source.config_version, fingerprint)
+        with _ENGINE_LOCK:
+            cached = _ENGINE_CACHE.get(key)
+            if cached is None:
+                kwargs = {"pool_pre_ping": True, "pool_recycle": 1800}
+                if self.source.source_type == "sqlite":
+                    kwargs = {}
+                cached = create_engine(_url_for(self.source), **kwargs)
+                _ENGINE_CACHE[key] = cached
+            return cached
+
+    def test_connection(self) -> dict:
+        try:
+            with self._engine().connect() as connection:
+                connection.execute(text("SELECT 1"))
+            return {"ok": True, "message": "connection successful", "engine": self.engine}
+        except Exception as exc:
+            return {"ok": False, "error": str(exc), "engine": self.engine}
+
+    def catalog(self) -> dict:
+        from jiuwenswarm.common.dialect_registry import is_system_schema
+
+        inspector = inspect(self._engine())
+        datasets: list[dict] = []
+        for schema_name in inspector.get_schema_names():
+            # 系统 schema 不作为业务数据集返回，排除名单由方言档维护。
+            if is_system_schema(self.source.source_type, schema_name):
+                continue
+            for name in inspector.get_table_names(schema=schema_name):
+                datasets.append(
+                    {"name": name, "schema": schema_name, "type": "table"}
+                )
+        # 同时提供扁平 datasets 和按 schema 分组的视图。
+        return build_catalog(
+            source_id=self.source.source_id, engine=self.engine, datasets=datasets
+        )
+
+    def schema(self, dataset: str, schema_name: str | None = None) -> dict:
+        if schema_name is None and ("." in dataset or dataset.startswith(("[", '"', "`"))):
+            from jiuwenswarm.common.ref_codec import table_identifier_parts
+            from jiuwenswarm.common.dialect_registry import sqlglot_dialect
+
+            parts = table_identifier_parts(dataset, sqlglot_dialect(self.source.source_type))
+            dataset = parts[-1]
+            schema_name = parts[0] if len(parts) == 2 else None
+        inspector = inspect(self._engine())
+        columns = inspector.get_columns(dataset, schema=schema_name)
+        # 主键与注释从 inspector 另取：get_columns 不含主键信息，注释则按方言
+        # 可能缺失（dialect_registry 的 has_column_comment 记录了这点）。
+        try:
+            pk_info = inspector.get_pk_constraint(dataset, schema=schema_name) or {}
+            pk_cols = {str(c) for c in (pk_info.get("constrained_columns") or [])}
+        except Exception:  # noqa: BLE001 —— 部分方言不支持主键反射，退化为空
+            pk_cols = set()
+        return build_schema(
+            source_id=self.source.source_id,
+            dataset=dataset,
+            schema_name=schema_name,
+            columns=[
+                {
+                    "name": column.get("name"),
+                    "type": str(column.get("type")),
+                    "nullable": column.get("nullable"),
+                    "default": column.get("default"),
+                    "pk": str(column.get("name")) in pk_cols,
+                    "comment": column.get("comment") or "",
+                }
+                for column in columns
+            ],
+        )
+
+    def preview(self, dataset: str, limit: int = 100) -> dict:
+        safe_limit = max(1, min(int(limit), 10_000))
+        return self.query(f"SELECT * FROM {self._quote_dataset(dataset)}", limit=safe_limit)
+
+    def query(self, sql: str, params=None, limit: int = 100) -> dict:
+        query = validate_read_only_sql(sql, source_type=self.source.source_type)
+        safe_limit = max(1, min(int(limit), 10_000))
+        started = time.monotonic()
+        with self._engine().connect() as connection:
+            result = connection.execute(text(query), params or {})
+            rows = result.fetchmany(safe_limit + 1)
+            columns = list(result.keys())
+        truncated = len(rows) > safe_limit
+        rows = rows[:safe_limit]
+        return {
+            "ok": True,
+            "source_id": self.source.source_id,
+            "engine": self.engine,
+            "columns": columns,
+            "rows": [list(row) for row in rows],
+            "row_count": len(rows),
+            "truncated": truncated,
+            "elapsed_ms": int((time.monotonic() - started) * 1000),
+        }
+
+    def _quote_dataset(self, dataset: str) -> str:
+        """按注册方言引用表名，支持 schema.table。
+
+        MySQL 使用反引号，PostgreSQL 使用双引号，T-SQL 使用成对方括号。
+        """
+        from jiuwenswarm.common.ref_codec import quoted_table_identifier
+        from jiuwenswarm.common.dialect_registry import sqlglot_dialect
+
+        try:
+            return quoted_table_identifier(dataset, sqlglot_dialect(self.source.source_type))
+        except ValueError as exc:
+            raise ConnectorError("invalid dataset name") from exc
+
+
+def clear_engine_cache(source_id: str | None = None) -> None:
+    with _ENGINE_LOCK:
+        keys = list(_ENGINE_CACHE)
+        for key in keys:
+            if source_id is None or key[0] == source_id:
+                engine = _ENGINE_CACHE.pop(key)
+                engine.dispose()
