@@ -0,0 +1,126 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Read-only SQL Server LocalDB checks for the governance query/query_dict path.
+
+Run setup_localdb.py first. This supplement has its own report and does not alter
+the original batch13 gate count. It never registers a source in the workspace.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import json
+from pathlib import Path
+import tempfile
+
+from verify_gates import CONFIG, EXPECTED, REF, ROOT, TSQL, normalized, dbc
+from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+
+
+@contextmanager
+def credentials():
+    """Use only the dedicated LocalDB config; leave default source storage alone."""
+    old_path, old_cache = dbc._DATASOURCE_CONFIG, dbc._SOURCE_CREDS_CACHE
+    key = (dbc._credential_scope(), "sqlserver", CONFIG["host"], CONFIG["port"], CONFIG["database"])
+    with tempfile.TemporaryDirectory(prefix="dataswarm-batch13-query-") as temp:
+        blank = Path(temp) / "datasource.yaml"
+        blank.write_text("", encoding="utf-8")
+        try:
+            dbc._DATASOURCE_CONFIG = blank
+            dbc._SOURCE_CREDS_CACHE = {key: {"user": "", "password": "", "driver": CONFIG["driver"],
+                                             "trusted_connection": True}}
+            yield
+        finally:
+            dbc.close_all()
+            dbc._DATASOURCE_CONFIG, dbc._SOURCE_CREDS_CACHE = old_path, old_cache
+
+
+def identity():
+    result = dbc.query(REF, "SELECT CAST(SERVERPROPERTY('ProductVersion') AS varchar(128)), "
+                       "CAST(SERVERPROPERTY('Edition') AS varchar(128)), DB_NAME()")
+    version, edition, database = result["rows"][0]
+    assert str(version).startswith("15.") and "Express" in edition and database == CONFIG["database"]
+    assert "password" not in result["db"]
+    return {"version": version, "edition": edition, "database": database, "driver": CONFIG["driver"]}
+
+
+def binding():
+    sql = '''SELECT "order_id", '?' AS "literal_value" FROM "dbo"."fact_orders"
+WHERE "order_id">=? ORDER BY "order_id"'''
+    result = dbc.query(REF, sql, [49998], limit=2)
+    assert result["rows"] == [[49998, "?"], [49999, "?"]] and result["truncated"] is True
+    assert dbc.query_dict(REF, sql, [49998], limit=2) == [
+        {"order_id": 49998, "literal_value": "?"}, {"order_id": 49999, "literal_value": "?"}]
+    return "ODBC ? binding, ANSI quoted identifiers and literal question mark survived both query paths"
+
+
+def limits():
+    sql = "SELECT order_id FROM dbo.fact_orders ORDER BY order_id"
+    over_cap = " UNION ALL ".join(["SELECT order_id FROM dbo.fact_orders"] * 3)
+    for selected, wanted, expected, truncated in (
+        (sql, 3, 3, True),
+        (over_cap, 0, min(150000, dbc.MAX_QUERY_ROWS), dbc.MAX_QUERY_ROWS < 150000),
+    ):
+        result = dbc.query(REF, selected, limit=wanted)
+        assert result["row_count"] == expected and result["truncated"] is truncated
+        assert len(dbc.query_dict(REF, selected, limit=wanted)) == expected
+    assert dbc.query(REF, "SELECT TOP 2 order_id FROM dbo.fact_orders ORDER BY order_id", limit=3)["truncated"] is False
+    return "fetchmany limits and truncation verified on real SQL Server without appending LIMIT"
+
+
+def question(key):
+    assert normalized(dbc.query(REF, TSQL[key], limit=10)["rows"]) == EXPECTED[key]
+    rows = dbc.query_dict(REF, TSQL[key], limit=10)
+    assert normalized([list(row.values()) for row in rows]) == EXPECTED[key]
+    return EXPECTED[key]
+
+
+def guards():
+    original = dbc._acquire
+
+    def refuse_connection(*args, **kwargs):
+        raise AssertionError("Unsafe SQL reached connection boundary; no write was sent")
+    sqls = ("UPDATE dbo.fact_orders SET order_amt=0 WHERE 1=0", "DROP TABLE dbo.acceptance_guard_probe",
+            "SELECT 1 AS x INTO dbo.acceptance_guard_probe", "SELECT 1; SELECT 2")
+    try:
+        dbc._acquire = refuse_connection
+        for method in (dbc.query, dbc.query_dict):
+            for sql in sqls:
+                try:
+                    method(REF, sql)
+                except QueryValidationError:
+                    pass
+                else:
+                    raise AssertionError("Unsafe SQL accepted")
+    finally:
+        dbc._acquire = original
+    assert dbc.query(REF, "SELECT COUNT(*) FROM dbo.fact_orders")["rows"] == [[50000]]
+    return "Both entry points rejected UPDATE/DROP/INTO/multiple statements before acquisition; 50000 rows remain"
+
+
+def main():
+    results = []
+    checks = [("identity", identity), ("binding", binding), ("limits", limits)]
+    checks.extend((key, lambda key=key: question(key)) for key in EXPECTED)
+    checks.append(("guards", guards))
+    with credentials():
+        for name, fn in checks:
+            try:
+                detail = fn()
+                status = "pass"
+            except Exception as exc:
+                status, detail = "fail", f"{type(exc).__name__}: {exc}"
+            results.append({"name": name, "status": status, "detail": detail})
+            print(f"[{status.upper()}] {name}: {detail}")
+    failed = sum(item["status"] == "fail" for item in results)
+    report = {"type": "sqlserver", "passed": len(results) - failed, "failed": failed, "results": results,
+              "boundaries": ["SQL Server LocalDB 2019 / ODBC 17 / integrated authentication only.",
+                             ("Write guards checked with a no-connection sentinel; "
+                              "server account write privileges are not tested.")]}
+    output = ROOT / "artifact" / "datasource-validation" / "batch13-governance-result.json"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(f"Passed {len(results) - failed}; failed {failed}. Report: {output}")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
