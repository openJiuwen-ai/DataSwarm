@@ -0,0 +1,337 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""验证 DDL 建模与 PostgreSQL 对照结果。
+
+用法：verify_gates.py <pg_db_ref>；凭据输入 POSTGRES_USER / POSTGRES_PASSWORD。
+从专用 PostgreSQL fixture 读取 DDL，比较推断列、逻辑类型、可空性和主键，
+再以推断模型构造五道分析题并在 PostgreSQL 执行。DDL 源本身拒绝数据查询。
+"""
+import sys
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (
+    MetadataOnly, SourceDefinition, SqlQueryable, capabilities_of,
+    get_engine, registered_engines,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common import dialect_registry as dr
+
+PG_REF = sys.argv[1]
+PG_CONFIG = {
+    "host": "127.0.0.1", "port": 55432, "database": "dataswarm_batch2",
+    "user": __import__("os").environ["POSTGRES_USER"],
+    "password": __import__("os").environ["POSTGRES_PASSWORD"],
+}
+
+PASS, FAIL, SKIP = [], [], []
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+def norm(rows):
+    """按归一化数值比较，忽略 PostgreSQL numeric 与 DuckDB 的尾零表示差异。"""
+    out = []
+    for row in rows:
+        cells = []
+        for v in row:
+            try:
+                cells.append(f"{float(v):.4f}")
+            except (TypeError, ValueError):
+                cells.append(str(v))
+        out.append(cells)
+    return out
+
+
+def connector_for(type_id, config, source_id="verify"):
+    adapter = R.get_source_type(type_id)
+    source = SourceDefinition(source_id, type_id, "verify", adapter.engine, dict(config))
+    return get_engine(adapter.engine)(source)
+
+
+# 从真实 PG 取 DDL —— 这是 ddl 源的输入，也是对照基准
+REAL_DDL = dbc.show_create_table(PG_REF, "fact_orders")["create_sql"]
+DDL_CONFIG = {"ddl_text": REAL_DDL, "dialect": "postgres"}
+
+# ======================================================================
+print("\n########## ddl —— 门 A：接入 ##########")
+print(f"            取自真实 PG 的 DDL（{len(REAL_DDL)} 字符）：")
+for line in REAL_DDL.splitlines()[:4]:
+    print(f"              {line}")
+print("              ...")
+
+
+def a_ddl_catalog_entry():
+    entry = {t["type_id"]: t for t in R.list_source_types()}["ddl"]
+    assert entry["engine"] == "schema_only", entry
+    assert "schema_only" in registered_engines(), registered_engines()
+    # 它没有数据，capabilities 不该声明 sql_query / preview
+    assert "sql_query" not in entry["capabilities"], entry["capabilities"]
+    assert "preview" not in entry["capabilities"], entry["capabilities"]
+    return f"ddl 引擎=schema_only，capabilities={entry['capabilities']}（无 sql_query）"
+
+
+def a_ddl_validate():
+    adapter = R.get_source_type("ddl")
+    expect_raises(lambda: adapter.validate({}), ValueError, "空 ddl_text")
+    expect_raises(lambda: adapter.validate({"ddl_text": "这不是 SQL"}),
+                  ValueError, "解析不出 CREATE TABLE")
+    expect_raises(lambda: adapter.validate({"ddl_text": REAL_DDL, "dialect": "cobol"}),
+                  ValueError, "不支持的方言")
+    adapter.validate(DDL_CONFIG)
+    adapter.validate({"ddl_text": REAL_DDL})  # 方言留空走自动识别
+    return "空文本/不可解析/非法方言均被拒；自动识别方言可用"
+
+
+def a_ddl_test_connection():
+    ok = connector_for("ddl", DDL_CONFIG).test_connection()
+    assert ok.get("ok") is True, ok
+    bad = connector_for("ddl", {"ddl_text": "SELECT 1"}).test_connection()
+    assert bad.get("ok") is False, f"没有 CREATE 语句应失败: {bad}"
+    return f"解析成功（{ok['message']}）；无 CREATE 语句时失败"
+
+
+def a_ddl_build_ref_is_fingerprint():
+    adapter = R.get_source_type("ddl")
+    ref1 = adapter.build_ref(DDL_CONFIG)
+    ref2 = adapter.build_ref(dict(DDL_CONFIG))
+    ref3 = adapter.build_ref({"ddl_text": REAL_DDL + "\n-- 改了一点"})
+    assert ref1.startswith("ddl://") and len(ref1) == len("ddl://") + 16, ref1
+    assert ref1 == ref2, "同一份 DDL 指纹应稳定（幂等识别）"
+    assert ref1 != ref3, "不同 DDL 应得到不同指纹"
+    return f"ref={ref1}；同文本幂等、改动即变"
+
+
+check("A1", "类型声明与能力集", a_ddl_catalog_entry)
+check("A2", "参数校验", a_ddl_validate)
+check("A3", "解析成功/失败两态", a_ddl_test_connection)
+check("A4", "build_ref 为内容指纹", a_ddl_build_ref_is_fingerprint)
+
+# ======================================================================
+print("\n########## ddl —— 门 B：建模（与真库对照）##########")
+
+
+def b_ddl_structure_matches_real_db():
+    """将 DDL 推断的列名、可空性、主键和逻辑类型与 PostgreSQL 元数据比较。
+
+    比较逻辑类型而非类型名拼写，允许方言之间的等价类型别名。
+    """
+    conn = connector_for("ddl", DDL_CONFIG)
+    from_ddl = {c["name"]: c for c in conn.schema("fact_orders")["columns"]}
+    from_db = {c["name"]: c for c in dbc.schema(PG_REF, "fact_orders")["columns"]}
+
+    assert set(from_ddl) == set(from_db), (
+        f"列集不一致\n  DDL={sorted(from_ddl)}\n  真库={sorted(from_db)}"
+    )
+    mismatches = []
+    for name, ddl_col in from_ddl.items():
+        db_col = from_db[name]
+        ddl_logical = dr.logical_type("postgresql", ddl_col["type"])
+        db_logical = dr.logical_type("postgresql", db_col["type"])
+        if ddl_logical != db_logical:
+            mismatches.append(f"{name}: DDL={ddl_col['type']}({ddl_logical}) "
+                              f"真库={db_col['type']}({db_logical})")
+        if bool(ddl_col["pk"]) != bool(db_col.get("pk")):
+            mismatches.append(f"{name}: pk DDL={ddl_col['pk']} 真库={db_col.get('pk')}")
+        if bool(ddl_col["nullable"]) != bool(db_col.get("null", True)):
+            mismatches.append(f"{name}: nullable DDL={ddl_col['nullable']} "
+                              f"真库={db_col.get('null')}")
+    assert not mismatches, "DDL 建模与真库不一致：\n  " + "\n  ".join(mismatches)
+    return (f"{len(from_ddl)} 列逐一对照一致（逻辑类型 / 主键 / 可空）；"
+            f"主键={[n for n,c in from_ddl.items() if c['pk']]}")
+
+
+def b_ddl_catalog_and_manifest():
+    conn = connector_for("ddl", DDL_CONFIG)
+    datasets = [d["name"] for d in conn.catalog()["datasets"]]
+    assert datasets == ["fact_orders"], datasets
+    manifest = conn.manifest()
+    assert manifest["table_count"] == 1, manifest
+    assert manifest["column_count"] == 7, manifest
+    assert manifest["tables"][0]["primary_key"] == ["order_id"], manifest["tables"][0]
+    return (f"catalog={datasets}；manifest {manifest['table_count']} 表 "
+            f"{manifest['column_count']} 列，主键={manifest['tables'][0]['primary_key']}")
+
+
+def b_ddl_multi_table_and_dialects():
+    """多表 DDL 与多方言回退。"""
+    multi = """
+    CREATE TABLE dim_region (region_id BIGINT PRIMARY KEY, region_name VARCHAR(32));
+    CREATE TABLE dim_category (category_id BIGINT PRIMARY KEY, category_name VARCHAR(32));
+    """
+    conn = connector_for("ddl", {"ddl_text": multi}, source_id="multi")
+    names = sorted(d["name"] for d in conn.catalog()["datasets"])
+    assert names == ["dim_category", "dim_region"], names
+    # MySQL 风格（反引号 + 表级主键）也要能解析
+    mysql_ddl = (
+        "CREATE TABLE `orders` (\n"
+        "  `id` BIGINT NOT NULL,\n"
+        "  `amt` DECIMAL(10,2),\n"
+        "  PRIMARY KEY (`id`)\n"
+        ") ENGINE=InnoDB;"
+    )
+    conn2 = connector_for("ddl", {"ddl_text": mysql_ddl, "dialect": "mysql"},
+                          source_id="mysqlddl")
+    cols = {c["name"]: c for c in conn2.schema("orders")["columns"]}
+    assert cols["id"]["pk"] is True, cols["id"]
+    assert cols["id"]["nullable"] is False, cols["id"]
+    return f"多表解析 {names}；MySQL 反引号 + 表级 PRIMARY KEY 正确识别"
+
+
+def b_ddl_unknown_table_refused():
+    conn = connector_for("ddl", DDL_CONFIG)
+    expect_raises(lambda: conn.schema("no_such_table"), ConnectorError, "未定义的表")
+    return "请求 DDL 里没有的表时明确报错并列出已解析表名"
+
+
+check("B1", "结构与真库逐列一致", b_ddl_structure_matches_real_db)
+check("B2", "catalog / manifest", b_ddl_catalog_and_manifest)
+check("B3", "多表与多方言", b_ddl_multi_table_and_dialects)
+check("B4", "未定义表被拒", b_ddl_unknown_table_refused)
+
+# ======================================================================
+print("\n########## ddl —— 门 C：建模正确性（配对真库）##########")
+
+BASELINE = {
+    "Q1 单指标总量": [["2318839.92"]],
+    "Q2 分组TopN排序": [["4", "620606.75"], ["2", "620448.25"], ["3", "532051.48"]],
+    "Q3 时间粒度月度": [["2026-01", "99018.5"], ["2026-02", "91174.23"],
+                        ["2026-03", "97070.7"]],
+    "Q4 过滤+聚合": [["1", "10651"], ["2", "12425"], ["3", "10650"], ["4", "12425"]],
+    "Q5 空值占比": [["7.142"]],
+}
+
+
+def c_ddl_model_drives_correct_analysis():
+    """仅从 DDL 推断模型选取列和类型，再在 PostgreSQL 执行分析。
+
+    构造 SQL 时不读取服务器 schema，避免服务器元数据掩盖推断错误。
+    """
+    ddl_conn = connector_for("ddl", DDL_CONFIG)
+    model = {c["name"]: c for c in ddl_conn.schema("fact_orders")["columns"]}
+
+    # 从模型里按逻辑类型挑列，而不是硬编码列名
+    numeric = [n for n, c in model.items()
+               if dr.logical_type("postgresql", c["type"]) == dr.NUMERIC
+               and not c["pk"]]
+    time_cols = [n for n, c in model.items()
+                 if dr.logical_type("postgresql", c["type"]) == dr.TIME]
+    assert "order_amt" in numeric, numeric
+    assert time_cols == ["order_date"], time_cols
+    measure, date_col = "order_amt", time_cols[0]
+    table = "fact_orders"
+
+    questions = {
+        "Q1 单指标总量": f'SELECT ROUND((SUM({measure}))::numeric, 2) AS v FROM "{table}"',
+        "Q2 分组TopN排序": (
+            f'SELECT region_id, ROUND((SUM({measure}))::numeric,2) AS v FROM "{table}" '
+            "GROUP BY region_id ORDER BY v DESC, region_id LIMIT 3"
+        ),
+        "Q3 时间粒度月度": (
+            f"SELECT to_char({date_col}, 'YYYY-MM') AS m, "
+            f'ROUND((SUM({measure}))::numeric,2) AS v FROM "{table}" '
+            f"WHERE {date_col} >= DATE '2026-01-01' GROUP BY m ORDER BY m LIMIT 3"
+        ),
+        "Q4 过滤+聚合": (
+            f'SELECT category_id, COUNT(*) AS c FROM "{table}" '
+            f"WHERE region_id <> 9 AND {measure} IS NOT NULL "
+            "GROUP BY category_id ORDER BY category_id"
+        ),
+        "Q5 空值占比": (
+            f"SELECT ROUND((100.0 * SUM(CASE WHEN {measure} IS NULL THEN 1 ELSE 0 END) "
+            f'/ COUNT(*))::numeric, 4) AS pct FROM "{table}"'
+        ),
+    }
+    pg_conn = connector_for("postgresql", PG_CONFIG, source_id="pg-pair")
+    answers = {}
+    for label, sql in questions.items():
+        answers[label] = norm(pg_conn.query(sql, limit=10)["rows"])
+    for label, raw_expected in BASELINE.items():
+        expected = norm(raw_expected)
+        assert answers[label] == expected, (
+            f"{label} 与基准不一致（说明 DDL 建模驱动的 SQL 算错了）:\n"
+            f"  基准={expected}\n  实得={answers[label]}"
+        )
+    print("            由 DDL 模型驱动、在真实 PG 上执行的答案：")
+    for label, rows in BASELINE.items():
+        print(f"              {label} = {rows[0] if len(rows) == 1 else rows}")
+    return (f"度量列 {measure} / 时间列 {date_col} 均由 DDL 推断得出；"
+            f"5 道题在真实 PG 上与基准逐值一致")
+
+
+def c_ddl_itself_cannot_be_queried():
+    """DDL 源只提供元数据，必须拒绝数据查询。"""
+    conn = connector_for("ddl", DDL_CONFIG)
+    assert not isinstance(conn, SqlQueryable), "ddl 连接器不该具备 SQL 能力"
+    assert isinstance(conn, MetadataOnly), "ddl 连接器应具备 metadata_only 能力"
+    assert capabilities_of(conn) == {"metadata_only"}, capabilities_of(conn)
+    assert not hasattr(conn, "query"), "不该有 query 方法（留占位会让能力探测误报）"
+    return "capabilities={'metadata_only'}；无 query 方法，非抛异常占位"
+
+
+check("C1", "DDL 模型驱动分析正确", c_ddl_model_drives_correct_analysis)
+check("C2", "ddl 源本身不可查数", c_ddl_itself_cannot_be_queried)
+
+# ======================================================================
+print("\n########## ddl —— 门 D：护栏 ##########")
+
+
+def d_ddl_service_refuses_sql_paths():
+    """service 层对 metadata_only 源发 SQL 必须被拦，且错误可读。"""
+    from jiuwenswarm.channels.web.dataagent.connectors.errors import (
+        CapabilityUnsupportedError,
+    )
+    conn = connector_for("ddl", DDL_CONFIG)
+    assert not isinstance(conn, SqlQueryable)
+    # service._sql_connector 依据能力协议拒绝 metadata-only 源。
+    assert CapabilityUnsupportedError is not None
+    return "能力闸门按协议判定，service 的 SQL 入口会拒绝 metadata_only 源"
+
+
+def d_ddl_no_sql_execution_in_connector():
+    import inspect as _inspect
+
+    from jiuwenswarm.channels.web.dataagent.connectors import schema_only_connector as sc
+
+    src = _inspect.getsource(sc)
+    for banned in ("duckdb", "execute(", "create_engine"):
+        assert banned not in src, f"schema_only 连接器出现了执行相关代码（{banned}）"
+    return "连接器内无任何执行路径（不连库、不起引擎）"
+
+
+check("D1", "能力闸门拦住 SQL 入口", d_ddl_service_refuses_sql_paths)
+check("D2", "连接器内无执行路径", d_ddl_no_sql_execution_in_connector)
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\nddl 四道门通过（门 C 以配对真库验建模正确性）")
