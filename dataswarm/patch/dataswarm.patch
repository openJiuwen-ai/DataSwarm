+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""guard 对象范围检查单测：允许集口径与别名绑定回归（切入点六调查产物）。
+
+背景：guard 列白名单曾存完整物理名（orders.amount_cny），而 sqlglot 的
+column.name 恒为裸列名（amount_cny），完整名永远匹配不上——恒等绑定
+（逻辑名 = 物理尾段）下未暴露，别名绑定（逻辑名 ≠ 尾段，column_map 机制
+本身支持）会把合法的编译产物误判越界。本组测试锁定修复后的口径
+（逻辑名 + 物理尾段），并与 analysis/checks._allowed_objects 对拍防再漂移。
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import sqlglot
+
+from jiuwenswarm.channels.web.dataagent.metrics import guard
+
+
+def _binding(column_map: dict[str, str], source_table: str = "shop.orders") -> SimpleNamespace:
+    return SimpleNamespace(source_table=source_table, column_map=column_map)
+
+
+def test_aliased_binding_allows_physical_column_reference():
+    """别名绑定（逻辑名≠物理尾段）下，编译产物引用物理列必须放行。
+
+    修复前：允许集只有 {'金额', 'orders.amount_cny'}，而 column.name 解析为
+    'amount_cny'——合法 SQL 被 SchemaChanged 误拒。
+    """
+    rev = SimpleNamespace(revision_id="r1")
+    by_rev = {"r1": [_binding({"金额": "orders.amount_cny"})]}
+    tables, columns = guard.allowed_objects([rev], by_rev)
+    assert "amount_cny" in columns and "金额" in columns
+
+    parsed = sqlglot.parse_one(
+        "SELECT SUM(orders.amount_cny) AS gmv FROM shop.orders")
+    guard._check_tables(parsed, tables)   # 不抛 = 表在界内
+    guard._check_columns(parsed, columns)  # 不抛 = 列在界内
+
+
+def test_identity_binding_allowed_set_unchanged():
+    """恒等绑定（生产现状）允许集不受修复影响。"""
+    rev = SimpleNamespace(revision_id="r1")
+    by_rev = {"r1": [_binding({"amount_cny": "orders.amount_cny",
+                               "pay_status": "orders.pay_status"})]}
+    _tables, columns = guard.allowed_objects([rev], by_rev)
+    assert columns == {"amount_cny", "pay_status"}
+
+
+def test_checks_uses_shared_allowed_objects():
+    """单源断言：analysis/checks 必须引用 guard.allowed_objects 本体，不得重抄一份。
+
+    统一前两侧各有一份 _allowed_objects（曾因物理名口径分叉产生误拒 bug）；
+    本测试防的是「将来又有人就地抄一份」。
+    """
+    from jiuwenswarm.channels.web.dataagent.analysis import checks as analysis_checks
+
+    assert analysis_checks.allowed_objects is guard.allowed_objects
