index 000000000..33798e0c8
--- /dev/null
+++ b/jiuwenswarm/agents/harness/common/knowledge_base/config.py
@@ -0,0 +1,143 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Knowledge base configuration for JiuWenSwarm.
+
+Only one config knob is exposed: ``knowledge_base.enabled`` in config.yaml.
+Everything else (kb_id, index_type, chunk size, …) is fixed to sane defaults
+in :class:`KnowledgeBaseSettings`. Per-query knobs (top_k, agentic,
+score_threshold) live on the ``kb_search`` tool, not in config.
+
+Embedding API settings are reused from the existing ``embed`` section via
+:func:`jiuwenswarm.agents.harness.common.memory.config.get_embed_config`.
+"""
+
+import logging
+import os
+import re
+from typing import Any, Dict, Optional
+
+import yaml
+
+from jiuwenswarm.common.utils import get_config_file, get_agent_workspace_dir
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_CONFIG_PATH = str(get_config_file())
+DEFAULT_WORKSPACE_DIR = str(get_agent_workspace_dir())
+
+# ChromaDB local mode supports vector index only (no sparse / hybrid).
+# See openjiuwen.core.retrieval.knowledge_base.KnowledgeBase.__setattr__.
+DEFAULT_KB_ID = "biz_kb"
+DEFAULT_COLLECTION_NAME = "biz_docs"
+DEFAULT_INDEX_TYPE = "vector"
+DEFAULT_CHUNK_SIZE = 512
+DEFAULT_CHUNK_OVERLAP = 50
+DEFAULT_TOP_K = 5
+DEFAULT_SCORE_THRESHOLD: Optional[float] = None
+DEFAULT_AGENTIC = False
+
+# Vector store root for all KB collections: <workspace>/.kb_chroma
+DEFAULT_KB_CHROMA_DIR = ".kb_chroma"
+
+_config_cache: Optional[Dict[str, Any]] = None
+
+
+def _resolve_env_vars(value: Any) -> Any:
+    """Recursively resolve environment variables in config values."""
+    if isinstance(value, str):
+        pattern = r'\$\{([^:}]+)(?::-([^}]*))?\}'
+
+        def replace_env(match):
+            var_name = match.group(1)
+            default = match.group(2) if match.group(2) is not None else ""
+            return os.getenv(var_name, default)
+
+        return re.sub(pattern, replace_env, value)
+    elif isinstance(value, dict):
+        return {k: _resolve_env_vars(v) for k, v in value.items()}
+    elif isinstance(value, list):
+        return [_resolve_env_vars(item) for item in value]
+    else:
+        return value
+
+
+def clear_config_cache() -> None:
+    """清除配置缓存，使下次 _load_config() 重新从 config.yaml 读取并解析环境变量."""
+    global _config_cache
+    _config_cache = None
+
+
+def _load_config() -> Dict[str, Any]:
+    """Load configuration from YAML file (cached)."""
+    global _config_cache
+    if _config_cache is not None:
+        return _config_cache
+
+    config_path = DEFAULT_CONFIG_PATH
+    if not os.path.exists(config_path):
+        logger.warning(f"Config file not found: {config_path}")
+        _config_cache = {}
+        return _config_cache
+
+    with open(config_path, "r", encoding="utf-8") as f:
+        config = yaml.safe_load(f) or {}
+
+    config = _resolve_env_vars(config)
+    _config_cache = config
+    return config
+
+
+def get_embed_config() -> Dict[str, str]:
+    """Reuse the memory system's embedding config (``embed`` section).
+
+    Returns a dict with ``api_key`` / ``base_url`` / ``model``. Empty strings
+    when the section is missing — callers treat empty as "not configured".
+    """
+    # Prefer the memory module's loader so a single source of truth stays in
+    # charge of the cache. Fall back to a local read if that import fails.
+    try:
+        from jiuwenswarm.agents.harness.common.memory.config import get_embed_config as _mem_get_embed_config
+        return _mem_get_embed_config()
+    except Exception:
+        pass
+
+    config = _load_config()
+    embed_config = config.get("embed", {})
+    return {
+        "api_key": embed_config.get("embed_api_key") or "",
+        "base_url": embed_config.get("embed_base_url") or "",
+        "model": embed_config.get("embed_model") or "",
+    }
+
+
+def is_embed_configured() -> bool:
+    """True when all three embedding fields are non-empty."""
+    cfg = get_embed_config()
+    return bool(cfg.get("api_key") and cfg.get("base_url") and cfg.get("model"))
+
+
+def is_kb_enabled(mode: str = "", config: Optional[Dict[str, Any]] = None) -> bool:
+    """Check if the knowledge base feature is enabled.
+
+    Reads ``knowledge_base.enabled`` (default False — opt-in). When the
+    embedding config is incomplete the feature is force-disabled regardless
+    of the ``enabled`` flag, because building a KB needs a working embedder.
+    """
+    try:
+        cfg = config if config is not None else _load_config()
+        kb_cfg = cfg.get("knowledge_base", {})
+        if not isinstance(kb_cfg, dict):
+            return False
+        enabled = bool(kb_cfg.get("enabled", False))
+        if not enabled:
+            return False
+        if not is_embed_configured():
+            logger.warning(
+                "knowledge_base.enabled is true but embed config is incomplete "
+                "(embed_api_key / embed_base_url / embed_model); disabling KB."
+            )
+            return False
+        return True
+    except Exception as e:
+        logger.warning(f"Invalid knowledge_base config, disable KB, error: {e}")
+        return False
diff --git a/jiuwenswarm/agents/harness/common/knowledge_base/manager.py b/jiuwenswarm/agents/harness/common/knowledge_base/manager.py
new file mode 100644
index 000000000..558be6723
--- /dev/null
+++ b/jiuwenswarm/agents/harness/common/knowledge_base/manager.py
@@ -0,0 +1,672 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Knowledge base manager for JiuWenSwarm.
+
+Wraps :class:`openjiuwen.core.retrieval.SimpleKnowledgeBase` (ChromaDB local
+backend) behind a multi-KB registry so the ``kb_*`` tools can list / get /
+update / ingest / search knowledge bases without each touching the RAG
+internals.
+
+Registry layout (``<workspace>/.kb_chroma/registry.json``)::
+
+    {
+      "biz_kb": {
+        "kb_id": "biz_kb",
+        "name": "业务知识库",
+        "description": "",
+        "tags": [],
+        "collection_name": "biz_docs",
+        "created": "2026-08-18T..."
+      }
+    }
+
+Each KB's vectors live in ``<workspace>/.kb_chroma/<kb_id>/`` (one ChromaDB
+persistent client per KB to keep collections isolated).
+"""
+
+import asyncio
+import datetime as _dt  # alias: Date.now()/new Date() are fine here, no workflow
+import json
+import logging
+import os
+import re
+import shutil
+from typing import Any, Dict, List, Optional
+
+import portalocker
+
+from .config import (
+    DEFAULT_CHUNK_OVERLAP,
+    DEFAULT_CHUNK_SIZE,
+    DEFAULT_COLLECTION_NAME,
+    DEFAULT_INDEX_TYPE,
+    DEFAULT_KB_CHROMA_DIR,
+    DEFAULT_KB_ID,
+    DEFAULT_SCORE_THRESHOLD,
+    DEFAULT_TOP_K,
+    get_embed_config,
+)
+
+logger = logging.getLogger(__name__)
+
+# kb_id 允许的字符集：字母/数字/下划线/中划线，1-64 位。kb_id 会成为 ChromaDB
+# 数据目录名（``<root>/<kb_id>/``），限制字符集防止路径穿越与非法目录名。
+_KB_ID_PATTERN = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
+
+# Module-level singleton cache keyed by (workspace_dir).
+_KB_MANAGERS: Dict[str, "KnowledgeBaseManager"] = {}
+
+
+def validate_kb_id(kb_id: str) -> Optional[str]:
+    """Return an error message for an invalid ``kb_id``, or ``None`` if valid.
+
+    The default KB id is always valid (it never becomes a directory name here,
+    but keeping it accepted avoids surprises when callers pre-create it).
+    """
+    if not isinstance(kb_id, str) or not kb_id.strip():
+        return "kb_id is required"
+    if kb_id == DEFAULT_KB_ID:
+        return None
+    if not _KB_ID_PATTERN.match(kb_id):
+        return (
+            "kb_id must match [A-Za-z0-9_-]{1,64} "
+            f"(got: {kb_id!r})"
+        )
+    return None
+
+
+class KnowledgeBaseManager:
+    """Manages one or more local ChromaDB-backed knowledge bases.
+
+    Use :meth:`get` to obtain a process-wide singleton for a workspace; do
+    not instantiate directly.
+    """
+
+    def __init__(self, workspace_dir: str):
+        self.workspace_dir = workspace_dir
+        self._chroma_root = os.path.join(workspace_dir, DEFAULT_KB_CHROMA_DIR)
+        self._registry_path = os.path.join(self._chroma_root, "registry.json")
+        # kb_id -> SimpleKnowledgeBase instance (lazy built)
+        self._kbs: Dict[str, Any] = {}
+        # kb_id -> registry entry dict (name/description/tags/collection_name/created)
+        self._registry: Dict[str, Dict[str, Any]] = {}
+        self._registry_loaded = False
+        self._lock = asyncio.Lock()
+
+    # ------------------------------------------------------------------ #
+    # Singleton
+    # ------------------------------------------------------------------ #
+    @classmethod
+    def get(cls, workspace_dir: str) -> "KnowledgeBaseManager":
+        """Return the singleton manager for ``workspace_dir``."""
+        key = os.path.abspath(workspace_dir)
+        if key in _KB_MANAGERS:
+            return _KB_MANAGERS[key]
+        mgr = cls(workspace_dir)
+        _KB_MANAGERS[key] = mgr
+        return mgr
+
+    @classmethod
+    def clear_cache(cls) -> None:
+        """Drop all cached managers (used by tests / config reload)."""
+        _KB_MANAGERS.clear()
+
+    # ------------------------------------------------------------------ #
+    # Registry persistence
+    # ------------------------------------------------------------------ #
+    def _load_registry(self) -> None:
+        if self._registry_loaded:
+            return
+        self._ensure_root()
+        if os.path.exists(self._registry_path):
+            try:
+                # 显式 UTF-8：Windows 默认 ANSI（GBK）会把中文库名写成乱码。
+                with portalocker.Lock(self._registry_path, "r", timeout=5, encoding="utf-8") as f:
+                    data = json.load(f)
+                if isinstance(data, dict):
+                    self._registry = {
+                        str(k): v for k, v in data.items() if isinstance(v, dict)
+                    }
+            except Exception as e:
+                logger.warning(f"Failed to load KB registry {self._registry_path}: {e}")
+                self._registry = {}
+        self._registry_loaded = True
+
+    def _save_registry(self) -> None:
+        self._ensure_root()
+        try:
+            # 显式 UTF-8：与 _load_registry 对齐，跨平台中文库名不失真。
+            with portalocker.Lock(self._registry_path, "w", timeout=5, encoding="utf-8") as f:
+                json.dump(self._registry, f, ensure_ascii=False, indent=2)
+        except Exception as e:
+            logger.error(f"Failed to save KB registry: {e}")
+
+    def _ensure_root(self) -> None:
+        os.makedirs(self._chroma_root, exist_ok=True)
+
+    # ------------------------------------------------------------------ #
+    # KB construction
+    # ------------------------------------------------------------------ #
+    def _chroma_path_for(self, kb_id: str) -> str:
+        return os.path.join(self._chroma_root, kb_id)
+
+    def _build_kb(self, kb_id: str, collection_name: str = "") -> Any:
+        """Construct a SimpleKnowledgeBase backed by a fresh ChromaDB path.
+
+        ChromaDB local mode supports ``index_type="vector"`` only; sparse /
+        hybrid are rejected by the base class validator.
+
+        The Chroma collection is always named ``kb_{kb_id}_chunks`` to match
+        ``SimpleKnowledgeBase.add_documents``'s ``IndexConfig.index_name``
+        (openjiuwen builds/writes that collection internally regardless of the
+        ``vector_store``'s collection_name). The passed ``collection_name`` is
+        kept for the registry only.
+        """
+        from openjiuwen.core.retrieval.common.config import (
+            EmbeddingConfig,
+            KnowledgeBaseConfig,
+            StoreType,
+            VectorStoreConfig,
+        )
+        from openjiuwen.core.retrieval.embedding.openai_embedding import (
+            OpenAIEmbedding,
+        )
+        from openjiuwen.core.retrieval.indexing.indexer.chroma_indexer import (
+            ChromaIndexer,
+        )
+        from openjiuwen.core.retrieval.indexing.processor.parser.auto_parser import (
+            AutoParser,
+        )
+        from openjiuwen.core.retrieval.indexing.processor.chunker import (
+            get_chunker,
+        )
+        from openjiuwen.core.retrieval.simple_knowledge_base import (
+            SimpleKnowledgeBase,
+        )
+        from openjiuwen.core.retrieval.vector_store.store import (
+            create_vector_store,
+        )
+
+        embed_cfg = get_embed_config()
+        chroma_path = self._chroma_path_for(kb_id)
+        os.makedirs(chroma_path, exist_ok=True)
+
+        store_config = VectorStoreConfig(
+            store_provider=StoreType.Chroma,
+            collection_name=f"kb_{kb_id}_chunks",
+        )
+        vector_store = create_vector_store(store_config, chroma_path=chroma_path)
+        index_manager = ChromaIndexer(
+            config=store_config,
+            chroma_path=chroma_path,
+        )
+        embed_model = OpenAIEmbedding(
+            config=EmbeddingConfig(
+                model_name=embed_cfg["model"],
+                base_url=embed_cfg["base_url"],
+                api_key=embed_cfg["api_key"],
+            )
+        )
+
+        kb = SimpleKnowledgeBase(
+            config=KnowledgeBaseConfig(
+                kb_id=kb_id,
+                index_type=DEFAULT_INDEX_TYPE,
+                chunk_size=DEFAULT_CHUNK_SIZE,
+                chunk_overlap=DEFAULT_CHUNK_OVERLAP,
+            ),
+            vector_store=vector_store,
+            embed_model=embed_model,
+            parser=AutoParser(),
+            chunker=get_chunker(
+                "hybrid",
+                chunk_size=DEFAULT_CHUNK_SIZE,
+                chunk_overlap=DEFAULT_CHUNK_OVERLAP,
+            ),
+            index_manager=index_manager,
+        )
+        return kb
+
+    async def _get_or_build_kb(self, kb_id: str) -> Any:
+        """Return the SimpleKnowledgeBase for ``kb_id``, building if needed.
+
+        Raises KeyError if the kb_id is not in the registry (i.e. has not been
+        created via ``create_kb`` / ``update_kb``).
+        """
+        self._load_registry()
+        if kb_id in self._kbs:
+            return self._kbs[kb_id]
+        if kb_id not in self._registry:
+            raise KeyError(f"Knowledge base not found: {kb_id}")
+        entry = self._registry[kb_id]
+        kb = await asyncio.to_thread(
+            self._build_kb, kb_id, entry.get("collection_name") or kb_id
+        )
+        self._kbs[kb_id] = kb
+        return kb
+
+    def _default_kb_id(self) -> str:
+        """Return the default KB id (created on first use if missing)."""
+        self._load_registry()
+        if DEFAULT_KB_ID in self._registry:
+            return DEFAULT_KB_ID
+        # First real call — create the default KB lazily.
+        return DEFAULT_KB_ID
+
+    async def _ensure_default_kb(self) -> str:
+        kb_id = self._default_kb_id()
+        if kb_id not in self._registry:
+            await self._create_kb(
+                kb_id=kb_id,
+                name="默认知识库",
+                description="",
+                tags=[],
+                collection_name=DEFAULT_COLLECTION_NAME,
+            )
+        return kb_id
+
+    # ------------------------------------------------------------------ #
+    # Public API (consumed by kb_tools)
+    # ------------------------------------------------------------------ #
+    async def _create_kb(
+        self,
+        kb_id: str,
+        name: str,
+        description: str,
+        tags: List[str],
+        collection_name: str,
+    ) -> Dict[str, Any]:
+        """Register a KB entry (internal; use :meth:`create_kb` for tool input)."""
+        async with self._lock:
+            self._load_registry()
+            entry = {
+                "kb_id": kb_id,
+                "name": name or kb_id,
+                "description": description or "",
+                "tags": tags or [],
+                "collection_name": collection_name or kb_id,
+                "created": _dt.datetime.utcnow().isoformat(timespec="seconds") + "Z",
+            }
+            self._registry[kb_id] = entry
+            self._save_registry()
+        return entry
+
+    async def create_kb(
+        self,
+        kb_id: str,
+        name: str = "",
+        description: str = "",
+        tags: Optional[List[str]] = None,
+    ) -> Dict[str, Any]:
+        """Create a new knowledge base with explicit metadata.
+
+        Args:
+            kb_id: KB identifier; doubles as the ChromaDB data dir name under
+                the workspace KB root. Must match ``[A-Za-z0-9_-]{1,64}`` and
+                must not already exist (``biz_kb`` included — the default KB
+                is created implicitly and cannot be re-created).
+            name: Display name; defaults to ``kb_id``.
+            description: Free-form description.
+            tags: Optional tag list.
+
+        Returns:
+            ``{"success": True, ...registry fields}`` on success;
+            ``{"success": False, "error": ...}`` on validation or conflict failure.
+        """
+        error = validate_kb_id(kb_id)
+        if error:
+            return {"success": False, "kb_id": kb_id, "error": error}
+        kb_id = kb_id.strip()
+        if kb_id == DEFAULT_KB_ID:
+            return {
+                "success": False,
+                "kb_id": kb_id,
+                "error": (
+                    f"'{DEFAULT_KB_ID}' is the default KB (created implicitly); "
+                    "use kb_update to edit it or pick another kb_id"
+                ),
+            }
+        async with self._lock:
+            self._load_registry()
+            if kb_id in self._registry:
+                return {
+                    "success": False,
+                    "kb_id": kb_id,
+                    "error": f"Knowledge base already exists: {kb_id}",
+                }
+            entry = {
+                "success": True,
+                "kb_id": kb_id,
+                "name": name or kb_id,
+                "description": description or "",
+                "tags": list(tags or []),
+                "collection_name": kb_id,
+                "created": _dt.datetime.utcnow().isoformat(timespec="seconds") + "Z",
+            }
+            self._registry[kb_id] = entry
+            self._save_registry()
+        return entry
+
+    async def list_kbs(self) -> List[Dict[str, Any]]:
+        """List all registered knowledge bases (without vector stats)."""
+        self._load_registry()
+        return [
+            {
+                "kb_id": e.get("kb_id"),
+                "name": e.get("name"),
