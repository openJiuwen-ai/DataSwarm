+             for t in (tbls.get("tables", []) if isinstance(tbls, dict) else tbls)]
+    assert "fact_orders" in names, names
+    cols = dbc.schema(ref, "fact_orders").get("columns", [])
+    assert cols, "db_connector.schema 返回空列"
