+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""P1-6 回归：warehouse excel 源在 excel 扩展缺失时回退 pandas。
+
+背景：_refresh_views（warehouse 路径）此前对 excel 硬走 read_xlsx，没有
+_prepare 路径的 pandas 回退——离线环境同一 excel 源普通查询能读、物化进
+warehouse 直接失败。修复后两条路径共用 _excel_view（含回退）。
+
+DuckDB 未安装的环境跑不了真实链路，这里用 monkeypatch 把 LOAD excel 打成
+失败，验证 warehouse 连接上走 _register_excel_pandas 回退且视图可查。
+
+跑法：python -m pytest tests/unit/channel/test_duckdb_excel_fallback.py -v
+"""
+from __future__ import annotations
+
+import pytest
+
+pytest.importorskip("duckdb", reason="DuckDB is not installed")
+pytest.importorskip("pandas", reason="pandas is not installed")
+
+from jiuwenswarm.common import db_connector
+from jiuwenswarm.channels.web.dataagent.connectors.duckdb_connector import (
+    close_warehouses,
+)
+
+
+@pytest.fixture()
+def excel_env(tmp_path, monkeypatch):
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path))
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    from jiuwenswarm.common import utils
+
+    monkeypatch.setattr(utils, "_workspace_base_dir", None)
+
+    import pandas as pd
+
+    directory = tmp_path / "xl"
+    directory.mkdir()
+    pd.DataFrame({"id": [1, 2], "amount": [10, 20]}).to_excel(
+        directory / "orders.xlsx", index=False)
+    ref = db_connector.build_file_source_ref("excel", str(directory))
+    yield ref
+    close_warehouses()
+
+
+def _force_excel_ext_unavailable(monkeypatch):
+    """把 LOAD excel 打失败 → _excel_view 走 pandas 回退。"""
+    import duckdb as _duckdb
+
+    real_execute = _duckdb.DuckDBPyConnection.execute
+
+    def _execute(self, sql, *args, **kw):
+        if isinstance(sql, str) and sql.strip() == "LOAD excel":
+            raise RuntimeError("extension not available (simulated offline)")
+        return real_execute(self, sql, *args, **kw)
+
+    monkeypatch.setattr(_duckdb.DuckDBPyConnection, "execute", _execute)
+
+
+def test_warehouse_excel_falls_back_to_pandas(excel_env, monkeypatch):
+    """excel 扩展不可用时，warehouse 路径回退 pandas 注册且查询可用。"""
+    _force_excel_ext_unavailable(monkeypatch)
+    result = db_connector.query(excel_env, 'SELECT COUNT(*) FROM "orders"', limit=1)
+    assert result["rows"] == [[2]]
+
+
+def test_warehouse_excel_pandas_fallback_survives_view_refresh(excel_env, monkeypatch):
+    """回退后再次查询（_refresh_views 重入）不报错——pandas register 幂等覆盖。"""
+    _force_excel_ext_unavailable(monkeypatch)
+    assert db_connector.query(excel_env, 'SELECT COUNT(*) FROM "orders"', limit=1)["rows"] == [[2]]
+    assert db_connector.query(excel_env, 'SELECT SUM(amount) FROM "orders"', limit=1)["rows"] == [[30]]
+
+
+def test_warehouse_excel_ctas_from_fallback_view(excel_env, monkeypatch):
+    """回退视图可物化（ETL CTAS 不因回退断链）。"""
+    _force_excel_ext_unavailable(monkeypatch)
+    db_connector.execute(
+        excel_env,
+        'CREATE OR REPLACE TABLE "dwd_orders" AS SELECT id, amount * 2 AS amt FROM "orders"',
+    )
+    out = db_connector.query(excel_env, 'SELECT * FROM "dwd_orders" ORDER BY id', limit=10)
+    assert out["rows"] == [[1, 20], [2, 40]]
+    db_connector.execute(excel_env, 'DROP TABLE "dwd_orders"')
