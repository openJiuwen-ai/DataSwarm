diff --git a/jiuwenswarm/common/db_connector.py b/jiuwenswarm/common/db_connector.py
new file mode 100644
index 000000000..4a3ee2309
--- /dev/null
+++ b/jiuwenswarm/common/db_connector.py
@@ -0,0 +1,2678 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""公共数据库连接、元数据读取和 SQL 执行入口。
+
+调用方通过 db-ref 指定数据源，可使用 Python API 或本模块 CLI。
+RefCodec 负责解析、连接及元数据差异；uses_pool 区分关系库连接池和自管 I/O。
+SQL 方言由 dialect_registry 提供，只读查询与显式写入使用各自的校验路径。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sqlite3
+import sys
+import threading
+import time
+from pathlib import Path
+from urllib.parse import quote, unquote
+
+from jiuwenswarm.common.ref_codec import (
+    RefCodec,
+    codec_for,
+    quoted_table_identifier,
+    register_ref_codec,
+)
+from jiuwenswarm.common.ref_codec import is_registered as ref_codec_is_registered
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+try:
+    import pymysql
+except ImportError:
+    pymysql = None  # Doris/MySQL 功能在用到时报错
+
+try:
+    from sqlalchemy import create_engine, text
+    from sqlalchemy.engine import Engine
+except ImportError:
+    create_engine = None  # 没装 SQLAlchemy 时降级到直连（每次建连）
+    text = None
+
+for _s in (sys.stdout, sys.stderr):
+    try:
+        _s.reconfigure(encoding="utf-8")
+    except Exception:
+        pass
+
+DEFAULT_LIMIT = 1000
+# limit<=0 时的服务端硬上限（方案 §3.1 G2）：fetch 阶段截断，不拼进 SQL 文本
+# （避免 Doris 聚合查询加 LIMIT 报 parse 错），防无限 fetchall 导致 OOM。
+MAX_QUERY_ROWS = 100_000
+
+
+# ==========================================================================
+# 默认数据源（没传 db_ref 时读 config）
+# ==========================================================================
+# 兼容两个位置：config/ 子目录（规范位）与 ~/.jiuwenswarm/ 根（历史位）。
+# config/ 存在时优先（本地开发可用 sqlite 覆盖 doris）。
+# 根目录经 get_user_workspace_dir 解析：JIUWENSWARM_DATA_DIR 优先
+# （dataswarm_boot / 桌面隔离 / 多实例跟随数据目录），无 env 时回退 ~/.jiuwenswarm。
+def _datasource_config_path() -> Path:
+    home = get_user_workspace_dir()
+    for cand in (home / "config" / "datasource.yaml", home / "datasource.yaml"):
+        if cand.is_file():
+            return cand
+    return home / "config" / "datasource.yaml"
+
+
+_DATASOURCE_CONFIG = _datasource_config_path()
+
+
+def env_orch_db_ref() -> str | None:
+    """读环境变量 JIUWENSWARM_ORCH_DB（编排元数据库 legacy sqlite 覆盖）。
+
+    供 workspace_context.current_workspace() 的 legacy 优先级使用：
+    env 指向本地 sqlite 文件时，整个编排后端走 sqlite，不参与多工作空间解析。
+    """
+    env = os.environ.get("JIUWENSWARM_ORCH_DB", "").strip()
+    if not env:
+        return None
+    return env if "://" in env else f"sqlite://{env}"
+
+
+def default_db_ref() -> str | None:
+    """读 ~/.jiuwenswarm/config/datasource.yaml 的 default_db 字段。返回 db-ref 或 None。"""
+    if not _DATASOURCE_CONFIG.is_file():
+        return None
+    try:
+        for line in _DATASOURCE_CONFIG.read_text(encoding="utf-8").splitlines():
+            line = line.split("#", 1)[0].rstrip()
+            m = re.match(r"^default_db\s*:\s*(.+)$", line.strip())
+            if m:
+                return m.group(1).strip().strip('"').strip("'")
+    except OSError:
+        pass
+    return None
+
+
+def metadata_db_ref(workspace_id: str | None = None) -> str | None:
+    """读 config 的 metadata_db 字段（系统元数据库）。返回 db-ref 或 None。
+
+    与 default_db_ref() 对称：default_db 指业务库，metadata_db 指系统元数据库
+    （唯一一套 dw_* 表）。上层 skill 读它后传给底层 skill。
+    """
+    if workspace_id:
+        from . import workspace_context
+
+        return workspace_context.metadata_db_ref(workspace_id)
+    if not _DATASOURCE_CONFIG.is_file():
+        return None
+    try:
+        for line in _DATASOURCE_CONFIG.read_text(encoding="utf-8").splitlines():
+            line = line.split("#", 1)[0].rstrip()
+            m = re.match(r"^metadata_db\s*:\s*(.+)$", line.strip())
+            if m:
+                return m.group(1).strip().strip('"').strip("'")
+    except OSError:
+        pass
+    return None
+
+
+def business_db_ref(workspace_id: str | None = None) -> str | None:
+    """Return the business database ref for a workspace.
+
+    The no-argument form is the legacy ``default_db`` lookup.  Supplying a
+    workspace id routes through the single workspace-context parser.
+    """
+    if workspace_id:
+        from . import workspace_context
+
+        return workspace_context.business_db_ref(workspace_id)
+    return default_db_ref()
+
+
+def _read_config_section(section: str) -> dict:
+    """读 config 的 doris:/mysql: 段，返回 {host,port,user,password,database}。
+
+    简单 YAML 解析（缩进 key: value），不引 PyYAML。section 缺失返回 {}。
+    """
+    if not _DATASOURCE_CONFIG.is_file():
+        return {}
+    out: dict = {}
+    in_section = False
+    try:
+        for line in _DATASOURCE_CONFIG.read_text(encoding="utf-8").splitlines():
+            raw = line.split("#", 1)[0].rstrip()
+            if not raw.strip():
+                continue
+            stripped = raw.lstrip()
+            indent = len(raw) - len(stripped)
+            # 顶层 key（无缩进）：section 开始/结束标记
+            if indent == 0:
+                in_section = stripped.startswith(f"{section}:")
+                continue
+            if not in_section:
+                continue
+            m = re.match(r"^(\w+)\s*:\s*(.*)$", stripped)
+            if m:
+                k, v = m.group(1), m.group(2).strip()
+                if v:
+                    out[k] = v.strip("'").strip('"')
+    except OSError:
+        pass
+    # 类型转换
+    if "port" in out:
+        try:
+            out["port"] = int(out["port"])
+        except ValueError:
+            pass
+    return out
+
+
+def _resolve_db_ref(db_ref: str | None) -> str:
+    """db_ref 为空时读 config 默认，再没有报错。"""
+    if db_ref:
+        return db_ref
+    configured = default_db_ref()
+    if configured:
+        return configured
+    raise ValueError(
+        "db_ref 为空且 ~/.jiuwenswarm/config/datasource.yaml 未配置 default_db"
+    )
+
+
+# ==========================================================================
+# db-ref 解析
+# ==========================================================================
+_SOURCE_CREDS_CACHE: dict[tuple[str, str, str, int, str], dict] = {}
+
+
+def _credential_scope() -> str:
+    """Return the workspace identity that owns credential lookup/cache entries."""
+    try:
+        from . import workspace_context
+
+        return workspace_context.current_workspace().workspace_id
+    except Exception:
+        return ""
+
+
+def _lookup_source_credentials(db_type: str, host: str, port: int, database: str) -> dict:
+    """工作空间元库 dw_datasources 表按连接四元组查 UI 源的独立凭据。
+
+    UI 建的源（工作空间元库 dw_datasources 表）各带一套 user/password，与全局
+    doris: 段无关；完整 db-ref（doris://host:port/db）原本凭据为空，这里补齐后
+    Engine URL 才能带认证。正/负结果均入进程内缓存（CRUD 后失效），避免每次
+    parse 都遍历空间元库查库。
+    """
+    scope = _credential_scope()
+    key = (scope, db_type, host, port, database)
+    if key in _SOURCE_CREDS_CACHE:
+        return _SOURCE_CREDS_CACHE[key]
+    # 懒导入避免环：db_connector ← datasource.store ← orchestration.db ← workspace_context ← db_connector
+    from jiuwenswarm.channels.web.dataagent.datasource import store as _ds_store
+
+    creds = _ds_store.find_credentials(
+        db_type, host, port, database, workspace_id=scope or None
+    )
+    _SOURCE_CREDS_CACHE[key] = creds
+    return creds
+
+
+def invalidate_source_credentials_cache() -> None:
+    """UI 数据源 CRUD 后清缓存（datasource service 调用，保证凭据立即生效）。
+
+    同时 dispose 全部池化关系库 Engine：完整形态 ref 的 Engine URL 在建池时
+    已固化了凭据，只清凭据缓存不改池，旧连接会继续用旧凭据直至被 recycle。
+    """
+    _SOURCE_CREDS_CACHE.clear()
+    for key, eng in list(_ENGINES.items()):
+        if "|rw" not in key and "|ro" not in key:
+            continue
+        try:
+            ref = key.rsplit("|", 1)[0]
+            if codec_for(parse_db_ref(ref)["type"]).uses_pool:
+                _ENGINES.pop(key, None)
+                eng.dispose()
+        except Exception:
+            pass
+
+
+# ==========================================================================
+# duckdb:// 文件源 ref（CSV/Excel 等文件数据源，DuckDB 引擎）
+# ==========================================================================
+def _duckdb_table_name(source_type: str, location: str) -> str:
+    """location → 合法 VIEW 名（与 DuckDBConnector._prepare 校验一致）。
+
+    单文件取 stem（orders.csv → orders）；目录/S3 取 data。
+    非法标识符（数字开头/特殊字符）回退 data，保证 ref 稳定可比较。
+    目录场景此值仅作 ref 兼容字段——csv 目录的实际视图集由
+    DuckDBConnector._datasets() 实时 glob 决定（每文件一视图）。
+    """
+    name = ""
+    if "://" not in location:
+        name = Path(location).stem
+    name = re.sub(r"[^A-Za-z0-9_]", "", name or "")
+    if not name or not name[0].isalpha():
+        return "data"
+    return name
+
+
+def build_file_source_ref(source_type: str, location: str, table_name: str | None = None) -> str:
+    """构造 duckdb:// 文件源 ref。
+
+    格式：duckdb://<quoted-location>?source_type=csv&table_name=x
+    location 编码用 quote(safe=":/\\")——Windows 盘符、目录、s3:// 嵌套、
+    中文/空格均安全往返。解析见 _parse_duckdb_ref（不用 urlparse，防 D: 被当 netloc）。
+    """
+    source_type = str(source_type or "").strip().lower()
+    location = str(location or "").strip()
+    if not source_type:
+        raise ValueError("source_type is required for file source ref")
+    if not location:
+        raise ValueError("location is required for file source ref")
+    table = str(table_name or "").strip() or _duckdb_table_name(source_type, location)
+    safe = ":/\\"
+    return (
+        f"duckdb://{quote(location, safe=safe)}"
+        f"?source_type={quote(source_type)}&table_name={quote(table)}"
+    )
+
+
+def _parse_duckdb_ref(rest: str) -> dict:
+    """duckdb ref 的 rest → spec。rest 形如 <quoted-location>?source_type=csv&table_name=x。
+
+    query 用首个 '?' 切分（location 内 '?' 已被 quote 转义成 %3F，不会误切）。
+    database 字段 = location 文件/目录名，供 _dao_db_name /
+    validate_business_database_name / 前端 /databases/{db_name} 对齐。
+    """
+    raw_location, _, query_part = rest.partition("?")
+    params: dict[str, str] = {}
+    if query_part:
+        for pair in query_part.split("&"):
+            key, _, value = pair.partition("=")
+            if key:
+                params[key] = unquote(value)
+    location = unquote(raw_location)
+    source_type = params.get("source_type") or "csv"
+    table_name = params.get("table_name") or _duckdb_table_name(source_type, location)
+    if not location:
+        raise ValueError("duckdb:// ref 缺少 location")
+    return {
+        "type": "duckdb",
+        "location": location,
+        "source_type": source_type,
+        "table_name": table_name,
+        "database": Path(location).name,
+    }
+
+
+# ==========================================================================
+# db-ref codec
+# ==========================================================================
+# 解析、连接及元数据接口统一委托 codec，避免新增类型在不同治理入口被误路由。
+
+
+@register_ref_codec
+class SqliteRefCodec(RefCodec):
+    """sqlite：单文件库，无凭据。"""
+
+    scheme = "sqlite"
+    dialect = "sqlite"
+
+    def decode(self, rest: str, db_ref: str) -> dict:
+        # sqlite://path/to/x.db → rest 是路径。
+        # Windows 绝对路径形如 sqlite:///D:/job/... 时 rest='/D:/...'，
+        # Path('/D:/...') 在 Windows 解析为相对路径 D:job（吞斜杠）→ 规整成 D:/...。
+        if len(rest) >= 3 and rest[0] == "/" and rest[2] == ":":
+            rest = rest[1:]
+        # 保留子类 scheme，供下游按真实类型路由。
+        return {"type": self.scheme, "path": rest}
+
+    def engine_url(self, spec: dict, read_only: bool) -> str:
+        p = Path(spec["path"]).expanduser().resolve()
+        # SQLAlchemy sqlite URL：三斜杠 + 绝对路径（Windows 盘符 D:/... 也合法）。
+        # 用 str(p).replace('\\','/') 规整，避免 as_posix() 在 Windows 绝对盘符路径上吞斜杠。
+        path_str = str(p).replace("\\", "/")
+        url = f"sqlite:///{path_str}"
+        if read_only:
+            # SQLite readonly via query param（SQLAlchemy sqlite dialect 支持 mode=ro）
+            url = f"{url}?mode=ro"
+        return url
+
+    def connect_direct(self, spec: dict, read_only: bool):
+        p = Path(spec["path"]).expanduser().resolve()
+        if read_only:
+            uri = f"file:{p.as_posix()}?mode=ro"
+            conn = sqlite3.connect(uri, uri=True, timeout=30)
+        else:
+            conn = sqlite3.connect(str(p), timeout=30)
+        conn.row_factory = sqlite3.Row
+        return conn, {"type": "sqlite", "path": str(p), "read_only": read_only}
+
+    def tables_sql(self) -> str:
+        return (
+            "SELECT name FROM sqlite_master WHERE type='table' "
+            "AND name NOT LIKE 'sqlite_%' ORDER BY name"
+        )
+
+    def describe_sql(self, table: str) -> str:
+        return f'PRAGMA table_info("{table}")'
+
+    def map_columns(self, rows) -> list[dict]:
+        # PRAGMA table_info: cid, name, type, notnull, dflt_value, pk
+        return [
+            {"name": r[1], "type": r[2], "null": r[3] == 1, "pk": bool(r[5])}
+            for r in rows
+        ]
+
+    def read_indexes(self, cur, table: str) -> list[dict]:
+        indexes: list[dict] = []
+        cur.execute(f'PRAGMA index_list("{table}")')
+        for idx in cur.fetchall():
+            idx_name = idx[1]
+            unique = idx[2] == 1
+            cur.execute(f'PRAGMA index_info("{idx_name}")')
+            # PRAGMA index_info: (seqno, cid, name) — name 在 index 2
+            cols = [r[2] for r in cur.fetchall()]
+            indexes.append({"name": idx_name, "columns": cols, "unique": unique})
+        return indexes
+
+    def read_create_sql(self, cur, table: str) -> str:
+        cur.execute(
+            "SELECT sql FROM sqlite_master WHERE type='table' AND name=?", (table,)
+        )
+        row = cur.fetchone()
+        return row[0] if row else ""
+
+    def post_connect(self, conn, read_only: bool) -> None:
+        conn.row_factory = sqlite3.Row
+
+
+class _MySQLProtocolRefCodec(RefCodec):
+    """MySQL 线协议族基类。
+
+    族成员只需声明 scheme / dialect / 默认端口 / 环境变量前缀——
+    同族引擎通过 scheme、默认端口和环境变量前缀复用连接逻辑。
+    """
+
+    dialect = "mysql"
+    default_port = 3306
+    env_prefix = "MYSQL"
+    #: config 段名；缺省与 scheme 同名。
+    config_section = ""
+
+    @property
+    def section(self) -> str:
+        return self.config_section or self.scheme
+
+    def decode(self, rest: str, db_ref: str) -> dict:
+        # <scheme>://host:port/db 或 <scheme>://（空 rest 用 config 段补全，没有再读环境变量）
+        # <scheme>://dbname（无 / 无 :）：指针自带库名，凭据仍从 config 段读
+        # <scheme>://meta 特殊标记：用 config 的 metadata_database 而非 database（同集群不同 schema）
+        scheme = self.scheme
+        meta_flag = rest.strip() == "meta"
+        body = "" if meta_flag else rest
+        if not body or "/" not in body:
+            # 1. config 的对应段（固定配置，优先）
+            cfg = _read_config_section(self.section)
+            # 2. 环境变量补全
+            prefix = self.env_prefix
+            host = cfg.get("host") or os.environ.get(f"{prefix}_HOST", "")
+            port = (
+                cfg.get("port")
+                or int(os.environ.get(f"{prefix}_PORT", "0") or 0)
+                or self.default_port
+            )
+            user = cfg.get("user") or os.environ.get(f"{prefix}_USER", "")
+            password = cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", "")
+            # meta 标记用 metadata_database；指针自带库名（body 非空）用 body；
+            # 空指针 <scheme>:// 用 config database
+            if meta_flag:
+                database = cfg.get("metadata_database") or os.environ.get(
+                    f"{prefix}_METADATA_DATABASE", ""
+                )
+                if not database:
+                    raise ValueError(
+                        f"{scheme}://meta 需 config {self.section}.metadata_database 配置元数据库 schema"
+                    )
+            elif body:
+                database = body
+            else:
+                database = cfg.get("database") or os.environ.get(
+                    f"{prefix}_DATABASE", ""
+                )
+            if not host:
+                raise ValueError(
+                    f"{scheme}:// 需 config {self.section}: 段 或环境变量 {prefix}_HOST，或完整 db-ref"
+                )
+            return {
+                "type": scheme,
+                "host": host,
+                "port": int(port) if port else self.default_port,
+                "user": user,
+                "password": password,
+                "database": database,
+                "is_metadata": meta_flag,
+            }
+        # host:port/db
+        host_port, _, db = body.partition("/")
+        host, _, port = host_port.partition(":")
+        resolved_port = int(port) if port else self.default_port
+        spec = {
+            "type": scheme,
+            "host": host,
+            "port": resolved_port,
+            "user": "",
+            "password": "",
+            "database": db,
+        }
+        # UI 管理的源（sources: 段）：完整 ref 凭据为空，按连接四元组匹配补齐
+        creds = _lookup_source_credentials(scheme, host, resolved_port, db)
+        if creds:
+            spec.update(creds)
+        return spec
+
+    def engine_url(self, spec: dict, read_only: bool) -> str:
+        from urllib.parse import quote_plus
+
+        user = spec.get("user") or ""
+        pwd = spec.get("password") or ""
+        if not user:
+            # 与 connect_direct 的 pymysql 直连路径同源兜底：spec 未带凭据时从
+            # config 段 + env（DORIS_USER/MYSQL_USER 等）补齐。否则 URL 无 auth
+            # 段，pymysql 回退当前系统用户名 → Access denied（2026-10-10 MySQL
+            # 元库 e2e 实测：user='ZhuanZ1' 被拒）。
+            resolved = _resolve_mysql_env(spec, default_prefix=self.env_prefix)
+            user = resolved.get("user") or ""
+            pwd = resolved.get("password") or ""
+        auth = f"{quote_plus(user, safe='')}:{quote_plus(pwd, safe='')}@" if user else ""
+        host = spec.get("host", "")
+        port = spec.get("port") or self.default_port
+        db = spec.get("database") or ""
+        return f"mysql+pymysql://{auth}{host}:{port}/{db}?charset=utf8mb4"
+
+    def connect_direct(self, spec: dict, read_only: bool):
+        if pymysql is None:
+            raise ImportError("pymysql 未安装，请 uv pip install pymysql")
+        a = _resolve_mysql_env(spec, default_prefix=self.env_prefix)
+        conn = pymysql.connect(**a)
+        return conn, {"type": spec["type"], **{k: v for k, v in a.items() if k != "password"}}
+
+    def tables_sql(self) -> str:
+        return "SHOW TABLES"
+
+    def describe_sql(self, table: str) -> str:
+        return f"DESCRIBE `{table}`"
+
+    def map_columns(self, rows) -> list[dict]:
+        # Doris/MySQL DESCRIBE: Field/Type/Null/Key/Default/Extra
+        #
+        # ``pk`` 必须显式给出：下游 knowledge/schema_candidates._is_pk 读的是
+        # ``pk``，只回 ``key`` 的话 MySQL/Doris 源的主键列恒判为非主键，会漏进
+        # 术语候选（Doris 是已放开类型，这是实打实的线上行为）。``key`` 保留，
+        # 既有读它的调用点不受影响。
+        return [
+            {
+                "name": r[0],
+                "type": r[1],
+                "null": r[2] == "YES",
+                "key": r[3],
+                "pk": str(r[3] or "").upper() == "PRI",
+            }
+            for r in rows
+        ]
+
+    def read_indexes(self, cur, table: str) -> list[dict]:
+        cur.execute(f"SHOW INDEX FROM {quoted_table_identifier(table, self.dialect)}")
+        seen: dict[str, dict] = {}
+        for r in cur.fetchall():
+            idx_name = r[2]  # Key_name
+            col = r[4]  # Column_name
+            non_unique = r[1]  # Non_unique
+            if idx_name not in seen:
+                seen[idx_name] = {
+                    "name": idx_name,
+                    "columns": [],
+                    "unique": not non_unique,
+                }
+            seen[idx_name]["columns"].append(col)
+        return list(seen.values())
+
+    def read_create_sql(self, cur, table: str) -> str:
+        cur.execute(f"SHOW CREATE TABLE {quoted_table_identifier(table, self.dialect)}")
+        row = cur.fetchone()
+        # SHOW CREATE TABLE: (Table, Create Table)；单列返回时退回 row[0]
+        # （保留原实现的兜底，Doris 某些版本只回一列）
+        if not row:
+            return ""
+        return row[1] if len(row) > 1 else row[0]
+
+
+@register_ref_codec
+class MySQLRefCodec(_MySQLProtocolRefCodec):
+    scheme = "mysql"
+
+
+@register_ref_codec
+class DorisRefCodec(_MySQLProtocolRefCodec):
+    scheme = "doris"
+    dialect = "doris"
+    default_port = 9030
+    env_prefix = "DORIS"
+
+    def session_setup(self, cur, read_only: bool) -> None:
+        if read_only:
+            return
+        # Doris 严格插入模式下单行类型不匹配会整批失败；编排写入放宽为非严格。
+        cur.execute("SET enable_insert_strict = false")
+
+
+class _PostgresProtocolRefCodec(RefCodec):
+    """PostgreSQL 协议族的连接和元数据实现。
+
+    子类声明 scheme、默认端口和环境变量前缀；Hologres 复用该协议路径，
+    其原厂目录与认证差异仍需独立验收。
+    """
+
+    dialect = "postgres"
+    default_port = 5432
+    env_prefix = "POSTGRES"
+    config_section = ""
+
+    @property
+    def section(self) -> str:
+        return self.config_section or self.scheme
+
+    def decode(self, rest: str, db_ref: str) -> dict:
