+
+class _SentinelCalled(Exception):
+    """哨兵：证明流程推进到了被标记的调用点。"""
+
+
+@pytest.fixture()
+def _plan_env(monkeypatch):
+    """validate_plan 前置依赖打桩：workspace / 候选复验 / scope 重建。"""
+    monkeypatch.setattr(service.workspace_context, "current_workspace",
+                        lambda: SimpleNamespace(workspace_id="ws-test"))
+    monkeypatch.setattr(service.semantic_link, "current_snapshots",
+                        lambda warnings: ({}, {}))
+
+
+def test_open_plan_rejected_when_switch_off(monkeypatch, _plan_env):
+    """开关关 + mode=open → ok=False / field=mode，且 build_context 未被调用。"""
+    monkeypatch.setattr(service, "get_open_analysis_enabled", lambda: False)
+
+    def _boom(*_a, **_k):
+        raise AssertionError("开关关时不应重建素材池（build_context）")
+
+    monkeypatch.setattr(service, "build_context", _boom)
+    result = service.validate_plan({"mode": "open", "question": "经营复盘",
+                                    "components": []})
+    assert result["validation"]["ok"] is False
+    assert result["plan"] is None
+    errors = result["validation"]["errors"]
+    assert errors[0]["field"] == "mode"
+    assert "开放分析未启用" in errors[0]["message"]
+    assert "mode=closed" in errors[0]["message"]
+
+
+def test_open_plan_passes_gate_when_switch_on(monkeypatch, _plan_env):
+    """开关开 + mode=open → 闸门放行，流程进入 build_context（素材池重建）。"""
+    monkeypatch.setattr(service, "get_open_analysis_enabled", lambda: True)
+
+    def _mark(*_a, **_k):
+        raise _SentinelCalled()
+
+    monkeypatch.setattr(service, "build_context", _mark)
+    with pytest.raises(_SentinelCalled):
+        service.validate_plan({"mode": "open", "question": "经营复盘",
+                               "components": []})
+
+
+def test_closed_plan_unaffected_by_switch_off(monkeypatch, _plan_env):
+    """开关关 + mode=closed（缺省同）→ 不触发 mode 闸门，走正常校验。"""
+    monkeypatch.setattr(service, "get_open_analysis_enabled", lambda: False)
+    monkeypatch.setattr(service.plan_module, "parse_and_validate",
+                        lambda payload, verified, scope_tables, material_ids=None:
+                        (None, []))
+    for payload in ({"mode": "closed", "question": "上月 GMV", "components": []},
+                    {"question": "上月 GMV", "components": []}):
+        result = service.validate_plan(payload)
+        messages = [e.get("message", "") for e in result["validation"]["errors"]]
+        assert all("开放分析未启用" not in m for m in messages), payload
