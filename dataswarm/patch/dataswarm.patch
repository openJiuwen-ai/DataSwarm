+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { TaskListPage } from './components/TaskListPage';
+import { WorkflowListPage } from './components/WorkflowListPage';
+import { WorkflowEditPage } from './components/WorkflowEditPage';
+import { InstanceListPage } from './components/InstanceListPage';
+import './components/shared/dataAsset.css';
+import './components/dataDevelopment.css';
+import { useDatasourceWorkspaceStore } from '../../stores/datasourceWorkspaceStore';
+
+import {
+  useDevelopmentRoute,
+  navigateDevelopment,
+  backToDevelopment,
+  setDevelopmentRefFilter,
+  navigateWorkflow,
+  backToWorkflowHome,
+} from './developmentRoute';
+
+export function DataAssetApp() {
+  const { page, workflowId: editingWorkflowId, taskId: editTaskTarget, refId, tab, instanceId } = useDevelopmentRoute();
+  const workspaceId = useDatasourceWorkspaceStore((state) => state.currentWorkspaceId);
+  const showRuns = (id: string, instance?: string) => navigateWorkflow(id, 'runs', instance);
+  const showTaskRuns = (ref: string) => navigateDevelopment('task-runs', { ref });
+  return (
+    <div className="da-shell">
+      <main className="da-main" key={workspaceId}>
+        {editingWorkflowId ? (
+          <WorkflowEditPage
+            key={editingWorkflowId}
+            workflowId={editingWorkflowId}
+            tab={tab}
+            instanceId={instanceId}
+            onTabChange={(next) => navigateWorkflow(editingWorkflowId, next, instanceId ?? undefined)}
+            onSelectInstance={(id, replace) => navigateWorkflow(editingWorkflowId, 'runs', id, replace)}
+            onBack={backToWorkflowHome}
+            onShowRuns={showRuns}
+          />
+        ) : (
+          <div className="da-content dd-page-content">
+            {(page === 'workflow-mgmt' || page === 'workflow-runs') && (
+              <WorkflowListPage onEdit={(id) => navigateWorkflow(id)} onShowRuns={showRuns} />
+            )}
+            {page === 'task-mgmt' && (
+              <TaskListPage
+                initialEditTaskId={editTaskTarget}
+                onShowRuns={showTaskRuns}
+                onCloseTarget={() => backToDevelopment('task-mgmt')}
+              />
+            )}
+            {page === 'task-runs' && (
+              <InstanceListPage refType="task" filterRefId={refId} onFilterRefChange={setDevelopmentRefFilter} />
+            )}
+          </div>
+        )}
+      </main>
+      {/* toast/确认框宿主已上提 App 主区统一挂载（_shared/ui/Feedback） */}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/api/orchestrationApi.ts b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/api/orchestrationApi.ts
