+async def test_sticky_binding_is_keyed_by_session(kb_workspace):
+    """Concurrent supervisor tasks must resolve their own session binding."""
+    first = os.path.join(kb_workspace, "proj-first")
+    second = os.path.join(kb_workspace, "proj-second")
+    os.makedirs(first, exist_ok=True)
+    os.makedirs(second, exist_ok=True)
+    token_a = kb_tools.bind_kb_workspace(first, session_id="sess-a")
+    kb_tools.reset_kb_workspace(token_a)
+    token_b = kb_tools.bind_kb_workspace(second, session_id="sess-b")
+    kb_tools.reset_kb_workspace(token_b)
+
+    # Simulate the supervisor restoring each session's identity before running
+    # its tool callback; no global last-request value may be consulted.
+    token_a = kb_tools._KB_WORKSPACE_SESSION_ID.set("sess-a")
+    try:
+        assert kb_tools._current_binding() == first
+    finally:
+        kb_tools._KB_WORKSPACE_SESSION_ID.reset(token_a)
+    token_b = kb_tools._KB_WORKSPACE_SESSION_ID.set("sess-b")
+    try:
+        assert kb_tools._current_binding() == second
+    finally:
+        kb_tools._KB_WORKSPACE_SESSION_ID.reset(token_b)
+
+
+def test_sticky_binding_evicts_least_recently_used_sessions(monkeypatch):
+    monkeypatch.setattr(kb_tools._StickyKBWorkspace, "_MAX_SESSIONS", 2)
+    sticky = kb_tools._StickyKBWorkspace
+
+    sticky.set("/first", "sess-first", invalid=True)
+    sticky.set("/second", "sess-second")
+    assert sticky.get("sess-first") == "/first"  # refresh first
+    sticky.set("/third", "sess-third")
+
+    assert sticky.get("sess-first") == "/first"
+    assert sticky.get("sess-second") is None
+    assert sticky.get("sess-third") == "/third"
+    assert sticky.is_invalid("sess-first") is True
+    assert sticky.is_invalid("sess-second") is False
