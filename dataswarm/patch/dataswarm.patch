index 000000000..7230845fa
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/components/ChatPanel/chatScrollPosition.ts
@@ -0,0 +1,51 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** A reading position in the retained timeline, independent of its hidden size. */
+export interface ChatScrollPosition {
+  scrollTop: number;
+  atBottom: boolean;
+  anchor: HTMLElement | null;
+  offset: number;
+}
+
+// Layout offsets exclude the translateY animation replayed when a hidden
+// message becomes visible. Bounding rectangles would add that animation to
+// the saved reading position on every menu round trip.
+function layoutTop(element: HTMLElement): number {
+  let top = 0;
+  let current: HTMLElement | null = element;
+  while (current) {
+    top += current.offsetTop;
+    const parent = current.offsetParent as HTMLElement | null;
+    top += parent?.clientTop ?? 0;
+    current = parent;
+  }
+  return top;
+}
+
+export function captureChatScrollPosition(container: HTMLElement, atBottom: boolean): ChatScrollPosition {
+  const top = layoutTop(container) + container.clientTop;
+  const items = container.querySelector('[data-testid="chat-panel-timeline"]')?.children;
+  const anchor = items
+    ? (Array.from(items).find(
+        (item): item is HTMLElement =>
+          item instanceof HTMLElement && layoutTop(item) + item.offsetHeight > top + container.scrollTop,
+      ) ?? null)
+    : null;
+  return {
+    scrollTop: container.scrollTop,
+    atBottom,
+    anchor,
+    offset: anchor ? layoutTop(anchor) - top - container.scrollTop : 0,
+  };
+}
+
+export function restoreChatScrollPosition(container: HTMLElement, position: ChatScrollPosition): void {
+  if (position.atBottom) {
+    container.scrollTop = Math.max(0, container.scrollHeight - container.clientHeight);
+  } else if (position.anchor && container.contains(position.anchor)) {
+    container.scrollTop = layoutTop(position.anchor) - layoutTop(container) - container.clientTop - position.offset;
+  } else {
+    // An empty timeline or a removed anchor retains the absolute reading offset.
+    container.scrollTop = position.scrollTop;
+  }
+}
