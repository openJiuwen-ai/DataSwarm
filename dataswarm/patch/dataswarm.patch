+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""StreamLoadExecutor 单测（方案批次 3 §7.4：Stream Load 任务化收口）。
+
+新功能档 TDD：executor_type="stream_load" 的执行器——服务端进程内执行数据面搬运，
+参数进 params_json：{file_path, target_db, target_table, columns?, label?}。
+
+导入路径（对齐 csv_importer 的 CSV_IMPORT_METHOD 契约，R1 风险项裁决）：
+  - 默认 MySQL Load：FE(9030) LOAD DATA LOCAL INFILE（SelectDB 托管实例 BE 8040
+    不对公网开放，直连会超时）——本地 SQL 语句用 fake 连接验证
+  - CSV_IMPORT_METHOD=stream_load：直连 BE 8040 HTTP PUT（requests monkeypatch）
+
+覆盖：
+  - file_path 校验（文件不存在拒绝）
+  - 成功导入 → TaskRunResult(status=success, result_summary 带 label/rows/method)
+  - 拒绝/异常 → failed + error_message
+  - 幂等 label：默认 {task_id}_{instance_id} 派生，显式 label 透传
+  - executors 注册表：get_executor("stream_load") 可取
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.orchestration.executors import base as exec_base
+from jiuwenswarm.channels.web.orchestration.executors import stream_load_executor as sle
+
+
+class _FakeResp:
+    def __init__(self, status=200, payload=None):
+        self.status_code = status
+        self._payload = payload or {"Status": "Success", "NumberLoadedRows": 42}
+
+    def json(self):
+        return self._payload
+
+
+class _FakeCursor:
+    def __init__(self, conn, rowcount=42):
+        self._conn = conn
+        self.rowcount = rowcount
+        self.executed: list[str] = []
+
+    def execute(self, sql):
+        self.executed.append(sql)
+        self._conn.executed.append(sql)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+
+class _FakeConn:
+    """pymysql 连接替身：记录执行的 SQL，rowcount 可控。"""
+
+    def __init__(self, rowcount=42, error: Exception | None = None):
+        self.executed: list[str] = []
+        self._rowcount = rowcount
+        self._error = error
+        self.closed = False
+
+    def cursor(self):
+        if self._error is not None:
+            raise self._error
+        return _FakeCursor(self, self._rowcount)
+
+    def commit(self):
+        pass
+
+    def close(self):
+        self.closed = True
+
+
