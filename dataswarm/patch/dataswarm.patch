+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""deploy/schema/ddl 双方言一致性单测。
+
+保证 sqlite/mysql 两份 DDL 的列名集合一致（findings 的 llm_* 列、runs 的 workspace_id），
+并校验 inspection_service 的 INSERT 列清单与 DDL 逐列对齐。
+"""
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+_REPO_ROOT = Path(__file__).resolve().parents[3]
+_DDL_DIR = _REPO_ROOT / "deploy" / "schema" / "ddl"
+
+
+def _parse_columns(sql: str) -> set[str]:
+    """提取 CREATE TABLE 括号内的列名（含反引号/双引号包裹的）。"""
+    match = re.search(r"CREATE TABLE[^(]*\((.+)\)", sql, re.S)
+    assert match, "CREATE TABLE 括号未找到"
+    body = match.group(1)
+    # 去掉尾部 DISTRIBUTED BY/PROPERTIES 等（Doris 在括号内只到列定义）
+    body = body.split("ENGINE=")[0]
+    cols = set()
+    for line in body.splitlines():
+        line = line.strip().rstrip(",")
+        if line.upper().startswith(("PRIMARY", "UNIQUE", "KEY", "DISTRIBUTED", "PROPERTIES")):
+            continue
+        m = re.match(r'[`"]?([A-Za-z_][A-Za-z0-9_]*)', line)
+        if m:
+            cols.add(m.group(1))
+    return cols
+
+
+def test_findings_ddl_both_dialects_have_review_columns():
+    sqlite = (_DDL_DIR / "dw_inspection_findings.ddl.sqlite.sql").read_text(encoding="utf-8")
+    mysql = (_DDL_DIR / "dw_inspection_findings.ddl.mysql.sql").read_text(encoding="utf-8")
+    s_cols = _parse_columns(sqlite)
+    m_cols = _parse_columns(mysql)
+    assert "llm_verdict" in s_cols and "llm_reason" in s_cols
+    assert "llm_verdict" in m_cols and "llm_reason" in m_cols
+
+
+def test_findings_ddl_dialect_column_sets_match():
+    """sqlite/mysql 双方言列名集合一致（除主键/引擎差异，列本身应同集合）。"""
+    sqlite = (_DDL_DIR / "dw_inspection_findings.ddl.sqlite.sql").read_text(encoding="utf-8")
+    mysql = (_DDL_DIR / "dw_inspection_findings.ddl.mysql.sql").read_text(encoding="utf-8")
+    s_cols = _parse_columns(sqlite)
+    m_cols = _parse_columns(mysql)
+    # PRIMARY KEY 行已被 _parse_columns 过滤
+    assert s_cols == m_cols, f"双方言列不一致: 仅sqlite={s_cols - m_cols} 仅mysql={m_cols - s_cols}"
+
+
+def test_runs_ddl_dialect_column_sets_match():
+    """dw_inspection_runs 双方言列名集合一致（含状态真相源所需的 workspace_id）。"""
+    sqlite = (_DDL_DIR / "dw_inspection_runs.ddl.sqlite.sql").read_text(encoding="utf-8")
+    mysql = (_DDL_DIR / "dw_inspection_runs.ddl.mysql.sql").read_text(encoding="utf-8")
+    s_cols = _parse_columns(sqlite)
+    m_cols = _parse_columns(mysql)
+    assert "workspace_id" in s_cols and "workspace_id" in m_cols
+    assert s_cols == m_cols, f"双方言列不一致: 仅sqlite={s_cols - m_cols} 仅mysql={m_cols - s_cols}"
+
+
+def test_runs_columns_constant_covers_ddl_columns():
+    """inspection_service.RUNS_COLUMNS 与 DDL 列集合逐列对齐。
+
+    漏列会静默丢字段，多列/错序会让 INSERT 直接失败——真库集成测试跑之前先在这挡住。
+    """
+    from jiuwenswarm.channels.web import inspection_service as svc
+
+    sqlite = (_DDL_DIR / "dw_inspection_runs.ddl.sqlite.sql").read_text(encoding="utf-8")
+    code_cols = {c.strip("`") for c in svc.RUNS_COLUMNS.split(",")}
+    ddl_cols = set(re.findall(r'"(\w+)"\s+(?:TEXT|VARCHAR|STRING)', sqlite))
+    assert code_cols == ddl_cols, f"代码列与 DDL 不一致: 仅代码={code_cols - ddl_cols} 仅 DDL={ddl_cols - code_cols}"
