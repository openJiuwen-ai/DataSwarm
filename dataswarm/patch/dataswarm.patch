@@ -0,0 +1,252 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { RefreshCw } from 'lucide-react';
+import { orchestrationApi } from '../api/orchestrationApi';
+import type { TaskDefinition } from '../types/orchestration';
+import { useListControls, useListQuery } from '../hooks/useListQuery';
+import { confirmDialog, toast, useAction } from './shared/Ui';
+import { ExecutorTag, HifiButton, HifiStatus, IconButton, LinkAction, SearchBox } from './shared/Hifi';
+import { RowMenu } from './shared/RowMenu';
+import { Table } from '../../../components/ui/Table/Table';
+import { Pagination } from '../../../components/ui/Pagination/Pagination';
+import { TaskEditDrawer } from './TaskEditDrawer';
+
+export function TaskListPage({
+  initialEditTaskId,
+  onShowRuns,
+  onCloseTarget,
+}: {
+  initialEditTaskId?: string | null;
+  onCloseTarget?: () => void;
+  onShowRuns: (taskId: string) => void;
+}) {
+  const { t } = useTranslation();
+  const { search, setSearch, setComposing, debouncedQ, page, setPage, pageSize, setPageSize } = useListControls();
+  const [refreshing, setRefreshing] = useState(false);
+  const [drawer, setDrawer] = useState<{ open: boolean; task: TaskDefinition | null }>({ open: false, task: null });
+  const { busy, run } = useAction();
+
+  const offset = (page - 1) * pageSize;
+
+  const load = useCallback(async () => {
+    const result = await orchestrationApi.listTasks({ q: debouncedQ, limit: pageSize, offset });
+    return { items: result.tasks, total: result.total };
+  }, [debouncedQ, pageSize, offset]);
+  const {
+    items: tasks,
+    total,
+    loading,
+    error: listError,
+    visibleError,
+    dismissError,
+    hasLoaded,
+    reload,
+  } = useListQuery(load);
+  useEffect(() => {
+    if (!loading && !listError && page > Math.max(1, Math.ceil(total / pageSize)))
+      setPage(Math.max(1, Math.ceil(total / pageSize)));
+  }, [loading, listError, total, page, pageSize, setPage]);
+
+  // 任务实例页跨页定位：任务列表就绪后打开目标任务的编辑抽屉
+  useEffect(() => {
+    if (!initialEditTaskId) return;
+    let active = true;
+    void orchestrationApi
+      .getTask(initialEditTaskId)
+      .then((task) => {
+        if (active) setDrawer({ open: true, task });
+      })
+      .catch((e) => {
+        if (active) toast.error(e.message);
+      });
+    return () => {
+      active = false;
+    };
+  }, [initialEditTaskId]);
+
+  const onDebug = (task: TaskDefinition) =>
+    void run(`debug:${task.task_id}`, t('dataAsset.taskList.debugTriggered', { name: task.name }), async () => {
+      const inst = await orchestrationApi.debugTask(task.task_id);
+      if (inst) onShowRuns(task.task_id);
+      return !!inst;
+    });
+
+  const onPublish = (task: TaskDefinition) =>
+    void run(`publish:${task.task_id}`, t('dataAsset.taskList.published', { name: task.name }), async () => {
+      await orchestrationApi.publishTask(task.task_id);
+      await reload();
+      return true;
+    });
+
+  const onUnpublish = (task: TaskDefinition) =>
+    void run(`unpublish:${task.task_id}`, t('dataAsset.taskList.unpublished', { name: task.name }), async () => {
+      const ok = await confirmDialog({
+        title: t('dataAsset.taskList.unpublishTitle', { name: task.name }),
+        message: t('dataAsset.taskList.unpublishMessage'),
+        confirmText: t('dataAsset.taskList.unpublishConfirm'),
+      });
+      if (!ok) return undefined;
+      await orchestrationApi.unpublishTask(task.task_id);
+      await reload();
+      return true;
+    });
+
+  const onDelete = (task: TaskDefinition) =>
+    void run(`delete:${task.task_id}`, t('dataAsset.taskList.deleted', { name: task.name }), async () => {
+      const ok = await confirmDialog({
+        title: t('dataAsset.taskList.deleteTitle', { name: task.name }),
+        message: t('dataAsset.taskList.deleteMessage'),
+        confirmText: t('common.delete'),
+        danger: true,
+      });
+      if (!ok) return undefined;
+      await orchestrationApi.deleteTask(task.task_id);
+      await reload();
+      return true;
+    });
+
+  const onRefresh = async () => {
+    setRefreshing(true);
+    try {
+      await reload();
+    } finally {
+      setRefreshing(false);
+    }
+  };
+
+  return (
+    <div>
+      {visibleError && (
+        <div className="da-error" role="alert">
+          <span>{visibleError}</span>
+          <button type="button" onClick={dismissError} aria-label={t('common.close')}>
+            ×
+          </button>
+        </div>
+      )}
+      <header className="da-page-header">
+        <h1>{t('dataAsset.taskList.title')}</h1>
+        <div className="da-page-header-actions">
+          <HifiButton onClick={() => setDrawer({ open: true, task: null })}>
+            {t('dataAsset.taskList.create')}
+          </HifiButton>
+        </div>
+      </header>
+      <div className="da-list-head">
+        <h2>{hasLoaded ? t('dataAsset.taskList.section', { count: total }) : t('dataAsset.taskList.sectionTitle')}</h2>
+      </div>
+      <div className="da-toolbar">
+        <SearchBox
+          onCompositionChange={setComposing}
+          value={search}
+          onChange={setSearch}
+          placeholder={t('dataAsset.taskList.searchPlaceholder')}
+        />
+        <IconButton onClick={() => void onRefresh()} loading={refreshing} title={t('common.refresh')}>
+          <RefreshCw size={14} aria-hidden="true" />
+        </IconButton>
+      </div>
+      {listError && !tasks.length ? null : loading && !tasks.length ? (
+        <div className="da-empty">{t('dataAsset.taskList.loading')}</div>
+      ) : tasks.length === 0 ? (
+        <div className="da-empty">
+          {debouncedQ ? t('dataAsset.taskList.emptyFiltered') : t('dataAsset.taskList.empty')}
+        </div>
+      ) : (
+        <Table
+          headers={[
+            t('dataAsset.taskList.col.name'),
+            t('dataAsset.taskList.col.status'),
+            t('dataAsset.taskList.col.executor'),
+            t('dataAsset.taskList.col.timeout'),
+            t('dataAsset.taskList.col.schedule'),
+            t('dataAsset.taskList.col.instanceCount'),
+            t('dataAsset.taskList.col.actions'),
+          ]}
+        >
+          {tasks.map((task) => (
+            <tr key={task.task_id}>
+              <td>
+                <span className="da-ellipsis" title={`${task.name} (${task.task_id})`}>
+                  {task.name}
+                </span>
+              </td>
+              <td>
+                <HifiStatus status={task.status} label={t(`dataAsset.status.${task.status}`)} />
+              </td>
+              <td>
+                <ExecutorTag type={task.executor_type} />
+              </td>
+              <td>{task.timeout_s}</td>
+              <td>
+                {task.schedule_type === 'none'
+                  ? t('dataAsset.wfForm.scheduleNone')
+                  : task.schedule_type === 'once'
+                    ? `${t('dataAsset.wfForm.scheduleOnce')} · ${task.schedule_once_at ?? '—'}`
+                    : `${t('dataAsset.wfForm.scheduleCron')} · ${task.schedule_cron ?? '—'}`}
+              </td>
+              <td>{task.instance_count ?? '—'}</td>
+              <td>
+                <div className="flex items-center gap-4">
+                  {task.status === 'draft' ? (
+                    <LinkAction loading={busy === `publish:${task.task_id}`} onClick={() => onPublish(task)}>
+                      {t('dataAsset.taskList.publish')}
+                    </LinkAction>
+                  ) : (
+                    <LinkAction loading={busy === `unpublish:${task.task_id}`} onClick={() => onUnpublish(task)}>
+                      {t('dataAsset.taskList.unpublish')}
+                    </LinkAction>
+                  )}
+                  <LinkAction loading={busy === `debug:${task.task_id}`} onClick={() => onDebug(task)}>
+                    {t('dataAsset.taskList.debug')}
+                  </LinkAction>
+                  <RowMenu
+                    text={t('dataAsset.taskList.more')}
+                    items={[
+                      { label: t('dataAsset.taskList.runHistory'), onClick: () => onShowRuns(task.task_id) },
+                      { label: t('dataAsset.taskList.edit'), onClick: () => setDrawer({ open: true, task }) },
+                      {
+                        label: t('common.delete'),
+                        onClick: () => onDelete(task),
+                        danger: true,
+                        loading: busy === `delete:${task.task_id}`,
+                      },
+                    ]}
+                  />
+                </div>
+              </td>
+            </tr>
+          ))}
+        </Table>
+      )}
+      {hasLoaded && (
+        <Pagination
+          total={total}
+          page={page}
+          pageSize={pageSize}
+          onPageChange={setPage}
+          onPageSizeChange={setPageSize}
+          loading={loading}
+          labels={{
+            total: t('common.pagination.total', { count: total }),
+            pageSize: t('common.pagination.pageSize'),
+            previous: t('common.pagination.previous'),
+            next: t('common.pagination.next'),
+            page: (item) => t('common.pagination.page', { page: item }),
+            navLabel: t('common.pagination.navLabel'),
+          }}
+        />
+      )}
+      <TaskEditDrawer
+        open={drawer.open}
+        task={drawer.task}
+        onClose={() => {
+          setDrawer({ open: false, task: null });
+          if (initialEditTaskId && onCloseTarget) onCloseTarget();
+          else void reload();
+        }}
+      />
+    </div>
+  );
+}
