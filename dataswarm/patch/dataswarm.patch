@@ -0,0 +1,136 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/rerank.py —— L2①b 去重合并 + ② 层 1 特征排序。
+
+去重合并（键 = workspace + 实体稳定 ID）：
+
+- 同 ID 的直发命中（L1 召回，带 rrf_score）与补全候选（图补全带出，
+  matched_on 含 ``graph:`` 前缀）合并为一条——分数取直发 RRF 分（不累加），
+  来源列表完整归并（``[lexical, graph:usesColumn:orders.region,
+  graph:measuresConcept:GMV]``）；
+- 跨子包**不去重**：同一列在 schema 子包与指标绑定中角色不同。
+
+层 1 特征排序（P0，不接 reranker——方案：由计划 LLM 直接看到带来源的
+候选列表做最终选择，评测显示选错率高时再接）：
+
+- 排序键：``(直发优先, RRF 分降序, 去相关独立来源数降序, entity_id 兜底)``；
+- 短路直通：唯一、有效、无冲突的规范名/别名全词命中确保 top-1；同义冲突
+  仍进歧义判定；
+- 歧义标注：与榜首**同通道同原始分**并列的候选标 ``ambiguous``（交 L2④
+  点名澄清，不静默任选）——按 RRF 分判并列永远判不出来，见
+  :func:`mark_ambiguity`。
+"""
+from __future__ import annotations
+
+import math
+
+from .model import RecallHit, RoadResult
+
+# 补全候选的来源前缀（直发 = 非 graph: 前缀）
+GRAPH_SOURCE_PREFIX = "graph:"
+
+# 同分判定容差：通道原始分构造时已 round(, 4)，最小档差 1e-4，容差远小于之
+_SCORE_TIE_EPS = 1e-9
+
+
+def dedupe_and_rank(road: RoadResult, extra: list[RecallHit]) -> list[RecallHit]:
+    """一路的直发命中 + 图补全候选 → 去重合并 + 层 1 特征排序。
+
+    Args:
+        road: L1 某路结果（hits 已按 RRF 排好）。
+        extra: 该路的图补全候选（无 rrf_score，matched_on 带 graph: 前缀）。
+
+    Returns:
+        排序后的候选列表（同 ID 合并，直发分保留，来源归并）。
+    """
+    merged: dict[str, RecallHit] = {}
+    for hit in road.hits:
+        merged[hit.entity_id] = hit
+    for hit in extra:
+        existing = merged.get(hit.entity_id)
+        if existing is None:
+            merged[hit.entity_id] = hit
+            continue
+        # 同 ID：来源归并（分数取直发 RRF 分——补全候选无分不累加）
+        for mark in hit.matched_on:
+            if mark not in existing.matched_on:
+                existing.matched_on.append(mark)
+
+    return sorted(
+        merged.values(),
+        key=lambda h: (
+            -_direct_score(h),          # 直发优先（RRF 分 > 0 者在前）
+            -_decorrelated_sources(h),  # 独立来源数多者优先
+            h.entity_id,                # 兜底保序（确定性）
+        ),
+    )
+
+
+def mark_ambiguity(terms: list[RecallHit]) -> list[RecallHit]:
+    """与榜首**同通道同原始分、且命中同一个问句片段**的候选标 ``ambiguous``。
+
+    三条判定缺一不可：
+
+    1. **看原始分，不看 RRF 分**：RRF 的设计目的就是用排名打破平局，同一
+       通道内两个同分候选必然拿到 1/61 与 1/62，按 RRF 判并列等于永远判不出
+       歧义——实测「交易总额」同时 LIKE 命中「商品交易总额」与「净交易总额」
+       （name 档各 0.9）时歧义被漏掉，用户收不到澄清；
+    2. **同通道内比**：跨通道原始分不可比（这正是用 RRF 的原因）；
+    3. **命中同一片段**：「交易总额」命中两个术语 = 真歧义（要澄清）；
+       「GMV 和退款金额」命中两个术语 = 两个诉求（**不要**澄清，否则常见的
+       多指标提问会被莫名反问）。片段不可得时（向量档无片段）退化为按 1+2 判。
+
+    精确别名（matched_on 含 alias）同分不算歧义——别名命中的前提是问题原文
+    包含该别名，双别名同分 = 用户同时点名两个术语（对齐 glossary 口径增强 C）。
+    """
+    if len(terms) < 2:
+        return terms
+    top = terms[0]
+    tied = [hit for hit in terms[1:] if _same_evidence(top, hit)]
+    if not tied:
+        return terms
+    group = [top, *tied]
+    if all("alias" not in hit.matched_on for hit in group):
+        for hit in group:
+            hit.payload["ambiguous"] = True
+    return terms
+
+
+def _same_evidence(top: RecallHit, other: RecallHit) -> bool:
+    """两候选是否「同通道同原始分 ∧ 同命中片段」（档位分离散，isclose 判等）。"""
+    top_scores = dict(top.channels)
+    if not any(name in top_scores
+               and math.isclose(top_scores[name], score, abs_tol=_SCORE_TIE_EPS)
+               for name, score in other.channels):
+        return False
+    top_token = str(top.payload.get("matched_token") or "")
+    other_token = str(other.payload.get("matched_token") or "")
+    if top_token and other_token:
+        return top_token == other_token
+    return True        # 片段不可得（向量档）→ 退化为仅看通道与分值
+
+
+def _direct_score(hit: RecallHit) -> float:
+    """直发分：RRF 分（直发候选 > 0；纯补全候选 = 0）。"""
+    return hit.rrf_score
+
+
+def _decorrelated_sources(hit: RecallHit) -> int:
+    """去相关独立来源数：同一底层证据的多条路径先归并封顶。
+
+    归并口径：``lexical*`` / ``vector|emb`` / ``schema:*`` / 每个 ``graph:*``
+    路径各算一路——「词法直发 + 图反查」是两路独立证据，而
+    ``graph:usesColumn`` 与 ``graph:measuresConcept`` 带出同一实体也是两路。
+    """
+    channels: set[str] = set()
+    for mark in hit.matched_on:
+        if mark.startswith("lexical"):
+            channels.add("lexical")
+        elif mark in ("vector", "emb") or mark.startswith("emb"):
+            channels.add("vector")
+        elif mark.startswith("schema:"):
+            channels.add("schema")
+        elif mark.startswith(GRAPH_SOURCE_PREFIX):
+            channels.add(mark)  # 每条图路径独立计
+        else:
+            channels.add(mark)
+    return len(channels)
