+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan_to_tasks 方言翻译单测（P1-5：mysql ETL 兜底翻译）。
+
+背景：DDL 侧有 _to_mysql_ddl 兜底，ETL 侧此前无对称兜底——旧 Doris plan
+的 etl_sql 直落 MySQL 执行。MySQL 与 Doris 语法族高度重叠（DATEDIFF/DATE_ADD/
+CAST AS DATE 均共用），真正需翻译的只有 CAST AS DOUBLE（MySQL 8.0.17 前无
+此目标类型）与 CURRENT_DATE()/CURRENT_TIMESTAMP()（MySQL 无括号形态）。
+
+跑法：python -m pytest tests/unit_tests/dw_warehouse_build/test_translate_dialect.py -v
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+_SCRIPT = (_REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+           / "skills" / "dw-warehouse-build" / "scripts" / "plan_to_tasks.py")
+
+
+def _load_ptt():
+    spec = importlib.util.spec_from_file_location("_ptt_dialect_test", _SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault("_ptt_dialect_test", mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture()
+def ptt():
+    return _load_ptt()
+
+
+# =========================================================================
+# _translate_mysql_sql：旧 Doris plan → MySQL 兼容
+# =========================================================================
+def test_translate_mysql_cast_double(ptt):
+    sql = "SELECT CAST(amount AS DOUBLE) / COUNT(*) AS ratio FROM ods_orders"
+    out = ptt._translate_mysql_sql(sql)
+    assert "AS DOUBLE" not in out
+    assert "(amount * 1.0) / COUNT(*)" in out
+
+
+def test_translate_mysql_current_date_parens(ptt):
+    sql = ("INSERT INTO t SELECT CURRENT_DATE(), CURRENT_TIMESTAMP() FROM s")
+    out = ptt._translate_mysql_sql(sql)
+    assert "CURRENT_DATE()" not in out
+    assert "CURRENT_TIMESTAMP()" not in out
+    assert "CURRENT_DATE" in out and "CURRENT_TIMESTAMP" in out
+
+
+def test_translate_mysql_keeps_native_mysql_syntax(ptt):
+    """DATEDIFF/DATE_ADD/CAST AS DATE 本就是 MySQL 语法，原样保留。"""
+    sql = ("SELECT DATEDIFF(ship_date, order_date), "
+           "DATE_ADD(order_date, INTERVAL 7 DAY), CAST(dt AS DATE) FROM ods")
+    assert ptt._translate_mysql_sql(sql) == sql
+
+
+def test_translate_mysql_empty(ptt):
+    assert ptt._translate_mysql_sql("") == ""
+    assert ptt._translate_mysql_sql(None) is None
+
+
+def test_translate_duckdb_nullif_temporal_assignment(ptt):
+    ddl = '''
+CREATE TABLE "dwd_orders" (
+  "purchase_ts" TIMESTAMP NULL,
+  "order_status" VARCHAR NULL
+)
+'''
+    sql = '''
+INSERT INTO "dwd_orders" ("purchase_ts", "order_status")
+SELECT NULLIF(o.`purchase_ts`, ''), NULLIF(o.`order_status`, '')
+FROM "ods_orders" AS o
+'''
+
+    out = ptt._translate_duckdb_sql(sql, ddl)
+
+    assert 'TRY_CAST((NULLIF(o."purchase_ts", \'\')) AS TIMESTAMP)' in out
+    assert 'NULLIF(o."order_status", \'\')' in out
+
+
+def test_translate_duckdb_temporal_assignment_accepts_empty_values(ptt):
+    import duckdb
+
+    ddl = 'CREATE TABLE "dwd_orders" ("purchase_ts" TIMESTAMP NULL)'
+    sql = (
+        'INSERT INTO "dwd_orders" ("purchase_ts") '
+        "SELECT NULLIF(o.`purchase_ts`, '') FROM \"ods_orders\" AS o"
+    )
+    translated = ptt._translate_duckdb_sql(sql, ddl)
+
+    connection = duckdb.connect(":memory:")
+    connection.execute('CREATE TABLE "ods_orders" ("purchase_ts" VARCHAR)')
+    connection.execute("INSERT INTO \"ods_orders\" VALUES (''), ('2024-01-02 03:04:05')")
+    connection.execute('CREATE TABLE "dwd_orders" ("purchase_ts" TIMESTAMP NULL)')
+    connection.execute(translated)
+
+    assert connection.execute('SELECT * FROM "dwd_orders"').fetchall() == [
+        (None,),
+        (datetime(2024, 1, 2, 3, 4, 5),),
+    ]
+
+
+# =========================================================================
+# _translate_etl_sql 分发（mysql 不再落「原样返回」分支）
+# =========================================================================
+def test_translate_etl_dispatch_mysql(ptt, monkeypatch):
+    monkeypatch.setattr(ptt, "_biz_is_sqlite", lambda ws="": False)
+    monkeypatch.setattr(ptt, "_biz_is_duckdb", lambda ws="": False)
+    monkeypatch.setattr(ptt, "_biz_is_mysql", lambda ws="": True)
+    monkeypatch.setattr(ptt, "WORKSPACE_ID", [""])
+    sql = "SELECT CAST(x AS DOUBLE) FROM t"
+    out = ptt._translate_etl_sql(sql)
+    assert "AS DOUBLE" not in out
+
+
+def test_translate_etl_dispatch_doris_passthrough(ptt, monkeypatch):
+    monkeypatch.setattr(ptt, "_biz_is_sqlite", lambda ws="": False)
+    monkeypatch.setattr(ptt, "_biz_is_duckdb", lambda ws="": False)
+    monkeypatch.setattr(ptt, "_biz_is_mysql", lambda ws="": False)
+    monkeypatch.setattr(ptt, "WORKSPACE_ID", [""])
+    sql = "SELECT CAST(x AS DOUBLE) FROM t"
+    assert ptt._translate_etl_sql(sql) == sql  # doris 原样
