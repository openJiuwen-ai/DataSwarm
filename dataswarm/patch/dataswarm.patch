+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Verb-Noun cmdlet 路由修复的回归测试。
+
+背景：模型在 bash 工具里写 PowerShell 命令（如 Copy-Item ...; python ...），
+openjiuwen / command_tools 的 shell_type=auto 判定认不出 → 回落 cmd.exe →
+报 "'Copy-Item' is not recognized as an internal or external command"。
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from jiuwenswarm.agents.harness.common.tools.command_tools import (
+    _has_cmdlet_segment,
