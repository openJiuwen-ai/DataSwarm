+                    "warnings": ["semantic_source_unsupported"]}
+        return start_run(
+            {
+                "source_id": source_id,
+                "trigger_type": trigger_type,
+                "include_profile": True,
+            }
+        )
+    finally:
+        workspace_context.reset(token)
+
+
+def _execute(
+    workspace_id: str,
+    source: dict,
+    run_id: str,
+    options: CollectionOptions,
+    adapter: SemanticaAdapter | None,
+) -> None:
+    token = workspace_context.set_current(workspace_id)
+    key = (workspace_id, source["source_id"])
+    collector = None
+    phase = "collect"
+    try:
+        repository.update_run(run_id, status="running")
+        previous = repository.latest_published_snapshot(source["source_id"])
+        snapshot_id = f"snapshot:{source['source_id']}:{run_id}"
+        collector = metadata_adapter_for(source)
+        snapshot = collector.collect(source, run_id, snapshot_id, options)
+        _validate_collection_size(previous, snapshot)
+        events = diff_snapshots(previous, snapshot)
+        # 维值字典抽取（L1 第四路）：快照 staged 前落库，随 snapshot_id 版本化。
+        # 字典是召回增强——抽取失败只记日志，绝不阻断采集/发布（对齐向量同步降级纪律）
+        value_status: dict[str, Any] = {}
+        try:
+            dict_rows = extract_value_dict(str(source.get("db_ref") or ""), snapshot,
+                                           collector=collector, diagnostics=value_status)
+        except Exception as exc:
+            dict_rows = []
+            value_status.update(status="failed", reason="value_dictionary_collection_failed",
+                                error=type(exc).__name__, rows=0)
+        snapshot.scope["value_dictionary"] = value_status
+        if dict_rows:
+            try:
+                repository.save_value_dict(source["source_id"], snapshot.snapshot_id, dict_rows)
+            except Exception as exc:  # noqa: BLE001 —— 落库失败降级为无字典
+                value_status.update(status="failed", reason="value_dictionary_persistence_failed",
+                                    error=type(exc).__name__)
+                logger.warning("[semantic.service][warn] 维值字典落库失败: %s: %s",
+                               type(exc).__name__, exc)
+        phase = "stage"
+        repository.save_snapshot(snapshot, "staged")
+        repository.save_profiles(snapshot)
+        repository.save_change_events(run_id, source["source_id"], events)
+        projection = add_deprecated_tombstones(build_projection(snapshot), previous, events)
+        # 图投影（可重建衍生品）：「知识图库」开关（SEMANTICA_GRAPH_ENABLED，默认关）
+        # 关 → 整段降级，快照照常发布，配好 Neo4j 并打开开关后下一次采集自动重建
+        # （元数据库是真相源，召回不读图）；开 → from_environment 照常构造，
+        # 图侧失败让 run 失败（配置了就该工作，失败要暴露）
+        graph_status: dict[str, Any] = {"status": "ok"}
+        graph_version = ""
+        graph_adapter = adapter
+        if graph_adapter is None and graph_projection_enabled():
+            graph_adapter = from_environment()
+        if graph_adapter is not None:
+            namespace = f"physical/{workspace_id or 'default'}/{source['source_id']}"
+            stage_id = graph_adapter.stage(namespace, snapshot_id, projection)
+            repository.update_run(run_id, status="staged", base_snapshot_id=previous.snapshot_id if previous else None,
+                                  current_snapshot_id=snapshot.snapshot_id, semantica_stage_id=stage_id)
+            graph_adapter.validate(stage_id)
+            phase = "publish"
+            result = graph_adapter.publish(stage_id)
+            graph_version = result.version
+        else:
+            graph_status = {"status": "unavailable", "reason": "graph_projection_disabled"}
+            # 无 stage_id 可记，仍落 base/current snapshot 关联（终态 update 不含这两个字段）
+            repository.update_run(run_id, status="staged", base_snapshot_id=previous.snapshot_id if previous else None,
+                                  current_snapshot_id=snapshot.snapshot_id)
+            phase = "publish"
+        repository.save_snapshot(snapshot, "published", graph_version)
+        # 发布成功后清理旧快照的字典行（字典只保留最新 published 一代）
+        try:
+            repository.purge_value_dict(source["source_id"], keep_snapshot_ids=[snapshot.snapshot_id])
+        except Exception as exc:  # noqa: BLE001 —— 清理失败只留冗余行，不影响读（按快照过滤）
+            logger.warning("[semantic.service][warn] 维值字典旧快照清理失败: %s: %s",
+                           type(exc).__name__, exc)
+        vector_status = _sync_vectors(workspace_id, source, snapshot)
+        phase = "impact"
+        impact_status: dict[str, Any] = {"status": "ok"}
+        try:
+            alerts = impact.propagate(source["source_id"], events, str(source.get("db_ref") or ""))
+        except Exception as exc:
+            # The graph and snapshot are already published. Report incomplete
+            # binding checks without falsely labelling that publication failed.
+            alerts = []
+            impact_status.update(status="failed", reason="impact_propagation_failed", error=type(exc).__name__)
+        repository.update_run(
+            run_id,
+            status="published",
+            semantica_version=graph_version,
+            finished_at=timeutil.now_iso(),
+            error_json=json.dumps({"alerts": len(alerts), "value_dictionary": value_status,
+                                   "vectors": vector_status, "impact": impact_status,
+                                   "collection_scope": snapshot.scope,
+                                   "collection_warnings": snapshot.errors, "graph": graph_status},
+                                  ensure_ascii=False),
+        )
+    except Exception as exc:
+        repository.update_run(
+            run_id,
+            status="failed",
+            finished_at=timeutil.now_iso(),
+            error_json=json.dumps({"type": type(exc).__name__, "phase": phase,
+                                   "reason": "semantic_collection_failed"}, ensure_ascii=False),
+        )
+    finally:
+        if collector is not None and hasattr(collector, "close"):
+            try:
+                collector.close()
+            except Exception as exc:
+                logger.warning("[semantic.service][warn] connector close failed: %s", type(exc).__name__)
+        with _running_lock:
+            _running_sources.pop(key, None)
+        workspace_context.reset(token)
+
+
+def get_run(run_id: str) -> dict | None:
+    """Return one semantic run."""
+    run = repository.get_run(run_id)
+    if run and run.get("error_json"):
+        try:
+            run["diagnostics"] = json.loads(run["error_json"])
+        except (TypeError, ValueError):
+            pass
+    return run
+
+
+def _sync_vectors(workspace_id: str, source: dict, snapshot) -> dict:
+    """publish 后同步 schema 向量；返回诊断，失败不影响快照发布。
+
+    向量通道是召回增强而非采集主流程——失败（embed 端点挂了/FAISS 异常）只
+    降级语义召回，run 照常 published（设计文档 §3 降级矩阵）。``sync``
+    自身已按降级契约返回状态不抛，这里再兜一层 FAISS 层的意外异常。
+    """
+    try:
+        status = vector_store.sync_workspace_vectors(
+            workspace_id, str(source["source_id"]), snapshot)
+    except Exception as exc:  # noqa: BLE001 —— 向量失败绝不阻断发布
+        status = {"status": "failed", "reason": "vector_sync_failed", "error": type(exc).__name__}
+    if status.get("status") != "ok":
+        logger.warning("[semantic.service][warn] schema 向量同步未完成: %s", status)
+    return status
+
+
+def vector_recall(source_id: str, query: str, limit: int = 20, *,
+                  db_ref: str = "") -> dict:
+    """语义向量召回表/列（设计文档 §4.6，路由见 semantic/api.py）。
+
+    ``db_ref`` 是 skill 侧（nl2sql recall_tables）的主键——skill 只有连接
+    ref 不知道 source_id，按当前工作空间注册源反查；``source_id`` 显式
+    传入时优先。反查不到**不报错**：返回 ``source_not_bound`` warning 的
+    空结果（降级契约与 vector_store.recall 同款——「通道关闭」不是
+    「没有相似表」，调用方据此走纯词法召回）。
+    """
+    if not source_id and db_ref:
+        source_id = _source_id_for_db_ref(db_ref)
+        if not source_id:
+            return {"tables": [], "query_vectors": [], "warnings": ["source_not_bound"]}
+    if not source_id:
+        raise ValueError("source_id is required")
+    if not query:
+        raise ValueError("q is required")
+    workspace_id = workspace_context.current_workspace().workspace_id
+    return vector_store.recall(workspace_id, source_id, query, limit=limit)
+
+
+def _source_id_for_db_ref(db_ref: str) -> str:
+    """按 db_ref 反查当前工作空间的注册源（enabled 优先，精确匹配）。
+
+    Args:
+        db_ref: 连接 ref（来自 skill 侧运行时 config，可信输入）。
+
+    Returns:
+        匹配的 ``source_id``；未匹配/查询失败返回空串（调用方走降级契约）。
+    """
+    # datasource_store 用模块级导入（service.py 顶部）——测试按
+    # ``service.datasource_store`` 打桩，函数内再 import 会路径错且桩不生效
+    ref = str(db_ref or "").strip()
+    if not ref:
+        return ""
+    try:
+        workspace_id = workspace_context.current_workspace().workspace_id
+        for source in datasource_store.list_sources(workspace_id or None):
+            if not source.get("enabled", True):
+                continue
+            if str(source.get("db_ref") or "") == ref:
+                return str(source.get("source_id") or "")
+    except Exception:  # noqa: BLE001 —— 反查失败按未绑定降级，不阻断召回
+        return ""
+    return ""
+
+
+def list_runs(source_id: str | None = None, limit: int = 50) -> list[dict]:
