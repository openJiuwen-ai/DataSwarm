+# Task 4: API 层解析 time_range body
+# --------------------------------------------------------------------------
+class _FakeHandler:
+    def __init__(self, body: dict):
+        self._body = body
+        self.headers = {"Content-Length": str(len(json.dumps(body)))}
+        self.rfile = self._BytesBody(json.dumps(body).encode("utf-8"))
+        self.status = None
+        self.payload = None
+
+    class _BytesBody:
+        def __init__(self, b):
+            self._b = b
+            self._i = 0
+
+        def read(self, n):
+            d = self._b[self._i:self._i + n]
+            self._i += n
+            return d
+
+    def _write_json(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class _Parsed:
+    def __init__(self, path):
+        self.path = path
+
