@@ -0,0 +1,96 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""test_metrics_published_single_source —— E6 published 单一出处收敛的三态护栏。
+
+「指标是否生效」的唯一判定口径是 ``store.published_revision*``（archived /
+无当前修订 / 当前修订非 published 均不生效）。E6 收敛后 semantic_link 与
+graph_projection 的生效扫描全部改走单一出处；本测试用三态 + 健康对照锁死
+收敛后行为——**archived 态在旧就地重抄实现里会漏入候选**（无 archived
+检查），这是 E6 唯一的行为变化，方向：归档指标从「可能漏过」变「正确排除」。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import semantic_link, store, versioning
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, write_published_snapshot
+
+WORKSPACE = "e6-states"
+
+
+@pytest.fixture()
+def states(e2e):
+    """健康指标 + 三态问题指标（archived / 无修订 / 非 published）。
+
+    Returns:
+        {"healthy": key, "archived": key, "draft": key, "no_rev": key,
+         "healthy_revision": MetricRevision}
+    """
+    imported = versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE,
+        target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    assert imported["created"] is True
+    # 与 e2e 用例同款：查真实 revision_id、确认 aov 映射候选，发布才能过绑定闸门
+    revision_ids = [r.revision_id for metric in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(metric.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="tester")
+    write_published_snapshot(e2e)
+    versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+        label="e6-states", published_by="tester")
+
+    defs = sorted(store.list_defs(WORKSPACE), key=lambda d: d.metric_key)
+    assert len(defs) >= 3, f"OSSIE 样例应导入 ≥3 个指标，实际 {len(defs)}"
+    healthy, archived, draft = defs[0], defs[1], defs[2]
+    # 三态构造：归档（def 级）/ 非 published（当前修订状态打回 draft）/ 无修订
+    store.set_current_revision(archived.metric_id, archived.current_revision_id, status="archived")
+    store.update_revision_status(draft.current_revision_id, "draft")
+    store.create_def(workspace_id=WORKSPACE, metric_key="no.revision.metric",
+                     name="无修订指标")
+    return {"healthy": healthy.metric_key, "archived": archived.metric_key,
+            "draft": draft.metric_key, "no_rev": "no.revision.metric",
+            "healthy_revision": store.published_revision_of(WORKSPACE, healthy.metric_key)}
+
+
+def test_three_states_single_source(states):
+    """三态 × 四路径一致：单一出处本体 + 两个收敛后的 semantic_link 消费方。"""
+    for bad_key in (states["archived"], states["no_rev"], states["draft"]):
+        assert store.published_revision_of(WORKSPACE, bad_key) is None, bad_key
+        assert semantic_link._revision_for(WORKSPACE, bad_key, None) is None, bad_key
+    scoped = {r.revision_id for r in semantic_link._scoped_revisions(WORKSPACE, None)}
+    bad_ids = set()
+    for bad_key in (states["archived"], states["no_rev"], states["draft"]):
+        metric = store.get_def_by_key(WORKSPACE, bad_key)
+        bad_ids.update(r.revision_id for r in store.list_revisions(metric.metric_id))
+    assert not (scoped & bad_ids), "三态修订不得混入生效集"
+
+    # 健康对照：三条路径都命中同一修订
+    revision = states["healthy_revision"]
+    assert revision is not None
+    assert semantic_link._revision_for(WORKSPACE, states["healthy"], None).revision_id \
+        == revision.revision_id
+    assert revision.revision_id in scoped
+
+
+def test_archived_exclusion_is_the_behavior_change(states):
+    """E6 行为变化的显式锁定：archived 指标的当前修订是 published，旧就地
+    重抄实现（无 archived 检查）会把它当生效——收敛后必须排除。"""
+    metric = store.get_def_by_key(WORKSPACE, states["archived"])
+    current = store.get_revision(metric.current_revision_id)
+    assert current is not None and current.status == "published", \
+        "前置：archived 态的当前修订本身仍是 published（正是旧实现漏过的形态）"
+    assert store.published_revision_of(WORKSPACE, states["archived"]) is None
+    assert semantic_link._revision_for(WORKSPACE, states["archived"], None) is None
+
+
+def test_release_scoped_view_preserved(states):
+    """release 分支是历史 release 成员视图，不属「当前生效」判定——保持
+    按修订自身状态过滤（E6 收敛不动它）。"""
+    release = store.get_active_release(WORKSPACE)
+    assert release is not None
+    revisions = semantic_link._scoped_revisions(WORKSPACE, release)
+    assert revisions, "release 视图应含本 release 携带的 published 修订"
+    assert all(r.status == "published" for r in revisions)
