+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 单个看板卡片：KPI 值 + 趋势 + 迷你图。 */
+
+import { EChart } from './shared/EChart';
+import { KpiCard } from '../../_shared/ui';
+import type { RenderedCard } from '../types/dashboard';
+import { Trash2 } from 'lucide-react';
+
+interface DashboardCardProps {
+  card: RenderedCard;
+  onClick: () => void;
+  onDelete: () => void;
+}
+
+export function DashboardCard({ card, onClick, onDelete }: DashboardCardProps) {
+  const isKpi = card.card_type === 'kpi' || card.card_type === 'metric';
+  const hasChart = card.echarts_option && Object.keys(card.echarts_option).length > 0;
+
+  return (
+    <div className="group relative rounded-xl border border-border bg-card p-4 shadow-sm transition hover:border-accent hover:shadow-md">
+      {/* 删除按钮 */}
+      <button
+        className="absolute right-2 top-2 rounded p-1 text-text-muted opacity-0 transition hover:bg-danger-subtle hover:text-danger group-hover:opacity-100"
+        onClick={(e) => { e.stopPropagation(); onDelete(); }}
+      >
+        <Trash2 size={12} />
+      </button>
+
+      <div className="cursor-pointer" onClick={onClick}>
+        <h3 className="mb-2 text-sm font-medium text-text-strong">{card.title}</h3>
+
+        {card.error && (
+          <div className="mb-2 rounded bg-danger-subtle px-2 py-1 text-xs text-danger">{card.error}</div>
+        )}
+
+        {isKpi && (
+          <KpiCard
+            label={card.title}
+            value={card.current_value ?? null}
+            trend={null}
+          />
+        )}
+
+        {hasChart && (
+          <div className="mt-2" style={{ height: isKpi ? 120 : 240 }}>
+            <EChart option={card.echarts_option as any} ariaLabel={card.title} height={isKpi ? 120 : 240} />
+          </div>
+        )}
+
+        {!isKpi && !hasChart && !card.error && (
+          <div className="flex h-24 items-center justify-center text-xs text-text-muted">无图表数据</div>
+        )}
+      </div>
+    </div>
+  );
+}
