index 000000000..e2cbc98ea
--- /dev/null
+++ b/tests/acceptance/datasource/batch13/verify_gates.py
@@ -0,0 +1,307 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""SQL Server real-service acceptance using dedicated LocalDB and ODBC 17.
+
+Run setup_localdb.py first. Usage: verify_gates.py [fixture_dir]
+The product SQLAlchemy and governance connector paths both run against the real
+SQL Server engine; DuckDB only supplies the independent numerical baseline.
+Authentication here is Windows integrated auth. SQL authentication, remote TCP,
+ODBC 18 TLS/certificate behavior, and cloud SQL Server remain explicit boundaries.
+No default workspace configuration or metadata database is changed.
+"""
+from __future__ import annotations
+
+from decimal import Decimal, InvalidOperation
+import json
+import os
+from pathlib import Path
+import sys
+
+from setup_localdb import DATABASE, DEFAULT_FIXTURE, DRIVER, INSTANCE, ROOT
+
+# Match the established acceptance scripts' environment based credential lookup.
+# These settings are process-local, contain no secrets, and are not persisted.
+os.environ["MSSQL_ODBC_DRIVER"] = DRIVER
+os.environ["MSSQL_TRUSTED_CONNECTION"] = "true"
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (
+    SourceDefinition, SqlQueryable, capabilities_of, get_engine,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+from jiuwenswarm.channels.web.dataagent.connectors.sqlalchemy_connector import clear_engine_cache
+from jiuwenswarm.channels.web.dataagent.datasource import registry as registry
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common import dialect_registry as dialects
+
+CONFIG = {"host": f"(localdb)\\{INSTANCE}", "database": DATABASE, "port": 1433,
+          "driver": DRIVER, "trusted_connection": True}
+FIXTURE = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else DEFAULT_FIXTURE
+ADAPTER = registry.get_source_type("sqlserver")
+REF = ADAPTER.build_ref(CONFIG)
+RESULTS: list[dict] = []
+BOUNDARIES = [
+    "SQL Server 2019 LocalDB / ODBC Driver 17 / Windows integrated auth only; "
+    "remote TCP, SQL authentication, ODBC 18 TLS/certificate behavior were not exercised.",
+    "Knowledge candidates are derived from real column metadata; persistence into "
+    "the default Doris metadata workspace is outside this database acceptance run.",
+    "ApplicationIntent=ReadOnly is routing intent, not server-side write protection; "
+    "application SQL guards are tested; production should use a least-privilege database account.",
+]
+
+
+def connector():
+    return get_engine(ADAPTER.engine)(SourceDefinition(
+        "verify-sqlserver-batch13", "sqlserver", "SQL Server acceptance", ADAPTER.engine, dict(CONFIG)))
+
+
+def check(gate: str, name: str, fn) -> None:
+    try:
+        detail = fn()
+        RESULTS.append({"gate": gate, "name": name, "status": "pass", "detail": detail})
+        print(f"[PASS] {gate} {name}" + (f" -- {detail}" if detail else ""))
+    except Exception as exc:
+        detail = f"{type(exc).__name__}: {exc}"
+        RESULTS.append({"gate": gate, "name": name, "status": "fail", "detail": detail})
+        print(f"[FAIL] {gate} {name} -- {detail}")
+
+
+def rejected(fn, exc_type=ValueError) -> None:
+    try:
+        fn()
+    except exc_type:
+        return
+    raise AssertionError("Operation unexpectedly accepted")
+
+
+def normalized(rows):
+    def cell(value):
+        try:
+            return format(Decimal(str(value)).quantize(Decimal("0.0001")), "f")
+        except (InvalidOperation, ValueError):
+            return str(value)
+    return [[cell(value) for value in row] for row in rows]
+
+
+def a_form():
+    entry = next(e for e in registry.list_source_types() if e["type_id"] == "sqlserver")
+    keys = {f["key"] for f in entry["fields"]}
+    assert {"host", "database", "driver", "trusted_connection", "password"} <= keys, keys
+    assert entry["engine"] == "sqlalchemy"
+    assert entry["available"] is ADAPTER.released
+    assert entry["unavailable_reason"] == ("" if ADAPTER.released else "not_released")
+    return f"dynamic form fields={len(keys)}; released={ADAPTER.released}"
+
+
+def a_validation():
+    rejected(lambda: ADAPTER.validate({}))
+    rejected(lambda: ADAPTER.validate({"host": "h", "database": "d", "port": 0, "user": "u"}))
+    rejected(lambda: ADAPTER.validate({"host": "h", "database": "d", "trusted_connection": False}))
+    ADAPTER.validate(CONFIG)
+    return "empty/invalid/missing SQL user rejected; integrated authentication accepted"
+
+
+def a_connection():
+    result = ADAPTER.test_connection(CONFIG)
+    assert result.get("ok") is True, result
+    bad = ADAPTER.test_connection({**CONFIG, "database": "dataswarm_batch13_missing_database",
+                                   "password": "acceptance-secret-must-not-echo"})
+    assert bad.get("ok") is False, bad
+    assert "acceptance-secret-must-not-echo" not in str(bad), bad
+    return "real connection success and nonexistent database failure"
+
+
+def a_redaction():
+    public = ADAPTER.public_config({**CONFIG, "password": "acceptance-only-secret"})
+    assert ADAPTER.secret_keys() == {"password"}
+    assert public["password"] == ""
+    assert public["trusted_connection"] is True
+
+
+def a_server_identity():
+    row = connector().query("SELECT CAST(SERVERPROPERTY('ProductVersion') AS varchar(32)), "
+                            "CAST(SERVERPROPERTY('Edition') AS varchar(64)), "
+                            "CAST(SERVERPROPERTY('IsLocalDB') AS int), DB_NAME()")["rows"][0]
+    assert row[2] == 1 and row[3] == DATABASE, row
+    return {"version": row[0], "edition": row[1], "is_localdb": row[2], "database": row[3]}
+
+
+def b_ref():
+    spec = dbc.parse_db_ref(REF)
+    assert spec["type"] == "sqlserver" and spec["database"] == DATABASE, spec
+    assert spec["host"].lower() == CONFIG["host"].lower(), spec
+    assert spec["driver"] == DRIVER, spec
+    assert str(spec["trusted_connection"]).lower() in {"true", "1", "yes"}, spec
+    return "named-instance ref roundtrip with process-local connection settings"
+
+
+def b_catalog():
+    entries = {(d["schema"], d["name"]) for d in connector().catalog()["datasets"]}
+    expected = {("dbo", "fact_orders"), ("sales", "fact_orders"), ("dbo", "metadata_edge_case")}
+    assert entries == expected, entries
+    return "two schema-qualified fact_orders datasets remain distinct"
+
+
+def b_schema():
+    schema = connector().schema("fact_orders", "dbo")
+    cols = {c["name"]: c for c in schema["columns"]}
+    assert len(cols) == 7, cols
+    assert schema["primary_key"] == ["order_id"], schema
+    assert cols["channel_name"]["comment"] == "下单渠道", cols["channel_name"]
+    assert cols["order_id"]["nullable"] is False
+    assert cols["order_amt"]["nullable"] is True
+    shadow = connector().schema("fact_orders", "sales")
+    assert {c["name"] for c in shadow["columns"]} == {"shadow_id", "shadow_note"}
+    return "7 real columns, primary key, Chinese comments, nullability; no schema collision"
+
+
+def b_governance():
+    names = dbc.tables(REF)["tables"]
+    assert "[dbo].[fact_orders]" in names, names
+    assert "[sales].[fact_orders]" in names, names
+    by = {c["name"]: c for c in dbc.schema(REF, "dbo.fact_orders")["columns"]}
+    assert len(by) == 7 and by["order_id"]["pk"] is True, by
+    assert by["channel_name"]["comment"] == "下单渠道", by
+    assert {c["name"] for c in dbc.schema(REF, "sales.fact_orders")["columns"]} == {"shadow_id", "shadow_note"}
+    indexes = dbc.list_indexes(REF, "dbo.fact_orders")["indexes"]
+    assert any(i["unique"] and i["columns"] == ["order_id"] for i in indexes), indexes
+    ddl = dbc.show_create_table(REF, "dbo.fact_orders")["create_sql"]
+    assert "PRIMARY KEY" in ddl.upper(), ddl
+    return "governance tables/schema/indexes/DDL all read the real database"
+
+
+def b_metadata_edges():
+    by = {c["name"]: c for c in dbc.schema(REF, "dbo.metadata_edge_case")["columns"]}
+    assert set(by) == {"key_a", "key_b", "label", "amount"}, by
+    assert by["label"]["comment"] == "删除中间列后的注释", by
+    assert by["label"]["type"].lower() == "nvarchar(42)", by
+    assert by["amount"]["type"].lower().replace(" ", "") == "decimal(18,4)", by
+    assert [n for n, c in by.items() if c["pk"]] == ["key_a", "key_b"], by
+    ddl = dbc.show_create_table(REF, "dbo.metadata_edge_case")["create_sql"]
+    assert ddl.upper().count("PRIMARY KEY") == 1, ddl
+    assert "[key_a], [key_b]" in ddl, ddl
+    indexes = dbc.list_indexes(REF, "dbo.metadata_edge_case")["indexes"]
+    assert any(i["unique"] and i["columns"] == ["key_a", "key_b"] for i in indexes), indexes
+    return "deleted-column comments, NVARCHAR length, DECIMAL precision, composite primary key"
+
+
+def b_candidates():
+    from jiuwenswarm.channels.web.dataagent.knowledge import schema_candidates
+    columns = dbc.schema(REF, "dbo.fact_orders")["columns"]
+    hits = {col["name"]: hit for col in columns
+            if (hit := schema_candidates._classify("fact_orders", col, "sqlserver"))}
+    assert hits["order_amt"]["asset_type"] == "metric", hits
+    assert hits["channel_name"]["asset_type"] == "term", hits
+    assert hits["order_date"]["asset_type"] == "term", hits
+    assert "order_id" not in hits, hits
+    return f"{len(hits)} knowledge candidates derived from real SQL Server column metadata"
+
+
+TSQL = {
+    "Q1": "SELECT ROUND(SUM(order_amt),2) FROM dbo.fact_orders",
+    "Q2": ("SELECT TOP 3 region_id, ROUND(SUM(order_amt),2) AS v FROM dbo.fact_orders "
+           "GROUP BY region_id ORDER BY v DESC,region_id"),
+    "Q3": ("SELECT TOP 3 FORMAT(order_date,'yyyy-MM') AS m, ROUND(SUM(order_amt),2) FROM dbo.fact_orders "
+           "WHERE order_date >= '2026-01-01' GROUP BY FORMAT(order_date,'yyyy-MM') ORDER BY m"),
+    "Q4": ("SELECT category_id,COUNT(*) FROM dbo.fact_orders WHERE region_id<>9 AND order_amt IS NOT NULL "
+           "GROUP BY category_id ORDER BY category_id"),
+    "Q5": "SELECT ROUND(100.0*SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END)/COUNT(*),3) FROM dbo.fact_orders",
+}
+DUCK = {
+    "Q1": "SELECT ROUND(SUM(order_amt),2) FROM fact_orders",
+    "Q2": ("SELECT region_id, ROUND(SUM(order_amt),2) AS v FROM fact_orders "
+           "GROUP BY region_id ORDER BY v DESC,region_id LIMIT 3"),
+    "Q3": ("SELECT strftime(order_date,'%Y-%m') AS m, ROUND(SUM(order_amt),2) FROM fact_orders "
+           "WHERE order_date >= DATE '2026-01-01' GROUP BY m ORDER BY m LIMIT 3"),
+    "Q4": ("SELECT category_id,COUNT(*) FROM fact_orders WHERE region_id<>9 AND order_amt IS NOT NULL "
+           "GROUP BY category_id ORDER BY category_id"),
+    "Q5": "SELECT ROUND(100.0*SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END)/COUNT(*),3) FROM fact_orders",
+}
+EXPECTED = {"Q1": [["2318839.9200"]],
+            "Q2": [["4.0000", "620606.7500"], ["2.0000", "620448.2500"], ["3.0000", "532051.4800"]],
+            "Q3": [["2026-01", "99018.5000"], ["2026-02", "91174.2300"], ["2026-03", "97070.7000"]],
+            "Q4": [["1.0000", "10651.0000"], ["2.0000", "12425.0000"], ["3.0000", "10650.0000"],
+                   ["4.0000", "12425.0000"]],
+            "Q5": [["7.1420"]]}
+
+
+def c_question(label):
+    import duckdb
+    with duckdb.connect() as db:
+        db.read_parquet(str(FIXTURE / "fact_orders.parquet")).create_view("fact_orders")
+        baseline = normalized(db.execute(DUCK[label]).fetchall())
+    actual = normalized(connector().query(TSQL[label], limit=10)["rows"])
+    assert baseline == EXPECTED[label], (label, "fixture baseline mismatch", baseline)
+    assert actual == baseline, (label, actual, baseline)
+    return actual
+
+
+def d_writes():
+    conn = connector()
+    for sql in ("INSERT INTO dbo.fact_orders(order_id) VALUES(-1)",
+                "UPDATE dbo.fact_orders SET order_amt=0 WHERE 1=0",
+                "DELETE FROM dbo.fact_orders WHERE 1=0",
+                "DROP TABLE dbo.acceptance_guard_probe",
+                "TRUNCATE TABLE dbo.acceptance_guard_probe",
+                "SELECT 1 AS x INTO dbo.acceptance_guard_probe",
+                "CREATE TABLE dbo.acceptance_guard_probe(x int)",
+                "ALTER TABLE dbo.acceptance_guard_probe ADD x int"):
+        rejected(lambda s=sql: conn.query(s), QueryValidationError)
+    assert conn.query("SELECT COUNT(*) FROM dbo.fact_orders")["rows"] == [[50000]]
+    return "8 write forms rejected before execution; fixture still has 50000 rows"
+
+
+def d_multi_and_dialect():
+    rejected(lambda: connector().query("SELECT 1; SELECT 2"), QueryValidationError)
+    rejected(lambda: connector().query("SELECT `order_id` FROM dbo.fact_orders"), QueryValidationError)
+    assert dialects.sqlglot_dialect("sqlserver") == "tsql"
+    assert dialects.profile_for("sqlserver").grain_fn == "FORMAT"
+    assert connector().query("SELECT TOP 1 [order_id] FROM dbo.fact_orders ORDER BY [order_id]")["rows"] == [[1]]
+    assert connector().query(
+        "SELECT [order_id] FROM dbo.fact_orders ORDER BY [order_id] OFFSET 1 ROWS FETCH NEXT 1 ROWS ONLY"
+    )["rows"] == [[2]]
+
+
+def d_limits():
+    conn = connector()
+    assert isinstance(conn, SqlQueryable)
+    assert capabilities_of(conn) == {"sql"}, capabilities_of(conn)
+    for requested, expected in ((10, 10), (100000, 10000)):
+        result = conn.query("SELECT order_id FROM dbo.fact_orders ORDER BY order_id", limit=requested)
+        assert result["row_count"] == expected and result["truncated"] is True, result["row_count"]
+    preview = conn.preview("dbo.fact_orders", limit=3)
+    assert preview["row_count"] == 3 and preview["truncated"] is True
+    return "SQL capability, preview, 10-row truncation and 10000-row hard cap"
+
+
+if __name__ == "__main__":
+    for gate, name, fn in [
+        ("A1", "registry/form/release state", a_form),
+        ("A2", "configuration validation", a_validation),
+        ("A3", "real connection success/failure", a_connection),
+        ("A4", "secret redaction", a_redaction),
+        ("A5", "real server identity", a_server_identity),
+        ("B1", "reference roundtrip", b_ref),
+        ("B2", "real catalog", b_catalog),
+        ("B3", "real SQLAlchemy schema", b_schema),
+        ("B4", "real governance connector paths", b_governance),
+        ("B5", "metadata edge cases", b_metadata_edges),
+        ("B6", "knowledge candidate derivation", b_candidates),
+    ]:
+        check(gate, name, fn)
+    for question in TSQL:
+        check("C", question, lambda q=question: c_question(q))
+    check("D1", "write guards", d_writes)
+    check("D2", "multi-statement and T-SQL dialect", d_multi_and_dialect)
+    check("D3", "capabilities/preview/truncation", d_limits)
+    clear_engine_cache("verify-sqlserver-batch13")
+    failed = sum(r["status"] == "fail" for r in RESULTS)
+    report = {"type": "sqlserver", "instance": INSTANCE, "database": DATABASE,
+              "driver": DRIVER, "passed": len(RESULTS) - failed, "failed": failed,
+              "boundaries": BOUNDARIES, "results": RESULTS}
+    output = ROOT / "artifact" / "datasource-validation" / "batch13-result.json"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(f"\nPassed {len(RESULTS)-failed}; failed {failed}; boundaries {len(BOUNDARIES)}")
+    for boundary in BOUNDARIES:
+        print(f"[BOUNDARY] {boundary}")
+    print(f"Report: {output}")
+    raise SystemExit(1 if failed else 0)
