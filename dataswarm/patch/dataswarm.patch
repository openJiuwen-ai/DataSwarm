+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import type { ArtifactMap, InspectionSummary } from '../types/inspection';
+import { LineagePage } from './LineagePage';
+import { OverviewPage } from './OverviewPage';
+import { QualityPage } from './QualityPage';
+import { SchemaPage } from './SchemaPage';
+
+function DashboardSection({ id, title, children }: { id: string; title?: string; children: React.ReactNode }) {
+  return (
+    <section className={`gov-dashboard-section gov-dashboard-section-${id}`} aria-labelledby={title ? `gov-dashboard-${id}` : undefined}>
+      {title && (
+        <header className="gov-dashboard-section-head">
+          <h2 id={`gov-dashboard-${id}`}>{title}</h2>
+        </header>
+      )}
+      {children}
+    </section>
+  );
+}
+
+export function GovernanceDashboardPage({ summary, artifacts }: { summary: InspectionSummary; artifacts: ArtifactMap }) {
+  const { t } = useTranslation();
+
+  return (
+    <div className="gov-dashboard">
+      <DashboardSection id="overview" title={t('governance.dashboard.sections.overview')}>
+        <OverviewPage summary={summary} artifacts={artifacts} showFindings={false} />
+      </DashboardSection>
+
+      <DashboardSection id="schema" title={t('governance.dashboard.sections.schema')}>
+        <SchemaPage artifact={artifacts.schema} showFindings={false} />
+      </DashboardSection>
+
+      <DashboardSection id="quality" title={t('governance.dashboard.sections.quality')}>
+        <QualityPage data={artifacts.data} zscore={artifacts.zscore} showFindings={false} />
+      </DashboardSection>
+
+      <DashboardSection id="lineage">
+        <LineagePage lineage={artifacts.lineage} columns={artifacts['column-lineage']} rootCause={artifacts['root-cause']} showFindings={false} />
+      </DashboardSection>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/governance/components/LineagePage.tsx b/jiuwenswarm/channels/web/frontend/src/features/governance/components/LineagePage.tsx
new file mode 100644
index 000000000..599b70d35
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/governance/components/LineagePage.tsx
@@ -0,0 +1,190 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 表血缘与字段血缘使用公共组件；巡检取数及根因结论由本页管理。
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { FindingList, Panel, Empty } from './shared/Ui';
+import type { ColumnLineageArtifact, LineageArtifact, RcaHypothesis, RootCauseArtifact } from '../types/inspection';
+import { LineageGraph } from '../../_shared/lineage/LineageGraph';
+import { ColumnLineageTable } from '../../_shared/lineage/ColumnLineageTable';
+import { LAYER_COLOR } from '../../_shared/lineage/lineageLayout';
+
+export function LineagePage({
+  lineage,
+  columns,
+  rootCause,
+  showFindings = true,
+}: {
+  lineage?: LineageArtifact;
+  columns?: ColumnLineageArtifact;
+  rootCause?: RootCauseArtifact;
+  showFindings?: boolean;
+}) {
+  const { t } = useTranslation();
+  const [mode, setMode] = useState<'table' | 'column'>('table');
+  const [selected, setSelected] = useState('');
+  const nodes = lineage?.graph.nodes ?? [];
+  const edges = lineage?.graph.edges ?? [];
+
+  const rcaTables = useMemo(() => {
+    const tables = new Set<string>();
+    for (const finding of rootCause?.findings ?? []) {
+      const object = finding.object ?? {};
+      const symptom = object.symptom_table as string | undefined;
+      const root = object.root_node as string | undefined;
+      if (symptom) tables.add(symptom);
+      if (root && root !== 'unknown') tables.add(root);
+    }
+    return tables;
+  }, [rootCause]);
+
+  const fitKey = useMemo(
+    () =>
+      JSON.stringify({
+        runId: lineage?.meta?.run_id,
+        nodes: nodes.map((node) => [node.table, node.layer]),
+        edges: edges.map((edge) => [edge.from, edge.to, edge.join_key]),
+      }),
+    [edges, lineage?.meta?.run_id, nodes],
+  );
+  // Each snapshot has its own search/filter state, even for older artifacts without run_id.
+  const columnKey = useMemo(() => JSON.stringify([columns?.meta?.run_id, columns?.graph]), [columns]);
+  const layerLegend = useMemo(() => {
+    const counts: Record<string, number> = {};
+    for (const node of nodes) {
+      const layer = node.layer ?? 'OTHER';
+      counts[layer] = (counts[layer] ?? 0) + 1;
+    }
+    return ['SOURCE', 'ODS', 'DWD', 'DWS', 'ADS']
+      .filter((layer) => counts[layer])
+      .map((layer) => ({ layer, count: counts[layer], color: LAYER_COLOR[layer] }));
+  }, [nodes]);
+
+  return (
+    <div className="gov-lineage-view">
+      <header className="gov-lineage-head">
+        <h2>{t('governance.dashboard.sections.lineage')}</h2>
+        <div className="gov-lineage-switch" role="group" aria-label={t('governance.dashboard.lineage.mode')}>
+          <button type="button" aria-pressed={mode === 'table'} onClick={() => setMode('table')}>
+            {t('governance.dashboard.lineage.table')}
+          </button>
+          <button type="button" aria-pressed={mode === 'column'} onClick={() => setMode('column')}>
+            {t('governance.dashboard.lineage.column')}
+          </button>
+        </div>
+      </header>
+      {mode === 'table' ? (
+        <Panel className="gov-graph-panel gov-lineage-panel">
+          <div className="gov-flow-legend">
+            {selected && (
+              <span className="gov-kpi-hint !mt-0">
+                {t('governance.dashboard.lineage.selected', { value: selected })}
+              </span>
+            )}
+            <span className="ml-auto flex flex-wrap items-center gap-3">
+              {layerLegend.map(({ layer, count, color }) => (
+                <span key={layer} className="flex items-center gap-1.5">
+                  <i className="inline-block h-2.5 w-2.5 rounded-[2px]" style={{ background: color }} />
+                  <span className="gov-lane-count">
+                    {layer} {count}
+                  </span>
+                </span>
+              ))}
+              {rcaTables.size > 0 && (
+                <span className="flex items-center gap-1.5">
+                  <i
+                    className="inline-block h-2.5 w-2.5 rounded-[2px] border border-dashed"
+                    style={{ borderColor: 'var(--color-feedback-danger)' }}
+                  />
+                  <span className="gov-lane-count">{t('governance.dashboard.lineage.rootCauseLegend')}</span>
+                </span>
+              )}
+            </span>
+          </div>
+          {nodes.length ? (
+            <div className="gov-flow-canvas">
+              <LineageGraph
+                key={fitKey}
+                nodes={nodes}
+                edges={edges}
+                selected={selected}
+                onSelect={setSelected}
+                rootCauseTables={rcaTables}
+                controlsPosition="bottom-right"
+              />
+            </div>
+          ) : (
+            <Empty text={t('governance.dashboard.lineage.waitingTable')} />
+          )}
+        </Panel>
+      ) : columns ? (
+        <ColumnLineageTable key={columnKey} graph={columns.graph} />
+      ) : (
+        <Panel>
+          <Empty text={t('governance.dashboard.lineage.waitingColumn')} />
+        </Panel>
+      )}
+      {showFindings && (
+        <Panel title={t('governance.dashboard.lineage.rootCauseFindings')}>
+          <FindingList findings={rootCause?.findings ?? []} />
+          <RcaHypotheses
+            hypotheses={rootCause?.hypotheses}
+            hasRootCause={!!rootCause && (rootCause.findings.length > 0 || !!rootCause.trace)}
+          />
+        </Panel>
+      )}
+    </div>
+  );
+}
+
+// ---- M3：AI 根因假设（与确定性 trace 结论区分，供排查参考） ----
+function RcaHypotheses({
+  hypotheses,
+  hasRootCause,
+}: {
+  hypotheses?: RcaHypothesis[];
+  hasRootCause?: boolean;
+}) {
+  const { t } = useTranslation();
+  // 无 root_cause 产物（巡检未触发根因追溯）→ 整块不渲染；
+  // 有 root_cause 但 hypotheses 空（LLM 超时/失败降级）→ 占位说明，不能静默消失
+  if (!hasRootCause) return null;
+  return (
+    <div className="mt-3">
+      <div className="mb-2 flex items-center gap-2">
+        <span className="gov-lane-label">{t('governance.dashboard.lineage.rca.title')}</span>
+        <span className="gov-kpi-hint !mt-0">{t('governance.dashboard.lineage.rca.disclaimer')}</span>
+      </div>
+      {(!hypotheses || hypotheses.length === 0) ? (
+        <p className="rounded-md border border-dashed border-gray-300 bg-gray-50 p-2.5 text-xs text-gray-500">
+          {t('governance.dashboard.lineage.rca.degraded')}
+        </p>
+      ) : (
+        <ol className="space-y-2">
+          {hypotheses.map((h, i) => (
+            <li key={i} className="rounded-md border border-dashed border-gray-300 bg-amber-50/60 p-2.5 text-sm">
+              <div className="flex items-start gap-2">
+                <span className="mt-0.5 shrink-0 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">
+                  {t('governance.dashboard.lineage.rca.hypothesis', { index: i + 1 })} · {t(`governance.dashboard.lineage.rca.confidence.${h.confidence}`, { defaultValue: h.confidence })}
+                </span>
+                <span className="leading-relaxed text-gray-800">{h.hypothesis}</span>
+              </div>
+              {h.supporting_evidence && h.supporting_evidence.length > 0 && (
+                <div className="mt-1.5 text-xs text-gray-600">
+                  {t('governance.dashboard.lineage.rca.evidence', { value: h.supporting_evidence.join('；') })}
+                </div>
+              )}
+              {h.verify_action && (
+                <div className="mt-1.5 text-xs text-gray-700">
+                  <span className="font-medium">{t('governance.dashboard.lineage.rca.verify')}</span>
+                  <code className="break-all rounded bg-gray-100 px-1 py-0.5 font-mono text-[11px]">
+                    {h.verify_action}
+                  </code>
+                </div>
+              )}
+            </li>
+          ))}
+        </ol>
+      )}
+    </div>
+  );
+}
