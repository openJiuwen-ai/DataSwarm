+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+def clear_cache_for(source_id, remote_path):
+    """仅清理指定源的暂存目录，确保首次拉取检查不受持久缓存影响。"""
+    import shutil
+
+    from jiuwenswarm.channels.web.dataagent.connectors import staged_connector as sc
+
+    shutil.rmtree(sc._cache_dir_for(source_id, remote_path, HDFS_CONFIG), ignore_errors=True)
+
+
+def connector_for(config=None, source_id="verify"):
+    adapter = R.get_source_type("hdfs")
+    source = SourceDefinition(
+        source_id, "hdfs", "verify", adapter.engine, dict(config or HDFS_CONFIG)
+    )
+    return get_engine(adapter.engine)(source)
+
+
+def fetcher_for(config=None):
+    from jiuwenswarm.channels.web.dataagent.connectors.staged_connector import (
+        _WebHdfsFetcher,
+    )
+
+    return _WebHdfsFetcher(dict(config or HDFS_CONFIG))
+
+
+def dataset_names(cat):
+    if cat.get("datasets") is not None:
+        return [d["name"] for d in cat["datasets"]]
+    return [tb["name"] for s in cat.get("schemas", []) for tb in s["tables"]]
+
+
+# ======================================================================
+print("\n########## 门 A：接入 ##########")
+
+
+def a_catalog_entry():
