index 000000000..9fe358b7e
--- /dev/null
+++ b/tests/unit_tests/dataagent/test_semantic_join_evidence.py
@@ -0,0 +1,320 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""semantic join 证据单测：dw_semantic_join_status 持久化 + 采集侧
+推断级/血缘级/声明级 evidence.level + 快照覆盖合并。
+
+- repository 层：save_join_status 幂等 upsert、非法 status 拒绝、list 过滤
+- 采集层：_inferred_joins 命名推断（*_id 同名同类型 + top_k 包含率）、
+  _lineage_joins 血缘级（table_lineage join_key 解析 + business_ref 隔离）、
+  声明级优先去重
+- 读取层：latest_published_snapshot 覆盖合并（verified 升声明级 / rejected 剔除）
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.semantic import repository
+from jiuwenswarm.channels.web.dataagent.semantic.adapters.mysql import (
+    _inferred_joins,
+    _lineage_joins,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    TableMeta,
+)
+from jiuwenswarm.channels.web.orchestration.db import _connect, _exec
+
+
+# ==========================================================================
+# repository 层
+# ==========================================================================
+
+def test_save_and_list_join_status(semantic_db):
+    row = repository.save_join_status(
+        "jp:abc123", "src", repository.JOIN_STATUS_VERIFIED, "alice", note="外键等价"
+    )
+    assert row["status"] == repository.JOIN_STATUS_VERIFIED
+
+    rows = repository.list_join_status(source_id="src")
+    assert len(rows) == 1 and rows[0]["join_node_id"] == "jp:abc123"
+
+
+def test_save_join_status_upsert_replaces(semantic_db):
+    repository.save_join_status("jp:abc", "src", repository.JOIN_STATUS_VERIFIED, "alice")
+    repository.save_join_status("jp:abc", "src", repository.JOIN_STATUS_REJECTED, "bob", note="误判")
+    rows = repository.list_join_status(source_id="src")
+    assert len(rows) == 1
+    assert rows[0]["status"] == repository.JOIN_STATUS_REJECTED
+    assert rows[0]["confirmed_by"] == "bob"
+
+
+def test_save_join_status_rejects_unknown_status(semantic_db):
+    with pytest.raises(ValueError, match="status"):
+        repository.save_join_status("jp:abc", "src", "maybe", "alice")
+
+
+def test_list_join_status_filters_by_status(semantic_db):
+    repository.save_join_status("jp:a", "src", repository.JOIN_STATUS_VERIFIED, "alice")
+    repository.save_join_status("jp:b", "src", repository.JOIN_STATUS_REJECTED, "bob")
+    verified = repository.list_join_status(source_id="src", status=repository.JOIN_STATUS_VERIFIED)
+    assert [r["join_node_id"] for r in verified] == ["jp:a"]
+
+
+# ==========================================================================
+# 采集层：推断级（命名约定）
+# ==========================================================================
+
+def _table(name: str, columns: list[tuple[str, str, list[dict]]], *, database: str = "shop") -> TableMeta:
+    metas = [
+        ColumnMeta("src", "mysql", database, name, col_name,
+                   data_type=data_type, ordinal=index + 1,
+                   top_k=top_k or [])
+        for index, (col_name, data_type, top_k) in enumerate(columns)
+    ]
+    return TableMeta("src", "mysql", database, name, columns=metas)
+
+
+def test_inferred_joins_pairs_same_name_id_columns():
+    orders = _table("orders", [
+        ("order_id", "bigint", [{"value": 1, "count": 2}]),
+        ("customer_id", "bigint", [{"value": 7, "count": 3}, {"value": 9, "count": 1}]),
+    ])
+    customers = _table("customers", [
+        ("customer_id", "bigint", [{"value": 7, "count": 5}, {"value": 9, "count": 2}]),
+        ("name", "varchar", []),
+    ])
+    joins = _inferred_joins("src", [orders, customers], known=[])
+    assert len(joins) == 1
+    join = joins[0]
+    assert join.level == "inferred"
+    assert join.status == "candidate"
+    assert join.source == ["naming_convention"]
+    assert join.evidence["naming"] == "customer_id"
+    # top_k 交集包含率参与 confidence（0.5 + overlap/2，overlap=1.0 → 0.8 封顶）
+    assert join.confidence == 0.8
+
+
+def test_inferred_joins_skip_type_mismatch_and_same_table():
+    orders = _table("orders", [
+        ("customer_id", "bigint", []),
+        ("other_id", "int", []),
+    ])
+    customers = _table("customers", [
+        ("customer_id", "varchar", []),  # 类型族不同：int vs string
+    ])
+    joins = _inferred_joins("src", [orders, customers], known=[])
+    assert joins == []
+
+
+def test_inferred_joins_skip_declared_endpoints():
+    orders = _table("orders", [("customer_id", "bigint", [])])
+    customers = _table("customers", [("customer_id", "bigint", [])])
+    from jiuwenswarm.channels.web.dataagent.semantic.model import JoinPathMeta
+
+    declared = JoinPathMeta(
+        source_id="src", source_type="mysql",
+        left_column_id="col:mysql:src:shop.orders.customer_id",
+        right_column_id="col:mysql:src:shop.customers.customer_id",
+        left_table_id="tbl:mysql:src:shop.orders",
+        right_table_id="tbl:mysql:src:shop.customers",
+        source=["foreign_key"], evidence={"level": "declared"}, status="verified",
+    )
+    # 声明级已覆盖该端点（含正反序）——推断级不再生成
+    joins = _inferred_joins("src", [orders, customers], known=[declared])
+    assert joins == []
+
+
+def test_inferred_joins_zero_overlap_keeps_base_confidence():
+    """top_k 都有采样但交集为空：overlap=0.0 是有效信息（非 None），confidence 保持基线。"""
+    orders = _table("orders", [("customer_id", "bigint", [{"value": 1, "count": 1}])])
+    customers = _table("customers", [("customer_id", "bigint", [{"value": 999, "count": 1}])])
+    joins = _inferred_joins("src", [orders, customers], known=[])
+    assert len(joins) == 1
+    assert joins[0].evidence["overlap_ratio"] == 0.0
+    assert joins[0].confidence == 0.5
+
+
+def test_inferred_joins_unprofiled_columns_omit_overlap():
+    """未 profile（top_k 空）：overlap_ratio 不写入 evidence（未知≠为 0）。"""
+    orders = _table("orders", [("customer_id", "bigint", [])])
+    customers = _table("customers", [("customer_id", "bigint", [])])
+    joins = _inferred_joins("src", [orders, customers], known=[])
+    assert len(joins) == 1
+    assert "overlap_ratio" not in joins[0].evidence
+    assert joins[0].confidence == 0.5
+
+
+# ==========================================================================
+# 采集层：血缘级（table_lineage）
+# ==========================================================================
+
+def _seed_lineage(rows: list[dict]):
+    conn = _connect()
+    try:
+        for row in rows:
+            _exec(
+                conn,
+                "INSERT INTO table_lineage "
+                "(lineage_id,plan_id,source_db,source_table,target_db,target_table,join_key,"
+                "lineage_type,transformation,task_id,business_ref,created_at) "
+                "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
+                (
+                    row["lineage_id"], row.get("plan_id", ""), row["source_db"], row["source_table"],
+                    row["target_db"], row["target_table"], row["join_key"], row.get("lineage_type", ""),
+                    "", row.get("task_id", ""), row.get("business_ref", ""), "2026-10-01T00:00:00",
+                ),
+            )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _fake_workspace(monkeypatch, *, business_ref: str = ""):
+    """从真实 current_workspace 派生假对象：保留 metadata_db_ref（_connect
+    依赖它定位 semantic_db fixture 的 tmp 元库），只覆盖 business_db_ref。"""
+    from jiuwenswarm.common import workspace_context as wctx
+
+    real = wctx.current_workspace()
+
+    class _W:
+        pass
+
+    fake = _W()
+    fake.metadata_db_ref = real.metadata_db_ref
+    fake.workspace_id = real.workspace_id
+    fake.business_db_ref = business_ref
+    monkeypatch.setattr(wctx, "current_workspace", lambda: fake)
+    return fake
+
+
+def test_lineage_joins_resolve_join_key(semantic_db, monkeypatch):
+    orders = _table("orders", [("order_id", "bigint", []), ("customer_id", "bigint", [])])
+    dim_customer = _table("dim_customer", [("id", "bigint", [])])
+    _seed_lineage([{
+        "lineage_id": "ln-1",
+        "source_db": "shop", "source_table": "dim_customer",
+        "target_db": "shop", "target_table": "orders",
+        "join_key": "orders.customer_id = dim_customer.id",
+    }])
+    _fake_workspace(monkeypatch, business_ref="")
+    joins = _lineage_joins("src", [orders, dim_customer], db_ref="mysql://db:3306/shop", known=[])
+    assert len(joins) == 1
+    join = joins[0]
+    assert join.level == "lineage"
+    assert join.status == "candidate"
+    assert join.confidence == 0.7
+    assert join.evidence["lineage_id"] == "ln-1"
+    # left=source 侧（dim_customer.id）、right=target 侧（orders.customer_id）
+    # ——join_key 的左右表序（orders 在左）与 lineage source/target 顺序无关
+    assert join.left_column_id.endswith("dim_customer.id")
+    assert join.right_column_id.endswith("orders.customer_id")
+
+
+def test_lineage_joins_skip_tables_out_of_scope(semantic_db, monkeypatch):
+    orders = _table("orders", [("customer_id", "bigint", [])])
+    # dim_customer 不在采集范围（表集合里没有）
+    _seed_lineage([{
+        "lineage_id": "ln-2",
+        "source_db": "shop", "source_table": "dim_customer",
+        "target_db": "shop", "target_table": "orders",
+        "join_key": "orders.customer_id = dim_customer.id",
+    }])
+    _fake_workspace(monkeypatch, business_ref="")
+    assert _lineage_joins("src", [orders], db_ref="mysql://db:3306/shop", known=[]) == []
+
+
+# ==========================================================================
+# 读取层：覆盖合并
+# ==========================================================================
+
+def test_level_property_falls_back_to_source():
+    from jiuwenswarm.channels.web.dataagent.semantic.model import JoinPathMeta
+
+    def _join(sources: list[str], evidence: dict | None = None) -> JoinPathMeta:
+        return JoinPathMeta(
+            source_id="src", source_type="mysql",
+            left_column_id="col:mysql:src:shop.a.x",
+            right_column_id="col:mysql:src:shop.b.y",
+            left_table_id="tbl:mysql:src:shop.a",
+            right_table_id="tbl:mysql:src:shop.b",
+            source=sources, evidence=evidence or {},
+        )
+
+    assert _join(["foreign_key"]).level == "declared"
+    assert _join(["view_definition"]).level == "declared"
+    assert _join(["table_lineage"]).level == "lineage"
+    assert _join(["naming_convention"]).level == "inferred"
+    assert _join(["something_else"]).level == "unknown"
+    assert _join(["naming_convention"], {"level": "declared"}).level == "declared"
+
+
+# ==========================================================================
+# 读取层：覆盖合并（latest_published_snapshot）
+# ==========================================================================
+
+def _publish_snapshot_with_joins(semantic_db, joins):
+    """落一个含给定 joins 的 published 快照（最小化绕过采集链）。"""
+    from jiuwenswarm.channels.web.dataagent.semantic.model import (
+        DatabaseMeta,
+        DataSourceMeta,
+        MetadataSnapshot,
+    )
+
+    orders = _table("orders", [("order_id", "bigint", []), ("customer_id", "bigint", [])])
+    customers = _table("customers", [("customer_id", "bigint", [])])
+    snapshot = MetadataSnapshot(
+        "snapshot:src:run-1", "run-1",
+        DataSourceMeta("src", "mysql", "mysql://db:3306/shop"),
+        [DatabaseMeta("src", "mysql", "shop")],
+        [orders, customers],
+        joins=joins,
+    )
+    repository.save_snapshot(snapshot, "published")
+    return snapshot
+
+
+def test_join_status_overlay_verified_upgrades_level(semantic_db):
+    from jiuwenswarm.channels.web.dataagent.semantic.model import JoinPathMeta
+
+    inferred = JoinPathMeta(
+        source_id="src", source_type="mysql",
+        left_column_id="col:mysql:src:shop.orders.customer_id",
+        right_column_id="col:mysql:src:shop.customers.customer_id",
+        left_table_id="tbl:mysql:src:shop.orders",
+        right_table_id="tbl:mysql:src:shop.customers",
+        cardinality="unknown", confidence=0.5,
+        source=["naming_convention"], evidence={"level": "inferred"},
+        status="candidate",
+    )
+    _publish_snapshot_with_joins(semantic_db, [inferred])
+    # 人工确认前：推断级 candidate
+    snap = repository.latest_published_snapshot("src")
+    assert snap.joins[0].level == "inferred" and snap.joins[0].status == "candidate"
+
+    repository.save_join_status(
+        inferred.node_id, "src", repository.JOIN_STATUS_VERIFIED, "alice")
+    snap = repository.latest_published_snapshot("src")
+    join = snap.joins[0]
+    assert join.status == "verified"
+    assert join.level == "declared"
+    assert "manual_confirm" in join.source
+    assert join.confidence == 1.0
+    assert join.node_id == inferred.node_id  # 端点不变（覆盖不重建）
+
+
+def test_join_status_overlay_rejected_removes_edge(semantic_db):
+    from jiuwenswarm.channels.web.dataagent.semantic.model import JoinPathMeta
+
+    inferred = JoinPathMeta(
+        source_id="src", source_type="mysql",
+        left_column_id="col:mysql:src:shop.orders.customer_id",
+        right_column_id="col:mysql:src:shop.customers.customer_id",
+        left_table_id="tbl:mysql:src:shop.orders",
+        right_table_id="tbl:mysql:src:shop.customers",
+        source=["naming_convention"], evidence={"level": "inferred"},
+        status="candidate",
+    )
+    _publish_snapshot_with_joins(semantic_db, [inferred])
+    repository.save_join_status(
+        inferred.node_id, "src", repository.JOIN_STATUS_REJECTED, "alice")
+    snap = repository.latest_published_snapshot("src")
+    assert snap.joins == []
