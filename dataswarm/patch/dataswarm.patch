+    finally:
+        sc._MAX_FILES = original
+    return f"超过 _MAX_FILES（默认 {original}）时拒绝暂存"
+
+
+def d_cache_quota_and_ttl():
+    from jiuwenswarm.channels.web.dataagent.connectors import staged_connector as sc
+
+    root = cpaths.staged_cache_root()
+    probe = root / "hdfs_ttl_probe.csv"
+    probe.write_text("x", encoding="utf-8")
+    os.utime(probe, (time.time() - 10 * 24 * 3600, time.time() - 10 * 24 * 3600))
+    report = sc._prune_cache()
+    assert not probe.exists(), "超 TTL 的暂存文件未被清理"
+    assert report["expired"] >= 1, report
