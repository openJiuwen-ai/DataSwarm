+
+    对账后必须补跑指标重投影恢复这些边（方案 W-4 变更同步第一条），否则
+    现象是「界面上术语绑着、分析却不认」。
+    """
+    from jiuwenswarm.channels.web.dataagent.metrics import graph_projection
+
+    calls: list[str] = []
+    monkeypatch.setattr(graph_projection, "reproject_workspace",
