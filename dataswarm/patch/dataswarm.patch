index 000000000..afac5b637
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/extraction_jobs.py
@@ -0,0 +1,107 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""后台知识抽取任务：提交即返回，守护线程串行执行，状态写回文档 payload。
+
+文档上传后处于「未抽取」；用户在文档管理里勾选多份提交抽取，HTTP 请求只做
+入队并立即返回，避免一次 LLM 蒸馏（分钟级）把页面卡在 loading。状态机：
+
+    （未抽取，无 status） → queued → running → complete / partial / failed
+
+ContextVar 不会传播到新线程，worker 每次取任务都按提交时记录的 workspace_id
+重新 ``set_current``；同一文档重复提交由内存去重表拦截（进程内单 worker 串行，
+不会出现同文档并发写 payload）。
+"""
+from __future__ import annotations
+
+import queue
+import threading
+
+from jiuwenswarm.common import workspace_context
+
+from . import documents
+
+_QUEUE: queue.Queue[tuple[str, str]] = queue.Queue()
+_PENDING: set[tuple[str, str]] = set()
+_LOCK = threading.Lock()
+_WORKER: threading.Thread | None = None
+_WORKER_LOCK = threading.Lock()
+
+
+def _set_status(version_id: str, status: str, error: str = "") -> None:
+    """把抽取状态写回文档 payload（worker 线程内调用，workspace 已设置）。"""
+    document = documents.get_document(version_id)
+    if not document:
+        return
+    extraction = document.setdefault("extraction", {})
+    extraction["status"] = status
+    if error:
+        extraction["error"] = error
+    else:
+        extraction.pop("error", None)
+    documents._save_extraction(document)
+
+
+def _loop() -> None:
+    while True:
+        workspace_id, version_id = _QUEUE.get()
+        try:
+            workspace_context.set_current(workspace_id or None)
+            _set_status(version_id, "running")
+            documents.extract_candidates(version_id)
+        except Exception as exc:  # noqa: BLE001 — 后台任务必须吞掉异常并落状态
+            try:
+                _set_status(version_id, "failed", error=f"{type(exc).__name__}: {exc}")
+            except Exception:  # noqa: BLE001 — 文档可能已被删除
+                pass
+        finally:
+            with _LOCK:
+                _PENDING.discard((workspace_id, version_id))
+            _QUEUE.task_done()
+
+
+def _ensure_worker() -> None:
+    global _WORKER
+    if _WORKER is not None and _WORKER.is_alive():
+        return
+    with _WORKER_LOCK:
+        if _WORKER is not None and _WORKER.is_alive():
+            return
+        _WORKER = threading.Thread(target=_loop, name="knowledge-extraction", daemon=True)
+        _WORKER.start()
+
+
+def is_pending(workspace_id: str, version_id: str) -> bool:
+    """该文档是否仍有排队/执行中的后台抽取任务（用于识别重启后的残留状态）。"""
+    with _LOCK:
+        return (workspace_id, version_id) in _PENDING
+
+
+def submit_extraction(version_ids: list[str], *, workspace_id: str = "") -> dict:
+    """提交后台抽取。
+
+    Args:
+        version_ids: 文档版本 id 列表（去重后按顺序入队）。
+        workspace_id: 提交时的工作空间；缺省取当前请求上下文。
+
+    Returns:
+        {queued: [version_id...], skipped: [{version_id, reason}...]}；
+        reason ∈ not_found / already_running。
+    """
+    workspace = workspace_id or workspace_context.current_workspace().workspace_id or "default"
+    queued: list[str] = []
+    skipped: list[dict] = []
+    for version_id in dict.fromkeys(str(v) for v in version_ids if str(v).strip()):
+        if documents.get_document(version_id) is None:
+            skipped.append({"version_id": version_id, "reason": "not_found"})
+            continue
+        key = (workspace, version_id)
+        with _LOCK:
+            if key in _PENDING:
+                skipped.append({"version_id": version_id, "reason": "already_running"})
+                continue
+            _PENDING.add(key)
+        _set_status(version_id, "queued")
+        _QUEUE.put(key)
+        queued.append(version_id)
+    if queued:
+        _ensure_worker()
+    return {"queued": queued, "skipped": skipped}
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/extraction_llm.py b/jiuwenswarm/channels/web/dataagent/knowledge/extraction_llm.py
new file mode 100644
index 000000000..8fc534709
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/extraction_llm.py
@@ -0,0 +1,421 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Distillation LLM provider with local typed-validation loop.
+
+Replaces the Semantica provider layer for extraction: the gateway in this
+deployment only exposes an Anthropic channel for the default model, and its
+OpenAI endpoint answers 503 with an HTML error page that the openai SDK
+silently returns as ``str``. The extraction schema is owned by this project
+anyway, so the typed loop (JSON coerce → pydantic validate → feed the error
+back once) is kept here instead of Semantica's repair loop.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import time
+from dataclasses import dataclass
+from typing import Any, Type, get_origin
+
+from pydantic import BaseModel, ValidationError
+
+import json_repair
+
+_FENCE_RE = re.compile(r"```(?:json)?\s*(.*?)```", re.DOTALL)
+_JSON_HINT_RE = re.compile(r"json", re.IGNORECASE)
+
+
+class ExtractionLLMError(RuntimeError):
+    """LLM extraction call failed (protocol error / unparseable / invalid)."""
+
+    def __init__(self, message: str, *, truncated: bool = False, code: str = "provider_error"):
+        super().__init__(message)
+        self.truncated = truncated
+        self.code = "output_truncated" if truncated else code
+
+
+@dataclass(frozen=True)
+class CompletionInfo:
+    protocol: str
+    stop_reason: str = ""
+    finish_reason: str = ""
+    thinking_chars: int = 0
+    text_chars: int = 0
+    truncated: bool = False
+    output_tokens: int | None = None
+    elapsed_ms: int = 0
+
+
+def _ensure_json_keyword(prompt: str) -> str:
+    """DashScope/Qwen 系网关在 ``json_object`` 模式下要求消息文本中出现 "json" 关键字。
+
+    当前抽取 prompt 恰好含 "JSON schema" 字样属于隐式依赖，措辞调整后网关会 400。
+    显式兜底：不含时追加一句。
+    """
+    if _JSON_HINT_RE.search(prompt):
+        return prompt
+    return prompt + "\n\nRespond with a valid json object matching the requested schema."
+
+
+def _optional_kwargs_rejected(exc: Exception) -> bool:
+    """Whether to strip the optional kwargs and retry bare.
+
+    Any 400/422 qualifies: gateway error text is unreliable (HTML error pages,
+    silently swallowed fields — see findings F-032), so a keyword match on the
+    message would miss real rejections. Stripping costs at most one extra
+    fast-failing call before the original error is re-raised.
+    """
+    status = getattr(exc, "status_code", None)
+    return status in {400, 422}
+
+
+def _loads_lenient(text: str) -> Any:
+    """Parse LLM JSON output tolerantly.
+
+    Tolerance is delegated to ``json_repair`` (the standard open-source fixer
+    for LLM output: trailing commas, unescaped quotes, unclosed brackets,
+    truncation, fences, single quotes...); a None result means unparseable
+    and surfaces as JSONDecodeError so the retry loop can feed it back.
+    """
+    payload = json_repair.loads(text)
+    if payload is None:
+        raise json.JSONDecodeError("unparseable LLM output", text, 0)
+    return payload
+
+
+def _is_list_field(field: Any) -> bool:
+    return get_origin(getattr(field, "annotation", None)) is list
+
+
+class ExtractionLLMProvider:
+    """Single ``generate_typed`` method, duck-typed for ``documents.extract_candidates``."""
+
+    def __init__(self, *, model: str, api_key: str, api_base: str, protocol: str = "openai",
+                 max_tokens: int | None = None, timeout_s: int = 300, client: Any = None,
+                 disable_thinking: bool = False, endpoint_profile: str | None = None):
+        """Args:
+            model: model name at the gateway.
+            api_key / api_base: gateway credentials; ``api_base`` must be http(s).
+            protocol: "anthropic" (/v1/messages) or "openai" (/v1/chat/completions).
+            max_tokens: completion cap, including reasoning on models that share
+                its budget. Defaults to 8192 for both protocols.
+            timeout_s: per-request timeout.
+            client: optional injected client for tests; built lazily otherwise.
+            disable_thinking: opt-in reasoning suppression via the platform's
+                dialect mapping; off by default — extraction runs with the
+                model's native reasoning behaviour.
+        """
+        if not model or not api_key or not api_base:
+            raise ValueError("model, api_key and api_base are required")
+        if protocol not in {"anthropic", "openai"}:
+            raise ValueError(f"unsupported protocol: {protocol}")
+        self.model, self.api_key, self.api_base = model, api_key, api_base
+        self.protocol, self.max_tokens, self.timeout_s = protocol, max_tokens, timeout_s
+        self.output_budget = max_tokens if max_tokens is not None else 8192
+        if self.output_budget <= 0:
+            raise ValueError("max_tokens must be positive")
+        self.disable_thinking, self.endpoint_profile = disable_thinking, endpoint_profile
+        self._injected_client = client
+        self.last_completion = CompletionInfo(protocol=protocol)
+        self.completions: list[CompletionInfo] = []
+
+    def generate_typed(self, prompt: str, schema: Type[BaseModel], *,
+                       temperature: float = 0.0, max_retries: int = 1) -> BaseModel:
+        """Call the LLM and return output validated against ``schema``.
+
+        Args:
+            prompt: extraction prompt (already contains the JSON schema).
+            schema: pydantic model to validate the reply against.
+            temperature: passed through; extraction wants 0.0.
+            max_retries: total attempts (>=1); validation errors are fed back.
+
+        Returns:
+            An instance of ``schema``.
+
+        Raises:
+            ExtractionLLMError: after all attempts fail.
+        """
+        prompt = _ensure_json_keyword(prompt)
+        attempt_prompt, last_error, last_code = prompt, "", "invalid_output"
+        for _attempt in range(max(1, max_retries)):
+            try:
+                raw = self._complete(attempt_prompt, temperature)
+                payload = self._load_payload(raw, schema)
+                return schema.model_validate(payload)
+            except ExtractionLLMError as exc:
+                if exc.truncated or exc.code not in {"empty_output", "invalid_output"}:
+                    raise
+                last_error, last_code = str(exc), exc.code
+            except (json.JSONDecodeError, ValidationError) as exc:
+                # ValidationError contains model-produced input; keep it out of
+                # diagnostics and retry prompts (it may contain document secrets).
+                last_error, last_code = type(exc).__name__, "invalid_output"
+            if last_error:
+                attempt_prompt = (f"{prompt}\n\nYour previous reply was not valid "
+                                  f"({last_error}). Reply with ONLY one JSON object "
+                                  "matching the schema.")
+        raise ExtractionLLMError(f"typed extraction failed after {max(1, max_retries)} attempts: {last_error}",
+                                 code=last_code)
+
+    # ------------------------------------------------------------------ calls
+    def _complete(self, prompt: str, temperature: float) -> str:
+        try:
+            if self.protocol == "anthropic":
+                return self._complete_anthropic(prompt, temperature)
+            return self._complete_openai(prompt, temperature)
+        except ExtractionLLMError:
+            raise
+        except Exception as exc:  # noqa: BLE001 — never expose credential-bearing SDK payloads
+            status = getattr(exc, "status_code", None)
+            raise ExtractionLLMError(f"extraction request failed: {type(exc).__name__}, status={status}") from exc
+
+    def _reasoning_kwargs(self) -> dict:
+        if not self.disable_thinking:
+            return {}
+        # Reuse the platform's model/endpoint dialect mapping instead of guessing
+        # `reasoning_effort` or `enable_thinking` from the transport alone.
+        from openjiuwen.core.foundation.llm import ModelClientConfig, ModelRequestConfig
+        from openjiuwen.core.foundation.llm.reasoning import resolve_reasoning_plan
+        from jiuwenswarm.common.reasoning_config import effective_endpoint_profile
+        plan = resolve_reasoning_plan(
+            ModelClientConfig(client_provider="Anthropic" if self.protocol == "anthropic" else "OpenAI",
+                              model_name=self.model, api_base=self.api_base, api_key=self.api_key,
+                              endpoint_profile=effective_endpoint_profile(self.api_base, self.endpoint_profile)),
+            ModelRequestConfig(model=self.model), explicit_kwargs={"reasoning": {"mode": "disabled"}})
+        return {**plan.sdk_params, **({"extra_body": plan.extra_body} if plan.extra_body else {})}
+
+    def _optional_kwargs(self) -> dict:
+        """Generation-side JSON constraint plus optional reasoning suppression.
+
+        ``response_format: json_object`` is applied where the gateway accepts
+        it (verified on this deployment for both protocols); any 400/422
+        strips the whole set once and retries bare — gateway error text is
+        not trusted to name the offending field. json_repair on the parse
+        side remains the safety net either way.
+        """
+        optional = dict(self._reasoning_kwargs())
+        if self.protocol == "anthropic":
+            # The anthropic SDK rejects unknown top-level params; extra_body
+            # passes through into the request body for the gateway to convert.
+            extra = optional.setdefault("extra_body", {})
+            extra.setdefault("response_format", {"type": "json_object"})
+        else:
+            optional.setdefault("response_format", {"type": "json_object"})
+        return optional
+
+    def _complete_anthropic(self, prompt: str, temperature: float) -> str:
+        client = self._injected_client or self._make_anthropic_client()
+        kwargs: dict[str, Any] = {"model": self.model,
+                                  "max_tokens": self.output_budget,
+                                  "temperature": temperature,
+                                  "messages": [{"role": "user", "content": prompt}]}
+        optional = self._optional_kwargs()
+        kwargs.update(optional)
+        t0 = time.perf_counter()
+        try:
+            response = client.messages.create(**kwargs)
+        except Exception as exc:
+            # Private Anthropic shims often expose the messages path but reject
+            # optional controls. Retry without them; never resend the same payload.
+            if not optional or not _optional_kwargs_rejected(exc):
+                raise
+            for key in optional:
+                kwargs.pop(key, None)
+            response = client.messages.create(**kwargs)
+        stop_reason = str(getattr(response, "stop_reason", "") or "")
+        blocks = getattr(response, "content", ()) or ()
+        thinking_chars = sum(len(str(getattr(block, "thinking", "") or ""))
+                             for block in blocks if getattr(block, "type", "") == "thinking")
+        # Reasoning models prepend thinking blocks; only text blocks carry the answer.
+        text = "".join(getattr(block, "text", "") for block in blocks
+                       if getattr(block, "type", "") == "text")
+        truncated = stop_reason in {"max_tokens", "length", "model_context_window_exceeded"}
+        self.last_completion = CompletionInfo(self.protocol, stop_reason=stop_reason,
+                                              thinking_chars=thinking_chars, text_chars=len(text),
+                                              truncated=truncated,
+                                              output_tokens=getattr(getattr(response, "usage", None),
+                                                                    "output_tokens", None),
+                                              elapsed_ms=int((time.perf_counter() - t0) * 1000))
+        self.completions.append(self.last_completion)
+        if truncated:
+            raise ExtractionLLMError(f"anthropic output truncated: stop_reason={stop_reason}, "
+                                     f"thinking_chars={thinking_chars}, text_chars={len(text)}", truncated=True)
+        if stop_reason and stop_reason != "end_turn":
+            raise ExtractionLLMError(f"anthropic incomplete response: stop_reason={stop_reason}")
+        if not text.strip():
+            raise ExtractionLLMError(f"anthropic response contains no text block "
+                                     f"(stop_reason={stop_reason or 'unknown'}, "
+                                     f"thinking_chars={thinking_chars})", code="empty_output")
+        return text
+
+    def _complete_openai(self, prompt: str, temperature: float) -> str:
+        client = self._injected_client or self._make_openai_client()
+        create_kwargs: dict[str, Any] = {"model": self.model, "temperature": temperature,
+                                         "messages": [{"role": "user", "content": prompt}]}
+        create_kwargs["max_tokens"] = self.output_budget
+        optional = self._optional_kwargs()
+        create_kwargs.update(optional)
+        t0 = time.perf_counter()
+        try:
+            response = client.chat.completions.create(**create_kwargs)
+        except Exception as exc:
+            if not optional or not _optional_kwargs_rejected(exc):
+                raise
+            for key in optional:
+                create_kwargs.pop(key, None)
+            response = client.chat.completions.create(**create_kwargs)
+        # Gateways answer some failures with an HTML page that the SDK returns
+        # as plain str (observed on new-api 503); fail loudly instead of crashing.
+        if isinstance(response, str):
+            raise ExtractionLLMError("openai endpoint returned a non-chat payload")
+        if not getattr(response, "choices", None):
+            raise ExtractionLLMError("openai endpoint returned no choices")
+        choice = response.choices[0]
+        finish_reason = str(getattr(choice, "finish_reason", "") or "")
+        message = choice.message
+        content = message.content
+        reasoning = getattr(message, "reasoning_content", "") or ""
+        truncated = finish_reason in {"length", "max_tokens"}
+        self.last_completion = CompletionInfo(self.protocol, finish_reason=finish_reason,
+                                              thinking_chars=len(str(reasoning)), text_chars=len(content or ""),
+                                              truncated=truncated,
+                                              output_tokens=getattr(getattr(response, "usage", None),
+                                                                    "completion_tokens", None),
+                                              elapsed_ms=int((time.perf_counter() - t0) * 1000))
+        self.completions.append(self.last_completion)
+        if truncated:
+            raise ExtractionLLMError(f"openai output truncated: finish_reason={finish_reason}, "
+                                     f"thinking_chars={len(str(reasoning))}, "
+                                     f"text_chars={len(content or '')}", truncated=True)
+        if finish_reason and finish_reason != "stop":
+            raise ExtractionLLMError(f"openai incomplete response: finish_reason={finish_reason}")
+        if not content or not content.strip():
+            raise ExtractionLLMError(f"openai response has empty content (finish_reason={finish_reason or 'unknown'}, "
+                                     f"thinking_chars={len(str(reasoning))})", code="empty_output")
+        return content
+
+    def _make_anthropic_client(self):
+        import anthropic
+        return anthropic.Anthropic(api_key=self.api_key, base_url=self.api_base, timeout=self.timeout_s, max_retries=0)
+
+    def _make_openai_client(self):
+        # The openai SDK treats base_url as a full prefix (it appends
+        # "/chat/completions" without adding "/v1"), unlike the anthropic SDK
+        # which appends "/v1/messages" itself. Gateway origins therefore need
+        # the explicit "/v1" or every call lands on an HTML 404 page.
+        from urllib.parse import urlparse
+        parsed = urlparse(self.api_base)
+        base = self.api_base.rstrip("/")
+        if parsed.path in ("", "/") and not base.endswith("/v1"):
+            base += "/v1"
+        from openai import OpenAI
+        return OpenAI(api_key=self.api_key, base_url=base, timeout=self.timeout_s, max_retries=0)
+
+    # ---------------------------------------------------------------- parsing
+    @staticmethod
+    def _load_payload(raw: str, schema: Type[BaseModel]) -> Any:
+        """Coerce the reply text into a schema-shaped JSON payload.
+
+        Strips markdown fences and prose around the JSON body; wraps a bare
+        list into the schema's first list-typed field (e.g. ``assets``).
+        """
+        text = raw.strip()
+        fenced = _FENCE_RE.search(text)
+        if fenced:
+            text = fenced.group(1).strip()
+        payload = _loads_lenient(text)
+        if isinstance(payload, list):
+            for name, field in schema.model_fields.items():
+                if _is_list_field(field):
+                    return {name: payload}
+        return payload
+
+
+def _config_node() -> dict:
+    """Read the optional ``knowledge_extraction`` node from the runtime config.
+
+    节点值同样支持 ``${VAR}`` 占位符（真值在 config/.env），按对话侧
+    ``resolve_env_vars`` 语义展开——裸读占位符会把它当字面量发给网关。
+    """
+    import yaml
+    from pathlib import Path
+    from ..metrics.llm import default_config_path
+    path = default_config_path()
+    if not path or not Path(path).is_file():
+        return {}
+    try:
+        raw = yaml.safe_load(Path(path).read_text(encoding="utf-8"))
+    except Exception:  # noqa: BLE001 — unreadable config falls back to defaults
+        return {}
+    node = raw.get("knowledge_extraction") if isinstance(raw, dict) else None
+    if not isinstance(node, dict):
+        return {}
+    from jiuwenswarm.common.config import resolve_env_vars
+    return resolve_env_vars(node)
+
+
+def _dedicated_channel() -> dict:
+    """Optional dedicated extraction channel: env group > config node, whole-channel only.
+
+    覆盖是整通道替换——model + api_key + api_base 三键配全才生效，部分配置
+    一律忽略并警告回落 models.defaults。逐键混合继承（A 网关的 base 继承
+    B 网关的 key）正是历史 401 配置漂移的根源（kbi-02 首跑实证），不允许。
+    """
+    import sys
+    candidates = []
+    env_channel = {
+        "model_name": os.environ.get("KNOWLEDGE_EXTRACT_MODEL", ""),
+        "api_key": os.environ.get("KNOWLEDGE_EXTRACT_API_KEY", ""),
+        "api_base": os.environ.get("KNOWLEDGE_EXTRACT_API_BASE", ""),
+        "client_provider": os.environ.get("KNOWLEDGE_EXTRACT_CLIENT_PROVIDER", ""),
+        "max_tokens": os.environ.get("KNOWLEDGE_EXTRACT_MAX_TOKENS", ""),
+    }
+    if any(env_channel.values()):
+        candidates.append(("env KNOWLEDGE_EXTRACT_*", env_channel))
+    node = _config_node()
+    if node:
+        candidates.append(("config knowledge_extraction node", {
+            "model_name": str(node.get("model_name") or ""),
+            "api_key": str(node.get("api_key") or ""),
+            "api_base": str(node.get("api_base") or ""),
+            "client_provider": str(node.get("client_provider") or ""),
+            "max_tokens": str(node.get("max_tokens") or ""),
+        }))
+    for source, channel in candidates:
+        if channel["model_name"] and channel["api_key"] and channel["api_base"]:
+            return channel
+        missing = [k for k in ("model_name", "api_key", "api_base") if not channel[k]]
+        print(f"[knowledge-extraction] {source} 缺少 {'/'.join(missing)}，"
+              f"整通道不生效，回落 models.defaults（半混合跨网关是 401 事故根源）",
+              file=sys.stderr)
+    return {}
+
+
+def build_default_provider() -> ExtractionLLMProvider:
+    """Default chat LLM (models.defaults) with optional whole-channel override.
+
+    蒸馏（文档抽取 + schema 派生深化）缺省与对话共用默认 LLM；专用通道经
+    ``_dedicated_channel``（env / config 节点，三键配全才生效）。思考恒禁用
+    （蒸馏是结构化抽取，思考块吃 JSON 输出预算、单批分钟级）——不在覆盖面。
+    """
+    from ..metrics.llm import load_llm_config
+    config = dict(load_llm_config())
+    channel = _dedicated_channel()
+    if channel:
+        config.update({k: v for k, v in channel.items() if v})
+    model = str(config.get("model_name") or "")
+    api_key = str(config.get("api_key") or "")
+    api_base = str(config.get("api_base") or "")
+    if not model or not api_key or not api_base:
+        raise ValueError("default LLM configuration is required for extraction "
+                         "(config.yaml models.defaults)")
+    provider_name = str(config.get("client_provider") or "OpenAI")
+    protocol = "anthropic" if provider_name.lower() == "anthropic" else "openai"
+    try:
+        max_tokens = int(config.get("max_tokens")) if str(config.get("max_tokens") or "").strip() else None
+    except (TypeError, ValueError):
+        max_tokens = None
+    return ExtractionLLMProvider(model=model, api_key=api_key,
+                                  api_base=api_base, protocol=protocol,
+                                  max_tokens=max_tokens,
+                                  disable_thinking=True)
