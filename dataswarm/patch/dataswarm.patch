+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/explore.py —— L3 探索工具：probe_values / check_join。
+
+探索只能补**物理信息**（表、列、join、取值）——缺业务口径（定义）时模型
+只能 clarify，不能靠探查数据自行认定口径（这条边界在编排指令层，不在代码）。
+
+- ``probe_values``：受限的只读 DISTINCT / LIKE 小查询，确认过滤取值；
+  敏感列禁用（快照 is_sensitive 判定，403）；
+- ``check_join``：校验候选 join——两端类型匹配（快照），预算内可选抽样
+  包含率；结果按证据等级记录，未经人工确认的一律推断级。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.common import workspace_context
+from jiuwenswarm.common.dialect_registry import quote_ident
+
+from ..metrics import semantic_link
+from ..sql import service as sql_service
+
+PROBE_MAX_LIMIT = 100
+JOIN_SAMPLE_LIMIT = 1000
+
+# check_join 结果的证据等级（未经人工确认一律推断级）
+JOIN_EVIDENCE_INFERRED = "inferred"
+
+
+def probe_request(body: dict[str, Any]) -> dict[str, Any]:
+    """probe_values（probe 端点入口）。
+
+    Args:
+        body: ``{"source_id", "table", "column", "like"?, "limit"?≤100}``。
+
+    Returns:
+        ``{"values": [...], "column", "table"}``。
+
+    Raises:
+        ValueError: 参数缺失 / 表列不在快照。
+        PermissionError: 敏感列禁用（403）。
+    """
+    source_id = str(body.get("source_id") or "")
+    table_name = str(body.get("table") or "")
+    column_name = str(body.get("column") or "")
+    like = str(body.get("like") or "").strip()
+    limit = max(1, min(int(body.get("limit") or 20), PROBE_MAX_LIMIT))
+    if not (source_id and table_name and column_name):
+        raise ValueError("source_id/table/column 均必填")
+
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    warnings: list[str] = []
+    _refs, snapshots = semantic_link.current_snapshots(warnings)
+    column = _find_column(snapshots, source_id, table_name, column_name)
+    if column is None:
+        raise ValueError(f"表列 {table_name}.{column_name} 不在当前 published 快照内"
+                         "——先经 describe_table 确认对象存在")
+    if column.is_sensitive:
+        raise PermissionError(f"列 {table_name}.{column_name} 为敏感列，禁止取值探查")
+
+    # 标识符引号按快照列的 source_type 选方言：源侧护栏用同方言解析
+    # （sql_guard），文件/采样源已由 registry 归一到 duckdb。硬编码反引号
+    # 会让 duckdb/postgres 方言的源在护栏解析阶段直接报 SQL parse error。
+    dialect = str(getattr(column, "source_type", "") or "duckdb")
+    column_ref = quote_ident(dialect, column_name)
+    value_alias = quote_ident(dialect, "value")
+    cnt_alias = quote_ident(dialect, "cnt")
+    predicate = (f"{column_ref} LIKE '%{_escape_like(like)}%'" if like
+                 else f"{column_ref} IS NOT NULL")
+    sql = (
+        f"SELECT {column_ref} AS {value_alias}, COUNT(*) AS {cnt_alias} "
+        f"FROM {quote_ident(dialect, table_name)} WHERE {predicate} "
+        f"GROUP BY {column_ref} ORDER BY {cnt_alias} DESC LIMIT {limit}"
+    )
+    result = sql_service.run_sql(None, sql, limit=limit, workspace_id=workspace_id,
+                                 source_id=source_id)
+    if not result.get("ok"):
+        raise RuntimeError(f"probe 查询失败: {result.get('error') or 'unknown'}")
+    columns = [str(c) for c in result.get("columns") or []]
+    values: list[str] = []
+    for row in result.get("rows") or ():
+        value = _row_get(row, columns, "value")
+        if value is not None:
+            values.append(str(value))
+    return {
+        "values": values,
+        "column": column_name,
+        "table": table_name,
+        "truncated": bool(result.get("truncated")) or len(values) >= limit,
+    }
+
+
+def check_join_request(body: dict[str, Any]) -> dict[str, Any]:
+    """check_join（check-join 端点入口）。
+
+    Args:
+        body: ``{"source_id", "left": {"table", "column"},
+        "right": {"table", "column"}, "sample"?}``。
+
+    Returns:
+        ``{"type_match", "evidence_level", "inclusion_ratio"?, "status",
+        "temp_scope_fragment", "left", "right"}``——``temp_scope_fragment``
+        供模型并进临时 scope（含两端表列与 join 声明）。
+    """
+    source_id = str(body.get("source_id") or "")
+    left = body.get("left") or {}
+    right = body.get("right") or {}
+    left_table, left_column = str(left.get("table") or ""), str(left.get("column") or "")
+    right_table, right_column = str(right.get("table") or ""), str(right.get("column") or "")
+    sample = bool(body.get("sample"))
+    if not (source_id and left_table and left_column and right_table and right_column):
+        raise ValueError("source_id 与 left/right 的 table/column 均必填")
+
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    warnings: list[str] = []
+    _refs, snapshots = semantic_link.current_snapshots(warnings)
+    left_meta = _find_column(snapshots, source_id, left_table, left_column)
+    right_meta = _find_column(snapshots, source_id, right_table, right_column)
+    if left_meta is None or right_meta is None:
+        raise ValueError("join 两端表列必须在当前 published 快照内（先 describe_table 确认）")
+    if left_meta.is_sensitive or right_meta.is_sensitive:
+        raise PermissionError("敏感列禁止 join 校验")
+
+    type_match = _same_type_family(left_meta.data_type, right_meta.data_type)
+
+    inclusion_ratio: float | None = None
+    if sample and type_match:
+        inclusion_ratio = _sample_inclusion(
+            workspace_id, source_id, left_table, left_column, right_table, right_column,
+            dialect=str(getattr(left_meta, "source_type", "") or "duckdb"))
+
+    status = "compatible" if type_match else "type_mismatch"
+    return {
+        "type_match": type_match,
+        "left_type": left_meta.data_type,
+        "right_type": right_meta.data_type,
+        "inclusion_ratio": inclusion_ratio,
+        "evidence_level": JOIN_EVIDENCE_INFERRED,  # 未确认一律推断级
+        "status": status,
+        "left": {"table": left_table, "column": left_column},
+        "right": {"table": right_table, "column": right_column},
+        "temp_scope_fragment": {
+            "tables": {left_table: [left_column], right_table: [right_column]},
+            "joins": [{
+                "left": f"{left_table}.{left_column}",
+                "right": f"{right_table}.{right_column}",
+                "level": JOIN_EVIDENCE_INFERRED,
+                "status": "candidate",
+            }],
+        },
+    }
+
+
+# ==========================================================================
+# 内部
+# ==========================================================================
+
+def _find_column(snapshots: dict[str, Any], source_id: str, table_name: str, column_name: str):
+    """快照定位列（表名/列名大小写不敏感；返回 ColumnMeta 或 None）。"""
+    for snapshot in snapshots.values():
+        if source_id and snapshot.source.source_id != source_id:
+            continue
+        for table in snapshot.tables:
+            if table.name.lower() != table_name.lower():
+                continue
+            for column in table.columns:
+                if column.name.lower() == column_name.lower() and column.status == "active":
+                    return column
+    return None
+
+
+def _same_type_family(left: str, right: str) -> bool:
+    """基础类型族匹配（int/string/datetime/其他精确匹配）。"""
+    def family(data_type: str) -> str:
+        lowered = str(data_type or "").lower()
+        if any(t in lowered for t in ("int", "serial")):
+            return "int"
+        if any(t in lowered for t in ("char", "text", "enum", "set")):
+            return "string"
+        if any(t in lowered for t in ("date", "time", "year")):
+            return "datetime"
+        return lowered
+
+    return family(left) == family(right)
+
+
+def _sample_inclusion(
+    workspace_id: str, source_id: str,
+    left_table: str, left_column: str, right_table: str, right_column: str,
+    dialect: str = "duckdb",
+) -> float | None:
+    """抽样包含率：左列 DISTINCT 样本中出现在右列的比例（budget 内 best-effort）。
+
+    ``dialect`` 为源侧方言（快照 ColumnMeta.source_type），标识符引号随之
+    选择，与 SQL 护栏的解析方言保持一致。
+    """
+    left, right = quote_ident(dialect, left_column), quote_ident(dialect, right_column)
+    total_alias, hit_alias = quote_ident(dialect, "total"), quote_ident(dialect, "hit")
+    sql = (
+        f"SELECT COUNT(*) AS {total_alias}, "
+        f"SUM(CASE WHEN ({left} IN (SELECT {right} FROM {quote_ident(dialect, right_table)} "
+        f"WHERE {right} IS NOT NULL LIMIT {JOIN_SAMPLE_LIMIT})) THEN 1 ELSE 0 END) AS {hit_alias} "
+        f"FROM (SELECT DISTINCT {left} FROM {quote_ident(dialect, left_table)} "
+        f"WHERE {left} IS NOT NULL LIMIT {JOIN_SAMPLE_LIMIT}) AS {quote_ident(dialect, 'probe_left')}"
+    )
+    result = sql_service.run_sql(None, sql, limit=10, workspace_id=workspace_id,
+                                 source_id=source_id)
+    if not result.get("ok") or not result.get("rows"):
+        return None
+    columns = [str(c) for c in result.get("columns") or []]
+    row = result["rows"][0]
+    total = int(_row_get(row, columns, "total") or 0)
+    hit = int(_row_get(row, columns, "hit") or 0)
+    return round(hit / total, 4) if total else None
+
+
+def _escape_like(value: str) -> str:
+    """LIKE 值转义：通配符（%/_/反斜杠）加单引号。
+
+    值最终拼进单引号字符串字面量——未转义的 ``'`` 可闭合字面量注入 SQL
+    （G.EDV.06），必须一并转成 ``''``。
+    """
+    return (value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+            .replace("'", "''"))
+
+
+def _row_get(row: Any, columns: list[str], key: str) -> Any:
+    """run_sql 行取列：list 行按 ``columns`` 位置序取值（db_connector.query 与
+    source connector 两条路径均返回 list 行）；dict 行直取。列缺席返回 None。
+    """
+    if isinstance(row, dict):
+        return row.get(key)
+    if key in columns:
+        return row[columns.index(key)]
+    return None
