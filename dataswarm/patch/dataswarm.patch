+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/intent.py —— NL → QuerySpec 意图解析（主通路的 LLM 半边）。
+
+LLM **只输出结构化 QuerySpec，不输出 SQL**；SQL 由 :mod:`.compiler` 确定性
+生成（方案 §阶段 5.1）。三条硬约束：
+
+1. **LLM 只能从收窄后的候选目录里选 ``metric_key``**——目录外的 key、越界的
+   ``group_by``/``grain`` 一律判无效，不进编译。
+2. **语义不充分或有实质歧义时返回澄清而非猜测**。
+3. JSON 解析失败重试 1 次，仍失败降级为澄清提问（不猜）。
+"""
+from __future__ import annotations
+
+import datetime
+import json
+import re
+from dataclasses import dataclass, field
+
+from . import llm
+from .context import Catalog, catalog_to_prompt_json, glossary_terms_prompt
+from .errors import QueryPlanError
+from .model import QuerySpec, resolve_dimension
+
+# 意图 JSON 里允许的过滤操作符（与 compiler._FILTER_OPS 对齐）
+_ALLOWED_FILTER_OPS = {"=", "!=", "<>", ">", ">=", "<", "<=", "IN", "NOT IN", "LIKE"}
+
+_SYSTEM_PROMPT = """你是数仓指标查询意图解析器。把用户的自然语言问题转成结构化查询规格 JSON。
+
+规则：
+1. metric_key 只能从「候选指标目录」里选，一个都不许编造。
+2. group_by 只能使用所选指标 allowed_dimensions 里列出的维度。
+3. grain 只能使用所选指标 time_grains 里列出的粒度；未提到时间粒度就省略 grain。
+4. time：用户提到时间就给 dimension（用指标的 time_dimension）、start、end_exclusive（ISO 日期，end 为开区间）；用户没提时间就省略 time 字段（= 全时间窗）。
+5. 只在实质性歧义时澄清（置 spec 为 null 并把疑问写进 clarifications）：多个不同口径的指标都匹配、维度值在候选里对不上、查询对象无法确定。
+用户没提时间（省略 time 即全时间窗）或没提分组（不 group_by 即总计）属于缺省而非歧义，禁止为此追问。
+6. 只输出一个 JSON 对象，不要输出任何解释文字或 markdown 代码块标记。
+
+输出格式：
+{"spec": {"metrics": ["..."], "group_by": ["..."], "time": {"dimension": "...", "start": "YYYY-MM-DD",
+"end_exclusive": "YYYY-MM-DD", "grain": "..."}, "filters": [{"field": "...", "op": "=", "value": "..."}]},
+"clarifications": []}
+
+filters 的 op 只允许 = != <> > >= < <= IN NOT IN LIKE。"""
+
+_FENCE_RE = re.compile(r"^```(?:json)?\s*|\s*```$", re.M)
+
+
+@dataclass(frozen=True)
+class IntentResult:
+    """意图解析结果。
+
+    Args:
+        spec: 解析出的查询规格；澄清时为 None。
+        clarifications: 需要用户澄清的问题列表。
+        raw: LLM 原始输出（追溯用，可能为空串）。
+        attempts: 实际调用 LLM 的次数。
+    """
+
+    spec: QuerySpec | None = None
+    clarifications: tuple[str, ...] = ()
+    raw: str = ""
+    attempts: int = 0
+    errors: tuple[str, ...] = field(default_factory=tuple)
+
+    @property
+    def needs_clarification(self) -> bool:
+        """是否需要向用户澄清。"""
+        return self.spec is None
+
+
+def parse_intent(
+    question: str,
+    catalog: Catalog,
+    *,
+    config_path: str | None = None,
+    today: str | None = None,
+) -> IntentResult:
+    """把自然语言问题解析成 :class:`~.model.QuerySpec`。
+
+    Args:
+        question: 用户问题。
+        catalog: 收窄后的候选目录（:func:`.context.build_catalog`）。
+        config_path: LLM 配置路径；None 用默认。
+        today: 传给 LLM 的「今天」日期（相对时间换算用）；默认取本机日期。
+
+    Returns:
+        :class:`IntentResult`。spec 为 None 时 clarifications 非空。
+    """
+    if not catalog.entries:
+        return IntentResult(clarifications=(catalog.clarification or "候选目录为空",))
+    today = today or datetime.date.today().isoformat()
+    # 术语口径段（口径增强 A/C）：命中术语的 definition 帮 LLM 对齐口径选指标；
+    # 同分歧义术语自带确认指令（语境裁决不了就澄清，不静默任选）
+    term_section = glossary_terms_prompt(catalog.glossary_terms)
+    user_prompt = (
+        f"今天是 {today}。\n\n"
+        + (f"{term_section}\n\n" if term_section else "")
+        + f"候选指标目录（只能从这里选 metric_key）：\n"
+        f"{catalog_to_prompt_json(catalog)}\n\n用户问题：{question}")
+
+    raw, attempts = "", 0
+    feedback = ""
+    for _ in range(2):  # 首次 + 1 次重试
+        attempts += 1
+        prompt = user_prompt if not feedback else f"{user_prompt}\n\n上一次输出的问题：{feedback}，请修正后重新输出。"
+        raw = llm.call_llm_sync(_SYSTEM_PROMPT, prompt,
+                                config_path=config_path, temperature=0.0)
+        if not raw:
+            return IntentResult(
+                clarifications=("LLM 不可用（返回空串），无法解析意图，请稍后重试或改用结构化查询",),
+                raw="", attempts=attempts,
+                errors=("llm_unavailable",))
+        parsed, error = _parse_json(raw)
+        if parsed is not None:
+            spec, clarifications, invalid = _validate_against_catalog(parsed, catalog)
+            if spec is not None:
+                return IntentResult(spec=spec, raw=raw, attempts=attempts)
+            if clarifications:
+                # 合法澄清：LLM 判断语义不充分，直接向用户澄清，不重试
+                return IntentResult(clarifications=tuple(clarifications),
+                                    raw=raw, attempts=attempts)
+            feedback = invalid or "输出结构不符合要求"
+            continue
+        feedback = error or "无法解析为 JSON"
+    return IntentResult(
+        clarifications=(feedback or "意图解析失败",),
+        raw=raw, attempts=attempts, errors=(feedback or "intent_parse_failed",))
+
+
+def _parse_json(raw: str) -> tuple[dict | None, str | None]:
+    """剥掉可能的 markdown 围栏后解析 JSON 对象。"""
+    text = _FENCE_RE.sub("", raw.strip()).strip()
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError as exc:
+        return None, f"不是合法 JSON（{exc.msg}）"
+    if not isinstance(parsed, dict):
+        return None, "顶层必须是对象"
+    return parsed, None
+
+
+def _validate_against_catalog(
+    parsed: dict, catalog: Catalog
+) -> tuple[QuerySpec | None, list[str], str | None]:
+    """按目录约束校验意图输出。
+
+    Returns:
+        ``(spec, clarifications, 无效原因)`` 三态：
+        - spec 非空 → 解析成功；
+        - spec 空且 clarifications 非空 → **合法澄清**（LLM 判断语义不充分，
+          上层直接向用户澄清，不重试）；
+        - 否则 invalid 非空 → 无效输出，回喂重试。
+
+        目录外指标、越界维度/粒度、非法过滤算子、非法时间都判无效并给出
+        可操作的原因。
+    """
+    clarifications = [str(c) for c in (parsed.get("clarifications") or []) if str(c).strip()]
+    spec_raw = parsed.get("spec")
+    if not isinstance(spec_raw, dict):
+        if clarifications:
+            return None, clarifications, None
+        return None, [], "spec 缺失且没有 clarifications"
+    metrics = spec_raw.get("metrics") or []
+    if not isinstance(metrics, list) or not metrics:
+        return None, [], "metrics 不能为空"
+    allowed_by_key = {e.metric_key: e for e in catalog.entries}
+    unknown = [m for m in metrics if m not in allowed_by_key]
+    if unknown:
+        return None, [], f"指标 {', '.join(map(str, unknown))} 不在候选目录内"
+    for key in metrics:
+        entry = allowed_by_key[key]
+        group_by = spec_raw.get("group_by") or []
+        bad_dims = [d for d in group_by
+                    if resolve_dimension(str(d), entry.allowed_dimensions) is None]
+        if bad_dims:
+            return None, [], (f"维度 {', '.join(bad_dims)} 不在 {key} 的允许维度内"
+                          f"（允许 {', '.join(entry.allowed_dimensions) or '无'}）")
+        time_raw = spec_raw.get("time") or {}
+        grain = time_raw.get("grain")
+        if grain and grain not in entry.time_grains:
+            return None, [], (f"粒度 {grain} 不被 {key} 支持"
+                          f"（支持 {', '.join(entry.time_grains) or '无'}）")
+    for flt in spec_raw.get("filters") or []:
+        if not isinstance(flt, dict):
+            return None, [], "filters 里每一项必须是对象"
+        op = str(flt.get("op") or "=").upper()
+        if op not in _ALLOWED_FILTER_OPS:
+            return None, [], f"过滤操作符 {op!r} 不在白名单内"
+    try:
+        spec = QuerySpec.from_dict(spec_raw)
+    except QueryPlanError as exc:
+        return None, [], exc.detail
+    return spec, [], None
