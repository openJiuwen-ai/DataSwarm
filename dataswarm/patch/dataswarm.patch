-function normalizeConfigBoolean(value: unknown): boolean {
-  if (typeof value === 'boolean') {
-    return value;
-  }
-  return ['1', 'true', 'yes', 'on', 'enabled'].includes(
-    String(value ?? '').trim().toLowerCase(),
-  );
