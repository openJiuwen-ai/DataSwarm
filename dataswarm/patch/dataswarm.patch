+    manifest = json.loads((init_ws / out["analysis_id"] / "manifest.json")
+                          .read_text(encoding="utf-8"))
+    assert manifest["open_analysis_enabled"] is False
+
+    capsys.readouterr()
+    monkeypatch.setattr(af, "_open_analysis_enabled", lambda: True)
+    code = af.cmd_init(_args(question="全面复盘", meta_file=None))
+    assert code == 0
+    out = json.loads(capsys.readouterr().out)
+    assert out["open_analysis_enabled"] is True
