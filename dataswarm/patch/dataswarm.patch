@@ -0,0 +1,75 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw-warehouse-design 聚合 DECIMAL 容量防线回归测试。
+
+背景：Doris 的 SUM/AVG(DECIMAL(P,S)) 中间类型是 DECIMAL(38,S)；
+窄精度落库列在聚合结果超上限时会运行时溢出（E-255 Arithmetic overflow）。
+构建器须把窄精度聚合 DECIMAL 自动加宽到 DECIMAL(38,S) 并给 warning。
+"""
+
+import pytest
+
+from metrics import _widen_aggregate_decimal, derive_tables_from_metrics
+from schema import MetricSpec, SemanticSpec
+
+
+def _metric(**overrides):
+    params = dict(
+        metric_name="total_amount_all",
+        display_name="板块累计成交额",
+        value_type="DECIMAL(18,4)",
+        expr="SUM(o.`amount`)",
+        grain=[],
+        source_tables=["bond.ods_stock_daily"],
+        source_aliases={"bond.ods_stock_daily": "o"},
+        table_name="dws_sector_summary",
+        caliber="板块累计成交额",
+    )
+    params.update(overrides)
+    return MetricSpec(**params)
+
+
+@pytest.mark.parametrize(
+    ("value_type", "expr", "expected_dtype", "expect_warning"),
+    [
+        ("DECIMAL(18,4)", "SUM(o.`amount`)", "DECIMAL(38,4)", True),
+        ("decimal(18,4)", "AVG(o.`amount`)", "DECIMAL(38,4)", True),
+        ("DECIMAL(38,4)", "SUM(o.`amount`)", "DECIMAL(38,4)", False),
+        ("DECIMAL(14,9)", "MAX(o.`close`)", "DECIMAL(14,9)", False),
+        ("DECIMAL(18,4)", "o.`amount` / NULLIF(o.`stock_cnt`, 0)", "DECIMAL(18,4)", False),
+        ("DOUBLE", "SUM(o.`ret`)", "DOUBLE", False),
+    ],
+)
+def test_widen_aggregate_decimal(value_type, expr, expected_dtype, expect_warning):
+    metric = _metric(value_type=value_type, expr=expr)
+    dtype, warning = _widen_aggregate_decimal(metric)
+    assert dtype == expected_dtype
+    assert (warning is not None) is expect_warning
+    if expect_warning:
+        assert "DECIMAL(38" in warning
+
+
+def test_derive_tables_widens_narrow_aggregate_decimal():
+    spec = SemanticSpec(
+        name="bond_quant",
+        business="bond",
+        purpose="聚合精度防线",
+        tables=[],
+        metrics=[_metric()],
+    )
+    column_types = {
+        "bond.ods_stock_daily": {
+            "trade_date": ("DATE", False),
+            "amount": ("DECIMAL(15,4)", True),
+        }
+    }
+    derived, errors, warnings = derive_tables_from_metrics(
+        spec, "bond", column_types, "L3_FULL_DW"
+    )
+    assert errors == []
+    assert any(
+        "total_amount_all" in warning and "DECIMAL(38,4)" in warning
+        for warning in warnings
+    )
+    table = next(t for t in derived if t.short_name == "dws_sector_summary")
+    column = next(c for c in table.columns if c.name == "total_amount_all")
+    assert column.dtype == "DECIMAL(38,4)"
