+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFileSync } from 'node:fs';
+import { act, createElement as h } from 'react';
+import { createRoot } from 'react-dom/client';
+import { JSDOM } from 'jsdom';
+import i18next from 'i18next';
+import { I18nextProvider } from 'react-i18next';
+import { getViewportForBounds } from '@xyflow/react';
+import {
+  buildGraphAdj,
+  reachable,
+  removeGraphElements,
+  graphEdgeId,
+  layoutWorkflowGraph,
+  WORKFLOW_GRAPH_METRICS,
+} from '../node_modules/.cache/workflow-graph/model/_shared/workflow/workflowGraphModel.mjs';
+import { toTaskGraphNodes } from '../node_modules/.cache/workflow-graph/model/governance/components/taskGraphModel.mjs';
+import {
+  toWorkflowGraphNodes,
+  applyWorkflowGraphChanges,
+} from '../node_modules/.cache/workflow-graph/model/dataAsset/components/shared/workflowGraphAdapter.mjs';
+import { WorkflowGraph, WorkflowDag, TaskPage, flowHarness } from '../node_modules/.cache/workflow-graph/runtime.mjs';
+
+const resources = Object.fromEntries(
+  ['zh', 'en'].map((language) => [
+    language,
+    {
+      translation: JSON.parse(readFileSync(new URL(`../src/i18n/locales/${language}.json`, import.meta.url), 'utf8')),
+    },
+  ]),
+);
+const topology = (id, parents = []) => ({ id, parents, label: id, taskLabel: id, group: 'DWD' });
+const task = (id, status, duration) => ({
+  task_id: id,
+  task_name: `Task ${id}`,
+  layer: 'DWD',
+  ...(status ? { latest_run: { task_id: id, status, duration_s: duration } } : {}),
+});
+const graph = {
+  nodes: [
+    task('a', 'failed', 0),
+    task('b', 'skipped', null),
+    task('c', 'skipped'),
+    task('d', 'success', 2),
+    task('e', 'skipped'),
+    task('f', 'running', 1),
+    task('g', 'queued'),
+    task('h'),
+  ],
+  edges: [
+    ['a', 'b'],
+    ['b', 'c'],
+    ['a', 'd'],
+    ['d', 'e'],
+    ['a', 'f'],
+    ['a', 'g'],
+  ].map(([from, to]) => ({ from, to })),
+};
+const draft = [
+  {
+    node_id: 'a',
+    task_id: 'same-task',
+    node_name: 'First',
+    group_name: 'ODS',
+    wait_review: true,
+    order_index: 7,
+    upstream_nodes: '',
+  },
+  {
+    node_id: 'b',
+    task_id: 'same-task',
+    node_name: 'Second',
+    group_name: 'DWD',
+    wait_review: false,
+    order_index: 9,
+    upstream_nodes: 'a',
+  },
+  {
+    node_id: 'c',
+    task_id: 'other-task',
+    node_name: 'Third',
+    group_name: 'ADS',
+    wait_review: true,
+    order_index: 11,
+    upstream_nodes: 'b',
+  },
+];
+const tasks = [{ task_id: 'same-task', name: 'Repeated task', executor_type: 'python' }];
+
+test('governance preserves snapshot metadata and only marks failed-to-skipped chains', () => {
+  const before = structuredClone(graph);
+  const nodes = toTaskGraphNodes(graph);
+  assert.deepEqual(graph, before);
+  assert.deepEqual(
+    nodes.filter((node) => node.failureRole).map((node) => [node.id, node.failureRole]),
+    [
+      ['a', 'source'],
+      ['b', 'blocked'],
+      ['c', 'blocked'],
+    ],
+  );
+  assert.equal(nodes[0].durationS, 0);
+  assert.equal(nodes[0].label, 'Task a');
+  assert.equal(nodes[0].taskLabel, 'a');
+  assert.equal(nodes[0].executor, undefined);
+  assert.equal(nodes[7].status, 'unknown');
+  assert.deepEqual(nodes[2].parents, ['b']);
+  assert.throws(() => toTaskGraphNodes({ nodes: graph.nodes, edges: [{ from: 'missing', to: 'a' }] }), /endpoint/);
+});
+
+test('workflow uses node identity for repeated tasks and preserves editor metadata on graph edits', () => {
+  const before = structuredClone(draft);
+  const nodes = toWorkflowGraphNodes(
+    draft,
+    tasks,
+    [
+      { node_id: 'a', status: 'failed' },
+      { node_id: 'b', status: 'success' },
+    ],
+    'Default',
+  );
+  assert.deepEqual(
+    nodes.map((node) => node.status),
+    ['failed', 'success', undefined],
+  );
+  assert.equal(nodes[0].executor, 'python');
+  assert.equal(nodes[2].taskLabel, 'other-task');
+  const changed = removeGraphElements(nodes, new Set(['b']), []);
+  const result = applyWorkflowGraphChanges(draft, changed);
+  assert.deepEqual(result, [draft[0], { ...draft[2], upstream_nodes: '' }]);
+  assert.deepEqual(draft, before);
+});
+
+test('edge deletion and reachability preserve exact arbitrary IDs', () => {
+  const nodes = [topology('a->b'), topology('a'), topology('c', ['a->b']), topology('b->c', ['a'])];
+  assert.notEqual(graphEdgeId('a->b', 'c'), graphEdgeId('a', 'b->c'));
+  const remaining = removeGraphElements(nodes, new Set(), [{ source: 'a->b', target: 'c' }]);
+  assert.deepEqual(remaining[2].parents, []);
+  assert.deepEqual(remaining[3].parents, ['a']);
+  const { downstream } = buildGraphAdj(nodes);
+  assert.deepEqual([...reachable('a', downstream)], ['a', 'b->c']);
+});
+
+async function mount(language, run) {
+  flowHarness.fitCalls = 0;
+  flowHarness.fitOptions = [];
+  flowHarness.viewportCalls = [];
+  const dom = new JSDOM('<div id="root"></div>', { url: 'http://unit.test', pretendToBeVisual: true });
+  const globals = {
+    window: dom.window,
+    document: dom.window.document,
+    HTMLElement: dom.window.HTMLElement,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    fetch: () => {
+      throw new Error('No network in component tests');
+    },
+  };
+  const descriptors = new Map(
+    Object.keys(globals).map((key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)]),
+  );
+  for (const [key, value] of Object.entries(globals))
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  const i18n = i18next.createInstance();
+  await i18n.init({ lng: language, resources, initImmediate: false, showSupportNotice: false });
+  const root = createRoot(document.getElementById('root'));
+  const render = async (element) => act(async () => root.render(h(I18nextProvider, { i18n }, element)));
+  const click = async (element) =>
+    act(async () => element.dispatchEvent(new window.MouseEvent('click', { bubbles: true })));
+  try {
+    await run({ render, click, i18n });
+  } finally {
+    await act(async () => root.unmount());
+    dom.window.close();
+    for (const [key, descriptor] of descriptors) {
+      if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+      else delete globalThis[key];
+    }
+  }
+}
+
+for (const language of ['zh', 'en'])
+  test(`governance shares workflow cards, statuses, duration and read-only controls in ${language}`, async () => {
+    await mount(language, async ({ render, click, i18n }) => {
+      await render(h(TaskPage, { artifact: { graph, runs: [], findings: [] }, showFindings: false }));
+      assert.equal(document.querySelectorAll('.wf-node-card').length, graph.nodes.length);
+      assert.equal(document.querySelectorAll('[data-failure="blocked"]').length, 2);
+      assert.equal(
+        document.querySelector('[data-node-id="a"] .wf-node-duration').textContent,
+        i18n.t('workflowGraph.duration', { value: 0 }),
+      );
+      assert.equal(
+        document.querySelector('[data-node-id="b"] .wf-node-duration').textContent,
+        i18n.t('workflowGraph.notExecuted'),
+      );
+      assert.ok(
+        document.querySelector('[data-node-id="h"]').textContent.includes(i18n.t('workflowGraph.status.unknown')),
+      );
+      assert.equal(
+        document.querySelector('.wf-canvas-toolbar').getAttribute('aria-label'),
+        i18n.t('workflowGraph.controls'),
+      );
+      assert.equal(flowHarness.props.deleteKeyCode, null);
+      assert.equal(flowHarness.props.nodesConnectable, false);
+      assert.ok(flowHarness.props.nodes.every((node) => !node.draggable));
+      assert.equal(flowHarness.props.zoomOnScroll, true);
+      assert.equal(flowHarness.props.fitView, true, 'dashboard fits the full graph on load');
+      assert.deepEqual(flowHarness.props.fitViewOptions, { padding: 0.15, maxZoom: 1 });
+      assert.equal(flowHarness.props.defaultViewport, undefined);
+      assertFullGraphFits(flowHarness.props.fitViewOptions);
+      assert.equal(document.querySelector('.wf-dag-root').dataset.density, 'compact');
+      assert.equal(document.querySelector('.wf-node-card').style.width, '260px');
+      assert.equal(document.querySelector('.wf-dag-canvas').style.height, '100%');
+      assert.equal(document.querySelector('.wf-dag-canvas').style.minHeight, '0');
