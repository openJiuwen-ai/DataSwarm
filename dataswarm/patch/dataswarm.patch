+"""semantic/vector_docs.py —— 物理快照 → 多槽位语义文档（schema 向量召回写入侧）。
+
+设计见 ``docs/archive/delivered/dataagent-schema-vector-design.md`` §4.1。同一对象的不同语义
+侧面（英文标识 / 中文注释 / 表注释上下文）拆成独立文档嵌入——混在一条向量里
+会互相稀释（metrics/embedding.py 实测：整句稀释，「客单价」0.53 → 长问句
+0.12）。
+
+脱敏红线（与 metrics/embedding.py 模块 docstring 同一纪律）：文档文本与
+metadata 只放业务语义词（表名/列名/表注释/列注释）。连接串（``conn_ref``）、
+视图定义原文（``view_definition``）、profile 采样值（``top_k``）、物理类型
+（``data_type``/``column_type``）一律不进——敏感列的**注释**是合法召回信号
+（「客户手机号」），数据值不是；v1 无数据值槽，天然满足。
+"""
+from __future__ import annotations
+
+import hashlib
+from dataclasses import dataclass, field
+from typing import Any
+
+from .model import MetadataSnapshot
+
+# 槽位/索引写入版本：不匹配时，下次同步仅重嵌当前 source 的文档。
+# v2 修复 Semantica 同 ID add 不替换向量后，迁移 v1 中 hash 已新但向量仍旧的索引。
+DOC_VERSION = "2"
+
+
+@dataclass(frozen=True)
+class SchemaDoc:
+    """一条待嵌入文档：确定性 id + 文本 + 台账 metadata。"""
+
+    id: str
+    text: str
+    doc_hash: str
+    metadata: dict[str, Any] = field(default_factory=dict)
+
+
+def _doc_hash(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:32]
+
+
+def _make_doc(workspace_id: str, source_id: str, node_id: str, kind: str,
+              slot: str, text: str, table_name: str,
+              column_name: str = "") -> SchemaDoc:
+    doc_hash = _doc_hash(text)
+    return SchemaDoc(
+        id=f"{node_id}:{slot}",
+        text=text,
+        doc_hash=doc_hash,
+        metadata={
+            "node_id": node_id,
+            "kind": kind,          # "tbl" | "col"
+            "slot": slot,          # "name" | "comment" | "ctx"
+            "source_id": source_id,
+            "workspace_id": workspace_id,
+            "doc_hash": doc_hash,
+            "doc_version": DOC_VERSION,
+            "table_name": table_name,
+            "column_name": column_name,
+        },
+    )
+
+
+def build_docs(workspace_id: str, source_id: str,
+               snapshot: MetadataSnapshot) -> list[SchemaDoc]:
+    """快照 → 多槽位文档列表（只含 active 对象；消失对象由同步层清出）。
+
+    Args:
+        workspace_id: 工作空间 id（metadata 台账与召回过滤用）。
+        source_id: 数据源 id（召回期按源过滤）。
+        snapshot: 采集快照（表/列含注释；视图同表处理，view_definition 不进文本）。
+
+    Returns:
+        文档列表；同一快照两次构建 id/doc_hash 稳定。
+    """
+    docs: list[SchemaDoc] = []
+    for table in snapshot.tables:
+        if table.status != "active":
+            continue
+        table_comment = (table.comment or "").strip()
+        docs.append(_make_doc(workspace_id, source_id, table.node_id, "tbl",
+                              "name", table.fqn, table.name))
+        if table_comment:
+            docs.append(_make_doc(workspace_id, source_id, table.node_id, "tbl",
+                                  "comment", table_comment, table.name))
+        for column in table.columns:
+            if column.status != "active":
+                continue
+            column_comment = (column.comment or "").strip()
+            docs.append(_make_doc(workspace_id, source_id, column.node_id, "col",
+                                  "name", f"{table.name}.{column.name}",
+                                  table.name, column.name))
+            if column_comment:
+                docs.append(_make_doc(workspace_id, source_id, column.node_id, "col",
+                                      "comment", column_comment,
+                                      table.name, column.name))
+            # 表注释给列提供业务上下文；任一为空则该槽无增量语义，跳过
+            if table_comment and column_comment:
+                docs.append(_make_doc(workspace_id, source_id, column.node_id, "col",
+                                      "ctx", f"{table_comment} {column_comment}",
+                                      table.name, column.name))
+    return docs
