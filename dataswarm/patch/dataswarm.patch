+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Physical metadata source adapters."""
+
+from .base import MetadataSourceAdapter
+from .mysql import MySQLMetadataAdapter
+
+
+def metadata_adapter_for(source: dict) -> MetadataSourceAdapter:
+    """Choose a collector from the registered source type without connecting."""
+    from ...datasource.registry import get_source_type
+    from .connector import ConnectorMetadataAdapter
+
+    source_type = str(source.get("source_type") or "").strip().lower()
+    declaration = get_source_type(source_type)
+    if not declaration.released:
+        raise ValueError(f"semantic collection is unavailable for unreleased source type: {source_type}")
+    if declaration.engine not in {"sqlalchemy", "duckdb", "sampled", "staged", "schema_only"}:
+        raise ValueError(f"semantic collection is unavailable for engine: {declaration.engine}")
+    if source.get("engine") and str(source["engine"]) != declaration.engine:
+        raise ValueError("source engine does not match its registered type")
+    if source_type == "mysql":
+        return MySQLMetadataAdapter()
+    return ConnectorMetadataAdapter(source)
+
+
+__all__ = ["MySQLMetadataAdapter", "metadata_adapter_for"]
