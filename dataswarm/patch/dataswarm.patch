+def dataset_names(cat):
+    if cat.get("datasets") is not None:
+        return [d["name"] for d in cat["datasets"]]
+    return [tb["name"] for s in cat.get("schemas", []) for tb in s["tables"]]
+
+
+def norm(rows):
+    """按数值比较（PG 的 numeric 保留尾零，DuckDB 不保留）。"""
+    out = []
+    for row in rows:
+        cells = []
+        for v in row:
+            try:
+                cells.append(f"{float(v):.4f}")
+            except (TypeError, ValueError):
+                cells.append(str(v))
+        out.append(cells)
+    return out
+
