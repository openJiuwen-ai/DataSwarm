+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""指标主通路端到端：Ossie 导入 → 确认映射 → 发布投影 → 编译 → 校验 → 执行 → 追溯。
+
+全链路在 tmp_path 内完成（``e2e`` fixture 见 conftest）：元库/业务库都是临时
+sqlite，图存储是临时目录。不打网络、不读真实 config、不碰本机 ``~/.jiuwenswarm``。
+
+期望值来自上游方案 ``verify_examples.py`` 已核实的夹具：
+
+    east  → gmv 400, paid_order_count 2, aov 200
+    north → gmv 0,   paid_order_count 0, aov None   (分母为 0 → NULL)
+    west  → gmv 200, paid_order_count 1, aov 200
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import service, versioning
+from jiuwenswarm.channels.web.dataagent.metrics.model import QuerySpec, TimeRange
+
+WORKSPACE = "demo"
+
+
+def _import_and_publish(e2e, *, confirm: bool = True) -> dict:
+    """导入 Ossie 样例 →（可选）确认 ratio 角色 → 发布 → 模拟语义采集。"""
+    from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, write_published_snapshot
+
+    imported = versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE,
+        target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    assert imported["created"] is True
+    assert len(imported["revisions"]) == 3
+
+    if confirm:
+        # 找到 aov 的 numerator/denominator 候选并确认
+        from jiuwenswarm.channels.web.dataagent.metrics import store
+        for revision_id in _all_revisions():
+            for mapping in store.list_concept_maps(revision_id, status="candidate"):
+                if mapping.relation_type in ("numerator", "denominator"):
+                    versioning.confirm_mapping(mapping.mapping_id, confirmed_by="tester")
+
+    revision_ids = _all_revisions()
+    write_published_snapshot(e2e)
+    release = versioning.publish_release(
+        WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+        label="首次发布", published_by="tester")
+    return {"imported": imported, "release": release, "revision_ids": revision_ids}
+
+
+def _all_revisions() -> list[str]:
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+    out: list[str] = []
+    for metric in store.list_defs(WORKSPACE):
+        out.extend(r.revision_id for r in store.list_revisions(metric.metric_id))
+    return out
+
+
+_AOV_SPEC = QuerySpec(
+    metrics=("commerce.aov",),
+    group_by=("orders.region",),
+    time=TimeRange(
+        dimension="orders.paid_at",
+        start="2026-08-01", end_exclusive="2026-09-01",
+    ),
+)
+
+
+# ==========================================================================
+# 用例
+# ==========================================================================
+def test_e2e_publish_then_query_aov(e2e):
+    """全链路主通路：发布后查 8 月各地区支付客单价，得三行期望值。"""
+    published = _import_and_publish(e2e, confirm=True)
+    assert published["release"].status == "published"
+
+    result = service.query(_AOV_SPEC, WORKSPACE, question="8 月各地区支付客单价")
+    assert result.path == "compiler"
+    assert result.authoritative is True
+
+    by_region = {row["region"]: row for row in result.rows}
+    assert set(by_region) == {"east", "north", "west"}
+    assert float(by_region["east"]["commerce_aov"]) == 200.0
+    assert by_region["north"]["commerce_aov"] is None, "分母为 0 时必须返回 NULL 而不是除零报错"
+    assert float(by_region["west"]["commerce_aov"]) == 200.0
+    assert result.row_count == 3
+
+
+def test_e2e_atomic_metrics_match_upstream_fixture(e2e):
+    """原子指标 gmv / paid_order_count 与上游 verify_examples.py 的期望值一致。"""
+    _import_and_publish(e2e, confirm=True)
+    from jiuwenswarm.channels.web.dataagent.metrics.model import QuerySpec as QS, TimeRange as TR
+
+    spec = QS(
+        metrics=("commerce.gmv", "commerce.paid_order_count"),
+        group_by=("orders.region",),
+        time=TR(dimension="orders.paid_at", start="2026-08-01", end_exclusive="2026-09-01"),
+    )
+    result = service.query(spec, WORKSPACE)
+    by_region = {row["region"]: row for row in result.rows}
+    assert float(by_region["east"]["commerce_gmv"]) == 400.0
+    assert int(by_region["east"]["commerce_paid_order_count"]) == 2
