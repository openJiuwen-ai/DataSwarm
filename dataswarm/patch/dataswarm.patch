+@register_source_type
+class SqliteAdapter(SourceTypeAdapter):
+    """SQLite 单文件库：走与 mysql 同款的 create → bind → 派生/语义采集通路。
+
+    ref 形态 sqlite://<绝对路径>（workspace_context.normalize_db_ref 同款归一）。
+    注意：fields 不含 database，_probe_blocked 视为文件型不做保存前探活——
+    路径有效性由 test_connection（表单/手工）与绑定后的采集任务兜底。
+    """
+
+    type_id = "sqlite"
+    label = "SQLite"
+    category = "file"
+    # 走 SqlAlchemyConnector 的 sqlite URL 分支（_url_for 按 path 建sqlite:///<path>），
+    # catalog/preview/query 由连接器框架承接；此前 engine="sqlite" 无对应引擎注册，
+    # 数据源 API 首次调用即 ValueError（源仓 test_source_type_conformance 照亮的存量缺口）。
+    engine = "sqlalchemy"
+    capabilities = {"test_connection", "catalog", "schema", "preview", "sql_query", "semantic_collection"}
+    fields = [
+        SourceField("path", "Database File Path", required=True, placeholder="D:/data/chinook.db"),
+    ]
+
+    def validate(self, params: dict) -> None:
+        path = str(params.get("path", "")).strip()
+        if not path:
+            raise ValueError("path is required for sqlite source")
+        from ..connectors.paths import resolve_local_path
+
+        try:
+            resolve_local_path(path, must_exist=False)
+        except Exception as exc:
+            raise ValueError(str(exc)) from exc
+
+    def build_ref(self, config: dict) -> str:
+        path = Path(str(config.get("path", ""))).expanduser()
+        return f"sqlite://{path.resolve()}"
+
+    def test_connection(self, config: dict) -> dict:
+        import sqlite3
+
+        path = Path(str(config.get("path", ""))).expanduser()
+        if not path.exists():
+            return {"ok": False, "error": f"file not found: {path}"}
+        try:
+            conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+            try:
+                (n_tables,) = conn.execute(
+                    "SELECT count(*) FROM sqlite_master"
+                    " WHERE type='table' AND name NOT LIKE 'sqlite_%'"
+                ).fetchone()
+                return {"ok": True, "message": f"SQLite database readable ({n_tables} tables)"}
+            finally:
+                conn.close()
+        except Exception as exc:
+            return {"ok": False, "error": str(exc)}
+
