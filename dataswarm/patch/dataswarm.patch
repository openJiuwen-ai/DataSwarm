+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** BI看板 REST API 层。 */
+
+import type {
+  DimensionDef,
+  DashboardDef,
+  CardDef,
+  RenderedCard,
+  RenderedDashboard,
+  DimensionInput,
+  DashboardInput,
+  CardInput,
+  DashboardFilters,
+} from '../types/dashboard';
+import {
+  ensureDatasourceWorkspaceId,
+  responseBelongsToCurrentWorkspace,
+} from '../../../stores/datasourceWorkspaceStore';
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  // 多工作空间（P2-4）：看板 API 统一注入当前 workspace_id
+  const wsId = await ensureDatasourceWorkspaceId();
+  const requestAt = wsId;
+  const target = wsId ? `${url}${url.includes('?') ? '&' : '?'}workspace_id=${encodeURIComponent(wsId)}` : url;
+  const response = await fetch(target, {
+    ...init,
+    headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const payload = await response.json().catch(() => ({})) as Record<string, unknown>;
+  if (!response.ok) {
+    const detail = typeof payload.error === 'string' ? payload.error
+      : typeof payload.detail === 'string' ? payload.detail
+      : `${response.status} ${response.statusText}`;
+    throw new Error(detail);
+  }
+  if (!responseBelongsToCurrentWorkspace(payload, requestAt)) {
+    throw new Error('workspace_changed');
+  }
+  return payload as T;
+}
+
+const enc = encodeURIComponent;
+
+export const dashboardApi = {
+  // ---- 维度 ----
+  listDimensions: () => request<{ dimensions: DimensionDef[] }>('/api/dataagent/dashboard/dimensions'),
+  getDimension: (id: string) => request<DimensionDef>(`/api/dataagent/dashboard/dimensions/${enc(id)}`),
+  createDimension: (input: DimensionInput) => request<DimensionDef>('/api/dataagent/dashboard/dimensions', { method: 'POST', body: JSON.stringify(input) }),
+  updateDimension: (id: string, input: DimensionInput) => request<DimensionDef>(`/api/dataagent/dashboard/dimensions/${enc(id)}/update`, { method: 'POST', body: JSON.stringify(input) }),
+  deleteDimension: (id: string) => request<{ ok: boolean }>(`/api/dataagent/dashboard/dimensions/${enc(id)}/delete`, { method: 'POST' }),
+  getDimensionValues: (id: string) => request<{ values: string[] }>(`/api/dataagent/dashboard/dimensions/${enc(id)}/values`),
+
+  // ---- 看板 ----
+  listDashboards: (status?: string, owner?: string) =>
+    request<{ dashboards: DashboardDef[] }>(`/api/dataagent/dashboard/dashboards${status || owner ? `?${new URLSearchParams(Object.entries({ status: status || '', owner: owner || '' }).filter(([, v]) => v)).toString()}` : ''}`),
+  getDashboard: (id: string) => request<DashboardDef>(`/api/dataagent/dashboard/dashboards/${enc(id)}`),
+  createDashboard: (input: DashboardInput) => request<DashboardDef>('/api/dataagent/dashboard/dashboards', { method: 'POST', body: JSON.stringify(input) }),
+  updateDashboard: (id: string, input: DashboardInput) => request<DashboardDef>(`/api/dataagent/dashboard/dashboards/${enc(id)}/update`, { method: 'POST', body: JSON.stringify(input) }),
+  deleteDashboard: (id: string) => request<{ ok: boolean }>(`/api/dataagent/dashboard/dashboards/${enc(id)}/delete`, { method: 'POST' }),
+  renderDashboard: (id: string, forceRefresh?: boolean, filters?: DashboardFilters) =>
+    request<RenderedDashboard>(`/api/dataagent/dashboard/dashboards/${enc(id)}/render`, {
+      method: 'POST',
+      body: JSON.stringify({
+        force_refresh: forceRefresh ?? false,
+        time_range: filters?.time_range,
+        dimensions: filters?.dimensions,
+      }),
+    }),
+
+  // ---- 看板卡片 ----
+  listCards: (dashboardId: string) => request<{ cards: CardDef[] }>(`/api/dataagent/dashboard/dashboards/${enc(dashboardId)}/cards`),
+  createCard: (dashboardId: string, input: CardInput) => request<CardDef>(`/api/dataagent/dashboard/dashboards/${enc(dashboardId)}/cards`, { method: 'POST', body: JSON.stringify(input) }),
+  updateCard: (dashboardId: string, cardId: string, input: CardInput) => request<CardDef>(`/api/dataagent/dashboard/dashboards/${enc(dashboardId)}/cards/${enc(cardId)}/update`, { method: 'POST', body: JSON.stringify(input) }),
+  deleteCard: (dashboardId: string, cardId: string) => request<{ ok: boolean }>(`/api/dataagent/dashboard/dashboards/${enc(dashboardId)}/cards/${enc(cardId)}/delete`, { method: 'POST' }),
+  reorderCards: (dashboardId: string, cardIds: string[]) => request<{ ok: boolean }>(`/api/dataagent/dashboard/dashboards/${enc(dashboardId)}/reorder`, { method: 'POST', body: JSON.stringify({ card_ids: cardIds }) }),
+  renderCard: (cardId: string, forceRefresh?: boolean) => request<RenderedCard>(`/api/dataagent/dashboard/cards/${enc(cardId)}/render`, { method: 'POST', body: JSON.stringify({ force_refresh: forceRefresh }) }),
+
+  // ---- 从 dw-report 导入 ----
+  importFromReport: (specPath: string, dashboardName?: string, datasourceRef?: string) =>
+    request<DashboardDef>('/api/dataagent/dashboard/import-from-report', { method: 'POST', body: JSON.stringify({ spec_path: specPath, dashboard_name: dashboardName, datasource_ref: datasourceRef }) }),
+};
