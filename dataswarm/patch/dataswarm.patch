new file mode 100644
index 000000000..49c7b15f8
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/connectors/paths.py
@@ -0,0 +1,76 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""本地数据文件路径沙箱。"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from .errors import FileAccessError
+
+
+def allowed_roots() -> list[Path]:
+    raw = os.environ.get("JIUWENSWARM_DATA_ROOTS", "").strip()
+    if raw:
+        values = raw.split(os.pathsep)
+    else:
+        values = [str(Path.cwd() / "data")]
+    return [Path(value).expanduser().resolve() for value in values if value.strip()]
+
+
+def staged_cache_root() -> Path:
+    """返回远端文件的受控本地缓存根目录。
+
+    FTP/SFTP/HDFS 下载后交给 DuckDB 查询。缓存路径不能由用户指定的远端路径
+    直接决定，以避免目录穿越。
+    """
+    raw = os.environ.get("JIUWENSWARM_STAGED_CACHE", "").strip()
+    root = Path(raw).expanduser() if raw else (allowed_roots()[0] / ".staged")
+    root = root.resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    return root
+
+
+def staged_cache_quota_bytes() -> int:
+    """暂存目录总配额（字节）。默认 2 GiB，超限时按最旧优先清理。"""
+    raw = os.environ.get("JIUWENSWARM_STAGED_CACHE_QUOTA", "").strip()
+    try:
+        value = int(raw) if raw else 0
+    except ValueError:
+        value = 0
+    return value if value > 0 else 2 * 1024 * 1024 * 1024
+
+
+def staged_cache_ttl_seconds() -> int:
+    """暂存文件的最大保留时长（秒）。默认 7 天。"""
+    raw = os.environ.get("JIUWENSWARM_STAGED_CACHE_TTL", "").strip()
+    try:
+        value = int(raw) if raw else 0
+    except ValueError:
+        value = 0
+    return value if value > 0 else 7 * 24 * 3600
+
+
+def resolve_staged_path(value: str) -> Path:
+    """校验一个路径确实落在暂存根目录内（防目录穿越）。"""
+    root = staged_cache_root()
+    resolved = Path(value).expanduser().resolve()
+    if resolved != root and root not in resolved.parents:
+        raise FileAccessError(f"staged path escapes cache root: {value}")
+    return resolved
+
+
+def resolve_local_path(value: str, must_exist: bool = True) -> Path:
+    if not value or "://" in value:
+        raise FileAccessError("a local relative path is required")
+    candidate = Path(value).expanduser()
+    roots = allowed_roots()
+    if candidate.is_absolute():
+        resolved = candidate.resolve()
+    else:
+        resolved = (roots[0] / candidate).resolve()
+        if not any(resolved == root or root in resolved.parents for root in roots):
+            raise FileAccessError("relative file path is outside allowed data roots")
+    if must_exist and not resolved.exists():
+        raise FileAccessError(f"file not found: {value}")
+    return resolved
diff --git a/jiuwenswarm/channels/web/dataagent/connectors/sampled_connector.py b/jiuwenswarm/channels/web/dataagent/connectors/sampled_connector.py
new file mode 100644
index 000000000..82ce39c1c
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/connectors/sampled_connector.py
@@ -0,0 +1,681 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""文档和键值存储的采样建模与有界物化连接器。
+
+采样推断 schema 后，通过谓词下推取数并物化到 DuckDB，聚合与关联使用 SQL
+执行，不进行 SQL 到原生查询语言的通用翻译。materialize_limit 限制本地行数，
+超限结果保留截断标记，调用方不能将其视为完整集合分析。
+
+同一字段出现多种类型时，infer_schema 保留观察到的类型并标为 mixed；
+schema 及 presence 均反映采样结果，不代表所有文档。
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from .base import Connector, SourceDefinition, build_catalog, build_schema, register_engine
+from .errors import ConnectorDependencyError, ConnectorError
+from .sql_guard import validate_read_only_sql
+
+#: 采样推断 schema 的默认文档数。
+DEFAULT_SAMPLE = 1000
+#: 单次查询物化进 DuckDB 的默认行数上限。
+DEFAULT_MATERIALIZE_LIMIT = 50_000
+#: 限制嵌套对象展平深度，避免列数随深层结构增长。
+MAX_FLATTEN_DEPTH = 3
+
+#: BSON/Python 类型 → 逻辑类型名（写进 schema 的 ``type`` 字段）。
+_TYPE_NAMES: dict[type, str] = {
+    bool: "BOOLEAN",
+    int: "BIGINT",
+    float: "DOUBLE",
+    str: "VARCHAR",
+    bytes: "BLOB",
+}
+
+
+def _type_name(value: Any) -> str:
+    import datetime as _dt
+    from decimal import Decimal
+
+    if value is None:
+        return "NULL"
+    if isinstance(value, bool):
+        return "BOOLEAN"
+    for python_type, name in _TYPE_NAMES.items():
+        if isinstance(value, python_type):
+            return name
+    if isinstance(value, Decimal):
+        return "DECIMAL"
+    if isinstance(value, (_dt.datetime, _dt.date)):
+        return "TIMESTAMP"
+    if isinstance(value, (list, tuple)):
+        return "JSON"
+    if isinstance(value, dict):
+        return "JSON"
+    return "VARCHAR"
+
+
+def _flatten(doc: dict, prefix: str = "", depth: int = 0) -> dict[str, Any]:
+    """嵌套文档展平成点号路径。
+
+    数组整体记为 JSON（不展开成 a.0 / a.1——下标会让列集随数据长度漂移）。
+    超过 ``MAX_FLATTEN_DEPTH`` 的子树整体记为 JSON。
+    """
+    out: dict[str, Any] = {}
+    for key, value in doc.items():
+        path = f"{prefix}{key}"
+        if isinstance(value, dict) and depth < MAX_FLATTEN_DEPTH:
+            nested = _flatten(value, prefix=f"{path}.", depth=depth + 1)
+            if nested:
+                out.update(nested)
+            else:
+                out[path] = {}
+        else:
+            out[path] = value
+    return out
+
+
+def _jsonable(value: Any) -> Any:
+    """物化进 DuckDB 前的值归一（ObjectId / datetime / 嵌套结构）。"""
+    import datetime as _dt
+    from decimal import Decimal
+
+    if value is None or isinstance(value, (bool, int, float, str)):
+        return value
+    if isinstance(value, Decimal):
+        return float(value)
+    if isinstance(value, (_dt.datetime, _dt.date)):
+        return value.isoformat()
+    if isinstance(value, (list, tuple, dict)):
+        return json.dumps(value, ensure_ascii=False, default=str)
+    return str(value)
+
+
+# ======================================================================
+# 采样存储的抽象
+# ======================================================================
+class SampledStore:
+    """非 SQL 存储的最小接口：列数据集 + 采样 + 扫描。"""
+
+    def list_datasets(self) -> list[str]:
+        raise NotImplementedError
+
+    def sample(self, dataset: str, size: int) -> list[dict]:
+        raise NotImplementedError
+
+    def scan(self, dataset: str, filters: dict | None, projection: list[str] | None,
+             limit: int) -> list[dict]:
+        raise NotImplementedError
+
+    def close(self) -> None:
+        return None
+
+
+class MongoStore(SampledStore):
+    """MongoDB —— pymongo。"""
+
+    def __init__(self, config: dict):
+        try:
+            from pymongo import MongoClient
+        except ImportError as exc:
+            raise ConnectorDependencyError(
+                "pymongo 未安装，请 pip install 'jiuwenswarm[ds-mongodb]'"
+            ) from exc
+        host = str(config.get("host") or "127.0.0.1")
+        port = int(config.get("port") or 27017)
+        user = str(config.get("user") or "")
+        password = str(config.get("password") or "")
+        database = str(config.get("database") or "")
+        if not database:
+            raise ConnectorError("database is required for mongodb source")
+        kwargs: dict[str, Any] = {
+            "host": host,
+            "port": port,
+            "serverSelectionTimeoutMS": 8000,
+            "connectTimeoutMS": 8000,
+        }
+        if user:
+            kwargs["username"] = user
+            kwargs["password"] = password
+            kwargs["authSource"] = str(config.get("auth_source") or database)
+        self._client = MongoClient(**kwargs)
+        self._db = self._client[database]
+
+    def list_datasets(self) -> list[str]:
+        return sorted(self._db.list_collection_names())
+
+    def sample(self, dataset: str, size: int) -> list[dict]:
+        return list(self._db[dataset].find({}, limit=max(1, int(size))))
+
+    def scan(self, dataset: str, filters: dict | None, projection: list[str] | None,
+             limit: int) -> list[dict]:
+        # 谓词与投影下推到服务端，别把整集合拉回来再过滤。
+        proj = {name: 1 for name in projection} if projection else None
+        cursor = self._db[dataset].find(filters or {}, proj, limit=max(1, int(limit)))
+        return list(cursor)
+
+    def ping(self) -> dict:
+        info = self._client.server_info()
+        return {"version": info.get("version", ""), "ok": True}
+
+    def close(self) -> None:
+        try:
+            self._client.close()
+        except Exception:  # noqa: BLE001
+            pass
+
+
+class RedisStore(SampledStore):
+    """将显式声明的 Redis 数据结构映射为逻辑表。
+
+    hash:<pattern> 每个 Hash key 对应一行；stream:<key> 每条消息对应一行；
+    zset:<key> 对应 member/score 两列。只使用受 max_keys 限制的 SCAN 游标，
+    不使用 KEYS；拒绝等价于全库通配的 Hash pattern。
+    """
+
+    #: 逻辑表名的前缀 → 结构类型
+    KINDS = ("hash", "stream", "zset")
+    #: 单次 SCAN 的键数上限
+    DEFAULT_MAX_KEYS = 5000
+
+    def __init__(self, config: dict):
+        try:
+            import redis
+        except ImportError as exc:
+            raise ConnectorDependencyError(
+                "redis 未安装，请 pip install 'jiuwenswarm[ds-redis]'"
+            ) from exc
+        self._client = redis.Redis(
+            host=str(config.get("host") or "127.0.0.1"),
+            port=int(config.get("port") or 6379),
+            db=int(config.get("db") or 0),
+            password=str(config.get("password") or "") or None,
+            socket_timeout=8,
+            decode_responses=True,
+        )
+        self._datasets = [
+            item.strip() for item in
+            str(config.get("datasets") or "").split(",") if item.strip()
+        ]
+        try:
+            self._max_keys = int(config.get("max_keys") or 0) or self.DEFAULT_MAX_KEYS
+        except (TypeError, ValueError):
+            self._max_keys = self.DEFAULT_MAX_KEYS
+
+    @classmethod
+    def parse_dataset(cls, dataset: str) -> tuple[str, str]:
+        """``hash:order:*`` → ("hash", "order:*")。"""
+        kind, _, pattern = str(dataset or "").partition(":")
+        kind = kind.strip().lower()
+        if kind not in cls.KINDS:
+            raise ConnectorError(
+                f"redis 数据集名必须形如 <kind>:<pattern>，kind ∈ "
+                f"{'/'.join(cls.KINDS)}；实得 {dataset!r}"
+            )
+        pattern = pattern.strip()
+        if not pattern:
+            raise ConnectorError(f"redis 数据集 {dataset!r} 缺少 key pattern")
+        if pattern in ("*", "**"):
+            # 全键空间扫描在生产库上会打挂实例，直接拒绝
+            raise ConnectorError(
+                "拒绝全键空间扫描（pattern 为 '*'）——请给出更具体的 key pattern"
+            )
+        return kind, pattern
+
+    def list_datasets(self) -> list[str]:
+        """逻辑表由配置显式声明，**不扫全库推断**。
+
+        这与 MongoDB 不同：Mongo 的 collection 列表是廉价的元数据查询，
+        而 Redis 要靠扫 key 才能知道有哪些「表」，代价和风险都不可接受。
+        """
+        if not self._datasets:
+            raise ConnectorError(
+                "redis 源必须显式声明 datasets（形如 "
+                "hash:order:*,stream:events），不支持扫全库自动发现"
+            )
+        for dataset in self._datasets:
+            self.parse_dataset(dataset)
+        return sorted(self._datasets)
+
+    def _scan_keys(self, pattern: str, limit: int) -> list[str]:
+        keys: list[str] = []
+        for key in self._client.scan_iter(match=pattern, count=500):
+            keys.append(key)
+            if len(keys) >= min(limit, self._max_keys):
+                break
+        return keys
+
+    #: 取 Hash 时每批流水线的 key 数。
+    PIPELINE_BATCH = 1000
+
+    def sample(self, dataset: str, size: int) -> list[dict]:
+        kind, pattern = self.parse_dataset(dataset)
+        if kind == "hash":
+            # 每个 Hash key 对应一行；流水线减少逐 key HGETALL 的网络往返。
+            keys = self._scan_keys(pattern, size)
+            rows: list[dict] = []
+            for start in range(0, len(keys), self.PIPELINE_BATCH):
+                batch = keys[start:start + self.PIPELINE_BATCH]
+                pipe = self._client.pipeline(transaction=False)
+                for key in batch:
+                    pipe.hgetall(key)
+                for key, fields in zip(batch, pipe.execute()):
+                    rows.append({"_key": key, **(fields or {})})
+            return rows
+        if kind == "zset":
+            rows = self._client.zrevrange(pattern, 0, max(0, size - 1), withscores=True)
+            return [{"member": m, "score": s} for m, s in rows]
+        # stream
+        entries = self._client.xrevrange(pattern, count=max(1, size))
+        return [{"_id": eid, **(fields or {})} for eid, fields in entries]
+
+    def scan(self, dataset: str, filters: dict | None, projection: list[str] | None,
+             limit: int) -> list[dict]:
+        # Redis 没有服务端谓词下推能力（除 key pattern 本身），所以 filters
+        # 只能在取回后过滤——如实说明，不假装下推。
+        docs = self.sample(dataset, limit)
+        if filters:
+            docs = [d for d in docs
+                    if all(str(d.get(k)) == str(v) for k, v in filters.items())]
+        return docs[:limit]
+
+    def ping(self) -> dict:
+        info = self._client.info("server")
+        return {"version": info.get("redis_version", ""), "ok": True}
+
+    def close(self) -> None:
+        try:
+            self._client.close()
+        except Exception:  # noqa: BLE001
+            pass
+
+
+class HBaseStore(SampledStore):
+    """通过 happybase/Thrift 读取 HBase，需要服务端启用 Thrift Server。
+
+    列名保留 column_family:qualifier，RowKey 映射为 _row。schema 推断受
+    sample_size 限制，presence 记录字段在样本中的出现频次。
+    """
+
+    # RowKey 不是 HBase 的列，是本连接器合成出来的一列（见 _row_to_doc）
+    ROW_KEY_COLUMN = "_row"
+
+    def __init__(self, config: dict):
+        try:
+            import happybase
+        except ImportError as exc:
+            raise ConnectorDependencyError(
+                "happybase 未安装，请 pip install 'jiuwenswarm[ds-hbase]'；"
+                "另需 HBase 集群开启 Thrift Server"
+            ) from exc
+        self._connection = happybase.Connection(
+            host=str(config.get("host") or "127.0.0.1"),
+            port=int(config.get("port") or 9090),
+            timeout=10000,
+            autoconnect=True,
+        )
+
+    def list_datasets(self) -> list[str]:
+        return sorted(
+            name.decode() if isinstance(name, bytes) else str(name)
+            for name in self._connection.tables()
+        )
+
+    @staticmethod
+    def _row_to_doc(row_key, data: dict) -> dict:
+        def _text(value):
+            return value.decode("utf-8", "replace") if isinstance(value, bytes) else value
+
+        doc = {HBaseStore.ROW_KEY_COLUMN: _text(row_key)}
+        for column, value in (data or {}).items():
+            doc[_text(column)] = _text(value)
+        return doc
+
+    @classmethod
+    def _pushdown_columns(cls, projection: list[str] | None) -> list[bytes] | None:
+        """挑出能下推给 HBase 的列。
+
+        ``_row`` 是本连接器合成的 RowKey 列，HBase 侧并不存在。原样下推会被
+        RegionServer 以 ``NoSuchColumnFamilyException`` 拒掉——HBase 把不带冒号
+        的名字当列族看。而它出现在 ``infer_schema`` 的列清单里，上层按列清单
+        选列时必然会传下来，所以必须在这里剔除。
+
+        RowKey 本来就随每行返回，不需要也无法单独投影：只取 RowKey 要用
+        ``FirstKeyOnlyFilter``，那是 HBase 自己的 filter 语法，与「不自研谓词
+        翻译」同一纪律，不碰。只选了合成列时退化为全列扫，再由上层裁列。
+        """
+        if not projection:
+            return None
+        real = [c for c in projection if c != cls.ROW_KEY_COLUMN]
+        if not real:
+            return None
+        return [c.encode() for c in real]
+
+    def sample(self, dataset: str, size: int) -> list[dict]:
+        table = self._connection.table(dataset)
+        return [
+            self._row_to_doc(key, data)
+            for key, data in table.scan(limit=max(1, int(size)))
+        ]
+
+    def scan(self, dataset: str, filters: dict | None, projection: list[str] | None,
+             limit: int) -> list[dict]:
+        table = self._connection.table(dataset)
+        # 真实列能下推（HBase 原生支持按列取），合成列不能（见 _pushdown_columns）；
+        # 谓词也不能——HBase 的 filter 语法另一套，这里不自研翻译
+        # （与不自研 SQL→MQL 同一纪律）。
+        columns = self._pushdown_columns(projection)
+        rows = [
+            self._row_to_doc(key, data)
+            for key, data in table.scan(columns=columns, limit=max(1, int(limit)))
+        ]
+        if filters:
+            rows = [r for r in rows
+                    if all(str(r.get(k)) == str(v) for k, v in filters.items())]
+        return rows[:limit]
+
+    def close(self) -> None:
+        try:
+            self._connection.close()
+        except Exception:  # noqa: BLE001
+            pass
+
+
+_STORES: dict[str, type[SampledStore]] = {
+    "mongodb": MongoStore,
+    "redis": RedisStore,
+    "hbase": HBaseStore,
+}
+
+
+# ======================================================================
+# 连接器
+# ======================================================================
+@register_engine("sampled")
+class SampledStoreConnector(Connector):
+    """采样推断结构并将有界扫描结果物化到 DuckDB。
+
+        同时实现 TabularScannable 和 SqlQueryable，分别提供扫描能力与物化后的 SQL 能力。
+    """
+
+    engine = "sampled"
+
+    def __init__(self, source: SourceDefinition):
+        self.source = source
+        self._store: SampledStore | None = None
+        self._schema_cache: dict[str, dict] = {}
+
+    # ------------------------------------------------------------------ #
+    def _store_for(self) -> SampledStore:
+        if self._store is not None:
+            return self._store
+        kind = self.source.source_type
+        store_cls = _STORES.get(kind)
+        if store_cls is None:
+            raise ConnectorError(
+                f"unsupported sampled store: {kind}"
+                f"（支持 {'/'.join(sorted(_STORES))}）"
+            )
+        self._store = store_cls(dict(self.source.config))
+        return self._store
+
+    def _sample_size(self) -> int:
+        try:
+            return max(1, int(self.source.config.get("sample_size") or DEFAULT_SAMPLE))
+        except (TypeError, ValueError):
+            return DEFAULT_SAMPLE
+
+    def _materialize_limit(self) -> int:
+        try:
+            value = int(self.source.config.get("materialize_limit") or 0)
+        except (TypeError, ValueError):
+            value = 0
+        return value if value > 0 else DEFAULT_MATERIALIZE_LIMIT
+
+    # ------------------------------------------------------------------ #
+    # 通用端口
+    # ------------------------------------------------------------------ #
+    def test_connection(self) -> dict:
+        try:
+            store = self._store_for()
+            detail = store.ping() if hasattr(store, "ping") else {}
+            names = store.list_datasets()
+            return {
+                "ok": True,
+                "message": (f"connected (server {detail.get('version', '?')}), "
+                            f"{len(names)} collection(s)"),
+                "engine": self.engine,
+            }
+        except Exception as exc:  # noqa: BLE001 —— 连接失败是预期结果
+            return {"ok": False, "error": str(exc), "engine": self.engine}
+
+    def catalog(self) -> dict:
+        names = self._store_for().list_datasets()
+        return build_catalog(
+            source_id=self.source.source_id,
+            engine=self.engine,
+            datasets=[
+                {"name": name, "schema": None, "type": "collection"}
+                for name in names
+            ],
+        )
+
+    def schema(self, dataset: str, schema_name: str | None = None) -> dict:
+        inferred = self.infer_schema(dataset, sample=self._sample_size())
+        return build_schema(
+            source_id=self.source.source_id,
+            dataset=dataset,
+            columns=[
+                {
+                    "name": col["name"],
+                    "type": col["type"],
+                    "nullable": col["nullable"],
+                    # 文档库没有主键约束概念；_id 是事实上的唯一键，如实标注。
+                    "pk": col["name"] == "_id",
+                    "comment": col.get("comment", ""),
+                }
+                for col in inferred["columns"]
+            ],
+        )
+
+    # ------------------------------------------------------------------ #
+    # TabularScannable
+    # ------------------------------------------------------------------ #
+    def infer_schema(self, dataset: str, sample: int = DEFAULT_SAMPLE) -> dict:
+        """采样推断列集与类型。
+
+        **漂移显式报告**：同名字段在样本里出现多种类型时，``type`` 置为
+        ``mixed``，``observed_types`` 列出全部观察到的类型，并计入
+        ``drift_fields``。挑一个当准会让下游静默算错。
+        """
+        cache_key = f"{dataset}:{sample}"
+        if cache_key in self._schema_cache:
+            return self._schema_cache[cache_key]
+        docs = self._store_for().sample(dataset, sample)
+        if not docs:
+            raise ConnectorError(f"collection is empty, cannot infer schema: {dataset}")
+        seen: dict[str, dict] = {}
+        for doc in docs:
+            flat = _flatten(dict(doc))
+            for name, value in flat.items():
+                entry = seen.setdefault(
+                    name, {"types": set(), "present": 0, "nulls": 0}
+                )
+                entry["present"] += 1
+                if value is None:
+                    entry["nulls"] += 1
+                else:
+                    entry["types"].add(_type_name(value))
+        total = len(docs)
+        columns, drift = [], []
+        for name, entry in seen.items():
+            types = sorted(entry["types"])
+            if len(types) > 1:
+                col_type = "mixed"
+                drift.append({"name": name, "observed_types": types})
+            else:
+                col_type = types[0] if types else "NULL"
+            columns.append({
+                "name": name,
+                "type": col_type,
+                "observed_types": types,
+                # 字段缺席或显式 null 都算可空——文档库字段本就可缺席
+                "nullable": entry["present"] < total or entry["nulls"] > 0,
+                "presence": round(entry["present"] / total, 4),
+                "comment": (f"采样 {total} 篇中出现 {entry['present']} 次"
+                            + (f"；类型漂移 {types}" if len(types) > 1 else "")),
+            })
+        columns.sort(key=lambda col: col["name"])
+        result = {
+            "dataset": dataset,
+            "sampled": total,
+            "columns": columns,
+            "drift_fields": drift,
+        }
+        self._schema_cache[cache_key] = result
+        return result
+
+    def scan(self, dataset: str, filters: dict | None = None,
+             projection: list[str] | None = None, limit: int = 100) -> dict:
+        docs = self._store_for().scan(dataset, filters, projection, limit)
+        inferred = self.infer_schema(dataset, sample=self._sample_size())
+        names = [col["name"] for col in inferred["columns"]]
+        if projection:
+            names = [n for n in names if n in set(projection)]
+        rows = []
+        for doc in docs:
+            flat = _flatten(dict(doc))
+            rows.append([_jsonable(flat.get(name)) for name in names])
+        return {
+            "ok": True,
+            "source_id": self.source.source_id,
+            "engine": self.engine,
+            "dataset": dataset,
+            "columns": names,
+            "rows": rows,
+            "row_count": len(rows),
+        }
+
+    # ------------------------------------------------------------------ #
+    # SqlQueryable（物化后用 DuckDB）
+    # ------------------------------------------------------------------ #
+    def _referenced_datasets(self, sql: str) -> list[str]:
+        """从 SQL 里抽出被引用的集合名。
+
+        用 sqlglot 解析 AST 取表名，不用正则——正则会把字符串字面量里的词、
+        CTE 别名、子查询别名都当成表。
+        """
+        import sqlglot
+        from sqlglot import exp
+
+        statement = sqlglot.parse_one(sql, read="duckdb")
+        # CTE 名是临时视图，不是存储里的集合，必须排除
+        cte_names = {
+            cte.alias_or_name.lower()
+            for cte in statement.find_all(exp.CTE)
+        }
+        available = {name.lower(): name for name in self._store_for().list_datasets()}
+        found: list[str] = []
+        for table in statement.find_all(exp.Table):
+            key = table.name.lower()
+            if key in cte_names:
+                continue
+            real = available.get(key)
+            if real and real not in found:
+                found.append(real)
+        return found
+
+    def _materialize(self, connection, datasets: list[str]) -> dict:
+        """把被引用的集合取数并建成 DuckDB 表，返回截断报告。"""
+        limit = self._materialize_limit()
+        truncated: list[str] = []
+        for dataset in datasets:
+            scanned = self.scan(dataset, limit=limit + 1)
+            rows, names = scanned["rows"], scanned["columns"]
+            if len(rows) > limit:
+                rows = rows[:limit]
+                truncated.append(dataset)
+            quoted = ", ".join(f'"{name}"' for name in names)
+            placeholders = ", ".join("?" for _ in names)
+            inferred = self.infer_schema(dataset, sample=self._sample_size())
+            types = {col["name"]: col["type"] for col in inferred["columns"]}
+            # mixed / JSON 一律按 VARCHAR 落地——物化层不替业务决定类型，
+            # 让 SQL 里显式 CAST，错了也能看见。
+            cols_ddl = ", ".join(
+                f'"{name}" {_duck_type(types.get(name, "VARCHAR"))}' for name in names
+            )
+            connection.execute(f'CREATE OR REPLACE TABLE "{dataset}" ({cols_ddl})')
+            if rows:
+                connection.executemany(
+                    f'INSERT INTO "{dataset}" ({quoted}) VALUES ({placeholders})', rows
+                )
+        return {"truncated_datasets": truncated, "materialize_limit": limit}
+
+    def query(self, sql: str, params: Any = None, limit: int = 100) -> dict:
+        import time
+
+        try:
+            import duckdb
+        except ImportError as exc:
+            raise ConnectorDependencyError("duckdb is not installed") from exc
+
+        # 护栏复用既有实现，方言为 duckdb（物化后就是 DuckDB 表）
+        query = validate_read_only_sql(sql, source_type="duckdb")
+        safe_limit = max(1, min(int(limit), 10_000))
+        started = time.monotonic()
+        datasets = self._referenced_datasets(query)
+        if not datasets:
+            raise ConnectorError(
+                "SQL 未引用任何已知集合；可用集合："
+                f"{self._store_for().list_datasets()}"
+            )
+        connection = duckdb.connect(database=":memory:")
+        try:
+            report = self._materialize(connection, datasets)
+            result = connection.execute(query, params or [])
+            rows = result.fetchmany(safe_limit + 1)
+            columns = [item[0] for item in result.description]
+            truncated = len(rows) > safe_limit
+            rows = rows[:safe_limit]
+            out = {
+                "ok": True,
+                "source_id": self.source.source_id,
+                "engine": self.engine,
+                "columns": columns,
+                "rows": [list(row) for row in rows],
+                "row_count": len(rows),
+                "truncated": truncated,
+                "elapsed_ms": int((time.monotonic() - started) * 1000),
+                "materialized": datasets,
+            }
+            if report["truncated_datasets"]:
+                # 物化截断必须显式透出：少算了数据却报成功是最坏的失败模式
+                out["materialize_truncated"] = report["truncated_datasets"]
+                out["materialize_limit"] = report["materialize_limit"]
+            return out
+        finally:
+            connection.close()
+
+    def preview(self, dataset: str, limit: int = 100) -> dict:
+        valid = set(self._store_for().list_datasets())
+        if dataset not in valid:
+            raise ConnectorError("dataset is not registered for this source")
+        return self.query(f'SELECT * FROM "{dataset}"', limit=limit)
+
+    def close(self) -> None:
+        if self._store is not None:
+            self._store.close()
+            self._store = None
+        self._schema_cache.clear()
+
+
+def _duck_type(inferred: str) -> str:
+    """推断类型 → DuckDB 建表类型。``mixed`` / ``JSON`` 落 VARCHAR。"""
+    if inferred in ("mixed", "JSON", "NULL", ""):
+        return "VARCHAR"
+    return inferred
+
+
+__all__ = ["SampledStoreConnector", "SampledStore", "MongoStore"]
