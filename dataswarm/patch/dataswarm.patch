+def test_shell_env_patch_covers_all_three_execute_paths() -> None:
+    """execute_cmd / execute_cmd_background / execute_cmd_stream 都要被 env patch 覆盖。
+
+    execute_cmd_stream 是 web 前端 BashTool 实际走的路径（流式输出），漏 patch
+    会导致 JIUWENSWARM_WORKSPACE_ID 不进 dwcli/skill 子进程（回归防线）。
+    """
+    from openjiuwen.core.sys_operation.local.shell_operation import ShellOperation
+
+    install_shell_tool_safety_hooks()
+    for attr in ("execute_cmd", "execute_cmd_background", "execute_cmd_stream"):
+        fn = getattr(ShellOperation, attr, None)
+        assert fn is not None, attr
+        assert getattr(fn, "jiuwenswarm_env_wrapped", False), attr
+
+
+def test_env_stream_wrapper_merges_workspace_env(monkeypatch: pytest.MonkeyPatch) -> None:
+    """execute_cmd_stream wrapper（async generator 形态）合并 workspace env 且保留原 kwargs。"""
+    import asyncio
+
+    from openjiuwen.core.sys_operation import shell_process_registry as reg
+    from openjiuwen.core.sys_operation.local.shell_operation import ShellOperation
+
+    captured: dict[str, str] = {}
+
+    async def fake_original(self, command, **kwargs):
+        captured.update(kwargs.get("environment") or {})
+        yield "chunk"
+
+    def fake_metadata(session_id, *args, **kwargs):
+        return {"workspace_id": "bank"} if session_id == "web_test_ws" else {}
+
+    monkeypatch.setattr(
+        "jiuwenswarm.server.runtime.session.session_metadata.get_session_metadata",
+        fake_metadata,
+    )
+
+    original_stream = ShellOperation.execute_cmd_stream
+    try:
+        # 把类方法换成 fake original 再装 patch，让 wrapper 包住可观察的 fake
+        bash_tool_safety.reset_installed_flag()
+        ShellOperation.execute_cmd_stream = fake_original
+        bash_tool_safety._patch_shell_operation_env()
+        wrapped = ShellOperation.execute_cmd_stream
+
+        async def run_wrapped() -> None:
+            token = reg.set_shell_session_id("web_test_ws")
+            try:
+                async for _ in wrapped(None, "echo hi", environment={"A": "1"}):
+                    pass
+            finally:
+                reg.reset_shell_session_id(token)
+
+        asyncio.run(run_wrapped())
+    finally:
+        ShellOperation.execute_cmd_stream = original_stream
+        bash_tool_safety.reset_installed_flag()
+
+    assert captured.get("JIUWENSWARM_WORKSPACE_ID") == "bank"
+    assert captured.get("JIUWENSWARM_SESSION_ID") == "web_test_ws"
+    assert captured.get("A") == "1"
+
+    # 无会话上下文（contextvar 未 set，trace fallback 也不可用）：不注入 workspace env
+    captured.clear()
+
+    async def run_no_sid() -> None:
+        async for _ in wrapped(None, "echo hi", environment={"A": "1"}):
+            pass
+
+    asyncio.run(run_no_sid())
+    assert "JIUWENSWARM_WORKSPACE_ID" not in captured
+    assert captured.get("A") == "1"
+
+
+def test_env_resolution_falls_back_to_current_session(monkeypatch: pytest.MonkeyPatch) -> None:
+    """shell registry contextvar 丢失时（DeepAgent 派发链断层），经
+    openjiuwen current-session contextvar 解析 session_id 并注入 workspace env。
+
+    BashTool 写 history 就靠 get_current_session()，该 contextvar 在 tool 执行
+    context 中被验证存活，是最可靠的 fallback。
+    """
+    import asyncio
+
+    from openjiuwen.core import session as sess_mod
+    from openjiuwen.core.sys_operation.shell_process_registry import _shell_session_id
+
+    class _FakeSession:
+        def get_session_id(self) -> str:
+            return "web_test_ws"
+
+    def fake_metadata(session_id, *args, **kwargs):
+        return {"workspace_id": "bank"} if session_id == "web_test_ws" else {}
+
+    monkeypatch.setattr(
+        "jiuwenswarm.server.runtime.session.session_metadata.get_session_metadata",
+        fake_metadata,
+    )
+
+    async def run() -> dict[str, str]:
+        _shell_session_id.set(None)  # 模拟 shell registry contextvar 断裂
+        token = sess_mod._current_session.set(_FakeSession())
+        try:
+            return bash_tool_safety._workspace_env_for_current_session()
+        finally:
+            sess_mod._current_session.reset(token)
+
+    env = asyncio.run(run())
+    assert env.get("JIUWENSWARM_WORKSPACE_ID") == "bank"
+    assert env.get("JIUWENSWARM_SESSION_ID") == "web_test_ws"
+
+
+def test_shell_env_patch_pins_utf8_decode_alongside_utf8_env() -> None:
+    """平台不变量：注入 UTF-8 env 的同时必须把解码端 ``options.encoding`` 也钉成 UTF-8。
+
+    只注入 env 不改解码 → 子进程写 UTF-8、框架按 locale(cp936) 解 → Windows 中文
+    必乱码；Linux 因 locale 本就是 UTF-8 恰好自洽，故该缺陷只在 Windows 暴露。
+    这里锁死「注入编码 == 解码编码」这条不变量（平台级回归防线）。
+    """
+    import asyncio
+
+    from openjiuwen.core.sys_operation.local.shell_operation import ShellOperation
+
+    seen: dict = {}
+
+    async def fake_original(self, command, **kwargs):
+        seen.update(kwargs)
+        yield "chunk"
+
+    original_stream = ShellOperation.execute_cmd_stream
+    try:
+        bash_tool_safety.reset_installed_flag()
+        ShellOperation.execute_cmd_stream = fake_original
+        bash_tool_safety._patch_shell_operation_env()
+        wrapped = ShellOperation.execute_cmd_stream
+
+        async def run(**kwargs) -> None:
+            async for _ in wrapped(None, "echo hi", **kwargs):
+                pass
+
+        asyncio.run(run())
+        env = seen.get("environment") or {}
+        assert env.get("PYTHONUTF8") == "1"
+        assert env.get("PYTHONIOENCODING") == "utf-8"
+        assert (seen.get("options") or {}).get("encoding") == "utf-8"
+
+        # 调用方显式指定的 encoding 不被覆盖（setdefault 语义），其余 options 保留
+        seen.clear()
+        asyncio.run(run(options={"encoding": "latin-1", "chunk_size": 8}))
+        assert seen["options"]["encoding"] == "latin-1"
+        assert seen["options"]["chunk_size"] == 8
+    finally:
+        ShellOperation.execute_cmd_stream = original_stream
+        bash_tool_safety.reset_installed_flag()
+
+
+def test_accepts_options_matches_real_signatures() -> None:
+    """签名判定基线：只有 execute_cmd / execute_cmd_stream 收 ``options``。
+
+    ``execute_cmd_background`` 立即返回 PID、不经 handler 解码，签名里没有
+    ``options``——给它注入会 TypeError。openjiuwen 若改签名，此测试先炸。
+    """
+    import inspect
+
+    from openjiuwen.core.sys_operation.local.shell_operation import ShellOperation
+
+    assert "options" in inspect.signature(ShellOperation.execute_cmd).parameters
+    assert "options" in inspect.signature(ShellOperation.execute_cmd_stream).parameters
+    assert "options" not in inspect.signature(ShellOperation.execute_cmd_background).parameters
+
+
