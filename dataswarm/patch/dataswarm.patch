+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useRef, useState, type DragEvent } from 'react';
+import { useTranslation } from 'react-i18next';
+import { FolderOpen, Loader2 } from 'lucide-react';
+import {
+  DESKTOP_LOCAL_FILES_EVENT,
+  DESKTOP_FILE_DRAG_EVENT,
+  isDesktopShell,
+  type DesktopLocalFilesEventDetail,
+} from '../../workspace/localFilePicker';
+import { isLikelyAbsolutePath, selectProjectDirectory } from '../../workspace/projectDirectoryPicker';
+
+type DirectoryPathInputProps = {
+  id: string;
+  value: string;
+  placeholder: string;
+  disabled: boolean;
+  invalid: boolean;
+  onChange: (path: string) => void;
+};
+
+type FileSystemEntryLike = { isDirectory?: boolean };
+type DroppedFile = File & { path?: string };
+type DataTransferItemWithEntry = DataTransferItem & {
+  webkitGetAsEntry?: () => FileSystemEntryLike | null;
+};
+
+const DROP_ACCEPT_WINDOW_MS = 1200;
+
+function desktopDirectories(detail: DesktopLocalFilesEventDetail | null | undefined): string[] {
+  const directories = Array.isArray(detail?.directories) ? detail.directories : [];
+  return directories.filter((path): path is string => typeof path === 'string' && isLikelyAbsolutePath(path));
+}
+
+function browserDroppedDirectory(dataTransfer: DataTransfer): { directory: boolean; path?: string } {
+  for (const rawItem of Array.from(dataTransfer.items)) {
+    const item = rawItem as DataTransferItemWithEntry;
+    const entry = item.webkitGetAsEntry?.();
+    if (!entry?.isDirectory) continue;
+    const path = (item.getAsFile() as DroppedFile | null)?.path?.trim();
+    return { directory: true, ...(path && isLikelyAbsolutePath(path) ? { path } : {}) };
+  }
+  return { directory: false };
+}
+
+export function DirectoryPathInput({ id, value, placeholder, disabled, invalid, onChange }: DirectoryPathInputProps) {
+  const { t } = useTranslation();
+  const desktopShell = isDesktopShell();
+  const [dragActive, setDragActive] = useState(false);
+  const [selecting, setSelecting] = useState(false);
+  const [dropError, setDropError] = useState<string | null>(null);
+  const dropZoneRef = useRef<HTMLDivElement>(null);
+  const dropAcceptUntilRef = useRef(0);
+  const lastDropIdRef = useRef<string | null>(null);
+
+  const acceptDirectory = useCallback(
+    (path: string) => {
+      setDragActive(false);
+      setDropError(null);
+      onChange(path);
+    },
+    [onChange],
+  );
+
+  useEffect(() => {
+    const onDesktopLocalFiles = (event: Event) => {
+      const detail = (event as CustomEvent<DesktopLocalFilesEventDetail>).detail;
+      if (detail?.source && detail.source !== 'drop') return;
+      const directories = desktopDirectories(detail);
+      if (!directories.length) return;
+      const dropId = typeof detail?.dropId === 'string' ? detail.dropId : null;
+      if (dropId && lastDropIdRef.current === dropId) return;
+
+      const clientX = detail?.clientX;
+      const clientY = detail?.clientY;
+      const hit =
+        typeof clientX === 'number' && typeof clientY === 'number' ? document.elementFromPoint(clientX, clientY) : null;
+      const droppedOnField = Boolean(hit && dropZoneRef.current?.contains(hit));
+      const recentlyEntered = Date.now() <= dropAcceptUntilRef.current;
+      if (!droppedOnField && !recentlyEntered) return;
+
+      if (dropId) lastDropIdRef.current = dropId;
+      acceptDirectory(directories[0]);
+    };
+    window.addEventListener(DESKTOP_LOCAL_FILES_EVENT, onDesktopLocalFiles as EventListener);
+    return () => window.removeEventListener(DESKTOP_LOCAL_FILES_EVENT, onDesktopLocalFiles as EventListener);
+  }, [acceptDirectory]);
+
+  useEffect(() => {
+    const onDesktopFileDrag = (event: Event) => {
+      const active = Boolean((event as CustomEvent<{ active?: boolean }>).detail?.active);
+      if (!active) setDragActive(false);
+    };
+    window.addEventListener(DESKTOP_FILE_DRAG_EVENT, onDesktopFileDrag as EventListener);
+    return () => window.removeEventListener(DESKTOP_FILE_DRAG_EVENT, onDesktopFileDrag as EventListener);
+  }, []);
+
+  const selectDirectory = async () => {
+    if (disabled || selecting) return;
+    setSelecting(true);
+    setDropError(null);
+    try {
+      const result = await selectProjectDirectory({
+        initialDir: isLikelyAbsolutePath(value) ? value : undefined,
+      });
+      if (result.ok) {
+        acceptDirectory(result.path);
+      } else if (result.reason === 'unsupported') {
+        setDropError(t('dataSource.form.serverDirectoryPickerUnavailable'));
+      } else if (result.reason !== 'cancelled') {
+        setDropError(result.message || t('dataSource.form.directorySelectFailed'));
+      }
+    } finally {
+      setSelecting(false);
+    }
+  };
+
+  const markDragActive = (event: DragEvent<HTMLDivElement>) => {
+    if (!desktopShell || disabled || !Array.from(event.dataTransfer.types).includes('Files')) return;
+    event.preventDefault();
+    event.dataTransfer.dropEffect = 'copy';
+    dropAcceptUntilRef.current = Date.now() + DROP_ACCEPT_WINDOW_MS;
+    setDragActive(true);
+  };
+
+  const handleDrop = (event: DragEvent<HTMLDivElement>) => {
+    if (disabled || !Array.from(event.dataTransfer.types).includes('Files')) return;
+    event.preventDefault();
+    setDragActive(false);
+    if (!desktopShell) return;
+    const dropped = browserDroppedDirectory(event.dataTransfer);
+    if (!dropped.directory) {
+      return;
+    }
+    if (!dropped.path) {
+      // WebView2 supplies the absolute path through DESKTOP_LOCAL_FILES_EVENT.
+      return;
+    }
+    acceptDirectory(dropped.path);
+  };
+
+  return (
+    <>
+      <div
+        ref={dropZoneRef}
+        className={`ds-directory-path${dragActive ? ' is-dragging' : ''}`}
+        data-datasource-directory-drop
+        onDragEnter={markDragActive}
+        onDragOver={markDragActive}
+        onDragLeave={(event) => {
+          if (!event.currentTarget.contains(event.relatedTarget as Node | null)) setDragActive(false);
+        }}
+        onDrop={handleDrop}
+      >
+        <input
+          id={id}
+          className="ds-input"
+          aria-invalid={invalid}
+          disabled={disabled}
+          type="text"
+          autoComplete="off"
+          value={value}
+          placeholder={dragActive ? t('dataSource.form.directoryDropActive') : placeholder}
+          onChange={(event) => {
+            setDropError(null);
+            onChange(event.target.value);
+          }}
+        />
+        <button
+          type="button"
+          className="ds-directory-select"
+          disabled={disabled || selecting}
+          onClick={() => void selectDirectory()}
+        >
+          {selecting ? <Loader2 className="animate-spin" size={15} /> : <FolderOpen size={15} />}
+          {t('dataSource.form.selectDirectory')}
+        </button>
+      </div>
+      {(dropError || desktopShell) && (
+        <small className={dropError ? 'ds-field-error' : undefined} role={dropError ? 'alert' : undefined}>
+          {dropError || t('dataSource.form.directoryDropHint')}
+        </small>
+      )}
+    </>
+  );
+}
