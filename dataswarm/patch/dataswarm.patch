+    _record_llm_step(manifest, "join", "decision", component_id=args.component_id,
+                     ai_output={"left": args.left, "right": args.right},
+                     context_digest="join 证据确认目标由模型选择")
+    manifest["budget"]["explore_count"] += 1
+    _save(manifest)
+    _emit(result, manifest, "join")
+    return 0
