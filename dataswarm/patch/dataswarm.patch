@@ -0,0 +1,29 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useState } from 'react';
+import type { DashboardPage, DashboardRoute } from './route';
+
+/** 看板页内部路由：监听 jiuwen:nav-dashboard 事件切换 page/dashboardId。
+ * URL 前缀为 /dataagent/dashboard/*（由 route.ts 的 parseDashboardRoute 解析）。 */
+export function useDashboardRoute() {
+  const [route, setRoute] = useState<DashboardRoute>({ kind: 'dashboard', page: 'dashboards' });
+
+  useEffect(() => {
+    const handler = (e: Event) => {
+      const detail = (e as CustomEvent<{ page?: DashboardPage; dashboardId?: string }>).detail;
+      if (!detail) return;
+      setRoute({
+        kind: 'dashboard',
+        page: detail.page ?? 'dashboards',
+        dashboardId: detail.dashboardId,
+      });
+    };
+    window.addEventListener('jiuwen:nav-dashboard', handler);
+    return () => window.removeEventListener('jiuwen:nav-dashboard', handler);
+  }, []);
+
+  const navigate = useCallback((page: DashboardPage) => {
+    setRoute((prev) => ({ kind: 'dashboard', page, dashboardId: page === 'dashboards' ? prev.dashboardId : undefined }));
+  }, []);
+
+  return { route, navigate };
+}
