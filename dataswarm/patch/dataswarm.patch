+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useState } from 'react';
+import { parseGovernanceRoute, type GovernancePage, type GovernanceRoute } from './route';
+
+function currentGovernanceRoute(): GovernanceRoute {
+  return parseGovernanceRoute(`${window.location.pathname}${window.location.search}`) ?? { kind: 'governance', page: 'overview' };
+}
+
+/**
+ * 治理页内部路由（page 切换 + run_id 定位）。
+ *
+ * 治理页嵌入主区（靠 activeNav 切换），内部 tab 切换走纯 state 不 pushState，
+ * 避免与 chat 的 URL 路由冲突。
+ *
+ * 但 /governance/... URL 仍需可用（巡检结果带链接）：顶层 App 解析 URL 后派发
+ * jiuwen:nav-governance 事件（带 page + runId），这里监听并设置 route，
+ * GovernanceApp 的 effect 据此调 selectRun 选中对应批次。
+ */
+export function useGovernanceRoute() {
+  const [route, setRoute] = useState<GovernanceRoute>(currentGovernanceRoute);
+
+  // 监听顶层 URL 解析派发的事件：切 page + 记 runId（供 GovernanceApp 选中批次）。
+  useEffect(() => {
+    const handler = (e: Event) => {
+      const detail = (e as CustomEvent<{ page?: GovernancePage; runId?: string }>).detail;
+      if (!detail) return;
+      setRoute({ kind: 'governance', page: detail.page ?? 'overview', runId: detail.runId });
+    };
+    window.addEventListener('jiuwen:nav-governance', handler);
+    return () => window.removeEventListener('jiuwen:nav-governance', handler);
+  }, []);
+
+  const navigate = useCallback((page: GovernancePage) => {
+    setRoute(prev => ({ kind: 'governance', page, runId: prev.runId }));
+  }, []);
+  return { route, navigate };
+}
