+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan/controller.py — 方案 HTTP 路由分发。
+
+路由前缀: /api/dataagent/plan/
+  GET  /plan            ?business=
+  GET  /plan/get        ?plan_id=
+  GET  /plan/tables     ?plan_id=
+  POST /plan/save       {plan_id?, name, business, purpose, content_json?, plan_data?}
+  POST /plan/tables/save {plan_id, tables}
+"""
+from __future__ import annotations
+
+from . import service as svc
+from .._common import read_body
+
+
+_PREFIX = "/api/dataagent/plan"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    rel = path[len(_PREFIX):].rstrip("/")
+    return rel.split("/")
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    try:
+        # ['', ''] 或 [''] → list
+        if len(parts) == 1 or (len(parts) == 2 and parts[1] == ""):
+            business = handler._query_arg(parsed, "business") or ""
+            handler._write_json(200, {"plans": svc.list_plans(business)})
+            return
+        # ['', 'get']
+        if len(parts) == 2 and parts[1] == "get":
+            plan_id = handler._query_arg(parsed, "plan_id") or ""
+            p = svc.get_plan(plan_id)
+            handler._write_json(200 if p else 404, p if p else {"error": "not_found"})
+            return
+        # ['', 'tables']
+        if len(parts) == 2 and parts[1] == "tables":
+            plan_id = handler._query_arg(parsed, "plan_id") or ""
+            handler._write_json(200, {"tables": svc.get_plan_tables(plan_id)})
+            return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = read_body(handler)
+    if body is None and len(parts) > 1:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        if len(parts) == 3 and parts[1] == "tables" and parts[2] == "save":
+            b = body or {}
+            plan_id = str(b.get("plan_id") or "").strip()
+            tables = b.get("tables")
+            if not plan_id or not isinstance(tables, list) or any(not isinstance(t, dict) for t in tables):
+                raise ValueError("plan_id and tables[] are required")
+            handler._write_json(200, svc.save_plan_tables(plan_id, tables))
+            return
+        # ['', 'save']
+        if len(parts) == 2 and parts[1] == "save":
+            b = body or {}
+            handler._write_json(201, svc.save_plan(
+                plan_id=b.get("plan_id", ""),
+                name=b.get("name", ""),
+                business=b.get("business", ""),
+                purpose=b.get("purpose", ""),
+                content_json=b.get("content_json", ""),
+                plan_data=b.get("plan_data"),
+            ))
+            return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
