@@ -0,0 +1,109 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useDrawer } from '../hooks/useDrawer';
+// 日志抽屉：右侧滑出的模态抽屉。传入若干 TaskRun，支持多 run 切换、stdout/stderr 切换。
+// 级别筛选/下载由内嵌 LogViewer 提供。按 run_id 工作。
+// 宿主：实例页/运行情况页「日志」按钮。
+
+import { useEffect, useState } from 'react';
+import { X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import type { TaskRun } from '../types/orchestration';
+import { Button } from './shared/Ui';
+import { LogViewer } from './LogViewer';
+
+interface Props {
+  /** 传入要查看的 runs；为 null 时关闭抽屉 */
+  runs: TaskRun[];
+  /** 初始展示的 run_id（一般为 runs[0]） */
+  initialRunId?: string | null;
+  onClose: () => void;
+}
+
+export function LogDrawer({ runs, initialRunId, onClose }: Props) {
+  const { t } = useTranslation();
+  const [selected, setSelected] = useState<string | null>(initialRunId ?? runs[0]?.run_id ?? null);
+  const [stream, setStream] = useState<'stdout' | 'stderr'>('stdout');
+
+  // 切换 runs 来源（如点了另一个实例的日志）时重置选中为首条
+  const runIds = runs.map((run) => run.run_id).join(',');
+  useEffect(() => {
+    setSelected(initialRunId ?? (runIds.split(',')[0] || null));
+    setStream('stdout');
+  }, [initialRunId, runIds]);
+
+  const drawerRef = useDrawer(true, onClose);
+
+  const cur = runs.find((r) => r.run_id === selected) ?? null;
+  const multi = runs.length > 1;
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end" ref={drawerRef} role="dialog" aria-modal="true">
+      {/* 遮罩 */}
+      <div className="absolute inset-0 bg-black/40" onClick={onClose} />
+      {/* 抽屉 */}
+      <div className="relative flex h-full w-[640px] max-w-[90vw] flex-col border-l border-border bg-card shadow-2xl">
+        <div className="flex items-center justify-between border-b border-border px-4 py-3">
+          <h3 className="text-sm font-semibold text-text-strong">{t('dataAsset.logs.title')}</h3>
+          <button
+            className="rounded p-1 text-text-muted hover:bg-secondary hover:text-text"
+            onClick={onClose}
+            aria-label={t('common.close')}
+          >
+            <X size={16} />
+          </button>
+        </div>
+
+        {cur ? (
+          <>
+            <div className="flex flex-wrap items-center gap-2 border-b border-border px-4 py-2 text-xs text-text-muted">
+              <span className="font-mono">{cur.node_name || cur.task_id}</span>
+              <span>·</span>
+              <span>
+                {t('dataAsset.logs.exitCode')} {cur.exit_code ?? '—'}
+              </span>
+              {cur.error_message && <span className="text-danger">· {cur.error_message}</span>}
+            </div>
+
+            {multi && (
+              <div className="flex flex-wrap gap-1 border-b border-border px-4 py-2">
+                {runs.map((r) => (
+                  <Button
+                    key={r.run_id}
+                    size="xs"
+                    variant={selected === r.run_id ? 'primary' : 'default'}
+                    onClick={() => setSelected(r.run_id)}
+                  >
+                    {r.node_name || r.task_id} · {t(`workflowRun.status.${r.status}`)}
+                  </Button>
+                ))}
+              </div>
+            )}
+
+            <div className="flex items-center gap-2 border-b border-border px-4 py-2 text-xs">
+              <Button
+                size="xs"
+                variant={stream === 'stdout' ? 'primary' : 'default'}
+                onClick={() => setStream('stdout')}
+              >
+                stdout
+              </Button>
+              <Button
+                size="xs"
+                variant={stream === 'stderr' ? 'danger' : 'default'}
+                onClick={() => setStream('stderr')}
+              >
+                stderr
+              </Button>
+            </div>
+
+            <LogViewer runId={selected} stream={stream} />
+          </>
+        ) : (
+          <div className="flex flex-1 items-center justify-center text-sm text-text-muted">
+            {t('dataAsset.logs.noRuns')}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/LogViewer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/LogViewer.tsx
