+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+const STORAGE_KEY = 'dw.onboarding.completed';
+
+/** 首次使用判定：localStorage 快速标记；App 在完成引导时还会双写服务端
+ *  dw_onboarding_done（桌面壳等 webview 的 localStorage 不保证跨启动持久）。 */
+export function isDwOnboardingDone(): boolean {
+  try {
+    return window.localStorage.getItem(STORAGE_KEY) === '1';
+  } catch {
+    // 隐私模式等 localStorage 不可用场景视为未完成
+    return false;
+  }
+}
+
+export function markDwOnboardingDone(): void {
+  try {
+    window.localStorage.setItem(STORAGE_KEY, '1');
+  } catch {
+    // 写不进去就只在本次会话内生效
+  }
+}
