new file mode 100644
index 000000000..82d11ad13
--- /dev/null
+++ b/tests/unit_tests/orchestration/test_bootstrap_skill_sync.py
@@ -0,0 +1,145 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""bootstrap._sync_dev_skills 单测：启动时 dev skills → runtime 覆盖同步。
+
+覆盖点：
+- 清单与 ensure_default_builtin_skills 共用 _default_builtin_skill_names（含 _dw_common）
+- 覆盖式合并：dst 旧文件被新文件覆盖
+- 同步后清理 runtime 侧 __pycache__
+- dev 目录缺失时跳过该 skill，不阻断其余同步
+- 单个 skill 复制失败只记日志，不抛异常
+"""
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.orchestration import bootstrap
+from jiuwenswarm.common.utils import _default_builtin_skill_names
+
+
+@pytest.fixture()
+def sync_env(monkeypatch, tmp_path):
+    """构造假 dev / runtime skills 目录，并把模块级路径指过去。"""
+    dev = tmp_path / "dev_skills"
+    runtime = tmp_path / "runtime_skills"
+    dev.mkdir()
+    runtime.mkdir()
+
+    # 最小 dw skill：带 SKILL.md 即满足 _default_builtin_skill_names 扫描条件
+    def make_skill(root: Path, name: str, content: str = "body") -> None:
+        d = root / name
+        d.mkdir(parents=True)
+        (d / "SKILL.md").write_text(f"# {name}\n{content}", encoding="utf-8")
+
+    make_skill(dev, "dw-alpha")
+    make_skill(dev, "dw-beta")
+    # _dw_common：无 SKILL.md，靠清单里的显式条目同步
+    common = dev / "_dw_common" / "scripts"
+    common.mkdir(parents=True)
+    (common / "capability.py").write_text("CAP = 1\n", encoding="utf-8")
+
+    monkeypatch.setattr(bootstrap, "_DEV_SKILLS", dev)
+    monkeypatch.setattr(bootstrap, "_RUNTIME_SKILLS", runtime)
+    return {"dev": dev, "runtime": runtime}
+
+
+def test_sync_list_is_shared_with_ensure_default_builtin_skills(sync_env):
+    """同步清单与 _default_builtin_skill_names 一致且含 _dw_common（防清单漂移）。
+
+    固定列表中 dev 侧不存在的 skill 会被跳过（warning），故实际同步集 =
+    清单 ∩ dev 实存目录。
+    """
+    bootstrap._sync_dev_skills()
+    expected = {
+        name
+        for name in ("_dw_common", *_default_builtin_skill_names(sync_env["dev"]))
+        if (sync_env["dev"] / name).is_dir()
+    }
+    synced = {p.name for p in sync_env["runtime"].iterdir() if p.is_dir()}
+    assert synced == expected
+
+
+def test_sync_overwrites_existing_files(sync_env):
+    """runtime 已存在的旧文件被 dev 新内容覆盖（覆盖式合并语义）。"""
+    rt = sync_env["runtime"]
+    stale = rt / "dw-alpha"
+    stale.mkdir()
+    (stale / "SKILL.md").write_text("# stale\n", encoding="utf-8")
+
+    bootstrap._sync_dev_skills()
+
+    assert (stale / "SKILL.md").read_text(encoding="utf-8").startswith("# dw-alpha")
+
+
+def test_sync_clears_runtime_pycache(sync_env):
+    """同步后 runtime 侧 __pycache__ 被清理。"""
+    dev = sync_env["dev"]
+    pycache = dev / "dw-alpha" / "__pycache__"
+    pycache.mkdir()
+    (pycache / "x.pyc").write_bytes(b"\x00")
+
+    bootstrap._sync_dev_skills()
+
+    rt_alpha = sync_env["runtime"] / "dw-alpha"
+    assert (rt_alpha / "SKILL.md").is_file()
+    assert not (rt_alpha / "__pycache__").exists()
+
+
+def test_sync_skips_missing_dev_dir(sync_env, monkeypatch):
+    """dev 侧目录缺失时跳过该 skill 且不报错（runtime 不受影响）。
+
+    动态扫描的 dw- skill 被删后自动退出清单；warning 分支由固定列表 skill
+    （dev 侧不存在）触发。jiuwenswarm 根 logger propagate=False，caplog
+    抓不到，故直接替换模块 logger 断言日志内容。
+    """
+
+    class Spy:
+        def __init__(self) -> None:
+            self.messages: list[str] = []
+
+        def warning(self, msg: str, *args) -> None:
+            self.messages.append(msg % args if args else msg)
+
+        def error(self, msg: str, *args) -> None:
+            self.messages.append("ERROR: " + (msg % args if args else msg))
+
+        def info(self, msg: str, *args) -> None:
+            pass
+
+    spy = Spy()
+    monkeypatch.setattr(bootstrap, "logger", spy)
+    shutil.rmtree(sync_env["dev"] / "dw-beta")
+
+    bootstrap._sync_dev_skills()
+
+    assert (sync_env["runtime"] / "dw-alpha" / "SKILL.md").is_file()
+    assert not (sync_env["runtime"] / "dw-beta").exists()
+    # 固定列表 skill（如 nl2sql）dev 侧不存在 → 逐个 warning 跳过
+    assert any("nl2sql" in m for m in spy.messages)
+    # 动态清单中被删的 dw-beta 已自动退出清单，不会尝试拷贝
+    assert not any("dw-beta" in m for m in spy.messages)
+
+
+def test_sync_failure_does_not_raise(sync_env, monkeypatch):
+    """单个 skill 复制失败只记日志，不影响其余 skill 同步。"""
+    import jiuwenswarm.channels.web.orchestration.bootstrap as bs
+
+    real_copytree = shutil.copytree
+    calls: list[str] = []
+
+    def flaky_copytree(src, dst, **kwargs):
+        calls.append(Path(dst).name)
+        if "dw-alpha" in str(dst):
+            raise OSError("disk full")
+        return real_copytree(src, dst, **kwargs)
+
+    monkeypatch.setattr(bs.shutil, "copytree", flaky_copytree)
+
+    # 不应抛异常
+    bs._sync_dev_skills()
+
+    assert "dw-alpha" in calls
+    # dw-alpha 失败，runtime 无残留
+    assert not (sync_env["runtime"] / "dw-alpha").exists()
