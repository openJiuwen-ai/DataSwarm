--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/workflowPreview/workflowPreviewUrl.ts
@@ -0,0 +1,14 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { parseWorkflowRunRoute } from '../../multi-session/routing/route';
+
+export function workflowPreviewUrl(href: string, baseUrl: string): string | null {
+  try {
+    const base = new URL(baseUrl);
+    const url = new URL(href, base);
+    if (!['http:', 'https:'].includes(url.protocol) || url.origin !== base.origin || url.username || url.password) return null;
+    if (!parseWorkflowRunRoute(url.pathname)) return null;
+    return url.href;
+  } catch {
+    return null;
+  }
+}
