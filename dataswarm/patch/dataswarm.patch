+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 指标详情抽屉：概要 → 当前口径 → 术语绑定 → 修订历史（折叠）→ 语义上下文。
+ *
+ * 口径不可变：改口径的入口是「新建修订」（candidate），发布后才生效；
+ * 本抽屉只读展示历史，不就地编辑修订。阅读主线：先答「现在是什么口径」，
+ * 历史与待办（候选映射确认、术语绑定）靠后，内部标识（definition_ref、
+ * release_id）不进人读界面。颜色一律走主题 token（见 ui.ts 头注释）。
+ */
+
+import { Fragment, useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  metricsV2Api,
+  type GlossaryTermOption,
+  type V2MetricDetail,
+  type V2MetricTerms,
+  type V2RevisionSummary,
+  type V2SemanticContext,
+} from './api';
+import { MetricSchemaGraph } from './MetricSchemaGraph';
+import { SchemaSubgraphView } from './SchemaSubgraphView';
+import {
+  badge,
+  btn,
+  btnPrimary,
+  enumLabel,
+  formatTime,
+} from './ui';
+import { X } from 'lucide-react';
+
+/** 键值网格：口径字段的统一排版（替代分号拼行）。 */
+function FactGrid({ items }: { items: Array<[string, React.ReactNode]> }) {
+  return (
+    <div className="grid grid-cols-[96px_1fr] gap-x-4 gap-y-1 text-xs">
+      {items.map(([name, value]) => (
+        <Fragment key={name}>
+          <span className="whitespace-nowrap text-text-muted">{name}</span>
+          <span className="min-w-0 break-words text-text">{value ?? '—'}</span>
+        </Fragment>
+      ))}
+    </div>
+  );
+}
+
+/** 单个修订的口径细节：字段网格 + 表达式 + 数据绑定 + 候选映射确认。 */
+function RevisionBody({
+  rev, busy, onConfirmMap,
+}: {
+  rev: V2RevisionSummary;
+  busy: boolean;
+  onConfirmMap: (mappingId: string, reject: boolean) => void;
+}) {
+  const { t } = useTranslation();
+  const hasCandidateMaps = !!rev.candidate_maps?.length;
+  return (
+    <div className="mt-2 space-y-2.5">
+      <FactGrid items={[
+        [t('biMetrics.detail.metricType'), enumLabel(t, 'type', rev.metric_type)],
+        [t('biMetrics.detail.unit'), rev.unit || '—'],
+        [t('biMetrics.detail.timeDimension'), rev.time_dimension || '—'],
+        [t('biMetrics.detail.timeGrain'),
+          rev.time_grains.map((g) => enumLabel(t, 'grain', g)).join(' / ') || '—'],
+        [t('biMetrics.detail.allowedDimensions'),
+          rev.allowed_dimensions.join(t('biMetrics.sep.enum')) || '—'],
+        [t('biMetrics.detail.dependencies'),
+          rev.dependencies.join(t('biMetrics.sep.enum')) || '—'],
+      ]} />
+      {rev.unparsed_reason && (
+        <p className="text-xs text-danger">
+          {t('biMetrics.detail.unparsedReason', { reason: rev.unparsed_reason })}
+        </p>
+      )}
+      {rev.expression_sql && (
+        <div>
+          <div className="mb-1 text-xs text-text-muted">{t('biMetrics.detail.expressionSql')}</div>
+          <pre className="overflow-x-auto whitespace-pre-wrap rounded bg-bg-muted p-2 font-mono text-xs text-text">
+            {rev.expression_sql}
+          </pre>
+        </div>
+      )}
+      {!!rev.bindings?.length && (
+        <div>
+          <div className="mb-1 text-xs text-text-muted">{t('biMetrics.detail.dataBindings')}</div>
+          <div className="space-y-1">
+            {rev.bindings.map((binding) => (
+              <div key={binding.binding_id} className="flex flex-wrap items-center gap-2 text-xs text-text">
+                <span className={badge(binding.verify_status === 'verified' ? 'green' : 'amber')}>
+                  {enumLabel(t, 'bindingStatus', binding.verify_status)}
+                </span>
+                <span className="font-mono">{binding.source_table || t('biMetrics.detail.noTableBound')}</span>
+                <span className="text-text-muted">
+                  {t('biMetrics.detail.columnMappingCount', { count: Object.keys(binding.column_map).length })}
+                </span>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+      {hasCandidateMaps && (
+        <div>
+          <div className="mb-1 text-xs font-medium text-warn">
+            {t('biMetrics.detail.candidateMapsTitle')}
+          </div>
+          <div className="space-y-1">
+            {rev.candidate_maps!.map((cm) => (
+              <div key={cm.mapping_id}
+                   className="flex items-center gap-2 rounded border border-warn/40 bg-warn-subtle px-2 py-1 text-xs">
+                <span className="font-mono">{cm.relation_type}</span>
+                <span className="min-w-0 flex-1 truncate" title={cm.evidence}>→ {cm.target_ref}</span>
+                <button className={btnPrimary} disabled={busy}
+                        onClick={() => onConfirmMap(cm.mapping_id, false)}>
+                  {t('biMetrics.detail.confirm')}
+                </button>
+                <button className={btn} disabled={busy}
+                        onClick={() => onConfirmMap(cm.mapping_id, true)}>
+                  {t('biMetrics.detail.reject')}
+                </button>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
+
+/** 术语绑定面板：指标 ↔ 业务术语（界面链路——点选即确认，无需二次 confirm）。
+ *
+ * 绑定是分析侧「术语直达指标」漏斗的燃料：术语精确命中且唯一链到一个已发布
+ * 指标时，提问可跳过指标候选甄别直接取数。
+ */
+function TermBindingPanel({ metricKey, published }: { metricKey: string; published: boolean }) {
+  const { t } = useTranslation();
+  const [bound, setBound] = useState<V2MetricTerms | null>(null);
+  const [options, setOptions] = useState<GlossaryTermOption[]>([]);
+  const [picked, setPicked] = useState('');
+  const [note, setNote] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  const reload = useCallback(() => {
+    setError('');
+    void (async () => {
+      try {
+        setBound(await metricsV2Api.listTerms(metricKey));
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+      }
+    })();
+  }, [metricKey]);
+
+  useEffect(() => {
+    reload();
+    void (async () => {
+      try {
+        const payload = await metricsV2Api.glossaryTerms();
+        setOptions((payload.terms ?? []).filter((term) => term.status !== 'deprecated'));
+      } catch {
+        setOptions([]);   // 术语库不可用：绑定区降级为只读，不阻断指标页
+      }
+    })();
+  }, [reload]);
+
+  const act = (fn: () => Promise<string>) => {
+    setBusy(true);
+    setError('');
+    void (async () => {
+      try {
+        setNote(await fn());
+        reload();
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+      } finally {
+        setBusy(false);
+      }
+    })();
+  };
+
+  const bind = () => {
+    if (!picked) return;
+    act(async () => {
+      const result = await metricsV2Api.bindTerm(metricKey, picked, 'web-user');
+      setPicked('');
+      const parts = [t('biMetrics.detail.boundNotice', { name: result.term.name })];
+      if (result.warnings.length) parts.push(result.warnings.join(t('biMetrics.sep.item')));
+      if (result.reproject_required) {
+        parts.push(t('biMetrics.detail.reprojectNote'));
+      } else if (!published) {
+        parts.push(t('biMetrics.detail.notPublishedBindNote'));
+      }
+      return parts.join(t('biMetrics.sep.pipe'));
+    });
+  };
+
+  const terms = bound?.terms ?? [];
+  return (
+    <div className="rounded-lg border border-border p-3">
+      <div className="text-xs font-medium text-text-strong mb-2">
+        {t('biMetrics.detail.termBindingTitle')}
+        <span className="ml-2 font-normal text-text-muted">
+          {t('biMetrics.detail.termBindingHint')}
+        </span>
+      </div>
+      {terms.length > 0 ? (
+        <div className="space-y-1">
+          {terms.map((term) => (
+            <div key={term.mapping_id}
+                 className="flex items-center gap-2 rounded border border-transparent bg-bg-muted px-2 py-1 text-xs">
+              <span className={badge(term.status === 'confirmed' ? 'green' : 'amber')}>
+                {term.status === 'confirmed' ? t('biMetrics.detail.confirmed') : term.status}
+              </span>
+              {term.resolved ? (
+                <span className="min-w-0 flex-1 truncate text-text" title={term.definition}>
+                  {term.name}<span className="ml-1 text-text-muted">{term.definition}</span>
+                </span>
+              ) : (
+                <span className="min-w-0 flex-1 truncate text-warn" title={term.evidence}>
+                  {t('biMetrics.detail.termMissing', { ref: term.target_ref })}
+                </span>
+              )}
+              {term.resolved && (
+                <button className={btn} disabled={busy}
+                        onClick={() => act(async () => {
+                          await metricsV2Api.unbindTerm(metricKey, term.term_id);
+                          return t('biMetrics.detail.unboundNotice', { name: term.name });
+                        })}>
+                  {t('biMetrics.detail.unbind')}
+                </button>
+              )}
+            </div>
+          ))}
+        </div>
+      ) : (
+        <p className="text-xs text-text-muted">{t('biMetrics.detail.noTerms')}</p>
+      )}
+      <div className="mt-2 flex items-center gap-2">
+        <select className="flex-1 rounded border border-border bg-bg-elevated px-2 py-1 text-xs text-text"
+                value={picked} onChange={(e) => setPicked(e.target.value)}>
+          <option value="">{t('biMetrics.detail.pickTerm')}</option>
+          {options.map((option) => (
+            <option key={option.term_id} value={option.term_id}>
+              {option.name}{option.synonyms_list?.length
+                ? t('biMetrics.detail.termSynonyms',
+                    { list: option.synonyms_list.join(t('biMetrics.sep.enum')) })
+                : ''}
+            </option>
+          ))}
+        </select>
+        <button className={btnPrimary} disabled={!picked || busy} onClick={bind}>
+          {t('biMetrics.detail.bind')}
+        </button>
+      </div>
+      {options.length === 0 && (
+        <p className="mt-1 text-xs text-text-muted">
+          {t('biMetrics.detail.noGlossaryTerms')}
+        </p>
+      )}
+      {note && <p className="mt-1 text-xs text-ok">{note}</p>}
+      {error && <p className="mt-1 text-xs text-danger">{error}</p>}
+    </div>
+  );
+}
+
+interface MetricDetailDrawerProps {
+  metricKey: string;
+  onClose: () => void;
+  /** 候选映射确认等会改变列表的动作后通知父级刷新 */
+  onChanged: () => void;
+  /** 打开「新建修订」表单（口径以当前修订预填） */
+  onCreateRevision: (detail: V2MetricDetail) => void;
+}
+
+export function MetricDetailDrawer({
+  metricKey, onClose, onChanged, onCreateRevision,
+}: MetricDetailDrawerProps) {
+  const { t } = useTranslation();
+  const [detail, setDetail] = useState<V2MetricDetail | null>(null);
+  const [ctx, setCtx] = useState<V2SemanticContext | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  const reload = useCallback(() => {
+    setError('');
+    void (async () => {
+      try {
+        setDetail(await metricsV2Api.getMetric(metricKey));
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+      }
+    })();
+  }, [metricKey]);
+
+  useEffect(() => { reload(); }, [reload]);
+
+  const confirmMap = (mappingId: string, reject: boolean) => {
+    setBusy(true);
+    setError('');
+    void (async () => {
+      try {
+        await metricsV2Api.confirmMapping(mappingId, 'web-user', reject);
+        reload();
+        onChanged();
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+      } finally {
+        setBusy(false);
+      }
+    })();
+  };
+
+  const loadContext = () => {
+    setBusy(true);
+    setError('');
+    void (async () => {
+      try {
+        setCtx(await metricsV2Api.context(metricKey));
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+      } finally {
+        setBusy(false);
+      }
+    })();
+  };
+
+  const published = !!detail && detail.revisions.some((rev) => rev.status === 'published');
+  // 当前生效口径 = revision_no 最大的 published；从未发布过则展示最新修订（标「未发布」）
+  const latestOf = (revs: V2RevisionSummary[]) =>
+    revs.reduce((a, b) => (b.revision_no > a.revision_no ? b : a));
+  const publishedRevs = detail?.revisions.filter((r) => r.status === 'published') ?? [];
+  const activeRevision = detail?.revisions.length
+    ? (publishedRevs.length ? latestOf(publishedRevs) : latestOf(detail.revisions))
+    : null;
+  // 历史修订按版本号倒序（新在上）；有待确认映射的 candidate 默认展开
+  const revisionsDesc = detail ? [...detail.revisions].sort((a, b) => b.revision_no - a.revision_no) : [];
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end bg-black/40" onClick={onClose}>
+      <div className="flex h-full w-full max-w-3xl flex-col border-l border-border bg-bg shadow-2xl"
+           onClick={(e) => e.stopPropagation()}>
+        <div className="flex items-center justify-between border-b border-border px-5 py-3">
+          <div className="min-w-0">
+            <div className="flex items-center gap-2">
+              <h3 className="truncate text-base font-semibold text-text-strong">
+                {detail?.metric.name ?? metricKey}
+              </h3>
+              {detail && (
+                <span className={badge(published ? 'green' : 'gray')}>
+                  {published
+                    ? t('biMetrics.enum.revisionStatus.published')
+                    : t('biMetrics.detail.unpublished')}
+                </span>
+              )}
+              {detail && detail.pending_concept_maps > 0 && (
+                <span className={badge('amber')}>
+                  {t('biMetrics.detail.pendingMaps', { count: detail.pending_concept_maps })}
+                </span>
+              )}
+            </div>
+            <div className="mt-0.5 font-mono text-xs text-text-muted">{metricKey}</div>
+          </div>
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}>
+            <X size={18} />
+          </button>
+        </div>
+
+        <div className="flex-1 space-y-4 overflow-y-auto p-5">
+          {error && (
+            <div className="rounded border border-danger/40 bg-danger-subtle px-3 py-2 text-sm text-danger">
+              {error}
+            </div>
+          )}
+          {!detail && !error && <div className="text-sm text-text-muted">{t('biMetrics.detail.loading')}</div>}
+          {detail && activeRevision && (
+            <>
+              <div className="space-y-1">
+                {detail.metric.description && (
+                  <p className="text-sm text-text">{detail.metric.description}</p>
+                )}
+                <div className="flex flex-wrap gap-x-4 gap-y-1 text-xs text-text-muted">
+                  <span>{t('biMetrics.detail.ownerLabel', { value: detail.metric.owner || '—' })}</span>
+                  <span>{t('biMetrics.detail.updatedAtLabel', { value: formatTime(detail.metric.updated_at) })}</span>
+                  <span>{t('biMetrics.detail.revisionCountLabel', { count: detail.revisions.length })}</span>
+                </div>
+                <div className="mt-2 flex gap-2">
+                  <button className={btnPrimary} disabled={busy}
+                          onClick={() => onCreateRevision(detail)}>
+                    {t('biMetrics.detail.createRevision')}
+                  </button>
+                  <button className={btn} disabled={busy || !published}
+                          title={published ? undefined
+                            : t('biMetrics.detail.contextNotPublishedHint')}
+                          onClick={loadContext}>
+                    {t('biMetrics.detail.viewContext')}
+                  </button>
+                </div>
+              </div>
+
+              {/* 当前口径：打开详情第一眼要回答的问题 */}
+              <div className="rounded-lg border border-accent/40 bg-accent-subtle p-3">
+                <div className="mb-2 flex items-center gap-2 text-xs font-medium text-text-strong">
+                  {publishedRevs.length
+                    ? t('biMetrics.detail.activeCaliber')
+                    : t('biMetrics.detail.latestCaliberUnpublished')}
+                  <span className="font-mono font-normal text-text-muted">
+                    r{activeRevision.revision_no}
+                  </span>
+                </div>
+                <RevisionBody rev={activeRevision} busy={busy} onConfirmMap={confirmMap} />
+              </div>
+
+              <TermBindingPanel
+                metricKey={detail.metric.metric_key}
+                published={published}
+              />
+
+              {revisionsDesc.length > 0 && (
+                <div className="rounded-lg border border-border p-3">
+                  <div className="text-xs font-medium text-text-strong mb-2">
+                    {t('biMetrics.detail.revisionHistory', { count: detail.revisions.length })}
+                  </div>
+                  <div className="space-y-1">
+                    {revisionsDesc.map((rev) => (
+                      <details key={rev.revision_id}
+                               open={rev.status !== 'published' && !!rev.candidate_maps?.length}>
+                        <summary className="flex cursor-pointer list-none items-center gap-2 rounded px-2 py-1 text-xs hover:bg-bg-hover">
+                          <span className="font-mono text-text-muted">r{rev.revision_no}</span>
+                          <span className={badge(rev.status === 'published' ? 'green'
+                            : rev.status === 'retired' ? 'gray' : 'amber')}>
+                            {enumLabel(t, 'revisionStatus', rev.status)}
+                          </span>
+                          {rev.revision_id === activeRevision.revision_id && (
+                            <span className={badge('blue')}>{t('biMetrics.detail.currentlyActive')}</span>
+                          )}
+                          <span className="text-text-muted">
+                            {enumLabel(t, 'type', rev.metric_type)}
+                            {rev.unit ? ` · ${rev.unit}` : ''}
+                          </span>
+                          {!!rev.candidate_maps?.length && (
+                            <span className="text-warn">
+                              {t('biMetrics.detail.pendingMaps', { count: rev.candidate_maps.length })}
+                            </span>
+                          )}
+                          <span className="ml-auto text-text-weak">{t('biMetrics.detail.expandCollapse')}</span>
+                        </summary>
+                        <div className="px-2 pt-1">
+                          <RevisionBody rev={rev} busy={busy} onConfirmMap={confirmMap} />
+                        </div>
+                      </details>
+                    ))}
+                  </div>
+                </div>
+              )}
+
+              {ctx && (
+                <div className="rounded-lg border border-accent/40 bg-accent-subtle p-3">
+                  <div className="text-xs font-medium text-text-strong mb-2">
+                    {t('biMetrics.detail.semanticContext')}
+                  </div>
+                  <FactGrid items={[
+                    [t('biMetrics.detail.name'), ctx.context.label],
+                    [t('biMetrics.detail.formulaSummary'),
+                      <span className="font-mono">{ctx.context.formula_summary}</span>],
+                    [t('biMetrics.detail.concept'), ctx.context.concept ?? '—'],
+                    [t('biMetrics.detail.numDenom'),
+                      `${ctx.context.numerator ?? '—'} / ${ctx.context.denominator ?? '—'}`],
+                    [t('biMetrics.detail.timeFieldLabel'), ctx.context.time_field ?? '—'],
+                    [t('biMetrics.detail.groupByFields'),
+                      ctx.context.group_by_fields.join(t('biMetrics.sep.enum')) || '—'],
+                    [t('biMetrics.detail.dependencies'),
+                      ctx.context.dependencies.map((d) =>
+                        t('biMetrics.detail.dependencyItem', {
+                          metricKey: d.metric_key,
+                          roles: d.roles.map((r) => enumLabel(t, 'depRole', r))
+                            .join(t('biMetrics.sep.enum')),
+                          fields: d.fields.join(t('biMetrics.sep.enum')),
+                        })).join(t('biMetrics.sep.item')) || '—'],
+                  ]} />
+                  {ctx.context.schema && (
+                    <div className="mt-2">
+                      <SchemaSubgraphView sub={ctx.context.schema}
+                          snapshotId={ctx.context.schema_snapshot_id} />
+                      {ctx.context.drift && (
+                        <div className="mt-1 text-xs text-warn">
+                          {t('biMetrics.detail.schemaDrift')}
+                        </div>
+                      )}
+                    </div>
+                  )}
+                  <div className="mt-3">
+                    <div className="mb-1 text-xs font-medium text-text">
+                      {t('biMetrics.detail.graphTitle')}
+                    </div>
+                    <MetricSchemaGraph ctx={ctx} />
+                  </div>
+                </div>
+              )}
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
