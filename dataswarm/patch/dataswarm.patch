+++ b/jiuwenswarm/channels/web/dataagent/metrics/versioning/term_binding.py
@@ -0,0 +1,210 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning/term_binding.py —— 术语绑定（bind/unbind/list/解析与绑定前置校验）（自 versioning.py 巨石按用例拆分，纯搬运）。
+
+发布语义见包门面 docstring（versioning/__init__.py）。
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+
+from .. import store
+from ..errors import DefinitionError, MetricNotFound
+from ..model import (
+    MAP_CONFIRMED,
+    REVISION_PUBLISHED,
+    ConceptMapping,
+    MetricRevision,
+)
+
+
+# ==========================================================================
+# 术语绑定（链路一：界面/API 直接绑定——人选的，直接 confirmed）
+# ==========================================================================
+
+RELATION_MEASURES_CONCEPT = "measuresConcept"
+
+
+def _target_revision(workspace_id: str, metric_key: str) -> MetricRevision:
+    """绑定落在哪个修订上：当前生效修订，没有就取最新一版。
+
+    ``current_revision_id`` 只在发布时才写，所以「已导入未发布」的指标必须
+    回退到最新修订——否则建模流程里最常见的「先导入、先绑术语、再发布」
+    直接走不通。
+
+    Raises:
+        MetricNotFound: 指标不存在或一个修订都没有。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    if metric.current_revision_id:
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is not None:
+            return revision
+    revisions = store.list_revisions(metric.metric_id)   # revision_no 倒序
+    if not revisions:
+        raise MetricNotFound(f"指标 {metric_key} 还没有任何修订，无法绑定术语")
+    return revisions[0]
+
+
+def bind_term(
+    workspace_id: str,
+    metric_key: str,
+    term_id: str,
+    *,
+    bound_by: str = "",
+) -> dict[str, Any]:
+    """把指标绑定到术语（``measuresConcept``）。
+
+    与 Ossie 导入链路（机器从自由文本猜 → candidate → 人工确认）不同：
+    这条链路的 ``target_ref`` 直接存 **term_id**（人从术语列表点选，无需
+    名字匹配），状态直接 ``confirmed``——点选动作本身就是确认，再要一轮
+    确认是官僚。
+
+    Args:
+        workspace_id: 工作空间。
+        metric_key: 指标 key（绑定落在当前生效修订，未发布时落最新修订）。
+        term_id: 术语 ID（必须存在且未废弃）。
+        bound_by: 操作人（审计）。
+
+    Returns:
+        ``{"mapping": {...}, "created": bool, "term": {...},
+        "reproject_required": bool, "warnings": [...]}``——
+        ``reproject_required`` 为真表示该修订已发布、图上的 measuresConcept
+        边要等下次发布或 ``POST /reprojects`` 才出现（**分析链路不受影响**：
+        元数据推导路直接读本表，绑定即生效）。
+
+    Raises:
+        MetricNotFound: 指标不存在或没有修订。
+        DefinitionError: 术语不存在 / 已废弃 / 术语库不可用。
+    """
+    revision = _target_revision(workspace_id, metric_key)
+    term = _active_term(term_id)
+    warnings: list[str] = []
+
+    # 幂等：同 (修订, measuresConcept, term_id) 已存在 → 置 confirmed 复用
+    existing = store.find_concept_map(
+        revision.revision_id, RELATION_MEASURES_CONCEPT, term_id)
+    if existing is not None:
+        if existing.status != MAP_CONFIRMED:
+            store.set_concept_map_status(
+                existing.mapping_id, MAP_CONFIRMED, confirmed_by=bound_by)
+        mapping = replace(existing, status=MAP_CONFIRMED, confirmed_by=bound_by)
+        created = False
+    else:
+        mapping = ConceptMapping(
+            mapping_id=store.new_id("map"),
+            workspace_id=workspace_id,
+            revision_id=revision.revision_id,
+            relation_type=RELATION_MEASURES_CONCEPT,
+            target_ref=term_id,
+            status=MAP_CONFIRMED,
+            evidence=f"ui:人工绑定术语「{term.get('name')}」",
+            confirmed_by=bound_by,
+        )
+        store.create_concept_map(mapping)
+        created = True
+
+    # 链分叉提示：该术语已被别的指标绑定 → 分析入口无法直达（不阻断，提示）
+    others = {
+        other.revision_id
+        for other in store.list_concept_maps_by_target(
+            workspace_id, RELATION_MEASURES_CONCEPT, term_id, status=MAP_CONFIRMED)
+        if other.revision_id != revision.revision_id
+    }
+    if others:
+        warnings.append(
+            f"term_multi_metric:术语「{term.get('name')}」还绑定了其他 {len(others)} 个指标"
+            "修订——一个术语链到多个指标时，分析提问无法直达单一口径（需用户二选一）")
+
+    return {
+        "mapping": mapping.__dict__,
+        "created": created,
+        "term": {"term_id": term_id, "name": term.get("name")},
+        "reproject_required": revision.status == REVISION_PUBLISHED,
+        "warnings": warnings,
+    }
+
+
+def unbind_term(workspace_id: str, metric_key: str, term_id: str) -> dict[str, Any]:
+    """解除指标与术语的绑定。
+
+    Returns:
+        ``{"removed": bool, "reproject_required": bool}``——未绑定时
+        ``removed=False``（幂等，不报错）。
+
+    Raises:
+        MetricNotFound: 指标不存在或没有修订。
+    """
+    revision = _target_revision(workspace_id, metric_key)
+    existing = store.find_concept_map(
+        revision.revision_id, RELATION_MEASURES_CONCEPT, term_id)
+    if existing is None:
+        return {"removed": False, "reproject_required": False}
+    store.delete_concept_map(existing.mapping_id)
+    return {"removed": True,
+            "reproject_required": revision.status == REVISION_PUBLISHED}
+
+
+def list_terms_of(workspace_id: str, metric_key: str) -> dict[str, Any]:
+    """指标已绑定的术语（含未解析的历史自由文本引用）。
+
+    Returns:
+        ``{"metric_key", "revision_id", "terms": [{mapping_id, target_ref,
+        status, evidence, resolved, term_id, name, definition}]}``——
+        ``resolved=False`` 是历史 Ossie 自由文本引用且当前解析不到术语
+        （图上连不出 Term 边，确认了也没用）。
+
+    Raises:
+        MetricNotFound: 指标不存在或没有修订。
+    """
+    revision = _target_revision(workspace_id, metric_key)
+    out: list[dict[str, Any]] = []
+    for mapping in store.list_concept_maps(revision.revision_id):
+        if mapping.relation_type != RELATION_MEASURES_CONCEPT:
+            continue
+        term = resolve_term_ref(mapping.target_ref)
+        out.append({
+            "mapping_id": mapping.mapping_id,
+            "target_ref": mapping.target_ref,
+            "status": mapping.status,
+            "evidence": mapping.evidence,
+            "resolved": term is not None,
+            "term_id": (term or {}).get("term_id", ""),
+            "name": (term or {}).get("name", ""),
+            "definition": (term or {}).get("definition", ""),
+        })
+    return {"metric_key": metric_key,
+            "revision_id": revision.revision_id, "terms": out}
+
+
+def resolve_term_ref(target_ref: str) -> dict[str, Any] | None:
+    """``target_ref`` → 术语（转调 :func:`graph_projection.resolve_term`）。
+
+    匹配规则只有一份实现（先 term_id 直查、再名字/别名全等），投影侧与
+    分析侧共用——三处各写一份必然漂移。
+    """
+    from .. import graph_projection
+
+    return graph_projection.resolve_term(target_ref)
+
+
+def _active_term(term_id: str) -> dict[str, Any]:
+    """校验术语存在且未废弃（绑定前置校验）。"""
+    try:
+        from ...glossary import resolve_term_for_binding
+
+        term, reason = resolve_term_for_binding(term_id)
+    except Exception as exc:  # noqa: BLE001 —— 术语库不可用：绑定不能静默成功
+        raise DefinitionError(f"术语库不可用，无法校验术语 {term_id}: {exc}") from exc
+    if reason == "missing":
+        raise DefinitionError(f"术语 {term_id} 不存在——请先在术语库创建")
+    if reason == "deprecated":
+        raise DefinitionError(f"术语 {term_id} 已废弃，不能绑定")
+    if term is None:  # 服务函数契约兜底（reason 为空则 term 非空），兼作类型收窄
+        raise DefinitionError(f"术语 {term_id} 解析异常")
+    return term
+
+
