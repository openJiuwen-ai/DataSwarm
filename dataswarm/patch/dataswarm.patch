+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Workspace-scoped business and metadata database resolution.
+
+The MVP keeps workspace definitions in ``datasource.yaml``.  This module is
+the single parser used by the service, CLI and skills; callers should not
+parse that file independently.
+"""
+from __future__ import annotations
+
+import os
+from contextvars import ContextVar, Token
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+try:
+    import yaml  # type: ignore
+except ImportError:  # pragma: no cover - package installs normally provide PyYAML
+    from ruamel.yaml import YAML
+
+    class _YamlCompat:
+        @staticmethod
+        def safe_load(text: str):
+            return YAML(typ="safe").load(text)
+
+    yaml = _YamlCompat()
+
+
+class WorkspaceContextError(ValueError):
+    """Base error for invalid or missing workspace context."""
+
+
+class WorkspaceNotConfigured(WorkspaceContextError):
+    """No workspace exists; standalone references may remain self-contained."""
+
+
+class WorkspaceContextRequired(WorkspaceContextError):
+    code = "WORKSPACE_CONTEXT_REQUIRED"
+
+    def __init__(self, workspace_ids: list[str]):
+        self.workspace_ids = workspace_ids
+        super().__init__(
+            f"workspace_id is required when multiple workspaces are configured "
+            f"(available: {', '.join(workspace_ids)})"
+        )
+
+
+class WorkspaceRefNotAllowed(WorkspaceContextError):
+    code = "DB_REF_NOT_ALLOWED"
+
+
+class DuplicateMetadataRef(WorkspaceContextError):
+    code = "DUPLICATE_METADATA_DB_REF"
+
+
+class WorkspaceBusinessNotBound(WorkspaceContextError):
+    code = "WORKSPACE_BUSINESS_NOT_BOUND"
+
+    def __init__(self, workspace_id: str):
+        self.workspace_id = workspace_id
+        super().__init__(
+            f"workspace {workspace_id!r} has no business database bound; "
+            "create a data source under this workspace first"
+        )
+
+
+@dataclass(frozen=True)
+class WorkspaceContext:
+    workspace_id: str
+    name: str
+    business_db_ref: str
+    metadata_db_ref: str
+    description: str = ""
+
+
+_current_workspace_id: ContextVar[str | None] = ContextVar(
+    "current_workspace_id", default=None
+)
+
+
+def _config_path() -> Path:
+    from . import db_connector
+
+    return db_connector._datasource_config_path()
+
+
+def _load_yaml() -> dict[str, Any]:
+    path = _config_path()
+    if not path.is_file():
+        return {}
+    try:
+        raw = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+    except (OSError, yaml.YAMLError) as exc:
+        raise WorkspaceContextError(f"invalid datasource config: {exc}") from exc
+    return raw if isinstance(raw, dict) else {}
+
+
+def list_configured_datasources() -> list[dict[str, Any]]:
+    """Return connection sections declared in datasource.yaml.
+
+    Workspace bindings are returned by ``list_workspaces``. This function only
+    exposes named connection sections such as ``doris`` and ``mysql`` and
+    never returns secret fields.
+    """
+    config = _load_yaml()
+    reserved = {"default_db", "metadata_db", "workspaces"}
+    sources: list[dict[str, Any]] = []
+    for source_type, raw in config.items():
+        if source_type in reserved or not isinstance(raw, dict):
+            continue
+        if not any(key in raw for key in ("host", "port", "database", "path", "location", "url")):
+            continue
+        safe_config = {
+            key: value
+            for key, value in raw.items()
+            if key not in {"password", "secret", "secret_key", "access_key", "token"}
+        }
+        sources.append(
+            {
+                "source_id": f"yaml:{source_type}",
+                "source_type": str(source_type),
+                "name": _text(raw.get("name")) or str(source_type),
+                "ref": f"{source_type}://",
+                "config": safe_config,
+                "managed": False,
+                "read_only": True,
+                "config_source": "yaml",
+            }
+        )
+    return sources
+
+
+def _text(value: Any) -> str:
+    return str(value or "").strip().strip("'").strip('"')
+
+
+def _workspace_records() -> list[WorkspaceContext]:
+    cfg = _load_yaml()
+    records: list[WorkspaceContext] = []
+    top_business = _text(cfg.get("default_db"))
+    top_metadata = _text(cfg.get("metadata_db")) or top_business
+    entries = cfg.get("workspaces")
+    if isinstance(entries, dict):
+        # Keep the legacy top-level pair as the explicit default workspace.
+        if top_business:
+            records.append(WorkspaceContext("default", "默认工作空间", top_business, top_metadata))
+        for workspace_id, raw in entries.items():
+            if not isinstance(raw, dict):
+                raise WorkspaceContextError(f"workspace {workspace_id!r} must be an object")
+            wid = _text(workspace_id)
+            if not wid or wid == "default":
+                raise WorkspaceContextError(f"invalid workspace id: {workspace_id!r}")
+            business = _text(raw.get("business_db_ref") or raw.get("default_db"))
+            metadata = _text(raw.get("metadata_db"))
+            if not business or not metadata:
+                raise WorkspaceContextError(
+                    f"workspace {wid!r} requires default_db and metadata_db"
+                )
+            records.append(WorkspaceContext(wid, _text(raw.get("name")) or wid, business, metadata,
+                                            _text(raw.get("description"))))
+    elif top_business:
+        records.append(WorkspaceContext("default", "默认工作空间", top_business, top_metadata))
+    try:
+        from . import workspace_store
+
+        records.extend(
+            WorkspaceContext(
+                str(row["workspace_id"]),
+                str(row["name"]),
+                str(row["business_db_ref"]),
+                str(row["metadata_db_ref"]),
+                str(row.get("description") or ""),
+            )
+            for row in workspace_store.list_workspaces()
+        )
+    except Exception as exc:
+        if isinstance(exc, WorkspaceContextError):
+            raise
+        raise WorkspaceContextError(f"invalid custom workspace registry: {exc}") from exc
+    if not records:
+        raise WorkspaceNotConfigured("no business database configured")
+    _validate_unique_metadata(records)
+    return records
+
+
+def _validate_unique_metadata(records: list[WorkspaceContext]) -> None:
+    seen: dict[str, str] = {}
+    for record in records:
+        key = normalize_db_ref(record.metadata_db_ref)
+        previous = seen.get(key)
+        if previous and previous != record.workspace_id:
+            raise DuplicateMetadataRef(
+                f"workspaces {previous!r} and {record.workspace_id!r} use the same metadata database"
+            )
+        seen[key] = record.workspace_id
+
+
+def list_workspaces() -> list[WorkspaceContext]:
+    return _workspace_records()
+
+
+def is_yaml_workspace(workspace_id: str) -> bool:
+    """Return whether a workspace id is declared in datasource.yaml."""
+    requested = _text(workspace_id)
+    if not requested:
+        return False
+    config = _load_yaml()
+    if requested == "default" and _text(config.get("default_db")):
+        return True
+    entries = config.get("workspaces")
+    return isinstance(entries, dict) and requested in entries
+
+
+def resolve(workspace_id: str | None = None) -> WorkspaceContext:
+    requested = _text(workspace_id) or _current_workspace_id.get()
+    records = _workspace_records()
+    if not requested:
+        if len(records) == 1:
+            return records[0]
+        raise WorkspaceContextRequired([r.workspace_id for r in records])
+    for record in records:
+        if record.workspace_id == requested:
+            return record
+    raise WorkspaceContextError(
+        f"unknown workspace_id {requested!r} (available: {', '.join(r.workspace_id for r in records)})"
+    )
+
+
+def selected_workspace_id() -> str | None:
+    """Explicit request/session selection, without loading the registry or YAML."""
+    return _current_workspace_id.get() or os.environ.get("JIUWENSWARM_WORKSPACE_ID", "").strip() or None
+
+
+def current_workspace() -> WorkspaceContext:
+    """当前调用链的工作空间（ContextVar 缺省时按配置形态分流）。
+
+    解析链（决策四）：
+    - legacy env 覆盖（JIUWENSWARM_ORCH_DB，直连 ref）优先级最高（方案风险表：仅多库化不动语义）。
+    - env ``JIUWENSWARM_WORKSPACE_ID``（bash 子进程注入的会话选中工作空间）——
+      编排脚本经 subprocess 链调用 orchestration/db 时 ContextVar 不会传播，
+      靠此 env 解析（建仓 plan_to_tasks→orch_db 事故链）。
+    - ContextVar（AgentServer 进程内 rail 设置）。
+    - 配置了多个工作空间且上下文缺失 → ``WORKSPACE_CONTEXT_REQUIRED``（决策八-1，大声失败）。
+    - 单工作空间/legacy → 静默默认。
+    """
+    from . import db_connector
+
+    requested = _current_workspace_id.get()
+    if requested:
+        return resolve(requested)
+    env = db_connector.env_orch_db_ref()
+    if env:
+        return WorkspaceContext("", "默认工作空间", env, env)
+    ws_env = os.environ.get("JIUWENSWARM_WORKSPACE_ID", "").strip()
+    if ws_env:
+        return resolve(ws_env)
+    return resolve()
+
+
+def set_current(workspace_id: str | None) -> Token[str | None]:
+    if workspace_id:
+        resolve(workspace_id)
+    return _current_workspace_id.set(_text(workspace_id) or None)
+
+
+def reset(token: Token[str | None]) -> None:
+    _current_workspace_id.reset(token)
+
+
+def same_physical_ref(ref_a: str, ref_b: str) -> bool:
+    """两个 db_ref 是否指向同一物理库（归一化后比较；解析失败回退字面比对）。"""
+    try:
+        return normalize_db_ref(ref_a) == normalize_db_ref(ref_b)
+    except Exception:
+        return ref_a == ref_b
+
+
+def normalize_db_ref(db_ref: str) -> str:
+    from . import db_connector
+
+    if isinstance(db_ref, str) and db_ref.startswith("duckdb://"):
+        # 文件源 ref：location 规范化（expanduser+resolve）后重组，
+        # 保证绑定比较（_plan_workspace_binding 的 same 判定）稳定。
+        spec = db_connector.parse_db_ref(db_ref)
+        location = spec["location"]
+        if "://" not in location:
+            location = str(Path(location).expanduser().resolve())
+        return db_connector.build_file_source_ref(spec["source_type"], location, spec["table_name"])
+    spec = db_connector.parse_db_ref(db_ref)
+    kind = spec.get("type", "sqlite")
+    if kind == "sqlite":
+        return f"sqlite://{Path(spec['path']).expanduser().resolve()}"
+    # These codecs do not identify their target by host/port/database. Keep
+    # their actual identity fields in the key; credentials never belong here.
+    if kind == "ddl":
+        return f"ddl://{spec['fingerprint']}"
+    host = _text(spec.get("host")).lower()
+    if kind == "redis":
+        return f"redis://{host}:{int(spec['port'])}/{int(spec['db'])}"
+    # doris://db（省略端口）经 parse_db_ref 落到 3306 缺省，doris 实际缺省 9030——
+    # 在此归一，防同库两种写法被判为不同库（二轮 R6）
+    port = int(spec.get("port") or 0) or (9030 if kind == "doris" else 3306)
+    if kind == "doris" and port == 3306:
+        port = 9030
+    return f"{kind}://{host}:{port}/{_text(spec.get('database'))}"
+
+
+def validate_ref_in_workspace(workspace_id: str | None, role: str, db_ref: str) -> str:
+    """校验 db_ref 归属当前工作空间，返回匹配到的规范 ref。
+
+    role 参数保留透传（调用方/接口签名不变），但**不再按 role 限制 ref 归属**
+    （用户决策 2026-09-07：接口层放开 role 内容校验）——本工作空间的业务库与
+    元库 ref 互相通用。仅保留 workspace 边界：不属于当前工作空间任何一库的
+    ref 仍大声拒绝，防跨工作空间串库。
+    """
+    try:
+        context = resolve(workspace_id)
+    except WorkspaceContextRequired:
+        # workspace_id 未指定（如 BI 卡片渲染只带显式 datasource_ref）：ref 命中
+        # 任一工作空间的任一库即放行（返回该库规范 ref）；都不命中维持大声失败。
+        try:
+            actual_key = normalize_db_ref(db_ref)
+        except Exception as exc:
+            raise WorkspaceRefNotAllowed(f"invalid db_ref: {db_ref!r}") from exc
+        for record in _workspace_records():
+            for candidate in (record.business_db_ref, record.metadata_db_ref):
+                try:
+                    if normalize_db_ref(candidate) == actual_key:
+                        return candidate
+                except Exception:  # noqa: BLE001 —— 单条 ref 解析失败不影响其余候选
+                    continue
+        raise WorkspaceRefNotAllowed(
+            f"db_ref is not allowed for any workspace: {db_ref!r}"
+        ) from None
+    try:
+        actual_key = normalize_db_ref(db_ref)
+    except Exception as exc:
+        raise WorkspaceRefNotAllowed(f"invalid db_ref: {db_ref!r}") from exc
+    if not context.business_db_ref:
+        raise WorkspaceBusinessNotBound(context.workspace_id)
+    for candidate in (context.business_db_ref, context.metadata_db_ref):
+        try:
+            if normalize_db_ref(candidate) == actual_key:
+                return candidate
+        except Exception:  # noqa: BLE001
+            continue
+    raise WorkspaceRefNotAllowed(
+        f"db_ref is not allowed for workspace={context.workspace_id}: {db_ref!r}"
+    )
+
+
+def resolve_business_ref(datasource_ref: str | None = None, workspace_id: str | None = None) -> str:
+    """解析目标业务库 db-ref（公共函数，替代跨模块导入私有 _business_ref_or_default）。
+
+    优先级：显式 datasource_ref > 当前工作空间业务库（含 env 覆盖链，
+    与 current_workspace 同源）> config default_db。禁止兜底元数据库
+    （角色分离原则，历史混用已消灭）。
+    """
+    if datasource_ref:
+        validate_ref_in_workspace(workspace_id, "business", datasource_ref)
+        return datasource_ref
+    try:
+        ctx = current_workspace() if workspace_id is None else resolve(workspace_id)
+        if ctx.business_db_ref:
+            return ctx.business_db_ref
+    except Exception:
+        pass
+    from . import db_connector
+
+    ref = db_connector.default_db_ref()
+    if not ref:
+        raise WorkspaceContextError("业务库未配置：请在工作空间或 datasource.yaml 中指定 default_db")
+    return ref
+
+
+def business_database_name(db_ref: str) -> str:
+    """Public selector for one bound datasource; never expose its credentials.
+
+    Keep file-source names aligned with their existing data-management DAO.
+    Non-SQL protocols may have a file, table or numeric database instead
+    of the relational ``database`` field.
+    """
+    from . import db_connector
+
+    spec = db_connector.parse_db_ref(db_ref)
+    kind = spec.get("type")
+    source_type = spec.get("source_type") or kind
+    if kind == "duckdb" and source_type not in {"ftp", "hdfs"}:
+        return Path(str(spec.get("location") or "")).name
+    if kind == "duckdb":
+        return str(spec.get("table_name") or source_type)
+    if kind == "sqlite":
+        return Path(str(spec.get("path") or "")).stem
+    for key in ("database", "db", "table_name"):
+        if spec.get(key) is not None and spec[key] != "":
+            return str(spec[key])
+    return str(source_type or "")
+
+
+def validate_business_database_name(workspace_id: str | None, db_name: str) -> str:
+    """Validate the legacy URL ``/databases/{db_name}`` selector.
+
+    The old database-management API carries a bare database name rather than
+    a complete db-ref.  It must still be constrained to the current
+    workspace's business database.
+    """
+    context = resolve(workspace_id)
+    if not context.business_db_ref:
+        raise WorkspaceBusinessNotBound(context.workspace_id)
+    expected = business_database_name(context.business_db_ref)
+    if not expected or _text(db_name) != _text(expected):
+        raise WorkspaceRefNotAllowed(
+            f"database {db_name!r} is not allowed for workspace={context.workspace_id}"
+        )
+    return context.business_db_ref
+
+
+def business_db_ref(workspace_id: str | None = None) -> str:
+    """当前工作空间的业务库 ref——未绑定时大声拒绝（WORKSPACE_BUSINESS_NOT_BOUND）。
+
+    唯一收口点：下游（db_connector 双路由 / 编排 / 巡检 / CLI）取业务库必须经此，
+    防空 ref 静默流入任务与查询链路。
+    """
+    context = resolve(workspace_id)
+    if not context.business_db_ref:
+        raise WorkspaceBusinessNotBound(context.workspace_id)
+    return context.business_db_ref
+
+
+def metadata_db_ref(workspace_id: str | None = None) -> str:
+    return resolve(workspace_id).metadata_db_ref
+
+
+def sanitize_ref(db_ref: str) -> str:
+    """db-ref 脱敏摘要（决策八-4）：只留 type+database，不带 host/凭据。
+
+    manifest、task_run、日志、dwcli 回显共用这一套，防原始 URI 泄露主机/密码。
+    sqlite 路径仅保留文件名。
+    """
+    if not db_ref:
+        return ""
+    try:
+        from . import db_connector
+
+        spec = db_connector.parse_db_ref(db_ref)
+        kind = spec.get("type", "sqlite")
+        if kind == "sqlite":
+            return f"sqlite:{Path(_text(spec.get('path'))).name}"
+        if kind == "duckdb":
+            return f"duckdb:{Path(_text(spec.get('location'))).name}"
+        database = _text(spec.get("database"))
+        return f"{kind}:{database}"
+    except Exception:
+        # 解析失败时只保留 scheme，绝不上抛原始 ref
+        return db_ref.split("://", 1)[0] + ":?" if "://" in db_ref else "?"
+
+
+def audit_summary(workspace_id: str | None = None) -> dict:
+    """审计留痕摘要（决策八-3/4）：workspace_id + 双 ref 脱敏摘要。
+
+    task_run / manifest / inspection 落库共用。不含凭据与主机名。
+    """
+    ctx = resolve(workspace_id)
+    return {
+        "workspace_id": ctx.workspace_id,
+        "business_ref": sanitize_ref(ctx.business_db_ref),
+        "metadata_ref": sanitize_ref(ctx.metadata_db_ref),
+    }
diff --git a/jiuwenswarm/common/workspace_store.py b/jiuwenswarm/common/workspace_store.py
new file mode 100644
index 000000000..d8ff55cee
--- /dev/null
+++ b/jiuwenswarm/common/workspace_store.py
@@ -0,0 +1,204 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+import re
+import sqlite3
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from .utils import get_user_workspace_dir
+
+
+_WORKSPACE_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
+
+
+def _config_dir() -> Path:
+    path = get_user_workspace_dir() / "config"
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _registry_path() -> Path:
+    return _config_dir() / "workspaces.db"
+
+
+def _connect() -> sqlite3.Connection:
+    connection = sqlite3.connect(_registry_path())
+    connection.row_factory = sqlite3.Row
+    connection.execute(
+        """
+        CREATE TABLE IF NOT EXISTS dw_workspaces (
+            workspace_id TEXT PRIMARY KEY,
+            name TEXT NOT NULL,
+            business_db_ref TEXT NOT NULL,
+            metadata_db_ref TEXT NOT NULL,
+            description TEXT NOT NULL DEFAULT '',
+            created_at TEXT NOT NULL
+        )
+        """
+    )
+    # 存量库幂等加列（CREATE IF NOT EXISTS 不给旧表加列）
+    cols = {row[1] for row in connection.execute("PRAGMA table_info(dw_workspaces)")}
+    if "description" not in cols:
+        connection.execute(
+            "ALTER TABLE dw_workspaces ADD COLUMN description TEXT NOT NULL DEFAULT ''"
+        )
+    connection.commit()
+    return connection
+
+
+def list_workspaces() -> list[dict[str, Any]]:
+    connection = _connect()
+    try:
+        return [dict(row) for row in connection.execute(
+            "SELECT workspace_id, name, business_db_ref, metadata_db_ref, description "
+            "FROM dw_workspaces ORDER BY created_at, workspace_id"
+        )]
+    finally:
+        connection.close()
+
+
+def create_workspace(name: str, business_db_ref: str = "", workspace_id: str | None = None,
+                     description: str = "") -> dict[str, Any]:
+    clean_name = str(name or "").strip()
+    if not clean_name:
+        raise ValueError("workspace name is required")
+    if len(clean_name) > 120:
+        raise ValueError("workspace name must be at most 120 characters")
+    clean_desc = str(description or "").strip()
+    if len(clean_desc) > 500:
+        raise ValueError("workspace description must be at most 500 characters")
+    clean_ref = str(business_db_ref or "").strip()
+
+    candidate = str(workspace_id or "").strip()
+    if candidate and not _WORKSPACE_ID_RE.fullmatch(candidate):
+        raise ValueError("workspace_id must contain only letters, digits, '_' or '-'")
+    workspace_id = candidate or f"custom-{uuid.uuid4().hex[:12]}"
+    metadata_path = _config_dir() / f"workspace_{workspace_id}.db"
+    metadata_ref = f"sqlite://{metadata_path}"
+
+    connection = _connect()
+    try:
+        if connection.execute(
+            "SELECT 1 FROM dw_workspaces WHERE workspace_id = ?", (workspace_id,)
+        ).fetchone():
+            raise ValueError(f"workspace_id already exists: {workspace_id}")
+        connection.execute(
+            "INSERT INTO dw_workspaces "
+            "(workspace_id, name, business_db_ref, metadata_db_ref, description, created_at) "
+            "VALUES (?, ?, ?, ?, ?, ?)",
+            (workspace_id, clean_name, clean_ref, metadata_ref, clean_desc,
+             datetime.now(timezone.utc).isoformat(timespec="seconds")),
+        )
+        connection.commit()
+    except Exception:
+        connection.rollback()
+        raise
+    finally:
+        connection.close()
+
+    return {
+        "workspace_id": workspace_id,
+        "name": clean_name,
+        "business_db_ref": clean_ref,
+        "metadata_db_ref": metadata_ref,
+        "description": clean_desc,
+    }
+
+
+def update_business_ref(workspace_id: str, db_ref: str) -> dict[str, Any]:
+    """绑定/换绑/解绑工作空间的业务数据源（覆盖式单绑定，空串 = 解绑）。"""
+    clean_ref = str(db_ref or "").strip()
+    clean_id = str(workspace_id or "").strip()
+    connection = _connect()
+    try:
+        existing = connection.execute(
+            "SELECT workspace_id FROM dw_workspaces WHERE workspace_id = ?", (clean_id,)
+        ).fetchone()
+        if not existing:
+            raise ValueError(f"workspace not found: {clean_id}")
+        connection.execute(
+            "UPDATE dw_workspaces SET business_db_ref = ? WHERE workspace_id = ?",
+            (clean_ref, clean_id),
+        )
+        connection.commit()
+    except Exception:
+        connection.rollback()
+        raise
+    finally:
+        connection.close()
+    return {"workspace_id": clean_id, "business_db_ref": clean_ref}
+
+
+def update_workspace(workspace_id: str, name: str | None = None,
+                     description: str | None = None) -> dict[str, Any]:
+    """修改工作空间 name/description（传 None 表示不改该字段）。
+
+    双 ref 与 workspace_id 不可改（换绑走 update_business_ref，改 id 会孤儿化
+    元库文件与历史归属）。
+    """
+    clean_id = str(workspace_id or "").strip()
+    updates: dict[str, Any] = {}
+    if name is not None:
+        clean_name = str(name or "").strip()
+        if not clean_name:
+            raise ValueError("workspace name is required")
+        if len(clean_name) > 120:
+            raise ValueError("workspace name must be at most 120 characters")
+        updates["name"] = clean_name
+    if description is not None:
+        clean_desc = str(description or "").strip()
+        if len(clean_desc) > 500:
+            raise ValueError("workspace description must be at most 500 characters")
+        updates["description"] = clean_desc
+    if not updates:
+        raise ValueError("nothing to update: name or description is required")
+    connection = _connect()
+    try:
+        existing = connection.execute(
+            "SELECT workspace_id FROM dw_workspaces WHERE workspace_id = ?", (clean_id,)
+        ).fetchone()
+        if not existing:
+            raise ValueError(f"workspace not found: {clean_id}")
+        connection.execute(
+            f"UPDATE dw_workspaces SET {', '.join(f'{column} = ?' for column in updates)} "
+            "WHERE workspace_id = ?",
+            (*updates.values(), clean_id),
+        )
+        connection.commit()
+    except Exception:
+        connection.rollback()
+        raise
+    finally:
+        connection.close()
+    row = next((item for item in list_workspaces() if item["workspace_id"] == clean_id), None)
+    if row is None:
+        raise RuntimeError(f"workspace row missing after update: {clean_id}")
+    return row
+
+
+def delete_workspace(workspace_id: str) -> dict[str, Any]:
+    """物理删除注册行。返回被删行的双 ref（service 拿去定位元库文件）。"""
+    clean_id = str(workspace_id or "").strip()
+    connection = _connect()
+    try:
+        row = connection.execute(
+            "SELECT business_db_ref, metadata_db_ref FROM dw_workspaces WHERE workspace_id = ?",
+            (clean_id,),
+        ).fetchone()
+        if not row:
+            raise ValueError(f"workspace not found: {clean_id}")
+        connection.execute("DELETE FROM dw_workspaces WHERE workspace_id = ?", (clean_id,))
+        connection.commit()
+    except Exception:
+        connection.rollback()
+        raise
+    finally:
+        connection.close()
+    return {
+        "workspace_id": clean_id,
+        "business_db_ref": str(row["business_db_ref"] or ""),
+        "metadata_db_ref": str(row["metadata_db_ref"] or ""),
+    }
diff --git a/jiuwenswarm/dataswarm_boot.py b/jiuwenswarm/dataswarm_boot.py
new file mode 100644
index 000000000..008912ce5
--- /dev/null
+++ b/jiuwenswarm/dataswarm_boot.py
@@ -0,0 +1,175 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""DataSwarm 启动引导：dataswarm* CLI 入口统一经本模块注入默认运行时根目录与端口基准。
+
+解决的问题：DataSwarm 与基座 jiuwenswarm 同机共存时，默认都落在 ``~/.jiuwenswarm``
+会互相覆盖配置/会话/产物。核心服务本就支持 ``JIUWENSWARM_DATA_DIR`` 环境变量
+（``jiuwenswarm.common.utils.get_user_workspace_dir``），缺的只是默认值——本模块
+在入口处补上：
+
+- ``JIUWENSWARM_DATA_DIR`` 默认 ``~/.dataswarm``（``JIUWENSWARM_HOME`` 设定时为
+  ``<JIUWENSWARM_HOME>/.dataswarm``，与基座解析 ``~/.jiuwenswarm`` 的基准一致）。
+  全部用 ``setdefault``：用户显式设置、多实例（``--name``）注入永远优先。
+- 端口基准组整组 +11000：``agent_server=29092 / web=30000 / gateway=30001 /
+  frontend=16173``。避开基座默认组（18092/19000/19001/5173）及其回退扫描段
+  （index 0..9，即 agent 18xxx-27xxx、web/gateway 19xxx-28xxx、frontend
+  5xxx-14xxx），也低于 Linux 临时端口段下沿 32768——与基座同跑时互不抢占，
+  bind 探测回退降级为纯保险。
+
+注意：
+- 命名实例（``--name``）的端口组在 ``instances.yaml`` 里显式持久化，历史实例
+  仍用旧基准的组；如与基座同跑冲突，重建实例或手改 yaml 端口组。
+- ``dwcli`` / ``jiuwenbox*`` 入口不经本模块（Agent.md 对外标识约定不变）；
+  ``dwcli`` 经 ``DWAGENT_BASE`` 与继承的进程环境发现服务。
+- 直接 ``python -m jiuwenswarm.<module>`` 启动不经入口，需自行 export 同名
+  环境变量（``scripts/dev/restart-dev.sh`` 已统一 export）。
+"""
+from __future__ import annotations
+
+import logging
+import os
+import sys
+from pathlib import Path
+
+logger = logging.getLogger("dataswarm-boot")
+
+_DATA_DIR_NAME = ".dataswarm"
+
+# 端口基准组：基座 BASE_PORTS 整组 +11000（组内偏移关系不变）
+_DEFAULT_PORT_BASES = {
+    "JIUWENSWARM_AGENT_SERVER_PORT": "29092",
+    "JIUWENSWARM_WEB_PORT": "30000",
+    "JIUWENSWARM_GATEWAY_PORT": "30001",
+    "JIUWENSWARM_FRONTEND_PORT": "16173",
+}
+
+
+def _default_data_dir() -> Path:
+    """默认运行时根目录：``<JIUWENSWARM_HOME 或 home>/.dataswarm``。"""
+    env_home = os.getenv("JIUWENSWARM_HOME")
+    base = Path(env_home).expanduser() if env_home else Path.home()
+    return base / _DATA_DIR_NAME
+
+
+def _apply_defaults() -> None:
+    """注入 DATA_DIR 与端口基准默认值（setdefault，显式设置优先）。"""
+    if "JIUWENSWARM_DATA_DIR" not in os.environ:
+        data_dir = _default_data_dir()
+        os.environ["JIUWENSWARM_DATA_DIR"] = str(data_dir)
+        logger.info("[dataswarm-boot] JIUWENSWARM_DATA_DIR 默认注入: %s", data_dir)
+    for key, value in _DEFAULT_PORT_BASES.items():
+        os.environ.setdefault(key, value)
+    # dwcli（skill 取数通道）的 Web API base：注入 FRONTEND_PORT——两种启动形态
+    # 都能服务 /api：正式（whl/桌面）单实例形态 app_web 监听 FRONTEND_PORT
+    # （前端静态 + /api 代理一体）；dev 形态 vite 占 FRONTEND_PORT 且 /api 代理
+    # 到独立 app_web。端口取已 setdefault 的 JIUWENSWARM_FRONTEND_PORT（命名
+    # 实例的端口组随之）。注：dwcli 的 base 解析中显式 DWAGENT_BASE 直接生效
+    # （不走回落探测链），注入值必须两种形态都正确——此前注入 WEB_PORT+2
+    # （30002）只有 dev 形态的独立 app_web 监听，whl 实测（dev42，2026-11-02）
+    # 单实例形态 30002 无人监听 → dwcli 恒连接拒绝。显式设置仍优先。
+    os.environ.setdefault(
+        "DWAGENT_BASE", f"http://127.0.0.1:{os.environ.get('JIUWENSWARM_FRONTEND_PORT', '16173')}")
+    # agent 的 bash 工具继承本进程 PATH：把服务自身的 Python 目录前置，保证
+    # skill 文档教的 `python -m jiuwenswarm.cli.dwcli` 解析到服务的 Python——
+    # whl 实测（dev42，2026-11-02）：PATH 只含系统 Python，agent 首跳
+    # ModuleNotFoundError 后自愈换完整路径，白耗 1-2 轮对话（冒烟 6 个失败
+    # 调用之一）
+    exe_dir = os.path.dirname(os.path.abspath(sys.executable))
+    path_sep = ";" if os.name == "nt" else ":"
+    if exe_dir and exe_dir not in (os.environ.get("PATH") or "").split(path_sep):
+        os.environ["PATH"] = exe_dir + path_sep + (os.environ.get("PATH") or "")
+        logger.info("[dataswarm-boot] PATH 前置服务 Python 目录: %s", exe_dir)
+
+
+def main() -> int:
+    """dataswarm（CLI 总入口）引导。"""
+    _apply_defaults()
+    from jiuwenswarm.cli.main import main as cli_main
+
+    return cli_main()
