+    old_ref = adapter.build_ref({"path": biz_dir})
+    new_dir = Path(biz_dir).parent / "biz_moved2"
+    new_ref = adapter.build_ref({"path": str(new_dir)})
+    other_ref = adapter.build_ref({"path": str(Path(biz_dir).parent / "other_src")})
+
+    # 工作空间元数据库建表 + 预置两条绑定（一条待级联、一条属其他源）
+    meta_ref = workspace_context.resolve(workspace_id).metadata_db_ref
+    ensure_system_schema(meta_ref)
+    token = workspace_context.set_current(workspace_id)
+    try:
+        metric_store.create_binding(Binding(
+            binding_id="bnd_cascade_hit", revision_id="rev_hit", workspace_id=workspace_id,
+            datasource_alias="moved_csv", datasource_ref=old_ref,
