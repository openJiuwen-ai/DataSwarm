--- /dev/null
+++ b/tests/acceptance/datasource/duckdb_native/verify_gates.py
@@ -0,0 +1,373 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""DuckDB 原生文件验收：临时实例、API 分发、SQL 分析与知识候选。
+
+脚本自行生成 240 行订单和多 schema 数据，所有文件及工作空间均位于临时目录。
+API 通过进程内 handler 调用；不启动 HTTP 服务，不调用 LLM 或云平台。
+"""
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+from contextlib import ExitStack, contextmanager
+from datetime import date, timedelta
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+from functools import partial
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import socket
+import sys
+import tempfile
+from unittest.mock import patch
+from urllib.parse import parse_qs, quote, urlencode, urlparse
+
+ROOT = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(ROOT))
+FACT = '"main"."fact_orders"'
+OTHER_FACT = '"sales"."fact_orders"'
+ODD_TABLE = '"odd.schema"."daily / ""quoted"""'
+VIEW = '"main"."order_summary"'
+TABLES = {FACT, OTHER_FACT, ODD_TABLE, VIEW}
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def normalized(rows):
+    def cell(value):
+        if value is None:
+            return None
+        try:
+            return format(Decimal(str(value)).quantize(Decimal("0.0001"), rounding=ROUND_HALF_UP), "f")
+        except (InvalidOperation, ValueError):
+            return str(value)
+    return [[cell(value) for value in row] for row in rows]
+
+
+def make_fixture(path):
+    import duckdb
+
+    rows = [(n, date(2026, 1, 1) + timedelta(days=n % 90), n % 4,
+             n % 3, None if n % 11 == 0 else Decimal(n * 137 % 10000) / 100)
+            for n in range(1, 241)]
+    with duckdb.connect(str(path)) as connection:
+        connection.execute("CREATE TABLE fact_orders (order_id BIGINT PRIMARY KEY, order_date DATE NOT NULL, "
+                           "region_id INTEGER NOT NULL, category_id INTEGER NOT NULL DEFAULT 0, "
+                           "order_amt DECIMAL(12,2))")
+        connection.executemany("INSERT INTO fact_orders VALUES (?, ?, ?, ?, ?)", rows)
+        connection.execute("COMMENT ON TABLE fact_orders IS 'Acceptance orders'")
+        connection.execute("COMMENT ON COLUMN fact_orders.order_amt IS 'Order amount'")
+        connection.execute("CREATE SCHEMA sales")
+        connection.execute("CREATE TABLE sales.fact_orders (order_id INTEGER, order_amt INTEGER)")
+        connection.execute("INSERT INTO sales.fact_orders VALUES (999, 17)")
+        connection.execute('CREATE SCHEMA "odd.schema"')
+        connection.execute(f"CREATE TABLE {ODD_TABLE} (label VARCHAR)")
+        connection.execute(f"INSERT INTO {ODD_TABLE} VALUES ('quoted-name-row')")
+        connection.execute("CREATE VIEW order_summary AS SELECT region_id, SUM(order_amt) AS order_amt "
+                           "FROM fact_orders GROUP BY region_id")
+    return rows
+
+
+def expected_answers(rows):
+    regions, months, categories = defaultdict(Decimal), defaultdict(Decimal), defaultdict(int)
+    total, nulls = Decimal(0), 0
+    for _, day, region, category, amount in rows:
+        if amount is None:
+            nulls += 1
+            continue
+        total += amount
+        regions[region] += amount
+        months[day.isoformat()[:7]] += amount
+        if region != 3:
+            categories[category] += 1
+    return {
+        "sum": normalized([[total]]),
+        "top_regions": normalized(sorted(regions.items(), key=lambda pair: (-pair[1], pair[0]))[:3]),
+        "monthly": normalized(sorted(months.items())),
+        "filtered_count": normalized(sorted(categories.items())),
+        "null_rate": normalized([[Decimal(nulls) * 100 / len(rows)]]),
+    }
+
+
+def questions():
+    return {
+        "sum": f"SELECT SUM(order_amt) FROM {FACT}",
+        "top_regions": (
+            f"SELECT region_id, SUM(order_amt) AS amount FROM {FACT} "
+            "GROUP BY region_id ORDER BY amount DESC, region_id LIMIT 3"
+        ),
+        "monthly": (
+            f"SELECT strftime(order_date, '%Y-%m') AS month, SUM(order_amt) FROM {FACT} "
+            "GROUP BY month ORDER BY month"
+        ),
+        "filtered_count": (
+            f"SELECT category_id, COUNT(*) FROM {FACT} WHERE region_id <> 3 AND order_amt IS NOT NULL "
+            "GROUP BY category_id ORDER BY category_id"
+        ),
+        "null_rate": f"SELECT 100.0 * SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END) / COUNT(*) FROM {FACT}",
+    }
+
+
+class Handler:
+    def __init__(self, body, workspace):
+        raw = json.dumps(body or {}).encode("utf-8")
+        self.rfile = io.BytesIO(raw)
+        self.headers = {"Content-Length": str(len(raw)), "X-Workspace-Id": workspace}
+        self.response = None
+
+    @staticmethod
+    def _query_arg(parsed, key):
+        return (parse_qs(parsed.query).get(key) or [""])[0]
+
+    def _write_json(self, status, body):
+        self.response = status, body
+
+
+class Harness:
+    def __init__(self, temp):
+        from jiuwenswarm.channels.web.dataagent import api
+        from jiuwenswarm.channels.web.dataagent.datasource import store
+        from jiuwenswarm.common import db_connector, workspace_context, workspace_store
+
+        self.api, self.store = api, store
+        self.dbc, self.wc, self.ws = db_connector, workspace_context, workspace_store
+        self.path = temp / "native orders.duckdb"
+        self.rows = make_fixture(self.path)
+        self.initial_hash = hashlib.sha256(self.path.read_bytes()).hexdigest()
+        self.ref = ""
+
+    def request(self, method, route, body=None, workspace="consumer", expected=200):
+        handler = Handler(body, workspace)
+        getattr(self.api, "handle_" + method)(handler, urlparse("/api/dataagent/" + route))
+        require(handler.response is not None, "API dispatch produced no response")
+        status, result = handler.response
+        require(status == expected, f"API status {status}: {result}")
+        if expected == 200:
+            require(result.get("ok") is not False, f"API operation failed: {result}")
+        return result
+
+    @contextmanager
+    def scope(self):
+        token = self.wc.set_current("consumer")
+        try:
+            yield
+        finally:
+            self.wc.reset(token)
+
+    def lifecycle(self):
+        self.ws.create_workspace("Owner", workspace_id="owner")
+        self.ws.create_workspace("Consumer", workspace_id="consumer")
+        self.request("post", "datasource/test", {"type": "duckdb", "location": str(self.path)}, "owner")
+        result = self.request("post", "datasource/create", {
+            "type": "duckdb", "source_id": "native-orders", "workspace_id": "owner",
+            "location": str(self.path)}, "owner")
+        require(result.get("bound") is True, "Create did not bind the owner workspace")
+        require(result.get("schema_derivation") == {"status": "queued"}, "Create did not schedule schema enrichment")
+        require(result.get("semantic_collection", {}).get("run_id") == "captured-semantic-1",
+                "Create did not return the captured semantic run")
+        self.ref = result["db_ref"]
+        bound = self.request("post", "datasource/bind", {"source_id": "native-orders", "workspace_id": "consumer"})
+        require(bound["db_ref"] == self.ref and bound.get("bound") is True, "Cross-workspace binding changed the ref")
+        require(bound.get("schema_derivation") == {"status": "queued"}, "Binding did not schedule schema enrichment")
+        require(bound.get("semantic_collection", {}).get("run_id") == "captured-semantic-2",
+                "Binding did not return the captured semantic run")
+        require(self.scheduled_derivations == [
+            {"workspace_id": workspace, "db_ref": self.ref, "source_id": "native-orders"}
+            for workspace in ("owner", "consumer")], "Schema enrichment scheduling lost bound source arguments")
+        require(self.scheduled_semantic_runs == [
+            {"workspace_id": workspace, "source_id": "native-orders", "trigger_type": "binding"}
+            for workspace in ("owner", "consumer")], "Semantic scheduling lost bound source arguments")
+        require(self.wc.validate_ref_in_workspace("consumer", "business", self.ref) == self.ref,
+                "Bound ref is not authorized")
+        saved = self.store.get_source("native-orders", workspace_id="owner")
+        require(saved["config"]["location"] == str(self.path), "Saved native file location was lost")
+        require(self.store.get_source("native-orders", workspace_id="consumer") is None,
+                "Binding duplicated source ownership")
+        with self.scope():
+            require(set(self.dbc.tables(self.ref)["tables"]) == TABLES, "Saved ref lost schema-qualified table names")
+        return {"saved_and_bound": True, "cross_workspace": True, "tables": len(TABLES)}
+
+    def browsing(self):
+        databases = self.request("get", "databases")["databases"]
+        require(len(databases) == 1, "Native source must expose one bound database")
+        prefix = "databases/" + quote(databases[0]["name"], safe="") + "/tables"
+        names = {entry["name"] for entry in self.request("get", prefix)["tables"]}
+        require(names == TABLES, "Browsing lost schemas, the view, or quoted identifiers")
+        for table in TABLES:
+            route = prefix + "/" + quote(table, safe="")
+            detail = self.request("get", route)
+            require(detail.get("ddl_supported") is True and bool(detail.get("ddl")), f"Persisted DDL missing: {table}")
+            preview = self.request("get", route + "/preview?" + urlencode({"limit": 2, "offset": 0}))
+            require(bool(preview["rows"]), f"Empty preview for {table}")
+            if table == FACT:
+                columns = {column["name"]: column for column in detail["columns"]}
+                require(columns["order_id"]["primary_key"] is True, "Primary key metadata was lost")
+                require(columns["order_date"]["nullable"] is False, "Nullability metadata was lost")
+                require(columns["category_id"]["default_value"] is not None, "Column default was lost")
+                require(columns["order_amt"]["comment"] == "Order amount", "Column comment was lost")
+                require(preview["has_more"] is True, "Preview pagination failed")
+            elif table == OTHER_FACT:
+                require(preview["rows"] == [[999, 17]], "Duplicate table name resolved to the wrong schema")
+            elif table == ODD_TABLE:
+                require(preview["rows"] == [["quoted-name-row"]], "Quoted identifier resolved incorrectly")
+        full_ref = "databases/" + quote(self.ref, safe="") + "/tables"
+        require({entry["name"] for entry in self.request("get", full_ref)["tables"]} == TABLES,
+                "Encoded ref route failed")
+        return {"tables_and_views": 4, "schemas": 3, "quoted_names": True, "preview": True}
+
+    def analysis(self):
+        expected = expected_answers(self.rows)
+        with self.scope():
+            for name, sql in questions().items():
+                result = self.dbc.query(self.ref, sql, limit=10)
+                require(normalized(result["rows"]) == expected[name],
+                        f"SQL analysis differs from Python baseline: {name}")
+                require(not result.get("truncated"), f"Analysis result truncated: {name}")
+            # 参数化查询同时验证原生 ref 经公共查询路由的参数传递。
+            result = self.dbc.query(self.ref, f"SELECT order_amt FROM {FACT} WHERE order_id = ?", params=[1])
+            require(normalized(result["rows"]) == normalized([[self.rows[0][-1]]]), "Parameterized query failed")
+        return {"rows": len(self.rows), "questions": 5, "baseline": "Python/Decimal", "answers": expected}
+
+    def knowledge(self):
+        from jiuwenswarm.channels.web.dataagent.knowledge import schema_candidates, store as knowledge
+
+        snapshot = self.request("post", "databases/schema-snapshot", {"db_ref": self.ref})
+        require(snapshot["table_count"] == 4, "Schema snapshot lost a table or view")
+        require(all(entry.get("create_sql") and entry["metadata_status"]["create_sql"] == "available"
+                    and not entry.get("error") for entry in snapshot["tables"]), "Snapshot DDL status is inaccurate")
+        require(all(entry["metadata_status"]["indexes"] == "unsupported" for entry in snapshot["tables"]),
+                "Snapshot silently advertised unsupported index metadata")
+        with self.scope():
+            derived = schema_candidates.derive_candidates(self.ref, source_id="native-orders")
+            require(not derived["failed_tables"] and derived["created_count"] > 0, "Schema derivation failed")
+            assets = knowledge.list_assets()
+            require(len(assets) == derived["created_count"], "Candidates were not persisted")
+            require(all(asset["status"] == "candidate" and asset["scope"]["source_ids"] == ["native-orders"]
+                        for asset in assets), "Candidate scope/status is incorrect")
+            require(schema_candidates.derive_candidates(self.ref, source_id="native-orders")["created_count"] == 0,
+                    "Repeated derivation created duplicates")
+        return {"snapshot_tables": 4, "persisted_candidates": len(assets), "idempotent": True}
+
+    def read_only(self):
+        from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+
+        with self.scope():
+            try:
+                self.dbc.query(self.ref, f"DELETE FROM {FACT}")
+            except (QueryValidationError, ValueError) as exc:
+                require("DELETE" in str(exc) or "read" in str(exc).lower(), "Unrelated error masked the write guard")
+                pass
+            else:
+                raise AssertionError("Read query accepted DELETE")
+            for operation in (
+                lambda: self.dbc.execute(self.ref, f"DELETE FROM {FACT}"),
+                lambda: self.dbc.executemany(self.ref, f"INSERT INTO {FACT} VALUES (?, ?, ?, ?, ?)", self.rows[:1]),
+            ):
+                try:
+                    operation()
+                except ValueError:
+                    pass
+                else:
+                    raise AssertionError("Native file accepted a public write operation")
+            require(self.dbc.query(self.ref, f"SELECT COUNT(*) FROM {FACT}")["rows"] == [[240]],
+                    "Rejected write changed rows")
+        require(hashlib.sha256(self.path.read_bytes()).hexdigest() == self.initial_hash, "Native file bytes changed")
+        return {"query_write_rejected": True, "write_routes_rejected": True, "file_sha256_unchanged": True}
+
+
+@contextmanager
+def isolated_runtime(temp):
+    from jiuwenswarm.channels.web.dataagent.datasource import store
+    from jiuwenswarm.channels.web.dataagent.knowledge import schema_enrichment
+    from jiuwenswarm.channels.web.dataagent.semantic import service as semantic_service
+    from jiuwenswarm.common import db_connector as dbc, workspace_context as wc, workspace_store as ws
+
+    temp.mkdir(parents=True, exist_ok=True)
+    blank = temp / "datasource.yaml"
+    blank.write_text("{}\n", encoding="utf-8")
+    with ExitStack() as stack:
+        stack.enter_context(patch.dict(os.environ, {}, clear=False))
+        for key in ("JIUWENSWARM_DATASOURCE_DB", "JIUWENSWARM_ORCH_DB", "JIUWENSWARM_WORKSPACE_ID"):
+            os.environ.pop(key, None)
+        os.environ.update(JIUWENSWARM_DATA_ROOTS=str(temp),
+                          JIUWENSWARM_DEPLOY_SCHEMA_DIR=str(ROOT / "deploy" / "schema"))
+        stack.enter_context(patch.object(ws, "_config_dir", lambda: temp))
+        stack.enter_context(patch.object(ws, "_registry_path", lambda: temp / "workspaces.db"))
+        stack.enter_context(patch.object(wc, "_config_path", lambda: blank))
+        stack.enter_context(patch.object(dbc, "_DATASOURCE_CONFIG", blank))
+        stack.enter_context(patch.object(dbc, "_SOURCE_CREDS_CACHE", {}))
+        stack.enter_context(patch.object(store, "_initialized_refs", set()))
+        # 收集新后台入口的参数，阻止启动 LLM 深化；规则候选仍在验收阶段真实派生。
+        scheduled = []
+
+        def capture_submit(workspace_id, *, db_ref="", source_id=""):
+            scheduled.append({"workspace_id": workspace_id, "db_ref": db_ref, "source_id": source_id})
+            return {"status": "queued"}
+        stack.enter_context(patch.object(schema_enrichment, "submit", capture_submit))
+        # Collection itself has independent synchronous pipeline coverage; no
+        # background task may retain these temporary workspace/file references.
+        semantic_runs = []
+        def capture_semantic_run(source_id, workspace_id, *, trigger_type):
+            semantic_runs.append({"workspace_id": workspace_id, "source_id": source_id,
+                                  "trigger_type": trigger_type})
+            return {"run_id": f"captured-semantic-{len(semantic_runs)}", "status": "queued"}
+        stack.enter_context(patch.object(semantic_service, "start_run_for_binding",
+                                         partial(capture_semantic_run, trigger_type="binding")))
+        stack.enter_context(patch.object(semantic_service, "start_run_for_query",
+                                         partial(capture_semantic_run, trigger_type="query_feedback")))
+        stack.enter_context(patch.object(socket.socket, "connect",
+                                         side_effect=AssertionError("Unexpected network access")))
+        token = wc.set_current(None)
+        stack.callback(wc.reset, token)
+        stack.callback(dbc.close_all)
+        harness = Harness(temp)
+        harness.scheduled_derivations = scheduled
+        harness.scheduled_semantic_runs = semantic_runs
+        yield harness
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path,
+                        default=ROOT / "artifact" / "datasource-validation" / "duckdb-native-result.json")
+    args = parser.parse_args(argv)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    report = {"source": "duckdb", "checks": [], "sql_analysis": "Five fixed SQL questions; Python/Decimal baseline",
+              "boundaries": ["In-process API dispatch; no network HTTP or browser.", "No LLM or GLM API calls.",
+                            ("Background enrichment submission is captured without starting LLM tasks; "
+                              "rule-based candidate derivation/store execute synchronously."),
+                            ("Semantic task startup is captured; collection is covered by the "
+                              "independent synchronous pipeline tests.")]}
+    try:
+        with tempfile.TemporaryDirectory(prefix="duckdb-native-", dir=args.output.parent) as directory:
+            temp = Path(directory)
+            with isolated_runtime(temp) as harness:
+                for name in ("lifecycle", "browsing", "analysis", "knowledge", "read_only"):
+                    try:
+                        detail = getattr(harness, name)()
+                    except Exception as exc:
+                        report["checks"].append({"gate": name, "status": "failed",
+                                                 "detail": f"{type(exc).__name__}: {exc}"})
+                        if name == "lifecycle":
+                            break
+                    else:
+                        report["checks"].append({"gate": name, "status": "passed", "detail": detail})
+                report["scheduled_derivations"] = harness.scheduled_derivations
+                report["scheduled_semantic_runs"] = harness.scheduled_semantic_runs
+        report["temporary_directory_removed"] = not temp.exists()
+    except Exception as exc:
+        report["checks"].append({"gate": "setup_cleanup", "status": "failed", "detail": f"{type(exc).__name__}: {exc}"})
+    report["totals"] = {status: sum(item["status"] == status for item in report["checks"])
+                        for status in ("passed", "failed")}
+    report["successful"] = report["totals"]["passed"] == 5 and report["totals"]["failed"] == 0
+    args.output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    return 0 if report["successful"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
