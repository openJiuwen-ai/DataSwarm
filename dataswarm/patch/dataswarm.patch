+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""DDL namespaces remain distinct from parsing through metadata lookup."""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import SourceDefinition
+from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError
+from jiuwenswarm.channels.web.dataagent.connectors.schema_only_connector import (
+    SchemaOnlyConnector,
+    parse_ddl,
+)
+
+
+def _connector(ddl: str, dialect: str = "postgresql") -> SchemaOnlyConnector:
+    return SchemaOnlyConnector(SourceDefinition(
+        "ddl-source", "ddl", "DDL", "schema_only",
+        {"ddl_text": ddl, "dialect": dialect},
+    ))
+
+
+@pytest.mark.parametrize("dialect,ddl", [
+    ("postgresql", 'CREATE TABLE "sales"."orders" (id INT PRIMARY KEY);'
+                   'CREATE TABLE "archive"."orders" (legacy_id INT);'),
+    ("mysql", 'CREATE TABLE `sales`.`orders` (id INT PRIMARY KEY);'
+              'CREATE TABLE `archive`.`orders` (legacy_id INT);'),
+    ("tsql", 'CREATE TABLE [sales].[orders] (id INT PRIMARY KEY);'
+             'CREATE TABLE [archive].[orders] (legacy_id INT);'),
+])
+def test_parse_and_lookup_preserve_schema_for_duplicate_table_names(dialect, ddl):
+    tables = parse_ddl(ddl, dialect)
+    assert [(table["schema"], table["name"]) for table in tables] == [
+        ("sales", "orders"), ("archive", "orders")]
+    connector = _connector(ddl, dialect)
+    assert connector.catalog()["datasets"] == [
+        {"name": "orders", "schema": "sales", "type": "ddl"},
+        {"name": "orders", "schema": "archive", "type": "ddl"},
+    ]
+    schema = connector.schema("orders", "sales")
+    assert schema["dataset"] == "orders" and schema["schema"] == "sales"
+    assert schema["primary_key"] == ["id"]
+    assert connector.schema("archive.orders")["columns"][0]["name"] == "legacy_id"
+    assert [table["schema"] for table in connector.manifest()["tables"]] == ["sales", "archive"]
+    with pytest.raises(ConnectorError, match="ambiguous"):
+        connector.schema("orders")
+    with pytest.raises(ConnectorError, match="not found"):
+        connector.schema("orders", "missing")
+
+
+def test_quoted_dotted_names_and_explicit_schema_are_not_split():
+    connector = _connector('CREATE TABLE "sales.region"."order.items" ("line.id" INT);')
+    expected = connector.schema("order.items", "sales.region")
+    assert expected["schema"] == "sales.region"
+    assert expected["columns"][0]["name"] == "line.id"
+    assert connector.schema('"sales.region"."order.items"') == expected
+    assert connector.schema("order.items") == expected
+
+
+def test_unqualified_ddl_remains_compatible_and_metadata_only():
+    connector = _connector("CREATE TABLE orders (id INT PRIMARY KEY);")
+    assert connector.catalog()["datasets"][0]["schema"] is None
+    assert connector.schema("orders")["schema"] is None
+    assert connector.schema("orders", "")["primary_key"] == ["id"]
+    assert not hasattr(connector, "query") and not hasattr(connector, "preview")
+
+
+def test_three_part_ddl_retains_catalog_in_namespace():
+    connector = _connector("CREATE TABLE [shop].[sales].[orders] (id INT);", "tsql")
+    assert connector.catalog()["datasets"][0]["schema"] == "shop.sales"
+    assert connector.schema("orders", "shop.sales")["schema"] == "shop.sales"
