+
+def test_review_all_dimension_cap(tmp_path, monkeypatch):
+    """单维度复核上限：超过 cap 只复核最高危前 N 条（zscore 特例 10）。"""
+    findings = [
+        {"finding_uid": f"u{i}", "category": "timeseries", "severity": "low",
+         "object": {"table": "t", "column": "c"}, "summary": f"时序异常 {i}"}
+        for i in range(15)
+    ]
+    # 把一条标 high，验证它优先被复核
+    findings[0]["severity"] = "high"
+    path = _artifact(tmp_path, findings, name="zscore")
+    client = _FakeClient()
+    monkeypatch.setattr(llm_mod, "LLMConfig", _FakeConfig)
+    monkeypatch.setattr(llm_mod, "create_llm_client", lambda config: client)
+    monkeypatch.setattr(fr, "_REVIEW_DIMENSION_CAP", {"zscore": 2})  # zscore cap=2
+
+    out = fr.review_all({"zscore_findings": path})  # 带 _findings 后缀（run_pipeline 传入形态）
+    assert out["total_reviewed"] == 2
+    assert out["skipped_review"] == 13  # 其余跳过
+    assert client.calls == [2]  # 1 次批量调用，2 条
+    payload = json.loads(Path(path).read_text(encoding="utf-8"))
+    reviewed = [x for x in payload["findings"] if "llm_verdict" in x]
+    unreviewed = [x for x in payload["findings"] if "llm_verdict" not in x]
