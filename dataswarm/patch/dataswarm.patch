+function assertFullGraphFits(options) {
+  const cases = [
+    { bounds: { x: 36, y: 36, width: 1492, height: 2016 }, width: 1200, height: 384 },
+    { bounds: { x: -120, y: 80, width: 260, height: 96 }, width: 900, height: 480 },
+  ];
+  for (const { bounds, width, height } of cases) {
+    const viewport = getViewportForBounds(bounds, width, height, 0.05, options.maxZoom, options.padding);
+    assert.ok(viewport.zoom <= 1, 'automatic fitting never enlarges small graphs');
+    assert.ok(viewport.x + bounds.x * viewport.zoom >= 0);
+    assert.ok(viewport.y + bounds.y * viewport.zoom >= 0);
+    assert.ok(viewport.x + (bounds.x + bounds.width) * viewport.zoom <= width);
+    assert.ok(viewport.y + (bounds.y + bounds.height) * viewport.zoom <= height);
+    // React Flow rounds applied padding to pixels.
+    assert.ok(Math.abs(viewport.x + (bounds.x + bounds.width / 2) * viewport.zoom - width / 2) <= 1);
+    assert.ok(Math.abs(viewport.y + (bounds.y + bounds.height / 2) * viewport.zoom - height / 2) <= 1);
+  }
