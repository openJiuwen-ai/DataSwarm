+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""test_dataagent_boundaries —— dataagent 包边界契约测试（S2，Phase 1 落地）。
+
+规则 (a)：接入层与语义构建层十包不得 import 数据分析层（``analysis``/``sql``/
+  ``plan``）——AST 解析 import 全形态（``from X import Y`` 的模块与别名、
+  ``import X``、level≥2 相对包导入），按解析后的**绝对模块名点边界匹配**，
+  非字符串前缀匹配（``sqlglot`` / ``sqlite3`` / 同包 ``sql_guard`` 等前缀
+  同形反例见 ``NEGATIVE_EXAMPLES``，匹配器实现错误即红）；
+规则 (b)：$DA 内跨包 ``_`` 前缀符号 from-import 禁令——白名单显式列出 §2.4
+  现存 from-import 式 5 处（6 个出现点，E5 公开化后清零）。
+
+规则 (b')：跨包「模块属性访问私有」禁令（E5 公开化后补的条款）——
+``binding._attr`` 形态，binding 经 import 绑定到异包模块；仅对全文件唯一
+绑定的名字判定（同名多绑定的函数级遮蔽静态不可判定，如实跳过）。
+
+E5 已完成：跨包私有引用清零（白名单随之清零）。已知范围外项：
+``orchestration.db._*`` 16 条边是 E13（Phase 4 规则 (c)）对象；
+``db_connector._read_config_section``（jiuwenswarm/common，$DA 范围外，
+调用面横跨 app_web/orchestration/skill 双目录）登记为 E5 遗留观察项。
+"""
+from __future__ import annotations
+
+import ast
+from collections import Counter
+from pathlib import Path
+
+import jiuwenswarm.channels.web.dataagent as _da_package
+
+# $DA 文件系统根与绝对模块前缀（经包定位，与 cwd 无关）
+DA_DIR = Path(_da_package.__file__).resolve().parent
+DA_PREFIX = "jiuwenswarm.channels.web.dataagent"
+
+# 接入层 5 包 + 语义构建层 5 包（规则 (a) 的受限方）
+LOWER_PACKAGES = (
+    "connectors", "datasource", "databases", "business_data", "meta_data",
+    "semantic", "knowledge", "glossary", "lineage", "metrics",
+)
+# 数据分析层 3 包（规则 (a) 的禁入目标）
+FORBIDDEN_PACKAGES = ("analysis", "sql", "plan")
+FORBIDDEN_ABS = tuple(f"{DA_PREFIX}.{name}" for name in FORBIDDEN_PACKAGES)
+
+# 规则 (b) 白名单：E5 公开化完成后清零（2026-10-26）——新跨包私有 from-import
+# 一律违规；曾经的 5 三元组已全部改名公开（asset_view / tokenize /
+# default_config_path / warehouse_file_for / lexical_schema_hits 族）。
+PRIVATE_IMPORT_WHITELIST: dict[tuple[str, str, str], int] = {}
+
+# 匹配器反例（设计 §3.4：字符串前缀匹配必然误判的素材——命中即匹配器实现有 bug）
+NEGATIVE_EXAMPLES = (
+    "sqlglot",                                    # semantic/adapters/mysql.py:11 等真实在用
+    "sqlite3",                                    # business_data/sqlite_impl.py:7
+    f"{DA_PREFIX}.connectors.sql_guard",          # from .sql_guard import ...（sqlalchemy_connector.py:13）
+    f"{DA_PREFIX}.business_data.sqlite_impl",     # from .sqlite_impl import ...（business_data/__init__.py:12）
+    f"{DA_PREFIX}.meta_data.sqlite_store",        # from .sqlite_store import ...（meta_data/__init__.py:9）
+)
+
+
+def _touches_forbidden(name: str) -> bool:
+    """绝对模块名是否落入禁入包（全等或点边界子模块，非前缀）。"""
+    return any(name == target or name.startswith(target + ".") for target in FORBIDDEN_ABS)
+
+
+def _package_of(rel_py: Path) -> str:
+    """.py 文件 → 其所属包的绝对模块名（模块文件与 __init__.py 的包都是所在目录）。"""
+    return ".".join([DA_PREFIX, *rel_py.parent.parts])
+
+
+def _import_names(tree: ast.AST, file_package: str) -> list[tuple[str, int]]:
+    """AST → 该文件 import 触达的全部绝对模块名 [(name, lineno)]。
+
+    覆盖形态：``import X``（含点路径）、``from X import a, b``（base 与
+    base.alias 都算——``from .. import analysis`` 的违规在 alias 上）、
+    相对导入按 level 归算到文件所在包。
+    """
+    names: list[tuple[str, int]] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                names.append((alias.name, node.lineno))
+        elif isinstance(node, ast.ImportFrom):
+            if node.level == 0:
+                base = node.module or ""
+            else:
+                parts = file_package.split(".")
+                # level=1 → 当前包；level=n → 上溯 (n-1) 层
+                if node.level - 1 > len(parts):
+                    continue  # 相对层级越过 DA_PREFIX 之外，交给规则 (c) 时代
+                anchor = ".".join(parts[: len(parts) - (node.level - 1)])
+                base = f"{anchor}.{node.module}" if node.module else anchor
+            if base:
+                names.append((base, node.lineno))
+                for alias in node.names:
+                    names.append((f"{base}.{alias.name}", node.lineno))
+    return names
+
+
+def _iter_py_files(root: Path) -> list[Path]:
+    return sorted(p for p in root.rglob("*.py")
+                  if "__pycache__" not in p.parts and ".pytest_cache" not in p.parts)
+
+
+def test_matcher_negative_examples():
+    """匹配器反例集：前缀同形素材必须全部不命中（匹配器退化为前缀匹配即红）。"""
+    for name in NEGATIVE_EXAMPLES:
+        assert not _touches_forbidden(name), f"反例被误判为违规: {name}"
+    # 正例自证：禁入包本体与其子模块必须命中
+    for name in (f"{DA_PREFIX}.analysis", f"{DA_PREFIX}.analysis.model",
+                 f"{DA_PREFIX}.sql", f"{DA_PREFIX}.plan.service"):
+        assert _touches_forbidden(name), f"正例未命中: {name}"
+
+
+def test_lower_packages_do_not_import_analysis_layer():
+    """规则 (a)：十下层包零例外（现状唯一违规 retrieval.py:13 已随 E1 消除）。"""
+    violations: list[str] = []
+    for pkg in LOWER_PACKAGES:
+        pkg_dir = DA_DIR / pkg
+        assert pkg_dir.is_dir(), f"扫描前提失效：包目录缺失 {pkg_dir}"
+        for path in _iter_py_files(pkg_dir):
+            rel = path.relative_to(DA_DIR)
+            tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+            file_package = _package_of(rel)
+            for name, lineno in _import_names(tree, file_package):
+                if _touches_forbidden(name):
+                    violations.append(f"{rel}:{lineno} -> {name}")
+    assert not violations, "下层包违规 import 分析层:\n" + "\n".join(violations)
+
+
+def test_no_cross_package_private_from_import():
+    """规则 (b)：$DA 内跨包 ``_`` 符号 from-import 仅白名单命中。"""
+    found: Counter = Counter()
+    details: dict[tuple[str, str, str], list[str]] = {}
+    # 扫描面：$DA 全部子包目录 + 顶层 .py（db.py/_common.py 等自研壳）
+    scan_roots = [d for d in DA_DIR.iterdir()
+                  if d.is_dir() and d.name not in ("__pycache__", ".pytest_cache")]
+    for root in scan_roots:
+        for path in _iter_py_files(root):
+            _scan_private_imports(path, found, details)
+    for path in sorted(DA_DIR.glob("*.py")):
+        _scan_private_imports(path, found, details)
+
+    allowed = Counter({key: count for key, count in PRIVATE_IMPORT_WHITELIST.items()})
+    unexpected = found - allowed
+    expired = allowed - found
+    problems = []
+    if unexpected:
+        problems.append("白名单外新增违规:\n" + "\n".join(
+            f"  {key[0]} -> {key[1]}.{key[2]} ×{count}（{'; '.join(details[key])}）"
+            for key, count in unexpected.items()))
+    if expired:
+        problems.append("白名单条目已消失（E5 公开化后应收缩白名单）:\n" + "\n".join(
+            f"  {key[0]} -> {key[1]}.{key[2]}" for key in expired))
+    assert not problems, "\n".join(problems)
+
+
+_ROOT = "<root>"  # $DA 顶层（db.py/_common.py/api.py 等）的包归属哨兵
+
+
+def _package_head(module_or_path: str) -> str:
+    """绝对模块名 → 包归属头：子包名；顶层模块（含 _common 等非目录模块）归 <root>。
+
+    同包 = 同头。api.py → _common._query_arg 是根包内部引用（与
+    knowledge/retrieval.py:34 → store._normal 同类，E5 顺手对象），
+    不属规则 (b) 的跨包禁令。
+    """
+    tail = module_or_path[len(DA_PREFIX):].lstrip(".")
+    head = tail.split(".")[0] if tail else ""
+    if head and (DA_DIR / head).is_dir():
+        return head
+    return _ROOT
+
+
+def _scan_private_imports(path: Path, found: Counter,
+                          details: dict[tuple[str, str, str], list[str]]) -> None:
+    """单文件扫描：跨包 `_` 前缀 from-import 记入 found/details。"""
+    try:
+        rel = path.relative_to(DA_DIR)
+    except ValueError:
+        return  # DA_DIR 之外的文件不扫
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    file_package = _package_of(rel)
+    importer_head = _package_head(file_package)
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.ImportFrom):
+            continue
+        if not any(alias.name.startswith("_") for alias in node.names):
+            continue
+        if node.level == 0:
+            base = node.module or ""
+        else:
+            parts = file_package.split(".")
+            if node.level - 1 > len(parts):
+                continue
+            anchor = ".".join(parts[: len(parts) - (node.level - 1)])
+            base = f"{anchor}.{node.module}" if node.module else anchor
+        if not base.startswith(f"{DA_PREFIX}."):
+            continue  # $DA 之外的目标（orchestration.db 等）是 E13/规则 (c) 对象
+        if _package_head(base) == importer_head:
+            continue  # 同包私有引用（E5 顺手对象）不属跨包禁令
+        for alias in node.names:
+            if not alias.name.startswith("_"):
+                continue
+            key = (str(rel), base[len(DA_PREFIX) + 1:], alias.name)
+            found[key] += 1
+            details.setdefault(key, []).append(f"line {node.lineno}")
+
+
+def _from_base(node: ast.ImportFrom, file_package: str) -> str:
+    """ImportFrom 的 base 绝对模块名（相对导入按 level 归算；越界返回空）。"""
+    if node.level == 0:
+        return node.module or ""
+    parts = file_package.split(".")
+    if node.level - 1 > len(parts):
+        return ""
+    anchor = ".".join(parts[: len(parts) - (node.level - 1)])
+    return f"{anchor}.{node.module}" if node.module else anchor
+
+
+def _module_bindings(tree: ast.AST, file_package: str) -> dict[str, list[str]]:
+    """名字 -> [绑定的 $DA 模块绝对名]（多绑定记多值；非 $DA 目标不记）。"""
+    bindings: dict[str, list[str]] = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                candidate = alias.name
+                if candidate.startswith(f"{DA_PREFIX}."):
+                    bindings.setdefault(alias.asname or candidate, []).append(candidate)
+        elif isinstance(node, ast.ImportFrom):
+            base = _from_base(node, file_package)
+            for alias in node.names:
+                candidate = f"{base}.{alias.name}" if base else alias.name
+                if not candidate.startswith(f"{DA_PREFIX}."):
+                    continue
+                rel_mod = candidate[len(DA_PREFIX) + 1:].replace(".", "/")
+                if ((DA_DIR / f"{rel_mod}.py").is_file()
+                        or (DA_DIR / rel_mod / "__init__.py").is_file()):
+                    bindings.setdefault(alias.asname or alias.name, []).append(candidate)
+    return bindings
+
+
+def test_no_cross_package_private_attribute_access():
+    """规则 (b')：跨包模块属性访问私有禁令（E5 后应为零）。
+
+    检测 ``binding._attr``——binding 唯一绑定到异包模块。同名多绑定
+    （函数级 import 遮蔽，如 publication.py 的 store 分别绑 metrics.store
+    与 knowledge.store）静态不可判定，跳过并在此如实登记为已知局限。
+    """
+    findings: list[str] = []
+    scan_roots = [d for d in DA_DIR.iterdir()
+                  if d.is_dir() and d.name not in ("__pycache__", ".pytest_cache")]
+    for root in scan_roots + [DA_DIR]:
+        files = sorted(root.glob("*.py")) if root == DA_DIR else _iter_py_files(root)
+        for path in files:
+            try:
+                rel = path.relative_to(DA_DIR)
+            except ValueError:
+                continue
+            tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+            file_package = _package_of(rel)
+            importer_head = _package_head(file_package)
+            for name, targets in _module_bindings(tree, file_package).items():
+                if len(targets) != 1 or _package_head(targets[0]) == importer_head:
+                    continue
+                for node in ast.walk(tree):
+                    if (isinstance(node, ast.Attribute) and node.attr.startswith("_")
+                            and isinstance(node.value, ast.Name) and node.value.id == name):
+                        findings.append(f"{rel}:{node.lineno} {name}.{node.attr} <- {targets[0]}")
+    assert not findings, "跨包模块属性访问私有:\n" + "\n".join(findings)
