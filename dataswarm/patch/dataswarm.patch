@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { formatRunStamp } from '../node_modules/.cache/governance-run-stamp/formatInspectionDateTime.mjs';
+
+const NOW = new Date(2026, 8, 10, 15, 0); // 2026-09-10 15:00 本地时间
+
+test('same-day run maps to today with HH:mm', () => {
+  const stamp = formatRunStamp('2026-09-10T09:05:00', NOW);
+  assert.deepEqual(stamp, { dayKey: 'today', date: '', time: '09:05' });
+});
+
+test('previous-day run maps to yesterday', () => {
+  const stamp = formatRunStamp('2026-09-09T23:41:00', NOW);
+  assert.deepEqual(stamp, { dayKey: 'yesterday', date: '', time: '23:41' });
+});
+
+test('older run maps to date with M月D日', () => {
+  const stamp = formatRunStamp('2026-09-01T08:00:00', NOW);
+  assert.deepEqual(stamp, { dayKey: 'date', date: '9月1日', time: '08:00' });
+});
+
+test('month boundary keeps the older date bucket', () => {
+  const stamp = formatRunStamp('2026-08-31T08:00:00', NOW);
+  assert.equal(stamp.dayKey, 'date');
+  assert.equal(stamp.date, '8月31日');
+});
+
+test('malformed timestamp falls back to empty stamp (caller renders run_id)', () => {
+  assert.deepEqual(formatRunStamp('not-a-timestamp', NOW), { dayKey: 'date', date: '', time: '' });
+  assert.deepEqual(formatRunStamp('2026/09/10 08:00', NOW), { dayKey: 'date', date: '', time: '' });
+});
+
+test('seconds-only future boundary: tomorrow counts as date bucket, not today', () => {
+  const stamp = formatRunStamp('2026-09-11T00:00:00', NOW);
+  assert.equal(stamp.dayKey, 'date');
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/governanceSessionStore.test.mjs b/jiuwenswarm/channels/web/frontend/tests/governanceSessionStore.test.mjs
new file mode 100644
index 000000000..fcdff7e70
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/governanceSessionStore.test.mjs
@@ -0,0 +1,164 @@
+/**
+ * governanceSessionStore —— 治理助手「每巡检批次独立会话」的纯数据层测试。
+ *
+ * 覆盖核心语义（docs/governance-embedded-chat-plan.md + 每批次独立会话修复）：
+ * - 同一 runId 复用已绑定的 sid（同批次内不 fork 新会话）
+ * - 不同 runId 各自独立 sid（跨批次不串会话）
+ * - 新建会话写入映射 + 列表封顶（防无界增长）
+ * - 空入库/脏数据容错（不抛异常，回退空列表）
+ * - 旧版单 sid 字符串键已废弃，不再读取
+ */
+
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  MAX_GOV_SESSIONS,
+  appendEntry,
+  findBoundSid,
+  readEntries,
+  writeEntries,
+} from '../node_modules/.cache/governance-session-store/governanceSessionStore.mjs';
+
+// ---- 最小 localStorage mock（按 key 存字符串，与浏览器 API 形状一致）----
+function makeStorage() {
+  const map = new Map();
+  return {
+    getItem: (k) => (map.has(k) ? map.get(k) : null),
+    setItem: (k, v) => { map.set(k, String(v)); },
+    removeItem: (k) => { map.delete(k); },
+  };
+}
+
+test('readEntries: 空库返回空列表', () => {
+  assert.deepEqual(readEntries(makeStorage()), []);
+});
+
+test('readEntries: 旧版单 sid 字符串键已废弃，按数组键读取（旧值不影响）', () => {
+  const s = makeStorage();
+  s.setItem('jiuwen.governance.chatSessionId', 'old-single-sid'); // 旧键，应被忽略
+  assert.deepEqual(readEntries(s), []);
+});
+
+test('readEntries: 正常读取 [{sid,runId}] 映射列表', () => {
+  const s = makeStorage();
+  s.setItem('jiuwen.governance.chatSessionIds', JSON.stringify([
+    { sid: 's1', runId: 'runA' },
+    { sid: 's2', runId: 'runB' },
+  ]));
+  assert.deepEqual(readEntries(s), [
+    { sid: 's1', runId: 'runA' },
+    { sid: 's2', runId: 'runB' },
+  ]);
+});
+
+test('readEntries: 脏数据/格式错误静默回退空列表（不抛异常）', () => {
+  const s = makeStorage();
+  s.setItem('jiuwen.governance.chatSessionIds', 'not-json{');
+  assert.deepEqual(readEntries(s), []);
+
+  s.setItem('jiuwen.governance.chatSessionIds', JSON.stringify({ not: 'array' }));
+  assert.deepEqual(readEntries(s), []);
+
+  // 部分项缺字段 → 过滤掉非法项，保留合法项
+  s.setItem('jiuwen.governance.chatSessionIds', JSON.stringify([
+    { sid: 's1', runId: 'runA' },
+    { sid: '', runId: 'runB' }, // sid 空，过滤
+    { runId: 'runC' },          // 无 sid，过滤
+    { sid: 's3', runId: 123 },  // runId 非字符串，过滤
+    { sid: 's4', runId: 'runD' },
+  ]));
+  assert.deepEqual(readEntries(s), [
+    { sid: 's1', runId: 'runA' },
+    { sid: 's4', runId: 'runD' },
+  ]);
+});
+
+test('findBoundSid: 同一 runId 返回已绑定的 sid（同批次复用语义）', () => {
+  const entries = [
+    { sid: 's1', runId: 'runA' },
+    { sid: 's2', runId: 'runB' },
+  ];
+  assert.equal(findBoundSid(entries, 'runA'), 's1');
+  assert.equal(findBoundSid(entries, 'runB'), 's2');
+});
+
+test('findBoundSid: 同 runId 多次绑定时取最近一次（后写入的覆盖）', () => {
+  const entries = [
+    { sid: 's-old', runId: 'runA' },
+    { sid: 's-new', runId: 'runA' }, // 同 run 重绑
+  ];
+  assert.equal(findBoundSid(entries, 'runA'), 's-new');
+});
+
+test('findBoundSid: 未绑定的 runId 返回 null（触发新建）', () => {
+  const entries = [{ sid: 's1', runId: 'runA' }];
+  assert.equal(findBoundSid(entries, 'runB'), null);
+  assert.equal(findBoundSid([], 'runA'), null);
+});
+
+test('findBoundSid: 不同 runId 互不串扰（跨批次独立）', () => {
+  const entries = [
+    { sid: 's1', runId: 'runA' },
+    { sid: 's2', runId: 'runB' },
+    { sid: 's3', runId: 'runC' },
+  ];
+  assert.equal(findBoundSid(entries, 'runA'), 's1');
+  assert.equal(findBoundSid(entries, 'runB'), 's2');
+  assert.equal(findBoundSid(entries, 'runC'), 's3');
+  assert.notEqual(findBoundSid(entries, 'runA'), findBoundSid(entries, 'runB'));
+});
+
+test('appendEntry: 追加新 {sid,runId} 到列表末尾', () => {
+  const entries = [{ sid: 's1', runId: 'runA' }];
+  const next = appendEntry(entries, { sid: 's2', runId: 'runB' });
+  assert.deepEqual(next, [
+    { sid: 's1', runId: 'runA' },
+    { sid: 's2', runId: 'runB' },
+  ]);
+});
+
+test('appendEntry: 列表超过 MAX_GOV_SESSIONS 时封顶，丢弃最旧的（先进先出）', () => {
+  const entries = Array.from({ length: MAX_GOV_SESSIONS }, (_, i) => ({
+    sid: `s${i}`, runId: `run${i}`,
+  }));
+  const next = appendEntry(entries, { sid: 'sFresh', runId: 'runFresh' });
+  assert.equal(next.length, MAX_GOV_SESSIONS);
+  // 最旧的 s0 被丢弃
+  assert.equal(next[0].sid, 's1');
+  // 最新的在末尾
+  assert.equal(next[next.length - 1].sid, 'sFresh');
+});
+
+test('writeEntries → readEntries 往返一致', () => {
+  const s = makeStorage();
+  const entries = [
+    { sid: 's1', runId: 'runA' },
+    { sid: 's2', runId: 'runB' },
+  ];
+  writeEntries(s, entries);
+  assert.deepEqual(readEntries(s), entries);
+});
+
+test('端到端语义：不同巡检批次各自独立会话，同批次内复用', () => {
+  const s = makeStorage();
+  // 模拟两轮巡检各自「开始修复」建会话
+  // run1 首次：无绑定 → 新建 s1 并写入
+  let entries = readEntries(s);
+  assert.equal(findBoundSid(entries, 'run1'), null);
+  entries = appendEntry(entries, { sid: 's1', runId: 'run1' });
+  writeEntries(s, entries);
+
+  // run2 首次：无绑定 → 新建 s2 并写入
+  entries = readEntries(s);
+  assert.equal(findBoundSid(entries, 'run2'), null);
+  entries = appendEntry(entries, { sid: 's2', runId: 'run2' });
+  writeEntries(s, entries);
+
+  // run1 第二次（同批次内复用）：命中已绑定的 s1，不再新建
+  entries = readEntries(s);
+  assert.equal(findBoundSid(entries, 'run1'), 's1');
+
+  // 两个 run 的 sid 必须不同（跨批次不串会话）
+  assert.notEqual(findBoundSid(entries, 'run1'), findBoundSid(entries, 'run2'));
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/governanceStoreRace.test.mjs b/jiuwenswarm/channels/web/frontend/tests/governanceStoreRace.test.mjs
new file mode 100644
index 000000000..828a2f193
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/governanceStoreRace.test.mjs
@@ -0,0 +1,122 @@
+/**
+ * governanceStore —— 快速切换批次的竞态回归测试。
+ *
+ * 复现条件（服务器慢时必现、本地快时难现）：连续点 A→B→A 切批次，每个批次要拉
+ * 6 个维度产物，浏览器对同一 origin 只有 6 条连接。若被取代的请求不取消，它们会一直
+ * 占着连接把新批次顶在队列后 → 异常清单空白 + 「加载中…」永不结束。
+ *
+ * 本用例锁住三条不变量：
+ * 1. 被取代的在飞请求会被 abort（不是等它跑完后丢弃）
+ * 2. 最终批次的 artifacts 必须写入（不能停在空清单）
+ * 3. loading 必须复位；因取代而失败不产生错误横幅
+ */
+
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+// datasourceWorkspaceStore / 会话 store 会读 window.localStorage，node 下需先补桩
+globalThis.window = {
+  localStorage: { getItem: () => null, setItem() {}, removeItem() {} },
+  addEventListener() {},
+  removeEventListener() {},
+};
+
+const DIMENSIONS = ['schema', 'data', 'zscore', 'lineage', 'column-lineage', 'root-cause'];
+
+function abortError() {
+  return Object.assign(new Error('The operation was aborted'), { name: 'AbortError' });
+}
+
+/** 带延迟与取消语义的 fetch 桩：signal abort 时以 AbortError 拒绝。 */
+function makeFetchStub({ summaryDelayFor, dimensionDelay }) {
+  const state = { aborted: 0, dimensionRequests: 0, summaryRequests: 0 };
+
+  const respond = (payload, ms, signal) =>
+    new Promise((resolve, reject) => {
+      if (signal?.aborted) {
+        state.aborted += 1;
+        reject(abortError());
+        return;
+      }
+      const timer = setTimeout(
+        () => resolve({ ok: true, status: 200, json: async () => payload }),
+        ms,
+      );
+      signal?.addEventListener(
+        'abort',
+        () => {
+          clearTimeout(timer);
+          state.aborted += 1;
+          reject(abortError());
+        },
+        { once: true },
+      );
+    });
+
+  const fetchStub = async (url, init) => {
+    const href = String(url);
+    const signal = init?.signal;
+    if (href.includes('/api/dataagent/workspaces')) {
+      return respond({ workspaces: [{ workspace_id: 'default', name: '默认', business: null, metadata: { type: 'sqlite', database: 'm' } }] }, 1, signal);
+    }
+    const summaryMatch = href.match(/\/api\/inspection\/runs\/([^?/]+)\?/);
+    if (summaryMatch && !href.includes('/manifest')) {
+      state.summaryRequests += 1;
+      return respond({ meta: { run_id: summaryMatch[1] }, errors: [] }, summaryDelayFor(summaryMatch[1]), signal);
+    }
+    const dimMatch = href.match(/\/api\/inspection\/([^?]+)\?run_id=([^&]+)/);
+    if (dimMatch) {
+      state.dimensionRequests += 1;
+      return respond({ meta: {}, findings: [{ finding_uid: `${dimMatch[1]}-1`, severity: 'high', summary: 's' }] }, dimensionDelay(dimMatch[2]), signal);
+    }
+    return respond({}, 1, signal);
+  };
+
+  return { fetchStub, state };
+}
+
+test('快速来回切换批次：最终批次加载完成，loading 复位且无错误', async () => {
+  // 慢服务器：summary 与维度都要等，制造并发窗口
+  const { fetchStub, state } = makeFetchStub({
+    summaryDelayFor: () => 120,
+    dimensionDelay: () => 150,
+  });
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = fetchStub;
+
+  try {
+    const { useGovernanceStore } = await import(
+      '../node_modules/.cache/governance-store-race/governanceStore.mjs'
+    );
+    const store = useGovernanceStore;
+    store.setState({
+      runs: [
+        { run_id: 'A', status: 'success', db: 'doris://a' },
+        { run_id: 'B', status: 'success', db: 'doris://b' },
+      ],
+    });
+
+    // 快速连点：A → B → A，每次都早于上一次响应返回
+    void store.getState().selectRun('A');
+    await new Promise(r => setTimeout(r, 20));
+    void store.getState().selectRun('B');
+    await new Promise(r => setTimeout(r, 20));
+    await store.getState().selectRun('A', DIMENSIONS);
+
+    // 让所有在飞请求（含被取消的）落定
+    await new Promise(r => setTimeout(r, 900));
+
+    const s = store.getState();
+    assert.equal(s.selectedRunId, 'A', '最终选中应为 A');
+    assert.equal(s.loading, false, 'loading 必须复位（不能停在「加载中…」）');
+    assert.equal(s.error, null, '被取代的请求不应产生错误横幅');
+    const loaded = DIMENSIONS.filter(d => d in s.artifacts);
+    assert.ok(
+      loaded.length > 0,
+      `最终批次的 artifacts 必须写入（当前已加载: ${loaded.join(',') || '无'}）`,
+    );
+    assert.ok(state.aborted > 0, '被取代的在飞请求应被 abort（否则会一直占用连接池）');
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/markdownInternalRoutes.test.mjs b/jiuwenswarm/channels/web/frontend/tests/markdownInternalRoutes.test.mjs
