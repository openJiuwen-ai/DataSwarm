@@ -0,0 +1,27 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+export const GOVERNANCE_COMPOSER_MAX_CHARS = 8000;
+
+export interface GovernanceComposerDraft {
+  runId: string;
+  value: string;
+}
+
+export function createGovernanceComposerDraft(runId: string, value = ''): GovernanceComposerDraft {
+  return { runId, value };
+}
+
+/** A composer draft belongs to exactly one inspection run. Switching runs discards it. */
+export function bindGovernanceComposerDraft(draft: GovernanceComposerDraft, runId: string): GovernanceComposerDraft {
+  return draft.runId === runId ? draft : createGovernanceComposerDraft(runId);
+}
+
+export function updateGovernanceComposerDraft(draft: GovernanceComposerDraft, runId: string, value: string): GovernanceComposerDraft {
+  const current = bindGovernanceComposerDraft(draft, runId);
+  return current.value === value ? current : createGovernanceComposerDraft(runId, value);
+}
+
+export function getGovernanceComposerSubmission(draft: GovernanceComposerDraft, runId: string, isProcessing: boolean): string | null {
+  const value = bindGovernanceComposerDraft(draft, runId).value.trim();
+  if (!value || isProcessing || value.length > GOVERNANCE_COMPOSER_MAX_CHARS) return null;
+  return value;
+}
