+def test_staged_default_port_has_a_single_source_of_truth():
+    """治理通路解析 location 时的默认端口必须与连接器声明的一致。
+
+    原先 `_staged_config_from_location` 硬编码 `22 if sftp else 21`，于是
+    `webhdfs` 落到 21（FTP 的端口），与 `DEFAULT_PORTS` 声明的 9870 矛盾。
+    adapter 生成的 ref 总带显式端口所以一直没暴露——但那是巧合不是保证。
+
+    按 `DEFAULT_PORTS` 参数化，新增 staged 协议时自动覆盖，不需要再想起这条。
+    """
+    from jiuwenswarm.channels.web.dataagent.connectors.staged_connector import (
+        DEFAULT_PORTS,
+    )
+    from jiuwenswarm.common import db_connector as dbc
+
+    for protocol, expected in DEFAULT_PORTS.items():
+        assert dbc._staged_default_port(protocol) == expected, protocol
+        # 走完整解析路径：不带端口的 location 必须补成同一个值
+        spec = {"location": f"{protocol}://h.example.com/data/*.csv",
+                "source_type": "ftp", "table_name": "t"}
+        got = dbc._staged_config_from_location(spec)["port"]
+        assert got == expected, f"{protocol} 解出 {got}，应为 {expected}"
+    # 显式端口优先于默认值
+    spec = {"location": "webhdfs://h.example.com:50070/data/*.csv",
+            "source_type": "hdfs", "table_name": "t"}
+    assert dbc._staged_config_from_location(spec)["port"] == 50070
+
