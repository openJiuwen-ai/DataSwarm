@@ -0,0 +1,264 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""BI 看板时间过滤单测。"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.dashboard import db as dash_db
+
+
+def test_apply_time_range_replaces_both_placeholders():
+    sql = "SELECT * FROM t WHERE dt BETWEEN {{time_start}} AND {{time_end}}"
+    out = dash_db._apply_time_range(sql, ("2026-08-01", "2026-08-29"))
+    assert out == "SELECT * FROM t WHERE dt BETWEEN '2026-08-01' AND '2026-08-29'"
+
+
+def test_apply_time_range_no_placeholder_returns_unchanged():
+    sql = "SELECT * FROM t"
+    assert dash_db._apply_time_range(sql, ("2026-08-01", "2026-08-29")) == sql
+
+
+def test_apply_time_range_only_one_placeholder():
+    sql = "SELECT * FROM t WHERE dt >= {{time_start}}"
+    out = dash_db._apply_time_range(sql, ("2026-08-01", "2026-08-29"))
+    assert out == "SELECT * FROM t WHERE dt >= '2026-08-01'"
+
+
+def test_apply_time_range_none_returns_unchanged():
+    sql = "SELECT * FROM t WHERE dt BETWEEN {{time_start}} AND {{time_end}}"
+    assert dash_db._apply_time_range(sql, None) == sql
+
+
+def test_apply_time_range_none_sql_returns_none():
+    assert dash_db._apply_time_range(None, ("2026-08-01", "2026-08-29")) is None
+
+
+def test_apply_time_range_invalid_date_raises():
+    sql = "SELECT * FROM t WHERE dt >= {{time_start}}"
+    with pytest.raises(ValueError, match="invalid date format"):
+        dash_db._apply_time_range(sql, ("2026/08/01", "2026-08-29"))
+
+
+def test_apply_time_range_inject_attempt_safe():
+    # 日期含 SQL 注入尝试：正则应拒绝
+    sql = "SELECT * FROM t WHERE dt >= {{time_start}}"
+    with pytest.raises(ValueError):
+        dash_db._apply_time_range(sql, ("2026-08-01'; DROP TABLE t;--", "2026-08-29"))
+
+
+def _bootstrap_sqlite_db(tmp_path, monkeypatch):
+    """把 dashboard db 指向临时 sqlite，并建表 + 塞一张含占位符的卡片。
+
+    返回 (dash_db_mod, db_ref)：db_ref 供用例构造同库 datasource_ref。"""
+    db_file = tmp_path / "meta.db"
+    db_ref = f"sqlite://{db_file}"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", db_ref)
+    # 重新加载 db 模块的 META_DB_REF / _is_sqlite
+    import importlib
+    import jiuwenswarm.channels.web.orchestration.db as orch_db
+    importlib.reload(orch_db)
+    # pin 单空间上下文（业务/元库都指向临时 sqlite）：多空间环境下
+    # _connect → current_workspace → resolve 会抛 WorkspaceContextRequired；
+    # render 链 validate_ref_in_workspace(None, ...) 也要求 datasource_ref
+    # 命中某个工作空间——二者都由 _workspace_records 替身一并解决。
+    from jiuwenswarm.common import workspace_context as wctx
+
+    ctx = wctx.WorkspaceContext("ws_test", "测试", db_ref, db_ref)
+    monkeypatch.setattr(wctx, "_workspace_records", lambda: [ctx])
+    import jiuwenswarm.channels.web.dataagent.dashboard.db as dash_db_mod
+    importlib.reload(dash_db_mod)
+    dash_db_mod.init_db()
+    # 塞一张卡片：SQL 含占位符
+    dash_db_mod.create_dashboard({"dashboard_id": "d_test", "name": "t"})
+    dash_db_mod.create_card("d_test", {
+        "card_id": "c_test",
+        "title": "test card",
+        "card_type": "chart",
+        "chart_spec": {"type": "bar", "x": "dt", "y": "pv"},
+        "sql_query": "SELECT '2026-08-15' AS dt, 100 AS pv WHERE '2026-08-15' BETWEEN {{time_start}} AND {{time_end}}",
+        "datasource_ref": f"sqlite://{db_file}",
+    })
+    return dash_db_mod, db_ref
+
+
+def test_render_card_with_time_range_returns_data(tmp_path, monkeypatch):
+    m, db_ref = _bootstrap_sqlite_db(tmp_path, monkeypatch)
+    r = m.render_card("c_test", time_range=("2026-08-01", "2026-08-29"))
+    assert r is not None
+    assert r.get("error") is None
+    opt = r.get("echarts_option")
+    assert opt is not None  # 有图表数据
+
+
+def _option_series(option):
+    """charts.options.chart_option 返回扁平结构 {..., series: [...]}；
+    兼容旧的响应式结构 {baseOption: {..., series: [...]}}。"""
+    if not isinstance(option, dict):
+        return []
+    if "series" in option:
+        return option["series"] or []
+    base = option.get("baseOption") or {}
+    return base.get("series") or []
+
+
+def test_render_card_different_time_range_changes_result(tmp_path, monkeypatch):
+    m, db_ref = _bootstrap_sqlite_db(tmp_path, monkeypatch)
+    # 范围内
+    r_in = m.render_card("c_test", time_range=("2026-08-01", "2026-08-29"))
+    # 范围外
