+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+﻿import { useTranslation } from 'react-i18next';
+import { AlertTriangle, FileSpreadsheet, X } from 'lucide-react';
+import { Button, Empty, Field, Panel, Table, inputClass } from '../../_shared/ui/Ui';
+import { useCsvSourceStore } from '../store/dataSourceStore';
+
+export function CsvSourcePage() {
+  const { t } = useTranslation();
+  const { csvPath, sampleRows, inferring, result, error, setCsvPath, setSampleRows, inferCsv, clearError } =
+    useCsvSourceStore();
+
+  const columns = result?.columns ?? [];
+  const preview = result?.preview ?? [];
+
+  return (
+    <div className="mx-auto max-w-4xl">
+      <header className="dw-page-head mb-5">
+        <h2>{t('dataSource.csv.title')}</h2>
+        <p>{t('dataSource.csv.subtitle')}</p>
+      </header>
+
+      {error && (
+        <div className="mb-4 flex items-center gap-2 rounded-lg border border-warn bg-warn-subtle px-3 py-2 text-sm text-warn">
+          <AlertTriangle size={14} />
+          <span className="flex-1">{error}</span>
+          <button onClick={clearError} aria-label={t('common.close')} className="text-warn hover:text-text">
+            <X size={14} />
+          </button>
+        </div>
+      )}
+
+      <Panel title={t('dataSource.csv.inputTitle')}>
+        <div className="flex flex-col gap-3 sm:flex-row sm:items-end">
+          <div className="flex-1">
+            <Field label={t('dataSource.csv.pathLabel')} hint={t('dataSource.csv.pathHint')}>
+              <input
+                className={inputClass}
+                value={csvPath}
+                onChange={(e) => setCsvPath(e.target.value)}
+                placeholder={t('dataSource.csv.pathPlaceholder')}
+                spellCheck={false}
+              />
+            </Field>
+          </div>
+          <div className="w-32">
+            <Field label={t('dataSource.csv.sampleRowsLabel')}>
+              <input
+                type="number"
+                min={1}
+                max={1000}
+                className={inputClass}
+                value={sampleRows}
+                onChange={(e) => setSampleRows(Number(e.target.value) || 100)}
+              />
+            </Field>
+          </div>
+          <Button variant="primary" loading={inferring} onClick={() => void inferCsv()}>
+            {t('dataSource.csv.infer')}
+          </Button>
+        </div>
+      </Panel>
+
+      {result && !result.ok && (
+        <div className="mt-4 rounded-lg border border-danger bg-danger-subtle px-3 py-2 text-sm text-danger">
+          {result.error || t('common.error')}
+        </div>
+      )}
+
+      {result?.ok && result.files && result.files.length > 0 && (
+        <div className="mt-4">
+          {result.files.map((f) => (
+            <Panel key={f.file} title={f.file || ''} className="mb-3">
+              <CsvResultBody
+                columns={f.columns ?? []}
+                preview={f.preview ?? []}
+                rowCount={f.row_count ?? 0}
+              />
+            </Panel>
+          ))}
+        </div>
+      )}
+
+      {result?.ok && !result.files && (
+        <div className="mt-4">
+          <Panel
+            title={result.file || t('dataSource.csv.resultTitle')}
+            actions={
+              <span className="font-mono text-xs text-text-muted">
+                {t('dataSource.csv.rowCount', { count: result.row_count ?? 0 })}
+              </span>
+            }
+          >
+            <CsvResultBody columns={columns} preview={preview} rowCount={result.row_count ?? 0} />
+          </Panel>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function CsvResultBody({ columns, preview }: { columns: { name: string; type: string }[]; preview: string[][]; rowCount: number }) {
+  const { t } = useTranslation();
+  if (columns.length === 0) {
+    return <Empty text={t('dataSource.csv.noColumns')} />;
+  }
+  return (
+    <div className="flex flex-col gap-4">
+      <div>
+        <h3 className="mb-2 text-sm font-medium text-text-strong">{t('dataSource.csv.schemaTitle')}</h3>
+        <Table
+          headers={[t('dataSource.csv.columnName'), t('dataSource.csv.columnType')]}
+          rows={columns.map((col) => [col.name, <span key={col.name} className="font-mono text-xs">{col.type}</span>])}
+        />
+      </div>
+      {preview.length > 1 && (
+        <div>
+          <h3 className="mb-2 flex items-center gap-1.5 text-sm font-medium text-text-strong">
+            <FileSpreadsheet size={14} aria-hidden />
+            {t('dataSource.csv.previewTitle')}
+          </h3>
+          <div className="overflow-x-auto rounded border border-border">
+            <table className="w-full border-collapse text-xs">
+              <thead>
+                <tr className="border-b border-border bg-panel text-left text-text-muted">
+                  {preview[0].map((h, i) => (
+                    <th key={i} className="whitespace-nowrap px-2 py-1.5 font-medium">{h}</th>
+                  ))}
+                </tr>
+              </thead>
+              <tbody>
+                {preview.slice(1).map((row, i) => (
+                  <tr key={i} className="border-b border-border/50">
+                    {row.map((cell, j) => (
+                      <td key={j} className="whitespace-nowrap px-2 py-1 font-mono text-text">{cell}</td>
+                    ))}
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
