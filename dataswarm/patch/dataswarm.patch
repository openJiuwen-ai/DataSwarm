+# ==========================================================================
+# 桩与工具
+# ==========================================================================
+class _StubLLM:
+    """按序吐出预设响应的 LLM 桩。"""
+
+    def __init__(self, *responses: str):
+        self.responses = list(responses)
+        self.calls: list[str] = []
+
+    def __call__(self, system_prompt: str, user_prompt: str, **kwargs) -> str:
+        self.calls.append(user_prompt)
+        return self.responses.pop(0) if self.responses else ""
+
+
+def _spec_json(metric: str, group_by: str = "orders.region", grain: str = "") -> str:
+    time_obj = {
+        "dimension": "orders.paid_at",
+        "start": "2026-08-01",
+        "end_exclusive": "2026-09-01",
+    }
+    if grain:
+        time_obj["grain"] = grain
+    return json.dumps({
+        "spec": {"metrics": [metric], "group_by": [group_by], "time": time_obj},
+        "clarifications": [],
+    })
+
+
+@pytest.fixture
+def published(e2e):
+    """导入 + 确认 + 发布好的 e2e 环境。"""
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE,
+        target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="tester")
+    write_published_snapshot(e2e)
+    versioning.publish_release(WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+                               label="V3", published_by="tester")
+    return e2e
+
