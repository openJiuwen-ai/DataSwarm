+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""库表管理、结构快照和数据源浏览的业务编排。
+
+DAO 编排：
+- list_databases / list_tables / get_table_detail / preview_table 走 business_data.get_dao()
+  （既有 DAO 或注册 codec 负责各数据源的方言与能力差异）
+- search_tables / schema_gap_analysis 走 db_connector（信息架构 LIKE 查询、跨表统计）
+"""
+from __future__ import annotations
+
+from jiuwenswarm.common.workspace_context import business_db_ref
+
+from .. import db as _da_db
+from .._common import ref_is_sqlite
+from ..business_data import get_dao
+
+db_connector = _da_db.db_connector
+
+
+def list_databases(db_ref: str | None = None) -> list[dict]:
+    """列出可用业务数据库（委托 BusinessDataDao 策略）。"""
+    ref = db_ref or business_db_ref()
+    return get_dao(db_ref=ref).list_databases()
+
+
+def _dao_db_name(db_ref: str) -> str:
+    """DAO 层契约是纯库名（Doris/MySQL）；db_ref URI 先解析出库名。
+
+    旧兼容路径 /api/databases/* 经 resolve_db_ref 优先取 query 的 db_ref，
+    可能拿到完整 URI（如 doris://olist_1）。直接当库名传给 Doris DAO 会在
+    INFORMATION_SCHEMA 匹配不到任何表（连接错误还被吞成空列表），skill/前端
+    全看到空表清单。URI 形态取 database 字段，纯库名原样返回；sqlite 只有
+    path 字段，返回原值保持 DAO 现有行为。
+    """
+    if "://" not in db_ref:
+        return db_ref
+    spec = db_connector.parse_db_ref(db_ref)
+    return spec.get("database") or db_ref
+
+
+def _dao_ref(db_ref: str) -> str:
+    """Return a complete business ref for DAO dialect selection.
+
+    The legacy URL shape passes a bare database name in the path.  It is a
+    logical database selector, not a SQLite path; use the current workspace
+    business ref to select the DAO implementation in that case.
+    """
+    return db_ref if "://" in db_ref else business_db_ref()
+
+
+def list_tables(db_ref: str) -> list[dict]:
+    """列出指定数据库的表（含元信息：行数、列数、层级推断）。"""
+    return get_dao(db_ref=_dao_ref(db_ref)).list_tables(_dao_db_name(db_ref))
+
+
+def get_table_detail(db_ref: str, table_name: str) -> dict:
+    """表详情：DDL、列、索引、行数。"""
+    return get_dao(db_ref=_dao_ref(db_ref)).get_table_detail(_dao_db_name(db_ref), table_name)
+
+
+def preview_table(db_ref: str, table_name: str, limit: int = 10,
+                  offset: int = 0) -> dict:
+    """预览表数据（offset 起取 limit 行，附全表行数 total）。"""
+    return get_dao(db_ref=_dao_ref(db_ref)).preview_table(
+        _dao_db_name(db_ref), table_name, limit, offset)
+
+
+def search_tables(db_ref: str, query: str, top_k: int = 10) -> dict:
+    """按表名模糊搜索（跨库或单库由 db_connector 决定）。
+
+    G15 修复：参数化查询——sql 占位符 ? + params 一起传给 db_connector.query，
+    避免未绑定占位符报错，同时天然防 SQL 注入（用户输入不拼进 SQL 文本）。
+    新接入类型通过各自的目录 codec 获取表名，避免把 INFORMATION_SCHEMA / LIMIT
+    假设带到 SQL Server、采样存储或仅结构源。
+    """
+    try:
+        scheme = db_ref.split("://", 1)[0].lower() if "://" in db_ref else ""
+        if scheme and scheme not in {"sqlite", "mysql", "doris"}:
+            names = db_connector.tables(db_ref).get("tables", [])
+            needle = (query or "").lower()
+            matched = [n for n in names if needle in n.lower()][:max(0, top_k)]
+            return {
+                "ok": True,
+                "results": [{"table_name": n} for n in matched],
+                "query": query,
+                "db_ref": db_ref,
+            }
+        sql, params = _search_tables_sql(db_ref, query, top_k)
+        result = db_connector.query(db_ref, sql, params=params)
+        # db_connector.query 返回 {row_count, columns, rows, ...}；search 返回 rows 作为 results
+        rows = result.get("rows", []) if isinstance(result, dict) else result
+        return {"ok": True, "results": rows, "query": query, "db_ref": db_ref}
+    except Exception as exc:
+        return {"ok": False, "error": str(exc), "query": query, "db_ref": db_ref}
+
+
+def _search_tables_sql(db_ref: str, query: str, top_k: int = 10) -> tuple[str, tuple]:
+    """返回 (sql, params)。占位符 ? 由 db_connector._format_sql 跨方言适配（sqlite ?/doris %s）。
+
+    params = (f"%{query}%", top_k)——LIKE 值 + LIMIT 值都参数化，不拼进 SQL 文本。
+    duckdb 文件源不走此函数（search_tables 在 service 层直接过滤 tables() 列表）。
+    """
+    if ref_is_sqlite(db_ref):
+        return (
+            "SELECT name as table_name FROM sqlite_master "
+            "WHERE type='table' AND name LIKE ? LIMIT ?"
+        ), (f"%{query}%", top_k)
+    return (
+        "SELECT TABLE_SCHEMA as db_name, TABLE_NAME as table_name "
+        "FROM INFORMATION_SCHEMA.TABLES "
+        "WHERE TABLE_NAME LIKE ? LIMIT ?"
+    ), (f"%{query}%", top_k)
+
+
+def schema_gap_analysis(db_ref: str, business: str = "",
+                        layers: str = "ODS,DWD,DWS,ADS") -> dict:
+    """检查各分层是否有表（缺层告警）。"""
+    try:
+        raw = db_connector.tables(db_ref)
+        if isinstance(raw, dict):
+            raw_tables = raw.get("tables", []) or []
+        elif isinstance(raw, list):
+            raw_tables = raw
+        else:
+            raw_tables = []
+        table_names = [t if isinstance(t, str) else t.get("table_name", t.get("name", str(t)))
+                       for t in raw_tables]
+        bare_names = {name: name for name in table_names}
+        if db_ref.startswith("duckdb://") and db_connector.parse_db_ref(db_ref).get("source_type") == "duckdb":
+            from jiuwenswarm.common.ref_codec import table_identifier_parts
+
+            # 分层前缀属于表名；保留完整引用供后续查询定位到同一个 schema。
+            bare_names = {name: table_identifier_parts(name, "duckdb")[-1] for name in table_names}
+        layer_list = [part.strip().upper() for part in layers.split(",")]
+        gap = {}
+        for layer in layer_list:
+            prefix = f"{layer.lower()}_"
+            found = [t for t in table_names if bare_names[t].lower().startswith(prefix)]
+            gap[layer] = {"count": len(found), "tables": found, "missing": len(found) == 0}
+        return {
+            "ok": True,
+            "db_ref": db_ref,
+            "business": business,
+            "gap": gap,
+            "total_tables": len(table_names),
+        }
+    except Exception as exc:
+        return {"ok": False, "error": str(exc), "db_ref": db_ref}
+
+
+def schema_snapshot(db_ref: str, tables: list[str] | None = None) -> dict:
+    """批量读取表结构及可用的索引、DDL 元数据。
+
+    在服务端通过 db_connector 收集元数据，减少调用方逐表发送 HTTP 请求。
+    单表探测失败记录 error，继续处理其余表。
+    索引/DDL 是可选能力；metadata_status 明示 available/unsupported/failed，
+    缺少能力不影响已读出的 columns，已实现端口的实际错误仍保留。
+
+    Args:
+        db_ref: 业务库 db-ref
+        tables: 指定表清单；缺省快照全表
+    Returns:
+        {ok, db_ref, tables:[{table, columns, indexes, create_sql}|{table, error}],
+         table_count, elapsed_ms} 或 {ok:false, error}
+    """
+    import time as _time
+    from jiuwenswarm.common.dialect_registry import db_type_of_ref
+    from jiuwenswarm.common.ref_codec import RefCodec, codec_for
+
+    t0 = _time.time()
+    try:
+        if not tables:
+            raw = db_connector.tables(db_ref)
+            names = raw.get("tables", []) or [] if isinstance(raw, dict) else list(raw or [])
+        else:
+            names = list(tables)
+        codec = codec_for(db_type_of_ref(db_ref))
+        index_hook = "read_indexes" if codec.uses_pool else "indexes"
+        ddl_hook = "read_create_sql" if codec.uses_pool else "create_sql"
+        supported = {
+            "indexes": getattr(type(codec), index_hook) is not getattr(RefCodec, index_hook),
+            "create_sql": getattr(type(codec), ddl_hook) is not getattr(RefCodec, ddl_hook),
+        }
+        out: list[dict] = []
+        for name in names:
+            entry: dict = {"table": name}
+            try:
+                metadata = db_connector.schema(db_ref, name)
+                entry["columns"] = metadata.get("columns", [])
+            except Exception as exc:  # noqa: BLE001 —— 单表失败隔离
+                entry["error"] = f"{type(exc).__name__}: {exc}"[:300]
+            else:
+                entry["metadata_status"] = {}
+                for key, operation in (("indexes", "list_indexes"), ("create_sql", "show_create_table")):
+                    empty = [] if key == "indexes" else ""
+                    entry[key] = empty
+                    # 原生文件库在字段反射时已返回持久 DDL，无需再开连接读取。
+                    reflected_key = "ddl" if key == "create_sql" else key
+                    if metadata.get(reflected_key) is not None:
+                        entry[key] = metadata[reflected_key]
+                        entry["metadata_status"][key] = "available"
+                        continue
+                    if not supported[key]:
+                        entry["metadata_status"][key] = "unsupported"
+                        continue
+                    try:
+                        entry[key] = getattr(db_connector, operation)(db_ref, name).get(key, empty)
+                        entry["metadata_status"][key] = "available"
+                    except Exception as exc:  # noqa: BLE001 —— 真实探测错误不能冒充无能力
+                        message = f"{type(exc).__name__}: {exc}"[:300]
+                        entry["metadata_status"][key] = "failed"
+                        entry.setdefault("metadata_errors", {})[key] = message
+                        errors = entry.get("error", "")
+                        entry["error"] = (f"{errors}; " if errors else "") + f"{key}: {message}"
+            out.append(entry)
+        return {"ok": True, "db_ref": db_ref, "tables": out,
+                "table_count": len(out),
+                "elapsed_ms": int((_time.time() - t0) * 1000)}
+    except Exception as exc:
+        return {"ok": False, "error": str(exc), "db_ref": db_ref,
+                "elapsed_ms": int((_time.time() - t0) * 1000)}
