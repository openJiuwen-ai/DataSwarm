+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_error_classify 错误分类单测（dialect-convergence 批次 2-G7 真相源）。
+
+从 nl2sql/tests/test_db_client.py 的分类断言迁移并扩充：
+MySQL 错误码 / Doris 1105 / DuckDB 三类文本 / with_phase 输出形态。
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+_SCRIPT = (_REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+           / "skills" / "_dw_common" / "scripts" / "dw_error_classify.py")
+
+
+@pytest.fixture(scope="module")
+def dec():
+    spec = importlib.util.spec_from_file_location("_dw_error_classify_test", _SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault("_dw_error_classify_test", mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _cls(dec, msg: str):
+    return dec.classify_error(Exception(msg))
+
+
+# --------------------------------------------------------------------------
+# MySQL 协议族（pymysql 错误码文本）
+# --------------------------------------------------------------------------
+def test_mysql_permission_denied(dec):
+    et, _, retry = _cls(dec, "(1142, \"SELECT command denied to user 'x'\")")
+    assert (et, retry) == ("PERMISSION_DENIED", False)
+
+
+def test_mysql_table_not_found(dec):
+    et, _, retry = _cls(dec, "(1146, \"Table 'biz.no_such' doesn't exist\")")
+    assert (et, retry) == ("TABLE_NOT_FOUND", False)
+
+
+def test_mysql_syntax_error_code_1064(dec):
+    et, _, retry = _cls(dec, "(1064, \"You have an error in your SQL syntax\")")
+    assert (et, retry) == ("SYNTAX_ERROR", True)
+
+
+def test_doris_1105_errcode_2(dec):
+    """Doris 语法错：1105 + errCode = 2（detailMessage 带解析器字样）。"""
+    et, _, retry = _cls(dec, "(1105, 'errCode = 2, mismatched input ...')")
+    assert (et, retry) == ("SYNTAX_ERROR", True)
+
+
+# --------------------------------------------------------------------------
+# DuckDB 文件源（EngineException 文本，无错误码）
+# --------------------------------------------------------------------------
+def test_duckdb_table_catalog_error(dec):
+    et, _, retry = _cls(dec, "Catalog Error: Table with name orders does not exist.")
+    assert (et, retry) == ("TABLE_NOT_FOUND", False)
+
+
+def test_duckdb_column_catalog_error(dec):
+    """列不存在先于通用 not found（修复动作不同：改 SELECT vs 换表）。"""
+    et, _, retry = _cls(dec, "Catalog Error: Column with name amt does not exist")
+    assert (et, retry) == ("COLUMN_NOT_FOUND", False)
+
+
+def test_duckdb_parser_exception(dec):
+    et, _, retry = _cls(dec, "ParserException: syntax error at or near \"FROM\"")
+    assert (et, retry) == ("SYNTAX_ERROR", True)
+
+
+def test_duckdb_binder_error(dec):
+    et, _, retry = _cls(dec, "Binder Error: No function matches 'date_trunc(VARCHAR)'")
+    assert (et, retry) == ("SYNTAX_ERROR", True)
+
+
+def test_duckdb_generic_catalog_error(dec):
+    """其余 Catalog Error 形态归 SYNTAX_ERROR（改写 SQL，重试无意义）。"""
+    et, _, retry = _cls(dec, "Catalog Error: Scalar Function with name x does not exist")
+    assert (et, retry) == ("SYNTAX_ERROR", True)
+
+
+def test_ambiguous_table_name_is_not_reported_as_service_error(dec):
+    """裸表名跨 schema 同名：修复动作是改用全限定名，不是查日志重试。"""
+    et, _, retry = _cls(
+        dec,
+        "not_found: table 'index_trade' is ambiguous across schemas; "
+        'use a qualified name: "indextrade_database"."index_trade", "main"."index_trade"',
+    )
+    assert (et, retry) == ("AMBIGUOUS_TABLE", True)
+
+
+# --------------------------------------------------------------------------
+# 通用
+# --------------------------------------------------------------------------
+def test_timeout_retryable(dec):
+    et, _, retry = _cls(dec, "(3024, 'Query timeout')")
+    assert (et, retry) == ("TIMEOUT", True)
+
+
+def test_unknown_falls_through(dec):
+    et, _, retry = _cls(dec, "connection reset by peer")
+    assert (et, retry) == ("UNKNOWN", True)
+
+
+def test_with_phase_output_shape(dec):
+    out = dec.with_phase("COLUMN_NOT_FOUND")
+    assert out["error_type"] == "COLUMN_NOT_FOUND"
+    assert out["error_phase"] == "SQL_EXECUTION"
+    assert "列名拼写" in out["suggestion"]
+    out2 = dec.with_phase("SYNTAX_ERROR", phase="SQL_DRY_RUN")
+    assert out2["error_phase"] == "SQL_DRY_RUN"
+
+
+def test_suggestions_cover_all_types(dec):
+    """SUGGESTIONS 覆盖 classify_error 的全部返回类型（UNKNOWN 不裸奔）。"""
+    for et in ("PERMISSION_DENIED", "TABLE_NOT_FOUND", "AMBIGUOUS_TABLE", "COLUMN_NOT_FOUND",
+               "SYNTAX_ERROR", "TIMEOUT", "UNKNOWN"):
+        assert dec.SUGGESTIONS[et]
