+                return {"ok": False, "error": f"directory contains no Excel workbooks: {path}"}
+            return {"ok": True, "message": f"{len(workbooks)} workbook(s) readable"}
+        if path.suffix.lower() not in (".xlsx", ".xlsm", ".xls"):
+            return {"ok": False, "error": "only .xls / .xlsx / .xlsm workbooks are supported"}
+        if path.suffix.lower() == ".xls":
+            try:
+                import xlrd
+
+                workbook = xlrd.open_workbook(str(path))
+                workbook.release_resources()
+                return {"ok": True, "message": "workbook readable"}
+            except ImportError:
+                return {"ok": False, "error": "xlrd is required for .xls (Excel 97-2003) workbooks"}
+            except Exception as exc:
+                return {"ok": False, "error": str(exc)}
+        try:
+            from openpyxl import load_workbook
+
+            workbook = load_workbook(path, read_only=True)
+            workbook.close()
+            return {"ok": True, "message": "workbook readable"}
+        except Exception as exc:
+            return {"ok": False, "error": str(exc)}
