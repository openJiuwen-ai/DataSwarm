+test('query changes reject stale results; dismissing a refresh error retains successful data and failure state', async () => {
+  const old = deferred();
+  let state;
+  function Harness({ load }) {
+    state = runtime.useListQuery(load);
+    return null;
+  }
+  const { root } = await mount(React.createElement(Harness, { load: () => old.promise }));
+  let fail = false;
+  const nextLoad = async () => {
+    if (fail) throw new Error('refresh failed');
+    return { items: ['current'], total: 12, meta: { success: 12 } };
+  };
+  await act(async () => root.render(React.createElement(Harness, { load: nextLoad })));
+  await act(async () => old.resolve({ items: ['stale'], total: 99, meta: { failed: 99 } }));
+  assert.deepEqual(state.items, ['current']);
+  assert.equal(state.total, 12);
+  assert.deepEqual(state.meta, { success: 12 });
+  fail = true;
+  await act(async () => state.reload());
+  await act(async () => state.dismissError());
+  assert.equal(state.error, 'refresh failed');
+  assert.equal(state.visibleError, null);
+  assert.equal(state.hasLoaded, true);
+  assert.deepEqual(state.items, ['current']);
+  assert.deepEqual(state.meta, { success: 12 });
+});
