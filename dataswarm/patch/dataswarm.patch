+"""semantic/service.py extract_value_dict 选列过滤单测。
+
+覆盖：日期族类型出白名单、标识/通信类列名与 _id 列整列排除、
+正常枚举列保留（full-merge-1021 维值召回污染修复的回归锁）。
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from jiuwenswarm.channels.web.dataagent.semantic import service
+
+
+def _column(name, data_type, *, sensitive=False):
+    return SimpleNamespace(
+        name=name, data_type=data_type, is_sensitive=sensitive,
+        node_id=f"col:mysql:src:shop.orders.{name}",
+    )
+
+
+def _snapshot(columns):
+    table = SimpleNamespace(
+        table_type="BASE TABLE", name="orders",
+        database="shop", node_id="tbl:mysql:src:shop.orders",
+        columns=columns,
+    )
+    return SimpleNamespace(tables=[table])
+
+
+def _install_db(monkeypatch, values_by_column):
+    """query_dict 桩：COUNT 查询回 distinct 数，取值查询回该列的值列表。"""
+
+    def query_dict(db_ref, sql, limit=None):
+        if "COUNT(DISTINCT" in sql:
+            col = sql.split("COUNT(DISTINCT `")[1].split("`")[0]
+            return [{"n": len(values_by_column.get(col, []))}]
+        col = sql.split("SELECT /*+ MAX_EXECUTION_TIME(30000) */ `")[1].split("`")[0]
+        return [{"v": v} for v in values_by_column.get(col, [])]
+
+    monkeypatch.setattr(service.db_connector, "query_dict", query_dict)
+
