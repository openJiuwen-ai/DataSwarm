+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""确认回复交给方案上下文语义层处理的回归测试。"""
+
+import intent as intent_mod
+
+
+def test_confirmation_replies_can_be_handed_off_without_rule_match():
+    """确认短语不需要全部命中规则即可交给上层语义判断。"""
+    for text in ("确认", "确认执行", "OK", "好", "可以"):
+        result = intent_mod.classify(text, plan_id="plan_demo")
+
+        assert result["action"] in {"EXECUTE", "UNKNOWN"}
+        if result["action"] == "UNKNOWN":
+            assert "已有待确认方案和唯一 plan_id" in result["llm_fallback"]
+            assert "可直接 handoff" in result["llm_fallback"]
+
+
+def test_execute_reply_remains_compatible_with_existing_rule_match():
+    """已有 EXECUTE 规则命中仍然可以直接进入执行分支。"""
+    result = intent_mod.classify("执行", plan_id="plan_demo")
+
+    assert result["action"] == "EXECUTE"
+
+
+def test_non_confirmation_rule_miss_keeps_initial_intent_fallback():
+    """无关输入仍然保持 UNKNOWN，不应被确认语义规则放行。"""
+    result = intent_mod.classify("你好", plan_id="plan_demo")
+
+    assert result["action"] == "UNKNOWN"
+    assert result["ask_user"] is True
