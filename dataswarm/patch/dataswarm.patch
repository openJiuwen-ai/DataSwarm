@@ -0,0 +1,228 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""原生 DuckDB 文件的真实连接、命名空间、分析和只读边界。"""
+
+from __future__ import annotations
+
+import hashlib
+from decimal import Decimal
+
+import pytest
+
+duckdb = pytest.importorskip("duckdb")
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import SourceDefinition
+from jiuwenswarm.channels.web.dataagent.connectors.duckdb_connector import DuckDBConnector
+from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError, QueryValidationError
+
+
+def connector(path):
+    return DuckDBConnector(SourceDefinition(
+        source_id="native", source_type="duckdb", name="Native DuckDB", engine="duckdb",
+        config={"location": str(path), "sandbox": False},
+    ))
+
+
+@pytest.fixture
+def database(tmp_path):
+    path = tmp_path / "原生 数据库.duckdb"
+    with duckdb.connect(str(path)) as connection:
+        connection.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY, region VARCHAR NOT NULL, "
+                           "amount DECIMAL(10,2) DEFAULT 0, ds DATE)")
+        connection.execute("COMMENT ON TABLE orders IS '订单'")
+        connection.execute("COMMENT ON COLUMN orders.amount IS '订单金额'")
+        connection.execute("INSERT INTO orders VALUES "
+                           "(1, 'east', 10.25, '2026-01-01'), "
+                           "(2, 'east', 20.50, '2026-01-02'), "
+                           "(3, 'west', NULL, '2026-02-01'), "
+                           "(4, 'west', 5.00, '2026-02-02')")
+        connection.execute("CREATE SCHEMA analytics")
+        connection.execute("CREATE TABLE analytics.orders AS SELECT 99 AS id")
+        connection.execute("CREATE VIEW analytics.totals AS "
+                           "SELECT region, sum(amount) AS amount FROM main.orders GROUP BY region")
+        connection.execute('CREATE TABLE "a.b" ("odd""column" INTEGER)')
+        connection.execute('INSERT INTO "a.b" VALUES (7)')
+        connection.execute('CREATE SCHEMA "quoted.schema"')
+        connection.execute('CREATE TABLE "quoted.schema"."odd""table" (value INTEGER)')
+        connection.execute('INSERT INTO "quoted.schema"."odd""table" VALUES (8)')
+    return path
+
+
+def test_catalog_retains_schemas_tables_and_views(database):
+    source = connector(database)
+    assert source.test_connection()["ok"] is True
+    catalog = source.catalog()
+    objects = {(row["schema"], row["name"], row["type"]) for row in catalog["datasets"]}
+    assert objects == {("main", "orders", "table"), ("main", "a.b", "table"),
+                       ("analytics", "orders", "table"), ("analytics", "totals", "view"),
+                       ("quoted.schema", 'odd"table', "table")}
+    assert {row["name"] for row in catalog["schemas"]} == {"main", "analytics", "quoted.schema"}
+
+
+def test_schema_preserves_constraints_comments_and_ddl(database):
+    metadata = connector(database).schema('"main"."orders"')
+    assert metadata["dataset"] == "orders"
+    assert metadata["schema"] == "main"
+    columns = {column["name"]: column for column in metadata["columns"]}
+    assert columns["id"]["pk"] and not columns["id"]["nullable"]
+    assert not columns["region"]["nullable"]
+    assert columns["amount"]["nullable"] and columns["amount"]["default"] == "0"
+    assert columns["amount"]["type"] == "DECIMAL(10,2)"
+    assert columns["amount"]["comment"] == "订单金额"
+    assert metadata["primary_key"] == ["id"] and metadata["partition_key"] == "ds"
+    assert metadata["comment"] == "订单" and metadata["ddl"].startswith("CREATE TABLE")
+    assert "indexes" not in metadata and "foreign_keys" not in metadata
+
+
+@pytest.mark.parametrize("name, expected", [
+    ('"analytics"."orders"', [[99]]),
+    ('a.b', [[7]]),
+    ('"main"."a.b"', [[7]]),
+    ('"quoted.schema"."odd""table"', [[8]]),
+])
+def test_preview_distinguishes_quoted_and_same_named_tables(database, name, expected):
+    assert connector(database).preview(name)["rows"] == expected
+
+
+def test_explicit_schema_and_view_metadata(database):
+    source = connector(database)
+    assert source.schema("orders", schema_name="analytics")["columns"][0]["name"] == "id"
+    metadata = source.schema("totals", schema_name="analytics")
+    assert metadata["ddl"].startswith("CREATE VIEW")
+    assert metadata["primary_key"] == []
+    assert source.preview('"analytics"."totals"')["row_count"] == 2
+
+
+def test_quoted_identifier_is_not_shadowed_by_literal_main_table(database):
+    with duckdb.connect(str(database)) as connection:
+        connection.execute('CREATE TABLE """analytics"".""orders""" AS SELECT 1000 AS id')
+    source = connector(database)
+    assert source.preview('"analytics"."orders"')["rows"] == [[99]]
+    assert source.preview('"main"."""analytics"".""orders"""')["rows"] == [[1000]]
+    assert source.schema('"analytics"."orders"', schema_name="main")["schema"] == "main"
+
+
+def test_analysis_parameters_and_truncation_do_not_modify_file(database):
+    before = hashlib.sha256(database.read_bytes()).hexdigest()
+    source = connector(database)
+    assert source.query("SELECT SUM(amount) FROM orders")["rows"] == [[Decimal("35.75")]]
+    assert source.query("SELECT region, SUM(amount) FROM orders GROUP BY region "
+                        "ORDER BY SUM(amount) DESC")["rows"] == [
+                            ["east", Decimal("30.75")], ["west", Decimal("5.00")]]
+    assert source.query("SELECT COUNT(*) FROM orders WHERE amount IS NULL")["rows"] == [[1]]
+    assert source.query("SELECT id FROM orders WHERE region = ? ORDER BY id", ["west"])["rows"] == [[3], [4]]
+    bounded = source.query("SELECT * FROM orders ORDER BY id", limit=2)
+    assert bounded["row_count"] == 2 and bounded["truncated"] is True
+    assert hashlib.sha256(database.read_bytes()).hexdigest() == before
+    # 每次调用关闭连接后，外部写入者仍可正常打开文件。
+    with duckdb.connect(str(database)) as connection:
+        assert connection.execute("SELECT COUNT(*) FROM orders").fetchone()[0] == 4
+
+
+def test_batch_stats_uses_unambiguous_identifiers(database):
+    stats = connector(database).batch_stats()
+    assert stats['"main"."orders"']["row_count"] == 4
+    assert stats['"analytics"."orders"']["row_count"] == 1
+    assert stats['"main"."a.b"']["row_count"] == 1
+
+
+@pytest.mark.parametrize("sql", [
+    "DROP TABLE orders", "INSERT INTO orders (id, region) VALUES (5, 'north')",
+    "ATTACH 'other.duckdb' AS other", "COPY orders TO 'out.csv'",
+    "SELECT 1; DELETE FROM orders", "CREATE TABLE saved AS SELECT * FROM orders",
+])
+def test_write_sql_is_rejected_before_connect(database, monkeypatch, sql):
+    source = connector(database)
+    monkeypatch.setattr(source, "_connection", lambda: pytest.fail("SQL guard must run before I/O"))
+    with pytest.raises(QueryValidationError):
+        source.query(sql)
+    with pytest.raises(ConnectorError, match="read-only"):
+        source.execute_write(sql)
+
+
+@pytest.mark.parametrize("sql", [
+    "SELECT * FROM read_text(?)", "SELECT * FROM read_csv(?)", "SELECT * FROM glob(?)",
+])
+def test_external_access_is_disabled(database, tmp_path, sql):
+    secret = tmp_path / "unrelated.csv"
+    secret.write_text("private\n123\n", encoding="utf-8")
+    with pytest.raises(duckdb.Error, match="disabled|Permission"):
+        connector(database).query(sql, [str(secret)])
+
+
+def test_stored_external_view_is_blocked(database, tmp_path):
+    external = tmp_path / "external.csv"
+    external.write_text("amount\n123\n", encoding="utf-8")
+    with duckdb.connect(str(database)) as connection:
+        escaped = str(external).replace("'", "''")
+        connection.execute(f"CREATE VIEW external_view AS SELECT * FROM read_csv('{escaped}')")
+    source = connector(database)
+    assert any(item["name"] == "external_view" for item in source.catalog()["datasets"])
+    with pytest.raises(duckdb.Error, match="disabled|Permission"):
+        source.preview("external_view")
+    with pytest.raises(duckdb.Error, match="locked"):
+        source.query("PRAGMA enable_external_access = true")
+
+
+def test_parallel_read_connections_use_same_locked_configuration(database):
+    source = connector(database)
