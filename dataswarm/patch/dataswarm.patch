+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/business_data/doris_impl.py — Doris 业务库访问实现。
+
+从 meta_data/doris_store.py 迁移。直接 pymysql 连 Doris 业务库。
+"""
+from __future__ import annotations
+
+import os
+from contextlib import closing
+from datetime import datetime
+from typing import Any
+
+# db_connector 已上收至 jiuwenswarm.common（方案 docs/skill-cli-web-api-plan.md §7.1）
+from jiuwenswarm.common import db_connector  # type: ignore  # noqa: E402
+from jiuwenswarm.common.dw_layer import infer_layer as _infer_layer
+
+from .base import BusinessDataDao, register
+
+
+# 系统库过滤
+_HIDDEN_DATABASES = {
+    "information_schema", "mysql", "__internal_schema",
+    "sys", "performance_schema", "__recycle_bin__",
+    "bigdata",
+}
+
+
+def _doris_config() -> dict:
+    """读取 Doris 连接配置。"""
+    _doris_yaml = db_connector._read_config_section("doris")
+    return {
+        "host": os.getenv("DORIS_HOST") or _doris_yaml.get("host") or "",
+        "port": int(os.getenv("DORIS_PORT") or _doris_yaml.get("port") or 9030),
+        "user": os.getenv("DORIS_USER") or _doris_yaml.get("user") or "admin",
+        "password": os.getenv("DORIS_PASSWORD") or _doris_yaml.get("password") or "",
+    }
+
+
+def _json_safe(v: Any) -> Any:
+    """Convert non-JSON-serializable types to safe primitives."""
+    if v is None:
+        return None
+    if isinstance(v, (str, int, float, bool)):
+        return v
+    if isinstance(v, datetime):
+        return v.isoformat()
+    if isinstance(v, bytes):
+        try:
+            return v.decode("utf-8")
+        except UnicodeDecodeError:
+            return v.decode("utf-8", errors="replace")
+    if isinstance(v, (list, tuple)):
+        return [_json_safe(x) for x in v]
+    if isinstance(v, dict):
+        return {str(k): _json_safe(x) for k, x in v.items()}
+    return str(v)
+
+
+@register
+class DorisBusinessDao(BusinessDataDao):
+    dao_type = "doris"
+
+    def __init__(self, db_ref: str | None = None):
+        self._db_ref = db_ref
+
+    def _conn_spec(self) -> dict:
+        """连接配置：db_ref 解析结果优先，无 db_ref 退回全局 doris: 段。
+
+        完整形态（mysql://host:port/db）host/port/凭据取自 ref（UI 源凭据经
+        parse_db_ref 的 _lookup_source_credentials 回填）；短形态（doris://db）
+        parse_db_ref 自动补全为 config 段——与全局段行为一致。凭据为空不
+        fallback 全局段（跨源串凭据比连接失败更糟），让 pymysql 大声报错。
+        """
+        if self._db_ref:
+            spec = db_connector.parse_db_ref(self._db_ref)
+            if spec.get("host"):
+                return {
+                    "host": spec["host"],
+                    "port": int(spec.get("port") or 9030),
+                    "user": spec.get("user") or "",
+                    "password": spec.get("password") or "",
+                }
+        return _doris_config()
+
+    def _conn(self, database: str | None = None):
+        """创建 pymysql 连接（MySQL 协议族：Doris / MySQL 业务库）。"""
+        import pymysql  # type: ignore
+        cfg = self._conn_spec()
+        if database:
+            cfg["database"] = database
+        return pymysql.connect(**cfg, cursorclass=pymysql.cursors.DictCursor)
+
+    def list_databases(self) -> list[dict]:
+        """Doris: SHOW DATABASES 过滤系统库。"""
+        import pymysql  # type: ignore
+        try:
+            with closing(self._conn()) as conn:
+                with conn.cursor() as cur:
+                    cur.execute("SHOW DATABASES")
+                    rows = cur.fetchall()
+        except pymysql.Error:
+            return []
+
+        result: list[dict] = []
+        cfg = self._conn_spec()
+        configured_db = ""
+        if self._db_ref:
+            configured_db = db_connector.parse_db_ref(self._db_ref).get("database") or ""
+        if configured_db:
+            rows = [{"Database": configured_db}]
+        for row in rows:
+            name = row["Database"]
+            if name in _HIDDEN_DATABASES:
+                continue
+            table_count = 0
+            try:
+                with closing(self._conn(name)) as conn:
+                    with conn.cursor() as cur:
+                        cur.execute("SHOW TABLES")
+                        table_count = len(cur.fetchall())
+            except pymysql.Error:
+                pass
+            result.append({
+                "name": name,
+                "path": f"{cfg['host']}:{cfg['port']}/{name}",
+                "size_bytes": 0,
+                "table_count": table_count,
+            })
+        return sorted(result, key=lambda d: d["name"])
+
+    def list_tables(self, db_name: str) -> list[dict]:
+        """Doris: INFORMATION_SCHEMA.TABLES + COLUMNS 查指定库的表。"""
+        import pymysql  # type: ignore
+        try:
+            with closing(self._conn(db_name)) as conn:
+                with conn.cursor() as cur:
+                    cur.execute(
+                        "SELECT TABLE_NAME, TABLE_ROWS, CREATE_TIME "
+                        "FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = %s "
+                        "ORDER BY TABLE_NAME",
+                        (db_name,),
+                    )
+                    rows = cur.fetchall()
+                    cur.execute(
+                        "SELECT TABLE_NAME, COUNT(*) AS cnt "
+                        "FROM INFORMATION_SCHEMA.COLUMNS "
+                        "WHERE TABLE_SCHEMA = %s GROUP BY TABLE_NAME",
+                        (db_name,),
+                    )
+                    col_counts = {r["TABLE_NAME"]: int(r["cnt"])
+                                  for r in cur.fetchall()}
+        except pymysql.Error:
+            return []
+
+        result: list[dict] = []
+        for row in rows:
+            table_name = row["TABLE_NAME"]
+            mtime = row["CREATE_TIME"]
+            result.append({
+                "name": table_name,
+                "row_count": int(row["TABLE_ROWS"] or 0),
+                "column_count": col_counts.get(table_name, 0),
+                "layer": _infer_layer(table_name),
+                "last_modified": mtime.isoformat() if mtime else "",
+            })
+        return result
+
+    def get_table_detail(self, db_name: str, table_name: str) -> dict:
+        """Doris: SHOW CREATE TABLE + INFORMATION_SCHEMA.COLUMNS/STATISTICS。"""
+        import pymysql  # type: ignore
+        with closing(self._conn(db_name)) as conn:
+            with conn.cursor() as cur:
+                cur.execute(f"SHOW CREATE TABLE `{table_name}`")
+                row = cur.fetchone()
+                ddl = ((row.get("Create Table") or row.get("Create View") or "")
+                       if row else "")
+
+                cur.execute(
+                    "SELECT COLUMN_NAME, COLUMN_TYPE, IS_NULLABLE, COLUMN_KEY, COLUMN_DEFAULT "
+                    "FROM INFORMATION_SCHEMA.COLUMNS "
+                    "WHERE TABLE_SCHEMA = %s AND TABLE_NAME = %s "
+                    "ORDER BY ORDINAL_POSITION",
+                    (db_name, table_name),
+                )
+                col_rows = cur.fetchall()
+                columns: list[dict] = []
+                for r in col_rows:
+                    # COLUMN_TYPE 带长度（varchar(64)）；COLUMN_KEY=PRI 才是主键
+                    # （DUP/UNI 是重复/唯一索引，不是主键，误判会致 drift 基线对比批量误报）
+                    columns.append({
+                        "name": r["COLUMN_NAME"],
+                        "type": r["COLUMN_TYPE"],
+                        "nullable": r["IS_NULLABLE"] == "YES",
+                        "primary_key": r["COLUMN_KEY"] == "PRI",
+                        "default_value": r["COLUMN_DEFAULT"],
+                    })
+
+                try:
+                    cur.execute(
+                        "SELECT INDEX_NAME, "
+                        "GROUP_CONCAT(COLUMN_NAME ORDER BY SEQ_IN_INDEX) AS cols, "
+                        "NON_UNIQUE FROM INFORMATION_SCHEMA.STATISTICS "
+                        "WHERE TABLE_SCHEMA = %s AND TABLE_NAME = %s "
+                        "GROUP BY INDEX_NAME, NON_UNIQUE",
+                        (db_name, table_name),
+                    )
+                    idx_rows = cur.fetchall()
+                    indexes = [{
+                        "name": r["INDEX_NAME"],
+                        "columns": (r["cols"] or "").split(","),
+                        "sql": "",
+                        "unique": not r["NON_UNIQUE"],
+                    } for r in idx_rows]
+                except pymysql.Error:
+                    indexes = []
+
+                try:
+                    cur.execute(
+                        "SELECT TABLE_ROWS, TABLE_COMMENT FROM INFORMATION_SCHEMA.TABLES "
+                        "WHERE TABLE_SCHEMA = %s AND TABLE_NAME = %s",
+                        (db_name, table_name),
+                    )
+                    tr = cur.fetchone()
+                    row_count = int(tr["TABLE_ROWS"] or 0) if tr else 0
+                    comment = (tr["TABLE_COMMENT"] or "") if tr else ""
+                except pymysql.Error:
+                    row_count = 0
+                    comment = ""
+        return {
+            "name": table_name,
+            "ddl": ddl,
+            "columns": columns,
+            "indexes": indexes,
+            "foreign_keys": [],
+            "row_count": row_count,
+            "comment": comment,
+        }
+
+    def preview_table(self, db_name: str, table_name: str,
+                      limit: int = 10, offset: int = 0) -> dict:
+        """Doris: SELECT * FROM `table` LIMIT N OFFSET M（附全表行数 total）。"""
+        limit = max(1, min(int(limit), 1000))
+        offset = max(0, int(offset))
+        with closing(self._conn(db_name)) as conn:
+            with conn.cursor() as cur:
+                cur.execute(
+                    "SELECT 1 FROM INFORMATION_SCHEMA.TABLES "
+                    "WHERE TABLE_SCHEMA = %s AND TABLE_NAME = %s",
+                    (db_name, table_name),
+                )
+                if not cur.fetchone():
+                    raise LookupError(f"table not found: {table_name}")
+                cur.execute(f"SELECT COUNT(*) AS total FROM `{table_name}`")
+                total = int(cur.fetchone()["total"])
+                cur.execute(
+                    f"SELECT * FROM `{table_name}` LIMIT %s OFFSET %s",
+                    (limit, offset),
+                )
+                columns = [d[0] for d in cur.description]
+                rows = [[_json_safe(v) for v in r.values()]
+                        for r in cur.fetchall()]
+        return {"columns": columns, "rows": rows, "total": total}
