+    monkeypatch.setenv("DW_TEST_API_KEY", "sk-env")
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text(
+        "models:\n"
+        "  defaults:\n"
+        "    - model_client_config:\n"
+        "        model_name: ${DW_TEST_MODEL_NAME}\n"
