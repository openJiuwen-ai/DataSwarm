+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""解析 DDL 文本，提供建模和知识候选所需的结构元数据。
+
+DDL 源没有业务数据，仅声明 metadata_only 能力，不提供 query/preview 方法。
+解析使用 sqlglot，多方言回退。结构验证可以与
+真实数据库对照，但配对数据库的查询结果不代表 DDL 源能够取数。
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from .base import Connector, SourceDefinition, build_catalog, build_schema, register_engine
+from .errors import ConnectorError
+
+#: 解析时依次尝试的方言。DDL 来源五花八门，先按最可能的试。
+_PARSE_DIALECTS = ("postgres", "mysql", "tsql", None)
+
+
+def parse_ddl(ddl_text: str, dialect: str | None = None) -> list[dict]:
+    """DDL 文本 → [{name, schema, columns:[{name,type,nullable,pk,comment}]}]。
+
+    多方言回退：显式指定 ``dialect`` 时只试它（失败即报错，不悄悄换方言——
+    用户指明了方言还静默换，错在哪就看不出来了）；未指定时依次尝试。
+    """
+    import sqlglot
+    from sqlglot import exp
+
+    text = str(ddl_text or "").strip()
+    if not text:
+        raise ConnectorError("ddl_text is empty")
+
+    dialect = str(dialect or "").strip().lower() or None
+    if dialect == "postgresql":
+        # The source form accepts PostgreSQL's name; SQLGlot requires postgres.
+        dialect = "postgres"
+    candidates = (dialect,) if dialect else _PARSE_DIALECTS
+    statements: list[Any] = []
+    errors: list[str] = []
+    for candidate in candidates:
+        try:
+            parsed = [s for s in sqlglot.parse(text, dialect=candidate) if s is not None]
+        except Exception as exc:  # noqa: BLE001 —— 换下一个方言再试
+            errors.append(f"{candidate or 'auto'}: {exc}")
+            continue
+        if any(isinstance(s, exp.Create) for s in parsed):
+            statements = parsed
+            break
+        errors.append(f"{candidate or 'auto'}: 未解析出 CREATE 语句")
+    if not statements:
+        raise ConnectorError(
+            "无法从 ddl_text 解析出 CREATE TABLE；各方言尝试结果：" + "；".join(errors)
+        )
+
+    tables: list[dict] = []
+    for statement in statements:
+        if not isinstance(statement, exp.Create):
+            continue
+        table_node = statement.find(exp.Table)
+        if table_node is None:
+            continue
+        schema_node = statement.find(exp.Schema)
+        if schema_node is None:
+            continue
+        columns: list[dict] = []
+        pk_names: set[str] = set()
+        for item in schema_node.expressions:
+            if isinstance(item, exp.PrimaryKey):
+                # 表级 PRIMARY KEY (a, b)
+                pk_names.update(col.name for col in item.expressions)
+                continue
+            if not isinstance(item, exp.ColumnDef):
+                continue
+            kind = item.args.get("kind")
+            col_type = kind.sql().upper() if kind is not None else "TEXT"
+            nullable, is_pk, comment = True, False, ""
+            for constraint in item.args.get("constraints") or []:
+                if not isinstance(constraint, exp.ColumnConstraint):
+                    continue
+                ckind = constraint.args.get("kind")
+                if isinstance(ckind, exp.PrimaryKeyColumnConstraint):
+                    is_pk, nullable = True, False
+                elif isinstance(ckind, exp.NotNullColumnConstraint):
+                    nullable = False
+                elif isinstance(ckind, exp.CommentColumnConstraint):
+                    raw = ckind.this
+                    comment = str(raw.this if hasattr(raw, "this") else raw).strip("'\"")
+            columns.append({
+                "name": item.name,
+                "type": col_type,
+                "nullable": nullable,
+                "pk": is_pk,
+                "comment": comment,
+            })
+        # 表级主键声明回填到列上
+        for column in columns:
+            if column["name"] in pk_names:
+                column["pk"] = True
+                column["nullable"] = False
+        namespace = ".".join(part for part in (table_node.catalog, table_node.db) if part)
+        tables.append({"name": table_node.name, "schema": namespace or None,
+                       "columns": columns})
+    if not tables:
+        raise ConnectorError("ddl_text 里没有可识别的 CREATE TABLE 定义")
+    return tables
+
+
+@register_engine("schema_only")
+class SchemaOnlyConnector(Connector):
+    """DDL 文本源。只实现通用元数据端口，**不实现 query / preview**。
+
+    不实现是刻意的：能力协议按方法存在性判定，留个抛异常的占位会让能力探测
+    将仅元数据源误判为支持 SQL。
+    """
+
+    engine = "schema_only"
+
+    def __init__(self, source: SourceDefinition):
+        self.source = source
+        self._tables: list[dict] | None = None
+
+    def _parsed(self) -> list[dict]:
+        if self._tables is None:
+            self._tables = parse_ddl(
+                self.source.config.get("ddl_text") or "",
+                str(self.source.config.get("dialect") or "") or None,
+            )
+        return self._tables
+
+    def test_connection(self) -> dict:
+        """没有「连接」可测，测的是能否解析出结构。"""
+        try:
+            tables = self._parsed()
+            total = sum(len(t["columns"]) for t in tables)
+            return {
+                "ok": True,
+                "message": f"parsed {len(tables)} table(s), {total} column(s)",
+                "engine": self.engine,
+            }
+        except Exception as exc:  # noqa: BLE001 —— 解析失败是预期结果
+            return {"ok": False, "error": str(exc), "engine": self.engine}
+
+    def catalog(self) -> dict:
+        return build_catalog(
+            source_id=self.source.source_id,
+            engine=self.engine,
+            datasets=[
+                {"name": t["name"], "schema": t["schema"], "type": "ddl"}
+                for t in self._parsed()
+            ],
+        )
+
+    def schema(self, dataset: str, schema_name: str | None = None) -> dict:
+        tables = self._parsed()
+        matches = [table for table in tables if table["name"] == dataset
+                   and (schema_name is None or table["schema"] == (schema_name or None))]
+        if not matches and schema_name is None:
+            # Try a qualified identifier only after the exact name: catalog
+            # entries may legitimately contain dots or spaces in their names.
+            from jiuwenswarm.common.ref_codec import table_identifier_parts
+
+            dialect = str(self.source.config.get("dialect") or "").strip()
+            if not dialect:
+                dialect = "tsql" if dataset.startswith("[") else "mysql" if dataset.startswith("`") else "postgres"
+            try:
+                parts = table_identifier_parts(dataset, dialect)
+            except ValueError as exc:
+                raise ConnectorError("invalid dataset name") from exc
+            dataset = parts[-1]
+            schema_name = parts[0] if len(parts) == 2 else None
+            matches = [table for table in tables if table["name"] == dataset
+                       and (schema_name is None or table["schema"] == schema_name)]
+        if len(matches) > 1:
+            raise ConnectorError(f"ambiguous table in ddl_text: {dataset}; specify schema_name")
+        if matches:
+            table = matches[0]
+            return build_schema(
+                source_id=self.source.source_id,
+                dataset=table["name"],
+                schema_name=table["schema"],
+                columns=table["columns"],
+            )
+        known = [f"{t['schema']}.{t['name']}" if t["schema"] else t["name"] for t in tables]
+        raise ConnectorError(f"table not found in ddl_text: {dataset}（已解析 {known}）")
+
+    def manifest(self) -> dict:
+        """全部结构一次性导出，供语义层 / 知识候选消费（MetadataOnly 能力）。"""
+        tables = self._parsed()
+        return {
+            "source_id": self.source.source_id,
+            "engine": self.engine,
+            "tables": [
+                {
+                    "name": t["name"],
+                    "schema": t["schema"],
+                    "columns": t["columns"],
+                    "primary_key": [c["name"] for c in t["columns"] if c["pk"]],
+                }
+                for t in tables
+            ],
+            "table_count": len(tables),
+            "column_count": sum(len(t["columns"]) for t in tables),
+        }
+
+    def close(self) -> None:
+        self._tables = None
+
+
+__all__ = ["SchemaOnlyConnector", "parse_ddl"]
