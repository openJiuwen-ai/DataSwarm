+def test_retry_hard_limit_stops_and_persists(flow, monkeypatch):
+    """同 kind+sql_hash 失败 3 次 → SystemExit 指路文案；manifest 先落盘。
+
+    实测背景：重试风暴 17 次同 SQL 重试（d5）——相同输入第 4 次不会有
+    不同结果，硬停强制换路径；账本不丢该次失败记录。
+    """
+    manifest = {"analysis_id": "aid-retry"}
+    saved = []
+    monkeypatch.setattr(flow._manifest_mod, "_save", lambda m: saved.append(m))
+    fail = {"ok": False, "error": "boom"}
+    for _ in range(2):  # 前两次：记失败不硬停
+        flow.record_execution(manifest, analysis_id="aid-retry", component_id="c1",
+                              sql="SELECT 1", result=dict(fail), kind="execute")
+    assert manifest["components"]["c1"]["status"] == "failed"
+    with pytest.raises(SystemExit, match=r"\[retry-limit\].*换路径"):
+        flow.record_execution(manifest, analysis_id="aid-retry", component_id="c1",
+                              sql="SELECT 1", result=dict(fail), kind="execute")
+    assert manifest["components"]["c1"]["status"] == "retries_exhausted"
+    assert saved, "SystemExit 前必须先落盘（账本不丢）"
+
