+def test_silent_real_tcp_peer_times_out_and_closes_transport(clients, monkeypatch):
+    ready = queue.Queue()
+    observed_eof = threading.Event()
+
+    async def serve():
+        stop = asyncio.Event()
+        writers = []
+
+        async def stalled(reader, writer):
+            writers.append(writer)
+            try:
+                while await reader.read(4096):
+                    pass
+                observed_eof.set()
+            finally:
+                writer.close()
+                await writer.wait_closed()
+
+        async with await asyncio.start_server(stalled, "127.0.0.1", 0) as server:
+            ready.put((asyncio.get_running_loop(), stop, server.sockets[0].getsockname()[1]))
+            await stop.wait()
+        for writer in writers:
+            writer.close()
+        await asyncio.gather(*(writer.wait_closed() for writer in writers), return_exceptions=True)
+
+    thread = threading.Thread(target=lambda: asyncio.run(serve()), daemon=True)
+    thread.start()
+    loop, stop, port = ready.get(timeout=10)
+    monkeypatch.setattr(_SftpFetcher, "_TIMEOUT_SECONDS", 0.2)
+    try:
+        with pytest.raises(paramiko.SSHException):
+            _SftpFetcher({"host": "127.0.0.1", "port": port})
+        assert clients[0].get_transport() is None
+        assert observed_eof.wait(3), "timed-out transport left its TCP connection open"
+    finally:
+        loop.call_soon_threadsafe(stop.set)
+        thread.join(timeout=10)
+        assert not thread.is_alive()
