+def test_flatten_keeps_arrays_whole_and_bounds_depth():
+    """数组不展开成下标、嵌套有深度上限——两者都会让列集随数据漂移。"""
+    from jiuwenswarm.channels.web.dataagent.connectors import sampled_connector as sc
+
+    flat = sc._flatten({
+        "a": {"b": {"c": {"d": {"e": 1}}}},
+        "tags": [1, 2, 3],
+        "top": 5,
+    })
+    assert "tags" in flat and not any(k.startswith("tags.") for k in flat), flat
+    assert flat["top"] == 5
+    # 超过 MAX_FLATTEN_DEPTH 的子树整体保留，不继续展开
+    deep = [k for k in flat if k.startswith("a.")]
+    assert deep, flat
+    assert max(k.count(".") for k in deep) <= sc.MAX_FLATTEN_DEPTH, deep
