@@ -0,0 +1,189 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Stable IDs, canonical fingerprints and snapshot diffs."""
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass, field
+from typing import Any
+
+from .model import ColumnMeta, MetadataSnapshot, TableMeta
+
+
+def _digest(value: str) -> str:
+    return hashlib.sha256(value.encode("utf-8")).hexdigest()
+
+
+def column_fingerprint(column: ColumnMeta) -> str:
+    """Return a structure-only fingerprint for one column."""
+    body = "|".join(
+        [
+            column.name,
+            column.data_type,
+            column.column_type,
+            str(column.nullable),
+            column.column_key,
+            str(column.is_indexed),
+            str(column.ordinal),
+            column.comment or "",
+            column.extra or "",
+        ]
+    )
+    return _digest(body)
+
+
+def table_fingerprint(table: TableMeta) -> str:
+    """Return a structure-only fingerprint for a table and ordered columns."""
+    columns = "|".join(
+        f"{column.name}:{column_fingerprint(column)}"
+        for column in sorted(table.columns, key=lambda item: item.ordinal)
+    )
+    body = "|".join(
+        [
+            table.name,
+            table.table_type,
+            table.engine,
+            table.comment or "",
+            table.view_definition or "",
+            table.partition_key or "",
+            table.partition_type or "",
+            columns,
+        ]
+    )
+    return _digest(body)
+
+
+def apply_fingerprints(snapshot: MetadataSnapshot) -> MetadataSnapshot:
+    """Populate column and table fingerprints in-place and return snapshot."""
+    for table in snapshot.tables:
+        for column in table.columns:
+            column.fingerprint = column_fingerprint(column)
+        table.fingerprint = table_fingerprint(table)
+    return snapshot
+
+
+@dataclass(frozen=True)
+class ChangeEvent:
+    object_id: str
+    object_kind: str
+    change_type: str
+    severity: str
+    old_fingerprint: str = ""
+    new_fingerprint: str = ""
+    details: dict[str, Any] = field(default_factory=dict)
+
+    @property
+    def event_key(self) -> str:
+        body = json.dumps(
+            {
+                "object_id": self.object_id,
+                "object_kind": self.object_kind,
+                "change_type": self.change_type,
+                "old": self.old_fingerprint,
+                "new": self.new_fingerprint,
+            },
+            sort_keys=True,
+            ensure_ascii=False,
+        )
+        return _digest(body)
+
+
+def _kind(object_id: str) -> str:
+    return object_id.split(":", 1)[0]
+
+
+def diff_snapshots(
+    previous: MetadataSnapshot | None,
+    current: MetadataSnapshot,
+) -> list[ChangeEvent]:
+    """Compare stable identities without treating sampled absence as deletion.
+
+    A sampled snapshot is the current observation, not a complete inventory.
+    Missing objects and inferred type changes remain visible in its scope for
+    review, but cannot produce destructive schema-change events downstream.
+    """
+    current_objects = current.object_map()
+    previous_objects = previous.object_map() if previous else {}
+    events: list[ChangeEvent] = []
+    sampled_schema = (
+        current.scope.get("engine") == "sampled"
+        or current.scope.get("population_scope") == "bounded_sample"
+        or current.scope.get("metadata_scope") == "sampled_schema"
+    )
+    observations: dict[str, Any] = {}
+    if sampled_schema:
+        observations = {
+            "base_snapshot_id": previous.snapshot_id if previous else None,
+            "metadata_scope": "sampled_schema",
+            "unconfirmed_removals": [],
+            "observed_type_changes": [],
+        }
+        # Replace on repeat calls, keeping this operation idempotent. The
+        # current snapshot still contains only objects actually observed.
+        current.scope["change_observations"] = observations
+
+    for object_id in sorted(current_objects.keys() - previous_objects.keys()):
+        kind = _kind(object_id)
+        events.append(
+            ChangeEvent(object_id, kind, "added", "low", new_fingerprint=_fingerprint(current_objects[object_id]))
+        )
+
+    for object_id in sorted(previous_objects.keys() - current_objects.keys()):
+        kind = _kind(object_id)
+        if sampled_schema:
+            observations["unconfirmed_removals"].append({
+                "object_id": object_id, "object_kind": kind,
+                "reason": "not_observed_in_sample",
+            })
+            continue
+        severity = "highest" if kind == "col" else "high" if kind in {"tbl", "view"} else "medium"
+        events.append(
+            ChangeEvent(object_id, kind, "removed", severity, old_fingerprint=_fingerprint(previous_objects[object_id]))
+        )
+
+    for object_id in sorted(current_objects.keys() & previous_objects.keys()):
+        old = previous_objects[object_id]
+        new = current_objects[object_id]
+        old_fp = _fingerprint(old)
+        new_fp = _fingerprint(new)
+        if old_fp == new_fp:
+            continue
+        details: dict[str, Any] = {}
+        if _kind(object_id) == "col":
+            type_changed = (
+                old.get("data_type") != new.get("data_type")
+                or old.get("column_type") != new.get("column_type")
+            )
+            change_type = "type_changed" if type_changed else "updated"
+            severity = "high" if type_changed else "medium"
+            details["type_changed"] = type_changed
+            if sampled_schema and type_changed:
+                observations["observed_type_changes"].append({
+                    "object_id": object_id,
+                    "old_data_type": old.get("data_type"), "new_data_type": new.get("data_type"),
+                    "old_column_type": old.get("column_type"), "new_column_type": new.get("column_type"),
+                    "reason": "type_inferred_from_sample",
+                })
+                change_type, severity = "updated", "low"
+                details = {"type_change_observed": True, "requires_confirmation": True,
+                           "metadata_scope": "sampled_schema"}
+        elif _kind(object_id) in {"tbl", "view"}:
+            change_type = "updated"
+            severity = "high" if old.get("table_type") != new.get("table_type") else "medium"
+        else:
+            change_type = "updated"
+            severity = "medium"
+        events.append(ChangeEvent(object_id, _kind(object_id), change_type, severity, old_fp, new_fp, details))
+    return events
+
+
+def _fingerprint(data: dict[str, Any]) -> str:
+    explicit = data.get("fingerprint")
+    if explicit:
+        return str(explicit)
+    sanitized = {
+        key: value
+        for key, value in data.items()
+        if key not in {"status", "observed_at", "top_k", "sample_values", "null_ratio", "distinct_count"}
+    }
+    return _digest(json.dumps(sanitized, sort_keys=True, ensure_ascii=False, default=str))
diff --git a/jiuwenswarm/channels/web/dataagent/semantic/graph.py b/jiuwenswarm/channels/web/dataagent/semantic/graph.py
new file mode 100644
index 000000000..ade950223
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/semantic/graph.py
@@ -0,0 +1,188 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Build the Semantica-neutral physical graph projection."""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from typing import Any
+
+from .fingerprint import ChangeEvent
+from .model import MetadataSnapshot
+
+
+@dataclass(frozen=True)
+class GraphNode:
+    id: str
+    type: str
+    properties: dict[str, Any] = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class GraphEdge:
+    source: str
+    target: str
+    type: str
+    properties: dict[str, Any] = field(default_factory=dict)
+
+
+@dataclass
+class GraphProjection:
+    nodes: list[GraphNode] = field(default_factory=list)
+    edges: list[GraphEdge] = field(default_factory=list)
+
+    def node_ids(self) -> set[str]:
+        return {node.id for node in self.nodes}
+
+
+def build_projection(snapshot: MetadataSnapshot) -> GraphProjection:
+    """Convert a canonical snapshot into stable Semantica graph objects."""
+    nodes: list[GraphNode] = []
+    edges: list[GraphEdge] = []
+    source = snapshot.source
+    nodes.append(
+        GraphNode(
+            source.node_id,
+            "DataSource",
+            {"sourceType": source.source_type, "connRef": source.conn_ref, "version": source.version},
+        )
+    )
+    for database in snapshot.databases:
+        nodes.append(GraphNode(database.node_id, "Database", _database_properties(database)))
+        edges.append(GraphEdge(source.node_id, database.node_id, "hasDatabase"))
+    for table in snapshot.tables:
+        table_properties = _table_properties(table)
+        node_type = "View" if table.table_type.upper() == "VIEW" else "Table"
+        nodes.append(GraphNode(table.node_id, node_type, table_properties))
+        edges.append(GraphEdge(table.database_id, table.node_id, "hasTable"))
+        for column in table.columns:
+            nodes.append(GraphNode(column.node_id, "Column", _column_properties(column)))
+            edges.append(GraphEdge(table.node_id, column.node_id, "hasColumn"))
+    for join in snapshot.joins:
+        nodes.append(GraphNode(join.node_id, "JoinPath", _join_properties(join)))
+        edges.append(GraphEdge(join.left_table_id, join.node_id, "joinLeft"))
+        edges.append(GraphEdge(join.node_id, join.right_table_id, "joinRight"))
+    for lineage in snapshot.lineages:
+        if lineage.source_column_id and lineage.target_column_id:
+            edges.append(
+                GraphEdge(
+                    lineage.source_column_id,
+                    lineage.target_column_id,
+                    "lineageTo",
+                    {"transformation": lineage.transformation, "completeness": lineage.completeness},
+                )
+            )
+        edges.append(GraphEdge(lineage.view_id, lineage.source_table_id, "derivedFrom"))
+    return GraphProjection(nodes, edges)
+
+
+def add_deprecated_tombstones(
+    projection: GraphProjection,
+    previous: MetadataSnapshot | None,
+    events: list[ChangeEvent],
+) -> GraphProjection:
+    """Keep removed physical objects visible but unusable in merge-only graph stores."""
+    if not previous:
+        return projection
+    previous_objects = previous.object_map()
+    existing = projection.node_ids()
+    type_map = {"ds": "DataSource", "db": "Database", "tbl": "Table", "view": "View", "col": "Column", "jp": "JoinPath"}
+    for event in events:
+        if event.change_type != "removed" or event.object_id in existing:
+            continue
+        old = previous_objects.get(event.object_id, {})
+        prefix = event.object_id.split(":", 1)[0]
+        properties = {
+            "status": "deprecated",
+            "fingerprint": old.get("fingerprint") or event.old_fingerprint,
+            "fqn": _old_fqn(prefix, old),
+            "name": old.get("name", ""),
+        }
+        projection.nodes.append(GraphNode(event.object_id, type_map.get(prefix, "PhysicalObject"), properties))
+    return projection
+
+
+def _old_fqn(prefix: str, old: dict[str, Any]) -> str:
+    if prefix == "col":
+        return ".".join(str(old.get(key) or "") for key in ("database", "table", "name")).strip(".")
+    if prefix in {"tbl", "view"}:
+        return ".".join(str(old.get(key) or "") for key in ("database", "name")).strip(".")
+    return str(old.get("name") or "")
+
+
+def _database_properties(database) -> dict[str, Any]:
+    return {"name": database.name, "charset": database.charset, "collation": database.collation}
+
+
+def _table_properties(table) -> dict[str, Any]:
+    return {
+        "fqn": table.fqn,
+        "name": table.name,
+        "dbName": table.database,
+        "tableType": table.table_type,
+        "engine": table.engine,
+        "comment": table.comment,
+        "definition": table.view_definition if table.table_type.upper() == "VIEW" else "",
+        "rowCount": table.row_count,
+        "rowCountEstimated": table.row_count_estimated,
+        "tableRole": table.table_role,
+        "roleConfidence": table.role_confidence,
+        "roleEvidence": table.role_evidence,
+        "partitionKey": table.partition_key,
+        "partitionType": table.partition_type,
+        "partitionCount": table.partition_count,
+        "status": table.status,
+        "fingerprint": table.fingerprint,
+    }
+
+
+def _column_properties(column) -> dict[str, Any]:
+    properties = {
+        "fqn": column.fqn,
+        "name": column.name,
+        "dataType": column.data_type,
+        "columnType": column.column_type,
+        "ordinal": column.ordinal,
+        "nullable": column.nullable,
+        "columnKey": column.column_key,
+        "isIndexed": column.is_indexed,
+        "comment": column.comment,
+        "nullRatio": column.null_ratio,
+        "distinctCount": column.distinct_count,
+        "colRole": _column_role(column),
+        "isSensitive": column.is_sensitive,
+        "sensitivityClass": column.sensitivity_class,
+        "status": column.status,
+        "fingerprint": column.fingerprint,
+    }
+    return properties
+
+
+def _column_role(column) -> str:
+    if column.is_sensitive:
+        return "sensitive"
+    if column.column_key in {"PRI", "UNI"}:
+        return "key"
+    if column.column_key == "MUL":
+        return "foreign_key"
+    lowered = column.name.lower()
+    if any(token in lowered for token in ("time", "date", "day", "month", "year")):
+        return "time"
+    if any(token in column.data_type.lower() for token in ("int", "decimal", "numeric", "double", "float")):
+        return "measure"
+    return "dimension"
+
+
+def _join_properties(join) -> dict[str, Any]:
+    return {
+        "leftColumn": join.left_column_id,
+        "rightColumn": join.right_column_id,
+        "cardinality": join.cardinality,
+        "confidence": join.confidence,
+        "source": join.source,
+        "overlapRatio": join.overlap_ratio,
+        # Neo4j 属性只接受原始类型/其数组——evidence 是 dict，序列化为 JSON 字符串
+        "evidence": json.dumps(join.evidence, ensure_ascii=False, default=str),
+        "level": join.level,
+        "status": join.status,
+        "usableForGeneration": join.status == "verified" and join.confidence >= 0.7,
+    }
diff --git a/jiuwenswarm/channels/web/dataagent/semantic/impact.py b/jiuwenswarm/channels/web/dataagent/semantic/impact.py
new file mode 100644
index 000000000..2e01fcf33
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/semantic/impact.py
@@ -0,0 +1,106 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Propagate dangerous physical changes to explicitly bound metrics."""
+from __future__ import annotations
+
+import hashlib
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+from jiuwenswarm.channels.web.dataagent.metrics.model import BINDING_FAILED
+from jiuwenswarm.channels.web.orchestration.db import _connect, _exec, _fetch_dicts, _fetch_one_dict
+from jiuwenswarm.common import workspace_context
+
+from .fingerprint import ChangeEvent
+
+
+def propagate(source_id: str, events: list[ChangeEvent], datasource_ref: str = "") -> list[dict]:
+    """Downgrade bindings only when an explicit table/column binding matches."""
+    results: list[dict] = []
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    for event in events:
+        parsed = _parse_physical_id(event.object_id)
+        if event.change_type not in {"removed", "type_changed"} or not parsed:
+            continue
+        for definition in metric_store.list_defs(workspace_id):
+            if not definition.current_revision_id:
+                continue
+            for binding in metric_store.list_bindings(definition.current_revision_id):
+                if datasource_ref and binding.datasource_ref and binding.datasource_ref != datasource_ref:
+                    continue
+                if binding.source_table not in {parsed["table"], parsed["fqn"]}:
+                    continue
+                if parsed.get("column") and parsed["column"] not in binding.columns:
+                    continue
+                if parsed.get("column"):
+                    subject = f"列 {parsed['column']}"
+                else:
+                    label = "视图" if event.object_kind == "view" else "表"
+                    subject = f"{label} {parsed['fqn']}"
+                action = "已删除" if event.change_type == "removed" else f"发生 {event.change_type}"
+                reason = f"{subject} {action}"
+                metric_store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED, verify_detail=reason)
+                alert = _save_alert(source_id, event, definition.metric_id, reason)
+                results.append(alert)
+    return results
+
+
+def _parse_physical_id(object_id: str) -> dict[str, str] | None:
+    prefix, _, suffix = object_id.partition(":")
+    if prefix not in {"tbl", "view", "col"}:
+        return None
+    parts = suffix.split(":", 2)
+    if len(parts) != 3:
+        return None
+    location = parts[2].split(".")
+    if prefix == "col" and len(location) >= 3:
+        database, table, column = location[0], location[1], ".".join(location[2:])
+        return {"database": database, "table": table, "column": column, "fqn": f"{database}.{table}"}
+    if len(location) >= 2:
+        database, table = location[0], ".".join(location[1:])
+        return {"database": database, "table": table, "fqn": f"{database}.{table}"}
+    return None
+
+
+def _save_alert(source_id: str, event: ChangeEvent, metric_id: str, reason: str) -> dict:
+    raw = f"{event.event_key}|{metric_id}|{reason}"
+    alert_id = "semantic-alert:" + hashlib.sha256(raw.encode("utf-8")).hexdigest()[:24]
+    message = f"物理对象 {event.object_id} 发生 {event.change_type}，指标 {metric_id} 绑定校验失败：{reason}"
+    conn = _connect()
+    try:
+        existing = _fetch_one_dict(conn, "SELECT * FROM dw_semantic_alerts WHERE alert_id=?", (alert_id,))
+        if not existing:
+            _exec(
+                conn,
+                "INSERT INTO dw_semantic_alerts "
+                "(alert_id,event_id,source_id,metric_id,severity,message,status,created_at) VALUES (?,?,?,?,?,?,?,?)",
+                (alert_id, event.event_key, source_id, metric_id, event.severity, message, "open",
+                 timeutil.now_iso()),
+            )
+            conn.commit()
+            existing = _fetch_one_dict(conn, "SELECT * FROM dw_semantic_alerts WHERE alert_id=?", (alert_id,))
+        return existing or {"alert_id": alert_id, "metric_id": metric_id, "status": "open"}
+    finally:
+        conn.close()
+
+
+def list_alerts(source_id: str | None = None, status: str | None = None, limit: int = 100) -> list[dict]:
+    """List semantic impact alerts."""
+    conditions: list[str] = []
+    params: list[object] = []
+    if source_id:
+        conditions.append("source_id=?")
+        params.append(source_id)
+    if status:
+        conditions.append("status=?")
+        params.append(status)
+    sql = "SELECT * FROM dw_semantic_alerts"
+    if conditions:
+        sql += " WHERE " + " AND ".join(conditions)
+    sql += " ORDER BY created_at DESC LIMIT ?"
+    params.append(max(1, min(limit, 500)))
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, sql, tuple(params))
+    finally:
+        conn.close()
diff --git a/jiuwenswarm/channels/web/dataagent/semantic/model.py b/jiuwenswarm/channels/web/dataagent/semantic/model.py
new file mode 100644
index 000000000..bcd4f1af3
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/semantic/model.py
@@ -0,0 +1,223 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Canonical physical metadata models used by the P0 semantic pipeline."""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from typing import Any
+
+
+@dataclass
+class ColumnMeta:
+    source_id: str
+    source_type: str
+    database: str
+    table: str
+    name: str
+    data_type: str = ""
+    column_type: str = ""
+    ordinal: int = 0
+    nullable: bool = True
+    column_key: str = ""
+    is_indexed: bool = False
+    default_value: Any = None
+    extra: str = ""
+    comment: str = ""
+    null_ratio: float | None = None
+    distinct_count: int | None = None
+    top_k: list[dict[str, Any]] = field(default_factory=list)
+    is_sensitive: bool = False
+    sensitivity_class: str = ""
+    status: str = "active"
+    fingerprint: str = ""
+
+    @property
+    def node_id(self) -> str:
+        return f"col:{self.source_type}:{self.source_id}:{self.database}.{self.table}.{self.name}"
+
+    @property
+    def table_id(self) -> str:
+        return f"tbl:{self.source_type}:{self.source_id}:{self.database}.{self.table}"
+
+    @property
+    def fqn(self) -> str:
+        return f"{self.database}.{self.table}.{self.name}"
+
+
+@dataclass
+class TableMeta:
+    source_id: str
+    source_type: str
+    database: str
+    name: str
+    table_type: str = "BASE TABLE"
+    engine: str = ""
+    comment: str = ""
+    row_count: int | None = None
+    row_count_estimated: bool = True
+    data_length: int | None = None
+    index_length: int | None = None
+    create_time: str | None = None
+    update_time: str | None = None
+    view_definition: str = ""
+    table_role: str = "unknown"
+    role_confidence: float = 0.0
+    role_evidence: list[str] = field(default_factory=list)
+    partition_key: str = ""
+    partition_type: str = ""
+    partition_count: int = 0
+    status: str = "active"
+    fingerprint: str = ""
+    columns: list[ColumnMeta] = field(default_factory=list)
+
+    @property
+    def node_id(self) -> str:
+        prefix = "view" if self.table_type.upper() == "VIEW" else "tbl"
+        return f"{prefix}:{self.source_type}:{self.source_id}:{self.database}.{self.name}"
+
+    @property
+    def database_id(self) -> str:
+        return f"db:{self.source_type}:{self.source_id}:{self.database}"
+
+    @property
+    def fqn(self) -> str:
+        return f"{self.database}.{self.name}"
+
+
+@dataclass
+class DatabaseMeta:
+    source_id: str
+    source_type: str
+    name: str
+    charset: str = ""
+    collation: str = ""
+
+    @property
+    def node_id(self) -> str:
+        return f"db:{self.source_type}:{self.source_id}:{self.name}"
+
+
+@dataclass
+class DataSourceMeta:
+    source_id: str
+    source_type: str
+    conn_ref: str
+    version: str = "1"
+
+    @property
+    def node_id(self) -> str:
+        return f"ds:{self.source_type}:{self.source_id}"
+
+
+@dataclass
+class JoinPathMeta:
+    source_id: str
+    source_type: str
+    left_column_id: str
+    right_column_id: str
+    left_table_id: str
+    right_table_id: str
+    cardinality: str = "unknown"
+    confidence: float = 0.0
+    source: list[str] = field(default_factory=list)
+    overlap_ratio: float | None = None
+    evidence: dict[str, Any] = field(default_factory=dict)
+    status: str = "candidate"
+
+    @property
+    def node_id(self) -> str:
+        import hashlib
+
+        raw = f"{self.left_column_id}|{self.right_column_id}"
+        digest = hashlib.md5(raw.encode("utf-8"), usedforsecurity=False).hexdigest()[:16]
+        return f"jp:{digest}"
+
+    @property
+    def level(self) -> str:
+        """证据等级：declared（外键/视图/人工确认）> lineage（ETL 血缘）> inferred（命名推断）。
+
+        优先读 ``evidence["level"]``（采集侧已标注）；缺失时从 source 列表
+        兜底推导（存量快照兼容）。
+        """
+        level = str(self.evidence.get("level") or "").strip()
+        if level:
+            return level
+        sources = {str(item) for item in self.source}
+        if sources & {"foreign_key", "view_definition", "manual_confirm"}:
+            return "declared"
+        if "table_lineage" in sources:
+            return "lineage"
+        if "naming_convention" in sources:
+            return "inferred"
+        return "unknown"
+
+
+@dataclass
+class ViewLineage:
+    source_id: str
+    source_type: str
+    view_id: str
+    source_table_id: str
+    source_column_id: str | None = None
+    target_column_id: str | None = None
+    transformation: str = ""
+    completeness: str = "complete"
+
+
+@dataclass
+class MetadataSnapshot:
+    snapshot_id: str
+    run_id: str
+    source: DataSourceMeta
+    databases: list[DatabaseMeta] = field(default_factory=list)
+    tables: list[TableMeta] = field(default_factory=list)
+    joins: list[JoinPathMeta] = field(default_factory=list)
+    lineages: list[ViewLineage] = field(default_factory=list)
+    collector_version: str = "physical-collector-v1"
+    rule_version: str = "semantic-rules-v1"
+    scope: dict[str, Any] = field(default_factory=dict)
+    status: str = "collected"
+    errors: list[dict[str, Any]] = field(default_factory=list)
+
+    def object_map(self) -> dict[str, dict[str, Any]]:
+        objects: dict[str, dict[str, Any]] = {self.source.node_id: asdict(self.source)}
+        for database in self.databases:
+            objects[database.node_id] = asdict(database)
+        for table in self.tables:
+            table_data = asdict(table)
+            table_data.pop("columns", None)
+            objects[table.node_id] = table_data
+            for column in table.columns:
+                objects[column.node_id] = asdict(column)
+        for join in self.joins:
+            objects[join.node_id] = asdict(join)
+        return objects
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+    @classmethod
+    def from_dict(cls, data: dict[str, Any]) -> "MetadataSnapshot":
+        source = DataSourceMeta(**data["source"])
+        databases = [DatabaseMeta(**item) for item in data.get("databases", [])]
+        tables: list[TableMeta] = []
+        for item in data.get("tables", []):
+            table = dict(item)
+            columns = [ColumnMeta(**column) for column in table.pop("columns", [])]
+            table["columns"] = columns
+            tables.append(TableMeta(**table))
+        joins = [JoinPathMeta(**item) for item in data.get("joins", [])]
+        lineages = [ViewLineage(**item) for item in data.get("lineages", [])]
+        return cls(
+            snapshot_id=data["snapshot_id"],
+            run_id=data["run_id"],
+            source=source,
+            databases=databases,
+            tables=tables,
+            joins=joins,
+            lineages=lineages,
+            collector_version=data.get("collector_version", "physical-collector-v1"),
+            rule_version=data.get("rule_version", "semantic-rules-v1"),
+            scope=data.get("scope", {}),
+            status=data.get("status", "collected"),
+            errors=data.get("errors", []),
+        )
diff --git a/jiuwenswarm/channels/web/dataagent/semantic/repository.py b/jiuwenswarm/channels/web/dataagent/semantic/repository.py
new file mode 100644
index 000000000..43d6f60ad
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/semantic/repository.py
@@ -0,0 +1,687 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Persistence for semantic runs, snapshots and change events."""
+from __future__ import annotations
+
+import hashlib
+import json
+import unicodedata
+from datetime import datetime
+from typing import Any
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.channels.web.orchestration.db import _connect, _exec, _fetch_dicts, _fetch_one_dict
+from jiuwenswarm.common import workspace_context
+
+from .fingerprint import ChangeEvent
+from .model import JoinPathMeta, MetadataSnapshot
+
+
+def _now() -> str:
+    return timeutil.now_iso()
+
+
+def _ensure() -> str:
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+    meta_ref = workspace_context.current_workspace().metadata_db_ref
+    ensure_system_schema(meta_ref)
+    return meta_ref
+
+
+def create_run(run_id: str, source_id: str, trigger_type: str, scope: dict[str, Any]) -> dict:
+    _ensure()
+    now = _now()
+    conn = _connect()
+    try:
+        _exec(
+            conn,
+            "INSERT INTO dw_semantic_runs "
+            "(run_id,source_id,trigger_type,status,scope_json,started_at,created_at) VALUES (?,?,?,?,?,?,?)",
+            (run_id, source_id, trigger_type, "queued", json.dumps(scope, ensure_ascii=False), now, now),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+    return get_run(run_id) or {}
+
+
+def update_run(run_id: str, **fields: Any) -> dict:
+    allowed = {
+        "status",
+        "base_snapshot_id",
+        "current_snapshot_id",
+        "semantica_stage_id",
+        "semantica_version",
+        "finished_at",
+        "error_json",
+    }
+    values = [(key, value) for key, value in fields.items() if key in allowed]
+    if not values:
+        return get_run(run_id) or {}
+    conn = _connect()
+    try:
+        _exec(
+            conn,
+            f"UPDATE dw_semantic_runs SET {', '.join(key + '=?' for key, _ in values)} WHERE run_id=?",
+            tuple(value for _, value in values) + (run_id,),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+    return get_run(run_id) or {}
+
+
+def get_run(run_id: str) -> dict | None:
+    _ensure()
+    conn = _connect()
+    try:
+        return _fetch_one_dict(conn, "SELECT * FROM dw_semantic_runs WHERE run_id=?", (run_id,))
+    finally:
+        conn.close()
+
+
+def list_runs(source_id: str | None = None, limit: int = 50) -> list[dict]:
+    _ensure()
+    conn = _connect()
+    try:
+        if source_id:
+            return _fetch_dicts(
+                conn,
+                "SELECT * FROM dw_semantic_runs WHERE source_id=? ORDER BY created_at DESC LIMIT ?",
+                (source_id, max(1, min(limit, 200))),
+            )
+        return _fetch_dicts(
+            conn,
+            "SELECT * FROM dw_semantic_runs ORDER BY created_at DESC LIMIT ?",
+            (max(1, min(limit, 200)),),
+        )
+    finally:
+        conn.close()
+
+
+def save_snapshot(snapshot: MetadataSnapshot, status: str, semantica_version: str = "") -> None:
+    _ensure()
+    payload = json.dumps(snapshot.to_dict(), ensure_ascii=False, default=str)
+    object_count = len(snapshot.object_map())
+    relation_count = len(snapshot.joins) + len(snapshot.lineages)
+    # Successive local collections can publish within one second. Keep their
+    # publication order distinguishable before old dictionary rows are purged.
+    published_at = datetime.now().isoformat(timespec="microseconds") if status == "published" else None
+    conn = _connect()
+    try:
+        existing = _fetch_one_dict(
+            conn,
+            "SELECT snapshot_id FROM dw_semantic_snapshots WHERE snapshot_id=?",
+            (snapshot.snapshot_id,),
+        )
+        if existing:
+            _exec(
+                conn,
+                "UPDATE dw_semantic_snapshots SET status=?,snapshot_json=?,object_count=?,relation_count=?,"
+                "semantica_version=?,published_at=? WHERE snapshot_id=?",
+                (
+                    status,
+                    payload,
+                    object_count,
+                    relation_count,
+                    semantica_version,
+                    published_at,
+                    snapshot.snapshot_id,
+                ),
+            )
+        else:
+            _exec(
+                conn,
+                "INSERT INTO dw_semantic_snapshots "
+                "(snapshot_id,run_id,source_id,status,scope_json,snapshot_json,object_count,relation_count,"
+                "semantica_version,published_at,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+                (
+                    snapshot.snapshot_id,
+                    snapshot.run_id,
+                    snapshot.source.source_id,
+                    status,
+                    json.dumps(snapshot.scope, ensure_ascii=False),
+                    payload,
+                    object_count,
+                    relation_count,
+                    semantica_version,
+                    published_at,
+                    _now(),
+                ),
+            )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def latest_published_snapshot(source_id: str) -> MetadataSnapshot | None:
+    _ensure()
+    conn = _connect()
+    try:
+        row = _fetch_one_dict(
+            conn,
+            "SELECT snapshot_json FROM dw_semantic_snapshots WHERE source_id=? AND status='published' "
+            "ORDER BY published_at DESC,created_at DESC,snapshot_id DESC LIMIT 1",
+            (source_id,),
+        )
+    finally:
+        conn.close()
+    if not row or not row.get("snapshot_json"):
+        return None
+    snapshot = MetadataSnapshot.from_dict(json.loads(row["snapshot_json"]))
+    _apply_join_status_overlay(source_id, snapshot)
+    return snapshot
+
+
+def _apply_join_status_overlay(source_id: str, snapshot: MetadataSnapshot) -> None:
+    """join 人工确认覆盖合并（快照不可变 → 覆盖层在读取时套用）。
+
+    - ``verified``：join 升声明级（status=verified、evidence.level=declared、
+      source 补 ``manual_confirm``）——等价外键声明的可信度；
+    - ``rejected``：从快照 joins 中剔除（下游再也看不到这条边）。
+
+    Args:
+        source_id: 数据源 ID。
+        snapshot: 就地修改的快照。
+    """
+    try:
+        statuses = list_join_status(source_id=source_id)
+    except Exception:  # noqa: BLE001 —— 覆盖层读失败按无确认处理，不阻断快照读取
+        return
+    if not statuses:
+        return
+    by_node = {str(row.get("join_node_id") or ""): row for row in statuses}
+    kept: list[JoinPathMeta] = []
+    for join in snapshot.joins:
+        row = by_node.get(join.node_id)
+        if row is None:
+            kept.append(join)
+            continue
+        if str(row.get("status")) == JOIN_STATUS_REJECTED:
+            continue
+        join.status = "verified"
+        join.evidence = {**join.evidence, "level": "declared"}
+        if "manual_confirm" not in join.source:
+            join.source = [*join.source, "manual_confirm"]
+        join.confidence = max(join.confidence, 1.0)
+        kept.append(join)
+    snapshot.joins = kept
+
+
+def search_latest_objects(
+    source_id: str,
+    query: str = "",
+    kind: str = "",
+    schema: str = "",
+    role: str = "",
+    status: str = "active",
+    limit: int = 100,
+) -> list[dict[str, Any]]:
+    """Search the latest published snapshot without traversing all graph nodes."""
+    snapshot = latest_published_snapshot(source_id)
+    if not snapshot:
+        return []
+    needle = query.strip().lower()
+    kind = kind.strip().lower()
+    rows: list[dict[str, Any]] = []
+    for object_id, data in snapshot.object_map().items():
+        object_kind = object_id.split(":", 1)[0]
+        if kind and object_kind != kind:
+            continue
+        if schema and str(data.get("database") or data.get("name") or "") != schema:
+            continue
+        if role and str(data.get("table_role") or "") != role:
+            continue
+        if status and str(data.get("status") or "active") != status:
+            continue
+        haystack = " ".join(
+            str(data.get(key) or "") for key in ("name", "database", "table", "comment", "data_type")
+        ).lower()
+        if needle and needle not in haystack:
+            continue
+        row = dict(data)
+        row["id"] = object_id
+        row["kind"] = object_kind
+        row.pop("top_k", None)
+        row.pop("default_value", None)
+        rows.append(row)
+        if len(rows) >= max(1, min(limit, 500)):
+            break
+    return rows
+
+
+def save_change_events(run_id: str, source_id: str, events: list[ChangeEvent]) -> None:
+    if not events:
+        return
+    _ensure()
+    conn = _connect()
+    try:
+        for event in events:
+            existing = _fetch_one_dict(
+                conn,
+                "SELECT event_id FROM dw_semantic_change_events WHERE event_id=?",
+                (event.event_key,),
+            )
+            if existing:
+                continue
+            _exec(
+                conn,
+                "INSERT INTO dw_semantic_change_events "
+                "(event_id,run_id,source_id,object_id,object_kind,change_type,severity,old_fingerprint,"
+                "new_fingerprint,impact_json,status,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
+                (
+                    event.event_key,
+                    run_id,
+                    source_id,
+                    event.object_id,
+                    event.object_kind,
+                    event.change_type,
+                    event.severity,
+                    event.old_fingerprint,
+                    event.new_fingerprint,
+                    json.dumps(event.details, ensure_ascii=False),
+                    "open",
+                    _now(),
+                ),
+            )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def save_profiles(snapshot: MetadataSnapshot) -> None:
+    """Persist profile detail outside Semantica; sensitive values are never stored."""
+    _ensure()
+    conn = _connect()
+    try:
+        for table in snapshot.tables:
+            for column in table.columns:
+                top_k = [] if column.is_sensitive else column.top_k
+                values = (
+                    snapshot.source.source_id,
+                    column.table_id,
+                    column.null_ratio,
+                    column.distinct_count,
+                    json.dumps(top_k, ensure_ascii=False, default=str),
+                    int(column.is_sensitive),
+                    column.sensitivity_class,
+                    snapshot.collector_version,
+                    _now(),
+                    column.node_id,
+                )
+                existing = _fetch_one_dict(
+                    conn,
+                    "SELECT column_id FROM dw_semantic_profile WHERE column_id=?",
+                    (column.node_id,),
+                )
+                if existing:
+                    _exec(
+                        conn,
+                        "UPDATE dw_semantic_profile SET source_id=?,table_id=?,null_ratio=?,distinct_count=?,"
+                        "top_k_json=?,is_sensitive=?,sensitivity_class=?,profile_version=?,observed_at=? "
+                        "WHERE column_id=?",
+                        values,
+                    )
+                else:
+                    _exec(
+                        conn,
+                        "INSERT INTO dw_semantic_profile "
+                        "(source_id,table_id,null_ratio,distinct_count,top_k_json,is_sensitive,sensitivity_class,"
+                        "profile_version,observed_at,column_id) VALUES (?,?,?,?,?,?,?,?,?,?)",
+                        values,
+                    )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def list_change_events(source_id: str | None = None, status: str | None = None, limit: int = 100) -> list[dict]:
+    _ensure()
+    conds: list[str] = []
+    params: list[Any] = []
+    if source_id:
+        conds.append("source_id=?")
+        params.append(source_id)
+    if status:
+        conds.append("status=?")
+        params.append(status)
+    sql = "SELECT * FROM dw_semantic_change_events"
+    if conds:
+        sql += " WHERE " + " AND ".join(conds)
+    sql += " ORDER BY created_at DESC LIMIT ?"
+    params.append(max(1, min(limit, 500)))
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, sql, tuple(params))
+    finally:
+        conn.close()
+
+
+# ==========================================================================
+# 维值字典（dw_semantic_value_dict，快照版本化；L1 第四路召回的读侧）
+# ==========================================================================
+
+# 单批落库行数上限：超限说明阈值配置失当，宁可截断并让调用方告警
+VALUE_DICT_ROW_HARD_CAP = 200_000
+
+
+def _latest_value_snapshot_join(source_count: int) -> str:
+    """Join each requested source's current generation within the read statement.
+
+    Dictionary rows exist before publication, so purge is not a visibility
+    boundary. Rank published snapshots before joining values: a new generation
+    with no values must not fall back to an older dictionary. The derived table
+    avoids correlated scalar ORDER BY/LIMIT, which Doris does not support.
+    """
+    source_placeholders = ",".join("?" for _ in range(source_count))
+    return (
+        "JOIN (SELECT s.source_id,s.snapshot_id,ROW_NUMBER() OVER ("
+        "PARTITION BY s.source_id ORDER BY s.published_at DESC,s.created_at DESC,s.snapshot_id DESC"
+        ") AS snapshot_rank FROM dw_semantic_snapshots AS s "
+        f"WHERE s.status='published' AND s.source_id IN ({source_placeholders})) AS published "
+        "ON published.source_id=v.source_id AND published.snapshot_id=v.snapshot_id "
+        "AND published.snapshot_rank=1 "
+    )
+
+
+def save_value_dict(source_id: str, snapshot_id: str, rows: list[dict[str, Any]]) -> int:
+    """批量写入维值字典行（同一快照重跑先清后插，方言无关幂等）。
+
+    ``value_id`` 由 ``(snapshot_id, column_id, value_text)`` 确定性生成（md5
+    截断）——保留大小写/全半角不同的原文，归一化值仅用于召回。同列同原文
+    在单批内去重，在不同快照各自成行；跨快照行靠 :func:`purge_value_dict` 清理。
+
+    Args:
+        source_id: 数据源 ID。
+        snapshot_id: 所属快照 ID。
+        rows: ``[{column_id, table_id, value_text, value_norm}]``。
+
+    Returns:
+        去重后实际写入行数（含触顶截断）。
+    """
+    if not rows:
+        return 0
+    _ensure()
+    conn = _connect()
+    seen: set[tuple[str, str]] = set()
+    written = 0
+    try:
+        _exec(conn, "DELETE FROM dw_semantic_value_dict WHERE snapshot_id=?", (snapshot_id,))
+        for row in rows:
+            column_id, value_text = str(row["column_id"]), str(row["value_text"])
+            identity = (column_id, value_text)
+            if identity in seen:
+                continue
+            if written >= VALUE_DICT_ROW_HARD_CAP:
+                break
+            seen.add(identity)
+            # Structured encoding keeps separators inside column names or data
+            # from aliasing a different identity. Do not normalize value_text.
+            value_id = hashlib.md5(
+                json.dumps([snapshot_id, column_id, value_text], ensure_ascii=False,
+                           separators=(",", ":")).encode("utf-8"),
+                usedforsecurity=False,
+            ).hexdigest()[:32]
+            _exec(
+                conn,
+                "INSERT INTO dw_semantic_value_dict "
+                "(value_id,source_id,snapshot_id,column_id,table_id,value_text,value_norm) "
+                "VALUES (?,?,?,?,?,?,?)",
+                (
+                    value_id,
+                    source_id,
+                    snapshot_id,
+                    column_id,
+                    row["table_id"],
+                    value_text,
+                    row["value_norm"],
+                ),
+            )
+            written += 1
+        conn.commit()
+    finally:
+        conn.close()
+    return written
+
+
+def purge_value_dict(source_id: str, keep_snapshot_ids: list[str]) -> int:
+    """删除该源中不在保留清单内的字典行（发布成功后清理旧快照）。
+
+    Args:
+        source_id: 数据源 ID。
+        keep_snapshot_ids: 保留的快照 ID 列表（通常只留最新 published）。
+
+    Returns:
+        删除行数对应的快照数（快照粒度计数）。
+    """
+    _ensure()
+    keep = set(keep_snapshot_ids)
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(
+            conn,
+            "SELECT DISTINCT snapshot_id FROM dw_semantic_value_dict WHERE source_id=?",
+            (source_id,),
+        )
+        removed = 0
+        for row in rows:
+            snapshot_id = str(row.get("snapshot_id") or "")
+            if snapshot_id and snapshot_id not in keep:
+                _exec(
+                    conn,
+                    "DELETE FROM dw_semantic_value_dict WHERE source_id=? AND snapshot_id=?",
+                    (source_id, snapshot_id),
+                )
+                removed += 1
+        if removed:
+            conn.commit()
+    finally:
+        conn.close()
+    return removed
+
+
+def _escape_like(value: str) -> str:
+    """转义 LIKE 通配符（``%``/``_``/``!``），配合 ESCAPE '!' 使用。"""
+    return value.replace("!", "!!").replace("%", "!%").replace("_", "!_")
+
+
+def _norm_text(value: str) -> str:
+    """NFKC + lower 归一化（与写入侧 value_norm 同一刻度）。"""
+    return unicodedata.normalize("NFKC", value).strip().lower()
+
+
+def recall_value_dict(source_id: str, query: str, limit: int = 5) -> list[dict]:
+    """维值词法召回：归一化全等优先，子串 LIKE 兜底（同刻度分档）。
+
+    Args:
+        source_id: 数据源 ID（限定最新 published 快照的字典行）。
+        query: 查询词（自动 NFKC+lower 归一化）。
+        limit: 返回上限（1-20）。
+
+    Returns:
+        ``[{value_id, column_id, table_id, value_text, match_type, snapshot_id}]``，
+        按 ``exact > substring`` 分档排序。
+    """
+    needle = _norm_text(query)
+    if not needle:
+        return []
+    _ensure()
+    conn = _connect()
+    try:
+        exact = _fetch_dicts(
+            conn,
+            "SELECT v.* FROM dw_semantic_value_dict AS v "
+            f"{_latest_value_snapshot_join(1)}"
+            "WHERE v.source_id=? AND v.value_norm=? ORDER BY v.column_id LIMIT ?",
+            (source_id, source_id, needle, max(1, min(limit, 20))),
+        )
+        pattern = "%" + _escape_like(needle) + "%"
+        like = _fetch_dicts(
+            conn,
+            "SELECT v.* FROM dw_semantic_value_dict AS v "
+            f"{_latest_value_snapshot_join(1)}"
+            "WHERE v.source_id=? AND v.value_norm LIKE ? ESCAPE '!' "
+            "AND v.value_norm<>? ORDER BY v.column_id LIMIT ?",
+            (source_id, source_id, pattern, needle, max(1, min(limit, 20))),
+        )
+    finally:
+        conn.close()
+    rows: list[dict] = []
+    seen: set[str] = set()
+    for match_type, batch in (("exact", exact), ("substring", like)):
+        for row in batch:
+            value_id = str(row.get("value_id") or "")
+            if value_id in seen:
+                continue
+            seen.add(value_id)
+            rows.append({
+                "value_id": value_id,
+                "column_id": str(row.get("column_id") or ""),
+                "table_id": str(row.get("table_id") or ""),
+                "value_text": str(row.get("value_text") or ""),
+                "snapshot_id": str(row.get("snapshot_id") or ""),
+                "match_type": match_type,
+            })
+            if len(rows) >= max(1, min(limit, 20)):
+                return rows
+    return rows
+
+
+# ==========================================================================
+# join 人工确认（dw_semantic_join_status，快照不可变 → 覆盖层）
+# ==========================================================================
+
+JOIN_STATUS_VERIFIED = "verified"
+JOIN_STATUS_REJECTED = "rejected"
+
+
+def save_join_status(
+    join_node_id: str,
+    source_id: str,
+    status: str,
+    confirmed_by: str,
+    note: str = "",
+) -> dict:
+    """写入/更新一条 join 人工确认（幂等 upsert：先删后插）。
+
+    Args:
+        join_node_id: ``JoinPathMeta.node_id``（md5(left|right)）。
+        source_id: 数据源 ID。
+        status: ``verified`` | ``rejected``。
+        confirmed_by: 确认人标识。
+        note: 备注说明。
+
+    Returns:
+        落库后的行。
+    """
+    if status not in (JOIN_STATUS_VERIFIED, JOIN_STATUS_REJECTED):
+        raise ValueError(f"status 只允许 {JOIN_STATUS_VERIFIED}/{JOIN_STATUS_REJECTED}，收到 {status!r}")
+    _ensure()
+    now = _now()
+    conn = _connect()
+    try:
+        _exec(conn, "DELETE FROM dw_semantic_join_status WHERE join_node_id=?", (join_node_id,))
+        _exec(
+            conn,
+            "INSERT INTO dw_semantic_join_status "
+            "(join_node_id,source_id,status,note,confirmed_by,confirmed_at) VALUES (?,?,?,?,?,?)",
+            (join_node_id, source_id, status, note, confirmed_by, now),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+    return {
+        "join_node_id": join_node_id,
+        "source_id": source_id,
+        "status": status,
+        "note": note,
+        "confirmed_by": confirmed_by,
+        "confirmed_at": now,
+    }
+
+
+def list_value_dict_texts(source_id: str, limit: int = 800) -> list[tuple[str, str]]:
+    """该源字典值的向量文档（value_id, value_text）——L1 维值路向量通道的语料。
+
+    Args:
+        source_id: 数据源 ID（只读取最新 published 快照行，暂存/失败代不可见）。
+        limit: 参与向量的行数上限（对齐 metrics EMB_MAX_DOCS，超出截断）。
+
+    Returns:
+        ``[(value_id, value_text)]``；无字典返回空列表。
+    """
+    _ensure()
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(
+            conn,
+            "SELECT v.value_id, v.value_text FROM dw_semantic_value_dict AS v "
+            f"{_latest_value_snapshot_join(1)}"
+            "WHERE v.source_id=? ORDER BY v.column_id, v.value_text LIMIT ?",
+            (source_id, source_id, max(1, min(limit, 100000))),
+        )
+    finally:
+        conn.close()
+    return [(str(r.get("value_id") or ""), str(r.get("value_text") or "")) for r in rows]
+
+
+def get_value_dict_rows(source_ids: list[str], value_ids: list[str]) -> list[dict]:
+    """按 value_id 批量回查字典行（向量命中后补 column_id/table_id 归属）。
+
+    Args:
+        source_ids: 数据源 ID 列表（限定范围，各源只读取最新 published 代，防跨源串）。
+        value_ids: 向量命中的 value_id 列表。
+
+    Returns:
+        ``[{value_id, source_id, column_id, table_id, value_text, snapshot_id}]``。
+    """
+    if not source_ids or not value_ids:
+        return []
+    _ensure()
+    conn = _connect()
+    try:
+        placeholders_sources = ",".join("?" for _ in source_ids)
+        placeholders_values = ",".join("?" for _ in value_ids)
+        rows = _fetch_dicts(
+            conn,
+            f"SELECT v.* FROM dw_semantic_value_dict AS v "
+            f"{_latest_value_snapshot_join(len(source_ids))}"
+            f"WHERE v.source_id IN ({placeholders_sources}) AND v.value_id IN ({placeholders_values})",
+            (*source_ids, *source_ids, *value_ids),
+        )
+    finally:
+        conn.close()
+    return [
+        {
+            "value_id": str(r.get("value_id") or ""),
+            "source_id": str(r.get("source_id") or ""),
+            "column_id": str(r.get("column_id") or ""),
+            "table_id": str(r.get("table_id") or ""),
+            "value_text": str(r.get("value_text") or ""),
+            "snapshot_id": str(r.get("snapshot_id") or ""),
+        }
+        for r in rows
+    ]
+
+
+def list_join_status(source_id: str | None = None, status: str | None = None) -> list[dict]:
+    """列出 join 人工确认记录（按源/状态过滤）。"""
+    _ensure()
+    conds: list[str] = []
+    params: list[Any] = []
+    if source_id:
+        conds.append("source_id=?")
+        params.append(source_id)
+    if status:
+        conds.append("status=?")
+        params.append(status)
+    sql = "SELECT * FROM dw_semantic_join_status"
+    if conds:
+        sql += " WHERE " + " AND ".join(conds)
+    sql += " ORDER BY confirmed_at DESC LIMIT ?"
+    params.append(500)
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, sql, tuple(params))
+    finally:
+        conn.close()
