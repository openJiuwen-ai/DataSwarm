+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Saved-reference governance on an isolated Redis peer and DDL registry.
+
+Provide --redis-server or an existing redis-server on PATH, plus --fixture.
+Missing prerequisites are blocked before service I/O. Only the owned authenticated
+loopback process is started and stopped; persistence is disabled. Metadata lives
+in temporary SQLite, and no existing Redis instance is flushed or modified.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import ExitStack
+import csv
+from datetime import datetime, timezone
+import json
+import os
+from pathlib import Path
+import secrets
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(ROOT))
+OUTPUT = ROOT / "artifact" / "datasource-validation"
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--redis-server", type=Path, default=shutil.which("redis-server"),
+                        help="Existing Redis executable; defaults to redis-server on PATH")
+    parser.add_argument("--fixture", type=Path, default=OUTPUT / "fixture" / "fact_orders.csv")
+    parser.add_argument("--output", type=Path, default=OUTPUT / "batch16-result.json")
+    args = parser.parse_args(argv)
+    records = []
+    report = {"batch": 16, "started_at_utc": datetime.now(timezone.utc).isoformat(),
+              "checks": records, "real_instance_verified": False,
+              "boundaries": ["Redis Windows 5.0 protocol peer; not Redis 7/8 or remote TLS/ACL.",
+                             "SQLite registry and local DDL; no knowledge persistence into Doris."]}
+
+    def write():
+        report["totals"] = {name: sum(row["status"] == name for row in records)
+                            for name in ("passed", "failed", "blocked")}
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding="utf-8")
+        print(json.dumps(report["totals"]))
+        print("GATE_TOTALS: " + json.dumps({**report["totals"], "boundaries": len(report["boundaries"])}))
+        print(f"Passed {report['totals']['passed']}; failed {report['totals']['failed']}; "
+              f"boundaries {len(report['boundaries'])}")
+        print(f"Report: {args.output}")
+
+    if args.redis_server is None or not args.redis_server.is_file() or not args.fixture.is_file():
+        records.append({"gate": "prerequisites", "status": "blocked",
+                        "detail": "Existing Redis binary (--redis-server or PATH) and 50,000-row fixture "
+                                  "are required."})
+        write()
+        return 2
+
+    import redis
+    from jiuwenswarm.channels.web.dataagent.datasource import registry, store
+    from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+    from jiuwenswarm.common import db_connector as dbc
+
+    password = secrets.token_urlsafe(32)
+
+    def check(name, fn):
+        try:
+            detail = fn()
+            records.append({"gate": name, "status": "passed", "detail": detail})
+            print(f"[OK] {name}: {detail}", flush=True)
+        except Exception as exc:
+            # Reports never serialize connection dictionaries or raw endpoints.
+            records.append({"gate": name, "status": "failed", "error_type": type(exc).__name__})
+            print(f"[FAIL] {name}: {type(exc).__name__}", flush=True)
+
+    OUTPUT.mkdir(parents=True, exist_ok=True)
+    with ExitStack() as stack:
+        temp = Path(stack.enter_context(tempfile.TemporaryDirectory(prefix="batch16-", dir=OUTPUT))).resolve()
+        assert temp.is_relative_to(OUTPUT.resolve())
+        old_env = dict(os.environ)
+        stack.callback(lambda: (os.environ.clear(), os.environ.update(old_env)))
+        for key in list(os.environ):
+            if key.startswith("REDIS_"):
+                os.environ.pop(key)
+        meta_ref = f"sqlite://{temp / 'metadata.db'}"
+        os.environ.update(JIUWENSWARM_DATASOURCE_DB=meta_ref,
+                          JIUWENSWARM_DEPLOY_SCHEMA_DIR=str(ROOT / "deploy" / "schema"))
+        (temp / "empty.yaml").write_text("{}\n", encoding="utf-8")
+        old_config_path = dbc._DATASOURCE_CONFIG
+        dbc._DATASOURCE_CONFIG = temp / "empty.yaml"
+        stack.callback(setattr, dbc, "_DATASOURCE_CONFIG", old_config_path)
+        stack.callback(lambda: dbc._invalidate(meta_ref, read_only=False))
+        stack.callback(lambda: dbc._invalidate(meta_ref, read_only=True))
+        with socket.socket() as reserve:
+            reserve.bind(("127.0.0.1", 0))
+            port = reserve.getsockname()[1]
+        log = stack.enter_context((temp / "redis.log").open("w", encoding="utf-8"))
+        proc = subprocess.Popen([str(args.redis_server.resolve()), "--bind", "127.0.0.1", "--port", str(port),
+                                 "--save", "", "--appendonly", "no", "--requirepass", password,
+                                 "--dir", str(temp)], stdout=log, stderr=subprocess.STDOUT,
+                                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+
+        def stop():
+            if proc.poll() is None:
+                proc.terminate()
+                try:
+                    proc.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    proc.kill()
+                    proc.wait(timeout=5)
+        stack.callback(stop)
+        client = redis.Redis(host="127.0.0.1", port=port, password=password, decode_responses=True,
+                             socket_timeout=3, socket_connect_timeout=1)
+        stack.callback(client.close)
+        try:
+            deadline = time.monotonic() + 15
+            while True:
+                if proc.poll() is not None:
+                    raise RuntimeError("owned Redis process failed to start")
+                try:
+                    if client.ping():
+                        break
+                except redis.ConnectionError:
+                    if time.monotonic() >= deadline:
+                        raise TimeoutError("owned Redis startup timed out")
+                    time.sleep(0.1)
+            with args.fixture.open(encoding="utf-8", newline="") as handle:
+                fixture = list(csv.DictReader(handle))
+            assert len(fixture) == 50000
+            for offset in range(0, len(fixture), 5000):
+                with client.pipeline(transaction=False) as pipe:
+                    for row in fixture[offset:offset + 5000]:
+                        pipe.hset(f"acceptance:order:{row['order_id']}",
+                                  mapping={k: v for k, v in row.items() if v != ""})
+                    pipe.execute()
+            report["server_version"] = client.info("server")["redis_version"]
+            report["real_instance_verified"] = True
+            config = {"host": "127.0.0.1", "port": port, "db": 0, "password": password,
+                      "datasets": "hash:acceptance:order:*", "max_keys": 60000, "materialize_limit": 60000}
+            ref = registry.get_source_type("redis").build_ref(config)
+            store.insert_source("acceptance-redis", "redis", "acceptance-redis", config, ref)
+            table = "hash:acceptance:order:*"
+
+            def metadata():
+                assert dbc.tables(ref)["tables"] == [table]
+                assert "order_amt" in {col["name"] for col in dbc.schema(ref, table)["columns"]}
+                return "Authenticated real server; catalog/schema recover saved settings without REDIS_* env."
+            check("A saved metadata", metadata)
+
+            def aggregate():
+                result = dbc.query(ref, f'SELECT COUNT(*), SUM(CAST(order_amt AS DECIMAL(12,2))) FROM "{table}"')
+                assert result["rows"][0][0] == 50000
+                assert str(result["rows"][0][1]) == "2318839.92"
+                assert password not in json.dumps(result, default=str)
+                return "50000 rows; total 2318839.92; public result contains no password."
+            check("B saved query dispatch", aggregate)
+
+            def truncation():
+                limited = {**config, "materialize_limit": 100}
+                store.update_source_row("acceptance-redis", "redis", "acceptance-redis", limited, ref)
+                try:
+                    result = dbc.query(ref, f'SELECT COUNT(*) FROM "{table}"')
+                    assert result["rows"] == [[100]]
+                    assert result["materialize_truncated"] == [table]
+                    assert result["materialize_limit"] == 100
+                finally:
+                    store.update_source_row("acceptance-redis", "redis", "acceptance-redis", config, ref)
+                return "Saved config update is immediate; 100-row partial materialization remains explicitly flagged."
+            check("C truncation semantics", truncation)
+
+            def readonly():
+                for sql in (f'DROP TABLE "{table}"', f'SELECT * INTO copied FROM "{table}"', 'SELECT 1; SELECT 2'):
+                    try:
+                        dbc.query(ref, sql)
+                    except (QueryValidationError, ValueError):
+                        continue
+                    raise AssertionError("write/multi-statement SQL accepted")
+                assert client.dbsize() == 50000
+                return "Writes, SELECT INTO and multiple statements rejected; Redis key count unchanged."
+            check("D query guards", readonly)
+
+            def ddl():
+                ddl_config = {"ddl_text": "CREATE TABLE orders (order_id BIGINT PRIMARY KEY, region VARCHAR(30), "
+                                          "order_amt DECIMAL(12,2));",
+                              "dialect": "postgres"}
+                ddl_ref = registry.get_source_type("ddl").build_ref(ddl_config)
+                store.insert_source("acceptance-ddl", "ddl", "acceptance-ddl", ddl_config, ddl_ref)
+                assert dbc.tables(ddl_ref)["tables"] == ["orders"]
+                assert dbc.schema(ddl_ref, "orders")["columns"][0]["pk"] is True
+                try:
+                    dbc.query(ddl_ref, "SELECT * FROM orders")
+                except ValueError as exc:
+                    assert "metadata-only" in str(exc)
+                else:
+                    raise AssertionError("DDL incorrectly executes SQL")
+                return "Persisted DDL reference resolves tables/primary key and refuses data queries."
+            check("E saved DDL metadata", ddl)
+        except Exception as exc:
+            records.append({"gate": "setup", "status": "failed", "error_type": type(exc).__name__})
+    report["owned_peer_stopped"] = proc.poll() is not None
+    report["temporary_directory_removed"] = not temp.exists()
+    write()
+    return 1 if report["totals"]["failed"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
