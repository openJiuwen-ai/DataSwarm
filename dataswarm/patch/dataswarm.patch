+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/semantic_link/schema_merge.py —— schema 召回合并（词法+EMB+merge 与 node 解析）（自 semantic_link.py 保守拆分，纯搬运）。
+
+模块定位见包门面 docstring（semantic_link/__init__.py）。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Sequence
+
+from ._util import _warn
+from .snapshots import _SCHEMA_STATUS_ACTIVE
+from .scoring import SCHEMA_COMMENT_SCORE, SCHEMA_LABEL_SCORE, _match_score
+
+
+
+@dataclass(frozen=True)
+class SchemaHit:
+    """S 入口（语义层快照）的一个命中。
+
+    ``node_id`` 是 semantic 稳定 ID（``tbl:/view:/col:`` 前缀）；
+    ``emb_via``：EMB 分由哪个查询向量胜出（整句原文或某个 jieba 短语），
+    词法命中或整句胜出时为空串。多向量归因，供 UI 可视化验证。
+    """
+
+    node_id: str
+    node_type: str
+    label: str
+    logical: str
+    score: float
+    matched_on: tuple[str, ...] = ()
+    emb_via: str = ""
+
+
+# ==========================================================================
+# schema 通道：快照词法 + FAISS 合并
+# ==========================================================================
+
+def schema_recall(
+    workspace_id: str, question: str, snapshots: dict[str, Any], *,
+    warnings: list[str],
+    extra_terms: Sequence[str] = (),
+) -> tuple[list[SchemaHit], float]:
+    """S 入口：快照内存词法匹配 + 语义层 FAISS 召回，按 node_id 合并取 max。
+
+    词法刻度对齐旧 schema 图 SPARQL（label 0.80 / comment 0.40、精确 +0.15）；
+    EMB 命中经 ``vector_store.recall``（其内部自带通道不可用降级与 warning）。
+    ``matched_on`` 含 ``emb``、``emb_via`` 记胜出查询向量（归因展示）。
+    ``extra_terms`` 为术语扩展词（整词注入，见 :func:`search_terms`）。
+    """
+    from .. import semantic_link as _facade  # 互调经包门面：保 patch 锚语义（见 __init__ docstring）
+    terms = _facade.search_terms(question, extra_terms=extra_terms)
+    lexical = _facade.lexical_schema_hits(snapshots, terms)
+    emb_hits, emb_warnings = _facade.emb_schema_hits(workspace_id, question, snapshots)
+    for warning in emb_warnings:
+        _warn(warnings, warning)
+    merged = _merge_schema_hits(snapshots, lexical, emb_hits)
+    confidence = max((h.score for h in merged), default=0.0)
+    return merged, confidence
+
+
+def lexical_schema_hits(
+    snapshots: dict[str, Any], terms: list[str], *, limit: int = 10,
+) -> list[SchemaHit]:
+    """快照词法匹配：表/列的 label（comment or name）与 comment 逐词子串。"""
+    if not terms:
+        return []
+    hits: list[SchemaHit] = []
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            if table.status != _SCHEMA_STATUS_ACTIVE:
+                continue
+            score = 0.0
+            matched: list[str] = []
+            label_value = table.comment or table.name
+            for field_name, value, base in (
+                ("label", label_value, SCHEMA_LABEL_SCORE),
+                ("comment", table.comment or "", SCHEMA_COMMENT_SCORE),
+            ):
+                fscore = _match_score(value, terms, base)
+                if fscore > 0:
+                    if fscore > score:
+                        score = fscore
+                    if field_name not in matched:
+                        matched.append(field_name)
+            if score > 0:
+                hits.append(SchemaHit(
+                    node_id=table.node_id,
+                    node_type="view" if table.table_type.upper() == "VIEW" else "tbl",
+                    label=label_value,
+                    logical=table.name,
+                    score=score,
+                    matched_on=tuple(matched),
+                ))
+            for column in table.columns:
+                if column.status != _SCHEMA_STATUS_ACTIVE:
+                    continue
+                col_score = 0.0
+                col_matched: list[str] = []
+                col_label = column.comment or column.name
+                for field_name, value, base in (
+                    ("label", col_label, SCHEMA_LABEL_SCORE),
+                    ("comment", column.comment or "", SCHEMA_COMMENT_SCORE),
+                ):
+                    fscore = _match_score(value, terms, base)
+                    if fscore > 0:
+                        if fscore > col_score:
+                            col_score = fscore
+                        if field_name not in col_matched:
+                            col_matched.append(field_name)
+                if col_score > 0:
+                    hits.append(SchemaHit(
+                        node_id=column.node_id,
+                        node_type="col",
+                        label=col_label,
+                        logical=f"{table.name}.{column.name}",
+                        score=col_score,
+                        matched_on=tuple(col_matched),
+                    ))
+    hits.sort(key=lambda h: (-h.score, h.node_id))
+    return hits[:limit]
+
+
+def emb_schema_hits(
+    workspace_id: str, question: str, snapshots: dict[str, Any],
+) -> tuple[dict[str, tuple[float, str]], list[str]]:
+    """FAISS 召回 → ``(node_id -> (校准分, 胜出查询向量), warnings)``。
+
+    recall 输出的表/列名经快照索引还原成稳定 node_id；还原不到（快照
+    刚轮换/列已删）直接丢弃——不伪造命中。
+    """
+    from ...semantic import vector_store
+
+    index = snapshot_index(snapshots)
+    out: dict[str, tuple[float, str]] = {}
+    warnings: list[str] = []
+    for source_id in snapshots:
+        try:
+            outcome = vector_store.recall(workspace_id, source_id, question)
+        except Exception as exc:  # noqa: BLE001 —— FAISS 链路故障降级词法，不阻断
+            _warn(warnings, f"semantic_vector_recall_failed:{type(exc).__name__}")
+            continue
+        for warning in outcome.get("warnings", []):
+            _warn(warnings, warning)
+        for table in outcome.get("tables", []):
+            # A stale explicit ID must never fall back to a different table
+            # sharing its bare name. Legacy results may use an unambiguous name.
+            table_reference = str(table.get("table_id") or table.get("table_fqn")
+                                  or table.get("table_name") or "")
+            table_score = float(table.get("score") or 0.0)
+            columns = table.get("columns") or []
+            if columns:
+                for column in columns:
+                    column_name = str(column.get("column_name") or "")
+                    node_id = _resolve_column_node_id(index, source_id, table_reference, column_name)
+                    if not node_id:
+                        continue
+                    cscore = float(column.get("score") or 0.0)
+                    via = str(column.get("emb_via") or "")
+                    prev = out.get(node_id)
+                    if prev is None or cscore > prev[0]:
+                        out[node_id] = (cscore, via)
+                continue
+            node_id = _resolve_table_node_id(index, source_id, table_reference)
+            if node_id and table_score > 0:
+                out[node_id] = (table_score, "")
+    return out, warnings
+
+
+def snapshot_index(snapshots: dict[str, Any]) -> dict[str, Any]:
+    """Index exact table IDs plus unambiguous FQN/bare-name aliases per source.
+
+    Multiple schemas may contain the same table name. Retain each exact ID and
+    mark ambiguous aliases with None instead of overwriting another table. The
+    marker also prevents source-agnostic anchors from selecting a different
+    source just because this source's candidates were ambiguous.
+    """
+    candidates: dict[str, dict[str, list[Any]]] = {}
+    for source_id, snapshot in snapshots.items():
+        for table in snapshot.tables:
+            item = (table, {c.name: c for c in table.columns})
+            for reference in {table.node_id, table.fqn, table.name}:
+                candidates.setdefault(reference, {}).setdefault(source_id, []).append(item)
+    return {reference: {source_id: items[0] if len(items) == 1 else None
+                        for source_id, items in sources.items()}
+            for reference, sources in candidates.items()}
+
+
+def _resolve_table_node_id(index: dict[str, Any], source_id: str, table_name: str) -> str:
+    """表名 → 稳定 node_id（歧义/缺失返回空）。"""
+    entry = index.get(table_name) or {}
+    item = entry.get(source_id)
+    if item is None:
+        return ""
+    return item[0].node_id
+
+
+def _resolve_column_node_id(
+    index: dict[str, Any], source_id: str, table_name: str, column_name: str,
+) -> str:
+    """(表名, 列名) → 稳定 node_id（缺失返回空，不伪造）。"""
+    entry = index.get(table_name) or {}
+    item = entry.get(source_id)
+    if item is None:
+        return ""
+    column = item[1].get(column_name)
+    return column.node_id if column is not None else ""
+
+
+def _merge_schema_hits(
+    snapshots: dict[str, Any], lexical_hits: list[SchemaHit],
+    emb_hits: dict[str, tuple[float, str]],
+) -> list[SchemaHit]:
+    """词法与 EMB 命中按 node_id 合并取 max；EMB 独有命中经快照索引补全属性。"""
+    by_id = {h.node_id: h for h in lexical_hits}
+    for node_id, (score, via) in emb_hits.items():
+        prev = by_id.get(node_id)
+        if prev is not None:
+            if score > prev.score:
+                by_id[node_id] = SchemaHit(
+                    node_id=prev.node_id, node_type=prev.node_type,
+                    label=prev.label, logical=prev.logical, score=score,
+                    matched_on=(*prev.matched_on, "emb"), emb_via=via)
+            continue
+        attributes = node_attributes(snapshots, node_id)
+        if attributes is None:
+            continue  # 索引里读不到（如快照刚轮换）：不伪造命中
+        by_id[node_id] = SchemaHit(
+            node_id=node_id, node_type=attributes[0], label=attributes[1],
+            logical=attributes[2], score=score, matched_on=("emb",), emb_via=via)
+    hits = sorted(by_id.values(), key=lambda h: (-h.score, h.node_id))
+    return hits
+
+
+def node_attributes(snapshots: dict[str, Any], node_id: str) -> tuple[str, str, str] | None:
+    """node_id → (node_type, label, logical)（快照内查不到返回 None）。
+
+    ``logical`` 为裸表形态（``orders`` / ``orders.amount_cny``），与旧 schema
+    图 logicalTable/logicalField 同构——子图/前端/传导消费方不感知 database。
+    """
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            if table.node_id == node_id:
+                return ("tbl", table.comment or table.name, table.name)
+            for column in table.columns:
+                if column.node_id == node_id:
+                    return ("col", column.comment or column.name,
+                            f"{table.name}.{column.name}")
+    return None
+
+
