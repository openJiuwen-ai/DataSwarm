@@ -0,0 +1,152 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""datasource/controller.py — 数据源 HTTP 路由分发。
+
+路由前缀: /api/dataagent/datasource/
+  GET  /datasource/probe?db_ref=&workspace_id=&source_id=
+  GET  /datasource/list
+  GET  /datasource/types
+  GET  /datasource/databases?db_ref=
+  GET  /datasource/catalog?source_id=
+  GET  /datasource/schema?source_id=&dataset=&schema=
+  GET  /datasource/preview?source_id=&dataset=&limit=
+  POST /datasource/query {source_id, sql, params?, limit?}
+  POST /datasource/infer   {path, sample_rows?}
+  POST /datasource/test    {type, host, port, user, password, database} | {type: csv, path}
+  POST /datasource/create  {source_id, type, ...connection params}
+  POST /datasource/create-database  {type, host, port, user, password, database}  # 库不存在时前端调
+  POST /datasource/bind    {source_id, workspace_id}
+  POST /datasource/update  {source_id, ...params}  # password 留空 = 沿用旧值
+  POST /datasource/delete  {source_id}
+"""
+from __future__ import annotations
+
+from jiuwenswarm.common.workspace_context import WorkspaceContextError
+
+from . import service as svc
+from .._common import read_body
+
+
+_PREFIX = "/api/dataagent/datasource"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    rel = path[len(_PREFIX):].rstrip("/")
+    return rel.split("/")
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    try:
+        # ['', 'probe']
+        if len(parts) == 2 and parts[1] == "probe":
+            db_ref = handler._query_arg(parsed, "db_ref") or ""
+            ws = handler._query_arg(parsed, "workspace_id") or None
+            source_id = handler._query_arg(parsed, "source_id") or None
+            handler._write_json(
+                200,
+                svc.probe_datasource(db_ref, workspace_id=ws, source_id=source_id),
+            )
+            return
+        # ['', 'list']
+        if len(parts) == 2 and parts[1] == "list":
+            workspace_id = handler._query_arg(parsed, "workspace_id") or None
+            handler._write_json(200, svc.list_datasources(workspace_id=workspace_id))
+            return
+        # ['', 'types'] — 类型目录（前端动态渲染表单）
+        if len(parts) == 2 and parts[1] == "types":
+            handler._write_json(200, svc.list_source_types())
+            return
+        # ['', 'databases']
+        if len(parts) == 2 and parts[1] == "databases":
+            db_ref = handler._query_arg(parsed, "db_ref") or ""
+            ws = handler._query_arg(parsed, "workspace_id") or None
+            handler._write_json(200, svc.list_databases(db_ref, workspace_id=ws))
+            return
+        if len(parts) == 2 and parts[1] == "catalog":
+            source_id = handler._query_arg(parsed, "source_id") or ""
+            handler._write_json(200, svc.source_catalog(source_id))
+            return
+        if len(parts) == 2 and parts[1] == "schema":
+            source_id = handler._query_arg(parsed, "source_id") or ""
+            dataset = handler._query_arg(parsed, "dataset") or ""
+            schema_name = handler._query_arg(parsed, "schema") or None
+            handler._write_json(200, svc.source_schema(source_id, dataset, schema_name))
+            return
+        if len(parts) == 2 and parts[1] == "preview":
+            source_id = handler._query_arg(parsed, "source_id") or ""
+            dataset = handler._query_arg(parsed, "dataset") or ""
+            limit = int(handler._query_arg(parsed, "limit") or 100)
+            handler._write_json(200, svc.source_preview(source_id, dataset, limit))
+            return
+    except WorkspaceContextError as exc:
+        handler._write_json(400, {"error": getattr(exc, "code", "invalid_workspace"),
+                                  "detail": str(exc)})
+        return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = read_body(handler)
+    if body is None and len(parts) > 1:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        # ['', 'infer']
+        if len(parts) == 2 and parts[1] == "infer":
+            file_path = (body or {}).get("path", "")
+            sample_rows = int((body or {}).get("sample_rows", 100))
+            handler._write_json(200, svc.infer_csv_schema(file_path, sample_rows))
+            return
+        # ['', 'test'] —— 保存前连通性测试（表单参数直连，不落盘）
+        if len(parts) == 2 and parts[1] == "test":
+            handler._write_json(200, svc.test_connection(body or {}))
+            return
+        # ['', 'create']
+        if len(parts) == 2 and parts[1] == "create":
+            handler._write_json(200, svc.create_source(body or {}))
+            return
+        # ['', 'create-database'] —— 库不存在时前端「创建数据库」按钮
+        if len(parts) == 2 and parts[1] == "create-database":
+            handler._write_json(200, svc.create_database(body or {}))
+            return
+        if len(parts) == 2 and parts[1] == "bind":
+            handler._write_json(200, svc.bind_source_to_workspace(body or {}))
+            return
+        # ['', 'update']
+        if len(parts) == 2 and parts[1] == "update":
+            handler._write_json(200, svc.update_source(body or {}))
+            return
+        # ['', 'delete']
+        if len(parts) == 2 and parts[1] == "delete":
+            handler._write_json(200, svc.delete_source(body or {}))
+            return
+        if len(parts) == 2 and parts[1] == "query":
+            payload = body or {}
+            handler._write_json(
+                200,
+                svc.query_source(
+                    str(payload.get("source_id") or ""),
+                    str(payload.get("sql") or ""),
+                    payload.get("params"),
+                    int(payload.get("limit") or 100),
+                ),
+            )
+            return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
