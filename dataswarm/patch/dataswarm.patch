+def update_instance_if_not_terminal(instance_id: str, *, terminal_statuses=("cancelled",),
+                                     **fields) -> dict | None:
+    """CAS 条件更新（方案 §5.3）：仅当实例状态不在 terminal_statuses 时才更新。
+
+    用途：workflow/task 末尾写 success/failed 前调用，防止 cancel 打在并发完成间隙
+    被后续 success 覆盖。受影响行数=0 时返回当前实例（已被 cancel/终态），不覆盖。
+
+    各方言通用：SELECT-then-UPDATE 在 _write_lock 内，等价于 CAS
+    （SQLite 单写锁串行化；Doris 语句级原子 UPDATE WHERE）。
+    """
+    inst = get_instance(instance_id)
+    if not inst:
+        return None
+    if inst.get("status") in terminal_statuses:
+        return inst  # 已终态（如 cancelled），不覆盖
+    return update_instance(instance_id, **fields)
+
+
+def create_task_run(instance_id: str, task_id: str, node_id: str | None, node_name: str | None,
+                    status: str = "queued") -> dict:
+    run_id = new_id("run")
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """INSERT INTO dw_task_runs
+                   (run_id,instance_id,task_id,node_id,node_name,status,started_at,
+                    finished_at,exit_code,stdout_path,stderr_path,error_message,result_summary)
+                   VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)""",
+                (run_id, instance_id, task_id, node_id, node_name, status, None, None, None, None, None, None, None),
+            )
+            conn.commit()
+        finally:
+            conn.close()
+    return get_task_run(run_id)  # type: ignore
+
+
+def get_task_run(run_id: str) -> dict | None:
+    conn = _connect()
+    try:
+        return _fetch_one_dict(conn, "SELECT * FROM dw_task_runs WHERE run_id=?", (run_id,))
+    finally:
+        conn.close()
+
+
+def list_task_runs(instance_id: str) -> list[dict]:
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, "SELECT * FROM dw_task_runs WHERE instance_id=? ORDER BY started_at", (instance_id,))
+    finally:
+        conn.close()
+
+
+def update_task_run(run_id: str, **fields) -> dict | None:
+    if not fields:
+        return get_task_run(run_id)
+    sets = []
+    vals: list[Any] = []
+    for k, v in fields.items():
+        sets.append(f"{k}=?")
+        vals.append(v)
+    vals.append(run_id)
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, f"UPDATE dw_task_runs SET {', '.join(sets)} WHERE run_id=?", vals)
+            conn.commit()
+        finally:
+            conn.close()
+    return get_task_run(run_id)
+
+
+def list_scheduled_targets() -> list[dict]:
+    """调度器扫描：所有 published 且 schedule_type in (once,cron) 的 task + enabled workflow。"""
+    conn = _connect()
+    out: list[dict] = []
+    try:
+        rows = _fetch_dicts(conn,
+            "SELECT * FROM dw_tasks WHERE status='published' AND schedule_type IN ('once','cron')")
+        for r in rows:
+            d = dict(r)
+            d["ref_type"] = "task"
+            d["ref_id"] = d["task_id"]
+            out.append(d)
+        rows = _fetch_dicts(conn,
+            "SELECT * FROM dw_workflows WHERE status='published' AND enabled=1 "
+            "AND schedule_type IN ('once','cron')")
+        for r in rows:
+            d = dict(r)
+            d["ref_type"] = "workflow"
+            d["ref_id"] = d["workflow_id"]
+            out.append(d)
+    finally:
+        conn.close()
+    return out
+
+
+def last_instance_ts(ref_type: str, ref_id: str) -> str | None:
+    conn = _connect()
+    try:
+        d = _fetch_one_dict(conn,
+            "SELECT created_at FROM dw_task_instances WHERE ref_type=? AND ref_id=? "
+            "ORDER BY created_at DESC LIMIT 1",
+            (ref_type, ref_id),
+        )
+        return d["created_at"] if d else None
+    finally:
+        conn.close()
+
+
+def mark_once_fired(task_id: str | None, wf_id: str | None) -> None:
+    """一次性调度触发后置 schedule_type=none，防重复触发。"""
+    with _write_lock:
+        conn = _connect()
+        try:
+            if task_id:
+                _exec(conn,
+                    "UPDATE dw_tasks SET schedule_type='none', updated_at=? WHERE task_id=?",
+                    (_now(), task_id),
+                )
+            if wf_id:
+                _exec(conn,
+                    "UPDATE dw_workflows SET schedule_type='none', updated_at=? WHERE workflow_id=?",
+                    (_now(), wf_id),
+                )
+            conn.commit()
+        finally:
+            conn.close()
