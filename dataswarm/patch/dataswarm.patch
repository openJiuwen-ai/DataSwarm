+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""service._metric_gate 单测（F-028 指标门禁：三档判定 + 兜底命中扩池）。
+
+覆盖：池内有指标强制选定、已选定放行、池内无指标兜底检索命中指路、
+无指标空间放行（G3 合法降级）、非 published 命中放行、兜底 probe 只用
+成分文本不拼问题（防兄弟成分误伤）、兜底命中 key 随返回供扩池。
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from jiuwenswarm.channels.web.dataagent.analysis import service  # noqa: E402
+
+
+def _metric(key: str, status: str = "active", revision: str | None = "rev-1") -> SimpleNamespace:
+    return SimpleNamespace(metric_key=key, status=status, current_revision_id=revision)
+
+
+def _published_revision() -> SimpleNamespace:
+    return SimpleNamespace(status="published")
+
+
+def _core(**overrides) -> dict:
+    base = {"component_id": "c1", "role": "core", "required": True,
+            "selected_metrics": [], "material_refs": ["col:src.t.a"],
+            "output": "总销售额 按月", "text": "", "dimensions": []}
+    base.update(overrides)
+    return base
+
+
+def _ctx(materials: list[dict]) -> dict:
+    return {"materials": materials}
+
+
+def test_pool_metric_forces_selection():
+    errors, fallback = service._metric_gate(
+        {"components": [_core()]}, "ws-1",
+        _ctx([{"kind": "metric", "metric_key": "nw.sales_amount"}]))
+    assert len(errors) == 1
+    assert errors[0]["field"] == "selected_metrics"
+    assert "nw.sales_amount" in errors[0]["message"]
+    assert fallback == set()  # 池内命中不产生扩容
+
+
+def test_pool_metric_with_selection_passes():
+    errors, fallback = service._metric_gate(
+        {"components": [_core(selected_metrics=["nw.sales_amount"])]}, "ws-1",
+        _ctx([{"kind": "metric", "metric_key": "nw.sales_amount"}]))
+    assert errors == [] and fallback == set()
+
+
+def test_pool_metric_with_ref_only_passes():
+    """material_refs 引用了 metric: 素材（selected_metrics 为空）也放行。"""
+    errors, _ = service._metric_gate(
+        {"components": [_core(material_refs=["metric:nw.sales_amount"])]}, "ws-1",
+        _ctx([{"kind": "metric", "metric_key": "nw.sales_amount"}]))
+    assert errors == []
+
+
+def test_no_pool_metric_no_hit_passes(monkeypatch):
+    """无指标空间：池内无 + 兜底检索空 → 放行（G3 合法降级）。"""
+    monkeypatch.setattr(service.store, "search_defs", lambda *a, **k: [])
+    errors, fallback = service._metric_gate({"components": [_core()]}, "ws-1", _ctx([]))
+    assert errors == [] and fallback == set()
+
+
+def test_fallback_hit_points_and_returns_key(monkeypatch):
+    """池内无指标（首路措辞运气差）但兜底检索命中 published → 报错指路 + key 供扩池。"""
+    calls: list[str] = []
+
+    def fake_search(ws, query, limit=5):
+        calls.append(query)
+        return [(_metric("nw.sales_amount"), 0.9, "name")]
+
+    monkeypatch.setattr(service.store, "search_defs", fake_search)
+    monkeypatch.setattr(service.store, "get_revision", lambda rid: _published_revision())
+    errors, fallback = service._metric_gate(
+        {"components": [_core()], "question": "出一份经营分析报告"}, "ws-1", _ctx([]))
+    assert len(errors) == 1
+    assert "nw.sales_amount" in errors[0]["message"]
+    assert fallback == {"nw.sales_amount"}
+    # probe 只用成分自身文本，不拼问题（防兄弟成分误伤）
+    assert calls == ["总销售额 按月"]
+
+
+def test_fallback_hit_below_floor_or_unpublished_passes(monkeypatch):
+    """兜底命中但分数不过门槛 / revision 非 published → 放行且不扩池。"""
+    monkeypatch.setattr(
+        service.store, "search_defs",
+        lambda *a, **k: [(_metric("nw.x"), 0.3, "desc"), (_metric("nw.y"), 0.9, "name")])
+    monkeypatch.setattr(service.store, "get_revision", lambda rid: SimpleNamespace(status="draft"))
+    errors, fallback = service._metric_gate({"components": [_core()]}, "ws-1", _ctx([]))
+    assert errors == [] and fallback == set()
+
+
+def test_facet_and_optional_components_not_gated(monkeypatch):
+    """facet / required=false 成分不受门禁约束。"""
+    monkeypatch.setattr(service.store, "search_defs", lambda *a, **k: [(_metric("m"), 0.9, "n")])
+    monkeypatch.setattr(service.store, "get_revision", lambda rid: _published_revision())
+    errors, fallback = service._metric_gate(
+        {"components": [_core(role="facet", facet_id="f1"), _core(required=False)]}, "ws-1",
+        _ctx([]))
+    assert errors == [] and fallback == set()
+
+
+@pytest.mark.parametrize("dims,output,expect_probe", [
+    (["月份", "品类"], "销售趋势", "销售趋势 月份 品类"),
+    ([], "", ""),
+])
+def test_probe_composition(dims, output, expect_probe, monkeypatch):
+    calls: list[str] = []
+    monkeypatch.setattr(service.store, "search_defs",
+                        lambda ws, q, limit=5: calls.append(q) or [])
+    service._metric_gate(
+        {"components": [_core(dimensions=dims, output=output)]}, "ws-1", _ctx([]))
+    assert calls == ([expect_probe] if expect_probe else [])
