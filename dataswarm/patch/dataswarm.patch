+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""/v2/explore 受控探索端点测试（增补设计 §8 / D7）。
+
+R3 的执行口子：schema 子图范围内 LLM 生成 SQL，guard 全过，authoritative=false。
+LLM 打桩；schema 子图来自真实探查（e2e 临时 sqlite 业务库）。
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import llm as metrics_llm
+from jiuwenswarm.channels.web.dataagent.metrics import store, versioning
+from jiuwenswarm.channels.web.dataagent.metrics import api_v2
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, WORKSPACE, write_published_snapshot
+from tests.unit_tests.web.test_metrics_v2_api import FakeHandler, PREFIX
+
+GMV = "commerce.gmv"
+
+
+@pytest.fixture
+def published(e2e, monkeypatch):
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="explore-test")
+    write_published_snapshot(e2e)
+    versioning.publish_release(WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+                               label="explore", published_by="t")
+    yield e2e
+
+
+_GOOD_SQL = json.dumps({
+    "sql": ("SELECT orders.region AS region, COUNT(*) AS cnt FROM orders "
+            "WHERE orders.pay_status = 'PAID' AND orders.paid_at >= ? "
+            "AND orders.paid_at < ? GROUP BY orders.region"),
+    "params": ["2026-08-01", "2026-09-01"],
+    "assumptions": ["仅统计已支付"],
+    "confidence": "medium",
+})
+
+
+def test_explore_compiles_within_subgraph(published, monkeypatch):
+    """子图范围内生成 SQL（执行语义拆分：不执行）；标 exploratory/非权威且落追溯。"""
+    monkeypatch.setattr(metrics_llm, "call_llm_sync", lambda *a, **k: _GOOD_SQL)
+    handler = FakeHandler(f"{PREFIX}/explore",
+                          {"question": "orders 里 pay_status 为 PAID 的笔数按 region 分布"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.response.status == 200
+    payload = handler.response.payload
+    assert payload["path"] == "exploratory"
+    assert payload["authoritative"] is False
+    # 只编译不执行：交付自包含 SQL（参数内联），无 rows
+    assert "rows" not in payload
+    assert "'2026-08-01'" in payload["sql_executable"]
+    assert "?" not in payload["sql_executable"]
+    logs = store.list_queries(WORKSPACE)
+    assert logs[0]["path"] == "exploratory"
+    assert logs[0]["executed"] == 0
+
+
+def test_explore_rejects_out_of_subgraph_table(published, monkeypatch):
+    """LLM 想查子图外的表 → 快校验拦下，修正耗尽报 SQL_VALIDATION_FAILED。"""
+    bad = json.dumps({"sql": "SELECT * FROM secret_table", "params": [],
+                      "assumptions": [], "confidence": "low"})
+    monkeypatch.setattr(metrics_llm, "call_llm_sync", lambda *a, **k: bad)
+    handler = FakeHandler(f"{PREFIX}/explore", {"question": "orders 的 region 分布，顺便看下 secret_table"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.response.status == 400
+    assert handler.response.payload["error"] == "SQL_VALIDATION_FAILED"
+    assert handler.response.payload["retryable"] is False
+
+
+def test_explore_without_schema_hit_400(published, monkeypatch):
+    """schema 零命中 → SEMANTIC_CONTEXT_EMPTY，不瞎跑。"""
+    monkeypatch.setattr(metrics_llm, "call_llm_sync", lambda *a, **k: _GOOD_SQL)
+    handler = FakeHandler(f"{PREFIX}/explore", {"question": "库存周转天数"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.response.status == 400
+    assert handler.response.payload["error"] == "SEMANTIC_CONTEXT_EMPTY"
+
+
+def test_explore_llm_unavailable_503(published, monkeypatch):
+    """LLM 空串 → LLM_UNAVAILABLE（503 类），绝不返回无依据数值。"""
+    monkeypatch.setattr(metrics_llm, "call_llm_sync", lambda *a, **k: "")
+    handler = FakeHandler(f"{PREFIX}/explore", {"question": "orders 里 pay_status 为 PAID 的笔数按 region 分布"})
+    api_v2.handle_post(handler, handler.parsed)
+    assert handler.response.status == 503
+    assert handler.response.payload["error"] == "LLM_UNAVAILABLE"
