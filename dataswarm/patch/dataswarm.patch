diff --git a/jiuwenswarm/channels/web/frontend/src/services/askUserAnswer.ts b/jiuwenswarm/channels/web/frontend/src/services/askUserAnswer.ts
new file mode 100644
index 000000000..6edd6bbcd
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/services/askUserAnswer.ts
@@ -0,0 +1,83 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 抽屉场景的 ask_user 应答最小实现。
+ *
+ * 从 hooks/useWebSocket.ts 的 sendUserAnswer（主聊天链路）提炼：只保留治理侧栏
+ * 需要的三类分级确认追问（ask_user / permission / confirm），其余分支显式抛
+ * NotSupported 而不是静默走错通道 —— 后端对这些分支校验不全，走错会静默失败。
+ */
+
+import { webRequest } from './webClient';
+import { useChatStore } from '../stores';
+import type { UserAnswer } from '../types';
+
+const SUPPORTED_INTERRUPT_SOURCES = new Set([
+  'ask_user_interrupt',
+  'permission_interrupt',
+  'confirm_interrupt',
+]);
+
+export interface SubmitAskUserAnswerParams {
+  sessionId: string;
+  requestId: string;
+  answers: UserAnswer[];
+  source?: string;
+}
+
+export class AnswerChannelNotSupportedError extends Error {
+  constructor(reason: string) {
+    super(`该类交互暂不支持在治理侧栏中作答（${reason}）`);
+    this.name = 'AnswerChannelNotSupportedError';
+  }
+}
+
+function isEvolutionRequestId(requestId: string): boolean {
+  return requestId.startsWith('skill_evolve_') || requestId.startsWith('team_skill_evolve_');
+}
+
+export async function submitAskUserAnswer(params: SubmitAskUserAnswerParams): Promise<void> {
+  const { sessionId, requestId, answers } = params;
+  const pending = useChatStore.getState().getRuntime(sessionId)?.pendingQuestion;
+  const pendingMatches = pending?.request_id === requestId;
+  const effectiveSource = params.source ?? (pendingMatches ? pending?.source : undefined);
+
+  // 明确不支持的复杂分支（v1）：演进审批、计划审批、激活确认、带 schema 的审批
+  const rid = requestId ?? '';
+  if (
+    effectiveSource === 'evolution_interrupt' ||
+    effectiveSource === 'skill_evolution_approval' ||
+    isEvolutionRequestId(rid)
+  ) {
+    throw new AnswerChannelNotSupportedError('技能演进审批');
+  }
+  if (effectiveSource === 'activate_confirm') {
+    throw new AnswerChannelNotSupportedError('扩展激活确认');
+  }
+  if (pendingMatches && pending?.planApprovalKind === 'plan_approval') {
+    throw new AnswerChannelNotSupportedError('计划模式审批');
+  }
+  if (pendingMatches && pending?.approvalSchema) {
+    throw new AnswerChannelNotSupportedError('结构化审批');
+  }
+
+  // 三类分级确认追问走 interrupt resume 通道（chat.send 携带 request_id + answers）
+  if (effectiveSource && SUPPORTED_INTERRUPT_SOURCES.has(effectiveSource)) {
+    await webRequest('chat.send', {
+      session_id: sessionId,
+      query: '',
+      mode: 'agent',
+      request_id: requestId,
+      answers,
+      ...(effectiveSource ? { source: effectiveSource } : {}),
+    });
+  } else {
+    // 其余（含无 source 的自进化确认）走 chat.user_answer
+    await webRequest('chat.user_answer', {
+      session_id: sessionId,
+      request_id: requestId,
+      answers,
+    });
+  }
+
+  useChatStore.getState().setPendingQuestion(sessionId, null);
+}
