+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""schema_enrichment —— 知识派生任务（L1 正则 + L2 LLM 深化）的测试。"""
+from __future__ import annotations
+
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+from jiuwenswarm.channels.web.dataagent.knowledge import schema_enrichment, store
+from jiuwenswarm.channels.web.dataagent.knowledge.schema_enrichment import EnrichedColumn, EnrichmentResult
+
+_TABLES = {
+    "orders": [
+        {"name": "order_id", "type": "BIGINT", "null": False, "pk": True},
+        {"name": "order_status", "type": "VARCHAR(32)", "null": True, "pk": False},
+        {"name": "customer_name", "type": "VARCHAR(64)", "null": True, "pk": False},
+        {"name": "refund_reason", "type": "VARCHAR(128)", "null": True, "pk": False},
+        {"name": "order_dt", "type": "VARCHAR(16)", "null": True, "pk": False},
+    ],
+}
+
+
+class FakeProvider:
+    model = "fake-derive-model"
+
+    def __init__(self, results, delay=0.0):
+        self.results = list(results)
+        self.prompts: list[str] = []
+        self.delay = delay
+
+    def generate_typed(self, prompt, schema, *, temperature=0, max_retries=1):
+        self.prompts.append(prompt)
+        if self.delay:
+            time.sleep(self.delay)
+        return self.results.pop(0)
+
+
+def _prepare(monkeypatch, tmp_path: Path):
+    db_path = tmp_path / "enrichment.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR",
+                       str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(f"sqlite://{db_path}")
+    monkeypatch.setattr(store, "_workspace", lambda: "ws-test")
+    # 后台线程无请求上下文：绕过真实 workspace 注册表
+    monkeypatch.setattr("jiuwenswarm.common.workspace_context.set_current", lambda _wid: None)
+    monkeypatch.setattr("jiuwenswarm.common.workspace_context.reset", lambda _token: None)
+    fake = SimpleNamespace(
+        tables=lambda _ref: {"tables": list(_TABLES)},
+        schema=lambda _ref, table: {"table": table, "columns": _TABLES.get(table, [])},
+        query=lambda _ref, sql, params=None, limit=None: {
+            "columns": ["order_status", "customer_name", "refund_reason", "order_dt"],
+            "rows": [["delivered", "张三", "七天无理由", "2026-01-01"],
+                     ["canceled", "李四", "质量问题", "2026-01-02"]]},
+    )
+    from jiuwenswarm.channels.web.dataagent import db as dataagent_db
+    monkeypatch.setattr(dataagent_db, "db_connector", fake)
+    schema_enrichment._JOBS.clear()
+    return fake
+
+
+def _patch_provider(monkeypatch, provider):
+    from jiuwenswarm.channels.web.dataagent.knowledge import extraction_llm
+    monkeypatch.setattr(extraction_llm, "build_default_provider", lambda: provider)
+
+
+def _wait_job(timeout=5.0):
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        job = schema_enrichment.job_status("ws-test")
+        if job and job["status"] in {"complete", "failed", "timeout"}:
+            return job
+        time.sleep(0.02)
+    return schema_enrichment.job_status("ws-test")
+
+
+def test_submit_runs_derive_then_enrich(monkeypatch, tmp_path):
+    """完整任务：L1 派生 4 条候选 → L2 每表一次 LLM → 定义/同义词/深化标记落库。
+
+    LLM 判定无业务概念而跳过的列（order_dt 缺席输出）保留 L1 原始描述，
+    仍标记已深化——不硬编定义、不反复重试。
+    """
+    _prepare(monkeypatch, tmp_path)
+    provider = FakeProvider([EnrichmentResult(columns=[
+        EnrichedColumn(column="order_status", definition="订单履约生命周期状态",
+                       zh_name="订单状态", synonyms=["履约状态"]),
+        # metric_hint 并入是行为锁：L1 已不派生数值候选（2026-11-02），
+        # 输出值直接给口径，验证 L2 不丢口径建议
+        EnrichedColumn(column="customer_name", definition="下单客户姓名",
+                       metric_hint="COUNT(DISTINCT customer_name)，按天聚合"),
+        EnrichedColumn(column="refund_reason", definition="退款原因"),
+    ])])
+    _patch_provider(monkeypatch, provider)
+
+    result = schema_enrichment.submit("ws-test", db_ref="mysql://biz", source_id="src-1")
+    assert result == {"status": "queued"}
+    job = _wait_job()
+    assert job["status"] == "complete", job
+    assert job["tables_total"] == 1 and job["tables_done"] == 1
+
+    assets = {a["title"]: a for a in store.list_assets()}
+    assert len(assets) == 4
+    status_col = assets["order_status"]
+    assert status_col["content"] == "订单履约生命周期状态"
+    assert "订单状态" in status_col["source"]["synonyms"] and "履约状态" in status_col["source"]["synonyms"]
+    assert status_col["source"]["enriched"]["model"] == "fake-derive-model"
+    # 口径建议并入候选内容
+    assert "COUNT(DISTINCT customer_name)" in assets["customer_name"]["content"]
+    # 提示词带样例值锚（防幻觉证据）
+    assert "delivered" in provider.prompts[0] and "张三" in provider.prompts[0]
+    # LLM 跳过的列：保留 L1 原始描述，仍标记已深化（一次判定不重试）
+    skipped = assets["order_dt"]
+    assert skipped["content"].startswith("疑似时间维度")
+    assert skipped["source"]["enriched"]["model"] == "fake-derive-model"
+
+    status = schema_enrichment.derivation_status("ws-test")
+    assert status["candidates"] == 4 and status["enriched"] == 4
+    assert status["status"] == "complete"
+
+
+def test_build_prompt_carries_skip_and_disambiguation_rules():
+    """提示词携带跳过规则（纯技术列不硬编）与实体消歧规则（同名列跨表不冲突）。"""
+    prompt = schema_enrichment._build_prompt(
+        "orders",
+        [{"column": "order_status", "column_type": "VARCHAR(32)"},
+         {"column": "phone", "column_type": "VARCHAR(20)"}],
+        {"order_status": ["delivered"], "phone": ["13800001234"]})
+    assert "SKIP columns" in prompt and "omit them from the output entirely" in prompt
+    assert "never a bare 手机号" in prompt
+    assert "Table: orders" in prompt
+    assert "- phone VARCHAR(20) — samples: 13800001234" in prompt
+
+
+def test_pending_tables_excludes_touched_candidates(monkeypatch, tmp_path):
+    """治理不变量：已深化 / 已编辑（revision>1）/ 已评审的候选不会被深化任务选中。"""
+    _prepare(monkeypatch, tmp_path)
+    from jiuwenswarm.channels.web.dataagent.knowledge.schema_candidates import derive_candidates
+    derive_candidates("mysql://biz")  # L1：4 条候选
+    assets = {a["title"]: a for a in store.list_assets()}
+    # 人工编辑（revision 递增）
+    store.update_candidate(assets["order_status"]["asset_id"], {"content": "人工定义"})
+    # 人工评审（approve）
+    store.transition(assets["customer_name"]["asset_id"], "approve")
+    # 已深化标记（模拟上一轮任务写回）
+    store.update_candidate(assets["refund_reason"]["asset_id"],
+                           {"source": {**assets["refund_reason"]["source"],
+                                       "enriched": {"model": "m", "at": "t", "version": "v1"}}})
+    pending = schema_enrichment._pending_tables()
+    assert [asset["title"] for assets_list in pending.values() for asset in assets_list] == ["order_dt"]
+    # 已编辑候选内容保持人工版本
+    assert store.get_asset(assets["order_status"]["asset_id"])["content"] == "人工定义"
+
+
+def test_timeout_stops_enrichment_and_keeps_partial(monkeypatch, tmp_path):
+    """任务级超时：逐表检查 deadline，超时保留已完成部分，状态可重试续跑。"""
+    _prepare(monkeypatch, tmp_path)
+    tables = dict(_TABLES)
+    tables["payments"] = [
+        {"name": "pay_id", "type": "BIGINT", "null": False, "pk": True},
+        {"name": "pay_channel", "type": "VARCHAR(16)", "null": True, "pk": False},
+    ]
+    tables["shipments"] = [
+        {"name": "ship_id", "type": "BIGINT", "null": False, "pk": True},
+        {"name": "ship_status", "type": "VARCHAR(16)", "null": True, "pk": False},
+    ]
+    from jiuwenswarm.channels.web.dataagent import db as dataagent_db
+    dataagent_db.db_connector.tables = lambda _ref: {"tables": list(tables)}
+    dataagent_db.db_connector.schema = lambda _ref, table: {"table": table, "columns": tables.get(table, [])}
+    monkeypatch.setenv("KNOWLEDGE_SCHEMA_ENRICH_TIMEOUT_S", "1")
+    provider = FakeProvider([EnrichmentResult(columns=[
+        EnrichedColumn(column="order_status", definition="订单履约生命周期状态"),
+        EnrichedColumn(column="customer_name", definition="下单客户姓名"),
+        EnrichedColumn(column="refund_reason", definition="退款原因"),
+        EnrichedColumn(column="order_dt", definition="订单日期"),
+        EnrichedColumn(column="pay_channel", definition="支付渠道"),
+        EnrichedColumn(column="ship_status", definition="配送状态"),
+    ])] * 10, delay=0.6)
+    _patch_provider(monkeypatch, provider)
+
+    schema_enrichment.submit("ws-test", db_ref="mysql://biz")
+    job = _wait_job(timeout=20)
+    assert job["status"] == "timeout", job
+    assert "可重试续跑" in job["error"]
+    # 部分成果保留：第 3 张表触发 deadline 前已完成 2 张
+    assert job["tables_done"] == 2 and job["tables_total"] == 3
+    enriched = sum(1 for a in store.list_assets() if (a.get("source") or {}).get("enriched"))
+    assert enriched >= 5  # orders(4) + payments(1) 已深化，shipments 未动
+
+
+def test_submit_rejects_duplicate_while_running(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    schema_enrichment._JOBS["ws-test"] = {"status": "running", "phase": "enrich"}
+    assert schema_enrichment.submit("ws-test") == {"status": "already_running"}
+
+
+def test_cancel_stops_enrichment_and_keeps_partial(monkeypatch, tmp_path):
+    """取消：cooperative 标志逐表检查，当前表完成后停止；已完成部分保留可续跑。
+
+    取消与超时同语义——任务落 cancelled 终态，重试不被 already_running 拒绝。
+    """
+    _prepare(monkeypatch, tmp_path)
+    tables = dict(_TABLES)
+    tables["payments"] = [
+        {"name": "pay_id", "type": "BIGINT", "null": False, "pk": True},
+        {"name": "pay_channel", "type": "VARCHAR(16)", "null": True, "pk": False},
+    ]
+    tables["shipments"] = [
+        {"name": "ship_id", "type": "BIGINT", "null": False, "pk": True},
+        {"name": "ship_status", "type": "VARCHAR(16)", "null": True, "pk": False},
+    ]
+    from jiuwenswarm.channels.web.dataagent import db as dataagent_db
+    dataagent_db.db_connector.tables = lambda _ref: {"tables": list(tables)}
+    dataagent_db.db_connector.schema = lambda _ref, table: {"table": table, "columns": tables.get(table, [])}
+    provider = FakeProvider([EnrichmentResult(columns=[
+        EnrichedColumn(column="order_status", definition="订单履约生命周期状态"),
+        EnrichedColumn(column="customer_name", definition="下单客户姓名"),
+        EnrichedColumn(column="refund_reason", definition="退款原因"),
+        EnrichedColumn(column="order_dt", definition="订单日期"),
+        EnrichedColumn(column="pay_channel", definition="支付渠道"),
+        EnrichedColumn(column="ship_status", definition="配送状态"),
+    ])] * 10, delay=0.6)
+    _patch_provider(monkeypatch, provider)
+
+    schema_enrichment.submit("ws-test", db_ref="mysql://biz")
+    # 等第一张表完成后再取消：验证「表间生效」而非立即中断
+    wait_deadline = time.time() + 10
+    while time.time() < wait_deadline:
+        job = schema_enrichment.job_status("ws-test")
+        if job and job.get("tables_done", 0) >= 1:
+            break
+        time.sleep(0.02)
+    assert schema_enrichment.cancel("ws-test") == {"status": "cancelling"}
+
+    job = _wait_job(timeout=20)
+    assert job["status"] == "cancelled", job
+    assert "可重试续跑" in job["error"]
+    # 部分成果保留：至少 1 张表深化完成、但未跑完全部
+    enriched = sum(1 for a in store.list_assets() if (a.get("source") or {}).get("enriched"))
+    assert 0 < enriched < 8
+    # 取消是终态：重试（重新 submit）不被 already_running 拒绝（线程 no-op 防串线程）
+    monkeypatch.setattr(schema_enrichment, "_run", lambda *args, **kwargs: None)
+    assert schema_enrichment.submit("ws-test", db_ref="mysql://biz") == {"status": "queued"}
+
+
+def test_cancel_without_running_job():
+    """无任务 / 已终态时取消返回 not_running。"""
+    schema_enrichment._JOBS.clear()
+    assert schema_enrichment.cancel("ws-test") == {"status": "not_running"}
+    schema_enrichment._JOBS["ws-test"] = {"status": "complete"}
+    assert schema_enrichment.cancel("ws-test") == {"status": "not_running"}
