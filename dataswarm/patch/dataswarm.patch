+
+    out = fr.review_all({"schema": path})
+    # drift 跳过不计入 total_reviewed；naming 复核
+    assert out["skipped_review"] == 1
+    assert out["total_reviewed"] == 1
+    # 只有 naming 被调 LLM（1 条 → 1 次调用）
+    assert client.calls == [1]
+
+    payload = json.loads(Path(path).read_text(encoding="utf-8"))
