+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""semantic/repository.py 维值字典持久化单测（阶段 A：dw_semantic_value_dict）。
+
+覆盖：save 幂等（同快照重跑先清后插）、purge 旧快照清理、recall 全等/子串
+分档与 NFKC 归一化匹配、LIKE 通配符转义、触顶截断。
+"""
+from __future__ import annotations
+
+import sqlite3
+from datetime import datetime, timedelta
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.semantic import repository
+from jiuwenswarm.channels.web.dataagent.semantic.model import DataSourceMeta, MetadataSnapshot
+
+
+def _snapshot(source_id="src", snapshot_id="snap-1", status="published"):
+    snapshot = MetadataSnapshot(snapshot_id, f"run-{snapshot_id}", DataSourceMeta(source_id, "csv", ""))
+    repository.save_snapshot(snapshot, status)
+    return snapshot
+
+
+@pytest.fixture()
+def published_snapshot(semantic_db):
+    return _snapshot()
+
+
+@pytest.fixture()
+def dict_rows():
+    # value_id 由 save_value_dict 内部按 (snapshot_id, column_id, value_text) 生成
+    return [
+        {
+            "column_id": "col:mysql:src:shop.orders.region",
+            "table_id": "tbl:mysql:src:shop.orders",
+            "value_text": "华东",
+            "value_norm": "华东",
+        },
+        {
+            "column_id": "col:mysql:src:shop.orders.region",
+            "table_id": "tbl:mysql:src:shop.orders",
+            "value_text": "SP",
+            "value_norm": "sp",
+        },
+        {
+            "column_id": "col:mysql:src:shop.orders.status",
+            "table_id": "tbl:mysql:src:shop.orders",
+            "value_text": "paid",
+            "value_norm": "paid",
+        },
+    ]
+
+
+def test_save_and_recall_exact_then_substring(published_snapshot, dict_rows):
+    written = repository.save_value_dict("src", "snap-1", dict_rows)
+    assert written == 3
+
+    # 全等命中置顶（NFKC+lower 归一化：SP → sp）
+    hits = repository.recall_value_dict("src", "SP")
+    assert [h["value_text"] for h in hits] == ["SP"]
+
+    # 子串命中（"paid" 查 "ai"）
+    hits = repository.recall_value_dict("src", "ai")
+    assert [h["value_text"] for h in hits] == ["paid"]
+    assert hits[0]["match_type"] == "substring"
