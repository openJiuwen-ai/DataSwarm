+           "FROM orders WHERE orders.pay_status = 'paid' "
+           "AND orders.paid_at >= '2026-07-01' AND orders.paid_at < '2026-10-01' "
+           "GROUP BY orders.region ORDER BY gmv_cny DESC")
+    result = checks.check_request({
+        "sql": sql,
+        "selected": [{"metric_key": "commerce.gmv"},
+                     {"metric_key": "commerce.paid_order_count"}]})
+    assert _check_of(result, "scope_membership")["status"] == "pass"
+    assert _check_of(result, "tables_columns_subset_binding")["status"] == "pass"
+    # G 等级不因别名引用误降
+    assert result["grounding_level"] == "G1"
