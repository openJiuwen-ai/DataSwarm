diff --git a/jiuwenswarm/channels/web/frontend/tests/metric-type-parse.test.mjs b/jiuwenswarm/channels/web/frontend/tests/metric-type-parse.test.mjs
new file mode 100644
index 000000000..66535304d
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/metric-type-parse.test.mjs
@@ -0,0 +1,90 @@
+/** metric-type-parse: MetricDef JSON 字段解析 helper 单测（node --test，esbuild 转译）。 */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const require = createRequire(import.meta.url);
+
+// 对齐 test:governance-session-store 的转译思路：esbuild 打包 TS → node 直接消费。
+// 用 JS API（buildSync）而非 CLI：Windows 下 bin 文件 spawn 需 .exe 后缀，不可靠。
+const srcPath = path.resolve(here, '../src/features/dashboard/types/dashboard.ts');
+const esbuild = require('esbuild');
+const result = esbuild.buildSync({
+  entryPoints: [srcPath],
+  bundle: true,
+  platform: 'node',
+  format: 'esm',
+  write: false,
+});
+const transpiled = result.outputFiles[0].text;
+
+// 被测模块 import 了 datasourceWorkspaceStore（其依赖 window 等浏览器全局），
+// 这里只取纯函数：从转译产物里提取三个 helper 的源码再 eval（纯 JSON 处理，无副作用）
+
+function extractFunction(name) {
+  const marker = `function ${name}(`;
+  const start = transpiled.indexOf(marker);
+  assert.ok(start > 0, `function ${name} not found in bundle`);
+  let depth = 0, i = transpiled.indexOf('{', start), end = i;
+  for (; i < transpiled.length; i++) {
+    if (transpiled[i] === '{') depth++;
+    if (transpiled[i] === '}') { depth--; if (depth === 0) { end = i + 1; break; } }
+  }
+  return transpiled.slice(start, end);
+}
+
+const helpers = new Function(`
+  ${extractFunction('parseDimensionIds')}
+  ${extractFunction('parseVerifiedQueries')}
+  ${extractFunction('parseBindingColumns')}
+  return { parseDimensionIds, parseVerifiedQueries, parseBindingColumns };
+`)();
+
+const { parseDimensionIds, parseVerifiedQueries, parseBindingColumns } = helpers;
+
+test('parseDimensionIds: 正常数组', () => {
+  assert.deepEqual(parseDimensionIds({ dimension_ids: '["dim_a","dim_b"]' }), ['dim_a', 'dim_b']);
+});
+
+test('parseDimensionIds: null/undefined/空串 → 空数组', () => {
+  assert.deepEqual(parseDimensionIds({}), []);
+  assert.deepEqual(parseDimensionIds({ dimension_ids: null }), []);
+  assert.deepEqual(parseDimensionIds({ dimension_ids: '' }), []);
+});
+
+test('parseDimensionIds: 非法 JSON → 空数组（不抛）', () => {
+  assert.deepEqual(parseDimensionIds({ dimension_ids: '{not json' }), []);
+});
+
+test('parseDimensionIds: 非数组 JSON → 空数组', () => {
+  assert.deepEqual(parseDimensionIds({ dimension_ids: '{"a":1}' }), []);
+});
+
+test('parseVerifiedQueries: 正常数组', () => {
+  assert.deepEqual(
+    parseVerifiedQueries({ verified_sql_json: '[{"q":"上月GMV","sql":"SELECT 1"}]' }),
+    [{ q: '上月GMV', sql: 'SELECT 1' }]);
+});
+
+test('parseVerifiedQueries: 非数组 JSON → 空数组', () => {
+  assert.deepEqual(parseVerifiedQueries({ verified_sql_json: '{"a":1}' }), []);
+});
+
+test('parseVerifiedQueries: null → 空数组', () => {
+  assert.deepEqual(parseVerifiedQueries({ verified_sql_json: null }), []);
+});
+
+test('parseBindingColumns: 正常数组', () => {
+  assert.deepEqual(parseBindingColumns({ source_columns: '["price","dt"]' }), ['price', 'dt']);
+});
+
+test('parseBindingColumns: null → 空数组', () => {
+  assert.deepEqual(parseBindingColumns({ source_columns: null }), []);
+});
+
+test('parseBindingColumns: 非法 JSON → 空数组', () => {
+  assert.deepEqual(parseBindingColumns({ source_columns: '[broken' }), []);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/navRemountKey.test.mjs b/jiuwenswarm/channels/web/frontend/tests/navRemountKey.test.mjs
new file mode 100644
index 000000000..9461a4aea
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/navRemountKey.test.mjs
@@ -0,0 +1,52 @@
+// 管理页 App 挂载必须带 key={`前缀-${dsWorkspaceId}`}（P2-1 切换语义，第二轮重构台账 A-7）。
+// 语义：切工作空间 = 整页重挂载（清模块级缓存、断在途请求）。AnalysisTraceApp 曾是
+// 9 页里唯一漏 key 的——切空间后展示旧空间列表。新管理页接入时本测试强制登记。
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const appPath = join(dirname(fileURLToPath(import.meta.url)), '..', 'src', 'App.tsx');
+const source = readFileSync(appPath, 'utf8');
+
+// 已登记的管理页（新页面接入须同步本清单并带 key）
+const NAV_APPS = [
+  'GovernanceApp', 'DataManagementApp', 'DataSourceApp', 'DataAssetApp',
+  'DashboardApp', 'MetricsV2App', 'GlossaryApp', 'KnowledgeApp', 'AnalysisTraceApp',
+];
+
+function mountTags(name) {
+  // 只匹配 JSX 挂载（import 行不含 '<'）；跨行属性用 [\s\S] 非贪婪到自闭合
+  return [...source.matchAll(new RegExp(`<${name}\\b[\\s\\S]*?/>`, 'g'))].map((m) => m[0]);
+}
+
+test('每个已登记管理页的挂载都带工作空间 key', () => {
+  for (const name of NAV_APPS) {
+    const tags = mountTags(name);
+    assert.ok(tags.length >= 1, `${name} 应在 App.tsx 挂载`);
+    for (const tag of tags) {
+      assert.ok(
+        tag.includes('key={`') && tag.includes('${dsWorkspaceId}'),
+        `${name} 挂载缺工作空间 key（切空间不会重挂载）: ${tag}`,
+      );
+    }
+  }
+});
+
+test('新增管理页挂载必须登记进 NAV_APPS（防无 key 新页混入）', () => {
+  const lines = source.split('\n');
+  const seen = new Set();
+  lines.forEach((line, idx) => {
+    // 跳过注释行（如「若这里 return <XxxApp />」的说明文字）
+    const before = line.split('//')[0];
+    for (const m of before.matchAll(/<([A-Z][A-Za-z0-9]*App)\b/g)) {
+      seen.add(m[1]);
+    }
+  });
+  const unregistered = [...seen].filter((name) => !NAV_APPS.includes(name));
+  assert.deepEqual(
+    unregistered, [],
+    `发现未登记的 *App 挂载：${unregistered}——要么补 key={...-${'${dsWorkspaceId}'}} 并登记 NAV_APPS，要么确认非管理页`,
+  );
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/promptSuggestions.test.mjs b/jiuwenswarm/channels/web/frontend/tests/promptSuggestions.test.mjs
