+          borderRadius: 6,
+          background: data.layerColor,
+          color: 'var(--color-text-inverse)',
+        }}
+      >
+        <TableGlyph width={13} height={13} />
+      </span>
+      <span style={{ minWidth: 0, flex: '1 1 auto' }}>
+        <span
+          title={data.label}
+          style={{
+            display: 'block',
+            overflow: 'hidden',
+            color: 'var(--color-text-strong)',
+            fontSize: 12,
+            fontWeight: 600,
+            lineHeight: '18px',
+            textOverflow: 'ellipsis',
+            whiteSpace: 'nowrap',
+          }}
+        >
+          {data.label}
+        </span>
+        {data.rowCount != null && (
+          <span style={{ display: 'block', color: 'var(--color-text-secondary)', fontSize: 10, lineHeight: '14px' }}>
+            {t('lineageGraph.rows', { value: data.rowCount.toLocaleString(i18n.language) })}
+          </span>
+        )}
+      </span>
+      <span
+        style={{
+          display: 'inline-flex',
+          flex: '0 0 auto',
+          alignItems: 'center',
+          gap: 4,
+          color: 'var(--color-text-secondary)',
+          fontSize: 10,
+          lineHeight: '14px',
+          whiteSpace: 'nowrap',
+        }}
+      >
+        <Database size={12} aria-hidden="true" />
+        {data.layer === 'OTHER' ? t('lineageGraph.otherLayer') : data.layer}
+      </span>
+      {data.isRootCause && <span className="lineage-graph-root-cause">{t('lineageGraph.rootCause')}</span>}
+      <Handle
+        type="source"
+        position={Position.Right}
+        isConnectable={false}
+        style={{ opacity: 0, pointerEvents: 'none' }}
+      />
+    </div>
+  );
+}
+
+const nodeTypes = { lineage: LineageNodeCard };
+
+interface LineageGraphProps {
+  nodes: LineageNode[];
+  edges: LineageEdge[];
+  layerFilter?: ReadonlySet<string>;
+  searchTerm?: string;
+  selected: string;
+  onSelect: (table: string) => void;
+  rootCauseTables?: ReadonlySet<string>;
+  controlsPosition?: PanelPosition;
+  extraControls?: ReactNode;
+}
+
+function LineageGraphInner({
+  nodes,
+  edges,
+  layerFilter,
+  searchTerm = '',
+  selected,
+  onSelect,
+  rootCauseTables,
+  controlsPosition = 'bottom-left',
+  extraControls,
+}: LineageGraphProps) {
+  const { t } = useTranslation();
+  const filteredNodes = useMemo(
+    () => nodes.filter((n) => !layerFilter || layerFilter.has(n.layer ?? 'OTHER')),
+    [nodes, layerFilter],
+  );
+  const filteredNodeIds = useMemo(() => new Set(filteredNodes.map((n) => n.table)), [filteredNodes]);
+  const visibleEdges = useMemo(
+    () => edges.filter((e) => filteredNodeIds.has(e.from) && filteredNodeIds.has(e.to)),
+    [edges, filteredNodeIds],
+  );
+
+  const nodePos = useMemo(() => computeLineageLayout(filteredNodes, visibleEdges).positions, [filteredNodes, visibleEdges]);
+  // 受控 nodes 下拖拽需自行落位：onNodesChange 把 position change 写进覆盖表，
+  // 否则 flowNodes 每次由 nodePos 重算，拖拽位移会被立即打回。数据刷新时回到自动布局。
+  const dragOverrides = useRef(new Map<string, { x: number; y: number }>());
+  const [posVersion, bumpPositions] = useReducer((n: number) => n + 1, 0);
+  const onNodesChange = useCallback((changes: NodeChange<LineageFlowNode>[]) => {
+    let moved = false;
+    for (const change of changes) {
+      if (change.type === 'position' && change.position) {
+        dragOverrides.current.set(change.id, change.position);
+        moved = true;
+      }
+    }
+    if (moved) bumpPositions();
+  }, []);
+  const downstream = useMemo(() => buildDownstreamMap(visibleEdges), [visibleEdges]);
+  const upstream = useMemo(() => buildUpstreamMap(visibleEdges), [visibleEdges]);
+
+  const searchMatches = useMemo(() => {
+    if (!searchTerm) return new Set<string>();
+    const low = searchTerm.toLowerCase();
+    return new Set(nodes.filter((n) => n.table.toLowerCase().includes(low)).map((n) => n.table));
+  }, [nodes, searchTerm]);
+
+  const highlightSet = useMemo(() => {
+    if (selected) return new Set<string>([...bfs(selected, downstream), ...bfs(selected, upstream)]);
+    if (searchMatches.size) return searchMatches;
+    return new Set<string>();
+  }, [selected, downstream, upstream, searchMatches]);
+
+  const hasSelection = Boolean(searchTerm) || highlightSet.size > 0;
+
+  const flowNodes = useMemo<LineageFlowNode[]>(
+    () =>
+      filteredNodes.map((n) => {
+        const layer = n.layer ?? 'OTHER';
+        return {
+          id: n.table,
+          type: 'lineage',
+          position: dragOverrides.current.get(n.table) ?? nodePos.get(n.table)!,
+          selected: selected === n.table,
+          data: {
+            label: n.table,
+            layer,
+            rowCount: n.rowcount,
+            layerColor: LAYER_COLOR[layer] ?? FALLBACK_LAYER_COLOR,
+            isSelected: selected === n.table,
+            isRootCause: rootCauseTables?.has(n.table) ?? false,
+            dim: hasSelection && !highlightSet.has(n.table),
+            onSelect,
+          },
+        };
+      }),
+    [filteredNodes, nodePos, posVersion, selected, hasSelection, highlightSet, rootCauseTables, onSelect],
+  );
+
+  const flowEdges = useMemo<Edge[]>(
+    () =>
+      visibleEdges.map((e, index) => {
+        const onPath = hasSelection && highlightSet.has(e.from) && highlightSet.has(e.to);
+        const onRootCause = rootCauseTables?.has(e.from) && rootCauseTables.has(e.to);
+        const color = onRootCause ? 'var(--color-feedback-danger)' : onPath ? 'var(--color-border-focus)' : '#94a3b8';
+        return {
+          id: JSON.stringify([e.from, e.to, index]),
+          source: e.from,
+          target: e.to,
+          ariaLabel: t('lineageGraph.edge', { source: e.from, target: e.to }),
+          style: {
+            stroke: color,
+            strokeWidth: onPath ? 2 : 1.5,
+            strokeDasharray: onRootCause ? '6 4' : undefined,
+            opacity: hasSelection && !onPath ? 0.15 : 1,
+          },
+          markerEnd: { type: MarkerType.ArrowClosed, color },
+        };
+      }),
+    [visibleEdges, hasSelection, highlightSet, rootCauseTables, t],
+  );
+
+  const onNodeClick = useCallback(
+    (_: unknown, node: Node) => onSelect(node.id === selected ? '' : node.id),
+    [onSelect, selected],
+  );
+
+  const onPaneClick = useCallback(() => {
+    if (selected) onSelect('');
+  }, [onSelect, selected]);
+
+  return (
+    <ReactFlow
+      className="lineage-graph"
+      nodes={flowNodes}
+      edges={flowEdges}
+      nodeTypes={nodeTypes}
+      onNodeClick={onNodeClick}
+      onPaneClick={onPaneClick}
+      onNodesChange={onNodesChange}
+      onKeyDown={(event) => {
+        if (event.key === 'Escape') onSelect('');
+      }}
+      nodesDraggable
+      nodesFocusable={false}
+      nodesConnectable={false}
+      edgesReconnectable={false}
+      deleteKeyCode={null}
+      elementsSelectable
+      panOnDrag
+      // 滚轮缩放整图；preventScrolling 拦截 wheel 冒泡，避免同时滚动页面
+      zoomOnScroll
+      preventScrolling
+      minZoom={0.05}
+      maxZoom={2}
+      fitView
+      fitViewOptions={{ padding: 0.15 }}
+      proOptions={{ hideAttribution: true }}
+      aria-label={t('lineageGraph.graph')}
+      ariaLabelConfig={{
+        'node.a11yDescription.default': t('lineageGraph.nodeKeyboard'),
+        'node.a11yDescription.keyboardDisabled': t('lineageGraph.nodeKeyboard'),
+        'edge.a11yDescription.default': t('lineageGraph.edgeKeyboard'),
+        'handle.ariaLabel': t('lineageGraph.handle'),
+        'controls.ariaLabel': t('lineageGraph.controls'),
+        'controls.zoomIn.ariaLabel': t('lineageGraph.zoomIn'),
+        'controls.zoomOut.ariaLabel': t('lineageGraph.zoomOut'),
+        'controls.fitView.ariaLabel': t('lineageGraph.fitView'),
+      }}
+    >
+      <Background variant={BackgroundVariant.Dots} gap={20} size={1} />
+      <Controls
+        className="lineage-graph-controls"
+        position={controlsPosition}
+        showInteractive={false}
+        aria-label={t('lineageGraph.controls')}
+      >
+        {extraControls}
+      </Controls>
+    </ReactFlow>
+  );
+}
+
+export function LineageGraph(props: LineageGraphProps) {
+  return (
+    <ReactFlowProvider>
+      <LineageGraphInner {...props} />
+    </ReactFlowProvider>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/_shared/lineage/columnLineageModel.ts b/jiuwenswarm/channels/web/frontend/src/features/_shared/lineage/columnLineageModel.ts
