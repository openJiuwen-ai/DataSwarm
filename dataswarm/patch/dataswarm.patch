+    conn = sqlite_store._connect()
+    conn.executemany(
+        "INSERT INTO table_lineage VALUES (?,?,?,?,?,?,?,?,?,?,?,?)", rows)
+    conn.commit()
+    conn.close()
+
+
+class TestSqliteStoreBusinessRefFilter:
+    def test_matching_ref_returned(self, lineage_db):
+        _insert(lineage_db, [_row("l1", "doris://hosta:9030/olist")])
+        rows = lineage_db.list_table_lineage(
+            "olist", business_ref="doris://hosta:9030/olist")
+        assert len(rows) == 1
+        assert rows[0]["source_table"] == "dwd_a"
