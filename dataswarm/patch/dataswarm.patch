+    assert result["graph"]["status"] == "ok"            # 对账本身成功
+    assert result["metric_reproject"]["status"] == "failed"
+    assert "neo4j unreachable" in result["metric_reproject"]["reason"]
+
+
+def test_reconcile_skips_reproject_without_published_metrics(term_db, monkeypatch):
+    """没有已发布指标 → skipped（不是错误，不该记 failed）。"""
+    from jiuwenswarm.channels.web.dataagent.metrics import graph_projection
+
+    def _unavailable(ws, **kw):
+        raise graph_projection.ProjectionUnavailableError("workspace default 没有已发布指标")
+
+    monkeypatch.setattr(graph_projection, "reproject_workspace", _unavailable)
+    _make_term()
+    result = sync.reconcile()
+    assert result["metric_reproject"]["status"] == "skipped"
diff --git a/tests/unit_tests/dataagent/test_knowledge_extraction_jobs.py b/tests/unit_tests/dataagent/test_knowledge_extraction_jobs.py
new file mode 100644
index 000000000..87c545bef
--- /dev/null
+++ b/tests/unit_tests/dataagent/test_knowledge_extraction_jobs.py
@@ -0,0 +1,87 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+import threading
+import time
+from pathlib import Path
+
+from jiuwenswarm.channels.web.dataagent.knowledge import documents, extraction_jobs, store
+
+
+def _prepare(monkeypatch, tmp_path: Path) -> None:
+    db_path = tmp_path / "knowledge.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR",
+                       str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(f"sqlite://{db_path}")
+    monkeypatch.setattr(store, "_workspace", lambda: "ws-test")
+    # 后台线程没有请求上下文：测试里不解析真实 datasource.yaml
+    monkeypatch.setattr(extraction_jobs.workspace_context, "set_current", lambda _wid: None)
+    documents._persist_document(
+        {"document_id": "doc-test", "version_id": "dv-test", "text": "source evidence",
+         "evidence": [{"evidence_id": "ev-test", "start": 0, "end": 15}],
+         "source": {"source_id": "source-test", "name": "fixture.md", "sha256": "hash"},
+         "metadata": {}, "quality": {}})
+
+
+def _wait(predicate, timeout: float = 3.0) -> bool:
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        if predicate():
+            return True
+        time.sleep(0.01)
+    return False
+
+
+def test_submit_queues_and_worker_marks_complete(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    calls: list[str] = []
+
+    def fake_extract(version_id: str):
+        calls.append(version_id)
+        document = documents.get_document(version_id)
+        document.setdefault("extraction", {})["status"] = "complete"
+        documents._save_extraction(document)
+        return {"version_id": version_id, "candidates": []}
+
+    monkeypatch.setattr(documents, "extract_candidates", fake_extract)
+    result = extraction_jobs.submit_extraction(["dv-test"])
+    assert result["queued"] == ["dv-test"] and result["skipped"] == []
+    assert _wait(lambda: calls == ["dv-test"])
+    assert _wait(lambda: not extraction_jobs.is_pending("default", "dv-test"))
+    assert documents.get_document("dv-test")["extraction"]["status"] == "complete"
+
+
+def test_submit_skips_unknown_document_and_duplicate_submission(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    release = threading.Event()
+    started = threading.Event()
+
+    def blocking_extract(version_id: str):
+        started.set()
+        release.wait(3)
+        document = documents.get_document(version_id)
+        document.setdefault("extraction", {})["status"] = "complete"
+        documents._save_extraction(document)
+
+    monkeypatch.setattr(documents, "extract_candidates", blocking_extract)
+    first = extraction_jobs.submit_extraction(["dv-test", "dv-missing"])
+    assert first["queued"] == ["dv-test"]
+    assert first["skipped"] == [{"version_id": "dv-missing", "reason": "not_found"}]
+    assert _wait(started.is_set)
+    second = extraction_jobs.submit_extraction(["dv-test"])
+    assert second["queued"] == []
+    assert second["skipped"] == [{"version_id": "dv-test", "reason": "already_running"}]
+    release.set()
+    assert _wait(lambda: not extraction_jobs.is_pending("default", "dv-test"))
+
+
+def test_stale_running_status_is_reported_as_failed(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    document = documents.get_document("dv-test")
+    document["extraction"] = {"status": "running"}
+    documents._save_extraction(document)
+    row = next(r for r in documents.list_documents() if r["version_id"] == "dv-test")
+    assert row["extraction_status"] == "failed"
+    assert "服务重启" in row["extraction_error"]
diff --git a/tests/unit_tests/dataagent/test_knowledge_retention.py b/tests/unit_tests/dataagent/test_knowledge_retention.py
