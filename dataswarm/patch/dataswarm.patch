+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type {
+  AnalysisComponent,
+  AnalysisManifest,
+  ComponentAttempt,
+  LlmTraceEntry,
+} from './api/analysisTraceApi';
+
+export function authorityLabel(attempt: ComponentAttempt): string {
+  if (attempt.authoritative === true) return '权威编译口径';
+  if (attempt.authoritative === false) return '参考/探索口径，未经确定性语义验证';
+  return '历史记录未声明权威性';
+}
+
+export function explorationLimit(component: AnalysisComponent): number {
+  return component.required === false ? 1 : 3;
+}
+
+export function attemptLabel(attempt: ComponentAttempt): string {
+  if (attempt.kind === 'check') return '程序化检查（scope + 口径一致性）';
+  if (attempt.kind === 'compile') return attempt.error ? 'G1 编译执行（失败）' : 'G1 编译执行';
+  return attempt.error ? '统一执行（失败）' : '统一执行';
+}
+
+// ==========================================================================
+// LLM 参与步骤（llm_trace）——统计与事件级匹配（analysis_flow.py 同侧契约）
+// ==========================================================================
+
+export interface LlmTraceStats {
+  decision: number;
+  generation: number;
+  deterministic: number;
+  total: number;
+}
+
+export function llmTraceStats(entries: LlmTraceEntry[]): LlmTraceStats {
+  const stats: LlmTraceStats = { decision: 0, generation: 0, deterministic: 0, total: entries.length };
+  for (const entry of entries) {
+    if (entry.llm_role === 'decision') stats.decision += 1;
+    else if (entry.llm_role === 'generation') stats.generation += 1;
+    else stats.deterministic += 1;
+  }
+  return stats;
+}
+
+/** 详情页头部行：一行讲清「哪些步骤是 LLM、其余确定性」；未采集回落占位 */
+export function llmHeaderLabel(manifest: AnalysisManifest): string {
+  const entries = manifest.llm_trace ?? [];
+  if (entries.length === 0) return 'LLM 未采集';
+  const stats = llmTraceStats(entries);
+  return `LLM 参与 ${stats.total} 步（决策 ${stats.decision} · 生成 ${stats.generation}；其余步骤确定性执行）`;
+}
+
+function parsedOutput(entry: LlmTraceEntry): Record<string, unknown> {
+  try {
+    return JSON.parse(entry.ai_output ?? '{}') as Record<string, unknown>;
+  } catch {
+    return {};
+  }
+}
+
+/** llm_trace 的 JSON 文本缩进美化；不可解析时原样返回（如已截断的片段） */
+export function prettyJsonText(text: string): string {
+  try {
+    return JSON.stringify(JSON.parse(text), null, 2);
+  } catch {
+    return text;
+  }
+}
+
+/** explore_rounds 的 tool 名 → llm_trace step 名（未知工具走 trace 通道按 tool 匹配） */
+export function exploreToolToStep(tool: string): string {
+  if (tool === 'recall_more') return 'context';
+  if (tool === 'probe_values') return 'probe';
+  if (tool === 'check_join') return 'join';
+  if (tool === 'list_tables') return 'list-tables';
+  if (tool === 'describe_table') return 'describe';
+  return 'trace';
+}
+
+/** trace 通道里带 decision 的条目——与 sufficiency_trace 按下标逐条对齐 */
+export function traceDecisionEntries(entries: LlmTraceEntry[], componentId: string): LlmTraceEntry[] {
+  return entries.filter((entry) => entry.step === 'trace'
+    && (entry.component_id ?? '') === (componentId ?? '')
+    && 'decision' in parsedOutput(entry));
+}
+
+/** 探索轮事件的匹配条目：已知 tool 映射到对应命令 step；未知 tool 走 trace 通道按 ai_output.tool 精确匹配 */
+export function llmEntriesForExplore(entries: LlmTraceEntry[], componentId: string, tool: string): LlmTraceEntry[] {
+  const step = exploreToolToStep(tool);
+  const matched = entries.filter((entry) => entry.step === step
+    && (entry.component_id ?? '') === (componentId ?? ''));
+  if (step !== 'trace') return matched;
+  return matched.filter((entry) => parsedOutput(entry).tool === tool);
+}
+
+/** 按 step+component_id 过滤取第 index 条（0 起）；越界返回 undefined */
+export function matchLlmEntry(
+  entries: LlmTraceEntry[],
+  opts: { step: string; componentId?: string; index?: number },
+): LlmTraceEntry | undefined {
+  const matched = entries.filter((entry) => entry.step === opts.step
+    && (opts.componentId === undefined
+      ? entry.component_id === undefined
+      : (entry.component_id ?? '') === opts.componentId));
+  return opts.index === undefined ? matched[0] : matched[opts.index];
+}
