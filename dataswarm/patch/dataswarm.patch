+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import { useEffect, useState } from 'react';
+import { Check, Copy, Key, Loader2 } from 'lucide-react';
+import RowCountIcon from '../../../../assets/data-management/row-count.svg?react';
+import FieldCountIcon from '../../../../assets/data-management/field-count.svg?react';
+import IndexCountIcon from '../../../../assets/data-management/index-count.svg?react';
+import ForeignKeyCountIcon from '../../../../assets/data-management/foreign-key-count.svg?react';
+import { CodePreview } from '../../../../components/ArtifactsPanel/CodePreview';
+import { Table, Pagination } from '../../../../components/ui';
+import { useDataManagementStore, type DetailTab as Tab } from '../../store/dataManagementStore';
+import { DataPreview } from './DataPreview';
+import { LineageView } from './LineageView';
+
+export function TableDetailPanel() {
+  const { t } = useTranslation();
+  const { tableDetail, detailLoading, loading, error, detailTab: tab, setDetailTab: setTab } = useDataManagementStore();
+  const [copied, setCopied] = useState(false);
+  const [columnsPage, setColumnsPage] = useState(1);
+  const [columnsPageSize, setColumnsPageSize] = useState(10);
+
+  // 切换表时字段分页回到第一页
+  useEffect(() => setColumnsPage(1), [tableDetail?.name]);
+
+  if (detailLoading || (loading && !tableDetail)) {
+    return (
+      <div className="dm-detail-loading" role="status" aria-busy="true" aria-label={t('dataManagement.loading')}>
+        <Loader2 size={28} className="animate-spin text-text-muted" aria-hidden="true" />
+      </div>
+    );
+  }
+  if (error) return <div className="dm-empty-state">{error}</div>;
+  if (!tableDetail) return <div className="dm-empty-state">{t('dataManagement.selectTable')}</div>;
+
+  const tabs: Array<[Tab, string]> = [
+    ['overview', t('dataManagement.tabs.overview')],
+    ['columns', t('dataManagement.tabs.columns')],
+    ['ddl', t('dataManagement.tabs.ddl')],
+    ['lineage', t('dataManagement.tabs.lineage')],
+  ];
+
+  const handleCopy = () => {
+    navigator.clipboard.writeText(tableDetail.ddl);
+    setCopied(true);
+    setTimeout(() => setCopied(false), 2000);
+  };
+
+  return (
+    <div className="dm-detail">
+      <h2 className="dm-head-title">{tableDetail.name}</h2>
+      {tableDetail.comment ? <p className="dm-head-desc">{tableDetail.comment}</p> : null}
+
+      <nav className="dm-tabs" aria-label={t('dataManagement.nodeDetails.title')}>
+        {tabs.map(([key, label]) => (
+          <button key={key} type="button" aria-current={tab === key ? 'page' : undefined} onClick={() => setTab(key)}>
+            {label}
+          </button>
+        ))}
+      </nav>
+
+      <div className="dm-content">
+        {tab === 'overview' && (
+          <>
+            <div className="dm-stat-grid">
+              <div className="dm-stat">
+                <span className="dm-stat-icon" data-kind="rows">
+                  <RowCountIcon width={18} height={18} aria-hidden="true" />
+                </span>
+                <div>
+                  <div className="dm-stat-label">{t('dataManagement.stats.rows')}</div>
+                  <div className="dm-stat-value">{tableDetail.row_count ?? '—'}</div>
+                </div>
+              </div>
+              <div className="dm-stat">
+                <span className="dm-stat-icon" data-kind="columns">
+                  <FieldCountIcon width={18} height={18} aria-hidden="true" />
+                </span>
+                <div>
+                  <div className="dm-stat-label">{t('dataManagement.stats.columns')}</div>
+                  <div className="dm-stat-value">{tableDetail.columns.length}</div>
+                </div>
+              </div>
+              <div className="dm-stat">
+                <span className="dm-stat-icon" data-kind="indexes">
+                  <IndexCountIcon width={18} height={18} aria-hidden="true" />
+                </span>
+                <div>
+                  <div className="dm-stat-label">{t('dataManagement.stats.indexes')}</div>
+                  <div className="dm-stat-value">
+                    {tableDetail.indexes_supported === false ? '—' : tableDetail.indexes.length}
+                  </div>
+                </div>
+              </div>
+              <div className="dm-stat">
+                <span className="dm-stat-icon" data-kind="fkeys">
+                  <ForeignKeyCountIcon width={18} height={18} aria-hidden="true" />
+                </span>
+                <div>
+                  <div className="dm-stat-label">{t('dataManagement.stats.foreignKeys')}</div>
+                  <div className="dm-stat-value">
+                    {tableDetail.foreign_keys_supported === false ? '—' : tableDetail.foreign_keys.length}
+                  </div>
+                </div>
+              </div>
+            </div>
+            <h3 className="dm-preview-title">{t('dataManagement.preview.title')}</h3>
+            <DataPreview />
+          </>
+        )}
+
+        {tab === 'columns' && (
+          <>
+            <Table
+              className="dm-table-wrap"
+              headers={[
+                t('dataManagement.columns.name'),
+                t('dataManagement.columns.type'),
+                t('dataManagement.columns.nullable'),
+                t('dataManagement.columns.primaryKey'),
+                t('dataManagement.columns.default'),
+              ]}
+            >
+              {tableDetail.columns
+                .slice((columnsPage - 1) * columnsPageSize, columnsPage * columnsPageSize)
+                .map((col) => (
+                  <tr key={col.name}>
+                    <td style={{ fontWeight: 500 }}>{col.name}</td>
+                    <td>
+                      <span className="dm-type-badge">{col.type}</span>
+                    </td>
+                    <td>
+                      <span aria-label={t(col.nullable ? 'dataManagement.yes' : 'dataManagement.no')}>
+                        {col.nullable ? '✓' : '✗'}
+                      </span>
+                    </td>
+                    <td>
+                      {col.primary_key ? (
+                        <Key
+                          size={12}
+                          className="dm-pk-icon dm-pk-mirror"
+                          aria-label={t('dataManagement.columns.primaryKey')}
+                        />
+                      ) : (
+                        ''
+                      )}
+                    </td>
+                    <td title={col.default_value ?? undefined}>
+                      {col.default_value ?? <span className="dm-cell-null">—</span>}
+                    </td>
+                  </tr>
+                ))}
+            </Table>
+            <Pagination
+              total={tableDetail.columns.length}
+              page={columnsPage}
+              pageSize={columnsPageSize}
+              onPageChange={setColumnsPage}
+              onPageSizeChange={(size) => {
+                setColumnsPageSize(size);
+                setColumnsPage(1);
+              }}
+              labels={{
+                total: t('common.pagination.total', { count: tableDetail.columns.length }),
+                pageSize: t('common.pagination.pageSize'),
+                previous: t('common.pagination.previous'),
+                next: t('common.pagination.next'),
+                page: (item) => t('common.pagination.page', { page: item }),
+                navLabel: t('common.pagination.navLabel'),
+              }}
+            />
+          </>
+        )}
+
+        {tab === 'ddl' && (
+          <div className="dm-ddl">
+            <button type="button" className="dm-btn dm-ddl-copy" onClick={handleCopy}>
+              {copied ? <Check size={12} aria-hidden="true" /> : <Copy size={12} aria-hidden="true" />}
+              {t(copied ? 'dataManagement.copied' : 'dataManagement.copy')}
+            </button>
+            <CodePreview content={tableDetail.ddl} name="ddl.sql" />
+          </div>
+        )}
+
+        {tab === 'lineage' && <LineageView />}
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/data-management/components/shared/TableTree.tsx b/jiuwenswarm/channels/web/frontend/src/features/data-management/components/shared/TableTree.tsx
