@@ -0,0 +1,155 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""find_analysis_id 的归属判定（F-026 / F-023 次生面）。
+
+- F-026：open-analysis-smoke nw-19 open plan 校验连续 4 次被拒后 agent 重建
+  analysis，旧逻辑按 question 相似度选——首次 init 的 question 是用户原话
+  （匹配分必高），重建后模型改写措辞必然更低，judge 对废弃实例判出 6 项假失败。
+  修复后按会话历史中最后出现位置选最终交付物。
+- ls 回显污染（fix-verify 批次）：模型 `ls` artifact 目录时会把**兄弟用例**的
+  analysis 目录名整批带进工具结果回显；旧「全文正则 + rfind 最后出现」在并行
+  批次下选中回显里的外来 id（ck-27 串到 nw-16 的 manifest，判出
+  metrics/open_analysis 双假失败）。修复后只认 tool_call 参数里的
+  `--analysis-id` 值，回显行一律不进候选。
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+EVAL_SCRIPTS = Path(__file__).resolve().parents[3] / ".claude/skills/dw-analysis-eval/scripts"
+if str(EVAL_SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(EVAL_SCRIPTS))
+
+import run_case  # noqa: E402
+
+QUESTION = "出一份 2006 年 Q2（4-6 月）的经营分析报告"
+
+
+def _setup(tmp_path, monkeypatch, history_lines: list[str], manifests: dict[str, str]):
+    """搭建 SESSIONS_DIR/ARTIFACT_ANALYSIS_DIR 沙盒并 patch 进 run_case。"""
+    sessions = tmp_path / "sessions" / "sess-1"
+    sessions.mkdir(parents=True)
+    (sessions / "history.jsonl").write_text("\n".join(history_lines) + "\n", encoding="utf-8")
+    artifacts = tmp_path / "artifacts"
+    for aid, question in manifests.items():
+        d = artifacts / aid
+        d.mkdir(parents=True)
+        (d / "manifest.json").write_text(
+            json.dumps({"analysis_id": aid, "question": question}, ensure_ascii=False),
+            encoding="utf-8")
+    monkeypatch.setattr(run_case, "SESSIONS_DIR", sessions.parent)
+    monkeypatch.setattr(run_case, "ARTIFACT_ANALYSIS_DIR", artifacts)
+    # 全局问题匹配兜底不参与本测试（会话历史锚定必须命中）
+    monkeypatch.setattr(run_case, "api_get", lambda _path: {"sessions": []})
+
+
+def test_rebuilt_analysis_last_seen_wins(tmp_path, monkeypatch):
+    """重建场景：废弃 id 首现早且 question 是用户原话，最终交付物必须胜出。"""
+    stale, final = "analysis-20261016-161032-70071b", "analysis-20261016-161536-62f483"
+    _setup(
+        tmp_path, monkeypatch,
+        history_lines=[
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"init --question {QUESTION}"}}, ensure_ascii=False),
+            json.dumps({"analysis_id": stale, "question": QUESTION}, ensure_ascii=False),
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"plan --analysis-id {stale}"}}, ensure_ascii=False),
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"init（重建） --analysis-id {final}"}}, ensure_ascii=False),
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"execute-batch --analysis-id {final}"}}, ensure_ascii=False),
+            json.dumps({"event_type": "chat.final", "content": f"报告基于 {final} 生成"}, ensure_ascii=False),
+        ],
+        # 废弃实例的 question = 用户原话（旧逻辑的 question 匹配分会选它）
+        manifests={stale: QUESTION,
+                   final: "2006年Q2（4-6月）经营分析：销售额、订单数、客单价，按月份、产品品类、客户、销售员拆解"},
+    )
+    assert run_case.find_analysis_id([QUESTION], since=0.0, wait=1.0, session_id="sess-1") == final
+
+
+def test_single_candidate_short_circuits(tmp_path, monkeypatch):
+    """单候选直接返回，无需排序。"""
+    only = "analysis-20261016-161536-62f483"
+    _setup(
+        tmp_path, monkeypatch,
+        history_lines=[json.dumps({"event_type": "chat.tool_call",
+                                   "tool_call": {"arguments": f"context --analysis-id {only}"}},
+                                  ensure_ascii=False)],
+        manifests={only: QUESTION},
+    )
+    assert run_case.find_analysis_id([QUESTION], since=0.0, wait=1.0, session_id="sess-1") == only
+
+
+def test_quoted_argument_form_is_extracted(tmp_path, monkeypatch):
+    """带引号的参数形态也要能提取：arguments 是未二次解析的嵌套 JSON，
+    模型把 id 用引号包裹时字面序列是 \\"analysis-...\\"（转义引号）。
+
+    full-fixverify ck-24：6 次 analysis_flow 调用全带引号形态，裸正则一个
+    都提不到 → analysis_id=None → judge 误判「未进入四层链路」。
+    """
+    only = "analysis-20261022-225822-ba67fa"
+    _setup(
+        tmp_path, monkeypatch,
+        history_lines=[json.dumps(
+            {"event_type": "chat.tool_call",
+             "tool_call": {"arguments": f'context --analysis-id \\"{only}\\" --question x'}},
+            ensure_ascii=False)],
+        manifests={only: QUESTION},
+    )
+    assert run_case.find_analysis_id([QUESTION], since=0.0, wait=1.0, session_id="sess-1") == only
+
+
+def test_tool_result_echo_does_not_pollute_candidates(tmp_path, monkeypatch):
+    """ls 回显污染：兄弟用例的 analysis 目录名只出现在工具结果里，不得进候选。
+
+    fix-verify 批次实证：ck-27 与 nw-16 并行，模型后段 `ls` artifact 目录把
+    nw-16 的 analysis-...-d0ed8f 整批文件名带进 result 回显（比自己的
+    tool_call 更晚出现），旧 rfind 逻辑选中它 → judge 拿别人 manifest 判假失败。
+    """
+    own = "analysis-20261022-223407-50809c"
+    foreign = "analysis-20261022-223420-d0ed8f"
+    _setup(
+        tmp_path, monkeypatch,
+        history_lines=[
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"context --analysis-id {own}"}},
+                       ensure_ascii=False),
+            # ls 工具结果回显：兄弟用例目录名整批出现（含 own 的文件，两者混排）
+            json.dumps({"event_type": "chat.tool_result",
+                        "result": f"files=['{foreign}\\\\c1_x.csv', '{own}\\\\c_trend.csv']"},
+                       ensure_ascii=False),
+            # 会话更后段再次回显 foreign——比 own 的 tool_call 晚，专打 rfind 时序
+            json.dumps({"event_type": "chat.tool_result",
+                        "result": f"files=['{foreign}\\\\c2_y.csv']"}, ensure_ascii=False),
+        ],
+        manifests={own: QUESTION,
+                   foreign: "分析 2006 年 4 月销售表现最好的产品（TopN 排名），出简报"},
+    )
+    assert run_case.find_analysis_id([QUESTION], since=0.0, wait=1.0, session_id="sess-1") == own
+
+
+def test_last_seen_uses_tool_call_order_not_echo(tmp_path, monkeypatch):
+    """多候选（重建场景）的「最后出现」按 tool_call 序列，不按回显时序。
+
+    重建后旧实例的文件名被尾段 ls 回显（比新实例的 tool_call 更晚），
+    旧 rfind 逻辑会倒选回废弃实例。
+    """
+    stale = "analysis-20261022-223400-dc3bd9"
+    final = "analysis-20261022-223911-f16146"
+    _setup(
+        tmp_path, monkeypatch,
+        history_lines=[
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"context --analysis-id {stale}"}},
+                       ensure_ascii=False),
+            json.dumps({"event_type": "chat.tool_call",
+                        "tool_call": {"arguments": f"execute-batch --analysis-id {final}"}},
+                       ensure_ascii=False),
+            # 尾段回显 stale（废弃实例）——比 final 的 tool_call 晚
+            json.dumps({"event_type": "chat.tool_result",
+                        "result": f"files=['{stale}\\\\old.csv']"}, ensure_ascii=False),
+        ],
+        manifests={stale: QUESTION, final: QUESTION + "（重建）"},
+    )
+    assert run_case.find_analysis_id([QUESTION], since=0.0, wait=1.0, session_id="sess-1") == final
