@@ -0,0 +1,64 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/api.py —— 旧编排 API 适配层（方案 §5.2）。
+
+历史：本文件曾是编排 HTTP API 的完整实现（tasks/workflows/instances CRUD）。
+方案 docs/skill-cli-web-api-plan.md §5.2 落地后，编排业务唯一实现在
+`dataagent/orchestration/service.py`；本文件退化为**薄适配层**：
+路径前缀改写 `/api/orchestration/*` → `/api/dataagent/orchestration/*`，
+附加 Deprecation/Sunset header 后转发给新 controller。
+
+行为保证：同一 service 驱动新旧两条路径，不存在行为分叉。
+删除条件（§5.2 弃用时间表）：全量前端调用迁移 + 兼容契约测试通过后移除本文件。
+"""
+from __future__ import annotations
+
+from urllib.parse import urlparse
+
+from jiuwenswarm.channels.web.dataagent.orchestration import controller as orch_ctrl
+
+_LEGACY_PREFIX = "/api/orchestration"
+_NEW_PREFIX = "/api/dataagent/orchestration"
+
+# §5.2 弃用时间表：前端切换完成前保留；Sunset 日期在前端切换 PR 时定
+_DEPRECATION_HEADERS = {
+    "Deprecation": "true",
+    "Sunset": "Sat, 31 Oct 2026 00:00:00 GMT",
+    "Link": '</api/dataagent/orchestration>; rel="successor-version"',
+}
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_LEGACY_PREFIX)
+
+
+def _rewrite_path(path: str) -> str:
+    """/api/orchestration/X → /api/dataagent/orchestration/X（仅一次前缀替换）。"""
+    return _NEW_PREFIX + path[len(_LEGACY_PREFIX):]
+
+
+class _DeprecatedHandlerProxy:
+    """包装 handler：_write_json 自动附加 Deprecation/Sunset header，其余透传。"""
+
+    def __init__(self, handler):
+        self._handler = handler
+
+    def _write_json(self, status, payload, headers: dict | None = None) -> None:
+        merged = {**_DEPRECATION_HEADERS, **(headers or {})}
+        self._handler._write_json(status, payload, headers=merged)
+
+    def __getattr__(self, name):
+        return getattr(self._handler, name)
+
+
+def handle_get(handler, parsed) -> None:
+    proxy = _DeprecatedHandlerProxy(handler)
+    new_parsed = urlparse(_rewrite_path(handler.path) if not parsed.query
+                          else _rewrite_path(parsed.path) + "?" + parsed.query)
+    orch_ctrl.handle_get(proxy, new_parsed)
+
+
+def handle_post(handler, parsed) -> None:
+    proxy = _DeprecatedHandlerProxy(handler)
+    new_parsed = urlparse(_rewrite_path(handler.path) if not parsed.query
+                          else _rewrite_path(parsed.path) + "?" + parsed.query)
+    orch_ctrl.handle_post(proxy, new_parsed)
