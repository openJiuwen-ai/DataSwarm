@@ -0,0 +1,229 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""builder/service.py — 建仓域服务端层（方案批次 3 §5.4/§5.4.1）。
+
+plan 派生状态查询、materialize（plan → 编排任务/工作流，编排写入单点走
+dataagent/orchestration/service）。
+
+方言纪律（§7.5）：通用 SQL + 占位符走 db_connector._format_sql，无 Doris 特有语法。
+幂等：materialize 按 plan_id（replace 模式先清旧）。
+"""
+from __future__ import annotations
+
+import logging
+
+
+from jiuwenswarm.common import db_connector
+from ..orchestration import service as orch_svc
+
+logger = logging.getLogger(__name__)
+
+SCHEMA_VERSION = 1
+
+# 派生状态：实例状态 → plan 级状态
+_DERIVED = {"running": "building", "queued": "building"}
+
+
+def metadata_db_ref() -> str:
+    """元数据库 db_ref（config 驱动，测试可 patch）。"""
+    return db_connector.metadata_db_ref() or ""
+
+
+# ==========================================================================
+# plan 派生状态（状态从关联实例派生，不冗余写 plan.status 之外的状态机）
+# ==========================================================================
+def _fetch_plan_with_tables(meta_ref: str, plan_id: str):
+    """读 plan 行 + plan_table 行 + 关联实例（bld_* task 前缀关联）。"""
+    conn, _ = db_connector._acquire(meta_ref, read_only=True)
+    cur = db_connector._cursor(conn)
+    try:
+        cur.execute("SELECT plan_id, name, status FROM `plan` WHERE plan_id = %s", (plan_id,))
+        prow = cur.fetchone()
+        plan = dict(zip(("plan_id", "name", "status"), prow)) if prow else None
+        cur.execute("SELECT table_name, layer, status FROM `plan_table` WHERE plan_id = %s",
+                    (plan_id,))
+        tables = [dict(zip(("table_name", "layer", "status"), r)) for r in cur.fetchall()]
+        cur.execute(
+            "SELECT t.task_id, i.status FROM dw_tasks t "
+            "JOIN dw_task_instances i ON i.ref_id = t.task_id AND i.ref_type = 'task' "
+            "WHERE t.task_id LIKE %s ORDER BY i.started_at DESC",
+            (f"bld_{plan_id}%",))
+        insts = [dict(zip(("ref_id", "status"), r)) for r in cur.fetchall()]
+        return plan, tables, insts
+    finally:
+        db_connector._release(conn)
+
+
+def get_plan_status(plan_id: str, *, meta_db_ref: str | None = None) -> dict:
+    """plan + 表清单 + 关联实例派生状态（§5.4 状态机：不冗余写状态字段）。"""
+    meta_ref = meta_db_ref or metadata_db_ref()
+    try:
+        plan, tables, insts = _fetch_plan_with_tables(meta_ref, plan_id)
+    except Exception as exc:  # noqa: BLE001
+        return {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:300]}
+    if not plan:
+        return {"ok": False, "error": "plan_not_found", "plan_id": plan_id}
+    statuses = [i["status"] for i in insts]
+    if any(s == "running" or s == "queued" for s in statuses):
+        derived = "building"
+    elif statuses and all(s == "success" for s in statuses):
+        derived = "completed"
+    elif any(s == "failed" for s in statuses):
+        derived = "failed"
+    else:
+        derived = plan.get("status") or "designing"
+    return {"ok": True, "plan": plan, "tables": tables, "instances": insts,
+            "table_count": len(tables), "derived_status": derived}
+
+
+# ==========================================================================
+# materialize：plan → 编排任务/工作流（§5.4.1 核心）
+# ==========================================================================
+def _load_plan_tables(meta_ref: str, plan_id: str) -> list[dict]:
+    conn, _ = db_connector._acquire(meta_ref, read_only=True)
+    cur = db_connector._cursor(conn)
+    try:
+        cur.execute(
+            "SELECT table_name, layer, ddl_sql, etl_sql, source_table, sync_type, "
+            "file_path, upstream_tables FROM `plan_table` WHERE plan_id = %s "
+            "ORDER BY table_name",
+            (plan_id,))
+        cols = ("table_name", "layer", "ddl_sql", "etl_sql", "source_table",
+                "sync_type", "file_path", "upstream_tables")
+        return [dict(zip(cols, r)) for r in cur.fetchall()]
+    finally:
+        db_connector._release(conn)
+
+
+def _old_task_ids_for_plan(plan_id: str, meta_ref: str) -> list[str]:
+    """旧 materialize 产出的任务 id（bld_<plan_id> 前缀约定）。"""
+    try:
+        conn, _ = db_connector._acquire(meta_ref, read_only=True)
+        cur = db_connector._cursor(conn)
+        cur.execute("SELECT task_id FROM dw_tasks WHERE task_id LIKE %s",
+                    (f"bld_{plan_id}%",))
+        ids = [r[0] for r in cur.fetchall()]
+        db_connector._release(conn)
+        return ids
+    except Exception:
+        return []
+
+
+def _delete_plan_lineage(plan_id: str) -> None:
+    """按 plan_id 清血缘（依赖 §5.4 lineage delete G6 修复）。"""
+    try:
+        from ..lineage import service as lineage_svc
+        lineage_svc.delete_table_lineage(plan_id)
+        lineage_svc.delete_column_lineage(plan_id)
+    except Exception as exc:  # noqa: BLE001 —— 清血缘失败不阻断 materialize
+        logger.warning("[builder] 清理 plan 血缘失败 plan_id=%s: %s", plan_id, exc)
+        pass
+
+
+def materialize(plan_id: str, *, mode: str = "replace",
+                file_paths: dict | None = None,
+                meta_db_ref: str | None = None) -> dict:
+    """plan → 编排任务/工作流（方案 §5.4.1）。
+
+    - 导数表（sync_type=stream_load 且 file_path）→ stream_load 任务
+    - DDL/ETL（ddl_sql/etl_sql）→ SQL 任务
+    - upstream_tables 派生 DAG；bld_<plan_id>_<table> 任务 id 约定
+    - mode=replace：先删旧任务/工作流 + 按 plan_id 清血缘，失败整体清理
+    """
+    meta_ref = meta_db_ref or metadata_db_ref()
+    tables = _load_plan_tables(meta_ref, plan_id)
+
+    created: list[dict] = []
+    task_ids: dict[str, str] = {}  # table_name → task_id
+
+    def _cleanup():
+        for tid in task_ids.values():
+            try:
+                orch_svc.delete_task(tid)
+            except Exception as exc:  # noqa: BLE001 —— 清理失败留下残留任务
+                logger.warning("[builder] 回滚清理任务失败 task_id=%s: %s", tid, exc)
+                pass
+        try:
+            orch_svc.delete_workflow(f"wf_{plan_id}")
+        except Exception as exc:  # noqa: BLE001 —— 清理失败留下残留工作流
+            logger.warning("[builder] 回滚清理工作流失败 workflow_id=wf_%s: %s", plan_id, exc)
+            pass
+
+    # replace 幂等：清旧（任务/工作流/血缘）——空表时也执行（清残留）
+    if mode == "replace":
+        for tid in _old_task_ids_for_plan(plan_id, meta_ref):
+            try:
+                orch_svc.delete_task(tid)
+            except Exception as exc:  # noqa: BLE001 —— 单任务清理失败继续其余
+                logger.warning("[builder] replace 清理旧任务失败 task_id=%s: %s", tid, exc)
+                pass
+        try:
+            orch_svc.delete_workflow(f"wf_{plan_id}")
+        except Exception as exc:  # noqa: BLE001 —— 工作流清理失败继续 materialize
+            logger.warning("[builder] replace 清理旧工作流失败 workflow_id=wf_%s: %s", plan_id, exc)
+            pass
+        _delete_plan_lineage(plan_id)
+    if not tables:
+        return {"ok": False, "error": "plan_table 为空（先完成设计/分层）", "plan_id": plan_id}
+
+    def _merge_file_path(t: dict) -> str | None:
+        return t.get("file_path") or (file_paths or {}).get(t.get("table_name") or "")
+
+    try:
+        # 1) 建任务（每个 plan_table 一个节点任务）
+        for t in tables:
+            name = t.get("table_name") or ""
+            task_id = f"bld_{plan_id}_{name}"
+            task_ids[name] = task_id
+            upstream = ",".join(
+                task_ids[u] for u in (t.get("upstream_tables") or "").split(",")
+                if u.strip() and u.strip() in task_ids)
+            if t.get("sync_type") == "stream_load":
+                # 导数任务：stream_load executor（CSV 本地路径直传，label 运行时派生）
+                params = {"file_path": _merge_file_path(t) or "",
+                          "target_db": str(t.get("target_db") or ""),
+                          "target_table": name}
+                orch_svc.create_task({
+                    "task_id": task_id, "name": f"[{plan_id}] 导数 {name}",
+                    "executor_type": "stream_load", "code": "",
+                    "params": params,
+                    # 透传真实业务 ref（mysql:// 源凭据从 dw_datasources 补齐；
+                    # 兜底空串时 executor 再按 target_db 派生 doris:// 指针）
+                    "datasource_ref": str(t.get("target_db_ref") or ""),
+                    "upstream_tasks": upstream, "layer": t.get("layer") or "ODS",
+                })
+            else:
+                # DDL + ETL → SQL 任务（生成代码零连接 import，§7.4）
+                etl_sql = t.get("etl_sql") or ""
+                ddl_sql = t.get("ddl_sql") or ""
+                code = "\n".join(x for x in (ddl_sql, etl_sql) if x)
+                orch_svc.create_task({
+                    "task_id": task_id, "name": f"[{plan_id}] {name}",
+                    "executor_type": "sql", "code": code,
+                    "datasource_ref": str(t.get("target_db_ref") or ""),
+                    "upstream_tasks": upstream, "layer": t.get("layer") or "",
+                })
+            created.append({"task_id": task_id, "table": name})
+
+        # 2) 组工作流 DAG（节点 = 任务，upstream_nodes = 上游任务 id）
+        nodes = [{"node_id": f"n_{task_ids[t.get('table_name')]}", "task_id": task_ids[t.get("table_name")],
+                  "node_name": t.get("table_name"),
+                  "upstream_nodes": ",".join(
+                      task_ids[u] for u in (t.get("upstream_tables") or "").split(",")
+                      if u.strip() and u.strip() in task_ids)}
+                 for t in tables]
+        wf = orch_svc.create_workflow({"name": f"[{plan_id}] 建仓工作流",
+                                       "description": f"materialize from plan {plan_id}"})
+        wf_id = wf["workflow_id"]
+        orch_svc.replace_nodes(wf_id, nodes)
+        # publish（调度器可扫；enabled 默认开）
+        orch_svc.set_workflow_status(wf_id, "published")
+    except Exception as exc:  # noqa: BLE001
+        _cleanup()  # 失败整体清理（§5.4.1 装配原子性）
+        return {"ok": False, "error": f"materialize 失败已回滚: {exc}"[:400],
+                "plan_id": plan_id}
+
+    return {"ok": True, "plan_id": plan_id, "workflow_id": wf_id,
+            "task_ids": [c["task_id"] for c in created], "nodes": len(nodes),
+            "mode": mode}
