index 000000000..c02230b43
--- /dev/null
+++ b/jiuwenswarm/channels/web/orchestration/scheduler.py
@@ -0,0 +1,169 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/scheduler.py —— 周期/一次性调度器。
+
+daemon 线程，每 10 秒扫一次 orch_task / orch_workflow 里 published 且
+schedule_type in (once,cron) 的目标，判断是否 due，due 则建实例派发执行。
+
+复用 jiuwenswarm/gateway/cron/cron_expr.py 的校验 + 一次性时间转 cron。
+croniter 算 next，与 dw_task_instances.created_at 最近一次实例时间比对。
+
+幂等：
+    - once：触发后置 schedule_type=none（mark_once_fired）
+    - cron：从「上次实例 created_at」算下一个 cron 点，已 ≤ now 则 due
+      （本周期尚未触发过）。所有时间统一 aware（Asia/Shanghai）。
+"""
+from __future__ import annotations
+
+import logging
+import threading
+import time
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.common import workspace_context
+
+from . import db as orch_db
+from . import workflow_engine
+from .db import _now
+from ..dataagent.semantic import scheduler as semantic_scheduler
+from ..dataagent.glossary import sync as glossary_sync
+
+logger = logging.getLogger(__name__)
+
+_POLL_INTERVAL_S = 10
+_TZ = "Asia/Shanghai"
+_started = False
+_thread: threading.Thread | None = None
+
+
+def start() -> None:
+    global _started, _thread
+    if _started:
+        return
+    _thread = threading.Thread(target=_loop, daemon=True, name="orch-scheduler")
+    _thread.start()
+    _started = True
+    logger.info("[orchestration] scheduler started (poll every %ss)", _POLL_INTERVAL_S)
+
+
+def _loop() -> None:
+    while True:
+        try:
+            _tick()
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("[orchestration] scheduler tick error: %s", exc)
+        time.sleep(_POLL_INTERVAL_S)
+
+
+def _tick(now: datetime | None = None) -> None:
+    if now is None:
+        now = datetime.now(tz=ZoneInfo(_TZ))
+    # 多库化（决策五）：逐工作空间取到期任务。_is_due 内部查 last_instance_ts、
+    # _fire 内部写 mark_once_fired/create_instance，都必须在该工作空间的
+    # contextvar 作用域内执行——否则多工作空间下 _connect 拿不到上下文大声失败
+    # （once/cron 任务会静默永不触发）。
+    for ws in workspace_context.list_workspaces():
+        token = workspace_context.set_current(ws.workspace_id)
+        try:
+            targets = orch_db.list_scheduled_targets()
+            due_targets = [t for t in targets if _is_due(t, now)]
+            for target in due_targets:
+                _fire(target, ws.workspace_id)
+            semantic_scheduler.tick(now)
+            # 术语库启动对账（方案 glossary P0 §7.2）：每 workspace 成功一次即完成，
+            # 内部 60s 失败退避；失败不影响本循环其余工作空间。
+            glossary_sync.reconcile_tick()
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("[orchestration] tick failed for workspace %s: %s",
+                           ws.workspace_id, exc)
+        finally:
+            workspace_context.reset(token)
+
+
+def _is_due(target: dict, now: datetime) -> bool:
+    st = target.get("schedule_type")
+    if st == "once":
+        at = target.get("schedule_once_at")
+        if not at:
+            return False
+        try:
+            t = _parse_iso(at)
+        except ValueError:
+            return False
+        # once 幂等：触发后 mark_once_fired 置 schedule_type=none，这里只要时间到就 due。
+        # t 可能 naive（用户只填了日期时间），统一按本地时区 aware 后再与 aware now 比较。
+        if t.tzinfo is None:
+            t = t.replace(tzinfo=now.tzinfo)
+        else:
+            t = t.astimezone(now.tzinfo)
+        return now >= t
+    if st == "cron":
+        cron = target.get("schedule_cron")
+        if not cron:
+            return False
+        try:
+            from croniter import croniter  # type: ignore
+            from jiuwenswarm.gateway.cron.cron_expr import normalize_cron_expr
+            normalized = normalize_cron_expr(cron)
+            tz = now.tzinfo if now.tzinfo else ZoneInfo(_TZ)
+            last_ts = orch_db.last_instance_ts(target["ref_type"], target["ref_id"])
+            # last_ts 是 dw_task_instances.created_at（ISO8601，如 2026-08-28T16:49:35+0800），
+            # 不是 instance_id（YYYYmmdd_HHMMSS_xxx）。用 _parse_iso 解析；失败则回退到 now。
+            # 语义：从「上次实例时间」算下一个 cron 点，若已 ≤ now 则 due（本周期尚未触发过）。
+            base = _parse_iso(last_ts) if last_ts else None
+            if base is None:
+                base = datetime.now(tz=tz)
+            if base.tzinfo is None:
+                base = base.replace(tzinfo=tz)
+            else:
+                base = base.astimezone(tz)
+            nxt = croniter(normalized, base, second_at_beginning=True).get_next(datetime)
+            # nxt 已 aware（zoneinfo croniter 输出带 tz）；now 也是 aware，直接比较。
+            if nxt.tzinfo is None:
+                nxt = nxt.replace(tzinfo=tz)
+            return now >= nxt
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("[orchestration] cron check failed for %s: %s", target["ref_id"], exc)
+            return False
+    return False
+
+
+def _parse_iso(s: str) -> datetime:
+    return timeutil.parse_ts_strict(s)
+
+
+def _fire(target: dict, workspace_id: str = "") -> None:
+    """触发目标。必须在调用方（_tick）已 set_current 的工作空间作用域内执行——
+    mark_once_fired/create_instance 写目标工作空间元数据库（任务行所在库即归属，决策七）。"""
+    ref_type = target["ref_type"]
+    ref_id = target["ref_id"]
+    # once 触发后立即置 none，防重复（在创建实例前先标记，防 tick 重入）
+    if target.get("schedule_type") == "once":
+        orch_db.mark_once_fired(
+            ref_id if ref_type == "task" else None,
+            ref_id if ref_type == "workflow" else None,
+        )
+    inst = orch_db.create_instance(ref_type, ref_id, trigger_type="schedule", status="queued")
+    # 在后台线程执行，不阻塞调度循环。执行线程是新的 contextvar 作用域，
+    # 必须显式 set 任务所在工作空间（决策九）。
+    threading.Thread(
+        target=_execute_instance, args=(inst["instance_id"], ref_type, ref_id, workspace_id),
+        daemon=True
+    ).start()
+    logger.info("[orchestration] fired %s %s (workspace=%s) -> instance %s",
+                ref_type, ref_id, workspace_id or "default", inst["instance_id"])
+
+
+def _execute_instance(instance_id: str, ref_type: str, ref_id: str,
+                      workspace_id: str = "") -> None:
+    token = workspace_context.set_current(workspace_id)
+    try:
+        if ref_type == "task":
+            workflow_engine.run_task_instance(instance_id, ref_id)
+        else:
+            workflow_engine.run_workflow_instance(instance_id, ref_id)
+    except Exception as exc:  # noqa: BLE001
+        orch_db.update_instance(instance_id, status="failed", error_message=str(exc), finished_at=_now())
+    finally:
+        workspace_context.reset(token)
