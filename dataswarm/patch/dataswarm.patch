+def _file_source(pipeline, file_format):
+    path = pipeline.root / f"orders.{file_format if file_format != 'excel' else 'xlsx'}"
+    if file_format == "csv":
+        with path.open("w", encoding="utf-8", newline="") as file:
+            writer = csv.DictWriter(file, fieldnames=list(ROWS[0]))
+            writer.writeheader()
+            writer.writerows(ROWS)
+    elif file_format == "json":
+        path.write_text(json.dumps(ROWS), encoding="utf-8")
+    elif file_format == "excel":
+        openpyxl = pytest.importorskip("openpyxl")
+        pytest.importorskip("pandas")
+        workbook = openpyxl.Workbook()
+        worksheet = workbook.active
+        worksheet.append(list(ROWS[0]))
+        for row in ROWS:
+            worksheet.append(list(row.values()))
+        workbook.save(path)
+        workbook.close()
+    else:
+        duckdb = pytest.importorskip("duckdb")
+        connection = duckdb.connect()
+        try:
+            connection.execute("CREATE TABLE orders (id INTEGER, region VARCHAR, phone VARCHAR)")
+            connection.executemany("INSERT INTO orders VALUES (?, ?, ?)", [list(row.values()) for row in ROWS])
+            escaped = str(path).replace("'", "''")
+            connection.execute(f"COPY orders TO '{escaped}' (FORMAT PARQUET)")
