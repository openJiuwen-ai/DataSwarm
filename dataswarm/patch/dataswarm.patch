+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 添加卡片弹窗：自定义 SQL/图表卡片。
+ * 旧「关联指标」模式已随旧指标体系退役（2026-10-10）——指标口径请用
+ *  指标语义（metricsV2）查询；看板卡片本身是 SQL 驱动的独立单元。
+ */
+
+import { useState } from 'react';
+import { useDashboardStore } from '../store/dashboardStore';
+import { Button, inputClass } from '../../_shared/ui';
+import { X } from 'lucide-react';
+
+interface CardAddModalProps {
+  dashboardId: string;
+  onClose: () => void;
+  onCreated: () => void;
+}
+
+export function CardAddModal({ dashboardId, onClose, onCreated }: CardAddModalProps) {
+  const store = useDashboardStore();
+  const [title, setTitle] = useState('');
+  const [cardType, setCardType] = useState<'metric' | 'chart' | 'kpi'>('kpi');
+  const [sqlQuery, setSqlQuery] = useState('');
+  const [chartType, setChartType] = useState('bar');
+  const [chartX, setChartX] = useState('');
+  const [chartY, setChartY] = useState('');
+
+  const handleCreate = async () => {
+    await store.createCard(dashboardId, {
+      title: title || '自定义卡片',
+      card_type: cardType,
+      sql_query: sqlQuery || undefined,
+      chart_spec: chartType && chartX && chartY ? { type: chartType as 'line' | 'bar' | 'pie' | 'scatter' | 'heatmap', x: chartX, y: chartY } : undefined,
+    });
+    onCreated();
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50" onClick={onClose}>
+      <div className="relative mx-4 w-full max-w-lg rounded-xl border border-border bg-card p-6 shadow-xl" onClick={(e) => e.stopPropagation()}>
+        <button className="absolute right-3 top-3 rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}>
+          <X size={18} />
+        </button>
+        <h3 className="mb-4 text-lg font-semibold text-text-strong">添加卡片</h3>
+
+        <div className="space-y-3">
+          <div>
+            <label className="mb-1 block text-xs text-text-muted">卡片标题</label>
+            <input className={inputClass} value={title} onChange={(e) => setTitle(e.target.value)} placeholder="输入标题" />
+          </div>
+          <div>
+            <label className="mb-1 block text-xs text-text-muted">卡片类型</label>
+            <select className={inputClass} value={cardType} onChange={(e) => setCardType(e.target.value as 'metric' | 'chart' | 'kpi')}>
+              <option value="kpi">KPI</option>
+              <option value="chart">图表</option>
+            </select>
+          </div>
+          <div>
+            <label className="mb-1 block text-xs text-text-muted">SQL 查询</label>
+            <textarea className={`${inputClass} h-24 font-mono text-xs`} value={sqlQuery} onChange={(e) => setSqlQuery(e.target.value)} placeholder="SELECT ... AS v FROM ..." />
+          </div>
+          {cardType === 'chart' && (
+            <div className="grid grid-cols-3 gap-2">
+              <div>
+                <label className="mb-1 block text-xs text-text-muted">图表类型</label>
+                <select className={inputClass} value={chartType} onChange={(e) => setChartType(e.target.value)}>
+                  <option value="bar">柱状图</option>
+                  <option value="line">折线图</option>
+                  <option value="pie">饼图</option>
+                </select>
+              </div>
+              <div>
+                <label className="mb-1 block text-xs text-text-muted">X轴</label>
+                <input className={inputClass} value={chartX} onChange={(e) => setChartX(e.target.value)} placeholder="列名" />
+              </div>
+              <div>
+                <label className="mb-1 block text-xs text-text-muted">Y轴</label>
+                <input className={inputClass} value={chartY} onChange={(e) => setChartY(e.target.value)} placeholder="列名" />
+              </div>
+            </div>
+          )}
+        </div>
+
+        <div className="mt-4 flex justify-end gap-2">
+          <Button variant="ghost" onClick={onClose}>取消</Button>
+          <Button variant="primary" onClick={() => void handleCreate()}>添加</Button>
+        </div>
+      </div>
+    </div>
+  );
+}
