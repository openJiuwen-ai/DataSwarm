+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dashboard/db.py —— BI看板元数据层。
+
+3 张表：dw_bi_dimensions / dw_bi_dashboards / dw_bi_dashboard_cards。
+（dw_bi_metrics 已随旧指标体系退役 2026-10-10，指标真相源是 metrics V2。）
+连接层复用编排模块的 db_connector._acquire（SQLAlchemy Engine 池）：
+定义 CRUD 走系统元数据库（经 _connect() 取当前工作空间元库），
+卡片计算 SQL 走业务库（_business_ref_or_default，MVP 约束 9.3 角色分离）。
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+import threading
+import uuid
+from pathlib import Path
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+# 公共连接器：db_connector 已上收至 jiuwenswarm.common（方案 docs/skill-cli-web-api-plan.md §7.1）
+from jiuwenswarm.common import db_connector  # type: ignore  # noqa: E402
+from jiuwenswarm.common import workspace_context
+
+logger = logging.getLogger(__name__)
+
+
+def _business_ref_or_default(datasource_ref: str | None) -> str:
+    """解析卡片/指标计算 SQL 的目标库（MVP 约束 9.3：计算 SQL 走 business role）。
+
+    优先级：显式 datasource_ref（经 validate_ref_in_workspace 校验，business role）
+    > 当前工作空间业务库 > 顶层 default_db（legacy）。禁止兜底元数据库
+    （原 ``datasource_ref or META_DB_REF`` 是角色混用点，已消灭）。
+    """
+    if datasource_ref:
+        workspace_context.validate_ref_in_workspace(None, "business", datasource_ref)
+        return datasource_ref
+    try:
+        ref = workspace_context.current_workspace().business_db_ref
+        if ref:
+            return ref
+    except Exception as exc:  # noqa: BLE001 —— 无工作空间上下文时回退 default_db
+        logger.debug("[dashboard] 工作空间业务库解析失败，回退 default_db: %s", exc)
+        pass
+    ref = db_connector.default_db_ref()
+    if not ref:
+        raise ValueError("业务库未配置：请在工作空间或 datasource.yaml 中指定 default_db")
+    return ref
+
+# dw-report charts：同样通过 sys.path 导入
+_CHART_UTILS_DIR = (Path(__file__).resolve().parent.parent.parent.parent.parent
+                    / "resources" / "agent" / "workspace" / "skills" / "dw-report" / "scripts")
+if str(_CHART_UTILS_DIR) not in os.sys.path:
+    import sys as _sys2
+    _sys2.path.insert(0, str(_CHART_UTILS_DIR))
+
+_write_lock = threading.Lock()
+
+
+def new_id(prefix: str) -> str:
+    return f"{prefix}_{uuid.uuid4().hex[:12]}"
+
+
+# --------------------------------------------------------------------------
+# 建表
+# --------------------------------------------------------------------------
+# 3 张 BI 看板表（dw_bi_dimensions / dw_bi_dashboards / dw_bi_dashboard_cards）
+# 的 DDL 已收编到 deploy/schema/ddl/，由 web.schema.ensure.ensure_system_schema
+# 幂等应用。SQLite 索引也单独成 idx_bi_*.ddl.sqlite.sql 文件同目录扫描执行。
+
+
+def init_db() -> None:
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(workspace_context.current_workspace().metadata_db_ref)
+
+
+def _parse_json_field(d: dict, field: str) -> Any:
+    raw = d.get(field)
+    if not raw:
+        return None
+    try:
+        return json.loads(raw) if isinstance(raw, str) else raw
+    except (json.JSONDecodeError, TypeError):
+        return None
+
+
+# ==========================================================================
+# 维度 CRUD
+# ==========================================================================
+def create_dimension(data: dict) -> dict:
+    dimension_id = data.get("dimension_id") or new_id("dim")
+    now = _now()
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """INSERT INTO dw_bi_dimensions
+                   (dimension_id,name,label,description,dim_type,value_source,
+                    value_sql,value_list,datasource_ref,created_at,updated_at)
+                   VALUES (?,?,?,?,?,?,?,?,?,?,?)""", (
+                dimension_id,
+                data.get("name", ""),
+                data.get("label"),
+                data.get("description"),
+                data.get("dim_type", "category"),
+                data.get("value_source", "manual"),
+                data.get("value_sql"),
+                json.dumps(data.get("value_list", []), ensure_ascii=False) if data.get("value_list") else None,
+                data.get("datasource_ref"),
+                now,
+                now,
+            ))
+            conn.commit()
+        finally:
+            conn.close()
+    return get_dimension(dimension_id)  # type: ignore
+
+
+def update_dimension(dimension_id: str, data: dict) -> dict | None:
+    existing = get_dimension(dimension_id)
+    if not existing:
+        return None
+    now = _now()
+    fields = []
+    vals: list[Any] = []
+    for k, col in [
+        ("name", "name"), ("label", "label"), ("description", "description"),
+        ("dim_type", "dim_type"), ("value_source", "value_source"),
+        ("value_sql", "value_sql"), ("datasource_ref", "datasource_ref"),
+    ]:
+        if k in data and data[k] is not None:
+            fields.append(f"{col}=?")
+            vals.append(data[k])
+    if "value_list" in data:
+        fields.append("value_list=?")
+        vals.append(json.dumps(data["value_list"], ensure_ascii=False) if data["value_list"] else None)
+    if not fields:
+        return existing
+    fields.append("updated_at=?")
+    vals.append(now)
+    vals.append(dimension_id)
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, f"UPDATE dw_bi_dimensions SET {', '.join(fields)} WHERE dimension_id=?", vals)
+            conn.commit()
+        finally:
+            conn.close()
+    return get_dimension(dimension_id)
+
+
+def list_dimensions() -> list[dict]:
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, "SELECT * FROM dw_bi_dimensions ORDER BY updated_at DESC")
+    finally:
+        conn.close()
+
+
+def get_dimension(dimension_id: str) -> dict | None:
+    conn = _connect()
+    try:
+        return _fetch_one_dict(conn, "SELECT * FROM dw_bi_dimensions WHERE dimension_id=?", (dimension_id,))
+    finally:
+        conn.close()
+
+
+def delete_dimension(dimension_id: str) -> bool:
+    with _write_lock:
+        conn = _connect()
+        try:
+            cur = _exec(conn, "DELETE FROM dw_bi_dimensions WHERE dimension_id=?", (dimension_id,))
+            conn.commit()
+            return cur.rowcount > 0
+        finally:
+            conn.close()
+
+
+def get_dimension_values(dimension_id: str) -> list:
+    """获取维度值列表。value_source=sql 执行 SQL；manual 返回 value_list。"""
+    dim = get_dimension(dimension_id)
+    if not dim:
+        return []
+    if dim.get("value_source") == "sql" and dim.get("value_sql"):
+        try:
+            ref = _business_ref_or_default(dim.get("datasource_ref"))
+            conn_ro, _ = db_connector._acquire(ref, read_only=True)
+            try:
+                rows = _fetch_dicts(conn_ro, dim["value_sql"])
+                return [r.get("v", list(r.values())[0]) for r in rows] if rows else []
+            finally:
+                conn_ro.close()
+        except Exception:
+            return []
+    vl = dim.get("value_list")
+    if vl:
+        try:
+            return json.loads(vl) if isinstance(vl, str) else vl
+        except (json.JSONDecodeError, TypeError):
+            return []
+    return []
+
+
+# ==========================================================================
+# 看板 CRUD
+# ==========================================================================
+def create_dashboard(data: dict) -> dict:
+    dashboard_id = data.get("dashboard_id") or new_id("dash")
+    now = _now()
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """INSERT INTO dw_bi_dashboards
+                   (dashboard_id,name,description,owner,layout_json,filter_defaults,
+                    status,source_type,source_ref,created_at,updated_at)
+                   VALUES (?,?,?,?,?,?,?,?,?,?,?)""", (
+                dashboard_id,
+                data.get("name", ""),
+                data.get("description"),
+                data.get("owner", "demo"),
+                json.dumps(data.get("layout_json", {}), ensure_ascii=False),
+                json.dumps(data.get("filter_defaults"), ensure_ascii=False) if data.get("filter_defaults") else None,
+                "active",
+                data.get("source_type"),
+                data.get("source_ref"),
+                now,
+                now,
+            ))
+            conn.commit()
+        finally:
+            conn.close()
+    return get_dashboard(dashboard_id)  # type: ignore
+
+
+def update_dashboard(dashboard_id: str, data: dict) -> dict | None:
+    existing = get_dashboard(dashboard_id)
+    if not existing:
+        return None
+    now = _now()
+    fields = []
+    vals: list[Any] = []
+    for k, col in [
+        ("name", "name"), ("description", "description"), ("owner", "owner"),
+        ("status", "status"), ("source_type", "source_type"), ("source_ref", "source_ref"),
+    ]:
+        if k in data and data[k] is not None:
+            fields.append(f"{col}=?")
+            vals.append(data[k])
+    if "layout_json" in data:
+        fields.append("layout_json=?")
+        vals.append(json.dumps(data["layout_json"], ensure_ascii=False))
+    if "filter_defaults" in data:
+        fields.append("filter_defaults=?")
+        vals.append(json.dumps(data["filter_defaults"], ensure_ascii=False) if data["filter_defaults"] else None)
+    if not fields:
+        return existing
+    fields.append("updated_at=?")
+    vals.append(now)
+    vals.append(dashboard_id)
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, f"UPDATE dw_bi_dashboards SET {', '.join(fields)} WHERE dashboard_id=?", vals)
+            conn.commit()
+        finally:
+            conn.close()
+    return get_dashboard(dashboard_id)
+
+
+def list_dashboards(status: str | None = None, owner: str | None = None) -> list[dict]:
+    conn = _connect()
+    try:
+        sql = "SELECT * FROM dw_bi_dashboards"
+        conds: list[str] = []
+        params: list[Any] = []
+        if status:
+            conds.append("status=?")
+            params.append(status)
+        if owner:
+            conds.append("owner=?")
+            params.append(owner)
+        if conds:
+            sql += " WHERE " + " AND ".join(conds)
+        sql += " ORDER BY updated_at DESC"
+        rows = _fetch_dicts(conn, sql, tuple(params))
+        for r in rows:
+            r["cards_count"] = len(list_cards(r["dashboard_id"]))
+        return rows
+    finally:
+        conn.close()
+
+
+def get_dashboard(dashboard_id: str) -> dict | None:
+    conn = _connect()
+    try:
+        d = _fetch_one_dict(conn, "SELECT * FROM dw_bi_dashboards WHERE dashboard_id=?", (dashboard_id,))
+        if d:
+            d["cards"] = list_cards(dashboard_id)
+        return d
+    finally:
+        conn.close()
+
+
+def delete_dashboard(dashboard_id: str) -> bool:
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, "DELETE FROM dw_bi_dashboard_cards WHERE dashboard_id=?", (dashboard_id,))
+            cur = _exec(conn, "DELETE FROM dw_bi_dashboards WHERE dashboard_id=?", (dashboard_id,))
+            conn.commit()
+            return cur.rowcount > 0
+        finally:
+            conn.close()
+
+
+# ==========================================================================
+# 卡片 CRUD
+# ==========================================================================
+def create_card(dashboard_id: str, data: dict) -> dict:
+    card_id = data.get("card_id") or new_id("card")
+    now = _now()
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """INSERT INTO dw_bi_dashboard_cards
+                   (card_id,dashboard_id,metric_id,title,card_type,chart_spec,
+                    echarts_option,sql_query,datasource_ref,sparkline_sql,
+                    grid_pos,display_format,trend_direction,order_index,created_at,updated_at)
+                   VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""", (
+                card_id,
+                dashboard_id,
+                data.get("metric_id"),
+                data.get("title", ""),
+                data.get("card_type", "metric"),
+                json.dumps(data["chart_spec"], ensure_ascii=False) if data.get("chart_spec") else None,
+                json.dumps(data["echarts_option"], ensure_ascii=False) if data.get("echarts_option") else None,
+                data.get("sql_query"),
+                data.get("datasource_ref"),
+                data.get("sparkline_sql"),
+                json.dumps(data.get("grid_pos", {}), ensure_ascii=False),
+                data.get("display_format"),
+                data.get("trend_direction"),
+                int(data.get("order_index", 0)),
+                now,
+                now,
+            ))
+            conn.commit()
+        finally:
+            conn.close()
+    return get_card(card_id)  # type: ignore
+
+
+def update_card(card_id: str, data: dict) -> dict | None:
+    existing = get_card(card_id)
+    if not existing:
+        return None
+    now = _now()
+    fields = []
+    vals: list[Any] = []
+    for k, col in [
+        ("metric_id", "metric_id"), ("title", "title"), ("card_type", "card_type"),
+        ("sql_query", "sql_query"), ("datasource_ref", "datasource_ref"),
+        ("sparkline_sql", "sparkline_sql"), ("display_format", "display_format"),
+        ("trend_direction", "trend_direction"),
+    ]:
+        if k in data and data[k] is not None:
+            fields.append(f"{col}=?")
+            vals.append(data[k])
+    if "chart_spec" in data:
+        fields.append("chart_spec=?")
+        vals.append(json.dumps(data["chart_spec"], ensure_ascii=False) if data["chart_spec"] else None)
+    if "echarts_option" in data:
+        fields.append("echarts_option=?")
+        vals.append(json.dumps(data["echarts_option"], ensure_ascii=False) if data["echarts_option"] else None)
+    if "grid_pos" in data:
+        fields.append("grid_pos=?")
+        vals.append(json.dumps(data["grid_pos"], ensure_ascii=False))
+    if "order_index" in data:
+        fields.append("order_index=?")
+        vals.append(int(data["order_index"]))
+    if not fields:
+        return existing
+    fields.append("updated_at=?")
+    vals.append(now)
+    vals.append(card_id)
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, f"UPDATE dw_bi_dashboard_cards SET {', '.join(fields)} WHERE card_id=?", vals)
+            conn.commit()
+        finally:
+            conn.close()
+    return get_card(card_id)
+
+
+def list_cards(dashboard_id: str) -> list[dict]:
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, "SELECT * FROM dw_bi_dashboard_cards WHERE dashboard_id=? ORDER BY order_index",
+                            (dashboard_id,))
+    finally:
+        conn.close()
+
+
+def get_card(card_id: str) -> dict | None:
+    conn = _connect()
+    try:
+        return _fetch_one_dict(conn, "SELECT * FROM dw_bi_dashboard_cards WHERE card_id=?", (card_id,))
+    finally:
+        conn.close()
+
+
+def delete_card(card_id: str) -> bool:
+    with _write_lock:
+        conn = _connect()
+        try:
+            cur = _exec(conn, "DELETE FROM dw_bi_dashboard_cards WHERE card_id=?", (card_id,))
+            conn.commit()
+            return cur.rowcount > 0
+        finally:
+            conn.close()
+
+
+def reorder_cards(dashboard_id: str, card_ids: list[str]) -> None:
+    with _write_lock:
+        conn = _connect()
+        try:
+            for i, cid in enumerate(card_ids):
+                _exec(conn,
+                      "UPDATE dw_bi_dashboard_cards SET order_index=?, updated_at=? "
+                      "WHERE card_id=? AND dashboard_id=?",
+                      (i, _now(), cid, dashboard_id))
+            conn.commit()
+        finally:
+            conn.close()
+
+
+# ==========================================================================
+# 渲染
+# ==========================================================================
+def render_card(card_id: str, force_refresh: bool = False,
+                time_range: tuple[str, str] | None = None) -> dict | None:
+    """渲染单卡片：执行 SQL + 生成 ECharts option，缓存回写。
+
+    time_range 为 (start, end) 或 None。SQL 含 {{time_start}}/{{time_end}}
+    占位符时一律重查（不走缓存），因为结果必然依赖时间范围。
+    """
+    card = get_card(card_id)
+    if not card:
+        return None
+
+    result = {"card_id": card["card_id"], "title": card["title"], "card_type": card["card_type"],
+              "metric_id": card.get("metric_id"), "grid_pos": _parse_json_field(card, "grid_pos") or {}}
+
+    cached = _parse_json_field(card, "echarts_option")
+    sql_query = card.get("sql_query")
+    has_placeholder = bool(sql_query and ("{{time_start}}" in sql_query or "{{time_end}}" in sql_query))
+
+    # 无占位符 + 有缓存 + 非 force_refresh → 走缓存（旧路径）
+    if cached and not force_refresh and not has_placeholder:
+        result["echarts_option"] = cached
+        result["current_value"] = None
+        return result
+
+    # 含占位符但未传 time_range → 极宽范围，防 SQL 报错
+    effective_range = time_range
+    if has_placeholder and effective_range is None:
+        effective_range = ("1900-01-01", "2999-12-31")
+
+    # 预校验时间范围：含占位符 SQL 的替换在 try 外执行，
+    # ValueError 会直接抛出，由 API 层捕获并返回 400（而非吞为 result["error"]）
+    applied_sql = sql_query
+    if sql_query and has_placeholder:
+        applied_sql = _apply_time_range(sql_query, effective_range)
+
+    # KPI 卡片：执行 SQL 取首行首列作为 current_value
+    if card["card_type"] == "kpi":
+        if not sql_query:
+            result["echarts_option"] = None
+            result["error"] = "KPI 卡片缺少 sql_query"
+            return result
+        try:
+            from charts.options import json_safe
+            ref = _business_ref_or_default(card.get("datasource_ref"))
+            conn_ro, _ = db_connector._acquire(ref, read_only=True)
+            try:
+                rows = _fetch_dicts(conn_ro, applied_sql)
+            finally:
+                conn_ro.close()
+            if not rows:
+                value = None
+            else:
+                first = rows[0]
+                value = list(first.values())[0] if first else None
+            result["current_value"] = json_safe(value) if value is not None else None
+            result["echarts_option"] = None
+        except Exception as e:
+            result["echarts_option"] = None
+            result["error"] = str(e)
+        return result
+
+    # 从 chart_spec 生成
+    chart_spec = _parse_json_field(card, "chart_spec")
+    if chart_spec and sql_query:
+        try:
+            import pandas as pd
+            from charts.options import ChartRequest, chart_option
+
+            ref = _business_ref_or_default(card.get("datasource_ref"))
+            conn_ro, _ = db_connector._acquire(ref, read_only=True)
+            try:
+                rows = _fetch_dicts(conn_ro, applied_sql)
+            finally:
+                conn_ro.close()
+            df = pd.DataFrame(rows) if rows else pd.DataFrame()
+            option = chart_option(df, ChartRequest.from_mapping(chart_spec))
+            option_json = json.dumps(option, ensure_ascii=False)
+            # 缓存回写（含占位符也写，方便无 time_range 时复用 —— 但含占位符路径不会命中缓存）
+            with _write_lock:
+                conn = _connect()
+                try:
+                    _exec(conn, "UPDATE dw_bi_dashboard_cards SET echarts_option=?, updated_at=? WHERE card_id=?",
+                          (option_json, _now(), card_id))
+                    conn.commit()
+                finally:
+                    conn.close()
+            result["echarts_option"] = option
+        except Exception as e:
+            result["echarts_option"] = None
+            result["error"] = str(e)
+    elif cached:
+        result["echarts_option"] = cached
+    else:
+        result["echarts_option"] = None
+
+    return result
+
+
+def render_dashboard(dashboard_id: str, force_refresh: bool = False,
+                     time_range: tuple[str, str] | None = None) -> dict | None:
+    """渲染看板所有卡片。time_range 透传给每个卡片的 render_card。"""
+    dash = get_dashboard(dashboard_id)
+    if not dash:
+        return None
+    cards = list_cards(dashboard_id)
+    rendered = []
+    for card in cards:
+        r = render_card(card["card_id"], force_refresh=force_refresh, time_range=time_range)
+        if r:
+            rendered.append(r)
+    return {
+        "dashboard_id": dash["dashboard_id"],
+        "name": dash["name"],
+        "description": dash.get("description"),
+        "layout_json": _parse_json_field(dash, "layout_json") or {},
+        "filter_defaults": _parse_json_field(dash, "filter_defaults"),
+        "cards": rendered,
+    }
+
+
+# ==========================================================================
+# 时间范围占位符替换
+# ==========================================================================
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+
+
+def _apply_time_range(sql: str | None, time_range: tuple[str, str] | None) -> str | None:
+    """把 {{time_start}} / {{time_end}} 替换为 'YYYY-MM-DD' 字面量。
+
+    - sql 为 None → None
+    - time_range 为 None → 原样返回（保留占位符由下游数据库报错，或无占位符时正常执行）
+    - start/end 必须 ^\\d{4}-\\d{2}-\\d{2}$，否则 ValueError
+    - SQL 不含占位符时原样返回
+    """
+    if sql is None:
+        return None
+    if time_range is None:
+        return sql
+    start, end = time_range
+    if not (_DATE_RE.match(start) and _DATE_RE.match(end)):
+        raise ValueError("invalid date format: must be YYYY-MM-DD")
+    return (
+        sql.replace("{{time_start}}", f"'{start}'")
+           .replace("{{time_end}}", f"'{end}'")
+    )
+
+
+# ==========================================================================
+# 从 dw-report 导入
+# ==========================================================================
+def import_from_report(spec_path: str, dashboard_name: str | None = None,
+                       datasource_ref: str | None = None) -> dict | None:
+    """从 dw-report 的 spec + data JSON 导入看板。"""
+    spec_path_obj = Path(spec_path).expanduser().resolve()
+    if not spec_path_obj.exists():
+        # 尝试同目录下找 data JSON
+        spec_path_obj = Path(spec_path).expanduser().resolve()
+
+    spec = None
+    data = None
+
+    # 尝试读取 spec JSON
+    for candidate in [spec_path_obj, spec_path_obj.with_name(spec_path_obj.stem + "_spec.json")]:
+        if candidate.exists():
+            try:
+                spec = json.loads(candidate.read_text("utf-8"))
+                break
+            except (json.JSONDecodeError, OSError):
+                pass
+
+    # 尝试读取 data JSON
+    # 候选路径必须严格指向 data 文件，绝不能让 spec 自身被当 data 加载
+    # （当 spec 文件名恰好是 spec.json 时，"spec".replace("_spec","_data") 返回原串，
+    #  candidate 退化为 spec.json 自身 → spec 被错当 data 读入 → charts_data 为空）
+    stem = spec_path_obj.stem
+    data_candidates = []
+    if "_spec" in stem:
+        data_candidates.append(spec_path_obj.with_name(stem.replace("_spec", "_data") + ".json"))
+    data_candidates.append(spec_path_obj.with_name(stem + "_data.json"))
+    data_candidates.append(spec_path_obj.parent / "data.json")
+    for dc in data_candidates:
+        # 兜底：跳过与 spec 自身同路径的候选，防止任何情况下把 spec 错当 data
+        if dc == spec_path_obj:
+            continue
+        if dc.exists():
+            try:
+                candidate_data = json.loads(dc.read_text("utf-8"))
+                # 最小校验：data 必须是 dict 且含 charts 键（chart ID → ECharts option 映射）
+                # 否则视为非 data 文件（如 spec 错配），跳过
+                if isinstance(candidate_data, dict) and "charts" in candidate_data:
+                    data = candidate_data
+                    break
+            except (json.JSONDecodeError, OSError):
+                pass
+
+    if not spec:
+        return None
+
+    # ---- SQL dry-run 校验：导入前先验证每条 sql 能跑通 ----
+    # 防止 agent 重写 spec 时引入语法/列引用错误，错误 SQL 落库后只有渲染才发现
+    sections_pre = spec.get("sections", [])
+    kpis_pre = spec.get("kpis", [])
+    sql_errors: list[dict] = []
+    if datasource_ref:
+        # 图表卡片 SQL
+        for i, sec in enumerate(sections_pre):
+            sql = (sec.get("sql") or "").strip()
+            if not sql:
+                continue
+            try:
+                conn_ro, _ = db_connector._acquire(datasource_ref, read_only=True)
+                try:
+                    cur = conn_ro.cursor()
+                    cur.execute(f"EXPLAIN {sql}")
+                    cur.fetchall()
+                finally:
+                    conn_ro.close()
+            except Exception as e:
+                sql_errors.append({
+                    "kind": "chart",
+                    "section_index": i,
+                    "title": sec.get("title", f"Section {i+1}"),
+                    "sql": sql[:500],
+                    "error": str(e)[:500],
+                })
+        # KPI SQL
+        for i, kpi in enumerate(kpis_pre):
+            sql = (kpi.get("sql") or "").strip()
+            if not sql:
+                sql_errors.append({
+                    "kind": "kpi",
+                    "section_index": i,
+                    "title": kpi.get("label", f"KPI {i+1}"),
+                    "sql": "",
+                    "error": "KPI 缺少 sql 字段——KPI 卡片必须带 sql 才能在看板动态取值",
+                })
+                continue
+            try:
+                conn_ro, _ = db_connector._acquire(datasource_ref, read_only=True)
+                try:
+                    cur = conn_ro.cursor()
+                    cur.execute(f"EXPLAIN {sql}")
+                    cur.fetchall()
+                finally:
+                    conn_ro.close()
+            except Exception as e:
+                sql_errors.append({
+                    "kind": "kpi",
+                    "section_index": i,
+                    "title": kpi.get("label", f"KPI {i+1}"),
+                    "sql": sql[:500],
+                    "error": str(e)[:500],
+                })
+    if sql_errors:
+        return {"error": "sql_validation_failed", "details": sql_errors}
+
+    title = dashboard_name or spec.get("title", "导入看板")
+    dash = create_dashboard({
+        "name": title,
+        "description": spec.get("subtitle") or spec.get("background"),
+        "source_type": "dw-report",
+        "source_ref": str(spec_path_obj),
+    })
+
+    sections = spec.get("sections", [])
+    charts_data = data.get("charts", {}) if data else {}
+    kpis = spec.get("kpis", [])
+
+    # 从 KPIs 创建 KPI 卡片
+    for i, kpi in enumerate(kpis):
+        create_card(dash["dashboard_id"], {
+            "title": kpi.get("label", f"KPI {i+1}"),
+            "card_type": "kpi",
+            "sql_query": kpi.get("sql"),
+            "datasource_ref": datasource_ref,
+            "grid_pos": {"row": 0, "col": i, "w": 1, "h": 1},
+            "order_index": i,
+        })
+
+    # 从 sections 创建图表卡片
+    offset = len(kpis)
+    for i, section in enumerate(sections):
+        chart_spec = section.get("chart")
+        chart_id = chart_spec if isinstance(chart_spec, str) else None
+        echarts_option = charts_data.get(chart_id) if (chart_id and charts_data) else None
+
+        # chart 字段为 dict (fast-path spec 格式)
+        cs = None
+        if isinstance(chart_spec, dict):
+            cs = chart_spec
+        elif chart_id and echarts_option is None:
+            # chart_id 是引用，但不在此 data 中
+            pass
+
+        create_card(dash["dashboard_id"], {
+            "title": section.get("title", f"Section {i+1}"),
+            "card_type": "chart",
+            "chart_spec": cs,
+            "echarts_option": echarts_option,
+            "sql_query": section.get("sql"),
+            "datasource_ref": datasource_ref,
+            "grid_pos": {"row": 1 + i // 3, "col": i % 3, "w": 1, "h": 1},
+            "order_index": offset + i,
+        })
+
+    return get_dashboard(dash["dashboard_id"])
