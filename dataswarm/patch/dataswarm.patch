+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis_flow 执行预算单测（O1：deadline 语义=脚本累计执行时间）。
+
+思考链实证（open-analysis-smoke-fix2 ck-27）：墙钟判据下 5 成分编译完必报
+deadline_exhausted，模型被逼「单条巨型命令」绕过编排轮耗。改为 budget.exec_ms
+累计（每次进程 _save 记账一次）+ 判据 = 已记账 + 本次进程进行中。
+"""
+from __future__ import annotations
+
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+_FLOW = (Path(__file__).resolve().parents[3]
+         / "jiuwenswarm/resources/agent/workspace/skills/dw-analysis/scripts/analysis_flow.py")
+sys.path.insert(0, str(_FLOW.parent))
+import flow.budget as budget  # noqa: E402
+import flow.manifest as manifest_mod  # noqa: E402
+
+
+def _flow_manifest():
+    """flow.manifest 模块对象——_PROC_START/_PROC_ACCOUNTED/ARTIFACT_ROOT 的
+    单一家（Phase 2a 拆层后 patch 打这里，打 analysis_flow 命名空间无效）。"""
+    return manifest_mod
+
+
+def _manifest(deadline_ms: int = 90000, exec_ms: int = 0) -> dict:
+    return {
+        "analysis_id": "a-test", "question": "q", "mode": "open",
+        "started_at": "2026-10-18T12:00:00",
+        "plan": {"budget": {"deadline_ms": deadline_ms},
+                 "components": [{"component_id": "c1", "role": "core", "required": True}]},
+        "components": {"c1": {"status": "planned", "attempts": [], "explore_rounds": [],
+                              "sufficiency_trace": [], "retries": 0}},
+        "budget": {"sql_count": 0, "explore_count": 0, "tool_calls": 0,
+                   "exec_ms": exec_ms},
+        "uncovered": [], "result_checks": {}, "notes": [],
+    }
+
+
+@pytest.fixture(autouse=True)
+def _fresh_proc_start(monkeypatch):
+    """全量套件下本文件模块在收集期导入，_PROC_START 定在收集时刻；文件实际
+    执行可能在数百秒后（orchestration 等目录排在 skills 前），elapsed 判据
+    会被套件时长污染触发 deadline_exhausted——统一重置为各测试自身时刻。
+    Phase 2a 起 _PROC_START 的家在 flow.manifest（proc_elapsed_ms 读模块
+    全局），patch 必须打在那里。"""
+    monkeypatch.setattr(_flow_manifest(), "_PROC_START", time.monotonic())
+
+
+def test_save_accounts_exec_ms_once(tmp_path, monkeypatch):
+    """_save 把本次进程耗时累进 exec_ms，同进程多次 _save 只记一次。"""
+    fm = _flow_manifest()
+    monkeypatch.setattr(fm, "ARTIFACT_ROOT", tmp_path)
+    manifest = _manifest()
+    fm._PROC_ACCOUNTED = False
+    manifest_mod._save(manifest)
+    first = manifest["budget"]["exec_ms"]
+    assert first >= 0
+    manifest_mod._save(manifest)
+    assert manifest["budget"]["exec_ms"] == first  # 不重复累加
+    fm._PROC_ACCOUNTED = False  # 复位，避免污染其他测试
+
+
+def test_work_allowed_uses_exec_ms_not_wallclock(monkeypatch):
+    """判据 = 已记账 exec_ms + 本次进程进行中——与 started_at 墙钟无关。"""
+    monkeypatch.setattr(_flow_manifest(), "_PROC_START", time.monotonic() - 5)
+    # 老账本已记 89.9s + 本次进程已进行 5s → 超 90s 限 → required 成分拒绝
+    manifest = _manifest(exec_ms=89900)
+    with pytest.raises(SystemExit, match="deadline_exhausted"):
+        budget._work_allowed(manifest, "c1", sql=True)
+    # started_at 在远古（墙钟早已超限）但 exec_ms 为 0 + 本次刚起步 → 放行
+    fresh = _manifest(exec_ms=0)
+    assert budget._work_allowed(fresh, "c1", sql=True) is True
+
+
+def test_work_allowed_execution_path_defers_tool_budget_to_main():
+    """执行路径不判定 tool_calls——main() 先检查后计数是单一闸门；
+    恰好达 cap 时本次调用已被 main 放行计数，work 必须允许。"""
+    manifest = _manifest()
+    manifest["budget"]["tool_calls"] = 30  # == MAX_TOOL_CALLS
+    assert budget._work_allowed(manifest, "c1", sql=True) is True
+
+
+def test_work_allowed_advisory_at_cap_reports_exhaustion():
+    """advisory（cmd_next 波次建议）按 main 准入边界预判：达 cap 不再建议新工作。
+    optional 自动跳过写账本；required 报错口径与 main 拒绝一致。"""
+    optional = _manifest()
+    optional["plan"]["components"] = [
+        {"component_id": "c1", "role": "facet", "required": False}]
+    optional["budget"]["tool_calls"] = 30
+    assert budget._work_allowed(optional, "c1", sql=True, advisory=True) is False
+    assert optional["components"]["c1"]["status"] == "skipped"
+    assert any("tool_budget_exhausted" in note for note in optional["uncovered"])
+
+    required = _manifest()
+    required["budget"]["tool_calls"] = 30
+    with pytest.raises(SystemExit, match="tool_budget_exhausted"):
+        budget._work_allowed(required, "c1", sql=True, advisory=True)
+
+
+def test_work_allowed_advisory_below_cap_allows():
+    """cap-1 时 advisory 仍放行（与 main 准入一致：还差一次才到顶）。"""
+    manifest = _manifest()
+    manifest["budget"]["tool_calls"] = 29
+    assert budget._work_allowed(manifest, "c1", sql=True, advisory=True) is True
+
+
+def test_legacy_manifest_without_exec_ms(monkeypatch):
+    """老 manifest 无 exec_ms 字段 → 从 0 起步，不炸。"""
+    monkeypatch.setattr(_flow_manifest(), "_PROC_START", time.monotonic())
+    legacy = _manifest()
+    legacy["budget"].pop("exec_ms")
+    assert budget._work_allowed(legacy, "c1", sql=True) is True
