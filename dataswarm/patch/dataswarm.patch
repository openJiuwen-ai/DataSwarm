diff --git a/jiuwenswarm/channels/web/frontend/src/features/datasource/store/dataSourceStore.ts b/jiuwenswarm/channels/web/frontend/src/features/datasource/store/dataSourceStore.ts
new file mode 100644
index 000000000..09abbac3d
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/datasource/store/dataSourceStore.ts
@@ -0,0 +1,227 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { create } from 'zustand';
+import { dataSourceApi } from '../api/dataSourceApi';
+import { useDataManagementStore } from '../../data-management/store/dataManagementStore';
+import type {
+  CsvInferenceResult,
+  DataSourceEntry,
+  SourceFormParams,
+  SourceMutationResult,
+  SourceTypeCatalogEntry,
+} from '../types/dataSource';
+
+interface DataSourceState {
+  sourceTypes: SourceTypeCatalogEntry[];
+  datasources: DataSourceEntry[];
+  yamlWorkspace: boolean;
+  activeWorkspaceId: string;
+  loading: boolean;
+  typesLoading: boolean;
+  typesError: string | null;
+  error: string | null;
+  /** db_ref -> probe result (ok / error) */
+  probeResults: Record<string, { ok: boolean; error?: string }>;
+  probingRefs: Set<string>;
+  loadSourceTypes: () => Promise<void>;
+  loadDatasources: (workspaceId?: string) => Promise<void>;
+  probe: (dbRef: string, workspaceId?: string, sourceId?: string) => Promise<void>;
+  /** contextWorkspaceId：仅写入 query 参数定位存储元库（请求上下文），body 不带 workspace_id 即不触发自动绑定 */
+  createSource: (params: SourceFormParams, contextWorkspaceId?: string) => Promise<SourceMutationResult>;
+  updateSource: (params: SourceFormParams) => Promise<SourceMutationResult>;
+  deleteSource: (sourceId: string, force?: boolean) => Promise<SourceMutationResult>;
+  bindSource: (sourceId: string) => Promise<SourceMutationResult>;
+  clearError: () => void;
+}
+
+interface CsvState {
+  csvPath: string;
+  sampleRows: number;
+  inferring: boolean;
+  result: CsvInferenceResult | null;
+  error: string | null;
+  setCsvPath: (path: string) => void;
+  setSampleRows: (rows: number) => void;
+  inferCsv: () => Promise<void>;
+  clearError: () => void;
+}
+
+/** 可创建的类型（available 且有表单字段）在类型目录中排在"即将支持"前面 */
+function isCreatable(entry: SourceTypeCatalogEntry) {
+  return entry.available === true && entry.fields.length > 0;
+}
+
+let listRequest = 0;
+let typesRequest = 0;
+let workspaceGeneration = 0;
+
+export const useDataSourceStore = create<DataSourceState>((set, get) => ({
+  sourceTypes: [],
+  datasources: [],
+  yamlWorkspace: true,
+  activeWorkspaceId: '',
+  loading: false,
+  typesLoading: false,
+  typesError: null,
+  error: null,
+  probeResults: {},
+  probingRefs: new Set(),
+
+  loadSourceTypes: async () => {
+    const request = ++typesRequest;
+    set({ typesLoading: true, typesError: null });
+    try {
+      const payload = await dataSourceApi.listSourceTypes();
+      if (!payload.ok) throw new Error(payload.error);
+      if (request === typesRequest)
+        set({
+          sourceTypes: [...payload.types].sort(
+            (a, b) => Number(isCreatable(b)) - Number(isCreatable(a)),
+          ),
+          typesLoading: false,
+        });
+    } catch (error) {
+      if (request === typesRequest)
+        set({ typesLoading: false, typesError: error instanceof Error ? error.message : String(error) });
+    }
+  },
+
+  loadDatasources: async (workspaceId) => {
+    const request = ++listRequest;
+    const switching = get().activeWorkspaceId !== (workspaceId ?? '');
+    if (switching) workspaceGeneration += 1;
+    set({
+      loading: true,
+      error: null,
+      activeWorkspaceId: workspaceId ?? '',
+      ...(switching ? { datasources: [], yamlWorkspace: true, probeResults: {}, probingRefs: new Set<string>() } : {}),
+    });
+    try {
+      const payload = await dataSourceApi.list(workspaceId);
+      if (!payload.ok) throw new Error(payload.error);
+      if (request !== listRequest) return;
+      set({
+        datasources: payload.datasources ?? [],
+        yamlWorkspace: payload.yaml_workspace === true,
+        activeWorkspaceId: workspaceId ?? '',
+        loading: false,
+      });
+    } catch (error) {
+      if (request === listRequest)
+        set({ loading: false, error: error instanceof Error ? error.message : String(error) });
+    }
+  },
+
+  probe: async (dbRef, workspaceId, sourceId) => {
+    if (get().probingRefs.has(dbRef)) return;
+    const generation = workspaceGeneration;
+    const probing = new Set(get().probingRefs);
+    probing.add(dbRef);
+    set({ probingRefs: probing });
+    try {
+      const result = await dataSourceApi.probe(dbRef, workspaceId, sourceId);
+      if (generation !== workspaceGeneration) return;
+      const probeResults = { ...get().probeResults, [dbRef]: { ok: result.ok, error: result.error } };
+      set({ probeResults });
+    } catch (error) {
+      if (generation !== workspaceGeneration) return;
+      const probeResults = {
+        ...get().probeResults,
+        [dbRef]: { ok: false, error: error instanceof Error ? error.message : String(error) },
+      };
+      set({ probeResults });
+    } finally {
+      if (generation !== workspaceGeneration) return;
+      const next = new Set(get().probingRefs);
+      next.delete(dbRef);
+      set({ probingRefs: next });
+    }
+  },
+
+  createSource: async (params, contextWorkspaceId) => {
+    const workspaceId = get().activeWorkspaceId;
+    try {
+      const result = await dataSourceApi.createSource(params, contextWorkspaceId);
+      if (!result.ok) {
+        return result;
+      }
+      if (workspaceId === get().activeWorkspaceId) await get().loadDatasources(workspaceId || undefined);
+      return result;
+    } catch (error) {
+      return { ok: false, error: error instanceof Error ? error.message : String(error) };
+    }
+  },
+
+  updateSource: async (params) => {
+    try {
+      const workspaceId = get().activeWorkspaceId || undefined;
+      const result = await dataSourceApi.updateSource(workspaceId ? { ...params, workspace_id: workspaceId } : params);
+      if (!result.ok) {
+        return result;
+      }
+      if ((workspaceId ?? '') === get().activeWorkspaceId) await get().loadDatasources(workspaceId);
+      return result;
+    } catch (error) {
+      return { ok: false, error: error instanceof Error ? error.message : String(error) };
+    }
+  },
+
+  deleteSource: async (sourceId, force = false) => {
+    try {
+      const workspaceId = get().activeWorkspaceId || undefined;
+      const result = await dataSourceApi.deleteSource(sourceId, force, workspaceId);
+      if (!result.ok) {
+        return result;
+      }
+      if ((workspaceId ?? '') === get().activeWorkspaceId) await get().loadDatasources(workspaceId);
+      return result;
+    } catch (error) {
+      return { ok: false, error: error instanceof Error ? error.message : String(error) };
+    }
+  },
+
+  bindSource: async (sourceId) => {
+    try {
+      const workspaceId = get().activeWorkspaceId || '';
+      const result = await dataSourceApi.bindSource(sourceId, workspaceId);
+      if (!result.ok) {
+        return result;
+      }
+      // 换绑后清数据资产页残留选中态（selectedDb 单例残留会展示旧源库表）
+      useDataManagementStore.getState().reset();
+      if (workspaceId === get().activeWorkspaceId) await get().loadDatasources(workspaceId || undefined);
+      return result;
+    } catch (error) {
+      return { ok: false, error: error instanceof Error ? error.message : String(error) };
+    }
+  },
+
+  clearError: () => set({ error: null }),
+}));
+
+export const useCsvSourceStore = create<CsvState>((set, get) => ({
+  csvPath: '',
+  sampleRows: 100,
+  inferring: false,
+  result: null,
+  error: null,
+
+  setCsvPath: (path) => set({ csvPath: path }),
+  setSampleRows: (rows) => set({ sampleRows: Math.max(1, Math.min(1000, rows)) }),
+
+  inferCsv: async () => {
+    const path = get().csvPath.trim();
+    if (!path) {
+      set({ error: '请输入 CSV 文件或目录路径', result: null });
+      return;
+    }
+    set({ inferring: true, error: null });
+    try {
+      const result = await dataSourceApi.inferCsv(path, get().sampleRows);
+      set({ inferring: false, result });
+    } catch (error) {
+      set({ inferring: false, error: error instanceof Error ? error.message : String(error) });
+    }
+  },
+
+  clearError: () => set({ error: null }),
+}));
