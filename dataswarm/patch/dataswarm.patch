@@ -0,0 +1,137 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Python 执行器。
+
+把用户代码写到临时 .py 文件，subprocess 跑 [sys.executable, tmp_py]，
+超时 kill，stdout/stderr 落盘。抄 command_tools._run_command_sync 的 poll+communicate
++ FD 清理 + 跨平台 encoding。
+
+params 通过 node_<n>.params.json 注入，代码里可：
+    import json, os
+    p = json.load(open(os.environ["ORCH_PARAMS_FILE"]))
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import time
+
+from .base import Executor, TaskRunResult, register
+
+
+@register
+class PythonExecutor(Executor):
+    executor_type = "python"
+
+    def run(self, code, params, datasource_ref, timeout_s, artifact_dir, log_prefix="node"):
+        artifact_dir.mkdir(parents=True, exist_ok=True)
+        script_path = artifact_dir / f"{log_prefix}.py"
+        params_path = artifact_dir / f"{log_prefix}.params.json"
+        stdout_path = artifact_dir / f"{log_prefix}.stdout.log"
+        stderr_path = artifact_dir / f"{log_prefix}.stderr.log"
+        # 注入编排上下文：参数文件 + 数据源路径
+        header = (
+            "import os, sys, json\n"
+            f"_p = open(os.environ.get('ORCH_PARAMS_FILE',''), encoding='utf-8') "
+            "if os.environ.get('ORCH_PARAMS_FILE') else None\n"
+            "ORCH_PARAMS = json.load(_p) if _p else {}\n"
+            "if _p: _p.close()\n"
+            f"ORCH_DATASOURCE = {repr(datasource_ref)}\n"
+            "import sqlite3 as _sqlite3\n"
+            f"_DEFAULT_DB = {repr(str(_default_db_path(datasource_ref)))}\n"
+            "def open_ro(path=None):\n"
+            "    p = path or _DEFAULT_DB\n"
+            "    import sqlite3\n"
+            "    return sqlite3.connect(f'file:'+str(p)+'?mode=ro', uri=True)\n"
+            "\n"
+        )
+        self._write_text(script_path, header + "\n" + code)
+        self._write_text(params_path, json.dumps(params or {}, ensure_ascii=False, indent=2))
+        result_summary: dict = {}
+        stdout_f = stdout_path.open("w", encoding="utf-8")
+        stderr_f = stderr_path.open("w", encoding="utf-8")
+        env = os.environ.copy()
+        env["ORCH_PARAMS_FILE"] = str(params_path)
+        env["PYTHONIOENCODING"] = "utf-8"  # 强制子进程 stdout/stderr 用 utf-8，避免 Windows GBK 乱码
+        # workspace 上下文透传：ContextVar 传不进子进程、服务进程 env 也没有该变量，
+        # Python 节点代码里 workspace_context.current_workspace() 会大声失败
+        # （实测 2026-09-15：probe 任务 RESOLVE_FAIL WorkspaceContextRequired）。
+        # 编排引擎（run_workflow_instance/_run_one / scheduler._execute_instance）
+        # 已在节点线程 set_current——这里读当前作用域注入 env，与 bash 工具链
+        # （bash_tool_safety）同口径；无上下文（单工作空间/legacy）跳过不注入。
+        try:
+            from jiuwenswarm.common import workspace_context as _wc
+
+            _ws_id = _wc.current_workspace().workspace_id
+            if _ws_id:
+                env["JIUWENSWARM_WORKSPACE_ID"] = _ws_id
+        except Exception:  # noqa: BLE001 —— 无 workspace 配置时静默跳过，走 env 缺省
+            pass
+        cmd = [sys.executable, str(script_path)]
+        try:
+            proc = subprocess.Popen(
+                cmd,
+                stdout=stdout_f,
+                stderr=stderr_f,
+                cwd=str(artifact_dir),
+                env=env,
+                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+            )
+        except Exception as exc:  # noqa: BLE001
+            stdout_f.close()
+            stderr_f.close()
+            self._write_text(stderr_path, f"[python_executor] Popen failed: {exc}")
+            return TaskRunResult(
+                exit_code=1,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                error_message=str(exc),
+                status="failed",
+            )
+        t0 = time.time()
+        try:
+            # 轮询 poll，超时 kill（抄 _run_command_sync 的 poll+communicate 混合）
+            while True:
+                rc = proc.poll()
+                if rc is not None:
+                    break
+                if time.time() - t0 > timeout_s:
+                    proc.kill()
+                    proc.wait()
+                    self._write_text(stderr_path, f"\n[python_executor] timeout after {timeout_s}s, killed")
+                    return TaskRunResult(
+                        exit_code=124,
+                        stdout_path=str(stdout_path),
+                        stderr_path=str(stderr_path),
+                        error_message=f"timeout after {timeout_s}s",
+                        status="timeout",
+                    )
+                time.sleep(0.3)
+            elapsed_ms = int((time.time() - t0) * 1000)
+            result_summary = {
+                "exit_code": proc.returncode,
+                "elapsed_ms": elapsed_ms,
+            }
+            status = "success" if proc.returncode == 0 else "failed"
+            err = None if proc.returncode == 0 else f"exit code {proc.returncode}"
+            return TaskRunResult(
+                exit_code=proc.returncode,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                result_summary=result_summary,
+                error_message=err,
+                status=status,
+            )
+        finally:
+            stdout_f.close()
+            stderr_f.close()
+
+
+def _default_db_path(datasource_ref: str | None) -> str:
+    """SQL 默认数据源。"""
+    if datasource_ref:
+        return datasource_ref
+    from .. import db as orch_db
+
+    return str(orch_db.WAREHOUSE_DB)
