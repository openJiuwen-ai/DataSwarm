+def replace_nodes(wf_id: str, nodes: list[dict]) -> list[dict]:
+    """整体替换工作流的节点（前端编辑器保存时用）。"""
+    from .node_graph import validate_nodes
+    if any(not isinstance(node, dict) for node in nodes):
+        raise ValueError("nodes must be objects")
+    if any(node.get("upstream_nodes") is not None and not isinstance(node["upstream_nodes"], str) for node in nodes):
+        raise ValueError("upstream_nodes must be a comma-separated string")
+    nodes = [
+        {
+            **node,
+            "node_id": node.get("node_id") or new_id("node"),
+            "upstream_nodes": ",".join(
+                parent.strip() for parent in (node.get("upstream_nodes") or "").split(",") if parent.strip()
+            ),
+        }
+        for node in nodes
+    ]
+    validate_nodes(nodes)
+    now = _now()
+    with _write_lock:
+        conn = _connect()
+        try:
+            if not _fetch_one_dict(conn, "SELECT workflow_id FROM dw_workflows WHERE workflow_id=?", (wf_id,)):
+                raise ValueError("workflow not found")
+            if nodes:
+                node_ids = [node["node_id"] for node in nodes]
+                owners = _fetch_dicts(
+                    conn,
+                    "SELECT workflow_id FROM dw_workflow_nodes WHERE node_id IN ("
+                    + ",".join("?" for _ in node_ids) + ")",
+                    tuple(node_ids),
+                )
+                if any(owner["workflow_id"] != wf_id for owner in owners):
+                    raise ValueError("node belongs to another workflow")
+                task_ids = sorted({node["task_id"] for node in nodes})
+                tasks = _fetch_dicts(
+                    conn,
+                    "SELECT task_id FROM dw_tasks WHERE task_id IN ("
+                    + ",".join("?" for _ in task_ids) + ")",
+                    tuple(task_ids),
+                )
+                missing = set(task_ids) - {task["task_id"] for task in tasks}
+                if missing:
+                    raise ValueError("task not found: " + ", ".join(sorted(missing)))
+            _exec(conn, "DELETE FROM dw_workflow_nodes WHERE workflow_id=?", (wf_id,))
+            for data in nodes:
+                _exec(conn, """INSERT INTO dw_workflow_nodes
+                       (node_id,workflow_id,task_id,group_name,node_name,upstream_nodes,
+                        wait_review,order_index,created_at)
+                       VALUES (?,?,?,?,?,?,?,?,?)""", (
+                    data["node_id"],
+                    wf_id,
+                    data["task_id"],
+                    data.get("group_name"),
+                    data.get("node_name"),
+                    data["upstream_nodes"],
+                    1 if data.get("wait_review") else 0,
+                    int(data.get("order_index", 0)),
+                    now,
+                ))
+            conn.commit()
+        finally:
+            conn.close()
+    return list_nodes(wf_id)
+
