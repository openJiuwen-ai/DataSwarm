+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""struct_notify 单测：classify_ddl / db_name_from_ref / emit 短路与容错（方案 §九）."""
+
+from __future__ import annotations
+
+from unittest.mock import patch
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent import struct_notify as sn
+
+
+# --------------------------------------------------------------------------
+# classify_ddl
+# --------------------------------------------------------------------------
+class TestClassifyDdl:
+    def test_create_plain(self):
+        assert sn.classify_ddl("CREATE TABLE dws_gmv (id bigint)") == [("CREATE", "dws_gmv")]
+
+    def test_create_backtick_doris(self):
+        # Doris 建表惯例（反引号 + ENGINE=OLAP），默认方言会退化成 Command
+        sql = (
+            "CREATE TABLE `dws_gmv_daily` (`id` bigint NOT NULL COMMENT 'ID') "
+            "ENGINE=OLAP DUPLICATE KEY(`id`) DISTRIBUTED BY HASH(`id`) BUCKETS 10"
+        )
+        assert sn.classify_ddl(sql) == [("CREATE", "dws_gmv_daily")]
+
+    def test_create_if_not_exists(self):
+        assert sn.classify_ddl("CREATE TABLE IF NOT EXISTS t1 (i int)") == [("CREATE", "t1")]
+
+    def test_create_with_db_prefix(self):
+        assert sn.classify_ddl("CREATE TABLE mydb.t1 (i int)") == [("CREATE", "mydb.t1")]
+
+    def test_alter(self):
+        assert sn.classify_ddl("ALTER TABLE `t1` ADD COLUMN c int") == [("ALTER", "t1")]
+
+    def test_drop(self):
+        assert sn.classify_ddl("DROP TABLE IF EXISTS old_x") == [("DROP", "old_x")]
+
+    def test_multi_statement(self):
+        assert sn.classify_ddl("CREATE TABLE a (i int); DROP TABLE b") == [
+            ("CREATE", "a"), ("DROP", "b"),
+        ]
+
+    def test_insert_not_ddl(self):
+        assert sn.classify_ddl("INSERT INTO t1 VALUES (1)") == []
+
+    def test_select_not_ddl(self):
+        assert sn.classify_ddl("SELECT * FROM t1 WHERE id = 1") == []
+
+    def test_comment_keyword_not_false_positive(self):
+        # 注释里的建表关键词不得误报（正则会误报，sqlglot 不会）
+        assert sn.classify_ddl("SELECT 1 -- CREATE TABLE fake") == []
+
+    def test_string_keyword_not_false_positive(self):
+        assert sn.classify_ddl("SELECT * FROM nope WHERE s = 'CREATE TABLE bad'") == []
+
+    def test_empty(self):
+        assert sn.classify_ddl("") == []
+        assert sn.classify_ddl("   ") == []
+
+
+# --------------------------------------------------------------------------
+# db_name_from_ref
+# --------------------------------------------------------------------------
+class TestDbNameFromRef:
+    @pytest.mark.parametrize("ref,expected", [
+        ("doris://olist_dw", "olist_dw"),
+        ("doris://host:9030/olist_dw", "olist_dw"),
+        ("sqlite:///data/x.db", "x"),
+        ("sqlite://C:/a/b.db", "b"),
+        ("/local/path.db", "path"),
+        ("", ""),
+    ])
+    def test_refs(self, ref, expected):
+        assert sn.db_name_from_ref(ref) == expected
+
+
+# --------------------------------------------------------------------------
+# emit 行为
+# --------------------------------------------------------------------------
+class TestEmit:
+    def _payload(self, sid="s1"):
+        return sn.build_table_change_payload(
+            session_id=sid, operation="CREATE", db="d", tables=["t1"],
+            sql="CREATE TABLE t1 (i int)",
+        )
+
+    def test_emit_without_session_short_circuits(self):
+        """无 session：不落历史不推送（append 到 default 会话是错误行为）。"""
+        with patch.object(sn, "_append_history") as hist, patch.object(sn, "notify_gateway") as notify:
+            sn._emit(self._payload(sid=""))
+        hist.assert_not_called()
+        notify.assert_not_called()
+
+    def test_emit_history_failure_does_not_block_notify(self):
+        with patch.object(sn, "_append_history", side_effect=RuntimeError("disk full")), \
+             patch.object(sn, "notify_gateway", return_value=True) as notify, \
+             patch.object(sn, "_session_exists", return_value=True):
+            sn._emit(self._payload())
+        notify.assert_called_once()
+
+    def test_emit_notify_failure_does_not_raise(self):
+        with patch.object(sn, "_append_history"), \
+             patch.object(sn, "notify_gateway", side_effect=OSError("refused")), \
+             patch.object(sn, "_session_exists", return_value=True):
+            sn._emit(self._payload())  # 不抛出
+
+    def test_emit_unknown_session_short_circuits(self):
+        with patch.object(sn, "_session_exists", return_value=False), \
+             patch.object(sn, "_append_history") as hist, \
+             patch.object(sn, "notify_gateway") as notify:
+            sn._emit(self._payload())
+        hist.assert_not_called()
+        notify.assert_not_called()
+
+    def test_emit_table_change_no_ddl_skips(self):
+        """非 DDL SQL（INSERT）不产事件。"""
+        with patch.object(sn, "_emit") as emit:
+            sn.emit_table_change(session_id="s1", sql="INSERT INTO t1 VALUES (1)", db_name="d")
+        emit.assert_not_called()
+
+    def test_emit_workflow_run_swallows_errors(self):
+        with patch.object(sn, "build_workflow_run_payload", side_effect=RuntimeError("boom")):
+            sn.emit_workflow_run(session_id="s1", instance={}, ref_type="task", name="x")
+
+    def test_emit_workflow_change_no_session_short_circuits(self):
+        """无 session：不落历史不推送。"""
+        with patch.object(sn, "_append_history") as hist, patch.object(sn, "notify_gateway") as notify:
+            sn.emit_workflow_change(
+                session_id="", operation="CREATE", workflow_id="wf_1", name="x", node_count=1,
+            )
+        hist.assert_not_called()
+        notify.assert_not_called()
+
+    def test_emit_workflow_change_emits_payload(self):
+        with patch.object(sn, "_emit") as emit:
+            sn.emit_workflow_change(
+                session_id="s1", operation="ADD_NODE", workflow_id="wf_1", name="GMV", node_count=5,
+            )
+        emit.assert_called_once()
+        payload = emit.call_args[0][0]
+        assert payload["kind"] == "workflow_change"
+        assert payload["workflow_change"]["operation"] == "ADD_NODE"
+        assert payload["workflow_change"]["workflow_id"] == "wf_1"
+        assert payload["workflow_change"]["node_count"] == 5
+
+
+class TestPayloadContract:
+    def test_table_change_digest_truncated(self):
+        sql = "CREATE TABLE t1 (i int) -- " + "x" * 500
+        payload = sn.build_table_change_payload(
+            session_id="s1", operation="CREATE", db="d", tables=["t1"], sql=sql,
+        )
+        digest = payload["table_change"]["sql_digest"]
+        assert len(digest) <= sn._SQL_DIGEST_LIMIT + 4  # 截断 + "..." 容差
+        assert digest.endswith("...")
+
+    def test_workflow_run_payload_shape(self):
+        inst = {"instance_id": "inst_1", "ref_id": "wf_1", "status": "queued"}
+        payload = sn.build_workflow_run_payload(
+            session_id="s1", instance=inst, ref_type="workflow", name="GMV",
+        )
+        assert payload["kind"] == "workflow_run"
+        assert payload["schema_version"] == 1
+        assert payload["event_id"].startswith("sc-")
+        assert payload["workflow_run"]["instance_id"] == "inst_1"
+        assert payload["workflow_run"]["name"] == "GMV"
