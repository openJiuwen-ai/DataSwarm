+def test_webhdfs_does_not_inherit_process_proxy_by_default():
+    """WebHDFS 默认必须直连，不继承进程的 HTTP_PROXY —— 批 11 真连抓到的缺陷。
+
+    OPEN 会被 NameNode 以 307 重定向到 **DataNode 的主机名**，那个名字是
+    NameNode 按 DataNode 注册信息在运行期生成的。进程若设了 HTTP_PROXY，
+    requests 默认 `trust_env=True` 会把这个内网地址也发给代理 → 502 Bad
+    Gateway，且错误里完全不提代理。
+
+    用户无法用 NO_PROXY 规避（重定向目标配置时未知），而且只测 LISTSTATUS 的
+    连通性检查还会通过（NameNode 地址常在 NO_PROXY 里），真正取数才失败——
+    所以这件事必须由代码兜住，不能推给部署。
+    """
+    from jiuwenswarm.channels.web.dataagent.connectors.staged_connector import (
+        _WebHdfsFetcher,
+    )
+
+    base = {"host": "nn.example.com", "port": 9870, "user": "hdfs"}
+    assert _WebHdfsFetcher(base)._session.trust_env is False
+    # 确有经代理访问的部署可以显式打开
+    assert _WebHdfsFetcher({**base, "use_proxy": True})._session.trust_env is True
+    # 字段要暴露出来，否则用户没法打开
+    assert any(f.key == "use_proxy" for f in R.get_source_type("hdfs").fields)
