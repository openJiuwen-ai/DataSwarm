+
+_DORIS_UNIQ_MOW = ("CREATE TABLE `dwd_orders` (\n `order_id` varchar(64) NOT NULL ) "
+                   "ENGINE=OLAP\nUNIQUE KEY(`order_id`)\nDISTRIBUTED BY HASH(`order_id`) "
+                   "BUCKETS 4\nPROPERTIES (\"enable_unique_key_merge_on_write\" = \"true\");")
+_DORIS_UNIQ_NOMOW = _DORIS_UNIQ_MOW.replace(
+    "\"enable_unique_key_merge_on_write\" = \"true\"",
+    "\"enable_unique_key_merge_on_write\" = \"false\"")
+_DORIS_DUP = ("CREATE TABLE `ods_orders` (...) ENGINE=OLAP\n"
+              "DUPLICATE KEY(`order_id`)\nDISTRIBUTED BY HASH(`order_id`) BUCKETS 8")
+
+
+def _probes(show_create="", version="", **extra):
+    p = {"show_create": lambda: show_create, "version": lambda: version}
+    p.update(extra)
+    return p
+
+
+class TestCapability:
+    def test_doris_uniq_mow_allows_update_delete(self):
+        c = cap_mod.compute_capability("doris://h:9030/db", "t",
+                                       probes=_probes(_DORIS_UNIQ_MOW, "2.1.7"))
+        assert c["ops"]["update"]["state"] == "supported"
+        assert c["ops"]["delete_condition"]["state"] == "supported"
+
+    def test_doris_uniq_without_mow_rejects_update(self):
+        c = cap_mod.compute_capability("doris://h:9030/db", "t",
+                                       probes=_probes(_DORIS_UNIQ_NOMOW, "2.1.7"))
+        assert c["ops"]["update"]["state"] == "unsupported"
+        assert "MoW" in c["ops"]["update"]["reason"]
+
+    def test_doris_duplicate_rejects_dml(self):
+        c = cap_mod.compute_capability("doris://h:9030/db", "t",
+                                       probes=_probes(_DORIS_DUP, "2.1.7"))
+        assert c["ops"]["update"]["state"] == "unsupported"
+        assert c["ops"]["delete_condition"]["state"] == "unsupported"
+        assert c["ops"]["insert_overwrite"]["state"] == "supported"
+
+    def test_doris_version_unparseable_insert_overwrite_unknown(self):
+        c = cap_mod.compute_capability("doris://h:9030/db", "t",
+                                       probes=_probes(_DORIS_DUP, ""))
+        assert c["ops"]["insert_overwrite"]["state"] == "unknown"
+
+    def test_probe_failure_yields_unknown_not_unsupported(self):
+        def boom():
+            raise RuntimeError("net down")
+        c = cap_mod.compute_capability("doris://h:9030/db", "t",
+                                       probes={"show_create": boom,
+                                               "version": boom})
+        assert c["ops"]["update"]["state"] == "unknown"
+
+    def test_mysql_innodb_supported_other_unknown(self):
+        ok = cap_mod.compute_capability("mysql://h:3306/db", "t",
+                                        probes={"engine": lambda: "InnoDB"})
+        bad = cap_mod.compute_capability("mysql://h:3306/db", "t",
+                                         probes={"engine": lambda: "MyISAM"})
+        assert ok["ops"]["update"]["state"] == "supported"
+        assert bad["ops"]["update"]["state"] == "unknown"
