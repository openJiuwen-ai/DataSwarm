@@ -0,0 +1,51 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""knowledge/roads.py —— 召回命中与路的共享契约（E1 解包环）。
+
+knowledge 生产、analysis 消费的召回领域模型。原定义在 ``analysis/model.py``，
+因 ``knowledge/retrieval`` 的唯一上行依赖边（原对 analysis.model 三符号的
+模块级导入）下沉至此——置于 knowledge 侧使依赖方向回到「下层不感知上层」；
+``analysis.model`` re-export 保持既有 import 路径（类身份同一：
+``analysis.model.RecallHit is knowledge.roads.RecallHit``）。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+# 向量通道门槛初值：对齐 metrics/embedding.EMB_SIM_FLOOR 的校准刻度下限——
+# 校准刻度调整两处须同步（有效值口径断言防漂移，见 E6b）。
+VECTOR_FLOOR = 0.50
+
+
+@dataclass
+class RecallHit:
+    """一路召回中的单个实体命中。
+
+    ``channels`` 是通道名到**原始分**的有序对（如 ``[("lexical", 0.9),
+    ("vector", 0.71)]``）——融合前各通道档位分/相似度，供观测与测试还原；
+    ``rrf_score`` 是融合排名分（跨通道可比，绝对值无意义）。
+    """
+
+    kind: str                    # term | metric | column | table | value
+    entity_id: str               # 稳定 ID（term_id / metric_key / col:node_id / value_id）
+    label: str
+    channels: list[tuple[str, float]] = field(default_factory=list)
+    matched_on: list[str] = field(default_factory=list)
+    rrf_score: float = 0.0
+    rank: int = 0                # 融合后名次（1 起）
+    payload: dict[str, Any] = field(default_factory=dict)  # kind 专属字段
+
+
+@dataclass(frozen=True)
+class RoadResult:
+    """一路（术语/指标/schema/维值）的召回结果。
+
+    ``raw_count`` 是门槛过滤前的通道候选数（与 ``hits`` 的差 = 被门槛/
+    发布态/deprecated 拦下的数量）——评审「为什么该命中没出现」的依据。
+    """
+
+    kind: str
+    hits: tuple[RecallHit, ...]
+    channel_status: str          # ok | no_hit | unavailable | stale | skipped
+    warnings: tuple[str, ...] = ()
+    raw_count: int = 0
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/schema_candidates.py b/jiuwenswarm/channels/web/dataagent/knowledge/schema_candidates.py
