+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useDrawer } from '../hooks/useDrawer';
+import { useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { EditorState } from '@codemirror/state';
+import { EditorView, keymap, lineNumbers, highlightActiveLine } from '@codemirror/view';
+import { defaultKeymap, history, historyKeymap, indentWithTab } from '@codemirror/commands';
+import { defaultHighlightStyle, syntaxHighlighting } from '@codemirror/language';
+import { sql } from '@codemirror/lang-sql';
+import { python } from '@codemirror/lang-python';
+import { Copy, Maximize2, Minimize2 } from 'lucide-react';
+import { toast } from './shared/Ui';
+
+export function TaskCodeEditor({
+  value,
+  language,
+  readOnly,
+  onChange,
+}: {
+  value: string;
+  language: 'sql' | 'python';
+  readOnly: boolean;
+  onChange: (value: string) => void;
+}) {
+  const { t } = useTranslation();
+  const host = useRef<HTMLDivElement>(null);
+  const view = useRef<EditorView | null>(null);
+  const change = useRef(onChange);
+  const current = useRef(value);
+  change.current = onChange;
+  current.current = value;
+  const [expanded, setExpanded] = useState(false);
+  const expandedRef = useDrawer(expanded, () => setExpanded(false));
+  useEffect(() => {
+    if (!host.current) return;
+    const editor = new EditorView({
+      parent: host.current,
+      state: EditorState.create({
+        doc: current.current,
+        extensions: [
+          lineNumbers(),
+          highlightActiveLine(),
+          history(),
+          keymap.of([...defaultKeymap, ...historyKeymap, indentWithTab]),
+          syntaxHighlighting(defaultHighlightStyle),
+          language === 'sql' ? sql() : python(),
+          EditorState.readOnly.of(readOnly),
+          EditorView.editable.of(!readOnly),
+          EditorView.contentAttributes.of({
+            'aria-label': t('dataAsset.taskForm.code'),
+            'aria-readonly': String(readOnly),
+          }),
+          EditorView.updateListener.of((update) => {
+            if (update.docChanged) change.current(update.state.doc.toString());
+          }),
+          EditorView.theme({
+            '&': {
+              height: '100%',
+              fontSize: '12px',
+              background: 'var(--color-surface-card)',
+              color: 'var(--color-text-primary)',
+            },
+            '.cm-scroller': { fontFamily: 'var(--font-mono)', overflow: 'auto' },
+            '.cm-gutters': {
+              background: 'var(--color-surface-muted)',
+              color: 'var(--color-text-placeholder)',
+              borderColor: 'var(--color-border-default)',
+            },
+            '.cm-activeLine': { background: 'var(--color-action-primary-subtle)' },
+            '.cm-cursor': { borderLeftColor: 'var(--color-text-primary)' },
+          }),
+        ],
+      }),
+    });
+    view.current = editor;
+    return () => {
+      editor.destroy();
+      view.current = null;
+    };
+  }, [language, readOnly, t]);
+  useEffect(() => {
+    const editor = view.current;
+    if (editor && editor.state.doc.toString() !== value)
+      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: value } });
+  }, [value]);
+  return (
+    <div
+      ref={expandedRef}
+      role={expanded ? 'dialog' : undefined}
+      aria-modal={expanded || undefined}
+      aria-label={expanded ? t('dataAsset.taskForm.code') : undefined}
+      className={`da-code-editor ${expanded ? 'is-expanded' : ''}`}
+    >
+      <div className="da-code-toolbar">
+        <span>{language === 'sql' ? 'SQL' : 'Python'}</span>
+        <button
+          type="button"
+          aria-label={t('dataAsset.taskForm.copy')}
+          title={t('dataAsset.taskForm.copy')}
+          onClick={() => {
+            void navigator.clipboard
+              .writeText(value)
+              .then(() => toast.success(t('dataAsset.taskForm.copied')))
+              .catch((e) => toast.error(e.message));
+          }}
+        >
+          <Copy size={14} />
+        </button>
+        <button
+          type="button"
+          aria-label={t(expanded ? 'dataAsset.taskForm.collapse' : 'dataAsset.taskForm.expand')}
+          title={t(expanded ? 'dataAsset.taskForm.collapse' : 'dataAsset.taskForm.expand')}
+          onClick={() => setExpanded(!expanded)}
+        >
+          {expanded ? <Minimize2 size={14} /> : <Maximize2 size={14} />}
+        </button>
+      </div>
+      <div className="da-code-host" ref={host} />
+    </div>
+  );
+}
