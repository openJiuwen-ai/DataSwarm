+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/shortcut.py —— 查询理解串行短路（第一级）判定。
+
+设计：``docs/archive/delivered/data-analysis-flow-shortcut-design.md`` §3.1。目标形态是三级
+串行漏斗——**先术语、术语够格就直接进计划、不够格再走指标召回、指标也
+召不到才退 schema 探索**，而不是四路并行融合后让模型在混杂候选面上挑。
+
+四条件全满足才短路（P0 取保守档：短路等于系统替用户认定口径，判错一次
+用户拿到的是「看似权威的错数」，比慢一点贵得多）：
+
+1. **命中过硬**：Top1 术语是「问句完整提及」——alias 精确档（问句完整
+   包含了术语名/别名，如「商品交易总额变化趋势」全名在句中）。LIKE
+   碎片档（问句某个词恰是术语名的子串，如「商品品类」的「商品」⊂
+   「商品交易总额」）与向量命中都不算——高频普通词的碎片碰撞不构成
+   「提及」，语义相似 ≠ 用户说的就是它；
+2. **没有第二处提及**：其余**完整提及**的术语都在抢**同一处**提及时可以
+   短路（强者通吃：问句写全了「商品交易总额」，精确命中 1.0 压过只蹭到
+   「交易总额」子串的 0.9，不算歧义）；命中**另一处**提及才算多诉求——
+   「GMV 和退款金额」是两件事，短路只锁 Top1 会丢掉第二件；
+3. **无歧义**：命中术语无 ``ambiguous`` 标记（同一处提及、同通道同原始分
+   并列 → 真分不清，先问用户）；
+4. **链唯一**：Top1 术语经 ``measuresConcept`` 链到**恰好一个** published
+   指标（回源复验由 :mod:`graph_expand` 完成——进 ``expansion.metrics``
+   的已是 published；一个术语挂多个指标 = 口径本身有分叉，留给模型甄别）。
+
+LIKE 碎片命中**不丢**：它仍进完整召回的候选榜（在那里有指标路/schema 路
+竞争，模型会甄别），只是不再单独替用户认定口径（实测事故：问「商品品类
+配送慢且评价低」被「商品」二字蹭中 GMV 术语，短路锁错指标全程跑偏）。
+
+**短路不豁免任何检查**：L3 的 scope 归属、六项口径检查、执行五层 guard、
+结果检查，对短路产物与完整召回产物一视同仁。短路只收窄候选面，不减安检。
+
+判定理由（:attr:`ShortcutVerdict.reasons`）全部进响应与 manifest 账本——
+评审要能回答「这个问题为什么没走短路」，也是后续放宽门槛的唯一依据。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from .graph_expand import Expansion
+from .model import GRAPH_MEASURES_PREFIX, RecallHit, RoadResult
+from .rerank import dedupe_and_rank, mark_ambiguity
+
+# 路由取值（响应 route 字段）
+ROUTE_TERM_SHORTCUT = "term_shortcut"
+ROUTE_FULL_RECALL = "full_recall"
+
+# 漏斗层级（观测用，对齐设计 ⑥ 的 A/B/C 分流命名）：
+# A = 术语直达；B = 术语命中但不够格，术语先验并入多路候选互证；
+# C = 术语未命中，纯多路召回。行为上 B/C 同走完整召回，分开只为可观测
+# ——「为什么没直达」与「压根没认出术语」是两类完全不同的改进动作
+# （前者补建模/消歧义，后者补术语库）。
+TIER_A_SHORTCUT = "A:term_shortcut"
+TIER_B_UNION = "B:union_with_term_prior"
+TIER_C_LEXICAL = "C:no_term_hit"
+
+
+def route_tier(verdict: ShortcutVerdict | None) -> str:
+    """判定结果 → 漏斗层级（None = 补召回轮，按 C 记）。"""
+    if verdict is None:
+        return TIER_C_LEXICAL
+    if verdict.eligible:
+        return TIER_A_SHORTCUT
+    return TIER_C_LEXICAL if REASON_NO_TERM in verdict.reasons else TIER_B_UNION
+
+# 判定理由码
+REASON_ELIGIBLE = "eligible"
+REASON_NO_TERM = "no_term_hit"                       # 术语路空
+REASON_NOT_LEXICAL = "top_term_not_lexical"          # 条件 1（只有碎片/向量命中）
+REASON_MULTI_TERM = "multi_lexical_terms"            # 条件 2
+REASON_AMBIGUOUS = "term_ambiguous"                  # 条件 3
+REASON_NO_LINK = "no_published_metric_link"          # 条件 4（链空）
+REASON_LINK_FORKED = "metric_link_forked"            # 条件 4（链分叉）
+REASON_RECALL_MORE = "recall_more_always_full"       # 补召回轮不判定
+REASON_NO_METRIC_CANDIDATE = "no_metric_candidate"   # 第二级空榜 → 第三级
+
+
+@dataclass(frozen=True)
+class ShortcutVerdict:
+    """短路判定结果。
+
+    ``term`` / ``metric_hit`` 仅在 ``eligible`` 时完整——短路包的术语口径
+    与选定指标就取自这里，不再二次召回。
+    """
+
+    eligible: bool
+    reasons: tuple[str, ...]
+    term: dict[str, Any] | None = None
+    metric_hit: RecallHit | None = None
+
+
+def term_shortcut_verdict(term_road: RoadResult, expansion: Expansion) -> ShortcutVerdict:
+    """第一级短路判定（四条件合取）。
+
+    Args:
+        term_road: 术语路召回结果（L1 只跑这一路的产物）。
+        expansion: 以术语为入口的图补全结果（提供 term → published 指标链）。
+
+    Returns:
+        :class:`ShortcutVerdict`——不合格时 ``reasons`` 列出全部未过条件
+        （不短路于第一个失败条件，评审要看全貌）。
+    """
+    ranked = mark_ambiguity(dedupe_and_rank(term_road, []))
+    if not ranked:
+        return ShortcutVerdict(False, (REASON_NO_TERM,))
+
+    top = ranked[0]
+    reasons: list[str] = []
+    if not _has_full_mention(top):
+        reasons.append(REASON_NOT_LEXICAL)
+    # 条件②：只有「命中另一处提及」才算多诉求。抢同一处提及的弱命中由强者
+    # 通吃——否则问句写全了「商品交易总额」仍会被只蹭到「交易总额」子串的
+    # 「净交易总额」拖住，永远走不了短路（实测现象）。LIKE 碎片命中同样
+    # 不算另一处提及（碎片既不触发短路、也不阻断短路）。
+    if any(_has_full_mention(hit) and not _same_mention(top, hit) for hit in ranked[1:]):
+        reasons.append(REASON_MULTI_TERM)
+    if any(hit.payload.get("ambiguous") for hit in ranked):
+        reasons.append(REASON_AMBIGUOUS)
+
+    links = term_links(expansion, term_id_of(top))
+    if not links:
+        reasons.append(REASON_NO_LINK)
+    elif len(links) > 1:
+        reasons.append(REASON_LINK_FORKED)
+
+    if reasons:
+        return ShortcutVerdict(False, tuple(reasons), term=term_view(top))
+    return ShortcutVerdict(True, (REASON_ELIGIBLE,), term=term_view(top), metric_hit=links[0])
+
+
+def term_links(expansion: Expansion, term_id: str) -> list[RecallHit]:
+    """某术语经 ``measuresConcept`` 链到的 published 指标候选。
+
+    Args:
+        expansion: 图补全结果（``metrics`` 内候选均已回源复验 published）。
+        term_id: 术语 ID。
+
+    Returns:
+        该术语链到的指标候选列表（空 = 术语没建模成指标）。
+
+    Note:
+        同一指标的多个入口来源会合并保留；知识入口不能覆盖术语关系标记。
+    """
+    # 术语 → 指标链的来源标记前缀（单源于 model.GRAPH_MEASURES_PREFIX，
+    # graph_expand 两条路同口径）
+    marker = f"{GRAPH_MEASURES_PREFIX}:{term_id}"
+    return [hit for hit in expansion.metrics if marker in hit.matched_on]
+
+
+def gap_terms(term_road: RoadResult, expansion: Expansion) -> list[dict[str, Any]]:
+    """缺口术语：命中了但没有任何 published 指标链的术语（带口径摘要）。
+
+    「术语库认识这个口径、只是还没建成指标」——编排层据此点破缺口并建议
+    去建模页固化（设计 §3.5 出口·提示建模），而不是含糊带过。纯事实字段，
+    是否提示由编排层按「指标候选是否也为空」裁决。
+
+    Args:
+        term_road: 术语路召回结果。
+        expansion: 图补全结果（链的来源）。
+
+    Returns:
+        ``[{term_id, name, definition, synonyms}]``——无缺口时空列表。
+    """
+    gaps: list[dict[str, Any]] = []
+    for hit in term_road.hits:
+        if term_links(expansion, term_id_of(hit)):
+            continue
+        gaps.append(term_view(hit))
+    return gaps
+
+
+def term_id_of(hit: RecallHit) -> str:
+    """术语命中 → term_id（payload 优先，兼容 entity_id 形态）。"""
+    return str(hit.payload.get("term_id") or hit.entity_id)
+
+
+def term_view(hit: RecallHit) -> dict[str, Any]:
+    """术语命中 → 术语子包条目（口径随行，供写 SQL 约束与报告归因）。"""
+    return {
+        "term_id": term_id_of(hit),
+        "name": str(hit.payload.get("name") or hit.label),
+        "definition": str(hit.payload.get("definition") or ""),
+        "synonyms": list(hit.payload.get("synonyms") or []),
+        "ambiguous": bool(hit.payload.get("ambiguous")),
+        "matched_on": list(hit.matched_on),
+    }
+
+
+def _has_full_mention(hit: RecallHit) -> bool:
+    """是否为「问句完整提及了术语」的命中（alias 精确档）。
+
+    词法通道里两档质量完全不同（:mod:`glossary.recall` 的分层）：
+
+    - **alias 档**：问句完整包含了术语名/别名（方向是「问句 ⊇ 别名」）
+      ——用户真的提及了这个口径；
+    - **like 档**：问句里某个词恰是术语名的子串（方向相反，「问句词 ⊂
+      术语名」）——碎片碰撞。问「商品品类」时「商品」⊂「商品交易总额」
+      就命中了，但「商品」是高频普通词，不构成「提及」。
+
+    触发短路的「过硬」只认 alias 档（向量档同样不算：语义相似 ≠ 用户
+    说的就是它）。like 碎片命中仍进完整召回的候选榜参与竞争，只是不再
+    单独替用户认定口径。
+
+    判据取 ``matched_on`` 含 ``"alias"``——terms 路召回把胜出通道名写进
+    ``matched_on``（alias / vector / like 三值）。
+    """
+    return "alias" in hit.matched_on
+
+
+def _same_mention(top: RecallHit, other: RecallHit) -> bool:
+    """两个术语是否在抢问句里的**同一处提及**。
+
+    判据是命中片段的包含关系（归一化后比较）：
+
+    - 「商品交易总额」命中「商品交易总额」、「净交易总额」只命中「交易总额」
+      → 后者是前者的子串 = 同一处提及，强者通吃，可以短路；
+    - 「GMV 和退款金额」里两个术语命中「GMV」与「退款金额」→ 互不包含 =
+      两处提及（两件事），短路只锁一个会答一半，不能短路。
+
+    片段缺失时按「同一处」处理（无从证明是两处；向量单独命中没有片段，但
+    那类命中不进本判定——调用方只看有词法通道的候选）。
+    """
+    top_token = _normalized_token(top)
+    other_token = _normalized_token(other)
+    if not top_token or not other_token:
+        return True
+    return top_token in other_token or other_token in top_token
+
+
+def _normalized_token(hit: RecallHit) -> str:
+    """命中片段归一化（大小写与空白无关，对齐 glossary 的别名归一口径）。"""
+    return "".join(str(hit.payload.get("matched_token") or "").lower().split())
