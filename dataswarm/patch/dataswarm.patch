+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""_compute_governance_fields 时间格式矩阵守门（时区策略统一 Phase 1）。
+
+改前 workflow_engine._parse_ts 只吃 %z 格式，naive 时间戳直接返回 None，导致
+naive started_at 的 duration_s / sla_time 静默丢失。本组用例锁死：naive /
++0800 / +08:00 / 混合格式全部产出治理字段（防 R5 回退）。
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.channels.web.orchestration import workflow_engine
+
+
+def _fields(started: str, finished: str) -> dict:
+    result = SimpleNamespace(result_summary={"row_count": 3})
+    return workflow_engine._compute_governance_fields(
+        {"sla_minutes": 10}, None, result, started, finished)
+
+
+def test_duration_s_present_for_all_three_formats():
+    cases = [
+        ("2026-10-27T10:00:00+08:00", "2026-10-27T10:02:30+08:00"),  # 新标准（C2）
+        ("2026-10-27T10:00:00+0800", "2026-10-27T10:02:30+0800"),    # 历史 F1
+        ("2026-10-27T10:00:00", "2026-10-27T10:02:30"),              # naive（改前丢字段）
+        ("2026-10-27T10:00:00", "2026-10-27T10:02:30+08:00"),        # 混合（存量混存真实场景）
+    ]
+    for started, finished in cases:
+        out = _fields(started, finished)
+        assert out["duration_s"] == 150.0, (started, finished)
+
+
+def test_sla_time_present_and_semantic_for_all_formats():
+    for started in ("2026-10-27T10:00:00+08:00", "2026-10-27T10:00:00+0800", "2026-10-27T10:00:00"):
+        out = _fields(started, started)
+        begin = timeutil.parse_ts(started)
+        assert begin is not None
+        sla = timeutil.parse_ts(out["sla_time"])
+        # sla_time 可解析且与 started 恰差 sla_minutes=10 分钟（不锁具体 offset 字符串）
+        assert sla is not None
+        assert (sla - begin).total_seconds() == 600
+
+
+def test_sla_time_falls_back_to_timeout():
+    # 无 sla_minutes 时用 timeout_s/60 近似
+    result = SimpleNamespace(result_summary={})
+    out = workflow_engine._compute_governance_fields(
+        {"timeout_s": 1800}, None, result, "2026-10-27T10:00:00", None)
+    begin = timeutil.parse_ts("2026-10-27T10:00:00")
+    sla = timeutil.parse_ts(out["sla_time"])
+    assert begin is not None and sla is not None
+    assert (sla - begin).total_seconds() == 1800
+
+
+def test_unparseable_yields_no_duration():
+    out = _fields("garbage", "2026-10-27T10:02:30+08:00")
+    assert "duration_s" not in out
