+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { NodeInput } from '../types/orchestration';
+
+export type SaveState = 'saved' | 'saving' | 'error';
+
+/** A document owns its history and one writer. Failed writes retain the local draft. */
+export class WorkflowDocument {
+  private history: NodeInput[][];
+  private cursor = 0;
+  private saved: NodeInput[] | null;
+  private pending: Promise<void> | null = null;
+  private listeners = new Set<() => void>();
+  private version = 0;
+  state: SaveState = 'saved';
+  error: Error | null = null;
+
+  constructor(
+    nodes: NodeInput[],
+    private write: (nodes: NodeInput[]) => Promise<unknown>,
+  ) {
+    this.history = [structuredClone(nodes)];
+    this.saved = this.history[0];
+  }
+
+  get nodes() {
+    return this.history[this.cursor];
+  }
+  get canUndo() {
+    return this.cursor > 0;
+  }
+  get canRedo() {
+    return this.cursor < this.history.length - 1;
+  }
+  get dirty() {
+    return this.nodes !== this.saved;
+  }
+  getSnapshot = () => this.version;
+  subscribe = (listener: () => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  private emit() {
+    this.version += 1;
+    this.listeners.forEach((listener) => listener());
+  }
+
+  change(nodes: NodeInput[]) {
+    if (JSON.stringify(nodes) === JSON.stringify(this.nodes)) return;
+    this.history = [...this.history.slice(0, this.cursor + 1), structuredClone(nodes)];
+    this.cursor += 1;
+    this.changed();
+  }
+
+  undo() {
+    if (this.canUndo) {
+      this.cursor -= 1;
+      this.changed();
+    }
+  }
+  redo() {
+    if (this.canRedo) {
+      this.cursor += 1;
+      this.changed();
+    }
+  }
+
+  private changed() {
+    this.emit();
+    // An error requires an explicit retry; subsequent edits must not silently overwrite it.
+    if (!this.error) void this.flush().catch(() => {});
+  }
+
+  async flush(): Promise<void> {
+    if (this.error) throw this.error;
+    if (this.pending) return this.pending;
+    if (!this.dirty) return;
+    this.state = 'saving';
+    this.emit();
+    this.pending = Promise.resolve().then(async () => {
+      try {
+        while (this.dirty) {
+          const snapshot = this.nodes;
+          await this.write(snapshot);
+          this.saved = snapshot;
+        }
+        this.state = 'saved';
+      } catch (error) {
+        // The server may have written the snapshot even when its response was lost.
+        this.saved = null;
+        this.error = error instanceof Error ? error : new Error(String(error));
+        this.state = 'error';
+        throw this.error;
+      } finally {
+        this.pending = null;
+        this.emit();
+      }
+    });
+    return this.pending;
+  }
+
+  retry() {
+    this.error = null;
+    return this.flush();
+  }
+}
+
+export function removeWorkflowNodes(nodes: NodeInput[], ids: Set<string>): NodeInput[] {
+  return nodes
+    .filter((node) => !ids.has(node.node_id!))
+    .map((node) => ({
+      ...node,
+      upstream_nodes: (node.upstream_nodes ?? '')
+        .split(',')
+        .filter((id) => id && !ids.has(id.trim()))
+        .join(','),
+    }));
+}
