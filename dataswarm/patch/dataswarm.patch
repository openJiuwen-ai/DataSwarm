+    assert result["grounding_level"] != "G1"
+    # 口径失败也要给修正指引——编排层纪律是「fail 只看 retry_hint」，
+    # 只给 checks 明细会让模型原地重试同一条 SQL
+    assert "GROUP BY" in result["retry_hint"]
+    assert "note" in result["retry_hint"]
