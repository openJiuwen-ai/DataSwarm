+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""会话按数据源工作空间隔离（chat-workspace-isolation-plan）单元测试。
+
+覆盖：
+- to_session_info 透出 workspace_id
+- project_adapter 三个列表接口的 workspace 归桶过滤
+- CronJob.workspace_id 序列化 roundtrip 与旧数据兜底
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.server.runtime.session.session_info import to_session_info
+from jiuwenswarm.server.runtime.gateway_adapter.project_adapter import (
+    _load_pinned_sessions,
+    _load_project_sessions,
+    _session_matches_workspace,
+    _workspace_bucket,
+)
+from jiuwenswarm.gateway.cron.models import CronJob
+
+
+# ===========================================================================
+# to_session_info 投影
+# ===========================================================================
+class TestToSessionInfoWorkspace:
+    @staticmethod
+    def test_workspace_id_passthrough():
+        meta = {"session_id": "s1", "workspace_id": "bank"}
+        info = to_session_info(meta)
+        assert info["workspace_id"] == "bank"
+
+    @staticmethod
+    def test_workspace_id_missing_defaults_empty():
+        info = to_session_info({"session_id": "s1"})
+        assert info["workspace_id"] == ""
+
+    @staticmethod
+    def test_workspace_id_non_string_coerced():
+        info = to_session_info({"session_id": "s1", "workspace_id": 123})
+        assert info["workspace_id"] == "123"
+
+
+# ===========================================================================
+# 归桶与过滤辅助
+# ===========================================================================
+class TestWorkspaceBucket:
+    @staticmethod
+    def test_empty_and_default_normalize():
+        assert _workspace_bucket("") == "default"
+        assert _workspace_bucket(None) == "default"
+        assert _workspace_bucket("default") == "default"
+
+    @staticmethod
+    def test_literal_passthrough():
+        assert _workspace_bucket("bank") == "bank"
+        assert _workspace_bucket(" bank ") == "bank"
+
+
+class TestSessionMatchesWorkspace:
+    @staticmethod
+    def test_no_request_means_no_filter():
+        assert _session_matches_workspace({"workspace_id": "bank"}, None)
+        assert _session_matches_workspace({"workspace_id": "bank"}, "")
+
+    @staticmethod
+    def test_legacy_session_falls_into_default_bucket():
+        # 存量会话无 workspace_id 字段 → 默认桶
+        assert _session_matches_workspace({}, "default")
+        assert not _session_matches_workspace({}, "bank")
+
+    @staticmethod
+    def test_exact_match():
+        assert _session_matches_workspace({"workspace_id": "bank"}, "bank")
+        assert not _session_matches_workspace({"workspace_id": "bank"}, "default")
+        # 'default' 归属的会话请求 default 桶命中
+        assert _session_matches_workspace({"workspace_id": "default"}, "default")
+
+
+# ===========================================================================
+# project_adapter 列表过滤（pinned / get_sessions）
+# ===========================================================================
+@pytest.fixture()
+def sessions_with_workspace(tmp_path, monkeypatch):
+    """两个工作空间各一条置顶 + 一条普通会话。"""
+    from jiuwenswarm.server.runtime.session import session_metadata as sm
+
+    d = tmp_path / "sessions"
+    d.mkdir()
+    monkeypatch.setattr(
+        "jiuwenswarm.server.runtime.session.session_metadata.get_agent_sessions_dir",
+        lambda: d,
