+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Validate a complete workflow graph before modifying persisted nodes."""
+from graphlib import CycleError, TopologicalSorter
+
+
+def validate_nodes(nodes: list[dict]) -> None:
+    ids = [node["node_id"] for node in nodes]
+    if any(not isinstance(node_id, str) or not node_id.strip() or "," in node_id for node_id in ids):
+        raise ValueError("invalid node id")
+    if len(set(ids)) != len(ids):
+        raise ValueError("duplicate node id")
+    dependencies: dict[str, list[str]] = {}
+    known_ids = set(ids)
+    for node in nodes:
+        if not node.get("task_id"):
+            raise ValueError("task id is required")
+        int(node.get("order_index", 0))
+        parents = [parent.strip() for parent in (node.get("upstream_nodes") or "").split(",") if parent.strip()]
+        if len(set(parents)) != len(parents):
+            raise ValueError("duplicate dependency")
+        for parent in parents:
+            if parent not in known_ids:
+                raise ValueError(f"unknown upstream node: {parent}")
+        dependencies[node["node_id"]] = parents
+    try:
+        TopologicalSorter(dependencies).prepare()
+    except CycleError as exc:
+        raise ValueError("workflow contains a dependency cycle") from exc
