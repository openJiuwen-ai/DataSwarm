new file mode 100644
index 000000000..8e002e6d1
--- /dev/null
+++ b/tests/unit_tests/test_app_web_inspection_runs.py
@@ -0,0 +1,88 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""巡检批次列表 handler 单测：状态以 dw_inspection_runs 为准，manifest 只读不写。
+
+回归背景：对话触发的巡检是 Agent bash 工具起的 run_pipeline 子进程，不归 web
+服务进程表管；此前「不在进程表即孤儿」的兜底会把在跑的批次 manifest 改写成
+failed，等 run_pipeline 收尾写终态 manifest 又变回成功 → 治理界面状态漂移。
+"""
+from __future__ import annotations
+
+import json
+import sys
+import threading
+import types
+
+bootstrap_module = types.ModuleType("jiuwenswarm.agents.harness.team.bootstrap")
+bootstrap_module.configure_agent_teams_home = lambda: None
+sys.modules.setdefault(bootstrap_module.__name__, bootstrap_module)
+
+# 必须在 stub 之后 import（app_web 模块级引用 bootstrap）
+from jiuwenswarm.channels.web import app_web as aw  # noqa: E402
+from jiuwenswarm.channels.web import inspection_service as svc  # noqa: E402
+
+
+class _FakePopen:
+    def __init__(self, return_code: int | None):
+        self._return_code = return_code
+
+    def poll(self):
+        return self._return_code
+
+
+def _handler(**attrs) -> aw._SpaStaticHandler:
+    handler = object.__new__(aw._SpaStaticHandler)
+    for key, value in attrs.items():
+        setattr(handler, key, value)
+    return handler
+
+
+def test_inspection_runs_reads_meta_db(monkeypatch):
+    """列表源是元数据库（按工作空间过滤），不再扫描 manifest 目录。"""
+    seen = {}
+
+    def fake_list_runs(meta_ref, *, workspace_id=None):
+        seen["meta_ref"] = meta_ref
+        seen["workspace_id"] = workspace_id
+        return [{"run_id": "run-1", "status": "running"}]
+
+    monkeypatch.setattr(svc, "list_runs", fake_list_runs)
+    handler = _handler()
+    runs = aw._SpaStaticHandler._inspection_runs(handler, "doris://meta", "default")
+
+    assert runs == [{"run_id": "run-1", "status": "running"}]
+    assert seen == {"meta_ref": "doris://meta", "workspace_id": "default"}
+
+
+def test_running_manifest_is_left_untouched(monkeypatch, tmp_path):
+    """回归：在跑的批次 manifest 保持原样（此前被误改写为 failed 即本 bug）。"""
+    run_dir = tmp_path / "runs" / "run-chat"
+    run_dir.mkdir(parents=True)
+    manifest_path = run_dir / "manifest.json"
+    original = {"run_id": "run-chat", "status": "running", "workspace_id": "default"}
+    manifest_path.write_text(json.dumps(original), encoding="utf-8")
+
+    monkeypatch.setattr(svc, "list_runs",
+                        lambda meta_ref, *, workspace_id=None: [dict(original)])
+    handler = _handler(inspection_root=tmp_path, inspection_processes={})
+    runs = aw._SpaStaticHandler._inspection_runs(handler, "doris://meta", "default")
+
+    assert runs[0]["status"] == "running"
+    assert json.loads(manifest_path.read_text(encoding="utf-8")) == original
+
+
+def test_refresh_processes_only_reaps_finished(monkeypatch, tmp_path):
+    """进程表只做回收，不再按退出码改状态（状态收敛交给库 + 超时）。"""
+    manifest_dir = tmp_path / "runs" / "run-dead"
+    manifest_dir.mkdir(parents=True)
+    manifest_path = manifest_dir / "manifest.json"
+    original = {"run_id": "run-dead", "status": "running"}
+    manifest_path.write_text(json.dumps(original), encoding="utf-8")
+
+    handler = _handler(inspection_root=tmp_path,
+                       inspection_lock=threading.Lock(),
+                       inspection_processes={"run-dead": _FakePopen(2),
+                                             "run-live": _FakePopen(None)})
+    aw._SpaStaticHandler._refresh_inspection_processes(handler)
+
+    assert list(handler.inspection_processes) == ["run-live"]
+    assert json.loads(manifest_path.read_text(encoding="utf-8")) == original
