+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""finding_review 单测（LLM 语义复核：全量 + 误报降级留痕）。
+
+覆盖：
+  - build_dimension_request：一维度整批打包；给 snapshot_index 时含 column_type
+  - parse_batch_response：verdict 数组 → {uid: (verdict, reason)}；坏 JSON → {}
+  - mapped_severity / apply_verdict：四档映射 + 永不升档 + original_severity 留痕
+  - review_all：fake async client 计数正确；批异常只记 failed 不崩整批；drift 跳过
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from jiuwenswarm.common import finding_review as fr
+from jiuwenswarm.symphony import llm as llm_mod
+
+
+# --------------------------------------------------------------------------
+# build_dimension_request / parse_batch_response
+# --------------------------------------------------------------------------
+def test_build_dimension_request_packs_all():
+    f1 = {
+        "finding_uid": "schema:naming:t1:c1:NAM-001:abcd1234",
+        "source_finding_id": "NAM-001", "category": "naming",
+        "severity": "info", "object": {"table": "t1", "column": "c1", "layer": "DWD"},
+        "summary": "时间列 t1.c1 命名不规范", "evidence": {"column": "c1"},
+    }
+    f2 = {"finding_uid": "u2", "category": "null", "severity": "high",
+          "object": {"table": "t2", "column": "id"}, "summary": "全空列"}
+    req = fr.build_dimension_request([f1, f2], dimension="schema")
+    assert req["system_prompt"]
+    body = json.loads(req["user_content"])
+    assert body["dimension"] == "schema"
+    assert len(body["findings"]) == 2
+    assert body["findings"][0]["finding_uid"] == f1["finding_uid"]
+    assert body["findings"][0]["rule"] == "NAM-001"
+    # schema 无 snapshot → 无 column_type
+    assert "column_type" not in body["findings"][0]
+
+
+def test_build_dimension_request_schema_adds_column_type():
+    f = {"finding_uid": "u1", "category": "naming", "severity": "info",
+         "object": {"table": "t1", "column": "on_time_rate"}}
+    snap = {"t1": {"on_time_rate": "DOUBLE", "created_time": "DATETIME"}}
+    req = fr.build_dimension_request([f], dimension="schema", snapshot_index=snap)
+    body = json.loads(req["user_content"])
+    assert body["findings"][0]["column_type"] == "DOUBLE"
+
+
+def test_parse_batch_response_valid():
+    content = json.dumps([
+        {"finding_uid": "u1", "verdict": "rejected", "reason": "比率列非时间列"},
+        {"finding_uid": "u2", "verdict": "confirmed", "reason": "真实问题"},
+    ])
+    out = fr.parse_batch_response(content)
+    assert out["u1"] == ("rejected", "比率列非时间列")
+    assert out["u2"] == ("confirmed", "真实问题")
+
+
+def test_parse_batch_response_invalid():
+    assert fr.parse_batch_response("not json") == {}
+    assert fr.parse_batch_response('{"verdicts":[]}') == {}
+    # 未知 verdict → (None, "")
+    assert fr.parse_batch_response(
+        '[{"finding_uid":"u1","verdict":"nope"}]') == {"u1": (None, "")}
+
+
+# --------------------------------------------------------------------------
+# mapped_severity / apply_verdict
+# --------------------------------------------------------------------------
+def test_mapped_severity_table():
+    assert fr.mapped_severity("high", "confirmed") == "high"
+    assert fr.mapped_severity("high", "downgraded") == "medium"
+    assert fr.mapped_severity("medium", "downgraded") == "low"
+    assert fr.mapped_severity("low", "downgraded") == "info"
+    assert fr.mapped_severity("info", "downgraded") == "info"  # 永不升档
+    assert fr.mapped_severity("high", "rejected") == "info"
+    assert fr.mapped_severity("info", "confirmed") == "info"
+
+
+def test_apply_verdict_downgrade_keeps_original():
+    f = {"severity": "high", "finding_uid": "u1"}
+    fr.apply_verdict(f, "downgraded", "部分成立")
+    assert f["severity"] == "medium"
+    assert f["original_severity"] == "high"
+    assert f["llm_verdict"] == "downgraded"
+    assert f["llm_reason"] == "部分成立"
+
+
+def test_apply_verdict_confirmed_no_downgrade():
+    f = {"severity": "high", "finding_uid": "u1"}
+    fr.apply_verdict(f, "confirmed", "真实问题")
+    assert f["severity"] == "high"
+    assert "original_severity" not in f
+    assert f["llm_verdict"] == "confirmed"
+
+
+def test_apply_verdict_rejected_to_info():
+    f = {"severity": "high", "finding_uid": "u1"}
+    fr.apply_verdict(f, "rejected", "纯误报")
+    assert f["severity"] == "info"
+    assert f["original_severity"] == "high"
+
+
+# --------------------------------------------------------------------------
+# review_all（fake async client）
+# --------------------------------------------------------------------------
+class _FakeClient:
+    """返回罐头 verdict 数组的 fake LLM 客户端（complete_json_async 单次调用）。"""
+
+    def __init__(self, verdict="rejected", reason="误报"):
+        self.verdict = verdict
+        self.reason = reason
+        self.calls = []
+
+    async def complete_json_async(self, *, system_prompt, user_content,
+                                  timeout=None, error_context="LLM", **kw):
+        body = json.loads(user_content)
+        items = body.get("findings", [])
+        self.calls.append(len(items))
+        return json.dumps([
+            {"finding_uid": it["finding_uid"], "verdict": self.verdict,
+             "reason": self.reason}
+            for it in items
+        ])
+
+
+class _FailingClient:
+    """整体抛异常的 fake LLM 客户端。"""
+
+    async def complete_json_async(self, *, system_prompt, user_content,
+                                  timeout=None, error_context="LLM", **kw):
+        raise RuntimeError("LLM down")
+
+
+def _artifact(tmp_path: Path, findings: list[dict], name: str = "schema") -> str:
+    p = tmp_path / f"{name}_findings.json"
+    p.write_text(json.dumps({"findings": findings}, ensure_ascii=False), encoding="utf-8")
+    return str(p)
+
+
+def test_review_all_counts_and_rewrites(tmp_path, monkeypatch):
+    """review_all 复核文件并原子写回（severity 降级 + llm 字段 + 无 .tmp 残留）。"""
+    f1 = {"finding_uid": "u1", "source_finding_id": "NAM-001", "category": "naming",
+          "severity": "info", "object": {"table": "t1", "column": "on_time_rate"},
+          "summary": "时间列", "evidence": {"column": "on_time_rate"}}
+    f2 = {"finding_uid": "u2", "source_finding_id": "UNI-001", "category": "uniqueness",
+          "severity": "high", "object": {"table": "t2", "column": "id"},
+          "summary": "业务键重复"}
+    path = _artifact(tmp_path, [f1, f2])
+    monkeypatch.setattr(llm_mod, "LLMConfig", _FakeConfig)
+    monkeypatch.setattr(llm_mod, "create_llm_client", lambda config: _FakeClient())
+
+    out = fr.review_all({"schema": path})
+    assert out["total_reviewed"] == 2
+    assert out["rejected"] == 2
+    assert out["failed"] == 0
+
+    payload = json.loads(Path(path).read_text(encoding="utf-8"))
+    assert payload["findings"][0]["severity"] == "info"  # info+rejected → info（永不升档）
+    assert payload["findings"][0]["llm_verdict"] == "rejected"
+    assert payload["findings"][1]["severity"] == "info"  # high+rejected → info
+    assert payload["findings"][1]["original_severity"] == "high"
+    assert not list(tmp_path.glob("*.tmp"))
+
+
+class _FakeConfig:
+    @classmethod
+    def from_default_model(cls):
+        return cls()
+
+
+def test_review_all_failing_client_marks_failed(tmp_path, monkeypatch):
+    """LLM 整体失败 → 记 failed，finding 原样（不崩）。"""
+    f1 = {"finding_uid": "u1", "category": "naming", "severity": "high",
+          "object": {"table": "t1", "column": "c1"}}
+    path = _artifact(tmp_path, [f1])
+    monkeypatch.setattr(llm_mod, "LLMConfig", _FakeConfig)
+    monkeypatch.setattr(llm_mod, "create_llm_client", lambda config: _FailingClient())
+
+    out = fr.review_all({"schema": path})
+    assert out["total_reviewed"] == 0
+    assert out["failed"] == 1
+    assert out["failures"]
+    # 文件未被改写（severity 原样，无 llm 字段）
+    payload = json.loads(Path(path).read_text(encoding="utf-8"))
+    assert payload["findings"][0]["severity"] == "high"
+    assert "llm_verdict" not in payload["findings"][0]
+
+
+def test_review_all_batch_loop(tmp_path, monkeypatch):
+    """大维度按 REVIEW_BATCH 分块：60 条 → 2 次 complete_json_many_async 调用。"""
+    findings = [{"finding_uid": f"u{i}", "category": "naming",
+                 "severity": "info", "object": {"table": "t", "column": f"c{i}"}}
+                for i in range(65)]
+    path = _artifact(tmp_path, findings)
+    client = _FakeClient()
+    monkeypatch.setattr(llm_mod, "LLMConfig", _FakeConfig)
+    monkeypatch.setattr(llm_mod, "create_llm_client", lambda config: client)
+
+    fr.review_all({"schema": path}, batch=60)
+    # 65 = 60 + 5 → 2 次调用
+    assert client.calls == [60, 5]
+
+
+def test_review_all_skips_drift_category(tmp_path, monkeypatch):
+    """drift 类 finding 不送 LLM 复核（漂移是确定性事实），severity 原样无 llm 字段。"""
+    findings = [
+        {"finding_uid": "u1", "category": "drift", "severity": "high",
+         "object": {"table": "t1", "column": "c1"},
+         "summary": "表 t1 相对基线被删除"},
+        {"finding_uid": "u2", "category": "naming", "severity": "info",
+         "object": {"table": "t2", "column": "on_time_rate"},
