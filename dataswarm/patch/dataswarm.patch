@@ -0,0 +1,107 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { JSDOM } from 'jsdom';
+
+test('the More menu starts manual collection only for registered sources with an available collector', async (t) => {
+  const dom = new JSDOM('<div id="root"></div>', { url: 'http://localhost' });
+  const { window } = dom;
+  Object.assign(globalThis, {
+    window,
+    document: window.document,
+    Element: window.Element,
+    IS_REACT_ACT_ENVIRONMENT: true,
+  });
+  window.localStorage.setItem('dw.workspace', 'sales');
+  const supported = [
+    'doris',
+    'mysql',
+    'sqlite',
+    'redis',
+    'ddl',
+    'hdfs',
+    'parquet',
+    'json',
+    'duckdb',
+    's3',
+    'oss',
+    'csv',
+    'excel',
+  ];
+  const types = supported.map((type_id) => ({
+    type_id,
+    label: type_id,
+    available: true,
+    fields: [],
+    capabilities: ['schema', 'semantic_collection'],
+  }));
+  types.push(
+    { type_id: 'postgresql', label: 'postgresql', available: true, fields: [], capabilities: ['schema'] },
+    {
+      type_id: 'unavailable',
+      label: 'unavailable',
+      available: false,
+      fields: [],
+      capabilities: ['semantic_collection'],
+    },
+  );
+  const rows = types.map(({ type_id }) => ({
+    type: type_id,
+    source_id: 'sales_' + type_id,
+    ref: type_id + '://sales',
+    managed: true,
+    bound: type_id === 'mysql',
+  }));
+  rows.push({ type: 'mysql', source_id: 'yaml:sales:business', ref: 'mysql://yaml', managed: false, read_only: true });
+
+  const posts = [];
+  t.mock.method(globalThis, 'fetch', async (url, options) => {
+    const path = new URL(url, window.location.origin);
+    switch (path.pathname) {
+      case '/api/dataagent/workspaces':
+        return Response.json({ workspaces: [{ workspace_id: 'sales', name: 'Sales' }] });
+      case '/api/dataagent/datasource/types':
+        return Response.json({ ok: true, types });
+      case '/api/dataagent/datasource/list':
+        return Response.json({ ok: true, datasources: rows });
+      case '/api/dataagent/semantic/runs':
+        if (options.method === 'POST') {
+          posts.push({ workspace: path.searchParams.get('workspace_id'), ...JSON.parse(options.body) });
+          return Response.json({ run_id: 'run-' + posts.length, status: 'queued' });
+        }
+        return Response.json({ runs: [{ status: 'running' }] });
+      default:
+        throw new Error('Unexpected endpoint ' + url);
+    }
+  });
+
+  const { DataSourceListPage } = await import('../node_modules/.cache/datasource-semantic/DataSourceListPage.mjs');
+  const root = createRoot(document.getElementById('root'));
+  t.after(async () => {
+    await act(() => root.unmount());
+    dom.window.close();
+  });
+  await act(async () => root.render(createElement(DataSourceListPage)));
+  const pageSize = [...document.querySelectorAll('select')].find((el) => [...el.options].some((o) => o.value === '50'));
+  await act(async () => {
+    pageSize.value = '50';
+    pageSize.dispatchEvent(new window.Event('change', { bubbles: true }));
+  });
+  const menus = [...document.querySelectorAll('.ds-table-row button[aria-expanded]')];
+  assert.equal(menus.length, rows.length);
+  for (const [i, button] of menus.entries()) {
+    await act(async () => button.click());
+    const action = [...document.querySelectorAll('.ds-menu button')].find((el) => el.textContent === '语义采集');
+    if (i >= supported.length) {
+      assert.equal(action, undefined, rows[i].source_id);
+      continue;
+    }
+    assert.ok(action, rows[i].type);
+    await act(async () => action.click());
+    assert.deepEqual(posts.at(-1), { workspace: 'sales', source_id: rows[i].source_id, trigger_type: 'manual' });
+    await act(async () => button.click());
+    assert.equal(document.querySelector('.ds-menu button:disabled')?.textContent, '采集中…');
+  }
+  assert.equal(posts.length, supported.length);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/datasourceWorkspaceStore.test.mjs b/jiuwenswarm/channels/web/frontend/tests/datasourceWorkspaceStore.test.mjs
new file mode 100644
index 000000000..ebe4f4d89
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/datasourceWorkspaceStore.test.mjs
@@ -0,0 +1,99 @@
+/**
+ * datasourceWorkspaceStore 单测（node --test）。
+ * workspaceBucket 归桶口径：空串/缺省/'default' → 'default'，其余字面量精确匹配；
+ * 与后端 project_adapter._workspace_bucket 保持一致。
+ * deleteWorkspace：POST /workspaces/{id}/delete，ok 透传 + 成功后重载列表。
+ */
+import { test, mock } from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  useDatasourceWorkspaceStore,
+  workspaceBucket,
+} from '../node_modules/.cache/datasource-workspace/datasourceWorkspaceStore.mjs';
+
+test('workspaceBucket normalizes empty/null/undefined/default to default', () => {
+  assert.equal(workspaceBucket(''), 'default');
+  assert.equal(workspaceBucket(null), 'default');
+  assert.equal(workspaceBucket(undefined), 'default');
+  assert.equal(workspaceBucket('default'), 'default');
+});
+
+test('workspaceBucket passes literal ids through and trims whitespace', () => {
+  assert.equal(workspaceBucket('bank'), 'bank');
+  assert.equal(workspaceBucket(' bank '), 'bank');
+});
+
+test('workspaceBucket does not treat other ids as default', () => {
+  assert.notEqual(workspaceBucket('temp'), 'default');
+});
+
+test('loadWorkspaces falls back to system default when no stored selection', async () => {
+  // 多空间 + 无 localStorage 记忆（清残留选择后 currentWorkspaceId 为空）：
+  // 回退选中系统默认工作空间（default-ws），而非停留在未选择
+  globalThis.window = { localStorage: { getItem: () => null, setItem() {}, removeItem() {} } };
+  const fetchMock = mock.method(globalThis, 'fetch', async () => ({
+    ok: true,
+    json: async () => ({
+      workspaces: [
+        { workspace_id: 'another', name: '另一空间', business: null, metadata: { type: 'sqlite', database: 'm2' } },
+        { workspace_id: 'default-ws', name: '默认工作空间', business: null, metadata: { type: 'sqlite', database: 'm' } },
+      ],
+    }),
+  }));
+  try {
+    useDatasourceWorkspaceStore.getState().setCurrentWorkspace('');
+    await useDatasourceWorkspaceStore.getState().loadWorkspaces();
+    assert.equal(useDatasourceWorkspaceStore.getState().currentWorkspaceId, 'default-ws');
+  } finally {
+    fetchMock.mock.restore();
+    delete globalThis.window;
+  }
+});
+
+test('deleteWorkspace posts to delete endpoint and reloads list', async () => {
+  globalThis.window = { localStorage: { getItem: () => null, setItem() {}, removeItem() {} } };
+  const fetchMock = mock.method(globalThis, 'fetch', async (url, init) => {
+    if (String(url).includes('/delete')) {
+      assert.equal(init?.method, 'POST');
+      assert.match(String(url), /\/api\/dataagent\/workspaces\/ws_x\/delete$/);
+      return { ok: true, json: async () => ({ ok: true, workspace_id: 'ws_x' }) };
+    }
+    // loadWorkspaces 的列表请求
+    return {
+      ok: true,
+      json: async () => ({
+        workspaces: [
+          { workspace_id: 'default', name: '默认', business: null, metadata: { type: 'sqlite', database: 'm' } },
+        ],
+      }),
+    };
+  });
+  try {
+    const result = await useDatasourceWorkspaceStore.getState().deleteWorkspace('ws_x');
+    assert.equal(result.ok, true);
+    assert.equal(fetchMock.mock.calls.length, 2); // delete + list
+    // 列表重载后回选 default
+    assert.equal(useDatasourceWorkspaceStore.getState().currentWorkspaceId, 'default');
+  } finally {
+    fetchMock.mock.restore();
+    delete globalThis.window;
+  }
+});
+
+test('deleteWorkspace passes through error_code payload', async () => {
+  globalThis.window = { localStorage: { getItem: () => null, setItem() {}, removeItem() {} } };
+  const fetchMock = mock.method(globalThis, 'fetch', async () => ({
+    ok: true,
+    json: async () => ({ ok: false, error_code: 'LAST_WORKSPACE', error: 'at least one workspace must remain' }),
+  }));
+  try {
+    const result = await useDatasourceWorkspaceStore.getState().deleteWorkspace('ws_only');
+    assert.equal(result.ok, false);
+    assert.equal(result.error_code, 'LAST_WORKSPACE');
+    assert.equal(fetchMock.mock.calls.length, 1); // 失败不重载列表
+  } finally {
+    fetchMock.mock.restore();
+    delete globalThis.window;
+  }
+});
