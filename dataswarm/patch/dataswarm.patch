+# ==========================================================================
+_PLANNED_SOURCE_TYPES: list[tuple[str, str, str]] = [
+    ("oracle", "Oracle", "relational"),
+    # 已有适配器的类型在各自类中声明发布状态，不在此重复注册。
+    ("rest_api", "RESTful API", "api"),
+    ("webhook", "Webhook", "api"),
+    ("erp", "ERP", "api"),
+    ("crm", "CRM", "api"),
+    ("oa", "OA", "api"),
+    ("kafka", "Kafka", "message"),
+    ("rabbitmq", "RabbitMQ", "message"),
+    ("rocketmq", "RocketMQ", "message"),
+    ("hive", "Hive", "message"),
+    ("spark", "Spark", "message"),
+]
+
+
+def _register_planned_source_types() -> None:
+    for planned_type_id, planned_label, planned_category in _PLANNED_SOURCE_TYPES:
+
+        class PlannedSourceType(SourceTypeAdapter):
+            type_id = planned_type_id
+            label = planned_label
+            category = planned_category
+            released = False
+
+            def validate(self, params: dict) -> None:
+                raise ValueError(f"source type '{self.type_id}' is not available yet")
+
+            def build_ref(self, config: dict) -> str:
+                raise ValueError(f"source type '{self.type_id}' is not available yet")
+
+            def test_connection(self, config: dict) -> dict:
+                return {"ok": False, "error": f"source type '{self.type_id}' is not available yet"}
+
+        register_source_type(PlannedSourceType)
+
+
+_register_planned_source_types()
