+    fake = FakeStore()
+    monkeypatch.setattr(sync, "_embedding_configured", lambda: True)
+    monkeypatch.setattr(sync, "_embed_texts", lambda texts: [[0.1] * 8 for _ in texts])
+    monkeypatch.setattr(sync, "_faiss_store", lambda ws, dims=None: fake)
+    monkeypatch.setattr(sync, "_VECTOR_DIR", tmp_path / "vectors")
+    return fake
