+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""已退役知识的保留期清理。
+
+退役条目是审计记录，不会自动消失；没有上限时列表与存储会单调增长。
+本模块按 ``KNOWLEDGE_RETIRED_RETENTION_DAYS``（默认 90 天，<=0 关闭自动清理）
+在每个工作空间首次访问知识列表时触发一次后台清理；``dw_knowledge_events``
+事件行不受影响，仍可按 asset_id 追溯谁在何时退役了什么。
+"""
+from __future__ import annotations
+
+import os
+import threading
+import time
+
+from jiuwenswarm.common import workspace_context
+
+from . import store
+
+_INTERVAL_S = 24 * 3600
+_LAST: dict[str, float] = {}
+_LOCK = threading.Lock()
+
+
+def retention_days() -> int:
+    """保留天数；非法值回退 90，<=0 表示不自动清理。"""
+    try:
+        return int(os.environ.get("KNOWLEDGE_RETIRED_RETENTION_DAYS", "90"))
+    except (TypeError, ValueError):
+        return 90
+
+
+def maybe_sweep() -> None:
+    """每个工作空间每 24h 最多触发一次清理（后台线程，不阻塞列表请求）。"""
+    days = retention_days()
+    if days <= 0:
+        return
+    workspace = store._workspace()
+    now = time.time()
+    with _LOCK:
+        if now - _LAST.get(workspace, 0.0) < _INTERVAL_S:
+            return
+        _LAST[workspace] = now
+    threading.Thread(target=_sweep, args=(workspace, days),
+                     name="knowledge-retention", daemon=True).start()
+
+
+def _sweep(workspace: str, days: int) -> None:
+    token = workspace_context.set_current(workspace or None)
+    try:
+        store.purge_retired(older_than_days=days)
+    except Exception:  # noqa: BLE001 — 维护任务失败不应影响服务
+        pass
+    finally:
+        workspace_context.reset(token)
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/retrieval.py b/jiuwenswarm/channels/web/dataagent/knowledge/retrieval.py
new file mode 100644
index 000000000..89b38e9fd
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/retrieval.py
@@ -0,0 +1,123 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""L1 typed discovery for published entities, mappings and rules.
+
+Documents remain evidence sources. Only reviewed, published knowledge assets
+are returned to analysis callers. The primary name of an asset (title before
+any parenthetical) is matched deterministically against the question — short
+asset texts lose badly on the shared calibrated EMB floor, and plan §11 puts
+exact/lexical hits on the first channel anyway. Embedding remains the channel
+for colloquial or cross-language phrasing.
+"""
+from __future__ import annotations
+
+from ..metrics import embedding
+from . import store
+from .roads import VECTOR_FLOOR, RecallHit, RoadResult
+from .selection import visible_assets
+
+# Entity was demoted to term (2026-10-20): business concepts ride the term
+# governance line (glossary alignment + L1 term road) instead of a separate
+# typed channel. Legacy entity assets are no longer recalled.
+ASSET_ROADS = {"mappings": "mapping", "rules": "rule"}
+
+
+def _primary_name(title: str) -> str:
+    """主名 = 标题去掉括号补注后的第一段（如「东南地区（Sudeste）州代码」→「东南地区」）。"""
+    return title.split("（", 1)[0].split("(", 1)[0].strip()
+
+
+def _lexical_names(asset: dict) -> list[str]:
+    """词法命中键：主名 + 同义词；mapping 另收 content 对照行的左侧键。
+
+    mapping 的检索价值在对照表（「东南地区（Sudeste）= SP、RJ、MG、ES」）而非
+    标题——LLM 蒸馏的标题措辞不可控（「巴西五大区州映射」不含用户查询词），
+    只按主名匹配会让已发布的映射对区域词问题零命中（kbi-07 闭环实证：
+    no_hit 而 SQL 靠模型自身地理知识落地）。分隔符只收对照形态的强信号
+    （= ＝ →），冒号不收——定义句「口径：全状态」会把「口径」误当键。
+    """
+    names = [_primary_name(asset["title"]), *((asset.get("source") or {}).get("synonyms") or [])]
+    if asset["asset_type"] != "mapping":
+        return names
+    for line in str(asset.get("content") or "").splitlines():
+        for sep in ("=", "＝", "→"):
+            if sep not in line:
+                continue
+            key = line.split(sep)[0].strip()
+            key = key.split("（")[0].split("(")[0].strip(" ;；,，、")
+            if len(key) >= 2:
+                names.append(key)
+            break
+    return names
+
+
+def retrieve(question: str, workspace_id: str, *, source_ids: list[str] | None = None,
+               limit: int = 8, versions: dict | None = None) -> dict:
+    assets = visible_assets(source_ids=source_ids, versions=versions)
+    if not assets:
+        return {"strategy": "lexical+embedding", "stage": "L1", "channel_status": "no_hit",
+                "hits": [], "warnings": [], "embedding_called": False}
+    normal_question = store.normalize(question)
+    hits, matched = [], set()
+    for asset in assets:
+        # 词法通道：命中键（NFKC casefold 后）作为问题子串出现即命中，分数与
+        # 词法路同刻度；确定性，不依赖 EMB 通道健康度。
+        normalized_names = [store.normalize(name) for name in _lexical_names(asset)]
+        if not any(len(name) >= 2 and name in normal_question for name in normalized_names):
+            continue
+        matched.add(asset["asset_id"])
+        hits.append(_hit(asset, {"matched_on": ["lexical"], "score": 1.0}))
+    remaining = [asset for asset in assets if asset["asset_id"] not in matched]
+    warnings: list[str] = []
+    embedding_called = False
+    if remaining and embedding.emb_available():
+        embedding_called = True
+        outcome = embedding.query_vectors(question)
+        if outcome.ok:
+            for kind in ASSET_ROADS.values():
+                typed = [asset for asset in remaining if asset["asset_type"] == kind]
+                if not typed:
+                    continue
+                docs = [(asset["asset_id"], " ".join((asset["title"], asset["content"]))) for asset in typed]
+                index = embedding.load_or_build(workspace_id=workspace_id, scope_id=f"business-knowledge-{kind}",
+                                                docs=docs, warnings=warnings)
+                if index is None:
+                    continue
+                by_id = {asset["asset_id"]: asset for asset in typed}
+                for asset_id, score, _ in embedding.rank(index, outcome.vectors, limit=limit):
+                    if score < VECTOR_FLOOR or asset_id in matched or asset_id not in by_id:
+                        continue
+                    matched.add(asset_id)
+                    hits.append(_hit(by_id[asset_id], {"matched_on": ["embedding"], "score": round(score, 4)}))
+        else:
+            warnings.append(f"knowledge_embedding_unavailable:{outcome.error}")
+    elif remaining:
+        warnings.append("knowledge_embedding_unavailable:lexical_only")
+    # Independent typed budgets: a large entity set must not crowd out rules.
+    hits = [hit for kind in ASSET_ROADS.values()
+            for hit in [h for h in hits if h["asset_type"] == kind][:max(0, limit)]]
+    return {"strategy": "lexical+embedding", "channel_status": "ok" if hits else "no_hit",
+            "stage": "L1", "hits": hits, "warnings": warnings, "embedding_called": embedding_called}
+
+
+def as_roads(result: dict) -> dict[str, RoadResult]:
+    """Keep knowledge types separate from the original four ranking pools."""
+    roads = {}
+    for name, kind in ASSET_ROADS.items():
+        hits = []
+        for item in result.get("hits") or []:
+            if item["asset_type"] != kind:
+                continue
+            hits.append(RecallHit(kind=kind, entity_id=item["asset_id"], label=item["title"],
+                                  rank=len(hits) + 1, matched_on=item.get("matched_on") or [],
+                                  channels=[(mark, item.get("score", 0)) for mark in item.get("matched_on") or []],
+                                  payload=item))
+        status = "ok" if hits else result.get("channel_status", "no_hit")
+        roads[name] = RoadResult(kind, tuple(hits), status if status != "ok" or hits else "no_hit",
+                                 tuple(result.get("warnings") or []), len(hits))
+    return roads
+
+
+def _hit(asset: dict, extra: dict) -> dict:
+    return {"asset_id": asset["asset_id"], "asset_type": asset["asset_type"], "title": asset["title"],
+            "content": asset["content"], "scope": asset["scope"], "source": asset["source"],
+            "revision": asset["revision"], **extra}
