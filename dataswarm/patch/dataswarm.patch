+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 治理助手「每巡检批次独立会话」的纯数据层。
+ *
+ * 只管 localStorage 读写 + run ↔ sid 映射的决策逻辑，**不碰** webRequest /
+ * crypto / useChatStore —— 这些副作用留给 governanceChat.ts 编排。
+ * 抽离出来是为了能在 node 下纯函数测试「同批次复用 / 跨批次独立 / 列表封顶」
+ * 等核心语义（见 tests/governanceSessionStore.test.mjs）。
+ *
+ * 旧版是单个 sid（'jiuwen.governance.chatSessionId'）：一轮巡检一个全局
+ * singleton，跨所有批次复用 → 不同轮次的「开始修复」全发进同一会话。现升级
+ * 为列表（'jiuwen.governance.chatSessionIds'），每批次有自己的会话。
+ */
+
+export const GOV_SESSION_STORAGE_KEY = 'jiuwen.governance.chatSessionIds';
+
+/** 列表封顶条数，防无界增长（按时间顺序保留最近 N 个批次）。 */
+export const MAX_GOV_SESSIONS = 20;
+
+export interface GovSessionEntry {
+  sid: string;
+  runId: string;
+}
+
+/** Storage 的最小形状（浏览器 localStorage 的子集，便于测试注入 mock）。 */
+export interface GovStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+/** 读取映射列表：空库 / 脏数据 / 旧版单 sid 键一律回退空列表，绝不抛异常。 */
+export function readEntries(storage: GovStorage): GovSessionEntry[] {
+  try {
+    const raw = storage.getItem(GOV_SESSION_STORAGE_KEY)?.trim() ?? '';
+    if (!raw) return [];
+    const parsed = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return [];
+    return parsed.filter((e): e is GovSessionEntry => {
+      return typeof e === 'object' && e !== null
+        && typeof e.sid === 'string' && !!e.sid
+        && typeof e.runId === 'string';
+    });
+  } catch {
+    return [];
+  }
+}
+
+/** 写入映射列表（fail-open：持久化失败静默，不阻塞对话）。 */
+export function writeEntries(storage: GovStorage, entries: GovSessionEntry[]): void {
+  try {
+    storage.setItem(GOV_SESSION_STORAGE_KEY, JSON.stringify(entries));
+  } catch {
+    /* 隐私模式等场景下持久化失败不阻塞使用 */
+  }
+}
+
+/**
+ * 查找某巡检批次已绑定的会话 id：
+ * 同 runId 多次绑定时取**最近一次**（后写入覆盖前写入）。
+ * 未绑定返回 null（调用方据此决定新建）。
+ * 不做验活——验活是副作用层（governanceChat）的职责。
+ */
+export function findBoundSid(entries: GovSessionEntry[], runId: string): string | null {
+  for (let i = entries.length - 1; i >= 0; i--) {
+    if (entries[i].runId === runId) return entries[i].sid;
+  }
+  return null;
+}
+
+/**
+ * 追加一条 {sid, runId} 到列表末尾；超过 MAX_GOV_SESSIONS 时丢弃最旧的（先进先出）。
+ * 返回新列表（不就地修改原数组），便于调用方链式更新 + 写盘。
+ */
+export function appendEntry(entries: GovSessionEntry[], entry: GovSessionEntry): GovSessionEntry[] {
+  const next = [...entries, entry];
+  if (next.length > MAX_GOV_SESSIONS) {
+    next.splice(0, next.length - MAX_GOV_SESSIONS);
+  }
+  return next;
+}
