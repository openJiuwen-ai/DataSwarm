+    pytest.importorskip("duckdb")
+    source = degrade.register_csv()
+    assert not graph_projection_enabled()
+
+    run = _run(source)
+
+    assert run["status"] == "published", run
+    assert run["diagnostics"]["graph"] == {"status": "unavailable", "reason": "graph_projection_disabled"}
+    assert not run["semantica_version"]
+    # 召回可达：最新 published 快照在场（真相源不依赖图）
+    snapshot = repository.latest_published_snapshot(source["source_id"])
+    assert snapshot is not None and snapshot.run_id == run["run_id"]
+    _refs, snapshots = semantic_link.current_snapshots()
+    assert source["source_id"] in snapshots
+
+
+def test_switch_on_graph_failure_fails_run(degrade, monkeypatch):
+    """开关开：图侧失败照旧让 run 失败（开关只认「关」，不吞开启后的故障）。"""
+    pytest.importorskip("duckdb")
+    source = degrade.register_csv()
+    monkeypatch.setenv("SEMANTICA_GRAPH_ENABLED", "true")
+    assert graph_projection_enabled()
+
+    class BrokenAdapter(InMemorySemanticaAdapter):
+        def stage(self, namespace, version, projection):
+            raise RuntimeError("neo4j unreachable")
+
+    monkeypatch.setattr(service, "from_environment", BrokenAdapter)
+
+    run = _run(source)
+
+    assert run["status"] == "failed", run
+    failure = json.loads(run["error_json"])
+    assert failure["phase"] == "stage" and failure["reason"] == "semantic_collection_failed"
+    assert repository.latest_published_snapshot(source["source_id"]) is None
+
+
+def test_injected_adapter_keeps_graph_publish(degrade):
+    """注入 adapter（既有单测形态）：行为不变，graph 标记恒写入（ok 也写）。"""
+    pytest.importorskip("duckdb")
+    source = degrade.register_csv()
+    graph = InMemorySemanticaAdapter()
+
+    run = service.start_run(
+        {"source_id": source["source_id"], "run_id": "run-graph", "include_profile": True},
+        adapter=graph, synchronous=True)
+
+    assert run["status"] == "published", run
+    assert run["diagnostics"]["graph"] == {"status": "ok"}
+    assert run["semantica_version"]
+    namespace = f"physical/{degrade.workspace_id}/{source['source_id']}"
+    assert graph.published_graphs[namespace].nodes
+
+
+def test_from_environment_gated_by_switch(monkeypatch):
+    """开关 gate 对所有图消费方生效：连接配置齐全但开关关 → 拒绝构造。
+
+    开关关的拒绝发生在 semantica 导入链之前——CI 缺系统依赖（如 _bz2，
+    networkx→bz2 链断）也稳定可测；开关开后的构造断言依赖 ``semantica.kg``
+    导入链可用（Neo4jStore 懒连接，无需真实服务），链不可用的环境跳过。
+    """
+    monkeypatch.setenv("SEMANTICA_URI", "bolt://localhost:7687")
+    monkeypatch.setenv("SEMANTICA_USERNAME", "neo4j")
+    monkeypatch.setenv("SEMANTICA_PASSWORD", "password")
+    monkeypatch.delenv("SEMANTICA_GRAPH_ENABLED", raising=False)
+
+    with pytest.raises(ValueError, match="disabled"):
+        semantica.from_environment()
+
+    monkeypatch.setenv("SEMANTICA_GRAPH_ENABLED", "true")
+    pytest.importorskip("semantica.kg")
+    assert semantica.from_environment() is not None
+
+
+def test_graph_projection_enabled_predicate(monkeypatch):
+    """与前端 parseConfigBoolean 同约定：true/1/yes/on/enabled（忽略大小写与空白）。"""
+    for raw in ("", "   ", "false", "False", "0", "no", "off", "disabled"):
+        monkeypatch.setenv("SEMANTICA_GRAPH_ENABLED", raw)
+        assert not graph_projection_enabled(), raw
+    monkeypatch.delenv("SEMANTICA_GRAPH_ENABLED", raising=False)
+    assert not graph_projection_enabled()
+    for raw in ("1", "true", "True", "TRUE", "yes", "on", "enabled", " true "):
+        monkeypatch.setenv("SEMANTICA_GRAPH_ENABLED", raw)
+        assert graph_projection_enabled(), raw
diff --git a/tests/unit_tests/dataagent/test_semantic_join_evidence.py b/tests/unit_tests/dataagent/test_semantic_join_evidence.py
