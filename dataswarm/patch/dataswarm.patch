+check("A1", "类型目录与表单字段", a_catalog_entries)
+check("A2", "参数校验拒绝非法输入", a_validate_rejects_bad_input)
+check("A3", "endpoint SSRF 边界", a_ssrf_guard)
+check("A4", "连通性测试双向正确", a_test_connection)
