+
+function AttemptBlock({ attempt }: { attempt: ComponentAttempt }) {
+  if (attempt.kind === 'check') {
+    return (
+      <>
+        {attempt.sql && <SqlBlock sql={attempt.sql} />}
+        <CheckTable checks={attempt.checks ?? []} title="" />
+        {attempt.grounding_level && (
+          <p className="mt-1 text-[11px]">
+            <Badge tone="bg-indigo-100 text-indigo-800">{attempt.grounding_level}</Badge>{' '}
+            <span className="text-text-muted">{GROUNDING_LABEL[attempt.grounding_level] ?? ''}</span>
+          </p>
+        )}
+        {attempt.retry_hint && (
+          <p className="mt-1 rounded bg-red-50 px-2 py-1 text-[11px] text-red-700">{attempt.retry_hint}</p>
+        )}
+      </>
+    );
+  }
+  // execute
+  return (
+    <>
+      {attempt.sql && <SqlBlock sql={attempt.sql} />}
+      <CheckTable
+        checks={(attempt.guard ?? []).map((g) => ({ name: g.name ?? g.check ?? "", status: g.status, detail: g.detail }))}
+        title="执行前 guard（撤销 → 只读单语句 → 授权 → 结构兼容 → 行数）"
+      />
+      {attempt.csv_path && (
+        <p className="mt-1 text-[11px] text-text-muted">
+          CSV：<span className="font-mono">{attempt.csv_path}</span> · {attempt.row_count ?? 0} 行
+          {attempt.truncated ? '（截断）' : ''}
+        </p>
+      )}
+      {attempt.grounding_level && (
+        <p className="mt-1 text-[11px]">
+          <Badge tone="bg-indigo-100 text-indigo-800">{attempt.grounding_level}</Badge>{' '}
+            <span className="text-text-muted">
+            {attempt.authoritative ? 'G1 · 已发布定义确定性编译' : GROUNDING_LABEL[attempt.grounding_level] ?? ''} · {authorityLabel(attempt)}
+            {attempt.non_authoritative_reasons?.length ? `（${attempt.non_authoritative_reasons.join(', ')}）` : ''}
+          </span>
+        </p>
+      )}
+      <CheckTable checks={attempt.result_checks ?? []} title="结果检查" />
+      {attempt.error && <p className="mt-1 text-[11px] text-red-600">{attempt.error}</p>}
+    </>
+  );
+}
