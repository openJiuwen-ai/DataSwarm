+# ======================================================================
+print("\n########## 门 C：数据分析跑通 ##########")
+
+
+def c_analysis_through_webhdfs():
+    conn = connector_for()
+    assert isinstance(conn, SqlQueryable), "staged 连接器不具备 sql 能力"
+    table = dataset_names(conn.catalog())[0]
+    answers = {}
+    for label, tpl in QUESTIONS.items():
+        rows = conn.query(tpl.format(t=f'"{table}"'), limit=10)["rows"]
+        answers[label] = [[str(v) for v in row] for row in rows]
+    for label, expected in BASELINE.items():
+        assert answers[label] == expected, (
+            f"{label} 与既有基准不一致:\n  基准={expected}\n  hdfs={answers[label]}"
+        )
+    print("            经真实 HDFS 取数后的答案：")
+    for label, rows in BASELINE.items():
+        print(f"              {label} = {rows[0] if len(rows) == 1 else rows}")
+    return f"5 道题经真实 WebHDFS → 暂存 → DuckDB 与基准逐值一致（表 {table}）"
+
+
+def c_parquet_over_webhdfs():
+    """验证 Parquet 经 OPEN 重定向和流式传输后仍保持完整二进制内容。"""
+    conn = connector_for({**HDFS_CONFIG, "path": f"{HDFS_DIR}/*.parquet",
+                          "format": "parquet"}, source_id="pq-hdfs")
+    table = dataset_names(conn.catalog())[0]
+    rows = conn.query(QUESTIONS["Q1 单指标总量"].format(t=f'"{table}"'), limit=5)["rows"]
+    got = [[str(v) for v in r] for r in rows]
+    assert got == BASELINE["Q1 单指标总量"], got
+    return "parquet 经 307 重定向与流式传输后结果一致（字节未被改写）"
+
+
+check("C1", "5 道分析题经 WebHDFS 跑通", c_analysis_through_webhdfs)
+check("C2", "parquet 经 WebHDFS 二进制完整", c_parquet_over_webhdfs)
+
+# ======================================================================
+print("\n########## 门 D：护栏 ##########")
+
+
+def d_write_rejected():
+    conn = connector_for()
+    table = dataset_names(conn.catalog())[0]
+    for sql in (f'INSERT INTO "{table}" VALUES (1)',
+                f'UPDATE "{table}" SET order_amt = 0',
