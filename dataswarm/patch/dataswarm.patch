+++ b/jiuwenswarm/channels/web/dataagent/metrics/store/revisions.py
@@ -0,0 +1,257 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/revisions.py —— 修订（dw_metric_revisions）CRUD 与 published 推导（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+
+「回源复验」三函数（published_revision / published_revision_of /
+list_effective_published）的内部互调经包门面（``store`` 属性）运行期解析：
+store 单模块时代，外部对 ``store.get_revision`` / ``store.get_def_by_key``
+等的 monkeypatch 在这些函数内同样生效；拆包后子模块直接引用会绕过 patch
+（test_analysis_checks / knowledge_flow 实证）——门面解析保留该语义。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+)
+
+from ..errors import MetricNotFound
+from ..model import (
+    REVISION_PUBLISHED,
+    ExpressionSpec,
+    MetricDef,
+    MetricRevision,
+    as_list,
+    canonical_json,
+)
+from ._db import _commit_if_own, _conn_or, _parse_json_dict, _write_lock
+
+
+
+# ==========================================================================
+# dw_metric_revisions —— 不可变口径版本
+# ==========================================================================
+_REV_COLS = (
+    "revision_id, metric_id, workspace_id, revision_no, metric_type, datatype, unit,"
+    " display_name, synonyms, expression_json, fixed_filters_json, time_dimension,"
+    " allowed_dimensions_json, time_grains_json, timezone, calendar, dependencies_json,"
+    " zero_denominator, additivity_json, subject_iri, status, source_type, ossie_raw,"
+    " definition_ref, definition_hash, created_at"
+)
+
+
+def create_revision(rev: MetricRevision, *, conn: Any = None) -> MetricRevision:
+    """写入一条修订。调用方须已算好 ``definition_hash`` 与 ``definition_ref``。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                f"INSERT INTO dw_metric_revisions ({_REV_COLS})"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    rev.revision_id, rev.metric_id, rev.workspace_id, rev.revision_no,
+                    rev.metric_type, rev.datatype, rev.unit, rev.display_name,
+                    canonical_json(list(rev.synonyms)), canonical_json(rev.expression.to_json_obj()),
+                    canonical_json([dict(f) for f in rev.fixed_filters]), rev.time_dimension,
+                    canonical_json(list(rev.allowed_dimensions)), canonical_json(list(rev.time_grains)),
+                    rev.timezone, rev.calendar, canonical_json(list(rev.dependencies)),
+                    rev.zero_denominator, canonical_json(dict(rev.additivity)), rev.subject_iri,
+                    rev.status, rev.source_type, rev.ossie_raw, rev.definition_ref,
+                    rev.definition_hash, rev.created_at,
+                ),
+            )
+            _commit_if_own(c, own)
+        return rev
+    finally:
+        if own:
+            c.close()
+
+
+def _row_to_revision(row: dict) -> MetricRevision:
+    return MetricRevision(
+        revision_id=row["revision_id"],
+        metric_id=row["metric_id"],
+        workspace_id=row["workspace_id"],
+        revision_no=int(row.get("revision_no") or 0),
+        metric_type=row.get("metric_type") or "atomic",
+        datatype=row.get("datatype") or "",
+        unit=row.get("unit") or "",
+        display_name=row.get("display_name") or "",
+        synonyms=tuple(as_list(row.get("synonyms"))),
+        expression=ExpressionSpec.from_json_obj(row.get("expression_json")),
+        fixed_filters=tuple(dict(f) for f in as_list(row.get("fixed_filters_json"))),
+        time_dimension=row.get("time_dimension") or "",
+        allowed_dimensions=tuple(as_list(row.get("allowed_dimensions_json"))),
+        time_grains=tuple(as_list(row.get("time_grains_json"))),
+        timezone=row.get("timezone") or "",
+        calendar=row.get("calendar") or "",
+        dependencies=tuple(as_list(row.get("dependencies_json"))),
+        zero_denominator=row.get("zero_denominator") or "",
+        additivity=_parse_json_dict(row.get("additivity_json")),
+        subject_iri=row.get("subject_iri") or "",
+        status=row.get("status") or "draft",
+        source_type=row.get("source_type") or "manual",
+        ossie_raw=row.get("ossie_raw") or "",
+        definition_ref=row.get("definition_ref") or "",
+        definition_hash=row.get("definition_hash") or "",
+        created_at=row.get("created_at") or "",
+    )
+
+
+
+def get_revision(revision_id: str, *, conn: Any = None) -> MetricRevision | None:
+    """按主键取修订。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c, "SELECT * FROM dw_metric_revisions WHERE revision_id = ?", (revision_id,))
+        return _row_to_revision(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def get_revision_or_raise(revision_id: str, *, conn: Any = None) -> MetricRevision:
+    """按主键取修订，不存在抛 :class:`~.errors.MetricNotFound`。"""
+    rev = get_revision(revision_id, conn=conn)
+    if rev is None:
+        raise MetricNotFound(f"修订 {revision_id} 不存在")
+    return rev
+
+
+def published_revision(metric: MetricDef | None) -> MetricRevision | None:
+    """指标当前修订已发布且未归档 → 该修订，否则 None。
+
+    「指标当前是否生效」的唯一判定口径：archived、无当前修订、当前修订
+    非 published 均不生效。召回/校验/执行各环节回源复验发布态时必须走
+    这里，不得就地重抄判定（archived 漏查会让已归档指标混进候选）。
+    """
+    if metric is None or metric.status == "archived" or not metric.current_revision_id:
+        return None
+    from .. import store as _facade  # 互调经包门面解析：见模块 docstring
+    revision = _facade.get_revision(metric.current_revision_id)
+    if revision is not None and revision.status == REVISION_PUBLISHED:
+        return revision
+    return None
+
+
+def published_revision_of(workspace_id: str, metric_key: str) -> MetricRevision | None:
+    """按 (workspace, metric_key) 回源取当前生效的 published 修订。"""
+    from .. import store as _facade
+    return published_revision(_facade.get_def_by_key(workspace_id, metric_key))
+
+
+def list_effective_published(workspace_id: str) -> list[tuple[MetricDef, MetricRevision]]:
+    """工作空间全部生效指标：(指标身份, 当前 published 修订) 列表。"""
+    from .. import store as _facade
+    return [
+        (metric, revision)
+        for metric in _facade.list_defs(workspace_id)
+        if (revision := published_revision(metric)) is not None
+    ]
+
+
+def list_revisions(metric_id: str, *, conn: Any = None) -> list[MetricRevision]:
+    """列出某指标的全部修订，按版本号倒序。"""
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_revisions WHERE metric_id = ? ORDER BY revision_no DESC",
+            (metric_id,),
+        )
+        return [_row_to_revision(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+def list_revisions_by_ids(revision_ids: list[str], *, conn: Any = None) -> list[MetricRevision]:
+    """按 ID 集合批量取修订。空集合直接返回空列表（不发 SQL）。"""
+    if not revision_ids:
+        return []
+    c, own = _conn_or(conn)
+    try:
+        placeholders = ", ".join("?" for _ in revision_ids)
+        rows = _fetch_dicts(
+            c,
+            f"SELECT * FROM dw_metric_revisions WHERE revision_id IN ({placeholders})",
+            tuple(revision_ids),
+        )
+        return [_row_to_revision(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+def next_revision_no(metric_id: str, *, conn: Any = None) -> int:
+    """下一个修订号，从 1 开始。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c,
+            "SELECT MAX(revision_no) AS max_no FROM dw_metric_revisions WHERE metric_id = ?",
+            (metric_id,),
+        )
+        return int((row or {}).get("max_no") or 0) + 1
+    finally:
+        if own:
+            c.close()
+
+
+def update_revision_status(revision_id: str, status: str, *, conn: Any = None) -> None:
+    """改修订状态。修订口径本身不可变，只有状态可变。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_revisions SET status = ? WHERE revision_id = ?",
+                (status, revision_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def find_revision_by_hash(
+    workspace_id: str, definition_hash: str, *, conn: Any = None
+) -> MetricRevision | None:
+    """按定义哈希查已存在修订，用于导入幂等。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c,
+            "SELECT * FROM dw_metric_revisions WHERE workspace_id = ? AND definition_hash = ?"
+            " ORDER BY revision_no DESC",
+            (workspace_id, definition_hash),
+        )
+        return _row_to_revision(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def delete_revisions_for_metric(metric_id: str, *, conn: Any = None) -> int:
+    """删除某指标的全部修订，返回删除行数（绑定/映射由调用方先级联清理）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_revisions WHERE metric_id = ?", (metric_id,))
+            deleted = int(getattr(cursor, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
