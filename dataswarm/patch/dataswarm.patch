@@ -0,0 +1,137 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Successful exploration queries return observable, non-blocking collection feedback."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.analysis import checks, execute
+from jiuwenswarm.channels.web.dataagent.semantic import service as semantic_service
+from jiuwenswarm.common import workspace_context
+
+
+@pytest.fixture()
+def query_env(monkeypatch):
+    state = {"workspace_id": "ws-a", "source_type": "sqlite", "ok": True, "executed": []}
+    monkeypatch.setattr(workspace_context, "current_workspace", lambda: SimpleNamespace(
+        workspace_id=state["workspace_id"]))
+    monkeypatch.setattr(execute, "_authorized_ref", lambda ws, sid, ref: ref or "sqlite://source.db")
+    monkeypatch.setattr(execute, "_source_type_of", lambda sid, ref: state["source_type"])
+    monkeypatch.setattr(checks, "_snapshot_scope_tables", lambda: {"orders": ["id"]})
+
+    def run_sql(db_ref, sql, **kwargs):
+        state["executed"].append({"sql": sql, **kwargs})
+        return {"ok": state["ok"], "rows": [{"x": 1}], "columns": ["x"], "row_count": 1}
+
+    monkeypatch.setattr(execute.sql_service, "run_sql", run_sql)
+    return state
+
+
+def _query(**kwargs):
+    return {"sql": "SELECT x FROM temp_t", "source_id": "src",
+            "temp_scope": {"tables": {"temp_t": ["x"]}}, **kwargs}
+
+
+def test_query_returns_run_and_uses_query_specific_entry(monkeypatch, query_env):
+    calls = []
+    monkeypatch.setattr(semantic_service, "start_run_for_query", lambda sid, ws:
+                        calls.append((sid, ws)) or {"run_id": "query-run", "status": "running"})
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda *args:
+                        pytest.fail("query feedback must not be classified as binding"))
+
+    result = execute.execute_request(_query())
+
+    assert result["ok"] is True
+    assert result["grounding_level"] == "G3"
+    assert result["rows"] == [{"x": 1}]
+    assert calls == [("src", "ws-a")]
+    assert result["semantic_collection"] == {
+        "status": "queued", "run_id": "query-run", "run_status": "running",
+    }
+
+
+@pytest.mark.parametrize("status,reason", [
+    ("unsupported", "metadata_collection_unsupported"),
+    ("disabled", "source_disabled"),
+    ("source_not_found", "source_not_found"),
+])
+def test_query_reports_decline_without_spawning_feedback_threads(
+    monkeypatch, query_env, status, reason,
+):
+    import threading
+
+    outcome = {"status": status, "reason": reason, "warnings": [reason]}
+    monkeypatch.setattr(semantic_service, "start_run_for_query", lambda *args: outcome)
+    monkeypatch.setattr(threading, "Thread", lambda *args, **kwargs:
+                        pytest.fail("unsupported query feedback must not create a thread"))
+
+    for _ in range(3):
+        result = execute.execute_request(_query())
+        assert result["ok"] is True
+        assert result["semantic_collection"] == outcome
+
+
+def test_query_survives_startup_failure_and_redacts_exception_text(monkeypatch, query_env):
+    def fail(*args):
+        raise RuntimeError("postgresql://user:private-password@db/shop")
+
+    monkeypatch.setattr(semantic_service, "start_run_for_query", fail)
+    result = execute.execute_request(_query())
+
+    assert result["ok"] is True
+    assert result["rows"] == [{"x": 1}]
+    assert result["semantic_collection"]["status"] == "trigger_failed"
+    assert result["semantic_collection"]["reason"] == "semantic_collection_trigger_failed"
+    assert result["semantic_collection"]["error"] == "RuntimeError"
+    assert "private-password" not in repr(result)
+
+
+@pytest.mark.parametrize("successful,temporary", [(False, True), (True, False)])
+def test_only_successful_temporary_scope_queries_trigger_collection(
+    monkeypatch, query_env, successful, temporary,
+):
+    query_env["ok"] = successful
+    monkeypatch.setattr(semantic_service, "start_run_for_query", lambda *args:
+                        pytest.fail("this query should not trigger collection"))
+    body = _query() if temporary else _query(sql="SELECT id FROM orders", temp_scope={})
+
+    result = execute.execute_request(body)
+
+    assert result["ok"] is successful
+    assert "semantic_collection" not in result
+
+
+def test_query_feedback_keeps_workspace_with_same_source_id(monkeypatch, query_env):
+    calls = []
+    monkeypatch.setattr(semantic_service, "start_run_for_query", lambda sid, ws:
+                        calls.append((sid, ws)) or {"run_id": f"{ws}-run", "status": "queued"})
+
+    for ws in ("ws-a", "ws-b"):
+        query_env["workspace_id"] = ws
+        result = execute.execute_request(_query())
+        assert result["semantic_collection"]["run_id"] == f"{ws}-run"
+
+    assert calls == [("src", "ws-a"), ("src", "ws-b")]
+    assert [query["workspace_id"] for query in query_env["executed"]] == ["ws-a", "ws-b"]
+
+
+@pytest.mark.parametrize("source_type,sql,temp_scope", [
+    ("sqlserver", "SELECT TOP (1) [x] FROM [temp_t]", {"tables": {"temp_t": ["x"]}}),
+    ("postgresql", 'SELECT "new_col" FROM "public"."orders"',
+     {"tables": {"public.orders": ["new_col"]}}),
+])
+def test_native_dialect_guard_and_temp_scope_trigger_feedback(
+    monkeypatch, query_env, source_type, sql, temp_scope,
+):
+    query_env["source_type"] = source_type
+    monkeypatch.setattr(semantic_service, "start_run_for_query", lambda *args: {
+        "run_id": "native-run", "status": "queued",
+    })
+
+    result = execute.execute_request(_query(sql=sql, temp_scope=temp_scope))
+
+    assert result["ok"] is True
+    assert result["grounding_level"] == "G3"
+    assert result["semantic_collection"]["run_id"] == "native-run"
+    assert query_env["executed"][0]["sql"] == sql
