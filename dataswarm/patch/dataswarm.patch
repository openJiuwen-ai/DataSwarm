+    assert cfg["skill_test_dirs"] == ["dw_analysis_eval", "dw_other"]
+    # 行内注释剥离（value 尾部 " #..." 不进值）
+    cfg2 = lib.parse_yaml_subset("archive:\n  branch: MR  # 归档分支\n")
+    assert cfg2["archive"]["branch"] == "MR"
+
+    assert lib.classify_dev_path("jiuwenswarm/a.py", cfg) == "patch"
+    assert lib.classify_dev_path("tests/test_new.py", cfg) == "patch"          # 前后端测试统一走 patch
+    assert lib.classify_dev_path("jiuwenswarm/channels/web/frontend/tests/ui.test.mjs", cfg) == "patch"
+    assert lib.classify_dev_path("tests/unit_tests/dw_not_in_list/test_x.py", cfg) == "patch"
+    assert lib.classify_dev_path("jiuwenswarm/resources/agent/workspace/skills/dw-demo/SKILL.md", cfg) == "skills"
+    # 全部测试在 patch 内，无 tests 展示分类
