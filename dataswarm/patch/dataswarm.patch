+def test_hbase_does_not_push_synthetic_rowkey_column_down():
+    """合成列不能下推给存储——真连才暴露的一类缺陷（批 10 门 B4 抓到）。
+
+    ``_row`` 是连接器自己造的 RowKey 列，HBase 侧不存在。它出现在
+    ``infer_schema`` 的列清单里，上层按列清单选列时必然会传下来；原样下推会被
+    RegionServer 以 ``NoSuchColumnFamilyException`` 拒掉（HBase 把不带冒号的
+    名字当列族看）。离线测试发现不了，因为桩不会校验列族是否存在。
+    """
+    from jiuwenswarm.channels.web.dataagent.connectors.sampled_connector import (
+        HBaseStore,
+    )
+
+    push = HBaseStore._pushdown_columns
+    assert push(None) is None
+    assert push([]) is None
+    # 真实列照常下推
+    assert push(["d:order_id", "d:order_amt"]) == [b"d:order_id", b"d:order_amt"]
+    # 合成列被剔除，真实列仍下推
+    assert push(["_row", "d:order_id"]) == [b"d:order_id"]
+    # 只选了合成列 → 退化为全列扫（而不是传一个 HBase 不认的列族）
+    assert push([HBaseStore.ROW_KEY_COLUMN]) is None
