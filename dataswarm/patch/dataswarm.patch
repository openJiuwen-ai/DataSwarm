+@register_source_type
+class FtpAdapter(SourceTypeAdapter):
+    """通过 staged 引擎下载 FTP/SFTP 文件并交给 DuckDB 查询。
+
+    FTP 的凭据和数据均为明文；SFTP 使用加密传输并校验服务器密钥。
+    """
+
+    type_id = "ftp"
+    label = "FTP / SFTP"
+    category = "file"
+    engine = "staged"
+    # FTP 使用标准库；类型同时提供 SFTP，因此统一检查 Paramiko 依赖。
+    requires = ("duckdb", "paramiko")
+    capabilities = {"test_connection", "catalog", "schema", "preview", "sql_query"}
+    protocols = ("sftp", "ftp")
+    formats = ("csv", "parquet", "json")
+    fields = [
+        SourceField("protocol", "Protocol", required=True,
+                    placeholder="sftp（推荐）或 ftp（明文传输，不加密）"),
+        SourceField("host", "Host", required=True, placeholder="10.0.0.1"),
+        SourceField("port", "Port", input_type="number", placeholder="sftp=22 / ftp=21"),
+        SourceField("user", "User", required=True, placeholder="readonly"),
+        SourceField("password", "Password", secret=True, input_type="password"),
+        SourceField("known_hosts", "SFTP known_hosts file",
+                    placeholder="本地可信 known_hosts 文件；留空使用用户默认文件"),
+        SourceField("host_key_sha256", "SFTP host key fingerprint",
+                    placeholder="SHA256:...（与 known_hosts 二选一）"),
+        SourceField("path", "Remote Path (glob)", required=True,
+                    placeholder="/data/orders/*.csv"),
+        SourceField("format", "Format", required=True, placeholder="csv"),
+        SourceField("table_name", "Table Name", placeholder="data"),
+    ]
+
+    def validate(self, params: dict) -> None:
+        protocol = str(params.get("protocol") or "").strip().lower()
+        if protocol not in self.protocols:
+            raise ValueError(f"protocol must be {' or '.join(self.protocols)}")
+        if protocol == "sftp":
+            known_hosts = str(params.get("known_hosts") or "").strip()
+            fingerprint = str(params.get("host_key_sha256") or "").strip()
+            if known_hosts and fingerprint:
+                raise ValueError("choose known_hosts or host_key_sha256, not both")
+            if fingerprint and not re.fullmatch(r"SHA256:[A-Za-z0-9+/]{43}=?", fingerprint):
+                raise ValueError("host_key_sha256 must be an OpenSSH SHA256 fingerprint")
+        if not str(params.get("host") or "").strip():
+            raise ValueError("host is required")
+        if not str(params.get("user") or "").strip():
+            raise ValueError("user is required for ftp/sftp source")
+        _validate_optional_port(params, "port")
+        remote = str(params.get("path") or "").strip()
+        if not remote:
+            raise ValueError("path is required for ftp/sftp source")
+        if ".." in remote:
+            # 远端路径不会变成本地写入路径（缓存目录按哈希定位），但 ``..``
+            # 在远端侧也是越权读取的信号，直接拒。
+            raise ValueError("path must not contain '..'")
+        if str(params.get("format") or "").strip().lower() not in self.formats:
+            raise ValueError(f"format must be {', '.join(self.formats)}")
+
+    def build_ref(self, config: dict) -> str:
+        """FTP 源 → duckdb:// ref（指向远端 URI，由 codec 负责暂存后再查）。
+
+        凭据不进 ref：ref 只带 protocol://host:port/path，凭据留在数据源配置里，
+        与 MySQL 族「完整 ref 凭据为空、按连接四元组查」同一纪律。
+        """
+        from jiuwenswarm.common.db_connector import build_file_source_ref
+
+        protocol = str(config.get("protocol") or "sftp").strip().lower()
+        default_port = 22 if protocol == "sftp" else 21
+        port = int(config.get("port") or default_port)
+        remote = str(config.get("path") or "")
+        location = f"{protocol}://{config.get('host')}:{port}{remote}"
+        return build_file_source_ref(
+            self.type_id, location,
+            str(config.get("table_name") or "") or None,
+        )
+
+    def test_connection(self, config: dict) -> dict:
+        from ..connectors.base import SourceDefinition
+        from ..connectors.staged_connector import StagedFileConnector
+
+        source = SourceDefinition(
+            "connection_test", self.type_id, "connection_test", self.engine, dict(config)
+        )
+        connector = StagedFileConnector(source)
+        try:
+            return connector.test_connection()
+        finally:
+            connector.close()
+
