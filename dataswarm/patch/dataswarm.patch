+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage delete 按 plan_id 修复单测（方案 §5.4 G6）。
+
+bug 修复档 TDD：现状 delete_table_lineage/delete_column_lineage 的 task_id 是必传，
+SQL 为 `WHERE plan_id=? AND task_id=?`——task_id 为 NULL 时恒不命中（已验证
+sqlite_store.py:433/doris_store.py:466）。本测试表达"task_id 可选，仅传 plan_id
+时按 plan_id 删"的正确期望，跑前应为红，修复后转绿。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.lineage import service as svc
+
+
+class _FakeStore:
+    """记录 delete 调用的 (plan_id, task_id, sql片段) 供断言。"""
+
+    def __init__(self):
+        self.delete_calls: list[tuple] = []  # (plan_id, task_id)
+        self.delete_count = 0
+
+    def list_table_lineage(self, db_name):
+        return []
+
+    def list_column_lineage(self, db_name, table_name=""):
+        return []
+
+    def save_table_lineage(self, edges):
+        return 0
+
+    def save_column_lineage(self, edges):
+        return 0
+
+    def delete_table_lineage(self, plan_id, task_id=None):
+        self.delete_calls.append(("table", plan_id, task_id))
+        return self.delete_count
+
+    def delete_column_lineage(self, plan_id, task_id=None):
+        self.delete_calls.append(("column", plan_id, task_id))
+        return self.delete_count
+
+
+@pytest.fixture
+def patch_store(monkeypatch):
+    store = _FakeStore()
+    monkeypatch.setattr(svc, "_get_store", lambda: store)
+    return store
+
+
+# --------------------------------------------------------------------------
+# task_id 省略 → 按 plan_id 删
+# --------------------------------------------------------------------------
+def test_delete_table_lineage_by_plan_only(patch_store):
+    """仅传 plan_id（task_id 省略）→ 按 plan_id 删。"""
+    out = svc.delete_table_lineage("plan_x")
+    assert out == 0  # FakeStore 返回 delete_count
+    kind, plan_id, task_id = patch_store.delete_calls[0]
+    assert kind == "table"
+    assert plan_id == "plan_x"
+    assert task_id is None  # 省略 → None
+
+
+def test_delete_column_lineage_by_plan_only(patch_store):
+    out = svc.delete_column_lineage("plan_x")
+    assert out == 0
+    kind, plan_id, task_id = patch_store.delete_calls[0]
+    assert kind == "column"
+    assert plan_id == "plan_x"
+    assert task_id is None
+
+
+# --------------------------------------------------------------------------
+# task_id 显式传 → 双条件删（向后兼容）
+# --------------------------------------------------------------------------
+def test_delete_table_lineage_with_task_id(patch_store):
+    """显式传 task_id → 双条件删（向后兼容现有调用方）。"""
+    svc.delete_table_lineage("plan_x", "task_y")
+    kind, plan_id, task_id = patch_store.delete_calls[0]
+    assert plan_id == "plan_x"
+    assert task_id == "task_y"
+
+
+def test_delete_column_lineage_with_task_id(patch_store):
+    svc.delete_column_lineage("plan_x", "task_y")
+    kind, plan_id, task_id = patch_store.delete_calls[0]
+    assert plan_id == "plan_x"
+    assert task_id == "task_y"
+
+
+# --------------------------------------------------------------------------
+# 空 plan_id → 不删（防误删全表）
+# --------------------------------------------------------------------------
+def test_delete_table_lineage_empty_plan_id_no_delete(patch_store):
+    """空 plan_id → 不执行删除（防误删全表）。"""
+    out = svc.delete_table_lineage("")
+    assert out == 0
+    assert patch_store.delete_calls == []  # 没调 store
+
+
+def test_delete_table_lineage_none_plan_id_no_delete(patch_store):
+    out = svc.delete_table_lineage(None)  # type: ignore[arg-type]
+    assert out == 0
+    assert patch_store.delete_calls == []
