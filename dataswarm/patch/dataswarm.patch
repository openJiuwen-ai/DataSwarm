@@ -0,0 +1,262 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/generator.py —— LLM 生成 SQL 的兜底通路（方案 §阶段 5.2）。
+
+只在**主通路不可用**时触发：指标无 published 修订、无有效绑定、或问题涉及
+未注册口径的探索性查询。产出必须过完整 guard（只读/单语句/对象范围），结果
+一律 ``path="llm"`` + ``authoritative=False``。
+
+红线（方案 §阶段 5.2）：
+- LLM 输入必须同时含**指标定义**与**语义关系上下文**；
+- 修正环上限 ``LLM_MAX_REPAIRS``（默认 2），仍失败则抛错，绝不返回无数据依据的结果；
+- ``call_llm_sync`` 空串 → LLMUnavailable，不重试语义。
+"""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Sequence
+
+import sqlglot
+
+from jiuwenswarm.channels.web.dataagent.connectors.sql_guard import validate_read_only_sql
+
+from . import llm
+from .errors import LLMUnavailable, SqlValidationError
+from .guard import out_of_scope_columns, out_of_scope_tables
+from .model import Binding, MetricRevision
+from .semantic_link import SemanticContext
+
+MAX_REPAIRS = 2
+
+# 术语口径段的 definition 截断：db 层上限 4000 字符，prompt 里 200 字足够
+# 对齐口径（口径关键在「算什么/排除什么」，不在全文）
+GLOSSARY_DEF_PROMPT_CAP = 200
+
+_SYSTEM_PROMPT = """你是数仓 SQL 生成器。根据「语义上下文」「指标口径」与「真实表结构」生成一条只读查询 SQL。
+
+硬性规则：
+1. 只输出一条 SQL 语句：纯 SELECT（可带 WITH 子查询），禁止任何 DDL/DML/多语句。
+2. 只能使用「真实表结构」里列出的表和列，一个都不许编造。
+3. 指标口径里的固定条件（如「仅统计已支付订单」）必须体现在 SQL 中。
+4. 时间过滤使用参数占位符 ? （不要拼日期字面量），参数顺序与 WHERE 中出现顺序一致。
+5. 只输出一个 JSON 对象，不要解释文字或 markdown 标记。
+
+输出格式：
+{"sql": "SELECT ...", "params": ["...", "..."], "assumptions": ["..."], "confidence": "low|medium|high"}"""
+
+
+@dataclass(frozen=True)
+class GeneratedSQL:
+    """兜底通路的生成产物。"""
+
+    sql: str
+    params: tuple[str, ...] = ()
+    assumptions: tuple[str, ...] = ()
+    confidence: str = "low"
+    attempts: int = 1
+    warnings: tuple[str, ...] = field(default_factory=tuple)
+
+
+def generate_sql(
+    question: str,
+    semantic_context: SemanticContext | None,
+    revisions: list[MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+    *,
+    dialect: str,
+    db_type: str,
+    max_repairs: int = MAX_REPAIRS,
+    config_path: str | None = None,
+    verified_examples: list[str] | None = None,
+    schema_scope: dict[str, Any] | None = None,
+    glossary_terms: Sequence[Mapping[str, Any]] | None = None,
+) -> GeneratedSQL:
+    """LLM 生成候选 SQL + 有限修正环。
+
+    Args:
+        question: 用户问题。
+        semantic_context: 语义关系上下文（可为 None，此时 prompt 里显式说明缺席）。
+        revisions: 相关修订（口径定义）。
+        bindings_by_revision: 绑定（真实表列）。
+        dialect: 目标 sqlglot 方言名。
+        db_type: 目标库类型。
+        max_repairs: 校验失败后的最大重生成次数。
+        config_path: LLM 配置路径。
+        verified_examples: 已确认 SQL 样例（few-shot，最多 3 条）。
+        schema_scope: 显式表列白名单 ``{"tables": {table: [col...]}}``（探索通路用）。
+            给了就用它做快校验范围；不给则从 revisions/bindings 推导。
+        glossary_terms: 问题命中的业务术语（口径增强 B，同构 dict 序列：
+            ``{"name": ..., "definition": ..., "ambiguous": ...}``）。
+            definition 渲染进口径段——兜底是 LLM 自由写 SQL 的地方，口径漂移
+            风险最大，术语口径跟着问题走而不只跟着指标走；歧义标记不渲染
+            （调用方选定 metric_key 后歧义已裁决）。
+
+    Returns:
+        :class:`GeneratedSQL`。
+
+    Raises:
+        LLMUnavailable: LLM 返回空串。
+        SqlValidationError: 修正次数耗尽仍不合法。
+    """
+    caliber = [
+        {
+            "metric_key": r.definition_ref,
+            "metric_type": r.metric_type,
+            "unit": r.unit,
+            "time_dimension": r.time_dimension,
+            "expression_dialect": r.expression.resolved_dialect,
+        }
+        for r in revisions
+    ]
+    schema = schema_scope if schema_scope is not None else schema_slice_of(revisions, bindings_by_revision)
+    ctx_obj = None
+    if semantic_context is not None:
+        ctx_obj = {
+            "metric_key": semantic_context.metric_key,
+            "label": semantic_context.label,
+            "concept": semantic_context.concept,
+            "operator": semantic_context.operator,
+            "formula_summary": semantic_context.formula_summary,
+            "dependencies": semantic_context.dependencies,
+            "time_field": semantic_context.time_field,
+            "group_by_fields": semantic_context.group_by_fields,
+        }
+    examples = (verified_examples or [])[:3]
+    # 术语口径段（口径增强 B）：口径参考渲染进 prompt（见 glossary_terms 参数
+    # 说明）；无命中术语时为空串，prompt 形态与既有结构一致
+    term_section = glossary_terms_prompt(glossary_terms or (), with_ambiguity=False)
+    user_prompt = (
+        f"目标 SQL 方言：{dialect}\n\n"
+        f"语义关系上下文：{json.dumps(ctx_obj, ensure_ascii=False) if ctx_obj else '（无——本次为探索性查询）'}\n\n"
+        f"指标口径：{json.dumps(caliber, ensure_ascii=False)}\n\n"
+        + (f"{term_section}\n\n" if term_section else "")
+        + f"真实表结构：{json.dumps(schema, ensure_ascii=False)}\n\n"
+        + ("已确认的同类 SQL 样例（仅供风格与口径参考）：\n"
+           + "\n".join(f"-- 样例 {i + 1}\n{sql}" for i, sql in enumerate(examples)) + "\n\n"
+           if examples else "")
+        + f"用户问题：{question}")
+
+    feedback = ""
+    attempts = 0
+    total = 1 + max(0, max_repairs)
+    for _ in range(total):
+        attempts += 1
+        prompt = user_prompt if not feedback else \
+            f"{user_prompt}\n\n上一次生成的 SQL 未通过校验：{feedback}\n请修正后重新生成。"
+        raw = llm.call_llm_sync(_SYSTEM_PROMPT, prompt,
+                                config_path=config_path, temperature=0.0)
+        if not raw:
+            raise LLMUnavailable("LLM 不可用（返回空串），兜底通路无法生成 SQL")
+        parsed = _parse_output(raw)
+        if parsed is None:
+            feedback = "输出不是合法 JSON 或缺少 sql 字段"
+            continue
+        sql, params, assumptions, confidence = parsed
+        problem = _quick_validate(sql, db_type, schema)
+        if problem is None:
+            return GeneratedSQL(sql=sql, params=tuple(params),
+                                assumptions=tuple(assumptions), confidence=confidence,
+                                attempts=attempts)
+        feedback = problem
+    raise SqlValidationError(
+        f"LLM 生成的 SQL 经 {attempts} 次尝试仍未通过校验：{feedback}",
+        retryable=False)
+
+
+def glossary_terms_prompt(terms: Sequence[Mapping[str, Any]],
+                          *, with_ambiguity: bool = True) -> str:
+    """命中术语 → prompt 口径段（无可用术语返回空串）。
+
+    ``with_ambiguity=True`` 渲染 ``[口径歧义]`` 标注与确认指令（术语口径
+    逐字面鉴别的场景用）；``generate_sql`` 兜底固定 ``with_ambiguity=False``
+    ——兜底时调用方已选定 metric_key，口径歧义已被裁决，残留的歧义标记
+    只会误导 SQL 生成，只留口径参考。
+
+    Args:
+        terms: 命中术语序列（同构 dict：name / definition / ambiguous）。
+        with_ambiguity: 是否渲染歧义标注与确认指令。
+
+    Returns:
+        prompt 段落；无可用术语时空串（调用方据此跳过段落）。
+    """
+    usable = [t for t in terms if str(t.get("name") or "").strip()]
+    if not usable:
+        return ""
+    lines: list[str] = []
+    for term in usable:
+        definition = str(term.get("definition") or "").strip()
+        if len(definition) > GLOSSARY_DEF_PROMPT_CAP:
+            definition = definition[:GLOSSARY_DEF_PROMPT_CAP] + "…"
+        flag = "[口径歧义] " if with_ambiguity and term.get("ambiguous") else ""
+        lines.append(f"- {flag}{term['name']}：{definition or '（术语库未提供定义）'}")
+    section = ("问题中识别到的业务术语（口径参考，不是候选指标，"
+               "不能当作 metric_key 使用）：\n" + "\n".join(lines))
+    if with_ambiguity and any(term.get("ambiguous") for term in usable):
+        section += ("\n注意：标「口径歧义」的术语在术语库同分命中，无法确定性判断"
+                    "用户指的是哪个口径——请结合问题语境与上述定义判断指向；"
+                    "无法确定时不要猜，把候选口径写进 clarifications 向用户确认。")
+    return section
+
+
+def schema_slice_of(revisions: list[MetricRevision],
+                    bindings_by_revision: dict[str, Any]) -> dict[str, Any]:
+    """给兜底生成器的真实表列切片（只含绑定声明的对象）。"""
+    tables: dict[str, list[str]] = {}
+    for rev in revisions:
+        for binding in bindings_by_revision.get(rev.revision_id, ()):
+            if binding.source_table:
+                cols = tables.setdefault(binding.source_table.split(".")[-1], [])
+                for logical, physical in binding.column_map.items():
+                    name = physical.split(".")[-1]
+                    if name not in cols:
+                        cols.append(name)
+    return {"tables": tables}
+
+
+def _parse_output(raw: str) -> tuple[str, list, list, str] | None:
+    """解析 LLM 输出为 (sql, params, assumptions, confidence)。"""
+    import re
+
+    text = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw.strip()).strip()
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError:
+        return None
+    if not isinstance(parsed, dict) or not parsed.get("sql"):
+        return None
+    params = parsed.get("params") or []
+    if not isinstance(params, list):
+        params = []
+    assumptions = parsed.get("assumptions") or []
+    confidence = str(parsed.get("confidence") or "low")
+    if confidence not in ("low", "medium", "high"):
+        confidence = "low"
+    return str(parsed["sql"]), [str(p) for p in params], list(assumptions), confidence
+
+
+def _quick_validate(sql: str, db_type: str, schema: dict) -> str | None:
+    """编译期快校验：只读/单语句 + 表列范围。
+
+    完整 guard（口径约束/授权）由 service 在执行前统一跑——这里只把明显
+    不合法的输出挡在重试环内，省一次无谓的执行。表列范围判定复用 guard
+    原子（``out_of_scope_tables`` / ``out_of_scope_columns``，E2 收敛——
+    同题单一出处；与原内联实现的逐位一致由 test_sql_scan_parity.py 对拍锁定）。
+    """
+    try:
+        validate_read_only_sql(sql, source_type=db_type)
+    except Exception as exc:  # noqa: BLE001 —— 校验失败就是要回喂的信息
+        return f"只读校验失败: {getattr(exc, 'detail', str(exc))}"
+    read = db_type if db_type != "doris" else "mysql"
+    try:
+        parsed = sqlglot.parse_one(sql, read=read)
+    except sqlglot.errors.ParseError as exc:
+        return f"按 {read} 方言解析失败: {exc}"
+    allowed_tables = set((schema.get("tables") or {}).keys())
+    allowed_columns = {c for cols in (schema.get("tables") or {}).values() for c in cols}
+    out_tables = out_of_scope_tables(parsed, allowed_tables)
+    if out_tables:
+        return f"引用了未授权的表 {out_tables[0]}（允许: {', '.join(sorted(allowed_tables))}）"
+    out_columns = out_of_scope_columns(parsed, allowed_columns)
+    if out_columns:
+        return f"引用了未声明的列 {out_columns[0]}"
+    return None
