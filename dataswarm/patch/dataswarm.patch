-
-            if remote_ids:
-                await channel.send_response(
-                    ws, req_id, ok=True,
-                    payload={"models": remote_ids, "source": "remote"},
-                )
-                return
-
-            # 远端失败/空 -> 回退预设。把远端状态码/原因透传给前端,联调时能
-            # 分辨是鉴权失败(key 错 / 需厂商专属签名)、限流、还是端点不可达,
