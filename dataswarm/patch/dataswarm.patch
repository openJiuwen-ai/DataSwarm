@@ -0,0 +1,131 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 看板筛选栏：时间范围 + 维度筛选。受控组件，filters/onChange 来自父级。 */
+
+import { useState } from 'react';
+import type { DimensionDef, DashboardFilters } from '../types/dashboard';
+
+interface DashboardFilterBarProps {
+  dimensions: DimensionDef[];
+  filters: DashboardFilters;
+  onChange: (filters: DashboardFilters) => void;
+}
+
+type Preset = '7d' | '30d' | '90d' | 'custom';
+
+function _fmt(d: Date): string {
+  const y = d.getFullYear();
+  const m = String(d.getMonth() + 1).padStart(2, '0');
+  const day = String(d.getDate()).padStart(2, '0');
+  return `${y}-${m}-${day}`;
+}
+
+function _presetRange(preset: Preset): { start: string; end: string } {
+  const end = new Date();
+  const start = new Date();
+  if (preset === '7d') start.setDate(end.getDate() - 6);
+  else if (preset === '30d') start.setDate(end.getDate() - 29);
+  else if (preset === '90d') start.setDate(end.getDate() - 89);
+  return { start: _fmt(start), end: _fmt(end) };
+}
+
+export function DashboardFilterBar({ dimensions, filters, onChange }: DashboardFilterBarProps) {
+  const tr = filters.time_range || { start: '', end: '' };
+  // 当前选中预设：若 start/end 匹配某预设则高亮，否则 custom
+  const matchPreset: Preset = (() => {
+    for (const p of ['7d', '30d', '90d'] as Preset[]) {
+      const r = _presetRange(p);
+      if (r.start === tr.start && r.end === tr.end) return p;
+    }
+    return 'custom';
+  })();
+
+  const [showCustom, setShowCustom] = useState(false);
+  const [draftStart, setDraftStart] = useState(tr.start);
+  const [draftEnd, setDraftEnd] = useState(tr.end);
+
+  const applyCustom = () => {
+    onChange({ ...filters, time_range: { start: draftStart, end: draftEnd } });
+    setShowCustom(false);
+  };
+
+  const draftInvalid = draftStart && draftEnd && draftStart > draftEnd;
+
+  return (
+    <div className="mb-4 flex flex-wrap items-center gap-3 rounded-lg border border-border bg-panel p-3">
+      {/* 时间范围 */}
+      <div className="flex items-center gap-1 text-xs">
+        <span className="text-text-muted">时间:</span>
+        {(['7d', '30d', '90d'] as const).map((range) => (
+          <button
+            key={range}
+            className={`rounded px-2 py-1 ${matchPreset === range ? 'bg-accent-subtle text-text-link' : 'text-text-muted hover:bg-secondary'}`}
+            onClick={() => onChange({ ...filters, time_range: _presetRange(range) })}
+          >
+            {range === '7d' ? '7天' : range === '30d' ? '30天' : '90天'}
+          </button>
+        ))}
+        <button
+          className={`rounded px-2 py-1 ${matchPreset === 'custom' ? 'bg-accent-subtle text-text-link' : 'text-text-muted hover:bg-secondary'}`}
+          onClick={() => {
+            setDraftStart(tr.start);
+            setDraftEnd(tr.end);
+            setShowCustom(!showCustom);
+          }}
+        >
+          自定义
+        </button>
+      </div>
+
+      {/* 自定义日期 picker */}
+      {showCustom && (
+        <div className="flex items-center gap-2 text-xs">
+          <input
+            type="date"
+            value={draftStart}
+            onChange={(e) => setDraftStart(e.target.value)}
+            className={`rounded border bg-bg px-2 py-1 text-text ${draftInvalid ? 'border-danger' : 'border-border'}`}
+          />
+          <span className="text-text-muted">至</span>
+          <input
+            type="date"
+            value={draftEnd}
+            onChange={(e) => setDraftEnd(e.target.value)}
+            className={`rounded border bg-bg px-2 py-1 text-text ${draftInvalid ? 'border-danger' : 'border-border'}`}
+          />
+          <button
+            className="rounded border border-accent bg-accent-subtle px-2 py-1 text-text-link disabled:opacity-50 disabled:cursor-not-allowed"
+            onClick={applyCustom}
+            disabled={!draftStart || !draftEnd || !!draftInvalid}
+          >
+            应用
+          </button>
+          {draftInvalid && <span className="text-danger">起始日期不能晚于结束日期</span>}
+        </div>
+      )}
+
+      {/* 当前选中的范围 */}
+      {tr.start && tr.end && (
+        <span className="text-xs text-text-muted">{tr.start} ~ {tr.end}</span>
+      )}
+
+      {/* 维度筛选（本期仅 UI，后端不应用） */}
+      {dimensions.length > 0 && (
+        <div className="flex flex-wrap items-center gap-2 text-xs">
+          <span className="text-text-muted">维度:</span>
+          {dimensions.slice(0, 4).map((dim) => (
+            <select
+              key={dim.dimension_id}
+              className="rounded border border-border bg-bg px-2 py-1 text-xs text-text"
+              defaultValue=""
+            >
+              <option value="">{dim.label || dim.name}</option>
+              {dim.value_list?.map((v, i) => (
+                <option key={i} value={v}>{v}</option>
+              ))}
+            </select>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
