+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_paths helper 单测：env 优先级 / 回退默认 / 派生目录。
+
+覆盖 DataSwarm 运行时隔离方案（2026-10-31 起）的核心契约：
+``workspace_root()`` 走 ``JIUWENSWARM_DATA_DIR`` 优先，无 env 回退
+``~/.dataswarm``（dataswarm* 入口总会注入该 env；无 env 裸调按 release
+形态的默认根落地）。
+"""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_DW_PATHS = (Path(__file__).resolve().parents[3]
+             / "jiuwenswarm" / "resources" / "agent" / "workspace" / "skills"
+             / "_dw_common" / "scripts" / "dw_paths.py")
+
+
+@pytest.fixture(scope="module")
+def dw_paths():
+    spec = importlib.util.spec_from_file_location("dw_paths", _DW_PATHS)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def test_workspace_root_env_priority(dw_paths, monkeypatch, tmp_path):
+    """JIUWENSWARM_DATA_DIR 设置时直接生效（expanduser 展开 ~）。"""
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path / "ws"))
+    assert dw_paths.workspace_root() == tmp_path / "ws"
+
+
+def test_workspace_root_env_expands_home(dw_paths, monkeypatch):
+    """env 值里的 ~ 展开为用户 home。"""
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", "~/.dataswarm")
+    assert dw_paths.workspace_root() == Path.home() / ".dataswarm"
+
+
+def test_workspace_root_fallback(dw_paths, monkeypatch):
+    """未设 env 时回退 ~/.dataswarm（release 形态的裸跑默认）。"""
+    monkeypatch.delenv("JIUWENSWARM_DATA_DIR", raising=False)
+    assert dw_paths.workspace_root() == Path.home() / ".dataswarm"
+
+
+def test_derived_roots(dw_paths, monkeypatch, tmp_path):
+    """config/artifact/agent 派生目录与 llm 配置路径拼接正确。"""
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path / "ws"))
+    assert dw_paths.config_root() == tmp_path / "ws" / "config"
+    assert dw_paths.artifact_root() == tmp_path / "ws" / "artifact"
+    assert dw_paths.agent_root() == tmp_path / "ws" / "agent"
+    assert dw_paths.llm_config_path() == tmp_path / "ws" / "config" / "config.yaml"
