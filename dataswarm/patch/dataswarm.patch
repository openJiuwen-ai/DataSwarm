@@ -0,0 +1,116 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/projection.py —— 指标口径的确定性纯函数（展示/检索用）。
+
+深集成后 Neo4j 投影主体在 :mod:`.graph_projection`（Metric 节点 + 跨
+namespace 边），本模块只剩**与图存储无关的纯函数**：
+
+- :func:`slugify`：IRI/ID 安全的稳定 slug 化（中文转 ``u<hex>``）
+- :func:`formula_summary`：公式**摘要**（脱敏红线：绝无表达式原文）
+- :func:`build_field_labels`：逻辑字段名 → 业务名映射（摘要可读性用）
+
+旧 pyoxigraph 投影体系（GraphPayload/命名图/跨图 link 边）已随验证版退役。
+"""
+from __future__ import annotations
+
+import re
+import unicodedata
+from typing import Any, Iterable
+
+from .model import (
+    Binding,
+    MetricRevision,
+    METRIC_TYPE_ATOMIC,
+    METRIC_TYPE_RATIO,
+)
+
+# IRI/ID 允许的字符集：中文名一律 slug 化后进 ID，原文放属性
+_IRI_ALLOWED_RE = re.compile(r"[^A-Za-z0-9:_./-]")
+
+# 算子 → 摘要用的人类可读标签
+_OPERATOR_LABELS = {
+    "sum": "SUM",
+    "count": "COUNT",
+    "count_distinct": "COUNT DISTINCT",
+    "avg": "AVG",
+    "min": "MIN",
+    "max": "MAX",
+    "divide": "比值",
+}
+
+
+def slugify(text: str, *, max_len: int = 80) -> str:
+    """把任意文本转成 IRI 安全的 slug。
+
+    中文等非 ASCII 字符经 NFKD 规范化后仍不在允许集内，转为 ``u<hex>`` 形式，
+    保证**可逆映射稳定**（同一中文名每次得到同一 slug），同时不丢唯一性。
+
+    Args:
+        text: 原始文本，如 ``commerce.支付客单价``。
+        max_len: slug 长度上限。
+
+    Returns:
+        只含 ``[A-Za-z0-9:_./-]`` 的字符串；空输入返回 ``"_"``。
+    """
+    if not text:
+        return "_"
+    normalized = unicodedata.normalize("NFKD", str(text))
+    out: list[str] = []
+    for char in normalized:
+        if _IRI_ALLOWED_RE.match(char):
+            # 非允许字符：转成 u+四位十六进制，避免不同中文名撞成同一个 '-'
+            out.append(f"u{ord(char):04x}")
+        else:
+            out.append(char)
+    slug = "".join(out)
+    slug = re.sub(r"\.{2,}", ".", slug).strip(".")
+    return (slug[:max_len] or "_")
+
+
+def formula_summary(rev: MetricRevision, *, field_labels: dict[str, str] | None = None) -> str:
+    """生成**公式摘要**（展示与检索用），不是可执行定义。
+
+    Args:
+        rev: 指标修订。
+        field_labels: 逻辑字段名 → 业务名，用于把 ``orders.amount_cny`` 显示成
+            ``订单金额``。缺失时退回字段名本身。
+
+    Returns:
+        摘要字符串，如 ``SUM(订单金额)`` / ``比值(commerce.gmv, commerce.paid_order_count)``。
+    """
+    labels = field_labels or {}
+    parsed = rev.expression.parsed
+    if parsed is None:
+        # 未解析：只说清「有表达式但未解析」，绝不把原文写进摘要
+        return "（表达式未解析，口径以 DataSwarm 定义为准）"
+    if rev.metric_type == METRIC_TYPE_RATIO and rev.dependencies:
+        return "比值(" + ", ".join(rev.dependencies) + ")"
+    if rev.metric_type != METRIC_TYPE_ATOMIC and rev.dependencies:
+        return "派生自(" + ", ".join(rev.dependencies) + ")"
+    label = _OPERATOR_LABELS.get(parsed.operator, parsed.operator.upper() or "表达式")
+    # 只展示被聚合的字段，过滤掉仅出现在过滤条件里的列，避免摘要过长
+    shown = [labels.get(f, f) for f in parsed.fields[:3]]
+    return f"{label}({', '.join(shown)})" if shown else label
+
+
+def build_field_labels(
+    revisions: Iterable[MetricRevision],
+    bindings: Iterable[Binding],
+    *,
+    ossie_models: dict[str, Any] | None = None,
+) -> dict[str, str]:
+    """汇总逻辑字段名 → 业务名。
+
+    业务名优先取 Ossie 字段的 ``label``/``description``，缺失时退回字段名。
+    ``ossie_models`` 为 ``metric_key -> OssieModel``，可选。
+    """
+    labels: dict[str, str] = {}
+    for binding in bindings:
+        for logical, physical in binding.column_map.items():
+            labels.setdefault(logical, physical)
+    for model in (ossie_models or {}).values():
+        for dataset in getattr(model, "datasets", ()):
+            for f in getattr(dataset, "fields", ()):
+                display = getattr(f, "label", "") or getattr(f, "description", "")
+                if display:
+                    labels[f"{dataset.name}.{f.name}"] = display
+    return labels
