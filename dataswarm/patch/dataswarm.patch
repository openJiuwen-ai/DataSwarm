+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""_fork_lib.py —— 归档工具公共库：git 对象层 / 归档分类 / patch 原语 / 配置解析。
+
+模型（共源 + 归档，V4 口径：patch 自足还原）：
+- develop_oss = 基线 tag + DataSwarm delta 全树；历史根 = 浅基线快照 commit（深度 1，
+  不携带基线仓历史），`git diff <根>..develop_oss` 即全部 delta
+- MR（成员 mr-fork 上）= archive_delta.py 生成的归档（脚本单点写入，永不手改）：
+    dataswarm/patch/dataswarm.patch   **基于基线 tag 的全部内容差异**（零排除）——
+                                      外部拿到后 `clone 基线 tag + apply patch` 一步还原
+    dataswarm/skills/<rest>           skill 改动/新增（文件形态，可浏览展示层）
+    sync 清单路径                      白名单工程资产整树放置（展示层；与 patch 重复
+                                      表达，覆盖亦无妨）
+  还原元信息（anchor / 基线 repo / 基线 tag）全部在归档 **commit message 的 trailer**，
+  MR 分支不设 manifest 目录或附属清单文件
+  还原不变量（强断言）：**基线 tag + git apply patch == develop_oss@anchor 全树**
+  （tests 全部在 patch 内，MR 分支不设 tests 展示目录）
+
+回位规则（仅展示层浏览时参考；还原流程不需要——patch 已含全部差异）：
+    dataswarm/skills/<rest>       ↔ jiuwenswarm/resources/agent/workspace/skills/<rest>
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+_ENV_REPO = os.environ.get("DATASWARM_FORK_REPO", "").strip()  # 测试用：指向沙箱仓库
+REPO_ROOT = Path(_ENV_REPO).resolve() if _ENV_REPO else Path(__file__).resolve().parents[3]
+FORK_DIR = REPO_ROOT / "scripts" / "dataswarm" / "fork"
+FORK_CONFIG = FORK_DIR / "fork_config.yaml"
+
+# ----------------------------------------------------------- 归档路径口径（唯一规则）
+SKILLS_DEV_DIR = "jiuwenswarm/resources/agent/workspace/skills"
+# 同步清单（develop_oss 上维护；随 scripts/dataswarm/ 自身条目同步到 MR 分支，消费端可读）
+SYNC_MANIFEST_PATH = "scripts/dataswarm/sync_manifest.yaml"
+
+ARCHIVE_ROOT = "dataswarm"
+PATCH_FILE = "dataswarm/patch/dataswarm.patch"
+SKILLS_ARCHIVE_DIR = "dataswarm/skills"
+ARCHIVE_TRAILER = "Archive-from"
+# 归档 commit message trailer（还原元信息唯一载体，MR 分支不设附属清单文件）
+BASELINE_REPO_TRAILER = "Baseline-Repo"
+BASELINE_TAG_TRAILER = "Baseline-Tag"
+
+# 归档分类：patch = 全量差异（零排除）；sync/skills = 展示层（文件形态放置）
+KIND_PATCH = "patch"
+KIND_SYNC = "sync"
+KIND_SKILLS = "skills"
+COPY_KINDS = (KIND_SYNC, KIND_SKILLS)
+
+# stdout 与 stderr 分别判定（Windows 下两者编码可能不同：管道/控制台差异会使
+# 一方 utf-8 另一方 locale——只判 stdout 会漏 reconfigure stderr，traceback 乱码）
+for _stream in (sys.stdout, sys.stderr):
+    if _stream.encoding and _stream.encoding.lower() not in ("utf-8", "utf8"):
+        _stream.reconfigure(encoding="utf-8")
+
+
+class ForkError(RuntimeError):
+    """归档工具失败。"""
+
+
+def git(*args: str, env: dict | None = None, check: bool = True,
+        input: bytes | None = None) -> subprocess.CompletedProcess:
+    proc = subprocess.run(["git", *args], cwd=REPO_ROOT, capture_output=True, env=env, input=input)
+    if check and proc.returncode != 0:
+        raise ForkError(f"git {' '.join(args)}\n{proc.stderr.decode('utf-8', errors='replace').strip()}")
+    return proc
+
+
+def rev(ref: str) -> str | None:
+    """解析为完整 sha；引用不存在返回 None。"""
+    proc = git("rev-parse", "--verify", "--quiet", ref, check=False)
+    if proc.returncode != 0:
+        return None
+    return proc.stdout.decode().strip()
+
+
+def is_ancestor(ancestor: str, descendant: str) -> bool:
+    return git("merge-base", "--is-ancestor", ancestor, descendant, check=False).returncode == 0
+
+
+# ---------------------------------------------------------------- 配置
+
+def parse_yaml_subset(text: str) -> dict:
+    """解析 fork_config / sync_manifest 的极简 YAML 子集（顶层 section：dict 或 list）。"""
+    data: dict = {}
+    section: str | None = None
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        if not line[0].isspace():
+            section = stripped.split(":", 1)[0].strip()
+            data.setdefault(section, {})
+            continue
+        if section is None:
+            continue
+        if stripped.startswith("- "):
+            if not isinstance(data[section], list):
+                data[section] = []  # 首见列表项——顶层 `key:` 无法预知类型，此处切换为 list
+            data[section].append(stripped[2:].strip())
+            continue
+        if isinstance(data[section], dict) and ":" in stripped:
+            key, _, value = stripped.partition(":")
+            # 剥离行内注释（空格+# 起；URL/SHA 等值内连续 # 不受影响）
+            data[section][key.strip()] = re.split(r"\s#", value.strip())[0].strip()
+    return data
+
+
+def load_config(path: str | Path | None = None) -> dict:
+    cfg_path = Path(path) if path else FORK_CONFIG
+    if not cfg_path.is_file():
+        raise ForkError(f"fork 配置不存在: {cfg_path}")
+    data = parse_yaml_subset(cfg_path.read_text(encoding="utf-8"))
+    for section in ("dev_hub", "mr_hub", "archive", "baseline"):
+        if not isinstance(data.get(section), dict):
+            raise ForkError(f"fork 配置缺 {section} 段: {cfg_path}")
+    if not data["baseline"].get("repo") or not data["baseline"].get("ref"):
+        raise ForkError(f"fork 配置缺 baseline.repo/ref: {cfg_path}")
+    if not data["mr_hub"].get("repo") or not data["mr_hub"].get("branch"):
+        raise ForkError(f"fork 配置缺 mr_hub.repo/branch: {cfg_path}")
+    return data
+
+
+def dev_hub_branch(cfg: dict) -> str:
+    return str(cfg["dev_hub"].get("branch") or "develop_oss")
+
+
+def mr_hub_branch(cfg: dict) -> str:
+    return str(cfg["mr_hub"].get("branch") or "develop")
+
+
+def archive_branch(cfg: dict) -> str:
+    return str(cfg["archive"].get("branch") or "MR")
+
+
+def skill_test_dirs(cfg: dict) -> list[str]:
+    dirs = cfg.get("skill_test_dirs")
+    return list(dirs) if isinstance(dirs, list) else []
+
+
+def load_sync_manifest(ref: str = "HEAD") -> dict[str, str]:
+    """读取同步清单（缺省工作区/HEAD；校验用）。
+
+    Returns:
+        {dev 路径: MR 分支路径}（升序，键唯一）
+
+    Raises:
+        ForkError: 清单缺失/不含 sync 段/路径互相重叠（前缀包含）/ref 树中不存在。
+    """
+    proc = git("show", f"{ref}:{SYNC_MANIFEST_PATH}", check=False)
+    if proc.returncode != 0:
+        raise ForkError(f"同步清单不存在（{SYNC_MANIFEST_PATH}，ref={ref}）——归档口径必填")
+    data = parse_yaml_subset(proc.stdout.decode("utf-8"))
+    sync = data.get("sync")
+    if not isinstance(sync, dict) or not sync:
+        raise ForkError(f"同步清单缺 sync 段: {SYNC_MANIFEST_PATH}")
+    paths = sorted(sync)
+    for a, b in zip(paths, paths[1:]):
+        if b == a or b.startswith(a + "/"):
+            raise ForkError(f"同步清单路径重叠（前者包含后者）: {a} ⊇ {b}")
+    for dev_path in paths:
+        if git("cat-file", "-e", f"{ref}:{dev_path}", check=False).returncode != 0:
+            raise ForkError(f"同步清单路径在 {ref} 树中不存在: {dev_path}")
+    return {p: str(sync[p]) for p in paths}
+
+
+def ensure_baseline_tag(tag: str) -> None:
+    """基线 tag 对象不在本地时浅 fetch（develop_oss 根即浅基线快照，此 fetch 仅兜底/基线升级用）。"""
+    ref = f"refs/tags/{tag}"
+    if rev(f"{ref}^{{commit}}") is not None:
+        return
+    cfg = load_config()
+    src = "baseline" if git("remote", "get-url", "baseline", check=False).returncode == 0 else cfg["baseline"]["repo"]
+    print(f"[*] 浅 fetch 基线 tag {tag}（源: {src}）...")
+    git("fetch", "--depth=1", "--no-tags", src, f"+{ref}:{ref}")
+
+
+# ---------------------------------------------------------------- 归档分类与路径映射
+
+def classify_dev_path(path: str, cfg: dict, sync_manifest: dict[str, str] | None = None) -> str:
+    """dev 全树路径 → 归档分类（KIND_*；仅用于展示层放置与统计——patch 恒含全部差异）。
+
+    判定顺序：sync 清单 → skills → patch（其余一切，含全部测试）。
+    """
+    if sync_manifest:
+        for dev_path in sync_manifest:
+            if path == dev_path or path.startswith(dev_path + "/"):
+                return KIND_SYNC
+    if path == SKILLS_DEV_DIR or path.startswith(SKILLS_DEV_DIR + "/"):
+        return KIND_SKILLS
+    return KIND_PATCH
+
+
+def to_archive_path(kind: str, dev_path: str, sync_manifest: dict[str, str] | None = None) -> str:
+    """dev 路径 → 归档分支路径（展示层；KIND_PATCH 走 diff 不经此函数）。"""
+    if kind == KIND_SYNC:
+        if not sync_manifest:
+            raise ForkError(f"KIND_SYNC 分类缺少 sync 清单: {dev_path}")
+        for dev_root, mr_root in sync_manifest.items():
+            if dev_path == dev_root:
+                return mr_root
+            if dev_path.startswith(dev_root + "/"):
+                return f"{mr_root}/{dev_path[len(dev_root) + 1:]}"
+        raise ForkError(f"sync 清单无法映射: {dev_path}")
+    if kind == KIND_SKILLS:
+        rest = dev_path[len(SKILLS_DEV_DIR) + 1:]
+        return f"{SKILLS_ARCHIVE_DIR}/{rest}"
+    raise ForkError(f"非复制类路径不走归档映射: {kind} {dev_path}")
+
+
+def to_dev_path_from_archive(archive_path: str) -> str:
+    """归档分支路径 → dev 全树路径（展示层回位参考；patch/生成物路径原样返回，由调用方过滤）。"""
+    if archive_path.startswith(f"{SKILLS_ARCHIVE_DIR}/"):
+        rest = archive_path[len(SKILLS_ARCHIVE_DIR) + 1:]
+        return f"{SKILLS_DEV_DIR}/{rest}"
+    return archive_path
+
+
+# ---------------------------------------------------------------- 树差异与归档集合
+
+def changed_entries(baseline_tag: str, anchor_ref: str) -> list[tuple[str, str, str, str]]:
+    """`git diff --raw -z --no-renames <tag>..<anchor>` -> [(status, path, new_mode, new_sha)]。
+
+    -z 格式：`:oldmode newmode oldsha newsha status` NUL `path` NUL（rename 已禁用，R/C 不出现）。
+    """
+    out = git("diff", "--raw", "--no-abbrev", "-z", "--no-renames", f"{baseline_tag}..{anchor_ref}").stdout
+    chunks = out.split(b"\0")
+    entries: list[tuple[str, str, str, str]] = []
+    i = 0
+    while i + 1 < len(chunks):
+        header = chunks[i].decode("utf-8", "replace")
+        path = chunks[i + 1].decode("utf-8", "replace")
+        if not header.startswith(":"):
+            i += 1
+            continue
+        parts = header[1:].split(" ")
+        if len(parts) < 5:
+            raise ForkError(f"无法解析 diff 条目: {header!r}")
+        _old_mode, new_mode, _old_sha, new_sha, status = parts[:5]
+        entries.append((status[:1], path, new_mode, new_sha))
+        i += 2
+    return entries
+
+
+def gen_patch_bytes(baseline_tag: str, anchor_ref: str) -> bytes:
+    """生成 git patch：基于基线 tag 的**全部内容差异**（零排除，含二进制）。
+
+    自足还原语义：`clone 基线 tag + git apply 本 patch` == develop_oss@anchor 全树。
+    MR 分支上的 skills/tests/sync 外观层文件与 patch 重复表达，覆盖亦无妨。
+    """
+    return git("diff", "--no-renames", "--binary", f"{baseline_tag}..{anchor_ref}").stdout
+
+
+def build_archive_set(baseline_tag: str, anchor_ref: str, cfg: dict, sync_manifest: dict[str, str]
+                      ) -> tuple[dict[str, tuple[str, str]], dict, dict[str, tuple[str, str]]]:
+    """构造外观层集合（patch 由 gen_patch_bytes 独立生成，恒含全部差异）。
+
+    Returns:
+        copy_files: {归档路径: (mode, blob_sha)}——skills 的改动/新增（展示层）
+        counts: {"skills": {A,M,D}, "sync": files, "patch": {A,M,D}, "total": {A,M,D}}
+        sync_files: {MR 分支路径: (mode, blob_sha)}——sync 白名单在 anchor 树的全量文件
+    """
+    entries = changed_entries(baseline_tag, anchor_ref)
+    copy_files: dict[str, tuple[str, str]] = {}
+    counts: dict = {"patch": {"A": 0, "M": 0, "D": 0},
+                    "skills": {"A": 0, "M": 0, "D": 0},
+                    "total": {"A": 0, "M": 0, "D": 0}}
+    for status, path, mode, sha in entries:
+        counts["total"][status] = counts["total"].get(status, 0) + 1
+        kind = classify_dev_path(path, cfg, sync_manifest)
+        if kind == KIND_SKILLS:
+            counts[kind][status] = counts[kind].get(status, 0) + 1
+            if status != "D":
+                copy_files[to_archive_path(kind, path, sync_manifest)] = (mode, sha)
+        # sync 类统计由整树给出（不走 changed 条目）；patch 含一切（含 sync/skills 的 diff）
+
+    # sync 展示层按清单全量放置（清单写了什么就同步什么，不做基线差异过滤；
+    # 与 patch 重复表达，覆盖亦无妨——还原单走 patch，不依赖展示层）
+    sync_files: dict[str, tuple[str, str]] = {}
+    for dev_path, mr_path in sync_manifest.items():
+        for p, (mode, sha) in list_tree(anchor_ref, dev_path).items():
+            rel = p[len(dev_path):].lstrip("/")
+            archive_path = f"{mr_path}/{rel}" if rel else mr_path
+            sync_files[archive_path] = (mode, sha)
+    counts["sync"] = len(sync_files)
+    return copy_files, counts, sync_files
+
+
+def tree_file_entry(ref: str, path: str) -> tuple[str, str] | None:
+    """取 ref 树中单个文件的 (mode, blob sha)；文件不存在返回 None。"""
+    out = git("ls-tree", ref, "--", path).stdout.decode("utf-8", "replace").strip()
+    if not out:
+        return None
+    meta, _path = out.split("\t", 1)
+    mode, _typ, sha = meta.split(" ")
+    return mode, sha
+
+
+def list_tree(ref: str, path: str | None = None) -> dict[str, tuple[str, str]]:
+    """{path: (mode, blob)}（关闭 quotePath，兼容中文路径；忽略 gitlink）。
+
+    path 非空时只列该路径（目录=整树，文件=单条目）。
+    """
+    args = ["-c", "core.quotePath=false", "ls-tree", "-r", "-z", ref]
+    if path is not None:
+        args += ["--", path]
+    out = git(*args).stdout
+    entries: dict[str, tuple[str, str]] = {}
+    for raw in out.split(b"\0"):
+        if not raw:
+            continue
+        meta, _, p = raw.partition(b"\t")
+        mode, typ, sha = meta.decode().split(" ")
+        if typ != "blob":
+            continue
+        entries[p.decode("utf-8")] = (mode, sha)
+    return entries
+
+
+def hash_blob(content: bytes) -> str:
+    """写入 blob 并返回 sha。"""
+    return git("hash-object", "-w", "--stdin", input=content).stdout.decode().strip()
+
+
+def write_tree(files: dict[str, tuple[str, str]]) -> str:
+    """临时 index 构造树（对象层，不落工作区）。"""
+    with tempfile.TemporaryDirectory(prefix="dataswarm-archive-") as tmp:
+        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "archive.index")}
+        git("read-tree", "--empty", env=env)
+        if files:
+            lines = [f"{mode} {sha}\t{path}".encode("utf-8") for path, (mode, sha) in sorted(files.items())]
+            git("update-index", "--index-info", env=env, input=b"\n".join(lines) + b"\n")
+        return git("write-tree", env=env).stdout.decode().strip()
+
+
+def apply_patch_tree(baseline_tag: str, patch_bytes: bytes) -> str:
+    """对象层真实回放（归档内建自检与 verify 共用）：基线树 + git apply --cached == anchor 全树。
+
+    全程临时 index，不经文件系统（Windows/Linux 零差异）；patch 文本的可应用性、
+    binary/eol 编码在此实打实验证。空 patch 直接返回基线树。
+    """
+    with tempfile.TemporaryDirectory(prefix="dataswarm-verify-") as tmp:
+        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "compose.index")}
+        git("read-tree", f"{baseline_tag}^{{tree}}", env=env)
+        if patch_bytes.strip():
+            patch_path = Path(tmp) / "dataswarm.patch"
+            patch_path.write_bytes(patch_bytes)
+            proc = git("-c", "core.autocrlf=false", "apply", "--cached", str(patch_path),
+                       env=env, check=False)
+            if proc.returncode != 0:
+                raise ForkError(
+                    f"patch 无法应用于基线 {baseline_tag}（基线漂移或生成缺陷）:\n"
+                    + proc.stderr.decode("utf-8", errors="replace").strip())
+        return git("write-tree", env=env).stdout.decode().strip()
+
+
+def tree_diff_paths(tree_a: str, tree_b: str) -> list[str]:
+    """两个树对象之间的路径差异（关闭 quotePath，兼容中文路径）。"""
+    out = git("-c", "core.quotePath=false", "diff", "--name-only", "--no-renames",
+              tree_a, tree_b).stdout
+    return [p.decode("utf-8") for p in out.split(b"\n") if p]
+
+
+# ---------------------------------------------------------------- 生成物（commit message trailer）
+
+ARCHIVE_TITLE_PREFIX = "chore(archive): "
+ARCHIVE_TITLE_MAX = 100  # 标题总长上限（中文按字符计），超出截断加 …
+
+# GitCode `!116 merge ...` / git `Merge branch ...` 等合并提交，对 MR 读者零信息
+_MERGE_SUBJECT_RE = re.compile(r"^(!\d+\s+)?merge\b", re.IGNORECASE)
+# Conventional Commits 前缀（`docs(rules): `）——标题已带 chore(archive)，不再嵌套 type
+_CONV_PREFIX_RE = re.compile(r"^[A-Za-z]+(\([^)]*\))?!?:\s+")
+
+
+def _oneline_subject(line: str) -> str:
+    """`git log --oneline` 行 → subject（去掉短 sha 前缀）。"""
+    _, _, subject = line.partition(" ")
+    return subject.strip()
+
+
+def _plain_subject(subject: str) -> str:
+    """去掉 Conventional Commits 前缀；剥空则保留原文。"""
+    return _CONV_PREFIX_RE.sub("", subject, count=1) or subject
+
+
+def _is_merge_commit(line: str) -> bool:
+    """是否 merge 类提交（subject 以 `!NN merge` / `merge` 开头）。"""
+    return bool(_MERGE_SUBJECT_RE.match(_oneline_subject(line)))
+
+
+def _delivered_commits(dev_commits: list[str] | None) -> list[str]:
+    """本次交付的有效提交（过滤 merge 类），保留原始行（含短 sha）供正文引用。"""
+    return [c.strip() for c in (dev_commits or []) if c.strip() and not _is_merge_commit(c)]
+
+
+def _archive_title(anchor_sha: str, delivered: list[str]) -> str:
+    """标题即交付摘要：取非 merge 提交的 subject；无有效提交才回落为锚点说明。
+
+    1 条 → 原样；2 条 → 「A；B」；多条 → 「A；B 等 N 项」；超长截断。
+    """
+    subjects = [_plain_subject(_oneline_subject(c)) for c in delivered]
+    if not subjects:
+        return f"{ARCHIVE_TITLE_PREFIX}归档 develop_oss@{anchor_sha[:12]}"
+    if len(subjects) <= 2:
+        summary = "；".join(subjects)
+    else:
+        summary = f"{subjects[0]}；{subjects[1]} 等 {len(subjects)} 项"
+    budget = ARCHIVE_TITLE_MAX - len(ARCHIVE_TITLE_PREFIX)
+    if len(summary) > budget:
+        summary = summary[:budget - 1] + "…"
+    return ARCHIVE_TITLE_PREFIX + summary
+
+
+def archive_commit_message(anchor_sha: str, cfg: dict, counts: dict,
+                           dev_commits: list[str] | None = None) -> str:
+    """归档提交信息：可读交付摘要 + 还原元信息 trailer（MR 分支唯一元信息载体）。
+
+    标题是本次交付内容的摘要（merge 类提交不计入）；anchor / 基线 / 统计留在正文。
+
+    trailer：
+        Archive-from:   锚点 commit（溯源/漂移检测）
+        Baseline-Repo:  基线仓 URL（还原用）
+        Baseline-Tag:   基线 tag（还原用）
+    """
+    tc = counts["total"]
+    delivered = _delivered_commits(dev_commits)
+    skipped = len(dev_commits or []) - len(delivered)
+    lines = [
+        _archive_title(anchor_sha, delivered),
+        "",
+        f"anchor: {anchor_sha}",
+        f"baseline: {cfg['baseline']['ref']}",
+        f"patch: A={tc['A']} M={tc['M']} D={tc['D']}（全量差异，clone 基线 tag + apply 即还原）",
+        f"展示层: skills={sum(counts['skills'].values())} | sync={counts['sync']}",
+        "",
+        "还原：git clone <Baseline-Repo> && git checkout <Baseline-Tag> && "
+        "git apply dataswarm/patch/dataswarm.patch",
+    ]
+    if delivered:
+        shown = delivered[:15]
+        skip_n = f"，已略过 merge {skipped} 个" if skipped else ""
+        lines += ["", f"本次交付（develop_oss 提交 {len(delivered)} 个{skip_n}）:"]
+        lines += [f"- {c[:80]}" for c in shown]
+        hidden = len(delivered) - len(shown)
+        if hidden > 0:
+            lines.append(f"… 另有 {hidden} 个提交未列出")
+    lines += ["",
+              f"{ARCHIVE_TRAILER}: {anchor_sha}",
+              f"{BASELINE_REPO_TRAILER}: {cfg['baseline']['repo']}",
+              f"{BASELINE_TAG_TRAILER}: {cfg['baseline']['ref']}"]
+    return "\n".join(lines) + "\n"
+
+
+def commit_message(ref: str) -> str:
+    """读取提交完整 message（标题 + 正文 + trailer）。"""
+    return git("log", "-1", "--format=%B", ref).stdout.decode("utf-8", "replace")
+
+
+def parse_archive_trailers(ref: str) -> dict[str, str]:
+    """读取归档 commit 的还原元信息 trailer。
+
+    Returns:
+        {"archive-from": ..., "baseline-repo": ..., "baseline-tag": ...}（存在的键）
+    """
+    msg = commit_message(ref)
+    out: dict[str, str] = {}
+    for line in msg.splitlines():
+        if ":" not in line:
+            continue
+        key, _, value = line.partition(":")
+        key = key.strip().lower()
+        if key in (ARCHIVE_TRAILER.lower(), BASELINE_REPO_TRAILER.lower(), BASELINE_TAG_TRAILER.lower()):
+            out[key] = value.strip()
+    return out
+
+
+def last_archive_from(commit: str) -> str | None:
+    """读取提交 trailer Archive-from（无则 None）。"""
+    return parse_archive_trailers(commit).get(ARCHIVE_TRAILER.lower())
