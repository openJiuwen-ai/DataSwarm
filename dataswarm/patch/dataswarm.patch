+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * StructChangePanel — 对话右侧面板的结构变更事件视图。
+ *
+ * 两区布局（docs/archive/delivered/chat-struct-change-push-plan.md §6.4）：
+ *   上：事件清单（倒序，点击选中）
+ *   下：详情视图
+ *     - workflow_run → WorkflowPreview iframe（/workflow-runs/<instance_id> 独立页，
+ *       自带 2s 轮询 + 节点运行态染色，本面板零轮询逻辑）
+ *     - table_change → 整库血缘图 + 新表高亮（复用 LineageFlowGraph，selected=新表）
+ *
+ * 数据来自 structChangeStore（实时 WS + 历史恢复两条链路合并，见 store 头注释）。
+ */
+
+import { useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Database, Workflow } from 'lucide-react';
+import { useStructChangeStore } from '../../stores/structChangeStore';
+import type { StructChangeEvent } from '../../stores/structChangeStore';
+import { WorkflowPreview } from '../../features/workflowPreview/WorkflowPreview';
+import { workflowRunEmbedPath } from '../../multi-session/routing/route';
+import { metadataApi } from '../../features/data-management/api/metadataApi';
+import { LineageGraph } from '../../features/_shared/lineage/LineageGraph';
+import { WorkflowGraph } from '../../features/_shared/workflow/WorkflowGraph';
+import { toWorkflowGraphNodes } from '../../features/dataAsset/components/shared/workflowGraphAdapter';
+import { orchestrationApi } from '../../features/dataAsset/api/orchestrationApi';
+import type { NodeInput, TaskDefinition, WorkflowDefinition } from '../../features/dataAsset/types/orchestration';
+import type { Layer, LineageArtifact, TableDetail } from '../../features/data-management/types/metadata';
+import './index.css';
+
+const ALL_LAYERS: Layer[] = ['ODS', 'DWD', 'DWS', 'ADS', 'OTHER'];
+const DEFAULT_LAYERS: Set<Layer> = new Set(ALL_LAYERS);
+
+function formatEventTime(ts: string): string {
+  if (!ts) return '';
+  const ms = Date.parse(ts);
+  if (!Number.isFinite(ms)) return '';
+  return new Date(ms).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
+}
+
+/** 事件清单行：图标 + 标题 + 右侧状态徽章/操作标签 + 时间（ToolPanel 收起态折叠区块复用） */
+export function EventRow({
+  event,
+  selected,
+  onSelect,
+  index = 0,
+}: {
+  event: StructChangeEvent;
+  selected: boolean;
+  onSelect: () => void;
+  /** 列表位次：驱动入场动画 stagger（收起态折叠区块传 -1 关闭动画） */
+  index?: number;
+}) {
+  const { t } = useTranslation();
+  const isRun = event.kind === 'workflow_run';
+  const isWfChange = event.kind === 'workflow_change';
+  const run = event.workflowRun;
+  const wc = event.workflowChange;
+  const tc = event.tableChange;
+  const title = isRun
+    ? run?.name || run?.refId || run?.instanceId
+    : isWfChange
+      ? wc?.name || wc?.workflowId
+      : (tc?.tables ?? []).join(', ');
+  // 徽章：库表操作与工作流定义操作都是静态准确的操作名；工作流执行行标「调试」——
+  // 事件 payload 的 status 是 emit 时刻快照（恒 queued）不可用，对话内触发的执行
+  // 即 debug 调试，实时运行状态在详情 iframe 里看。
+  const badge = isRun
+    ? { cls: 'is-debug', text: t('structChange.wfOperation.debug') }
+    : isWfChange
+      ? {
+          cls: `op-${(wc?.operation || 'CREATE').toLowerCase()}`,
+          text: t(`structChange.wfOperation.${wc?.operation || 'CREATE'}`, { defaultValue: wc?.operation }),
+        }
+      : {
+          cls: `op-${(tc?.operation || 'CREATE').toLowerCase()}`,
+          text: t(`structChange.operation.${tc?.operation || 'CREATE'}`, { defaultValue: tc?.operation }),
+        };
+
+  return (
+    <button
+      type="button"
+      className={`struct-change-row ${selected ? 'is-selected' : ''}`}
+      onClick={onSelect}
+      data-testid="struct-change-event-row"
+      style={index >= 0 ? { animationDelay: `${Math.min(index, 8) * 36}ms` } : undefined}
+    >
+      <span className="struct-change-row-icon">
+        {event.kind === 'table_change' ? <Database size={14} aria-hidden="true" /> : <Workflow size={14} aria-hidden="true" />}
+      </span>
+      <span className="struct-change-row-body">
+        <span className="struct-change-row-title">{title}</span>
+      </span>
+      {badge && <span className={`struct-change-row-badge ${badge.cls}`}>{badge.text}</span>}
+      <span className="struct-change-row-time">{formatEventTime(event.ts)}</span>
+    </button>
+  );
+}
+
+/** workflow_run 详情：iframe 指向 /workflow-runs/<instanceId>?embed=1（纯 DAG 画布，
+ *  无页头/返回/刷新控件；自带 2s 轮询 + 节点运行态染色，本面板零轮询逻辑） */
+function WorkflowRunDetail({ event }: { event: StructChangeEvent }) {
+  const run = event.workflowRun;
+  if (!run) return null;
+  return (
+    <div className="struct-change-detail" data-testid="struct-change-workflow-detail">
+      <WorkflowPreview url={workflowRunEmbedPath(run.instanceId)} />
+    </div>
+  );
+}
+
+/** workflow_change 详情：按 workflow_id 现拉最新定义渲染只读 DAG——
+ *  详情展示"这个工作流的当前样子"，Agent 挂节点时同 workflow 的新事件到达会
+ *  触发重拉，DAG 跟着长；列表行才是操作历史。 */
+function WorkflowChangeDetail({ event, revision }: { event: StructChangeEvent; revision: number }) {
+  const { t } = useTranslation();
+  const wc = event.workflowChange;
+  const [workflow, setWorkflow] = useState<WorkflowDefinition | null>(null);
+  const [tasks, setTasks] = useState<TaskDefinition[]>([]);
+  const [error, setError] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [selectedNodeId, setSelectedNodeId] = useState<string | null>(null);
+
+  const workflowId = wc?.workflowId ?? '';
+
+  useEffect(() => {
+    if (!workflowId) return;
+    let disposed = false;
+    setLoading(true);
+    setError('');
+    void (async () => {
+      try {
+        // allTasks 拉全量任务目录供节点副标题展示；定义与任务目录并行取
+        const [wf, taskList] = await Promise.all([
+          orchestrationApi.getWorkflow(workflowId),
+          orchestrationApi.allTasks(),
+        ]);
+        if (disposed) return;
+        setWorkflow(wf);
+        setTasks(taskList);
+        setLoading(false);
+      } catch (err) {
+        if (disposed) return;
+        setError(err instanceof Error ? err.message : String(err));
+        setLoading(false);
+      }
+    })();
+    return () => {
+      disposed = true;
+    };
+  }, [workflowId, revision]);
+
+  const draft = useMemo<NodeInput[]>(
+    () => (workflow?.nodes ?? []).map(node => ({
+      node_id: node.node_id,
+      task_id: node.task_id,
+      group_name: node.group_name ?? '',
+      node_name: node.node_name ?? '',
+      upstream_nodes: node.upstream_nodes,
+      wait_review: !!node.wait_review,
+      order_index: node.order_index,
+    })),
+    [workflow?.nodes],
+  );
+
+  if (!wc) return null;
+
+  return (
+    <div className="struct-change-detail" data-testid="struct-change-workflow-definition-detail">
+      {loading && <div className="struct-change-placeholder">{t('common.loading')}</div>}
+      {!loading && error && (
+        <div className="struct-change-placeholder struct-change-placeholder-error" role="alert">{error}</div>
+      )}
+      {!loading && !error && draft.length === 0 && (
+        <div className="struct-change-placeholder">{t('workflowRun.emptyGraph')}</div>
+      )}
+      {!loading && !error && draft.length > 0 && (
+        <div className="struct-change-lineage">
+          <WorkflowGraph
+            nodes={toWorkflowGraphNodes(draft, tasks, undefined, t('dataAsset.nodeForm.defaultGroup'))}
+            selectedNodeId={selectedNodeId}
+            onSelectNode={id => setSelectedNodeId(cur => (cur === id ? null : id))}
+            readOnly
+            canvasHeight="100%"
+            canvasMinHeight={0}
+            fitViewOnResize
+            fitViewMaxZoom={1}
+          />
+        </div>
+      )}
+    </div>
+  );
+}
+
+/** 表结构卡：建表事件在血缘图中无边时的降级视图（方案 A——首次建表占绝大多数，
+ *  空泳道图是负体验；字段结构才是建表动作的直接产出）。数据来自 metadataApi.getTable。 */
+function TableSchemaCard({ db, table }: { db: string; table: string }) {
+  const { t } = useTranslation();
+  const [detail, setDetail] = useState<TableDetail | null>(null);
+  const [error, setError] = useState('');
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => {
+    if (!db || !table) return;
+    let disposed = false;
+    setLoading(true);
+    setError('');
+    setDetail(null);
+    metadataApi
+      .getTable(db, table)
+      .then(d => {
+        if (disposed) return;
+        setDetail(d);
+        setLoading(false);
+      })
+      .catch(err => {
+        if (disposed) return;
+        setError(err instanceof Error ? err.message : String(err));
+        setLoading(false);
+      });
+    return () => {
+      disposed = true;
+    };
+  }, [db, table]);
+
+  const layer = inferLayer(table);
+
+  if (loading) return <div className="struct-change-placeholder">{t('structChange.schemaLoading')}</div>;
+  if (error) {
+    return <div className="struct-change-placeholder struct-change-placeholder-error" role="alert">{error}</div>;
+  }
+  if (!detail) return null;
+
+  return (
+    <div className="struct-change-schema" data-testid="struct-change-schema-card">
+      <div className="struct-change-schema-stats">
+        <span className="struct-change-schema-layer" data-layer={layer}>{layer}</span>
+        <span>{t('structChange.schemaColumns', { count: detail.columns.length })}</span>
+        <span>{t('structChange.schemaRows', { count: detail.row_count })}</span>
+      </div>
+      <div className="struct-change-schema-table">
+        <table>
+          <thead>
+            <tr>
+              <th>{t('structChange.schemaCol.name')}</th>
+              <th>{t('structChange.schemaCol.type')}</th>
+              <th>{t('structChange.schemaCol.nullable')}</th>
+              <th>{t('structChange.schemaCol.primaryKey')}</th>
+            </tr>
+          </thead>
+          <tbody>
+            {detail.columns.map(col => (
+              <tr key={col.name}>
+                <td>{col.name}</td>
+                <td><span className="struct-change-type-badge">{col.type}</span></td>
+                <td>{col.nullable ? '✓' : '✗'}</td>
+                <td>{col.primary_key ? '🔑' : ''}</td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+      <p className="struct-change-schema-note">{t('structChange.lineagePending')}</p>
+    </div>
+  );
+}
+
+/** 表名前缀推断分层（与后端 _infer_layer 同规则；仅展示徽标用，判错无害） */
+function inferLayer(table: string): string {
+  const low = table.toLowerCase();
+  if (low.startsWith('ods_')) return 'ODS';
+  if (low.startsWith('dwd_')) return 'DWD';
+  if (low.startsWith('dws_')) return 'DWS';
+  if (low.startsWith('ads_')) return 'ADS';
+  return 'OTHER';
+}
+
+/** table_change 详情：加载整库血缘后按焦点表是否在图中分流——
+ *  有边 → 整库血缘图 + 新表高亮；无边（普通建表，绝大多数）→ 表结构卡降级（方案 A） */
+function TableChangeDetail({ event }: { event: StructChangeEvent }) {
+  const { t } = useTranslation();
+  const tc = event.tableChange;
+  const [lineage, setLineage] = useState<LineageArtifact | null>(null);
+  const [error, setError] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [selected, setSelected] = useState('');
+
+  const db = tc?.db ?? '';
+  const focusTable = useMemo(() => {
+    // 带库名的表（db.table）取裸表名——lineage 图的节点键是裸表名
+    const first = tc?.tables?.[0] ?? '';
+    return first.includes('.') ? first.split('.').pop() ?? '' : first;
+  }, [tc?.tables]);
+
+  useEffect(() => {
+    if (!db) return;
+    let disposed = false;
+    setLoading(true);
+    setError('');
+    setLineage(null);
+    metadataApi
+      .getLineage(db)
+      .then(artifact => {
+        if (disposed) return;
+        setLineage(artifact);
+        setLoading(false);
+      })
+      .catch(err => {
+        if (disposed) return;
+        setError(err instanceof Error ? err.message : String(err));
+        setLoading(false);
+      });
+    return () => {
+      disposed = true;
+    };
+  }, [db]);
+
+  useEffect(() => {
+    setSelected(focusTable);
+  }, [focusTable]);
+
+  if (!tc) return null;
+
+  const nodes = lineage?.graph.nodes ?? [];
+  const focusInGraph = Boolean(focusTable) && nodes.some(n => n.table === focusTable);
+  // 血缘可用 = 焦点表在图中有边（孤点表与完全无边都走表结构卡降级）
+  const lineageUsable = focusInGraph && (lineage?.graph.edges ?? []).length > 0;
+
+  return (
+    <div className="struct-change-detail" data-testid="struct-change-table-detail">
+      {loading && <div className="struct-change-placeholder">{t('structChange.loading')}</div>}
+      {!loading && error && (
+        <div className="struct-change-placeholder struct-change-placeholder-error" role="alert">
+          {t('structChange.lineageError', { message: error })}
+        </div>
+      )}
+      {!loading && !error && (
+        lineageUsable && lineage ? (
+          <div className="struct-change-lineage">
+            <LineageGraph
+              nodes={lineage.graph.nodes}
+              edges={lineage.graph.edges}
+              layerFilter={DEFAULT_LAYERS}
+              searchTerm=""
+              selected={selected}
+              onSelect={(table: string) => setSelected(cur => (cur === table ? '' : table))}
+            />
+          </div>
+        ) : (
+          <>
+            {focusTable && <TableSchemaCard db={db} table={focusTable} />}
+            {!focusTable && (
+              <div className="struct-change-placeholder">{t('structChange.emptyLineage')}</div>
+            )}
+          </>
+        )
+      )}
+    </div>
+  );
+}
+
+export function StructChangePanel({ sessionId }: { sessionId: string }) {
+  const { t } = useTranslation();
+  const events = useStructChangeStore(s => s.runtimes[sessionId]?.events ?? []);
+  const [selectedId, setSelectedId] = useState('');
+  // 双 tab：「工作流」= 执行(workflow_run) + 定义变更(workflow_change) 混排；
+  // 「库表变更」= table_change。无事件的 tab 隐藏（显隐兜底回第一个可用 tab）。
+  const [tab, setTab] = useState<'workflow' | 'table_change'>('workflow');
+
+  // tab 只展示有事件的类型；无事件类型兜底回第一个可用 tab
+  const availableTabs = useMemo(() => {
+    const tabs: ('workflow' | 'table_change')[] = [];
+    if (events.some(e => e.kind === 'workflow_run' || e.kind === 'workflow_change')) tabs.push('workflow');
+    if (events.some(e => e.kind === 'table_change')) tabs.push('table_change');
+    return tabs;
+  }, [events]);
+  const activeTab = (availableTabs.includes(tab) ? tab : availableTabs[0]) ?? 'workflow';
+
+  // tab state 只代表用户点击意图；类型缺失兜底展示时同步 state，避免新事件到达后视图静默跳 tab
+  useEffect(() => {
+    if (availableTabs.length && !availableTabs.includes(tab)) setTab(availableTabs[0]);
+  }, [availableTabs, tab]);
+
+  const tabEvents = useMemo(
+    () => events.filter(e => (activeTab === 'workflow'
+      ? e.kind === 'workflow_run' || e.kind === 'workflow_change'
+      : e.kind === 'table_change')),
+    [events, activeTab],
+  );
+
+  // 默认选中最新事件；tab 切换或列表变化后若选中项已不在当前 tab 列表则回落到最新
+  const effectiveSelectedId = useMemo(
+    () => (selectedId && tabEvents.some(e => e.eventId === selectedId) ? selectedId : tabEvents[0]?.eventId ?? ''),
+    [selectedId, tabEvents],
+  );
+  const selectedEvent = tabEvents.find(e => e.eventId === effectiveSelectedId);
+
+  // 详情聚合：选中 workflow_change 详情时，同 workflow_id 的后续定义事件到达会让
+  // DAG 自动重拉更新（"看着工作流长大"）；执行/库表详情不需要。
+  const wfChangeRevision = useMemo(() => {
+    if (selectedEvent?.kind !== 'workflow_change') return 0;
+    const wfId = selectedEvent.workflowChange?.workflowId;
+    return events.filter(e => e.kind === 'workflow_change' && e.workflowChange?.workflowId === wfId).length;
+  }, [selectedEvent, events]);
+
+  const tabLabels: Record<'workflow' | 'table_change', string> = {
+    workflow: t('structChange.filter.workflowRun'),
+    table_change: t('structChange.filter.tableChange'),
+  };
+  const tabs = availableTabs.map(key => ({ key, label: tabLabels[key] }));
+
+  return (
+    <div className="struct-change-panel" data-testid="struct-change-panel">
+      <div className="struct-change-list" data-testid="struct-change-list">
+        {/* 双 tab 签头：下划线式，对齐治理 main-tabs */}
+        <div className="struct-change-list-filter" role="tablist" aria-label={t('structChange.tab')} data-testid="struct-change-list-filter">
+          {tabs.map(item => (
+            <button
+              key={item.key}
+              type="button"
+              role="tab"
+              aria-selected={activeTab === item.key}
+              className={`struct-change-filter-btn ${activeTab === item.key ? 'is-active' : ''}`}
+              onClick={() => setTab(item.key)}
+            >
+              {item.label}
+            </button>
+          ))}
+        </div>
+        <div className="struct-change-list-scroll">
+          {tabEvents.map((event, i) => (
+            <EventRow
+              key={event.eventId}
+              event={event}
+              selected={event.eventId === effectiveSelectedId}
+              onSelect={() => setSelectedId(event.eventId)}
+              index={i}
+            />
+          ))}
+          {tabEvents.length === 0 && (
+            <div className="struct-change-placeholder">{t('structChange.empty')}</div>
+          )}
+        </div>
+      </div>
+      <div className="struct-change-view">
+        {selectedEvent?.kind === 'workflow_run' && <WorkflowRunDetail event={selectedEvent} />}
+        {selectedEvent?.kind === 'workflow_change' && (
+          <WorkflowChangeDetail event={selectedEvent} revision={wfChangeRevision} />
+        )}
+        {selectedEvent?.kind === 'table_change' && <TableChangeDetail event={selectedEvent} />}
+      </div>
+    </div>
+  );
+}
