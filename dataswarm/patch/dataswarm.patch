index 000000000..081521e6a
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/governanceFindingModel.test.mjs
@@ -0,0 +1,167 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { collectFindingRows, filterFindingRows } from '../node_modules/.cache/governance-finding-model/findingModel.mjs';
+
+function finding(overrides = {}) {
+  return {
+    id: 'source-1',
+    finding_uid: 'uid-1',
+    severity: 'medium',
+    category: 'completeness',
+    summary: 'Orders contains incomplete records',
+    ...overrides,
+  };
+}
+
+function artifact(findings) {
+  return { findings };
+}
+
+test('按固定 artifactKey 映射和顺序聚合跨维度 finding', () => {
+  const { rows, duplicateUids } = collectFindingRows({
+    task: artifact([finding({ finding_uid: 'task-uid', category: 'schedule' })]),
+    zscore: artifact([finding({ finding_uid: 'zscore-uid' })]),
+    schema: artifact([finding({ finding_uid: 'schema-uid' })]),
+    data: artifact([finding({ finding_uid: 'data-uid' })]),
+    lineage: artifact([finding({ finding_uid: 'lineage-uid' })]),
+    'column-lineage': artifact([finding({ finding_uid: 'column-uid' })]),
+    metric: artifact([finding({ finding_uid: 'metric-uid' })]),
+  });
+
+  assert.deepEqual(
+    rows.map(({ artifactKey, dimension, uid }) => ({ artifactKey, dimension, uid })),
+    [
+      { artifactKey: 'schema', dimension: 'schema', uid: 'schema-uid' },
+      { artifactKey: 'data', dimension: 'quality', uid: 'data-uid' },
+      { artifactKey: 'zscore', dimension: 'quality', uid: 'zscore-uid' },
+      { artifactKey: 'lineage', dimension: 'lineage', uid: 'lineage-uid' },
+      { artifactKey: 'column-lineage', dimension: 'lineage', uid: 'column-uid' },
+      { artifactKey: 'metric', dimension: 'metric', uid: 'metric-uid' },
+      { artifactKey: 'task', dimension: 'task', uid: 'task-uid' },
+    ],
+  );
+  assert.deepEqual(duplicateUids, []);
+  assert.ok(rows.every(row => row.selectable && row.selectionIssue === null));
+});
+
+test('root-cause 分析产物不进异常清单（只在血缘图追溯链与根因面板展示）', () => {
+  const { rows } = collectFindingRows({
+    'root-cause': artifact([finding({ finding_uid: 'root-uid', category: 'root_cause' })]),
+  });
+  assert.deepEqual(rows, []);
+});
+
+test('选择身份严格使用 finding_uid，不用原始 id 或 source_finding_id 兜底', () => {
+  const { rows } = collectFindingRows({
+    schema: artifact([
+      finding({ id: 'legacy-id', source_finding_id: 'legacy-source', finding_uid: undefined }),
+      finding({ id: 'empty-id', finding_uid: '' }),
+      finding({ id: 'blank-id', finding_uid: '   ' }),
+      finding({ id: 'opaque-id', finding_uid: '  uid-kept-verbatim  ' }),
+    ]),
+  });
+
+  assert.deepEqual(
+    rows.map(row => row.uid),
+    [null, null, null, '  uid-kept-verbatim  '],
+  );
+  assert.deepEqual(
+    rows.map(row => row.selectable),
+    [false, false, false, true],
+  );
+  assert.deepEqual(
+    rows.map(row => row.selectionIssue),
+    ['missing_uid', 'missing_uid', 'missing_uid', null],
+  );
+});
+
+test('维度、严重度和分类筛选在组内为 OR、组间为 AND', () => {
+  const { rows } = collectFindingRows({
+    schema: artifact([
+      finding({ finding_uid: 'schema-high', severity: 'high', category: 'naming' }),
+      finding({ finding_uid: 'schema-low', severity: 'low', category: 'type' }),
+    ]),
+    data: artifact([
+      finding({ finding_uid: 'quality-high', severity: 'high', category: 'freshness' }),
+      finding({ finding_uid: 'quality-medium', severity: 'medium', category: 'completeness' }),
+    ]),
+    lineage: artifact([finding({ finding_uid: 'lineage-high', severity: 'high', category: 'freshness' })]),
+  });
+
+  assert.deepEqual(
+    filterFindingRows(rows, {
+      dimensions: ['quality', 'lineage'],
+      severities: ['high'],
+      categories: ['freshness'],
+    }).map(row => row.uid),
+    ['quality-high', 'lineage-high'],
+  );
+  assert.equal(filterFindingRows(rows, { dimensions: [], severities: [], categories: [] }).length, rows.length);
+});
+
+test('全文过滤覆盖身份、摘要、明细、对象和证据，且多关键词全部命中', () => {
+  const { rows } = collectFindingRows({
+    data: artifact([
+      finding({
+        id: 'NUL-001',
+        finding_uid: 'quality-orders-buyer',
+        source_finding_id: 'source-null-check',
+        summary: 'Buyer identifier is missing',
+        detail: 'Detected in the latest partition',
+        object: { table: 'DWD_ORDERS', column: 'buyer_id' },
+        evidence: { null_count: 27 },
+      }),
+      finding({
+        id: 'DUP-001',
+        finding_uid: 'quality-customers-email',
+        summary: 'Customer email is duplicated',
+        object: { table: 'dim_customers', column: 'email' },
+      }),
+    ]),
+  });
+
+  assert.deepEqual(
+    filterFindingRows(rows, { query: 'dwd_orders BUYER_ID' }).map(row => row.uid),
+    ['quality-orders-buyer'],
+  );
+  assert.deepEqual(
+    filterFindingRows(rows, { query: 'latest 27' }).map(row => row.uid),
+    ['quality-orders-buyer'],
+  );
+  assert.deepEqual(
+    filterFindingRows(rows, { query: 'source-null-check missing' }).map(row => row.uid),
+    ['quality-orders-buyer'],
+  );
+  assert.deepEqual(filterFindingRows(rows, { query: 'not-present' }), []);
+  assert.equal(filterFindingRows(rows, { query: '   ' }).length, rows.length);
+});
+
+test('重复 finding_uid 保留全部行、显式上报且禁止歧义选择', () => {
+  const { rows, duplicateUids } = collectFindingRows({
+    schema: artifact([finding({ id: 'schema-source', finding_uid: 'duplicate-uid' })]),
+    data: artifact([finding({ id: 'quality-source', finding_uid: 'duplicate-uid' }), finding({ id: 'quality-unique', finding_uid: 'unique-uid' })]),
+  });
+
+  assert.equal(rows.length, 3);
+  assert.deepEqual(duplicateUids, ['duplicate-uid']);
+  assert.deepEqual(
+    rows
+      .filter(row => row.uid === 'duplicate-uid')
+      .map(row => ({
+        artifactKey: row.artifactKey,
+        duplicateUid: row.duplicateUid,
+        selectable: row.selectable,
+        selectionIssue: row.selectionIssue,
+      })),
+    [
+      { artifactKey: 'schema', duplicateUid: true, selectable: false, selectionIssue: 'duplicate_uid' },
+      { artifactKey: 'data', duplicateUid: true, selectable: false, selectionIssue: 'duplicate_uid' },
+    ],
+  );
+
+  const uniqueRow = rows.find(row => row.uid === 'unique-uid');
+  assert.equal(uniqueRow?.duplicateUid, false);
+  assert.equal(uniqueRow?.selectable, true);
+  assert.equal(uniqueRow?.selectionIssue, null);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/governanceFlowModel.test.mjs b/jiuwenswarm/channels/web/frontend/tests/governanceFlowModel.test.mjs
