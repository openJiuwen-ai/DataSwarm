+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""judge 新增断言的离线单测：INL intent/time_basis 对照 + pairs_multi 容差/豁免。
+
+不依赖 MySQL / 后端服务——evidence 目录用最小骨架 manifest 构造，
+与 test_open_analysis_eval.py 同款 sys.path 注入编排。
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+EVAL_SCRIPTS = Path(__file__).resolve().parents[3] / ".claude/skills/dw-analysis-eval/scripts"
+if str(EVAL_SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(EVAL_SCRIPTS))
+
+from judge import Verdict, _check_pairs_multi, judge_case  # noqa: E402
+
+
+def _mk_evidence(tmp_path: Path, manifest: dict) -> Path:
+    artifact = tmp_path / "artifact"
+    artifact.mkdir(exist_ok=True)
+    (artifact / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False),
+                                             encoding="utf-8")
+    return tmp_path
+
+
+def _manifest(inl: dict | None = None) -> dict:
+    manifest: dict = {
+        # 一个 execute 尝试让 analysis: required 的早退不触发（INL 断言在早退之后）
+        "components": {"c1": {"component_id": "c1",
+                              "attempts": [{"kind": "execute", "grounding_level": "G1",
+                                            "sql": "SELECT 1"}]}},
+    }
+    if inl is not None:
+        manifest["intent_normalized"] = inl
+    return manifest
+
+
+def _judge(tmp_path: Path, manifest: dict, expect: dict) -> dict:
+    evidence = _mk_evidence(tmp_path, manifest)
+    case = {"id": "t-inl", "difficulty": "easy", "coverage": [], "expect": expect}
+    return judge_case(case, evidence, {"cases": {}}, "batch")
+
+
+def _groups(result: dict) -> set[str]:
+    return {f["group"] for f in result["failures"]}
+
+
+def test_intent_match_populates_details_and_passes(tmp_path):
+    inl = {"intent": "diagnosis", "scope": {"time": {"basis": "calendar_month"}}}
+    result = _judge(tmp_path, _manifest(inl),
+                    {"analysis": "required", "intent": "diagnosis"})
+    assert "intent" not in _groups(result)
+    assert result["details"]["intent_normalized"] == {
+        "intent": "diagnosis", "time_basis": "calendar_month"}
+
+
+def test_intent_mismatch_fails_with_both_values(tmp_path):
+    inl = {"intent": "analysis", "scope": {"time": {"basis": "default"}}}
+    result = _judge(tmp_path, _manifest(inl),
+                    {"analysis": "required", "intent": "diagnosis"})
+    fails = [f for f in result["failures"] if f["group"] == "intent"]
+    assert len(fails) == 1
+    assert "analysis" in fails[0]["detail"] and "diagnosis" in fails[0]["detail"]
+
+
+def test_intent_expected_but_ledger_missing_fails_with_hint(tmp_path):
+    """零账本路径（lookup/report_only 不产 manifest.intent_normalized）写了断言键
+    必须失败并指路——防 INL 落账链路静默退化。"""
+    result = _judge(tmp_path, _manifest(inl=None),
+                    {"analysis": "required", "intent": "analysis"})
+    fails = [f for f in result["failures"] if f["group"] == "intent"]
+    assert len(fails) == 1
+    assert "intent_normalized" in fails[0]["detail"]
+
+
+def test_time_basis_match_mismatch_and_missing(tmp_path):
+    # 匹配：不失败
+    result = _judge(tmp_path, _manifest({"intent": "analysis",
+                                         "scope": {"time": {"basis": "rolling_30d"}}}),
+                    {"analysis": "required", "time_basis": "rolling_30d"})
+    assert "time_basis" not in _groups(result)
+    # 不匹配：失败
+    result = _judge(tmp_path, _manifest({"intent": "analysis",
+                                         "scope": {"time": {"basis": "default"}}}),
+                    {"analysis": "required", "time_basis": "rolling_30d"})
+    assert "time_basis" in _groups(result)
+    # basis 字段缺失：降级 warn 不失败（结构漂移防御）
+    result = _judge(tmp_path, _manifest({"intent": "analysis", "scope": {}}),
+                    {"analysis": "required", "time_basis": "rolling_30d"})
+    assert "time_basis" not in _groups(result)
+    assert any("basis 缺失" in w for w in result["warnings"])
+
+
+def test_no_inl_keys_backward_compatible(tmp_path):
+    """expect 不写 intent/time_basis 时，manifest 无论有无 intent_normalized
+    都不产生新失败/警告（存量 20 例零影响）。"""
+    for manifest in (_manifest(inl=None),
+                     _manifest({"intent": "analysis", "scope": {"time": {"basis": "default"}}})):
+        result = _judge(tmp_path, manifest, {"analysis": "required"})
+        assert "intent" not in _groups(result) and "time_basis" not in _groups(result)
+        assert not any("intent_normalized" in w for w in result["warnings"])
+
+
+# ---------------------------------------------------------------------------
+# pairs_multi：tolerance=isclose 与 allow_extra_keys（judge 增强 B）
+# ---------------------------------------------------------------------------
+
+def _top_table() -> list[list[str]]:
+    return [["state", "gmv", "aov"],
+            ["SP", "228169.34", "134.217259"],
+            ["RJ", "90493.98", "163.346534"],
+            ["XX", "1.00", "2.00"]]  # XX 为真值外键（成分 CSV 拉全维的合法形态）
+
+
+_TRUTH_MULTI = {"SP": {"gmv": "228169.34", "aov": "134.217259"},
+                "RJ": {"gmv": "90493.98", "aov": "163.346534"}}
+
+
+def _csv_failures(verdict: Verdict) -> list[str]:
+    return [f["detail"] for f in verdict.failures if f["group"] == "csv"]
+
+
+def test_pairs_multi_exact_by_default_flags_extra_and_noise():
+    verdict = Verdict()
+    _check_pairs_multi(verdict, [_top_table()], _TRUTH_MULTI, hints=[])
+    assert any("多出真值外键" in d for d in _csv_failures(verdict))
+
+
+def test_pairs_multi_allow_extra_downgrades_to_note():
+    verdict = Verdict()
+    _check_pairs_multi(verdict, [_top_table()], _TRUTH_MULTI, hints=[],
+                       allow_extra=True)
+    assert not _csv_failures(verdict)
+    # F-062：显式豁免是说明性留痕——进 notes 不进 warnings（warning 会把
+    # pass 拉成 degraded，与豁免意图自相矛盾）。
+    assert any("allow_extra_keys" in n for n in verdict.notes)
+
+
+def test_pairs_multi_isclose_tolerates_rounding_but_not_real_diff():
+    """isclose 吸收分位级舍入差（≤0.01：模型未 ROUND 高精度输出 vs 真值
+    ROUND(2)——olist-42 实证 325.397091 vs 325.40 假失败，F-062），真差异
+    （数量级偏离）仍必须失败——数值要求不放松。"""
+    verdict = Verdict()
+    _check_pairs_multi(verdict, [_top_table()],
+                       {"SP": {"gmv": "228169.340000001", "aov": "134.217259000001"},
+                        "RJ": {"gmv": "90493.98", "aov": "163.346534"}},
+                       hints=[], allow_extra=True, tolerance="isclose")
+    assert not _csv_failures(verdict)
+    # 分位级舍入差（模型高精度 134.217259 vs 真值 ROUND(2) 134.22，差 0.003）通过
+    verdict = Verdict()
+    _check_pairs_multi(verdict, [_top_table()],
+                       {"SP": {"gmv": "228169.34", "aov": "134.22"},
+                        "RJ": {"gmv": "90493.98", "aov": "163.35"}},
+                       hints=[], allow_extra=True, tolerance="isclose")
+    assert not _csv_failures(verdict)
+    # 真差异（aov 偏离 25+，远超分位级）仍失败
+    verdict = Verdict()
+    _check_pairs_multi(verdict, [_top_table()],
+                       {"SP": {"gmv": "228169.34", "aov": "160.00"},
+                        "RJ": {"gmv": "90493.98", "aov": "163.35"}},
+                       hints=[], allow_extra=True, tolerance="isclose")
+    assert any("aov" in d for d in _csv_failures(verdict))
