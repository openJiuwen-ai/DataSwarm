@@ -0,0 +1,112 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 治理侧栏的轻量输入区：textarea + 发送/停止。
+ *
+ * 刻意不复用 ChatPanel/InputArea（2864 行 contenteditable，与全局 activeSessionId
+ * 深度耦合）——这里只需要纯文本对话，按 sessionId 显式绑定。
+ */
+
+import { useEffect, useRef, useState, type KeyboardEvent } from 'react';
+import { Square } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import sendIcon from '../../../assets/send.svg';
+import sendActiveIcon from '../../../assets/send_active.svg';
+import { useChatStore } from '../../../stores';
+import { useGovernanceStore } from '../store/governanceStore';
+import { stopGovernanceTurn } from '../chat/governanceChat';
+import {
+  bindGovernanceComposerDraft,
+  createGovernanceComposerDraft,
+  getGovernanceComposerSubmission,
+  GOVERNANCE_COMPOSER_MAX_CHARS,
+  updateGovernanceComposerDraft,
+} from './governanceComposerDraft';
+
+interface GovernanceComposerProps {
+  runId: string;
+  sessionId: string;
+  onSend: (content: string) => void;
+}
+
+export function GovernanceComposer({ runId, sessionId, onSend }: GovernanceComposerProps) {
+  const { t } = useTranslation();
+  const [draft, setDraft] = useState(() => createGovernanceComposerDraft(runId));
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+  const isProcessing = useChatStore(s => s.runtimes[sessionId]?.isProcessing ?? false);
+  const currentDraft = bindGovernanceComposerDraft(draft, runId);
+  const value = currentDraft.value;
+
+  useEffect(() => {
+    setDraft(previous => bindGovernanceComposerDraft(previous, runId));
+  }, [runId]);
+
+  const fixPrefill = useGovernanceStore(s => s.fixPrefill);
+  // 外部预填（FixPlanPage 修复 spec）：消费信箱 → 填入 → 聚焦，不自动发送
+  useEffect(() => {
+    if (fixPrefill === null) return;
+    setDraft(previous => updateGovernanceComposerDraft(previous, runId, fixPrefill));
+    useGovernanceStore.getState().consumeFixPrefill();
+    textareaRef.current?.focus();
+  }, [fixPrefill, runId]);
+
+  const submit = () => {
+    const content = getGovernanceComposerSubmission(currentDraft, runId, isProcessing);
+    if (content === null) return;
+    onSend(content);
+    setDraft(createGovernanceComposerDraft(runId));
+    textareaRef.current?.focus();
+  };
+
+  const handleKeyDown = (e: KeyboardEvent<HTMLTextAreaElement>) => {
+    if (e.key === 'Enter' && !e.shiftKey && !e.nativeEvent.isComposing) {
+      e.preventDefault();
+      submit();
+    }
+  };
+
+  const overBudget = value.length > GOVERNANCE_COMPOSER_MAX_CHARS;
+  const canSend = Boolean(sessionId && value.trim() && !overBudget && !isProcessing);
+
+  return (
+    <div className="gov-agent-footer">
+      <div className="gov-agent-inputrow" data-over={overBudget || undefined}>
+        <textarea
+          ref={textareaRef}
+          className="gov-agent-textarea"
+          value={value}
+          onChange={event => setDraft(previous => updateGovernanceComposerDraft(previous, runId, event.target.value))}
+          onKeyDown={handleKeyDown}
+          placeholder={isProcessing ? t('governance.assistant.composer.processing') : t('governance.assistant.composer.placeholder')}
+          aria-label={t('governance.assistant.composer.input')}
+          rows={3}
+          disabled={!sessionId}
+        />
+        <button
+          type="button"
+          className={`gov-agent-send ${isProcessing ? 'is-stop' : ''}`}
+          disabled={!sessionId || (!isProcessing && !canSend)}
+          title={isProcessing ? t('governance.assistant.composer.stop') : t('governance.assistant.composer.send')}
+          aria-label={isProcessing ? t('governance.assistant.composer.stop') : t('governance.assistant.composer.send')}
+          onClick={() => {
+            if (isProcessing) void stopGovernanceTurn(sessionId);
+            else submit();
+          }}
+        >
+          {isProcessing ? (
+            <Square size={16} fill="currentColor" strokeWidth={1.8} aria-hidden="true" />
+          ) : (
+            <img className="gov-agent-send-icon" src={canSend ? sendActiveIcon : sendIcon} alt="" aria-hidden="true" />
+          )}
+        </button>
+      </div>
+      {overBudget && (
+        <p className="gov-agent-warn">
+          {t('governance.assistant.composer.overLimit', {
+            max: GOVERNANCE_COMPOSER_MAX_CHARS,
+            count: value.length,
+          })}
+        </p>
+      )}
+    </div>
+  );
+}
