+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  bindGovernanceComposerDraft,
+  createGovernanceComposerDraft,
+  getGovernanceComposerSubmission,
+  updateGovernanceComposerDraft,
+} from '../node_modules/.cache/governance-composer-draft/governanceComposerDraft.mjs';
+
+test('A 批次预填被消费后切换到 B，草稿同步清空且不会产生发送内容', () => {
+  let draft = createGovernanceComposerDraft('run-a');
+  draft = updateGovernanceComposerDraft(draft, 'run-a', '修复 run-a 的异常');
+
+  assert.equal(draft.runId, 'run-a');
+  assert.equal(getGovernanceComposerSubmission(draft, 'run-a', false), '修复 run-a 的异常');
+
+  draft = bindGovernanceComposerDraft(draft, 'run-b');
+
+  assert.deepEqual(draft, { runId: 'run-b', value: '' });
+  assert.equal(getGovernanceComposerSubmission(draft, 'run-b', false), null);
+});
+
+test('同一批次内更新保留草稿，切换批次后旧草稿不能作为新批次提交', () => {
+  let draft = createGovernanceComposerDraft('run-a', '第一版');
+  draft = updateGovernanceComposerDraft(draft, 'run-a', '第二版');
+
+  assert.deepEqual(draft, { runId: 'run-a', value: '第二版' });
+  assert.equal(getGovernanceComposerSubmission(draft, 'run-b', false), null);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/governanceFindingModel.test.mjs b/jiuwenswarm/channels/web/frontend/tests/governanceFindingModel.test.mjs
