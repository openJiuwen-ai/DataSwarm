+def test_anchor_rollback_rejected(sandbox):
+    """mr-hub develop 已记录 anchor 后，更旧的锚点归档被防回退中止。"""
+    # 清单存在后再前进一个 commit 作为「已交付」锚点
+    write(sandbox, "jiuwenswarm/a.py", "base+delta2\n")
+    git(["add", "-A"], sandbox)
+    commit(sandbox, "delta 3")
+    delivered = git(["rev-parse", "develop_oss"], sandbox).stdout.strip()
+
+    assert run_tool(sandbox, "archive_delta.py", "--anchor", delivered, "--push").returncode == 0
+    # 模拟平台合入：MR → mr-hub:develop
+    git(["push", "-q", "mr-hub", "MR:refs/heads/develop"], sandbox)
+    prev = git(["rev-parse", f"{delivered}^"], sandbox).stdout.strip()
+
+    proc = run_tool(sandbox, "archive_delta.py", "--anchor", prev)
+    assert proc.returncode != 0, proc.stdout + proc.stderr
+    assert "锚点回退" in proc.stderr or "锚点回退" in proc.stdout
+
+    # 新锚点正常：重挂到 mr-hub:develop tip 之上
+    write(sandbox, "jiuwenswarm/a.py", "base+delta3\n")
+    git(["add", "-A"], sandbox)
+    commit(sandbox, "delta 4")
+    proc = run_tool(sandbox, "archive_delta.py", "--push")
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    parent = git(["rev-parse", "MR^"], sandbox).stdout.strip()
+    hub_tip = git(["rev-parse", "mr-hub/develop"], sandbox).stdout.strip()
+    assert parent == hub_tip  # 单 commit 重挂：parent = 合入目标 tip
+    assert run_tool(sandbox, "verify_equivalence.py", "--archive-ref", "MR").returncode == 0
