@@ -0,0 +1,165 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""databases schema-snapshot 批量探测单测（方案批次 2 / G18）。
+
+新功能档 TDD：POST /api/dataagent/databases/schema-snapshot 一次返回全表
+schema/索引/DDL，消除 schema-inspector 快照 33 表×4-5 查询的 150+ 次 HTTP 往返。
+跑前应为红（端点未建），实现后转绿。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import urlparse
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.databases import controller as ctrl
+from jiuwenswarm.channels.web.dataagent.databases import service as svc
+
+
+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    def __init__(self, path: str, body: dict | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        raw = json.dumps(body).encode() if body else b""
+        self.rfile = _FakeRfile(raw)
+        self.headers = {"Content-Length": str(len(raw))}
+        self._resp = FakeResponse()
+
+    def _write_json(self, status, payload):
+        self._resp.capture(status, payload)
+
+    def _query_arg(self, parsed, name):
+        return None
+
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, n):
+        return self._data[:n]
+
+
+class _FakeConnector:
+    """模拟 db_connector 进程内批量探测。fail_tables 里的表 schema 抛错。"""
+
+    def __init__(self, table_names, fail_tables=()):
+        self._names = table_names
+        self._fail = set(fail_tables)
+        self.calls: list[tuple] = []
+
+    def tables(self, db_ref):
+        self.calls.append(("tables", db_ref))
+        return {"tables": self._names, "table_count": len(self._names), "db": {"type": "doris"}}
+
+    def schema(self, db_ref, table):
+        self.calls.append(("schema", table))
+        if table in self._fail:
+            raise RuntimeError(f"schema fail {table}")
+        return {"table": table, "columns": [{"name": "id", "type": "int", "null": False, "key": "PRI"}],
+                "db": {}}
+
+    def list_indexes(self, db_ref, table):
+        self.calls.append(("indexes", table))
+        if table in self._fail:
+            raise RuntimeError(f"index fail {table}")
+        return {"table": table, "indexes": [{"name": "PRIMARY", "columns": ["id"], "unique": True}],
+                "db": {}}
+
+    def show_create_table(self, db_ref, table):
+        self.calls.append(("show_create", table))
+        if table in self._fail:
+            raise RuntimeError(f"show create fail {table}")
+        return {"table": table, "create_sql": f"CREATE TABLE {table} (id int)", "db": {}}
+
+
+@pytest.fixture
+def patch_connector(monkeypatch):
+    fake = _FakeConnector(["ods_a", "dwd_b", "dws_c"], fail_tables={"dws_c"})
+    monkeypatch.setattr(svc, "db_connector", fake)
+    return fake
+
+
+# --------------------------------------------------------------------------
+# service 层
+# --------------------------------------------------------------------------
+def test_schema_snapshot_all_tables(patch_connector):
+    """无 tables 参数 → 全表快照，每表含 columns/indexes/create_sql。"""
+    out = svc.schema_snapshot("doris://h/d")
+    assert out["ok"] is True
+    assert out["table_count"] == 3
+    assert {t["table"] for t in out["tables"]} == {"ods_a", "dwd_b", "dws_c"}
+    a = next(t for t in out["tables"] if t["table"] == "ods_a")
+    assert a["columns"][0]["name"] == "id"
+    assert a["indexes"][0]["unique"] is True
+    assert "CREATE TABLE ods_a" in a["create_sql"]
+
+
+def test_schema_snapshot_selected_tables(patch_connector):
+    """tables 参数指定子集 → 只快照指定表。"""
+    out = svc.schema_snapshot("doris://h/d", tables=["ods_a"])
+    assert out["ok"] is True
+    assert out["table_count"] == 1
+    assert out["tables"][0]["table"] == "ods_a"
+
+
+def test_schema_snapshot_single_table_failure_isolated(patch_connector):
+    """单表探测失败不炸整体：失败表记 error 字段，其余正常。"""
+    out = svc.schema_snapshot("doris://h/d")
+    assert out["ok"] is True
+    bad = next(t for t in out["tables"] if t["table"] == "dws_c")
+    assert bad["error"]
+    good = next(t for t in out["tables"] if t["table"] == "ods_a")
+    assert "error" not in good
+
+
+def test_schema_snapshot_elapsed_ms_reported(patch_connector):
+    out = svc.schema_snapshot("doris://h/d")
+    assert isinstance(out["elapsed_ms"], int)
+
+
+def test_schema_snapshot_tables_failure(patch_connector, monkeypatch):
+    """tables() 本身失败 → ok:false envelope。"""
+    def boom(db_ref):
+        raise RuntimeError("conn refused")
+    monkeypatch.setattr(patch_connector, "tables", boom)
+    out = svc.schema_snapshot("doris://h/d")
+    assert out["ok"] is False
+    assert "conn refused" in out["error"]
+
+
+# --------------------------------------------------------------------------
+# controller 层
+# --------------------------------------------------------------------------
+def test_controller_post_schema_snapshot(patch_connector, monkeypatch):
+    monkeypatch.setattr(ctrl, "svc", svc)
+    h = FakeHandler("/api/dataagent/databases/schema-snapshot",
+                    {"db_ref": "doris://h/d", "tables": ["ods_a"]})
+    ctrl.handle_post(h, h.parsed)
+    assert h._resp.status == 200
+    assert h._resp.payload["ok"] is True
+    assert h._resp.payload["table_count"] == 1
+
+
+def test_controller_post_schema_snapshot_missing_db_ref(patch_connector, monkeypatch):
+    monkeypatch.setattr(ctrl, "svc", svc)
+    h = FakeHandler("/api/dataagent/databases/schema-snapshot", {})
+    ctrl.handle_post(h, h.parsed)
+    assert h._resp.status == 400
+
+
+def test_controller_post_unknown_route_404(patch_connector, monkeypatch):
+    monkeypatch.setattr(ctrl, "svc", svc)
+    h = FakeHandler("/api/dataagent/databases/unknown", {})
+    ctrl.handle_post(h, h.parsed)
+    assert h._resp.status == 404
