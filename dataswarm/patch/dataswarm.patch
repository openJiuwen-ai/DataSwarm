+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage/controller.py — 表/列血缘 HTTP 路由分发。
+
+作为 dataagent 子模块，由 dataagent/api.py 委托调用。
+路由前缀: /api/dataagent/lineage/
+
+入口剥掉前缀后 split，使 parts 索引与业务路径一一对应
+（仿 dashboard/api.py 的 _split 模式，避免 off-by-one）。
+"""
+from __future__ import annotations
+
+from urllib.parse import unquote
+
+from jiuwenswarm.common.workspace_context import WorkspaceContextError
+
+from . import service as svc
+from .._common import read_body, write_json
+
+
+_PREFIX = "/api/dataagent/lineage"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    """剥掉前缀后 split，返回 ['', <segment>, ...]。
+
+    段经 unquote：前端 encodeURIComponent 编码中文库名/表名，parsed.path
+    保留编码态，与 databases/controller._split 同口径解码。
+    """
+    rel = unquote(path[len(_PREFIX):].rstrip("/"))
+    return rel.split("/")
+
+
+def _workspace_id(handler, parsed) -> str | None:
+    return handler._query_arg(parsed, "workspace_id")
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    try:
+        ws = _workspace_id(handler, parsed)
+        # ['', '{db}']
+        if len(parts) == 2 and parts[1]:
+            plan_id = handler._query_arg(parsed, "plan_id") or None
+            handler._write_json(200, svc.read_table_lineage(parts[1], plan_id=plan_id,
+                                                            workspace_id=ws))
+            return
+        # ['', '{db}', 'tables', '{table}', 'columns']
+        if (len(parts) == 5 and parts[2] == "tables" and parts[4] == "columns"
+                and parts[1] and parts[3]):
+            handler._write_json(200, svc.read_column_lineage(parts[1], parts[3],
+                                                             workspace_id=ws))
+            return
+    except WorkspaceContextError as exc:
+        handler._write_json(400, {"error": getattr(exc, "code", "invalid_workspace"),
+                                  "detail": str(exc)})
+        return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = read_body(handler)
+    if body is None and len(parts) > 1:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        ws = (body or {}).get("workspace_id") if isinstance(body, dict) else None
+        # ['', 'table']
+        if len(parts) == 2 and parts[1] == "table":
+            edges = (body or {}).get("edges", [])
+            count = svc.save_table_lineage(edges, workspace_id=ws)
+            handler._write_json(201, {"ok": True, "count": count})
+            return
+        # ['', 'column']
+        if len(parts) == 2 and parts[1] == "column":
+            edges = (body or {}).get("edges", [])
+            count = svc.save_column_lineage(edges, workspace_id=ws)
+            handler._write_json(201, {"ok": True, "count": count})
+            return
+        # ['', 'table', 'delete']
+        if len(parts) == 3 and parts[1] == "table" and parts[2] == "delete":
+            count = svc.delete_table_lineage(
+                (body or {}).get("plan_id", ""),
+                (body or {}).get("task_id", ""),
+                workspace_id=ws,
+            )
+            handler._write_json(200, {"ok": True, "count": count})
+            return
+        # ['', 'column', 'delete']
+        if len(parts) == 3 and parts[1] == "column" and parts[2] == "delete":
+            count = svc.delete_column_lineage(
+                (body or {}).get("plan_id", ""),
+                (body or {}).get("task_id", ""),
+                workspace_id=ws,
+            )
+            handler._write_json(200, {"ok": True, "count": count})
+            return
+    except WorkspaceContextError as exc:
+        handler._write_json(400, {"error": getattr(exc, "code", "invalid_workspace"),
+                                  "detail": str(exc)})
+        return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
