@@ -0,0 +1,174 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { buildMetricCaliberChartModel, metricCaliberLegendName } from '../node_modules/.cache/governance-metric-chart-model/metricChartModel.mjs';
+
+const metricValues = [
+  {
+    metric: 'GMV',
+    business_meaning: '商品交易总额',
+    caliber_values: [
+      { caliber: '商品口径(sum_price)', value: 98673972.48, note: '按商品售价合计，不含运费', source_table: 'dwd_fact_order_items' },
+      {
+        caliber: '商品含运口径(sum_price+freight)',
+        value: 114526618.8,
+        note: '商品售价+运费合计',
+        source_table: 'dwd_fact_order_items',
+      },
+      {
+        caliber: '支付口径(sum_payment_value)',
+        value: 125935820.72,
+        note: '按实际支付金额合计',
+        source_table: 'dwd_fact_payments',
+      },
+    ],
+  },
+  {
+    metric: '订单数',
+    business_meaning: '成交订单量',
+    caliber_values: [
+      { caliber: '去重订单数(count_distinct_order_id)', value: null, note: '按订单去重', source_table: 'dwd_fact_orders' },
+      { caliber: '明细行数(count_items)', value: 785616, note: '按明细行计数', source_table: 'dwd_fact_order_items' },
+      { caliber: '支付笔数(count_payments)', value: 795520, note: '按支付流水计数', source_table: 'dwd_fact_payments' },
+    ],
+  },
+  {
+    metric: '客单价',
+    business_meaning: '平均每客户贡献金额',
+    caliber_values: [
+      { caliber: 'GMV/下单客户数', value: null, note: '分母为客户数', source_table: 'dwd_fact_order_items+dwd_dim_customer' },
+      { caliber: 'GMV/总订单数', value: null, note: '分母为订单数', source_table: 'dwd_fact_order_items+dwd_fact_orders' },
+    ],
+  },
+  {
+    metric: '平均评分',
+    business_meaning: '订单评价均分',
+    caliber_values: [
+      { caliber: '全量平均(avg_all)', value: 4.088801951, note: '所有评价平均', source_table: 'dwd_fact_reviews' },
+      { caliber: '仅有评论平均(avg_with_comment)', value: 3.673630078, note: '仅有评论', source_table: 'dwd_fact_reviews' },
+    ],
+  },
+  {
+    metric: '退货率',
+    business_meaning: '订单取消/退货比例',
+    caliber_values: [
+      { caliber: '状态口径(canceled)', value: null, note: '按订单状态', source_table: 'dwd_fact_orders' },
+      { caliber: '评价口径(score_eq_1)', value: 0.11464, note: '按评分统计', source_table: 'dwd_fact_reviews' },
+    ],
+  },
+];
+
+const ghostFindings = [
+  ['订单数', '去重订单数(count_distinct_order_id)'],
+  ['客单价', 'GMV/下单客户数'],
+  ['客单价', 'GMV/总订单数'],
+  ['退货率', '状态口径(canceled)'],
+].map(([metric, caliber], index) => ({
+  id: `MGT-${index + 1}`,
+  severity: 'high',
+  category: 'metric_ghost',
+  object: { metric, caliber },
+  summary: '引用不存在的对象',
+}));
+
+function item(model, metric, caliber) {
+  const result = model.items.find(candidate => candidate.metric === metric && candidate.caliber === caliber);
+  assert.ok(result, `${metric} / ${caliber} should exist`);
+  return result;
+}
+
+function closeTo(actual, expected, tolerance = 0.05) {
+  assert.notEqual(actual, null);
+  assert.ok(Math.abs(actual - expected) <= tolerance, `${actual} should be within ${tolerance} of ${expected}`);
+}
+
+test('builds the real 3/3/2/2/2 metric groups with 8 available and 4 null slots', () => {
+  const model = buildMetricCaliberChartModel(metricValues, ghostFindings);
+
+  assert.deepEqual(
+    model.groups.map(group => group.metric),
+    ['GMV', '订单数', '客单价', '平均评分', '退货率'],
+  );
+  assert.deepEqual(
+    model.groups.map(group => group.slotCount),
+    [3, 3, 2, 2, 2],
+  );
+  assert.equal(model.totalCaliberCount, 12);
+  assert.equal(model.availableValueCount, 8);
+  assert.equal(model.missingValueCount, 4);
+  assert.equal(model.allValuesMissing, false);
+  assert.equal(model.items.filter(chartItem => chartItem.isGhost).length, 4);
+
+  closeTo(item(model, 'GMV', '商品口径(sum_price)').normalizedValue, 78.35);
+  closeTo(item(model, 'GMV', '商品含运口径(sum_price+freight)').normalizedValue, 90.94);
+  closeTo(item(model, 'GMV', '支付口径(sum_payment_value)').normalizedValue, 100);
+  closeTo(item(model, '订单数', '明细行数(count_items)').normalizedValue, 98.76);
+  closeTo(item(model, '订单数', '支付笔数(count_payments)').normalizedValue, 100);
+  closeTo(item(model, '平均评分', '全量平均(avg_all)').normalizedValue, 100);
+  closeTo(item(model, '平均评分', '仅有评论平均(avg_with_comment)').normalizedValue, 89.84);
+  closeTo(item(model, '退货率', '评价口径(score_eq_1)').normalizedValue, 100);
+});
+
+test('retains null definition slots without converting them to zero', () => {
+  const model = buildMetricCaliberChartModel(metricValues, ghostFindings);
+  const missing = model.items.filter(chartItem => chartItem.rawValue === null);
+
+  assert.equal(missing.length, 4);
+  assert.ok(missing.every(chartItem => chartItem.normalizedValue === null));
+  assert.deepEqual(
+    missing.map(chartItem => [chartItem.metric, chartItem.slotIndex, chartItem.slotCount]),
+    [
+      ['订单数', 0, 3],
+      ['客单价', 0, 2],
+      ['客单价', 1, 2],
+      ['退货率', 0, 2],
+    ],
+  );
+});
+
+test('reports an explicit all-null state for 5 metrics and 12 definitions', () => {
+  const allNullValues = metricValues.map(metric => ({
+    ...metric,
+    caliber_values: metric.caliber_values.map(caliber => ({ ...caliber, value: null })),
+  }));
+  const allGhosts = allNullValues.flatMap(metric =>
+    metric.caliber_values.map((caliber, index) => ({
+      id: `${metric.metric}-${index}`,
+      severity: 'high',
+      category: 'metric_ghost',
+      object: { metric: metric.metric, caliber: caliber.caliber },
+      summary: '引用不存在的对象',
+    })),
+  );
+
+  const model = buildMetricCaliberChartModel(allNullValues, allGhosts);
+
+  assert.equal(model.groups.length, 5);
+  assert.equal(model.totalCaliberCount, 12);
+  assert.equal(model.availableValueCount, 0);
+  assert.equal(model.missingValueCount, 12);
+  assert.equal(model.allValuesMissing, true);
+  assert.ok(model.items.every(chartItem => chartItem.rawValue === null && chartItem.normalizedValue === null));
+  assert.ok(model.items.every(chartItem => chartItem.isGhost));
+});
+
+test('matches ghost status only by the exact metric and caliber identity', () => {
+  const findings = [
+    ...ghostFindings,
+    { id: 'wrong-category', severity: 'high', category: 'metric_ghost_like', object: { metric: 'GMV', caliber: '商品口径(sum_price)' }, summary: '' },
+    { id: 'wrong-caliber', severity: 'high', category: 'metric_ghost', object: { metric: 'GMV', caliber: '商品口径' }, summary: '' },
+  ];
+
+  const model = buildMetricCaliberChartModel(metricValues, findings);
+
+  assert.equal(item(model, 'GMV', '商品口径(sum_price)').isGhost, false);
+  assert.equal(item(model, '订单数', '去重订单数(count_distinct_order_id)').isGhost, true);
+});
+
+test('keeps full caliber formulas while deriving concise legend labels', () => {
+  const model = buildMetricCaliberChartModel(metricValues, ghostFindings);
+
+  assert.ok(model.legendCalibers.includes('商品含运口径(sum_price+freight)'));
+  assert.equal(metricCaliberLegendName('商品含运口径(sum_price+freight)'), '商品含运口径');
+  assert.equal(metricCaliberLegendName('GMV/下单客户数'), 'GMV/下单客户数');
+});
