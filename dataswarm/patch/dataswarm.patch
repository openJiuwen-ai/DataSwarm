+    assert out["graph"]["nodes"], "nodes should not be empty"
+    nodes = {n["table"]: n for n in out["graph"]["nodes"]}
+    assert "dwd_orders" in nodes
+    assert nodes["dwd_orders"]["layer"] == "DWD"
+    assert nodes["dwd_orders"]["rowcount"] == 100
+    assert nodes["dws_orders_daily"]["layer"] == "DWS"
+    assert nodes["dwd_users"]["task_id"] == "t2"
+    # 跨库边前缀 db.table
+    cross_edge = next(e for e in out["graph"]["edges"] if e["task_id"] == "t2")
+    assert cross_edge["from"] == "other_db.ods_users"
+    assert cross_edge["to"] == "dwd_users"
+    # information_schema 查询字面拼接（Doris Nereids arity bug 禁占位符）
+    sql = patch_db_connector.query_dict_calls[0][1]
+    assert "TABLE_SCHEMA = 'olist'" in sql
