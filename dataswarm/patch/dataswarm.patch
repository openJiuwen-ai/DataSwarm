+        "sql": "SELECT 1", "row_count": 1, "truncated": False})
+    by_name = {c["name"]: c for c in result["checks"]}
+    assert by_name["time_coverage"]["status"] == "unknown"
+
+
+# ==========================================================================
+# Phase 5 · join_amplification 升级：快照表行数基线判定
+# ==========================================================================
+
+def test_join_amplification_branches():
+    """四分支：无 join pass / 基线内 pass / 超 3×fail / 基线缺失 unknown。"""
+    from jiuwenswarm.channels.web.dataagent.analysis.result_check import run_result_checks
+
+    join_sql = ("SELECT a.x, b.y FROM orders a JOIN payments b "
+                "ON a.order_id = b.order_id")
+
+    def by_name(r: dict) -> dict:
+        return {c["name"]: c for c in r["checks"]}["join_amplification"]
+
+    no_join = run_result_checks({"sql": "SELECT x FROM t", "row_count": 10},
+                                table_baselines={"t": 5})
+    assert by_name(no_join)["status"] == "pass"
+
+    within = run_result_checks({"sql": join_sql, "row_count": 500},
+                               table_baselines={"orders": 1000, "payments": 2000})
+    assert by_name(within)["status"] == "pass"
+
+    amplified = run_result_checks({"sql": join_sql, "row_count": 9000},
+                                  table_baselines={"orders": 1000, "payments": 2000})
+    check = by_name(amplified)
+    assert check["status"] == "fail" and "join 放大嫌疑" in check["detail"]
+
+    missing = run_result_checks({"sql": join_sql, "row_count": 9000})
+    assert by_name(missing)["status"] == "unknown"
+    partial = run_result_checks({"sql": join_sql, "row_count": 9000},
+                                table_baselines={"other": 10})
+    assert by_name(partial)["status"] == "unknown"  # 参与表缺基线不猜
