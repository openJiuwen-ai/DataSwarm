+def test_new_type_needs_no_db_connector_edit(tmp_path):
+    """注册 codec 后，引用解析与元数据操作由统一入口分发。
+
+    使用临时 SQLite 文件验证 parse_db_ref、tables、schema、list_indexes 和
+    show_create_table，无需修改 db_connector 或启动外部数据库。
+    """
+    import sqlite3
+
+    from jiuwenswarm.common import db_connector as dbc
+    from jiuwenswarm.common import ref_codec as rc
+
+    db_path = tmp_path / "probe.db"
+    conn = sqlite3.connect(db_path)
+    conn.execute("CREATE TABLE sales (id INTEGER PRIMARY KEY, amt REAL, note TEXT)")
+    conn.execute("CREATE INDEX idx_sales_amt ON sales(amt)")
+    conn.commit()
+    conn.close()
+
+    scheme = "probedb"
+    assert not rc.is_registered(scheme)
+
+    # 外部类型注册：复用 sqlite 族的连接与目录逻辑，只换 scheme
+    @rc.register_ref_codec
+    class ProbeRefCodec(dbc.SqliteRefCodec):
+        scheme = "probedb"
+        dialect = "sqlite"
+
+    try:
+        ref = f"{scheme}://{db_path.as_posix()}"
+
+        spec = dbc.parse_db_ref(ref)
+        assert spec["type"] == scheme, spec
+
+        listed = dbc.tables(ref)
+        assert "sales" in listed["tables"], listed
+
+        described = dbc.schema(ref, "sales")
+        cols = {c["name"]: c for c in described["columns"]}
+        assert set(cols) == {"id", "amt", "note"}, cols
+        assert cols["id"]["pk"] is True
+
+        indexes = dbc.list_indexes(ref, "sales")
+        assert any(i["name"] == "idx_sales_amt" for i in indexes["indexes"]), indexes
+
+        created = dbc.show_create_table(ref, "sales")
+        assert "CREATE TABLE" in created["create_sql"].upper(), created
+    finally:
+        rc._CODECS.pop(scheme, None)
+        dbc.close_all()
+
+    assert not rc.is_registered(scheme), "测试后未清理注册表，会污染其他用例"
