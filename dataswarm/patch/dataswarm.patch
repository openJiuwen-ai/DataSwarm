+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 导入 Ossie 语义模型弹窗（原独立「导入」页签收进指标页工具栏）。 */
+
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Button, inputClass } from '../_shared/ui';
+import { metricsV2Api, type V2ImportResult } from './api';
+import { X } from 'lucide-react';
+
+interface ImportModelDialogProps {
+  onClose: () => void;
+  onImported: () => void;
+}
+
+export function ImportModelDialog({ onClose, onImported }: ImportModelDialogProps) {
+  const { t } = useTranslation();
+  const [content, setContent] = useState('');
+  const [result, setResult] = useState<V2ImportResult | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  const doImport = () => {
+    setBusy(true);
+    setError('');
+    void (async () => {
+      try {
+        setResult(await metricsV2Api.importOssie(content));
+        onImported();
+      } catch (e) {
+        setError(e instanceof Error ? e.message : String(e));
+      } finally {
+        setBusy(false);
+      }
+    })();
+  };
+
+  const pickFile = (file: File | undefined) => {
+    if (!file) return;
+    void file.text().then(setContent);
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40" onClick={onClose}>
+      <div className="flex max-h-[85vh] w-full max-w-3xl flex-col rounded-lg border border-border bg-bg shadow-2xl"
+           onClick={(e) => e.stopPropagation()}>
+        <div className="flex items-center justify-between border-b border-border px-5 py-3">
+          <h3 className="text-base font-semibold text-text-strong">{t('biMetrics.import.title')}</h3>
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}>
+            <X size={18} />
+          </button>
+        </div>
+
+        <div className="flex-1 space-y-3 overflow-y-auto p-5">
+          <p className="text-sm text-text-muted">
+            {t('biMetrics.import.introBefore')}
+            <b>{t('biMetrics.import.candidateRevision')}</b>
+            {t('biMetrics.import.introAfter')}
+          </p>
+          <input type="file" accept=".yaml,.yml,.json" className="text-sm"
+                 onChange={(e) => pickFile(e.target.files?.[0])} />
+          <textarea
+            className={`${inputClass} h-72 font-mono text-xs`}
+            placeholder="version: 0.2.0.dev0&#10;name: ...&#10;datasets:&#10;- name: orders&#10;  ..."
+            value={content}
+            onChange={(e) => setContent(e.target.value)} />
+          {error && <div className="text-xs text-danger">{error}</div>}
+          {result && (
+            <div className="rounded border border-accent/40 bg-accent-subtle p-3 text-sm space-y-1">
+              <div className="font-medium text-text-strong">
+                {result.created
+                  ? t('biMetrics.import.success')
+                  : t('biMetrics.import.idempotent')}
+              </div>
+              <div className="text-text">
+                {t('biMetrics.import.resultCounts', {
+                  revisions: result.revisions.length,
+                  bindings: result.bindings.length,
+                  mappings: result.candidate_mappings.length,
+                })}
+              </div>
+              {result.revisions.map((ref) => (
+                <div key={ref} className="text-xs text-text-muted">{ref}</div>
+              ))}
+            </div>
+          )}
+        </div>
+
+        <div className="flex items-center justify-end gap-2 border-t border-border px-5 py-3">
+          <Button variant="ghost" onClick={onClose}>{t('biMetrics.import.close')}</Button>
+          <Button variant="primary" loading={busy} disabled={!content.trim()} onClick={doImport}>
+            {t('biMetrics.import.submit')}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
