+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/shortcut.py + service.build_context 串行短路单测。
+
+设计：``docs/archive/delivered/data-analysis-flow-shortcut-design.md`` §7 验收用例 V1-V9。
+
+- 判定四条件正反例（词法高档 / 单术语 / 无歧义 / 链唯一）
+- 短路包形态：无候选榜、选定指标即链指标、维值恒空、join 带出
+- 漏斗编排：短路命中只跑术语路；判定不过复用术语路结果补跑三路；
+  recall_more 永远全路；指标零候选标 no_metric_candidate + gap_terms
+"""
+from __future__ import annotations
+
+from jiuwenswarm.channels.web.dataagent.analysis import (
+    context_pack,
+    graph_expand,
+    recall as analysis_recall,
+    service,
+    shortcut,
+)
+from jiuwenswarm.channels.web.dataagent.analysis.graph_expand import Expansion
+from jiuwenswarm.channels.web.dataagent.analysis.model import (
+    GRAPH_MEASURES_PREFIX,
+    RecallHit,
+    RoadResult,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    DatabaseMeta,
+    DataSourceMeta,
+    JoinPathMeta,
+    MetadataSnapshot,
+    TableMeta,
+)
+
+
+# ==========================================================================
+# 夹具
+# ==========================================================================
+
+def _term_hit(term_id: str, name: str, *, lexical: float | None = 0.9,
+              vector: float | None = None, rrf: float = 0.016,
+              token: str = "") -> RecallHit:
+    channels: list[tuple[str, float]] = []
+    matched_on: list[str] = []
+    if lexical is not None:
+        channels.append(("lexical", lexical))
+        # 档位决定来源：精确别名恒 1.0，子串命中是 name/synonym 档（≤0.9）
+        matched_on.append("alias" if lexical >= 1.0 else "like")
+    if vector is not None:
+        channels.append(("vector", vector))
+        matched_on.append("emb")
+    return RecallHit(kind="term", entity_id=term_id, label=name, channels=channels,
+                     matched_on=matched_on, rrf_score=rrf,
+                     payload={"term_id": term_id, "name": name,
+                              "definition": f"{name}的口径", "synonyms": [],
+                              "matched_token": token or name})
+
+
+def _metric_hit(metric_key: str, term_id: str) -> RecallHit:
+    return RecallHit(kind="metric", entity_id=metric_key, label=metric_key,
+                     matched_on=[f"{GRAPH_MEASURES_PREFIX}:{term_id}"],
+                     payload={"metric_key": metric_key, "revision_id": "rev-1",
+                              "display_name": metric_key})
+
+
+def _expansion(metrics: list[RecallHit]) -> Expansion:
+    return Expansion(metrics=metrics, graph_status="ok", graph_path="graph_read")
+
+
+def _term_road(hits: list[RecallHit]) -> RoadResult:
+    return RoadResult("term", tuple(hits), "ok", raw_count=len(hits))
+
+
+def _snapshot(*, with_join: bool = False) -> MetadataSnapshot:
+    orders = [
+        ColumnMeta("src", "mysql", "shop", "orders", "order_id",
+                   data_type="bigint", ordinal=1, column_key="PRI", comment="订单号"),
+        ColumnMeta("src", "mysql", "shop", "orders", "amount_cny",
+                   data_type="decimal", ordinal=2, comment="订单金额"),
+        ColumnMeta("src", "mysql", "shop", "orders", "customer_id",
+                   data_type="bigint", ordinal=3, comment="客户ID"),
+    ]
+    customers = [
+        ColumnMeta("src", "mysql", "shop", "customers", "customer_id",
+                   data_type="bigint", ordinal=1, comment="客户ID"),
+        ColumnMeta("src", "mysql", "shop", "customers", "region",
+                   data_type="varchar", ordinal=2, comment="销售区域"),
+    ]
+    joins = []
+    if with_join:
+        joins.append(JoinPathMeta(
+            source_id="src", source_type="mysql",
+            left_column_id="col:mysql:src:shop.orders.customer_id",
+            right_column_id="col:mysql:src:shop.customers.customer_id",
+            left_table_id="tbl:mysql:src:shop.orders",
+            right_table_id="tbl:mysql:src:shop.customers",
+            source=["declared"], evidence={"level": "declared"}, status="confirmed"))
+    return MetadataSnapshot(
+        "snapshot:src:run-1", "run-1",
+        DataSourceMeta("src", "mysql", "mysql://db:3306/shop"),
+        [DatabaseMeta("src", "mysql", "shop")],
+        [
+            TableMeta("src", "mysql", "shop", "orders", columns=orders),
+            TableMeta("src", "mysql", "shop", "customers", columns=customers),
+        ],
+        joins=joins,
+    )
