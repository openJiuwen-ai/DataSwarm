+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""test_sql_scan_parity —— SQL 引用扫描对拍测试（S1，Phase 2 口径收敛的证据底座）。
+
+**对拍（同题差分）**：guard 原子（``out_of_scope_tables`` / ``out_of_scope_columns``，
+唯一标准出处）× ``generator._quick_validate``（explore 兜底重试环内的快校验）——
+两者回答同一道题「SQL 越没越界」，断言判定逐位等价（quick_validate 的
+首个违规短路只影响报告数量，不影响判定集合；归一口径见断言注释）。
+
+**豁免登记（异题锁定）**：E2 判定「问不同问题的两份」不收敛、显式登记——
+- ``result_check._check_group_key_uniqueness``：提取 GROUP BY 分组键**子集**做
+  结果语义验证（键组合唯一性），无允许集、不做越界判定；
+- ``ossie._column_refs``：从导入模型的表达式提取 ``table.column`` 依赖引用
+  （构建 Binding column_map），无允许集、输出带前缀形态。
+两者的行为在黄金样本上被钉死——任何一份漂移即红；重新登记须过评审，
+不许静默改。
+
+E2 收敛（generator 改调原子）前后本测试都必须绿——这就是「行为逐位一致」
+的机器证明。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import sqlglot
+
+from jiuwenswarm.channels.web.dataagent.analysis.model import (
+    CHECK_FAIL, CHECK_PASS, CHECK_UNKNOWN,
+)
+from jiuwenswarm.channels.web.dataagent.analysis import result_check
+from jiuwenswarm.channels.web.dataagent.metrics import generator, guard, ossie
+
+
+@dataclass(frozen=True)
+class GoldenSQL:
+    """对拍样本：SQL + 允许集（表/列）——两边实现喂同一份输入。"""
+
+    name: str
+    sql: str
+    allowed_tables: frozenset[str]
+    allowed_columns: frozenset[str]
+
+
+GOLDEN_SQL: tuple[GoldenSQL, ...] = (
+    GoldenSQL("in_scope_group",
+              "SELECT state, SUM(amount) AS gmv FROM orders "
+              "WHERE dt >= '2026-01-01' GROUP BY state",
+              frozenset({"orders"}), frozenset({"state", "amount", "dt"})),
+    GoldenSQL("table_out", "SELECT * FROM secret_table",
+              frozenset({"orders"}), frozenset({"state"})),
+    GoldenSQL("column_out", "SELECT salary FROM orders",
+              frozenset({"orders"}), frozenset({"state", "amount"})),
+    GoldenSQL("both_out", "SELECT password FROM vault",
+              frozenset({"orders"}), frozenset({"state"})),
+    GoldenSQL("join_qualified",
+              "SELECT o.state, SUM(o.amount) AS gmv FROM orders o "
+              "JOIN customers c ON o.customer_id = c.customer_id GROUP BY o.state",
+              frozenset({"orders", "customers"}),
+              frozenset({"state", "amount", "customer_id"})),
+    GoldenSQL("empty_allowed_no_fence", "SELECT anything FROM anywhere",
+              frozenset(), frozenset()),
+    GoldenSQL("star_in_scope", "SELECT * FROM orders",
+              frozenset({"orders"}), frozenset()),
+)
+
+
+def _schema_of(sample: GoldenSQL) -> dict:
+    """按允许集构造 generator 的 schema 切片形态（tables → 列清单）。
+
+    每个允许表映射全部允许列——generator 从 schema 推导的允许集与样本的
+    allowed_tables/allowed_columns 严格一致，对拍输入才同一。
+    """
+    return {"tables": {table: sorted(sample.allowed_columns)
+                       for table in sample.allowed_tables}}
+
+
+def test_quick_validate_parity_with_guard_atoms():
+    """同题差分：guard 原子 × generator 快校验，判定逐位等价。
+
+    归一口径：quick_validate 表优先短路（有表违规即返回、不查列），故期望列
+    违规仅在表违规为空时报告；判定等价 = 通过/不通过结论一致 + 首个违规对象
+    同一。收敛后 quick_validate 直接调原子，集合等价由结构保证。
+    """
+    for sample in GOLDEN_SQL:
+        parsed = sqlglot.parse_one(sample.sql, read="mysql")
+        out_tables = guard.out_of_scope_tables(parsed, set(sample.allowed_tables))
+        expect_columns = [] if out_tables else guard.out_of_scope_columns(
+            parsed, set(sample.allowed_columns))
+        feedback = generator._quick_validate(sample.sql, "mysql", _schema_of(sample))
+        label = f"[{sample.name}]"
+
+        if not out_tables and not expect_columns:
+            assert feedback is None, f"{label} 原子判界内，快校验却报: {feedback}"
+            continue
+        assert feedback is not None, f"{label} 原子判越界（表 {out_tables} 列 {expect_columns}），快校验却放行"
+        if out_tables:
+            assert "未授权的表" in feedback and out_tables[0] in feedback, \
+                f"{label} 首个越界表不一致：原子 {out_tables[0]}，快校验 {feedback}"
+        else:
+            assert "未声明的列" in feedback and expect_columns[0] in feedback, \
+                f"{label} 首个越界列不一致：原子 {expect_columns[0]}，快校验 {feedback}"
+
+
+def test_registered_exemption_result_check_group_key():
+    """豁免登记 ①：result_check 的分组键提取——问「结果分组键组合唯一吗」。
+
+    与 guard 原子不同题（无允许集、只取 GROUP BY 列子集、三态判定），
+    E2 判定豁免；此处钉死其黄金行为，漂移即红。
+    """
+    sql = "SELECT state, SUM(amount) FROM orders GROUP BY state"
+    # 键互异 → pass
+    ok = result_check._check_group_key_uniqueness(
+        sql, [{"state": "SP", "SUM(amount)": 1}, {"state": "RJ", "SUM(amount)": 2}])
+    assert (ok.name, ok.status) == ("group_key_uniqueness", CHECK_PASS)
+    # 键组合重复 → fail（join 放大或键选取错误的信号）
+    dup = result_check._check_group_key_uniqueness(
+        sql, [{"state": "SP", "SUM(amount)": 1}, {"state": "SP", "SUM(amount)": 3}])
+    assert dup.status == CHECK_FAIL and "组合重复" in dup.detail
+    # 无 GROUP BY → unknown（不适用，不是失败）
+    plain = result_check._check_group_key_uniqueness(
+        "SELECT state FROM orders", [{"state": "SP"}])
+    assert plain.status == CHECK_UNKNOWN and "无 GROUP BY" in plain.detail
+    # 输出缺分组键原始列（表达式/别名形态）→ unknown（无法验证，不猜）
+    aliased = result_check._check_group_key_uniqueness(
+        sql, [{"province_label": "SP"}])
+    assert aliased.status == CHECK_UNKNOWN
+
+
+def test_registered_exemption_ossie_column_refs():
+    """豁免登记 ③：ossie 的引用提取——问「导入公式依赖哪些列」。
+
+    与 guard 原子不同题（无允许集、纯提取、输出 table.column 带前缀形态，
+    服务 Binding column_map 构建）；E2 判定豁免；此处钉死其黄金行为。
+    """
+    ratio = sqlglot.parse_one(
+        "SUM(orders.amount_cny) / COUNT(DISTINCT orders.customer_id)", read="mysql")
+    assert ossie._column_refs(ratio) == ["orders.amount_cny", "orders.customer_id"]
+    bare = sqlglot.parse_one("amount_cny * 2", read="mysql")
+    assert ossie._column_refs(bare) == ["amount_cny"], "无表前缀时只留裸列名"
+    # 重复引用去重且保序（首个出现序）
+    repeated = sqlglot.parse_one(
+        "orders.amount_cny + orders.amount_cny", read="mysql")
+    assert ossie._column_refs(repeated) == ["orders.amount_cny"]
