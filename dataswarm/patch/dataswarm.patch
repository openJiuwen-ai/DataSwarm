+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Table and view removal can affect bindings without a column identity."""
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics.model import BINDING_FAILED
+from jiuwenswarm.channels.web.dataagent.semantic import impact
+from jiuwenswarm.channels.web.dataagent.semantic.fingerprint import ChangeEvent
+
+
+@pytest.mark.parametrize("kind,label", [("tbl", "表"), ("view", "视图")])
+def test_removed_table_or_view_downgrades_matching_bindings_without_column_lookup(monkeypatch, kind, label):
+    source_ref = "postgresql://fixture/app"
+    bindings = [
+        SimpleNamespace(binding_id="matched", datasource_ref=source_ref, source_table="app.orders", columns=["amount"]),
+        SimpleNamespace(binding_id="other-table", datasource_ref=source_ref, source_table="app.customers", columns=["amount"]),
+        SimpleNamespace(binding_id="other-source", datasource_ref="postgresql://other/app", source_table="app.orders", columns=["amount"]),
+    ]
+    updated, saved = [], []
+    monkeypatch.setattr(impact.workspace_context, "current_workspace", lambda: SimpleNamespace(workspace_id="fixture"))
+    monkeypatch.setattr(impact.metric_store, "list_defs", lambda workspace: [SimpleNamespace(current_revision_id="revision", metric_id="metric")])
+    monkeypatch.setattr(impact.metric_store, "list_bindings", lambda revision: bindings)
+    monkeypatch.setattr(impact.metric_store, "update_binding_status", lambda *args, **kwargs: updated.append((args, kwargs)))
+
+    def save(source_id, event, metric_id, reason):
+        saved.append(reason)
+        return {"metric_id": metric_id, "reason": reason}
+
+    monkeypatch.setattr(impact, "_save_alert", save)
+    event = ChangeEvent(f"{kind}:postgresql:source:app.orders", kind, "removed", "high")
+    alerts = impact.propagate("source", [event], source_ref)
+    assert len(updated) == 1 and updated[0][0] == ("matched", BINDING_FAILED)
+    assert updated[0][1]["verify_detail"] == f"{label} app.orders 已删除"
+    assert saved == [f"{label} app.orders 已删除"]
+    assert len(alerts) == 1
diff --git a/tests/unit_tests/dataagent/test_semantic_value_dict.py b/tests/unit_tests/dataagent/test_semantic_value_dict.py
