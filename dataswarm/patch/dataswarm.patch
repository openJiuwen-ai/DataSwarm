+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Source adapter protocol for physical metadata collection."""
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+
+from ..model import MetadataSnapshot
+
+
+@dataclass(frozen=True)
+class CollectionOptions:
+    schemas: tuple[str, ...]
+    include_profile: bool = True
+    profile_max_columns_per_table: int = 20
+    profile_top_k: int = 10
+    profile_sample_rows: int = 10000
+    exclude_patterns: tuple[str, ...] = ("*_bak_*", "tmp_*", "*_202[0-9]")
+    core_tables: tuple[str, ...] = ()
+
+
+class MetadataSourceAdapter(ABC):
+    """Collect one consistent metadata snapshot from a registered source."""
+
+    @abstractmethod
+    def collect(
+        self,
+        source: dict,
+        run_id: str,
+        snapshot_id: str,
+        options: CollectionOptions,
+    ) -> MetadataSnapshot:
+        """Collect and normalize one source snapshot."""
diff --git a/jiuwenswarm/channels/web/dataagent/semantic/adapters/connector.py b/jiuwenswarm/channels/web/dataagent/semantic/adapters/connector.py
new file mode 100644
index 000000000..a5a81e5c5
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/semantic/adapters/connector.py
@@ -0,0 +1,382 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Physical metadata from the shared connector catalog and schema contracts.
+
+The caller owns this adapter until ``close()``. A bounded, projected sample is
+cached per table so profiles and value dictionaries describe the same rows.
+Catalog/schema reads are not a database-wide transactional snapshot.
+"""
+from __future__ import annotations
+
+import fnmatch
+import json
+import re
+from collections import Counter, defaultdict
+from typing import Any
+
+from sqlglot import exp
+
+from jiuwenswarm.common.dialect_registry import logical_type, quote_ident, sqlglot_dialect
+
+from ...connectors.base import Connector, SqlQueryable, TabularScannable
+from ...connectors.manager import ConnectorManager
+from ..fingerprint import apply_fingerprints
+from ..model import ColumnMeta, DatabaseMeta, DataSourceMeta, JoinPathMeta, MetadataSnapshot, TableMeta
+from .base import CollectionOptions, MetadataSourceAdapter
+from .mysql import _infer_table_role, _json_value, _sensitivity, _topk_overlap, _type_family
+
+# The shared SQL connector query contract caps returned rows at 10,000.
+MAX_SAMPLE_ROWS = 10_000
+
+
+class ConnectorMetadataAdapter(MetadataSourceAdapter):
+    """Collect any supported connector without duplicating engine adapters."""
+
+    def __init__(self, source: dict | None = None):
+        self._source = dict(source or {})
+        self.connector: Connector | None = None
+        self.engine = ""
+        self.sql_source_type = ""
+        self.scope: dict[str, Any] = {}
+        self._datasets: dict[str, tuple[str, str | None]] = {}
+        self._samples: dict[str, dict] = {}
+        self._sample_limit = MAX_SAMPLE_ROWS
+        self._sample_ceiling = MAX_SAMPLE_ROWS
+
+    def collect(self, source: dict, run_id: str, snapshot_id: str,
+                options: CollectionOptions) -> MetadataSnapshot:
+        source_id = str(source.get("source_id") or "").strip()
+        source_type = str(source.get("source_type") or "").strip().lower()
+        if not source_id or not source_type:
+            raise ValueError("source_id and source_type are required")
+        if self.connector is not None:
+            raise ValueError("metadata adapter already collected a source; close it before reuse")
+        self._source = dict(source)
+        # The service already authorized this exact source row in its workspace.
+        # Do not resolve it again through the process-global source loader.
+        manager = ConnectorManager(lambda requested: self._source if requested == source_id else None)
+        definition = manager.source(source_id)
+        self.connector = manager.get(source_id)
+        self.engine = definition.engine
+        self.sql_source_type = source_type if self.engine == "sqlalchemy" else "duckdb"
+        config = definition.config
+        self._sample_ceiling = MAX_SAMPLE_ROWS
+        if self.engine == "sampled":
+            self._sample_ceiling = min(MAX_SAMPLE_ROWS, _positive_int(config.get("materialize_limit"), 50_000))
+        self._sample_limit = max(1, min(int(options.profile_sample_rows), self._sample_ceiling))
+        logical_database = str(config.get("database") or "default")
+        population = {"sampled": "bounded_sample", "staged": "staged_files",
+                      "schema_only": "metadata_only"}.get(self.engine, "source")
+        self.scope = {
+            "engine": self.engine,
+            "requested_schemas": list(options.schemas),
+            "schemas": [],
+            "exclude_patterns": list(options.exclude_patterns),
+            "population_scope": population,
+            "metadata_scope": "sampled_schema" if self.engine == "sampled" else "catalog",
+            "transactional_snapshot": False,
+            "profile": {"requested": bool(options.include_profile), "method": "bounded_rows",
+                        "requested_limit": int(options.profile_sample_rows),
+                        "effective_limit": self._sample_limit, "sensitive_values": "excluded",
+                        "value_types": "recognized_scalars"},
+            "schema_mapping": {},
+            "datasets": {},
+        }
+        if self.engine == "sampled":
+            self.scope["schema_sample_limit"] = _positive_int(config.get("sample_size"), 1000)
+            self.scope["materialize_limit"] = _positive_int(config.get("materialize_limit"), 50_000)
+        if self.engine == "schema_only":
+            self.scope["profile"].update(method="none", skipped_reason="metadata_only")
+        catalog = self.connector.catalog()
+        datasets = _catalog_datasets(catalog)
+        available_schemas = {str(item.get("schema") or logical_database) for item in datasets}
+        missing = set(options.schemas) - available_schemas
+        if missing:
+            raise ValueError("requested schemas are absent from the source catalog: " + ", ".join(sorted(missing)))
+
+        tables: list[TableMeta] = []
+        seen_ids: set[str] = set()
+        for item in sorted(datasets, key=lambda entry: (str(entry.get("schema") or ""), str(entry.get("name") or ""))):
+            name = str(item.get("name") or "")
+            sql_schema = str(item["schema"]) if item.get("schema") is not None else None
+            database = sql_schema or logical_database
+            if options.schemas and database not in options.schemas:
+                continue
+            if any(fnmatch.fnmatch(name.lower(), pattern.lower()) for pattern in options.exclude_patterns):
+                continue
+            if not name:
+                raise ValueError("source catalog contains an unnamed dataset")
+            # None means an unspecified namespace to the DDL connector; an
+            # empty string explicitly selects an unqualified catalog entry.
+            schema_selector = "" if self.engine == "schema_only" and sql_schema is None else sql_schema
+            metadata = self.connector.schema(name, schema_name=schema_selector)
+            table = TableMeta(
+                source_id, source_type, database, name,
+                table_type="VIEW" if str(item.get("type") or "").lower() == "view" else "BASE TABLE",
+                engine=self.engine, comment=str(metadata.get("comment") or item.get("comment") or ""),
+                # build_schema detects ds/dt-style names, which is only a
+                # candidate until a connector supplies partition evidence.
+                partition_key=str(metadata.get("partition_key") or "") if metadata.get("partition_type") else "",
+                partition_type=str(metadata.get("partition_type") or ""),
+                view_definition=str(metadata.get("view_definition") or ""),
+            )
+            if table.table_type == "VIEW" and not table.view_definition:
+                table.view_definition = str(metadata.get("ddl") or "")
+            primary_keys = set(metadata.get("primary_key") or [])
+            for ordinal, column in enumerate(metadata.get("columns") or [], 1):
+                column_name = str(column.get("name") or "")
+                if not column_name:
+                    raise ValueError("source schema contains an unnamed column")
+                sensitivity = _sensitivity(column_name, str(column.get("comment") or ""))
+                table.columns.append(ColumnMeta(
+                    source_id, source_type, database, name, column_name,
+                    data_type=str(column.get("type") or ""), column_type=str(column.get("type") or ""),
+                    ordinal=ordinal, nullable=bool(column.get("nullable", True)),
+                    column_key="PRI" if column.get("pk") or column_name in primary_keys else "",
+                    # A declared key is not proof of a reflected physical index.
+                    is_indexed=bool(column.get("is_indexed", False)),
+                    default_value=(None if sensitivity or not is_scalar_type(self.sql_source_type, column.get("type"))
+                                   else _serializable(column.get("default"))),
+                    comment=str(column.get("comment") or ""),
+                    is_sensitive=bool(sensitivity), sensitivity_class=sensitivity,
+                ))
+            # Canonical models use dotted IDs. Reject collisions (including
+            # quoted names containing dots) rather than overwriting graph nodes.
+            for object_id in [table.node_id, *(column.node_id for column in table.columns)]:
+                if object_id in seen_ids:
+                    raise ValueError("source metadata contains ambiguous duplicate object identities")
+                seen_ids.add(object_id)
+            tables.append(table)
+            self._datasets[table.node_id] = (name, sql_schema)
+            self.scope["schema_mapping"][table.node_id] = {"database": database, "sql_schema": sql_schema}
+            has_column_flags = any("is_indexed" in column for column in metadata.get("columns") or [])
+            self.scope["datasets"][table.node_id] = {
+                "dataset": name, "sql_schema": sql_schema, "population_scope": population,
+                "dataset_type": str(item.get("type") or "table"),
+                "format": str(item.get("format") or ""),
+                "index_metadata": "explicit_column_flags" if has_column_flags else "not_collected",
+            }
+            if metadata.get("partition_key") and not metadata.get("partition_type"):
+                self.scope["datasets"][table.node_id].update({
+                    "partition_key_candidate": str(metadata["partition_key"]),
+                    "partition_candidate_evidence": "column_name_heuristic",
+                })
+            if self.engine == "sampled" and isinstance(self.connector, TabularScannable):
+                # SampledStoreConnector.schema() omits these inference details;
+                # infer_schema reuses its existing cache at the same limit.
+                inferred = self.connector.infer_schema(name, sample=self.scope["schema_sample_limit"])
+                self.scope["datasets"][table.node_id].update({
+                    "schema_sampled": inferred.get("sampled"),
+                    "schema_columns": [{"name": str(column.get("name") or ""),
+                                        "presence": column.get("presence"),
+                                        "observed_types": list(column.get("observed_types") or [])}
+                                       for column in inferred.get("columns") or []],
+                    "schema_drift_fields": [{"name": str(column.get("name") or ""),
+                                             "observed_types": list(column.get("observed_types") or [])}
+                                            for column in inferred.get("drift_fields") or []],
+                })
+
+        schemas = sorted({table.database for table in tables})
+        self.scope["schemas"] = schemas
+        errors: list[dict] = []
+        for table in tables:
+            if options.include_profile and self.engine != "schema_only" and options.profile_max_columns_per_table > 0:
+                try:
+                    self._profile_table(table, options)
+                except Exception as exc:
+                    # Connector exceptions may contain connection URLs or data.
+                    errors.append({"stage": "profile", "table": table.fqn,
+                                   "type": type(exc).__name__, "message": "bounded profile collection failed"})
+                    self.scope["datasets"][table.node_id]["profile_status"] = "failed"
+            table.table_role, table.role_confidence, table.role_evidence = _infer_table_role(table)
+        snapshot = MetadataSnapshot(
+            snapshot_id, run_id,
+            DataSourceMeta(source_id, source_type, f"{source_type}://source/{source_id}",
+                          str(source.get("config_version") or 1)),
+            databases=[DatabaseMeta(source_id, source_type, schema) for schema in schemas],
+            tables=tables, scope=self.scope, errors=errors,
+        )
+        snapshot.joins = _inferred_joins(tables)
+        return apply_fingerprints(snapshot)
+
+    def dataset_for(self, table: TableMeta) -> tuple[str, str | None]:
+        """Return the physical dataset and schema, never its display database."""
+        try:
+            return self._datasets[table.node_id]
+        except KeyError:
+            raise ValueError("table does not belong to this metadata collection") from None
+
+    def quote_identifier(self, name: str) -> str:
+        return quote_ident(self.sql_source_type, name)
+
+    def qualified_table(self, table: TableMeta) -> str:
+        name, schema = self.dataset_for(table)
+        parts = [schema, name] if schema else [name]
+        return ".".join(self.quote_identifier(part) for part in parts)
+
+    def query(self, sql: str, *, limit: int = MAX_SAMPLE_ROWS) -> dict:
+        if not isinstance(self.connector, SqlQueryable):
+            raise ValueError("source provides metadata only; SQL data queries are unavailable")
+        return self.connector.query(sql, limit=limit)
+
+    def sample_table(self, table: TableMeta, limit: int | None = None) -> dict:
+        """Read one bounded non-sensitive sample, reused throughout this run.
+
+        A later request never widens or refetches the first sample. ``truncated``
+        describes this bounded read; ``population_scope`` also records cases
+        where the connector itself cannot promise a complete population.
+        """
+        name, schema = self.dataset_for(table)
+        if self.engine == "schema_only":
+            return {"columns": [], "rows": [], "row_count": 0, "truncated": False,
+                    "population_scope": "metadata_only", "skipped_reason": "metadata_only"}
+        cached = self._samples.get(table.node_id)
+        if cached is not None:
+            return cached
+        requested = self._sample_limit if limit is None else max(1, int(limit))
+        effective = min(requested, self._sample_ceiling)
+        names = [column.name for column in table.columns if not column.is_sensitive
+                 and is_scalar_type(self.sql_source_type, column.data_type)]
+        excluded = [
+            {"name": column.name, "reason": "sensitive" if column.is_sensitive else "non_scalar_or_unknown_type"}
+            for column in table.columns if column.name not in names
+        ]
+        result: dict[str, Any]
+        if not names:
+            result = {"columns": [], "rows": [], "truncated": False, "skipped_reason": "no_safe_columns"}
+        elif self.engine == "sampled" and isinstance(self.connector, TabularScannable):
+            result = self.connector.scan(name, projection=names, limit=effective + 1)
+        else:
+            target = exp.Table(this=exp.to_identifier(name, quoted=True))
+            if schema:
+                target.set("db", exp.to_identifier(schema, quoted=True))
+            statement = (exp.select(*(exp.column(column, quoted=True) for column in names))
+                         .from_(target).limit(effective + 1))
+            result = self.query(statement.sql(dialect=sqlglot_dialect(self.sql_source_type)), limit=effective)
+        if result.get("ok") is False:
+            raise ValueError("source connector rejected bounded sample query")
+        returned = list(result.get("columns") or [])
+        # Enforce the safe projection again at the connector boundary.
+        raw_rows = list(result.get("rows") or [])
+        non_scalar = (dict, list, tuple, set, bytes, bytearray, memoryview)
+        positions = []
+        for index, column in enumerate(returned):
+            if column not in names:
+                continue
+            if any(isinstance(row[index], non_scalar) for row in raw_rows[:effective]):
+                excluded.append({"name": column, "reason": "non_scalar_value"})
+                continue
+            positions.append((index, column))
+        rows = [[_serializable(row[index]) for index, _ in positions] for row in raw_rows[:effective]]
+        sample = {
+            "columns": [column for _, column in positions], "rows": rows, "row_count": len(rows),
+            "truncated": bool(result.get("truncated")) or len(raw_rows) > effective,
+            "population_scope": self.scope["population_scope"],
+            "requested_limit": requested, "effective_limit": effective,
+        }
+        if result.get("skipped_reason"):
+            sample["skipped_reason"] = result["skipped_reason"]
+        elif not positions:
+            sample["skipped_reason"] = "no_safe_values"
+        self._samples[table.node_id] = sample
+        self.scope["datasets"][table.node_id].update({
+            "profile_rows": len(rows), "profile_limit": effective,
+            "profile_truncated": sample["truncated"], "profile_scope": "bounded_rows",
+            "profile_status": "skipped" if sample.get("skipped_reason") else "collected",
+            "profile_excluded_columns": excluded,
+        })
+        return sample
+
+    def _profile_table(self, table: TableMeta, options: CollectionOptions) -> None:
+        sample = self.sample_table(table)
+        rows = sample["rows"]
+        if sample.get("skipped_reason"):
+            return
+        if not sample["truncated"] and self.engine not in {"sampled", "staged"}:
+            table.row_count, table.row_count_estimated = len(rows), False
+        positions = {name: index for index, name in enumerate(sample["columns"])}
+        for column in table.columns[:max(0, options.profile_max_columns_per_table)]:
+            if column.is_sensitive or column.name not in positions:
+                continue
+            values = [row[positions[column.name]] for row in rows]
+            column.null_ratio = round(sum(value is None for value in values) / len(values), 6) if values else 0.0
+            counts: Counter[str] = Counter()
+            decoded = {}
+            for value in values:
+                if value is not None:
+                    key = json.dumps(value, ensure_ascii=False, sort_keys=True)
+                    counts[key] += 1
+                    decoded[key] = value
+            column.distinct_count = len(counts)
+            column.top_k = [{"value": decoded[key], "count": count}
+                            for key, count in counts.most_common(max(0, options.profile_top_k))]
+
+    def close(self) -> None:
+        connector, self.connector = self.connector, None
+        self._samples.clear()
+        self._datasets.clear()
+        if connector is not None:
+            connector.close()
+
+
+def _catalog_datasets(catalog: dict) -> list[dict]:
+    if "datasets" in catalog:
+        return list(catalog["datasets"])
+    return [{**table, "schema": schema.get("name") or None}
+            for schema in catalog.get("schemas") or [] for table in schema.get("tables") or []]
+
+
+def _positive_int(value: Any, default: int) -> int:
+    try:
+        return max(1, int(value or default))
+    except (TypeError, ValueError):
+        return default
+
+
+def _serializable(value: Any) -> Any:
+    # Handles nested JSON, decimals, dates, binary and driver-specific scalars.
+    return json.loads(json.dumps(_json_value(value), ensure_ascii=False, default=str))
+
+
+def is_scalar_type(source_type: str, physical_type: Any) -> bool:
+    """Identify safe scalar types for both profiles and value dictionaries.
+
+    Unlike logical_type, preserve array/container distinctions. ENUM and SET
+    member strings are literals, so words inside them are not type syntax.
+    """
+    physical = str(physical_type or "").upper()
+    type_head = physical.split("(", 1)[0].strip()
+    # logical_type deliberately strips array suffixes for SQL typing; profiles
+    # must not let INTEGER[] or a nested STRUCT pass as scalar values.
+    if ("[" in type_head or re.search(r"\)\s*(?:\[|ARRAY\b)", physical)
+            or re.search(r"\b(?:ARRAY|LIST|MAP|STRUCT|UNION|VARIANT|MIXED)\b", type_head)):
+        return False
+    return logical_type(source_type, physical) in {"numeric", "text", "time", "bool"}
+
+
+def _inferred_joins(tables: list[TableMeta]) -> list[JoinPathMeta]:
+    """Reuse MySQL's conservative naming heuristic with canonical typed IDs."""
+    by_name: dict[str, list[tuple[TableMeta, ColumnMeta]]] = defaultdict(list)
+    for table in tables:
+        if table.table_type == "VIEW":
+            continue
+        for column in table.columns:
+            if column.name.lower().endswith("_id") and not column.is_sensitive:
+                by_name[column.name.lower()].append((table, column))
+    joins = []
+    for name, entries in by_name.items():
+        for index, (left_table, left_column) in enumerate(entries):
+            for right_table, right_column in entries[index + 1:]:
+                if (left_table.node_id == right_table.node_id
+                        or _type_family(left_column.data_type) != _type_family(right_column.data_type)):
+                    continue
+                overlap = _topk_overlap(left_column, right_column)
+                evidence: dict[str, Any] = {"level": "inferred", "naming": name, "profile_scope": "bounded_rows"}
+                if overlap is not None:
+                    evidence["overlap_ratio"] = overlap
+                joins.append(JoinPathMeta(
+                    left_table.source_id, left_table.source_type, left_column.node_id, right_column.node_id,
+                    left_table.node_id, right_table.node_id,
+                    confidence=0.5 if overlap is None else min(0.8, 0.5 + overlap / 2),
+                    source=["naming_convention"], evidence=evidence, status="candidate",
+                ))
+    return joins
