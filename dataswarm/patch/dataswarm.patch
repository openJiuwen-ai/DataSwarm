+    _write_config(monkeypatch, tmp_path, _TWO_WS)
+    # 命中 ecommerce 的业务库 → 放行并返回该工作空间的规范 ref
+    assert wc.validate_ref_in_workspace(
+        None, "business", "sqlite:///ecommerce.db") == "sqlite:///ecommerce.db"
+    # 命中 bank 的元数据库 → 放行
+    assert wc.validate_ref_in_workspace(
+        None, "metadata", "sqlite:///meta_bank.db") == "sqlite:///meta_bank.db"
+    # 不属于任何工作空间 → 拒绝
