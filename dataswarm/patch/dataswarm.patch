+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""PythonExecutor workspace 上下文透传单测（2026-09-15 探针任务回归）。
+
+实测背景：编排 Python 节点子进程 env 无 JIUWENSWARM_WORKSPACE_ID、ContextVar
+传不进子进程 → 节点代码调 workspace_context.current_workspace() 在多工作空间
+配置下大声失败（WorkspaceContextRequired）。修复：执行器在编排链路已 set_current
+的作用域内解析 workspace，注入子进程 env（与 bash 工具链 bash_tool_safety 同口径）。
+"""
+from __future__ import annotations
+
+import textwrap
+
+from jiuwenswarm.common import workspace_context as wc
+
+
+PROBE_CODE = textwrap.dedent("""
+    import os
+    print("WS_ENV:" + os.environ.get("JIUWENSWARM_WORKSPACE_ID", "<ABSENT>"))
+""")
+
+
+def _run_probe(code: str, tmp_path) -> tuple[str, str]:
+    """跑一次 PythonExecutor，返回 (stdout, stderr) 文本。"""
+    from jiuwenswarm.channels.web.orchestration.executors.python_executor import PythonExecutor
+
+    artifact_dir = tmp_path / "artifact"
+    result = PythonExecutor().run(
+        code=code,
+        params={},
+        datasource_ref=None,
+        timeout_s=60,
+        artifact_dir=artifact_dir,
+        log_prefix="node",
+    )
+    assert result.status == "success", \
+        f"executor failed: {result.error_message}; stderr={_read(artifact_dir, 'node.stderr.log')}"
+    return _read(artifact_dir, "node.stdout.log"), _read(artifact_dir, "node.stderr.log")
+
+
+def _read(artifact_dir, name: str) -> str:
+    p = artifact_dir / name
+    return p.read_text(encoding="utf-8") if p.is_file() else ""
+
+
+def test_python_executor_injects_workspace_env(tmp_path, monkeypatch):
+    """编排链路已 set_current：子进程 env 必须带 workspace_id。"""
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
+    # 桩注册表：不读开发者机器的真实 ~/.jiuwenswarm/（未必有 default 工作空间）
+    monkeypatch.setattr(wc, "_workspace_records", lambda: [
+        wc.WorkspaceContext("default", "默认工作空间", "sqlite://x.db", "sqlite://x.db")])
+    token = wc.set_current("default")
+    try:
+        stdout, _ = _run_probe(PROBE_CODE, tmp_path)
+    finally:
+        wc.reset(token)
+    assert "WS_ENV:default" in stdout
+
+
+def test_python_executor_no_context_leaves_env_absent(tmp_path, monkeypatch):
+    """无 workspace 配置（单空间/legacy）：不注入，env 保持 ABSENT，执行不失败。
+
+    current_workspace() 单空间静默返回 workspace_id=""（空串），执行器对空串
+    不写 env——子进程与修复前行为一致。
+    """
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    monkeypatch.setattr(wc, "_config_path",
+                        lambda: tmp_path / "nonexistent_datasource.yaml")
+    monkeypatch.setattr(wc, "_workspace_records", lambda: [
+        wc.WorkspaceContext("", "默认", "sqlite://x.db", "sqlite://x.db")])
+    stdout, _ = _run_probe(PROBE_CODE, tmp_path)
+    assert "WS_ENV:<ABSENT>" in stdout
