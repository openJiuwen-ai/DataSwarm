+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import { useLayoutEffect, useRef, useState } from 'react';
+import { Table } from '../../../../components/ui/Table/Table';
+import { Pagination } from '../../../../components/ui/Pagination/Pagination';
+import { useDataManagementStore } from '../../store/dataManagementStore';
+
+/** 数据单元格：单行显示、受 .dm-cell 宽度上限截断；仅在实际截断时挂 title 显示全值。
+ *  用 ResizeObserver 监听宽度变化（列宽冻结/容器缩放都会改变截断状态） */
+function PreviewCell({ value }: { value: string }) {
+  const ref = useRef<HTMLDivElement>(null);
+  const [truncated, setTruncated] = useState(false);
+
+  useLayoutEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    const check = () => setTruncated(el.scrollWidth > el.clientWidth);
+    check();
+    const ro = new ResizeObserver(check);
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, [value]);
+
+  return (
+    <div ref={ref} className="dm-cell" title={truncated ? value : undefined}>
+      {value}
+    </div>
+  );
+}
+
+export function DataPreview() {
+  const { t } = useTranslation();
+  const { preview, previewError, tableDetail, previewOffset, previewLimit, loadPreview, setPreviewLimit } =
+    useDataManagementStore();
+  const [loading, setLoading] = useState(false);
+
+  const load = async () => {
+    if (loading) return;
+    setLoading(true);
+    try {
+      await loadPreview();
+    } finally {
+      setLoading(false);
+    }
+  };
+  if (tableDetail?.preview_supported === false) {
+    return <div className="dm-empty-state">{t('dataManagement.preview.unsupported')}</div>;
+  }
+  if (!preview) {
+    return (
+      <div className="dm-empty-state">
+        {previewError && <p role="alert">{previewError}</p>}
+        <p>{t('dataManagement.preview.waiting')}</p>
+        {previewError && (
+          <button type="button" className="dm-btn" onClick={() => void load()} disabled={loading}>
+            {t('dataManagement.preview.load')}
+          </button>
+        )}
+      </div>
+    );
+  }
+
+  const total = preview.total;
+  const knownTotal = typeof total === 'number';
+  const pageCount = knownTotal ? Math.max(1, Math.ceil(total / previewLimit)) : Infinity;
+  // 页码由 store 的 previewOffset 派生（与 preview 数据同步更新，唯一真源）
+  const page = Math.min(Math.floor(previewOffset / previewLimit), pageCount - 1);
+
+  const goTo = async (next: number) => {
+    const target = Math.max(0, Math.min(next, pageCount - 1));
+    if (target === page || loading) return;
+    setLoading(true);
+    await loadPreview(target * previewLimit, previewLimit);
+    setLoading(false);
+  };
+
+  const changeLimit = async (limit: number) => {
+    if (limit === previewLimit || loading) return;
+    setLoading(true);
+    await setPreviewLimit(limit);
+    setLoading(false);
+  };
+
+  return (
+    <div className="dm-preview">
+      {previewError && <p role="alert">{previewError}</p>}
+      {preview.sampled || preview.materialize_truncated?.length || preview.truncated ? (
+        <p role="status">{t('dataManagement.preview.partial')}</p>
+      ) : null}
+      {preview.window_truncated && <p role="status">{t('dataManagement.preview.windowLimit')}</p>}
+      <Table className="dm-preview-wrap" headers={preview.columns}>
+        {preview.rows.map((row, i) => (
+          <tr key={i}>
+            {row.map((cell, j) => (
+              <td key={j}>
+                {cell === null ? <span className="dm-null-badge">null</span> : <PreviewCell value={String(cell)} />}
+              </td>
+            ))}
+          </tr>
+        ))}
+      </Table>
+      {knownTotal ? (
+        <Pagination
+          total={total}
+          page={page + 1}
+          pageSize={previewLimit}
+          onPageChange={(next) => void goTo(next - 1)}
+          onPageSizeChange={(limit) => void changeLimit(limit)}
+          loading={loading}
+          labels={{
+            total: t('common.pagination.total', { count: total }),
+            pageSize: t('common.pagination.pageSize'),
+            previous: t('common.pagination.previous'),
+            next: t('common.pagination.next'),
+            page: (item) => t('common.pagination.page', { page: item }),
+            navLabel: t('common.pagination.navLabel'),
+          }}
+        />
+      ) : (
+        <div className="ui-pagination">
+          <span>
+            {t('dataManagement.preview.unknownTotal', {
+              start: preview.rows.length ? previewOffset + 1 : 0,
+              end: preview.rows.length ? previewOffset + preview.rows.length : 0,
+            })}
+          </span>
+          <nav className="ui-pagination-pager" aria-label={t('common.pagination.navLabel')}>
+            <select
+              value={previewLimit}
+              onChange={(event) => void changeLimit(Number(event.target.value))}
+              disabled={loading}
+              aria-label={t('common.pagination.pageSize')}
+            >
+              {[10, 20, 50, 100].map((size) => (
+                <option key={size} value={size}>
+                  {size}
+                </option>
+              ))}
+            </select>
+            <button
+              type="button"
+              className="dm-btn"
+              disabled={!previewOffset || loading}
+              onClick={() => void goTo(page - 1)}
+            >
+              {t('common.pagination.previous')}
+            </button>
+            <span>{t('common.pagination.page', { page: page + 1 })}</span>
+            <button
+              type="button"
+              className="dm-btn"
+              disabled={!preview.has_more || loading}
+              onClick={() => void goTo(page + 1)}
+            >
+              {t('common.pagination.next')}
+            </button>
+          </nav>
+        </div>
+      )}
+    </div>
+  );
+}
