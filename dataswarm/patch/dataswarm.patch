+
+// 等待审核（节点模板 wait_review 与运行态 waiting_review 共用视觉家族，琥珀系）
+const REVIEW_COLOR = 'var(--color-feedback-waiting-review)';
+// 运行态顶部状态条与看板图例共用语义色。
+// skipped 语义是"未执行"，走中性色而非警示色。
+export const WORKFLOW_STATUS_STYLE: Record<string, { color: string; subtle: string }> = {
+  queued: { color: 'var(--color-feedback-queued)', subtle: 'var(--color-feedback-queued-subtle)' },
