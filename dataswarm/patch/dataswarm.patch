+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 分析追踪页（流程评审）：分析会话列表 + 四层链路时间线详情。
+ *
+ * 数据面 = analysis_flow.py 落盘的 manifest.json（只读），不动主链路。
+ * 评审目标：每一层「命中了什么、为什么、检查了什么、执行了什么」全部
+ * 可见——L1 四路命中实体明细（RRF 分/原始分/来源归因）→ 上下文三子包 →
+ * L2 计划成分（含过滤值状态）→ L3 逐成分 判断→探索→检查→执行（SQL 原文、
+ * guard、check_results、G 等级、CSV）→ 未完成成分与警告。
+ */
+
+import { useCallback, useEffect, useState } from 'react';
+import { analysisTraceApi } from './api/analysisTraceApi';
+import {
+  attemptLabel,
+  authorityLabel,
+  explorationLimit,
+  llmEntriesForExplore,
+  llmHeaderLabel,
+  matchLlmEntry,
+  prettyJsonText,
+  traceDecisionEntries,
+} from './traceModel';
+import type {
+  AnalysisComponent,
+  AnalysisManifest,
+  AnalysisSessionSummary,
+  ComponentAttempt,
+  LlmTraceEntry,
+  RecallHitView,
+  SchemaTablePackView,
+} from './api/analysisTraceApi';
+
+const GROUNDING_LABEL: Record<string, string> = {
+  G1: 'G1 指标定义上下文（参考已发布口径）',
+  G2: 'G2 治理 schema（探索口径）',
+  G3: 'G3 临时 scope（探索口径）',
+};
+
+const CHANNEL_LABEL: Record<string, string> = {
+  terms: '术语路',
+  metrics: '指标路',
+  schema: 'schema 路',
+  values: '维值路',
+  entities: '业务实体路',
+  mappings: '业务映射路',
+  rules: '业务规则发现路',
+};
+
+const KIND_LABEL: Record<string, string> = {
+  term: '术语',
+  metric: '指标',
+  column: '列',
+  table: '表',
+  value: '维值',
+  entity: '业务实体',
+  mapping: '业务映射',
+  rule: '业务规则',
+};
+
+function statusColor(status: string): string {
+  if (status === 'pass' || status === 'done' || status === 'ok' || status === 'sufficient' || status === 'verified' || status === 'completed') {
+    return 'bg-ok-subtle text-ok';
+  }
+  if (status === 'fail' || status === 'failed' || status === 'infeasible' || status === 'rejected') {
+    return 'bg-danger-subtle text-danger';
+  }
+  if (status === 'unknown' || status === 'unavailable' || status === 'no_hit' || status === 'clarify' || status === 'candidate' || status === 'retrying' || status === 'qualified' || status === 'partial') {
+    return 'bg-warn-subtle text-warn';
+  }
+  return 'bg-bg-muted text-text-muted';
+}
+
+function levelColor(level: string): string {
+  if (level === 'declared') return 'bg-emerald-100 text-emerald-800';
+  if (level === 'lineage') return 'bg-sky-100 text-sky-800';
+  if (level === 'inferred') return 'bg-amber-100 text-amber-800';
+  return 'bg-slate-100 text-slate-600';
+}
+
+function Badge({ children, tone }: { children: React.ReactNode; tone: string }) {
+  return (
+    <span className={`inline-flex items-center rounded px-1.5 py-0.5 text-[11px] font-medium ${tone}`}>
+      {children}
+    </span>
+  );
+}
+
+/** SQL 原文块（等宽、可滚动，评审核心素材） */
+function SqlBlock({ sql }: { sql: string }) {
+  return (
+    <pre className="mt-1 max-h-40 overflow-auto rounded bg-slate-50 p-2 font-mono text-[11px] leading-relaxed text-slate-800">
+      {sql}
+    </pre>
+  );
+}
+
+/** LLM_ROLE 三档的徽标色与文案（与 G 等级徽标色系对齐：生成=indigo/决策=amber/确定性=slate） */
+const LLM_ROLE_META: Record<string, { tone: string; label: string }> = {
+  generation: { tone: 'bg-indigo-100 text-indigo-800', label: 'LLM 生成' },
+  decision: { tone: 'bg-amber-100 text-amber-800', label: 'LLM 决策' },
+  deterministic: { tone: 'bg-slate-100 text-slate-600', label: '确定性 · 零 LLM' },
+};
+
+/** 步骤级 LLM 链接：点击展开该步给 LLM 的上下文摘要与 AI 产出（llm_trace 未采集时整块不渲染） */
+function LlmStepLink({ entries }: { entries: LlmTraceEntry[] }) {
+  if (entries.length === 0) return null;
+  return (
+    <details className="inline">
+      <summary className="cursor-pointer text-[11px] text-text-link hover:underline">LLM · 查看输入与产出</summary>
+      <div className="mt-1 space-y-2 rounded border border-border bg-surface p-2 text-left">
+        {entries.map((entry, i) => {
+          const meta = LLM_ROLE_META[entry.llm_role ?? ''] ?? { tone: 'bg-slate-100 text-slate-600', label: entry.llm_role ?? '未知' };
+          return (
+            <div key={`${entry.step}-${i}`} className="text-[11px]">
+              <div className="flex flex-wrap items-baseline gap-2">
+                <Badge tone={meta.tone}>{meta.label}</Badge>
+                <span className="font-mono">{entry.step}</span>
+                {entry.component_id && <span className="font-mono text-text-muted">{entry.component_id}</span>}
+                {entry.at && <span className="text-[10px] text-text-muted">{entry.at.replace('T', ' ')}</span>}
+              </div>
+              {entry.context_digest && <p className="mt-0.5 text-text-muted">{entry.context_digest}</p>}
+              {entry.context_payload && (
+                <details className="mt-0.5 rounded border border-border bg-bg-elevated p-1.5">
+                  <summary className="cursor-pointer text-text-link hover:underline">
+                    给 LLM 的输入（{entry.context_payload.length} 字符{entry.context_truncated ? '，已截断' : ''}）
+                  </summary>
+                  <pre className="mt-1 max-h-72 overflow-auto whitespace-pre-wrap break-all rounded bg-slate-50 p-2 font-mono text-[11px] leading-relaxed text-slate-800">
+                    {prettyJsonText(entry.context_payload)}
+                  </pre>
+                </details>
+              )}
+              {entry.ai_output && (
+                <details className="mt-0.5 rounded border border-border bg-bg-elevated p-1.5">
+                  <summary className="cursor-pointer text-text-link hover:underline">
+                    AI 产出（{entry.ai_output.length} 字符{entry.ai_output_truncated ? '，已截断' : ''}）
+                  </summary>
+                  <pre className="mt-1 max-h-60 overflow-auto whitespace-pre-wrap break-all rounded bg-slate-50 p-2 font-mono text-[11px] leading-relaxed text-slate-800">
+                    {prettyJsonText(entry.ai_output)}
+                  </pre>
+                </details>
+              )}
+              {entry.refs?.length ? <p className="mt-0.5 text-text-muted">详见：{entry.refs.join(' · ')}</p> : null}
+            </div>
+          );
+        })}
+      </div>
+    </details>
+  );
+}
+
+/** 键值对行（探索动作参数等结构化渲染） */
+function KeyValueRows({ entries }: { entries: Array<[string, unknown]> }) {
+  return (
+    <div className="mt-0.5 space-y-0.5">
+      {entries.map(([k, v]) => (
+        <p key={k} className="text-[11px] text-text-muted">
+          <span className="font-mono text-text">{k}</span>
+          <span className="mx-1">=</span>
+          {typeof v === 'object' && v !== null ? JSON.stringify(v) : String(v)}
+        </p>
+      ))}
+    </div>
+  );
+}
+
+/** 检查结果表（check_results / result_checks / guard 共用形态） */
+function CheckTable({ checks, title }: { checks: Array<{ name: string; status: string; detail: string }>; title: string }) {
+  if (!checks?.length) return null;
+  return (
+    <div className="mt-1">
+      {title && <p className="text-[11px] text-text-muted">{title}</p>}
