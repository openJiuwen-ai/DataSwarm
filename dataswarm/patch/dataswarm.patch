+    return "6 类写/导出操作被拒（护栏复用 DuckDB 路径，未因暂存而绕过）"
+
+
+def d_multi_statement_and_dialect():
+    conn = connector_for()
+    expect_raises(lambda: conn.query("SELECT 1; DROP TABLE t"),
