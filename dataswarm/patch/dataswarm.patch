@@ -0,0 +1,111 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+type ListQuery = { q: string; page: number; size: number };
+function readQuery(): ListQuery {
+  const params = new URLSearchParams(window.location.search);
+  const size = Number(params.get('size'));
+  const page = Number(params.get('page'));
+  return {
+    q: params.get('q') ?? '',
+    page: Number.isInteger(page) && page > 0 ? page : 1,
+    size: [10, 20, 50, 100].includes(size) ? size : 10,
+  };
+}
+export function useListControls() {
+  const [query, setQuery] = useState(() => readQuery());
+  const [search, setSearch] = useState(query.q);
+  const [composing, setComposing] = useState(false);
+  useEffect(() => {
+    if (composing) return;
+    const timer = window.setTimeout(() => {
+      setQuery((current) => (current.q === search.trim() ? current : { ...current, q: search.trim(), page: 1 }));
+    }, 300);
+    return () => window.clearTimeout(timer);
+  }, [search, composing]);
+  useEffect(() => {
+    const restore = () => {
+      const next = readQuery();
+      setQuery(next);
+      setSearch(next.q);
+    };
+    window.addEventListener('popstate', restore);
+    return () => window.removeEventListener('popstate', restore);
+  }, []);
+  useEffect(() => {
+    const params = new URLSearchParams(window.location.search);
+    params.delete('status');
+    params.delete('trigger');
+    for (const [key, value] of Object.entries(query)) {
+      if (value) params.set(key, String(value));
+      else params.delete(key);
+    }
+    window.history.replaceState(window.history.state, '', `${window.location.pathname}?${params}`);
+  }, [query]);
+  const setPage = useCallback((page: number) => setQuery((current) => ({ ...current, page })), []);
+  const setPageSize = useCallback((size: number) => setQuery((current) => ({ ...current, size, page: 1 })), []);
+  return {
+    search,
+    setSearch,
+    setComposing,
+    debouncedQ: query.q,
+    page: query.page,
+    pageSize: query.size,
+    setPage,
+    setPageSize,
+  };
+}
+
+/** Only the current request can change the visible page. A null loader disables list requests. */
+export function useListQuery<T, Meta = undefined>(
+  load: (() => Promise<{ items: T[]; total: number; meta?: Meta }>) | null,
+) {
+  const [items, setItems] = useState<T[]>([]);
+  const [total, setTotal] = useState(0);
+  const [meta, setMeta] = useState<Meta>();
+  const [loading, setLoading] = useState(!!load);
+  const [error, setError] = useState<string | null>(null);
+  const [errorDismissed, setErrorDismissed] = useState(false);
+  const [hasLoaded, setHasLoaded] = useState(false);
+  const dismissError = useCallback(() => setErrorDismissed(true), []);
+  const generation = useRef(0);
+  const reload = useCallback(async () => {
+    const request = ++generation.current;
+    setLoading(!!load);
+    setError(null);
+    setErrorDismissed(false);
+    if (!load) return;
+    try {
+      const result = await load();
+      if (request !== generation.current) return;
+      setItems(result.items);
+      setTotal(result.total);
+      setMeta(result.meta);
+      setHasLoaded(true);
+    } catch (e) {
+      if (request === generation.current) setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      if (request === generation.current) setLoading(false);
+    }
+  }, [load]);
+  useEffect(() => {
+    setItems([]);
+    setMeta(undefined);
+    setHasLoaded(false);
+    void reload();
+    return () => {
+      generation.current += 1;
+    };
+  }, [reload]);
+  return {
+    items,
+    total,
+    meta,
+    loading,
+    error,
+    visibleError: errorDismissed ? null : error,
+    dismissError,
+    hasLoaded,
+    reload,
+  };
+}
