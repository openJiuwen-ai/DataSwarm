@@ -0,0 +1,207 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo, useState } from 'react';
+import { Empty } from './shared/Ui';
+import { useGovernanceStore } from '../store/governanceStore';
+import type { ArtifactMap, Finding } from '../types/inspection';
+import { DIM_COLOR } from '../govTheme';
+
+/**
+ * 修复方案页 —— 只做一件事：帮用户把勾选的问题变成一条人话请求发给治理助手，
+ * 由对话按标准四步走完整个修复闭环（docs/governance/governance-fix-execution-plan.md Part A）：
+ *
+ *   1.了解问题（agent 先讲清现象/根因/影响）
+ *   2.AI 出方案（含高危项标注：仅出方案不动手）
+ *   3.人工确定（对话内回复"确认 编号"）
+ *   4.执行并汇报（agent 调 /fix/execute，结果汇总贴回对话）
+ *
+ * 本页面不再渲染计划预览/执行面板——那是上一版的过度设计（用户反馈：确认应只在对话发生）。
+ */
+
+// artifact key → 维度名。column-lineage/root-cause 归血缘。
+const DIMENSION_OF: Record<string, string> = {
+  schema: 'Schema', data: '数据质量', zscore: '数据质量',
+  lineage: '血缘', 'column-lineage': '血缘', 'root-cause': '血缘',
+  metric: '指标', task: '任务',
+};
+
+function collectFindings(artifacts: ArtifactMap): { dim: string; finding: Finding }[] {
+  const out: { dim: string; finding: Finding }[] = [];
+  for (const [key, artifact] of Object.entries(artifacts)) {
+    const dim = DIMENSION_OF[key];
+    if (!dim || !artifact?.findings) continue;
+    for (const finding of artifact.findings) out.push({ dim, finding });
+  }
+  return out;
+}
+
+/** 原始编号 + uid 尾 4 位做消歧短 ID（同 run 里 NUL-001 会跨表重复）。 */
+function shortTag(f: Finding): string {
+  const tail = (f.finding_uid ?? '').slice(-4);
+  const base = f.source_finding_id ?? f.id;
+  return tail ? `${base}·${tail}` : base;
+}
+function subjText(f: Finding): string {
+  const o = (f.object ?? {}) as Record<string, unknown>;
+  return [o.table, o.column].filter(Boolean).join('.');
+}
+
+const ITEM_LIMIT = 15;
+const MSG_BUDGET = 6500; // 留足余量低于输入框 8000 上限
+const SEVERITY_ORDER: Record<string, number> = { high: 0, medium: 1, low: 2, info: 3 };
+
+/** 极简请求：一行一个问题（ID｜定位｜摘要），不携带任何流程说明——
+ *  流程在 dw-anomaly-fixer SKILL.md 里，agent 按 skill 走四步。 */
+export function buildFixRequestMessage(
+  selected: { dim: string; finding: Finding }[], runId: string,
+): string {
+  const ordered = [...selected].sort(
+    (a, b) => (SEVERITY_ORDER[a.finding.severity] ?? 9) - (SEVERITY_ORDER[b.finding.severity] ?? 9),
+  );
+  const rows = ordered.slice(0, ITEM_LIMIT).map(
+    ({ finding: f }) =>
+      `- 问题ID ${shortTag(f)}｜${subjText(f)}｜${(f.summary ?? '').slice(0, 50)}（${f.severity}）`,
+  );
+  let body = [
+    `请修复本批次数仓问题（批次 ${runId}${ordered.length > ITEM_LIMIT ? `，仅列前 ${ITEM_LIMIT}/${ordered.length}` : ''}）：`,
+    ...rows,
+  ].join('\n');
+  while (body.length > MSG_BUDGET && rows.length > 1) {
+    rows.pop();
+    body = [`请修复本批次数仓问题（批次 ${runId}）：`, ...rows].join('\n');
+  }
+  return body;
+}
+
+export function FixPlanPage({ artifacts, runId }: { artifacts: ArtifactMap; runId: string; db?: string }) {
+  const all = useMemo(() => collectFindings(artifacts), [artifacts]);
+
+  const groups = useMemo(() => {
+    const order: string[] = [];
+    const map: Record<string, { dim: string; finding: Finding }[]> = {};
+    for (const item of all) {
+      if (!map[item.dim]) { map[item.dim] = []; order.push(item.dim); }
+      map[item.dim].push(item);
+    }
+    return order.map((dim) => ({ dim, items: map[dim] }));
+  }, [all]);
+
+  const [checked, setChecked] = useState<Set<string>>(new Set());
+  const [collapsed, setCollapsed] = useState<Set<string>>(new Set());
+  const [sentNote, setSentNote] = useState(false);
+  const [busy] = useState(false);
+
+  const selectedItems = useMemo(() => all.filter((it) => checked.has(it.finding.id)), [all, checked]);
+  const highCount = all.filter((it) => it.finding.severity === 'high').length;
+
+  const toggle = (id: string) => {
+    setChecked((prev) => {
+      const next = new Set(prev);
+      if (next.has(id)) next.delete(id); else next.add(id);
+      return next;
+    });
+  };
+  const toggleGroup = (groupItems: { dim: string; finding: Finding }[]) => {
+    setChecked((prev) => {
+      const next = new Set(prev);
+      const allChecked = groupItems.every((it) => next.has(it.finding.id));
+      for (const it of groupItems) {
+        if (allChecked) next.delete(it.finding.id); else next.add(it.finding.id);
+      }
+      return next;
+    });
+  };
+  const toggleCollapse = (dim: string) => {
+    setCollapsed((prev) => {
+      const next = new Set(prev);
+      if (next.has(dim)) next.delete(dim); else next.add(dim);
+      return next;
+    });
+  };
+
+  /** 唯一动作：把人话请求送进治理对话（页面不做任何执行） */
+  const startFix = () => {
+    if (!runId || selectedItems.length === 0) return;
+    useGovernanceStore.getState().requestFixPrefill(buildFixRequestMessage(selectedItems, runId));
+    setSentNote(true);
+  };
+  if (all.length === 0) {
+    return <Empty text="暂无 findings，请确认已选中巡检批次且各维度产物已加载" />;
+  }
+
+  return (
+    <div className="space-y-4">
+      <div className="gov-panel flex flex-wrap items-center gap-x-3 justify-between !py-2.5 text-sm">
+        <span style={{ color: 'var(--gov-ink)' }}>共 {all.length} 项 findings</span>
+        <span className="gov-kpi-hint !mt-0">已选 {selectedItems.length} · 高危 {highCount}</span>
+        <button className="gov-btn gov-btn-primary" disabled={selectedItems.length === 0 || busy}
+          onClick={startFix}>
+          开始修复（{selectedItems.length}）
+        </button>
+      </div>
+
+      {sentNote && (
+        <p className="gov-kpi-hint !mt-0">
+          已把勾选问题带入右侧「AI 助手」，请在那里完成 说明→方案→确认→执行 四步。
+        </p>
+      )}
+
+      {(groups.map(({ dim, items: groupItems }) => {
+        const checkedInGroup = groupItems.filter((it) => checked.has(it.finding.id)).length;
+        const allChecked = groupItems.length > 0 && checkedInGroup === groupItems.length;
+        const isCollapsed = collapsed.has(dim);
+        const dimColor = DIM_COLOR_OF_DIM[dim] ?? '#8d99a8';
+        return (
+          <section key={dim} className="gov-panel">
+            <div className="flex items-center gap-2">
+              <button type="button" className="flex flex-1 items-center gap-2 text-left"
+                onClick={() => toggleCollapse(dim)} aria-expanded={!isCollapsed}>
+                <i aria-hidden="true" className="inline-block h-3 w-3 shrink-0 rounded-[2px]"
+                  style={{ background: dimColor, opacity: isCollapsed ? 0.45 : 1 }} />
+                <h2 className="m-0 text-sm font-semibold" style={{ color: 'var(--gov-ink)' }}>{dim}</h2>
+                <span className="gov-rail-count">{groupItems.length}</span>
+                <span className="gov-kpi-hint !mt-0">{checkedInGroup ? `已选 ${checkedInGroup}/${groupItems.length}` : ''}</span>
+              </button>
+              <label className="flex cursor-pointer items-center gap-1.5 gov-kpi-hint !mt-0" onClick={(e) => e.stopPropagation()}>
+                <input type="checkbox" checked={allChecked} onChange={() => toggleGroup(groupItems)} />
+                {allChecked ? '取消全选' : '全选'}
+              </label>
+            </div>
+            {!isCollapsed && (
+              <div className="mt-3 border-t pt-3" style={{ borderColor: 'var(--gov-line)' }}>
+                {groupItems.map(({ finding: it }, idx) => {
+                  const isChecked = checked.has(it.id);
+                  return (
+                    // key 消歧：finding_uid 唯一优先（v2 批次都有）；旧批次无 uid 时
+                    // 同表同 category 的 finding id 会重复（如 NUL-001），再拼序号兜底
+                    <article key={it.finding_uid ?? `${it.id}-${it.category ?? 'null'}-${idx}`} className="gov-finding flex items-start gap-2.5"
+                      style={{ background: isChecked ? 'var(--gov-accent-subtle)' : undefined, borderColor: isChecked ? 'var(--gov-accent-edge)' : undefined }}>
+                      <input type="checkbox" className="mt-1" checked={isChecked} onChange={() => toggle(it.id)} aria-label={`勾选 ${it.summary}`} />
+                      <div className="min-w-0 flex-1">
+                        <div className="gov-finding-head flex-wrap">
+                          <span className="gov-finding-id">{it.source_finding_id ?? it.id}</span>
+                          <span className="gov-tag" data-sev={it.severity}>{it.severity}</span>
+                          <span className="gov-cat">{it.category}</span>
+                          <span className="gov-finding-summary">{it.summary}</span>
+                        </div>
+                        {it.detail && <p className="gov-finding-detail">{it.detail}</p>}
+                      </div>
+                    </article>
+                  );
+                })}
+              </div>
+            )}
+          </section>
+        );
+      }))}
+    </div>
+  );
+}
+
+// 维度中文显示名 → 治理动线色。
+const DIM_COLOR_OF_DIM: Record<string, string> = {
+  Schema: DIM_COLOR.schema,
+  数据质量: DIM_COLOR.quality,
+  血缘: DIM_COLOR.lineage,
+  指标: DIM_COLOR.metric,
+  任务: DIM_COLOR.task,
+};
