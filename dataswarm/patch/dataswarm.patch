diff --git a/jiuwenswarm/channels/web/frontend/src/features/governance/store/governanceStore.ts b/jiuwenswarm/channels/web/frontend/src/features/governance/store/governanceStore.ts
new file mode 100644
index 000000000..f76ae8330
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/governance/store/governanceStore.ts
@@ -0,0 +1,355 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { create } from 'zustand';
+import { inspectionApi, SUPERSEDED_ERROR } from '../api/inspectionApi';
+import { useChatStore, useSessionStore } from '../../../stores';
+import { ensureGovernanceSession, isGovSessionCreatedThisLoad, restoreGovernanceHistory, updateGovernanceSessionTitle } from '../chat/governanceChat';
+import type { ArtifactMap, Dimension, FixPlanArtifact, InspectionManifest, InspectionSummary } from '../types/inspection';
+
+// 当前前端会话（后端维护的 currentSession 优先，不受 /governance URL 影响）
+function currentSessionId(): string {
+  const cur = useSessionStore.getState().currentSession;
+  const sid = cur?.session_id ?? '';
+  return sid && sid !== 'new' ? sid : '';
+}
+
+// 请求序列号：selectRun/loadDimensions 并发时防止旧请求覆盖新结果。
+// 每次 selectRun 递增；loadDimensions 完成时校验 token 未变才写入 artifacts。
+let runRequestSeq = 0;
+const dimensionRequests = new Map<string, Promise<readonly [Dimension, NonNullable<ArtifactMap[Dimension]>]>>();
+
+// 进行中的加载（selectRun / loadDimensions）计数：结果被更新的批次取代时不写状态，
+// 但 loading 必须由「最后一个结束的加载」收尾，否则 spinner 永久卡在「加载中…」。
+// 两处早退分支（seq 失效）都不经过 set({loading:false})，故统一由 finally 兜底。
+let inflightLoads = 0;
+
+// 当前批次的取消信号：selectRun 切批次时 abort 上一批的在飞请求。
+// 不取消的话，过期请求会一直占着浏览器同 origin 的 6 条连接（每个批次要拉 6 个维度），
+// 新批次的请求被顶在队列后面 → 服务器慢时表现为清单空白 + 「加载中…」不结束。
+let runAbort: AbortController | null = null;
+
+/** 单次加载内维度请求的并发上限：降低切换瞬间对连接池的冲击。 */
+const DIMENSION_CONCURRENCY = 3;
+
+/**
+ * 受控并发执行，语义等价 Promise.allSettled（顺序与结果一一对应）。
+ *
+ * Args:
+ *   items: 待执行项。
+ *   limit: 并发上限。
+ *   fn: 单项执行函数（可抛错，错误以 rejected 结果返回）。
+ *
+ * Returns:
+ *   与 allSettled 同形的结果数组；不抛异常。
+ */
+async function settleLimit<T, R>(
+  items: readonly T[],
+  limit: number,
+  fn: (item: T) => Promise<R>,
+): Promise<PromiseSettledResult<R>[]> {
+  const results: PromiseSettledResult<R>[] = new Array(items.length);
+  let cursor = 0;
+  const worker = async () => {
+    for (;;) {
+      const index = cursor++;
+      if (index >= items.length) return;
+      try {
+        results[index] = { status: 'fulfilled', value: await fn(items[index]) };
+      } catch (reason) {
+        results[index] = { status: 'rejected', reason };
+      }
+    }
+  };
+  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
+  return results;
+}
+
+function loadDimensionOnce(runId: string, dimension: Dimension, signal: AbortSignal | undefined, generation: number) {
+  // key 带 generation：被取消的旧请求（同一 run 的上一轮加载）不得被新一轮复用
+  const key = `${runId}:${generation}:${dimension}`;
+  const active = dimensionRequests.get(key);
+  if (active) return active;
+  const request = inspectionApi.getDimension(dimension, runId, signal).then(artifact => [dimension, artifact] as const);
+  dimensionRequests.set(key, request);
+  request.finally(() => dimensionRequests.delete(key)).catch(() => {});
+  return request;
+}
+
+interface GovernanceState {
+  runs: InspectionManifest[];
+  selectedRunId: string;
+  summary: InspectionSummary | null;
+  artifacts: ArtifactMap;
+  loading: boolean;
+  error: string | null;
+  fixPlan: FixPlanArtifact | null;
+  fixPlanLoading: boolean;
+  fixPlanError: string | null;
+  /** 治理页内置 Agent 对话的专属会话 id（ensureGovernanceSession 完成后写入） */
+  govSessionId: string;
+  /** govSessionId 对应的巡检批次；与 selectedRunId 不一致时禁止发送。 */
+  govSessionRunId: string;
+  /** 内置 AI 助手悬浮窗展开态（收起时显示悬浮球） */
+  govPanelOpen: boolean;
+  /** FixPlanPage → 抽屉的单向预填信箱（消费即清空，不自动发送） */
+  fixPrefill: string | null;
+  /** 已随 chat.send 下发过上下文前缀的 runId，同批次只注入一次 */
+  ctxSentRunIds: string[];
+  /** 当前巡检批次内勾选的 finding_uid；切换批次时强制清空。 */
+  selectedFindingUids: string[];
+  loadRuns: (preferredRunId?: string) => Promise<void>;
+  selectRun: (runId: string, dimensions?: Dimension[]) => Promise<void>;
+  loadDimensions: (dimensions: Dimension[]) => Promise<void>;
+  rerun: () => Promise<void>;
+  generateFixPlan: () => Promise<FixPlanArtifact | null>;
+  clearError: () => void;
+  /** 确保某巡检批次有自己的治理会话：会话切换时恢复历史、清空旧批次上下文记账。 */
+  assertGovSession: (runId: string) => Promise<void>;
+  setGovPanelOpen: (open: boolean) => void;
+  requestFixPrefill: (message: string) => void;
+  consumeFixPrefill: () => string | null;
+  markContextSent: (runId: string) => void;
+  toggleFindingSelection: (findingUid: string) => void;
+  setFindingSelection: (findingUids: string[]) => void;
+  clearFindingSelection: () => void;
+}
+
+const message = (error: unknown) => (error instanceof Error ? error.message : '未知错误');
+
+export const useGovernanceStore = create<GovernanceState>((set, get) => ({
+  runs: [],
+  selectedRunId: '',
+  summary: null,
+  artifacts: {},
+  loading: false,
+  error: null,
+  fixPlan: null,
+  fixPlanLoading: false,
+  fixPlanError: null,
+  govSessionId: '',
+  govSessionRunId: '',
+  govPanelOpen: false,
+  fixPrefill: null,
+  ctxSentRunIds: [],
+  selectedFindingUids: [],
+  setGovPanelOpen: open => set({ govPanelOpen: open }),
+  // 修复入口：写入预填信箱并自动展开右侧栏，等用户确认发送（不自动发）
+  requestFixPrefill: message => set({ fixPrefill: message, govPanelOpen: true }),
+  consumeFixPrefill: () => {
+    const msg = get().fixPrefill;
+    if (msg !== null) set({ fixPrefill: null });
+    return msg;
+  },
+  markContextSent: runId => {
+    if (!get().ctxSentRunIds.includes(runId)) set({ ctxSentRunIds: [...get().ctxSentRunIds, runId] });
+  },
+  toggleFindingSelection: findingUid => {
+    if (!findingUid) return;
+    const current = get().selectedFindingUids;
+    set({
+      selectedFindingUids: current.includes(findingUid) ? current.filter(uid => uid !== findingUid) : [...current, findingUid],
+    });
+  },
+  setFindingSelection: findingUids => {
+    set({ selectedFindingUids: [...new Set(findingUids.filter(Boolean))] });
+  },
+  clearFindingSelection: () => set({ selectedFindingUids: [] }),
+  assertGovSession: async runId => {
+    if (!runId) return;
+    const sid = await ensureGovernanceSession(runId);
+    if (!sid) return;
+    // 批次切换发生在异步 ensure 期间时，旧请求不得覆盖新批次会话。
+    if (get().selectedRunId !== runId) return;
+    const prev = get().govSessionId;
+    if (prev === sid && get().govSessionRunId === runId) return; // 同批次会话已就绪，幂等无事可做
+    set({
+      govSessionId: sid,
+      govSessionRunId: runId,
+      // 会话切换 → 清旧批次上下文记账，让新批次的上下文前缀重新注入
+      ctxSentRunIds: [],
+    });
+    await updateGovernanceSessionTitle(sid, runId);
+    // 历史恢复守卫：仅当下述三条同时成立才拉取历史——
+    //  1. 非本次新建（新建即空会话，拉取只会空场）；
+    //  2. 目标会话 runtime 尚无消息（本 load 已对话/已恢复过 → 内存消息才是最新的，覆盖会丢失）；
+    //  3. 目标会话不在处理中（避免正在发送时被历史回放打断）。
+    const runtime = useChatStore.getState().runtimes[sid];
+    if (!isGovSessionCreatedThisLoad(sid) && !runtime?.messages?.length && !runtime?.isProcessing) {
+      void restoreGovernanceHistory(sid).catch(e => console.warn('[governance.assert-session] history restore failed (session kept)', e));
+    }
+  },
+  clearError: () => set({ error: null }),
+  loadRuns: async preferredRunId => {
+    set({ loading: true, error: null });
+    try {
+      const { runs } = await inspectionApi.listRuns();
+      set({ runs });
+      const currentRunId = get().selectedRunId;
+      const selected =
+        (preferredRunId && runs.some(run => run.run_id === preferredRunId) ? preferredRunId : '') ||
+        // 当前选中仅在仍存在于最新批次列表时保留；否则视为失效（如后端已清空/换库）
+        (currentRunId && runs.some(run => run.run_id === currentRunId) ? currentRunId : '') ||
+        runs.find(run => run.status === 'success')?.run_id ||
+        runs[0]?.run_id ||
+        '';
+      if (selected) {
+        await get().selectRun(selected);
+      } else {
+        // 无任何批次：清空 run 级状态（口径同 selectRun 切批次的隔离重置），渲染空态而非陈旧数据
+        set({
+          selectedRunId: '',
+          summary: null,
+          artifacts: {},
+          loading: false,
+          selectedFindingUids: [],
+          fixPrefill: null,
+          govSessionId: '',
+          govSessionRunId: '',
+          ctxSentRunIds: [],
+        });
+      }
+    } catch (error) {
+      set({ loading: false, error: message(error) });
+    }
+  },
+  selectRun: async (runId, dimensions) => {
+    // 递增 token：让并发中的 loadDimensions 旧请求完成时检测到 seq 变化而放弃写入。
+    const seq = ++runRequestSeq;
+    // 上一批次的在飞请求立即取消（释放连接，别让过期请求把新批次顶在队列后）
+    runAbort?.abort();
+    runAbort = new AbortController();
+    const signal = runAbort.signal;
+    const runChanged = get().selectedRunId !== runId;
+    // 批次身份变化时立即隔离选择、预填和会话，防止旧批次上下文被发送到新批次。
+    set({
+      selectedRunId: runId,
+      summary: null,
+      artifacts: {},
+      loading: true,
+      error: null,
+      ...(runChanged
+        ? {
+            selectedFindingUids: [],
+            fixPrefill: null,
+            govSessionId: '',
+            govSessionRunId: '',
+            ctxSentRunIds: [],
+          }
+        : {}),
+    });
+    // 补绑会话：对话触发巡检时 manifest 可能无 session_id，用当前会话补上，修复时能回原会话。
+    const run = get().runs.find(r => r.run_id === runId);
+    const sid = currentSessionId();
+    if (run && !run.session_id && sid) {
+      void inspectionApi
+        .bindSession(runId, sid)
+        .then(() => {
+          set({ runs: get().runs.map(r => (r.run_id === runId ? { ...r, session_id: sid } : r)) });
+        })
+        .catch(() => {
+          /* 补绑失败不阻塞查看 */
+        });
+    }
+    // 注：治理助手会话懒建——selectRun（切批次/加载）不再自动建会话，避免「切批次就建」。
+    // 会话只在用户点悬浮球或点「开始修复」时由 assertGovSession 建立（见 GovernanceChatPanel）。
+    inflightLoads += 1;
+    try {
+      const summary = await inspectionApi.getSummary(runId, signal);
+      if (get().selectedRunId !== runId || seq !== runRequestSeq) return;
+      set({ summary, artifacts: {}, loading: false });
+      // summary 就绪、artifacts 已清空后，串行加载当前页需要的维度，避免与并发触发竞态。
+      if (dimensions?.length) await get().loadDimensions(dimensions);
+    } catch (error) {
+      if (get().selectedRunId !== runId || seq !== runRequestSeq) return;
+      // 本批次已被更新的选择取代（请求被 abort）：状态归新批次管，不写错误横幅
+      if (message(error) === SUPERSEDED_ERROR) return;
+      set({ summary: null, artifacts: {}, loading: false, error: message(error) });
+    } finally {
+      inflightLoads -= 1;
+      // 上面两处「已被取代」的早退都不写 loading，由这里兜底：最后一个加载结束即复位，
+      // 避免批次被抢断后 spinner 永久停在「加载中…」。
+      if (inflightLoads === 0 && get().loading) set({ loading: false });
+    }
+  },
+  loadDimensions: async dimensions => {
+    const runId = get().selectedRunId;
+    if (!runId) return;
+    const missing = dimensions.filter(dimension => !get().artifacts[dimension]);
+    if (!missing.length) return;
+    const seq = runRequestSeq;
+    const signal = runAbort?.signal;
+    inflightLoads += 1;
+    set({ loading: true, error: null });
+    try {
+      // 受控并发：一次切批次最多同时占 DIMENSION_CONCURRENCY 条连接，别把同 origin 的
+      // 6 条连接池一次吃满（服务器慢时会把后续批次的请求顶在队列里）。
+      const settled = await settleLimit(
+        missing, DIMENSION_CONCURRENCY,
+        dimension => loadDimensionOnce(runId, dimension, signal, seq),
+      );
+      // 期间若切换了 run（selectRun 递增过 token），旧请求结果不写入，避免覆盖新 run 的空 artifacts。
+      if (get().selectedRunId !== runId || seq !== runRequestSeq) return;
+      const artifacts = { ...get().artifacts };
+      const errors: string[] = [];
+      settled.forEach(result => {
+        if (result.status === 'fulfilled') artifacts[result.value[0]] = result.value[1] as never;
+        else {
+          // 维度产物缺失（该阶段本次未产出，如 data 失败跳过）、或本批次已被取代（请求被
+          // abort）= 均属预期，不当错误横幅展示；其余错误如实上报。
+          const msg = message(result.reason);
+          if (msg !== 'artifact_not_found' && msg !== SUPERSEDED_ERROR) errors.push(msg);
+        }
+      });
+      set({ artifacts, loading: false, error: errors.length ? errors.join('；') : null });
+    } finally {
+      inflightLoads -= 1;
+      // 过期分支（上面的 return）不走 set，由这里兜底收尾：最后一个加载结束即复位
+      // loading，避免异常清单停在「加载中…」永不结束。
+      if (inflightLoads === 0 && get().loading) set({ loading: false });
+    }
+  },
+  rerun: async () => {
+    const current = get().runs.find(run => run.run_id === get().selectedRunId);
+    if (!current) return;
+    set({ loading: true, error: null });
+    try {
+      // 业务库严格按 config：复用该 run 的库；若是已退役的 demo 训练库则清空，让后端按 config default_db 解析
+      const db = /training_warehouse\.db|inspection_demo\.db$/i.test(current.db) ? '' : current.db;
+      const created = await inspectionApi.createRun(db, current.baseline_source_db, current.session_id || currentSessionId() || undefined);
+      const newRunId = created.run_id;
+      set({
+        selectedRunId: newRunId,
+        selectedFindingUids: [],
+        fixPrefill: null,
+        govSessionId: '',
+        govSessionRunId: '',
+        ctxSentRunIds: [],
+      });
+      // 轮询 manifest，直到状态离开 queued/running（plan §4.2 状态机）。
+      // 上限 ~120s，每 2s 一次；巡检本身 <30s，通常首轮即完成。
+      for (let i = 0; i < 60; i++) {
+        await new Promise(resolve => window.setTimeout(resolve, 2000));
+        const manifest = await inspectionApi.getManifest(newRunId);
+        if (manifest.status !== 'queued' && manifest.status !== 'running') break;
+      }
+      await get().loadRuns();
+    } catch (error) {
+      set({ loading: false, error: message(error) });
+    }
+  },
+  generateFixPlan: async () => {
+    const runId = get().selectedRunId;
+    const summary = get().summary;
+    if (!runId || !summary) return null;
+    set({ fixPlanLoading: true, fixPlanError: null });
+    try {
+      // db 优先用 summary.meta.db（巡检时的库路径）
+      await inspectionApi.fixPlan(runId, summary.meta?.db ?? '');
+      const plan = await inspectionApi.getFixPlan(runId);
+      set({ fixPlan: plan, fixPlanLoading: false });
+      return plan;
+    } catch (error) {
+      set({ fixPlanLoading: false, fixPlanError: message(error) });
+      return null;
+    }
+  },
+}));
