+test('compact DAG reduces both extents without changing dependency rows or overlapping nodes', () => {
+  const roots = Array.from({ length: 17 }, (_, i) => topology(`root-${i}`));
+  const nodes = [
+    ...roots,
+    ...roots.map((root) => topology(`import-${root.id}`, [root.id])),
+    topology(
+      'detail',
+      roots.map((root) => `import-${root.id}`),
+    ),
+    topology('summary', ['detail']),
+    topology('output', ['summary']),
+  ];
+  const before = structuredClone(nodes);
+  const comfortable = layoutWorkflowGraph(nodes);
+  const compact = layoutWorkflowGraph(nodes, 'compact');
+  const extent = (positions, size, axis) =>
+    Math.max(...Object.values(positions).map((p) => p[axis] + size)) -
+    Math.min(...Object.values(positions).map((p) => p[axis]));
+  assert.ok(extent(compact, 260, 'x') < extent(comfortable, 312, 'x'));
+  assert.ok(extent(compact, 96, 'y') < extent(comfortable, 152, 'y'));
+  assert.deepEqual(nodes, before);
+  const rows = new Map();
+  for (const node of nodes) {
+    const position = compact[node.id];
+    const row = rows.get(position.y) ?? [];
+    row.push(position.x);
+    rows.set(position.y, row);
+    for (const parent of node.parents)
+      assert.ok(compact[parent].y + WORKFLOW_GRAPH_METRICS.compact.height < position.y);
+  }
+  assert.equal(new Set(roots.map((node) => compact[node.id].y)).size, 1);
+  for (const xs of rows.values()) {
+    xs.sort((a, b) => a - b);
+    for (let i = 1; i < xs.length; i++)
+      assert.ok(xs[i] - xs[i - 1] >= WORKFLOW_GRAPH_METRICS.compact.width + WORKFLOW_GRAPH_METRICS.compact.nodeGap);
