+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""compiler 过滤器归并回归（F-020）。
+
+同字段 ``=`` / ``IN`` 多值过滤器必须归并为单条 ``IN``——intent 对「A 和 B 对比」
+类问题会拆出同字段多个 ``=``，AND 连接逻辑恒空（ck-24 实锤：
+``WHERE country='USA' AND country='Canada'``）。单值字段保持 ``=`` 形态不破坏
+存量编译产物。
+"""
+from __future__ import annotations
+
+from jiuwenswarm.channels.web.dataagent.metrics.compiler import _merge_same_field_filters
+from jiuwenswarm.channels.web.dataagent.metrics.model import QueryFilter
+
+
+def test_same_field_equality_filters_merge_into_in():
+    filters = (QueryFilter(field="customer_country", op="=", value="USA"),
+               QueryFilter(field="customer_country", op="=", value="Canada"))
+    merged = _merge_same_field_filters(filters)
+    assert len(merged) == 1
+    assert merged[0].op == "IN"
+    assert list(merged[0].value) == ["USA", "Canada"]
+
+
+def test_same_field_in_and_equality_merge():
+    filters = (QueryFilter(field="genre", op="IN", value=["Rock", "Jazz"]),
+               QueryFilter(field="genre", op="=", value="Metal"))
+    merged = _merge_same_field_filters(filters)
+    assert len(merged) == 1
+    assert merged[0].op == "IN"
+    assert list(merged[0].value) == ["Rock", "Jazz", "Metal"]
+
+
+def test_single_value_filter_kept_as_is():
+    filters = (QueryFilter(field="customer_country", op="=", value="USA"),)
+    merged = _merge_same_field_filters(filters)
+    assert len(merged) == 1
+    assert merged[0].op == "="
+    assert merged[0].value == "USA"
+
+
+def test_different_fields_not_merged():
+    filters = (QueryFilter(field="customer_country", op="=", value="USA"),
+               QueryFilter(field="genre", op="=", value="Rock"))
+    merged = _merge_same_field_filters(filters)
+    assert len(merged) == 2
+    assert all(f.op == "=" for f in merged)
+
+
+def test_range_operators_untouched():
+    filters = (QueryFilter(field="total", op=">", value=100),
+               QueryFilter(field="total", op="<", value=500),
+               QueryFilter(field="customer_country", op="=", value="USA"),
+               QueryFilter(field="customer_country", op="=", value="Canada"))
+    merged = _merge_same_field_filters(filters)
+    ops = [(f.field, f.op) for f in merged]
+    assert ("total", ">") in ops and ("total", "<") in ops
+    assert ops.count(("customer_country", "IN")) == 1
+    # 归并后的 IN 排在原字段首次出现的位置（保持 WHERE 顺序稳定）
+    assert ops.index(("customer_country", "IN")) == 2
