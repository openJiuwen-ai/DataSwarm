+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 指标模块内共用样式串与类型（页签 / 抽屉 / 弹窗统一引用）。
+ *
+ * 颜色一律走主题 token（tailwind.config 的 CSS 变量映射），
+ * 禁止硬编码 gray/blue 系——深色主题下会成浅色补丁。
+ */
+
+import type { TFunction } from 'i18next';
+
+export const btn = 'px-3 py-1.5 text-sm rounded border border-border bg-bg-elevated text-text hover:bg-bg-hover disabled:opacity-40';
+export const btnPrimary = 'px-3 py-1.5 text-sm rounded bg-accent text-accent-foreground hover:bg-accent-hover disabled:opacity-40';
+
+export const badge = (tone: 'green' | 'gray' | 'red' | 'amber' | 'blue') =>
+  `inline-block px-2 py-0.5 text-xs rounded ${tone === 'green' ? 'bg-ok-subtle text-ok'
+    : tone === 'red' ? 'bg-danger-subtle text-danger'
+    : tone === 'amber' ? 'bg-warn-subtle text-warn'
+    : tone === 'blue' ? 'bg-accent-subtle text-accent'
+    : 'bg-secondary text-text-muted'}`;
+
+/** 页签内异步操作的统一包装：返回 null 表示失败（错误由调用方收集）。 */
+export type Runner = <T>(fn: () => Promise<T>) => Promise<T | null>;
+
+/** 时间戳裁到分钟：'2026-10-20T12:34:56' → '2026-10-20 12:34'。 */
+export function formatTime(value?: string): string {
+  return (value || '').slice(0, 16).replace('T', ' ');
+}
+
+/** 逗号分隔输入 ↔ 字符串数组（中英文逗号都认）。 */
+export function splitList(value: string): string[] {
+  return value.split(/[,，]/).map((item) => item.trim()).filter(Boolean);
+}
+
+export function joinList(values?: string[]): string {
+  return (values ?? []).join(', ');
+}
+
+// ---- 领域枚举 → i18n key（取值集合对齐后端 metrics/model.py 常量） ----
+// 文案在渲染期经 enumLabel(t, group, value) 解析到 biMetrics.enum.<group>.<尾段>，
+// 禁止模块顶层缓存标签（切语言不生效）；未知枚举值 defaultValue 兜底原值。
+
+export type EnumGroup =
+  | 'type' | 'revisionStatus' | 'bindingStatus' | 'grain' | 'depRole'
+  | 'projectionStatus' | 'releaseStatus';
+
+/** 枚举值 → biMetrics.enum.<group>.<尾段> 的纯数据映射（保留映射以便对齐后端常量集合）。 */
+const ENUM_KEY_TAILS: Record<EnumGroup, Record<string, string>> = {
+  type: { atomic: 'atomic', derived: 'derived', ratio: 'ratio' },
+  revisionStatus: { draft: 'draft', candidate: 'candidate', published: 'published', retired: 'retired' },
+  bindingStatus: { verified: 'verified', unbound: 'unbound', failed: 'failed' },
+  grain: { day: 'day', week: 'week', month: 'month', year: 'year' },
+  depRole: { numerator: 'numerator', denominator: 'denominator' },
+  projectionStatus: { published: 'published', pending: 'pending', failed: 'failed' },
+  releaseStatus: { published: 'published', draft: 'draft', revoked: 'revoked', failed: 'failed' },
+};
+
+/** 枚举值解析为当前语言标签；未知值回退原值（避免漏译开天窗）。 */
+export function enumLabel(t: TFunction, group: EnumGroup, value: string): string {
+  const tail = ENUM_KEY_TAILS[group][value] ?? value;
+  return t(`biMetrics.enum.${group}.${tail}`, { defaultValue: value });
+}
