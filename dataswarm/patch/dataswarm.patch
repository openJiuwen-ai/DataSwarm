+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type {
+  CsvInferenceResult,
+  CatalogResult,
+  CreateDatabaseResult,
+  DataSourceListResult,
+  KnowledgeDerivationStatus,
+  ProbeResult,
+  SemanticRun,
+  SemanticRunListResult,
+  SourceTypeCatalogResult,
+  SourceFormParams,
+  SourceMutationResult,
+  TestConnectionResult,
+  SourceQueryResult,
+  SourceSchemaResult,
+} from '../types/dataSource';
+
+async function getJson<T>(url: string): Promise<T> {
+  const response = await fetch(url, { headers: { Accept: 'application/json' } });
+  const payload = (await response.json().catch(() => ({}))) as Record<string, unknown>;
+  if (!response.ok) {
+    throw new Error(typeof payload.error === 'string' ? payload.error : `${response.status} ${response.statusText}`);
+  }
+  return payload as T;
+}
+
+async function postJson<T>(url: string, body: unknown): Promise<T> {
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+    body: JSON.stringify(body),
+  });
+  const payload = (await response.json().catch(() => ({}))) as Record<string, unknown>;
+  if (!response.ok) {
+    throw new Error(typeof payload.error === 'string' ? payload.error : `${response.status} ${response.statusText}`);
+  }
+  return payload as T;
+}
+
+export const dataSourceApi = {
+  list: (workspaceId?: string) =>
+    getJson<DataSourceListResult>(
+      `/api/dataagent/datasource/list${workspaceId ? `?workspace_id=${encodeURIComponent(workspaceId)}` : ''}`,
+    ),
+  listSourceTypes: () => getJson<SourceTypeCatalogResult>('/api/dataagent/datasource/types'),
+  probe: (dbRef: string, workspaceId?: string, sourceId?: string) =>
+    getJson<ProbeResult>(
+      `/api/dataagent/datasource/probe?db_ref=${encodeURIComponent(dbRef)}${workspaceId ? `&workspace_id=${encodeURIComponent(workspaceId)}` : ''}${sourceId ? `&source_id=${encodeURIComponent(sourceId)}` : ''}`,
+    ),
+  catalog: (sourceId: string, workspaceId?: string) => {
+    const params = new URLSearchParams({ source_id: sourceId });
+    if (workspaceId) params.set('workspace_id', workspaceId);
+    return getJson<CatalogResult>(`/api/dataagent/datasource/catalog?${params.toString()}`);
+  },
+  schema: (sourceId: string, dataset: string, schemaName?: string, workspaceId?: string) => {
+    const params = new URLSearchParams({ source_id: sourceId, dataset });
+    if (schemaName) params.set('schema', schemaName);
+    if (workspaceId) params.set('workspace_id', workspaceId);
+    return getJson<SourceSchemaResult>(`/api/dataagent/datasource/schema?${params.toString()}`);
+  },
+  preview: (sourceId: string, dataset: string, limit = 100, workspaceId?: string) => {
+    const params = new URLSearchParams({ source_id: sourceId, dataset, limit: String(limit) });
+    if (workspaceId) params.set('workspace_id', workspaceId);
+    return getJson<SourceQueryResult>(`/api/dataagent/datasource/preview?${params.toString()}`);
+  },
+  query: (sourceId: string, sql: string, params?: unknown, limit = 100, workspaceId?: string) =>
+    postJson<SourceQueryResult>(
+      `/api/dataagent/datasource/query${workspaceId ? `?workspace_id=${encodeURIComponent(workspaceId)}` : ''}`,
+      { source_id: sourceId, sql, params, limit },
+    ),
+  testConnection: (params: SourceFormParams) =>
+    postJson<TestConnectionResult>('/api/dataagent/datasource/test', params),
+  createDatabase: (params: SourceFormParams) =>
+    postJson<CreateDatabaseResult>('/api/dataagent/datasource/create-database', params),
+  createSource: (params: SourceFormParams, contextWorkspaceId?: string) =>
+    postJson<SourceMutationResult>(
+      `/api/dataagent/datasource/create${contextWorkspaceId ? `?workspace_id=${encodeURIComponent(contextWorkspaceId)}` : ''}`,
+      params,
+    ),
+  bindSource: (sourceId: string, workspaceId: string) =>
+    postJson<SourceMutationResult>('/api/dataagent/datasource/bind', {
+      source_id: sourceId,
+      workspace_id: workspaceId,
+    }),
+  updateSource: (params: SourceFormParams) =>
+    postJson<SourceMutationResult>('/api/dataagent/datasource/update', params),
+  deleteSource: (sourceId: string, force = false, workspaceId?: string) =>
+    postJson<SourceMutationResult>(
+      `/api/dataagent/datasource/delete${workspaceId ? `?workspace_id=${encodeURIComponent(workspaceId)}` : ''}`,
+      { source_id: sourceId, force },
+    ),
+  inferCsv: (path: string, sampleRows = 100) =>
+    postJson<CsvInferenceResult>('/api/dataagent/datasource/infer', { path, sample_rows: sampleRows }),
+  /** 手动触发/重试知识派生任务（L1 schema 正则 + L2 深化）；进度看数据源列表。 */
+  runKnowledgeDerivation: (workspaceId: string) =>
+    postJson<{ status: string; knowledge_derivation?: KnowledgeDerivationStatus }>(
+      `/api/dataagent/knowledge/schema-enrichment/run?workspace_id=${encodeURIComponent(workspaceId)}`,
+      {},
+    ),
+  /** 取消运行中的知识派生任务（当前表完成后停止，已完成部分保留，可重试续跑）。 */
+  cancelKnowledgeDerivation: (workspaceId: string) =>
+    postJson<{ status: string; knowledge_derivation?: KnowledgeDerivationStatus }>(
+      `/api/dataagent/knowledge/schema-enrichment/cancel?workspace_id=${encodeURIComponent(workspaceId)}`,
+      {},
+    ),
+  /** 手动触发语义采集（元数据快照 → 知识图发布）；与绑定数据源时后端自动触发的是同一入口。 */
+  startSemanticRun: (sourceId: string, workspaceId?: string) => {
+    const params = new URLSearchParams();
+    if (workspaceId) params.set('workspace_id', workspaceId);
+    const qs = params.toString();
+    return postJson<SemanticRun>(`/api/dataagent/semantic/runs${qs ? `?${qs}` : ''}`, {
+      source_id: sourceId,
+      trigger_type: 'manual',
+    });
+  },
+  /** 查询语义采集 run（按 source_id 过滤，取回轮询最新状态）。 */
+  listSemanticRuns: (sourceId: string, workspaceId?: string) => {
+    const params = new URLSearchParams({ source_id: sourceId });
+    if (workspaceId) params.set('workspace_id', workspaceId);
+    return getJson<SemanticRunListResult>(`/api/dataagent/semantic/runs?${params.toString()}`);
+  },
+};
