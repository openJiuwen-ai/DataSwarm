+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/controller.py — /api/dataagent/orchestration/* 路由分发（方案 §五）。
+
+纯路由：解析 path/body → 调 service → 状态码映射。
+业务逻辑全在 service.py（新旧 API 唯一实现，见 §5.2 适配层）。
+
+状态码契约：
+    200 查询/操作成功；201 创建成功；202 debug（异步执行已受理）；
+    404 not_found；409 enable 非 published / resume cancelled（service 返回 status_code）；
+    400 bad_request。
+"""
+from __future__ import annotations
+
+import json
+import threading
+
+from . import service as svc
+
+
+_PREFIX = "/api/dataagent/orchestration"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    rel = path[len(_PREFIX):].rstrip("/")
+    return rel.split("/")
+
+
+def _read_body(handler) -> dict | None:
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except ValueError:
+        return None
+    if not length:
+        return {}
+    try:
+        return json.loads(handler.rfile.read(length).decode("utf-8"))
+    except ValueError:
+        return None
+
+
+def _write_result(handler, result, ok_status: int = 200) -> None:
+    """service 结果 → HTTP。result 带 status_code 时用之（409/404 等）。"""
+    if isinstance(result, dict) and result.get("status_code"):
+        handler._write_json(result["status_code"], result)
+        return
+    handler._write_json(ok_status, result)
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    # ['', 'tasks']
+    if len(parts) == 2 and parts[1] == "tasks":
+        status = handler._query_arg(parsed, "status")
+        q = handler._query_arg(parsed, "q")
+        try:
+            limit = int(handler._query_arg(parsed, "limit") or "100")
+            if limit <= 0:
+                limit = 100
+        except (TypeError, ValueError):
+            limit = 100
+        try:
+            offset = int(handler._query_arg(parsed, "offset") or "0")
+            if offset < 0:
+                offset = 0
+        except (TypeError, ValueError):
+            offset = 0
+        tasks = svc.list_tasks(status=status, q=q, limit=limit, offset=offset)
+        total = svc.count_tasks(status=status, q=q)
+        handler._write_json(200, {"tasks": tasks, "total": total,
+                                  "limit": limit, "offset": offset})
+        return
+    if len(parts) == 3 and parts[1] == "tasks":
+        t = svc.get_task(parts[2])
+        handler._write_json(200 if t else 404, t if t else {"error": "not_found"})
+        return
+    if len(parts) == 2 and parts[1] == "workflows":
+        status = handler._query_arg(parsed, "status")
+        q = handler._query_arg(parsed, "q")
+        try:
+            limit = int(handler._query_arg(parsed, "limit") or "100")
+            if limit <= 0:
+                limit = 100
+        except (TypeError, ValueError):
+            limit = 100
+        try:
+            offset = int(handler._query_arg(parsed, "offset") or "0")
+            if offset < 0:
+                offset = 0
+        except (TypeError, ValueError):
+            offset = 0
+        wfs = svc.list_workflows(status=status, q=q, limit=limit, offset=offset)
+        total = svc.count_workflows(status=status, q=q)
+        handler._write_json(200, {"workflows": wfs, "total": total,
+                                  "limit": limit, "offset": offset})
+        return
+    if len(parts) == 3 and parts[1] == "workflows":
+        wf = svc.get_workflow(parts[2])
+        handler._write_json(200 if wf else 404, wf if wf else {"error": "not_found"})
+        return
+    if len(parts) == 2 and parts[1] == "instances":
+        # 分页参数：limit 默认 20，offset 默认 0
+        try:
+            limit = int(handler._query_arg(parsed, "limit") or "20")
+            if limit <= 0:
+                limit = 20
+        except (TypeError, ValueError):
+            limit = 20
+        try:
+            offset = int(handler._query_arg(parsed, "offset") or "0")
+            if offset < 0:
+                offset = 0
+        except (TypeError, ValueError):
+            offset = 0
+        insts = svc.list_instances(
+            ref_type=handler._query_arg(parsed, "ref_type"),
+            ref_id=handler._query_arg(parsed, "ref_id"),
+            trigger_type=handler._query_arg(parsed, "trigger_type"),
+            q=handler._query_arg(parsed, "q"),
+            limit=limit, offset=offset)
+        status_counts = svc.count_instances_by_status(
+            ref_type=handler._query_arg(parsed, "ref_type"),
+            ref_id=handler._query_arg(parsed, "ref_id"),
+            trigger_type=handler._query_arg(parsed, "trigger_type"),
+            q=handler._query_arg(parsed, "q"))
+        handler._write_json(200, {"instances": insts, "total": sum(status_counts.values()),
+                                  "status_counts": status_counts,
+                                  "limit": limit, "offset": offset})
+        return
+    if len(parts) == 3 and parts[1] == "instances":
+        inst = svc.get_instance(parts[2])
+        handler._write_json(200 if inst else 404, inst if inst else {"error": "not_found"})
+        return
+    if len(parts) == 4 and parts[1] == "instances" and parts[3] == "task-runs":
+        handler._write_json(200, {"task_runs": svc.list_task_runs(parts[2])})
+        return
+    if len(parts) == 4 and parts[1] == "task-runs" and parts[3] == "logs":
+        stream = handler._query_arg(parsed, "stream") or "stdout"
+        handler._write_json(200, svc.get_task_run_log(parts[2], stream))
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = _read_body(handler)
+    if body is None and len(parts) > 2:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        # ---- tasks ----
+        if len(parts) == 2 and parts[1] == "tasks":
+            t = svc.create_task(body or {})
+            handler._write_json(201, t)
+            return
+        if len(parts) == 4 and parts[1] == "tasks":
+            action = parts[3]
+            if action == "update":
+                t = svc.update_task(parts[2], body or {})
+                handler._write_json(200 if t else 404, t if t else {"error": "not_found"})
+                return
+            if action == "delete":
+                ok = svc.delete_task(parts[2])
+                handler._write_json(200 if ok else 404, {"ok": ok} if ok else {"error": "not_found"})
+                return
+            if action in ("publish", "unpublish"):
+                status = "published" if action == "publish" else "draft"
+                t = svc.set_task_status(parts[2], status)
+                handler._write_json(200 if t else 404, t if t else {"error": "not_found"})
+                return
+            if action == "debug":
+                inst = _debug_task(parts[2])
+                _emit_workflow_run_event(handler, inst, "task", parts[2], svc.get_task(parts[2]))
+                handler._write_json(202, inst)
+                return
+
+        # POST /tasks/preview-lineage —— 解析 SQL 预览血缘（不落库，与旧 API 同语义）
+        if len(parts) == 3 and parts[1] == "tasks" and parts[2] == "preview-lineage":
+            code = (body or {}).get("code", "") if body else ""
+            ds_ref = (body or {}).get("datasource_ref") if body else None
+            handler._write_json(200, svc.preview_lineage(code, ds_ref))
+            return
+
+        # ---- workflows ----
+        if len(parts) == 2 and parts[1] == "workflows":
+            wf = svc.create_workflow(body or {})
+            _emit_workflow_change_event(handler, "CREATE", wf["workflow_id"])
+            handler._write_json(201, wf)
+            return
+        if len(parts) == 4 and parts[1] == "workflows":
+            wid, action = parts[2], parts[3]
+            if action == "update":
+                wf = svc.update_workflow(wid, body or {})
+                if wf:
+                    _emit_workflow_change_event(handler, "UPDATE", wid)
+                handler._write_json(200 if wf else 404, wf if wf else {"error": "not_found"})
+                return
+            if action == "delete":
+                ok = svc.delete_workflow(wid)
+                handler._write_json(200 if ok else 404, {"ok": ok} if ok else {"error": "not_found"})
+                return
+            if action in ("publish", "unpublish"):
+                status = "published" if action == "publish" else "draft"
+                wf = svc.set_workflow_status(wid, status)
+                handler._write_json(200 if wf else 404, wf if wf else {"error": "not_found"})
+                return
+            if action == "enable":
+                _write_result(handler, svc.enable_workflow(wid))
+                return
+            if action == "disable":
+                _write_result(handler, svc.disable_workflow(wid))
+                return
+            if action == "pause":
+                inst = _pause_latest_instance(wid)
+                handler._write_json(200, inst)
+                return
+            if action == "debug":
+                only_nodes = (body or {}).get("only_nodes")
+                if only_nodes is not None and (
+                    not isinstance(only_nodes, list)
+                    or any(not isinstance(node_id, str) or not node_id.strip() for node_id in only_nodes)
+                ):
+                    raise ValueError("only_nodes must be a list of non-empty node ids")
+                inst = _debug_workflow(wid, only_nodes=only_nodes)
+                _emit_workflow_run_event(handler, inst, "workflow", wid, svc.get_workflow(wid))
+                handler._write_json(202, inst)
+                return
+
+        # ---- nodes（单增 or 整体替换）----
+        if len(parts) == 4 and parts[1] == "workflows" and parts[3] == "nodes":
+            if isinstance(body, dict) and isinstance(body.get("nodes"), list):
+                nodes = svc.replace_nodes(parts[2], body["nodes"])
+                _emit_workflow_change_event(handler, "REPLACE_NODES", parts[2])
+                handler._write_json(200, {"nodes": nodes})
+            else:
+                node = svc.add_node(parts[2], body or {})
+                _emit_workflow_change_event(handler, "ADD_NODE", parts[2])
+                handler._write_json(201, node)
+            return
+
+        # ---- instances 控制 ----
+        if len(parts) == 4 and parts[1] == "instances":
+            iid, action = parts[2], parts[3]
+            if action == "approve":
+                inst = svc.approve_node(iid)
+                handler._write_json(200 if inst else 404, inst if inst else {"error": "not_found"})
+                return
+            if action == "resume":
+                inst = svc.resume_workflow(iid)
+                if inst is None:
+                    handler._write_json(404, {"error": "not_found"})
+                else:
+                    _write_result(handler, inst)  # 409 (cancelled) / 200
+                return
+            if action == "cancel":
+                inst = svc.cancel_instance(iid)
+                handler._write_json(200 if inst else 404, inst if inst else {"error": "not_found"})
+                return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+# --------------------------------------------------------------------------
+# debug 触发（与旧 orchestration/api.py 同语义：202 + daemon 线程执行）
+# --------------------------------------------------------------------------
+def _emit_workflow_run_event(handler, inst: dict, ref_type: str, ref_id: str,
+                              entity: dict | None) -> None:
+    """debug 受理成功后发 chat.struct_change 事件（对话侧 DAG 面板用）.
+
+    无 X-Jiuwen-Session-Id（cron/scheduler/手工 curl）时 struct_notify 内部静默短路。
+    entity 取 workflow/task 名称用于前端事件清单展示。
+    """
+    from .. import struct_notify
+
+    name = str(entity.get("name") or "") if isinstance(entity, dict) else ""
+    struct_notify.emit_workflow_run(
+        session_id=handler.headers.get("X-Jiuwen-Session-Id", "") or "",
+        instance=inst,
+        ref_type=ref_type,
+        name=name or ref_id,
+    )
+
+
+def _emit_workflow_change_event(handler, operation: str, workflow_id: str) -> None:
+    """工作流定义级变更（创建/更新/挂节点）成功后发 workflow_change 事件.
+
+    node_count 取变更后的节点总数（get_workflow 内联 nodes），失败不影响业务返回。
+    """
+    from .. import struct_notify
+
+    try:
+        wf = svc.get_workflow(workflow_id) or {}
+    except Exception:  # noqa: BLE001 —— 事件是成功操作的后置钩子，查询失败只记空值
+        wf = {}
+    struct_notify.emit_workflow_change(
+        session_id=handler.headers.get("X-Jiuwen-Session-Id", "") or "",
+        operation=operation,
+        workflow_id=workflow_id,
+        name=str(wf.get("name") or workflow_id),
+        node_count=len(wf.get("nodes") or []),
+    )
+
+
+def _debug_task(task_id: str) -> dict:
+    task = svc.get_task(task_id)
+    if not task:
+        raise ValueError("task not found")
+    from jiuwenswarm.channels.web.orchestration import db as orch_db
+    inst = orch_db.create_instance("task", task_id, "debug", "queued")
+    # threading.Thread 新线程不继承 ContextVar：把请求线程解析出的工作空间
+    # 显式传入 bg 线程 set_current（决策九），否则执行器兜底到全局 default 库。
+    from jiuwenswarm.common import workspace_context
+    try:
+        ws_id = workspace_context.current_workspace().workspace_id
+    except Exception:  # noqa: BLE001 —— legacy 单库/无上下文时按 default
+        ws_id = ""
+    threading.Thread(
+        target=_run_task_bg, args=(inst["instance_id"], task_id, ws_id), daemon=True,
+    ).start()
+    return inst
+
+
+def _run_task_bg(instance_id: str, task_id: str, workspace_id: str = "") -> None:
+    from jiuwenswarm.common import workspace_context
+    from jiuwenswarm.channels.web.orchestration import workflow_engine
+    token = workspace_context.set_current(workspace_id)
+    try:
+        workflow_engine.run_task_instance(instance_id, task_id)
+    finally:
+        workspace_context.reset(token)
+
+
+def _debug_workflow(wf_id: str, only_nodes: list[str] | None = None) -> dict:
+    wf = svc.get_workflow(wf_id)
+    if not wf:
+        raise ValueError("workflow not found")
+    from jiuwenswarm.channels.web.orchestration import db as orch_db
+    inst = orch_db.create_instance("workflow", wf_id, "debug", "queued")
+    from jiuwenswarm.common import workspace_context
+    try:
+        ws_id = workspace_context.current_workspace().workspace_id
+    except Exception:  # noqa: BLE001 —— legacy 单库/无上下文时按 default
+        ws_id = ""
+    threading.Thread(
+        target=_run_workflow_bg, args=(inst["instance_id"], wf_id, ws_id, only_nodes), daemon=True,
+    ).start()
+    return inst
+
+
+def _run_workflow_bg(
+    instance_id: str,
+    wf_id: str,
+    workspace_id: str = "",
+    only_nodes: list[str] | None = None,
+) -> None:
+    from jiuwenswarm.common import workspace_context
+    from jiuwenswarm.channels.web.orchestration import workflow_engine
+    token = workspace_context.set_current(workspace_id)
+    try:
+        workflow_engine.run_workflow_instance(instance_id, wf_id, only_nodes=only_nodes)
+    finally:
+        workspace_context.reset(token)
+
+
+def _pause_latest_instance(wf_id: str) -> dict:
+    """暂停该工作流最近一个 running/queued 实例（与旧 API 同语义）。"""
+    from jiuwenswarm.channels.web.orchestration import db as orch_db
+    from jiuwenswarm.channels.web.orchestration import workflow_engine
+    insts = orch_db.list_instances(ref_type="workflow", ref_id=wf_id)
+    running = [i for i in insts if i["status"] in ("running", "queued")]
+    if not running:
+        return {"ok": False, "error": "no running instance"}
+    inst = workflow_engine.pause_workflow(running[0]["instance_id"])
+    return inst or {"ok": False, "error": "pause failed"}
