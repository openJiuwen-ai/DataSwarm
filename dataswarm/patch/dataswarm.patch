+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""execute 链路 golden 契约测试（Phase 2b 先行录制——统一三份后处理的机器锚点）。
+
+对 compile / execute / execute-batch 三个子命令，用 fixture manifest + 打桩
+`_analysis` 响应，断言 stdout JSON 字段集、exit code、manifest 记账结构
+（attempts / result_checks / evidence / budget）。2b 把三份近似拷贝的后处理
+统一为 execute_core 管线前后，同一份断言必须全绿——stdout 契约逐字节兼容
+不是口号，是这组断言。
+
+时间戳归一化：`at` 字段与 csv_path 中的时间成分每次运行不同，断言按
+「字段存在 + 形态」而非字面值。
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+_FLOW = (Path(__file__).resolve().parents[3]
+         / "jiuwenswarm/resources/agent/workspace/skills/dw-analysis/scripts/analysis_flow.py")
+sys.path.insert(0, str(_FLOW.parent))
+import flow.commands as analysis_flow  # noqa: E402
+
+
+def _flow_manifest():
+    """flow.manifest 模块对象——_dir/_manifest_path 的家（patch 打这里）。"""
+    import flow.manifest as fm
+    return fm
+
+
+@pytest.fixture(scope="module")
+def af():
+    return analysis_flow
+
+
+def _seed(tmp_path, manifest) -> None:
+    """fixture manifest 落盘——cmd_* 经 _load 读磁盘，跑完重读取断言。"""
+    d = tmp_path / manifest["analysis_id"]
+    d.mkdir(parents=True, exist_ok=True)
+    (d / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False), "utf-8")
+
+
+def _args(**kw):
+    return argparse.Namespace(**kw)
+
+
+def _manifest() -> dict:
+    """closed 模式两成分 fixture（c1 有选定指标走编译通道，c2 走生成通道）。"""
+    return {
+        "analysis_id": "a-golden", "question": "各州 GMV", "created_at": "2026-10-24T12:00:00",
+        "mode": "closed", "open_analysis_enabled": False,
+        "semantic_versions": {"release_id": "rel_001"},
+        "context": None,
+        "plan": {
+            "source_id": "src_eval",
+            "budget": {},
+            "components": [
+                {"component_id": "c1", "text": "GMV by state", "required": True, "priority": 100,
+                 "selected_metrics": ["olist.gmv"], "derived_metrics": [], "dimensions": ["orders.customer_state"],
+                 "time": {"dimension": "orders.order_purchase_timestamp",
+                          "start": "2017-08-01", "end_exclusive": "2017-09-01"}},
+                {"component_id": "c2", "text": "orders by state", "required": True, "priority": 90,
+                 "selected_metrics": [], "derived_metrics": [], "dimensions": [],
+                 "time": None},
+            ],
+        },
+        "components": {
+            "c1": {"status": "planned", "attempts": [], "explore_rounds": [],
+                   "sufficiency_trace": [], "retries": 0},
+            "c2": {"status": "planned", "attempts": [], "explore_rounds": [],
+                   "sufficiency_trace": [], "retries": 0},
+        },
+        "budget": {"sql_count": 0, "explore_count": 0, "tool_calls": 0, "exec_ms": 0},
+        "uncovered": [], "result_checks": {}, "notes": [], "evidence": [],
+    }
+
+
+_COMPILE_OK = {"covered": True, "query_id": "q_gm_001", "release_id": "rel_001",
+               "sql": "SELECT state, SUM(gmv) FROM t GROUP BY state",
+               "sql_template": "SELECT ...", "params": [], "db_ref": "mysql://h/d",
+               "selected": [{"metric_key": "olist.gmv"}]}
+_EXEC_OK = {"ok": True, "rows": [["SP", "123.45"]], "columns": ["state", "gmv"],
+            "row_count": 1, "truncated": False, "grounding_level": "G1",
+            "authoritative": True, "query_semantics_verified": True,
+            "db_ref": "mysql://h/d"}
+_EXEC_OK_GEN = {"ok": True, "rows": [["SP", "7"]], "columns": ["state", "orders"],
+                "row_count": 1, "truncated": False, "grounding_level": "G3",
+                "non_authoritative_reasons": ["探索口径"],
+                "db_ref": "mysql://h/d"}
+_EXEC_FAIL = {"ok": False, "error": "guard_rejected", "guard": [{"name": "readonly", "status": "fail"}]}
+_CHECKS_OK = {"checks": [{"name": "empty_result", "status": "pass", "detail": "rows=1"},
+                         {"name": "truncated", "status": "pass", "detail": ""}]}
+
+
+def _install_fake_analysis(af, monkeypatch, *, compile_resp=None, exec_resp=None,
+                           fail_component: str | None = None):
+    """打桩 _analysis：按 (group, action, component_id) 路由到固定响应。"""
+    compile_resp = compile_resp if compile_resp is not None else dict(_COMPILE_OK)
+    exec_resp = exec_resp if exec_resp is not None else dict(_EXEC_OK)
+    checks = dict(_CHECKS_OK)
+
+    def fake(group, action, body):
+        if (group, action) == ("analysis", "compile"):
+            return dict(compile_resp)
+        if (group, action) == ("analysis", "execute"):
+            cid = body.get("component_id")
+            if fail_component and cid == fail_component:
+                return dict(_EXEC_FAIL)
+            if cid == "c2":                      # 生成通道（无选定指标）：非权威风味
+                return dict(_EXEC_OK_GEN)
+            return dict(exec_resp)
+        if (group, action) == ("analysis", "result-check"):
+            return dict(checks)
+        raise AssertionError(f"golden 桩未覆盖的调用: {group}/{action}")
+
+    # 命令层与管线（execute_core._checked_result）均经 dwcli_client 模块
+    # 属性调用——单一打桩 seam
+    import flow.dwcli_client as dc
+    monkeypatch.setattr(dc, "_analysis", fake)
+
+
+def _golden_ws(monkeypatch, tmp_path):
+    fm = _flow_manifest()
+    monkeypatch.setattr(fm, "_dir", lambda aid: tmp_path / aid)
+    monkeypatch.setattr(fm, "_manifest_path", lambda aid: tmp_path / aid / "manifest.json")
+    return tmp_path
+
+
+def _norm(record: dict) -> dict:
+    """归一化时间戳类字段（at / csv_path / *_at）。"""
+    out = {}
+    for k, v in record.items():
+        if k == "at":
+            out[k] = "<TS>"
+        elif k == "csv_path" and isinstance(v, str):
+            out[k] = re.sub(r"\d{8}_\d{6}_\d+", "<TS>", v)
+        else:
+            out[k] = v
+    return out
+
+
+# ---------------------------------------------------------------- compile 成功
+def test_golden_compile_covered(af, monkeypatch, tmp_path, capsys):
+    _golden_ws(monkeypatch, tmp_path)
+    _install_fake_analysis(af, monkeypatch)
+    manifest = _manifest()
+    code, result = analysis_flow._compile_one(manifest, "a-golden", "c1", source_id="src_eval")
+    assert code == 0 and result["ok"] is True
+    # stdout 字段集（compile 通道 result 即执行结果 + 通道附加）
+    assert set(result) >= {"ok", "csv_path", "result_checks", "grounding_level",
+                           "authoritative", "query_semantics_verified", "evidence_id"}
+    # attempt 记录字段集（compile 版：多 query_id/release_id）
+    attempt = _norm(manifest["components"]["c1"]["attempts"][-1])
+    assert set(attempt) == {"kind", "at", "sql", "sql_hash", "csv_path", "row_count",
+                            "truncated", "grounding_level", "authoritative",
+                            "query_semantics_verified", "non_authoritative_reasons",
+                            "query_id", "release_id", "db_ref", "result_checks",
+                            "source_id", "metric_refs", "time", "dimensions", "artifact_hash"}
+    assert attempt["kind"] == "compile"
+    assert attempt["query_id"] == "q_gm_001" and attempt["release_id"] == "rel_001"
+    assert attempt["authoritative"] is True
+    # 记账状态
+    assert manifest["components"]["c1"]["status"] == "done"
+    assert manifest["budget"]["sql_count"] == 1          # closed：成功后 +1
+    assert manifest["result_checks"]["c1"] == _CHECKS_OK["checks"]
+    # evidence 结构
+    ev = manifest["evidence"][-1]
+    assert ev["evidence_id"] == "ev-c1-1"
+    assert ev["component_id"] == "c1" and ev["kind"] == "result"
+    assert ev["artifact"].endswith(".csv")
+    assert ev["quality"]["status"] == "pass"
+
+
+# ---------------------------------------------------------------- compile 路由信号
+def test_golden_compile_uncovered(af, monkeypatch, tmp_path):
+    _golden_ws(monkeypatch, tmp_path)
+    _install_fake_analysis(af, monkeypatch,
+                           compile_resp={"covered": False, "action": "fix_plan",
+                                         "reason": "dimension_out_of_scope", "detail": "region 不在白名单"})
+    manifest = _manifest()
+    code, result = analysis_flow._compile_one(manifest, "a-golden", "c1")
+    assert code == 0                                    # 路由信号不是错误
+    assert result["action"] == "fix_plan"
+    assert manifest["components"]["c1"]["status"] == "planned"   # 未终结
+    assert manifest["budget"]["sql_count"] == 0
+    trace = manifest["components"]["c1"]["sufficiency_trace"][-1]
+    assert trace["decision"] == "compile_uncovered"
+
+
+# ---------------------------------------------------------------- execute 成功
+def test_golden_execute_ok(af, monkeypatch, tmp_path, capsys):
+    _golden_ws(monkeypatch, tmp_path)
+    _install_fake_analysis(af, monkeypatch)
+    _seed(tmp_path, _manifest())
+    code = analysis_flow.cmd_execute(_args(analysis_id="a-golden", component_id="c2",
+                                           sql_file=None, sql="SELECT 1",
+                                           source_id="", selected_file=None, selected_json=None,
+                                           temp_scope_file=None, temp_scope_json=None,
+                                           limit=None, time_json=None))
+    out = json.loads(capsys.readouterr().out)
+    assert code == 0 and out["ok"] is True
+    manifest = analysis_flow._load("a-golden")
+    assert set(out) >= {"ok", "csv_path", "result_checks", "grounding_level", "evidence_id"}
+    # attempt 字段集（execute 版：无 query_id/release_id）
+    attempt = _norm(manifest["components"]["c2"]["attempts"][-1])
+    assert set(attempt) == {"kind", "at", "sql", "sql_hash", "csv_path", "row_count",
+                            "truncated", "grounding_level", "authoritative",
+                            "query_semantics_verified", "non_authoritative_reasons",
+                            "db_ref", "result_checks", "source_id", "metric_refs",
+                            "time", "dimensions", "artifact_hash"}
+    assert attempt["kind"] == "execute"
+    assert attempt["authoritative"] is False            # 生成响应无 authoritative（_record_evidence 回填 bool(None)）
+    assert manifest["components"]["c2"]["status"] == "done"
+    assert manifest["budget"]["sql_count"] == 1
+    assert manifest["evidence"][-1]["evidence_id"] == "ev-c2-1"
+
+
+# ---------------------------------------------------------------- execute 失败
+def test_golden_execute_fail(af, monkeypatch, tmp_path, capsys):
+    _golden_ws(monkeypatch, tmp_path)
+    _install_fake_analysis(af, monkeypatch, fail_component="c2")
+    _seed(tmp_path, _manifest())
+    code = analysis_flow.cmd_execute(_args(analysis_id="a-golden", component_id="c2",
+                                           sql_file=None, sql="SELECT bad",
+                                           source_id="", selected_file=None, selected_json=None,
+                                           temp_scope_file=None, temp_scope_json=None,
+                                           limit=None, time_json=None))
+    out = json.loads(capsys.readouterr().out)
+    assert code == 2 and out["ok"] is False             # EXIT_SERVICE
+    manifest = analysis_flow._load("a-golden")
+    attempt = _norm(manifest["components"]["c2"]["attempts"][-1])
+    assert set(attempt) == {"kind", "at", "sql", "sql_hash", "error", "guard"}
+    assert attempt["error"] == "guard_rejected"
+    assert manifest["components"]["c2"]["status"] == "failed"
+    assert manifest["budget"]["sql_count"] == 0         # 失败不计数（closed）
+    assert manifest.get("evidence") == []
+
+
+# ---------------------------------------------------------------- execute-batch 混合
+def test_golden_execute_batch_mixed(af, monkeypatch, tmp_path, capsys):
+    _golden_ws(monkeypatch, tmp_path)
+    _install_fake_analysis(af, monkeypatch, fail_component="c2")
