new file mode 100644
index 000000000..5b6195af2
--- /dev/null
+++ b/tests/unit_tests/common/test_ensure_frozen_python_alias.py
@@ -0,0 +1,145 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""冻结桌面形态 python 别名入口（runtime/bin shim + PATH 前插）单测。"""
+
+from __future__ import annotations
+
+import os
+import shlex
+import sys
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.common.utils import (
+    _windows_cmd_encoding,
+    _write_python_aliases,
+    ensure_frozen_python_alias,
+)
+
+
+@pytest.fixture
+def frozen_env(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    """模拟冻结形态：frozen=True + 隔离数据目录 + 指定 sys.executable。
+
+    ensure_frozen_python_alias 会直接改 os.environ["PATH"]（monkeypatch 不会
+    代为还原），fixture 自行快照还原，避免跨用例泄漏。
+    """
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path))
+    # get_user_workspace_dir 有模块级缓存，重置后按 env 重新解析
+    monkeypatch.setattr("jiuwenswarm.common.utils._workspace_base_dir", None)
+    fake_exe = tmp_path / "DataSwarm.app" / "Contents" / "MacOS" / "dataswarm"
+    fake_exe.parent.mkdir(parents=True)
+    fake_exe.write_text("#!/bin/sh\n", encoding="utf-8")
+    monkeypatch.setattr(sys, "executable", str(fake_exe))
+    original_path = os.environ.get("PATH")
+    yield tmp_path
+    if original_path is None:
+        os.environ.pop("PATH", None)
+    else:
+        os.environ["PATH"] = original_path
+
+
+def test_non_frozen_returns_none(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """非冻结（源码/whl）形态不生成别名，行为零变化。"""
+    monkeypatch.delattr(sys, "frozen", raising=False)
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path))
+    monkeypatch.setattr("jiuwenswarm.common.utils._workspace_base_dir", None)
+    assert ensure_frozen_python_alias() is None
+    assert not (tmp_path / "runtime" / "bin").exists()
+
+
+def test_posix_alias_written_and_executable(frozen_env: Path) -> None:
+    """POSIX 形态：python/python3 落盘、内容转发全部参数、可执行位置位。"""
+    bin_dir = ensure_frozen_python_alias()
+    assert bin_dir is not None
+    exe = str(sys.executable)
+    for name in ("python", "python3"):
+        shim = bin_dir / name
+        content = shim.read_text(encoding="utf-8")
+        assert content.startswith("#!/bin/sh")
+        assert f"exec {shlex.quote(exe)} \"$@\"" in content
+        assert os.access(shim, os.X_OK)
+
+
+def test_alias_follows_exe_path_change(frozen_env: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """exe 路径随升级变化时，shim 按最新内容重写（陈旧路径是真缺陷）。"""
+    bin_dir = ensure_frozen_python_alias()
+    assert bin_dir is not None
+    old_content = (bin_dir / "python").read_text(encoding="utf-8")
+    new_exe = frozen_env / "DataSwarm-new.app" / "Contents" / "MacOS" / "dataswarm"
+    new_exe.parent.mkdir(parents=True)
+    new_exe.write_text("#!/bin/sh\n", encoding="utf-8")
+    monkeypatch.setattr(sys, "executable", str(new_exe))
+    assert ensure_frozen_python_alias() is not None
+    new_content = (bin_dir / "python").read_text(encoding="utf-8")
+    assert new_content != old_content
+    assert shlex.quote(str(new_exe)) in new_content
+
+
+def test_path_prepended_idempotently(frozen_env: Path) -> None:
+    """别名目录前插本进程 PATH，重复调用不叠加。"""
+    before = os.environ.get("PATH", "")
+    bin_dir = ensure_frozen_python_alias()
+    assert bin_dir is not None
+    expected = f"{bin_dir}{os.pathsep}{before}"
+    assert os.environ["PATH"] == expected
+    ensure_frozen_python_alias()
+    assert os.environ["PATH"] == expected
+
+
+def test_windows_alias_variants(frozen_env: Path) -> None:
+    """Windows 形态：python/python3 各写 .cmd（cmd/PowerShell）+ 无扩展名 sh（git-bash）。
+
+    .cmd 必须 ANSI 代码页 + CRLF：cmd.exe 按本机代码页读 .cmd（UTF-8 写盘的
+    中文路径成乱码），LF 行尾会打乱其行定位（rem 注释行中段被当命令执行）。
+    python3 与 POSIX 一样写：agent 按 SKILL.md 字面命令与训练习惯行事，两种
+    写法都会出现，漏一个就漏到系统 Python / 商店 stub 上。
+
+    platform 经参数注入而非 monkeypatch os.name——pathlib 3.13 的 Path 构造
+    按 os.name 分派 WindowsPath/PosixPath，全局改 os.name 会把 Path 构造打挂。
+    """
+    bin_dir = frozen_env / "runtime" / "bin"
+    bin_dir.mkdir(parents=True)
+    exe = str(sys.executable)
+    _write_python_aliases(bin_dir, exe, "nt")
+    cmd_bytes = (bin_dir / "python.cmd").read_bytes()
+    assert b"\r\n" in cmd_bytes
+    assert cmd_bytes.count(b"\n") == cmd_bytes.count(b"\r\n")  # 无裸 LF
+    cmd_content = cmd_bytes.decode(_windows_cmd_encoding())
+    assert cmd_content.startswith("@echo off")
+    assert f"\"{exe}\" %*" in cmd_content
+    for stem in ("python", "python3"):
+        assert (bin_dir / stem).exists()  # git-bash 需要无扩展名 sh 脚本
+        assert os.access(bin_dir / stem, os.X_OK)
+        stem_cmd = (bin_dir / f"{stem}.cmd").read_bytes().decode(_windows_cmd_encoding())
+        assert stem_cmd.startswith("@echo off")
+        assert f"\"{exe}\" %*" in stem_cmd
+
+
+def test_windows_cmd_shim_rewrites_stale_format(frozen_env: Path) -> None:
+    """旧格式 .cmd（UTF-8 编码或 LF 行尾）必须被判为已变化而重写。
+
+    文本级比较会因 universal newlines 归一把 LF 旧文件误判为未变、跳过修复；
+    字节级比较保证升级后旧 shim 被重写为新格式。"""
+    bin_dir = frozen_env / "runtime" / "bin"
+    bin_dir.mkdir(parents=True)
+    exe = str(sys.executable)
+    _write_python_aliases(bin_dir, exe, "nt")
+    cmd_path = bin_dir / "python.cmd"
+    good = cmd_path.read_bytes()
+    cmd_path.write_bytes(good.replace(b"\r\n", b"\n"))  # 模拟旧版 LF 行尾
+    _write_python_aliases(bin_dir, exe, "nt")
+    assert cmd_path.read_bytes() == good  # 被重写回 CRLF
+
+
+def test_windows_cmd_shim_ansi_path_roundtrip(frozen_env: Path) -> None:
+    """exe 路径含非 ASCII（中文安装目录）时 .cmd 按本机代码页写盘、可还原。
+
+    UTF-8 写盘的中文路径被 cmd.exe 按代码页读成乱码——转发目标路径无效。"""
+    exe = str(frozen_env / "洛克脚本" / "dataswarm.exe")
+    bin_dir = frozen_env / "runtime" / "bin"
+    bin_dir.mkdir(parents=True)
+    _write_python_aliases(bin_dir, exe, "nt")
+    raw = (bin_dir / "python.cmd").read_bytes()
+    assert f"\"{exe}\" %*" in raw.decode(_windows_cmd_encoding())
