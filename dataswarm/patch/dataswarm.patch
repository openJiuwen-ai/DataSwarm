+        row["extraction_error"] = (payload.get("extraction") or {}).get("error") or ""
+        row["extraction_failed_batches"] = len(extraction.get("batches") or {}) and \
+            sum(1 for b in (extraction.get("batches") or {}).values()
+                if isinstance(b, dict) and b.get("status") == "failed") or None
+        out.append(row)
+    return out
