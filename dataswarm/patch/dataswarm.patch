--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/KnowledgeReviewPage.tsx
@@ -0,0 +1,942 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 知识库管理页：文档接入 → 文档管理（状态/重抽取/删除）→ 候选审核（筛选+分页+流转发布）。
+ * 文档管理体验：状态徽章/失败批次提示/删除确认/断点重跑；
+ * 列表服务端分页与筛选下推（候选量随文档蒸馏持续增长，不做前端全量渲染），
+ * 视觉沿用 DataSwarm shared ui（KpiCard/Panel/Badge/Table/Pagination）+ lucide 图标。 */
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { Badge, Button, Empty, KpiCard, Panel, RefreshButton, SolidButton, Table, inputClass } from '../../_shared/ui';
+import { Pagination } from '../../../components/ui/Pagination/Pagination';
+import { knowledgeApi, type KnowledgeAsset, type KnowledgeDocument, type RetiredSource } from '../api/knowledgeApi';
+import { glossaryApi } from '../api/glossaryApi';
+import { metricsV2Api, type V2MetricListItem } from '../../metricsV2/api';
+import type { TermDef } from '../types/dashboard';
+import { KnowledgeAssetFormDrawer } from './KnowledgeAssetFormDrawer';
+import { AlertTriangle, Archive, BookOpen, Check, Copy, FileText, Pencil, ShieldCheck, TrendingUp, Upload, X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import { writeClipboard } from '../../trajectory/primitives/clipboard';
+
+/** 一键复制小图标：常显灰色 Copy，点击变 ✓/×（1.5s 恢复），hover 提示可复制 */
+function CopyButton({ value, label }: { value: string; label: string }) {
+  const { t } = useTranslation();
+  const [state, setState] = useState<'idle' | 'ok' | 'fail'>('idle');
+  useEffect(() => {
+    if (state === 'idle') return;
+    const timer = window.setTimeout(() => setState('idle'), 1500);
+    return () => window.clearTimeout(timer);
+  }, [state]);
+  return (
+    <button type="button"
+      className="shrink-0 rounded p-0.5 text-text-muted opacity-50 transition-colors hover:bg-secondary hover:text-text hover:opacity-100"
+      title={state === 'ok'
+        ? t('knowledge.list.copyOk')
+        : state === 'fail' ? t('knowledge.list.copyFail') : t('knowledge.list.copyHint', { label })}
+      aria-label={t('knowledge.list.copyAria', { label })}
+      onClick={async () => {
+        setState(await writeClipboard(value) ? 'ok' : 'fail');
+      }}>
+      {state === 'ok' ? <Check size={12} className="text-ok" />
+        : state === 'fail' ? <X size={12} className="text-danger" />
+        : <Copy size={12} />}
+    </button>
+  );
+}
+
+const ASSET_STATUS: Record<string, { tone: 'info' | 'warn' | 'success' | 'neutral'; bar: string }> = {
+  candidate: { tone: 'info', bar: 'border-l-text-link' },
+  approved: { tone: 'warn', bar: 'border-l-warn' },
+  published: { tone: 'success', bar: 'border-l-[var(--color-feedback-success)]' },
