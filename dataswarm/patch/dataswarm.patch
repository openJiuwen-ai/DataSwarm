+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/plan.py 单测（阶段 E：L2④ QueryPlan 程序校验）。
+
+覆盖：合法计划、候选外指标拒绝、越界维度/过滤字段、time 必填、component
+超限、component_id 重复、依赖缺失/成环、pending 过滤值透传。
+"""
+from __future__ import annotations
+
+from jiuwenswarm.channels.web.dataagent.analysis import plan as plan_module
+
+_CANDIDATES = {"commerce.gmv", "commerce.aov", "commerce.paid_orders"}
+_SCOPE = {"orders": ["amount_cny", "region", "paid_at"], "customers": ["customer_id", "name"]}
+
+
+def _plan(components: list[dict], **extra) -> dict:
+    return {"analysis_id": "a-1", "question": "上季度华东流水多少",
+            "components": components, **extra}
+
+
+def _component(**overrides) -> dict:
+    base = {
+        "component_id": "c1", "text": "华东 GMV",
+        "selected_metrics": ["commerce.gmv"],
+        "dimensions": ["region"],
+        "time": {"dimension": "paid_at", "start": "2026-07-01", "end_exclusive": "2026-10-01"},
+        "filters": [{"field": "region", "op": "=", "value": "华东"}],
+        "depends_on": [], "output": "按月 GMV 金额",
+    }
+    base.update(overrides)
+    return base
+
+
+def test_valid_plan_passes():
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component()]), _CANDIDATES, _SCOPE)
+    assert parsed is not None and errors == []
+    assert parsed.components[0].selected_metrics == ("commerce.gmv",)
+    assert parsed.components[0].filters[0].status == "confirmed"
+
+
+def test_metric_outside_candidates_rejected():
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(selected_metrics=["ghost.metric"])]), _CANDIDATES, _SCOPE)
+    assert parsed is None
+    assert any("不在候选榜内" in e["message"] for e in errors)
+
+
+def test_dimension_and_filter_out_of_scope_rejected():
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(dimensions=["unknown_dim"],
+                          filters=[{"field": "no_such_col", "op": "=", "value": "x"}])]),
+        _CANDIDATES, _SCOPE)
+    assert parsed is None
+    assert any("维度" in e["message"] for e in errors)
+    assert any("过滤字段" in e["message"] for e in errors)
+
+
+def test_table_qualified_filter_field_accepted():
+    """「表.列」形态的过滤字段合法（归一到列名比对）。"""
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(filters=[{"field": "orders.region", "op": "=", "value": "华东"}])]),
+        _CANDIDATES, _SCOPE)
+    assert parsed is not None and errors == []
+
+
+def test_time_required_fields():
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(time={"dimension": "paid_at", "start": "2026-07-01"})]),
+        _CANDIDATES, _SCOPE)
+    assert parsed is None
+    assert any("time.end_exclusive" in e["field"] for e in errors)
+
+
+def test_component_limit_and_duplicate_ids():
+    many = [_component(component_id=f"c{i}") for i in range(6)]
+    parsed, errors = plan_module.parse_and_validate(_plan(many), _CANDIDATES, _SCOPE)
+    assert any("超上限" in e["message"] for e in errors)
+
+    dup = [_component(), _component()]
+    parsed, errors = plan_module.parse_and_validate(_plan(dup), _CANDIDATES, _SCOPE)
+    assert any("重复" in e["message"] for e in errors)
+
+
+def test_dependency_missing_and_cycle():
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(depends_on=["ghost"])]), _CANDIDATES, _SCOPE)
+    assert any("不在计划内" in e["message"] for e in errors)
+
+    cycle = [
+        _component(component_id="c1", depends_on=["c2"]),
+        _component(component_id="c2", depends_on=["c1"]),
+    ]
+    parsed, errors = plan_module.parse_and_validate(_plan(cycle), _CANDIDATES, _SCOPE)
+    assert any("成环" in e["message"] for e in errors)
