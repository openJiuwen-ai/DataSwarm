@@ -0,0 +1,61 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 欢迎页示例提示集合：guide（使用指南）/ develop（数据开发）/ analyze（数据分析）三类，
+ * 欢迎页顶部按大类筛选，进入默认展示「使用指南」，每类随机抽取若干展示，
+ * 点击后把扩展版 prompt 填入输入框、由用户决定是否发送（不自动发送）。
+ *
+ * 文案单一来源在 i18n：chat.promptSuggestions.<id>.title / .prompt，
+ * 分类名在 chat.promptSuggestions.categories.<category>。
+ * 本文件保持零依赖纯逻辑，便于单文件 tsc + node --test（同 imeComposition 模式）。
+ */
+
+export type PromptCategory = 'guide' | 'develop' | 'analyze';
+
+export interface PromptSuggestion {
+  /** 稳定 id，同时是 i18n key 的一段：chat.promptSuggestions.<id>.* */
+  id: string;
+  category: PromptCategory;
+}
+
+/** 分类展示顺序（label 走 i18n：chat.promptSuggestions.categories.<id>）。 */
+export const PROMPT_CATEGORIES: readonly PromptCategory[] = ['guide', 'develop', 'analyze'];
+
+/** 提示集合：完善内容只加条目（并在 zh/en 两个 locale 补文案），不改抽取逻辑。 */
+export const PROMPT_SUGGESTIONS: readonly PromptSuggestion[] = [
+  // 使用指南：平台配置与接入类
+  { id: 'datasource', category: 'guide' },
+  { id: 'knowledgeGraph', category: 'guide' },
+  { id: 'knowledgeDocs', category: 'guide' },
+  { id: 'semanticCollect', category: 'guide' },
+  // 数据开发：指标/术语/编排/巡检等数仓建设类
+  { id: 'createMetric', category: 'develop' },
+  { id: 'addTerm', category: 'develop' },
+  { id: 'createWorkflow', category: 'develop' },
+  { id: 'inspectTable', category: 'develop' },
+  // 数据分析：取数与问数类
+  { id: 'analyzeTable', category: 'analyze' },
+  { id: 'revenueMom', category: 'analyze' },
+  { id: 'topProducts', category: 'analyze' },
+];
+
+function shuffle<T>(items: readonly T[], random: () => number): T[] {
+  const result = [...items];
+  for (let i = result.length - 1; i > 0; i -= 1) {
+    const j = Math.floor(random() * (i + 1));
+    [result[i], result[j]] = [result[j], result[i]];
+  }
+  return result;
+}
+
+/** 按大类抽取 count 条：类内洗牌取前 count；类内不足时全量返回。 */
+export function pickPromptSuggestions(
+  category: PromptCategory,
+  count = 4,
+  random: () => number = Math.random,
+): PromptSuggestion[] {
+  const pool = shuffle(
+    PROMPT_SUGGESTIONS.filter((s) => s.category === category),
+    random,
+  );
+  return pool.slice(0, count);
+}
