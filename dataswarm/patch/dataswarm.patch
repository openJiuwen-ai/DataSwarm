+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/model.py —— L1 四路召回与 L2 上下文/计划的领域模型。
+
+``RecallHit`` / ``RoadResult`` / ``VECTOR_FLOOR`` 已下沉 ``..knowledge.roads``
+（E1 解包环），此处同名 as re-export 保持既有 ``from .model import ...``
+路径——类身份同一，消费方零改动。
+
+打分契约（方案 v0.4）：
+- 通道内：原始分排序并卡最低相关性门槛（词法档位分/向量相似度各设门槛）；
+- 跨通道：RRF（``score = Σ 1/(60 + rank)``）只融合排名不融合分数——双路
+  同时命中的候选自然胜出，无需跨通道权重配比；
+- 下游特征：精排只用排名、命中通道（matched_on）与来源，不混用原始分。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from ..knowledge.roads import (  # noqa: F401 —— 稳定 re-export（E1），非未用导入
+    RecallHit as RecallHit,
+    RoadResult as RoadResult,
+    VECTOR_FLOOR as VECTOR_FLOOR,
+)
+
+# ---------------------------------------------------------------------------
+# L1 · 召回命中与路结果
+# ---------------------------------------------------------------------------
+
+RRF_K = 60  # RRF 常数（业界标准值，k 值调整由评测集决定）
+
+# 通道门槛初值（P0；最终由评测集校准）：
+# - 词法：synonym/别名档（0.7）以上参与融合——definition 泛匹配档（0.25）
+#   单独命中不参与（噪声控制），但同实体向量命中不受此影响；
+# - 向量：VECTOR_FLOOR（已下沉 knowledge.roads）对齐 metrics/embedding 的
+#   校准刻度下限。
+LEXICAL_FLOOR = 0.70
+
+# 四路上限（方案）：术语 3-5 / 指标 10 / schema 列 15-30 / 维值 5
+TERMS_LIMIT = 5
+METRICS_LIMIT = 10
+ANALYSIS_SCHEMA_LIMIT = 30
+VALUES_LIMIT = 5
+
+# 维值通道档位分：词法全等 / 词法子串 / 向量——构造与排序键必须同源
+VALUE_EXACT_SCORE = 1.0
+VALUE_LEXICAL_SCORE = 0.7
+VALUE_VECTOR_SCORE = 0.6
+
+# 图补全证据前缀（matched_on 标记）：graph:measuresConcept[:<term_id>]
+GRAPH_MEASURES_PREFIX = "graph:measuresConcept"
+
+# 通道状态：空结果原样传 L2（附状态），L1 不决定执行分支
+CHANNEL_OK = "ok"
+CHANNEL_NO_HIT = "no_hit"
+CHANNEL_UNAVAILABLE = "unavailable"
+CHANNEL_STALE = "stale"
+# 本轮未跑（串行短路路径只跑术语路）——与 unavailable 区分：通道没坏，是没叫它
+CHANNEL_SKIPPED = "skipped"
+
+
+def rrf_fuse(hits_by_channel: dict[str, list[RecallHit]]) -> list[RecallHit]:
+    """RRF 融合：``score(entity) = Σ_channel 1/(RRF_K + rank_channel)``。
+
+    Args:
+        hits_by_channel: 通道名 → **已按原始分降序排好**的命中列表。每个
+            hit 的 ``channels`` 构造时只带本通道的 ``(channel, 原始分)``；
+            门槛过滤由调用方在各自通道内完成。
+
+    Returns:
+        融合后按 rrf_score 降序的命中列表；同实体的 channels/matched_on
+        跨通道归并（保留各通道原始分），rank 写回（1 起）。
+    """
+    merged: dict[str, RecallHit] = {}
+    for hits in hits_by_channel.values():
+        for position, hit in enumerate(hits, start=1):
+            existing = merged.get(hit.entity_id)
+            if existing is None:
+                hit.rrf_score = 1.0 / (RRF_K + position)
+                merged[hit.entity_id] = hit
+                continue
+            existing.rrf_score += 1.0 / (RRF_K + position)
+            for name, score in hit.channels:
+                if name not in [pair_name for pair_name, _ in existing.channels]:
+                    existing.channels.append((name, score))
+            for mark in hit.matched_on:
+                if mark not in existing.matched_on:
+                    existing.matched_on.append(mark)
+    ranked = sorted(merged.values(), key=lambda h: (-h.rrf_score, h.entity_id))
+    for index, hit in enumerate(ranked, start=1):
+        hit.rank = index
+    return ranked
+
+
+# ---------------------------------------------------------------------------
+# L2 · 上下文包
+# ---------------------------------------------------------------------------
+
+@dataclass
+class SchemaTablePack:
+    """schema 子包内单表条目：表列 + join 路径 + 命中列的维值候选。"""
+
+    table_id: str
+    table: str                       # 物理表名（不带库名前缀）
+    source_id: str = ""
+    snapshot_id: str = ""
+    comment: str = ""
+    columns: list[dict[str, Any]] = field(default_factory=list)
+    # 每项 {name, type, comment, matched(命中标记), value_candidates: [...]}
+    joins: list[dict[str, Any]] = field(default_factory=list)
+    # 每项 {left, right, level, status, cardinality, confidence}
+
+    def column_names(self) -> list[str]:
+        """表内全部列名（scope 允许集构建用）。"""
+        return [str(column.get("name") or "") for column in self.columns]
+
+
+@dataclass
+class ContextPacks:
+    """L2③ 组装完成的三子包（术语/指标/schema 并列，维值附 schema 子包）。"""
+
+    glossary: list[dict[str, Any]] = field(default_factory=list)
+    # {term_id, name, definition, synonyms, ambiguous}
+    metrics_candidates: list[dict[str, Any]] = field(default_factory=list)
+    # {metric_key, display_name, score, matched_on, revision_id, rrf_rank}
+    metrics_selected: list[dict[str, Any]] = field(default_factory=list)
+    # 选定指标（QueryPlan 之后回填）——完整定义/口径/绑定/依赖闭包
+    schema_tables: list[SchemaTablePack] = field(default_factory=list)
+    # 已审核发布的文档语义实例（实体/映射）；文档只作为证据来源，不直接进入上下文。
+    knowledge_assets: list[dict[str, Any]] = field(default_factory=list)
+    knowledge_rules: list[dict[str, Any]] = field(default_factory=list)
+    knowledge_rule_trace: dict[str, Any] = field(default_factory=dict)
+    semantic_versions: dict[str, Any] = field(default_factory=dict)
+    # {release_id, snapshots: [{source_id, snapshot_id}], graph_status}
+
+    def scope_tables(self) -> dict[str, list[str]]:
+        """scope 允许集：表名 → 列名列表（scope 归属检查的依据）。"""
+        return {pack.table: pack.column_names() for pack in self.schema_tables}
+
+
+# ---------------------------------------------------------------------------
+# L2④ · QueryPlan（模型；程序校验在 plan.py）
+# ---------------------------------------------------------------------------
+
+@dataclass(frozen=True)
+class ComponentFilter:
+    """component 级过滤条件（维值候选命中时标 confirmed，未命中标 pending）。"""
+
+    field: str
+    op: str
+    value: Any
+    status: str = "confirmed"       # confirmed | pending
+    value_source: str = ""          # value_dict | probe | user
+
+
+@dataclass(frozen=True)
+class PlanComponent:
+    """分析计划的单个成分（一条 SQL 的最小单位）。
+
+    ``selected_metrics`` 是 SQL 应产出的指标（进口径一致性检查——ratio 的
+    分子分母必须出现）；``derived_metrics`` 是**报告层计算的派生指标**
+    （如客单价 = gmv/订单数——取数时顺带算或报告层算，**不进口径检查**，
+    方案「仅作依赖的指标」的落点）。
+    """
+
+    component_id: str
+    text: str
+    selected_metrics: tuple[str, ...] = ()
+    derived_metrics: tuple[str, ...] = ()
+    dimensions: tuple[str, ...] = ()
+    time: dict[str, Any] | None = None
+    # {dimension, start, end_exclusive, grain?, timezone?}
+    filters: tuple[ComponentFilter, ...] = ()
+    depends_on: tuple[str, ...] = ()
+    output: str = ""                # 输出粒度/单位声明
+    status: str = "planned"  # 服务端只发初始 planned；done/failed 等权威状态机在 skill 侧 manifest
+    role: str = "core"              # core | facet
+    facet_id: str = ""
+    required: bool = True
+    priority: int = 100
+    evidence_requirement: str = "authoritative_or_qualified"
+    material_refs: tuple[str, ...] = ()
+
+
+@dataclass(frozen=True)
+class QueryPlan:
+    """分析计划（LLM 提议 + plan.py 程序校验）。"""
+
+    analysis_id: str
+    question: str
+    source_id: str = ""
+    release_id: str = "active"
+    components: tuple[PlanComponent, ...] = ()
+    uncovered: tuple[str, ...] = ()
+    mode: str = "closed"            # closed | open
+    facets: tuple[dict[str, Any], ...] = ()
+    coverage: dict[str, Any] = field(default_factory=dict)
+    budget: dict[str, Any] = field(default_factory=dict)
+
+
+# ---------------------------------------------------------------------------
+# L3 · 检查结果与产物标注
+# ---------------------------------------------------------------------------
+
+CHECK_PASS, CHECK_FAIL, CHECK_UNKNOWN = "pass", "fail", "unknown"
+
+GROUNDING_G1 = "G1"   # 指标定义上下文（published 指标 + 引用全在绑定内 + 口径检查无 fail）
+GROUNDING_G2 = "G2"   # 治理 schema（引用都在 published 快照内）
+GROUNDING_G3 = "G3"   # 临时 scope（引用了活库探查进入临时 scope 的对象）
+
+NON_AUTHORITY_NO_PROVIDER = "no_semantic_provider"   # P0/P1 全部非权威的固定原因
+
+
+@dataclass(frozen=True)
+class CheckResult:
+    """单条程序化检查结果（scope 归属 / 口径一致性 / 结果检查共用形态）。"""
+
+    name: str
+    status: str                     # pass | fail | unknown
+    detail: str = ""
+
+    def to_dict(self) -> dict[str, Any]:
+        """响应序列化唯一形态（checks / result-check 端点共用，防字段分叉）。"""
+        return {"name": self.name, "status": self.status, "detail": self.detail}
