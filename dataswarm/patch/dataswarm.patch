+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""databases/controller.py — 库表管理 HTTP 路由分发。
+
+路由前缀: /api/dataagent/databases/
+  GET /databases
+  GET /databases/{db}/tables
+  GET /databases/{db}/tables/{table}
+  GET /databases/{db}/tables/{table}/preview
+  GET /databases/search            ?db_ref=&q=&top_k=
+  GET /databases/schema-gap        ?db_ref=&business=&layers=
+"""
+from __future__ import annotations
+
+from urllib.parse import unquote
+
+from jiuwenswarm.common.workspace_context import (
+    resolve as _resolve_workspace,
+    validate_business_database_name,
+    validate_ref_in_workspace,
+)
+
+from . import service as svc
+from .._common import resolve_db_ref as _resolve_db_ref
+
+
+_PREFIX = "/api/dataagent/databases"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    """剥掉前缀后 split，返回 ['', <segment>, ...]。
+
+    段经 unquote：前端 encodeURIComponent 编码中文库名/表名（文件源的库名
+    是文件名，如 订单表.xlsx），parsed.path 保留编码态，不解码会导致
+    validate_business_database_name 比对失败 → 数据资产页看不到表。
+    """
+    rel = path[len(_PREFIX):].rstrip("/")
+    return [unquote(part) for part in rel.split("/")]
+
+
+def handle_get(handler, parsed) -> None:
+    path = parsed.path.rstrip("/")
+    parts = _split(path)
+    workspace_id = handler._query_arg(parsed, "workspace_id") or ""
+    try:
+        # ['', ''] 或 [''] → list databases
+        if len(parts) == 1 or (len(parts) == 2 and parts[1] == ""):
+            _list_databases(handler, workspace_id)
+            return
+        # ['', 'search']
+        if len(parts) == 2 and parts[1] == "search":
+            db_ref = handler._query_arg(parsed, "db_ref") or ""
+            q = handler._query_arg(parsed, "q") or ""
+            top_k = int(handler._query_arg(parsed, "top_k") or "10")
+            handler._write_json(200, svc.search_tables(db_ref, q, top_k))
+            return
+        # ['', 'schema-gap']
+        if len(parts) == 2 and parts[1] == "schema-gap":
+            db_ref = handler._query_arg(parsed, "db_ref") or ""
+            business = handler._query_arg(parsed, "business") or ""
+            layers = handler._query_arg(parsed, "layers") or "ODS,DWD,DWS,ADS"
+            handler._write_json(200, svc.schema_gap_analysis(db_ref, business, layers))
+            return
+        # ['', '{db}', 'tables']
+        if len(parts) == 3 and parts[2] == "tables":
+            db_ref = _resolve_db_ref(handler, parsed, parts[1])
+            ctx = _resolve_workspace(workspace_id)
+            if "://" in db_ref:
+                db_ref = validate_ref_in_workspace(ctx.workspace_id, "business", db_ref)
+            else:
+                validate_business_database_name(ctx.workspace_id, db_ref)
+            handler._write_json(200, {"tables": svc.list_tables(db_ref)})
+            return
+        # ['', '{db}', 'tables', '{table}', 'preview']
+        if (len(parts) == 5 and parts[2] == "tables" and parts[4] == "preview"):
+            db_ref = _resolve_db_ref(handler, parsed, parts[1])
+            ctx = _resolve_workspace(workspace_id)
+            if "://" in db_ref:
+                db_ref = validate_ref_in_workspace(ctx.workspace_id, "business", db_ref)
+            else:
+                validate_business_database_name(ctx.workspace_id, db_ref)
+            limit = int(handler._query_arg(parsed, "limit") or "10")
+            offset = int(handler._query_arg(parsed, "offset") or "0")
+            handler._write_json(200, svc.preview_table(db_ref, parts[3], limit, offset))
+            return
+        # ['', '{db}', 'tables', '{table}']
+        if len(parts) == 4 and parts[2] == "tables":
+            db_ref = _resolve_db_ref(handler, parsed, parts[1])
+            ctx = _resolve_workspace(workspace_id)
+            if "://" in db_ref:
+                db_ref = validate_ref_in_workspace(ctx.workspace_id, "business", db_ref)
+            else:
+                validate_business_database_name(ctx.workspace_id, db_ref)
+            handler._write_json(200, svc.get_table_detail(db_ref, parts[3]))
+            return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except LookupError as exc:
+        # 表不在数据源目录里（含跨 schema 裸名歧义）：是「找不到」，不是服务端故障。
+        # 500 internal_error 会让技能侧只能报 UNKNOWN（hint 指向查数据库日志）。
+        handler._write_json(404, {"error": "not_found", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    path = parsed.path.rstrip("/")
+    # POST /databases/schema-snapshot —— 批量全表 schema/索引/DDL 快照（方案批次 2 / G18）
+    if path == "/api/dataagent/databases/schema-snapshot":
+        from .._common import read_body
+        body = read_body(handler)
+        db_ref = (body or {}).get("db_ref", "")
+        if not db_ref:
+            handler._write_json(400, {"error": "db_ref_required"})
+            return
+        tables = (body or {}).get("tables")
+        handler._write_json(200, svc.schema_snapshot(db_ref, tables=tables))
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+# --------------------------------------------------------------------------
+# 辅助
+# --------------------------------------------------------------------------
+def _list_databases(handler, workspace_id: str = "") -> None:
+    """GET /api/dataagent/databases。"""
+    try:
+        ctx = _resolve_workspace(workspace_id)
+        databases = svc.list_databases(ctx.business_db_ref)
+        handler._write_json(200, {"databases": databases, "workspace_id": ctx.workspace_id})
+    except ValueError as exc:
+        # WorkspaceBusinessNotBound 等 workspace 校验：400 带错误码
+        handler._write_json(400, {"error": getattr(exc, "code", "bad_request"), "detail": str(exc)})
+    except Exception as exc:
+        handler._write_json(500, {"error": "doris_unavailable", "detail": str(exc)})
