+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/errors.py —— 指标模块统一异常层级与错误码。
+
+设计要点（方案 §阶段 5c）：
+- 每个异常自带 ``code`` / ``retryable`` / ``detail``，``detail`` 必须可操作
+  （说清哪个指标、哪个修订、哪条引用、期望什么），因为 LLM 修正环直接回喂它。
+- ``error_message`` 落库/出网前统一截断到 1000 字符，避免列溢出与日志膨胀。
+- 第三方异常经 :func:`classify` 归一到本层级，不另造一套分类。
+"""
+from __future__ import annotations
+
+# 落库与响应体的 detail 上限（方案 §阶段 5c 约定）
+MAX_DETAIL_LEN = 1000
+
+
+class ErrorCode:
+    """错误码常量。与方案 §阶段 5b 的错误码目录一一对应。"""
+
+    # 定义与导入
+    OSSIE_SCHEMA_INVALID = "OSSIE_SCHEMA_INVALID"
+    DEFINITION_INVALID = "DEFINITION_INVALID"
+    METRIC_NOT_FOUND = "METRIC_NOT_FOUND"
+    BINDING_UNBOUND = "BINDING_UNBOUND"
+    # 发布与投影
+    RELEASE_NOT_FOUND = "RELEASE_NOT_FOUND"
+    PROJECTION_REQUIRED = "PROJECTION_REQUIRED"
+    PROJECTION_STALE = "PROJECTION_STALE"
+    PROJECTION_CONFLICT = "PROJECTION_CONFLICT"
+    PROJECTION_REF_INCOMPLETE = "PROJECTION_REF_INCOMPLETE"
+    # 语义层
+    SEMANTICA_DISABLED = "SEMANTICA_DISABLED"
+    SEMANTICA_UNAVAILABLE = "SEMANTICA_UNAVAILABLE"
+    SEMANTIC_CONTEXT_EMPTY = "SEMANTIC_CONTEXT_EMPTY"
+    CAPABILITY_UNAVAILABLE = "CAPABILITY_UNAVAILABLE"
+    # 查询
+    QUERY_PLAN_INVALID = "QUERY_PLAN_INVALID"
+    SQL_VALIDATION_FAILED = "SQL_VALIDATION_FAILED"
+    PERMISSION_DENIED = "PERMISSION_DENIED"
+    SCHEMA_CHANGED = "SCHEMA_CHANGED"
+    LLM_UNAVAILABLE = "LLM_UNAVAILABLE"
+    # 可重试
+    TRANSIENT = "TRANSIENT"
+
+
+class MetricError(Exception):
+    """指标模块异常基类。
+
+    Args:
+        detail: 可操作的错误说明；超长会被截断到 :data:`MAX_DETAIL_LEN`。
+        code: 错误码，取 :class:`ErrorCode` 常量。
+        retryable: 是否建议调用方重试。
+        request_id: 贯穿一次请求的追踪 ID，可为空。
+    """
+
+    code: str = "METRIC_ERROR"
+    retryable: bool = False
+
+    def __init__(
+        self,
+        detail: str,
+        *,
+        code: str | None = None,
+        retryable: bool | None = None,
+        request_id: str | None = None,
+    ) -> None:
+        self.detail = truncate_detail(detail)
+        self.code = code or self.code
+        self.retryable = self.retryable if retryable is None else retryable
+        self.request_id = request_id
+        super().__init__(self.detail)
+
+    def to_envelope(self) -> dict:
+        """转成统一错误体 ``{error, detail, request_id, retryable}``。"""
+        return {
+            "error": self.code,
+            "detail": self.detail,
+            "request_id": self.request_id,
+            "retryable": self.retryable,
+        }
+
+
+def truncate_detail(detail: str) -> str:
+    """把 detail 截断到 :data:`MAX_DETAIL_LEN`，截断处留省略标记。"""
+    text = str(detail or "")
+    if len(text) <= MAX_DETAIL_LEN:
+        return text
+    return text[: MAX_DETAIL_LEN - 3] + "..."
+
+
+class DefinitionError(MetricError):
+    """指标定义/Ossie 导入类错误（不可重试）。"""
+
+    code = ErrorCode.DEFINITION_INVALID
+
+
+class OssieSchemaError(DefinitionError):
+    """Ossie 文件不合官方 schema 或 ``profile_version`` 不符。"""
+
+    code = ErrorCode.OSSIE_SCHEMA_INVALID
+
+
+class MetricNotFound(DefinitionError):
+    """指标或修订不存在。"""
+
+    code = ErrorCode.METRIC_NOT_FOUND
+
+
+class BindingUnbound(DefinitionError):
+    """指标修订未绑定到可解析的物理表列。"""
+
+    code = ErrorCode.BINDING_UNBOUND
+
+
+class ProjectionError(MetricError):
+    """发布投影类错误。"""
+
+    code = ErrorCode.PROJECTION_REF_INCOMPLETE
+
+
+class ReleaseNotFound(ProjectionError):
+    """发布批次不存在。"""
+
+    code = ErrorCode.RELEASE_NOT_FOUND
+
+
+class ProjectionRequired(ProjectionError):
+    """要求已发布投影但没有成功投影（含首次发布失败）。"""
+
+    code = ErrorCode.PROJECTION_REQUIRED
+
+
+class ProjectionStale(ProjectionError):
+    """当前使用的是旧 release 的投影。"""
+
+    code = ErrorCode.PROJECTION_STALE
+
+
+class ProjectionConflict(ProjectionError):
+    """并发发布同一 ``(metric_id, revision)``。"""
+
+    code = ErrorCode.PROJECTION_CONFLICT
+    retryable = True
+
+
+class SemanticStoreError(MetricError):
+    """语义层不可用类错误。"""
+
+    code = ErrorCode.SEMANTICA_UNAVAILABLE
+    retryable = True
+
+
+class SemanticaDisabled(SemanticStoreError):
+    """Semantica 未安装或未启用。"""
+
+    code = ErrorCode.SEMANTICA_DISABLED
+    retryable = False
+
+
+class SemanticContextEmpty(SemanticStoreError):
+    """检索不到语义上下文。"""
+
+    code = ErrorCode.SEMANTIC_CONTEXT_EMPTY
+    retryable = False
+
+
+class CapabilityUnavailable(SemanticStoreError):
+    """当前 transport 不支持某能力。
+
+    绝不静默伪造空关系或空候选——调用方必须显式处理。
+    """
+
+    code = ErrorCode.CAPABILITY_UNAVAILABLE
+    retryable = False
+
+
+class QueryPlanError(MetricError):
+    """LLM 意图越权或查询规格非法（可回喂修正）。"""
+
+    code = ErrorCode.QUERY_PLAN_INVALID
+    retryable = True
+
+
+class SqlValidationError(MetricError):
+    """SQL 校验失败（只读/语法/对象范围/口径约束）。"""
+
+    code = ErrorCode.SQL_VALIDATION_FAILED
+    retryable = True
+
+
+class PermissionDenied(MetricError):
+    """授权范围校验失败，不重试。"""
+
+    code = ErrorCode.PERMISSION_DENIED
+    retryable = False
+
+
+class SchemaChanged(MetricError):
+    """绑定表列与真实 schema 不一致（反幽灵失败），不重试。"""
+
+    code = ErrorCode.SCHEMA_CHANGED
+    retryable = False
+
+
+class LLMUnavailable(MetricError):
+    """LLM 返回空串或不可用。"""
+
+    code = ErrorCode.LLM_UNAVAILABLE
+    retryable = True
+
+
+class TransientError(MetricError):
+    """可重试的瞬时错误：超时 / 429 / 5xx / 连接失败。"""
+
+    code = ErrorCode.TRANSIENT
+    retryable = True
+
+
+def classify(exc: BaseException) -> MetricError:
+    """把任意异常归一到 :class:`MetricError` 层级。
+
+    已经是 MetricError 的原样返回；其余按类型映射到瞬时错误或定义错误，
+    保留原始异常为 ``__cause__`` 便于排查。
+
+    Args:
+        exc: 待归一的异常。
+
+    Returns:
+        归一后的 MetricError 实例。
+    """
+    if isinstance(exc, MetricError):
+        return exc
+    text = f"{type(exc).__name__}: {exc}"
+    lowered = text.lower()
+    # 连接/超时/限流/服务端错误 → 可重试
+    transient_markers = ("timeout", "timed out", "connection", "429", "500", "502", "503", "504")
+    if any(marker in lowered for marker in transient_markers):
+        return TransientError(text)
+    return DefinitionError(text)
