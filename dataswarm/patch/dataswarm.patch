+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/meta_data — 元数据存储策略层。
+
+通过 MetadataStore ABC + @register + get_store() 工厂，
+消除业务代码中的 if/else 数据库分支，配置驱动后端选择。
+"""
+from .base import MetadataStore, get_store, register
+
+# 触发 @register 装饰器，确保实现类注册到 _REGISTRY
+from .sqlite_store import SqliteMetadataStore  # noqa: F401
+from .doris_store import DorisMetadataStore     # noqa: F401
