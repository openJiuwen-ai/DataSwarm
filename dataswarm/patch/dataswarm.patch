+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis HTTP 面错误映射：PermissionError 必须落 403（第二轮重构台账 A-3）。
+
+`explore.probe/check_join` 对敏感列 raise PermissionError（docstring 承诺
+403），但 api 层只映射 (TypeError, ValueError)→400 / Exception→500——
+权限拒绝被当成服务器内部错误，dwcli 透传 http_code 后 LLM 会把它当
+可重试错误浪费预算。
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.analysis import api, explore
+
+
+class _Handler:
+    def __init__(self):
+        self.headers = {"Content-Length": "0"}
+        self.responses = []
+
+    def _write_json(self, code, payload):
+        self.responses.append((code, payload))
+
+
+def _post(endpoint: str) -> tuple[_Handler, SimpleNamespace]:
+    handler = _Handler()
+    return handler, SimpleNamespace(path=f"/api/dataagent/analysis/{endpoint}")
+
+
+@pytest.mark.parametrize("endpoint", ["probe", "check-join"])
+def test_permission_error_maps_403(monkeypatch, endpoint):
+    def _raise(body):
+        raise PermissionError("列 t.c 为敏感列，禁止取值探查")
+
