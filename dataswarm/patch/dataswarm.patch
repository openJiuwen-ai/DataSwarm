+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/explore.py 行协议适配测试。
+
+背景（2026-10-20 评测 olist-07 定位）：run_sql 两条路径（db_connector.query
+与 source connector）都返回 list 行 + columns 位置序，而 probe_request /
+_sample_inclusion 原按 dict 行 ``row.get(key)`` 取值 → 对真实数据源必抛
+``'list' object has no attribute 'get'``（评测里表现为 probe internal_error，
+组件自降 G2）。修复引入 ``_row_get`` 按 columns 位置取值。
+"""
+from types import SimpleNamespace
+
+import jiuwenswarm.channels.web.dataagent.analysis.explore as explore
+
+
+class TestIdentifierQuoting:
+    """探针 SQL 的标识符引号必须跟随源方言。
+
+    回归（2026-11-05）：probe 硬编码反引号，duckdb/postgres 方言的源在
+    护栏 ``sqlglot.parse(read=duckdb)`` 阶段即报
+    ``Invalid expression / Unexpected token. Line 1, Col: 24``——
+    ``dedsa.sales_orders.Delivery_Status`` 维值探查失败。
+    """
+
+    def _probe_sql(self, monkeypatch, source_type: str) -> str:
+        column = SimpleNamespace(
+            name="Delivery_Status", status="active", is_sensitive=False,
+            data_type="VARCHAR", source_type=source_type)
+        snapshot = SimpleNamespace(
+            source=SimpleNamespace(source_id="dedsa"),
+            tables=[SimpleNamespace(name="sales_orders", columns=[column])])
+        monkeypatch.setattr(explore.semantic_link, "current_snapshots",
+                            lambda warnings=None: ([], {"snap": snapshot}))
+        monkeypatch.setattr(explore.workspace_context, "current_workspace",
+                            lambda: SimpleNamespace(workspace_id="ws"))
+        captured: dict[str, str] = {}
+
+        def fake_run_sql(_ref, sql, limit=0, workspace_id=None, source_id=None):
+            captured["sql"] = sql
+            return {"ok": True, "rows": [], "columns": ["value", "cnt"]}
+
+        monkeypatch.setattr(explore.sql_service, "run_sql", fake_run_sql)
+        explore.probe_request({"source_id": "dedsa", "table": "sales_orders",
+                               "column": "Delivery_Status"})
+        return captured["sql"]
+
+    def test_duckdb_source_uses_double_quotes(self, monkeypatch):
+        sql = self._probe_sql(monkeypatch, "duckdb")
+        assert '"Delivery_Status"' in sql
+        assert "`" not in sql
+
+    def test_mysql_source_keeps_backticks(self, monkeypatch):
+        sql = self._probe_sql(monkeypatch, "mysql")
+        assert "`Delivery_Status`" in sql
+
+    def test_sample_inclusion_sql_follows_dialect(self, monkeypatch):
+        captured: dict[str, str] = {}
+
+        def fake_run_sql(_ref, sql, limit=0, workspace_id=None, source_id=None):
+            captured["sql"] = sql
+            return {"ok": True, "rows": [[10, 5]], "columns": ["total", "hit"]}
+
+        monkeypatch.setattr(explore.sql_service, "run_sql", fake_run_sql)
+        explore._sample_inclusion("ws", "dedsa", "t1", "c1", "t2", "c2", dialect="duckdb")
+        assert '"c1"' in captured["sql"]
+        assert "`" not in captured["sql"]
+
+
+class TestRowGet:
+    def _columns(self) -> list[str]:
+        return ["value", "cnt"]
+
+    def test_list_row_by_column_position(self):
+        assert explore._row_get(["credit_card", 7], self._columns(), "value") == "credit_card"
+        assert explore._row_get(["credit_card", 7], self._columns(), "cnt") == 7
+
+    def test_dict_row_passthrough(self):
+        assert explore._row_get({"value": "boleto", "cnt": 3}, self._columns(), "value") == "boleto"
+
+    def test_missing_column_returns_none(self):
+        assert explore._row_get(["x"], self._columns(), "absent") is None
+
+    def test_none_value_is_none(self):
+        assert explore._row_get([None, 1], self._columns(), "value") is None
+
+
+class TestSampleInclusionRowParsing:
+    """_sample_inclusion 的 run_sql 桩按 list 行协议返回，验证 total/hit 位置取值。"""
+
+    def _run(self, monkeypatch, rows):
+        result = {"ok": True, "rows": rows, "columns": ["total", "hit"]}
+
+        def fake_run_sql(_ref, _sql, limit=0, workspace_id=None, source_id=None):
+            return result
+
+        monkeypatch.setattr(explore.sql_service, "run_sql", fake_run_sql)
+        return explore._sample_inclusion("ws", "src", "t1", "c1", "t2", "c2")
+
+    def test_ratio_from_list_rows(self, monkeypatch):
+        assert self._run(monkeypatch, [[100, 25]]) == 0.25
+
+    def test_zero_total_returns_none(self, monkeypatch):
+        assert self._run(monkeypatch, [[0, 0]]) is None
+
+    def test_empty_rows_returns_none(self, monkeypatch):
+        assert self._run(monkeypatch, []) is None
