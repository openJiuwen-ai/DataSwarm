+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_aggregate_check GROUP BY 聚合校验单测（dialect-convergence 批次 1b G8 真相源）。"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+_SCRIPT = (_REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+           / "skills" / "_dw_common" / "scripts" / "dw_aggregate_check.py")
+
+
+@pytest.fixture(scope="module")
+def dac():
+    spec = importlib.util.spec_from_file_location("_dw_agg_check_test", _SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault("_dw_agg_check_test", mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+GOOD = """INSERT INTO dws_t (ym, amt)
+SELECT
+  DATE_FORMAT(dt, '%Y-%m') AS ym,
+  SUM(amt) AS amt
+FROM dwd_o GROUP BY DATE_FORMAT(dt, '%Y-%m')"""
+
+BAD = """INSERT INTO dws_t (ym, amt, extra)
+SELECT
+  DATE_FORMAT(dt, '%Y-%m') AS ym,
+  SUM(amt) AS amt,
+  cust_name AS extra
+FROM dwd_o GROUP BY DATE_FORMAT(dt, '%Y-%m')"""
+
+
+def test_good_group_by_passes(dac):
+    dac.assert_group_by_output(GOOD, "dws_t")  # 不抛
+
+
+def test_bad_output_column_raises(dac):
+    with pytest.raises(ValueError, match="extra"):
+        dac.assert_group_by_output(BAD, "dws_t")
+
+
+def test_no_group_by_skips(dac):
+    dac.assert_group_by_output("INSERT INTO t SELECT 1", "t")  # 不抛
+
+
+def test_non_insert_skips(dac):
+    dac.assert_group_by_output("SELECT * FROM t", "t")  # 不抛
+
+
+def test_round_wrapped_aggregate_passes(dac):
+    sql = ("INSERT INTO t (a, b) SELECT g AS a, ROUND(SUM(x), 2) AS b "
+           "FROM s GROUP BY g")
+    dac.assert_group_by_output(sql, "t")  # 不抛
+
+
+def test_coalesce_wrapped_aggregate_passes(dac):
+    sql = ("INSERT INTO t (a, b) SELECT g AS a, COALESCE(SUM(x), 0) AS b "
+           "FROM s GROUP BY g")
+    dac.assert_group_by_output(sql, "t")  # 不抛
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
