+    monkeypatch.setattr(_dwcli_mod(), "_analysis", lambda group, action, body: {
+        "validation": {"ok": True, "errors": []}, "plan": body["plan"]})
+    plan_file = tmp_path / "plan.json"
+    plan_file.write_text(json.dumps({"mode": "open", "question": "经营复盘",
