+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/lineage —— 任务驱动的血缘生产层。
+
+血缘的唯一生产者是任务（编排模块）。本包负责：
+    parser.parse_sql(sql, default_db)  解析 SQL → 结构化 edges（不落库，供预览/单测）
+    writer.write_from_sql(...)         edges → bigdata.table_lineage / column_lineage 落库
+
+设计要点：
+    - 正则解析（_parse_select_columns / _extract_source_col / _extract_join_key）
+      **不依赖人工声明的 source_tables**，纯从 SQL 文本解析源/目标表+列。
+    - 解析不出的（复杂 SQL / 非 INSERT）返回空 edges，调用方按 lineage_type='manual'
+      交人工标注兜底。
+    - parser 纯函数、无 IO，便于单测；writer 走 db_connector 写 bigdata。
+"""
+from .parser import parse_sql, ParseResult  # noqa: F401
+from .writer import write_from_sql, write_from_manual, ensure_schema, WriteResult  # noqa: F401
diff --git a/jiuwenswarm/channels/web/orchestration/lineage/parser.py b/jiuwenswarm/channels/web/orchestration/lineage/parser.py
new file mode 100644
index 000000000..94c354d3e
--- /dev/null
+++ b/jiuwenswarm/channels/web/orchestration/lineage/parser.py
@@ -0,0 +1,380 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage/parser.py —— SQL → 血缘 edges 解析器（纯函数，无 IO）。
+
+正则解析不依赖人工声明的 plan_table.source_tables——源表也从 SQL 文本解析（FROM/JOIN 子句）。
+
+解析范围（MVP）：
+    - 表级：INSERT INTO <target> + FROM/JOIN <source> + ON <join_key> → 表边
+    - 字段级：SELECT <expr> AS <alias> → source_col → target_col（带 transformation）
+    - 非 INSERT 的纯 SELECT 查询 → 不产血缘（只读消费，非产出）
+    - CREATE TABLE <target> AS SELECT ... → 同 INSERT 处理（CTAS）
+    - 复杂 SQL（CTE/UNION/子查询）→ 尽力解析；解析不出的边跳过，不阻断
+
+返回 ParseResult（table_edges / column_edges），不落库。
+"""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+
+
+@dataclass
+class TableEdge:
+    source_db: str
+    source_table: str
+    target_db: str
+    target_table: str
+    join_key: str | None = None
+    lineage_type: str = "etl"  # etl | manual | import
+
+
+@dataclass
+class ColumnEdge:
+    source_db: str
+    source_table: str
+    source_column: str
+    target_db: str
+    target_table: str
+    target_column: str
+    transformation: str | None = None
+
+
+@dataclass
+class ParseResult:
+    """SQL 解析结果。is_write=False 表示非写入类 SQL（纯查询），不产血缘。"""
+    is_write: bool = False
+    target_db: str = ""
+    target_table: str = ""
+    table_edges: list[TableEdge] = field(default_factory=list)
+    column_edges: list[ColumnEdge] = field(default_factory=list)
+
+    def to_dicts(self) -> dict:
+        """便于序列化/日志/预览 API 返回。"""
+        return {
+            "is_write": self.is_write,
+            "target": {"db": self.target_db, "table": self.target_table},
+            "table_edges": [
+                {"source_db": e.source_db, "source_table": e.source_table,
+                 "target_db": e.target_db, "target_table": e.target_table,
+                 "join_key": e.join_key, "lineage_type": e.lineage_type}
+                for e in self.table_edges
+            ],
+            "column_edges": [
+                {"source_db": e.source_db, "source_table": e.source_table,
+                 "source_column": e.source_column,
+                 "target_db": e.target_db, "target_table": e.target_table,
+                 "target_column": e.target_column, "transformation": e.transformation}
+                for e in self.column_edges
+            ],
+        }
+
+
+# --------------------------------------------------------------------------
+# 正则（迁移自 infer_lineage_from_plan.py，保持一致）
+# --------------------------------------------------------------------------
+# INSERT INTO `db`.`table` / INSERT INTO `table` / INSERT INTO db.table
+# 库前缀可选；用 (?:(\w+)\s*\.\s*)? 确保带点才进组，否则整组不匹配
+_RE_INSERT_TARGET = re.compile(
+    r"INSERT\s+(?:OR\s+REPLACE\s+)?INTO\s+(?:`?(\w+)`?\s*\.\s*)?`?(\w+)`?",
+    re.IGNORECASE,
+)
+# CREATE TABLE `db`.`table` AS SELECT ...  (CTAS)；OR REPLACE 是 DuckDB 形态
+_RE_CTAS_TARGET = re.compile(
+    r"CREATE\s+(?:OR\s+REPLACE\s+)?TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?(?:`?(\w+)`?\s*\.\s*)?`?(\w+)`?\s+AS\s+SELECT",
+    re.IGNORECASE,
+)
+# FROM/JOIN 后的源表：FROM `db`.`table` / FROM `table` / JOIN `table`
+# 不匹配子查询（FROM (SELECT...)）；MVP 只抓裸表引用。
+_RE_SOURCE_TABLE = re.compile(
+    r"(?:FROM|JOIN)\s+(?:`?(\w+)`?\s*\.\s*)?`?(\w+)`?",
+    re.IGNORECASE,
+)
+# CTE 定义：WITH name AS ( 或 WITH name AS SELECT
+_RE_CTE_DEF = re.compile(
+    r"\bWITH\s+(\w+)\s+AS\s*\(",
+    re.IGNORECASE,
+)
+# 多 CTE：递归或逗号分隔的 CTE 名（WITH a AS (...), b AS (...)）
+_RE_CTE_NAMES = re.compile(
+    r"\bWITH\s+(\w+)\s+AS\s*\(|,\s*(\w+)\s+AS\s*\(",
+    re.IGNORECASE,
+)
+# ON `a`.`col` = `b`.`col`  或  a.col = b.col（无反引号）
+_RE_JOIN_KEY = re.compile(
+    r"ON\s+`?(\w+)`?\s*\.\s*`?(\w+)`?\s*=\s*`?(\w+)`?\s*\.\s*`?(\w+)`?",
+    re.IGNORECASE,
+)
+_RE_SELECT_COLS = re.compile(r"SELECT\s+(.*?)\s+FROM", re.DOTALL | re.IGNORECASE)
+_RE_AS_ALIAS = re.compile(r"\bAS\s+`?(\w+)`?\s*$", re.IGNORECASE)
+_RE_BARE_COL = re.match  # alias placeholder, real use below
+_RE_INNER_COL = re.compile(r"`(\w+)`")  # 反引号列：`col`
+# 括号内的列引用：FUNC(alias.col) / FUNC(col) → 抓 alias.col 或 col
+_RE_FUNC_INNER = re.compile(r"\(([^)]*)\)")
+_RE_COL_REF = re.compile(r"`?(\w+)`?(?:\.`?(\w+)`?)?$")
+
+
+def _split_select_clause(select_clause: str) -> list[str]:
+    """按逗号切 SELECT 列（忽略括号嵌套）。迁移自 _parse_select_columns。"""
+    parts: list[str] = []
+    depth = 0
+    current = ""
+    for ch in select_clause:
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+        elif ch == "," and depth == 0:
+            parts.append(current.strip())
+            current = ""
+            continue
+        current += ch
+    if current.strip():
+        parts.append(current.strip())
+    return parts
+
+
+def _parse_select_columns(select_sql: str) -> list[tuple[str, str]]:
+    """SELECT 子句 → [(target_col, source_expr)]。迁移自 infer_lineage。"""
+    m = _RE_SELECT_COLS.search(select_sql)
+    if not m:
+        return []
+    select_clause = m.group(1).strip()
+    parts = _split_select_clause(select_clause)
+    mappings: list[tuple[str, str]] = []
+    for part in parts:
+        m2 = _RE_AS_ALIAS.search(part)
+        if m2:
+            target_col = m2.group(1)
+            source_expr = part[: m2.start()].strip()
+        else:
+            m3 = _RE_COL_REF.match(part.strip())
+            if m3:
+                target_col = m3.group(2) or m3.group(1)
+                source_expr = part.strip()
+            else:
+                continue
+        mappings.append((target_col, source_expr))
+    return mappings
+
+
+def _extract_source_col(expr: str) -> str | None:
+    """从表达式抽源列名。迁移自 infer_lineage，增强：函数表达式优先抽括号内列。
+
+    `o.amount` → amount；`SUM(o.amount)` → amount；`amount` → amount。
+    """
+    expr = expr.strip()
+    # 反引号列：`col`
+    m = _RE_INNER_COL.search(expr)
+    if m:
+        return m.group(1)
+    # 函数表达式：FUNC(...) → 抓括号内的第一个列引用
+    fm = _RE_FUNC_INNER.search(expr)
+    if fm:
+        inner = fm.group(1).strip()
+        # inner 可能是 `alias.col` 或 `col` 或 `alias.col, alias.col2`
+        first = inner.split(",")[0].strip()
+        if "." in first:
+            return first.split(".")[-1].strip("` ")
+        return first.strip("` ")
+    # 纯列引用：col 或 alias.col
+    cm = _RE_COL_REF.match(expr)
+    if cm:
+        return cm.group(2) or cm.group(1)
+    return None
+
+
+def _extract_join_key(sql: str) -> str | None:
+    """ON a.c1 = b.c2 → join_key。迁移自 _extract_join_key，支持有无反引号。"""
+    m = _RE_JOIN_KEY.search(sql)
+    if not m:
+        return None
+    # 组 2 = 左列，组 4 = 右列（group(1)/group(3) 是表别名，忽略）
+    left, right = m.group(2), m.group(4)
+    return left if left == right else f"{left}/{right}"
+
+
+def _normalize_ref(db: str | None, table: str, default_db: str) -> tuple[str, str]:
+    """db 为空时用 default_db 填充。"""
+    return (db or default_db, table)
+
+
+def _extract_cte_names(sql: str) -> set[str]:
+    """提取 SQL 中所有 CTE 名称（WITH name AS (...)）。用于从源表中排除 CTE 引用。"""
+    names: set[str] = set()
+    for m in _RE_CTE_NAMES.finditer(sql):
+        # group(1) = WITH 后的第一个 CTE 名；group(2) = 逗号后的后续 CTE 名
+        name = m.group(1) or m.group(2)
+        if name:
+            names.add(name.lower())
+    return names
+
+
+def _find_sources(sql: str, default_db: str) -> list[tuple[str, str]]:
+    """从 FROM/JOIN 子句抽源表（去重，保序）。过滤 CTE 名和子查询。"""
+    cte_names = _extract_cte_names(sql)
+    table_functions = {"read_csv", "read_csv_auto", "read_xlsx", "read_parquet", "read_json"}
+    sources: list[tuple[str, str]] = []
+    seen: set[tuple[str, str]] = set()
+    for m in _RE_SOURCE_TABLE.finditer(sql):
+        db, table = m.group(1), m.group(2)
+        # 过滤 SQL 关键字被误当表名（SELECT...FROM 后接 WHERE 等）
+        if table.upper() in ("SELECT", "WHERE", "GROUP", "ORDER", "HAVING",
+                              "LIMIT", "UNION", "JOIN", "ON", "AS", "DUAL"):
+            continue
+        # 过滤 CTE 名（CTE 不是真实表，不应作为源表边）
+        if table.lower() in cte_names:
+            continue
+        if table.lower() in table_functions:
+            continue
+        db, table = _normalize_ref(db, table, default_db)
+        if (db, table) not in seen:
+            seen.add((db, table))
+            sources.append((db, table))
+    return sources
+
+
+# FROM ods.orders o / JOIN ods.customers c → 别名→真实表映射
+# 抓 FROM/JOIN 后的 表 + 可选别名（别名是紧随其后的裸标识符）
+_RE_TABLE_ALIAS = re.compile(
+    r"(?:FROM|JOIN)\s+(?:`?(\w+)`?\s*\.\s*)?`?(\w+)`?\s+(?:AS\s+)?(\w+)",
+    re.IGNORECASE,
+)
+
+
+def _build_alias_map(sql: str, default_db: str) -> dict[str, tuple[str, str]]:
+    """别名 → (db, table)。FROM ods.orders o → {'o': ('ods','orders')}。"""
+    amap: dict[str, tuple[str, str]] = {}
+    for m in _RE_TABLE_ALIAS.finditer(sql):
+        db, table, alias = m.group(1), m.group(2), m.group(3)
+        if alias.upper() in ("SELECT", "WHERE", "GROUP", "ORDER", "HAVING",
+                              "LIMIT", "UNION", "JOIN", "ON", "AS", "DUAL",
+                              "LEFT", "RIGHT", "INNER", "OUTER", "CROSS"):
+            continue
+        db, table = _normalize_ref(db, table, default_db)
+        amap[alias] = (db, table)
+    return amap
+
+
+def _normalize_quotes(sql: str) -> str:
+    """把双引号标识符（DuckDB/PostgreSQL 风格）转成反引号，供下游正则消费。
+
+    只转标识符位置的双引号：单引号字符串字面量（'...'）整体跳过，
+    其内部的双引号不动。字符串字面量在 ETL SQL 里只出现在 CAST/
+    date_diff 等函数参数中，不会被误转后也不会影响 FROM/JOIN 解析。
+    """
+    out: list[str] = []
+    in_single = False
+    i = 0
+    n = len(sql)
+    while i < n:
+        ch = sql[i]
+        if ch == "'":
+            in_single = not in_single
+            out.append(ch)
+            i += 1
+        elif ch == '"' and not in_single:
+            # 找配对的关闭双引号，整体替换为反引号
+            j = sql.find('"', i + 1)
+            if j == -1:
+                out.append(ch)
+                i += 1
+            else:
+                out.append("`")
+                out.append(sql[i + 1:j])
+                out.append("`")
+                i = j + 1
+        else:
+            out.append(ch)
+            i += 1
+    return "".join(out)
+
+
+def parse_sql(sql: str, default_db: str = "") -> ParseResult:
+    """解析 SQL → 血缘 edges。
+
+    - INSERT INTO target SELECT ... FROM sources → 表边 sources→target + 字段边
+    - CREATE TABLE target AS SELECT ... → 同上（CTAS）
+    - 纯 SELECT（无 INSERT/CTAS）→ is_write=False，不产血缘（只读消费）
+    - 解析不出目标表 → is_write=False（非写入，不产血缘）
+    """
+    if not sql or not sql.strip():
+        return ParseResult()
+
+    # DuckDB/PostgreSQL 双引号标识符 → 反引号（下游正则只认反引号/裸标识符）
+    sql = _normalize_quotes(sql)
+
+    # 找目标表（INSERT 或 CTAS）
+    target_db: str = ""
+    target_table: str = ""
+    m = _RE_INSERT_TARGET.search(sql)
+    if m:
+        target_db, target_table = _normalize_ref(m.group(1), m.group(2), default_db)
+    else:
+        m = _RE_CTAS_TARGET.search(sql)
+        if m:
+            target_db, target_table = _normalize_ref(m.group(1), m.group(2), default_db)
+    if not target_table:
+        # 非写入类 SQL，不产血缘
+        return ParseResult(is_write=False)
+
+    sources = _find_sources(sql, default_db)
+    alias_map = _build_alias_map(sql, default_db)
+    join_key = _extract_join_key(sql)
+
+    table_edges: list[TableEdge] = [
+        TableEdge(source_db=s[0], source_table=s[1],
+                  target_db=target_db, target_table=target_table,
+                  join_key=join_key, lineage_type="etl")
+        for s in sources
+    ]
+
+    # 字段级
+    column_edges: list[ColumnEdge] = []
+    col_mappings = _parse_select_columns(sql)
+    for target_col, source_expr in col_mappings:
+        src_col = _extract_source_col(source_expr)
+        if not src_col:
+            continue
+        # 源表定位：优先 `alias`.`col` → 别名映射；否则 `table`.`col` → 直接表；
+        # 否则用第一个源表兜底
+        tbl_match = re.search(r"`?(\w+)`?\s*\.\s*`?(\w+)`?", source_expr)
+        if tbl_match:
+            ref_name, col2 = tbl_match.group(1), tbl_match.group(2)
+            if ref_name in alias_map:
+                s_db, s_tbl = alias_map[ref_name]
+                s_col = col2
+            elif any(ref_name == s[1] for s in sources):
+                # ref_name 是已解析的真实源表名（无别名，直接 table.col 引用）
+                s_db, s_tbl = next(s for s in sources if s[1] == ref_name)
+                s_col = col2
+            else:
+                # 子查询别名（如 a.col / b.col）不在 alias_map 中，
+                # 也非真实表名 → 无法确定具体源表，用第一个源表兜底
+                if not sources:
+                    continue
+                s_db, s_tbl = sources[0]
+                s_col = col2
+        else:
+            if not sources:
+                continue
+            s_db, s_tbl = sources[0]
+            s_col = src_col
+        # transformation：只有函数/运算表达式才算 transformation；
+        # 纯列引用（col / alias.col，含反引号）视为直传，transformation=None
+        expr_stripped = source_expr.strip()
+        is_plain_col = bool(re.fullmatch(
+            r"`?\w+`?\s*\.\s*`?\w+`?|`?\w+`?", expr_stripped))
+        transformation = None if is_plain_col else expr_stripped
+        column_edges.append(ColumnEdge(
+            source_db=s_db, source_table=s_tbl, source_column=s_col,
+            target_db=target_db, target_table=target_table, target_column=target_col,
+            transformation=transformation,
+        ))
+
+    return ParseResult(
+        is_write=True,
+        target_db=target_db,
+        target_table=target_table,
+        table_edges=table_edges,
+        column_edges=column_edges,
+    )
diff --git a/jiuwenswarm/channels/web/orchestration/lineage/writer.py b/jiuwenswarm/channels/web/orchestration/lineage/writer.py
new file mode 100644
index 000000000..1011e6cf2
--- /dev/null
+++ b/jiuwenswarm/channels/web/orchestration/lineage/writer.py
@@ -0,0 +1,278 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage/writer.py —— edges → bigdata.table_lineage / column_lineage 落库。
+
+血缘写入的三个时机（见 plan §3.3）：
+    - 保存任务（preview-lineage 端点）：不落库，只调 parser 返回，不走 writer
+    - 发布任务（publish）：write_from_sql(plan_id=task_id, ...)   构建时落库
+    - 执行任务（workflow_engine）：write_from_sql(plan_id=instance_id, ...)  运行时权威
+
+幂等策略：Doris 不支持 INSERT IGNORE。写前按 (plan_id, task_id) 删旧边，再 INSERT
+全部新边——该任务该版本的血缘整体替换。唯一索引 uniq_t_lineage/uniq_c_lineage
+在并发/异常残留时兜底（冲突时 DELETE 失败则该边 ignored）。
+
+task_id：产出任务 ID，写进 table_lineage.task_id / column_lineage.task_id（新列，
+ensure_schema 加）。用于前端"产出任务"桥接 + 一致性巡检。
+
+连接：走 db_connector.execute(metadata_db_ref, ...)，与编排模块其他写入同一连接层。
+      writer 不自建连接、不引表 DDL（表由 deploy/schema 真相源统一初始化），
+      但 ensure_schema 幂等加 task_id 列（若缺）。
+"""
+from __future__ import annotations
+
+import logging
+import uuid
+from dataclasses import dataclass
+from datetime import datetime
+
+from jiuwenswarm.channels.web import timeutil
+
+from . import parser as lineage_parser
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class WriteResult:
+    inserted_table: int = 0
+    ignored_table: int = 0
+    inserted_column: int = 0
+    ignored_column: int = 0
+    skipped: str = ""  # 非写入 SQL / 解析失败的原因
+
+    def to_dict(self) -> dict:
+        return {
+            "inserted_table": self.inserted_table,
+            "ignored_table": self.ignored_table,
+            "inserted_column": self.inserted_column,
+            "ignored_column": self.ignored_column,
+            "skipped": self.skipped,
+        }
+
+
+def _lineage_id(prefix: str) -> str:
+    return f"{prefix}_{uuid.uuid4().hex[:12]}"
+
+
+def ensure_schema(db_ref: str | None = None) -> None:
+    """幂等加 task_id / business_ref 列到 table_lineage / column_lineage（若缺）。
+
+    Doris ALTER TABLE ADD COLUMN；缺列才加，已存在跳过。
+    """
+    from jiuwenswarm.common import db_connector  # noqa: E402
+    target_ref = db_ref or _default_db_ref()
+    for tbl in ("table_lineage", "column_lineage"):
+        try:
+            cols = db_connector.schema(target_ref, tbl).get("columns", [])
+            names = [c["name"] for c in cols]
+            if "task_id" not in names:
+                db_connector.execute(
+                    target_ref,
+                    f"ALTER TABLE {tbl} ADD COLUMN task_id VARCHAR(64) NULL",
+                )
+            if "business_ref" not in names:
+                db_connector.execute(
+                    target_ref,
+                    f"ALTER TABLE {tbl} ADD COLUMN business_ref VARCHAR(512) NULL",
+                )
+        except Exception:
+            # 列已存在或权限问题，忽略；写入时会再暴露
+            pass
+
+
+def _resolve_business_ref(business_ref: str | None = None) -> str | None:
+    """解析本批血缘边归属的业务数据源 ref，规范化后返回。
+
+    优先级：显式参数（任务的 datasource_ref）> 当前工作空间绑定。
+    全失败返回 None——宁 NULL 不丢整条血缘（写入不阻断）。
+    """
+    from jiuwenswarm.common import workspace_context  # noqa: E402
+
+    ref = str(business_ref or "").strip()
+    if not ref:
+        try:
+            ref = str(workspace_context.current_workspace().business_db_ref or "").strip()
+        except Exception:  # noqa: BLE001 —— 无 workspace 上下文时 fallback None
+            return None
+    if not ref:
+        return None
+    try:
+        return workspace_context.normalize_db_ref(ref)
+    except Exception:  # noqa: BLE001 —— ref 解析失败不阻断写入
+        return None
+
+
+def write_from_sql(
+    task_id: str,
+    plan_id: str,
+    sql: str,
+    default_db: str = "",
+    db_ref: str | None = None,
+    business_ref: str | None = None,
+) -> WriteResult:
+    """解析 SQL 并把血缘边写入 bigdata.table_lineage / column_lineage。
+
+    参数：
+        task_id: 产出任务 ID（写 task_id 列）
+        plan_id: 版本键（publish=task_id；执行=instance_id）
+        sql: 任务的 SQL（executor_type='sql' 时即 task['code']）
+        default_db: SQL 里未带库前缀时的默认库名（= datasource_ref 的库名）
+        db_ref: 写入目标库的 db-ref（默认用编排模块 metadata_db_ref → bigdata）
+        business_ref: 归属业务数据源 ref（默认 fallback 当前工作空间绑定，
+            规范化后写 business_ref 列——跨数据源血缘隔离键）
+    """
+    from jiuwenswarm.common import db_connector  # noqa: E402  （已上收至 jiuwenswarm.common）
+
+    target_ref = db_ref or _default_db_ref()
+    ensure_schema(target_ref)
+    biz_ref = _resolve_business_ref(business_ref)
+
+    parsed = lineage_parser.parse_sql(sql, default_db=default_db)
+    if not parsed.is_write:
+        return WriteResult(skipped="非写入类 SQL（纯 SELECT 或无法解析目标表），不产血缘")
+
+    # 删旧（该任务该版本的所有边），保证幂等
+    _delete_task_edges(target_ref, plan_id, task_id)
+
+    res = WriteResult()
+    # 写表级边
+    now = timeutil.now_db_datetime()
+    for e in parsed.table_edges:
+        try:
+            db_connector.execute(
+                target_ref,
+                "INSERT INTO table_lineage "
+                "(lineage_id, plan_id, source_db, source_table, "
+                " target_db, target_table, join_key, lineage_type, "
+                " transformation, task_id, business_ref, created_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (_lineage_id("tl"), plan_id, e.source_db, e.source_table,
+                 e.target_db, e.target_table, e.join_key, e.lineage_type,
+                 None, task_id, biz_ref, now),
+                commit=True,
+            )
+            res.inserted_table += 1
+        except Exception:
+            res.ignored_table += 1
+
+    # 写字段级边
+    for e in parsed.column_edges:
+        try:
+            db_connector.execute(
+                target_ref,
+                "INSERT INTO column_lineage "
+                "(column_lineage_id, plan_id, source_db, source_table, source_column, "
+                " target_db, target_table, target_column, transformation, task_id, "
+                " business_ref, created_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (_lineage_id("cl"), plan_id, e.source_db, e.source_table,
+                 e.source_column, e.target_db, e.target_table, e.target_column,
+                 e.transformation, task_id, biz_ref, now),
+                commit=True,
+            )
+            res.inserted_column += 1
+        except Exception:
+            res.ignored_column += 1
+
+    _commit(target_ref)
+    return res
+
+
+def write_from_manual(
+    task_id: str,
+    plan_id: str,
+    source_tables: list[tuple[str, str]],
+    target_db: str,
+    target_table: str,
+    db_ref: str | None = None,
+    business_ref: str | None = None,
+) -> WriteResult:
+    """人工标注兜底（Python 任务 / 复杂 SQL）：人工标的源表→目标表 写表级边。
+
+    仅写表级，无字段级（人工标注通常不到字段级精度）。
+    lineage_type='manual'。
+    """
+    from jiuwenswarm.common import db_connector  # noqa: E402
+
+    target_ref = db_ref or _default_db_ref()
+    ensure_schema(target_ref)
+    biz_ref = _resolve_business_ref(business_ref)
+    _delete_task_edges(target_ref, plan_id, task_id)
+    res = WriteResult()
+    now = timeutil.now_db_datetime()
+    for s_db, s_tbl in source_tables:
+        try:
+            db_connector.execute(
+                target_ref,
+                "INSERT INTO table_lineage "
+                "(lineage_id, plan_id, source_db, source_table, "
+                " target_db, target_table, join_key, lineage_type, "
+                " transformation, task_id, business_ref, created_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (_lineage_id("tl"), plan_id, s_db, s_tbl,
+                 target_db, target_table, None, "manual", None, task_id, biz_ref, now),
+                commit=True,
+            )
+            res.inserted_table += 1
+        except Exception:
+            res.ignored_table += 1
+    _commit(target_ref)
+    return res
+
+
+def _delete_task_edges(db_ref: str, plan_id: str, task_id: str) -> None:
+    """删该任务该版本的所有血缘边（幂等写前清理）。"""
+    from jiuwenswarm.common import db_connector  # noqa: E402
+    try:
+        db_connector.execute(
+            db_ref,
+            "DELETE FROM table_lineage WHERE plan_id = ? AND task_id = ?",
+            (plan_id, task_id), commit=True,
+        )
+        db_connector.execute(
+            db_ref,
+            "DELETE FROM column_lineage WHERE plan_id = ? AND task_id = ?",
+            (plan_id, task_id), commit=True,
+        )
+    except Exception:
+        pass  # 删失败不阻断写；INSERT 仍有唯一索引兜底
+
+
+def _commit(db_ref: str) -> None:
+    """显式提交事务。
+
+    pymysql 连接需 commit；db_connector.execute 的 commit=True 参数会触发。
+    这里再 execute 一条无害语句确保事务提交（Doris autocommit 也兼容）。
+    """
+    from jiuwenswarm.common import db_connector  # noqa: E402
+    try:
+        db_connector.execute(db_ref, "SELECT 1", commit=True)
+    except Exception as exc:  # noqa: BLE001 —— 提交探活失败不阻断血缘写入
+        logger.warning("[lineage-writer] 显式提交探活失败 db_ref=%s: %s", db_ref, exc)
+        pass
+
+
+def _default_db_ref() -> str:
+    """默认写入目标 = 当前工作空间元数据库（决策一：血缘表在元库，归属随工作空间）。
+
+    优先级：JIUWENSWARM_ORCH_DB env（legacy sqlite 覆盖）> 当前工作空间
+    metadata_db_ref（contextvar，多工作空间缺失时大声失败）> config metadata_db。
+    """
+    import os
+    env = os.environ.get("JIUWENSWARM_ORCH_DB", "").strip()
+    if env:
+        return env if "://" in env else f"sqlite://{env}"
+    try:
+        from jiuwenswarm.common import workspace_context  # noqa: E402
+        ref = workspace_context.current_workspace().metadata_db_ref
+        if ref:
+            return ref
+    except Exception:  # noqa: BLE001 —— 无 workspace 配置时走 legacy config 兜底
+        pass
+    from jiuwenswarm.common import db_connector  # noqa: E402
+    ref = db_connector.metadata_db_ref()
+    if ref:
+        return ref
+    raise RuntimeError(
+        "系统元数据库未配置：lineage writer 无法定位元库。"
+        "请在 ~/.jiuwenswarm/config/datasource.yaml 配置 metadata_db。"
+    )
