+    setMetricKey('');
+    setName('');
+    setDescription('');
+    setOwner('');
+    setMetricType('atomic');
+    setExpression('');
+    setUnit('');
+    setSynonyms('');
+    setTimeDimension('');
+    setAllowedDimensions([]);
+    setTimeGrains([]);
+    setDependencies([]);
+    setZeroDenominator('');
+    setBindingAlias('');
+    setBindingTable('');
+    setColumnMapJson('');
+    setShowAdvanced(false);
+    setError('');
+  };
+
+  useEffect(() => {
