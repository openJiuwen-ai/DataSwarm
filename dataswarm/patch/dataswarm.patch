index 000000000..847e04f86
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/components/WorkspaceContextBar.tsx
@@ -0,0 +1,152 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 全局数据源工作空间上下文栏（多工作空间 P2-5）。
+ *
+ * 挂在 App 主体顶部，仅在治理/数据开发/数据资产/BI看板四个数据页面显示——
+ * 对话页沿用输入栏内的 WorkspaceSelector（写入 session metadata）。
+ * 两者共享同一 store（currentWorkspaceId），切库即全局生效；
+ * 页面挂载点以 key=workspaceId 重挂载，天然清缓存、断在途请求（P2-1 切换语义）。
+ */
+import { useEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { Database } from 'lucide-react';
+import clsx from 'clsx';
+import { useTranslation } from 'react-i18next';
+import {
+  useDatasourceWorkspaceStore,
+  type DatasourceWorkspaceSummary,
+} from '../stores/datasourceWorkspaceStore';
+import { CreateWorkspaceDialog } from './CreateWorkspaceDialog';
+import { EditWorkspaceDialog } from './EditWorkspaceDialog';
+import { WorkspaceRowMenu } from './WorkspaceRowMenu';
+
+function summaryLabel(ws: DatasourceWorkspaceSummary, unboundLabel: string): string {
+  const biz = ws.business
+    ? (ws.business.database || ws.business.type || '?')
+    : unboundLabel;
+  const meta = ws.metadata?.database || ws.metadata?.type || '?';
+  return `${biz} / ${meta}`;
+}
+
+export function WorkspaceContextBar() {
+  const { t } = useTranslation();
+  const { workspaces, currentWorkspaceId, error, loadWorkspaces, setCurrentWorkspace } =
+    useDatasourceWorkspaceStore();
+  const [open, setOpen] = useState(false);
+  const [anchor, setAnchor] = useState<DOMRect | null>(null);
+  const [createOpen, setCreateOpen] = useState(false);
+  const [editing, setEditing] = useState<DatasourceWorkspaceSummary | null>(null);
+  const rootRef = useRef<HTMLDivElement>(null);
+  const portalRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    void loadWorkspaces();
+  }, [loadWorkspaces]);
+
+  // 每次打开强制重拉：绑定可能来自数据源页 / 对话内 skill，store 快照未必最新
+  useEffect(() => {
+    if (open) void loadWorkspaces();
+  }, [open, loadWorkspaces]);
+
+  useEffect(() => {
+    if (!open) return;
+    const onDocMouseDown = (event: MouseEvent) => {
+      const target = event.target as Node;
+      if (rootRef.current?.contains(target) || portalRef.current?.contains(target)) return;
+      // 行内「…」弹层 portal 到 body：不算外部点击（点完选项自行关外层）
+      if (target instanceof Element && target.closest('[data-workspace-row-menu]')) return;
+      setOpen(false);
+    };
+    document.addEventListener('mousedown', onDocMouseDown);
+    return () => document.removeEventListener('mousedown', onDocMouseDown);
+  }, [open]);
+
+  const current = workspaces.find((ws) => ws.workspace_id === currentWorkspaceId) ?? null;
+  const unboundLabel = t('datasourceWorkspace.unbound');
+
+  // 单工作空间/未配置：不渲染（与对话内选择器一致，保持单库 UI 干净）
+  return (
+    <div className="ws-context-bar" ref={rootRef}>
+      <Database size={13} aria-hidden="true" />
+      <span className="ws-context-bar__label">{t('datasourceWorkspace.barLabel')}</span>
+      <button
+        type="button"
+        className={clsx('ws-context-bar__trigger', open && 'is-open')}
+        onClick={() => {
+          if (!open && rootRef.current) setAnchor(rootRef.current.getBoundingClientRect());
+          setOpen((value) => !value);
+        }}
+        aria-haspopup="menu"
+        aria-expanded={open}
+        title={current ? `${current.name}（${summaryLabel(current, unboundLabel)}）` : t('datasourceWorkspace.selectTitle')}
+      >
+        <span className="ws-context-bar__name">{current?.name ?? t('datasourceWorkspace.selectTitle')}</span>
+        {current && <span className="ws-context-bar__summary">{summaryLabel(current, unboundLabel)}</span>}
+      </button>
+      {open && anchor && createPortal(
+        <div
+          ref={portalRef}
+          className="chat-mode-select__menu ws-context-bar__menu"
+          role="menu"
+          style={{
+            position: 'fixed',
+            top: anchor.bottom + 6,
+            left: Math.max(anchor.left, 8),
+            zIndex: 1000,
+          }}
+        >
+          {error && (
+            <div className="chat-datasource-select__error">{t('datasourceWorkspace.loadFailed')}{error}</div>
+          )}
+          {workspaces.map((ws) => {
+            const active = ws.workspace_id === (current?.workspace_id ?? currentWorkspaceId);
+            return (
+              <div
+                key={ws.workspace_id}
+                className={clsx('chat-work-select__option', active && 'is-active')}
+                role="menuitemradio"
+                aria-checked={active}
+                title={`${ws.business?.type || ''}:${summaryLabel(ws, unboundLabel)}`}
+                onClick={() => {
+                  setCurrentWorkspace(ws.workspace_id);
+                  setOpen(false);
+                }}
+              >
+                <Database className="chat-datasource-select__option-icon" size={14} />
+                <span className="chat-datasource-select__option-text">
+                  <span className="chat-datasource-select__option-name">{ws.name}</span>
+                  <span className="chat-datasource-select__option-summary">{summaryLabel(ws, unboundLabel)}</span>
+                  {ws.description ? (
+                    <span className="chat-datasource-select__option-description">{ws.description}</span>
+                  ) : null}
+                </span>
+                {ws.origin !== 'yaml' && ws.workspace_id !== 'default' && (
+                  <WorkspaceRowMenu
+                    workspace={ws}
+                    onEdit={setEditing}
+                    onAction={() => setOpen(false)}
+                  />
+                )}
+              </div>
+            );
+          })}
+          <button
+            type="button"
+            className="chat-work-select__option"
+            onClick={() => {
+              setOpen(false);
+              setCreateOpen(true);
+            }}
+          >
+            <span className="chat-datasource-select__option-text">{t('datasourceWorkspace.createAction')}</span>
+          </button>
+        </div>,
+        document.body,
+      )}
+      <CreateWorkspaceDialog open={createOpen} onClose={() => setCreateOpen(false)} />
+      {editing && (
+        <EditWorkspaceDialog workspace={editing} open onClose={() => setEditing(null)} />
+      )}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/components/WorkspaceRowMenu.tsx b/jiuwenswarm/channels/web/frontend/src/components/WorkspaceRowMenu.tsx
new file mode 100644
index 000000000..f7ecf87d3
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/components/WorkspaceRowMenu.tsx
@@ -0,0 +1,152 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 工作空间列表行内「…」操作菜单（WorkspaceSelector / WorkspaceContextBar 共用）。
+ *
+ * 每行最右侧悬浮一个 … 钮，点击弹出「修改 / 删除」子菜单：
+ * - 修改：回调 onEdit（编辑对话框由父组件持有，避免随菜单关闭被卸载）
+ * - 删除：单次 confirmDialog 确认（此前两段式强确认按用户要求简化为一次）
+ * 仅 UI 创建的非 default 空间渲染（yaml/default 只读）。
+ * 子菜单经 portal 挂 body，避免被外层菜单 overflow 裁剪。
+ */
+import { useEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useTranslation } from 'react-i18next';
+import { MoreHorizontal, Pencil, Trash2 } from 'lucide-react';
+import { confirmDialog, toast } from '../features/_shared/ui/Feedback';
+import { useDatasourceWorkspaceStore } from '../stores/datasourceWorkspaceStore';
+import type { DatasourceWorkspaceSummary } from '../stores/datasourceWorkspaceStore';
+
+interface Props {
+  workspace: DatasourceWorkspaceSummary;
+  /** 点「修改」时上报（父组件关菜单并打开编辑对话框） */
+  onEdit: (workspace: DatasourceWorkspaceSummary) => void;
+  /** 任一选项被点击（外层菜单自行关闭） */
+  onAction?: () => void;
+}
+
+export function WorkspaceRowMenu({ workspace, onEdit, onAction }: Props) {
+  const { t } = useTranslation();
+  const deleteWorkspace = useDatasourceWorkspaceStore((state) => state.deleteWorkspace);
+  const [open, setOpen] = useState(false);
+  const [deleting, setDeleting] = useState(false);
+  const [anchor, setAnchor] = useState<DOMRect | null>(null);
+  const rowMenuRef = useRef<HTMLDivElement>(null);
+  const portalRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    if (!open) return;
+    const onDocMouseDown = (event: MouseEvent) => {
+      const target = event.target as Node;
+      if (rowMenuRef.current?.contains(target) || portalRef.current?.contains(target)) return;
+      setOpen(false);
+    };
+    document.addEventListener('mousedown', onDocMouseDown);
+    return () => document.removeEventListener('mousedown', onDocMouseDown);
+  }, [open]);
+
+  const deleteErrorMessage = (errorCode?: string, error?: string): string => {
+    switch (errorCode) {
+      case 'WORKSPACE_NOT_FOUND':
+        return t('datasourceWorkspace.deleteFailedNotFound');
+      case 'YAML_WORKSPACE_READ_ONLY':
+        return t('datasourceWorkspace.deleteFailedYaml');
+      case 'DEFAULT_WORKSPACE_PROTECTED':
+        return t('datasourceWorkspace.deleteFailedDefault');
+      case 'LAST_WORKSPACE':
+        return t('datasourceWorkspace.deleteFailedLast');
+      default:
+        return t('datasourceWorkspace.deleteFailed', { error: error ?? '' });
+    }
+  };
+
+  const handleDelete = async () => {
+    setOpen(false);
+    onAction?.();
+    const confirmed = await confirmDialog({
+      title: t('datasourceWorkspace.deleteConfirmTitle', { name: workspace.name }),
+      message: t('datasourceWorkspace.deleteConfirmMessage', { name: workspace.name }),
+      danger: true,
+      appearance: 'workspace-delete',
+    });
+    if (!confirmed) return;
+    setDeleting(true);
+    try {
+      const result = await deleteWorkspace(workspace.workspace_id);
+      if (result.ok) {
+        toast.success(t('datasourceWorkspace.deleteSuccess'));
+      } else {
+        toast.error(deleteErrorMessage(result.error_code, result.error));
+      }
+    } finally {
+      setDeleting(false);
+    }
+  };
+
+  return (
+    <div
+      ref={rowMenuRef}
+      className="workspace-row-menu"
+      onClick={(event) => event.stopPropagation()}
+      onMouseDown={(event) => event.stopPropagation()}
+    >
+      <button
+        type="button"
+        className="workspace-row-menu__trigger"
+        onClick={(event) => {
+          event.stopPropagation();
+          if (!open && event.currentTarget) setAnchor(event.currentTarget.getBoundingClientRect());
+          setOpen((value) => !value);
+        }}
+        disabled={deleting}
+        aria-haspopup="menu"
+        aria-expanded={open}
+        title={t('datasourceWorkspace.rowMenuTitle')}
+      >
+        <MoreHorizontal size={14} aria-hidden="true" />
+      </button>
+      {open && anchor && createPortal(
+        <div
+          ref={portalRef}
+          className="workspace-row-menu__popup"
+          data-workspace-row-menu="open"
+          role="menu"
+          style={{
+            position: 'fixed',
+            // 底部空间不足时向上翻转，避免菜单溢出视口底部（4px*2 padding + 30px*2 菜单项 ≈ 68px）
+            top:
+              window.innerHeight - anchor.bottom >= 80
+                ? anchor.bottom + 4
+                : Math.max(anchor.top - 72, 8),
+            left: Math.max(anchor.left - 96, 8),
+            zIndex: 1150,
+          }}
+        >
+          <button
+            type="button"
+            role="menuitem"
+            className="workspace-row-menu__item"
+            onClick={() => {
+              setOpen(false);
+              onAction?.();
+              onEdit(workspace);
+            }}
+          >
+            <Pencil size={13} aria-hidden="true" />
+            <span>{t('datasourceWorkspace.editAction')}</span>
+          </button>
+          <button
+            type="button"
+            role="menuitem"
+            className="workspace-row-menu__item workspace-row-menu__item--danger"
+            disabled={deleting}
+            onClick={() => void handleDelete()}
+          >
+            <Trash2 size={13} aria-hidden="true" />
+            <span>{t('datasourceWorkspace.deleteAction')}</span>
+          </button>
+        </div>,
+        document.body,
+      )}
+    </div>
+  );
+}
