+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { WorkflowGraphNode } from '../../../_shared/workflow/workflowGraphModel';
+import type { NodeInput, TaskDefinition, TaskRun } from '../../types/orchestration';
+import { parseUpstream } from './dagLayout';
+
+function executionDuration(run: TaskRun | undefined): number | undefined {
+  if (!run?.started_at || !run.finished_at || run.status === 'skipped') return undefined;
+  const started = Date.parse(run.started_at);
+  const finished = Date.parse(run.finished_at);
+  if (!Number.isFinite(started) || !Number.isFinite(finished) || finished < started) return undefined;
+  return (finished - started) / 1000;
+}
+
+export function toWorkflowGraphNodes(
+  draft: NodeInput[],
+  tasks: TaskDefinition[],
+  taskRuns: TaskRun[] | undefined,
+  defaultGroup: string,
+): WorkflowGraphNode[] {
+  const byTask = new Map(tasks.map((task) => [task.task_id, task]));
+  const runsByNode = new Map(taskRuns?.map((run) => [run.node_id, run]));
+  return draft.map((node) => {
+    if (!node.node_id) throw new Error('A workflow node must have a stable ID');
+    const task = byTask.get(node.task_id);
+    const taskLabel = task?.name ?? node.task_id;
+    const run = runsByNode.get(node.node_id);
+    return {
+      id: node.node_id,
+      parents: parseUpstream(node.upstream_nodes),
+      label: node.node_name || taskLabel,
+      taskLabel,
+      group: node.group_name || defaultGroup,
+      executor: task?.executor_type,
+      waitReview: !!node.wait_review,
+      status: run?.status,
+      durationS: executionDuration(run),
+    };
+  });
+}
+
+/** Graph editing changes membership and dependencies; other workflow fields remain owned by the editor. */
+export function applyWorkflowGraphChanges(draft: NodeInput[], next: WorkflowGraphNode[]): NodeInput[] {
+  const original = new Map(draft.map((node) => [node.node_id, node]));
+  return next.map((node) => {
+    const previous = original.get(node.id);
+    if (!previous) throw new Error(`Unknown workflow node: ${node.id}`);
+    return { ...previous, upstream_nodes: node.parents.join(',') };
+  });
+}
