+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis 链路防漂移契约测试（重构 Phase 1.5）。
+
+锁两类「文档 ↔ 代码」一致性，漂移即红：
+1. route 四态：服务端 build_context 产出的 route 值必须都在
+   references/fetch-flow.md 路由表文档化（d6 教训：route 表曾缺 full_context）；
+2. 命令面：analysis_flow.py 注册的全部子命令必须在 SKILL.md / references
+   文档化——模型只能看见文档写过的命令，未文档化 = 命令不存在。
+"""
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+_REPO = Path(__file__).resolve().parents[3]
+_SKILL_DIR = _REPO / "jiuwenswarm/resources/agent/workspace/skills/dw-analysis"
+_REGISTRY = _SKILL_DIR / "scripts/flow/cli_registry.py"
+_ANALYSIS_PKG = _REPO / "jiuwenswarm/channels/web/dataagent/analysis"
+
+# 有意不向模型暴露的内部工具命令：execute 已自动跑结果检查，
+# result-check 仅为人工补跑入口。命令被删/改名而白名单没同步时由
+# test_undocumented_allowlist_still_registered 变红。
+_UNDOCUMENTED_COMMANDS = {"result-check"}
+
+
+def _registered_commands() -> set[str]:
+    src = _REGISTRY.read_text(encoding="utf-8")
+    return set(re.findall(r'add_parser\("([^"]+)"', src))
+
+
+def _skill_docs() -> str:
+    parts = [_SKILL_DIR / "SKILL.md", *sorted((_SKILL_DIR / "references").glob("*.md"))]
+    return "\n".join(p.read_text(encoding="utf-8") for p in parts)
+
+
+def test_all_flow_commands_documented():
+    """每个注册子命令都必须在 SKILL.md/references 出现（词边界匹配，容忍表格简写形态）。"""
+    docs = _skill_docs()
+    missing = {cmd for cmd in _registered_commands()
+               if cmd not in _UNDOCUMENTED_COMMANDS
+               and not re.search(rf"\b{re.escape(cmd)}\b", docs)}
+    assert not missing, f"未文档化的子命令（模型不可见）: {sorted(missing)}"
+
+
+def test_undocumented_allowlist_still_registered():
+    """白名单命令必须仍真实注册——防止命令删了/改名了白名单成死条目。"""
+    stale = _UNDOCUMENTED_COMMANDS - _registered_commands()
+    assert not stale, f"白名单里已不存在的命令（请同步删白名单）: {sorted(stale)}"
+
+
+def test_fetch_flow_documents_all_route_states():
+    """服务端产出的 route 值必须全部在 fetch-flow.md 路由表（backtick 形态）。"""
+    from jiuwenswarm.channels.web.dataagent.analysis import shortcut
+
+    service_src = (_ANALYSIS_PKG / "service.py").read_text(encoding="utf-8")
+    states = {shortcut.ROUTE_TERM_SHORTCUT, shortcut.ROUTE_FULL_RECALL}
+    # full_context 由 scale gate 直接产出字面量（service.py 内无同名常量）
+    if 'route="full_context"' in service_src:
+        states.add("full_context")
+    md = (_SKILL_DIR / "references/fetch-flow.md").read_text(encoding="utf-8")
+    missing = {s for s in states if f"`{s}`" not in md}
+    assert not missing, f"fetch-flow.md 路由表缺 route 文档: {sorted(missing)}"
+    # no_metric_candidate 是叠加在 full_recall 上的 reason，路由表须一并交代
+    assert f"`{shortcut.REASON_NO_METRIC_CANDIDATE}`" in md, \
+        "fetch-flow.md 缺 no_metric_candidate 说明"
