+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""DuckDB 原生库的只读连接和元数据。
+
+原生库保留自己的 schema、表和视图，不创建文件源临时视图或 warehouse。
+查询只能访问库内数据；视图中引用的外部文件同样受连接配置约束。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from jiuwenswarm.common.dialect_registry import quote_ident
+from jiuwenswarm.common.ref_codec import table_identifier_parts
+
+from .base import build_catalog, build_schema
+from .errors import ConnectorError
+
+
+def connect(location: str, driver):
+    """仅打开已有本地文件，避免拼错路径时 DuckDB 创建空库。"""
+    if not location or "://" in location or "*" in location or "?" in location:
+        raise ConnectorError("native DuckDB source requires a single local database file")
+    path = Path(location)
+    if not path.is_file():
+        raise ConnectorError(f"native DuckDB database file not found: {location}")
+    # SELECT 可间接调用文件读取函数；只读模式本身并不隔离文件系统。
+    # 在建连参数中锁定配置，同配置的并发读连接不需再次执行 SET。
+    return driver.connect(
+        database=str(path),
+        read_only=True,
+        config={
+            "enable_external_access": "false",
+            "autoload_known_extensions": "false",
+            "autoinstall_known_extensions": "false",
+            "lock_configuration": "true",
+            "threads": "4",
+            "memory_limit": "2GB",
+        },
+    )
+
+
+def datasets(connection) -> list[dict]:
+    rows = connection.execute(
+        "SELECT schema_name, table_name, 'table', comment, sql FROM duckdb_tables() "
+        "WHERE database_name = current_database() AND NOT internal AND NOT temporary "
+        "UNION ALL "
+        "SELECT schema_name, view_name, 'view', comment, sql FROM duckdb_views() "
+        "WHERE database_name = current_database() AND NOT internal AND NOT temporary "
+        "ORDER BY 1, 2"
+    ).fetchall()
+    return [
+        {"schema": row[0], "name": row[1], "type": row[2],
+         "comment": row[3] or "", "ddl": row[4]}
+        for row in rows
+    ]
+
+
+def catalog(connection, source_id: str) -> dict:
+    return build_catalog(source_id=source_id, engine="duckdb", datasets=datasets(connection))
+
+
+def resolve_dataset(connection, dataset: str, schema_name: str | None = None) -> dict:
+    """显式引号标识符优先解析，避免被同名的 main 表遮蔽。
+
+    裸表名先按 main 解析（与 DuckDB 默认 search_path 一致）；main 里没有时
+    在全部 schema 中找唯一同名表——原生库常有 main 之外的业务 schema，
+    调用方（如任务描述）通常只知道裸表名。
+    """
+    available = {(item["schema"], item["name"]): item for item in datasets(connection)}
+    if schema_name is not None:
+        key = (schema_name, dataset)
+    elif not dataset.lstrip().startswith('"') and ("main", dataset) in available:
+        key = ("main", dataset)
+    else:
+        try:
+            parts = table_identifier_parts(dataset, "duckdb")
+        except ValueError as exc:
+            raise ConnectorError("invalid native DuckDB dataset identifier") from exc
+        if len(parts) == 2:
+            key = tuple(parts)
+        else:
+            key = ("main", parts[0])
+            if key not in available:
+                matches = sorted(name for name in available if name[1] == parts[0])
+                if len(matches) > 1:
+                    candidates = ", ".join(f'"{schema}"."{name}"' for schema, name in matches)
+                    raise ConnectorError(
+                        f"dataset {parts[0]!r} is ambiguous across schemas; "
+                        f"use a qualified name: {candidates}"
+                    )
+                if matches:
+                    key = matches[0]
+    if key not in available:
+        raise ConnectorError("dataset is not registered for this source")
+    return available[key]
+
+
+def quoted_dataset(item: dict) -> str:
+    return f'{quote_ident("duckdb", item["schema"])}.{quote_ident("duckdb", item["name"])}'
+
+
+def schema(connection, source_id: str, dataset: str, schema_name: str | None = None) -> dict:
+    item = resolve_dataset(connection, dataset, schema_name)
+    names = [item["schema"], item["name"]]
+    rows = connection.execute(
+        "SELECT column_name, data_type, is_nullable, column_default, comment "
+        "FROM duckdb_columns() WHERE database_name = current_database() "
+        "AND schema_name = ? AND table_name = ? ORDER BY column_index", names,
+    ).fetchall()
+    keys = connection.execute(
+        "SELECT constraint_column_names FROM duckdb_constraints() "
+        "WHERE database_name = current_database() AND schema_name = ? AND table_name = ? "
+        "AND constraint_type = 'PRIMARY KEY'", names,
+    ).fetchall()
+    primary_key = {name for row in keys for name in row[0]}
+    result = build_schema(
+        source_id=source_id,
+        dataset=item["name"],
+        schema_name=item["schema"],
+        columns=[
+            {"name": row[0], "type": row[1], "nullable": row[2],
+             "default": row[3], "comment": row[4] or "", "pk": row[0] in primary_key}
+            for row in rows
+        ],
+    )
+    # 未反射索引和外键时不填空列表，调用方据此区分“不支持”和“没有”。
+    result.update(comment=item["comment"], ddl=item["ddl"])
+    return result
+
+
+def batch_stats(connection, source_id: str) -> dict[str, dict]:
+    stats = {}
+    for item in datasets(connection):
+        identifier = quoted_dataset(item)
+        metadata = schema(connection, source_id, item["name"], item["schema"])
+        count = connection.execute(f"SELECT COUNT(*) FROM {identifier}").fetchone()[0]
+        stats[identifier] = {"columns": metadata["columns"], "row_count": int(count)}
+    return stats
