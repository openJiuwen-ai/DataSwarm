+++ b/jiuwenswarm/channels/web/frontend/tests/workflowLayout.test.mjs
@@ -0,0 +1,120 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { layoutWorkflowNodes } from '../node_modules/.cache/dag-layout/workflowLayout.mjs';
+
+const node = (id, ...parents) => ({ node_id: id, upstream_nodes: parents.join(',') });
+
+function assertRows(nodes, expected) {
+  const before = structuredClone(nodes);
+  const positions = layoutWorkflowNodes(nodes);
+  assert.deepEqual(nodes, before, 'layout must not modify workflow dependencies');
+  const rows = [...new Set(Object.values(positions).map((position) => position.y))].sort((a, b) => a - b);
+  assert.equal(rows.length, expected.length);
+  expected.forEach((ids, row) => {
+    assert.deepEqual(
+      nodes
+        .filter((n) => positions[n.node_id].y === rows[row])
+        .map((n) => n.node_id)
+        .sort(),
+      [...ids].sort(),
+    );
+    const xs = ids.map((id) => positions[id].x).sort((a, b) => a - b);
+    for (let i = 1; i < xs.length; i++) assert.ok(xs[i] - xs[i - 1] >= 312 + 64, 'cards must not overlap');
+  });
+  for (const n of nodes) {
+    for (const parent of n.upstream_nodes.split(',').filter(Boolean)) {
+      assert.ok(positions[parent].y + 152 < positions[n.node_id].y, 'dependencies must point down');
+    }
+  }
+  return positions;
+}
+
+test('all warehouse table-creation roots stay in row one, followed by import, detail, summary and metrics', () => {
+  const ods = [
+    'customers',
+    'geolocation',
+    'items',
+    'payments',
+    'reviews',
+    'orders',
+    'products',
+    'sellers',
+    'categories',
+  ];
+  const outputs = [
+    'detail',
+    'payment_detail',
+    'category_daily',
+    'delivery_daily',
+    'order_daily',
+    'user_summary',
+    'core',
+    'repurchase',
+  ];
+  const roots = [...ods, ...outputs].map((id) => `ddl_${id}`);
+  const imports = ods.map((id) => `import_${id}`);
+  const nodes = [
+    ...roots.map((id) => node(id)),
+    ...ods.map((id) => node(`import_${id}`, `ddl_${id}`)),
+    node(
+      'detail',
+      'ddl_detail',
+      'import_orders',
+      'import_items',
+      'import_customers',
+      'import_products',
+      'import_categories',
+    ),
+    node('payment_detail', 'ddl_payment_detail', 'import_orders', 'import_payments', 'import_customers'),
+    node('category_daily', 'ddl_category_daily', 'detail'),
+    node('delivery_daily', 'ddl_delivery_daily', 'detail'),
+    node('order_daily', 'ddl_order_daily', 'payment_detail'),
+    node('user_summary', 'ddl_user_summary', 'payment_detail'),
+    node('core', 'ddl_core', 'order_daily'),
+    node('repurchase', 'ddl_repurchase', 'user_summary'),
+  ];
+  const expected = [
+    roots,
+    imports,
+    ['detail', 'payment_detail'],
+    ['category_daily', 'delivery_daily', 'order_daily', 'user_summary'],
+    ['core', 'repurchase'],
+  ];
+  const positions = assertRows(nodes, expected);
+  assert.deepEqual(layoutWorkflowNodes(nodes), positions, 'identical input must keep a stable layout');
+  assertRows([...nodes].reverse(), expected);
+});
