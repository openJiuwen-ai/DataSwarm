+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 指标语义层 V2 REST API（/api/dataagent/metrics/v2/*）。
+
+ * workspace 注入与响应归属校验沿用 dashboard 模块 dashboardApi 的约定。
+ */
+
+import {
+  getCurrentDatasourceWorkspaceId,
+  responseBelongsToCurrentWorkspace,
+} from '../../stores/datasourceWorkspaceStore';
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  const wsId = getCurrentDatasourceWorkspaceId();
+  const requestAt = wsId;
+  const target = wsId
+    ? `${url}${url.includes('?') ? '&' : '?'}workspace_id=${encodeURIComponent(wsId)}`
+    : url;
+  const response = await fetch(target, {
+    ...init,
+    headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const payload = await response.json().catch(() => ({})) as Record<string, unknown>;
+  if (!response.ok) {
+    // 优先展示 detail（可操作文案）；error 是错误码，只有缺 detail 时才回退
+    const detail = typeof payload.detail === 'string' && payload.detail
+      ? payload.detail
+      : typeof payload.error === 'string' ? payload.error
+      : `${response.status} ${response.statusText}`;
+    throw new Error(detail);
+  }
+  if (!responseBelongsToCurrentWorkspace(payload, requestAt)) {
+    throw new Error('workspace_changed');
+  }
+  return payload as T;
+}
+
+const enc = encodeURIComponent;
+
+// ---- 响应类型（与后端 api_v2.py 载荷对齐） ----
+
+export interface V2Health {
+  enabled: boolean;
+  semantic: { available: boolean; mode: string; detail: string; error_code: string | null };
+  capabilities: {
+    named_graphs: boolean; sparql: boolean; rdf_import: boolean;
+    shacl: boolean; provenance: boolean; multi_instance: boolean;
+  };
+  /** 深集成（语义层数据面）：已采集语义快照的源锚点与当前发布投影状态 */
+  semantic_refs?: { source_id: string; snapshot_id: string }[];
+  projection_status?: string | null;
+}
+
+export interface V2BindingSummary {
+  binding_id: string;
+  datasource_alias?: string;
+  datasource_ref: string;
+  source_table: string;
+  column_map: Record<string, string>;
+  verify_status: string;
+}
+
+export interface V2RevisionSummary {
+  revision_id: string;
+  revision_no: number;
+  metric_type: string;
+  unit: string;
+  display_name: string;
+  status: string;
+  definition_ref: string;
+  definition_hash: string;
+  synonyms: string[];
+  time_dimension: string;
+  allowed_dimensions: string[];
+  time_grains: string[];
+  dependencies: string[];
+  zero_denominator?: string;
+  unparsed_reason: string | null;
+  candidate_maps?: V2CandidateMap[];
+  /** 详情端点额外返回（列表摘要没有）：新建修订表单据此预填 */
+  expression_sql?: string;
+  expression_dialect?: string;
+  bindings?: V2BindingSummary[];
+}
+
+export interface V2CandidateMap {
+  mapping_id: string;
+  relation_type: string;
+  target_ref: string;
+  evidence: string;
+}
+
+/** 术语库候选项（绑定下拉） */
+export interface GlossaryTermOption {
+  term_id: string;
+  name: string;
+  definition?: string;
+  synonyms_list?: string[];
+  status?: string;
+}
+
+/** 指标已绑定术语 */
+export interface V2MetricTerms {
+  metric_key: string;
+  revision_id: string;
+  terms: Array<{
+    mapping_id: string;
+    target_ref: string;
+    status: string;
+    evidence: string;
+    /** false = 自由文本引用解析不到术语，图上连不出 Term 边 */
+    resolved: boolean;
+    term_id: string;
+    name: string;
+    definition: string;
+  }>;
+}
+
+export interface V2BindTermResult {
+  mapping: { mapping_id: string; status: string; target_ref: string };
+  created: boolean;
+  term: { term_id: string; name: string };
+  /** 该修订已发布——图边要等下次发布或重投影（分析链路不受影响） */
+  reproject_required: boolean;
+  warnings: string[];
+}
+
+export interface V2MetricListItem {
+  metric_id: string;
+  metric_key: string;
+  name: string;
+  description: string;
+  owner: string;
+  status: string;
+  current_revision: {
+    display_name: string;
+    unit: string;
+    metric_type: string;
+    time_dimension?: string;
+  } | null;
+  /** 最新修订（可能是未发布的 candidate）；表格类型/时间维度列用它兜底 */
+  latest_revision: {
+    display_name: string;
+    unit: string;
+    metric_type: string;
+    time_dimension?: string;
+    revision_no?: number;
+    status?: string;
+  } | null;
+  revision_count: number;
+  has_published: boolean;
+  updated_at: string;
+}
+
+/** 物理绑定载荷（列表/详情/手动建修订共用）。 */
+export interface V2BindingInfo {
+  binding_id: string;
+  datasource_alias: string;
+  datasource_ref: string;
+  source_table: string;
+  column_map: Record<string, string>;
+  verify_status: string;
+  verify_detail: string;
+}
+
+/** 表单提交的绑定草稿（未填字段由后端按恒等映射补齐）。 */
+export interface V2BindingDraft {
+  datasource_alias: string;
+  source_table: string;
+  column_map?: Record<string, string>;
+}
+
+/** 手动建指标/建修订的请求体。 */
+export interface V2RevisionWritePayload {
+  metric_type: string;
+  expression?: string;
+  expression_dialect?: string;
+  unit?: string;
+  display_name?: string;
+  synonyms?: string[];
+  time_dimension?: string;
+  allowed_dimensions?: string[];
+  time_grains?: string[];
+  dependencies?: string[];
+  zero_denominator?: string;
+}
+
+export interface V2MetricCreatePayload {
+  metric_key: string;
+  name: string;
+  description?: string;
+  owner?: string;
+  revision: V2RevisionWritePayload;
+  binding?: V2BindingDraft;
+}
+
+/** 手动建修订的响应：修订摘要 + 表达式解析结果 + 绑定。 */
+export interface V2ManualRevisionResult extends V2RevisionSummary {
+  expression_sql: string;
+  expression_dialect: string;
+  parsed_operator: string;
+  parsed_fields: string[];
+  binding: V2BindingInfo | null;
+}
+
+export interface V2CreateMetricResult {
+  metric: V2MetricListItem;
+  revision: V2ManualRevisionResult;
+  candidate_mappings: string[];
+}
+
+export interface V2CreateRevisionResult {
+  revision: V2ManualRevisionResult;
+  carried_term_maps: string[];
+  candidate_mappings: string[];
+}
+
+export interface V2DeleteMetricResult {
+  deleted: boolean;
+  metric_key: string;
+  revisions: number;
+  bindings: number;
+  mappings: number;
+  projection: { status: string; detail: string };
+}
+
+/** 数据源下拉项（/api/dataagent/datasource/list）。 */
+export interface V2DatasourceOption {
+  source_id?: string;
+  ref: string;
+  type: string;
+  database?: string;
+  workspace_name?: string;
+  role?: string;
+  managed?: boolean;
+}
+
+/** 数据源目录（/api/dataagent/datasource/catalog）：表下拉的候选来源。 */
+export interface V2SourceCatalog {
+  source_id: string;
+  schemas?: Array<{ name: string; tables: Array<{ name: string; type: string }> }>;
+  datasets?: Array<{ name: string; type: string; format: string }>;
+}
+
+/** 表结构（/api/dataagent/datasource/schema）：维度列下拉的候选来源。 */
+export interface V2SourceSchema {
+  source_id: string;
+  dataset: string;
+  columns: Array<{ name: string; type: string }>;
+}
+
+/** 指标列表查询：不分页时 page/pageSize 传 0 或不传（兼容全量调用方）。 */
+export interface V2MetricListQuery {
+  keyword?: string;
+  /** 'published' | 'draft'；'all'/空 表示不过滤 */
+  status?: string;
+  /** metric_key | name | updated_at | revision_count（服务端白名单） */
+  sort?: string;
+  order?: 'asc' | 'desc';
+  page?: number;
+  pageSize?: number;
+}
+
+export interface V2MetricListResult {
+  metrics: V2MetricListItem[];
+  total: number;
+  page: number;
+  page_size: number;
+  /** 全空间状态计数（不受服务端筛选影响），供 KPI 与筛选徽章 */
+  status_counts: Record<string, number>;
+}
+
+export interface V2MetricDetail {
+  metric: {
+    metric_id: string; metric_key: string; name: string;
+    description: string; status: string;
+    owner?: string; created_at?: string; updated_at?: string;
+  };
+  revisions: V2RevisionSummary[];
+  pending_concept_maps: number;
+}
+
+export interface V2SemanticContext {
+  context: {
+    metric_key: string; revision: string | null; label: string; comment: string; unit: string;
+    operator: string; formula_summary: string; synonyms: string[];
+    concept: string | null; numerator: string | null; denominator: string | null;
+    time_field: string | null; group_by_fields: string[];
+    definition_ref: string | null;
+    dependencies: { metric_key: string; roles: string[]; fields: string[] }[];
+    schema: V2SchemaSubgraph | null;
+    schema_snapshot_id: string | null;
+    drift: boolean;
+  };
+  release_id: string;
+  context_digest: string;
+}
+
+export interface V2Release {
+  release_id: string;
+  label: string;
+  status: string;
+  projection_status: string;
+  error_code: string;
+  error_message: string;
+  published_at: string;
+  created_at: string;
+}
+
+export interface V2QueryResult {
+  rows: Record<string, unknown>[];
+  columns: string[];
+  row_count: number;
+  elapsed_ms: number;
+  query_id: string;
+  path: string;
+  authoritative: boolean;
+  degraded_reason: string;
+  stale: boolean;
+  sql: string;
+  dialect: string;
+  release_id: string;
+  metric_keys: string[];
+  warnings: string[];
+}
+
+export interface V2SchemaSubgraph {
+  tables: { id: string; type: string; label: string; logical: string }[];
+  columns: { id: string; type: string; label: string; logical: string }[];
+  joins: { left: string; right: string; kind: string; evidence: string; verified: boolean }[];
+  lineage: { left: string; right: string; kind: string; level: string;
+             evidence: string; verified: boolean; transformation?: string }[];
+}
+
+export interface V2RecallEntry {
+  metric_key: string;
+  display_name: string;
+  confidence: number;
+  score: number;
+  channels: Record<string, number>;
+  matched_on: string[];
+  emb_via: string;
+}
+
+export interface V2RecallSchemaHit {
+  logical: string;
+  node_type: string;
+  score: number;
+  matched_on: string[];
+  emb_via: string;
+}
+
+export interface V2Recall {
+  entries: V2RecallEntry[];
+  schema_hits: V2RecallSchemaHit[];
+  schema_confidence: number;
+  query_vectors: string[];
+  clarify_threshold?: number;
+  weights?: Record<string, number>;
+  emb_calibration?: { floor: number; ceil: number };
+}
+
+export interface V2QueryLogRow {
+  query_id: string;
+  question: string | null;
+  path: string | null;
+  authoritative: number;
+  executed: number;
+  row_count: number | null;
+  error_code: string | null;
+  error_message: string | null;
+  degraded_reason: string | null;
+  feedback: string;
+  created_at: string;
+  generated_sql: string | null;
+  release_id: string | null;
+}
+
+export interface V2ImportResult {
+  revisions: string[];
+  bindings: string[];
+  candidate_mappings: string[];
+  created: boolean;
+}
+
+export interface V2PublishResult {
+  release: V2Release;
+  projection: { projection_status: string };
+}
+
+// ---- API ----
+
+export interface V2QuerySpec {
+  metrics: string[];
+  group_by?: string[];
+  time?: {
+    dimension: string;
+    start: string;
+    end_exclusive: string;
+    grain?: string;
+  };
+  filters?: { field: string; op: string; value: string }[];
+  limit?: number;
+}
+
+export const metricsV2Api = {
+  health: () => request<V2Health>('/api/dataagent/metrics/v2/health'),
+
+  /** 指标列表：keyword/status 筛选与分页均下推服务端；不传 page 时返回全量 */
+  listMetrics: (query: V2MetricListQuery = {}) => {
+    const params = new URLSearchParams();
+    if (query.keyword) params.set('keyword', query.keyword);
+    if (query.status && query.status !== 'all') params.set('status', query.status);
+    if (query.sort) params.set('sort', query.sort);
+    if (query.order) params.set('order', query.order);
+    if (query.page) params.set('page', String(query.page));
+    if (query.pageSize) params.set('page_size', String(query.pageSize));
+    const suffix = params.toString();
+    return request<V2MetricListResult>(
+      `/api/dataagent/metrics/v2/metrics${suffix ? `?${suffix}` : ''}`);
+  },
+
+  getMetric: (key: string) =>
+    request<V2MetricDetail>(`/api/dataagent/metrics/v2/metrics/${enc(key)}`),
+
+  /** 手动新建指标（身份 + r1 口径 + 物理绑定） */
+  createMetric: (payload: V2MetricCreatePayload) =>
+    request<V2CreateMetricResult>('/api/dataagent/metrics/v2/metrics', {
+      method: 'POST',
+      body: JSON.stringify(payload),
+    }),
+
+  /** 改指标身份（名称/说明/负责人）；口径变更走 createRevision */
+  updateMetric: (key: string, payload: { name?: string; description?: string; owner?: string }) =>
+    request<{ metric: V2MetricListItem }>(
+      `/api/dataagent/metrics/v2/metrics/${enc(key)}/update`, {
+        method: 'POST',
+        body: JSON.stringify(payload),
+      }),
+
+  /** 新建 candidate 修订（口径不可变，改口径即新修订） */
+  createRevision: (key: string, payload: V2RevisionWritePayload & { binding?: V2BindingDraft }) =>
+    request<V2CreateRevisionResult>(
+      `/api/dataagent/metrics/v2/metrics/${enc(key)}/revisions`, {
+        method: 'POST',
+        body: JSON.stringify(payload),
+      }),
+
+  /** 删除指标；已发布指标需 force=true（删除后服务端尽力重投影） */
+  deleteMetric: (key: string, force = false) =>
+    request<V2DeleteMetricResult>(
+      `/api/dataagent/metrics/v2/metrics/${enc(key)}/delete`, {
+        method: 'POST',
+        body: JSON.stringify({ force }),
+      }),
+
+  /** 数据源下拉（手动建指标的绑定区） */
+  datasources: () =>
+    request<{ ok: boolean; datasources: V2DatasourceOption[] }>(
+      '/api/dataagent/datasource/list'),
+
+  /** 数据源下的库/表目录（源表下拉） */
+  sourceCatalog: (sourceId: string) =>
+    request<V2SourceCatalog>(
+      `/api/dataagent/datasource/catalog?source_id=${enc(sourceId)}`),
+
+  /** 表列结构（时间维度/允许维度下拉）；schema 用于同实例多库的表 */
+  sourceSchema: (sourceId: string, dataset: string, schemaName = '') =>
+    request<V2SourceSchema>(
+      `/api/dataagent/datasource/schema?source_id=${enc(sourceId)}&dataset=${enc(dataset)}`
+      + (schemaName ? `&schema=${enc(schemaName)}` : '')),
+
+  context: (key: string) =>
+    request<V2SemanticContext>(`/api/dataagent/metrics/v2/metrics/${enc(key)}/context`),
+
+  releases: () =>
+    request<{ releases: V2Release[] }>('/api/dataagent/metrics/v2/releases'),
+
+  importOssie: (content: string) =>
+    request<V2ImportResult>('/api/dataagent/metrics/v2/ossie/import', {
+      method: 'POST',
+      body: JSON.stringify({ content }),
+    }),
+
+  publish: (revisionIds: string[], label: string, publishedBy: string) =>
+    request<V2PublishResult>('/api/dataagent/metrics/v2/releases/publish', {
+      method: 'POST',
+      body: JSON.stringify({ revision_ids: revisionIds, label, published_by: publishedBy }),
+    }),
+
+  confirmMapping: (mappingId: string, confirmedBy: string, reject = false) =>
+    request<{ mapping?: V2CandidateMap; mapping_id?: string; status?: string }>(
+      `/api/dataagent/metrics/v2/concept-map/${enc(mappingId)}/confirm`, {
+        method: 'POST',
+        body: JSON.stringify(
+          reject ? { action: 'reject', confirmed_by: confirmedBy } : { confirmed_by: confirmedBy }),
+      }),
+
+  /** 指标已绑定的业务术语（resolved=false 是解析不到术语的历史自由文本引用） */
+  listTerms: (metricKey: string) =>
+    request<V2MetricTerms>(`/api/dataagent/metrics/v2/metrics/${enc(metricKey)}/terms`),
+
+  /** 绑定术语（界面链路：target_ref 存 term_id，状态直接 confirmed） */
+  bindTerm: (metricKey: string, termId: string, boundBy = '') =>
+    request<V2BindTermResult>(`/api/dataagent/metrics/v2/metrics/${enc(metricKey)}/terms`, {
+      method: 'POST',
+      body: JSON.stringify({ term_id: termId, bound_by: boundBy }),
+    }),
+
+  unbindTerm: (metricKey: string, termId: string) =>
+    request<{ removed: boolean; reproject_required: boolean }>(
+      `/api/dataagent/metrics/v2/metrics/${enc(metricKey)}/terms`, {
+        method: 'POST',
+        body: JSON.stringify({ term_id: termId, action: 'unbind' }),
+      }),
+
+  /** 术语库候选（绑定下拉用；术语库是独立模块，直接读它的列表端点） */
+  glossaryTerms: (keyword = '') =>
+    request<{ terms: GlossaryTermOption[] }>(
+      `/api/dataagent/glossary/terms${keyword ? `?keyword=${enc(keyword)}` : ''}`),
+
+  query: (spec: V2QuerySpec) =>
+    request<V2QueryResult>('/api/dataagent/metrics/v2/query', {
+      method: 'POST',
+      body: JSON.stringify(spec),
+    }),
+
+  feedback: (queryId: string, feedback: 'verified' | 'rejected' | 'none', confirmedBy: string) =>
+    request<{ query_id: string; feedback: string; verified_id: string | null }>(
+      `/api/dataagent/metrics/v2/query-log/${enc(queryId)}/feedback`, {
+        method: 'POST',
+        body: JSON.stringify({ feedback, confirmed_by: confirmedBy }),
+      }),
+
+  queries: (limit = 50) =>
+    request<{ queries: V2QueryLogRow[] }>(
+      `/api/dataagent/metrics/v2/query-log?limit=${limit}`),
+};
