+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { Plus, RefreshCw } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import WorkspaceIcon from '../assets/sidebar/workspace.svg?react';
+import { CreateWorkspaceDialog } from './CreateWorkspaceDialog';
+import { EditWorkspaceDialog } from './EditWorkspaceDialog';
+import { WorkspaceRowMenu } from './WorkspaceRowMenu';
+import { useDatasourceWorkspaceStore, type DatasourceWorkspaceSummary } from '../stores/datasourceWorkspaceStore';
+import './WorkspaceSwitcher.css';
+
+function summaryLabel(workspace: DatasourceWorkspaceSummary, unbound: string) {
+  const business = workspace.business?.database || workspace.business?.type || unbound;
+  const metadata = workspace.metadata?.database || workspace.metadata?.type || '?';
+  return `${business} / ${metadata}`;
+}
+
+export function WorkspaceSwitcher() {
+  const { t } = useTranslation();
+  const { workspaces, currentWorkspaceId, isLoading, initialized, error, loadWorkspaces, setCurrentWorkspace } =
+    useDatasourceWorkspaceStore();
+  const [open, setOpen] = useState(false);
+  const [createOpen, setCreateOpen] = useState(false);
+  const [editing, setEditing] = useState<DatasourceWorkspaceSummary | null>(null);
+  const [position, setPosition] = useState({ left: 80, bottom: 68 });
+  const anchorRef = useRef<HTMLButtonElement>(null);
+  const panelRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    void loadWorkspaces();
+  }, [loadWorkspaces]);
+
+  // 每次打开强制重拉：绑定可能来自数据源页 / 对话内 skill，store 快照未必最新
+  useEffect(() => {
+    if (open) void loadWorkspaces();
+  }, [open, loadWorkspaces]);
+
+  useEffect(() => {
+    if (!open) return;
+    const closeOnPointer = (event: MouseEvent) => {
+      const target = event.target as Node;
+      if (!anchorRef.current?.contains(target) && !panelRef.current?.contains(target)) setOpen(false);
+    };
+    const closeOnKey = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') setOpen(false);
+    };
+    document.addEventListener('mousedown', closeOnPointer);
+    document.addEventListener('keydown', closeOnKey);
+    return () => {
+      document.removeEventListener('mousedown', closeOnPointer);
+      document.removeEventListener('keydown', closeOnKey);
+    };
+  }, [open]);
+
+  useEffect(() => {
+    if (!open) return;
+    const updatePosition = () => {
+      const rect = anchorRef.current?.getBoundingClientRect();
+      if (!rect) return;
+      const width = 280;
+      const left = Math.min(Math.max(8, rect.right + 8), window.innerWidth - width - 8);
+      // Keep the panel close to the bottom trigger instead of anchoring it to
+      // the trigger's upper edge, which creates an unnecessary vertical gap.
+      const bottom = Math.max(8, window.innerHeight - rect.bottom + 8);
+      setPosition({ left, bottom });
+    };
+    updatePosition();
+    window.addEventListener('resize', updatePosition);
+    return () => window.removeEventListener('resize', updatePosition);
+  }, [open]);
+
+  const current = workspaces.find((item) => item.workspace_id === currentWorkspaceId);
+  const pick = (id: string) => {
+    setCurrentWorkspace(id);
+    setOpen(false);
+  };
+
+  return (
+    <>
+      <button
+        ref={anchorRef}
+        type="button"
+        className="workspace-rail-trigger"
+        aria-label={t('datasourceWorkspace.sidebarLabel')}
+        aria-expanded={open}
+        aria-haspopup="menu"
+        data-testid="workspace-switcher-trigger"
+        title={
+          current
+            ? t('datasourceWorkspace.currentTooltip', { name: current.name })
+            : t('datasourceWorkspace.sidebarLabel')
+        }
+        onClick={() => setOpen((value) => !value)}
+      >
+        <WorkspaceIcon aria-hidden="true" />
+        <span>{t('datasourceWorkspace.sidebarLabel')}</span>
+      </button>
+      {open &&
+        createPortal(
+          <div
+            ref={panelRef}
+            className="workspace-switcher-popover"
+            role="menu"
+            data-testid="workspace-switcher-popover"
+            style={{ left: position.left, bottom: position.bottom }}
+          >
+            <button
+              type="button"
+              className="workspace-switcher-create"
+              onClick={() => {
+                setOpen(false);
+                setCreateOpen(true);
+              }}
+              data-testid="workspace-switcher-create"
+            >
+              <Plus size={16} aria-hidden="true" />
+              <span>{t('datasourceWorkspace.createAction')}</span>
+            </button>
+            <div className="workspace-switcher-divider" />
+            <div className="workspace-switcher-list" aria-live="polite">
+              {isLoading && <div className="workspace-switcher-state">{t('datasourceWorkspace.loading')}</div>}
+              {!isLoading && error && (
+                <div className="workspace-switcher-state workspace-switcher-state--error">
+                  <span>
+                    {t('datasourceWorkspace.loadFailed')} {error}
+                  </span>
+                  <button
+                    type="button"
+                    onClick={() => void loadWorkspaces()}
+                    aria-label={t('datasourceWorkspace.retry')}
+                    title={t('datasourceWorkspace.retry')}
+                  >
+                    <RefreshCw size={14} />
+                  </button>
+                </div>
+              )}
+              {!isLoading && !error && initialized && workspaces.length === 0 && (
+                <div className="workspace-switcher-state">{t('datasourceWorkspace.empty')}</div>
+              )}
+              {!isLoading &&
+                !error &&
+                workspaces.map((workspace) => {
+                  const active = workspace.workspace_id === currentWorkspaceId;
+                  const summary = summaryLabel(workspace, t('datasourceWorkspace.unbound'));
+                  return (
+                    <div
+                      key={workspace.workspace_id}
+                      className={`workspace-switcher-item${active ? ' workspace-switcher-item--active' : ''}`}
+                    >
+                      <button
+                        type="button"
+                        role="menuitemradio"
+                        aria-checked={active}
+                        disabled={active}
+                        className="workspace-switcher-item__main"
+                        onClick={() => pick(workspace.workspace_id)}
+                        data-testid="workspace-switcher-item"
+                      >
+                        <span className="workspace-switcher-item__copy" title={`${workspace.name} - ${summary}`}>
+                          <span className="workspace-switcher-item__name">{workspace.name}</span>
+                          <span className="workspace-switcher-item__summary">{summary}</span>
+                        </span>
+                        {active && (
+                          <span className="workspace-switcher-item__current">
+                            {t('datasourceWorkspace.current')}
+                          </span>
+                        )}
+                      </button>
+                      {workspace.origin !== 'yaml' && workspace.workspace_id !== 'default' && (
+                        <WorkspaceRowMenu
+                          workspace={workspace}
+                          onEdit={setEditing}
+                          onAction={() => setOpen(false)}
+                        />
+                      )}
+                    </div>
+                  );
+                })}
+            </div>
+          </div>,
+          document.body,
+        )}
+      <CreateWorkspaceDialog open={createOpen} onClose={() => setCreateOpen(false)} />
+      {editing && (
+        <EditWorkspaceDialog workspace={editing} open onClose={() => setEditing(null)} />
+      )}
+    </>
+  );
+}
