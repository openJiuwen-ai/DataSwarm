+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Real local registry -> DDL governance -> persisted knowledge candidates.
+
+All metadata writes use temporary SQLite. No business database or cloud I/O.
+"""
+from pathlib import Path
+import socket
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import registry, store as sources
+from jiuwenswarm.channels.web.dataagent.knowledge import schema_candidates, store as knowledge
+from jiuwenswarm.common import db_connector as dbc, dialect_registry as dr, workspace_context
+
+
+@pytest.fixture
+def metadata_db(tmp_path, monkeypatch):
+    ref = f"sqlite://{tmp_path / 'knowledge.db'}"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", ref)
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", ref)
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    token = workspace_context.set_current(None)
+    monkeypatch.setattr(socket.socket, "connect", lambda *args: pytest.fail("network access forbidden"))
+    try:
+        yield ref
+    finally:
+        workspace_context.reset(token)
+        dbc._invalidate(ref, read_only=True)
+        dbc._invalidate(ref, read_only=False)
+
+
+@pytest.mark.parametrize("dialect,numeric,text", [
+    ("postgres", "FLOAT8", "CITEXT"),
+    ("postgresql", "FLOAT8", "CITEXT"),
+    ("mysql", "DECIMAL(12,2)", "ENUM('east','west')"),
+    ("tsql", "MONEY", "NVARCHAR(40)"),
+    ("duckdb", "HUGEINT", "VARCHAR(40)"),
+    ("", "DECIMAL(12,2)", "ENUM('east','west')"),
+    ("", "MONEY", "VARCHAR(40)"),
+])
+def test_saved_ddl_derives_and_persists_candidates_with_metadata_dialect(metadata_db, dialect, numeric, text):
+    config = {"ddl_text": f"CREATE TABLE orders (id BIGINT PRIMARY KEY, revenue {numeric}, region {text});",
+              "dialect": dialect}
+    registry.get_source_type("ddl").validate(config)
+    ref = registry.get_source_type("ddl").build_ref(config)
+    sources.insert_source("ddl-saved", "ddl", "DDL schema", config, ref)
+    assert dbc.tables(ref)["tables"] == ["orders"]
+    result = schema_candidates.derive_candidates(ref, source_id="ddl-saved")
+    # 指标候选派生已关闭（2026-11-02）：数值列 revenue 不再产出，只派生文本列 region
+    assert result["created_count"] == 1 and result["failed_tables"] == []
+    assets = {item["title"]: item for item in knowledge.list_assets()}
+    assert assets.keys() == {"region"}
+    assert "revenue" not in assets
+    assert assets["region"]["asset_type"] == "term"
+    assert all(item["status"] == "candidate" for item in assets.values())
+    assert all(item["scope"]["source_ids"] == ["ddl-saved"] for item in assets.values())
+    assert all(item["source"]["origin"] == "schema_auto" for item in assets.values())
+    assert all(knowledge.events(item["asset_id"])[0]["action"] == "create" for item in assets.values())
+    repeated = schema_candidates.derive_candidates(ref, tables=["orders"], source_id="ddl-saved")
+    assert repeated["created_count"] == 0 and repeated["skipped_existing"] == 1
+    assert dr.is_registered("ddl") is False
+    with pytest.raises(ValueError, match="metadata-only"):
+        dbc.query(ref, "SELECT * FROM orders")
+
+
+@pytest.mark.parametrize("kind", ["mongodb", "redis"])
+def test_sampled_duckdb_types_still_derive_into_sqlite(metadata_db, monkeypatch, kind):
+    from jiuwenswarm.channels.web.dataagent import db as dataagent_db
+
+    # Transport stays offline; these are the real materialized DuckDB type names.
+    fake = SimpleNamespace(
+        tables=lambda ref: {"tables": ["orders"]},
+        schema=lambda ref, table: {"columns": [
+            {"name": "revenue", "type": "HUGEINT", "pk": False},
+            {"name": "region", "type": "VARCHAR", "pk": False},
+        ]},
+    )
+    monkeypatch.setattr(dataagent_db, "db_connector", fake)
+    assert dr.sqlglot_dialect(dr.db_type_of_ref(f"{kind}://localhost:1234/test")) == "duckdb"
+    result = schema_candidates.derive_candidates(f"{kind}://localhost:1234/test")
+    # 指标派生已关闭：数值列 revenue 不产出，只派生文本列 region
+    assert result["created_count"] == 1
+    assert {item["title"] for item in knowledge.list_assets()} == {"region"}
+
+
+def test_missing_saved_ddl_does_not_create_candidates(metadata_db):
+    with pytest.raises(ValueError, match="configuration not found"):
+        schema_candidates.derive_candidates("ddl://0123456789abcdef", tables=["orders"])
+    assert knowledge.list_assets() == []
