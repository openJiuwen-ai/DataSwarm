@@ -0,0 +1,515 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/service.py —— 查询编排入口。
+
+执行语义拆分（用户方案 2026-10-12）：指标模块 = 口径真相源 + SQL 编译器，
+**对话链路不执行**——
+
+    compile_only(spec)  对话主通路：release → 修订/绑定 → 授权 → compile →
+                        guard → 追溯（executed=0），产出 AskAnswer（权威口径
+                        SQL，参数内联自包含），执行交对话链路的执行通道
+    query(spec)         预览/测试通路（指标管理界面）：compile_only 的产物
+                        由服务端连库执行，返回 rows（唯一保留执行能力的入口）
+    ask(question)       LLM 入口：目录收窄 → 意图解析 → QuerySpec
+                        → compiler 路由走 compile_only；编译失败降级 LLM
+                        生成 SQL（同样只生成不执行，path=llm,
+                        authoritative=false，必带 degraded_reason）
+
+降级红线：**不得静默从 compiler 降级到 llm**——降级必须带 ``degraded_reason``；
+LLM 不可用或修正耗尽 → 明确报错，绝不返回无数据依据的数值。
+"""
+from __future__ import annotations
+
+import os
+import time
+from typing import Any
+
+from jiuwenswarm.common import db_connector
+
+from . import compiler, guard, store
+from . import semantic_link
+from .errors import (
+    BindingUnbound,
+    MetricError,
+    MetricNotFound,
+    QueryPlanError,
+    ReleaseNotFound,
+    SemanticContextEmpty,
+)
+from .model import (
+    PATH_COMPILER,
+    PATH_EXPLORATORY,
+    AskAnswer,
+    Binding,
+    CompiledQuery,
+    MetricRevision,
+    QueryResult,
+    QuerySpec,
+    Release,
+    canonical_json,
+    sha256_of,
+)
+from .semantic_link import context_digest
+
+
+def _llm_max_repairs() -> int:
+    """LLM 修正环上限（环境变量 ``DATASWARM_METRICS_LLM_MAX_REPAIRS``，默认 2）。"""
+    try:
+        return max(0, int(os.environ.get("DATASWARM_METRICS_LLM_MAX_REPAIRS", "2")))
+    except ValueError:
+        return 2
+
+
+def explore(question: str, workspace_id: str, *, subgraph_scope: dict | None = None) -> AskAnswer:
+    """R3 受控探索：schema 子图范围内 LLM 生成 SQL（D7）。
+
+    Phase 3b 自 api_v2._run_explore 下沉（路由层不再内联业务），schema 命中
+    经 semantic_link 直供（V2 catalog 随 ask 退场后不再有生产消费方）。
+    表列白名单 = 子图 ∩ 活 catalog（generator 快校验 + guard 反幽灵双闸）；
+    join 只用 verified 边；结果 ``path=exploratory``、``authoritative=False``。
+
+    Args:
+        question: 用户问题。
+        workspace_id: 工作空间。
+        subgraph_scope: 调用方自带子图（缺省按 question 经 semantic_link 召回）。
+
+    Returns:
+        :class:`AskAnswer`——编译产物 + 探索口径标注。
+
+    Raises:
+        SemanticContextEmpty: schema 召回零命中或子图内无可用列。
+        MetricError: LLM 生成/校验失败（失败查询已记 query_log）。
+    """
+    import os as _os
+    import time as _time
+
+    from jiuwenswarm.common import workspace_context
+    from jiuwenswarm.common.dialect_registry import sqlglot_dialect
+
+    from . import generator
+
+    scope = subgraph_scope
+    subgraph: dict | None = scope if isinstance(scope, dict) and scope.get("tables") else None
+    if subgraph is None:
+        warnings: list[str] = []
+        _refs, snapshots = semantic_link.current_snapshots(warnings)
+        schema_hits, _confidence = semantic_link.schema_recall(
+            workspace_id, question, snapshots, warnings=warnings)
+        if not schema_hits:
+            raise SemanticContextEmpty(
+                "schema 召回零命中，无法界定探索范围——请补充表/列名或先建指标")
+        subgraph = semantic_link.build_exploration_subgraph(
+            snapshots, [hit.node_id for hit in schema_hits])
+    tables: dict[str, list[str]] = {}
+    for column in (subgraph or {}).get("columns", []):
+        logical = str(column.get("logical") or "")
+        if "." in logical:
+            table, _, col = logical.partition(".")
+            tables.setdefault(table, []).append(col)
+    if not tables:
+        raise SemanticContextEmpty("schema 子图内没有可用列，无法界定探索范围")
+
+    ref = workspace_context.current_workspace().business_db_ref
+    resolved = guard.check_authorization(ref, workspace_id)
+    db_type = str(db_connector.parse_db_ref(resolved).get("type") or "sqlite")
+    started = _time.time()
+    spec_digest = sha256_of(canonical_json({"question": question, "tables": tables}))
+    try:
+        generated = generator.generate_sql(
+            question, None, [], {}, dialect=sqlglot_dialect(db_type), db_type=db_type,
+            max_repairs=int(_os.environ.get("DATASWARM_METRICS_LLM_MAX_REPAIRS", "2")),
+            verified_examples=[], schema_scope={"tables": tables})
+        elapsed = int((_time.time() - started) * 1000)
+        query_id = store.log_query({
+            "workspace_id": workspace_id, "question": question,
+            "query_spec_json": canonical_json({"scope": sorted(tables)}),
+            "path": PATH_EXPLORATORY, "authoritative": False,
+            "generated_sql": generated.sql,
+            "sql_params_json": canonical_json(list(generated.params)),
+            "dialect": sqlglot_dialect(db_type), "executed": 0,
+            "row_count": 0, "elapsed_ms": elapsed,
+            "context_digest": spec_digest,
+            "degraded_reason": "",
+        })
+        compiled = CompiledQuery(
+            sql=generated.sql, params=tuple(generated.params),
+            dialect=sqlglot_dialect(db_type), db_type=db_type,
+            datasource_ref=resolved, revision_ids=(), release_id="",
+            metric_keys=(), group_by=(), grain="", limit=0)
+        return AskAnswer(
+            compiled=compiled,
+            spec={"question": question, "tables": tables},
+            sql_executable=inline_params(generated.sql, tuple(generated.params)),
+            authoritative=False, path=PATH_EXPLORATORY,
+            query_id=query_id, warnings=tuple(generated.assumptions))
+    except MetricError as exc:
+        store.log_query({
+            "workspace_id": workspace_id, "question": question, "path": PATH_EXPLORATORY,
+            "authoritative": False, "dialect": db_type, "executed": 0,
+            "elapsed_ms": int((_time.time() - started) * 1000),
+            "context_digest": spec_digest,
+            "error_code": exc.code, "error_message": exc.detail,
+        })
+        raise
+
+
+def record_feedback(query_id: str, feedback: str, *, confirmed_by: str = "") -> dict:
+    """记录查询反馈；``verified`` 且为主通路成功查询时固化为可复用 SQL。
+
+    Returns:
+        ``{"query_id": ..., "feedback": ..., "verified_id": str | None}``。
+
+    Raises:
+        MetricNotFound: 查询记录不存在。
+    """
+    row = store.get_query(query_id)
+    if row is None:
+        raise MetricNotFound(f"查询记录 {query_id} 不存在")
+    verified_id = None
+    if feedback == "verified" and row.get("path") == PATH_COMPILER and row.get("executed"):
+        verified_id = store.create_verified_sql({
+            "workspace_id": row.get("workspace_id") or "",
+            "revision_ids_json": row.get("revision_ids_json"),
+            "query_spec_digest": _spec_digest_of(row),
+            "sql_text": row.get("generated_sql") or "",
+            "dialect": row.get("dialect"),
+            "scope_json": canonical_json(
+                {"metric_keys": _metric_keys_of_revisions(row.get("revision_ids_json"))}),
+            "release_id": row.get("release_id"),
+            "confirmed_by": confirmed_by,
+        })
+    store.update_query_feedback(query_id, feedback)
+    return {"query_id": query_id, "feedback": feedback, "verified_id": verified_id}
+
+
+def _metric_keys_of_revisions(revision_ids_json: str | None) -> list[str]:
+    """revision_ids → metric_key 列表（verified 池按 key 检索的真相源）。
+
+    池行只钉 revision_ids，而召回的 verified 通道按 metric_key 查——写入时
+    把 key 解析进 ``scope_json``，否则 ``LIKE '%key%'`` 对着 ``rev_xxx`` 永远
+    不命中（V3 起 verified 通道静默死掉的实测根因）。
+    """
+    keys: list[str] = []
+    for revision_id in store.as_list(revision_ids_json):
+        revision = store.get_revision(revision_id)
+        if revision is None:
+            continue
+        definition = store.get_def(revision.metric_id)
+        if definition is not None and definition.metric_key not in keys:
+            keys.append(definition.metric_key)
+    return keys
+
+
+def _spec_digest_of(row: dict) -> str:
+    """从追溯行还原规格摘要；还原不了就用 SQL 文本摘要兜底。"""
+    spec_json = row.get("query_spec_json")
+    if spec_json:
+        return sha256_of(str(spec_json))
+    return sha256_of(str(row.get("generated_sql") or ""))
+
+
+def inline_params(sql: str, params: tuple[Any, ...]) -> str:
+    """占位符 SQL → 自包含 SQL（字面量内联）。
+
+    执行层（nl2sql execute_sql / dwcli sql run）没有 params 绑定通道，
+    交付给执行层的 SQL 必须自包含。标量按 SQL 字面量规则：数字裸写、
+    字符串加单引号（内嵌引号双写）、None 写 NULL。
+    """
+    out = sql
+    for p in params:
+        if p is None:
+            literal = "NULL"
+        elif isinstance(p, (int, float)) and not isinstance(p, bool):
+            literal = str(p)
+        else:
+            literal = "'" + str(p).replace("'", "''") + "'"
+        out = out.replace("?", literal, 1)
+    return out
+
+
+def compile_only(
+    spec: QuerySpec,
+    workspace_id: str,
+    *,
+    session_id: str = "",
+    question: str = "",
+) -> AskAnswer:
+    """编译不执行——对话链路的主通路（执行语义拆分）。
+
+    与 :func:`query` 共享编译准备（release/依赖闭包/绑定/授权/编译/guard），
+    差异在最后：**不连业务库**，追溯 ``executed=0``，产物经
+    :class:`~.model.AskAnswer` 交执行层（agent 的 nl2sql 通道或前端
+    ``/query`` 预览）。准备段刻意独立于 query 实现——执行与编译两条
+    通路解耦演化，互不传导风险。
+
+    Raises:
+        与 :func:`query` 相同（ReleaseNotFound / MetricNotFound / QueryPlanError /
+        guard / 编译错误）。
+    """
+    release = _resolve_release(spec, workspace_id)
+    revisions = store.list_revisions_by_ids(list(release.revision_ids))
+    if not revisions:
+        raise ReleaseNotFound(f"发布批次 {release.release_id} 内没有修订")
+    by_key = {_key_of(r): r for r in revisions}
+    missing = [k for k in spec.metrics if k not in by_key]
+    if missing:
+        raise MetricNotFound(
+            f"指标 {', '.join(missing)} 不在 release {release.release_id} 内"
+            f"（可用: {', '.join(sorted(by_key)) or '无'}）")
+    involved = _dependency_closure([by_key[k] for k in spec.metrics], by_key)
+    bindings_by_revision = {
+        rev.revision_id: store.list_bindings(rev.revision_id) for rev in involved}
+    datasource_ref = _datasource_of(involved, bindings_by_revision)
+    resolved_ref = guard.check_authorization(datasource_ref, workspace_id)
+    db_type = str(db_connector.parse_db_ref(resolved_ref).get("type") or "sqlite")
+    roles = _roles_of(involved)
+    spec_json = canonical_json(spec.to_dict())
+    ctx_digest = _context_digest_if_available(None, workspace_id, spec, release)
+
+    started = time.time()
+    try:
+        compiled = compiler.compile_spec(
+            spec, involved, bindings_by_revision,
+            db_type=db_type, datasource_ref=resolved_ref,
+            release_id=release.release_id, roles=roles)
+        validation = guard.check(compiled, involved, bindings_by_revision)
+        query_id = store.log_query({
+            "workspace_id": workspace_id, "session_id": session_id, "question": question,
+            "query_spec_json": spec_json, "path": PATH_COMPILER, "authoritative": True,
+            "release_id": release.release_id,
+            "revision_ids_json": canonical_json([r.revision_id for r in
+                                                 _selected_revisions(spec, by_key)]),
+            "generated_sql": compiled.sql,
+            "sql_params_json": canonical_json([str(p) for p in compiled.params]),
+            "dialect": compiled.dialect, "validation_json": canonical_json(validation),
+            "executed": 0, "row_count": 0,
+            "elapsed_ms": int((time.time() - started) * 1000),
+            "context_digest": ctx_digest,
+            "degraded_reason": "",
+        })
+        return AskAnswer(
+            compiled=compiled, spec=spec.to_dict(),
+            sql_executable=inline_params(compiled.sql, compiled.params),
+            authoritative=True, query_id=query_id,
+            warnings=tuple(validation.get("warnings") or []),
+        )
+    except MetricError as exc:
+        store.log_query({
+            "workspace_id": workspace_id, "session_id": session_id, "question": question,
+            "query_spec_json": spec_json, "path": PATH_COMPILER, "authoritative": True,
+            "release_id": release.release_id, "dialect": db_type,
+            "executed": 0,
+            "elapsed_ms": int((time.time() - started) * 1000),
+            "context_digest": ctx_digest,
+            "error_code": exc.code, "error_message": exc.detail,
+        })
+        raise
+
+
+def query(
+    spec: QuerySpec,
+    workspace_id: str,
+    *,
+    session_id: str = "",
+    question: str = "",
+    semantic_context: Any = None,
+) -> QueryResult:
+    """执行一次结构化指标查询（主通路）。
+
+    Args:
+        spec: 已 ``validate()`` 的查询规格。
+        workspace_id: 工作空间。
+        session_id: 会话 ID（追溯用）。
+        question: 触发本次查询的自然语言问题（可为空）。
+        semantic_context: 调用方已取好的语义上下文（避免重复检索）；
+            缺席时自动经 :func:`.semantic_link.build_semantic_context` 检索，
+            检索失败不阻断主通路。
+
+    Returns:
+        :class:`~.model.QueryResult`，``path=compiler``、``authoritative=True``。
+
+    Raises:
+        ReleaseNotFound: 无可用发布批次。
+        MetricNotFound: 指标不在发布批次内。
+        QueryPlanError: 维度/粒度越界等规格问题。
+        其余 :class:`~.errors.MetricError` 子类按 guard/执行实际错误抛出。
+    """
+    release = _resolve_release(spec, workspace_id)
+    revisions = store.list_revisions_by_ids(list(release.revision_ids))
+    if not revisions:
+        raise ReleaseNotFound(f"发布批次 {release.release_id} 内没有修订")
+
+    by_key = {_key_of(r): r for r in revisions}
+    missing = [k for k in spec.metrics if k not in by_key]
+    if missing:
+        raise MetricNotFound(
+            f"指标 {', '.join(missing)} 不在 release {release.release_id} 内"
+            f"（可用: {', '.join(sorted(by_key)) or '无'}）")
+
+    # 参与编译的修订：选中指标 + 它们的依赖闭包（ratio/derived 展开）
+    involved = _dependency_closure([by_key[k] for k in spec.metrics], by_key)
+    bindings_by_revision = {
+        rev.revision_id: store.list_bindings(rev.revision_id) for rev in involved}
+
+    datasource_ref = _datasource_of(involved, bindings_by_revision)
+    resolved_ref = guard.check_authorization(datasource_ref, workspace_id)
+    db_type = str(db_connector.parse_db_ref(resolved_ref).get("type") or "sqlite")
+
+    roles = _roles_of(involved)
+    spec_json = canonical_json(spec.to_dict())
+    ctx_digest = _context_digest_if_available(
+        semantic_context, workspace_id, spec, release)
+
+    started = time.time()
+    try:
+        compiled = compiler.compile_spec(
+            spec, involved, bindings_by_revision,
+            db_type=db_type, datasource_ref=resolved_ref,
+            release_id=release.release_id, roles=roles)
+        validation = guard.check(compiled, involved, bindings_by_revision)
+        result = db_connector.query(resolved_ref, compiled.sql, params=list(compiled.params), limit=None)
+        columns = result.get("columns") or []
+        rows = [dict(zip(columns, row)) for row in (result.get("rows") or [])]
+        if len(rows) > spec.limit:
+            rows = rows[: spec.limit]
+        elapsed_ms = int((time.time() - started) * 1000)
+        query_id = store.log_query({
+            "workspace_id": workspace_id, "session_id": session_id, "question": question,
+            "query_spec_json": spec_json, "path": PATH_COMPILER, "authoritative": True,
+            "release_id": release.release_id,
+            "revision_ids_json": canonical_json([r.revision_id for r in
+                                                 _selected_revisions(spec, by_key)]),
+            "generated_sql": compiled.sql,
+            "sql_params_json": canonical_json([str(p) for p in compiled.params]),
+            "dialect": compiled.dialect, "validation_json": canonical_json(validation),
+            "executed": 1, "row_count": len(rows), "elapsed_ms": elapsed_ms,
+            "context_digest": ctx_digest,
+            "degraded_reason": "",
+        })
+        return QueryResult(
+            rows=rows, columns=list(columns), compiled=compiled,
+            path=PATH_COMPILER, authoritative=True, row_count=len(rows),
+            elapsed_ms=elapsed_ms, query_id=query_id,
+            warnings=list(validation.get("warnings") or []),
+        )
+    except MetricError as exc:
+        store.log_query({
+            "workspace_id": workspace_id, "session_id": session_id, "question": question,
+            "query_spec_json": spec_json, "path": PATH_COMPILER, "authoritative": True,
+            "release_id": release.release_id, "dialect": db_type,
+            "executed": 0,
+            "elapsed_ms": int((time.time() - started) * 1000),
+            "context_digest": ctx_digest,
+            "error_code": exc.code, "error_message": exc.detail,
+        })
+        raise
+
+
+# ==========================================================================
+# 内部
+# ==========================================================================
+def _resolve_release(spec: QuerySpec, workspace_id: str) -> Release:
+    """``active`` → 当前生效批次；否则按显式 ID 取。"""
+    if spec.release and spec.release != "active":
+        release = store.get_release(spec.release)
+        if release is None or release.workspace_id != workspace_id:
+            raise ReleaseNotFound(f"发布批次 {spec.release} 不存在或不属于 workspace {workspace_id}")
+        return release
+    active = store.get_active_release(workspace_id)
+    if active is None:
+        raise ReleaseNotFound(
+            f"workspace {workspace_id} 没有已发布批次——先 publish 一个 release 才能查询")
+    return active
+
+
+def _dependency_closure(
+    selected: list[MetricRevision], by_key: dict[str, MetricRevision]
+) -> list[MetricRevision]:
+    """选中指标 + 依赖闭包（保序去重）。"""
+    out: list[MetricRevision] = []
+    seen: set[str] = set()
+
+    def walk(rev: MetricRevision) -> None:
+        if rev.revision_id in seen:
+            return
+        seen.add(rev.revision_id)
+        out.append(rev)
+        for dep in rev.dependencies:
+            target = by_key.get(dep)
+            if target is not None:
+                walk(target)
+
+    for rev in selected:
+        walk(rev)
+    return out
+
+
+def _selected_revisions(
+    spec: QuerySpec, by_key: dict[str, MetricRevision]
+) -> list[MetricRevision]:
+    """选中（不含依赖闭包）的修订，追溯用。"""
+    return [by_key[k] for k in spec.metrics if k in by_key]
+
+
+def _datasource_of(
+    revisions: list[MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+) -> str:
+    """从绑定里解析业务库 ref；所有涉及修订必须同源。"""
+    refs: set[str] = set()
+    for rev in revisions:
+        for binding in bindings_by_revision.get(rev.revision_id, ()):
+            if binding.datasource_ref:
+                refs.add(binding.datasource_ref)
+    if not refs:
+        raise BindingUnbound(
+            f"指标 {', '.join(_key_of(r) for r in revisions)} 的绑定没有可用的数据源"
+            "（datasource_ref 为空——导入时数据源别名未解析）")
+    if len(refs) > 1:
+        raise QueryPlanError(
+            f"查询涉及多个数据源 {', '.join(sorted(refs))}；跨源口径本期不支持")
+    return refs.pop()
+
+
+def _roles_of(revisions: list[MetricRevision]) -> dict[str, dict[str, str]]:
+    """从已确认映射构造 ratio 组装角色：``key -> {numerator, denominator}``。"""
+    confirmed = store.list_confirmed_maps([r.revision_id for r in revisions])
+    by_revision: dict[str, dict[str, str]] = {}
+    for mapping in confirmed:
+        if mapping.relation_type not in ("numerator", "denominator"):
+            continue
+        entry = by_revision.setdefault(mapping.revision_id, {})
+        entry[mapping.relation_type] = mapping.target_ref
+    out: dict[str, dict[str, str]] = {}
+    for rev in revisions:
+        role_entry = by_revision.get(rev.revision_id)
+        if role_entry and "numerator" in role_entry and "denominator" in role_entry:
+            out[_key_of(rev)] = role_entry
+    return out
+
+
+def _context_digest_if_available(
+    semantic_context: Any,
+    workspace_id: str,
+    spec: QuerySpec,
+    release: Release,
+) -> str:
+    """尽力取语义上下文摘要；检索失败不阻断主通路。"""
+    if semantic_context is not None:
+        return context_digest(semantic_context)
+    try:
+        ctx = semantic_link.build_semantic_context(
+            workspace_id, spec.metrics[0], release)
+        return context_digest(ctx)
+    except MetricError:
+        return ""
+
+
+def _key_of(rev: MetricRevision) -> str:
+    """从 definition_ref 还原 metric_key。"""
+    ref = rev.definition_ref or ""
+    if "@" in ref:
+        head = ref.split("@", 1)[0]
+        parts = head.split(":")
+        if len(parts) >= 4:
+            return ":".join(parts[3:])
+    return ref
