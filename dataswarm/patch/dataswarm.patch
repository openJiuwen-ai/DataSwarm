+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo, useState } from 'react';
+import SchemaIcon from '../../../assets/governance/schema.svg?react';
+import DataQualityIcon from '../../../assets/governance/data-quality.svg?react';
+import LineageIcon from '../../../assets/governance/lineage.svg?react';
+import type { EChartsOption } from 'echarts';
+import { useTranslation } from 'react-i18next';
+import { EChart } from './shared/EChart';
+import { Kpi, Panel, FindingList } from './shared/Ui';
+import type { HealthDimension, InspectionSummary } from '../types/inspection';
+import type { ArtifactMap } from '../types/inspection';
+import { CHART, HEALTH_CHART, CHART_TOOLTIP, MONO_FONT } from '../govTheme';
+
+/**
+ * 总览页（plan §7.3）。
+ *
+ *  - KPI 仪表卡（主数量 + 评分和 high/medium 分布）。
+ *  - 三维健康度雷达图，沿用高保真圆形分层底图与青绿色评分区域。
+ *  - 问题最多的表 Top N：聚合各维度 findings，行动指向——该优先修哪张表。
+ *  - 异常清单。
+ */
+
+const DIMENSIONS = ['schema', 'quality', 'lineage'] as const;
+
+/** run 级 AI 解读面板（--ai-report 开启且 LLM 成功时才有内容；无 ai_summary 不渲染）。
+ *
+ * 旁路增强字段：只做展示，不替代任何确定性图表；带「AI 生成」角标以区分模板文案
+ * （方案 inspection-llm-integration-plan §2.6）。作为 run 级执行摘要全宽放在总览图表区下方。
+ */
+function AiSummaryPanel({ text }: { text: string }) {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(true);
+  return (
+    <section className="gov-panel gov-overview-ai">
+      <h2 className="gov-panel-title">
+        <button type="button" className="gov-ai-toggle" onClick={() => setOpen(!open)}>
+          <span className="gov-ai-caret" aria-hidden>{open ? '▾' : '▸'}</span>
+          {t('governance.dashboard.overview.ai.title')}
+        </button>
+        <span className="gov-panel-mark">{t('governance.dashboard.overview.ai.generated')}</span>
+      </h2>
+      {open && <p className="gov-ai-summary">{text}</p>}
+    </section>
+  );
+}
+
+/** 横条色按排名：Top 3 红色警示，其余橙色（与 #f23030 同饱和度/亮度的协调色相）。 */
+const BAR_COLOR_TOP3 = '#f23030';
+const BAR_COLOR_REST = '#f28c28';
+
+const TOP_TABLES_LIMIT = 5;
+
+interface TopTableRow {
+  table: string;
+  high: number;
+  medium: number;
+  low: number;
+  total: number;
+}
+
+/** 各表异常 Top N：聚合已加载维度的 findings（info 是档案记录不计），按问题数降序。 */
+function collectTopTables(artifacts: ArtifactMap, limit: number): TopTableRow[] {
+  const counts = new Map<string, { high: number; medium: number; low: number }>();
+  for (const artifact of Object.values(artifacts)) {
+    for (const finding of artifact?.findings ?? []) {
+      const severity = finding.severity;
+      if (severity !== 'high' && severity !== 'medium' && severity !== 'low') continue;
+      const obj = (finding.object ?? {}) as Record<string, unknown>;
+      const table = typeof obj.table === 'string' && obj.table ? obj.table
+        : typeof obj.symptom_table === 'string' && obj.symptom_table ? obj.symptom_table : '';
+      if (!table) continue;
+      const entry = counts.get(table) ?? { high: 0, medium: 0, low: 0 };
+      if (severity === 'high') entry.high += 1;
+      else if (severity === 'medium') entry.medium += 1;
+      else entry.low += 1;
+      counts.set(table, entry);
+    }
+  }
+  return [...counts.entries()]
+    .map(([table, c]) => ({ table, ...c, total: c.high + c.medium + c.low }))
+    .sort((a, b) => b.total - a.total)
+    .slice(0, limit);
+}
+
+export function OverviewPage({
+  summary,
+  artifacts,
+  showFindings = true,
+}: {
+  summary: InspectionSummary;
+  artifacts: ArtifactMap;
+  showFindings?: boolean;
+}) {
+  const { t } = useTranslation();
+  const scores = summary.health_scores;
+
+  const healthScore = DIMENSIONS.every(name => Number.isFinite(scores?.[name]?.score))
+    ? Math.round(DIMENSIONS.reduce((total, name) => total + scores![name].score, 0) / DIMENSIONS.length)
+    : '—';
+
+  // 健康度辅助提示：评分为主，严重度分布作为细分。
+  const healthHint = (dim?: HealthDimension): string => {
+    if (!dim) return '';
+    const parts = [t('governance.dashboard.overview.score', { value: dim.score })];
+    if (dim.high) parts.push(t('governance.dashboard.overview.high', { count: dim.high }));
+    if (dim.medium) parts.push(t('governance.dashboard.overview.medium', { count: dim.medium }));
+    return parts.join(' · ');
+  };
+
+  const radarOption = useMemo<EChartsOption>(
+    () => ({
+      tooltip: { ...CHART_TOOLTIP },
+      media: [
+        {
+          query: { maxWidth: 360 },
+          option: { radar: { radius: '56%', axisNameGap: 8, axisName: { fontSize: 12 } } },
+        },
+        { option: { radar: { radius: '76%', axisNameGap: 15, axisName: { fontSize: 14 } } } },
+      ],
+      radar: {
+        indicator: DIMENSIONS.map(name => ({ name: t(`governance.dimensions.${name}`), max: 100 })),
+        shape: 'circle',
+        radius: '76%',
+        splitNumber: 5,
+        axisName: { color: HEALTH_CHART.label, fontSize: 14 },
+        axisLine: { lineStyle: { color: HEALTH_CHART.axis } },
+        splitLine: { show: false },
+        splitArea: { areaStyle: { color: [...HEALTH_CHART.rings] } },
+      },
+      series: [
+        {
+          type: 'radar',
+          symbol: 'circle',
+          symbolSize: 6,
+          lineStyle: { color: HEALTH_CHART.accent, width: 1.5 },
+          data: [
+            {
+              value: DIMENSIONS.map(name => scores?.[name]?.score ?? 0),
+              name: t('governance.dashboard.overview.healthSeries'),
+              itemStyle: { color: HEALTH_CHART.accent },
+              areaStyle: { color: HEALTH_CHART.accent, opacity: 0.24 },
+            },
+          ],
+        },
+      ],
+    }),
+    [scores, t],
+  );
+
+  // 问题最多的表 Top N：雷达图旁的行动指向图——哪些表该优先修。
+  // 无异常时展示全部通过空态，不放空图。
+  const topTables = useMemo(() => collectTopTables(artifacts, TOP_TABLES_LIMIT), [artifacts]);
+  const topTablesOption = useMemo<EChartsOption>(() => {
+    const rows = [...topTables].reverse(); // yAxis 自下而上，反转让第一名在最上
+    return {
+      tooltip: {
+        ...CHART_TOOLTIP,
+        trigger: 'item',
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        formatter: (p: any) => {
+          const d = p?.data ?? {};
+          return [
+            `<strong>${d.table ?? ''}</strong>`,
+            t('governance.dashboard.overview.topTablesHigh', { count: d.high ?? 0 }),
+            t('governance.dashboard.overview.topTablesMedium', { count: d.medium ?? 0 }),
+            t('governance.dashboard.overview.topTablesLow', { count: d.low ?? 0 }),
+          ].filter(line => !line.endsWith('0')).join('<br/>');
+        },
+      },
+      grid: { left: 8, right: 40, top: 8, bottom: 8, containLabel: true },
+      xAxis: { type: 'value', minInterval: 1, splitLine: { show: false }, axisLabel: { show: false } },
+      yAxis: {
+        type: 'category',
+        data: rows.map(row => row.table),
+        axisLine: { show: false },
+        axisTick: { show: false },
+        axisLabel: { fontSize: 11, color: CHART.body, fontFamily: MONO_FONT },
+      },
+      series: [
+        {
+          type: 'bar',
+          barMaxWidth: 16,
+          data: rows.map((row, i) => ({
+            value: row.total,
+            table: row.table,
+            high: row.high,
+            medium: row.medium,
+            low: row.low,
+            itemStyle: {
+              // rows 为反转数组（第一名在最下），按原始排名取色：Top 3 红，其余橙
+              color: rows.length - i <= 3 ? BAR_COLOR_TOP3 : BAR_COLOR_REST,
+              borderRadius: [4, 4, 4, 4],
+            },
+          })),
+          label: {
+            show: true,
+            position: 'right',
+            fontSize: 11,
+            fontFamily: MONO_FONT,
+            color: CHART.muted,
+            // eslint-disable-next-line @typescript-eslint/no-explicit-any
+            formatter: (p: any) => String(p?.data?.value ?? ''),
+          },
+        },
+      ],
+    };
+  }, [topTables, t]);
+
+  const findings = Object.values(artifacts).flatMap(artifact => artifact?.findings ?? []);
+
+  return (
+    <div className="gov-overview">
+      <div className="gov-overview-kpis">
+        <Kpi
+          label={t('governance.dimensions.schema')}
+          icon={<SchemaIcon aria-hidden="true" />}
+          kind="schema"
+          value={summary.schema_summary?.count ?? '—'}
+          hint={healthHint(scores?.schema)}
+        />
+        <Kpi
+          label={t('governance.dimensions.quality')}
+          icon={<DataQualityIcon aria-hidden="true" />}
+          kind="quality"
+          value={summary.data_summary?.count ?? '—'}
+          hint={healthHint(scores?.quality)}
+        />
+        <Kpi
+          label={t('governance.dimensions.lineage')}
+          icon={<LineageIcon aria-hidden="true" />}
+          kind="lineage"
+          value={`${summary.lineage_summary?.nodes ?? 0}/${summary.lineage_summary?.edges ?? 0}`}
+          hint={healthHint(scores?.lineage)}
+        />
+      </div>
+
+      <div className={showFindings ? 'gov-overview-with-findings' : 'gov-overview-charts'}>
+        <Panel title={t('governance.dashboard.overview.healthTitle')} className="gov-overview-health">
+          <div className="gov-health-chart">
+            <EChart option={radarOption} ariaLabel={t('governance.dashboard.charts.health')} height={270} />
+            <div className="gov-health-score">
+              <strong>{healthScore}</strong>
+              <span>{t('governance.dashboard.overview.healthScore')}</span>
+            </div>
+          </div>
+        </Panel>
+        <div className="gov-overview-side">
+          <Panel title={t('governance.dashboard.overview.topTablesTitle', { count: topTables.length })} className="gov-overview-history">
+            {topTables.length > 0
+              ? <EChart option={topTablesOption} ariaLabel={t('governance.dashboard.overview.topTablesTitle', { count: topTables.length })} height={250} />
+              : <div className="gov-empty">{t('governance.dashboard.overview.topTablesEmpty')}</div>}
+          </Panel>
+          {showFindings && (
+            <Panel title={t('governance.dashboard.overview.findingsTitle', { count: findings.length })}>
+              <FindingList findings={findings} limit={12} />
+            </Panel>
+          )}
+        </div>
+      </div>
+
+      {summary.ai_summary && <AiSummaryPanel text={summary.ai_summary} />}
+    </div>
+  );
+}
