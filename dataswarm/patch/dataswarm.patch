+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""空态工作空间列表语义：自动创建系统默认工作空间，而非返回空列表。
+
+回归背景：CI ST 首跑 GET /api/dataagent/workspaces 曾返回 400
+（WorkspaceNotConfigured 经 api 层 ValueError 兜底转 400），预检判服务不可达——
+空态先是合法化为空列表；现为「首次进入即有默认空间可选」，会话默认有归属
+（不绑定业务数据源，用户后续建源自动绑定）。创建失败仍按空态返回（页面可用），
+其余配置错误照常上抛。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.workspace import service
+from jiuwenswarm.common import db_connector, workspace_store
+from jiuwenswarm.common import workspace_context as wc
+
+
+@pytest.fixture()
+def isolated_workspace_env(monkeypatch, tmp_path):
+    """隔离工作空间数据面：yaml 指向 tmp 不存在路径，注册表/元库落 tmp。"""
+    config_dir = tmp_path / "config"
+    config_dir.mkdir()
+    monkeypatch.setattr(
+        db_connector, "_datasource_config_path", lambda: config_dir / "datasource.yaml"
+    )
+    monkeypatch.setattr(workspace_store, "_config_dir", lambda: config_dir)
+    return config_dir
+
+
+def test_list_workspaces_creates_default_when_empty(isolated_workspace_env):
+    """完全空态：首次 list 自动创建系统默认工作空间（空绑定）并返回。"""
+    payload = service.list_workspaces()
+    assert len(payload["workspaces"]) == 1
+    ws = payload["workspaces"][0]
+    assert ws["workspace_id"] == service.DEFAULT_WORKSPACE_ID
+    assert ws["name"] == service.DEFAULT_WORKSPACE_NAME
+    assert ws["origin"] == "ui"
+    assert ws["business"] is None  # 默认不绑定数据源
+    # 注册行与元库文件真实落地（元库经 ensure_system_schema 建表）
+    rows = workspace_store.list_workspaces()
+    assert [row["workspace_id"] for row in rows] == [service.DEFAULT_WORKSPACE_ID]
+    assert (isolated_workspace_env / f"workspace_{service.DEFAULT_WORKSPACE_ID}.db").is_file()
+
+
+def test_list_workspaces_default_creation_is_idempotent(isolated_workspace_env):
+    """默认空间已存在（重复 list / 二次进入）不重复创建。"""
+    first = service.list_workspaces()
+    second = service.list_workspaces()
+    assert second == first
+    assert len(workspace_store.list_workspaces()) == 1
+
+
+def test_list_workspaces_keeps_existing_without_default(isolated_workspace_env):
+    """已有工作空间（非空态）不触发默认空间创建。"""
+    workspace_store.create_workspace("已有空间", "sqlite:///biz.db", workspace_id="existing")
+    payload = service.list_workspaces()
+    assert [ws["workspace_id"] for ws in payload["workspaces"]] == ["existing"]
+
+
+def test_list_workspaces_swallows_concurrent_default_creation(monkeypatch):
+    """并发首开：对手已建好默认空间（already exists）被吞掉，按空态返回不 500。"""
+
+    def no_workspace():
+        raise wc.WorkspaceNotConfigured("no business database configured")
+
+    monkeypatch.setattr(wc, "list_workspaces", no_workspace)
+
+    def lost_race(payload):
+        raise ValueError("workspace_id already exists: default-ws")
+
+    monkeypatch.setattr(service, "create_workspace", lost_race)
+    assert service.list_workspaces() == {"workspaces": []}
+
+
+def test_list_workspaces_survives_default_creation_failure(monkeypatch):
+    """默认空间创建失败（非已存在类错误）：记日志后按空态返回，不向页面上抛。"""
+
+    def no_workspace():
+        raise wc.WorkspaceNotConfigured("no business database configured")
+
+    monkeypatch.setattr(wc, "list_workspaces", no_workspace)
+    monkeypatch.setattr(
+        service, "create_workspace", lambda payload: (_ for _ in ()).throw(RuntimeError("disk full"))
+    )
+    assert service.list_workspaces() == {"workspaces": []}
+
+
+def test_list_workspaces_still_surfaces_invalid_config(monkeypatch):
+    def broken():
+        raise wc.WorkspaceContextError("invalid custom workspace registry: boom")
+
+    monkeypatch.setattr(wc, "_workspace_records", broken)
+    with pytest.raises(wc.WorkspaceContextError, match="boom"):
+        service.list_workspaces()
