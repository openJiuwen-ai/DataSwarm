+# ==========================================================================
+# create_database：CREATE DATABASE IF NOT EXISTS
+# ==========================================================================
+class _FakeCursor:
+    def __init__(self, executed: list[str]):
+        self._executed = executed
+
+    def execute(self, sql):
+        self._executed.append(sql)
+
+    def close(self):
+        pass
+
+
+class _FakeConnection:
+    def __init__(self, connect_kwargs: dict, executed: list[str]):
+        self._connect_kwargs = connect_kwargs
+        self._executed = executed
+
+    def cursor(self):
+        return _FakeCursor(self._executed)
+
+    def commit(self):
+        pass
+
+    def close(self):
+        pass
+
+
+def _patch_pymysql_connect(monkeypatch):
+    """替身 pymysql.connect：记录连接 kwargs 与执行 SQL。返回 (connect_kwargs, executed)。"""
+    import pymysql
+
+    connect_kwargs: dict = {}
+    executed: list[str] = []
+
+    def fake_connect(**kwargs):
+        connect_kwargs.update(kwargs)
+        return _FakeConnection(kwargs, executed)
+
+    monkeypatch.setattr(pymysql, "connect", fake_connect)
+    return connect_kwargs, executed
+
+
+def test_create_database_success(monkeypatch, workspace_env):
+    """建库成功：不带 database 连接 + CREATE DATABASE IF NOT EXISTS。"""
