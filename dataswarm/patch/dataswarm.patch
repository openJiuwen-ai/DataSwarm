@@ -0,0 +1,91 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 术语详情抽屉（glossary P0）：定义全文 / 别名 / 元信息 / 投影同步状态，只读。 */
+
+import { useEffect, useState } from 'react';
+import { Badge } from '../../_shared/ui';
+import { glossaryApi } from '../api/glossaryApi';
+import type { TermDef } from '../types/dashboard';
+import { X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+
+interface TermDetailDrawerProps {
+  term: TermDef;
+  onClose: () => void;
+}
+
+export function TermDetailDrawer({ term, onClose }: TermDetailDrawerProps) {
+  const { t } = useTranslation();
+  const [full, setFull] = useState<TermDef | null>(null);
+
+  // 详情接口附带 vector_count（列表接口不带）
+  useEffect(() => {
+    glossaryApi.get(term.term_id).then(setFull).catch(() => setFull(null));
+  }, [term.term_id]);
+
+  const shown = full || term;
+  const synonyms = shown.synonyms_list || [];
+  const vectorCount = full?.vector_count;
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end bg-black/40" onClick={onClose}>
+      <div className="flex h-full w-full max-w-xl flex-col border-l border-border bg-bg shadow-2xl" onClick={(e) => e.stopPropagation()}>
+        <div className="flex items-center justify-between border-b border-border px-5 py-3">
+          <div className="flex items-center gap-2">
+            <h3 className="flex items-center gap-2 text-base font-semibold text-text-strong">
+              {shown.name}
+              <Badge tone={shown.status === 'active' ? 'success' : 'neutral'}>
+                {t(shown.status === 'active' ? 'glossary.status.active' : 'glossary.status.deprecated')}
+              </Badge>
+            </h3>
+          </div>
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}><X size={18} /></button>
+        </div>
+
+        <div className="flex-1 space-y-5 overflow-y-auto p-5">
+          {/* 定义 */}
+          <section>
+            <h4 className="mb-2 text-sm font-medium text-text-strong">{t('glossary.detail.definition')}</h4>
+            <p className="whitespace-pre-wrap rounded bg-secondary p-3 text-sm text-text">{shown.definition || '—'}</p>
+          </section>
+
+          {/* 别名 */}
+          <section>
+            <h4 className="mb-2 text-sm font-medium text-text-strong">{t('glossary.detail.synonyms')}</h4>
+            {synonyms.length === 0 && <p className="text-xs text-text-muted">{t('glossary.detail.noSynonyms')}</p>}
+            <div className="flex flex-wrap gap-1">
+              {synonyms.map((s) => (
+                <span key={s} className="rounded-full bg-secondary px-2 py-0.5 text-xs">{s}</span>
+              ))}
+            </div>
+          </section>
+
+          {/* 元信息 */}
+          <section>
+            <h4 className="mb-2 text-sm font-medium text-text-strong">{t('glossary.detail.meta')}</h4>
+            <dl className="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
+              <div><dt className="text-text-muted">{t('glossary.detail.owner')}</dt><dd>{shown.owner || '—'}</dd></div>
+              <div><dt className="text-text-muted">{t('glossary.detail.source')}</dt><dd>{shown.source || '—'}</dd></div>
+              <div><dt className="text-text-muted">{t('glossary.detail.tags')}</dt><dd>{shown.tags || '—'}</dd></div>
+              <div><dt className="text-text-muted">{t('glossary.detail.updatedAt')}</dt><dd>{shown.updated_at}</dd></div>
+              <div className="col-span-2"><dt className="text-text-muted">{t('glossary.detail.termId')}</dt>
+                <dd className="font-mono text-[11px]">{shown.term_id}</dd></div>
+              <div className="col-span-2"><dt className="text-text-muted">{t('glossary.detail.fingerprint')}</dt>
+                <dd className="font-mono text-[11px]">{shown.fingerprint ? `${shown.fingerprint.slice(0, 16)}…` : '—'}</dd></div>
+            </dl>
+          </section>
+
+          {/* 投影同步状态 */}
+          <section>
+            <h4 className="mb-2 text-sm font-medium text-text-strong">{t('glossary.detail.projection')}</h4>
+            <p className="text-xs text-text-muted">
+              {vectorCount == null
+                ? t('glossary.detail.projectionLoading')
+                : t('glossary.detail.vectorCount', { count: vectorCount })}
+            </p>
+            <p className="mt-1 text-xs text-text-muted">{t('glossary.detail.projectionHint')}</p>
+          </section>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermFormDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermFormDrawer.tsx
new file mode 100644
index 000000000..c6cc6b6f6
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermFormDrawer.tsx
@@ -0,0 +1,97 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 术语新建/编辑抽屉（glossary P0：name + definition + 别名/owner/tags）。 */
+
+import { useState } from 'react';
+import { useDashboardStore } from '../store/dashboardStore';
+import { Button, Field, inputClass } from '../../_shared/ui';
+import type { TermDef } from '../types/dashboard';
+import { X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+
+interface TermFormDrawerProps {
+  term: TermDef | null;
+  onClose: () => void;
+  onSaved: () => void;
+}
+
+export function TermFormDrawer({ term, onClose, onSaved }: TermFormDrawerProps) {
+  const { t } = useTranslation();
+  const store = useDashboardStore();
+  const isEdit = !!term;
+
+  const [name, setName] = useState(term?.name || '');
+  const [definition, setDefinition] = useState(term?.definition || '');
+  const [synonyms, setSynonyms] = useState(term?.synonyms_list?.join(', ') || '');
+  const [owner, setOwner] = useState(term?.owner || '');
+  const [tags, setTags] = useState(term?.tags || '');
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+
+  const handleSave = async () => {
+    setError('');
+    if (!name.trim()) { setError(t('glossary.form.errors.nameRequired')); return; }
+    if (!definition.trim()) { setError(t('glossary.form.errors.definitionRequired')); return; }
+    setSaving(true);
+    try {
+      const input = {
+        name: name.trim(),
+        definition: definition.trim(),
+        synonyms: synonyms.trim() || undefined,
+        owner: owner.trim() || undefined,
+        tags: tags.trim() || undefined,
+      };
+      const saved = isEdit && term
+        ? await store.updateTerm(term.term_id, input)
+        : await store.createTerm(input);
+      if (saved) {
+        onSaved();
+      } else {
+        // store 里的 error 是闭包旧值，取实时快照
+        setError(useDashboardStore.getState().error || t('glossary.form.errors.saveFailed'));
+      }
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end bg-black/40" onClick={onClose}>
+      <div className="flex h-full w-full max-w-xl flex-col border-l border-border bg-bg shadow-2xl" onClick={(e) => e.stopPropagation()}>
+        <div className="flex items-center justify-between border-b border-border px-5 py-3">
+          <h3 className="text-base font-semibold text-text-strong">{t(isEdit ? 'glossary.form.editTitle' : 'glossary.form.createTitle')}</h3>
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}><X size={18} /></button>
+        </div>
+
+        <div className="flex-1 space-y-4 overflow-y-auto p-5">
+          <Field label={t('glossary.form.name')}>
+            <input className={inputClass} value={name} onChange={(e) => setName(e.target.value)} placeholder={t('glossary.form.namePlaceholder')} />
+          </Field>
+
+          <Field label={t('glossary.form.definition')}>
+            <textarea className={`${inputClass} h-32`} value={definition} onChange={(e) => setDefinition(e.target.value)} placeholder={t('glossary.form.definitionPlaceholder')} />
+          </Field>
+
+          <Field label={t('glossary.form.synonyms')}>
+            <input className={inputClass} value={synonyms} onChange={(e) => setSynonyms(e.target.value)} placeholder={t('glossary.form.synonymsPlaceholder')} />
+            <span className="mt-1 block text-xs text-text-muted">{t('glossary.form.synonymsHint')}</span>
+          </Field>
+
+          <Field label={t('glossary.form.owner')}>
+            <input className={inputClass} value={owner} onChange={(e) => setOwner(e.target.value)} placeholder={t('glossary.form.ownerPlaceholder')} />
+          </Field>
+
+          <Field label={t('glossary.form.tags')}>
+            <input className={inputClass} value={tags} onChange={(e) => setTags(e.target.value)} placeholder={t('glossary.form.tagsPlaceholder')} />
+          </Field>
+        </div>
+
+        {error && <span className="px-5 text-xs text-danger">{error}</span>}
+
+        <div className="flex items-center justify-end gap-2 border-t border-border px-5 py-3">
+          <Button variant="ghost" onClick={onClose}>{t('common.cancel')}</Button>
+          <Button variant="primary" disabled={saving} onClick={() => void handleSave()}>{t(isEdit ? 'common.save' : 'glossary.form.create')}</Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermListPage.tsx b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermListPage.tsx
new file mode 100644
index 000000000..c0d3e6bc9
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermListPage.tsx
@@ -0,0 +1,221 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 业务术语 CRUD 列表页（glossary P0）：搜索 + 三件套入口 + JSON 导入 + 投影重建。 */
+
+import { useRef, useState } from 'react';
+import { useDashboardStore } from '../store/dashboardStore';
+import { TermFormDrawer } from './TermFormDrawer';
+import { TermDetailDrawer } from './TermDetailDrawer';
+import { Panel, EmptyState, Button, SolidButton, STATUS_DOT_TONE, StatusDot, Table } from '../../_shared/ui';
+import { BookMarked, RefreshCw, Search } from 'lucide-react';
+import type { TermDef } from '../types/dashboard';
+import type { TermImportItem } from '../api/glossaryApi';
+import { useTranslation } from 'react-i18next';
+
+/** 与数据接入页 stamp() 同口径：ISO 时间截到分钟（YYYY-MM-DD HH:mm） */
+function formatTime(value: string): string {
+  return (value || '').slice(0, 16).replace('T', ' ');
+}
+
+export function TermListPage() {
+  const { t } = useTranslation();
+  const store = useDashboardStore();
+  const [editing, setEditing] = useState<TermDef | null>(null);
+  const [creating, setCreating] = useState(false);
+  const [detail, setDetail] = useState<TermDef | null>(null);
+  const [keyword, setKeyword] = useState('');
+  const [reindexing, setReindexing] = useState(false);
+  const [reindexNote, setReindexNote] = useState('');
+  const [importing, setImporting] = useState(false);
+  const [importNote, setImportNote] = useState('');
+  const [importFailures, setImportFailures] = useState<{ name: string; reason: string }[]>([]);
+  const fileInputRef = useRef<HTMLInputElement>(null);
+
+  const handleDelete = async (id: string) => {
+    await store.deleteTerm(id);
+  };
+
+  /** 导入 JSON 文件：兼容顶层数组与 {"items":[...]} 两种格式，单条失败不阻断整批 */
+  const handleImportFile = async (file: File) => {
+    setImporting(true);
+    setImportNote('');
+    setImportFailures([]);
+    try {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(await file.text());
+      } catch {
+        setImportNote(t('glossary.list.importBadJson'));
+        return;
+      }
+      const items = Array.isArray(parsed) ? parsed
+        : parsed && typeof parsed === 'object' && Array.isArray((parsed as { items?: unknown }).items)
+          ? (parsed as { items: TermImportItem[] }).items
+          : null;
+      if (!items || items.length === 0) {
+        setImportNote(t('glossary.list.importEmpty'));
+        return;
+      }
+      const result = await store.importTerms(items);
+      if (result) {
+        setImportNote(t('glossary.list.importDone', { imported: result.imported, updated: result.updated }));
+        setImportFailures(result.failed.map((f) => ({ name: f.name || `#${f.index}`, reason: f.reason })));
+      }
+    } finally {
+      setImporting(false);
+      if (fileInputRef.current) fileInputRef.current.value = '';
+    }
+  };
+
+  const handleSearch = async () => {
+    await store.loadTerms(keyword.trim() || undefined);
+  };
+
+  /** 运维兜底：清空向量投影并全量重建（图 merge 幂等无需清） */
+  const handleReindex = async () => {
+    setReindexing(true);
+    setReindexNote('');
+    try {
+      const result = await store.reindexTerms();
+      if (result) {
+        setReindexNote(t('glossary.list.reindexDone', {
+          graph: t(`glossary.sync.${result.graph.status}`),
+          vector: t(`glossary.sync.${result.vector.status}`),
+        }));
+      }
+    } finally {
+      setReindexing(false);
+    }
+  };
+
+  const openDetail = async (term: TermDef) => {
+    setDetail(term);
+  };
+
+  const headers = ['name', 'synonyms', 'definition', 'status', 'updatedAt', 'actions'].map((key) => t(`glossary.list.headers.${key}`));
+
+  const rows = store.terms.map((term) => [
+    <span className="font-medium text-text-strong">{term.name}</span>,
+    <span className="text-xs text-text-muted">{term.synonyms_list?.join(' / ') || '—'}</span>,
+    <span className="text-xs text-text-muted">{term.definition.length > 60 ? `${term.definition.slice(0, 60)}…` : term.definition}</span>,
+    <StatusDot
+      tone={term.status === 'active' ? STATUS_DOT_TONE.success : STATUS_DOT_TONE.draft}
+      label={t(term.status === 'active' ? 'glossary.status.active' : 'glossary.status.deprecated')}
+    />,
+    <span className="whitespace-nowrap text-xs text-text-muted">{formatTime(term.updated_at)}</span>,
+    // 行内文字动作：对齐数据接入 ds-action-link（accent 蓝，删除红）
+    <div className="flex items-center gap-3">
+      <button className="cursor-pointer whitespace-nowrap border-0 bg-transparent p-0 text-sm text-[var(--color-chat-accent)] hover:opacity-80" onClick={() => void openDetail(term)}>
+        {t('glossary.list.details')}
+      </button>
+      <button className="cursor-pointer whitespace-nowrap border-0 bg-transparent p-0 text-sm text-[var(--color-chat-accent)] hover:opacity-80" onClick={() => setEditing(term)}>
+        {t('glossary.list.edit')}
+      </button>
+      <button className="cursor-pointer whitespace-nowrap border-0 bg-transparent p-0 text-sm text-[var(--color-feedback-danger)] hover:opacity-80" onClick={() => void handleDelete(term.term_id)}>
+        {t('common.delete')}
+      </button>
+    </div>,
+  ]);
+
+  return (
+    <div>
+      <div className="dw-page-head mb-4 flex items-start justify-between gap-3">
+        <div>
+          <h2 className="dw-page-title-xl">{t('glossary.list.title')}</h2>
+          <p>{t('glossary.list.subtitle')}</p>
+        </div>
+        <div className="flex items-center gap-2">
+          <input
+            ref={fileInputRef}
+            type="file"
+            accept=".json,application/json"
+            className="hidden"
+            onChange={(e) => {
+              const file = e.target.files?.[0];
+              if (file) void handleImportFile(file);
+            }}
+          />
+          <SolidButton loading={importing} onClick={() => fileInputRef.current?.click()} title={t('glossary.list.importHint')}>
+            {t('glossary.list.import')}
+          </SolidButton>
+          <SolidButton loading={reindexing} onClick={() => void handleReindex()}>
+            {t('glossary.list.reindex')}
+          </SolidButton>
+          <SolidButton onClick={() => setCreating(true)}>
+            {t('glossary.list.create')}
+          </SolidButton>
+        </div>
+      </div>
+
+      {reindexNote && (
+        <div className="mb-4 rounded border border-accent/40 bg-accent-subtle px-3 py-2 text-xs text-text">{reindexNote}</div>
+      )}
+
+      {importNote && (
+        <div className={`mb-4 rounded border px-3 py-2 text-xs ${importFailures.length > 0 ? 'border-danger/40 bg-danger-subtle text-danger' : 'border-accent/40 bg-accent-subtle text-text'}`}>
+          <div>
+            {importNote}
+            {importFailures.length > 0 && `（${t('glossary.list.importFailedCount', { count: importFailures.length })}）`}
+          </div>
+          {importFailures.slice(0, 3).map((f, i) => (
+            <div key={i} className="mt-1 text-danger/80">{f.name}：{f.reason}</div>
+          ))}
+          {importFailures.length > 3 && (
+            <div className="mt-1 text-danger/60">{t('glossary.list.importMoreFailures', { count: importFailures.length - 3 })}</div>
+          )}
+        </div>
+      )}
+
+      <div className="mb-4 flex gap-2">
+        <div className="relative flex-1 max-w-md">
+          <Search size={14} className="absolute left-2.5 top-2.5 text-text-muted" />
+          <input
+            className="w-full rounded border border-line bg-bg py-1.5 pl-8 pr-3 text-xs text-text placeholder:text-text-muted focus:border-accent focus:outline-none"
+            value={keyword}
+            onChange={(e) => setKeyword(e.target.value)}
+            onKeyDown={(e) => { if (e.key === 'Enter') void handleSearch(); }}
+            placeholder={t('glossary.list.searchPlaceholder')}
+          />
+        </div>
+        {/* 刷新：对齐数据接入 ds-icon-button（纯图标，紧挨搜索框） */}
+        <button
+          className="inline-flex h-8 w-8 flex-none items-center justify-center rounded-md border border-line bg-transparent text-text-muted hover:bg-secondary hover:text-text"
+          onClick={() => void store.loadTerms(keyword.trim() || undefined)}
+          title={t('common.refresh')} aria-label={t('common.refresh')}>
+          <RefreshCw size={16} className={store.loading ? 'animate-spin' : ''} />
+        </button>
+        <Button variant="default" size="sm" onClick={() => void handleSearch()}>{t('glossary.list.search')}</Button>
+      </div>
+
+      {store.terms.length === 0 ? (
+        <EmptyState
+          icon={<BookMarked size={32} />}
+          title={t('glossary.list.emptyTitle')}
+          hint={t('glossary.list.emptyHint')}
+          actionLabel={`+ ${t('glossary.list.create')}`}
+          onAction={() => setCreating(true)}
+        />
+      ) : (
+        <Panel title={t('glossary.list.count', { count: store.terms.length })}>
+          {/* 固定状态/时间/操作列宽：定义列吸收剩余空间，不再挤压相邻列导致「启用」与时间跨行；
+              时间列按截到分钟的新格式（YYYY-MM-DD HH:mm）适配宽度 */}
+          <Table headers={headers} rows={rows} mutedHead colWidths={['16%', '16%', 'auto', 104, 132, 176]} />
+        </Panel>
+      )}
+
+      {(creating || editing) && (
+        <TermFormDrawer
+          term={editing}
+          onClose={() => { setCreating(false); setEditing(null); }}
+          onSaved={() => { setCreating(false); setEditing(null); }}
+        />
+      )}
+
+      {detail && (
+        <TermDetailDrawer
+          term={detail}
+          onClose={() => setDetail(null)}
+        />
+      )}
+    </div>
+  );
+}
