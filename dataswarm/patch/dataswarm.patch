index 000000000..be4a84bac
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/publication.py
@@ -0,0 +1,209 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Publication checks and graph projection boundary."""
+import json
+
+from jiuwenswarm.common import workspace_context
+
+# Read-side applicability keys (selection.TARGET_KEYS); duplicated here so the
+# gate stays readable next to the checks that enforce it.
+_APPLICABILITY_KEYS = ("metric_keys", "term_ids", "entity_ids", "column_ids",
+                       "table_ids", "dimensions", "scenarios")
+
+
+def validate_publication(asset: dict) -> None:
+    source = asset.get("source") or {}
+    if source.get("origin") == "schema_auto":
+        # Schema-derived candidates carry no document evidence; their provenance
+        # is the schema element itself (table + column, kept in source.schema).
+        schema_meta = source.get("schema") or {}
+        if not str(schema_meta.get("table") or "").strip() or not str(schema_meta.get("column") or "").strip():
+            raise ValueError("schema-derived knowledge requires its source table and column")
+    elif source.get("origin") == "manual":
+        # Manually entered knowledge: the reviewer IS the provenance (approve
+        # action), so no document/schema evidence is demanded. Conflicts and
+        # term/metric alignment gates below still apply unchanged.
+        pass
+    else:
+        if not source.get("evidence_id") or not source.get("document_version_id") or not source.get("evidence_quote"):
+            raise ValueError("published knowledge requires a source document version and evidence quote")
+        from . import documents
+        document = documents.get_document(source["document_version_id"])
+        if not document or document["document_id"] != source.get("document_id"):
+            raise ValueError("source document version is unavailable")
+        span = source.get("evidence_span") or {}
+        start, end = span.get("start"), span.get("end")
+        if (not isinstance(start, int) or not isinstance(end, int)
+                or document["text"][start:end] != source["evidence_quote"]):
+            raise ValueError("knowledge evidence no longer matches its source document span")
+    if asset["asset_type"] in {"term", "metric"} and not (
+            source.get("alignment_ref") or source.get("alignment_decision")):
+        raise ValueError("term/metric proposals need an authority link or explicit reviewed alignment decision")
+    if asset["asset_type"] == "metric" and not str(source.get("alignment_ref") or "").startswith("metric:"):
+        raise ValueError("metric candidates must be modeled and published through the "
+                         "existing OSSIE revision workflow first")
+    if asset["asset_type"] == "rule" and not any(asset["scope"].get(key) for key in _APPLICABILITY_KEYS):
+        # source_ids describes provenance, not applicability — an unbound rule is
+        # only publishable when the reviewer explicitly marks it workspace-wide.
+        # Otherwise "forgot to bind" is silently read as "applies to everything".
+        if asset["scope"].get("workspace_wide") is not True:
+            raise ValueError("rule requires reviewed applicability (metric/term/entity/column/table/"
+                             "dimension/scenario refs) or an explicit workspace_wide scope")
+    if asset["asset_type"] == "mapping" and not any(
+            asset["scope"].get(key) for key in ("column_ids", "table_ids", "dimensions")):
+        # A mapping without physical targets is untraceable text: read-side
+        # expansion follows scope refs, so an unbound mapping can never bring
+        # its column into context no matter how well L1 recalls it.
+        raise ValueError("mapping requires physical targets (column_ids/table_ids/dimensions) "
+                         "so directed expansion can follow it; bind targets before publishing")
+    if asset["asset_type"] == "metric" and str(source.get("alignment_ref") or "").startswith("metric:"):
+        key = source["alignment_ref"].removeprefix("metric:")
+        from ..metrics import store
+        workspace_id = workspace_context.current_workspace().workspace_id or "default"
+        metric = store.get_def_by_key(workspace_id, key)
+        revision = store.get_revision(metric.current_revision_id) if metric and metric.current_revision_id else None
+        if revision is None or revision.status != "published":
+            raise ValueError("aligned metric must have a published revision")
+
+
+def normalize_scope_refs(asset: dict) -> dict:
+    """Resolve logical ``table.column`` / bare-table scope refs to snapshot node IDs.
+
+    Distillation emits logical names (the LLM never sees node IDs); publication
+    is the reviewed moment to pin them. Only unique active matches are replaced
+    — ambiguous or unknown refs are left as-is and surface later as read-side
+    ``dropped`` evidence instead of a silent guess.
+    """
+    scope = asset.get("scope") or {}
+    if not any(scope.get(key) for key in ("column_ids", "table_ids")):
+        return asset
+    from ..metrics import semantic_link
+    try:
+        _refs, snapshots = semantic_link.current_snapshots([])
+    except Exception:  # noqa: BLE001 — snapshots unavailable: keep logical refs, read side re-verifies
+        return asset
+    tables = [table for snapshot in snapshots.values() for table in snapshot.tables if table.status == "active"]
+    columns = [(table, column) for table in tables for column in table.columns if column.status == "active"]
+    resolved = dict(scope)
+
+    def _column_ref(value: str) -> str:
+        # 素材 node_id 方言（单冒号 col:/tbl:/view:）原样透传；col:: 绑定方言
+        # 同以 col: 开头一并透传——绑定边只在 graph_expand 侧解析（E4 显式化；
+        # 原 removeprefix("col::") 在所有可达路径上均为 no-op，死行移除）
+        if value.startswith(("col:", "tbl:", "view:")):
+            return value
+        matches = [column.node_id for table, column in columns
+                   if f"{table.name}.{column.name}" == value]
+        return matches[0] if len(matches) == 1 else value
+
+    def _table_ref(value: str) -> str:
+        if value.startswith(("col:", "tbl:", "view:")):
+            return value
+        matches = [table.node_id for table in tables if table.name == value]
+        return matches[0] if len(matches) == 1 else value
+
+    # Only normalize keys the scope actually declared: writing back an empty
+    # list for an absent key pollutes the published scope (and would make
+    # scope_pinned true for every publish).
+    if scope.get("column_ids"):
+        resolved["column_ids"] = [_column_ref(str(value)) for value in scope["column_ids"]]
+    if scope.get("table_ids"):
+        resolved["table_ids"] = [_table_ref(str(value)) for value in scope["table_ids"]]
+    if resolved == scope:
+        return asset
+    return {**asset, "scope": resolved}
+
+
+def project_asset(asset: dict | None, *, adapter=None) -> dict:
+    if not asset:
+        return {"status": "skipped"}
+    if asset["asset_type"] == "example":
+        return {"status": "skipped", "reason": "examples are not graph nodes"}
+    if asset["asset_type"] in {"metric", "term"}:
+        return publish_authority_asset(asset)
+    from . import store
+    from ..semantic.graph import GraphNode, GraphEdge, GraphProjection
+    from ..semantic.semantica import from_environment, graph_projection_enabled
+    from ..metrics.graph_projection import metric_node_id
+    workspace_id = store._workspace()
+    namespace = f"knowledge/{workspace_id}/{asset['asset_id']}"
+    node_id = f"knowledge:{workspace_id}:{asset['asset_id']}"
+    # 图投影开关关：明确记 pending 原因（与语义采集的 graph_projection_disabled 同语义）。
+    # 不短路的话会落进下方 except 兜底，reason 只剩异常类型名——「开关关闭（预期降级）」
+    # 与「真故障」共用 "ValueError" 这种不可辩读标记，评审无从判断要不要报警。
+    if adapter is None and not graph_projection_enabled():
+        return {"status": "pending", "reason": "graph_projection_disabled"}
+    try:
+        graph = adapter or from_environment()
+        graph.delete_graph_nodes(namespace)
+        if asset["status"] != "published":
+            return {"status": "removed"}
+        source, scope = asset["source"], asset["scope"]
+        evidence_id = f"evidence:{workspace_id}:{asset['asset_id']}:{source['evidence_id']}"
+        node_type = {"rule": "BusinessRule", "entity": "BusinessEntity", "mapping": "DimensionMapping",
+                     "term": "TermProposalBinding", "metric": "MetricProposalBinding"}[asset["asset_type"]]
+        nodes = [GraphNode(node_id, node_type, {"asset_id": asset["asset_id"], "title": asset["title"],
+                                               "revision": asset["revision"], "status": asset["status"]}),
+                 GraphNode(evidence_id, "Evidence", {"document_version_id": source["document_version_id"],
+                                                      "evidence_id": source["evidence_id"]})]
+        stage = graph.stage(namespace, str(asset["revision"]),
+                            GraphProjection(nodes, [GraphEdge(node_id, evidence_id, "supportedBy")]))
+        graph.validate(stage)
+        graph.publish(stage)
+        edges = []
+        for key in scope.get("metric_keys") or []:
+            edges.append(GraphEdge(node_id, metric_node_id(workspace_id, key), "appliesTo"))
+        for key in scope.get("term_ids") or []:
+            edges.append(GraphEdge(node_id, f"term:{workspace_id}:{key}", "appliesTo"))
+        for key in scope.get("entity_ids") or []:
+            edges.append(GraphEdge(node_id, f"knowledge:{workspace_id}:{key}", "appliesTo"))
+        for key in (scope.get("column_ids") or []) + (scope.get("table_ids") or []):
+            edges.append(GraphEdge(node_id, key, "appliesTo"))
+        cross = graph.create_cross_edges(namespace, edges) if edges else {"created": 0, "missed": 0}
+        return {"status": "published", "nodes": len(nodes), "cross_edges": cross}
+    except Exception as exc:  # noqa: BLE001 — projections are reconstructible; authority is the metadata catalog
+        return {"status": "pending", "reason": type(exc).__name__}
+
+
+def publish_authority_asset(asset: dict) -> dict:
+    """Write aligned terms through the glossary authority; metrics require a published OSSIE revision."""
+    source = asset.get("source") or {}
+    if asset["asset_type"] == "metric":
+        return {"status": "aligned", "authority_ref": source.get("alignment_ref")}
+    if asset["asset_type"] == "term":
+        from ..glossary import db, sync
+        ref = str(source.get("alignment_ref") or "")
+        if ref.startswith("term:"):
+            term = db.get_term(ref.removeprefix("term:"))
+            if not term or term.get("status") != "active":
+                raise ValueError("aligned glossary term is unavailable")
+            return {"status": "aligned", "authority_ref": f"term:{term['term_id']}"}
+        if source.get("alignment_decision") != "create_new_term":
+            raise ValueError("reviewer must align to a glossary term or explicitly approve a new term")
+        term_id = f"term_knowledge_{asset['asset_id']}"
+        term = db.get_term(term_id)
+        if term is None:
+            term = db.create_term({"term_id": term_id, "name": asset["title"], "definition": asset["content"],
+                               "synonyms": source.get("synonyms") or [], "owner": asset.get("owner") or "",
+                               "source": "business_knowledge"})
+        projection = sync.publish_term(term)
+        return {"status": "published", "authority_ref": f"term:{term['term_id']}", "projection": projection}
+    raise ValueError(f"unsupported authority asset_type: {asset['asset_type']}")
+
+
+def retire_authority_asset(asset_id: str, history: list[dict]) -> dict:
+    from ..glossary import db, sync
+    for event in reversed(history):
+        if event.get("action") != "publish":
+            continue
+        try:
+            result = json.loads(event.get("payload_json") or "{}").get("authority_result") or {}
+        except (TypeError, ValueError):
+            result = {}
+        if result.get("status") != "published" or not str(result.get("authority_ref") or "").startswith("term:"):
+            return {"status": "retained", "reason": "aligned glossary term is shared and remains authoritative"}
+        term_id = str(result["authority_ref"]).removeprefix("term:")
+        term = db.delete_term(term_id)
+        if not term:
+            return {"status": "retained", "reason": "glossary term was already removed"}
+        return {"status": "deprecated", "projection": sync.publish_term(term, deleted=True)}
+    return {"status": "retained", "reason": "no created glossary authority was linked"}
