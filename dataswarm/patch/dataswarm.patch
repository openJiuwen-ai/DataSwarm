+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""builder service 单测（方案批次 3 §5.4/§5.4.1：plan-status/materialize）。
+
+builder 建仓域（dataagent/builder/）。service 用 db_connector 直连元数据库
+（plan/plan_table 真相源），materialize 调 orchestration service 建任务/工作流
+（编排写入单点）。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.builder import service as bsvc
+
+
+class _FakeConn:
+    def __init__(self):
+        self.rows: list[list] = []
+        self.queries: list[tuple] = []
+        self.rowcount = 0
+
+    def cursor(self):
+        return self
+
+    def execute(self, sql, params=None):
+        self.queries.append((sql, params))
+        self.rows.append([])
+
+    def executemany(self, sql, seq):
+        self.queries.append((sql, list(seq)))
+
+    def fetchall(self):
+        return self.rows[-1] if self.rows else []
+
+    def fetchone(self):
+        return self.rows[-1][0] if self.rows and self.rows[-1] else None
+
+    def commit(self):
+        pass
+
+    def rollback(self):
+        pass
+
+    def close(self):
+        pass
+
+
+class _FakeConnector:
+    def __init__(self):
+        self._conn = _FakeConn()
+        self.acquire_calls: list[tuple] = []
+
+    def _acquire(self, db_ref, read_only=True):
+        self.acquire_calls.append((db_ref, read_only))
+        return self._conn, {"type": "doris"}
+
+    def _cursor(self, conn):
+        return conn
+
+    def _release(self, conn):
+        pass
+
+    def _format_sql(self, sql, params, db_type):
+        return sql, params
+
+
+@pytest.fixture
+def patch_env(monkeypatch):
+    fake = _FakeConnector()
+    monkeypatch.setattr(bsvc, "db_connector", fake)
+    monkeypatch.setattr(bsvc, "metadata_db_ref", lambda: "doris://meta")
+    return fake
+
+
+# --------------------------------------------------------------------------
+# plans 派生状态查询（状态从实例派生，不冗余存储）
+# --------------------------------------------------------------------------
+def test_plan_status_query(patch_env, monkeypatch):
+    """GET plan：plan + plan_table + 关联实例状态派生。"""
+    fake = patch_env._conn
+    # fetchall 序列：plan 行 / plan_table 行 / 实例行
+    fake.rows.clear()
+    fake.rows.extend([
+        [("plan-1", "olist 建仓", "importing")],
+        [("plan-1", "dwd_a", "etl_done"), ("plan-1", "dwd_b", "ddl_created")],
+        [("bld_dwd_a", "success"), ("bld_dwd_b", "running")],
+    ])
+    monkeypatch.setattr(bsvc, "_fetch_plan_with_tables", lambda meta_ref, plan_id: (
+        {"plan_id": "plan-1", "name": "olist 建仓", "status": "importing"},
+        [{"table_name": "dwd_a", "status": "etl_done"},
+         {"table_name": "dwd_b", "status": "ddl_created"}],
+        [{"ref_id": "bld_dwd_a", "status": "success"},
+         {"ref_id": "bld_dwd_b", "status": "running"}],
+    ))
+    out = bsvc.get_plan_status("plan-1")
+    assert out["ok"] is True
+    assert out["plan"]["plan_id"] == "plan-1"
+    assert out["derived_status"] == "building"  # 有 running 实例 → building
+    assert out["table_count"] == 2
+
+
+# --------------------------------------------------------------------------
+# materialize：plan → 任务/工作流（编排写入单点）
+# --------------------------------------------------------------------------
+def test_materialize_builds_tasks_and_workflow(patch_env, monkeypatch):
+    """materialize：读 plan_table → 建 DDL/ETL SQL 任务 + stream_load 导数任务
+    → 分层 DAG 工作流 → 返回 workflow_id。replace 幂等。"""
+    # plan_table 两行：ods 导数（stream_load）+ dwd ETL（SQL）
+    monkeypatch.setattr(bsvc, "_load_plan_tables", lambda meta_ref, plan_id: [
+        {"table_name": "ods_orders", "source_table": "olist_orders",
+         "sync_type": "stream_load", "file_path": "D:/csv/x.csv",
+         "layer": "ODS", "upstream_tables": ""},
+        {"table_name": "dwd_orders", "ddl_sql": "CREATE TABLE dwd_orders(id int)",
+         "etl_sql": "INSERT INTO dwd_orders SELECT * FROM ods_orders",
+         "layer": "DWD", "upstream_tables": "ods_orders"},
+    ])
+    created = []
+
+    class _OrchSvc:
+        def create_task(self, data):
+            created.append(("task", data))
+            return {**data, "task_id": f"bld_{len(created)}"}
+
+        def create_workflow(self, data):
+            created.append(("workflow", data))
+            return {**data, "workflow_id": "wf_new"}
+
+        def replace_nodes(self, wid, nodes):
+            created.append(("nodes", wid, nodes))
+            return nodes
+
+        def set_workflow_status(self, wid, status, enabled=None):
+            created.append(("status", wid, status))
+            return {"workflow_id": wid, "status": status}
+
+        def delete_task(self, tid):
+            created.append(("delete_task", tid))
+            return True
+
+        def delete_workflow(self, wid):
+            created.append(("delete_workflow", wid))
+            return True
+
+        def get_workflow(self, wid):
+            return None  # replace 模式先删旧
+
+    monkeypatch.setattr(bsvc, "orch_svc", _OrchSvc())
+    out = bsvc.materialize("plan-1", mode="replace", file_paths={})
+    assert out["ok"] is True
+    assert out["workflow_id"] == "wf_new"
+    # 2 个任务（1 stream_load + 1 ETL SQL）+ 1 工作流 + nodes
+    kinds = [c[0] for c in created]
+    assert kinds.count("task") == 2
+    assert kinds.count("workflow") == 1
+    # ETL 任务是 SQL 任务（无 pymysql 生成码）
+    etl = next(c for c in created if c[0] == "task" and "dwd_orders" in str(c[1].get("name", "")))
+    assert etl[1]["executor_type"] == "sql"
+    assert "pymysql" not in (etl[1]["code"] or "")
+    assert "requests" not in (etl[1]["code"] or "")
+    # 导数任务是 stream_load
+    load = next(c for c in created if c[0] == "task" and "stream_load" in str(c[1].get("executor_type")))
+    assert load[1]["executor_type"] == "stream_load"
+
+
+def test_materialize_dag_upstream(patch_env, monkeypatch):
+    """DAG：DWD 的 upstream_tables=ods_orders → ETL 任务 upstream_tasks 指向导数任务。"""
+    monkeypatch.setattr(bsvc, "_load_plan_tables", lambda meta_ref, plan_id: [
+        {"table_name": "ods_orders", "sync_type": "stream_load",
+         "file_path": "D:/csv/x.csv", "layer": "ODS", "upstream_tables": ""},
+        {"table_name": "dwd_orders", "etl_sql": "INSERT INTO dwd_orders SELECT 1",
+         "layer": "DWD", "upstream_tables": "ods_orders"},
+    ])
+    nodes_created = []
+
+    class _OrchSvc:
+        def create_task(self, data):
+            return {**data, "task_id": data["task_id"]}
+
+        def create_workflow(self, data):
+            return {"workflow_id": "wf1"}
+
+        def replace_nodes(self, wid, nodes):
+            nodes_created.extend(nodes)
+            return nodes
+
+        def set_workflow_status(self, wid, status, enabled=None):
+            return {"workflow_id": wid}
+
+        def delete_task(self, tid):
+            return True
+
+        def delete_workflow(self, wid):
+            return True
+
+        def get_workflow(self, wid):
+            return None
+    monkeypatch.setattr(bsvc, "orch_svc", _OrchSvc())
+    out = bsvc.materialize("plan-1", mode="replace")
+    assert out["ok"] is True
+    # dwd 节点 upstream 含 ods 节点
+    dwd_node = next(n for n in nodes_created if n["task_id"] == "bld_plan-1_dwd_orders")
+    assert "bld_plan-1_ods_orders" in (dwd_node.get("upstream_nodes") or "")
+
+
+def test_materialize_replace_cleans_old(patch_env, monkeypatch):
+    """replace 模式：先删旧任务/工作流 + 按 plan_id 清血缘（G6 修复后可用）。"""
+    monkeypatch.setattr(bsvc, "_load_plan_tables", lambda meta_ref, plan_id: [])
+    deleted = []
+
+    class _OrchSvc:
+        def create_task(self, data):
+            return {**data}
+
+        def create_workflow(self, data):
+            return {"workflow_id": "wf1"}
+
+        def replace_nodes(self, wid, nodes):
+            return nodes
+
+        def set_workflow_status(self, wid, status, enabled=None):
+            return {"workflow_id": wid}
+
+        def delete_task(self, tid):
+            deleted.append(("task", tid))
+            return True
+
+        def delete_workflow(self, wid):
+            deleted.append(("workflow", wid))
+            return True
+
+        def get_workflow(self, wid):
+            return {"workflow_id": wid}
+    monkeypatch.setattr(bsvc, "orch_svc", _OrchSvc())
+    monkeypatch.setattr(bsvc, "_delete_plan_lineage", lambda plan_id: deleted.append(("lineage", plan_id)))
+    monkeypatch.setattr(bsvc, "_old_task_ids_for_plan", lambda plan_id, meta_ref: ["bld_old1"])
+    bsvc.materialize("plan-1", mode="replace")
+    assert ("task", "bld_old1") in deleted
+    assert ("lineage", "plan-1") in deleted
