+  target_db: string;
+  target_table: string;
+  target_column: string;
+  transformation?: string | null;
+}
+export interface LineagePreview {
+  is_write: boolean;
+  target: { db: string; table: string };
+  table_edges: LineagePreviewTableEdge[];
+  column_edges: LineagePreviewColumnEdge[];
+}
