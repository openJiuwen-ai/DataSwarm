+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""csv/excel 目录源判定与视图名集单测（dialect-convergence 批次 1b G5 唯一真相源）。
+
+验证 connectors.duckdb_connector.{is_dir_location, dir_view_names}：
+- 目录/单文件/glob/s3 URL/非 csv-excel 类型的判定矩阵
+- 视图名 stem 清洗 + 冲突 _2 后缀 + sorted 稳定
+- business_data.duckdb_impl 的 _view_names/_is_csv_dir_ref 消费同一真相源
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors.duckdb_connector import (
+    dir_view_names,
+    is_dir_location,
+)
+
+
+def test_is_dir_location_matrix(tmp_path):
+    d = tmp_path / "csvdir"
+    d.mkdir()
+    (d / "a.csv").write_text("x\n1\n")
+    f = tmp_path / "single.csv"
+    f.write_text("x\n1\n")
+
+    assert is_dir_location("csv", str(d)) is True
+    assert is_dir_location("excel", str(d)) is True  # excel 目录也支持
+    assert is_dir_location("csv", str(f)) is False  # 单文件
+    assert is_dir_location("csv", str(tmp_path / "*.csv")) is False  # glob
+    assert is_dir_location("csv", "s3://bucket/prefix") is False  # URL
+    assert is_dir_location("parquet", str(d)) is False  # 非 csv/excel
+    assert is_dir_location("csv", "") is False
+    assert is_dir_location("csv", str(tmp_path / "nope")) is False
+
+
+def test_dir_view_names_stem_clean_and_conflict(tmp_path):
+    d = tmp_path / "csvdir"
+    d.mkdir()
+    (d / "1num.csv").write_text("x\n1\n")          # 数字开头 → data
+    (d / "orders.csv").write_text("x\n1\n")
+    (d / "orders-2x.csv").write_text("x\n1\n")     # 清洗后 orders2x？不：'-' 剥掉 → orders2x
+    (d / "orders-2x.csv").write_text("x\n1\n")
+    # 真冲突构造：'orders.a' 与 'orders-a' 清洗后同为 'ordersa'
+    (d / "orders.a.csv").write_text("x\n1\n")
+    (d / "orders-a.csv").write_text("x\n1\n")
+    (d / "客户数据.csv").write_text("x\n1\n")      # 非 ASCII → data（与 1num 的 data 冲突 → data_2）
+
+    names = dir_view_names("csv", str(d))
+    # sorted 文件名字典序（'-'/'.' 排在字母前，中文最后）：
+    # '1num' < 'orders-2x' < 'orders.a' < 'orders-a' < 'orders' < '客户数据'
+    assert names == ["data", "orders2x", "ordersa", "ordersa_2", "orders", "data_2"]
+
+
+def test_dir_view_names_excel_suffixes(tmp_path):
+    d = tmp_path / "xlsdir"
+    d.mkdir()
+    (d / "a.xlsx").write_text("x")
+    (d / "b.xlsm").write_text("x")
+    (d / "c.xls").write_text("x")
+    (d / "d.csv").write_text("x\n")  # excel 目录忽略 csv
+
+    assert dir_view_names("excel", str(d)) == ["a", "b", "c"]
+
+
+def test_dir_view_names_non_dir_returns_empty(tmp_path):
+    f = tmp_path / "single.csv"
+    f.write_text("x\n1\n")
+    assert dir_view_names("csv", str(f)) == []
+    assert dir_view_names("csv", "s3://bucket") == []
+
+
+def test_duckdb_impl_consumes_shared(tmp_path, monkeypatch):
+    """business_data.duckdb_impl 判定经共享函数（收口后不再独立 glob）。"""
+    from jiuwenswarm.channels.web.dataagent.business_data import duckdb_impl
+    from jiuwenswarm.common import db_connector
+
+    d = tmp_path / "csvdir"
+    d.mkdir()
+    (d / "t.csv").write_text("x\n1\n")
+    ref = db_connector.build_file_source_ref("csv", str(d))
+
+    assert duckdb_impl._is_csv_dir_ref(ref) is True
+    assert duckdb_impl._view_names(ref) == {"t"}
+    # 单文件源不是目录源
+    f = tmp_path / "single.csv"
+    f.write_text("x\n1\n")
+    ref_single = db_connector.build_file_source_ref("csv", str(f))
+    assert duckdb_impl._is_csv_dir_ref(ref_single) is False
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
