diff --git a/tests/unit_tests/test_workspace_context.py b/tests/unit_tests/test_workspace_context.py
new file mode 100644
index 000000000..e455694da
--- /dev/null
+++ b/tests/unit_tests/test_workspace_context.py
@@ -0,0 +1,311 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+import textwrap
+
+import pytest
+
+from jiuwenswarm.common import workspace_context as wc
+
+
+def _write_config(monkeypatch, tmp_path, content: str):
+    path = tmp_path / "datasource.yaml"
+    path.write_text(textwrap.dedent(content), encoding="utf-8")
+    monkeypatch.setattr(wc, "_config_path", lambda: path)
+    # 隔离 UI 工作空间注册库：否则本机 ~/.jiuwenswarm/config/workspaces.db 的
+    # 真实记录会并入 _workspace_records，把"单空间"用例变成多空间。
+    from jiuwenswarm.common import workspace_store
+
+    registry = tmp_path / "isolated_workspaces.db"
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: registry)
+
+
+_TWO_WS = """
+    default_db: sqlite:///biz.db
+    metadata_db: sqlite:///meta.db
+    workspaces:
+      ecommerce:
+        name: 电商数仓
+        default_db: sqlite:///ecommerce.db
+        metadata_db: sqlite:///meta_ecommerce.db
+      bank:
+        name: 银行数仓
+        default_db: sqlite:///bank.db
+        metadata_db: sqlite:///meta_bank.db
+"""
+
+
+def test_single_workspace_legacy_resolves_default(monkeypatch, tmp_path):
+    _write_config(monkeypatch, tmp_path, """
+        default_db: sqlite:///biz.db
+        metadata_db: sqlite:///meta.db
+    """)
+    context = wc.resolve()
+    assert context.workspace_id == "default"
+    assert wc.business_db_ref() == "sqlite:///biz.db"
+
+
+def test_multiple_workspaces_require_context(monkeypatch, tmp_path):
+    _write_config(monkeypatch, tmp_path, """
+        workspaces:
+          ecommerce:
+            default_db: sqlite:///ecommerce.db
+            metadata_db: sqlite:///meta_ecommerce.db
+          bank:
+            default_db: sqlite:///bank.db
+            metadata_db: sqlite:///meta_bank.db
+    """)
+    with pytest.raises(wc.WorkspaceContextRequired):
+        wc.resolve()
+    assert wc.resolve("bank").business_db_ref == "sqlite:///bank.db"
+
+
+def test_duplicate_metadata_refs_are_rejected(monkeypatch, tmp_path):
+    _write_config(monkeypatch, tmp_path, """
+        workspaces:
+          ecommerce:
+            default_db: sqlite:///ecommerce.db
+            metadata_db: sqlite:///meta.db
+          bank:
+            default_db: sqlite:///bank.db
+            metadata_db: sqlite:///meta.db
+    """)
+    with pytest.raises(wc.DuplicateMetadataRef):
+        wc.list_workspaces()
+
+
+def test_ref_validation_role_not_restrictive(monkeypatch, tmp_path):
+    """role 参数保留透传但不限制 ref 归属（用户决策：接口层放开 role 内容校验）；
+    本工作空间的业务库/元库 ref 互相通用，仅 workspace 边界保留。"""
+    _write_config(monkeypatch, tmp_path, """
+        workspaces:
+          bank:
+            default_db: sqlite:///bank.db
+            metadata_db: sqlite:///meta_bank.db
+    """)
+    assert wc.validate_ref_in_workspace("bank", "business", "sqlite:///bank.db")
+    # 元库 ref + business role → 放行（role 不再限制）
+    assert wc.validate_ref_in_workspace("bank", "business", "sqlite:///meta_bank.db")
+    # 业务库 ref + metadata role → 放行
+    assert wc.validate_ref_in_workspace("bank", "metadata", "sqlite:///bank.db")
+
+
+# --------------------------------------------------------------------------
+# 决策八-4 / 决策九：审计摘要与上下文隔离（多工作空间缺口补齐，2026-09-07）
+# --------------------------------------------------------------------------
+
+
+def test_audit_summary_masks_credentials(monkeypatch, tmp_path):
+    """audit_summary 只含 type+database，不带 host/端口（决策八-4）。"""
+    _write_config(monkeypatch, tmp_path, """
+        workspaces:
+          bank:
+            default_db: doris://doris-host:9030/bank_dw
+            metadata_db: doris://doris-host:9030/data_swarm_bank
+    """)
+    summary = wc.audit_summary("bank")
+    assert summary["workspace_id"] == "bank"
+    assert summary["business_ref"] == "doris:bank_dw"
+    assert summary["metadata_ref"] == "doris:data_swarm_bank"
+    blob = repr(summary)
+    assert "doris-host" not in blob and "9030" not in blob
+
+
+def test_sanitize_ref_sqlite_keeps_filename_only():
+    ref = wc.sanitize_ref("sqlite:///home/user/data/warehouse.db")
+    assert ref == "sqlite:warehouse.db"
+    assert "/" not in ref.replace("sqlite:", "", 1)
+
+
+def test_contextvar_isolation_between_threads(monkeypatch, tmp_path):
+    """ContextVar 按线程隔离：子线程 set 不影响主线程 resolve（决策九）。"""
+    import threading
+
+    _write_config(monkeypatch, tmp_path, _TWO_WS)
+    got: list[str] = []
+
+    def _run():
+        wc.set_current("bank")
+        got.append(wc.current_workspace().workspace_id)
+
+    t = threading.Thread(target=_run)
+    t.start()
+    t.join()
+    assert got == ["bank"]
+    # 主线程未 set → 多工作空间大声失败，不受子线程影响
+    with pytest.raises(wc.WorkspaceContextRequired):
+        wc.current_workspace()
+
+
