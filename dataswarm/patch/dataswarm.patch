+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/compile_provider.py —— G1 Provider：compiler 作为第一个语义引擎实现。
+
+双路径（方案 v0.5 评审结论「compiler 当第一个 Provider」）：计划成分有选定
+指标 → 优先确定性编译——SQL 由已发布定义渲染，**构造即正确**，产物
+``authoritative=true``、免口径一致性检查；编译不覆盖（跨表/越界/未发布/
+角色未确认）返回结构化 ``reason + action``，由编排层决定修计划或转 LLM 路径。
+
+错误分流红线（不能静默把越界成分转 LLM 路径绕开白名单）：
+- 跨表/维度越界/粒度不支持/过滤越界 → ``fix_plan``（口径问题，转 LLM 生成
+  也过不了 check 的白名单校验——正确解法是修计划：拆成分/取消选定/建模承接）
+- 过滤值 pending → ``probe_first``（先 probe_values 确认再回来编译）
+- 授权失败 → ``blocked``（硬边界，任何路径都过不去）
+
+导入纪律：``from ..metrics import service as metric_service``（模块引用）——
+单测打桩须 patch 模块属性，from-import 函数绑定拷贝 patch 不生效。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.common import workspace_context
+
+from ..metrics import service as metric_service
+from ..metrics.errors import (
+    DefinitionError,
+    MetricError,
+    MetricNotFound,
+    PermissionDenied,
+    QueryPlanError,
+    ReleaseNotFound,
+)
+from ..metrics.model import QuerySpec
+from .model import GROUNDING_G1
+
+
+def compile_request(body: dict[str, Any]) -> dict[str, Any]:
+    """component → 确定性编译（compile 端点入口）。
+
+    Args:
+        body: ``{"analysis_id"?, "component": {PlanComponent 序列化形态}}``——
+            component 须含 ``selected_metrics``（为空属正常探索路由，非错误）。
+
+    Returns:
+        覆盖时 ``{"covered": True, "sql"（自包含可执行）, "sql_template",
+        "params", "query_id", "selected", "authoritative": True, ...}``；
+        未覆盖时 ``{"covered": False, "action", "reason", "detail"}``——
+        action ∈ fix_plan / probe_first / llm_path / blocked。
+
+    Raises:
+        ValueError: component 缺失或形态非法。
+    """
+    component = body.get("component")
+    if not isinstance(component, dict):
+        raise ValueError("component 必须是对象")
+    selected = [str(key) for key in component.get("selected_metrics") or ()]
+    if not selected:
+        return {"covered": False, "action": "llm_path", "reason": "no_selected_metric",
+                "detail": "无选定指标——走 LLM 生成路径（探索成分）"}
+    pending = [str(flt.get("field") or "")
+               for flt in component.get("filters") or ()
+               if isinstance(flt, dict)
+               and str(flt.get("status") or "confirmed") == "pending"]
+    if pending:
+        return {"covered": False, "action": "probe_first", "reason": "pending_filter_value",
+                "detail": f"过滤值未确认（{', '.join(pending)}）——"
+                          "先 probe_values 确认后重试编译"}
+
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    try:
+        spec = QuerySpec.from_dict(_spec_of(component))
+        answer = metric_service.compile_only(
+            spec, workspace_id,
+            session_id=str(body.get("analysis_id") or ""),
+            question=str(component.get("text") or ""))
+    except MetricError as exc:
+        reason, action, detail = _classify(exc)
+        return {"covered": False, "action": action, "reason": reason, "detail": detail}
+
+    compiled = answer.compiled
+    return {
+        "covered": True, "action": "use_sql",
+        "sql": answer.sql_executable,          # 字面量内联，可直接交 execute
+        "sql_template": compiled.sql,           # 占位符模板（审计 + execute 验证）
+        "params": list(compiled.params),
+        "dialect": compiled.dialect,
+        "db_ref": compiled.datasource_ref,
+        "query_id": answer.query_id,
+        "release_id": compiled.release_id,
+        "revision_ids": list(compiled.revision_ids),
+        "metric_keys": list(compiled.metric_keys),
+        "selected": [{"metric_key": key} for key in spec.metrics],
+        "grounding_level": GROUNDING_G1,
+        "definition_grounded": True,
+        "query_semantics_verified": True,
+        "authoritative": True,
+        "non_authoritative_reasons": [],
+        "warnings": list(answer.warnings or ()),
+    }
+
+
+# ==========================================================================
+# 成分规格 → QuerySpec（同源设计的直译映射）
+# ==========================================================================
+
+def _spec_of(component: dict[str, Any]) -> dict[str, Any]:
+    """PlanComponent 序列化形态 → QuerySpec dict。
+
+    ``time`` 只带 dimension/start/end_exclusive/grain 四键（timezone 不参与
+    编译）；``filters`` 全量带入（pending 已在上游拦截）。
+    """
+    time_raw = component.get("time")
+    time_dict = None
+    if isinstance(time_raw, dict) and time_raw:
+        time_dict = {
+            "dimension": str(time_raw.get("dimension") or ""),
+            "start": str(time_raw.get("start") or ""),
+            "end_exclusive": str(time_raw.get("end_exclusive") or ""),
+        }
+        if time_raw.get("grain"):
+            time_dict["grain"] = str(time_raw["grain"])
+    return {
+        "metrics": [str(key) for key in component.get("selected_metrics") or ()],
+        "group_by": [str(dim) for dim in component.get("dimensions") or ()],
+        "filters": [
+            {"field": str(flt.get("field") or ""), "op": str(flt.get("op") or "="),
+             "value": flt.get("value")}
+            for flt in component.get("filters") or () if isinstance(flt, dict)
+        ],
+        "time": time_dict,
+    }
+
+
+# ==========================================================================
+# 异常分流（按类型优先，QueryPlanError 细类按消息前缀——消息有存量测试锚定）
+# ==========================================================================
+
+def _classify(exc: MetricError) -> tuple[str, str, str]:
+    """异常 → ``(reason, action, detail)``。
+
+    分流语义见模块 docstring；``fix_plan`` 的 detail 面向编排层（主 Agent）
+    的下一步决策，不面向终端用户。
+    """
+    detail = str(getattr(exc, "detail", "") or exc)
+    if isinstance(exc, PermissionDenied):
+        return ("not_authorized", "blocked",
+                "数据源不在当前工作空间授权范围内——硬边界，不可经其他路径绕过")
+    if isinstance(exc, ReleaseNotFound):
+        return ("no_active_release", "fix_plan",
+                "无可用指标发布批次——取消选定指标，转探索成分（G2/G3）")
+    if isinstance(exc, MetricNotFound):
+        return ("metric_not_in_release", "fix_plan",
+                f"{detail}——取消选定转探索成分，或先在指标管理页发布该指标")
+    if isinstance(exc, QueryPlanError):
+        if "共用同一绑定表" in detail:
+            return ("cross_table", "fix_plan",
+                    "选定指标绑定多张表——按表拆分成分各自编译；确需跨表口径时"
+                    "取消选定转探索成分（G2/G3），或经衍生指标/宽表建模承接")
+        if "过滤字段" in detail:
+            return ("filter_field_not_allowed", "fix_plan", detail)
+        if "允许维度" in detail:
+            return ("dimension_not_allowed", "fix_plan",
+                    f"{detail}——若诉求是时间序列，把时间列放进 time 参数"
+                    "（dimension+grain，时间通道不受维度白名单约束）而非 dimensions；"
+                    "否则移除越界维度，或取消选定转探索成分"
+                    "（所需维度不在白名单属建模缺口信号，可沉淀为建模建议）")
+        if "粒度" in detail:
+            return ("grain_not_supported", "fix_plan", detail)
+        return ("plan_violation", "fix_plan", detail)
+    if isinstance(exc, DefinitionError):
+        return ("definition_not_compilable", "fix_plan",
+                f"{detail}——该指标定义暂不可编译（表达式/依赖角色缺失），"
+                "取消选定转探索成分")
+    return ("compile_failed", "fix_plan", detail)
