+def test_publish_term_graph_replaces_by_stable_id(term_db):
+    adapter = sync._graph_adapter
+    term = _make_term()
+    first = sync.publish_term(term)
+    second = sync.publish_term(term)
+    assert first["graph"]["status"] == "ok"
+    assert second["graph"]["status"] == "ok"  # 重复 publish 不报错
+    node_id = f"term:default:{term['term_id']}"
+    node = _latest_node(adapter)
+    assert node.id == node_id
+    assert node.type == "Term"
+    assert node.properties["synonyms"] == ["GMV", "平台成交总额"]
+    assert adapter.published["glossary/default"]  # namespace 带 workspace 维度
+    # 每次写前都按稳定 id 清旧节点（Neo4j 是 CREATE 语义，不清则累积冗余）
+    expected_delete = ("glossary/default", [node_id])
+    assert adapter.delete_calls == [expected_delete, expected_delete]
