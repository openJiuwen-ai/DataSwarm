+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Datasource identity isolation without opening a database or remote service."""
+from __future__ import annotations
+
+from pathlib import Path
+from urllib.parse import parse_qs, urlencode, urlparse
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.databases import controller
+from jiuwenswarm.common import db_connector as dbc, workspace_context as wc
+
+
+@pytest.fixture(autouse=True)
+def no_connection_defaults(monkeypatch):
+    monkeypatch.setattr(dbc, "_read_config_section", lambda _: {})
+    monkeypatch.setattr(dbc, "_lookup_source_credentials", lambda *a, **k: {})
+
+
+DIFFERENT_TARGETS = [
+    ("redis://same.invalid:6379/0", "redis://same.invalid:6379/9"),
+    ("ddl://0000000000000000", "ddl://1111111111111111"),
+    ("mongodb://same.invalid:27017/a", "mongodb://same.invalid:27017/b"),
+    ("hbase://first.invalid:9090", "hbase://second.invalid:9090"),
+]
+
+
+def workspace(monkeypatch, ref):
+    context = wc.WorkspaceContext("bound", "Bound source", ref, "sqlite://isolated-metadata.db")
+    monkeypatch.setattr(wc, "resolve", lambda *a, **k: context)
+    monkeypatch.setattr(controller, "_resolve_workspace", lambda *a, **k: context)
+    return context
+
+
+@pytest.mark.parametrize("bound,requested", DIFFERENT_TARGETS)
+def test_different_targets_do_not_pass_workspace_binding(monkeypatch, bound, requested):
+    workspace(monkeypatch, bound)
+    assert wc.normalize_db_ref(bound) != wc.normalize_db_ref(requested)
+    with pytest.raises(wc.WorkspaceRefNotAllowed):
+        wc.validate_ref_in_workspace("bound", "business", requested)
+
+
+@pytest.mark.parametrize("bound,requested", [
+    ("redis://HOST.invalid:6379/0", "redis://host.invalid/00"),
+    ("ddl://0123456789abcdef", "ddl://0123456789abcdef"),
+    ("mongodb://HOST.invalid:27017/orders", "mongodb://host.invalid/orders"),
+    ("hbase://HOST.invalid:9090", "hbase://host.invalid"),
+    ("mysql://HOST.invalid:3306/orders", "mysql://host.invalid/orders"),
+    ("doris://HOST.invalid:9030/orders", "doris://host.invalid/orders"),
+    ("postgresql://HOST.invalid:5432/orders", "postgresql://host.invalid/orders"),
+    ("sqlserver://HOST.invalid:1433/orders", "sqlserver://host.invalid/orders"),
+])
+def test_equivalent_identity_returns_the_saved_ref(monkeypatch, bound, requested):
+    workspace(monkeypatch, bound)
+    assert wc.normalize_db_ref(bound) == wc.normalize_db_ref(requested)
+    assert wc.validate_ref_in_workspace("bound", "business", requested) == bound
+
+
+def test_sqlite_and_file_source_canonicalization_is_preserved(tmp_path):
+    relative = Path("identity-fixture.db")
+    assert wc.normalize_db_ref(f"sqlite://{relative}") == wc.normalize_db_ref(
+        f"sqlite://{relative.resolve()}"
+    )
+    source = tmp_path / "orders.csv"
+    ref = dbc.build_file_source_ref("csv", str(source), "orders")
+    equivalent = dbc.build_file_source_ref("csv", str(tmp_path / "." / "orders.csv"), "orders")
+    other_table = dbc.build_file_source_ref("csv", str(source), "payments")
+    assert wc.normalize_db_ref(ref) == wc.normalize_db_ref(equivalent)
+    assert wc.normalize_db_ref(ref) != wc.normalize_db_ref(other_table)
+
+
+@pytest.mark.parametrize("ref", [
+    "redis://host.invalid/0",
+    "mongodb://host.invalid/orders",
+    "mysql://host.invalid/orders",
+])
+def test_normalized_identity_excludes_connection_secrets(monkeypatch, ref):
+    secret = "identity-secret-sentinel"
+    monkeypatch.setattr(dbc, "_read_config_section", lambda _: {
+        "user": secret, "password": secret, "access_key_id": secret,
+        "access_key_secret": secret,
+    })
+    normalized = wc.normalize_db_ref(ref)
+    assert secret not in normalized
+    assert not any(key in normalized for key in ("password", "access_key"))
+
+
+class Handler:
+    def __init__(self):
+        self.response = None
+
+    @staticmethod
+    def _query_arg(parsed, name):
+        return (parse_qs(parsed.query).get(name) or [""])[0]
+
+    def _write_json(self, status, body):
+        self.response = status, body
+
+
+ROUTES = [
+    ("tables", "list_tables"),
+    ("tables/orders", "get_table_detail"),
+    ("tables/orders/preview", "preview_table"),
+]
+
+
+@pytest.mark.parametrize("bound,requested", DIFFERENT_TARGETS[:5])
+@pytest.mark.parametrize("suffix,operation", ROUTES)
+def test_controller_rejects_unbound_identity_before_data_io(monkeypatch, bound, requested, suffix, operation):
+    workspace(monkeypatch, bound)
+    monkeypatch.setattr(controller.svc, operation, lambda *a, **k: pytest.fail("unbound datasource I/O"))
+    handler = Handler()
+    query = urlencode({"workspace_id": "bound", "db_ref": requested})
+    controller.handle_get(handler, urlparse(f"/api/dataagent/databases/selector/{suffix}?{query}"))
+    assert handler.response[0] == 400
+    assert handler.response[1]["error"] == "bad_request"
+
+
+@pytest.mark.parametrize("suffix,operation", ROUTES)
+def test_controller_passes_validated_saved_ref_to_data_io(monkeypatch, suffix, operation):
+    bound, requested = "redis://HOST.invalid:6379/0", "redis://host.invalid/00"
+    workspace(monkeypatch, bound)
+    called = []
+
+    def service(ref, *args):
+        called.append(ref)
+        return [] if operation == "list_tables" else {}
+    monkeypatch.setattr(controller.svc, operation, service)
+    handler = Handler()
+    query = urlencode({"workspace_id": "bound", "db_ref": requested})
+    controller.handle_get(handler, urlparse(f"/api/dataagent/databases/selector/{suffix}?{query}"))
+    assert handler.response[0] == 200
+    assert called == [bound]
+
+
+@pytest.mark.parametrize("suffix,operation", ROUTES)
+def test_controller_keeps_bare_database_selector_contract(monkeypatch, suffix, operation):
+    workspace(monkeypatch, "redis://host.invalid:6379/0")
+    called = []
+
+    def service(ref, *args):
+        called.append(ref)
+        return [] if operation == "list_tables" else {}
+    monkeypatch.setattr(controller.svc, operation, service)
+    handler = Handler()
+    controller.handle_get(handler, urlparse(f"/api/dataagent/databases/0/{suffix}?workspace_id=bound"))
+    assert handler.response[0] == 200
+    assert called == ["0"]
