+def _ranked_search(monkeypatch, store, rankings):
+    """A ranked index that honors k, including repeated searches per query."""
+    store.index.metadata = {item["id"]: item["metadata"]
+                            for ranking in rankings for item in ranking}
+    calls = []
+
+    def search(query_vector, k):
+        query_index = int(np.argmax(query_vector))
+        calls.append((query_index, k))
+        return rankings[query_index][:k]
+
+    monkeypatch.setattr(store, "search_similar", search)
+    return calls
+
