+def update_release(release_id: str, **fields: Any) -> None:
+    """按列名更新发布批次。列名取自白名单，杜绝 SQL 注入。"""
+    allowed = {
+        "label", "status", "revision_ids_json", "manifest_json", "checksum",
+        "projection_graph", "projection_status", "error_code", "error_message",
+        "projected_at", "published_at", "published_by",
+    }
+    updates = {k: v for k, v in fields.items() if k in allowed}
+    if not updates:
+        return
+    assignments = ", ".join(f"{k} = ?" for k in updates)
+    conn = _connect()
+    try:
+        with _write_lock:
+            _exec(
+                conn,
+                f"UPDATE dw_metric_releases SET {assignments} WHERE release_id = ?",
+                (*updates.values(), release_id),
+            )
+            conn.commit()
+    finally:
+        conn.close()
