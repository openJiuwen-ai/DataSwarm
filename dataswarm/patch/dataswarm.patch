@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { dedupeColumnLineageEdges, getFlowAutoFitMinZoom } from '../node_modules/.cache/governance-flow-model/flowModel.mjs';
+
+test('deduplicates the current artifact shape from 27 edges to 3 exact relations', () => {
+  const relations = [
+    { from: 'ods.items.price', to: 'dwd.detail.price', transformation: null },
+    { from: 'dwd.detail.price', to: 'dws.category.avg_price', transformation: 'AVG(price)' },
+    { from: 'dws.category.avg_price', to: 'ads.category.avg_price', transformation: null },
+  ];
+  const duplicated = Array.from({ length: 9 }, () => relations).flat();
+
+  const unique = dedupeColumnLineageEdges(duplicated);
+
+  assert.equal(duplicated.length, 27);
+  assert.deepEqual(unique, relations);
+});
+
+test('uses strict tuple identity without delimiter collisions or value normalization', () => {
+  const edges = [
+    { from: 'a|b', to: 'c', transformation: 'd' },
+    { from: 'a', to: 'b|c', transformation: 'd' },
+    { from: 'a', to: 'b', transformation: null },
+    { from: 'a', to: 'b', transformation: undefined },
+    { from: 'a', to: 'b', transformation: '' },
+    { from: 'a', to: 'b', transformation: ' ' },
+    { from: 'a', to: 'b', transformation: null },
+  ];
+
+  assert.deepEqual(dedupeColumnLineageEdges(edges), edges.slice(0, -1));
+});
+
+test('exposes readable and complete auto-fit lower bounds', () => {
+  assert.equal(getFlowAutoFitMinZoom('readable'), 0.7);
+  assert.equal(getFlowAutoFitMinZoom('complete'), 0.08);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/governanceMetricChartModel.test.mjs b/jiuwenswarm/channels/web/frontend/tests/governanceMetricChartModel.test.mjs
