+                                    docs=docs, warnings=[])
+    assert first is not None and len(first) == 2
+
+    def _boom(*args, **kwargs):
+        raise AssertionError("memo 命中时不该再读缓存文件")
+
+    monkeypatch.setattr(embedding, "_read_cache", _boom)
+    second = embedding.load_or_build(workspace_id=WORKSPACE, scope_id="memo-scope",
+                                     docs=docs, warnings=[])
+    assert second is first, "同文档集同模型必须复用同一份索引"
+
+    # 文档变了 → memo 失效，回到读文件 + 增量嵌入路径
+    monkeypatch.setattr(embedding, "_read_cache", lambda *a, **k: {})
+    emb_on.texts.clear()
+    changed = embedding.load_or_build(
+        workspace_id=WORKSPACE, scope_id="memo-scope",
+        docs=[("k1", "成交额 gmv"), ("k2", "订单笔数")], warnings=[])
+    assert changed is not None and changed is not first
+    assert "订单笔数" in emb_on.texts, "变更的文档必须重嵌"
