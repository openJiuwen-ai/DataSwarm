+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { RefreshCw } from 'lucide-react';
+import { orchestrationApi } from '../api/orchestrationApi';
+import { useListControls, useListQuery } from '../hooks/useListQuery';
+import { confirmDialog, useAction } from './shared/Ui';
+import { HifiButton, HifiStatus, IconButton, LinkAction, SearchBox } from './shared/Hifi';
+import { RowMenu } from './shared/RowMenu';
+import { Table } from '../../../components/ui/Table/Table';
+import { Pagination } from '../../../components/ui/Pagination/Pagination';
+import { WorkflowFormDrawer } from './WorkflowFormDrawer';
+import { RecentWorkflowRuns } from './RecentWorkflowRuns';
+
+interface Props {
+  onEdit: (workflowId: string) => void;
+  onShowRuns: (workflowId: string, instanceId?: string) => void;
+}
+
+interface WorkflowRow {
+  workflow_id: string;
+  name: string;
+}
+
+export function WorkflowListPage({ onEdit, onShowRuns }: Props) {
+  const { t } = useTranslation();
+  const { search, setSearch, setComposing, debouncedQ, page, setPage, pageSize, setPageSize } = useListControls();
+  const [statusFilter, setStatusFilter] = useState<'draft' | 'published' | null>(null);
+  const load = useCallback(async () => {
+    const result = await orchestrationApi.listWorkflows({
+      q: debouncedQ,
+      status: statusFilter ?? undefined,
+      limit: pageSize,
+      offset: (page - 1) * pageSize,
+    });
+    return { items: result.workflows, total: result.total };
+  }, [debouncedQ, statusFilter, pageSize, page]);
+  const {
+    items: workflows,
+    total: workflowTotal,
+    loading,
+    error: listError,
+    visibleError,
+    dismissError,
+    hasLoaded,
+    reload,
+  } = useListQuery(load);
+  useEffect(() => {
+    if (!loading && !listError && page > Math.max(1, Math.ceil(workflowTotal / pageSize)))
+      setPage(Math.max(1, Math.ceil(workflowTotal / pageSize)));
+  }, [loading, listError, workflowTotal, page, pageSize, setPage]);
+  const [refreshing, setRefreshing] = useState(false);
+  const [recentRevision, setRecentRevision] = useState(0);
+  const loadCounts = useCallback(async () => {
+    const [draft, published] = await Promise.all([
+      orchestrationApi.listWorkflows({ status: 'draft', limit: 1, offset: 0 }),
+      orchestrationApi.listWorkflows({ status: 'published', limit: 1, offset: 0 }),
+    ]);
+    return { items: [{ draft: draft.total, published: published.total }], total: draft.total + published.total };
+  }, []);
+  const counts = useListQuery(loadCounts);
+  const reloadDirectory = async () => {
+    await Promise.all([reload(), counts.reload()]);
+  };
+  const toggleStatusFilter = (value: 'draft' | 'published') => {
+    setStatusFilter((current) => (current === value ? null : value));
+    setPage(1);
+  };
+
+  const [formOpen, setFormOpen] = useState(false);
+  const { busy, run } = useAction();
+
+  const onRefresh = async () => {
+    setRefreshing(true);
+    try {
+      await reloadDirectory();
+      setRecentRevision((value) => value + 1);
+    } finally {
+      setRefreshing(false);
+    }
+  };
+
+  const onDebug = (wf: WorkflowRow) =>
+    void run(`debug:${wf.workflow_id}`, t('dataAsset.wfList.debugTriggered', { name: wf.name }), async () => {
+      const inst = await orchestrationApi.debugWorkflow(wf.workflow_id);
+      if (inst) onShowRuns(wf.workflow_id, inst.instance_id);
+      return !!inst;
+    });
+
+  const onPublish = (wf: WorkflowRow) =>
+    void run(`publish:${wf.workflow_id}`, t('dataAsset.wfList.published', { name: wf.name }), async () => {
+      await orchestrationApi.publishWorkflow(wf.workflow_id);
+      await reloadDirectory();
+      return true;
+    });
+
+  const onUnpublish = (wf: WorkflowRow) =>
+    void run(`unpublish:${wf.workflow_id}`, t('dataAsset.wfList.unpublished', { name: wf.name }), async () => {
+      const ok = await confirmDialog({
+        title: t('dataAsset.wfList.unpublishTitle', { name: wf.name }),
+        message: t('dataAsset.wfList.unpublishMessage'),
+        confirmText: t('dataAsset.wfList.unpublishConfirm'),
+      });
+      if (!ok) return undefined;
+      await orchestrationApi.unpublishWorkflow(wf.workflow_id);
+      await reloadDirectory();
+      return true;
+    });
+
+  const onDelete = (wf: WorkflowRow) =>
+    void run(`delete:${wf.workflow_id}`, t('dataAsset.wfList.deleted', { name: wf.name }), async () => {
+      const ok = await confirmDialog({
+        title: t('dataAsset.wfList.deleteTitle', { name: wf.name }),
+        message: t('dataAsset.wfList.deleteMessage'),
+        confirmText: t('common.delete'),
+        danger: true,
+      });
+      if (!ok) return undefined;
+      await orchestrationApi.deleteWorkflow(wf.workflow_id);
+      await reloadDirectory();
+      setRecentRevision((value) => value + 1);
+      return true;
+    });
+
+  return (
+    <div className="dd-home">
+      {visibleError && (
+        <div className="da-error" role="alert">
+          <span>{visibleError}</span>
+          <button type="button" onClick={dismissError} aria-label={t('common.close')}>
+            ×
+          </button>
+        </div>
+      )}
+      <header className="dd-home-header">
+        <h1>{t('dataAsset.brand')}</h1>
+        <p>{t('dataAsset.development.subtitle')}</p>
+      </header>
+      <RecentWorkflowRuns onOpen={onShowRuns} revision={recentRevision} />
+      <div className="dd-directory-toolbar">
+        <div className="dd-directory-heading">
+          <h2>{t('dataAsset.wfList.sectionTitle')}</h2>
+          {counts.items[0] &&
+            (['draft', 'published'] as const).map((value) => (
+              <button
+                type="button"
+                key={value}
+                className="dd-count dd-status-toggle"
+                aria-pressed={statusFilter === value}
+                onClick={() => toggleStatusFilter(value)}
+              >
+                <HifiStatus
+                  status={value}
+                  label={`${t(value === 'published' ? 'dataAsset.development.published' : 'dataAsset.status.draft')} ${counts.items[0][value]}`}
+                />
+              </button>
+            ))}
+        </div>
+        <div className="dd-directory-actions">
+          <SearchBox
+            onCompositionChange={setComposing}
+            value={search}
+            onChange={setSearch}
+            placeholder={t('dataAsset.wfList.searchPlaceholder')}
+          />
+          <IconButton onClick={() => void onRefresh()} loading={refreshing} title={t('common.refresh')}>
+            <RefreshCw size={14} aria-hidden="true" />
+          </IconButton>
+          <HifiButton onClick={() => setFormOpen(true)}>{t('dataAsset.wfList.create')}</HifiButton>
+        </div>
+      </div>
+      {counts.error && (
+        <div role="alert" className="dd-error">
+          {counts.error}
+          <button type="button" onClick={() => void counts.reload()}>
+            {t('common.retry')}
+          </button>
+        </div>
+      )}
+      {listError && !workflows.length ? null : loading && !workflows.length ? (
+        <div className="da-empty">{t('dataAsset.wfList.loading')}</div>
+      ) : workflows.length === 0 ? (
+        <div className="da-empty">
+          {debouncedQ || statusFilter ? t('dataAsset.wfList.emptyFiltered') : t('dataAsset.wfList.empty')}
+        </div>
+      ) : (
+        <Table
+          headers={[
+            t('dataAsset.wfList.col.name'),
+            t('dataAsset.development.description'),
+            t('dataAsset.wfList.col.status'),
+            t('dataAsset.wfList.col.instanceCount'),
+            t('dataAsset.wfList.col.actions'),
+          ]}
+        >
+          {workflows.map((wf) => (
+            <tr key={wf.workflow_id}>
+              <td>
+                <button
+                  type="button"
+                  className="da-link"
+                  onClick={() => onEdit(wf.workflow_id)}
+                  title={`${wf.name} (${wf.workflow_id})`}
+                >
+                  {wf.name}
+                </button>
+              </td>
+              <td>
+                <span className="dd-description" title={wf.description || undefined}>
+                  {wf.description || '—'}
+                </span>
+              </td>
+              <td>
+                <HifiStatus
+                  status={wf.status}
+                  label={t(wf.status === 'published' ? 'dataAsset.development.published' : 'dataAsset.status.draft')}
+                />
+              </td>
+              <td>{wf.instance_count ?? '—'}</td>
+              <td>
+                <div className="flex items-center gap-4">
+                  {wf.status === 'draft' ? (
+                    <LinkAction loading={busy === `publish:${wf.workflow_id}`} onClick={() => onPublish(wf)}>
+                      {t('dataAsset.wfList.publish')}
+                    </LinkAction>
+                  ) : (
+                    <LinkAction loading={busy === `unpublish:${wf.workflow_id}`} onClick={() => onUnpublish(wf)}>
+                      {t('dataAsset.wfList.unpublish')}
+                    </LinkAction>
+                  )}
+                  <LinkAction loading={busy === `debug:${wf.workflow_id}`} onClick={() => onDebug(wf)}>
+                    {t('dataAsset.wfList.debug')}
+                  </LinkAction>
+                  <RowMenu
+                    text={t('dataAsset.wfList.more')}
+                    items={[
+                      { label: t('dataAsset.wfList.runHistory'), onClick: () => onShowRuns(wf.workflow_id) },
+                      { label: t('dataAsset.wfList.edit'), onClick: () => onEdit(wf.workflow_id) },
+                      {
+                        label: t('common.delete'),
+                        onClick: () => onDelete(wf),
+                        danger: true,
+                        loading: busy === `delete:${wf.workflow_id}`,
+                      },
+                    ]}
+                  />
+                </div>
+              </td>
+            </tr>
+          ))}
+        </Table>
+      )}
+      {hasLoaded && (
+        <Pagination
+          total={workflowTotal}
+          page={page}
+          pageSize={pageSize}
+          onPageChange={setPage}
+          onPageSizeChange={setPageSize}
+          loading={loading}
+          labels={{
+            total: t('common.pagination.total', { count: workflowTotal }),
+            pageSize: t('common.pagination.pageSize'),
+            previous: t('common.pagination.previous'),
+            next: t('common.pagination.next'),
+            page: (item) => t('common.pagination.page', { page: item }),
+            navLabel: t('common.pagination.navLabel'),
+          }}
+        />
+      )}
+      <WorkflowFormDrawer
+        open={formOpen}
+        workflow={null}
+        onClose={() => {
+          setFormOpen(false);
+          void reloadDirectory();
+        }}
+        onCreated={(wf) => onEdit(wf.workflow_id)}
+      />
+    </div>
+  );
+}
