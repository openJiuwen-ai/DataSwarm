+def test_load_llm_config_prefers_is_default_entry(tmp_path):
+    """对话主模型是 is_default=True 的条目，深化同样取它（而非列表首位）。"""
+    from jiuwenswarm.channels.web.dataagent.metrics import llm as metrics_llm
