+    assert result["ok"] is False
+    assert result["error_code"] == "TEST_FAILED"
+    assert calls == []
+
+
+def test_create_source_file_type_skips_probe(monkeypatch, workspace_env):
+    """csv 文件型源不探测：test_connection 失败也放行保存（行为不变）。"""
+    calls = _make_store(monkeypatch, [])
