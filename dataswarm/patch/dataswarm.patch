+
+def test_groupby_on_declared_time_field_passes(semantic_env):
+    """按月看趋势：时间列进 GROUP BY 是合法的，不是越界维度。
+
+    回归：指标定义把时间字段（time_field）与业务维度（group_by_fields）分开
+    存，白名单漏掉时间字段会把**所有趋势类分析**判成越界——实测现象是模型
+    连续两轮 fail 后绕开指标口径，产物从 G1 掉到 G2。
+    """
+    sql = ("SELECT DATE_FORMAT(orders.paid_at, '%Y-%m') AS ym, SUM(orders.amount_cny) "
