+
+def a_oss_uri_normalization():
+    from jiuwenswarm.channels.web.dataagent.connectors.duckdb_connector import DuckDBConnector
+    n = DuckDBConnector._normalize_object_store_uri
+    assert n("oss://bucket/a/b.parquet") == "s3://bucket/a/b.parquet"
+    assert n("s3a://bucket/k") == "s3://bucket/k"
+    assert n("s3://bucket/k") == "s3://bucket/k"
+    assert n("D:/data/x.parquet") == "D:/data/x.parquet"
+    return "oss:// 与 s3a:// 归一到 s3://，本地路径不变"
