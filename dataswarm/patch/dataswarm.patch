+
+def test_no_time_window_legal_unknown(semantic_env):
+    """计划无时间窗时 SQL 无时间条件为合法——unknown 文案不误导。"""
+    sql = ("SELECT orders.region, SUM(orders.amount_cny) FROM orders "
+           "WHERE orders.pay_status = 'paid' GROUP BY orders.region")
+    result = checks.check_request(_body(sql))
+    detail = _check_of(result, "time_boundary_shape")["detail"]
+    assert "计划未声明时间窗" in detail
