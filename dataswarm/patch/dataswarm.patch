@@ -0,0 +1,253 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""db-ref 编解码、连接和元数据端口的注册表。
+
+codec 统一提供 decode、连接及 tables/schema 等端口，方言能力仍由
+dialect_registry 管理。uses_pool=True 时由 db_connector 管理连接池；
+uses_pool=False 时由 codec 或委托引擎负责 I/O。
+"""
+from __future__ import annotations
+
+import re
+from typing import Any, Sequence
+
+
+def table_identifier_parts(table: str, dialect: str) -> list[str]:
+    """Parse a table or schema.table name, preserving quoted identifier case.
+
+    Metadata entry points accept identifiers, never SQL expressions. Quoted
+    components may contain dots or escaped delimiters; a plain split('.') loses
+    their meaning.
+    """
+    from jiuwenswarm.common.dialect_registry import profile_for
+
+    profile = profile_for(dialect)
+    opening, closing = profile.ident_quote, profile.quote_close
+    value = str(table or "").strip()
+    parts: list[str] = []
+    while value:
+        if value.startswith(opening):
+            chars: list[str] = []
+            index = 1
+            while index < len(value):
+                if value[index] == closing:
+                    if index + 1 < len(value) and value[index + 1] == closing:
+                        chars.append(closing)
+                        index += 2
+                        continue
+                    break
+                chars.append(value[index])
+                index += 1
+            if index == len(value):
+                raise ValueError("unterminated quoted table identifier")
+            part = "".join(chars)
+            value = value[index + 1:].strip()
+        else:
+            part, separator, tail = value.partition(".")
+            part = part.strip()
+            if not re.fullmatch(r"[\w$#]+", part):
+                raise ValueError("invalid table identifier")
+            value = "." + tail if separator else ""
+        if not part or any(ord(char) < 32 for char in part):
+            raise ValueError("invalid table identifier")
+        parts.append(part)
+        if len(parts) > 2:
+            raise ValueError("table identifier must be table or schema.table")
+        if value:
+            if not value.startswith(".") or not value[1:].strip():
+                raise ValueError("invalid qualified table identifier")
+            value = value[1:].strip()
+    if not parts:
+        raise ValueError("table identifier is required")
+    return parts
+
+
+def quoted_table_identifier(table: str, dialect: str) -> str:
+    from jiuwenswarm.common.dialect_registry import quote_ident
+
+    return ".".join(quote_ident(dialect, part) for part in table_identifier_parts(table, dialect))
+
+
+class RefCodec:
+    """一种 db-ref scheme 的编解码器。
+
+    子类至少要实现 ``decode``；关系库再实现四个元数据钩子，自管 I/O 的类型
+    改为实现 ``list_tables`` / ``describe``。
+    """
+
+    #: db-ref 的 scheme，同时是 ``parse_db_ref`` 返回的 ``spec["type"]``。
+    scheme: str = ""
+    #: 对应 ``dialect_registry`` 的键（方言知识不在 codec 里重复声明）。
+    dialect: str = ""
+    #: True = 连接走 db_connector 的 Engine 池；False = codec 自管 I/O。
+    uses_pool: bool = True
+    #: 该方言裸标识符默认落到的 schema（DuckDB 的 main）；空串表示无此概念。
+    #: 跨 schema 同名时按它优先，与裸名 SQL 的解析结果保持一致。
+    default_schema: str = ""
+
+    # ------------------------------------------------------------------ #
+    # 解码（必须实现）
+    # ------------------------------------------------------------------ #
+    def decode(self, rest: str, db_ref: str) -> dict:
+        """``scheme://`` 之后的部分 → spec。必须含 ``type`` 键。"""
+        raise NotImplementedError
+
+    # ------------------------------------------------------------------ #
+    # 连接（走池的类型实现）
+    # ------------------------------------------------------------------ #
+    def engine_url(self, spec: dict, read_only: bool) -> str:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 engine_url")
+
+    def connect_direct(self, spec: dict, read_only: bool) -> tuple[Any, dict]:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 connect_direct")
+
+    def post_connect(self, conn: Any, read_only: bool) -> None:
+        """拿到裸连接后的驱动级调整（默认无操作）。
+
+        例：sqlite 要设 ``row_factory = sqlite3.Row``。
+        """
+        return None
+
+    def session_setup(self, cur: Any, read_only: bool) -> None:
+        """会话级参数设置（默认无操作）。
+
+        例：Doris 写入前 ``SET enable_insert_strict = false``；PostgreSQL 按
+        配置设 ``search_path``。失败不应中断主流程，由调用方包 try。
+        """
+        return None
+
+    # ------------------------------------------------------------------ #
+    # 元数据：走池的类型只给 SQL 与行映射
+    # ------------------------------------------------------------------ #
+    def tables_sql(self) -> str:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 tables_sql")
+
+    def map_tables(self, rows: Sequence[Sequence[Any]]) -> list[str]:
+        return [r[0] for r in rows]
+
+    def describe_sql(self, table: str) -> str:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 describe_sql")
+
+    def map_columns(self, rows: Sequence[Sequence[Any]]) -> list[dict]:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 map_columns")
+
+    # ------------------------------------------------------------------ #
+    # 元数据：需要多步游标交互的治理端口（走池的类型实现）
+    # ------------------------------------------------------------------ #
+    # 这两个不能像 tables_sql 那样只给一条 SQL：SQLite 读索引要先 index_list
+    # 再逐个 index_info，是多轮交互；取 CREATE 语句两族的取值列位也不同
+    # （sqlite row[0] / MySQL row[1]）。所以端口收在「给你游标，你负责读」。
+    def read_indexes(self, cur: Any, table: str) -> list[dict]:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 read_indexes")
+
+    def read_create_sql(self, cur: Any, table: str) -> str:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 read_create_sql")
+
+    # ------------------------------------------------------------------ #
+    # 元数据：自管 I/O 的类型实现这些
+    # ------------------------------------------------------------------ #
+    def list_tables(self, spec: dict) -> dict:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 list_tables")
+
+    def query(self, spec: dict, sql: str, params=None, limit: int = 100) -> dict:
+        """Self-managed codecs opt into execution; metadata-only refs reject it."""
+        raise ValueError(f"{self.scheme} source is metadata-only; SQL queries are unavailable")
+
+    def describe(self, spec: dict, table: str) -> dict:
+        raise NotImplementedError(f"{self.scheme} codec 未实现 describe")
+
+    def indexes(self, spec: dict) -> list[dict]:
+        """自管 I/O 类型的索引。默认空——文件源是 VIEW，无索引语义。"""
+        return []
+
+    def create_sql(self, spec: dict) -> str:
+        """自管 I/O 类型的建表语句。默认空串——VIEW 由运行时注册，无持久 DDL。"""
+        return ""
+
+    def meta(self, spec: dict) -> dict:
+        """自管 I/O 类型的连接元信息（返回给调用方的 ``db`` 字段）。"""
+        raise NotImplementedError(f"{self.scheme} codec 未实现 meta")
+
+
+_CODECS: dict[str, RefCodec] = {}
+
+
+def register_ref_codec(codec_cls: type[RefCodec]) -> type[RefCodec]:
+    """装饰器：注册 db-ref codec。
+
+    重名报错（防静默覆盖，与 ``@register_source_type`` / ``@register_engine``
+    同口径）。
+    """
+    scheme = getattr(codec_cls, "scheme", "")
+    if not scheme:
+        raise ValueError(f"{codec_cls.__name__}.scheme 不能为空")
+    if scheme in _CODECS:
+        raise ValueError(f"ref codec already registered: {scheme}")
+    _CODECS[scheme] = codec_cls()
+    return codec_cls
+
+
+def register_alias(alias: str, scheme: str) -> None:
+    """把一个 scheme 别名指向已注册的 codec，用于同线协议族复用。
+
+    与 ``dialect_registry._ALIASES`` 的作用相同但层次不同：那边决定「按什么方言
+    解析 SQL」，这边决定「用哪套连接与目录读取逻辑」。
+    """
+    target = _CODECS.get(scheme)
+    if target is None:
+        raise ValueError(f"alias 目标 codec 未注册: {scheme}")
+    if alias in _CODECS:
+        raise ValueError(f"ref codec already registered: {alias}")
+    _CODECS[alias] = target
+
+
+_builtins_loaded = False
+
+
+def _ensure_builtins() -> None:
+    """内置 codec 定义在 ``db_connector`` 里（要用到它的私有连接助手），靠 import
+    副作用注册。只 import 本模块的调用方否则会看到空注册表——那是「未注册
+    scheme」的假报错，排查方向完全错。此处按需补一次 import。
+
+    不会循环 import：本模块的模块体不 import db_connector，而 db_connector 的
+    顶部 import 本模块；``_builtins_loaded`` 标志避免在 db_connector 自身初始化
+    期间重入。
+    """
+    global _builtins_loaded
+    if _builtins_loaded or _CODECS:
+        return
+    _builtins_loaded = True
+    try:
+        import jiuwenswarm.common.db_connector  # noqa: F401  —— 仅为注册副作用
+    except Exception:  # noqa: BLE001 —— 连不上就维持空表，由调用方报缺 codec
+        pass
+
+
+def codec_for(scheme: str) -> RefCodec:
+    _ensure_builtins()
+    codec = _CODECS.get(str(scheme or "").strip().lower())
+    if codec is None:
+        raise ValueError(
+            f"不支持的 db-ref scheme: {scheme!r}（已注册: {sorted(_CODECS)}）。"
+            f"新增数据源类型需注册 RefCodec，否则治理/血缘/知识派生接不上。"
+        )
+    return codec
+
+
+def is_registered(scheme: str) -> bool:
+    _ensure_builtins()
+    return str(scheme or "").strip().lower() in _CODECS
+
+
+def registered_schemes() -> list[str]:
+    _ensure_builtins()
+    return sorted(_CODECS)
+
+
+def pooled_schemes() -> list[str]:
+    _ensure_builtins()
+    return sorted(s for s, c in _CODECS.items() if c.uses_pool)
+
+
+def self_managed_schemes() -> list[str]:
+    _ensure_builtins()
+    return sorted(s for s, c in _CODECS.items() if not c.uses_pool)
