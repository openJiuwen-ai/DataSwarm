index 000000000..5baa15fde
--- /dev/null
+++ b/tests/unit_tests/common/test_db_connector_limit.py
@@ -0,0 +1,120 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""db_connector.query 的 limit<=0 截断行为单测（方案 §3.1 G2）。
+
+验证：
+- limit<=0 不走 fetchall（防 OOM），改走 fetchmany(MAX_QUERY_ROWS+1) + 截断标记
+- limit=None 仍走 fetchall（聚合场景，向后兼容）
+- truncated 正确反映是否超限
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.common import db_connector
+from jiuwenswarm.common.db_connector import MAX_QUERY_ROWS
+
+
+class _FakeCursor:
+    """假游标：记录 fetchmany/fetchall 调用与返回行。"""
+
+    def __init__(self, rows: list):
+        self._rows = rows
+        self.fetchmany_calls: list[int | None] = []
+        self.fetchall_calls = 0
+        self.execute_calls: list[str] = []
+        self.description = [(r"col",)] if rows else []
+
+    def execute(self, sql, params=None):
+        self.execute_calls.append(sql)
+
+    def fetchmany(self, n):
+        self.fetchmany_calls.append(n)
+        return self._rows[:n]
+
+    def fetchall(self):
+        self.fetchall_calls += 1
+        return self._rows
+
+
+class _FakeConn:
+    def __init__(self, cur: _FakeCursor):
+        self._cur = cur
+
+    def cursor(self):
+        return self._cur
+
+    def close(self):
+        pass
+
+
+def _patch_acquire(monkeypatch, cur, db_type="sqlite"):
+    """patch db_connector._acquire 返回假连接 + meta。"""
+    meta = {"type": db_type, "ref": "sqlite://test"}
+    conn = _FakeConn(cur)
+
+    def _fake_acquire(db_ref, read_only=True):
+        return conn, meta
+
+    def _fake_release(c):
+        pass
+
+    monkeypatch.setattr(db_connector, "_acquire", _fake_acquire)
+    monkeypatch.setattr(db_connector, "_release", _fake_release)
+    monkeypatch.setattr(db_connector, "_invalidate", lambda *a, **kw: None)
+
+
+def test_limit_zero_uses_fetchmany_not_fetchall(monkeypatch):
+    """limit=0 走 fetchmany(MAX+1) 截断，不走 fetchall（G2 修复前是 fetchall）。"""
+    rows = [{"t": i} for i in range(MAX_QUERY_ROWS + 5)]  # 超限
+    cur = _FakeCursor(rows)
+    _patch_acquire(monkeypatch, cur)
+
+    result = db_connector.query("sqlite://test", "SELECT * FROM t", limit=0)
+
+    assert cur.fetchall_calls == 0, "limit<=0 不应走 fetchall"
+    assert cur.fetchmany_calls == [MAX_QUERY_ROWS + 1], "应 fetch MAX+1 行判断截断"
+    assert result["truncated"] is True
+    assert result["row_count"] == MAX_QUERY_ROWS
+
+
+def test_limit_negative_uses_fetchmany_not_fetchall(monkeypatch):
+    """limit=-1 同 limit=0，走 fetchmany 截断。"""
+    rows = [{"t": i} for i in range(3)]
+    cur = _FakeCursor(rows)
+    _patch_acquire(monkeypatch, cur)
+
+    result = db_connector.query("sqlite://test", "SELECT * FROM t", limit=-1)
+
+    assert cur.fetchall_calls == 0
+    assert cur.fetchmany_calls == [MAX_QUERY_ROWS + 1]
+    assert result["truncated"] is False  # 3 行 < MAX
+
+
+def test_limit_none_still_fetchall(monkeypatch):
+    """limit=None 仍走 fetchall（聚合场景向后兼容，truncated 恒 False）。"""
+    rows = [{"t": i} for i in range(3)]
+    cur = _FakeCursor(rows)
+    _patch_acquire(monkeypatch, cur)
+
+    result = db_connector.query("sqlite://test", "SELECT * FROM t", limit=None)
+
+    assert cur.fetchall_calls == 1, "limit=None 应走 fetchall"
+    assert cur.fetchmany_calls == []
+    assert result["truncated"] is False
+
+
+def test_limit_zero_no_limit_in_sql(monkeypatch):
+    """limit<=0 不拼 LIMIT 进 SQL（避免 Doris 聚合 parse 错），靠 fetch 截断。"""
+    rows = [{"t": i} for i in range(3)]
+    cur = _FakeCursor(rows)
+    _patch_acquire(monkeypatch, cur)
+
+    db_connector.query("sqlite://test", "SELECT * FROM t", limit=0)
+
+    executed = cur.execute_calls[0]
+    assert "LIMIT" not in executed.upper(), f"limit<=0 不应拼 LIMIT，实际: {executed}"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
