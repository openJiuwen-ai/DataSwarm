+def e_saved_config_without_environment_credentials():
+    """Use a real isolated SQLite registry and fresh cache, not env credentials.
+
+    This covers both FTP and batch12's SFTP. For SFTP the saved host identity
+    trust setting must survive together with user/password; otherwise governance
+    would reject the real server even though the source's own connector worked.
+    """
+    import tempfile
+    from contextlib import ExitStack
+    from unittest.mock import patch
+    from jiuwenswarm.channels.web.dataagent.datasource import store
+    from jiuwenswarm.common import db_connector as dbc
+
+    repository = Path(__file__).resolve().parents[4]
+    with tempfile.TemporaryDirectory(prefix=f"dataswarm-{PROTOCOL}-saved-source-") as directory:
+        scratch = Path(directory)
+        overrides = {
+            "JIUWENSWARM_DATASOURCE_DB": str(scratch / "metadata.db"),
+            "JIUWENSWARM_DEPLOY_SCHEMA_DIR": str(repository / "deploy" / "schema"),
+            "JIUWENSWARM_STAGED_CACHE": str(scratch / "fresh-cache"),
+        }
+        with patch.dict(os.environ, overrides), ExitStack() as cleanup:
+            # Returning a connection to SQLAlchemy's pool does not release its
+            # Windows file handle. Dispose only this temporary metadata DB.
+            meta_ref = store._resolve_db_ref()
+            cleanup.callback(dbc._invalidate, meta_ref, False)
+            cleanup.callback(dbc._invalidate, meta_ref, True)
+            cleanup.callback(store._initialized_refs.discard, meta_ref)
+            for key in list(os.environ):
+                if key.startswith(("SFTP_", "FTP_")):
+                    os.environ.pop(key)
+            assert not any(key.startswith(("SFTP_", "FTP_")) for key in os.environ)
+            ref = R.get_source_type("ftp").build_ref(FTP_CONFIG)
+            source_id = f"acceptance-saved-{PROTOCOL}"
+            store.insert_source(source_id, "ftp", "Saved transport acceptance", dict(FTP_CONFIG), ref)
+            saved = store.get_source(source_id)
+            assert saved is not None and saved["config"] == FTP_CONFIG
+            names = dbc.tables(ref)["tables"]
+            assert "fact_orders" in names, names
+            columns = dbc.schema(ref, "fact_orders")["columns"]
+            assert len(columns) == 7 and {c["name"] for c in columns} >= {"order_id", "order_amt"}
+            result = dbc.query(ref, "SELECT COUNT(*), ROUND(SUM(order_amt),2) FROM fact_orders")
+            count, total = result["rows"][0]
+            assert count == 50000 and abs(float(total) - 2318839.92) < 0.0001, result["rows"]
+            cache_files = list((scratch / "fresh-cache").rglob("fact_orders.csv"))
+            assert cache_files, "治理查询没有通过新缓存真实拉取文件"
+            return (f"临时 SQLite 保存 {PROTOCOL} 配置后清空全部 FTP_/SFTP_ 环境变量；"
+                    f"治理 tables/schema/query 真实成功，50000 行，总额={total}")
+
+
+check("E1", "保存配置后不依赖环境凭据", e_saved_config_without_environment_credentials)
+
+# ======================================================================
+print("\n########## hdfs ##########")
+blocked("hdfs", "本批不覆盖（已移至第 11 批）",
+        "本批写的时候认为 WebHDFS 需要多机 Hadoop 集群，故标为无法真验。"
+        "**那个判断是错的**：伪分布式只是 NameNode + DataNode 两个 JVM 进程。"
+        "hdfs 已在第 11 批真连 Hadoop 3.3.6 伪分布式并过完四道门，"
+        "见 tests/acceptance/datasource/batch11/。本批只验 ftp，不重复验。")
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print(f"\n{PROTOCOL} 接入/建模/分析/护栏检查通过；知识候选落库仍未覆盖；hdfs 真连见第 11 批")
