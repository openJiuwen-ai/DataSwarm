+
+def test_duckdb_csv_directory_new_file_after_prepare_is_visible(tmp_path, monkeypatch):
+    """_prepare 后新增文件，重新查询拿到新视图——视图集每次调用重建。"""
+    pytest.importorskip("duckdb", reason="DuckDB is not installed")
+    source = _csv_dir_source(tmp_path, monkeypatch, {"orders.csv": "id\n1\n"})
+    connector = DuckDBConnector(source)
+    assert connector.query('SELECT COUNT(*) FROM "orders"', limit=1)["rows"] == [[1]]
+
+    (tmp_path / "csvdir" / "items.csv").write_text("id\n5\n", encoding="utf-8")
+    assert connector.query('SELECT COUNT(*) FROM "items"', limit=1)["rows"] == [[1]]
