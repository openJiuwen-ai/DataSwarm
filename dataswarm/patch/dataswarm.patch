@@ -0,0 +1,137 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { ArtifactMap, Finding, Severity } from '../types/inspection';
+
+/**
+ * Artifact key 到治理分类的唯一映射（异常清单的报错本体范围）。
+ *
+ * 聚合时按此数组顺序读取明确列出的 artifact；不会依赖对象插入顺序，
+ * 也不会把未知 key 猜测成某个治理分类。
+ *
+ * root-cause（根因追溯）不在此列：它是数据质量异常沿血缘的分析结论，
+ * 不是巡检直接发现的报错——只在血缘图追溯链高亮与「根因追溯」面板展示，
+ * 不混入异常清单的「血缘」报错（其 strategy=investigate 也不可执行修复）。
+ */
+export const FINDING_ARTIFACT_DIMENSIONS = [
+  { artifactKey: 'schema', dimension: 'schema' },
+  { artifactKey: 'data', dimension: 'quality' },
+  { artifactKey: 'zscore', dimension: 'quality' },
+  { artifactKey: 'lineage', dimension: 'lineage' },
+  { artifactKey: 'column-lineage', dimension: 'lineage' },
+  { artifactKey: 'metric', dimension: 'metric' },
+  { artifactKey: 'task', dimension: 'task' },
+] as const;
+
+export type FindingArtifactKey = (typeof FINDING_ARTIFACT_DIMENSIONS)[number]['artifactKey'];
+export type FindingDimension = (typeof FINDING_ARTIFACT_DIMENSIONS)[number]['dimension'];
+export type FindingSelectionIssue = 'missing_uid' | 'duplicate_uid';
+
+export interface FindingRow {
+  artifactKey: FindingArtifactKey;
+  dimension: FindingDimension;
+  /** finding 在所属 artifact.findings 中的原始位置，仅用于展示定位，不是选择身份。 */
+  sourceIndex: number;
+  finding: Finding;
+  /** 唯一允许用于勾选和修复 API 的身份；旧 id/source_finding_id 不参与兜底。 */
+  uid: string | null;
+  selectable: boolean;
+  duplicateUid: boolean;
+  selectionIssue: FindingSelectionIssue | null;
+}
+
+export interface FindingCollection {
+  rows: FindingRow[];
+  /** 按首次出现顺序列出违反 run 内唯一约束的 finding_uid。 */
+  duplicateUids: string[];
+}
+
+export interface FindingFilters {
+  /** 同一筛选项内为 OR，不同筛选项之间为 AND；空数组等同未限制。 */
+  dimensions?: readonly FindingDimension[];
+  severities?: readonly Severity[];
+  categories?: readonly string[];
+  /** 不区分英文大小写；空白分隔的多个关键词必须全部命中。 */
+  query?: string;
+}
+
+function readUid(finding: Finding): string | null {
+  const uid = finding.finding_uid;
+  return typeof uid === 'string' && uid.trim().length > 0 ? uid : null;
+}
+
+function searchText(row: FindingRow): string {
+  const { finding } = row;
+  return [
+    row.artifactKey,
+    row.dimension,
+    row.uid,
+    finding.id,
+    finding.source_finding_id,
+    finding.finding_fingerprint,
+    finding.severity,
+    finding.category,
+    finding.summary,
+    finding.detail,
+    JSON.stringify(finding.object ?? {}),
+    JSON.stringify(finding.evidence ?? {}),
+    JSON.stringify(finding.fix_hint ?? {}),
+  ]
+    .filter((value): value is string => typeof value === 'string')
+    .join('\n')
+    .toLowerCase();
+}
+
+/**
+ * 将所有已加载 artifact 的 finding 汇总成异常清单模型。
+ *
+ * finding_uid 缺失或重复时都不允许选择：前者没有合法修复身份，后者无法
+ * 用一个 UID 无歧义地指向某一行。两类记录仍完整保留，供页面展示数据问题。
+ */
+export function collectFindingRows(artifacts: ArtifactMap): FindingCollection {
+  const baseRows: Omit<FindingRow, 'selectable' | 'duplicateUid' | 'selectionIssue'>[] = [];
+  const uidCounts = new Map<string, number>();
+
+  for (const { artifactKey, dimension } of FINDING_ARTIFACT_DIMENSIONS) {
+    const artifact = artifacts[artifactKey];
+    if (!artifact) continue;
+
+    artifact.findings.forEach((finding, sourceIndex) => {
+      const uid = readUid(finding);
+      baseRows.push({ artifactKey, dimension, sourceIndex, finding, uid });
+      if (uid !== null) uidCounts.set(uid, (uidCounts.get(uid) ?? 0) + 1);
+    });
+  }
+
+  const duplicateUids = [...uidCounts.entries()].filter(([, count]) => count > 1).map(([uid]) => uid);
+  const duplicateUidSet = new Set(duplicateUids);
+
+  const rows: FindingRow[] = baseRows.map(row => {
+    const duplicateUid = row.uid !== null && duplicateUidSet.has(row.uid);
+    const selectionIssue: FindingSelectionIssue | null = row.uid === null ? 'missing_uid' : duplicateUid ? 'duplicate_uid' : null;
+    return {
+      ...row,
+      duplicateUid,
+      selectionIssue,
+      selectable: selectionIssue === null,
+    };
+  });
+
+  return { rows, duplicateUids };
+}
+
+/** 对聚合后的行执行确定性的精确筛选，不改变原始顺序。 */
+export function filterFindingRows(rows: readonly FindingRow[], filters: FindingFilters): FindingRow[] {
+  const dimensions = filters.dimensions?.length ? new Set(filters.dimensions) : null;
+  const severities = filters.severities?.length ? new Set(filters.severities) : null;
+  const categories = filters.categories?.length ? new Set(filters.categories) : null;
+  const queryTerms = filters.query?.trim().toLowerCase().split(/\s+/).filter(Boolean) ?? [];
+
+  return rows.filter(row => {
+    if (dimensions && !dimensions.has(row.dimension)) return false;
+    if (severities && !severities.has(row.finding.severity)) return false;
+    if (categories && !categories.has(row.finding.category)) return false;
+    if (queryTerms.length === 0) return true;
+
+    const haystack = searchText(row);
+    return queryTerms.every(term => haystack.includes(term));
+  });
+}
