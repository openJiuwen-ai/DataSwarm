diff --git a/tests/unit/channel/_dataagent_test_helpers.py b/tests/unit/channel/_dataagent_test_helpers.py
new file mode 100644
index 000000000..079bdc989
--- /dev/null
+++ b/tests/unit/channel/_dataagent_test_helpers.py
@@ -0,0 +1,58 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent 模块分层单测公共 helper。"""
+from __future__ import annotations
+
+import json
+from urllib.parse import urlparse
+
+
+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    """模拟 BaseHTTPRequestHandler 子类，仅保留 controller 用到的方法。"""
+
+    def __init__(self, path: str, body: bytes | None = b"",
+                 response: FakeResponse | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        self.rfile = _FakeRfile(body or b"")
+        self.headers = {"Content-Length": str(len(body or b""))}
+        self._resp = response or FakeResponse()
+
+    def _write_json(self, status, payload):
+        self._resp.capture(status, payload)
+
+    def _query_arg(self, parsed, name):
+        for pair in self.parsed.query.split("&"):
+            if "=" in pair:
+                k, v = pair.split("=", 1)
+                if k == name:
+                    return v
+        return None
+
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, n):
+        return self._data[:n]
+
+
+def make_handler(path: str, body: dict | None = None) -> tuple[FakeHandler, FakeResponse]:
+    """构造 (FakeHandler, FakeResponse) 对。body 为 dict 时自动 JSON 编码。"""
+    if body is None:
+        raw = b""
+    else:
+        raw = json.dumps(body).encode()
+    resp = FakeResponse()
+    h = FakeHandler(path, body=raw, response=resp)
+    return h, resp
