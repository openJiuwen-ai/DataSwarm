@@ -0,0 +1,240 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""HTTP API for the analysis data-plane（/api/dataagent/analysis/*）。
+
+仿 semantic/api.py：is_route 前缀判定 + handle_get/handle_post 分发；
+workspace 上下文由 dataagent/api.py 的 _with_workspace 统一安装。
+"""
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+_PREFIX = "/api/dataagent/analysis"
+
+
+def is_route(path: str) -> bool:
+    """Return whether a path belongs to analysis APIs."""
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    return path[len(_PREFIX):].rstrip("/").split("/")
+
+
+def handle_get(handler, parsed) -> None:
+    """GET 分发：``sessions``（列表）与 ``sessions/{id}``（manifest 详情）。"""
+    parts = _split(parsed.path)
+    try:
+        if len(parts) == 2 and parts[1] == "sessions":
+            handler._write_json(200, list_sessions())
+            return
+        if len(parts) == 3 and parts[1] == "sessions":
+            from urllib.parse import unquote
+
+            manifest = get_session(unquote(parts[2]))
+            handler._write_json(200 if manifest else 404,
+                                manifest or {"error": "not_found"})
+            return
+    except (TypeError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:  # noqa: BLE001
+        logger.exception("analysis GET %s 处理失败", parsed.path)
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+# ==========================================================================
+# 分析追踪（流程评审）：只读扫 artifact/analysis/*/manifest.json
+# ==========================================================================
+
+def _artifact_root() -> Path:
+    import os
+
+    # 显式 ARTIFACT_DIR > 运行时根（DATA_DIR，whl 独立运行时即 ~/.dataswarm）
+    # > 基座默认 ~/.jiuwenswarm。whl 实测（dev42，2026-11-02）：旧实现只认
+    # JIUWENSWARM_ARTIFACT_DIR（无人注入）恒回落旧目录，whl 形态 artifact 实际
+    # 落在 ~/.dataswarm/artifact/analysis，分析追踪页 sessions API 恒空——
+    # UI 追踪时间线全程不可见。与 web 进程 _get_user_workspace_dir 同款推导
+    # （app_web 属同一进程，但此处就地展开避免反向 import）。
+    explicit = os.environ.get("JIUWENSWARM_ARTIFACT_DIR", "").strip()
+    if explicit:
+        return Path(explicit).expanduser().resolve()
+    data_dir = os.environ.get("JIUWENSWARM_DATA_DIR", "").strip()
+    root = Path(data_dir).expanduser() if data_dir else (
+        Path(os.environ.get("JIUWENSWARM_HOME") or Path.home()) / ".jiuwenswarm")
+    return (root / "artifact" / "analysis").resolve()
+
+
+def list_sessions() -> dict:
+    """分析会话列表（按创建时间倒序，供追踪页评审入口）。
+
+    Returns:
+        ``{"sessions": [{analysis_id, question, created_at, components: 数,
+        done/failed 数, grounding 汇总, budget, warnings 数}]}``。
+    """
+    import json
+    from .trace_summary import summarize_manifest
+
+    root = _artifact_root()
+    sessions: list[dict] = []
+    if root.exists():
+        for manifest_path in root.glob("*/manifest.json"):
+            try:
+                manifest = json.loads(manifest_path.read_text("utf-8"))
+            except (OSError, ValueError):
+                continue
+            components = manifest.get("components") or {}
+            done = sum(1 for c in components.values() if c.get("status") == "done")
+            failed = sum(1 for c in components.values()
+                         if c.get("status") in ("failed", "infeasible", "clarify"))
+            groundings = [
+                attempt.get("grounding_level")
+                for c in components.values()
+                for attempt in c.get("attempts") or ()
+                if attempt.get("kind") in {"execute", "compile"}
+            ]
+            sessions.append({
+                "analysis_id": manifest.get("analysis_id") or manifest_path.parent.name,
+                "question": manifest.get("question") or "",
+                "created_at": manifest.get("created_at") or "",
+                "component_count": len(components),
+                "done_count": done,
+                "failed_count": failed,
+                "uncovered": len(manifest.get("uncovered") or []),
+                "grounding_levels": sorted({g for g in groundings if g}),
+                "budget": manifest.get("budget") or {},
+                "has_plan": bool(manifest.get("plan")),
+                "analysis_summary": summarize_manifest(manifest),
+            })
+    sessions.sort(key=lambda s: s.get("created_at") or "", reverse=True)
+    return {"sessions": sessions}
+
+
+def get_session(analysis_id: str) -> dict | None:
+    """单个分析会话的完整 manifest（追踪页详情视图）。"""
+    import json
+    import re
+
+    if not re.fullmatch(r"[A-Za-z0-9_\-]+", analysis_id):
+        return None
+    manifest_path = _artifact_root() / analysis_id / "manifest.json"
+    if not manifest_path.exists():
+        return None
+    try:
+        manifest = json.loads(manifest_path.read_text("utf-8"))
+    except (OSError, ValueError):
+        return None
+    manifest.setdefault("analysis_id", analysis_id)
+    from .trace_summary import summarize_manifest
+
+    manifest["analysis_summary"] = summarize_manifest(manifest)
+    return manifest
+
+
+def _table_row_baselines() -> dict[str, int] | None:
+    """published 快照的表行数基线（join_amplification 检查用；快照缺席返回 None）。
+
+    只取行数已采集的表（``row_count`` 可空——未采集的表不进基线，检查侧
+    按 unknown 降级不猜）。
+    """
+    from ..metrics import semantic_link
+
+    warnings: list[str] = []
+    try:
+        _refs, snapshots = semantic_link.current_snapshots(warnings)
+    except Exception:  # noqa: BLE001 —— 快照缺席/库异常：基线不可用，检查降级 unknown
+        return None
+    baselines: dict[str, int] = {}
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            if isinstance(table.row_count, int) and table.row_count > 0:
+                baselines[table.name] = table.row_count
+    return baselines or None
+
+
+def handle_post(handler, parsed) -> None:
+    """POST 分发：context/plan/compile/check/execute/probe/check-join/result-check。"""
+    parts = _split(parsed.path)
+    body = _read_body(handler)
+    if body is None:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    from . import service
+    try:
+        if len(parts) == 2 and parts[1] == "context":
+            result = service.build_context(
+                str(body.get("question") or ""),
+                mode=str(body.get("mode") or "initial"),
+                source_ids=[str(s) for s in body.get("source_ids") or ()] or None,
+            )
+            handler._write_json(200, result)
+            return
+        if len(parts) == 2 and parts[1] == "plan":
+            plan_payload = body.get("plan")
+            if not isinstance(plan_payload, dict):
+                handler._write_json(400, {"error": "bad_request", "detail": "plan 必须是对象"})
+                return
+            result = service.validate_plan(
+                plan_payload,
+                candidate_keys=[str(k) for k in body.get("candidates") or ()],
+            )
+            handler._write_json(200, result)
+            return
+        if len(parts) == 2 and parts[1] == "compile":
+            from . import compile_provider
+            handler._write_json(200, compile_provider.compile_request(body))
+            return
+        if len(parts) == 2 and parts[1] == "check":
+            from . import checks
+            handler._write_json(200, checks.check_request(body))
+            return
+        if len(parts) == 2 and parts[1] == "execute":
+            from . import execute
+            handler._write_json(200, execute.execute_request(body))
+            return
+        if len(parts) == 2 and parts[1] == "probe":
+            from . import explore
+            handler._write_json(200, explore.probe_request(body))
+            return
+        if len(parts) == 2 and parts[1] == "check-join":
+            from . import explore
+            handler._write_json(200, explore.check_join_request(body))
+            return
+        if len(parts) == 2 and parts[1] == "result-check":
+            from . import result_check
+            handler._write_json(200, result_check.run_result_checks(
+                body, table_baselines=_table_row_baselines()))
+            return
+    except (TypeError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except PermissionError as exc:
+        # probe/check-join 的敏感列拒绝（explore docstring 承诺 403）：
+        # 落 500 会被 LLM 当可重试的内部错误浪费预算
+        handler._write_json(403, {"error": "forbidden", "detail": str(exc)})
+        return
+    except Exception as exc:  # noqa: BLE001 —— 统一 500 且落日志（dwcli 链路契约）
+        logger.exception("analysis POST %s 处理失败", parsed.path)
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def _read_body(handler) -> dict | None:
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except (TypeError, ValueError):
+        return None
+    if not length:
+        return {}
+    import json
+
+    try:
+        body = json.loads(handler.rfile.read(length))
+    except (json.JSONDecodeError, TypeError):
+        return None
+    return body if isinstance(body, dict) else None
