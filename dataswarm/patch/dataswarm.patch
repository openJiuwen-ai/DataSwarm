+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw-analysis skill llm_trace 采集单测：门控、步骤标注、对齐契约与截断。
+
+不打 web 服务——``_analysis`` 打桩；manifest 落临时目录（monkeypatch 根路径）。
+对应设计 ``docs/data-analysis-flow-llm-trace-design.md``：
+- llm_role 三档（deterministic/decision/generation）与逐命令映射
+- 对齐契约：llm_trace[trace] ↔ sufficiency_trace、llm_trace[execute] ↔ attempts[kind=execute]
+  按下标逐条对齐（追踪页事件级链接的依赖）
+- budget.llm_calls 恒不写入（平台 API 调用数脚本侧数不到，不伪造）
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+_SKILL_SCRIPT = (Path(__file__).resolve().parents[3]
+                 / "jiuwenswarm" / "resources" / "agent" / "workspace" / "skills"
+                 / "dw-analysis" / "scripts" / "analysis_flow.py")
+
+
+def _load_module():
+    sys.path.insert(0, str(_SKILL_SCRIPT.parent))
+    import flow.commands as mod
+    return mod
+
+
+def _dwcli_mod():
+    import flow.dwcli_client as dc
+    return dc
+
+
+def _observability():
+    import flow.observability as ob
+    return ob
+
+
+def _flow_manifest():
+    """flow.manifest 模块对象——_dir/_manifest_path 的家（Phase 2a 拆层后
+    _load/_save 内部经 manifest 模块全局找路径，patch 打这里）。"""
+    import flow.manifest as fm
+    return fm
+
+
+@pytest.fixture(scope="module")
+def af():
+    return _load_module()
+
+
+@pytest.fixture()
+def trace_on(af, monkeypatch):
+    """开关统一打桩——不受开发机 ANALYSIS_LLM_TRACE 环境变量污染。"""
+    monkeypatch.setattr(_observability(), "LLM_TRACE", True)
+
+
+@pytest.fixture()
+def workspace(af, monkeypatch, tmp_path):
+    """manifest 落临时目录。"""
+    fm = _flow_manifest()
+    monkeypatch.setattr(fm, "_dir", lambda analysis_id: tmp_path / analysis_id)
+    monkeypatch.setattr(fm, "_manifest_path",
+                        lambda analysis_id: tmp_path / analysis_id / "manifest.json")
+    (tmp_path / "a1").mkdir()
+    manifest = {
+        "analysis_id": "a1", "question": "上个月 GMV 多少", "created_at": "2026-10-20T10:00:00",
+        "semantic_versions": {}, "context": None, "plan": None, "components": {},
+        "budget": {"sql_count": 0, "explore_count": 0, "llm_calls": 0, "tool_calls": 0},
