+
+    def create_instance(self, ref_type, ref_id, trigger_type="debug", status="queued"):
+        inst = {"instance_id": "i1", "ref_type": ref_type, "ref_id": ref_id,
+                "trigger_type": trigger_type, "status": status}
+        self.instances["i1"] = inst
+        return inst
+
+    def get_instance(self, iid):
+        return self.instances.get(iid)
+
+    def update_instance(self, iid, **kw):
+        self.update_instance_calls.append((iid, kw))
+        if iid in self.instances:
+            self.instances[iid].update(kw)
+            return self.instances[iid]
+        return None
+
+    def list_instances(self, **kw):
+        return list(self.instances.values())
+
+    def count_instances(self, **kw):
+        return len(self.instances)
+
+    def count_instances_by_ref(self, ref_type, ref_ids=None):
+        wanted = set(ref_ids) if ref_ids is not None else None
+        return dict(Counter(i["ref_id"] for i in self.instances.values()
+                            if i["ref_type"] == ref_type and (wanted is None or i["ref_id"] in wanted)))
+
+    def list_task_runs(self, iid):
+        return []
+
+    def get_task_run(self, rid):
+        return None
+
