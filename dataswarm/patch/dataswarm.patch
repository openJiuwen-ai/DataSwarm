+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 看板详情页：网格布局展示卡片 + 筛选栏。 */
+
+import { useEffect, useState } from 'react';
+import { useDashboardStore } from '../store/dashboardStore';
+import { DashboardCard } from './DashboardCard';
+import { DashboardCardFull } from './DashboardCardFull';
+import { DashboardFilterBar } from './DashboardFilterBar';
+import { CardAddModal } from './CardAddModal';
+import { Button, RefreshButton } from '../../_shared/ui';
+import { ArrowLeft, Plus, Trash2 } from 'lucide-react';
+import type { RenderedCard } from '../types/dashboard';
+
+export function DashboardViewPage() {
+  const store = useDashboardStore();
+  const [rendered, setRendered] = useState<RenderedCard[]>([]);
+  const [selectedCard, setSelectedCard] = useState<RenderedCard | null>(null);
+  const [showAddCard, setShowAddCard] = useState(false);
+
+  const dashboard = store.currentDashboard;
+
+  useEffect(() => {
+    if (store.selectedDashboardId) {
+      void store.renderDashboard(store.selectedDashboardId, false, store.dashboardFilters).then((r) => {
+        if (r) setRendered(r.cards);
+      });
+    }
+  }, [store.selectedDashboardId, store.currentDashboard?.cards?.length, store.dashboardFilters]);
+
+  if (!dashboard) return null;
+
+  const handleRefresh = async () => {
+    if (store.selectedDashboardId) {
+      const r = await store.renderDashboard(store.selectedDashboardId, true, store.dashboardFilters);
+      if (r) setRendered(r.cards);
+    }
+  };
+
+  return (
+    <div>
+      {/* 顶栏 */}
+      <div className="mb-4 flex items-center justify-between">
+        <div className="flex items-center gap-3">
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={() => store.selectDashboard('')}>
+            <ArrowLeft size={18} />
+          </button>
+          <div>
+            <h2 className="text-xl font-semibold text-text-strong">{dashboard.name}</h2>
+            {dashboard.description && <p className="text-xs text-text-muted">{dashboard.description}</p>}
+          </div>
+        </div>
+        <div className="flex items-center gap-2">
+          <Button variant="primary" size="xs" onClick={() => setShowAddCard(true)}>
+            <Plus size={12} className="mr-1 inline" /> 添加卡片
+          </Button>
+          <RefreshButton onRefresh={() => void handleRefresh()} />
+          <Button variant="danger" size="xs" onClick={() => void store.deleteDashboard(dashboard.dashboard_id)}>
+            <Trash2 size={12} className="mr-1 inline" /> 删除
+          </Button>
+        </div>
+      </div>
+
+      {/* 筛选栏 */}
+      <DashboardFilterBar
+        dimensions={store.dimensions}
+        filters={store.dashboardFilters}
+        onChange={store.setDashboardFilters}
+      />
+
+      {/* 卡片网格 */}
+      {rendered.length === 0 ? (
+        <div className="flex min-h-48 items-center justify-center text-sm text-text-muted">
+          暂无卡片，点击"添加卡片"开始
+        </div>
+      ) : (
+        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
+          {rendered.map((card) => (
+            <DashboardCard
+              key={card.card_id}
+              card={card}
+              onClick={() => setSelectedCard(card)}
+              onDelete={async () => {
+                await store.deleteCard(dashboard.dashboard_id, card.card_id);
+                setRendered((prev) => prev.filter((c) => c.card_id !== card.card_id));
+              }}
+            />
+          ))}
+        </div>
+      )}
+
+      {/* 全尺寸图表弹窗 */}
+      {selectedCard && (
+        <DashboardCardFull card={selectedCard} onClose={() => setSelectedCard(null)} />
+      )}
+
+      {/* 添加卡片弹窗 */}
+      {showAddCard && dashboard && (
+        <CardAddModal
+          dashboardId={dashboard.dashboard_id}
+          onClose={() => setShowAddCard(false)}
+          onCreated={() => {
+            setShowAddCard(false);
+            void store.selectDashboard(dashboard.dashboard_id).then(() => {
+              void store.renderDashboard(dashboard.dashboard_id, true, store.dashboardFilters).then((r) => {
+                if (r) setRendered(r.cards);
+              });
+            });
+          }}
+        />
+      )}
+    </div>
+  );
+}
