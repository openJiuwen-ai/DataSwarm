+def test_registry_catalog_has_categories_and_planned_types():
+    catalog = {t["type_id"]: t for t in _registry.list_source_types()}
+    assert catalog["doris"]["category"] == "message"
+    assert catalog["csv"]["category"] == "file"
+    # PostgreSQL 有真实实例证据；Hologres 仅验证 PG 兼容端，未完成原厂验收。
+    for type_id in ("postgresql", "hologres"):
+        assert catalog[type_id]["available"] is True
+        assert catalog[type_id]["engine"] == "sqlalchemy"
+        assert catalog[type_id]["unavailable_reason"] == ""
+    # 文件和对象存储映射到 DuckDB；S3 / OSS 的兼容端验证边界见验收 README。
+    for type_id in ("parquet", "json", "s3", "oss"):
+        assert catalog[type_id]["available"] is True
+        assert catalog[type_id]["engine"] == "duckdb"
+        assert catalog[type_id]["unavailable_reason"] == ""
+    # FTP / SFTP 通过 staged 暂存后交由 DuckDB 查询。
+    assert catalog["ftp"]["available"] is True
+    assert catalog["ftp"]["engine"] == "staged"
+    # HBase 使用 sampled 引擎，standalone / Thrift 实例记录见验收 README。
+    assert catalog["hbase"]["available"] is True
+    assert catalog["hbase"]["engine"] == "sampled"
+    assert catalog["hbase"]["unavailable_reason"] == ""
+    # HDFS 经 WebHDFS 暂存，与 FTP 共用 staged 引擎。
+    assert catalog["hdfs"]["available"] is True
+    assert catalog["hdfs"]["engine"] == "staged"
+    assert catalog["hdfs"]["unavailable_reason"] == ""
+    # SQL Server 的 LocalDB 实例范围见验收 README。
+    assert catalog["sqlserver"]["available"] is True
+    assert catalog["sqlserver"]["engine"] == "sqlalchemy"
+    assert catalog["sqlserver"]["unavailable_reason"] == ""
+    for type_id, entry in catalog.items():
+        if _registry.get_source_type(type_id).released:
+            continue
+        assert entry["available"] is False
+        # 发布状态与驱动缺失分别报告。
+        assert entry["unavailable_reason"] == "not_released"
+    # 已实现适配器须声明连接字段；实现状态与发布状态分别检查。
+    for type_id in ("sqlserver",):
+        assert catalog[type_id]["fields"], type_id
+    # 纯占位类型没有可填写的连接字段。
+    for type_id in ("kafka", "rest_api", "erp"):
+        assert catalog[type_id]["fields"] == [], type_id
+    # MongoDB 经采样建模后物化到 DuckDB。
+    assert catalog["mongodb"]["available"] is True
+    assert catalog["mongodb"]["engine"] == "sampled"
+    for type_id in ("json", "parquet", "ftp", "oss", "s3", "hdfs"):
+        assert catalog[type_id]["category"] == "file"
+    for type_id in ("redis", "hbase", "mongodb"):
+        assert catalog[type_id]["category"] == "nosql"
+    # Redis 使用 sampled 引擎。
+    assert catalog["redis"]["available"] is True
+    assert catalog["redis"]["engine"] == "sampled"
+    for type_id in ("rest_api", "webhook", "erp", "crm", "oa"):
+        assert catalog[type_id]["category"] == "api"
+    for type_id in ("kafka", "rabbitmq", "rocketmq", "hive", "spark"):
+        assert catalog[type_id]["category"] == "message"
+
