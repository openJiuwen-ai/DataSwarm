-                )
-                return
-
-            preset = get_preset(vendor_key, plan)
-            if preset is None:
-                await channel.send_response(
-                    ws, req_id, ok=False,
-                    error=f"unknown vendor/plan: {vendor_key}/{plan_raw}",
-                    code="BAD_REQUEST",
