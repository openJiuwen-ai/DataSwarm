index 000000000..44a75b8cc
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/semantic_link.py
@@ -0,0 +1,1021 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/semantic_link.py —— 指标模块读侧的语义层集成点（深集成）。
+
+原 pyoxigraph 验证版（``schema_graph.py`` 直连活库探查 + schema 命名图召回）
+退役后，本模块是指标侧消费语义层（``dataagent/semantic/``）的**唯一读侧入口**：
+
+- source 解析：``binding.datasource_ref`` → ``source_id``（dw_datasources）
+- schema 供给：``dw_semantic_snapshots`` 最新 published 快照（元数据库），
+  **绝不直连活库**——严格单一通道，源未采集即降级，不保留直查兜底
+- 召回：快照内存词法匹配（刻度对齐旧 schema 图 SPARQL：label 0.80 /
+  comment 0.40、精确命中 +0.15）+ 语义层 FAISS 召回（``vector_store.recall``）
+  按 node_id 合并取 max
+- 传导 / 上下文 / 子图：全部从 ``dw_metric_*`` 表 + semantic 快照构建，
+  不读任何图存储（Neo4j 是纯写侧投影，查询面真相源 = 元数据库）
+
+写侧（Metric 节点投影进 Neo4j）见 :mod:`.graph_projection`，与本模块无关。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Sequence
+
+from jiuwenswarm.channels.web.orchestration.db import _connect, _fetch_dicts
+
+from . import store
+from .errors import SemanticContextEmpty
+from .model import Release
