+export function AnalysisTraceApp() {
+  const [sessions, setSessions] = useState<AnalysisSessionSummary[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [selected, setSelected] = useState<AnalysisManifest | null>(null);
+  const [detailError, setDetailError] = useState('');
+
+  const load = useCallback(() => {
+    setLoading(true);
+    setError('');
+    analysisTraceApi.listSessions()
+      .then((r) => setSessions(r.sessions ?? []))
+      .catch((e: Error) => setError(e.message || '加载失败'))
+      .finally(() => setLoading(false));
+  }, []);
+
+  useEffect(() => { load(); }, [load]);
+
+  const openSession = useCallback((analysisId: string) => {
+    setDetailError('');
+    setSelected(null);
+    analysisTraceApi.getSession(analysisId)
+      .then(setSelected)
+      .catch((e: Error) => setDetailError(e.message || '加载失败'));
+  }, []);
+
+  const hasDetail = Boolean(selected) || detailError;
+
+  return (
+    <div className="flex h-full w-full bg-bg text-text">
+      <main className="min-w-0 flex-1 overflow-auto">
+        <div className="dw-content">
+          <h1 className="mb-1 text-lg font-medium">分析追踪 · 流程评审</h1>
+          <p className="mb-5 text-xs text-text-muted">
+            数据分析四层链路（dw-analysis）的 manifest 账本只读视图——结果按双路径权威分级标注：编译产物（G1）为权威口径，LLM 生成路径为探索口径
+          </p>
+          {!hasDetail ? (
+            <SessionList
+              sessions={sessions}
+              loading={loading}
+              error={error}
+              onSelect={openSession}
+              onRefresh={load}
+            />
+          ) : selected ? (
+            <SessionDetail manifest={selected} onBack={() => { setSelected(null); load(); }} />
+          ) : (
+            <p className="py-8 text-center text-sm text-red-600">{detailError}</p>
+          )}
+        </div>
+      </main>
+    </div>
+  );
