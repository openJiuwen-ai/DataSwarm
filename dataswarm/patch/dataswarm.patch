+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""连接器对外暴露的稳定错误类型。"""
+
+
+class ConnectorError(Exception):
+    code = "connector_error"
+    retryable = False
+
+
+class ConnectorDependencyError(ConnectorError):
+    code = "connector_dependency_missing"
+
+
+class SourceNotFoundError(ConnectorError):
+    code = "source_not_found"
+
+
+class SourceDisabledError(ConnectorError):
+    code = "source_disabled"
+
+
+class QueryValidationError(ConnectorError):
+    code = "query_validation_failed"
+
+
+class CapabilityUnsupportedError(ConnectorError):
+    """数据源不支持所请求的能力。
+
+    与 ConnectorDependencyError 区分：补装驱动不会改变该数据源的能力。
+    """
+
+    code = "capability_unsupported"
+
+
+class FileAccessError(ConnectorError):
+    code = "file_access_denied"
