+# --------------------------------------------------------------------------
+# LLM 复核留痕两列（llm_verdict/llm_reason）
+# --------------------------------------------------------------------------
+def test_findings_sql_includes_llm_columns(patch_connector, tmp_path):
+    """FINDINGS_SQL 含 llm_verdict/llm_reason/ai_summary（18 列 → 21 列）。"""
