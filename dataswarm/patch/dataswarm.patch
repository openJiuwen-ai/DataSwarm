+def _bound_metrics(monkeypatch, entries, snapshots):
+    """Exercise both production consumers with real bindings and snapshot models."""
+    definitions = {}
+    revisions = {}
+    bindings = {}
+    for key, source_ref, table_ref, physical in entries:
+        revision_id = f"revision-{key}"
+        definitions[key] = MetricDef(key, "ws", key, key, current_revision_id=revision_id)
+        revisions[revision_id] = MetricRevision(
+            revision_id, key, "ws", 1, status="published",
+            time_dimension="logical_amount", allowed_dimensions=("logical_amount",))
+        bindings[revision_id] = [Binding(
+            f"binding-{key}", revision_id, "ws", datasource_ref=source_ref,
+            source_table=table_ref, column_map={"logical_amount": physical})]
+    source_map = {f"ref-{source}": source for source in snapshots}
+    monkeypatch.setattr(core, "resolve_source_map", lambda _ws: source_map)
+    monkeypatch.setattr(graph_projection, "resolve_source_map", lambda _ws: source_map, raising=False)
+    monkeypatch.setattr(store, "get_revision", revisions.get)
+    monkeypatch.setattr(store, "get_def", definitions.get)
+    monkeypatch.setattr(store, "list_bindings", lambda rid: bindings.get(rid, []))
+    monkeypatch.setattr(store, "list_effective_published", lambda _ws: [
+        (definitions[revision.metric_id], revision) for revision in revisions.values()])
+    release = Release("release", "ws", revision_ids=tuple(revisions))
+
+    def propagate(node_id, node_type="col"):
+        hit = semantic_link.SchemaHit(node_id, node_type, "amount", "orders.amount", .8)
+        return semantic_link.propagate_to_metrics("ws", release, snapshots, [hit])
+
+    _projection, edges = graph_projection.build_metric_projection(
+        "ws", release, list(revisions.values()), definitions, bindings, [], {}, snapshots)
+    edge_targets = {(edge.source, edge.type, edge.target) for edge in edges}
+    return propagate, edge_targets
+
+
+def _edge(metric, kind, target):
+    return graph_projection.metric_node_id("ws", metric), kind, target
+
