@@ -0,0 +1,123 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback } from 'react';
+import { useTranslation } from 'react-i18next';
+import SqlIcon from '../../../assets/data-development/sql.svg?react';
+import PythonIcon from '../../../assets/data-development/python.svg?react';
+import { orchestrationApi, OrchestrationApiError } from '../api/orchestrationApi';
+import { useListQuery } from '../hooks/useListQuery';
+import { Button } from './shared/Ui';
+import { RunStatusLabel, useRunTime } from './WorkflowRunUi';
+
+export function RecentWorkflowRuns({
+  onOpen,
+  revision,
+}: {
+  onOpen: (workflowId: string, instanceId: string) => void;
+  revision: number;
+}) {
+  const { t } = useTranslation();
+  const time = useRunTime();
+  const load = useCallback(async () => {
+    const result = await orchestrationApi.listInstances({ ref_type: 'workflow', limit: 4, offset: 0 });
+    if (!result.instances.length) return { items: [], total: 0 };
+    const workflowIds = [...new Set(result.instances.map((instance) => instance.ref_id))];
+    const [workflows, tasks] = await Promise.all([
+      Promise.all(workflowIds.map(async (id) => {
+        try {
+          return await orchestrationApi.getWorkflow(id);
+        } catch (error) {
+          if (error instanceof OrchestrationApiError && error.status === 404) return null;
+          throw error;
+        }
+      })),
+      orchestrationApi.allTasks(),
+    ]);
+    const byId = new Map(workflows.flatMap((workflow) => workflow ? [[workflow.workflow_id, workflow] as const] : []));
+    const taskTypes = new Map(tasks.map((task) => [task.task_id, task.executor_type]));
+    const items = result.instances.map((instance) => {
+      const workflow = byId.get(instance.ref_id);
+      const nodes = workflow?.nodes ?? [];
+      const types = nodes.slice(0, 3).map((node) => {
+        const type = taskTypes.get(node.task_id);
+        if (!type) throw new Error(t('dataAsset.development.missingNodeTask', { id: node.task_id }));
+        return type;
+      });
+      return { instance, workflow, types, remaining: Math.max(0, nodes.length - 3) };
+    });
+    return { items, total: result.total };
+    // revision explicitly reloads the independent recent-runs query.
+  }, [revision, t]);
+  const query = useListQuery(load);
+  if (!query.items.length && !query.error) return null;
+
+  return (
+    <section className="dd-recent" aria-labelledby="dd-recent-title">
+      <h2 id="dd-recent-title">{t('dataAsset.development.recent')}</h2>
+      {query.error && (
+        <div role="alert" className="dd-error">
+          {query.error}
+          <Button onClick={() => void query.reload()}>{t('common.retry')}</Button>
+        </div>
+      )}
+      {query.loading && !query.hasLoaded ? (
+        <div className="dd-loading" role="status">
+          {t('common.loading')}
+        </div>
+      ) : (
+        <div className="dd-recent-grid">
+          {query.items.map(({ instance, workflow, types, remaining }) => (
+            <button
+              type="button"
+              className="dd-run-card"
+              data-status={instance.status}
+              key={instance.instance_id}
+              disabled={!workflow}
+              onClick={() => onOpen(instance.ref_id, instance.instance_id)}
+            >
+              {workflow && <span
+                className="dd-run-card-art"
+                aria-label={t('dataAsset.development.nodeCount', { count: workflow.nodes?.length ?? 0 })}
+              >
+                <span className="dd-executor-stack">
+                  {types.map((type, index) => (
+                    <span
+                      className="dd-executor-circle"
+                      data-type={type}
+                      key={index}
+                      style={{ zIndex: types.length - index }}
+                      title={type === 'sql' ? 'SQL' : 'Python'}
+                    >
+                      {type === 'sql' ? <SqlIcon aria-label="SQL" /> : <PythonIcon aria-label="Python" />}
+                    </span>
+                  ))}
+                  {remaining > 0 && <span className="dd-executor-more">+{remaining}</span>}
+                </span>
+              </span>}
+              {!workflow && (
+                <span className="dd-run-card-art dd-run-card-unavailable">
+                  {t('dataAsset.apiErrors.not_found')}
+                </span>
+              )}
+              <span className="dd-run-card-content">
+                <span
+                  className="dd-run-card-title"
+                  title={`${instance.ref_name || workflow?.name || instance.ref_id} ${instance.instance_id}`}
+                >
+                  <strong>{instance.ref_name || workflow?.name || instance.ref_id}</strong>
+                  <code>{instance.instance_id}</code>
+                </span>
+                <span className="dd-run-card-meta">
+                  <RunStatusLabel status={instance.status} />
+                  <span aria-hidden="true">·</span>
+                  <time dateTime={instance.created_at} title={time.date(instance.created_at)}>
+                    {time.relative(instance.created_at)}
+                  </time>
+                </span>
+              </span>
+            </button>
+          ))}
+        </div>
+      )}
+    </section>
+  );
+}
