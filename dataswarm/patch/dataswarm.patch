+    "Q3 时间粒度月度": (
+        "SELECT strftime(order_date, '%Y-%m') AS m, ROUND(SUM(order_amt),2) AS v "
+        "FROM {t} WHERE order_date >= DATE '2026-01-01' "
+        "GROUP BY m ORDER BY m LIMIT 3"
+    ),
+    "Q4 过滤+聚合": (
