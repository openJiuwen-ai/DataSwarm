+def test_ratio_fail_hint_mentions_derived(semantic_env):
+    """ratio fail 的 detail 提示 derived_metrics 槽位（报告层派生不进口径检查）。"""
+    # 语义上下文带分子分母（ratio）
+    from types import SimpleNamespace as NS
+    from jiuwenswarm.channels.web.dataagent.metrics import semantic_link
+
+    original = semantic_link.build_semantic_context
+
+    def _ratio_ctx(ws, key, release):
+        ctx = original(ws, key, release)
+        ctx.numerator = "SUM(orders.amount_cny)"
+        ctx.denominator = "COUNT(orders.order_id)"
+        return ctx
+    semantic_link.build_semantic_context = _ratio_ctx
+    try:
+        sql = ("SELECT orders.region, COUNT(orders.order_id) FROM orders "
+               "WHERE orders.pay_status = 'paid' GROUP BY orders.region")
+        result = checks.check_request(_body(sql))
+        detail = _check_of(result, "ratio_components")["detail"]
+        assert "derived_metrics" in detail
+    finally:
+        semantic_link.build_semantic_context = original
+
+
+def test_empty_sql_rejected(semantic_env):
+    with pytest.raises(ValueError, match="sql"):
+        checks.check_request({"sql": "  "})
