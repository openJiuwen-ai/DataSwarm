+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react';
+import ReinspectIcon from '../../assets/governance/reinspect.svg?react';
+import DataQualityIcon from '../../assets/governance/data-quality.svg?react';
+import { useTranslation } from 'react-i18next';
+import { useGovernanceRoute } from '../../multi-session/routing/useGovernanceRoute';
+import type { GovernancePage } from '../../multi-session/routing/route';
+import { useGovernanceStore } from './store/governanceStore';
+import { AnomalyListPage } from './components/AnomalyListPage';
+import { GovernanceChatPanel } from './components/GovernanceChatPanel';
+import { GovernanceDashboardPage } from './components/GovernanceDashboardPage';
+import { formatInspectionDateTime, formatRunStamp } from './formatInspectionDateTime';
+import type { Dimension, InspectionManifest } from './types/inspection';
+import './governance.css';
+
+// metric/task 阶段暂缓启用（执行跳过），界面同步隐藏；恢复时补回这两个维度。
+const ALL_DIMENSIONS: Dimension[] = ['schema', 'data', 'zscore', 'lineage', 'column-lineage', 'root-cause'];
+
+const MAIN_TABS: GovernancePage[] = ['overview', 'anomalies'];
+// ≤1599px（1440/1536 笔记本）助手走浮层，主区拿回宽度；1600+ 才并排
+const ASSISTANT_OVERLAY_MEDIA = '(max-width: 1599px)';
+
+function useAssistantOverlayMode(): boolean {
+  const [isOverlay, setIsOverlay] = useState(() => (typeof window === 'undefined' ? false : window.matchMedia(ASSISTANT_OVERLAY_MEDIA).matches));
+
+  useEffect(() => {
+    const media = window.matchMedia(ASSISTANT_OVERLAY_MEDIA);
+    const handleChange = () => setIsOverlay(media.matches);
+    handleChange();
+    media.addEventListener('change', handleChange);
+    return () => media.removeEventListener('change', handleChange);
+  }, []);
+
+  return isOverlay;
+}
+
+function RunMenu({ runs, selectedId, onSelect }: { runs: InspectionManifest[]; selectedId: string; onSelect: (runId: string) => void }) {
+  const { t } = useTranslation();
+
+  return (
+    <div className="gov-run-menu">
+      <div className="gov-run-menu-label">
+        <span>{t('governance.runs.title')}</span>
+      </div>
+      <div className="gov-run-list" role="listbox" aria-label={t('governance.runs.select')}>
+        {runs.map(run => {
+          const stamp = formatRunStamp(run.started_at);
+          const hasStamp = Boolean(stamp.time);
+          return (
+            <button
+              key={run.run_id}
+              type="button"
+              role="option"
+              aria-selected={run.run_id === selectedId}
+              className="gov-run-item"
+              title={run.run_id}
+              onClick={() => onSelect(run.run_id)}
+            >
+              {hasStamp ? (
+                <>
+                  <span className="gov-run-item-top">
+                    <i className="gov-run-dot" data-status={run.status} aria-hidden="true" />
+                    <span className="gov-run-day">{t(`governance.runs.${stamp.dayKey}`, { defaultValue: stamp.date })}</span>
+                    {stamp.date && <span className="gov-run-day">{stamp.date}</span>}
+                    <span className="gov-run-time">{stamp.time}</span>
+                  </span>
+                  <span className="gov-run-item-sub">
+                    <span className="gov-run-db">{run.db}</span>
+                    <span className="gov-run-status" data-status={run.status}>
+                      {t(`governance.status.${run.status}`, { defaultValue: run.status })}
+                    </span>
+                  </span>
+                </>
+              ) : (
+                <span>{run.run_id}</span>
+              )}
+            </button>
+          );
+        })}
+        {runs.length === 0 && <div className="gov-run-empty">{t('governance.runs.empty')}</div>}
+      </div>
+    </div>
+  );
+}
+
+export function GovernanceApp() {
+  const { route, navigate } = useGovernanceRoute();
+  const { t } = useTranslation();
+  const runs = useGovernanceStore(state => state.runs);
+  const selectedRunId = useGovernanceStore(state => state.selectedRunId);
+  const summary = useGovernanceStore(state => state.summary);
+  const artifacts = useGovernanceStore(state => state.artifacts);
+  const loading = useGovernanceStore(state => state.loading);
+  const error = useGovernanceStore(state => state.error);
+  const panelOpen = useGovernanceStore(state => state.govPanelOpen);
+  const isAssistantOverlay = useAssistantOverlayMode();
+  const mainRef = useRef<HTMLElement>(null);
+  const loadRuns = useGovernanceStore(state => state.loadRuns);
+  const selectRun = useGovernanceStore(state => state.selectRun);
+  const loadDimensions = useGovernanceStore(state => state.loadDimensions);
+  const rerun = useGovernanceStore(state => state.rerun);
+  const clearError = useGovernanceStore(state => state.clearError);
+
+  useEffect(() => {
+    void loadRuns(route.runId);
+  }, [loadRuns, route.runId]);
+
+  useLayoutEffect(() => {
+    const main = mainRef.current;
+    if (!main) return;
+    main.inert = panelOpen && isAssistantOverlay;
+    return () => {
+      main.inert = false;
+    };
+  }, [isAssistantOverlay, panelOpen]);
+
+  // 依赖必须含 summary 对象本身，而不是派生的 run_id 字符串：selectRun 每次都先清
+  // artifacts（{}）再写新 summary，同一批次「切出去再进来」时 run_id 不变、对象已换新，
+  // 只订阅 run_id 会让 effect 不重跑 → 异常清单永久空白（1dc85f52b 同类回归）。
+  // 也不用 summary.run_id !== selectedRunId 提前 return：该守卫一旦不成立就永不加载，
+  // loadDimensions 内部已有 selectedRunId/missing 双重校验，无需在此拦截。
+  useEffect(() => {
+    if (!summary) return;
+    void loadDimensions(ALL_DIMENSIONS);
+  }, [summary, selectedRunId, loadDimensions]);
+
+  const renderPage = useCallback(() => {
+    if (!summary) {
+      return (
+        <div className="gov-page-state">
+          <DataQualityIcon width={22} height={22} aria-hidden="true" />
+          <span>{runs.length ? t('governance.state.loadingSummary') : t('governance.state.noRuns')}</span>
+        </div>
+      );
+    }
+    if (route.page === 'anomalies') {
+      return <AnomalyListPage artifacts={artifacts} runId={selectedRunId} />;
+    }
+    return <GovernanceDashboardPage key={selectedRunId} summary={summary} artifacts={artifacts} />;
+  }, [summary, runs, route.page, artifacts, selectedRunId, t]);
+
+  const selectedRun = runs.find(run => run.run_id === selectedRunId);
+
+  return (
+    <div className="gov-shell" data-agent-open={panelOpen || undefined}>
+      <aside className="gov-side">
+        <div className="gov-brand">
+          <h1>{t('governance.title')}</h1>
+        </div>
+        <RunMenu
+          runs={runs}
+          selectedId={selectedRunId}
+          onSelect={runId => {
+            if (runId !== selectedRunId) void selectRun(runId);
+          }}
+        />
+      </aside>
+
+      <main ref={mainRef} className="gov-main">
+        <div className="gov-main-inner">
+          <header className="gov-head">
+            <div className="gov-head-top">
+              <h2 className="gov-head-title">{t('governance.resultsTitle')}</h2>
+              {/* 重新巡检是后台长链路（Web 端无法看到进度），宣发版隐藏入口；保留 store.rerun 供恢复时用 */}
+              <button type="button" className="gov-head-action" hidden disabled={loading || !selectedRunId} onClick={() => void rerun()}>
+                <ReinspectIcon width={16} height={16} aria-hidden="true" />
+                {t('governance.runs.rerun')}
+              </button>
+            </div>
+            <div className="gov-head-copy">
+              <div className="gov-head-meta">
+                {selectedRun && <span>{t('governance.meta.currentRun', { value: selectedRunId })}</span>}
+                {summary?.meta?.run_at && <span>{t('governance.meta.runAt', { value: formatInspectionDateTime(summary.meta.run_at) })}</span>}
+                {summary?.meta?.db && <span>{t('governance.meta.database', { value: summary.meta.db })}</span>}
+                {selectedRun && (
+                  <span>
+                    {t('governance.meta.status', {
+                      value: t(`governance.status.${selectedRun.status}`, { defaultValue: selectedRun.status }),
+                    })}
+                  </span>
+                )}
+                {loading && <span>{t('governance.state.loading')}</span>}
+              </div>
+            </div>
+          </header>
+
+          <nav className="gov-main-tabs" aria-label={t('governance.tabs.label')}>
+            {MAIN_TABS.map(page => (
+              <button key={page} type="button" aria-current={route.page === page ? 'page' : undefined} onClick={() => navigate(page)}>
+                {t(`governance.tabs.${page}`)}
+              </button>
+            ))}
+          </nav>
+
+          <div className="gov-main-content">
+            {error && (
+              <div className="gov-alert" role="alert">
+                <span>{error}</span>
+                <button type="button" onClick={clearError} aria-label={t('governance.common.close')}>
+                  ×
+                </button>
+              </div>
+            )}
+            {summary?.errors?.length ? (
+              <div className="gov-alert" role="alert">
+                <span>
+                  {t('governance.errors.partial', {
+                    details: summary.errors.join(t('governance.common.errorSeparator')),
+                  })}
+                </span>
+              </div>
+            ) : null}
+
+            {renderPage()}
+          </div>
+        </div>
+      </main>
+
+      <GovernanceChatPanel />
+    </div>
+  );
+}
