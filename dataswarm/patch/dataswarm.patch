@@ -0,0 +1,62 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 业务知识顶层壳：与业务术语同级的独立导航模块。
+ * 子 tab 按知识生命周期分类：文档管理（接入/重跑/删除）/ 知识管理（候选筛选/流转/发布），
+ * URL 尾段 /documents /review 可直达对应子页。 */
+
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { KnowledgeReviewPage } from './KnowledgeReviewPage';
+import '../../_shared/ui/shell.css';
+
+type TabKey = 'documents' | 'review';
+
+function tabFromPath(pathname: string): TabKey {
+  return pathname.endsWith('/review') ? 'review' : 'documents';
+}
+
+export function KnowledgeApp() {
+  const { t } = useTranslation();
+  const [tab, setTab] = useState<TabKey>(() => tabFromPath(window.location.pathname));
+
+  useEffect(() => {
+    const handler = () => setTab(tabFromPath(window.location.pathname));
+    window.addEventListener('jiuwen:routechange', handler);
+    return () => window.removeEventListener('jiuwen:routechange', handler);
+  }, []);
+
+  const pick = (next: TabKey) => {
+    setTab(next);
+    window.history.pushState(null, '', `/dataagent/knowledge/${next}`);
+    window.dispatchEvent(new Event('jiuwen:routechange'));
+  };
+
+  const tabs: { key: TabKey; label: string }[] = [
+    { key: 'documents', label: t('knowledge.nav.documents') },
+    { key: 'review', label: t('knowledge.nav.review') },
+  ];
+
+  return (
+    <div className="flex h-full w-full bg-bg text-text">
+      <main className="min-w-0 flex-1 overflow-auto">
+        <div className="dw-content">
+          <div className="mb-6 flex gap-1 border-b border-border">
+            {tabs.map(({ key, label }) => (
+              <button
+                key={key}
+                onClick={() => pick(key)}
+                className={
+                  tab === key
+                    ? '-mb-px border-b-2 border-text px-3 py-2 text-sm font-medium text-text-strong'
+                    : '-mb-px border-b-2 border-transparent px-3 py-2 text-sm text-text-muted hover:text-text'
+                }
+              >
+                {label}
+              </button>
+            ))}
+          </div>
+          <KnowledgeReviewPage section={tab} />
+        </div>
+      </main>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/KnowledgeAssetFormDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/KnowledgeAssetFormDrawer.tsx
new file mode 100644
index 000000000..f3d0b7165
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/KnowledgeAssetFormDrawer.tsx
@@ -0,0 +1,271 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 知识候选新建/编辑抽屉（TermFormDrawer 同款交互）。
+ * 面向业务评审人：类型用卡片选择 + 逐类「是什么/发布效果/发布前提」说明；
+ * scope 拆成带解释的结构化输入（指标/术语/表列/维度），术语下拉取自术语库，
+ * 高级用户可切换 JSON 直编。 */
+
+import { useEffect, useState } from 'react';
+import { Button, Field, inputClass } from '../../_shared/ui';
+import { glossaryApi } from '../api/glossaryApi';
+import { knowledgeApi, type KnowledgeAsset } from '../api/knowledgeApi';
+import { BookOpen, ChevronDown, Lightbulb, ArrowLeftRight, ShieldCheck, TrendingUp, X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+
+interface TypeSpec {
+  value: string;
+  icon: typeof BookOpen;
+}
+
+/** 文案（label/oneLiner/detail）在 knowledge.form.types.<value>.* 命名空间，渲染期经 t 解析 */
+const TYPE_SPECS: TypeSpec[] = [
+  { value: 'rule', icon: ShieldCheck },
+  { value: 'term', icon: BookOpen },
+  { value: 'metric', icon: TrendingUp },
+  { value: 'mapping', icon: ArrowLeftRight },
+  { value: 'example', icon: Lightbulb },
+];
+
+/** 新建仅限知识实体类：术语/指标在各自管理页维护（术语库 / 指标系统），
+ * 知识库不重复开设创建入口（避免双真相源）；蒸馏出的 term/metric 候选
+ * 仍在此评审并发布对齐，但其 spec 只用于编辑/展示。 */
+const CREATE_TYPES = ['rule', 'mapping', 'example'] as const;
+
+const _SCOPE_TARGET_KEYS = ['metric_keys', 'term_ids', 'entity_ids', 'column_ids', 'table_ids', 'dimensions', 'scenarios'];
+
+function _scopeHasTargets(scope: Record<string, unknown> | undefined): boolean {
+  return _SCOPE_TARGET_KEYS.some((key) => Array.isArray(scope?.[key]) && (scope?.[key] as unknown[]).length > 0);
+}
+
+/** 文案（label/hint/placeholder）在 knowledge.form.scope.<ns>.* 命名空间，渲染期经 t 解析；
+ *  key 为 scope 字段名，ns 为 locale 键尾段（camelCase） */
+const SCOPE_FIELDS: Array<{ key: 'metric_keys' | 'term_ids' | 'physical' | 'dimensions' | 'scenarios'; ns: string }> = [
+  { key: 'metric_keys', ns: 'metricKeys' },
+  { key: 'term_ids', ns: 'termIds' },
+  { key: 'physical', ns: 'physical' },
+  { key: 'dimensions', ns: 'dimensions' },
+  { key: 'scenarios', ns: 'scenarios' },
+];
+
+interface KnowledgeAssetFormDrawerProps {
+  asset: KnowledgeAsset | null;
+  onClose: () => void;
+  onSaved: () => void;
+  /** 工作空间还没有任何指标/术语：规则默认按全空间生效（唯一合理选项）。 */
+  catalogEmpty?: boolean;
+}
+
+function scopeToFields(scope: Record<string, unknown>): Record<string, string> {
+  return {
+    metric_keys: ((scope.metric_keys as string[]) ?? []).join(', '),
+    term_ids: ((scope.term_ids as string[]) ?? []).join(', '),
+    physical: [...((scope.table_ids as string[]) ?? []), ...((scope.column_ids as string[]) ?? [])].join(', '),
+    dimensions: ((scope.dimensions as string[]) ?? []).join(', '),
+    scenarios: ((scope.scenarios as string[]) ?? []).join(', '),
+  };
+}
+
+function fieldsToScope(fields: Record<string, string>, extra: Record<string, unknown>): Record<string, unknown> {
+  const split = (value: string) => value.split(/[,，]/).map((item) => item.trim()).filter(Boolean);
+  const tables: string[] = [];
+  const columns: string[] = [];
+  for (const item of split(fields.physical ?? '')) {
+    (item.split('.').length >= 3 ? columns : tables).push(item);
+  }
+  const scope: Record<string, unknown> = { ...extra };
+  if (split(fields.metric_keys ?? '').length) scope.metric_keys = split(fields.metric_keys);
+  if (split(fields.term_ids ?? '').length) scope.term_ids = split(fields.term_ids);
+  if (tables.length) scope.table_ids = tables;
+  if (columns.length) scope.column_ids = columns;
+  if (split(fields.dimensions ?? '').length) scope.dimensions = split(fields.dimensions);
+  if (split(fields.scenarios ?? '').length) scope.scenarios = split(fields.scenarios);
+  return scope;
+}
+
+export function KnowledgeAssetFormDrawer({ asset, onClose, onSaved, catalogEmpty = false }: KnowledgeAssetFormDrawerProps) {
+  const { t } = useTranslation();
+  const isEdit = !!asset;
+  const [assetType, setAssetType] = useState(asset?.asset_type ?? 'rule');
+  const [title, setTitle] = useState(asset?.title ?? '');
+  const [content, setContent] = useState(asset?.content ?? '');
+  const [fields, setFields] = useState<Record<string, string>>(scopeToFields((asset?.scope as Record<string, unknown>) ?? {}));
+  const [jsonMode, setJsonMode] = useState(false);
+  const [jsonText, setJsonText] = useState(JSON.stringify(asset?.scope ?? {}, null, 2));
+  const [terms, setTerms] = useState<Array<{ term_id: string; name: string }>>([]);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+  const [workspaceWide, setWorkspaceWide] = useState(
+    ((asset?.scope as Record<string, unknown>)?.workspace_wide as boolean) === true
+    || (catalogEmpty && !_scopeHasTargets(asset?.scope as Record<string, unknown> | undefined)));
+
+  useEffect(() => {
+    glossaryApi.list().then((result) => setTerms(result.terms ?? [])).catch(() => setTerms([]));
+  }, []);
+
+  const spec = TYPE_SPECS.find((item) => item.value === assetType) ?? TYPE_SPECS[0];
+
+  const toggleJsonMode = () => {
+    if (!jsonMode) {
+      // 进入 JSON 模式：把当前结构化字段序列化进去
+      const extra = Object.fromEntries(Object.entries((asset?.scope as Record<string, unknown>) ?? {})
+        .filter(([key]) => !['metric_keys', 'term_ids', 'table_ids', 'column_ids', 'dimensions', 'scenarios'].includes(key)));
+      setJsonText(JSON.stringify(fieldsToScope(fields, extra), null, 2));
+    }
+    setJsonMode(!jsonMode);
+  };
+
+  const handleSave = async () => {
+    setError('');
+    if (!title.trim() || !content.trim()) { setError(t('knowledge.form.errors.titleContentRequired')); return; }
+    let scope: Record<string, unknown>;
+    if (jsonMode) {
+      try { scope = JSON.parse(jsonText || '{}'); }
+      catch { setError(t('knowledge.form.errors.scopeInvalidJson')); return; }
+      if (typeof scope !== 'object' || scope === null || Array.isArray(scope)) { setError(t('knowledge.form.errors.scopeNotObject')); return; }
+    } else {
+      const extra = Object.fromEntries(Object.entries((asset?.scope as Record<string, unknown>) ?? {})
+        .filter(([key]) => !['metric_keys', 'term_ids', 'table_ids', 'column_ids', 'dimensions', 'scenarios', 'workspace_wide'].includes(key)));
+      scope = fieldsToScope(fields, extra);
+      if (workspaceWide) scope.workspace_wide = true;
+      // 规则发布门禁：既无显式适用范围也未声明全空间生效 → 提前给出人话提示
+      if (assetType === 'rule' && !workspaceWide
+        && !['metric_keys', 'term_ids', 'table_ids', 'column_ids', 'dimensions', 'scenarios']
+          .some((key) => Array.isArray(scope[key]) && (scope[key] as unknown[]).length)) {
+        setError(t('knowledge.form.errors.ruleNeedsScope'));
+        return;
+      }
+    }
+    setSaving(true);
+    try {
+      if (isEdit && asset) {
+        await knowledgeApi.update(asset.asset_id, { title: title.trim(), content: content.trim(), scope });
+      } else {
+        await knowledgeApi.createAsset({ asset_type: assetType, title: title.trim(), content: content.trim(), scope });
+      }
+      onSaved();
+    } catch (exc) { setError(exc instanceof Error ? exc.message : t('knowledge.form.errors.saveFailed')); }
+    finally { setSaving(false); }
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end bg-black/40" onClick={onClose}>
+      <div className="flex h-full w-full max-w-xl flex-col border-l border-border bg-bg shadow-2xl" onClick={(e) => e.stopPropagation()}>
+        <div className="flex items-center justify-between border-b border-border px-5 py-3">
+          <h3 className="text-base font-semibold text-text-strong">{t(isEdit ? 'knowledge.form.editTitle' : 'knowledge.form.createTitle')}</h3>
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}><X size={18} /></button>
+        </div>
+
+        <div className="flex-1 space-y-5 overflow-y-auto p-5">
+          <Field label={t('knowledge.form.typeLabel')}>
+            {isEdit ? (
+              <p className="rounded border border-border bg-panel/50 px-3 py-2 text-sm text-text">
+                <spec.icon size={14} className="mr-1.5 inline align-[-2px] text-text-muted" />
+                {t(`knowledge.form.types.${spec.value}.label`)} — {t(`knowledge.form.types.${spec.value}.oneLiner`)}
+              </p>
+            ) : (
+              <div className="grid grid-cols-2 gap-2">
+                {TYPE_SPECS.filter((item) => (CREATE_TYPES as readonly string[]).includes(item.value)).map((item) => (
+                  <button key={item.value} type="button"
+                    className={`flex flex-col items-center gap-1 rounded-lg border p-3 text-center transition-colors ${assetType === item.value ? 'border-accent bg-accent-subtle' : 'border-border bg-secondary hover:border-border-strong'}`}
+                    onClick={() => setAssetType(item.value)}>
+                    <item.icon size={18} className={assetType === item.value ? 'text-text-link' : 'text-text-muted'} />
+                    <span className={`text-xs font-medium ${assetType === item.value ? 'text-text-link' : 'text-text'}`}>
+                      {t(`knowledge.form.types.${item.value}.label`)}
+                    </span>
+                    <span className="text-[10px] leading-tight text-text-tertiary">
+                      {t(`knowledge.form.types.${item.value}.oneLiner`)}
+                    </span>
+                  </button>
+                ))}
+              </div>
+            )}
+          </Field>
+
+          <div className="rounded-lg border border-border/70 bg-panel/40 p-3.5 text-xs leading-relaxed text-text-muted">
+            <p><span className="font-medium text-text">{t('knowledge.form.fieldWhat')}</span>
+              {t(`knowledge.form.types.${spec.value}.what`)}</p>
+            <p className="mt-1.5"><span className="font-medium text-text">{t('knowledge.form.fieldEffect')}</span>
+              {t(`knowledge.form.types.${spec.value}.effect`)}</p>
+            <p className="mt-1.5"><span className="font-medium text-text">{t('knowledge.form.fieldPrerequisite')}</span>
+              {t(`knowledge.form.types.${spec.value}.prerequisite`)}</p>
+          </div>
+
+          <Field label={t('knowledge.form.titleLabel')}>
+            <input className={inputClass} value={title} onChange={(e) => setTitle(e.target.value)}
+              placeholder={assetType === 'rule'
+                ? t('knowledge.form.titlePlaceholderRule')
+                : assetType === 'term' ? t('knowledge.form.titlePlaceholderTerm') : t('knowledge.form.titlePlaceholder')} />
+          </Field>
+
+          <Field label={t('knowledge.form.contentLabel')}>
+            <textarea className={`${inputClass} h-36`} value={content} onChange={(e) => setContent(e.target.value)}
+              placeholder={assetType === 'rule' ? t('knowledge.form.contentPlaceholderRule') : t('knowledge.form.contentPlaceholder')} />
+          </Field>
+
+          <div>
+            <div className="mb-2 flex items-center justify-between">
+              <span className="text-sm font-medium text-text">{t('knowledge.form.scopeLabel')}</span>
+              <button type="button" className="flex items-center gap-1 text-xs text-text-link hover:underline" onClick={toggleJsonMode}>
+                <ChevronDown size={12} className={jsonMode ? 'rotate-180 transition-transform' : 'transition-transform'} />
+                {jsonMode ? t('knowledge.form.backToForm') : t('knowledge.form.jsonMode')}
+              </button>
+            </div>
+            {jsonMode ? (
+              <textarea className={`${inputClass} h-48 font-mono text-xs`} value={jsonText} onChange={(e) => setJsonText(e.target.value)}
+                placeholder='{ "metric_keys": ["net_sales"] }' />
+            ) : (
+              <div className="space-y-3">
+                {SCOPE_FIELDS.map((field) => (
+                  <Field key={field.key}
+                    label={t(`knowledge.form.scope.${field.ns}.label`)}
+                    hint={t(`knowledge.form.scope.${field.ns}.hint`)}>
+                    {field.key === 'term_ids' ? (
+                      <>
+                        <input className={inputClass} list="knowledge-term-options" value={fields.term_ids}
+                          onChange={(e) => setFields((old) => ({ ...old, term_ids: e.target.value }))}
+                          placeholder={t(`knowledge.form.scope.${field.ns}.placeholder`)} />
+                        <datalist id="knowledge-term-options">
+                          {terms.map((term) => <option key={term.term_id} value={term.term_id} label={term.name} />)}
+                        </datalist>
+                      </>
+                    ) : (
+                      <input className={inputClass} value={fields[field.key] ?? ''}
+                        onChange={(e) => setFields((old) => ({ ...old, [field.key]: e.target.value }))}
+                        placeholder={t(`knowledge.form.scope.${field.ns}.placeholder`)} />
+                    )}
+                  </Field>
+                ))}
+                {assetType === 'rule' && (
+                  <label className="flex items-start gap-2 rounded border border-border/60 bg-panel/30 px-3 py-2.5 text-xs text-text">
+                    <input type="checkbox" className="mt-0.5" checked={workspaceWide}
+                      onChange={(e) => setWorkspaceWide(e.target.checked)} />
+                    <span>
+                      {t('knowledge.form.workspaceWide')}
+                      <span className="mt-0.5 block leading-relaxed text-text-tertiary">
+                        {catalogEmpty
+                          ? t('knowledge.form.workspaceWideEmptyHint')
+                          : t('knowledge.form.workspaceWideHint')}
+                      </span>
+                    </span>
+                  </label>
+                )}
+              </div>
+            )}
+          </div>
+
+          {isEdit && (
+            <p className="text-xs text-text-muted">
+              {t('knowledge.form.sourceUnchanged', { origin: String(asset?.source?.origin ?? 'document') })}
+            </p>
+          )}
+        </div>
+
+        {error && <span className="px-5 text-xs text-danger">{error}</span>}
+
+        <div className="flex items-center justify-end gap-2 border-t border-border px-5 py-3">
+          <Button variant="ghost" onClick={onClose}>{t('common.cancel')}</Button>
+          <Button variant="primary" disabled={saving} onClick={() => void handleSave()}>{isEdit ? t('common.save') : t('knowledge.form.create')}</Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/KnowledgeReviewPage.tsx b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/KnowledgeReviewPage.tsx
