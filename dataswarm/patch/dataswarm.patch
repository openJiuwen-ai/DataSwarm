+/**
+ * structChangeStore —— 结构变更事件 store 的纯逻辑测试。
+ *
+ * 覆盖核心语义（docs/chat-struct-change-push-plan.md §6.1）：
+ * - applyEvent 按 eventId 幂等（实时先到 + 历史回放后到只展示一次）
+ * - 首条事件返回 true（面板自动展开判定）
+ * - 事件上限 50，超出丢最旧
+ * - 跨 session 隔离 / clearSession / removeRuntime
+ * - normalizeStructChangeEvent 契约解析（两类事件 + 非法 payload 丢弃）
+ */
+
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  useStructChangeStore,
+  normalizeStructChangeEvent,
+} from '../node_modules/.cache/struct-change-store/structChangeStore.mjs';
+
+// zustand store 是模块级单例，测试间共享：每个用例前清干净全部 runtime
+function resetStore() {
+  const state = useStructChangeStore.getState();
+  for (const sid of Object.keys(state.runtimes)) {
+    state.removeRuntime(sid);
+  }
+}
+
+test.beforeEach(() => resetStore());
+
+function workflowPayload(eventId = 'sc-1-a') {
+  return {
+    schema_version: 1,
+    event_id: eventId,
+    session_id: 's1',
+    ts: '2026-09-14T10:30:00+08:00',
+    kind: 'workflow_run',
+    workflow_run: {
+      instance_id: 'inst_1',
+      ref_type: 'workflow',
+      ref_id: 'wf_1',
+      status: 'queued',
+      name: 'GMV 日汇总',
+    },
+  };
+}
+
+function tablePayload(eventId = 'sc-2-b') {
+  return {
+    schema_version: 1,
+    event_id: eventId,
+    session_id: 's1',
+    ts: '2026-09-14T10:35:00+08:00',
+    kind: 'table_change',
+    table_change: {
+      operation: 'CREATE',
+      db: 'olist_dw',
+      tables: ['dws_gmv_daily'],
+      sql_digest: 'CREATE TABLE `dws_gmv_daily` ...',
+      source: 'dwcli sql ddl',
+    },
+  };
+}
+
+function workflowChangePayload(eventId = 'sc-3-c') {
+  return {
+    schema_version: 1,
+    event_id: eventId,
+    session_id: 's1',
+    ts: '2026-09-14T10:40:00+08:00',
+    kind: 'workflow_change',
+    workflow_change: {
+      operation: 'ADD_NODE',
+      workflow_id: 'wf_1',
+      name: 'GMV 日汇总',
+      node_count: 5,
+      source: 'dwcli workflow',
+    },
+  };
+}
+
+test('applyEvent: 首条返回 true（自动展开），后续返回 false', () => {
+  const store = useStructChangeStore.getState();
