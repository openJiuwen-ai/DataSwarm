@@ -0,0 +1,150 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useId, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { ArrowRightLeft, Search } from 'lucide-react';
+import { Input } from '../../../components/ui/Input/Input';
+import { Select } from '../../../components/ui/Select/Select';
+import { Table } from '../../../components/ui/Table/Table';
+import { useAdaptiveTooltip } from '../../../hooks/useAdaptiveTooltip';
+import {
+  buildColumnLineageRows,
+  filterColumnLineageRows,
+  type ColumnLineageGraph,
+  type ColumnLineageReference,
+} from './columnLineageModel';
+import './columnLineageTable.css';
+
+function ExpressionReference({ reference }: { reference: ColumnLineageReference }) {
+  const { t } = useTranslation();
+  const tooltipId = useId();
+  const { tooltip, handlers } = useAdaptiveTooltip({
+    id: tooltipId,
+    content: (
+      <div className="column-lineage-expression-body">
+        <span>{t('columnLineageTable.transformation')}</span>
+        <pre>{reference.transformation}</pre>
+      </div>
+    ),
+  });
+
+  return (
+    <>
+      <button
+        type="button"
+        className="column-lineage-reference column-lineage-expression"
+        aria-label={t('columnLineageTable.showTransformation', { field: reference.id })}
+        aria-describedby={tooltip ? tooltipId : undefined}
+        data-tooltip={reference.transformation}
+        {...handlers}
+        onKeyDown={(event) => {
+          if (event.key === 'Escape') handlers.onBlur();
+        }}
+      >
+        <span>{reference.id}</span>
+        <ArrowRightLeft size={12} aria-hidden="true" />
+      </button>
+      {tooltip}
+    </>
+  );
+}
+
+function ReferenceList({ references }: { references: readonly ColumnLineageReference[] }) {
+  const { t } = useTranslation();
+  if (!references.length) return <span className="column-lineage-none">{t('columnLineageTable.noRelation')}</span>;
+  return (
+    <ul className="column-lineage-references">
+      {references.map((reference, index) => (
+        <li key={index}>
+          {reference.transformation ? (
+            <ExpressionReference reference={reference} />
+          ) : (
+            <span className="column-lineage-reference">{reference.id}</span>
+          )}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+/** Pure presentation: callers supply their current metadata or inspection snapshot. */
+export function ColumnLineageTable({ graph, table: fixedTable }: { graph: ColumnLineageGraph; table?: string }) {
+  const { t } = useTranslation();
+  const [selectedTable, setTable] = useState('');
+  const table = fixedTable ?? selectedTable;
+  const [search, setSearch] = useState('');
+  const rows = useMemo(() => buildColumnLineageRows(graph), [graph]);
+  const tables = useMemo(() => [...new Set(rows.map((row) => row.table).filter(Boolean))], [rows]);
+  const filtered = useMemo(() => filterColumnLineageRows(rows, table, search), [rows, table, search]);
+  const total = table ? rows.filter((row) => row.table === table).length : rows.length;
+
+  return (
+    <section className="column-lineage-view" aria-label={t('columnLineageTable.title')}>
+      <div className="column-lineage-toolbar">
+        {fixedTable !== undefined ? (
+          <span className="column-lineage-table-filter">
+            <span>{t('columnLineageTable.viewTable')}</span>
+            <span className="column-lineage-context-table">{fixedTable}</span>
+          </span>
+        ) : (
+          <label className="column-lineage-table-filter">
+            <span>{t('columnLineageTable.viewTable')}</span>
+            <Select
+              value={table}
+              onChange={setTable}
+              options={[
+                { value: '', label: t('columnLineageTable.allTables') },
+                ...tables.map((value) => ({ value, label: value })),
+              ]}
+            />
+          </label>
+        )}
+        <span className="column-lineage-count" role="status">
+          {search.trim()
+            ? t('columnLineageTable.matchedCount', { count: filtered.length, total })
+            : t('columnLineageTable.totalCount', { count: total })}
+        </span>
+        <Input
+          type="search"
+          autoComplete="off"
+          size="small"
+          value={search}
+          onChange={setSearch}
+          aria-label={t('columnLineageTable.search')}
+          placeholder={t('columnLineageTable.search')}
+          prefix={<Search size={14} aria-hidden="true" />}
+          rootClassName="column-lineage-search"
+        />
+      </div>
+      <Table
+        className="column-lineage-table"
+        headers={[
+          t('columnLineageTable.upstream'),
+          table ? t('columnLineageTable.tableFields', { table }) : t('columnLineageTable.field'),
+          t('columnLineageTable.downstream'),
+        ]}
+      >
+        {filtered.map((row) => (
+          <tr key={row.id}>
+            <td className="column-lineage-upstream">
+              <ReferenceList references={row.sources} />
+            </td>
+            <td className="column-lineage-current">
+              {!table && row.table && <span className="column-lineage-table-name">{row.table}</span>}
+              <span className="column-lineage-field-name">{row.column}</span>
+            </td>
+            <td className="column-lineage-downstream">
+              <ReferenceList references={row.targets} />
+            </td>
+          </tr>
+        ))}
+        {!filtered.length && (
+          <tr className="ui-table-empty-row">
+            <td colSpan={3} className="column-lineage-empty">
+              {t(total ? 'columnLineageTable.noMatches' : 'columnLineageTable.empty')}
+            </td>
+          </tr>
+        )}
+      </Table>
+    </section>
+  );
+}
