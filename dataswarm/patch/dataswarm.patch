--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/glossary/sync.py
@@ -0,0 +1,451 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""glossary/sync.py —— 术语双投影同步：图（Semantica/Neo4j）+ 向量（Semantica FAISSStore）。
+
+真相源永远是 dw_ontology_terms（db.py）；本模块维护两个可重建投影：
+
+- 图：Term 节点先删后写替换到 namespace `glossary/{workspace}`（Neo4j 写入是
+  CREATE 语义，publish 前清旧节点防累积冗余），软删置 tombstone（对齐物理层
+  add_deprecated_tombstones 模式）。
+- 向量：一术语 N+1 条（规范名+定义 1 条、每个别名 1 条），确定性 id，
+  全删全插更新；embedding 复用 memory 系统的 OpenAI 兼容 provider。
+
+两条同步路径（方案 P0 §7）：CRUD 写路径钩子（publish_term）实时同步、
+启动对账（reconcile_tick → reconcile）幂等兜底。任一投影失败不回滚表写。
+
+分层决策（与母文档 §4.1 的偏差，实测 Semantica 0.7 门面后确定）：
+embedding 生成不走 semantica.embeddings（其 TextEmbedder 默认英文模型且
+VectorStore.add_documents 失败时静默 fallback 随机向量），而是复用
+jiuwenswarm memory 的 OpenAICompatibleEmbeddingProvider（同一 get_embed_config
+配置源）；向量存取直接用 semantica FAISSStore 底层类（支持确定性 id、
+metadata、删除与文件持久化）。
+"""
+from __future__ import annotations
+
+import logging
+import threading
+import time
+import uuid
+from pathlib import Path
+
+from ..semantic.graph import GraphNode, GraphProjection
+from ..semantic.semantica import SemanticaAdapter, from_environment
+from . import db
+
+logger = logging.getLogger(__name__)
+
+_vector_lock = threading.Lock()
+_graph_lock = threading.Lock()
+
+# ---- 向量持久化：data/glossary/vectors/{workspace}.faiss（相对 web 进程 cwd）----
+_VECTOR_DIR = Path("data/glossary/vectors")
+
+_faiss_cache: dict[str, object] = {}
+# workspace 级索引操作锁：_vector_lock 只护缓存字典；scan/add/delete/save
+# 必须另行持本锁——faiss 在 C++ 层释放 GIL，并发读写交错是未定义行为。
+_store_locks: dict[str, threading.Lock] = {}
+_graph_adapter: SemanticaAdapter | None = None
+
+# ---- 启动对账：每 workspace 成功一次即完成；失败 60s 退避重试 ----
+_reconciled_workspaces: set[str] = set()
+_reconcile_failed_at: dict[str, float] = {}
+_RECONCILE_RETRY_S = 60.0
+
+
+# ==========================================================================
+# workspace 与 embedding
+# ==========================================================================
+
+def _workspace_id() -> str:
+    """当前工作空间 id（env 直连等场景为空 → 'default'，对齐物理图 namespace 惯例）。"""
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        return workspace_context.current_workspace().workspace_id or "default"
+    except Exception:  # noqa: BLE001 —— 无工作空间配置的 legacy 环境回落 default
+        return "default"
+
+
+def _embedding_configured() -> bool:
+    """embedding 是否已配置。
+
+    复用 metrics EMB 通道的配置解析（含 ``.env`` 补读）——平台 ``get_embed_config``
+    在 web 进程会把 ``${EMBED_API_BASE}`` 占位符解析成空串，glossary 向量投影
+    因此在标准部署形态下静默 ``skipped: embedding_not_configured``（实测 nw
+    空间 FAISS 索引从未建成、口语问题 terms 路无语义兜底）。
+    """
+    from ..metrics import embedding as metrics_embedding
+
+    settings = metrics_embedding.embed_settings()
+    return bool(settings.get("api_key") and settings.get("base_url") and settings.get("model"))
+
+
+def _embed_texts(texts: list[str]) -> list[list[float]]:
+    """批量生成 embedding（复用 metrics EMB 通道，同一配置同一 provider）。
+
+    Raises:
+        RuntimeError: embedding 调用失败（由 ``_sync_vector_term`` 捕获透出）。
+    """
+    from ..metrics import embedding as metrics_embedding
+
+    outcome = metrics_embedding.embed_texts(texts)
+    if not outcome.ok:
+        raise RuntimeError(str(outcome.error or "emb_failed"))
+    return [list(vector) for vector in outcome.vectors]
+
+
+# ==========================================================================
+# 向量投影（Semantica FAISSStore，确定性 id + metadata + 文件持久化）
+# ==========================================================================
+
+def _vector_path(workspace_id: str) -> Path:
+    return _VECTOR_DIR / f"{workspace_id}.faiss"
+
+
+def _faiss_store(workspace_id: str, dims: int | None = None):
+    """取（或建/载）workspace 级 FAISSStore。文件已存在则 load（dims 取自 sidecar）。
+
+    Args:
+        workspace_id: 工作空间 id。
+        dims: 新建索引时的向量维度；已 load 的缓存实例忽略该参数。
+
+    Returns:
+        FAISSStore 实例；首次新建且 dims 未知时返回 None（调用方先 embed 再来）。
+    """
+    from semantica.vector_store.faiss_store import FAISSStore
+
+    with _vector_lock:
+        cached = _faiss_cache.get(workspace_id)
+        if cached is not None:
+            return cached
+        path = _vector_path(workspace_id)
+        store = FAISSStore(dimension=dims or 768)
+        if path.exists():
+            store.load_index(path)
+        else:
+            if not dims:
+                return None
+            store.create_index("flat", "L2")
+        _faiss_cache[workspace_id] = store
+        return store
+
+
+def _store_lock(workspace_id: str) -> threading.Lock:
+    """取（或建）workspace 级索引操作锁，与 ``_faiss_cache`` 同 key。"""
+    with _vector_lock:
+        lock = _store_locks.get(workspace_id)
+        if lock is None:
+            lock = _store_locks[workspace_id] = threading.Lock()
+        return lock
+
+
+def _term_vector_records(term: dict) -> tuple[list[str], list[str], list[dict]]:
+    """一术语 N+1 条拆条（方案 P0 §6.2）。返回 (ids, documents, metadata)。"""
+    term_id = term["term_id"]
+    name = term["name"]
+    synonyms = term.get("synonyms_list") or db.parse_synonyms(term.get("synonyms"))
+    fingerprint = term.get("fingerprint") or ""
+    ids = [f"{term_id}:canonical"] + [f"{term_id}:syn:{i}" for i in range(len(synonyms))]
+    documents = [f"{name}：{term['definition']}"] + [f"{synonym}（{name}）" for synonym in synonyms]
+    metadata = [{"term_id": term_id, "kind": "canonical", "fingerprint": fingerprint}] + [
+        {"term_id": term_id, "kind": "synonym", "text": synonym, "fingerprint": fingerprint}
+        for synonym in synonyms
+    ]
+    return ids, documents, metadata
+
+
+def _vector_ids_by_term(store) -> dict[str, list[tuple[str, str]]]:
+    """scan 现有向量：term_id → [(vector_id, fingerprint)]（对账与删除共用）。"""
+    grouped: dict[str, list[tuple[str, str]]] = {}
+    index = getattr(store, "index", None)
+    if index is None:
+        return grouped
+    for vector_id, meta in (getattr(index, "metadata", None) or {}).items():
+        term_id = str(meta.get("term_id") or "")
+        if not term_id:
+            continue
+        grouped.setdefault(term_id, []).append((vector_id, str(meta.get("fingerprint") or "")))
+    return grouped
+
+
+def _sync_vector_term(term: dict, deleted: bool) -> dict:
+    """单术语向量投影：active 全删全插；deleted 按 term_id 删除。
+
+    Returns:
+        {"status": "ok"|"skipped"|"failed", "reason": ...}——skipped=未配置 embedding。
+    """
+    workspace_id = _workspace_id()
+    if not _embedding_configured():
+        return {"status": "skipped", "reason": "embedding_not_configured"}
+    try:
+        term_id = term["term_id"]
+        ids, documents, metadata = _term_vector_records(term)
+        # 先 embed 拿真实维度（首次建索引需要，且是慢调用须在锁外），再取/建 FAISSStore
+        vectors = _embed_texts(documents)
+        dims = len(vectors[0]) if vectors else 0
+        store = _faiss_store(workspace_id, dims=dims)
+        if store is None:  # pragma: no cover —— dims 已给仍建不出，防御分支
+            return {"status": "failed", "reason": "faiss_unavailable"}
+        with _store_lock(workspace_id):
+            stale_ids = [vector_id for vector_id, _ in _vector_ids_by_term(store).get(term_id, [])]
+            if stale_ids:
+                store.delete_vectors(stale_ids)
+            if not deleted:
+                store.add_vectors(vectors, ids=ids, metadata=metadata)
+            store.save_index(_vector_path(workspace_id))
+        return {"status": "ok", "vectors": 0 if deleted else len(ids)}
+    except Exception as exc:  # noqa: BLE001 —— 投影失败不回滚表写，状态透出
+        return {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"}
+
+
+def _clear_vector_workspace(workspace_id: str) -> None:
+    """reindex 用：清空该 workspace 的向量缓存与索引文件。"""
+    with _vector_lock:
+        _faiss_cache.pop(workspace_id, None)
+    path = _vector_path(workspace_id)
+    for artifact in (path, Path(str(path) + ".meta.json")):
+        if artifact.exists():
+            artifact.unlink()
+
+
+# ==========================================================================
+# 图投影（Semantica GraphBuilder，先删后写替换，namespace glossary/{workspace}）
+# ==========================================================================
+
+def _get_graph_adapter() -> SemanticaAdapter:
+    """进程内缓存生产 adapter；构造失败（环境变量缺失）抛错由调用方降级。"""
+    global _graph_adapter
+    with _graph_lock:
+        if _graph_adapter is None:
+            _graph_adapter = from_environment()
+        return _graph_adapter
+
+
+def _term_graph_node(term: dict, workspace_id: str, tombstone: bool = False) -> GraphNode:
+    """Term 节点（active 全属性 / tombstone 只保留可追溯字段）。"""
+    node_id = f"term:{workspace_id}:{term['term_id']}"
+    if tombstone:
+        properties = {
+            "name": term.get("name", ""),
+            "status": "deprecated",
+            "fingerprint": term.get("fingerprint") or "",
+        }
+    else:
+        synonyms = term.get("synonyms_list") or db.parse_synonyms(term.get("synonyms"))
+        properties = {
+            "name": term["name"],
+            "definition": term["definition"],
+            "synonyms": synonyms,
+            "status": term.get("status", "active"),
+            "owner": term.get("owner", ""),
+            "source": term.get("source", ""),
+            "tags": term.get("tags", ""),
+            "fingerprint": term.get("fingerprint") or "",
+            "updatedAt": term.get("updated_at", ""),
+        }
+    return GraphNode(node_id, "Term", properties)
+
+
+def _publish_graph(nodes: list[GraphNode], workspace_id: str, replace_namespace: bool = False) -> dict:
+    """stage → validate → publish 一批 Term 节点（先删后写的替换语义）。
+
+    Neo4j 写入是纯 CREATE（semantica GraphBuilder 无 MERGE/upsert），publish 前
+    必须清旧节点，否则每次同步累积冗余。单术语路径只按稳定 id 清（避免误删同
+    namespace 其他术语）；replace_namespace=True 时清整个 namespace（全量对账
+    用，调用方须保证 nodes 覆盖目标态全部术语，可为空表 = 清空投影）。
+    """
+    projection = GraphProjection(nodes=nodes, edges=[])
+    namespace = f"glossary/{workspace_id}"
+    version = f"glossary-{uuid.uuid4().hex[:8]}"
+    adapter = _get_graph_adapter()
+    if replace_namespace:
+        adapter.delete_graph_nodes(namespace)
+    elif nodes:
+        adapter.delete_graph_nodes(namespace, [node.id for node in nodes])
+    stage_id = adapter.stage(namespace, version, projection)
+    adapter.validate(stage_id)
+    result = adapter.publish(stage_id)
+    return {"status": "ok", "version": result.version, "nodes": result.node_count}
+
+
+def _sync_graph_term(term: dict, deleted: bool) -> dict:
+    """单术语图投影：按稳定 id 替换节点（deleted 时为 tombstone）。"""
+    workspace_id = _workspace_id()
+    try:
+        node = _term_graph_node(term, workspace_id, tombstone=deleted)
+        return _publish_graph([node], workspace_id)
+    except Exception as exc:  # noqa: BLE001 —— 图不可达不回滚表写
+        return {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"}
+
+
+# ==========================================================================
+# 对外入口
+# ==========================================================================
+
+def vector_count(term_id: str) -> int:
+    """该术语在当前 workspace 向量投影中的条数（详情展示用；无索引/未配置返回 0）。"""
+    store = _faiss_store(_workspace_id())
+    if store is None:
+        return 0
+    return len(_vector_ids_by_term(store).get(term_id, []))
+
+
+def publish_term(term: dict, deleted: bool = False) -> dict:
+    """CRUD 写路径钩子：术语落库后同步双投影（方案 P0 §7.1）。
+
+    Args:
+        term: db 层返回的术语 dict（含 synonyms_list）。
+        deleted: True 表示软删（图 tombstone / 向量删除）。
+
+    Returns:
+        {"graph": {...}, "vector": {...}}——两个投影各自的状态，失败不影响表写。
+    """
+    return {
+        "graph": _sync_graph_term(term, deleted),
+        "vector": _sync_vector_term(term, deleted),
+    }
+
+
+def _reproject_metric_graph(workspace_id: str) -> dict:
+    """术语图全量替换后，补跑指标重投影恢复 ``Metric→Term`` 跨层边。
+
+    跨层边挂在节点上，而全量对账是 ``DETACH DELETE`` 整个 glossary namespace
+    再写——Term 节点被删重建时，指向它们的 measuresConcept 边**连带消失**，
+    元数据库里的绑定却还在（分析侧的图读路于是查不到链，表现为「绑了术语但
+    分析不认」）。这里补投影是方案 W-4「变更同步」的第一条：跟不上就看得见，
+    失败只记原因不阻断对账（元数据库是真相源，图是可重建衍生品）。
+
+    Returns:
+        ``{"status": "published"|"skipped"|"failed", ...}``——无已发布指标或
+        Neo4j 未配置都算 ``skipped``（不是错误）。
+    """
+    try:
+        from ..metrics.graph_projection import ProjectionUnavailableError, reproject_workspace
+    except Exception as exc:  # noqa: BLE001 —— metrics 模块不可用：对账照常完成
+        return {"status": "skipped", "reason": f"{type(exc).__name__}: {exc}"}
+    try:
+        outcome = reproject_workspace(workspace_id)
+        return {"status": "published", **{
+            key: outcome.get(key) for key in
+            ("cross_created", "cross_missed", "warnings") if key in outcome}}
+    except ProjectionUnavailableError as exc:
+        return {"status": "skipped", "reason": str(exc)}
+    except Exception as exc:  # noqa: BLE001 —— Neo4j 不可达等：记原因不阻断
+        return {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"}
+
+
+def reconcile() -> dict:
+    """当前 workspace 全量对账（方案 P0 §7.2，幂等）。
+
+    图：全量替换（先清 namespace 再写 active + tombstone；空表即清空投影）。
+    向量：scan 后按 term_id 比对 fingerprint 与条数，修偏（重建/删除）。
+    图与向量互不阻塞，各自失败各自记录。
+    """
+    workspace_id = _workspace_id()
+    terms = db.list_terms(include_deprecated=True)
+    active = [t for t in terms if t.get("status") == "active"]
+    deprecated = [t for t in terms if t.get("status") == "deprecated"]
+    result: dict = {"workspace": workspace_id, "terms": len(terms)}
+
+    # 图对账：全量替换（先清 namespace 再写 active + tombstone；空表时即清空投影）
+    try:
+        nodes = [_term_graph_node(t, workspace_id) for t in active]
+        nodes += [_term_graph_node(t, workspace_id, tombstone=True) for t in deprecated]
+        result["graph"] = _publish_graph(nodes, workspace_id, replace_namespace=True)
+        result["metric_reproject"] = _reproject_metric_graph(workspace_id)
+    except Exception as exc:  # noqa: BLE001
+        result["graph"] = {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"}
+
+    # 向量对账：不配置 embedding 时整体 skipped
+    if not _embedding_configured():
+        result["vector"] = {"status": "skipped", "reason": "embedding_not_configured"}
+        return result
+    try:
+        # 只对已存在的索引文件做 scan 对账；索引不存在时不预建（真实维度只能
+        # 由 embedding 结果决定），缺失术语经 _sync_vector_term 首次写入时建。
+        store = _faiss_store(workspace_id)
+        grouped = _vector_ids_by_term(store) if store is not None else {}
+        expected = {t["term_id"]: t for t in active}
+        rebuilt = 0
+        removed = 0
+        for term_id, entries in grouped.items():
+            term = expected.get(term_id)
+            if term is None:
+                store.delete_vectors([vector_id for vector_id, _ in entries])
+                store.save_index(_vector_path(workspace_id))
+                removed += 1
+                continue
+            expected_ids, _, _ = _term_vector_records(term)
+            fingerprints = {fp for _, fp in entries}
+            if len(entries) != len(expected_ids) or fingerprints != {term.get("fingerprint") or ""}:
+                outcome = _sync_vector_term(term, deleted=False)
+                if outcome.get("status") == "ok":
+                    rebuilt += 1
+                else:
+                    result.setdefault("vector_errors", []).append({"term_id": term_id, **outcome})
+        for term_id, term in expected.items():
+            if term_id not in grouped:
+                outcome = _sync_vector_term(term, deleted=False)
+                if outcome.get("status") == "ok":
+                    rebuilt += 1
+                else:
+                    result.setdefault("vector_errors", []).append({"term_id": term_id, **outcome})
+        result["vector"] = {"status": "ok", "rebuilt": rebuilt, "removed": removed}
+    except Exception as exc:  # noqa: BLE001
+        result["vector"] = {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"}
+    return result
+
+
+def reindex() -> dict:
+    """全量重建投影（运维兜底）：向量清空重灌，图全量替换。"""
+    workspace_id = _workspace_id()
+    _clear_vector_workspace(workspace_id)
+    return reconcile()
+
+
+def reconcile_tick() -> None:
+    """scheduler 挂载入口（orchestration/scheduler._tick 每 workspace 调用一次）。
+
+    进程生命周期内每 workspace 对账成功一次即完成；失败 60s 退避后重试
+    （Neo4j/faiss 可能晚于 web 起来）。必须在该 workspace 的 contextvar 作用域内调用。
+    """
+    workspace_id = _workspace_id()
+    if workspace_id in _reconciled_workspaces:
+        return
+    failed_at = _reconcile_failed_at.get(workspace_id)
+    if failed_at and time.time() - failed_at < _RECONCILE_RETRY_S:
+        return
+    try:
+        result = reconcile()
+        graph_ok = result.get("graph", {}).get("status") == "ok"
+        vector_status = result.get("vector", {}).get("status")
+        vector_ok = vector_status in {"ok", "skipped"}
+        if graph_ok and vector_ok:
+            _reconciled_workspaces.add(workspace_id)
+            _reconcile_failed_at.pop(workspace_id, None)
+            logger.info("[glossary] 启动对账完成 workspace=%s terms=%s vector=%s",
+                        workspace_id, result.get("terms"), vector_status)
+        else:
+            _reconcile_failed_at[workspace_id] = time.time()
+            logger.warning("[glossary] 启动对账未完成 workspace=%s graph=%s vector=%s",
+                           workspace_id, result.get("graph", {}).get("status"), vector_status)
+    except Exception as exc:  # noqa: BLE001 —— 对账失败不影响调度循环
+        _reconcile_failed_at[workspace_id] = time.time()
+        logger.warning("[glossary] 启动对账异常 workspace=%s: %s", workspace_id, exc)
+
+
+def _reset_for_tests() -> None:
+    """测试隔离：清空模块级缓存（图 adapter / faiss 缓存 / 对账标记）。"""
+    global _graph_adapter
+    with _graph_lock:
+        _graph_adapter = None
+    with _vector_lock:
+        _faiss_cache.clear()
+    _reconciled_workspaces.clear()
+    _reconcile_failed_at.clear()
+
+
+def _set_graph_adapter_for_tests(adapter: SemanticaAdapter | None) -> None:
+    """测试注入：替换图 adapter（InMemorySemanticaAdapter / None 走生产链路）。"""
+    global _graph_adapter
+    with _graph_lock:
+        _graph_adapter = adapter
