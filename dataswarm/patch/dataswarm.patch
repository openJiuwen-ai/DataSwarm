+def list_joins(
+    source_id: str,
+    *,
+    status: str | None = None,
+    level: str | None = None,
+) -> dict:
+    """列出最新 published 快照的 join 边（含人工确认覆盖结果）。
+
+    Args:
+        source_id: 数据源 ID。
+        status: 过滤 ``verified`` | ``candidate``；None 全量。
+        level: 过滤证据等级 ``declared`` | ``lineage`` | ``inferred``；None 全量。
+
+    Returns:
+        ``{"joins": [...], "snapshot_id": ...}``；源未采集时 joins 为空列表。
+    """
+    if not source_id:
+        raise ValueError("source_id is required")
+    snapshot = repository.latest_published_snapshot(source_id)
+    if snapshot is None:
+        return {"joins": [], "snapshot_id": None}
+    rows = []
+    for join in snapshot.joins:
+        if status and join.status != status:
+            continue
+        if level and join.level != level:
+            continue
+        rows.append({
+            "join_node_id": join.node_id,
+            "left_column_id": join.left_column_id,
+            "right_column_id": join.right_column_id,
+            "left_table_id": join.left_table_id,
+            "right_table_id": join.right_table_id,
+            "cardinality": join.cardinality,
+            "confidence": join.confidence,
+            "source": list(join.source),
+            "level": join.level,
+            "status": join.status,
+            "usable_for_generation": join.status == "verified" and join.confidence >= 0.7,
+        })
+    return {"joins": rows, "snapshot_id": snapshot.snapshot_id}
+
+
+def confirm_join(
+    join_node_id: str,
+    source_id: str,
+    status: str,
+    confirmed_by: str,
+    note: str = "",
+) -> dict:
+    """join 人工确认：verified（升声明级）/ rejected（读取时剔除）。
+
+    快照不可变——确认写 ``dw_semantic_join_status`` 覆盖层，读取侧
+    (:func:`repository.latest_published_snapshot`) 合并生效。
+
+    Args:
+        join_node_id: ``JoinPathMeta.node_id``。
+        source_id: 数据源 ID。
+        status: ``verified`` | ``rejected``。
+        confirmed_by: 确认人标识。
+        note: 备注说明。
+
+    Returns:
+        ``{"join": 落库行, "existed_in_snapshot": bool}``。
+
+    Raises:
+        ValueError: status 非法或 join 不在最新 published 快照内。
+    """
+    if not join_node_id or not source_id:
+        raise ValueError("join_node_id 与 source_id 均必填")
+    snapshot = repository.latest_published_snapshot(source_id)
+    if snapshot is None:
+        raise ValueError(f"source {source_id} 尚无 published 快照，无法确认 join")
+    if not any(join.node_id == join_node_id for join in snapshot.joins):
+        raise ValueError(f"join {join_node_id} 不在 {source_id} 最新快照内")
+    row = repository.save_join_status(join_node_id, source_id, status, confirmed_by, note)
+    return {"join": row, "existed_in_snapshot": True}
+
+
+def search_graph(
