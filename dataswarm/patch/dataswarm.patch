--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/metricsV2/PublishTab.tsx
@@ -0,0 +1,347 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 发布页签：待发布修订清单 + 发布设置 + 发布历史。
+ *
+ * 发布是「修订 → 生效口径」的唯一开关：勾选 candidate 修订后投影到语义图，
+ * 成功即对分析取数生效。图投影失败不回滚发布（元数据库是真相源，可重投影修）。
+ */
+
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  Badge,
+  Button,
+  EmptyState,
+  Field,
+  Panel,
+  RefreshButton,
+  Table,
+  TableSkeleton,
+  inputClass,
+} from '../_shared/ui';
+import { Pagination } from '../../components/ui/Pagination/Pagination';
+import {
+  metricsV2Api,
+  type V2MetricDetail,
+  type V2MetricListItem,
+  type V2Release,
+  type V2RevisionSummary,
+} from './api';
+import { enumLabel, formatTime, type Runner } from './ui';
+import { CheckCircle2, Rocket } from 'lucide-react';
+
+/** 徽标只存色调；文案渲染期经 enumLabel 解析（biMetrics.enum.*），切语言即时生效。 */
+const REVISION_STATUS_TONE: Record<string, 'neutral' | 'success' | 'warn' | 'danger'> = {
+  draft: 'neutral', candidate: 'warn', published: 'success', retired: 'neutral',
+};
+
+const PROJECTION_STATUS_TONE: Record<string, 'neutral' | 'success' | 'warn' | 'danger'> = {
+  published: 'success', pending: 'neutral', failed: 'danger',
+};
+
+const RELEASE_STATUS_TONE: Record<string, 'neutral' | 'success' | 'warn' | 'danger'> = {
+  published: 'success', draft: 'neutral', revoked: 'neutral', failed: 'danger',
+};
+
+interface RevisionRow {
+  metricKey: string;
+  metricName: string;
+  revision: V2RevisionSummary;
+}
+
+export function PublishTab({ run }: { run: Runner }) {
+  const { t } = useTranslation();
+  const [releases, setReleases] = useState<V2Release[]>([]);
+  const [metrics, setMetrics] = useState<V2MetricListItem[]>([]);
+  const [details, setDetails] = useState<Record<string, V2MetricDetail>>({});
+  const [loadedKeys, setLoadedKeys] = useState<Record<string, boolean>>({});
+  const [checked, setChecked] = useState<Record<string, boolean>>({});
+  const [label, setLabel] = useState('');
+  const [publishMsg, setPublishMsg] = useState<{ ok: boolean; text: string } | null>(null);
+  const [revPage, setRevPage] = useState(1);
+  const [revPageSize, setRevPageSize] = useState(10);
+  const [historyPage, setHistoryPage] = useState(1);
+  const [historyPageSize, setHistoryPageSize] = useState(10);
+
+  const reload = useCallback(() => {
+    // 修订状态会随发布变化：清空详情缓存，让下面的 effect 重新拉取
+    setDetails({});
+    setLoadedKeys({});
+    void run(async () => {
+      const [rel, mets] = await Promise.all([
+        metricsV2Api.releases(), metricsV2Api.listMetrics(),
+      ]);
+      setReleases(rel.releases);
+      setMetrics(mets.metrics);
+    });
+  }, [run]);
+
+  useEffect(() => { reload(); }, [reload]);
+
+  useEffect(() => {
+    // 拉详情收集修订 ID；失败也记 loaded，避免永远停在加载中
+    metrics.forEach((m) => {
+      if (!loadedKeys[m.metric_key]) {
+        void metricsV2Api.getMetric(m.metric_key).then((d) => {
+          setDetails((prev) => ({ ...prev, [m.metric_key]: d }));
+        }).catch(() => undefined)
+          .finally(() => setLoadedKeys((prev) => ({ ...prev, [m.metric_key]: true })));
+      }
+    });
+  }, [metrics, loadedKeys]);
+
+  const loadingDetails = metrics.some((m) => !loadedKeys[m.metric_key]);
+
+  const allRevisions: RevisionRow[] = useMemo(() => Object.values(details).flatMap((detail) =>
+    detail.revisions.map((revision) => ({
+      metricKey: detail.metric.metric_key,
+      metricName: detail.metric.name,
+      revision,
+    }))), [details]);
+
+  const pendingRevisions = useMemo(() =>
+    allRevisions.filter(({ revision }) => revision.status !== 'published').length, [allRevisions]);
+  const selected = useMemo(() =>
+    allRevisions.filter(({ revision }) => checked[revision.revision_id]), [allRevisions, checked]);
+  const pendingCount = useMemo(() =>
+    selected.reduce((sum, { revision }) => sum + (revision.candidate_maps?.length ?? 0), 0), [selected]);
+  const canPublish = selected.length > 0 && !loadingDetails;
+
+  const selectAllPending = () => {
+    const next: Record<string, boolean> = {};
+    allRevisions.forEach(({ revision }) => {
+      if (revision.status !== 'published') next[revision.revision_id] = true;
+    });
+    setChecked(next);
+    setPublishMsg(null);
+  };
+
+  const doPublish = () => {
+    if (!canPublish) return;
+    setPublishMsg(null);
+    void run(async () => {
+      const result = await metricsV2Api.publish(
+        selected.map(({ revision }) => revision.revision_id), label, 'web-user');
+      const projectionStatus = result.projection.projection_status;
+      const projection = projectionStatus === 'published'
+        ? t('biMetrics.publish.projectionOk')
+        : projectionStatus === 'skipped'
+          ? t('biMetrics.publish.projectionSkipped')
+          : t('biMetrics.publish.projectionFailed');
+      setPublishMsg({
+        ok: true,
+        text: t('biMetrics.publish.successNotice', {
+          releaseId: result.release.release_id, status: result.release.status, projection,
+        }),
+      });
+      setChecked({});
+      setLabel('');
+      reload();
+    });
+  };
+
+  // 列表可能随修订增长：两处列表都分页；页码越界时收敛到最后一页
+  const revPageCount = Math.max(1, Math.ceil(allRevisions.length / revPageSize));
+  const currentRevPage = Math.min(revPage, revPageCount);
+  const visibleRevisions = allRevisions.slice(
+    (currentRevPage - 1) * revPageSize, currentRevPage * revPageSize);
+  const historyPageCount = Math.max(1, Math.ceil(releases.length / historyPageSize));
+  const currentHistoryPage = Math.min(historyPage, historyPageCount);
+  const visibleReleases = releases.slice(
+    (currentHistoryPage - 1) * historyPageSize, currentHistoryPage * historyPageSize);
+
+  const revisionRows = visibleRevisions.map(({ metricKey, metricName, revision }) => {
+    const published = revision.status === 'published';
+    const statusTone = REVISION_STATUS_TONE[revision.status] ?? 'neutral';
+    const statusLabel = enumLabel(t, 'revisionStatus', revision.status);
+    return (
+      <label key={revision.revision_id}
+             className={`flex cursor-pointer items-start gap-3 rounded-lg border px-3 py-2 transition-colors ${
+               published
+                 ? 'border-border bg-secondary/40 opacity-70'
+                 : 'border-border hover:bg-panel'
+             }`}>
+        <input type="checkbox" className="mt-1" disabled={published}
+               checked={!!checked[revision.revision_id]}
+               onChange={(e) => setChecked((prev) => ({
+                 ...prev, [revision.revision_id]: e.target.checked,
+               }))} />
+        <div className="min-w-0 flex-1">
+          <div className="flex flex-wrap items-center gap-2">
+            <span className="truncate text-sm font-medium text-text-strong">{metricName}</span>
+            <span className="font-mono text-xs text-text-muted">{metricKey}</span>
+            <span className="text-xs text-text-muted">r{revision.revision_no}</span>
+            <Badge tone={statusTone}>{statusLabel}</Badge>
+            <Badge tone="neutral">{enumLabel(t, 'type', revision.metric_type)}</Badge>
+            {revision.unit && <span className="text-xs text-text-muted">{revision.unit}</span>}
+          </div>
+          <div className="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted">
+            {revision.definition_hash && (
+              <span title={t('biMetrics.publish.hashTitle')}>
+                hash <code>{revision.definition_hash.slice(0, 8)}</code>
+              </span>
+            )}
+            {revision.time_dimension
+              && <span>{t('biMetrics.publish.timeDimension', { value: revision.time_dimension })}</span>}
+            {!!revision.candidate_maps?.length && (
+              <span className="text-warn">
+                {t('biMetrics.publish.pendingMapsNote', { count: revision.candidate_maps.length })}
+              </span>
+            )}
+            {published && <span>{t('biMetrics.publish.publishedNoRecheck')}</span>}
+          </div>
+        </div>
+      </label>
+    );
+  });
+
+  const historyRows = visibleReleases.map((release) => {
+    const statusTone = RELEASE_STATUS_TONE[release.status] ?? 'neutral';
+    const statusLabel = enumLabel(t, 'releaseStatus', release.status);
+    const projectionTone = PROJECTION_STATUS_TONE[release.projection_status] ?? 'neutral';
+    const projectionLabel = enumLabel(t, 'projectionStatus', release.projection_status);
+    return [
+      <span className="font-mono text-xs" title={release.release_id}>{release.release_id}</span>,
+      <span className="text-xs">{release.label || '—'}</span>,
+      <Badge tone={statusTone}>{statusLabel}</Badge>,
+      <Badge tone={projectionTone}>{projectionLabel}</Badge>,
+      <span className="text-xs text-text-muted">{formatTime(release.published_at)}</span>,
+      <span className="text-xs text-danger" title={release.error_message}>
+        {release.error_code || '—'}
+      </span>,
+    ];
+  });
+
+  return (
+    <div className="space-y-4">
+      {publishMsg && (
+        <div className="flex items-start gap-2 rounded-lg border border-accent/40 bg-accent-subtle px-3 py-2 text-sm text-text">
+          <CheckCircle2 size={16} className="mt-0.5 shrink-0 text-text-link" />
+          <span className="min-w-0 break-all">{publishMsg.text}</span>
+        </div>
+      )}
+
+      <div className="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
+        <Panel
+          title={t('biMetrics.publish.revisionListTitle', {
+            pending: pendingRevisions, total: allRevisions.length,
+          })}
+          actions={(
+            <div className="flex items-center gap-2">
+              <RefreshButton onRefresh={reload} />
+              <Button variant="default" size="sm" disabled={loadingDetails}
+                      onClick={selectAllPending}>
+                {t('biMetrics.publish.selectAllPending')}
+              </Button>
+              <Button variant="ghost" size="sm" onClick={() => { setChecked({}); setPublishMsg(null); }}>
+                {t('biMetrics.publish.clearSelection')}
+              </Button>
+            </div>
+          )}
+        >
+          {loadingDetails ? (
+            <TableSkeleton rows={4} />
+          ) : allRevisions.length === 0 ? (
+            <EmptyState
+              title={t('biMetrics.publish.emptyTitle')}
+              hint={t('biMetrics.publish.emptyHint')}
+            />
+          ) : (
+            <>
+              <div className="space-y-2">{revisionRows}</div>
+              <div className="mt-4">
+                <Pagination
+                  total={allRevisions.length}
+                  page={currentRevPage}
+                  pageSize={revPageSize}
+                  onPageChange={setRevPage}
+                  onPageSizeChange={(size) => { setRevPageSize(size); setRevPage(1); }}
+                  labels={{
+                    total: t('biMetrics.publish.totalRevisions', { count: allRevisions.length }),
+                    pageSize: t('biMetrics.pagination.pageSize'),
+                    previous: t('biMetrics.pagination.previous'),
+                    next: t('biMetrics.pagination.next'),
+                    page: (no) => t('biMetrics.pagination.page', { no }),
+                    navLabel: t('biMetrics.pagination.revisionsNav'),
+                  }}
+                  pageSizeOptions={[10, 20, 50]}
+                  loading={loadingDetails}
+                />
+              </div>
+            </>
+          )}
+        </Panel>
+
+        <Panel title={t('biMetrics.publish.settingsTitle')}>
+          <div className="space-y-4">
+            <div className="grid grid-cols-2 gap-2">
+              <div className="rounded-lg border border-border bg-panel px-3 py-2">
+                <div className="text-xs text-text-muted">{t('biMetrics.publish.selectedRevisions')}</div>
+                <div className="mt-0.5 text-xl font-semibold text-text-strong">{selected.length}</div>
+              </div>
+              <div className="rounded-lg border border-border bg-panel px-3 py-2">
+                <div className="text-xs text-text-muted">{t('biMetrics.publish.pendingMapsLabel')}</div>
+                <div className={`mt-0.5 text-xl font-semibold ${pendingCount ? 'text-warn' : 'text-text-strong'}`}>
+                  {pendingCount}
+                </div>
+              </div>
+            </div>
+            <Field label={t('biMetrics.publish.labelField')} hint={t('biMetrics.publish.labelHint')}>
+              <input className={inputClass} value={label}
+                     placeholder={t('biMetrics.publish.labelPlaceholder')}
+                     onChange={(e) => setLabel(e.target.value)} />
+            </Field>
+            <Button variant="primary" disabled={!canPublish} onClick={doPublish}
+                    className="w-full">
+              <Rocket size={14} className="mr-1 inline" />
+              {t('biMetrics.publish.publishSelected')}
+            </Button>
+            <p className="text-xs leading-5 text-text-muted">
+              {t('biMetrics.publish.notice')}
+            </p>
+          </div>
+        </Panel>
+      </div>
+
+      <Panel title={t('biMetrics.publish.historyTitle', { count: releases.length })}>
+        {releases.length === 0 ? (
+          <EmptyState
+            title={t('biMetrics.publish.emptyHistoryTitle')}
+            hint={t('biMetrics.publish.emptyHistoryHint')}
+          />
+        ) : (
+          <>
+            <Table
+              headers={[
+                t('biMetrics.publish.headers.batch'),
+                t('biMetrics.publish.headers.label'),
+                t('biMetrics.publish.headers.status'),
+                t('biMetrics.publish.headers.projection'),
+                t('biMetrics.publish.headers.publishedAt'),
+                t('biMetrics.publish.headers.error'),
+              ]}
+              rows={historyRows}
+            />
+            <div className="mt-4">
+              <Pagination
+                total={releases.length}
+                page={currentHistoryPage}
+                pageSize={historyPageSize}
+                onPageChange={setHistoryPage}
+                onPageSizeChange={(size) => { setHistoryPageSize(size); setHistoryPage(1); }}
+                labels={{
+                  total: t('biMetrics.publish.totalBatches', { count: releases.length }),
+                  pageSize: t('biMetrics.pagination.pageSize'),
+                  previous: t('biMetrics.pagination.previous'),
+                  next: t('biMetrics.pagination.next'),
+                  page: (no) => t('biMetrics.pagination.page', { no }),
+                  navLabel: t('biMetrics.pagination.historyNav'),
+                }}
+                pageSizeOptions={[10, 20, 50]}
+              />
+            </div>
+          </>
+        )}
+      </Panel>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/metricsV2/SchemaSubgraphView.tsx b/jiuwenswarm/channels/web/frontend/src/features/metricsV2/SchemaSubgraphView.tsx
new file mode 100644
