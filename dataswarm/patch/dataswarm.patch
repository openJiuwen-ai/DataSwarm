+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Redis 采样建模、物化查询与扫描护栏验收。
+
+用法：verify_gates.py <redis_port>，目标须预置专用 fixture。
+Hash 值以字符串读取，分析 SQL 显式 CAST；缺失字段经物化表示为 NULL。
+历史实例结果覆盖 Windows 社区版 Redis 5.0.14，不代表 Redis 7/8 或远端 TLS/ACL。
+"""
+import sys
+import time
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (
+    SourceDefinition, SqlQueryable, TabularScannable, capabilities_of, get_engine,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import (
+    ConnectorError, QueryValidationError,
+)
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common import dialect_registry as dr
+
+PORT = int(sys.argv[1])
+CONFIG = {
+    "host": "127.0.0.1", "port": PORT,
+    "datasets": "hash:order:*,stream:events,zset:leaderboard",
+    "max_keys": 60000, "materialize_limit": 60000,
+}
+HASH_TABLE = "hash:order:*"
+
+PASS, FAIL, SKIP = [], [], []
+
+BASELINE = {
+    "Q1 单指标总量": [["2318839.92"]],
+    "Q2 分组TopN排序": [["4", "620606.75"], ["2", "620448.25"], ["3", "532051.48"]],
+    "Q3 时间粒度月度": [["2026-01", "99018.5"], ["2026-02", "91174.23"],
+                        ["2026-03", "97070.7"]],
+    "Q4 过滤+聚合": [["1", "10651"], ["2", "12425"], ["3", "10650"], ["4", "12425"]],
+    "Q5 空值占比": [["7.142"]],
+}
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+def connector_for(config=None, source_id="verify"):
+    adapter = R.get_source_type("redis")
+    source = SourceDefinition(
+        source_id, "redis", "verify", adapter.engine, dict(config or CONFIG)
+    )
+    return get_engine(adapter.engine)(source)
+
+
+def norm(rows):
+    out = []
+    for row in rows:
+        cells = []
+        for v in row:
+            try:
+                cells.append(f"{float(v):.4f}")
+            except (TypeError, ValueError):
+                cells.append(str(v))
+        out.append(cells)
+    return out
+
+
+# ======================================================================
+print("\n########## 门 A：接入 ##########")
+
+
+def a_real_connection():
+    ok = connector_for().test_connection()
+    assert ok.get("ok") is True, f"真实 Redis 应连通: {ok}"
+    bad = connector_for({**CONFIG, "port": 6399}).test_connection()
+    assert bad.get("ok") is False, f"错端口应失败: {bad}"
+    return f"真实 Redis 连通（{ok['message']}）；错端口失败"
+
+
+def a_validate_and_boundaries():
+    adapter = R.get_source_type("redis")
+    expect_raises(lambda: adapter.validate({"host": "h", "port": PORT}),
+                  ValueError, "缺 datasets")
+    expect_raises(lambda: adapter.validate({**CONFIG, "datasets": "hash:*"}),
+                  Exception, "全键空间扫描")
+    expect_raises(lambda: adapter.validate({**CONFIG, "datasets": "list:foo"}),
+                  Exception, "不支持的结构类型")
+    adapter.validate(CONFIG)
+    return "datasets 必填；全键扫描与非法结构被拒"
+
+
+def a_full_keyspace_refused_at_runtime():
+    """运行期仍须拒绝未声明范围的全键扫描。"""
+    conn = connector_for({**CONFIG, "datasets": "hash:order:*"})
+    expect_raises(lambda: conn.scan("hash:*", limit=10), ConnectorError, "运行期全键扫描")
+    return "运行期对 pattern='*' 同样拒绝"
+
+
+check("A1", "真实连通性", a_real_connection)
+check("A2", "参数校验与能力边界", a_validate_and_boundaries)
+check("A3", "运行期拒绝全键扫描", a_full_keyspace_refused_at_runtime)
+
+# ======================================================================
+print("\n########## 门 B：建模（三种结构映射）##########")
+
+
+def b_hash_as_rows():
+    conn = connector_for()
+    inferred = conn.infer_schema(HASH_TABLE, sample=1000)
+    by = {c["name"]: c for c in inferred["columns"]}
+    assert "_key" in by, list(by)          # RowKey 作为列
+    for want in ("order_id", "order_amt", "channel_name"):
+        assert want in by, list(by)
+    # Redis Hash 无类型：所有值都是字符串
+    assert all(c["type"] == "VARCHAR" for c in inferred["columns"]), {
+        c["name"]: c["type"] for c in inferred["columns"]
+    }
+    # 空值只能表现为字段缺席（Hash 无 NULL 概念）
+    assert by["order_amt"]["presence"] < 1.0, by["order_amt"]
+    assert by["order_id"]["presence"] == 1.0, by["order_id"]
+    return (f"{len(by)} 列（含 _key）；全部 VARCHAR（Redis Hash 无类型）；"
+            f"order_amt presence={by['order_amt']['presence']}（空值=字段缺席）")
+
+
+def b_stream_as_timeseries():
+    conn = connector_for()
+    inferred = conn.infer_schema("stream:events", sample=100)
+    by = {c["name"]: c for c in inferred["columns"]}
+    assert "_id" in by, list(by)           # Stream entry ID
+    assert "kind" in by and "seq" in by, list(by)
+    out = conn.scan("stream:events", limit=10)
+    assert out["row_count"] == 10, out["row_count"]
+    return f"Stream 映射为时序表：列 {sorted(by)}"
+
+
+def b_zset_as_leaderboard():
+    conn = connector_for()
+    inferred = conn.infer_schema("zset:leaderboard", sample=100)
+    by = {c["name"]: c for c in inferred["columns"]}
+    assert set(by) == {"member", "score"}, list(by)
+    out = conn.scan("zset:leaderboard", limit=5)
+    # ZREVRANGE：按 score 降序
+    scores = [float(r[out["columns"].index("score")]) for r in out["rows"]]
+    assert scores == sorted(scores, reverse=True), scores
+    return f"ZSet 映射为排行榜表（member/score，按 score 降序）"
+
+
+def b_scan_pipelined_performance():
+    """验证多 key Hash 读取使用流水线并满足本地 fixture 的耗时上限。"""
+    conn = connector_for()
+    started = time.monotonic()
+    out = conn.scan(HASH_TABLE, limit=50000)
+    elapsed = time.monotonic() - started
+    assert out["row_count"] == 50000, out["row_count"]
+    # 固定 fixture 的流水线读取须满足下方耗时上限。
+    assert elapsed < 8.0, f"取 5 万 key 耗时 {elapsed:.1f}s，流水线可能失效"
+    return f"5 万 key 取回耗时 {elapsed:.1f}s（逐 key 往返实测约 14s）"
+
+
+def b_governance_path():
+    ref = R.get_source_type("redis").build_ref(CONFIG)
+    assert ref == f"redis://127.0.0.1:{PORT}/0", ref
+    spec = dbc.parse_db_ref(ref)
+    assert spec["type"] == "redis" and spec["port"] == PORT, spec
+    return f"build_ref={ref}，parse_db_ref 往返无损"
+
+
+def b_capabilities():
+    conn = connector_for()
+    assert capabilities_of(conn) == {"sql", "scan"}, capabilities_of(conn)
+    assert isinstance(conn, TabularScannable) and isinstance(conn, SqlQueryable)
+    return "capabilities = {'sql','scan'}（原生 scan + 物化后 SQL）"
+
+
+check("B1", "Hash 映射为行", b_hash_as_rows)
+check("B2", "Stream 映射为时序表", b_stream_as_timeseries)
+check("B3", "ZSet 映射为排行榜", b_zset_as_leaderboard)
+check("B4", "流水线取数性能", b_scan_pipelined_performance)
+check("B5", "治理通路 ref 往返", b_governance_path)
+check("B6", "能力协议可组合", b_capabilities)
+
+blocked("B7", "知识候选落库",
+        "同前几批：默认元数据库为 doris 且本仓缺知识表 DDL。分类规则本身在"
+        "批 5/7 已验（采样列走同一条 _classify 路径）。")
+
+# ======================================================================
+print("\n########## 门 C：数据分析跑通 ##########")
+
+# Redis Hash 无类型，所有值都是字符串 → 必须显式 CAST。
+T = f'"{HASH_TABLE}"'
+AMT = "CAST(order_amt AS DOUBLE)"
+QUESTIONS = {
+    "Q1 单指标总量": f"SELECT ROUND(SUM({AMT}), 2) AS v FROM {T}",
+    "Q2 分组TopN排序": (
+        f"SELECT CAST(region_id AS BIGINT) AS region_id, ROUND(SUM({AMT}),2) AS v "
+        f"FROM {T} GROUP BY region_id ORDER BY v DESC, region_id LIMIT 3"
+    ),
+    "Q3 时间粒度月度": (
+        f"SELECT strftime(CAST(order_date AS DATE), '%Y-%m') AS m, "
+        f"ROUND(SUM({AMT}),2) AS v FROM {T} "
+        f"WHERE CAST(order_date AS DATE) >= DATE '2026-01-01' "
+        f"GROUP BY m ORDER BY m LIMIT 3"
+    ),
+    "Q4 过滤+聚合": (
+        f"SELECT CAST(category_id AS BIGINT) AS category_id, COUNT(*) AS c FROM {T} "
+        f"WHERE CAST(region_id AS BIGINT) <> 9 AND order_amt IS NOT NULL "
+        f"GROUP BY category_id ORDER BY category_id"
+    ),
+    "Q5 空值占比": (
+        f"SELECT ROUND(100.0 * SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END) "
+        f"/ COUNT(*), 4) AS pct FROM {T}"
+    ),
+}
+
+
+def c_analysis_matches_baseline():
+    conn = connector_for()
+    answers = {}
+    for label, sql in QUESTIONS.items():
+        res = conn.query(sql, limit=10)
+        assert "materialize_truncated" not in res, (
+            f"{label} 物化被截断，答案不可信: {res.get('materialize_truncated')}"
+        )
+        answers[label] = norm(res["rows"])
+    for label, raw in BASELINE.items():
+        expected = norm(raw)
+        assert answers[label] == expected, (
+            f"{label} 与基准不一致:\n  基准={expected}\n  redis={answers[label]}"
+        )
+    print("            经真实 Redis 取数物化后的答案：")
+    for label, rows in BASELINE.items():
+        print(f"              {label} = {rows[0] if len(rows) == 1 else rows}")
+    return "5 道题经真实 Redis → 物化 → DuckDB，与基准逐值一致（需显式 CAST）"
+
+
+def c_null_semantics_preserved():
+    """字段缺席必须变成 NULL，否则空值占比会算错。"""
+    conn = connector_for()
+    res = conn.query(
+        f"SELECT COUNT(*) AS total, "
+        f"SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END) AS nulls FROM {T}",
+        limit=5,
+    )
+    total, nulls = res["rows"][0]
+    assert total == 50000, total
+    assert nulls == 3571, f"空值数不对: {nulls}（应为 3571）"
+    return f"5 万行中 {nulls} 个 NULL —— 字段缺席正确转为 NULL"
+
+
+check("C1", "5 道分析题与基准一致", c_analysis_matches_baseline)
+check("C2", "字段缺席→NULL 语义正确", c_null_semantics_preserved)
+
+# ======================================================================
+print("\n########## 门 D：护栏 ##########")
+
+
+def d_write_rejected():
+    conn = connector_for()
+    for sql in (f"INSERT INTO {T} VALUES (1)", f"UPDATE {T} SET order_amt = 0",
+                f"DELETE FROM {T}", f"DROP TABLE {T}",
+                "CREATE TABLE evil AS SELECT 1", f"COPY {T} TO 'leak.csv'"):
+        expect_raises(lambda s=sql: conn.query(s), QueryValidationError, sql[:26])
+    return "6 类写/导出操作被拒"
+
+
+def d_materialize_truncation_explicit():
+    conn = connector_for({**CONFIG, "materialize_limit": 100})
+    res = conn.query(f"SELECT COUNT(*) AS c FROM {T}", limit=5)
+    assert res["materialize_truncated"] == [HASH_TABLE], res
+    assert res["rows"] == [[100]], res["rows"]
+    return f"物化上限 100 时显式报截断，结果 {res['rows'][0][0]} 行（不静默少算）"
+
+
+def d_dialect_and_truncation():
+    conn = connector_for()
+    expect_raises(lambda: conn.query(f"SELECT 1; DROP TABLE {T}"),
+                  QueryValidationError, "多语句")
+    assert dr.sqlglot_dialect("redis") == "duckdb", dr.sqlglot_dialect("redis")
+    res = conn.query(f"SELECT * FROM {T}", limit=10)
+    assert len(res["rows"]) == 10 and res["truncated"] is True, res.get("truncated")
+    return "多语句被拒；方言=duckdb；返回行截断置位"
+
+
+def d_no_keys_command():
+    import inspect as _inspect
+
+    from jiuwenswarm.channels.web.dataagent.connectors.sampled_connector import (
+        RedisStore,
+    )
+
+    src = _inspect.getsource(RedisStore)
+    assert ".keys(" not in src, "出现 client.keys() 调用（会阻塞实例）"
+    assert "scan_iter(" in src, "未使用 SCAN 游标"
+    return "无 keys() 调用，只用 SCAN 游标"
+
+
+check("D1", "写/导出操作被拒", d_write_rejected)
+check("D2", "物化截断显式透出", d_materialize_truncation_explicit)
+check("D3", "多语句/方言/截断", d_dialect_and_truncation)
+check("D4", "无全键扫描命令", d_no_keys_command)
+
+blocked("D5", "Redis 7/8 行为差异",
+        "真连的是 Windows 社区移植版 5.0.14（Redis 官方不出 Windows 构建）。"
+        "Redis 7/8 的新行为（如 RESP3、函数、集群模式）未覆盖。")
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\nredis 四道门通过（真连 Redis 5.0.14；边界见阻断项）")
