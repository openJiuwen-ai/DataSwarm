@@ -0,0 +1,113 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/query_log.py —— 查询账本（dw_metric_query_log）与反馈（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+from ._db import _commit_if_own, _conn_or, _write_lock, new_id
+
+
+# ==========================================================================
+# dw_metric_query_log —— 查询追溯
+# ==========================================================================
+def log_query(record: dict[str, Any], *, conn: Any = None) -> str:
+    """写一条查询追溯记录。成功与失败都要写。
+
+    Args:
+        record: 列名 → 值。缺 ``query_id`` / ``created_at`` 时自动补。
+        conn: 可选的既有连接。
+
+    Returns:
+        query_id。
+    """
+    query_id = record.get("query_id") or new_id("mq")
+    created_at = record.get("created_at") or _now()
+    columns = (
+        "query_id, workspace_id, session_id, question, query_spec_json, path, authoritative,"
+        " release_id, revision_ids_json, generated_sql, sql_params_json, dialect,"
+        " validation_json, executed, row_count, elapsed_ms, model_name, context_digest,"
+        " schema_snapshot_id, degraded_reason, feedback, error_code, error_message, created_at"
+    )
+    values = (
+        query_id, record.get("workspace_id") or "", record.get("session_id"),
+        record.get("question"), record.get("query_spec_json"), record.get("path"),
+        1 if record.get("authoritative", True) else 0, record.get("release_id"),
+        record.get("revision_ids_json"), record.get("generated_sql"),
+        record.get("sql_params_json"), record.get("dialect"), record.get("validation_json"),
+        1 if record.get("executed") else 0, record.get("row_count"), record.get("elapsed_ms"),
+        record.get("model_name"), record.get("context_digest"), record.get("schema_snapshot_id"),
+        record.get("degraded_reason"), record.get("feedback") or "none",
+        record.get("error_code"), record.get("error_message"), created_at,
+    )
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                f"INSERT INTO dw_metric_query_log ({columns})"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                values,
+            )
+            _commit_if_own(c, own)
+        return query_id
+    finally:
+        if own:
+            c.close()
+
+
+def list_queries(workspace_id: str, *, limit: int = 50, conn: Any = None) -> list[dict]:
+    """列出最近的查询追溯记录。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_query_log WHERE workspace_id = ?"
+            " ORDER BY created_at DESC LIMIT ?",
+            (workspace_id, int(limit)),
+        )
+    finally:
+        if own:
+            c.close()
+
+
+
+
+def update_query_feedback(query_id: str, feedback: str, *, conn: Any = None) -> None:
+    """更新查询追溯行的反馈标记（none/verified/rejected）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_query_log SET feedback = ? WHERE query_id = ?",
+                (feedback, query_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def get_query(query_id: str, *, conn: Any = None) -> dict | None:
+    """按主键取查询追溯行。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_one_dict(
+            c, "SELECT * FROM dw_metric_query_log WHERE query_id = ?", (query_id,))
+    finally:
+        if own:
+            c.close()
+
+
