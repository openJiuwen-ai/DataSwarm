+++ b/tests/acceptance/datasource/batch3/verify_gates.py
@@ -0,0 +1,290 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""SQL Server 的离线声明、ref、元数据 SQL 和护栏检查。
+
+本脚本不连接数据库。目录 SQL 可解析不代表服务器语义正确；catalog/schema
+返回值和五道分析题仍需真实实例验证。SQL Server 实例验收见 batch13。
+"""
+import sys
+
+import sqlglot
+
+from jiuwenswarm.channels.web.dataagent.connectors.errors import (
+    QueryValidationError,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.sql_guard import (
+    validate_read_only_sql,
+)
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common import dialect_registry as dr
+from jiuwenswarm.common import ref_codec as rc
+
+PASS, FAIL, SKIP = [], [], []
+TARGETS = ("sqlserver",)
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+# ======================================================================
+print("\n########## 门 A：接入（离线部分）##########")
+
+
+def a_declared_and_released():
+    """发布状态与驱动是否安装分别检查。"""
+    types = {t["type_id"]: t for t in R.list_source_types()}
+    adapter = R.get_source_type("sqlserver")
+    entry = types["sqlserver"]
+    assert adapter.released is True
+    assert entry["available"] == (not adapter.missing_requirements)
+    assert entry["fields"] and adapter.requires
+    return "类型已开放；驱动缺失仍影响当前可用性"
+
+
+def a_fields_are_complete():
+    expected = {
+        "sqlserver": {"host", "port", "user", "password", "database", "driver", "trusted_connection"},
+    }
+    detail = []
+    for tid in TARGETS:
+        keys = {f.key for f in R.get_source_type(tid).fields}
+        assert keys == expected[tid], (tid, keys)
+        secrets = R.get_source_type(tid).secret_keys()
+        assert secrets == {"password"}, (tid, secrets)
+        detail.append(f"{tid}={len(keys)}字段")
+    return "，".join(detail) + "；password 标为密文"
+
+
+def a_validate_rules():
+    adapter = R.get_source_type("sqlserver")
+    expect_raises(lambda: adapter.validate({}), ValueError, "空参数")
+    expect_raises(
+        lambda: adapter.validate({"host": "h", "database": "d", "port": 1433}),
+        ValueError, "缺 user",
+    )
+    adapter.validate({"host": "h", "database": "d", "port": 1433, "user": "u"})
+    return "必填项校验正确"
+
+
+def a_secret_redaction():
+    for tid in TARGETS:
+        adapter = R.get_source_type(tid)
+        pub = adapter.public_config(
+            {"password": "s3cret", "user": "u", "host": "h"}
+        )
+        assert pub["password"] == "", (tid, pub)
+        assert pub["user"] == "u" and pub["host"] == "h"
+    return "SQL Server password 回显为空，非密文字段保留"
+
+
+check("A1", "声明与发布状态", a_declared_and_released)
+check("A2", "表单字段与密文标注", a_fields_are_complete)
+check("A3", "参数校验规则", a_validate_rules)
+check("A4", "凭据脱敏回显", a_secret_redaction)
+
+blocked("A5", "真实连通性测试",
+        "SQL Server 真实连接成功/失败两态见 batch13。"
+        "本脚本仅执行离线检查。")
+
+# ======================================================================
+print("\n########## 门 B：建模（离线部分）##########")
+
+
+def b_build_ref_roundtrip():
+    detail = []
+    cases = [
+        ("sqlserver", {"host": "h", "port": 1433, "database": "mydb"}, 1433, "mydb"),
+    ]
+    for tid, cfg, port, target in cases:
+        ref = R.get_source_type(tid).build_ref(cfg)
+        spec = dbc.parse_db_ref(ref)
+        assert spec["type"] == tid, spec
+        assert spec["port"] == port, spec
+        assert spec["database"] == target, spec
+        detail.append(ref)
+    return "往返无损：" + "，".join(detail)
+
+
+def b_codec_registered_with_all_ports():
+    for tid in TARGETS:
+        assert rc.is_registered(tid), f"{tid} codec 未注册——治理/知识通路会接不上"
+        codec = rc.codec_for(tid)
+        assert codec.uses_pool is True
+        assert codec.tables_sql()
+        assert codec.describe_sql("T")
+        # 多步游标端口必须被子类覆盖，不能停在基类的 NotImplementedError
+        for hook in ("read_indexes", "read_create_sql", "map_columns"):
+            assert getattr(type(codec), hook) is not getattr(rc.RefCodec, hook), (
+                f"{tid} codec 未覆盖 {hook}"
+            )
+    return "SQL Server codec 已注册，且目录 SQL / 行映射 / 索引 / DDL 四端口齐备"
+
+
+def b_catalog_sql_parses_under_own_dialect():
+    """按目标方言解析目录 SQL；仅验证语法，不验证数据字典语义。"""
+    detail = []
+    for tid in TARGETS:
+        codec = rc.codec_for(tid)
+        dialect = dr.sqlglot_dialect(codec.dialect)
+        for label, sql in (("tables_sql", codec.tables_sql()),
+                           ("describe_sql", codec.describe_sql("FACT_ORDERS"))):
+            try:
+                sqlglot.parse_one(sql, read=dialect)
+            except Exception as exc:
+                raise AssertionError(f"{tid}.{label} 在 {dialect} 方言下解析失败: {exc}")
+        detail.append(f"{tid}({dialect})")
+    return "解析通过：" + "，".join(detail) + "；注意：能解析≠在真库上结果正确"
+
+
+def b_engine_url_shape():
+    codec = rc.codec_for("sqlserver")
+    url = codec.engine_url(
+        {"type": "sqlserver", "host": "h", "port": 1433, "database": "d",
+         "user": "u", "password": "p"}, True)
+    assert url.startswith("mssql+pyodbc://"), url
+    assert "driver=ODBC+Driver+18" in url, url
+    assert "ApplicationIntent=ReadOnly" in url, url
+    assert "TrustServerCertificate=yes" not in url, url
+    return "默认 ODBC URL 保留 TLS 证书校验；实例使用版本见 batch13"
+
+
+def b_credentials_resolved_in_one_place():
+    """池化 URL 与直连共用 _credentials，避免缺失凭据时走不同回退路径。"""
+    for tid in TARGETS:
+        codec = rc.codec_for(tid)
+        assert hasattr(codec, "_credentials"), f"{tid} 未走统一凭据出口"
+        user, pwd = codec._credentials({"user": "u", "password": "p"})
+        assert (user, pwd) == ("u", "p")
+    return "SQL Server codec 的凭据解析收在基类 _credentials() 单一出口"
+
+
+def b_logical_type_for_native_names():
+    """验证 SQL Server 原生类型名的逻辑类型映射。"""
+    cases = [
+        ("sqlserver", "nvarchar(100)", dr.TEXT),
+        ("sqlserver", "datetime2", dr.TIME),
+        ("sqlserver", "money", dr.NUMERIC),
+        ("sqlserver", "uniqueidentifier", dr.TEXT),
+    ]
+    for tid, physical, expected in cases:
+        got = dr.logical_type(tid, physical)
+        assert got == expected, (tid, physical, got, expected)
+    return f"{len(cases)} 个 T-SQL 原生类型名归一正确"
+
+
+check("B1", "build_ref <-> parse_db_ref 往返", b_build_ref_roundtrip)
+check("B2", "codec 注册与端口齐备", b_codec_registered_with_all_ports)
+check("B3", "目录 SQL 方言可解析", b_catalog_sql_parses_under_own_dialect)
+check("B4", "engine_url 形态", b_engine_url_shape)
+check("B5", "凭据解析单一出口", b_credentials_resolved_in_one_place)
+check("B6", "原生类型名逻辑归一", b_logical_type_for_native_names)
+
+blocked("B7", "真实 catalog / schema / 索引 / DDL",
+        "SQL Server 的 sys 目录、注释、主键、"
+        "跨 schema 同名表及 DDL 已由第 13 批真验。")
+blocked("B8", "知识候选落库",
+        "本离线脚本不执行知识候选落库。")
+
+# ======================================================================
+print("\n########## 门 C：数据分析跑通 ##########")
+
+blocked("C", "5 道分析题跑通",
+        "本离线脚本不执行分析；SQL Server 的五题真实结果见 batch13。")
+
+# ======================================================================
+print("\n########## 门 D：护栏（离线部分）##########")
+
+
+def d_dialect_mapping():
+    assert dr.sqlglot_dialect("sqlserver") == "tsql"
+    profile = dr.profile_for("sqlserver")
+    assert profile.grain_fn == "FORMAT"
+    assert profile.limit_syntax == "offset_fetch"
+    return "时间粒度 FORMAT；分页 OFFSET/FETCH"
+
+
+def d_paired_bracket_quoting():
+    """成对方括号须转义名称中的右括号。"""
+    assert dr.quote_ident("sqlserver", "order") == "[order]"
+    assert dr.quote_ident("sqlserver", "we]ird") == "[we]]ird]"
+    assert dr.quote_qualified("sqlserver", "dbo.orders") == "[dbo].[orders]"
+    return "成对方括号及内嵌右括号转义正确"
+
+
+def d_guard_uses_right_dialect():
+    backtick = "SELECT `col` FROM t"
+    validate_read_only_sql(backtick, source_type="mysql")
+    expect_raises(
+        lambda: validate_read_only_sql(backtick, source_type="sqlserver"),
+        QueryValidationError, "T-SQL 反引号",
+    )
+    validate_read_only_sql(
+        "SELECT * FROM t ORDER BY a OFFSET 0 ROWS FETCH NEXT 10 ROWS ONLY",
+        source_type="sqlserver",
+    )
+    validate_read_only_sql("SELECT TOP 10 * FROM t", source_type="sqlserver")
+    return "拒绝反引号；OFFSET/FETCH 与 TOP 通过只读校验"
+
+
+def d_write_statements_rejected_by_dialect():
+    """写操作拦截是 AST 级的，与方言无关——但要确认换方言后依然生效。"""
+    for tid in TARGETS:
+        for sql in ("INSERT INTO t VALUES (1)", "UPDATE t SET a = 1",
+                    "DELETE FROM t", "DROP TABLE t", "TRUNCATE TABLE t",
+                    "CREATE TABLE x (a int)"):
+            expect_raises(lambda s=sql, d=tid: validate_read_only_sql(s, source_type=d),
+                          QueryValidationError, f"{tid}: {sql[:20]}")
+    return "SQL Server 的 6 类写操作全部被拒"
+
+
+def d_system_schemas_declared():
+    """系统 schema 过滤不得排除默认业务 schema。"""
+    assert dr.system_schemas("sqlserver")
+    assert dr.is_system_schema("sqlserver", "sys") is True
+    assert dr.is_system_schema("sqlserver", "dbo") is False
+    return "sys 为系统 schema，dbo 为业务 schema"
+
+
+check("D1", "方言映射与能力位", d_dialect_mapping)
+check("D2", "成对标识符引用", d_paired_bracket_quoting)
+check("D3", "护栏按正确方言解析", d_guard_uses_right_dialect)
+check("D4", "写操作跨方言被拒", d_write_statements_rejected_by_dialect)
+check("D5", "系统 schema 已声明", d_system_schemas_declared)
+
+blocked("D6", "真实只读与截断行为",
+        "SQL Server 应用只读护栏及截断的真实结果见 batch13；"
+        "ApplicationIntent=ReadOnly 仅为路由意图，不是服务端写权限限制。")
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n本批未覆盖的实例检查：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\nSQL Server 离线契约通过；真实实例验收见 batch13")
