+    def update_task(self, tid, data):
+        if tid not in self.tasks:
+            return None
+        self.tasks[tid].update(data)
+        return self.tasks[tid]
+
+    def delete_task(self, tid):
+        return self.tasks.pop(tid, None) is not None
+
+    def list_tasks(self, status=None, q=None, limit=100, offset=0):
+        return list(self.tasks.values())
+
+    def set_task_status(self, tid, status, enabled=None):
+        if tid not in self.tasks:
