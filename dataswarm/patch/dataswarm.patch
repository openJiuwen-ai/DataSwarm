@@ -0,0 +1,203 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/llm.py —— 服务端 LLM 调用封装（镜像 _dw_common/llm_client.py 契约）。
+
+契约（与 skill 侧一致）：**失败/超时/未配置返回空串，永不抛异常**——调用方
+判空降级为「无法回答 + 原因」，绝不编造数值。
+
+为什么镜像而不 import：``_dw_common/scripts/`` 是 skill 脚本（无包结构，
+sys.path 不可靠）；仓库先例是各子系统自带 LLM 封装（auto_harness/service.py）。
+
+两个实测陷阱都内建规避：
+- ``temperature`` 必须经 ``invoke`` 覆盖传——``ModelRequestConfig`` 默认 0.95；
+- ``use_shared_llm_http_client=False``——openjiuwen 共享 httpx 池绑定首个
+  事件循环，本模块每次 ``call_llm_sync`` 都 ``asyncio.run`` 开新 loop，
+  共享池在首个 loop 关闭后报 Connection error。
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+from pathlib import Path
+
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+try:
+    from openjiuwen.core.foundation.llm import (  # type: ignore[import-untyped]
+        Model,
+        ModelClientConfig,
+        ModelRequestConfig,
+        SystemMessage,
+        UserMessage,
+    )
+
+    LLM_AVAILABLE = True
+except ImportError:
+    LLM_AVAILABLE = False
+    Model = None  # type: ignore[assignment]
+
+try:
+    import yaml
+
+    _YAML_AVAILABLE = True
+except ImportError:
+    _YAML_AVAILABLE = False
+
+
+logger = logging.getLogger(__name__)
+
+
+def default_config_path() -> Path:
+    """默认配置路径：运行时数据根（JIUWENSWARM_DATA_DIR 优先）的 config/config.yaml。
+
+    与 db_connector._datasource_config_path 同一推导：dataswarm_boot / 桌面 /
+    多实例注入 DATA_DIR 隔离数据目录后，硬编码 ``~/.jiuwenswarm`` 会让
+    metrics 的 LLM 配置读到基座目录（网关/密钥串台）。
+    """
+    return get_user_workspace_dir() / "config" / "config.yaml"
+
+
+def load_llm_config(config_path: str | None = None) -> dict:
+    """多级 fallback 读取 LLM 配置（ai_analysis > react.model_client_config >
+    models.defaults 的 is_default 条目/首位）。
+
+    与对话侧 ``get_default_models`` 同源语义的两处对齐（2026-11-03）：
+    - **``${VAR}`` 占位符解析**：发布模板的 models.defaults 是
+      ``${MODEL_NAME}/${API_BASE}/${API_KEY}``，实际值在 config/.env；对话侧经
+      ``resolve_env_vars`` 展开。裸读不展开会拿到字面量去请求网关——exe 首装
+      形态下对话成功、本链路必失败（APIConnectionError）。
+    - **取 is_default 条目**：对话主模型是 ``is_default=True`` 的条目，不一定是
+      列表首位；取首位会在多模型配置下用错模型。
+
+    Args:
+        config_path: 显式配置文件路径；None 用默认路径。
+
+    Returns:
+        ``{model_name, api_base, api_key, verify_ssl, client_provider}``；
+        ``api_key`` 可能为空串——调用方须判空降级；``client_provider`` 指示
+        网关协议（Anthropic /v1/messages 或 OpenAI /v1/chat/completions）。
+    """
+    config: dict = {"model_name": "", "api_base": "", "api_key": "", "verify_ssl": True,
+                    "client_provider": "OpenAI"}
+    path = Path(config_path) if config_path else default_config_path()
+    if not path.is_file() or not _YAML_AVAILABLE:
+        return config
+    try:
+        raw = yaml.safe_load(path.read_text(encoding="utf-8"))
+    except Exception:  # noqa: BLE001 —— 配置读不到走默认空配置
+        return config
+    if not isinstance(raw, dict):
+        return config
+    candidate: dict | None = None
+    if isinstance(raw.get("ai_analysis"), dict):
+        cand = raw["ai_analysis"]
+        candidate = {"model_name": cand.get("model_name"), "api_base": cand.get("api_base"),
+                     "api_key": cand.get("api_key"), "client_provider": cand.get("client_provider")}
+    elif isinstance(raw.get("react"), dict) and isinstance(
+            raw["react"].get("model_client_config"), dict):
+        cand = raw["react"]["model_client_config"]
+        candidate = {"model_name": raw["react"].get("model_name") or cand.get("model_name"),
+                     "api_base": cand.get("api_base"), "api_key": cand.get("api_key"),
+                     "client_provider": cand.get("client_provider")}
+    else:
+        defaults = raw.get("models")
+        if isinstance(defaults, dict):
+            defaults = defaults.get("defaults")
+        if isinstance(defaults, list) and defaults:
+            # 对话主模型 = is_default=True 的条目（不一定是首位）；无标记时沿用首位
+            entry = next((item for item in defaults
+                          if isinstance(item, dict) and item.get("is_default")), defaults[0])
+            cand = entry.get("model_client_config") or {}
+            candidate = {"model_name": cand.get("model_name"), "api_base": cand.get("api_base"),
+                         "api_key": cand.get("api_key"), "verify_ssl": cand.get("verify_ssl"),
+                         "client_provider": cand.get("client_provider")}
+    if candidate:
+        # 发布模板的值是 ${VAR} 占位符，真值在 config/.env——与对话侧同样展开
+        from jiuwenswarm.common.config import resolve_env_vars
+        candidate = resolve_env_vars(candidate)
+        for key in ("model_name", "api_base", "api_key", "verify_ssl", "client_provider"):
+            if candidate.get(key) is not None:
+                config[key] = candidate[key]
+    return config
+
+
+class _LLMClient:
+    """惰性持有 Model 实例（镜像 skill 侧 _LLMClient）。"""
+
+    def __init__(self, config_path: str | None = None):
+        self.config = load_llm_config(config_path)
+        self._model = None
+
+    def _get_model(self):
+        if self._model is None:
+            if not LLM_AVAILABLE:
+                raise RuntimeError("LLM 模块未安装（openjiuwen）")
+            if not self.config.get("api_key"):
+                raise RuntimeError("未配置 api_key（~/.jiuwenswarm/config/config.yaml）")
+            client_config = ModelClientConfig(
+                # 网关协议跟着配置走（Anthropic /v1/messages 或 OpenAI
+                # /v1/chat/completions）；写死 OpenAI 会让 Anthropic-only
+                # 网关的 explore 兜底静默失败（对照 extraction_llm 的映射）
+                client_provider=str(self.config.get("client_provider") or "OpenAI"),
+                api_base=self.config["api_base"],
+                api_key=self.config["api_key"],
+                verify_ssl=self.config.get("verify_ssl", True),
+                # 独享 http client：共享池绑首个 loop，见模块 docstring
+                use_shared_llm_http_client=False,
+            )
+            self._model = Model(
+                model_client_config=client_config,
+                model_config=ModelRequestConfig(model=self.config["model_name"]),
+            )
+        return self._model
+
+    async def call(self, system_prompt: str, user_prompt: str,
+                   temperature: float = 0.0, timeout_s: int = 90) -> str:
+        model = self._get_model()
+        messages = [SystemMessage(content=system_prompt), UserMessage(content=user_prompt)]
+        response = await model.invoke(messages=messages, temperature=temperature,
+                                      timeout=timeout_s)
+        return response.content if hasattr(response, "content") else str(response)
+
+
+_CLIENT: _LLMClient | None = None
+
+
+async def call_llm(system_prompt: str, user_prompt: str, *,
+                    config_path: str | None = None,
+                    temperature: float = 0.0,
+                    timeout_s: int = 90) -> str:
+    """调 LLM，失败/超时/未配置返回空串（不抛异常）。
+
+    Args:
+        system_prompt: 系统提示词。
+        user_prompt: 用户提示词。
+        temperature: 意图解析用 0.0——要稳定不要创意。
+        timeout_s: 硬超时上限。
+
+    Returns:
+        LLM 响应文本；失败时空串，调用方判空降级。
+    """
+    global _CLIENT
+    try:
+        # 每次调用新建客户端，不缓存 Model：本模块经 asyncio.run 每次开新
+        # 事件循环，Model 内部 httpx client 绑定首个 loop；loop 关闭后复用
+        # 缓存 Model 会 Connection error（openjiuwen 共享池同款陷阱，
+        # use_shared_llm_http_client=False 只换掉共享池，Model 级缓存仍踩）。
+        client = _LLMClient(config_path)
+        _CLIENT = client  # 仅留引用供测试探查，不参与复用
+        coro = client.call(system_prompt, user_prompt,
+                            temperature=temperature, timeout_s=timeout_s)
+        return await asyncio.wait_for(coro, timeout=timeout_s + 5)
+    except Exception as exc:  # noqa: BLE001 —— 降级契约：永不抛
+        logger.warning("[metrics.llm][warn] LLM 调用失败: %s: %s", type(exc).__name__, exc)
+        return ""
+
+
+def call_llm_sync(system_prompt: str, user_prompt: str, *,
+                  config_path: str | None = None,
+                  temperature: float = 0.0,
+                  timeout_s: int = 90) -> str:
+    """call_llm 的同步包装（asyncio.run）。参数语义同 :func:`call_llm`。"""
+    return asyncio.run(call_llm(system_prompt, user_prompt,
+                                config_path=config_path,
+                                temperature=temperature, timeout_s=timeout_s))
