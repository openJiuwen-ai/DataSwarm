+  const [columnMapJson, setColumnMapJson] = useState(
+    latestBinding?.column_map ? JSON.stringify(latestBinding.column_map, null, 2) : '');
+  const [showAdvanced, setShowAdvanced] = useState(false);
+
+  const [datasources, setDatasources] = useState<V2DatasourceOption[]>([]);
+  const [datasourcesReady, setDatasourcesReady] = useState(isEdit);
+  const [metricOptions, setMetricOptions] = useState<string[]>([]);
+  const [tableOptions, setTableOptions] = useState<string[]>([]);
+  const [columnOptions, setColumnOptions] = useState<string[]>(EMPTY_VALUES);
+  const [structureNote, setStructureNote] = useState('');
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+
+  // edit/revision 打开时按目标指标重新预填（避免上次上下文串数据）；create 不清空，保留已写内容
+  const applyContext = useCallback(() => {
+    const revision = mode === 'revision' ? detail?.revisions[0] : undefined;
+    const revisionBinding = revision?.bindings?.[0];
