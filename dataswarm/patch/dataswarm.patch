+        ("avg_order_value", "DOUBLE COMMENT '客单价'"),
+        ("gmv_wow", "DOUBLE COMMENT 'GMV周同比'"),
+        ("gmv_dod", "DOUBLE COMMENT 'GMV日环比'"),
