+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""duckdb warehouse / csv 目录源写路径单测。
+
+覆盖：
+- csv 目录源（新口径）：读走 :memory:（无 .duckdb 文件）、execute_write
+  CTAS/INSERT/DROP/TRUNCATE 产物 csv 落源目录、manifest 保护源文件、
+  表清单实时感知产物文件
+- warehouse 源（excel 目录 + 单文件/glob）：物化写入 .duckdb、
+  COPY TO 导出、视图名碰撞拒绝、COPY 路径越界拒绝
+- classify_ddl 对 CREATE OR REPLACE TABLE 的解析（struct_change 事件链路）
+
+隔离：JIUWENSWARM_DATA_DIR + JIUWENSWARM_DATA_ROOTS 指向 tmp_path，
+并重置 utils._workspace_base_dir 模块缓存（否则首个用例的 home 会固化）；
+收尾 close_warehouses()（Windows 下文件锁阻碍 tmp_path 清理）。
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.common import db_connector
+
+pytest.importorskip("duckdb", reason="DuckDB is not installed")
+
+
+@pytest.fixture()
+def warehouse_env(tmp_path, monkeypatch):
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path))
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    from jiuwenswarm.common import utils
+
+    monkeypatch.setattr(utils, "_workspace_base_dir", None)
+    yield tmp_path
+    from jiuwenswarm.channels.web.dataagent.connectors.duckdb_connector import (
+        close_warehouses,
+    )
+
+    close_warehouses()
+
+
+@pytest.fixture()
+def csv_dir_ref(warehouse_env) -> str:
+    directory = warehouse_env / "sales"
+    directory.mkdir()
+    (directory / "orders.csv").write_text("id,amount\n1,100\n2,200\n3,300\n", encoding="utf-8")
+    return db_connector.build_file_source_ref("csv", str(directory))
+
+
+# --------------------------------------------------------------------------
+# csv 目录源：execute_write 基本路径（产物 csv 落源目录）
+# --------------------------------------------------------------------------
+def test_warehouse_ctas_and_query(csv_dir_ref, warehouse_env):
+    result = db_connector.execute(
+        csv_dir_ref, "CREATE OR REPLACE TABLE dwd_orders AS SELECT id, amount * 2 AS amt FROM orders"
+    )
+    assert result["affected_rows"] == 3
+    assert result["db"]["type"] == "duckdb"
+    out = warehouse_env / "sales" / "dwd_orders.csv"
+    assert out.exists()
+    assert out.read_text(encoding="utf-8").startswith("id,amt")
+    query = db_connector.query(csv_dir_ref, "SELECT * FROM dwd_orders ORDER BY id", limit=10)
+    assert query["rows"] == [[1, 200], [2, 400], [3, 600]]
+
+
+def test_warehouse_read_path_no_duckdb_file(csv_dir_ref, warehouse_env):
+    """锁消除核心断言：查看类入口不建 warehouse .duckdb 文件。"""
+    from jiuwenswarm.common import utils
+
+    db_connector.tables(csv_dir_ref)
+    db_connector.batch_stats(csv_dir_ref)
+    warehouse_dir = utils.get_user_workspace_dir() / "warehouse"
+    if warehouse_dir.exists():
+        assert not list(warehouse_dir.glob("*.duckdb"))
+        assert not list(warehouse_dir.glob("*.wal"))
+
+
+def test_warehouse_insert_into_materialized(csv_dir_ref):
+    db_connector.execute(csv_dir_ref, "CREATE TABLE dwd_orders AS SELECT * FROM orders")
+    result = db_connector.execute(
+        csv_dir_ref, "INSERT INTO dwd_orders SELECT id + 10, amount FROM orders"
+    )
+    assert result["affected_rows"] == 3
+    count = db_connector.query(csv_dir_ref, "SELECT COUNT(*) FROM dwd_orders", limit=1)
+    assert count["rows"] == [[6]]
+
+
+def test_warehouse_insert_with_column_list(csv_dir_ref):
+    """带列清单 INSERT（ETL 生成器实际形态）：目标表名须从 Schema 包裹中取出。
+
+    sqlglot 把 INSERT INTO "t" (cols) 的目标解析成 Schema(this=Table)，
+    直接取 stmt.this.name 会得空串 → "requires a target table name"。
+    """
+    db_connector.execute(csv_dir_ref, 'CREATE TABLE dwd_orders ("id" INT, "amount" INT)')
+    result = db_connector.execute(
+        csv_dir_ref,
+        'INSERT INTO "dwd_orders" ("id", "amount") '
+        'SELECT o."id" AS "id", o."amount" AS "amount" FROM "orders" AS "o"',
+    )
+    assert result["affected_rows"] == 3
+    count = db_connector.query(csv_dir_ref, "SELECT COUNT(*) FROM dwd_orders", limit=1)
+    assert count["rows"] == [[3]]
+
+
+def test_warehouse_view_name_collision_rejected(csv_dir_ref, warehouse_env):
+    with pytest.raises(Exception, match="conflicts with a source file view"):
+        db_connector.execute(csv_dir_ref, "CREATE OR REPLACE TABLE orders AS SELECT 1 AS x")
+    # 源文件原样
+    assert (warehouse_env / "sales" / "orders.csv").read_text(encoding="utf-8").startswith("id,amount")
