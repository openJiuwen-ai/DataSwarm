@@ -0,0 +1,252 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""seed_etl_tasks.py —— 把数仓 4 层 ETL 建模任务化（plan 阶段 5）。
+
+核心思路（用户拍板）：
+    数仓 4 层表（ODS→DWD→DWS→ADS）的"建表+数据转换 SQL"用编排任务承载，
+    不再是 custom_layered_design.py 的静态 plan_table。每条 INSERT...SELECT
+    ETL 变成一个 SQL 任务；任务执行时建表灌数 + 自动产出血缘边（plan §3.3）。
+    这些任务按分层依赖组成一个 DAG 工作流（ODS→DWD→DWS→ADS）。
+
+任务 SQL 形态（用户选）：只把 INSERT...SELECT 作为任务 code；建表 DDL 预先在
+    Doris 建好（custom_layered_design 的 ddl_sql 已跑过），任务只灌数+产血缘。
+
+血缘产出：任务 publish（构建时，plan_id=task_id）+ debug 执行（运行时，
+    plan_id=instance_id）都会调 lineage_writer 解析 INSERT...SELECT 写
+    table_lineage/column_lineage。debug 工作流一次跑完整分层，产全量血缘。
+
+工作流 DAG（分层依赖）：
+    DWD 层（3 任务，源=ODS，无前驱）：
+        dwd_order_detail / dwd_order_payment / dwd_order_review
+    DWS 层（5 任务，源=DWD，前驱=对应 DWD 任务的节点）：
+        dws_trade_order_1d / dws_category_sale_1d / dws_customer_repurchase_1d
+        / dws_delivery_performance_1d（前 4 个依赖 dwd_order_detail 节点）
+        dws_payment_type_1d（依赖 dwd_order_payment 节点）
+    ADS 层（5 任务，源=DWS，前驱=对应 DWS 任务的节点）：
+        ads_gmv_daily / ads_order_count_daily（依赖 dws_trade_order_1d 节点）
+        ads_customer_repurchase（依赖 dws_customer_repurchase_1d 节点）
+        ads_delivery_performance（依赖 dws_delivery_performance_1d 节点）
+        ads_category_sales_distribution（依赖 dws_category_sale_1d 节点）
+
+用法:
+    python -m jiuwenswarm.channels.web.orchestration.seed_etl_tasks          # 建+publish
+    python -m jiuwenswarm.channels.web.orchestration.seed_etl_tasks --debug   # 建后 debug 跑工作流
+    python -m jiuwenswarm.channels.web.orchestration.seed_etl_tasks --clean    # 清演示 ETL 任务/工作流
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import logging
+import sys
+from pathlib import Path
+
+from . import db as orch_db
+
+# 复用 dw-ops 的 ETL 设计（同一份 SQL，避免分叉）
+# seed_etl_tasks.py 在 jiuwenswarm/channels/web/orchestration/，回退到 scripts/dw-ops
+_DW_OPS_DIR = (Path(__file__).resolve().parent.parent.parent.parent.parent
+               / "scripts" / "dw-ops")
+if str(_DW_OPS_DIR) not in sys.path:
+    sys.path.insert(0, str(_DW_OPS_DIR))
+import custom_layered_design as cld  # type: ignore  # noqa: E402
+
+logger = logging.getLogger(__name__)
+
+# 演示数据固定 ID
+DEMO_WF_ID = "demo_wf_warehouse_etl"
+# task_id 前缀（table_name_short 作后缀）
+TASK_PREFIX = "demo_etl_"
+
+# 业务库 db-ref：跟随当前工作空间业务库（多工作空间收口：函数化，不再 import 固化；
+# 仅服务端演示种子数据使用，属 legacy 兼容层）
+
+
+def _biz_db_ref() -> str:
+    try:
+        from jiuwenswarm.common import workspace_context
+        return workspace_context.business_db_ref()
+    except Exception as exc:  # noqa: BLE001 —— 无工作空间上下文时回退全局默认库
+        logger.debug("[seed-etl] 工作空间业务库解析失败，回退 default_db_ref: %s", exc)
+        pass
+    try:
+        from jiuwenswarm.common import db_connector
+        ref = db_connector.default_db_ref()
+        if ref:
+            return ref
+    except Exception as exc:  # noqa: BLE001 —— 均未配置时回退演示 doris://
+        logger.debug("[seed-etl] default_db_ref 解析失败，回退 doris://: %s", exc)
+        pass
+    return "doris://"
+
+
+def _design_all_etl() -> list[dict]:
+    """调 custom_layered_design 的 design 函数拿全部 13 个 ETL 的 SQL。
+
+    返回 [{table_name_short, etl_sql, source_tables(json str), layer}]。
+    DWD 传空 ods_schemas（etl_sql 写死，不依赖表结构）。
+    """
+    dwd = [
+        cld.design_dwd_order_detail({}),
+        cld.design_dwd_order_payment({}),
+        cld.design_dwd_order_review({}),
+    ]
+    dws = [
+        cld.design_dws_trade_order_1d(),
+        cld.design_dws_category_sale_1d(),
+        cld.design_dws_customer_repurchase_1d(),
+        cld.design_dws_delivery_performance_1d(),
+        cld.design_dws_payment_type_1d(),
+    ]
+    ads = [
+        cld.design_ads_gmv_daily(),
+        cld.design_ads_order_count_daily(),
+        cld.design_ads_customer_repurchase(),
+        cld.design_ads_delivery_performance(),
+        cld.design_ads_category_sales_distribution(),
+    ]
+    return dwd + dws + ads
+
+
+def _task_id_for(table_short: str) -> str:
+    return f"{TASK_PREFIX}{table_short}"
+
+
+def _node_id_for(table_short: str) -> str:
+    return f"node_{table_short}"
+
+
+def _parse_source_shorts(source_tables_json: str) -> list[str]:
+    """source_tables 是 ["olist.dwd_order_detail", ...] → 取短表名 ["dwd_order_detail"]。"""
+    try:
+        fqns = json.loads(source_tables_json or "[]")
+    except Exception:
+        return []
+    return [s.split(".")[-1] for s in fqns]
+
+
+def seed(debug: bool = False) -> None:
+    orch_db.init_db()
+
+    etls = _design_all_etl()
+    # 先清旧
+    for e in etls:
+        orch_db.delete_task(_task_id_for(e["table_name_short"]))
+    orch_db.delete_workflow(DEMO_WF_ID)
+
+    # 1. 建 13 个 ETL 任务（INSERT...SELECT）
+    task_by_short: dict[str, str] = {}  # table_short → task_id
+    for e in etls:
+        short = e["table_name_short"]
+        task_id = _task_id_for(short)
+        # 任务 code = 纯 INSERT...SELECT（建表 DDL 已在 Doris 预建）
+        # datasource_ref 指向业务库（Doris olist，4 层表所在）
+        orch_db.create_task({
+            "task_id": task_id,
+            "name": f"ETL-{short}",
+            "description": f"{e['layer']} 层 ETL：灌数 {short}（源：{e['source_tables']}）",
+            "executor_type": "sql",
+            "code": e["etl_sql"],
+            "datasource_ref": _biz_db_ref(),
+            "timeout_s": 600,
+            "sla_minutes": 5,
+            "layer": e["layer"],
+            "output_table": short,
+        })
+        task_by_short[short] = task_id
+        print(f"  [task] {task_id}  ({e['layer']} → {short})")
+
+    # 2. 建分层 DAG 工作流
+    # 节点上游：DWD 无前驱；DWS 前驱=其 source_tables 对应的 DWD 节点；
+    #           ADS 前驱=其 source_tables 对应的 DWS 节点。
+    nodes = []
+    for e in etls:
+        short = e["table_name_short"]
+        src_shorts = _parse_source_shorts(e["source_tables"])
+        # 上游节点 = 源表对应的节点（源表必在已建任务里，DWD 源=ODS 无节点→空前驱）
+        upstream_nodes = [_node_id_for(s) for s in src_shorts if s in task_by_short]
+        nodes.append({
+            "node_id": _node_id_for(short),
+            "task_id": task_by_short[short],
+            "node_name": short,
+            "group_name": e["layer"],
+            "order_index": {"DWD": 0, "DWS": 1, "ADS": 2}.get(e["layer"], 3),
+            "upstream_nodes": ",".join(upstream_nodes),
+            "wait_review": False,
+        })
+
+    orch_db.create_workflow({
+        "workflow_id": DEMO_WF_ID,
+        "name": "数仓分层 ETL 工作流",
+        "description": "ODS→DWD→DWS→ADS 分层 DAG：13 个 ETL 任务按层依赖",
+    })
+    orch_db.replace_nodes(DEMO_WF_ID, nodes)
+    print(f"  [workflow] {DEMO_WF_ID}  ({len(nodes)} 节点分层 DAG)")
+
+    # 3. publish 任务（构建时落库血缘，plan §3.3-B）
+    #    publish 会调 api._write_task_lineage_on_publish；这里直接调 writer（seed 脚本无 HTTP）
+    from .lineage import writer as lineage_writer
+    from .api import _db_name_from_ref
+    for e in etls:
+        short = e["table_name_short"]
+        task_id = task_by_short[short]
+        orch_db.set_task_status(task_id, "published")
+        default_db = _db_name_from_ref(_biz_db_ref())
+        r = lineage_writer.write_from_sql(
+            task_id=task_id, plan_id=task_id, sql=e["etl_sql"], default_db=default_db,
+        )
+        print(f"  [publish+lineage] {task_id}: inserted_t={r.inserted_table} "
+              f"ignored_t={r.ignored_table} inserted_c={r.inserted_column}")
+
+    # publish 工作流
+    orch_db.set_workflow_status(DEMO_WF_ID, "published")
+    print("\n数仓 ETL 任务化就绪：13 任务 + 1 分层工作流（已 publish，血缘已落库）")
+    print("验证：")
+    print("  - 数据管理页血缘图：应看到 ODS→DWD→DWS→ADS 全量分层边，节点带产出任务名")
+    print("  - 数仓治理→巡检→血缘维度：同一张图（读 table_lineage）")
+    if debug:
+        print("\n--debug：启动 web 后在「数据开发」debug 工作流，真实建表+运行时血缘")
+    else:
+        print("\n下一步：启动 web → 数据开发 → 工作流「数仓分层 ETL 工作流」→ debug 跑全流程")
+
+
+def clean() -> None:
+    etls = _design_all_etl()
+    for e in etls:
+        short = e["table_name_short"]
+        tid = _task_id_for(short)
+        if orch_db.delete_task(tid):
+            print(f"deleted task {tid}")
+    # 清该任务写的血缘（table_lineage / column_lineage）
+    from .lineage import writer as lineage_writer
+    try:
+        from jiuwenswarm.common import db_connector  # noqa: E402
+        ref = lineage_writer._default_db_ref()
+        for e in etls:
+            short = e["table_name_short"]
+            tid = _task_id_for(short)
+            db_connector.execute(
+                ref, "DELETE FROM table_lineage WHERE task_id = ?", (tid,), commit=False)
+            db_connector.execute(
+                ref, "DELETE FROM column_lineage WHERE task_id = ?", (tid,), commit=False)
+        db_connector.execute(ref, "SELECT 1", commit=True)
+        print("cleaned lineage edges for demo ETL tasks")
+    except Exception as e:
+        print(f"clean lineage skipped: {e}")
+    if orch_db.delete_workflow(DEMO_WF_ID):
+        print(f"deleted workflow {DEMO_WF_ID}")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="数仓 4 层 ETL 任务化 seed")
+    ap.add_argument("--debug", action="store_true", help="建后提示 debug 跑工作流")
+    ap.add_argument("--clean", action="store_true", help="清演示 ETL 任务/工作流/血缘")
+    args = ap.parse_args()
+    if args.clean:
+        clean()
+    else:
+        seed(debug=args.debug)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
