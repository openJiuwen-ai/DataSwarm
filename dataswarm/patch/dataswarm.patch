+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 数据源工作空间选择器（多工作空间方案 P2-2/P2-5）。
+ *
+ * 两处挂载：欢迎页「选择项目」一行（work-row：可切换下拉，样式同项目选择器，
+ * 参考高保真「选择数仓」）与会话内输入框工具栏（toolbar：静态展示当前工作空间，
+ * 不可切换）。治理页跟随 WorkspaceContextBar（共享同一 store）。
+ * 下拉展示 name + 库名摘要（后端脱敏摘要）。
+ */
+import { useEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { Database, Check } from 'lucide-react';
+import clsx from 'clsx';
+import { useTranslation } from 'react-i18next';
+import { useChatStore } from '../../stores/chatStore';
+import { useSessionStore } from '../../stores/sessionStore';
+import {
+  useDatasourceWorkspaceStore,
+  workspaceBucket,
+  type DatasourceWorkspaceSummary,
+} from '../../stores/datasourceWorkspaceStore';
+import { CreateWorkspaceDialog } from '../CreateWorkspaceDialog';
+import { EditWorkspaceDialog } from '../EditWorkspaceDialog';
+import { WorkspaceRowMenu } from '../WorkspaceRowMenu';
+
+interface WorkspaceSelectorProps {
+  /** work-row：欢迎页项目选择行内，可展开切换；toolbar：会话内工具栏静态展示（不可切换） */
+  variant?: 'work-row' | 'toolbar';
+  /** 选中变化回调（P2-2：通知会话层更新 session metadata） */
+  onChange?: (workspaceId: string) => void;
+  disabled?: boolean;
+}
+
+function summaryLabel(ws: DatasourceWorkspaceSummary, unboundLabel: string): string {
+  const biz = ws.business
+    ? (ws.business.database || ws.business.type || '?')
+    : unboundLabel;
+  const meta = ws.metadata?.database || ws.metadata?.type || '?';
+  return `${biz} / ${meta}`;
+}
+
+/** 当前激活会话归属的工作空间 id（决策四：toolbar 展示会话归属而非全局选择）。 */
+function useActiveSessionWorkspaceId(): string {
+  const activeSessionId = useChatStore((s) => s.activeSessionId);
+  return useSessionStore((s) => {
+    if (!activeSessionId) return '';
+    const session = s.currentSession?.session_id === activeSessionId
+      ? s.currentSession
+      : s.sessions.find((item) => item.session_id === activeSessionId);
+    return session?.workspace_id ?? '';
+  });
+}
+
+export function WorkspaceSelector({ variant = 'toolbar', onChange, disabled = false }: WorkspaceSelectorProps) {
+  const { t } = useTranslation();
+  const { workspaces, currentWorkspaceId, isLoading, error, loadWorkspaces, setCurrentWorkspace } =
+    useDatasourceWorkspaceStore();
+  const [open, setOpen] = useState(false);
+  const [showNotice, setShowNotice] = useState(false);
+  const [createOpen, setCreateOpen] = useState(false);
+  const [editing, setEditing] = useState<DatasourceWorkspaceSummary | null>(null);
+  const noticeDismissedFor = useRef<string | null>(null);
+  const rootRef = useRef<HTMLDivElement>(null);
+
+  // 切换提示 5s 自动消失
+  useEffect(() => {
+    if (!showNotice) return;
+    const timer = window.setTimeout(() => setShowNotice(false), 5000);
+    return () => window.clearTimeout(timer);
+  }, [showNotice]);
+
+  // 单工作空间（或未配置 workspaces 段）不显示选择器——默认工作空间无选择语义
+  useEffect(() => {
+    void loadWorkspaces();
+  }, [loadWorkspaces]);
+
+  // 每次打开强制重拉：绑定可能来自数据源页 / 对话内 skill，store 快照未必最新
+  useEffect(() => {
+    if (open) void loadWorkspaces();
+  }, [open, loadWorkspaces]);
+
+  useEffect(() => {
+    if (!open) return;
+    const onDocMouseDown = (event: MouseEvent) => {
+      const target = event.target as Node;
+      if (rootRef.current?.contains(target)) return;
+      // 行内「…」弹层 portal 到 body：不算外部点击（点完选项自行关外层）
+      if (target instanceof Element && target.closest('[data-workspace-row-menu]')) return;
+      setOpen(false);
+    };
+    document.addEventListener('mousedown', onDocMouseDown);
+    return () => document.removeEventListener('mousedown', onDocMouseDown);
+  }, [open]);
+
+  const current = workspaces.find((ws) => ws.workspace_id === currentWorkspaceId) ?? null;
+  const unboundLabel = t('datasourceWorkspace.unbound');
+
+  // 会话内工具栏：静态展示会话归属的工作空间（不可切换；全局切换入口在欢迎页）。
+  // 决策四：跨空间打开会话时应显示会话自己的归属，而非全局当前选择。
+  // 注意：hook 必须在下方早返回之前调用——workspaces.length/isLoading 变化会触发
+  // 该早返回，hook 位置在返回之后会导致两次渲染 hook 数量不一致（React 崩溃）。
+  const sessionWorkspaceId = useActiveSessionWorkspaceId();
+  const sessionWorkspaceName = (() => {
+    const bucket = workspaceBucket(sessionWorkspaceId);
+    if (!sessionWorkspaceId && bucket === 'default') return null; // 无归属信息 → 维持旧展示
+    return workspaces.find((ws) => ws.workspace_id === bucket)?.name
+      ?? (bucket === 'default' ? null : bucket);
+  })();
+
+  if (workspaces.length <= 1 && !error) {
+    // 仅默认工作空间：不渲染（保持 UI 与单库时代一致）
+    if (!isLoading && workspaces.length <= 1) return null;
+  }
+
+  const title = current
+    ? `${current.name}（${summaryLabel(current, unboundLabel)}）`
+    : error
+      ? `${t('datasourceWorkspace.loadFailed')}${error}`
+      : t('datasourceWorkspace.selectTitle');
+
+  if (variant === 'toolbar') {
+    return (
+      <div
+        className="chat-datasource-select chat-datasource-select--static"
+        title={sessionWorkspaceName ? t('datasourceWorkspace.sessionOwnerTitle', { name: sessionWorkspaceName }) : title}
+      >
+        <Database className="chat-input-btn-icon" strokeWidth={1.8} aria-hidden="true" />
+        <span className="chat-datasource-select__label">
+          {sessionWorkspaceName ?? (current ? current.name : '')}
+        </span>
+      </div>
+    );
+  }
+
+  const pick = (workspaceId: string) => {
+    const previous = current?.workspace_id ?? currentWorkspaceId;
+    setCurrentWorkspace(workspaceId);
+    setOpen(false);
+    onChange?.(workspaceId);
+    // 决策四切换语义：会话内已有产物时给出一次性提示（不追溯已有产物）
+    if (noticeDismissedFor.current !== workspaceId && previous && previous !== workspaceId) {
+      noticeDismissedFor.current = workspaceId;
+      setShowNotice(true);
+    }
+  };
+
+  // 欢迎页「选择项目」一行：触发钮/下拉样式同项目选择器（chat-work-select）
+  return (
+    <div
+      ref={rootRef}
+      className={clsx('chat-work-select', 'chat-datasource-select--work-row', open && 'chat-work-select--open')}
+      data-testid="chat-panel-datasource-select"
+    >
+      <button
+        type="button"
+        className="chat-work-select__trigger chat-work-select__trigger--selected"
+        onClick={() => {
+          if (disabled) return;
+          setOpen((value) => !value);
+        }}
+        disabled={disabled}
+        title={title}
+        aria-haspopup="menu"
+        aria-expanded={open}
+      >
+        <Database size={16} strokeWidth={1.8} aria-hidden="true" />
+        <span>{current?.name ?? t('datasourceWorkspace.selectTitle')}</span>
+        <svg className="chat-work-select__chevron" width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" strokeWidth={1.8} aria-hidden="true">
+          <path strokeLinecap="round" strokeLinejoin="round" d="M6 8l4 4 4-4" />
+        </svg>
+      </button>
+      {showNotice && createPortal(
+        <div
+          className="app-toast-wrapper app-toast-wrapper--top-center"
+          style={{ position: 'fixed', top: 12, left: '50%', transform: 'translateX(-50%)', zIndex: 1100 }}
+          role="status"
+        >
+          <div className="app-session-toast">{t('datasourceWorkspace.switchNotice')}</div>
+        </div>,
+        document.body,
+      )}
+      {open && (
+        <div className="chat-work-select__menu chat-datasource-select__menu" role="menu">
+          {error && (
+            <div className="chat-datasource-select__error">{t('datasourceWorkspace.loadFailed')}{error}</div>
+          )}
+          {workspaces.map((ws) => {
+            const active = ws.workspace_id === (current?.workspace_id ?? currentWorkspaceId);
+            return (
+              <div
+                key={ws.workspace_id}
+                className={clsx('chat-work-select__option', active && 'is-active')}
+                role="menuitemradio"
+                aria-checked={active}
+                title={`${ws.business?.type || ''}:${summaryLabel(ws, unboundLabel)}`}
+                onClick={() => pick(ws.workspace_id)}
+              >
+                <Database className="chat-datasource-select__option-icon" size={14} />
+                <span className="chat-datasource-select__option-text">
+                  <span className="chat-datasource-select__option-name">{ws.name}</span>
+                  <span className="chat-datasource-select__option-summary">{summaryLabel(ws, unboundLabel)}</span>
+                  {ws.description ? (
+                    <span className="chat-datasource-select__option-description">{ws.description}</span>
+                  ) : null}
+                </span>
+                {active ? <Check size={14} className="chat-work-select__check" /> : null}
+                {ws.origin !== 'yaml' && ws.workspace_id !== 'default' && (
+                  <WorkspaceRowMenu
+                    workspace={ws}
+                    onEdit={setEditing}
+                    onAction={() => setOpen(false)}
+                  />
+                )}
+              </div>
+            );
+          })}
+          {workspaces.length === 0 && !error && !isLoading && (
+            <div className="chat-work-select__empty">{t('datasourceWorkspace.empty')}</div>
+          )}
+          <button
+            type="button"
+            className="chat-work-select__option"
+            onClick={() => {
+              setOpen(false);
+              setCreateOpen(true);
+            }}
+          >
+            <span className="chat-datasource-select__option-text">{t('datasourceWorkspace.createAction')}</span>
+          </button>
+        </div>
+      )}
+      <CreateWorkspaceDialog open={createOpen} onClose={() => setCreateOpen(false)} />
+      {editing && (
+        <EditWorkspaceDialog workspace={editing} open onClose={() => setEditing(null)} />
+      )}
+    </div>
+  );
+}
