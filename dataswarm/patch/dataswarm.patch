index 000000000..a91070de0
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/graph_projection.py
@@ -0,0 +1,401 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/graph_projection.py —— Metric 节点投影进 Neo4j 语义图（深集成写侧）。
+
+复用语义层 :class:`~..semantic.semantica.SemanticaAdapter` 的
+stage/validate/publish 协议，namespace ``metrics/{workspace}``，与同事的
+``physical/{ws}/{source_id}``、``glossary/{ws}`` 同库并存——图上打通
+「术语 → 指标 → 表列」跨层链路。
+
+写侧纪律（与物理层同一模式）：
+
+- **整 namespace 先删后写**：GraphBuilder 纯 CREATE 无 MERGE，publish 前
+  ``delete_graph_nodes`` 清旧节点防累积；投影范围 = workspace 全部**当前
+  生效**指标（current_revision 且 published），非仅本批修订——否则整删
+  会丢掉其他指标的节点。
+- **跨 namespace 边直写**：usesTable/usesColumn/timeField/canGroupBy 指向
+  physical 稳定 ID、measuresConcept 指向 glossary Term——semantica 0.7 的
+  ``GraphStore.create_relationship`` 靠**进程内** ``_app_node_id_map`` 解析
+  边端点，跨进程/跨 namespace 必失配且 ``add_edges`` 静默丢边（已核实 SDK
+  源码），故跨边不进 GraphBuilder payload，经 ``create_cross_edges`` 协议
+  扩展直写；协议未落地时自动降级（跨边不产出 + warning，不阻塞发布）。
+- **脱敏红线**：节点只带公式摘要（``formula_summary``），绝无表达式原文、
+  连接串、凭据；完整可执行口径永远从 ``dw_metric_revisions`` 按
+  ``definitionRef`` 回读（与旧投影 ``assert_no_raw_expression`` 同一纪律）。
+- **元数据库是真相源**：投影失败不回滚发布（release 照常 published，
+  ``projection_status=failed`` 可 reproject 重试），对齐 glossary
+  「投影失败不回滚表写」。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from . import store
+from .model import (
+    MAP_CONFIRMED,
+    MetricDef,
+    MetricRevision,
+    Release,
+)
+from .projection import build_field_labels, formula_summary, slugify
+from .semantic_link import binding_to_snapshot, resolve_source_map, snapshot_index
+
+# Neo4j 关系类型只允许 [A-Za-z0-9_]（跨边直写时即关系类型名）
+EDGE_DEPENDS_ON = "dependsOn"
+EDGE_NUMERATOR = "numerator"
+EDGE_DENOMINATOR = "denominator"
+EDGE_MEASURES_CONCEPT = "measuresConcept"
+EDGE_USES_TABLE = "usesTable"
+EDGE_USES_COLUMN = "usesColumn"
+EDGE_TIME_FIELD = "timeField"
+EDGE_CAN_GROUP_BY = "canGroupBy"
+
+METRIC_NODE_TYPE = "Metric"
+CONCEPT_NODE_TYPE = "BusinessConcept"
+
+
+def metrics_namespace(workspace_id: str) -> str:
+    """指标图 namespace（与 physical/glossary 同库不同 namespace）。"""
+    return f"metrics/{workspace_id}"
+
+
+def metric_node_id(workspace_id: str, metric_key: str) -> str:
+    """指标节点稳定 ID（跨 release 稳定；中文 key 经 slug 化，原文在属性）。"""
+    return f"metric:{workspace_id}:{slugify(metric_key)}"
+
+
+def build_metric_projection(
+    workspace_id: str,
+    release: Release,
+    revisions: list[MetricRevision],
+    defs_by_id: dict[str, MetricDef],
+    bindings_by_revision: dict[str, list[Any]],
+    confirmed_maps: list[Any],
+    supersedes: dict[str, str],
+    snapshots: dict[str, Any],
+) -> tuple[Any, list[Any]]:
+    """当前生效指标 → (in-projection, 跨 namespace 边)。
+
+    Args:
+        revisions: 本批修订（节点属性冻结用当前生效修订——由调用方保证
+            revisions 即当前生效集合或全量投影的一部分）。
+        snapshots: 语义层快照（跨边端点解析；空 dict 时跨边降级缺失）。
+
+    Returns:
+        ``(GraphProjection, cross_edges)``——projection 内节点/边可过
+        ``_validate_projection``（端点都在节点集内）；cross_edges 端点指向
+        physical/glossary 的稳定 ID，须直写。
+    """
+    from ..semantic.graph import GraphEdge, GraphNode, GraphProjection
+
+    def _new_concept_node(concept_id: str, label: str) -> GraphNode:
+        return GraphNode(concept_id, CONCEPT_NODE_TYPE, {"label": label})
+
+    # 全量投影：workspace 全部当前生效 published 修订（整 namespace 替换语义），
+    # 走 store 单一出处（E6 收敛——原循环就地重抄的 archived +
+    # published 判定与 list_effective_published 逐条等价，纯重构）
+    effective: dict[str, tuple[MetricDef, MetricRevision]] = {
+        metric.metric_key: (metric, revision)
+        for metric, revision in store.list_effective_published(workspace_id)
+    }
+    batch_keys = {_metric_key_of(r): r for r in revisions}
+    # 本批修订尚未 set_current（发布中）——也纳入（发布成功后它们即当前生效）
+    for key, revision in batch_keys.items():
+        if key not in effective:
+            metric_def = defs_by_id.get(revision.metric_id)
+            if metric_def is not None:
+                effective[key] = (metric_def, revision)
+
+    field_labels = build_field_labels(revisions, _flatten(bindings_by_revision))
+    source_map = resolve_source_map(workspace_id)
+    source_indexes = {source_id: snapshot_index({source_id: snapshot})
+                      for source_id, snapshot in snapshots.items()}
+    nodes: dict[str, GraphNode] = {}
+    edges: list[GraphEdge] = []
+    cross_edges: list[GraphEdge] = []
+    concept_nodes: dict[str, GraphNode] = {}
+
+    for key, (metric_def, revision) in effective.items():
+        node_id = metric_node_id(workspace_id, key)
+        properties: dict[str, Any] = {
+            "metricKey": key,
+            "displayName": revision.display_name or metric_def.name,
+            "description": metric_def.description or "",
+            "unit": revision.unit,
+            "operator": revision.expression.parsed.operator if revision.expression.parsed else "",
+            "formula": formula_summary(revision, field_labels=field_labels),
+            "revision": revision.revision_no,
+            "definitionRef": revision.definition_ref,
+            "definitionHash": revision.definition_hash,
+            "synonyms": list(revision.synonyms),
+            "releaseId": release.release_id,
+            "workspaceId": workspace_id,
+            "authority": "dataswarm",
+            "status": "published",
+        }
+        previous = (supersedes or {}).get(revision.revision_id)
+        if previous:
+            properties["supersedesRef"] = previous
+        nodes[node_id] = GraphNode(node_id, METRIC_NODE_TYPE, properties)
+
+        # 跨 namespace 边：usesTable/usesColumn/timeField/canGroupBy → physical
+        for binding in bindings_by_revision.get(revision.revision_id, ()):
+            if not binding.source_table:
+                continue
+            table_id, column_nodes = binding_to_snapshot(binding, source_map, source_indexes)
+            if not table_id:
+                continue  # 快照解析不到（源未采集/表改名）——不产悬空边
+            cross_edges.append(GraphEdge(node_id, table_id, EDGE_USES_TABLE))
+            if revision.time_dimension:
+                column = _column_of(revision.time_dimension)
+                physical = binding.column_map.get(column, column)
+                target = column_nodes.get(physical)
+                if target:
+                    cross_edges.append(GraphEdge(node_id, target, EDGE_TIME_FIELD))
+            for dimension in revision.allowed_dimensions:
+                column = _column_of(dimension)
+                physical = binding.column_map.get(column, column)
+                target = column_nodes.get(physical)
+                if target:
+                    cross_edges.append(GraphEdge(node_id, target, EDGE_CAN_GROUP_BY))
+
+    # 已确认业务映射（candidate 一律不投影——与旧投影规则③一致）
+    for mapping in confirmed_maps:
+        if mapping.status != MAP_CONFIRMED:
+            continue
+        mapped_revision = _find_revision(revisions, mapping.revision_id)
+        if mapped_revision is None:
+            continue
+        source = metric_node_id(workspace_id, _metric_key_of(mapped_revision))
+        if mapping.relation_type == "measuresConcept":
+            target = _glossary_term_node_id(workspace_id, mapping.target_ref)
+            if target:
+                cross_edges.append(GraphEdge(
+                    source, target, EDGE_MEASURES_CONCEPT,
+                    {"evidence": mapping.evidence}))
+                continue
+            # 未命中术语：保留 metrics namespace 内的概念节点（旧行为，信息不丢）
+            concept_id = _concept_node_id(mapping.target_ref)
+            if concept_id not in concept_nodes:
+                concept_nodes[concept_id] = _new_concept_node(
+                    concept_id, mapping.target_ref)
+            edges.append(GraphEdge(source, concept_id, EDGE_MEASURES_CONCEPT,
+                                   {"evidence": mapping.evidence}))
+            continue
+        edge_type = {
+            "dependsOn": EDGE_DEPENDS_ON,
+            "numerator": EDGE_NUMERATOR,
+            "denominator": EDGE_DENOMINATOR,
+        }.get(mapping.relation_type)
+        if edge_type is None:
+            continue
+        edges.append(GraphEdge(source, metric_node_id(workspace_id, mapping.target_ref),
+                               edge_type, {"evidence": mapping.evidence}))
+
+    for concept_node in concept_nodes.values():
+        nodes[concept_node.id] = concept_node
+    projection = GraphProjection(nodes=list(nodes.values()), edges=edges)
+    _assert_no_raw_expression(projection)
+    return projection, cross_edges
+
+
+def publish_metric_graph(
+    workspace_id: str,
+    release: Release,
+    revisions: list[MetricRevision],
+    defs_by_id: dict[str, MetricDef],
+    bindings_by_revision: dict[str, list[Any]],
+    confirmed_maps: list[Any],
+    supersedes: dict[str, str],
+    snapshots: dict[str, Any] | None,
+    *,
+    adapter: Any,
+) -> dict:
+    """构建并发布指标图（整 namespace 先删后写 + 跨 namespace 边直写）。
+
+    Returns:
+        ``{"version", "node_count", "edge_count", "cross_created",
+        "cross_missed", "warnings"}``——跨边协议未落地时 cross_* 为 0 并记
+        ``cross_edges_unsupported`` warning（降级不阻塞）。
+
+    Raises:
+        Exception: adapter 任何失败原样抛出——调用方（publish_release）捕获后
+        标 ``projection_status=failed``，不回滚发布（真相源是元数据库）。
+    """
+    from .semantic_link import current_snapshots
+
+    if snapshots is None:
+        _refs, snapshots = current_snapshots()
+    projection, cross_edges = build_metric_projection(
+        workspace_id, release, revisions, defs_by_id, bindings_by_revision,
+        confirmed_maps, supersedes, snapshots)
+    namespace = metrics_namespace(workspace_id)
+    version = release.release_id
+    warnings: list[str] = []
+
+    adapter.delete_graph_nodes(namespace)
+    stage_id = adapter.stage(namespace, version, projection)
+    adapter.validate(stage_id)
+    result = adapter.publish(stage_id)
+
+    cross_created = 0
+    cross_missed = len(cross_edges)
+    create_cross = getattr(adapter, "create_cross_edges", None)
+    if cross_edges and create_cross is None:
+        # 契约未落地（同事 SemanticaAdapter 尚无 create_cross_edges）——降级
+        warnings.append("cross_edges_unsupported")
+    elif cross_edges and create_cross is not None:
+        outcome = create_cross(namespace, cross_edges)
+        cross_created = int(outcome.get("created", 0))
+        cross_missed = int(outcome.get("missed", 0))
+        if cross_missed:
+            warnings.append(f"cross_link_missed:{cross_missed}")
+    return {
+        "version": version,
+        "node_count": result.node_count,
+        "edge_count": result.edge_count,
+        "cross_created": cross_created,
+        "cross_missed": cross_missed,
+        "warnings": warnings,
+    }
+
+
+def reproject_workspace(workspace_id: str, *, adapter: Any = None) -> dict:
+    """全量重投影当前生效指标（修复 projection_status=failed 的运维入口）。
+
+    adapter 缺省从环境构造（生产 Neo4j）；任何失败原样抛出。
+    """
+    from .model import REVISION_PUBLISHED
+
+    if adapter is None:
+        from ..semantic.semantica import from_environment
+
+        adapter = from_environment()
+    defs = store.list_defs(workspace_id)
+    revisions: list[MetricRevision] = []
+    defs_by_id: dict[str, MetricDef] = {}
+    bindings: dict[str, list[Any]] = {}
+    for metric in defs:
+        defs_by_id[metric.metric_id] = metric
+        if not metric.current_revision_id:
+            continue
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is None or revision.status != REVISION_PUBLISHED:
+            continue
+        revisions.append(revision)
+        bindings[revision.revision_id] = store.list_bindings(revision.revision_id)
+    active = store.get_active_release(workspace_id)
+    if active is None and not revisions:
+        raise ProjectionUnavailableError(
+            f"workspace {workspace_id} 没有已发布指标，无可重投影内容")
+    release = active or Release(
+        release_id=f"reproject-{store.new_id('release')}",
+        workspace_id=workspace_id, status="published",
+        revision_ids=tuple(r.revision_id for r in revisions))
+    confirmed = store.list_confirmed_maps([r.revision_id for r in revisions])
+    return publish_metric_graph(
+        workspace_id, release, revisions, defs_by_id, bindings, confirmed,
+        {}, None, adapter=adapter)
+
+
+class ProjectionUnavailableError(Exception):
+    """重投影前置条件不满足（无已发布指标 / adapter 不可用）。"""
+
+
+def resolve_term(target_ref: str) -> dict[str, Any] | None:
+    """``concept_map.target_ref`` → glossary 术语（两条绑定链路统一收口）。
+
+    **先按 term_id 直查，再退 name/别名全等**：
+
+    - 界面绑定链路存的是 **term_id**（人从术语列表点选，无需匹配）；
+    - Ossie 导入链路存的是自由文本（导入时已尽量解析成 term_id，解析不到
+      的历史数据仍是原文）——对这类引用保留精确名字匹配。
+
+    只做**精确**匹配：模糊匹配会把 measuresConcept 边指向错误术语。废弃
+    术语一律按未命中（不产悬挂边）。
+
+    Args:
+        target_ref: 映射的目标引用（term_id 或术语名/别名）。
+
+    Returns:
+        术语 dict；未命中 / 术语库不可用 → None。
+    """
+    ref = str(target_ref or "").strip()
+    if not ref:
+        return None
+    try:
+        from ..glossary import db as glossary_db
+    except Exception:  # noqa: BLE001 —— glossary 模块不可用按未命中处理
+        return None
+    try:
+        term = glossary_db.get_term(ref)
+        if term is not None:
+            return None if str(term.get("status") or "active") == "deprecated" else term
+        normalized = glossary_db.normalize_alias(ref)
+        for candidate in glossary_db.list_terms(status="active"):
+            if str(candidate.get("status") or "active") == "deprecated":
+                continue
+            if glossary_db.normalize_alias(str(candidate.get("name") or "")) == normalized:
+                return candidate
+            for synonym in glossary_db.parse_synonyms(candidate.get("synonyms")):
+                if glossary_db.normalize_alias(synonym) == normalized:
+                    return candidate
+    except Exception:  # noqa: BLE001 —— 术语库查询失败按未命中，不阻塞投影
+        return None
+    return None
+
+
+def _glossary_term_node_id(workspace_id: str, target_ref: str) -> str | None:
+    """业务概念 → Term 稳定 ID（未命中返回 None，调用方保留概念节点）。"""
+    term = resolve_term(target_ref)
+    if term is None or not term.get("term_id"):
+        return None
+    return f"term:{workspace_id}:{term['term_id']}"
+
+
+def _concept_node_id(target_ref: str) -> str:
+    """metrics namespace 内概念节点 ID（未命中 glossary 时的保留形态）。"""
+    return f"concept:{slugify(target_ref)}"
+
+
+def _column_of(logical: str) -> str:
+    """``orders.amount`` / 裸 ``amount`` → 列名。"""
+    return logical.split(".", 1)[1] if "." in logical else logical
+
+
+def _flatten(bindings_by_revision: dict[str, list[Any]]) -> list[Any]:
+    out: list[Any] = []
+    for items in bindings_by_revision.values():
+        out.extend(items)
+    return out
+
+
+def _find_revision(revisions: list[MetricRevision], revision_id: str) -> MetricRevision | None:
+    for revision in revisions:
+        if revision.revision_id == revision_id:
+            return revision
+    return None
+
+
+def _metric_key_of(revision: MetricRevision) -> str:
+    metric = store.get_def(revision.metric_id)
+    return metric.metric_key if metric is not None else ""
+
+
+def _assert_no_raw_expression(projection: Any) -> None:
+    """脱敏守卫：节点属性不得出现表达式原文（与旧投影同纪律）。
+
+    ``formula_summary``（``SUM(订单金额)``/``比值(...)``）是合法展示形态；
+    拦的是**可执行 SQL 片段**（CASE WHEN / SELECT-FROM-WHERE 多段结构）。
+    """
+    from .errors import ProjectionError
+
+    forbidden_markers = ("CASE WHEN", "SELECT ", " FROM ", " WHERE ")
+    for node in projection.nodes:
+        for value in node.properties.values():
+            if not isinstance(value, str):
+                continue
+            upper = value.upper()
+            hits = [marker for marker in forbidden_markers if marker in upper]
+            if hits and value.count(" ") >= 2:
+                raise ProjectionError(
+                    f"图节点疑似携带表达式原文: {node.id}（含 {'/'.join(hits)}）")
