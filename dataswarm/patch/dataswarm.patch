+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useMemo, useState, useSyncExternalStore } from 'react';
+import { ChevronLeft, PanelRightOpen, Plus, Trash2 } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import { orchestrationApi } from '../api/orchestrationApi';
+import { getCurrentDatasourceWorkspaceId } from '../../../stores/datasourceWorkspaceStore';
+import type { NodeInput, TaskDefinition, WorkflowDefinition } from '../types/orchestration';
+import SqlIcon from '../../../assets/data-development/sql.svg?react';
+import PythonIcon from '../../../assets/data-development/python.svg?react';
+import UndoIcon from '../../../assets/data-development/undo.svg?react';
+import RedoIcon from '../../../assets/data-development/redo.svg?react';
+import { HifiStatus } from './shared/Hifi';
+import { RowMenu } from './shared/RowMenu';
+import { WorkflowDocument, removeWorkflowNodes } from '../store/workflowDocument';
+import { useAction } from '../../_shared/ui/Feedback';
+import { Button, confirmDialog, Empty, toast } from './shared/Ui';
+import { WorkflowDag } from './WorkflowDag';
+import { NodeEditDrawer } from './NodeEditDrawer';
+import { WorkflowDetails } from './WorkflowDetails';
+import { WorkflowRuns } from './WorkflowRuns';
+import type { WorkflowTab } from '../developmentRoute';
+import { generateUuidV4 } from '../../../utils/uuid';
+
+interface Props {
+  workflowId: string;
+  onBack: () => void;
+  onShowRuns: (refId: string, instanceId?: string) => void;
+  tab?: WorkflowTab;
+  instanceId?: string | null;
+  onTabChange?: (tab: WorkflowTab) => void;
+  onSelectInstance?: (id: string, replace?: boolean) => void;
+}
+
+type LoadedWorkflow = {
+  workflow: WorkflowDefinition;
+  tasks: TaskDefinition[];
+  document: WorkflowDocument;
+  unsubscribe?: () => void;
+};
+// Retain unsaved documents across in-app navigation, including failed requests.
+const openDocuments = new Map<string, LoadedWorkflow>();
+window.addEventListener('beforeunload', (event) => {
+  if ([...openDocuments.values()].some((entry) => entry.document.dirty)) {
+    event.preventDefault();
+    event.returnValue = '';
+  }
+});
+
+export function WorkflowEditPage(props: Props) {
+  const { t } = useTranslation();
+  const [loaded, setLoaded] = useState<LoadedWorkflow | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  useEffect(() => {
+    let active = true;
+    const workspace = getCurrentDatasourceWorkspaceId();
+    const key = `${workspace}:${props.workflowId}`;
+    let entry = openDocuments.get(key);
+    let unsubscribe: (() => void) | undefined;
+    const attach = (value: LoadedWorkflow) => {
+      value.unsubscribe?.();
+      entry = value;
+      openDocuments.set(key, value);
+      setLoaded(value);
+      unsubscribe = value.unsubscribe = value.document.subscribe(() => {
+        if (!active && !value.document.dirty) {
+          openDocuments.delete(key);
+          unsubscribe?.();
+        }
+      });
+    };
+    setLoaded(null);
+    setError(null);
+    if (entry) attach(entry);
+    else
+      void Promise.all([orchestrationApi.getWorkflow(props.workflowId), orchestrationApi.allTasks()])
+        .then(([workflow, tasks]) => {
+          if (!active) return;
+          const nodes = (workflow.nodes ?? []).map((n) => ({
+            node_id: n.node_id,
+            task_id: n.task_id,
+            node_name: n.node_name ?? '',
+            group_name: n.group_name ?? '',
+            upstream_nodes: n.upstream_nodes,
+            wait_review: !!n.wait_review,
+            order_index: n.order_index,
+          }));
+          const document = new WorkflowDocument(nodes, (next) => {
+            if (getCurrentDatasourceWorkspaceId() !== workspace)
+              return Promise.reject(new Error(t('dataAsset.editor.workspaceChanged')));
+            return orchestrationApi.saveNodes(props.workflowId, next);
+          });
+          attach({ workflow, tasks, document });
+        })
+        .catch((e) => {
+          if (active) setError(String(e instanceof Error ? e.message : e));
+        });
+    return () => {
+      active = false;
+      if (!entry?.document.dirty) {
+        openDocuments.delete(key);
+        unsubscribe?.();
+      }
+    };
+  }, [props.workflowId, attempt, t]);
+  if (error)
+    return (
+      <div role="alert" className="p-6 text-danger">
+        {error} <Button onClick={() => setAttempt((x) => x + 1)}>{t('common.retry')}</Button>
+        <Button onClick={props.onBack}>{t('common.back')}</Button>
+      </div>
+    );
+  if (!loaded) return <Empty text={t('dataAsset.wfEdit.loading')} />;
+  return <WorkflowEditor key={props.workflowId} {...props} {...loaded} />;
+}
+
+function WorkflowEditor({
+  workflowId,
+  onBack,
+  onShowRuns,
+  tab = 'editor',
+  instanceId = null,
+  onTabChange,
+  onSelectInstance,
+  workflow,
+  tasks,
+  document,
+}: Props & {
+  workflow: WorkflowDefinition;
+  tasks: TaskDefinition[];
+  document: WorkflowDocument;
+}) {
+  const { t } = useTranslation();
+  useSyncExternalStore(document.subscribe, document.getSnapshot);
+  const [wf, setWf] = useState(workflow);
+  const [nodeEditor, setNodeEditor] = useState<{
+    id: string | null;
+    node: NodeInput | null;
+    executor?: 'sql' | 'python';
+  } | null>(null);
+  const [detailsOpen, setDetailsOpen] = useState(true);
+  const [selectedNodeId, setSelectedNodeId] = useState<string | null>(null);
+  const [runsRefreshKey, setRunsRefreshKey] = useState(0);
+  const { busy, run } = useAction();
+  const editorTasks = useMemo(
+    () => (nodeEditor?.executor ? tasks.filter((task) => task.executor_type === nodeEditor.executor) : tasks),
+    [tasks, nodeEditor?.executor],
+  );
+  const draft = document.nodes;
+  const locked = !!busy;
+  const persist = useCallback(
+    (next: NodeInput[]) => {
+      document.change(next);
+    },
+    [document],
+  );
+  const editNode = useCallback(
+    (id: string) => {
+      const node = document.nodes.find((n) => n.node_id === id);
+      if (node) {
+        setSelectedNodeId(id);
+        setNodeEditor({ id, node });
+      }
+    },
+    [document],
+  );
+  const changeHistory = useCallback(
+    (direction: 'undo' | 'redo') => {
+      if (direction === 'undo' ? !document.canUndo : !document.canRedo) return;
+      setNodeEditor(null);
+      setSelectedNodeId(null);
+      document[direction]();
+    },
+    [document],
+  );
+
+  useEffect(() => {
+    const shortcut = (e: KeyboardEvent) => {
+      const target = e.target as HTMLElement;
+      if (
+        tab !== 'editor' ||
+        locked ||
+        target.closest('input,textarea,select,[contenteditable="true"],[role="dialog"]')
+      )
+        return;
+      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
+        e.preventDefault();
+        changeHistory(e.shiftKey ? 'redo' : 'undo');
+      }
+    };
+    window.addEventListener('keydown', shortcut);
+    return () => {
+      window.removeEventListener('keydown', shortcut);
+    };
+  }, [changeHistory, locked, tab]);
+
+  const leave = (action: () => void) => {
+    void run('leave', '', async () => {
+      await document.flush();
+      action();
+      return undefined;
+    });
+  };
+  const submitNode = (node: NodeInput) => {
+    persist(
+      nodeEditor?.id == null
+        ? [...draft, { ...node, node_id: `node_${generateUuidV4().replaceAll('-', '')}`, order_index: draft.length }]
+        : draft.map((n) => (n.node_id === nodeEditor.id ? { ...n, ...node } : n)),
+    );
+    setNodeEditor(null);
+    setSelectedNodeId(null);
+  };
+  const removeNode = (id: string) => {
+    persist(removeWorkflowNodes(draft, new Set([id])));
+    if (selectedNodeId === id) setSelectedNodeId(null);
+    if (nodeEditor?.id === id) setNodeEditor(null);
+  };
+  const duplicateNode = (id: string) => {
+    const node = draft.find((n) => n.node_id === id)!;
+    const label = node.node_name || tasks.find((task) => task.task_id === node.task_id)?.name || node.task_id;
+    persist([
+      ...draft,
+      {
+        ...node,
+        node_id: `node_${generateUuidV4().replaceAll('-', '')}`,
+        node_name: `${label}${t('dataAsset.nodeForm.duplicateSuffix')}`,
+        order_index: draft.length,
+      },
+    ]);
+    setNodeEditor(null);
+    setSelectedNodeId(null);
+  };
+  const changeStatus = (publish: boolean) => {
+    const prefix = publish ? 'publish' : 'unpublish';
+    void run(prefix, t(`dataAsset.wfEdit.${publish ? 'published' : 'unpublished'}`, { name: wf.name }), async () => {
+      if (
+        !(await confirmDialog({
+          title: t(`dataAsset.wfEdit.${prefix}Title`, { name: wf.name }),
+          message: t(`dataAsset.wfEdit.${prefix}Message`),
+          confirmText: t(publish ? 'dataAsset.wfEdit.publish' : 'dataAsset.wfList.unpublish'),
+        }))
+      )
+        return;
+      await document.flush();
+      setWf(
+        await (publish ? orchestrationApi.publishWorkflow(workflowId) : orchestrationApi.unpublishWorkflow(workflowId)),
+      );
+      return true;
+    });
+  };
+  const deleteWorkflow = () => {
+    void run('delete', t('dataAsset.wfEdit.deleted', { name: wf.name }), async () => {
+      if (
+        !(await confirmDialog({
+          title: t('dataAsset.wfEdit.deleteTitle', { name: wf.name }),
+          message: t('dataAsset.wfEdit.deleteMessage'),
+          confirmText: t('common.delete'),
+          danger: true,
+        }))
+      )
+        return;
+      await document.flush();
+      await orchestrationApi.deleteWorkflow(workflowId);
+      onBack();
+      return true;
+    });
+  };
+  const addNodeItems = (['sql', 'python'] as const).map((executor) => ({
+    label: t(executor === 'sql' ? 'dataAsset.editor.sqlExecutor' : 'dataAsset.editor.pythonExecutor'),
+    icon:
+      executor === 'sql' ? (
+        <SqlIcon width={16} height={16} aria-hidden="true" />
+      ) : (
+        <PythonIcon width={16} height={16} aria-hidden="true" />
+      ),
+    onClick: () => {
+      setDetailsOpen(true);
+      setSelectedNodeId(null);
+      setNodeEditor({ id: null, node: null, executor });
+    },
+    disabled: locked || !tasks.some((task) => task.executor_type === executor),
+  }));
+  const changeTab = (next: WorkflowTab) => {
+    if (next === tab) return;
+    leave(() => {
+      setNodeEditor(null);
+      if (onTabChange) onTabChange(next);
+      else onShowRuns(workflowId);
+    });
+  };
+  return (
+    <div className="da-editor dd-editor">
+      <div className="dd-detail-header">
+        <div className="dd-detail-heading">
+          <button
+            type="button"
+            className="da-control shrink-0 rounded p-2 text-text-muted hover:text-text disabled:cursor-not-allowed disabled:opacity-50"
+            title={t('common.back')}
+            aria-label={t('common.back')}
+            disabled={locked}
+            onClick={() => leave(onBack)}
+          >
+            <ChevronLeft size={18} aria-hidden="true" />
+          </button>
+          <h2 className="min-w-0 truncate text-lg font-semibold text-text-strong" title={wf.name}>
+            {wf.name}
+          </h2>
+          <span className="dd-count">
+            <HifiStatus
+              status={wf.status}
+              label={t(wf.status === 'published' ? 'dataAsset.development.published' : 'dataAsset.status.draft')}
+            />
+          </span>
+          <span
+            role="status"
+            aria-live="polite"
+            className={`text-xs ${document.state === 'error' ? 'text-danger' : 'text-text-muted'}`}
+          >
+            {t(`dataAsset.editor.${document.state}`)}
+          </span>
+        </div>
+        <div className="dd-tabs" role="tablist" aria-label={t('dataAsset.development.workflowViews')}>
+          {(['editor', 'runs'] as const).map((value) => (
+            <button
+              type="button"
+              key={value}
+              id={`dd-tab-${value}`}
+              role="tab"
+              aria-controls="dd-view"
+              aria-selected={tab === value}
+              tabIndex={tab === value ? 0 : -1}
+              disabled={locked}
+              onClick={() => changeTab(value)}
+              onKeyDown={(event) => {
+                if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+                  event.preventDefault();
+                  const next = value === 'editor' ? 'runs' : 'editor';
+                  (event.currentTarget.parentElement?.querySelector(`#dd-tab-${next}`) as HTMLButtonElement)?.focus();
+                  changeTab(next);
+                }
+              }}
+            >
+              {t(`dataAsset.development.${value}`)}
+            </button>
+          ))}
+        </div>
+        <div className="dd-header-actions">
+          <Button variant="ghost" disabled={locked} onClick={deleteWorkflow}>
+            <Trash2 size={15} aria-hidden="true" />
+            {t('common.delete')}
+          </Button>
+          <Button
+            variant="default"
+            disabled={locked}
+            loading={busy === 'debug'}
+            onClick={() => {
+              void run('debug', t('dataAsset.wfList.debugTriggered', { name: wf.name }), async () => {
+                await document.flush();
+                const instance = await orchestrationApi.debugWorkflow(workflowId);
+                setRunsRefreshKey((value) => value + 1);
+                onShowRuns(workflowId, instance.instance_id);
+                return true;
+              });
+            }}
+          >
+            {t('dataAsset.wfList.debug')}
+          </Button>
+          <Button
+            variant={wf.status === 'draft' ? 'primary' : 'default'}
+            disabled={locked}
+            onClick={() => changeStatus(wf.status === 'draft')}
+          >
+            {t(wf.status === 'draft' ? 'dataAsset.wfEdit.publish' : 'dataAsset.wfList.unpublish')}
+          </Button>
+        </div>
+      </div>
+      {document.error && (
+        <div
+          role="alert"
+          className="flex items-center gap-3 border-b border-danger bg-danger-subtle px-4 py-2 text-sm text-danger"
+        >
+          <span>
+            {t('dataAsset.editor.saveError')} {document.error.message}
+          </span>
+          <Button
+            onClick={() => {
+              void document.retry().catch((e) => toast.error(e.message));
+            }}
+          >
+            {t('common.retry')}
+          </Button>
+        </div>
+      )}
+      <div id="dd-view" role="tabpanel" aria-labelledby={`dd-tab-${tab}`} className="dd-view">
+        {tab === 'runs' ? (
+          <WorkflowRuns
+            key={workflowId}
+            workflowId={workflowId}
+            draft={draft}
+            tasks={tasks}
+            instanceId={instanceId}
+            refreshKey={runsRefreshKey}
+            onSelectInstance={onSelectInstance ?? ((id) => onShowRuns(workflowId, id))}
+          />
+        ) : (
+          <div className="dd-workspace dd-editor-workspace">
+            <div className="dd-canvas-area">
+              {!detailsOpen && !nodeEditor && (
+                <button
+                  type="button"
+                  className="dd-expand-details da-icon-btn"
+                  title={t('dataAsset.development.expandDetails')}
+                  aria-label={t('dataAsset.development.expandDetails')}
+                  onClick={() => setDetailsOpen(true)}
+                >
+                  <PanelRightOpen size={20} />
+                </button>
+              )}
+              <WorkflowDag
+                fitViewOnResize
+                emptyContent={
+                  <div className="dd-editor-empty nodrag nopan">
+                    <RowMenu text={t('dataAsset.editor.addTask')} icon={<Plus size={32} />} items={addNodeItems} />
+                    <p>{t('dataAsset.development.addFirstNode')}</p>
+                  </div>
+                }
+                draft={draft}
+                tasks={tasks}
+                canvasHeight="100%"
+                canvasMinHeight={0}
+                selectedNodeId={selectedNodeId}
+                onSelectNode={(id) => {
+                  setSelectedNodeId(id);
+                  if (id && !locked) {
+                    editNode(id);
+                    setDetailsOpen(true);
+                  } else setNodeEditor(null);
+                }}
+                onNodeDoubleClick={locked ? undefined : editNode}
+                onDuplicateNode={locked ? undefined : duplicateNode}
+                onDeleteNode={
+                  locked
+                    ? undefined
+                    : (id) => {
+                        const node = draft.find((item) => item.node_id === id)!;
+                        void confirmDialog({
+                          title: t('dataAsset.nodeForm.deleteTitle', {
+                            name:
+                              node.node_name ||
+                              tasks.find((task) => task.task_id === node.task_id)?.name ||
+                              node.task_id,
+                          }),
+                          message: t('dataAsset.nodeForm.deleteMessage'),
+                          danger: true,
+                          confirmText: t('common.delete'),
+                        }).then((ok) => {
+                          if (ok) removeNode(id);
+                        });
+                      }
+                }
+                onChange={locked ? undefined : persist}
+                readOnly={locked}
+                canvasTools={
+                  <>
+                    <Button
+                      variant="ghost"
+                      disabled={!document.canUndo || locked}
+                      onClick={() => changeHistory('undo')}
+                    >
+                      <UndoIcon width={16} height={16} aria-hidden="true" />
+                      {t('dataAsset.editor.undo')}
+                    </Button>
+                    <Button
+                      variant="ghost"
+                      disabled={!document.canRedo || locked}
+                      onClick={() => changeHistory('redo')}
+                    >
+                      <RedoIcon width={16} height={16} aria-hidden="true" />
+                      {t('dataAsset.editor.redo')}
+                    </Button>
+                    <span className="wf-toolbar-divider" aria-hidden="true" />
+                    <RowMenu
+                      text={t('dataAsset.editor.addTask')}
+                      icon={
+                        <>
+                          <Plus size={14} aria-hidden="true" />
+                          {t('dataAsset.editor.addTask')}
+                        </>
+                      }
+                      items={addNodeItems}
+                    />
+                  </>
+                }
+              />
+            </div>
+            {nodeEditor ? (
+              <NodeEditDrawer
+                open={!!nodeEditor}
+                node={nodeEditor?.node ?? null}
+                allNodes={draft}
+                tasks={editorTasks}
+                selfNodeId={nodeEditor?.id ?? undefined}
+                onClose={() => {
+                  setNodeEditor(null);
+                  setSelectedNodeId(null);
+                }}
+                onSubmit={submitNode}
+                onDelete={nodeEditor?.id ? () => removeNode(nodeEditor.id!) : undefined}
+                onDuplicate={nodeEditor?.id ? () => duplicateNode(nodeEditor.id!) : undefined}
+              />
+            ) : detailsOpen ? (
+              <WorkflowDetails
+                workflow={wf}
+                nodeCount={draft.length}
+                onCollapse={() => setDetailsOpen(false)}
+                onUpdated={setWf}
+              />
+            ) : null}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/WorkflowFormDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/WorkflowFormDrawer.tsx
