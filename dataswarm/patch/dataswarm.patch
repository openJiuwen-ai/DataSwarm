+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""python 别名 shim 转发到冻结 exe 后，入口 `-c` / `-V` 的分发语义测试。"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+_ENTRY_PATH = Path(__file__).resolve().parents[2] / "scripts" / "jiuwenswarm_exe_entry.py"
+
+if not _ENTRY_PATH.exists():
+    pytest.skip("desktop packaging assets are absent", allow_module_level=True)
+
+
+@pytest.fixture
+def exe_entry():
+    entry_path = Path(__file__).resolve().parents[2] / "scripts" / "jiuwenswarm_exe_entry.py"
+    spec = importlib.util.spec_from_file_location("test_jiuwenswarm_exe_entry_alias", entry_path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_dash_c_executes_code(exe_entry, monkeypatch, capsys) -> None:
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "argv", ["dataswarm", "-c", "print('alias-ok')"])
+    assert exe_entry._dispatch() == 0
+    assert "alias-ok" in capsys.readouterr().out
+
+
+def test_dash_c_argv_semantics(exe_entry, monkeypatch, capsys) -> None:
+    """对齐 CPython：sys.argv[0] 置 "-c"，剩余参数为业务参数。"""
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(
+        sys, "argv", ["dataswarm", "-c", "import sys; print(sys.argv)", "a1", "a2"]
+    )
+    assert exe_entry._dispatch() == 0
+    assert "['-c', 'a1', 'a2']" in capsys.readouterr().out
+
+
+def test_dash_c_code_can_sys_exit(exe_entry, monkeypatch) -> None:
+    """-c 代码里的 sys.exit 退出码原样透传。"""
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "argv", ["dataswarm", "-c", "import sys; sys.exit(3)"])
+    with pytest.raises(SystemExit) as exc_info:
+        exe_entry._dispatch()
+    assert exc_info.value.code == 3
+
+
+def test_dash_c_takes_precedence_over_py_detection(exe_entry, monkeypatch, capsys) -> None:
+    """`-c` 的代码串以 .py 结尾时不得误入脚本分支（静默假成功）。"""
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "argv", ["dataswarm", "-c", "print('x.py')"])
+    assert exe_entry._dispatch() == 0
+    assert "x.py" in capsys.readouterr().out
+
+
+def test_bare_dash_c_reports_usage_error(exe_entry, monkeypatch, capsys) -> None:
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "argv", ["dataswarm", "-c"])
+    assert exe_entry._dispatch() == 2
+    assert "-c" in capsys.readouterr().err
+
+
+def test_dash_V_prints_python_version_prefix(exe_entry, monkeypatch, capsys) -> None:
+    """`-V` 输出以 "Python <version>" 开头（版本探测脚本只认该前缀）。"""
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "argv", ["dataswarm", "-V"])
+    assert exe_entry._dispatch() == 0
+    out = capsys.readouterr().out
+    assert out.startswith("Python ")
+    assert "frozen runtime" in out
