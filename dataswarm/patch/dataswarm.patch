+def test_insert_select_with_join():
+    sql = (
+        "INSERT INTO dws.daily_gmv "
+        "SELECT o.order_id AS oid, SUM(o.amount) AS total "
+        "FROM ods.orders o "
+        "JOIN ods.customers c ON o.customer_id = c.customer_id "
+        "GROUP BY o.order_id"
+    )
+    r = parser.parse_sql(sql, default_db="dws")
+    assert r.is_write is True
+    assert r.target_table == "daily_gmv"
+    assert r.target_db == "dws"
+    # 源表：ods.orders + ods.customers
+    src_pairs = {(e.source_db, e.source_table) for e in r.table_edges}
+    assert ("ods", "orders") in src_pairs
+    assert ("ods", "customers") in src_pairs
+    # join_key
+    assert any(e.join_key and "customer_id" in e.join_key for e in r.table_edges)
+    # 字段级：oid <- ods.orders.order_id；total <- ods.orders.amount（带 transformation）
+    col_pairs = {(c.source_table, c.source_column, c.target_column) for c in r.column_edges}
+    assert ("orders", "order_id", "oid") in col_pairs
+    assert ("orders", "amount", "total") in col_pairs
+    # total 有 transformation（SUM(...)）
+    total_edge = [c for c in r.column_edges if c.target_column == "total"][0]
+    assert total_edge.transformation is not None
+    # oid 是裸列引用，无 transformation
+    oid_edge = [c for c in r.column_edges if c.target_column == "oid"][0]
+    assert oid_edge.transformation is None
+
+
+def test_pure_select_no_lineage():
+    """纯 SELECT 查询任务：不产血缘（只读消费）。"""
+    sql = "SELECT * FROM ods.orders WHERE order_id = 1"
+    r = parser.parse_sql(sql, default_db="ods")
+    assert r.is_write is False
+    assert r.table_edges == []
+    assert r.column_edges == []
+
+
+def test_ctas_create_table_as_select():
+    sql = (
+        "CREATE TABLE dwd.fact_orders AS "
+        "SELECT order_id, customer_id FROM ods.orders"
+    )
+    r = parser.parse_sql(sql, default_db="dwd")
+    assert r.is_write is True
+    assert r.target_table == "fact_orders"
+    assert r.target_db == "dwd"
+    assert any(e.source_table == "orders" for e in r.table_edges)
+
+
+def test_empty_and_noninsert_sql():
+    assert parser.parse_sql("").is_write is False
+    assert parser.parse_sql("   ").is_write is False
+    # UPDATE 无 INSERT/CTAS，MVP 视为非写入（不产血缘）
+    r = parser.parse_sql("UPDATE ods.orders SET amount = 1 WHERE id = 1", default_db="ods")
+    assert r.is_write is False
+
+
+def test_default_db_fill():
+    """表名不带库前缀时用 default_db 填充。"""
+    sql = "INSERT INTO daily_gmv SELECT order_id FROM orders"
+    r = parser.parse_sql(sql, default_db="dws")
+    assert r.target_db == "dws"
+    assert r.target_table == "daily_gmv"
+    assert all(e.target_db == "dws" for e in r.table_edges)
+    assert any(e.source_table == "orders" and e.source_db == "dws" for e in r.table_edges)
+
+
+def test_complex_sql_partial_parse():
+    """复杂 SQL（CTE 子查询）：尽力解析，解析不出也不抛。"""
+    sql = (
+        "WITH base AS (SELECT order_id FROM ods.orders) "
+        "INSERT INTO dws.gmv SELECT order_id FROM base"
+    )
+    r = parser.parse_sql(sql, default_db="dws")
+    # WITH 子查询的 base 不是裸表，MVP 不抓；但目标表能解析
+    assert r.is_write is True
+    assert r.target_table == "gmv"
+    # base 是 CTE 名，被 _find_sources 当表抓到——MVP 可接受（不阻断）
+    # 关键是不抛异常、目标表正确
+
+
+def test_double_quoted_identifiers():
+    """双引号标识符（DuckDB/PostgreSQL 风格，CSV 建仓 plan 的实际形态）。
+
+    曾因 parser 只认反引号/裸标识符 → is_write=False，整条建仓 0 血缘。
+    """
+    sql = (
+        'INSERT INTO "dwd_order_detail" ("order_id", "price")\n'
+        'SELECT o."order_id" AS "order_id", CAST(o."amount" AS DOUBLE) AS "price"\n'
+        'FROM "ods_olist_orders_dataset" AS "o"\n'
+        'LEFT JOIN "ods_olist_order_items_dataset" AS "i" ON o."order_id" = i."order_id"'
+    )
+    r = parser.parse_sql(sql, default_db="olist")
+    assert r.is_write is True
+    assert r.target_table == "dwd_order_detail"
+    src_pairs = {(e.source_db, e.source_table) for e in r.table_edges}
+    assert ("olist", "ods_olist_orders_dataset") in src_pairs
+    assert ("olist", "ods_olist_order_items_dataset") in src_pairs
+    col_pairs = {(c.source_table, c.source_column, c.target_column) for c in r.column_edges}
+    assert ("ods_olist_orders_dataset", "order_id", "order_id") in col_pairs
+    # CAST 表达式记 transformation
+    price_edge = [c for c in r.column_edges if c.target_column == "price"][0]
+    assert price_edge.transformation is not None
+
+
+def test_double_quoted_ctas():
+    """双引号 CTAS（duckdb 导入节点形态）也产血缘。"""
+    sql = (
+        'CREATE OR REPLACE TABLE "ods_orders" AS '
+        "SELECT * FROM read_csv('D:/olist/orders.csv', delim=',', header=true)"
+    )
+    r = parser.parse_sql(sql, default_db="olist")
+    assert r.is_write is True
+    assert r.target_table == "ods_orders"
+    assert r.table_edges == []
+
+
+def test_string_literal_quotes_preserved():
+    """单引号字符串字面量内的双引号不被误转。"""
+    normalized = parser._normalize_quotes("SELECT 'a\"b' AS x FROM \"t\"")
+    assert "'a\"b'" in normalized
+    assert "`t`" in normalized
+
+
+if __name__ == "__main__":
+    test_insert_select_with_join()
+    test_pure_select_no_lineage()
+    test_ctas_create_table_as_select()
+    test_empty_and_noninsert_sql()
+    test_default_db_fill()
+    test_complex_sql_partial_parse()
+    test_double_quoted_identifiers()
+    test_double_quoted_ctas()
+    test_string_literal_quotes_preserved()
+    print("[OK] all parser tests passed")
