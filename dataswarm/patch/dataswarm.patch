+def test_recall_waits_for_complete_vector_commit(vector_env, monkeypatch):
+    """A reader must not see the interval between add and stale-vector deletion."""
+    from concurrent.futures import ThreadPoolExecutor, TimeoutError
+    from threading import Event
+
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    store = vector_env.store
+    added, release, reader_started = Event(), Event(), Event()
+    original_add = store.add_vectors
+
+    def blocking_add(*args, **kwargs):
+        original_add(*args, **kwargs)
+        added.set()
+        assert release.wait(5), "test did not release the vector commit"
+
+    monkeypatch.setattr(store, "add_vectors", blocking_add)
+    monkeypatch.setattr(store, "search_similar", lambda query, k: [
+        {"id": doc_id, "distance": .9, "metadata": dict(meta)}
+        for doc_id, meta in store.index.metadata.items()
+    ][:k])
+    monkeypatch.setattr(embedding, "query_vectors",
+                        _fake_query_vectors([(1, 0, 0, 0)], ("question",)))
+
+    def read():
+        reader_started.set()
+        return vector_store.recall("ws", "orders", "question")
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        writer = executor.submit(
+            vector_store.sync_workspace_vectors, "ws", "orders",
+            _snapshot(phone_comment="updated phone", include_amount=False))
+        try:
+            assert added.wait(2)
+            reader = executor.submit(read)
+            assert reader_started.wait(2)
+            with pytest.raises(TimeoutError):
+                reader.result(timeout=.1)
+        finally:
+            release.set()
+        assert writer.result(timeout=2)["status"] == "ok"
+        recalled = reader.result(timeout=2)
+    assert recalled["warnings"] == []
+    assert "amount" not in {column["column_name"] for column in recalled["tables"][0]["columns"]}
+    assert len(store.index.metadata) == 8
