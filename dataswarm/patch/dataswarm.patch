+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 血缘预览组件：建任务时解析 SQL 实时预览会产出什么血缘（不落库）。
+// 调 POST /api/orchestration/tasks/preview-lineage，展示表级/字段级边。
+
+import { useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { orchestrationApi } from '../api/orchestrationApi';
+import type { LineagePreview } from '../types/orchestration';
+import { Button } from './shared/Ui';
+
+interface Props {
+  code: string;
+  executorType: string;
+  datasourceRef?: string;
+}
+
+export function LineagePreviewSection({ code, executorType, datasourceRef }: Props) {
+  const { t } = useTranslation();
+  const requestId = useRef(0);
+  useEffect(() => {
+    requestId.current += 1;
+    setPreview(null);
+    setErr(null);
+    setLoading(false);
+    return () => {
+      requestId.current += 1;
+    };
+  }, [code, executorType, datasourceRef]);
+  const [preview, setPreview] = useState<LineagePreview | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+
+  const runPreview = async () => {
+    if (!code.trim()) {
+      setErr(t('dataAsset.lineage.enterCode'));
+      return;
+    }
+    const request = ++requestId.current;
+    setLoading(true);
+    setErr(null);
+    try {
+      const r = await orchestrationApi.previewLineage(code, datasourceRef);
+      if (request === requestId.current) setPreview(r);
+    } catch (e) {
+      if (request === requestId.current) {
+        setErr(e instanceof Error ? e.message : t('dataAsset.lineage.failed'));
+        setPreview(null);
+      }
+    } finally {
+      if (request === requestId.current) setLoading(false);
+    }
+  };
+
+  if (executorType !== 'sql') {
+    return <p className="text-xs text-text-muted">{t('dataAsset.lineage.sqlOnly')}</p>;
+  }
+
+  return (
+    <div className="space-y-2 rounded-lg border border-border bg-panel p-3">
+      <div className="flex items-center justify-between">
+        <span className="text-xs font-medium text-text-strong">{t('dataAsset.lineage.title')}</span>
+        <Button variant="ghost" size="xs" disabled={loading || !code.trim()} onClick={runPreview}>
+          {t(loading ? 'dataAsset.lineage.loading' : 'dataAsset.lineage.preview')}
+        </Button>
+      </div>
+      {err && <p className="text-xs text-danger">{err}</p>}
+      {preview && (
+        <div className="space-y-2 text-xs">
+          {!preview.is_write ? (
+            <p className="text-text-muted">{t('dataAsset.lineage.readOnly')}</p>
+          ) : (
+            <>
+              <div>
+                <span className="text-text-muted">{t('dataAsset.lineage.target')}</span>
+                {[preview.target.db, preview.target.table].filter(Boolean).join('.')}
+              </div>
+              {preview.table_edges.length > 0 && (
+                <div>
+                  <div className="mb-1 text-text-muted">
+                    {t('dataAsset.lineage.tables', { count: preview.table_edges.length })}
+                  </div>
+                  <ul className="space-y-0.5 pl-2 font-mono">
+                    {preview.table_edges.map((e, i) => (
+                      <li key={i}>
+                        {[e.source_db, e.source_table].filter(Boolean).join('.')} →{' '}
+                        {[e.target_db, e.target_table].filter(Boolean).join('.')}
+                        {e.join_key ? ` (ON ${e.join_key})` : ''}
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              )}
+              {preview.column_edges.length > 0 && (
+                <div>
+                  <div className="mb-1 text-text-muted">
+                    {t('dataAsset.lineage.columns', { count: preview.column_edges.length })}
+                  </div>
+                  <ul className="space-y-0.5 pl-2 font-mono">
+                    {preview.column_edges.map((e, i) => (
+                      <li key={i} title={e.transformation ?? ''}>
+                        {e.source_table}.{e.source_column} → {e.target_table}.{e.target_column}
+                        {e.transformation ? `  [${e.transformation}]` : ''}
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              )}
+              {preview.table_edges.length === 0 && preview.column_edges.length === 0 && (
+                <p className="text-text-muted">{t('dataAsset.lineage.noEdges')}</p>
+              )}
+            </>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/LogDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/LogDrawer.tsx
