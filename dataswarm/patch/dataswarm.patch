@@ -0,0 +1,95 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""按数据源注册的 engine 创建和缓存连接器。
+
+数据源类型声明执行引擎，连接器类通过引擎注册表解析；此处不维护类型到引擎的副本。
+"""
+
+from __future__ import annotations
+
+from .base import Connector, SourceDefinition, get_engine
+from .errors import SourceDisabledError, SourceNotFoundError
+
+# 仅为触发 @register_engine 装饰器注册；引擎实例化一律走 get_engine()。
+from . import duckdb_connector as _duckdb_connector  # noqa: F401
+from . import sqlalchemy_connector as _sqlalchemy_connector  # noqa: F401
+from . import sampled_connector as _sampled_connector  # noqa: F401
+from . import schema_only_connector as _schema_only_connector  # noqa: F401
+from . import staged_connector as _staged_connector  # noqa: F401
+
+#: 注册表查不到类型时的引擎（关系型线协议占多数，与 SourceTypeAdapter 的默认值一致）。
+_DEFAULT_ENGINE = "sqlalchemy"
+
+
+def _backfill_duckdb_file_config(config: dict, db_ref: str) -> dict:
+    """duckdb 文件源注册 config 缺 table_name 时按 db_ref 回填（含存量源）。
+
+    注册落库的 config 只有 {"path"}，而 db_ref 携带 table_name=<stem>——
+    两通道不对称：db-ref 分支（common.db_connector._duckdb_connector）按 ref
+    spec 补齐 table_name，source-id 分支（本类）曾直接用注册 config，
+    DuckDBConnector._table_name() 落到 "data" fallback，TEMP VIEW 名与
+    db_ref 声明不一致，执行 SQL `FROM <table_name>` 报 Catalog Error
+    （ST 真跑实证：报告数字对但结果 CSV 为空、components.status=failed）。
+    """
+    if not db_ref.startswith("duckdb://") or config.get("table_name"):
+        return config
+    from jiuwenswarm.common.db_connector import parse_db_ref
+
+    try:
+        spec = parse_db_ref(db_ref)
+    except Exception:  # noqa: BLE001 —— 解析失败保留原 config，视图名走既有 fallback
+        return config
+    table_name = str(spec.get("table_name") or "")
+    location = str(spec.get("location") or "")
+    if not table_name:
+        return config
+    config.setdefault("table_name", table_name)
+    if location:
+        config.setdefault("location", location)
+        config.setdefault("path", location)
+    return config
+
+
+def _declared_engine(source_type: str) -> str:
+    """数据源类型 → 声明的执行引擎（唯一真相源：datasource 注册表）。"""
+    from ..datasource.registry import get_source_type
+
+    try:
+        return str(get_source_type(source_type).engine or _DEFAULT_ENGINE)
+    except ValueError:
+        # 未注册类型（历史遗留行 / 手工写库）：按默认引擎走，与旧行为一致。
+        return _DEFAULT_ENGINE
+
+
+class ConnectorManager:
+    def __init__(self, source_loader):
+        self._source_loader = source_loader
+
+    def source(self, source_id: str) -> SourceDefinition:
+        row = self._source_loader(source_id)
+        if not row:
+            raise SourceNotFoundError(f"source not found: {source_id}")
+        if row.get("enabled", True) is False:
+            raise SourceDisabledError(f"source is disabled: {source_id}")
+        config = dict(row.get("config") or {})
+        source_type = str(row.get("source_type") or "")
+        engine = str(row.get("engine") or _declared_engine(source_type))
+        config = _backfill_duckdb_file_config(config, str(row.get("db_ref") or ""))
+        return SourceDefinition(
+            source_id=str(row.get("source_id") or source_id),
+            source_type=source_type,
+            name=str(row.get("name") or source_id),
+            engine=engine,
+            config=config,
+            enabled=True,
+            config_version=int(row.get("config_version") or 1),
+        )
+
+    def get(self, source_id: str) -> Connector:
+        source = self.source(source_id)
+        return get_engine(source.engine)(source)
+
+
+def get_connector_manager() -> ConnectorManager:
+    from ..datasource.store import find_local_source
+
+    return ConnectorManager(find_local_source)
