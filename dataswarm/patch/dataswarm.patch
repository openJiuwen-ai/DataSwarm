+
+def resolve_source_map(workspace_id: str) -> dict[str, str]:
+    """``datasource_ref（db_ref）→ source_id`` 映射（同 ref 多源取 enabled 最新）。
+
+    指标绑定只存 datasource_ref；语义层快照按 source_id 组织——本函数是
+    两套 ID 空间的桥。数据源模块不可用或空时返回空映射（调用方降级）。
+    """
+    try:
+        from jiuwenswarm.channels.web.dataagent.datasource import store as ds_store
+
+        sources = ds_store.list_sources(workspace_id)
+    except Exception:  # noqa: BLE001 —— 数据源模块不可用按无源处理，不阻断召回
+        return {}
+    out: dict[str, str] = {}
+    for source in sources:
+        ref = str(source.get("db_ref") or "")
+        source_id = str(source.get("source_id") or "")
+        if not ref or not source_id:
+            continue
+        out[ref] = source_id  # 列表序靠后的覆盖靠前的（enabled/最新优先由 store 排序保证）
+    return out
+
+
+def workspace_semantic_refs() -> list[SemanticRef]:
+    """当前工作空间有 published 快照的全部源（每源取最新一条）。
+
+    快照表按 workspace 隔离（每空间独立元数据库），无需再按 workspace 过滤。
+    """
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(
+            conn,
+            "SELECT source_id, snapshot_id FROM dw_semantic_snapshots "
+            "WHERE status='published' ORDER BY published_at DESC",
+            (),
+        )
+    except Exception:  # noqa: BLE001 —— 快照表未建（未跑过采集）按无 refs 处理
+        return []
+    finally:
+        conn.close()
+    out: dict[str, SemanticRef] = {}
+    for row in rows:
+        source_id = str(row.get("source_id") or "")
+        snapshot_id = str(row.get("snapshot_id") or "")
+        if not source_id or not snapshot_id or source_id in out:
+            continue
+        out[source_id] = SemanticRef(source_id=source_id, snapshot_id=snapshot_id)
+    return list(out.values())
+
+
+def load_snapshots(
+    refs: list[SemanticRef], warnings: list[str] | None = None,
+) -> dict[str, Any]:
+    """逐源加载最新 published 快照（``source_id -> MetadataSnapshot``）。
+
+    单源加载失败记 warning 跳过，不拖垮其余源（降级纪律：不把「某源挂了」
+    当「全部没有 schema」）。
+    """
+    from ..semantic import repository as semantic_repository
+
+    out: dict[str, Any] = {}
+    for ref in refs:
+        try:
+            snapshot = semantic_repository.latest_published_snapshot(ref.source_id)
+        except Exception as exc:  # noqa: BLE001
+            if warnings is not None:
+                _warn(warnings, f"semantic_snapshot_load_failed:{ref.source_id}:{type(exc).__name__}")
+            continue
+        if snapshot is not None:
+            out[ref.source_id] = snapshot
+    return out
+
+
+def current_snapshots(warnings: list[str] | None = None) -> tuple[list[SemanticRef], dict[str, Any]]:
+    """一步取 refs + snapshots（召回链路的公共入口）。"""
+    refs = workspace_semantic_refs()
+    return refs, load_snapshots(refs, warnings)
