@@ -0,0 +1,109 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { ArtifactMap, Dimension, Finding, FixContextResponse, FixExecuteResult, FixPlanArtifact, FixPlanResult, InspectionManifest, InspectionSummary } from '../types/inspection';
+import {
+  ensureDatasourceWorkspaceId,
+  responseBelongsToCurrentWorkspace,
+} from '../../../stores/datasourceWorkspaceStore';
+import i18n from '../../../i18n';
+
+/** 读取类请求超时：超过即中止，避免请求挂死导致页面 loading 永不结束。 */
+const READ_TIMEOUT_MS = 60_000;
+/** 同步执行的修复链路（起 plan / 执行确认项）耗时远超读取，单独放宽。 */
+const MUTATION_TIMEOUT_MS = 180_000;
+/**
+ * 请求被「更新的批次」主动取消时的错误标识。
+ *
+ * 快速切换批次会并发多个加载，浏览器对同一 origin 只有 6 条连接——过期请求若不取消
+ * 就会一直占用连接，把新批次的请求顶在队列后面（服务器慢时尤其明显）。故 selectRun
+ * 递增序列号时立即 abort 上一批在飞请求。这类取消是预期行为，调用方必须静默忽略，
+ * 不能当错误横幅展示。
+ */
+export const SUPERSEDED_ERROR = 'superseded';
+
+export interface RequestOptions {
+  timeoutMs?: number;
+  /** 外部取消信号（批次切换时由 store 传入），与超时共同构成中止条件。 */
+  signal?: AbortSignal;
+}
+
+async function request<T>(url: string, init?: RequestInit, options: RequestOptions = {}): Promise<T> {
+  const timeoutMs = options.timeoutMs ?? READ_TIMEOUT_MS;
+  // 多工作空间（P2-4）：巡检 API 统一注入当前 workspace_id
+  const wsId = await ensureDatasourceWorkspaceId();
+  const requestAt = wsId;
+  const target = wsId ? `${url}${url.includes('?') ? '&' : '?'}workspace_id=${encodeURIComponent(wsId)}` : url;
+  const controller = new AbortController();
+  const external = options.signal;
+  if (external) {
+    if (external.aborted) controller.abort();
+    else external.addEventListener('abort', () => controller.abort(), { once: true });
+  }
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  let response: Response;
+  try {
+    response = await fetch(target, {
+      ...init,
+      signal: controller.signal,
+      headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...init?.headers },
+    });
+  } catch (error) {
+    if (controller.signal.aborted) {
+      // 被新批次取代 → 静默标识；否则是超时，以可读文案上抛让调用方恢复正常态
+      throw new Error(external?.aborted ? SUPERSEDED_ERROR : i18n.t('governance.errors.timeout'));
+    }
+    throw error;
+  } finally {
+    clearTimeout(timer);
+  }
+  const payload = await response.json().catch(() => ({})) as Record<string, unknown>;
+  if (!response.ok) throw new Error(typeof payload.error === 'string' ? payload.error : `${response.status} ${response.statusText}`);
+  if (!responseBelongsToCurrentWorkspace(payload, requestAt)) {
+    throw new Error('workspace_changed');
+  }
+  return payload as T;
+}
+
+export const inspectionApi = {
+  listRuns: () => request<{ runs: InspectionManifest[] }>('/api/inspection/runs'),
+  // signal：批次切换时由 store 传入，被取代的加载立即取消以释放连接
+  getSummary: (runId: string, signal?: AbortSignal) =>
+    request<InspectionSummary>(`/api/inspection/runs/${encodeURIComponent(runId)}`, undefined, { signal }),
+  getManifest: (runId: string) => request<InspectionManifest>(`/api/inspection/runs/${encodeURIComponent(runId)}/manifest`),
+  getDimension: <D extends Dimension>(dimension: D, runId: string, signal?: AbortSignal) =>
+    request<NonNullable<ArtifactMap[D]>>(
+      `/api/inspection/${dimension}?run_id=${encodeURIComponent(runId)}`, undefined, { signal },
+    ),
+  createRun: (db: string, baselineDb?: string | null, sessionId?: string) => request<{ run_id: string; status: string }>(
+    '/api/inspection/runs', { method: 'POST', body: JSON.stringify({ db, baseline_db: baselineDb || undefined, session_id: sessionId }) },
+  ),
+  // 修复方案（v2 契约）：POST 起 fixer plan（同步）；uids 子集透传 --finding-uids
+  fixPlan: (runId: string, db: string, findingUids?: string[]) => request<FixPlanResult>(
+    '/api/inspection/fix/plan',
+    { method: 'POST', body: JSON.stringify({ run_id: runId, db,
+        ...(findingUids?.length ? { finding_uids: findingUids } : {}) }) },
+    { timeoutMs: MUTATION_TIMEOUT_MS },
+  ),
+  getFixPlan: (runId: string) => request<FixPlanArtifact>(`/api/inspection/fix/plan?run_id=${encodeURIComponent(runId)}`),
+  // 勾选子集的紧凑修复上下文（涉及表 capability 由后端探测，浏览器不连库）
+  fixContext: (runId: string, findingUids: string[]) => request<FixContextResponse>(
+    '/api/inspection/fix/context',
+    { method: 'POST', body: JSON.stringify({ run_id: runId, finding_uids: findingUids }) },
+  ),
+  // 确认项执行：digest 与路径防护都在后端，前端只透传
+  fixExecute: (runId: string, planPath: string, confirmItemUids: string[], opts?: { db?: string; planDigest?: string }) => request<FixExecuteResult>(
+    '/api/inspection/fix/execute',
+    { method: 'POST', body: JSON.stringify({ run_id: runId, plan_path: planPath,
+        confirm_item_uids: confirmItemUids,
+        ...(opts?.db ? { db: opts.db } : {}),
+        ...(opts?.planDigest ? { plan_digest: opts.planDigest } : {}) }) },
+    { timeoutMs: MUTATION_TIMEOUT_MS },
+  ),
+  // finding 明细惰性加载（库优先，文件兜底；旧批次无 UID 时后端返回 404）
+  getFindingDetail: (runId: string, uid: string) => request<{ run_id: string; source: string; dimension: string; finding: Finding }>(
+    `/api/inspection/findings/${encodeURIComponent(uid)}?run_id=${encodeURIComponent(runId)}`,
+  ),
+  // 补绑会话：对话触发巡检时 manifest 可能无 session_id，前端治理页选中该 run 时用当前会话补上
+  bindSession: (runId: string, sessionId: string) => request<{ run_id: string; session_id: string }>(
+    `/api/inspection/runs/${encodeURIComponent(runId)}/bind-session`, { method: 'POST', body: JSON.stringify({ session_id: sessionId }) },
+  ),
+};
