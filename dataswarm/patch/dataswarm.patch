+# ==========================================================================
+# 检索词与打分（口径自 context.py / transport 迁入，语义不变）
+# ==========================================================================
+
+def search_terms(question: str, cap: int = 12,
+                 extra_terms: Sequence[str] = ()) -> list[str]:
+    """图/schema 两路共用的检索词：分词 → 去数字与日期残片 → 去重保序 → 截断。
+
+    截断前必须先去日期残片：「2026年8月各地区支付客单价」的前 8 个 2-gram
+    全是日期碎片（20/02/26/6年/年8/8月/月各/各地），真词（支付/客单/单价）
+    被 cap 挤掉 → 召回对带日期的句子问法恒为零（实测事故，单测问句不带
+    日期所以没抓到）。
+
+    ``extra_terms`` 是术语扩展词（glossary 命中的规范名/别名）：整词进检索
+    （不切 2-gram，整词子串命中 label 更准），并保留最多 3 席不被问题
+    分词挤掉——弱扩展不如不扩展，但强术语词被 cap 截掉等于白桥接。
+    """
+    def _keep(tokens: Sequence[str]) -> list[str]:
+        out: list[str] = []
+        for token in tokens:
+            if token.isdigit():
+                continue
+            if len(token) == 2 and any(ch.isdigit() for ch in token):
+                continue  # 「6年」「8月」「20」类日期残片
+            if token not in out:
+                out.append(token)
+        return out
+
+    extras = _keep(extra_terms)[:3]
+    base = _keep(store._tokenize(question))[:max(cap - len(extras), 1)]
+    terms: list[str] = []
+    for token in (*base, *extras):
+        if token not in terms:
+            terms.append(token)
+    return terms[:cap]
+
+
+def _match_score(value: str, terms: list[str], base: float) -> float:
+    """子串匹配打分：包含命中取 base，精确全等 +EXACT_BONUS（上限 1.0）。"""
+    lowered = (value or "").strip().lower()
+    if not lowered:
+        return 0.0
+    for term in terms:
+        if term in lowered:
+            score = base
+            if lowered == term:
+                score = min(1.0, base + EXACT_BONUS)
+            return score
+    return 0.0
+
+
+def metric_table_scores(
+    workspace_id: str, question: str, *, release: Release | None,
+    extra_terms: Sequence[str] = (),
+) -> dict[str, tuple[float, list[str]]]:
+    """图通道的表实现：published 修订分词匹配 → ``metric_key -> (score, matched_on)``。
+
+    替代旧 SPARQL ``search_candidates``（Metric/MetricRevision 节点），
+    打分刻度严格对齐 ``transport._MATCH_SCORES``。release 给定只在批内
+    修订中匹配（旧图 release 作用域）；无 release 匹配全部 published 当前修订。
+    ``extra_terms`` 为术语扩展词（整词注入，见 :func:`search_terms`）。
+    """
+    terms = search_terms(question, extra_terms=extra_terms)
+    if not terms:
+        return {}
+    revisions = _scoped_revisions(workspace_id, release)
+    defs = {d.metric_id: d for d in store.list_defs(workspace_id)}
+    out: dict[str, tuple[float, list[str]]] = {}
+    for revision in revisions:
+        metric_def = defs.get(revision.metric_id)
+        if metric_def is None:
+            continue
+        fields: dict[str, str] = {
+            "metric_key": metric_def.metric_key,
+            "display_name": revision.display_name or metric_def.name,
+            "description": metric_def.description or "",
+        }
+        best_score = 0.0
+        matched: list[str] = []
+        for name, value in fields.items():
+            base = METRIC_MATCH_SCORES[name]
+            score = _match_score(value, terms, base)
+            if score > 0:
+                if score > best_score:
+                    best_score = score
+                if name not in matched:
+                    matched.append(name)
+        for synonym in revision.synonyms:
+            score = _match_score(synonym, terms, METRIC_MATCH_SCORES["synonym"])
+            if score > 0:
+                if score > best_score:
+                    best_score = score
+                if "synonym" not in matched:
+                    matched.append("synonym")
+        if best_score > 0:
+            out[metric_def.metric_key] = (best_score, matched)
+    return out
+
+
+def _scoped_revisions(workspace_id: str, release: Release | None) -> list[Any]:
+    """release 作用域内的 published 修订；无 release 取全部当前 published。"""
+    from .model import REVISION_PUBLISHED
+
+    out: list[Any] = []
+    if release is not None:
+        for revision_id in release.revision_ids:
+            revision = store.get_revision(revision_id)
+            if revision is not None and revision.status == REVISION_PUBLISHED:
+                out.append(revision)
+        return out
+    for metric in store.list_defs(workspace_id):
+        if not metric.current_revision_id:
+            continue
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is not None and revision.status == REVISION_PUBLISHED:
+            out.append(revision)
+    return out
+
+
+# ==========================================================================
+# schema 通道：快照词法 + FAISS 合并
+# ==========================================================================
+
+def schema_recall(
+    workspace_id: str, question: str, snapshots: dict[str, Any], *,
+    warnings: list[str],
+    extra_terms: Sequence[str] = (),
+) -> tuple[list[SchemaHit], float]:
+    """S 入口：快照内存词法匹配 + 语义层 FAISS 召回，按 node_id 合并取 max。
+
+    词法刻度对齐旧 schema 图 SPARQL（label 0.80 / comment 0.40、精确 +0.15）；
+    EMB 命中经 ``vector_store.recall``（其内部自带通道不可用降级与 warning）。
+    ``matched_on`` 含 ``emb``、``emb_via`` 记胜出查询向量（归因展示）。
+    ``extra_terms`` 为术语扩展词（整词注入，见 :func:`search_terms`）。
+    """
+    terms = search_terms(question, extra_terms=extra_terms)
+    lexical = _lexical_schema_hits(snapshots, terms)
+    emb_hits, emb_warnings = _emb_schema_hits(workspace_id, question, snapshots)
+    for warning in emb_warnings:
+        _warn(warnings, warning)
+    merged = _merge_schema_hits(snapshots, lexical, emb_hits)
+    confidence = max((h.score for h in merged), default=0.0)
+    return merged, confidence
+
+
+def _lexical_schema_hits(
+    snapshots: dict[str, Any], terms: list[str], *, limit: int = 10,
+) -> list[SchemaHit]:
+    """快照词法匹配：表/列的 label（comment or name）与 comment 逐词子串。"""
+    if not terms:
+        return []
+    hits: list[SchemaHit] = []
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            if table.status != _SCHEMA_STATUS_ACTIVE:
+                continue
+            score = 0.0
+            matched: list[str] = []
+            label_value = table.comment or table.name
+            for field_name, value, base in (
+                ("label", label_value, SCHEMA_LABEL_SCORE),
+                ("comment", table.comment or "", SCHEMA_COMMENT_SCORE),
+            ):
+                fscore = _match_score(value, terms, base)
+                if fscore > 0:
+                    if fscore > score:
+                        score = fscore
+                    if field_name not in matched:
+                        matched.append(field_name)
+            if score > 0:
+                hits.append(SchemaHit(
+                    node_id=table.node_id,
+                    node_type="view" if table.table_type.upper() == "VIEW" else "tbl",
+                    label=label_value,
+                    logical=table.name,
+                    score=score,
+                    matched_on=tuple(matched),
+                ))
+            for column in table.columns:
+                if column.status != _SCHEMA_STATUS_ACTIVE:
+                    continue
+                col_score = 0.0
+                col_matched: list[str] = []
+                col_label = column.comment or column.name
+                for field_name, value, base in (
+                    ("label", col_label, SCHEMA_LABEL_SCORE),
+                    ("comment", column.comment or "", SCHEMA_COMMENT_SCORE),
+                ):
+                    fscore = _match_score(value, terms, base)
+                    if fscore > 0:
+                        if fscore > col_score:
+                            col_score = fscore
+                        if field_name not in col_matched:
+                            col_matched.append(field_name)
+                if col_score > 0:
+                    hits.append(SchemaHit(
+                        node_id=column.node_id,
+                        node_type="col",
+                        label=col_label,
+                        logical=f"{table.name}.{column.name}",
+                        score=col_score,
+                        matched_on=tuple(col_matched),
+                    ))
+    hits.sort(key=lambda h: (-h.score, h.node_id))
+    return hits[:limit]
+
+
+def _emb_schema_hits(
+    workspace_id: str, question: str, snapshots: dict[str, Any],
+) -> tuple[dict[str, tuple[float, str]], list[str]]:
+    """FAISS 召回 → ``(node_id -> (校准分, 胜出查询向量), warnings)``。
+
+    recall 输出的表/列名经快照索引还原成稳定 node_id；还原不到（快照
+    刚轮换/列已删）直接丢弃——不伪造命中。
+    """
+    from ..semantic import vector_store
+
+    index = _snapshot_index(snapshots)
+    out: dict[str, tuple[float, str]] = {}
+    warnings: list[str] = []
+    for source_id in snapshots:
+        try:
+            outcome = vector_store.recall(workspace_id, source_id, question)
+        except Exception as exc:  # noqa: BLE001 —— FAISS 链路故障降级词法，不阻断
+            _warn(warnings, f"semantic_vector_recall_failed:{type(exc).__name__}")
+            continue
+        for warning in outcome.get("warnings", []):
+            _warn(warnings, warning)
+        for table in outcome.get("tables", []):
+            table_name = str(table.get("table_name") or "")
+            table_score = float(table.get("score") or 0.0)
+            columns = table.get("columns") or []
+            if columns:
+                for column in columns:
+                    column_name = str(column.get("column_name") or "")
+                    node_id = _resolve_column_node_id(index, source_id, table_name, column_name)
+                    if not node_id:
+                        continue
+                    cscore = float(column.get("score") or 0.0)
+                    via = str(column.get("emb_via") or "")
+                    prev = out.get(node_id)
+                    if prev is None or cscore > prev[0]:
+                        out[node_id] = (cscore, via)
+                continue
+            node_id = _resolve_table_node_id(index, source_id, table_name)
+            if node_id and table_score > 0:
+                out[node_id] = (table_score, "")
+    return out, warnings
+
+
+def _snapshot_index(snapshots: dict[str, Any]) -> dict[str, Any]:
+    """快照索引：``table_name -> {source_id -> (table, {column_name -> column})}``。"""
+    index: dict[str, dict[str, Any]] = {}
+    for source_id, snapshot in snapshots.items():
+        for table in snapshot.tables:
+            entry = index.setdefault(table.name, {})
+            entry[source_id] = (table, {c.name: c for c in table.columns})
+    return index
+
+
+def _resolve_table_node_id(index: dict[str, Any], source_id: str, table_name: str) -> str:
+    """表名 → 稳定 node_id（歧义/缺失返回空）。"""
+    entry = index.get(table_name) or {}
+    item = entry.get(source_id)
+    if item is None:
+        return ""
+    return item[0].node_id
+
+
+def _resolve_column_node_id(
+    index: dict[str, Any], source_id: str, table_name: str, column_name: str,
+) -> str:
+    """(表名, 列名) → 稳定 node_id（缺失返回空，不伪造）。"""
+    entry = index.get(table_name) or {}
+    item = entry.get(source_id)
+    if item is None:
+        return ""
+    column = item[1].get(column_name)
+    return column.node_id if column is not None else ""
+
+
+def _merge_schema_hits(
+    snapshots: dict[str, Any], lexical_hits: list[SchemaHit],
+    emb_hits: dict[str, tuple[float, str]],
+) -> list[SchemaHit]:
+    """词法与 EMB 命中按 node_id 合并取 max；EMB 独有命中经快照索引补全属性。"""
+    by_id = {h.node_id: h for h in lexical_hits}
+    for node_id, (score, via) in emb_hits.items():
+        prev = by_id.get(node_id)
+        if prev is not None:
+            if score > prev.score:
+                by_id[node_id] = SchemaHit(
+                    node_id=prev.node_id, node_type=prev.node_type,
+                    label=prev.label, logical=prev.logical, score=score,
+                    matched_on=(*prev.matched_on, "emb"), emb_via=via)
+            continue
+        attributes = _node_attributes(snapshots, node_id)
+        if attributes is None:
+            continue  # 索引里读不到（如快照刚轮换）：不伪造命中
+        by_id[node_id] = SchemaHit(
+            node_id=node_id, node_type=attributes[0], label=attributes[1],
+            logical=attributes[2], score=score, matched_on=("emb",), emb_via=via)
+    hits = sorted(by_id.values(), key=lambda h: (-h.score, h.node_id))
+    return hits
+
+
+def _node_attributes(snapshots: dict[str, Any], node_id: str) -> tuple[str, str, str] | None:
+    """node_id → (node_type, label, logical)（快照内查不到返回 None）。
+
+    ``logical`` 为裸表形态（``orders`` / ``orders.amount_cny``），与旧 schema
+    图 logicalTable/logicalField 同构——子图/前端/传导消费方不感知 database。
+    """
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            if table.node_id == node_id:
+                return ("tbl", table.comment or table.name, table.name)
+            for column in table.columns:
+                if column.node_id == node_id:
+                    return ("col", column.comment or column.name,
+                            f"{table.name}.{column.name}")
+    return None
+
+
+# ==========================================================================
+# S→M 传导（纯表计算，替代旧跨图 link 边反向遍历）
+# ==========================================================================
+
+def propagate_to_metrics(
+    workspace_id: str, release: Release | None, snapshots: dict[str, Any],
+    hits: list[SchemaHit],
+) -> dict[str, float]:
+    """schema 命中经绑定反查指标 → ``metric_key -> 传导分``。
+
+    语义与旧 link 边反向遍历等价：release 内全部修订的 bindings 建
+    ``(source, 表)``/``(source, 表, 列)`` 索引，schema 命中按对象归属传导
+    ``score * SCHEMA_PROPAGATION``；噪声级命中（低于 MIN）不传导。
+    """
+    if release is None or not hits:
+        return {}
+    source_map = resolve_source_map(workspace_id)
+    if not source_map:
+        return {}
+    index: dict[tuple[str, str, str], set[str]] = {}
+    for revision_id in release.revision_ids:
+        revision = store.get_revision(revision_id)
+        if revision is None:
+            continue
+        for binding in store.list_bindings(revision_id):
+            source_id = source_map.get(binding.datasource_ref or "")
+            if not source_id or not binding.source_table:
+                continue
+            table_name = binding.source_table.split(".")[-1]
+            keys = {(source_id, table_name, ""), (source_id, binding.source_table, "")}
+            for physical in binding.column_map.values():
+                column_name = physical.split(".")[-1]
+                keys.add((source_id, table_name, column_name))
+                keys.add((source_id, binding.source_table, column_name))
+            for key in keys:
+                index.setdefault(key, set()).add(_metric_key_of(revision))
+    # node_id → (source_id, table, column)：直接从快照对象定位，不解析 ID 串
+    object_locations: dict[str, tuple[str, str, str]] = {}
+    for source_id, snapshot in snapshots.items():
+        for table in snapshot.tables:
+            object_locations[table.node_id] = (source_id, table.name, "")
+            for column in table.columns:
+                object_locations[column.node_id] = (source_id, table.name, column.name)
+    out: dict[str, float] = {}
+    for hit in hits[:SCHEMA_PROPAGATE_LIMIT]:
+        if hit.score < SCHEMA_PROPAGATE_MIN:
+            continue  # 噪声级命中不传导，见 SCHEMA_PROPAGATE_MIN 注释（context.py 实测事故）
+        location = object_locations.get(hit.node_id)
+        if location is None:
+            continue
+        source_id, table_name, column_name = location
+        metric_keys = index.get((source_id, table_name, column_name))
+        if not metric_keys and not column_name:
+            metric_keys = index.get((source_id, table_name, ""))
+        if not metric_keys:
+            continue
+        score = hit.score * SCHEMA_PROPAGATION
+        for metric_key in metric_keys:
+            if score > out.get(metric_key, 0.0):
+                out[metric_key] = score
+    return out
+
+
+def _metric_key_of(revision: Any) -> str:
+    """修订所属指标的 metric_key（经 defs 反查，缓存表内往返）。"""
+    metric = store.get_def(revision.metric_id)
+    return metric.metric_key if metric is not None else ""
+
+
+# ==========================================================================
+# 发布链路：绑定校验与语义 refs（替代旧 _ensure_schema_snapshot 活库探查）
+# ==========================================================================
+
+def ensure_semantic_refs(
+    workspace_id: str,
+    bindings_by_revision: dict[str, list[Any]],
+    warnings: list[str],
+) -> list[dict[str, str]]:
+    """发布时逐 binding 校验语义层快照，产出 manifest 的 ``semantic_refs``。
+
+    严格单一通道（plan 决策 3）：绑定数据源未被语义层采集 → 绑定回写
+    ``failed(semantic_not_collected)`` + warning，**发布不阻断**（倒逼先
+    注册数据源触发采集）；表列在快照中缺失（结构漂移）同理。全存在则
+    绑定确认 ``verified``。
+
+    Returns:
+        ``[{"source_id": ..., "snapshot_id": ...}]``（去重保序）。
+    """
+    from .model import BINDING_FAILED, BINDING_VERIFIED
+
+    source_map = resolve_source_map(workspace_id)
+    snapshots = load_snapshots(workspace_semantic_refs(), warnings)
+    refs: list[dict[str, str]] = []
+    seen_sources: set[str] = set()
+    for bindings in bindings_by_revision.values():
+        for binding in bindings:
+            if not binding.source_table:
+                continue
+            source_id = source_map.get(binding.datasource_ref or "")
+            if not source_id:
+                _warn(warnings, f"semantic_source_unregistered:{binding.binding_id}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail="semantic_source_unregistered: 绑定数据源未注册")
+                continue
+            snapshot = snapshots.get(source_id)
+            if snapshot is None:
+                _warn(warnings, f"semantic_not_collected:{source_id}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail=f"semantic_not_collected: 数据源 {source_id} 无已发布语义快照")
+                continue
+            table_name = binding.source_table.split(".")[-1]
+            table = _snapshot_table(snapshot, table_name, binding)
+            if table is None:
+                _warn(warnings, f"binding_table_missing:{source_id}:{table_name}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail=f"表 {binding.source_table} 不在语义快照中（结构漂移）")
+                continue
+            physical_columns = {
+                physical.split(".")[-1] for physical in binding.column_map.values()
+            } or set(binding.column_map.keys())
+            missing = sorted(
+                name for name in physical_columns
+                if name not in {c.name for c in table.columns})
+            if missing:
+                _warn(warnings, f"binding_columns_missing:{table_name}:{','.join(missing)}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail=f"列 {','.join(missing)} 不在表 {table_name} 的语义快照中")
+                continue
+            store.update_binding_status(
+                binding.binding_id, BINDING_VERIFIED,
+                verify_detail=f"semantic:{source_id}@{snapshot.snapshot_id}")
+            if source_id not in seen_sources:
+                seen_sources.add(source_id)
+                refs.append({"source_id": source_id, "snapshot_id": snapshot.snapshot_id})
+    return refs
+
+
+def _snapshot_table(snapshot: Any, table_name: str, binding: Any) -> Any | None:
+    """快照内按表名取 TableMeta；多 database 同名表按 column_map 命中锚定。"""
+    candidates = [t for t in snapshot.tables if t.name == table_name]
+    if len(candidates) == 1:
+        return candidates[0]
+    if not candidates:
+        # 绑定写的是全限定名（db.table）时按 fqn 再试一轮
+        fqn_match = [t for t in snapshot.tables if t.fqn == binding.source_table]
+        return fqn_match[0] if fqn_match else None
+    physical_columns = {
+        physical.split(".")[-1] for physical in binding.column_map.values()
+    } or set(binding.column_map.keys())
+    for table in candidates:
+        names = {c.name for c in table.columns}
+        if physical_columns and physical_columns <= names:
+            return table
+    return None
+
+
+# ==========================================================================
+# 语义上下文（替代旧 adapter.retrieve_context）
+# ==========================================================================
+
+def build_semantic_context(
+    workspace_id: str, metric_key: str, release: Release | None,
+) -> SemanticContext:
+    """从 ``dw_metric_*`` 表 + semantic 快照组装指标语义上下文。
+
+    Raises:
+        SemanticContextEmpty: 指标在该 release 内没有 published 修订。
+    """
+    revision = _revision_for(workspace_id, metric_key, release)
+    if revision is None:
+        raise SemanticContextEmpty(
+            f"语义层检索不到 {metric_key}（workspace={workspace_id}, "
+            f"release={release.release_id if release else None}）；"
+            "请确认该指标已发布")
+    metric = store.get_def(revision.metric_id)
+    if metric is None:
+        raise SemanticContextEmpty(f"指标定义缺失: {metric_key}")
+    warnings: list[str] = []
+    refs, snapshots = current_snapshots(warnings)
+    bindings = [b for b in store.list_bindings(revision.revision_id) if b.source_table]
+    mappings = store.list_concept_maps(revision.revision_id, status="confirmed")
+    summary = formula_summary(revision)
+
+    dependencies: dict[str, dict[str, Any]] = {}
+    concept: str | None = None
+    numerator: str | None = None
+    denominator: str | None = None
+    for mapping in mappings:
+        if mapping.relation_type == "measuresConcept":
+            if concept is None:
+                concept = mapping.target_ref
+            continue
+        if mapping.relation_type not in ("dependsOn", "numerator", "denominator"):
+            continue
+        entry = dependencies.setdefault(
+            mapping.target_ref, {"metric_key": mapping.target_ref, "roles": [], "fields": []})
+        if mapping.relation_type not in entry["roles"]:
+            entry["roles"].append(mapping.relation_type)
+        if mapping.relation_type == "numerator" and numerator is None:
+            numerator = mapping.target_ref
+        if mapping.relation_type == "denominator" and denominator is None:
+            denominator = mapping.target_ref
+    for dep_key, entry in dependencies.items():
+        entry["fields"] = _dependency_fields(workspace_id, dep_key, bindings)
+
+    physical = _physical_bindings(revision, bindings, snapshots)
+    schema_sub = None
+    if snapshots and physical:
+        seeds = [pid.table_id for pid in physical if pid.table_id]
+        seeds += [cid for pid in physical for cid in pid.node_ids.values()]
+        schema_sub = build_exploration_subgraph(snapshots, seeds)
+    group_by: list[str] = []
+    time_field: str | None = None
+    for pid in physical:
+        group_by.extend(pid.group_by)
+        if time_field is None:
+            time_field = pid.time_field
+    ctx = SemanticContext(
+        workspace_id=workspace_id, metric_key=metric_key,
+        release_id=release.release_id if release else None,
+        revision=str(revision.revision_no),
+        label=revision.display_name or metric.name,
+        comment=metric.description or "",
+        unit=revision.unit,
+        operator=revision.expression.parsed.operator if revision.expression.parsed else "",
+        formula_summary=summary,
+        synonyms=list(revision.synonyms),
+        concept=concept,
+        dependencies=_sorted_dependencies(dependencies),
+        numerator=numerator, denominator=denominator,
+        time_field=time_field,
+        group_by_fields=group_by,
+        definition_ref=revision.definition_ref,
+        warnings=warnings,
+        schema=schema_sub,
+        schema_snapshot_id=refs[0].snapshot_id if refs else None,
+        drift=not refs,
+    )
+    return ctx
+
+
+def _revision_for(workspace_id: str, metric_key: str, release: Release | None) -> Any | None:
+    """指标在 release 作用域内的 published 修订（无 release 取当前修订）。"""
+    from .model import REVISION_PUBLISHED
+
+    for metric in store.list_defs(workspace_id):
+        if metric.metric_key != metric_key or not metric.current_revision_id:
+            continue
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is None or revision.status != REVISION_PUBLISHED:
+            return None
+        if release is None or revision.revision_id in release.revision_ids:
+            return revision
+    return None
+
+
+@dataclass(frozen=True)
+class _PhysicalRef:
+    """一次 binding → 快照对象的解析产物。
+
+    ``table_id``/``node_ids``：快照内真实 node_id（解析不到为空——子图
+    种子缺位只影响可视化，不影响字段语义）；``fields``：物理 ``表.列`` 串
+    （与旧 link 边 logicalField 同构）；``time_field``/``group_by`` 同理。
+    """
+
+    table_id: str
+    node_ids: dict[str, str]
+    fields: tuple[str, ...]
+    time_field: str | None
+    group_by: list[str]
+
+
+def _physical_bindings(
+    revision: Any, bindings: list[Any], snapshots: dict[str, Any] | None = None,
+) -> list[_PhysicalRef]:
+    """修订的逻辑字段（time/dimensions）经 column_map 物理化 + 快照对象锚定。
+
+    快照给了就尝试把 (表名, 物理列) 锚定到真实 node_id（同表名多库歧义时
+    列名全命中者优先，锚不定留空——绝不造悬空 ID）。
+    """
+    index = _snapshot_index(snapshots) if snapshots else {}
+    out: list[_PhysicalRef] = []
+    for binding in bindings:
+        table = binding.source_table.split(".")[-1]
+        physical_fields: dict[str, str] = {}
+
+        def physicalize(logical: str) -> str:
+            column = logical.split(".", 1)[1] if "." in logical else logical
+            physical = binding.column_map.get(column, column)
+            physical_fields[physical] = f"{table}.{physical}"
+            return f"{table}.{physical}"
+
+        time_field = physicalize(revision.time_dimension) if revision.time_dimension else None
+        group_by = [physicalize(d) for d in revision.allowed_dimensions if d]
+        if not physical_fields:
+            for logical in (revision.time_dimension, *revision.allowed_dimensions):
+                if logical:
+                    physicalize(logical)
+        table_id, node_ids = _anchor_to_snapshot(index, table, physical_fields)
+        out.append(_PhysicalRef(
+            table_id=table_id, node_ids=node_ids,
+            fields=tuple(physical_fields.values()),
+            time_field=time_field, group_by=group_by))
+    return out
+
+
+def _anchor_to_snapshot(
+    index: dict[str, Any], table_name: str, columns: dict[str, str],
+) -> tuple[str, dict[str, str]]:
+    """(表名, 物理列集) → (表 node_id, {物理列: 列 node_id})。
+
+    多 database 同名表歧义时按列名全命中锚定；全部锚不定返回空
+    （``("", {})``——调用方按缺位降级）。
+    """
+    entry = index.get(table_name) or {}
+    if not entry:
+        return "", {}
+    if len(entry) == 1:
+        table, column_index = next(iter(entry.values()))
+        return table.node_id, {
+            name: column_index[name].node_id
+            for name in columns if name in column_index}
+    # 歧义：列名全命中的库胜出；无全命中不锚定
+    for table, column_index in entry.values():
+        if columns and all(name in column_index for name in columns):
+            return table.node_id, {
+                name: column_index[name].node_id for name in columns}
+    return "", {}
+
+
+def _dependency_fields(workspace_id: str, dep_key: str, own_bindings: list[Any]) -> list[str]:
+    """依赖指标经其 bindings 引用的物理列（``表.列`` 形态）。
+
+    依赖指标无绑定时退回自身 bindings 的字段面（旧图读不到依赖节点时
+    fields 为空——这里至少给 LLM 一个诚实的空/近似面，不虚构）。
+    """
+    for metric in store.list_defs(workspace_id):
+        if metric.metric_key != dep_key or not metric.current_revision_id:
+            continue
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is None:
+            return []
+        refs = _physical_bindings(
+            revision, [b for b in store.list_bindings(revision.revision_id) if b.source_table])
+        return [field for ref in refs for field in ref.fields]
+    return []
+
+
+def _sorted_dependencies(dependencies: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
+    """依赖按 metric_key 排序（确定性输出，快照/哈希稳定）。"""
+    return [dependencies[key] for key in sorted(dependencies)]
+
+
+def context_digest(ctx: SemanticContext) -> str:
+    """语义上下文摘要，写进查询追溯用于复查（不含业务数据）。"""
+    from .model import canonical_json, sha256_of
+
+    payload = {
+        "metric_key": ctx.metric_key,
+        "release_id": ctx.release_id,
+        "revision": ctx.revision,
+        "definition_ref": ctx.definition_ref,
+        "operator": ctx.operator,
+        "formula_summary": ctx.formula_summary,
+        "concept": ctx.concept,
+        "dependencies": ctx.dependencies,
+        "time_field": ctx.time_field,
+        "group_by_fields": ctx.group_by_fields,
+    }
+    return sha256_of(canonical_json(payload))
+
