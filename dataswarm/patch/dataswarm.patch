+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Real SFTP identity/authentication boundaries and deterministic cleanup checks."""
+from __future__ import annotations
+
+import asyncio
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+asyncssh = pytest.importorskip("asyncssh")
+paramiko = pytest.importorskip("paramiko")
+
+from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError
+from jiuwenswarm.channels.web.dataagent.connectors.staged_connector import _SftpFetcher
+
+
+@pytest.fixture
+def sftp_server(tmp_path):
+    root = tmp_path / "data"
+    root.mkdir()
+    (root / "orders.csv").write_text("id,amount\n1,12.5\n", encoding="utf-8")
+    state = SimpleNamespace(password_attempts=0, connections=[], closed=threading.Event())
+    ready = queue.Queue()
+    key = asyncssh.generate_private_key("ssh-rsa")
+
+    class Server(asyncssh.SSHServer):
+        def connection_made(self, connection):
+            state.connections.append(connection)
+
+        def connection_lost(self, exc):
+            state.closed.set()
+
+        def begin_auth(self, username):
+            return True
+
+        def password_auth_supported(self):
+            return True
+
+        def validate_password(self, username, password):
+            state.password_attempts += 1
+            return username == "fixture-user" and password == "fixture-password"
+
+    async def serve():
+        stop = asyncio.Event()
+        async with await asyncssh.create_server(
+            Server, "127.0.0.1", 0, server_host_keys=[key],
+            sftp_factory=lambda channel: asyncssh.SFTPServer(channel, chroot=str(root)),
+        ) as server:
+            ready.put((asyncio.get_running_loop(), stop, server.get_port()))
+            await stop.wait()
+        for connection in state.connections:
+            connection.close()
+        await asyncio.gather(*(connection.wait_closed() for connection in state.connections), return_exceptions=True)
+
+    def thread_main():
+        try:
+            asyncio.run(serve())
+        except BaseException as exc:
+            ready.put(exc)
+
+    thread = threading.Thread(target=thread_main, daemon=True)
+    thread.start()
+    started = ready.get(timeout=10)
+    if isinstance(started, BaseException):
+        raise started
+    loop, stop, port = started
+    known_hosts = tmp_path / "known_hosts"
+    known_hosts.write_text(f"[127.0.0.1]:{port} " + key.export_public_key("openssh").decode("ascii"), encoding="ascii")
+    state.config = {"host": "127.0.0.1", "port": port, "user": "fixture-user",
+                    "password": "fixture-password", "known_hosts": str(known_hosts)}
+    state.known_hosts = known_hosts
+    state.key = key
+    state.port = port
+    try:
+        yield state
+    finally:
+        loop.call_soon_threadsafe(stop.set)
+        thread.join(timeout=10)
+        assert not thread.is_alive(), "temporary SSH server did not close"
+
+
+@pytest.fixture
+def clients(monkeypatch):
+    created = []
+    real_client = paramiko.SSHClient
+
+    def create():
+        client = real_client()
+        created.append(client)
+        return client
+
+    monkeypatch.setattr(paramiko, "SSHClient", create)
+    return created
+
+
+def test_known_hosts_allows_real_download_and_idempotent_close(sftp_server, clients, tmp_path):
+    fetcher = _SftpFetcher(sftp_server.config)
+    assert [item[0] for item in fetcher.list_files("/*.csv")] == ["/orders.csv"]
+    target = tmp_path / "received.csv"
+    fetcher.download("/orders.csv", target)
+    assert target.read_text(encoding="utf-8") == "id,amount\n1,12.5\n"
+    assert sftp_server.password_attempts == 1
+    assert fetcher._sftp.get_channel().gettimeout() == 30
+    fetcher.close()
+    fetcher.close()
+    assert clients[0].get_transport() is None
+    assert sftp_server.closed.wait(3)
+
+
+def test_trusted_sha256_pin_allows_real_connection(sftp_server, clients):
+    config = {**sftp_server.config, "known_hosts": "", "host_key_sha256": sftp_server.key.get_fingerprint("sha256")}
+    fetcher = _SftpFetcher(config)
+    try:
+        assert fetcher.list_files("/*.csv")
+        assert sftp_server.password_attempts == 1
+    finally:
+        fetcher.close()
+    assert clients[0].get_transport() is None
+
+
+@pytest.mark.parametrize("trust", ["wrong_known_hosts", "unknown_host", "wrong_pin"])
+def test_wrong_or_unknown_identity_is_rejected_before_password(sftp_server, clients, trust):
+    config = dict(sftp_server.config)
+    if trust == "wrong_known_hosts":
+        other = asyncssh.generate_private_key("ssh-rsa")
+        sftp_server.known_hosts.write_text(
+            f"[127.0.0.1]:{sftp_server.port} " + other.export_public_key("openssh").decode("ascii"), encoding="ascii")
+    elif trust == "unknown_host":
+        sftp_server.known_hosts.write_text("", encoding="ascii")
+    else:
+        config.update(
+            known_hosts="", host_key_sha256=asyncssh.generate_private_key("ssh-rsa").get_fingerprint("sha256")
+        )
