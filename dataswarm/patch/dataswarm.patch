+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useRef } from 'react';
+import * as echarts from 'echarts';
+
+/**
+ * ECharts 通用封装。
+ *
+ * 工程约束：
+ *   - chart 实例只在挂载时 init 一次，卸载时 dispose。option 变化时只 setOption（merge），
+ *     不重建 chart——避免「option 每变一次就 dispose+init」导致的闪烁。
+ *   - resize：ResizeObserver 监听容器尺寸变化，图表自适应。
+ *   - onEvents：事件绑定在 init 时一次，handler 变化通过 ref 透传最新版（不重绑）。
+ *
+ * 事件 key 为 ECharts 事件名（如 'click'），value 为回调，收到 echarts 透传的 params。
+ */
+export type EChartEventMap = Record<string, (params: unknown) => void>;
+
+function normalizeOption(option: echarts.EChartsOption | string): echarts.EChartsOption | null {
+  if (typeof option !== 'string') return option;
+
+  try {
+    return JSON.parse(option) as echarts.EChartsOption;
+  } catch {
+    return null;
+  }
+}
+
+export function EChart({
+  option,
+  height = 360,
+  onEvents,
+}: {
+  option: echarts.EChartsOption | string;
+  height?: number;
+  onEvents?: EChartEventMap;
+}) {
+  const ref = useRef<HTMLDivElement>(null);
+  const chartRef = useRef<echarts.EChartsType | null>(null);
+  // 事件 handler 用 ref 透传，避免 handler 变化触发重建
+  const eventsRef = useRef<EChartEventMap | undefined>(onEvents);
+  eventsRef.current = onEvents;
+
+  // 仅挂载时 init + 卸载时 dispose（不依赖 option）
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    const chart = echarts.init(el);
+    chartRef.current = chart;
+    const observer = new ResizeObserver(() => chart.resize());
+    observer.observe(el);
+    // 事件绑定一次，handler 通过 ref 取最新
+    const dispatch = (eventName: string) => (params: unknown) => {
+      const handler = eventsRef.current?.[eventName];
+      if (handler) handler(params);
+    };
+    // 预绑定常用事件；未知事件按需扩展
+    ['click', 'dblclick', 'mouseover', 'mouseout'].forEach((ev) => chart.on(ev, dispatch(ev)));
+    return () => {
+      observer.disconnect();
+      chart.dispose();
+      chartRef.current = null;
+    };
+  }, []);
+
+  // option 变化时只 setOption（merge，不重建 chart）
+  useEffect(() => {
+    const chart = chartRef.current;
+    const normalizedOption = normalizeOption(option);
+    if (chart && normalizedOption) chart.setOption(normalizedOption, false);
+  }, [option]);
+
+  return <div ref={ref} style={{ height }} className="w-full" />;
+}
