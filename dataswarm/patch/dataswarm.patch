@@ -0,0 +1,518 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""V2 HTTP API 端点测试（/api/dataagent/metrics/v2/*）。
+
+FakeHandler 直测 controller 入口（模式照 test_inspection_endpoints.py）；
+存储/业务库/语义图用 conftest 的 ``e2e`` fixture，LLM 打桩。旧端点（/metrics
+无 v2 前缀）不受影响的回归由旧 api 的消费方（dashboard 前端）与既有测试保证。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import api_v2
+from jiuwenswarm.channels.web.dataagent.metrics import store
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, WORKSPACE
+
+AOV = "commerce.aov"
+GMV = "commerce.gmv"
+PREFIX = "/api/dataagent/metrics/v2"
+
+
+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    """满足 api_v2 所需的最小 handler 面：_write_json / _query_arg / headers / rfile。"""
+
+    def __init__(self, path: str, body: dict | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        self.headers = {"Content-Length": str(len(json.dumps(body))) if body else "0"}
+        self.rfile = _FakeRfile(json.dumps(body).encode() if body else b"")
+        self._resp = FakeResponse()
+
+    def _write_json(self, status, payload):
+        self._resp.capture(status, payload)
+
+    def _query_arg(self, parsed, name):
+        return {k: v[0] for k, v in parse_qs(parsed.query).items()}.get(name)
+
+    @property
+    def response(self):
+        return self._resp
+
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, _length):
+        return self._data
+
+
+def _get(path: str) -> FakeHandler:
+    return FakeHandler(path)
+
+
+def _post(path: str, body: dict) -> FakeHandler:
+    return FakeHandler(path, body)
+
+
+def _spec_json(metric: str, grain: str = "") -> str:
+    time_obj = {"dimension": "orders.paid_at", "start": "2026-08-01",
+                "end_exclusive": "2026-09-01"}
+    if grain:
+        time_obj["grain"] = grain
+    return json.dumps({"spec": {"metrics": [metric], "group_by": ["orders.region"],
+                                "time": time_obj}, "clarifications": []})
+
+
+@pytest.fixture
+def api(e2e, monkeypatch):
+    """e2e 环境 + LLM 桩 + 语义层指向 e2e 的图目录。"""
+    monkeypatch.setenv("DATASWARM_METRICS_SEMANTICA_ENABLED", "true")
+    yield e2e
+
+
+# ==========================================================================
+# health / list / get
+# ==========================================================================
+def test_health_reports_semantic_layer(api):
+    handler = _get(f"{PREFIX}/health")
+    api_v2.handle_get(handler, handler.parsed)
+    assert handler.response.status == 200
+    assert handler.response.payload["enabled"] is True
+    assert "semantic" in handler.response.payload
+
+
+def test_list_empty_then_import(api):
+    handler = _get(f"{PREFIX}/metrics")
+    api_v2.handle_get(handler, handler.parsed)
+    assert handler.response.status == 200
+    assert handler.response.payload["metrics"] == []
+
+    import_handler = _post(f"{PREFIX}/ossie/import",
+                           {"content": OSSIE_EXAMPLE.read_text(encoding="utf-8")})
+    api_v2.handle_post(import_handler, import_handler.parsed)
+    assert import_handler.response.status == 200
+    payload = import_handler.response.payload
+    assert payload["created"] is True
+    assert len(payload["revisions"]) == 3
+    assert len(payload["candidate_mappings"]) == 7  # dependsOn×2 + num/den×2 + concept×3
+
+    handler2 = _get(f"{PREFIX}/metrics")
+    api_v2.handle_get(handler2, handler2.parsed)
+    keys = {m["metric_key"] for m in handler2.response.payload["metrics"]}
+    assert keys == {GMV, "commerce.paid_order_count", AOV}
+    # 未发布：current_revision 为 None
+    assert all(m["current_revision"] is None for m in handler2.response.payload["metrics"])
+
+
+def test_list_pagination_and_status_filter(api):
+    _post_import(api)
+
+    # 不带 page 保持全量（dwcli 等旧调用方兼容）
+    full = _get(f"{PREFIX}/metrics")
+    api_v2.handle_get(full, full.parsed)
+    assert len(full.response.payload["metrics"]) == 3
+    assert full.response.payload["total"] == 3
+    assert full.response.payload["status_counts"] == {"published": 0, "draft": 3}
+
+    # 服务端分页：总数不随页大小变
