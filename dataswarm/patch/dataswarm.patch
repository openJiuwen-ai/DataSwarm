+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import { useEffect, useRef, useState } from 'react';
+import { ChevronDown, Search } from 'lucide-react';
+import { useDataManagementStore } from '../../store/dataManagementStore';
+
+export function DbSelector() {
+  const { t } = useTranslation();
+  const { databases, selectedDb, selectDb } = useDataManagementStore();
+  const [open, setOpen] = useState(false);
+  const [search, setSearch] = useState('');
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const onClick = (e: MouseEvent) => {
+      if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false);
+    };
+    document.addEventListener('mousedown', onClick);
+    return () => document.removeEventListener('mousedown', onClick);
+  }, []);
+
+  if (!databases.length) return <div className="dm-db-empty">{t('dataManagement.databaseEmpty')}</div>;
+
+  const filtered = databases.filter((db) => db.name.toLowerCase().includes(search.toLowerCase()));
+  const selected = databases.find((db) => db.name === selectedDb);
+
+  return (
+    <div ref={ref} className="dm-db">
+      <button
+        type="button"
+        className="dm-db-button"
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        onClick={() => setOpen((v) => !v)}
+      >
+        <span className="dm-db-name">{selected?.name ?? t('dataManagement.selectDatabase')}</span>
+        {selected && <span className="dm-db-count">{t('dataManagement.tableCount', { count: selected.table_count })}</span>}
+        <ChevronDown size={14} aria-hidden="true" />
+      </button>
+      {open && (
+        <div className="dm-db-pop">
+          <div className="dm-db-search">
+            <Search size={14} aria-hidden="true" />
+            <input
+              type="text"
+              placeholder={t('dataManagement.searchDatabase')} aria-label={t('dataManagement.searchDatabase')}
+              value={search}
+              onChange={(e) => setSearch(e.target.value)}
+              autoFocus
+            />
+          </div>
+          <ul className="dm-db-list" role="listbox" aria-label={t('dataManagement.selectDatabase')}>
+            {filtered.map((db) => (
+              <li key={db.path}>
+                <button
+                  type="button"
+                  role="option"
+                  aria-selected={db.name === selectedDb}
+                  className="dm-db-item"
+                  onClick={() => {
+                    void selectDb(db.name);
+                    setOpen(false);
+                    setSearch('');
+                  }}
+                >
+                  <span>{db.name}</span>
+                  <span>{t('dataManagement.tableCount', { count: db.table_count })}</span>
+                </button>
+              </li>
+            ))}
+            {!filtered.length && <li className="dm-db-empty">{t('dataManagement.noMatches')}</li>}
+          </ul>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/data-management/components/shared/LineageView.tsx b/jiuwenswarm/channels/web/frontend/src/features/data-management/components/shared/LineageView.tsx
