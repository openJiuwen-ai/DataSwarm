+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""sync_baseline.py —— 基线升级（merge-tree 三方合并；develop_oss 不携带基线 git 历史）。
+
+base = 旧基线 tag，ours = develop_oss，theirs = 新基线 tag，合并结果提交到 develop_oss 并更新 fork_config.
+
+用法:
+    python scripts/dataswarm/fork/sync_baseline.py workswarm0.2.7 [--dry-run]
+
+冲突时：不移动 develop_oss，创建 `upgrade-<tag>` 分支（含冲突标记的合并树），按提示人工处理。
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from _fork_lib import (  # noqa: E402
+    FORK_CONFIG,
+    REPO_ROOT,
+    ForkError,
+    dev_hub_branch,
+    ensure_baseline_tag,
+    git,
+    hash_blob,
+    load_config,
+    rev,
+)
+
+CONFIG_PATH = FORK_CONFIG.relative_to(REPO_ROOT).as_posix()
+
+
+def merge_tree(base: str, ours: str, theirs: str) -> tuple[str | None, int, str]:
+    """返回 (合并树 sha, 退出码, 完整输出)。"""
+    proc = git("merge-tree", "--write-tree", f"--merge-base={base}", ours, theirs, check=False)
+    out = proc.stdout.decode("utf-8", "replace")
+    tree = None
+    for line in out.splitlines():
+        token = line.strip().split(" ")[0]
+        if len(token) == 40 and all(c in "0123456789abcdef" for c in token):
+            tree = token
+            break
+    return tree, proc.returncode, out
+
+
+def config_with_ref(new_tag: str, branch: str) -> bytes:
+    text = git("show", f"{branch}:{CONFIG_PATH}").stdout.decode("utf-8")
+    lines = []
+    for line in text.splitlines():
+        if line.strip().startswith("ref:") and line.startswith("  "):
+            indent = line[:len(line) - len(line.lstrip())]
+            lines.append(f"{indent}ref: {new_tag}")
+        else:
+            lines.append(line)
+    return ("\n".join(lines) + "\n").encode("utf-8")
+
+
+def write_tree_with_config(tree: str, config_blob: str) -> str:
+    with tempfile.TemporaryDirectory(prefix="dataswarm-upgrade-") as tmp:
+        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "upgrade.index")}
+        git("read-tree", tree, env=env)
+        git("update-index", "--add", "--cacheinfo", f"100644,{config_blob},{CONFIG_PATH}", env=env)
+        return git("write-tree", env=env).stdout.decode().strip()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="基线升级：merge-tree 三方合并到 develop_oss")
+    ap.add_argument("new_tag", help="新基线 tag（如 workswarm0.2.7）")
+    ap.add_argument("--dry-run", action="store_true", help="只做合并预演，不提交")
+    args = ap.parse_args()
+
+    cfg = load_config()
+    branch = dev_hub_branch(cfg)
+    current = git("symbolic-ref", "--quiet", "--short", "HEAD", check=False).stdout.decode().strip()
+    if current != branch:
+        raise ForkError(f"当前分支不是 {branch}（{current or 'detached'}）——基线升级需在 {branch} 检出上执行")
+    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
+        raise ForkError("工作区有未提交改动——先提交")
+
+    old_tag = cfg["baseline"]["ref"]
+    if old_tag == args.new_tag:
+        print(f"[OK] 基线已是 {old_tag}——no-op")
+        return 0
+    ensure_baseline_tag(args.new_tag)
+    branch_sha = rev(branch)
+    if not branch_sha:
+        raise ForkError(f"无法解析 {branch} 的提交 SHA")
+
+    tree, code, out = merge_tree(f"refs/tags/{old_tag}", branch, f"refs/tags/{args.new_tag}")
+    if tree is None:
+        raise ForkError(f"merge-tree 未产出树对象:\n{out}")
+
+    if code != 0:
+        # 冲突：建 upgrade-<tag> 分支供人工解决，develop_oss 不动
+        msg = (f"chore(upgrade): 基线 {old_tag} -> {args.new_tag} 合并（含冲突）\n\n"
+               f"人工解决后：git add -A && git commit && git branch -f {branch} upgrade-{args.new_tag}\n")
+        if not args.dry_run:
+            commit = git("commit-tree", tree, "-p", branch_sha, "-m", msg).stdout.decode().strip()
+            git("update-ref", f"refs/heads/upgrade-{args.new_tag}", commit)
+            print(out)
+            print(f"[WARN] 存在冲突——已建分支 upgrade-{args.new_tag}（{branch} 未移动）。")
+            print(f"       处理: git checkout upgrade-{args.new_tag} → 解冲突 → git add -A && git commit")
+            print(f"             → 更新 {CONFIG_PATH} 的 ref → 手工 git branch -f {branch} upgrade-{args.new_tag}")
+        else:
+            print(out)
+            print("[dry-run] 合并存在冲突")
+        return 1
+
+    config_blob = hash_blob(config_with_ref(args.new_tag, branch))
+    final_tree = write_tree_with_config(tree, config_blob)
+    if args.dry_run:
+        print(f"[dry-run] 合并干净，结果树 {final_tree}（基线 {old_tag} -> {args.new_tag}）")
+        return 0
+
+    msg = (f"feat(baseline): 升级基线 {old_tag} -> {args.new_tag}\n\n"
+           f"merge-tree 三方合并（base={old_tag}, ours={branch}, theirs={args.new_tag}）\n"
+           f"{branch} 不携带基线 git 历史；基线 tag 记录于 {CONFIG_PATH}\n\n"
+           f"Baseline-Tag: {args.new_tag}\n")
+    commit = git("commit-tree", final_tree, "-p", branch_sha, "-m", msg).stdout.decode().strip()
+    git("update-ref", f"refs/heads/{branch}", commit, branch_sha)
+    git("reset", "--hard", "-q", "HEAD")
+    print(f"[OK] 基线已升级 {old_tag} -> {args.new_tag}（commit {commit[:12]}）")
+    print("[*] 提示：基线升级后 patch 面自动收缩（已进基线的改动不再出现在归档 diff）——"
+          "提交后重跑 archive_delta.py 生成新归档")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
