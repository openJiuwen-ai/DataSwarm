+def a_unavailable_reason_is_actionable():
+    types = {t["type_id"]: t for t in R.list_source_types()}
+    # 使用不支持的产品类别验证拒绝路径，避免新增协议支持改变反例含义。
+    for tid in ("erp", "crm", "oa"):
+        assert types[tid]["unavailable_reason"] == "not_released", types[tid]
+    # 已支持的类型不应返回禁用原因。
+    for tid in ("postgresql", "parquet"):
+        assert types[tid]["unavailable_reason"] == "", types[tid]
+    return "未放开类型给出 not_released，已放开类型原因为空（与 driver_missing 可区分）"
