index 000000000..95d470cb2
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/analysis/context_pack.py
@@ -0,0 +1,377 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/context_pack.py —— L2③ 上下文组装：三子包并列。
+
+- **术语子包**：definition / 别名 / 歧义标注——业务语义约束；
+- **指标子包**：候选与选定分开；候选附维度/粒度白名单（供 L2 规划预判
+  越界）；选定指标（QueryPlan 之后回填）附定义、口径、绑定表列、依赖
+  闭包、单位、metric_kind（复用 ``semantic_link.build_semantic_context``）；
+- **schema 子包**：按表分组——命中列作选表信号 → 装入表列与注释；join
+  路径带证据等级；命中列附维值候选；带 source_id / snapshot_id。
+
+维值作为列属性附在 schema 子包内（不独立成包）；组装的是**尽力而为的
+上下文**，不保证完整（充分性由 L3 模型逐 component 判断）。
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any
+
+from ..metrics import semantic_link, store
+from .graph_expand import Expansion
+from .model import (
+    GRAPH_MEASURES_PREFIX,
+    METRICS_LIMIT,
+    ContextPacks,
+    RecallHit,
+    RoadResult,
+    SchemaTablePack,
+)
+from .rerank import dedupe_and_rank, mark_ambiguity
+from .shortcut import term_view
+
+# 指标候选榜进上下文的上限（选定指标的完整闭包不受此截断——回源读取）
+CANDIDATE_PACK_LIMIT = METRICS_LIMIT
+
+# 选中证据等级（与 G1/G2/G3 正交，见 evidence_tier_of）
+CONFIRMED_TIER, SCORED_TIER = "confirmed", "scored"
+# 人工确认关系的来源前缀（单源于 model.GRAPH_MEASURES_PREFIX）：
+# 术语→指标的 measuresConcept 边（confirmed 才进图）
+
+
+def build_packs(
+    recall_results: dict[str, RoadResult],
+    expansion: Expansion,
+    workspace_id: str,
+    snapshots: dict[str, Any],
+    snapshot_refs: list[Any],
+) -> ContextPacks:
+    """L1 四路 + 图补全 → 去重精排 → 三子包。
+
+    Args:
+        recall_results: ``recall_all`` 返回。
+        expansion: ``graph_expand.expand`` 返回。
+        workspace_id: 工作空间。
+        snapshots: 快照集（schema 子包列结构来源）。
+        snapshot_refs: SemanticRef 列表（版本记录）。
+
+    Returns:
+        :class:`ContextPacks`——``metrics_selected`` 此时为空（QueryPlan
+        后由 :func:`fill_selected_metrics` 回填）。
+    """
+    packs = ContextPacks()
+
+    # ---- 术语子包：直发 + 图补全（指标 → measuresConcept → 术语）----
+    terms_ranked = mark_ambiguity(dedupe_and_rank(
+        recall_results.get("terms", RoadResult("term", (), "unavailable")),
+        [_term_hit(term) for term in expansion.terms],
+    ))
+    for hit in terms_ranked:
+        packs.glossary.append(term_view(hit))
+
+    # ---- 指标子包（候选）：直发 + 图补全 ----
+    metrics_ranked = dedupe_and_rank(
+        recall_results.get("metrics", RoadResult("metric", (), "unavailable")),
+        expansion.metrics,
+    )
+    for hit in metrics_ranked[:CANDIDATE_PACK_LIMIT]:
+        candidate = {
+            "metric_key": hit.entity_id,
+            "display_name": hit.payload.get("display_name") or hit.label,
+            "revision_id": hit.payload.get("revision_id") or "",
+            "matched_on": list(hit.matched_on),
+            "evidence_tier": evidence_tier_of(hit),
+        }
+        # 候选阶段即附维度/粒度白名单：规划层要先能预判越界，否则只能在
+        # compile 被拒后修计划重来（smoke 实证：gmv+order_status 规划 →
+        # dimension_not_allowed → 修计划往返 5 次工具调用，未变成分还被
+        # 连带重新执行）。回读失败不阻断候选输出（与选定回填同容错口径）。
+        revision = store.published_revision_of(workspace_id, hit.entity_id)
+        if revision is not None:
+            candidate["allowed_dimensions"] = list(revision.allowed_dimensions)
+            candidate["time_grains"] = list(revision.time_grains)
+        packs.metrics_candidates.append(candidate)
+
+    # ---- schema 子包：按表分组（命中列 + 同表展开 + join + 维值候选）----
+    schema_ranked = dedupe_and_rank(
+        recall_results.get("schema", RoadResult("column", (), "unavailable")),
+        expansion.columns,
+    )
+    value_candidates = _value_candidates_by_column(
+        recall_results.get("values", RoadResult("value", (), "unavailable")))
+    matched_column_ids = {hit.entity_id for hit in recall_results.get(
+        "schema", RoadResult("column", (), "unavailable")).hits}
+    table_packs = _group_by_table(schema_ranked, snapshots, expansion)
+    for pack in table_packs:
+        for column in pack.columns:
+            column["value_candidates"] = value_candidates.get(column.get("node_id") or "", [])
+            column["matched"] = column.get("node_id") in matched_column_ids
+        pack.joins = [join for join in expansion.joins
+                      if _join_touches_table(join, pack.table_id)]
+    packs.schema_tables = table_packs
+
+    # ---- 语义版本记录 ----
+    packs.semantic_versions = _versions_view(workspace_id, snapshot_refs, expansion)
+    return packs
+
+
+def build_shortcut_packs(
+    term: dict[str, Any],
+    metric_key: str,
+    expansion: Expansion,
+    workspace_id: str,
+    snapshots: dict[str, Any],
+    snapshot_refs: list[Any],
+) -> ContextPacks:
+    """短路包：术语口径 + 选定指标（无候选榜）+ 链上表列。
+
+    与 :func:`build_packs` 的三处差别（设计 §3.3——窄而确定）：
+
+    - ``metrics_candidates`` 恒空：模型无从选别的，也无需选（候选甄别正是
+      短路省掉的那一步）；``metrics_selected`` 不等 QueryPlan 直接回填完整
+      闭包（口径/绑定/依赖）；
+    - ``schema_tables`` 只装链涉及表（指标绑定带出 + 同表全列 + join 边）；
+    - 维值候选恒空：短路路径不跑维值路（四路里偏贵的一路，省它正是收益）
+      ——过滤值由编排层提交计划前批量 probe 精确确认。
+
+    Args:
+        term: 命中术语（:func:`shortcut.term_view` 产物）。
+        metric_key: 链指标的 metric_key（唯一 published）。
+        expansion: 以该指标为入口、``seed_bound_columns=True`` 的图补全结果。
+        workspace_id: 工作空间。
+        snapshots: 快照集（列结构来源）。
+        snapshot_refs: SemanticRef 列表（版本记录）。
+
+    Returns:
+        :class:`ContextPacks`。
+    """
+    packs = ContextPacks()
+    packs.glossary.append(dict(term))
+
+    table_packs = _group_by_table(expansion.columns, snapshots, expansion)
+    # 绑定带出的列（graph: 来源）标 matched——口径核心列，与同表填充列区分
+    bound_ids = {hit.entity_id for hit in expansion.columns
+                 if any(mark.startswith("graph:") for mark in hit.matched_on)}
+    for pack in table_packs:
+        for column in pack.columns:
+            column["value_candidates"] = []
+            column["matched"] = column.get("node_id") in bound_ids
+        pack.joins = [join for join in expansion.joins
+                      if _join_touches_table(join, pack.table_id)]
+    packs.schema_tables = table_packs
+
+    packs.semantic_versions = _versions_view(workspace_id, snapshot_refs, expansion)
+    fill_selected_metrics(packs, workspace_id, [metric_key])
+    # 短路路径的选定指标是顺人工确认的术语关系找到的——最硬的背书
+    for selected in packs.metrics_selected:
+        selected["evidence_tier"] = CONFIRMED_TIER
+    return packs
+
+
+def fill_selected_metrics(
+    packs: ContextPacks, workspace_id: str, metric_keys: list[str]
+) -> None:
+    """QueryPlan 选定指标 → 回读依赖闭包（完整定义，不受 top-k 截断）。
+
+    Args:
+        packs: 就地回填 ``metrics_selected``。
+        workspace_id: 工作空间。
+        metric_keys: 计划选定的 metric_key 列表。
+
+    Raises:
+        不抛——选定指标回读失败记入 ``metrics_selected`` 条目的 error 字段，
+        由计划层（L2④）决定改选或标未覆盖。
+    """
+    for metric_key in metric_keys:
+        try:
+            context = semantic_link.build_semantic_context(workspace_id, metric_key, None)
+        except Exception as exc:  # noqa: BLE001 —— 回读失败不阻断计划，交上层裁决
+            packs.metrics_selected.append({
+                "metric_key": metric_key, "error": f"semantic_context_failed:{type(exc).__name__}",
+            })
+            continue
+        revision = store.published_revision_of(workspace_id, metric_key)
+        packs.metrics_selected.append({
+            "metric_key": metric_key,
+            "revision_id": revision.revision_id if revision else "",
+            "display_name": context.label or metric_key,
+            "unit": context.unit,
+            "metric_kind": "ratio" if (context.numerator and context.denominator) else "atomic",
+            "operator": context.operator,
+            "formula_summary": context.formula_summary,
+            "definition_ref": context.definition_ref,
+            "time_field": context.time_field,
+            "group_by_fields": list(context.group_by_fields),
+            "dependencies": list(context.dependencies),
+            "numerator": context.numerator,
+            "denominator": context.denominator,
+            "warnings": list(context.warnings),
+        })
+
+
+def scope_of(packs: ContextPacks, source_id: str = "") -> dict[str, Any]:
+    """上下文包 → scope 允许集（表列白名单 + join 白名单 + 版本锚点）。"""
+    tables = packs.scope_tables()
+    joins = [
+        {"left": join.get("left"), "right": join.get("right"),
+         "level": join.get("level"), "status": join.get("status")}
+        for pack in packs.schema_tables for join in pack.joins
+    ]
+    payload = json.dumps({"tables": tables, "joins": joins}, ensure_ascii=False, sort_keys=True)
+    digest = hashlib.sha256(payload.encode("utf-8"), usedforsecurity=False).hexdigest()[:16]
+    return {
+        "tables": tables,
+        "joins": joins,
+        "source_id": source_id,
+        "snapshot_ids": [
+            ref.get("snapshot_id") for ref in packs.semantic_versions.get("snapshots", [])
+        ],
+        "release_id": packs.semantic_versions.get("release_id"),
+        "scope_digest": digest,
+    }
+
+
+# ==========================================================================
+# 内部
+# ==========================================================================
+
+def evidence_tier_of(hit: RecallHit) -> str:
+    """候选指标的**选中证据**等级：``confirmed`` / ``scored``。
+
+    与 G1/G2/G3 是**两个正交维度**，报告里都要有：
+
+    - ``grounding_level``（G1/G2/G3）回答「这个数锚定在哪层口径」——用的是
+      已发布指标？治理快照？还是现场探查的临时对象；
+    - ``evidence_tier`` 回答「这个指标是怎么被选中的」——顺着**人工确认过的
+      术语→指标关系**找到的（confirmed），还是靠词面/语义相似度猜的（scored）。
+
+    一个 G1 的数也可能是 scored（指标确实已发布、口径检查也过，但「该不该用
+    这个指标回答这个问题」只是词面匹配的判断）。方案⑫「图漫游来的数有人工
+    背书、纯词面匹配来的数是猜的——报告里必须可区分」说的就是这一维。
+    """
+    return CONFIRMED_TIER if any(
+        mark.startswith(GRAPH_MEASURES_PREFIX) for mark in hit.matched_on) else SCORED_TIER
+
+
+def _term_hit(term: dict[str, Any]) -> RecallHit:
+    """图补全术语 → RecallHit 形态（无 rrf 分，来源 graph:）。"""
+    return RecallHit(
+        kind="term", entity_id=str(term.get("term_id") or ""),
+        label=str(term.get("name") or ""),
+        matched_on=[GRAPH_MEASURES_PREFIX],
+        payload=term)
+
+
+def _versions_view(
+    workspace_id: str, snapshot_refs: list[Any], expansion: Expansion
+) -> dict[str, Any]:
+    """语义版本锚点（完整召回包与短路包同口径）。"""
+    return {
+        "release_id": _active_release_id(workspace_id),
+        "snapshots": [
+            {"source_id": ref.source_id, "snapshot_id": ref.snapshot_id}
+            for ref in snapshot_refs
+        ],
+        "graph_status": expansion.graph_status,
+    }
+
+
+def _group_by_table(
+    column_hits: list[RecallHit],
+    snapshots: dict[str, Any],
+    expansion: Expansion,
+) -> list[SchemaTablePack]:
+    """列候选 → 按表分组的 schema 子包。
+
+    触及的表（列命中所属表 / expansion.tables 整表带出）统一**装入全表列**
+    与注释（方案：「命中列作选表信号 → 装入表列与注释」——选表后列全量
+    给出，命中与否由 ``matched`` 标记区分）；列结构回源快照。
+    """
+    table_index: dict[str, Any] = {}
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            table_index[table.node_id] = table
+
+    touched: dict[str, Any] = {}
+    for hit in column_hits:
+        table = _table_of_column(table_index, hit.entity_id)
+        if table is not None:
+            touched[table.node_id] = table
+    for table_id in expansion.tables:
+        if table_id in table_index:
+            touched[table_id] = table_index[table_id]
+
+    packs: list[SchemaTablePack] = []
+    for table_id, table in touched.items():
+        pack = SchemaTablePack(
+            table_id=table_id, table=table.name,
+            source_id=str(getattr(table, "source_id", "") or ""),
+            snapshot_id=_snapshot_id_of(snapshots, table_id),
+            comment=table.comment,
+        )
+        for column in table.columns:
+            if column.status != "active":
+                continue
+            pack.columns.append({
+                "node_id": column.node_id,
+                "name": column.name,
+                "type": column.data_type,
+                "comment": column.comment,
+            })
+        packs.append(pack)
+    return packs
+
+
+def _table_of_column(table_index: dict[str, Any], column_id: str):
+    """列 node_id → 所属 TableMeta。"""
+    for table in table_index.values():
+        for column in table.columns:
+            if column.node_id == column_id:
+                return table
+    return None
+
+
+def _snapshot_id_of(snapshots: dict[str, Any], node_id: str) -> str:
+    """对象所属快照 ID（快照集按 source_id 组织，对象全局唯一）。"""
+    for snapshot in snapshots.values():
+        if node_id in snapshot.object_map():
+            return snapshot.snapshot_id
+    return ""
+
+
+def _join_touches_table(join: dict[str, Any], table_id: str) -> bool:
+    """join 边是否与表相关（按列 node_id 前缀比对表 node_id）。"""
+    left_table = _table_of_column_id(str(join.get("left") or ""))
+    right_table = _table_of_column_id(str(join.get("right") or ""))
+    return table_id in (left_table, right_table)
+
+
+def _table_of_column_id(column_id: str) -> str:
+    """col:mysql:{source}:{db}.{tbl}.{col} → tbl:{source}:{db}.{tbl}。"""
+    parts = column_id.split(":")
+    if len(parts) < 4 or not column_id.startswith("col:"):
+        return ""
+    source_type, source_id = parts[1], parts[2]
+    fqn = ":".join(parts[3:])
+    table_fqn = fqn.rsplit(".", 1)[0]
+    return f"tbl:{source_type}:{source_id}:{table_fqn}"
+
+
+def _value_candidates_by_column(values_road: RoadResult) -> dict[str, list[str]]:
+    """维值命中 → {column_id: [取值候选]}（附到 schema 子包对应列）。"""
+    out: dict[str, list[str]] = {}
+    for hit in values_road.hits:
+        column_id = str(hit.payload.get("column_id") or "")
+        if not column_id:
+            continue
+        out.setdefault(column_id, []).append(str(hit.payload.get("value") or ""))
+    return out
+
+
+def _active_release_id(workspace_id: str) -> str | None:
+    """当前 active release ID（无则 None）。"""
+    try:
+        release = store.get_active_release(workspace_id)
+        return release.release_id if release else None
+    except Exception:  # noqa: BLE001 —— 无 release（未发布过指标）不算错误
+        return None
diff --git a/jiuwenswarm/channels/web/dataagent/analysis/execute.py b/jiuwenswarm/channels/web/dataagent/analysis/execute.py
