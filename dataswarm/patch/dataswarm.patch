+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/ossie.py —— Apache Ossie 语义模型导入。
+
+Ossie 是指标定义的导入/交换标准（``plan.md`` 图3/图4/图10）。本模块把官方
+schema 校验通过的语义模型转成 DataSwarm 的 :class:`~.model.MetricRevision` +
+:class:`~.model.Binding` + 候选 :class:`~.model.ConceptMapping`。
+
+三条硬规则（方案 §投影策略）：
+
+1. **不用正则猜结构**——一律按官方 schema 解析出的字段语义映射。
+2. **依赖边只认显式声明**——``custom_extensions.dependencies`` 才产生
+   ``dependsOn``；``ratio`` 且恰好两个依赖时按位置生成 ``numerator``/
+   ``denominator``，但状态是 ``candidate``，必须人工确认后才进正式投影。
+3. **公式 AST 只产出算子与字段引用**，绝不反推「这引用了某个已有指标」。
+
+导入产物是 ``candidate`` 修订：Ossie 格式合法不等于口径正确（``plan.md`` 图4）。
+"""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from functools import lru_cache
+from pathlib import Path
+from typing import Any, Callable
+
+import sqlglot
+import sqlglot.expressions as exp
+import yaml
+
+from .errors import OssieSchemaError
+from .model import (
+    Binding,
+    ConceptMapping,
+    ExpressionSpec,
+    MetricRevision,
+    ParsedExpression,
+    METRIC_TYPE_ATOMIC,
+    METRIC_TYPE_RATIO,
+    REVISION_CANDIDATE,
+    BINDING_UNBOUND,
+    BINDING_VERIFIED,
+    MAP_CANDIDATE,
+)
+from .store import new_id
+
+# 官方 schema 与示例随包分发（deploy 时不依赖 D:\\job\\plan 下的方案目录）
+_RESOURCE_ROOT = Path(__file__).resolve().parents[4] / "resources"
+OSSIE_SCHEMA_PATH = _RESOURCE_ROOT / "ossie" / "ossie-schema.json"
+
+VENDOR_DATASWARM = "DATASWARM"
+EXPECTED_PROFILE_VERSION = "1.0"
+
+# Ossie 的 Dialect 枚举不含 DORIS/MYSQL/SQLITE，必须显式映射到 sqlglot read 方言
+_OSSIE_TO_SQLGLOT: dict[str, str] = {
+    "ANSI_SQL": "mysql",
+    "OSSIE_SQL_2026": "mysql",
+    "BIGQUERY": "bigquery",
+    "SNOWFLAKE": "snowflake",
+    "DATABRICKS": "databricks",
+}
+# 非 SQL 表达式语言：能存原文，但不能 AST 解析
+_UNPARSEABLE_DIALECTS = frozenset({"MDX", "TABLEAU", "MAQL", "SIGMA", "THOUGHTSPOT", "DAX"})
+
+# 目标库类型 → 优先选用的 Ossie 方言顺序
+_TARGET_PREFERENCE: dict[str, tuple[str, ...]] = {
+    "doris": ("ANSI_SQL", "OSSIE_SQL_2026"),
+    "mysql": ("ANSI_SQL", "OSSIE_SQL_2026"),
+    "sqlite": ("ANSI_SQL", "OSSIE_SQL_2026"),
+    "duckdb": ("ANSI_SQL", "OSSIE_SQL_2026"),
+    "bigquery": ("BIGQUERY", "ANSI_SQL", "OSSIE_SQL_2026"),
+    "snowflake": ("SNOWFLAKE", "ANSI_SQL", "OSSIE_SQL_2026"),
+    "databricks": ("DATABRICKS", "ANSI_SQL", "OSSIE_SQL_2026"),
+}
+_DEFAULT_PREFERENCE = ("ANSI_SQL", "OSSIE_SQL_2026")
+
+
+@lru_cache(maxsize=1)
+def load_schema() -> dict:
+    """读取随包分发的 Ossie 官方 JSON Schema。
+
+    Returns:
+        schema dict。
+
+    Raises:
+        OssieSchemaError: schema 文件缺失或不是合法 JSON。
+    """
+    if not OSSIE_SCHEMA_PATH.is_file():
+        raise OssieSchemaError(f"Ossie schema 文件缺失: {OSSIE_SCHEMA_PATH}")
+    try:
+        return json.loads(OSSIE_SCHEMA_PATH.read_text(encoding="utf-8"))
+    except json.JSONDecodeError as exc:
+        raise OssieSchemaError(f"Ossie schema 不是合法 JSON: {exc}") from exc
+
+
+@dataclass(frozen=True)
+class OssieField:
+    """数据集字段。"""
+
+    name: str
+    datatype: str = ""
+    is_time: bool = False
+    label: str = ""
+    description: str = ""
+    synonyms: tuple[str, ...] = ()
+    dialects: dict[str, str] = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class OssieDataset:
+    """逻辑数据集（事实表或维度表）。"""
+
+    name: str
+    source: str
+    primary_key: tuple[str, ...] = ()
+    description: str = ""
+    fields: tuple[OssieField, ...] = ()
+    extension: dict[str, Any] = field(default_factory=dict)
+
+    @property
+    def datasource_alias(self) -> str:
+        """DATASWARM 扩展里声明的数据源别名。"""
+        return str(self.extension.get("datasource_alias") or "")
+
+    @property
+    def subject_iri(self) -> str:
+        """业务本体主体 IRI。"""
+        return str(self.extension.get("subject_iri") or "")
+
+    def field_map(self) -> dict[str, OssieField]:
+        """字段名 → 字段。"""
+        return {f.name: f for f in self.fields}
+
+
+@dataclass(frozen=True)
+class OssieMetric:
+    """指标声明。"""
+
+    name: str
+    datatype: str = ""
+    description: str = ""
+    synonyms: tuple[str, ...] = ()
+    dialects: dict[str, str] = field(default_factory=dict)
+    extension: dict[str, Any] = field(default_factory=dict)
+
+    @property
+    def metric_key(self) -> str:
+        """扩展里显式声明的 metric_key；缺失时返回空串由调用方兜底。"""
+        return str(self.extension.get("metric_key") or "")
+
+    @property
+    def metric_type(self) -> str:
+        """``atomic`` / ``derived`` / ``ratio``，缺省按 atomic。"""
+        return str(self.extension.get("metric_type") or METRIC_TYPE_ATOMIC)
+
+    @property
+    def dependencies(self) -> tuple[str, ...]:
+        """显式声明的依赖 metric_key 列表。"""
+        raw = self.extension.get("dependencies") or []
+        return tuple(str(d) for d in raw) if isinstance(raw, list) else ()
+
+
+@dataclass(frozen=True)
+class OssieModel:
+    """顶层语义模型。"""
+
+    version: str
+    name: str
+    description: str = ""
+    datasets: tuple[OssieDataset, ...] = ()
+    relationships: tuple[dict[str, Any], ...] = ()
+    metrics: tuple[OssieMetric, ...] = ()
+    extension: dict[str, Any] = field(default_factory=dict)
+    raw_text: str = ""
+
+    @property
+    def namespace(self) -> str:
+        """模型级扩展里的命名空间，用于兜底拼 metric_key。"""
+        return str(self.extension.get("namespace") or "")
+
+    def dataset_map(self) -> dict[str, OssieDataset]:
+        """数据集名 → 数据集。"""
+        return {d.name: d for d in self.datasets}
+
+    def metric_key_of(self, metric: OssieMetric) -> str:
+        """指标的 metric_key：优先扩展显式声明，否则 ``<namespace>.<name>``。"""
+        if metric.metric_key:
+            return metric.metric_key
+        prefix = self.namespace
+        return f"{prefix}.{metric.name}" if prefix else metric.name
+
+
+def _extension_of(node: dict[str, Any]) -> dict[str, Any]:
+    """取 ``vendor_name=DATASWARM`` 的扩展并解析其 JSON 字符串。
+
+    Raises:
+        OssieSchemaError: ``data`` 不是字符串、不是合法 JSON、不是对象，
+            或 ``profile_version`` 不等于 :data:`EXPECTED_PROFILE_VERSION`。
+    """
+    for item in node.get("custom_extensions") or []:
+        if not isinstance(item, dict) or item.get("vendor_name") != VENDOR_DATASWARM:
+            continue
+        data = item.get("data")
+        if not isinstance(data, str):
+            raise OssieSchemaError(
+                f"DATASWARM 扩展的 data 必须是 JSON 字符串，实际是 {type(data).__name__}")
+        try:
+            parsed = json.loads(data)
+        except json.JSONDecodeError as exc:
+            raise OssieSchemaError(f"DATASWARM 扩展的 data 不是合法 JSON: {exc}") from exc
+        if not isinstance(parsed, dict):
+            raise OssieSchemaError("DATASWARM 扩展的 data 解析后必须是对象")
+        profile = str(parsed.get("profile_version") or "")
+        if profile != EXPECTED_PROFILE_VERSION:
+            raise OssieSchemaError(
+                f"DATASWARM 扩展 profile_version={profile!r}，"
+                f"期望 {EXPECTED_PROFILE_VERSION!r}")
+        return parsed
+    return {}
+
+
+def _ai_context_synonyms(node: dict[str, Any]) -> tuple[str, ...]:
+    """从 ``ai_context`` 取同义词。``ai_context`` 可以是字符串或对象。"""
+    ctx = node.get("ai_context")
+    if isinstance(ctx, dict):
+        raw = ctx.get("synonyms") or []
+        return tuple(str(s) for s in raw) if isinstance(raw, list) else ()
+    return ()
+
+
+def _dialects_of(node: dict[str, Any]) -> dict[str, str]:
+    """取 ``expression.dialects`` 的方言 → 表达式映射。"""
+    expression = node.get("expression") or {}
+    out: dict[str, str] = {}
+    for item in expression.get("dialects") or []:
+        if isinstance(item, dict) and item.get("dialect") and item.get("expression") is not None:
+            out[str(item["dialect"])] = str(item["expression"])
+    return out
+
+
+def parse_ossie(text: str, *, fmt: str = "yaml") -> OssieModel:
+    """解析并校验 Ossie 语义模型。
+
+    Args:
+        text: YAML 或 JSON 原文。
+        fmt: ``"yaml"`` 或 ``"json"``。
+
+    Returns:
+        解析后的 :class:`OssieModel`。
+
+    Raises:
+        OssieSchemaError: 文本无法解析、不合官方 schema，或 DATASWARM 扩展非法。
+    """
+    if not text or not text.strip():
+        raise OssieSchemaError("Ossie 文本为空")
+    try:
+        data = json.loads(text) if fmt == "json" else yaml.safe_load(text)
+    except (json.JSONDecodeError, yaml.YAMLError) as exc:
+        raise OssieSchemaError(f"Ossie 文本解析失败: {exc}") from exc
+    if not isinstance(data, dict):
+        raise OssieSchemaError("Ossie 顶层必须是对象")
+
+    _validate_against_schema(data)
+
+    datasets: list[OssieDataset] = []
+    for ds in data.get("datasets") or []:
+        fields = tuple(
+            OssieField(
+                name=str(f.get("name") or ""),
+                datatype=str(f.get("datatype") or ""),
+                is_time=bool((f.get("dimension") or {}).get("is_time")),
+                label=str(f.get("label") or ""),
+                description=str(f.get("description") or ""),
+                synonyms=_ai_context_synonyms(f),
+                dialects=_dialects_of(f),
+            )
+            for f in (ds.get("fields") or [])
+            if isinstance(f, dict)
+        )
+        datasets.append(OssieDataset(
+            name=str(ds.get("name") or ""),
+            source=str(ds.get("source") or ""),
+            primary_key=tuple(str(k) for k in (ds.get("primary_key") or [])),
+            description=str(ds.get("description") or ""),
+            fields=fields,
+            extension=_extension_of(ds),
+        ))
+
+    metrics = [
+        OssieMetric(
+            name=str(m.get("name") or ""),
+            datatype=str(m.get("datatype") or ""),
+            description=str(m.get("description") or ""),
+            synonyms=_ai_context_synonyms(m),
+            dialects=_dialects_of(m),
+            extension=_extension_of(m),
+        )
+        for m in (data.get("metrics") or [])
+        if isinstance(m, dict)
+    ]
+
+    return OssieModel(
+        version=str(data.get("version") or ""),
+        name=str(data.get("name") or ""),
+        description=str(data.get("description") or ""),
+        datasets=tuple(datasets),
+        relationships=tuple(r for r in (data.get("relationships") or []) if isinstance(r, dict)),
+        metrics=tuple(metrics),
+        extension=_extension_of(data),
+        raw_text=text,
+    )
+
+
+def _validate_against_schema(data: dict) -> None:
+    """用官方 JSON Schema 校验；jsonschema 未安装时跳过并交由字段级校验兜底。"""
+    try:
+        import jsonschema
+    except ImportError:
+        return
+    schema = load_schema()
+    validator = jsonschema.Draft202012Validator(schema)
+    errors = sorted(validator.iter_errors(data), key=lambda e: list(e.absolute_path))
+    if errors:
+        details = "; ".join(
+            f"{'/'.join(str(p) for p in e.absolute_path) or '<root>'}: {e.message}"
+            for e in errors[:5]
+        )
+        raise OssieSchemaError(f"Ossie 模型不符合官方 schema（{len(errors)} 处）: {details}")
+
+
+# ==========================================================================
+# 方言解析与 AST
+# ==========================================================================
+def resolve_dialect(dialects: dict[str, str], target_db_type: str = "") -> tuple[str, str]:
+    """按目标库选出可用的 Ossie 方言。
+
+    顺序：目标库精确偏好 → ``ANSI_SQL`` → ``OSSIE_SQL_2026``。都不支持时
+    返回第一个有原文的方言并交由调用方标记未解析——**保留原文，不猜**。
+
+    Args:
+        dialects: 方言名 → 表达式原文。
+        target_db_type: 目标库类型（``parse_db_ref`` 的 ``type`` 口径）。
+
+    Returns:
+        ``(选用的 Ossie 方言名, 表达式原文)``；无可用方言时为 ``("", "")``。
+    """
+    if not dialects:
+        return "", ""
+    preference = _TARGET_PREFERENCE.get(target_db_type, _DEFAULT_PREFERENCE)
+    for name in preference:
+        if dialects.get(name):
+            return name, dialects[name]
+    for name in ("ANSI_SQL", "OSSIE_SQL_2026"):
+        if dialects.get(name):
+            return name, dialects[name]
+    # 只剩非 SQL 方言（MDX/DAX/...）：保留原文，标未解析
+    for name, text in dialects.items():
+        if text:
+            return name, text
+    return "", ""
+
+
+def parse_expression(expression: str, ossie_dialect: str) -> tuple[ParsedExpression | None, str | None]:
+    """AST 解析指标表达式，只产出算子与字段引用。
+
+    Args:
+        expression: 表达式原文。
+        ossie_dialect: Ossie 方言名，用于选 sqlglot read 方言。
+
+    Returns:
+        ``(ParsedExpression | None, unparsed_reason | None)``。解析失败不抛异常，
+        返回 ``(None, 原因)``——调用方保留原文并标记未解析。
+    """
+    if not expression or not expression.strip():
+        return None, "expression 为空"
+    read_dialect = _OSSIE_TO_SQLGLOT.get(ossie_dialect)
+    if read_dialect is None:
+        if ossie_dialect in _UNPARSEABLE_DIALECTS:
+            return None, f"方言 {ossie_dialect} 不是 SQL 表达式语言，保留原文不解析"
+        return None, f"方言 {ossie_dialect} 无对应的 sqlglot 解析器，保留原文不解析"
+    try:
+        parsed = sqlglot.parse_one(expression, read=read_dialect)
+    except sqlglot.errors.ParseError as exc:
+        return None, f"sqlglot 解析失败（{read_dialect}）: {exc}"
+    if parsed is None:
+        return None, "sqlglot 返回空解析树"
+    fields = tuple(_column_refs(parsed))
+    return ParsedExpression(operator=_detect_operator(parsed), fields=fields), None
+
+
+def _column_refs(parsed: sqlglot.Expr) -> list[str]:
+    """提取表达式引用的列，形如 ``orders.amount_cny``（无表前缀时只留列名）。"""
+    out: list[str] = []
+    seen: set[str] = set()
+    for column in parsed.find_all(exp.Column):
+        name = column.name
+        if not name:
+            continue
+        table = column.table
+        ref = f"{table}.{name}" if table else name
+        if ref not in seen:
+            seen.add(ref)
+            out.append(ref)
+    return out
+
+
+def _detect_operator(parsed: sqlglot.Expr) -> str:
+    """判定聚合算子。
+
+    比率型（顶层是除法）→ ``divide``；否则取第一个聚合函数。
+    只判定算子，**不推断指标间依赖**。
+    """
+    if isinstance(parsed, (exp.Div, exp.DPipe)) or parsed.find(exp.Div) is not None:
+        return "divide"
+    if parsed.find(exp.Avg) is not None:
+        return "avg"
+    count = parsed.find(exp.Count)
+    if count is not None:
+        # sqlglot 把 COUNT(DISTINCT x) 表示为 Count(this=Distinct(...))，
+        # 没有 distinct 参数位——必须查子节点，否则恒判成 count。
+        is_distinct = isinstance(count.this, exp.Distinct) or count.find(exp.Distinct) is not None
+        return "count_distinct" if is_distinct else "count"
+    if parsed.find(exp.Sum) is not None:
+        return "sum"
+    if parsed.find(exp.Min) is not None:
+        return "min"
+    if parsed.find(exp.Max) is not None:
+        return "max"
+    return ""
+
+
+# ==========================================================================
+# 转换：Ossie → DataSwarm 领域对象
+# ==========================================================================
+def to_revisions(
+    model: OssieModel,
+    workspace_id: str,
+    *,
+    target_db_type: str = "",
+    metric_id_resolver: Callable[[str], str] | None = None,
+) -> list[MetricRevision]:
+    """把 Ossie 指标转成 ``candidate`` 修订。
+
+    Args:
+        model: 已校验的语义模型。
+        workspace_id: 归属工作空间。
+        target_db_type: 目标业务库类型，决定方言偏好。
+        metric_id_resolver: ``metric_key -> metric_id``。为 None 时用 metric_key
+            本身占位，由调用方在建完 ``dw_metric_defs`` 后回填。
+
+    Returns:
+        修订列表，顺序与 ``model.metrics`` 一致。
+
+    Raises:
+        OssieSchemaError: 指标缺少表达式且无依赖声明。
+    """
+    resolve = metric_id_resolver or (lambda key: key)
+    out: list[MetricRevision] = []
+    for metric in model.metrics:
+        key = model.metric_key_of(metric)
+        ext = metric.extension
+        resolved_dialect, expression = resolve_dialect(metric.dialects, target_db_type)
+        if not expression and metric.metric_type == METRIC_TYPE_ATOMIC:
+            raise OssieSchemaError(f"指标 {key} 缺少可用的表达式原文")
+        parsed, unparsed = parse_expression(expression, resolved_dialect) if expression else (None, "无表达式")
+        allowed = ext.get("allowed_dimensions") or []
+        grains = ext.get("time_grains") or []
+        additivity = ext.get("additivity") or {}
+        rev = MetricRevision(
+            revision_id=new_id("rev"),
+            metric_id=resolve(key),
+            workspace_id=workspace_id,
+            revision_no=1,
+            metric_type=metric.metric_type,
+            datatype=metric.datatype,
+            unit=str(ext.get("unit") or ""),
+            display_name=str(ext.get("display_name") or metric.name),
+            synonyms=tuple(metric.synonyms),
+            expression=ExpressionSpec(
+                resolved_dialect=resolved_dialect,
+                dialects=dict(metric.dialects),
+                parsed=parsed,
+                unparsed_reason=unparsed,
+            ),
+            time_dimension=str(ext.get("default_time_dimension") or ""),
+            allowed_dimensions=tuple(str(d) for d in allowed) if isinstance(allowed, list) else (),
+            time_grains=tuple(str(g) for g in grains) if isinstance(grains, list) else (),
+            timezone=str(ext.get("timezone") or ""),
+            calendar=str(ext.get("calendar") or ""),
+            dependencies=metric.dependencies,
+            zero_denominator=str(ext.get("zero_denominator") or ""),
+            additivity={str(k): str(v) for k, v in additivity.items()} if isinstance(additivity, dict) else {},
+            subject_iri=str(ext.get("subject_iri") or ""),
+            status=REVISION_CANDIDATE,
+            source_type="ossie",
+            ossie_raw=model.raw_text,
+            definition_ref=f"dataswarm:metric:{workspace_id}:{key}@r1",
+        )
+        out.append(_with_hash(rev))
+    return out
+
+
+def _with_hash(rev: MetricRevision) -> MetricRevision:
+    """补算 ``definition_hash``（dataclass frozen，需 replace）。"""
+    from dataclasses import replace
+
+    return replace(rev, definition_hash=rev.compute_definition_hash())
+
+
+def resolve_bindings(
+    model: OssieModel,
+    workspace_id: str,
+    revisions_by_key: dict[str, MetricRevision],
+    *,
+    datasource_resolver: Callable[[str], str | None] | None = None,
+) -> list[Binding]:
+    """把 Ossie 数据集转成修订的物理绑定。
+
+    ``dataset.source``（``database.schema.table``）→ ``source_table``；
+    ``datasource_alias`` 经解析器换成 ``datasource_ref``。解析不到就落
+    ``verify_status=unbound``，**不静默兜底到 config default_db**。
+
+    Args:
+        model: 已校验的语义模型。
+        workspace_id: 归属工作空间。
+        revisions_by_key: ``metric_key -> 修订``。
+        datasource_resolver: ``alias -> db_ref``，返回 None 表示解析不到。
+
+    Returns:
+        绑定列表（每个修订一条）。
+    """
+    resolver = datasource_resolver if datasource_resolver is not None else default_datasource_resolver(workspace_id)
+    # 指标 → 它引用的数据集：从表达式的列前缀推断数据集归属
+    bindings: list[Binding] = []
+    for metric in model.metrics:
+        key = model.metric_key_of(metric)
+        rev = revisions_by_key.get(key)
+        if rev is None:
+            continue
+        dataset = _dataset_for_metric(model, rev)
+        if dataset is None:
+            bindings.append(Binding(
+                binding_id=new_id("bnd"),
+                revision_id=rev.revision_id,
+                workspace_id=workspace_id,
+                verify_status=BINDING_UNBOUND,
+                verify_detail="未能从表达式列前缀定位到 Ossie 数据集",
+            ))
+            continue
+        alias = dataset.datasource_alias
+        db_ref = resolver(alias) if alias else None
+        column_map = {f.name: f.name for f in dataset.fields}
+        bindings.append(Binding(
+            binding_id=new_id("bnd"),
+            revision_id=rev.revision_id,
+            workspace_id=workspace_id,
+            datasource_alias=alias,
+            datasource_ref=db_ref or "",
+            source_table=_physical_table(dataset.source),
+            column_map=column_map,
+            verify_status=BINDING_VERIFIED if db_ref else BINDING_UNBOUND,
+            verify_detail="" if db_ref else f"数据源别名 {alias!r} 未解析到已注册的 datasource",
+        ))
+    return bindings
+
+
+def _physical_table(source: str) -> str:
+    """``database.schema.table`` → 建表时用的表名。
+
+    SQLite/Doris 都不支持三段式限定，取最后一段；调用方按 datasource 选库。
+    """
+    parts = [p for p in (source or "").split(".") if p]
+    return parts[-1] if parts else ""
+
+
+def _dataset_for_metric(model: OssieModel, rev: MetricRevision) -> OssieDataset | None:
+    """按表达式里的列前缀定位数据集；定位不到时退化为唯一数据集。"""
+    refs = rev.expression.parsed.fields if rev.expression.parsed else ()
+    prefixes = {r.split(".", 1)[0] for r in refs if "." in r}
+    datasets = model.dataset_map()
+    for prefix in prefixes:
+        if prefix in datasets:
+            return datasets[prefix]
+    if len(model.datasets) == 1:
+        return model.datasets[0]
+    return None
+
+
+def candidate_mappings(
+    model: OssieModel,
+    workspace_id: str,
+    revisions_by_key: dict[str, MetricRevision],
+) -> list[ConceptMapping]:
+    """生成**候选**业务映射（``status=candidate``，不进正式投影）。
+
+    - ``dependencies`` → ``dependsOn``，evidence 记明来自 Ossie 显式声明
+    - ``metric_type=ratio`` 且恰好两个依赖 → 按位置生成 ``numerator``/
+      ``denominator``，evidence 标注是位置推断，**必须人工确认**
+    - ``subject_iri`` → ``measuresConcept``
+
+    绝不从公式形状反推指标引用（方案 §投影策略）。
+    """
+    out: list[ConceptMapping] = []
+    for metric in model.metrics:
+        key = model.metric_key_of(metric)
+        rev = revisions_by_key.get(key)
+        if rev is None:
+            continue
+        concept = metric.extension.get("subject_iri") or _dataset_subject(model, rev)
+        out.extend(candidate_mappings_for(
+            workspace_id, rev,
+            dependencies=metric.dependencies,
+            metric_type=metric.metric_type,
+            subject_iri=str(concept or ""),
+            source="ossie",
+        ))
+    return out
+
+
+def candidate_mappings_for(
+    workspace_id: str,
+    revision: MetricRevision,
+    *,
+    dependencies: tuple[str, ...] | list[str],
+    metric_type: str,
+    subject_iri: str = "",
+    source: str = "manual",
+) -> list[ConceptMapping]:
+    """为一组依赖生成候选映射（Ossie 导入与手动建修订共用一份实现）。
+
+    Args:
+        workspace_id: 工作空间。
+        revision: 映射挂载的修订。
+        dependencies: 依赖指标 key 列表；ratio 按位置映射分子/分母。
+        metric_type: 指标类型（``ratio`` 才生成 numerator/denominator）。
+        subject_iri: 业务概念引用（非空时生成 ``measuresConcept`` 候选）。
+        source: evidence 前缀，标识映射来源（``ossie`` / ``manual``）。
+
+    Returns:
+        尚未落库的 :class:`~.model.ConceptMapping` 列表。
+    """
+    out: list[ConceptMapping] = []
+    for index, dep in enumerate(dependencies):
+        out.append(ConceptMapping(
+            mapping_id=new_id("map"),
+            workspace_id=workspace_id,
+            revision_id=revision.revision_id,
+            relation_type="dependsOn",
+            target_ref=dep,
+            status=MAP_CANDIDATE,
+            evidence=f"{source}:dependencies[{index}] 显式声明",
+        ))
+    if metric_type == METRIC_TYPE_RATIO and len(dependencies) == 2:
+        for relation, index in (("numerator", 0), ("denominator", 1)):
+            out.append(ConceptMapping(
+                mapping_id=new_id("map"),
+                workspace_id=workspace_id,
+                revision_id=revision.revision_id,
+                relation_type=relation,
+                target_ref=dependencies[index],
+                status=MAP_CANDIDATE,
+                evidence=(
+                    f"{source}:metric_type=ratio + dependencies[{index}] 位置推断，"
+                    "需人工确认后才进正式投影"
+                ),
+            ))
+    if subject_iri:
+        out.append(ConceptMapping(
+            mapping_id=new_id("map"),
+            workspace_id=workspace_id,
+            revision_id=revision.revision_id,
+            relation_type="measuresConcept",
+            target_ref=subject_iri,
+            status=MAP_CANDIDATE,
+            evidence=f"{source}:subject_iri 显式声明",
+        ))
+    return out
+
+
+def _dataset_subject(model: OssieModel, rev: MetricRevision) -> str:
+    """从修订绑定的数据集取 ``subject_iri``。"""
+    if rev.subject_iri:
+        return rev.subject_iri
+    dataset = _dataset_for_metric(model, rev)
+    return dataset.subject_iri if dataset else ""
+
+
+def default_datasource_resolver(workspace_id: str) -> Callable[[str], str | None]:
+    """默认解析器：按 name 或 source_id 在 ``dw_datasources`` 里查 ``db_ref``。
+
+    注册表不中时**回退 workspace 业务库**：数据集所在库常常就是该空间的
+    ``default_db``（如 CSV 直绑的工作空间——datasource create 会因
+    ``SOURCE_ALREADY_BOUND`` 拒绝重复注册），此时别名即业务库本身。
+    授权不受此影响——guard 仍按 workspace 双库判定，业务库 ref 天然通过。
+    """
+    cache: dict[str, str | None] = {}
+    table: dict[str, str] | None = None
+
+    def resolve(alias: str) -> str | None:
+        nonlocal table
+        if alias in cache:
+            return cache[alias]
+        if table is None:
+            table = _load_datasource_aliases(workspace_id)
+        ref = table.get(alias)
+        if ref is None:
+            ref = _workspace_business_ref(workspace_id)
+        cache[alias] = ref
+        return ref
+
+    return resolve
+
+
+def _workspace_business_ref(workspace_id: str) -> str | None:
+    """workspace 业务库 ref；取不到返回 None（不静默兜底元库）。"""
+    try:
+        from jiuwenswarm.common import workspace_context
+
+        context = workspace_context.resolve(workspace_id)
+        return context.business_db_ref or None
+    except Exception:  # noqa: BLE001 —— 解析失败按未命中处理，绑定落 unbound
+        return None
+
+
+def _load_datasource_aliases(workspace_id: str) -> dict[str, str]:
+    """读工作空间已注册数据源，建 ``{name/source_id: db_ref}`` 映射。"""
+    try:
+        from jiuwenswarm.channels.web.dataagent.datasource import store as ds_store
+
+        out: dict[str, str] = {}
+        for source in ds_store.list_sources(workspace_id):
+            ref = str(source.get("db_ref") or "")
+            if not ref:
+                continue
+            for key in (source.get("name"), source.get("source_id")):
+                if key:
+                    out[str(key)] = ref
+        return out
+    except Exception:  # noqa: BLE001 —— 数据源模块不可用时按解析不到处理，不阻断导入
+        return {}
