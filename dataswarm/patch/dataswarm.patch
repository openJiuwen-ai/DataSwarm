+def test_concurrent_sync_serializes_writers_but_recall_uses_old_index(vector_env, monkeypatch):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Event, Lock
+
+    stores = {"ws": FakeStore(), "other-ws": FakeStore()}
+    monkeypatch.setattr(vector_store, "_faiss_store", lambda ws, dims=None: stores[ws])
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    monkeypatch.setattr(stores["ws"], "search_similar", lambda query, k: [
+        {"id": doc_id, "distance": .9, "metadata": dict(meta)}
+        for doc_id, meta in stores["ws"].index.metadata.items()
+    ][:k])
+    entered, release, second_started, recall_started = Event(), Event(), Event(), Event()
+    embed_lock = Lock()
+    embed_calls = 0
+
+    def blocking_embed(texts, *, timeout_s=20):
+        nonlocal embed_calls
+        with embed_lock:
+            embed_calls += 1
+            first = embed_calls == 1
+        if first:
+            entered.set()
+            assert release.wait(5), "test did not release the first sync"
+        return vector_env.embed(texts, timeout_s=timeout_s)
+
+    monkeypatch.setattr(embedding, "embed_texts", blocking_embed)
+    monkeypatch.setattr(embedding, "query_vectors",
+                        _fake_query_vectors([(1, 0, 0, 0)], ("问题",)))
+    other = _snapshot()
+    other.source.source_id = "second"
+    for table in other.tables:
+        table.source_id = "second"
+        for column in table.columns:
+            column.source_id = "second"
+
+    def sync_second():
+        second_started.set()
+        return vector_store.sync_workspace_vectors("ws", "second", other)
+
+    def read_first():
+        recall_started.set()
+        return vector_store.recall("ws", "orders", "问题")
+
+    with ThreadPoolExecutor(max_workers=4) as executor:
+        first = executor.submit(
+            vector_store.sync_workspace_vectors, "ws", "orders",
+            _snapshot(phone_comment="updated phone", include_amount=False))
+        try:
+            assert entered.wait(2)
+            second = executor.submit(sync_second)
+            reader = executor.submit(read_first)
+            assert second_started.wait(2) and recall_started.wait(2)
+            independent = executor.submit(vector_store.sync_workspace_vectors, "other-ws", "orders", _snapshot())
+            assert independent.result(timeout=2)["status"] == "ok"
+            assert not second.done()
+            recalled = reader.result(timeout=2)
+            assert recalled["warnings"] == []
+            assert "amount" in {column["column_name"] for column in recalled["tables"][0]["columns"]}
+            assert len(stores["ws"].index.metadata) == 9  # embedding has not committed yet
+        finally:
+            release.set()
+        assert first.result(timeout=2)["status"] == second.result(timeout=2)["status"] == "ok"
+        assert reader.result(timeout=2)["warnings"] == []
+    assert len(stores["ws"].index.metadata) == 17
+    assert len(stores["other-ws"].index.metadata) == 9
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot(empty=True))
+    assert {meta["source_id"] for meta in stores["ws"].index.metadata.values()} == {"second"}
+    assert len(stores["other-ws"].index.metadata) == 9
+
