@@ -0,0 +1,1197 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""数据源类型、表单字段、可用状态和执行引擎的注册表。
+
+SourceTypeAdapter 声明字段、校验规则、db-ref 构造和连通性测试，前端按字段
+声明渲染表单。category 用于分组；available 由发布状态及运行时依赖共同决定。
+"""
+from __future__ import annotations
+
+import ipaddress
+import re
+import socket
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class SourceField:
+    """表单字段声明：前端按此 schema 动态渲染，不写死任何类型。"""
+
+    key: str
+    label: str
+    required: bool = False
+    secret: bool = False
+    placeholder: str = ""
+    input_type: str = "text"  # text | number | password
+
+
+class SourceTypeAdapter(ABC):
+    """数据源类型的配置与能力声明。
+
+    released 显式控制产品开放状态；requires 声明需要探测的 Python 模块。
+    available 只有在类型已开放且依赖齐备时为真。安装驱动不会自动放开类型，
+    unavailable_reason 区分未发布和缺少驱动，供前端提供对应提示。
+    """
+
+    type_id: str = ""
+    label: str = ""
+    category: str = "other"
+    #: 产品是否开放该类型；具体已验证范围见验收文档。
+    released: bool = True
+    #: 运行所需的 Python 模块名；缺任一即不可用。
+    requires: tuple[str, ...] = ()
+    engine: str = "sqlalchemy"
+    capabilities: set[str] = set()
+    fields: list[SourceField] = []
+
+    @property
+    def missing_requirements(self) -> tuple[str, ...]:
+        """声明依赖里当前不可导入的模块（只探测，不真正 import）。"""
+        from importlib.util import find_spec
+
+        missing: list[str] = []
+        for module in self.requires:
+            try:
+                if find_spec(module) is None:
+                    missing.append(module)
+            except (ImportError, ValueError):
+                # 父包本身缺失时 find_spec 会抛，同样算缺依赖
+                missing.append(module)
+        return tuple(missing)
+
+    @property
+    def available(self) -> bool:
+        return bool(self.released) and not self.missing_requirements
+
+    @property
+    def unavailable_reason(self) -> str:
+        """返回不可用原因；可用时返回空串。
+
+        not_released 表示类型未开放，driver_missing:<mod> 表示缺少运行时依赖。
+        """
+        if not self.released:
+            return "not_released"
+        missing = self.missing_requirements
+        if missing:
+            return "driver_missing:" + ",".join(missing)
+        return ""
+
+    @abstractmethod
+    def validate(self, params: dict) -> None:
+        """校验连接参数，不合法抛 ValueError（message 直接给前端）。"""
+
+    @abstractmethod
+    def build_ref(self, config: dict) -> str:
+        """连接参数 → db-ref（下游治理/编排用这个 ref 走 db_connector）。"""
+
+    @abstractmethod
+    def test_connection(self, config: dict) -> dict:
+        """连通性测试（保存前/列表页均可调），返回 {ok, message?/error?}。"""
+
+    def secret_keys(self) -> set[str]:
+        return {f.key for f in self.fields if f.secret}
+
+    def public_config(self, config: dict) -> dict:
+        """脱敏：secret 字段替换为空串（列表/编辑回显不泄露凭据）。"""
+        return {k: ("" if k in self.secret_keys() else v) for k, v in config.items()}
+
+
+_SOURCE_TYPE_REGISTRY: dict[str, type[SourceTypeAdapter]] = {}
+
+
+def register_source_type(cls: type[SourceTypeAdapter]) -> type[SourceTypeAdapter]:  # pylint: disable=decorator-add-wraps
+    """装饰器：注册数据源类型。type_id 冲突时后注册的报错（防静默覆盖）。
+
+    类装饰器原样返回 cls，无内层函数可包装，functools.wraps 不适用（H4004 属误报）。
+    """
+    type_id = getattr(cls, "type_id", "")
+    if not type_id:
+        raise ValueError(f"{cls.__name__}.type_id 不能为空")
+    if type_id in _SOURCE_TYPE_REGISTRY:
+        raise ValueError(f"source type already registered: {type_id}")
+    _SOURCE_TYPE_REGISTRY[type_id] = cls
+    return cls
+
+
+def get_source_type(type_id: str) -> SourceTypeAdapter:
+    cls = _SOURCE_TYPE_REGISTRY.get(type_id)
+    if cls is None:
+        raise ValueError(
+            f"unknown source type: {type_id!r} (supported: {sorted(_SOURCE_TYPE_REGISTRY)})"
+        )
+    return cls()
+
+
+def list_source_types() -> list[dict]:
+    """类型目录：前端据此渲染类型选择弹窗（分类 + 可用状态）与动态表单。
+
+    ``available`` / ``unavailable_reason`` 是实例属性（需要运行时探测驱动），
+    故此处实例化 adapter 读取——adapter 的 ``__init__`` 无副作用，代价可忽略。
+    """
+    return [
+        {
+            "type_id": cls.type_id,
+            "label": cls.label,
+            "category": cls.category,
+            "available": (adapter := cls()).available,
+            "unavailable_reason": adapter.unavailable_reason,
+            "engine": cls.engine,
+            "capabilities": sorted(cls.capabilities),
+            "fields": [
+                {
+                    "key": f.key,
+                    "label": f.label,
+                    "required": f.required,
+                    "secret": f.secret,
+                    "placeholder": f.placeholder,
+                    "input_type": f.input_type,
+                }
+                for f in cls.fields
+            ],
+        }
+        for cls in _SOURCE_TYPE_REGISTRY.values()
+    ]
+
