+def test_file_source_ref_roundtrip(source_type, location):
+    ref = db_connector.build_file_source_ref(source_type, location)
+    assert ref.startswith("duckdb://")
+    spec = db_connector.parse_db_ref(ref)
+    assert spec["type"] == "duckdb"
+    assert spec["source_type"] == source_type
+    # Windows 绝对路径在 resolve 后盘符大小写可能变化，仅比较结尾
+    if "://" in location:
+        assert spec["location"] == location
+    else:
+        assert Path(spec["location"]) == Path(location).expanduser().resolve()
+    assert spec["table_name"]
+    assert spec["database"] == Path(location).name
