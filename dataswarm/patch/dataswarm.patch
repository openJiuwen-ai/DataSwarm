@@ -0,0 +1,128 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { Finding, MetricArtifact } from '../types/inspection';
+
+type MetricValue = MetricArtifact['metric_values'][number];
+
+export interface MetricCaliberChartItem {
+  metricIndex: number;
+  slotIndex: number;
+  slotCount: number;
+  metric: string;
+  businessMeaning: string;
+  caliber: string;
+  legendName: string;
+  rawValue: number | null;
+  normalizedValue: number | null;
+  note: string;
+  sourceTable: string;
+  isGhost: boolean;
+}
+
+export interface MetricCaliberGroup {
+  metric: string;
+  businessMeaning: string;
+  slotCount: number;
+  items: MetricCaliberChartItem[];
+}
+
+export interface MetricCaliberChartModel {
+  groups: MetricCaliberGroup[];
+  items: MetricCaliberChartItem[];
+  legendCalibers: string[];
+  totalCaliberCount: number;
+  availableValueCount: number;
+  missingValueCount: number;
+  allValuesMissing: boolean;
+}
+
+function tupleKey(metric: string, caliber: string): string {
+  return JSON.stringify([metric, caliber]);
+}
+
+function stringField(value: unknown): string | null {
+  return typeof value === 'string' ? value : null;
+}
+
+/**
+ * 口径图例只展示公式括号前的业务名称；完整口径始终保留在 tooltip 中。
+ */
+export function metricCaliberLegendName(caliber: string): string {
+  const formulaStart = caliber.indexOf('(');
+  if (formulaStart <= 0) return caliber;
+  const name = caliber.slice(0, formulaStart).trim();
+  return name || caliber;
+}
+
+/**
+ * 指标口径图的纯数据模型。
+ *
+ * - 分组与槽位严格沿用 metric_values / caliber_values 的接口顺序；
+ * - 每个指标独立按自身最大有效值归一化；
+ * - null 与非有限值始终保留为 null，不转换成 0；
+ * - 幽灵状态只接受 category=metric_ghost 且 metric、caliber 精确相等。
+ */
+export function buildMetricCaliberChartModel(metricValues: MetricValue[], findings: Finding[]): MetricCaliberChartModel {
+  const ghostIdentities = new Set<string>();
+  for (const finding of findings) {
+    if (finding.category !== 'metric_ghost') continue;
+    const metric = stringField(finding.object?.metric);
+    const caliber = stringField(finding.object?.caliber);
+    if (metric !== null && caliber !== null) ghostIdentities.add(tupleKey(metric, caliber));
+  }
+
+  const legendCalibers: string[] = [];
+  const seenCalibers = new Set<string>();
+  const groups = metricValues.map<MetricCaliberGroup>((metricValue, metricIndex) => {
+    const validValues = metricValue.caliber_values
+      .map(({ value }) => value)
+      .filter((value): value is number => typeof value === 'number' && Number.isFinite(value));
+    const maxValue = validValues.length > 0 ? Math.max(...validValues) : null;
+    const slotCount = metricValue.caliber_values.length;
+
+    const items = metricValue.caliber_values.map<MetricCaliberChartItem>((caliberValue, slotIndex) => {
+      if (!seenCalibers.has(caliberValue.caliber)) {
+        seenCalibers.add(caliberValue.caliber);
+        legendCalibers.push(caliberValue.caliber);
+      }
+
+      const rawValue = typeof caliberValue.value === 'number' && Number.isFinite(caliberValue.value) ? caliberValue.value : null;
+      const normalizedValue = rawValue === null || maxValue === null ? null : maxValue === 0 ? 0 : (rawValue / maxValue) * 100;
+
+      return {
+        metricIndex,
+        slotIndex,
+        slotCount,
+        metric: metricValue.metric,
+        businessMeaning: metricValue.business_meaning,
+        caliber: caliberValue.caliber,
+        legendName: metricCaliberLegendName(caliberValue.caliber),
+        rawValue,
+        normalizedValue,
+        note: caliberValue.note,
+        sourceTable: caliberValue.source_table,
+        isGhost: ghostIdentities.has(tupleKey(metricValue.metric, caliberValue.caliber)),
+      };
+    });
+
+    return {
+      metric: metricValue.metric,
+      businessMeaning: metricValue.business_meaning,
+      slotCount,
+      items,
+    };
+  });
+
+  const items = groups.flatMap(group => group.items);
+  const availableValueCount = items.filter(item => item.rawValue !== null).length;
+  const totalCaliberCount = items.length;
+
+  return {
+    groups,
+    items,
+    legendCalibers,
+    totalCaliberCount,
+    availableValueCount,
+    missingValueCount: totalCaliberCount - availableValueCount,
+    allValuesMissing: totalCaliberCount > 0 && availableValueCount === 0,
+  };
+}
