+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/service.py — 编排业务层（方案 §五）。
+
+是编排域的唯一业务实现——新旧 API（/api/dataagent/orchestration/* 与旧
+/api/orchestration/*）共用本 service，避免两套写路径分叉。
+
+薄封装：调 orchestration/db.py（orch_db）+ workflow_engine.py，不复制业务逻辑。
+不复制 DAO（编排表 dw_* 已有真相源）。
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+
+from jiuwenswarm.channels.web.orchestration import db as orch_db
+from jiuwenswarm.channels.web.orchestration import workflow_engine
+from jiuwenswarm.channels.web.orchestration.lineage import parser as lineage_parser
+from jiuwenswarm.common import workspace_context
+
+# 终态：不可被 cancel/approve/resume 改变
+_TERMINAL_STATUSES = ("success", "failed", "cancelled")
+
+
+@contextmanager
+def _workspace_scope(workspace_id: str | None):
+    context = workspace_context.resolve(workspace_id)
+    token = workspace_context.set_current(context.workspace_id)
+    try:
+        yield context
+    finally:
+        workspace_context.reset(token)
+
+
+# ==========================================================================
+# tasks
+# ==========================================================================
+def create_task(data: dict) -> dict:
+    with _workspace_scope(data.get("workspace_id")) as context:
+        datasource_ref = data.get("datasource_ref")
+        if datasource_ref:
+            workspace_context.validate_ref_in_workspace(
+                context.workspace_id, "business", datasource_ref
+            )
+        else:
+            # 未绑定业务库的工作空间大声拒绝（WORKSPACE_BUSINESS_NOT_BOUND），
+            # 防空 ref 静默落入任务记录
+            data = {**data, "datasource_ref": workspace_context.business_db_ref(context.workspace_id)}
+        return orch_db.create_task(data)
+
+
+def get_task(task_id: str) -> dict | None:
+    return orch_db.get_task(task_id)
+
+
+def list_tasks(status: str | None = None, q: str | None = None,
+               limit: int = 100, offset: int = 0) -> list[dict]:
+    tasks = orch_db.list_tasks(status, q=q, limit=limit, offset=offset)
+    # 任务管理页「实例数」列：对当前页 task_id 一次 GROUP BY 聚合后按行合并
+    counts = orch_db.count_instances_by_ref("task", [t["task_id"] for t in tasks])
+    for t in tasks:
+        t["instance_count"] = counts.get(t["task_id"], 0)
+    return tasks
+
+
+def count_tasks(status: str | None = None, q: str | None = None) -> int:
+    return orch_db.count_tasks(status, q=q)
+
+
+def update_task(task_id: str, data: dict) -> dict | None:
+    with _workspace_scope(data.get("workspace_id")) as context:
+        datasource_ref = data.get("datasource_ref")
+        if datasource_ref:
+            workspace_context.validate_ref_in_workspace(
+                context.workspace_id, "business", datasource_ref
+            )
+        return orch_db.update_task(task_id, data)
+
+
+def delete_task(task_id: str) -> bool:
+    return orch_db.delete_task(task_id)
+
+
+def set_task_status(task_id: str, status: str) -> dict | None:
+    """task 级 publish/unpublish（§5.1：task 不提供 enable/disable）。
+
+    publish 时构建时落库血缘（plan §3.3-B，与旧 orchestration/api.py 同语义）：
+    仅 SQL 任务且有 SQL 时写，失败不阻断 publish。
+    """
+    t = orch_db.set_task_status(task_id, status)
+    if t and status == "published":
+        _write_task_lineage_on_publish(t)
+    return t
+
+
+def _db_name_from_ref(datasource_ref: str | None) -> str:
+    """从 datasource_ref 解析库名（lineage parser 的 default_db）。
+
+    doris://meta → ""（meta 是元数据别名）；doris://biz/olist → "olist"；
+    sqlite://path → ""（单库无库名）。
+    """
+    from jiuwenswarm.common import db_connector
+
+    return db_connector.lineage_db_name(datasource_ref)
+
+
+def _write_task_lineage_on_publish(task: dict) -> None:
+    """publish 时构建时落库血缘（plan §3.3-B，从旧 orchestration/api.py 上收）。
+
+    仅 SQL 任务且有写入 SQL 时写；失败不阻断 publish（catch + log）。
+    plan_id = task_id（任务级版本，重 publish 覆盖）。
+    """
+    try:
+        if (task.get("executor_type") or "").lower() != "sql":
+            return
+        code = task.get("code") or ""
+        if not code.strip():
+            return
+        from jiuwenswarm.channels.web.orchestration.lineage import writer as lineage_writer
+        default_db = _db_name_from_ref(task.get("datasource_ref"))
+        lineage_writer.write_from_sql(
+            task_id=task["task_id"],
+            plan_id=task["task_id"],  # 构建时版本 = 任务级
+            sql=code,
+            default_db=default_db,
+            business_ref=task.get("datasource_ref"),
+        )
+    except Exception:
+        # 血缘落库失败不阻断 publish；编排日志记录即可
+        pass
+
+
+# ==========================================================================
+# workflows
+# ==========================================================================
+def create_workflow(data: dict) -> dict:
+    with _workspace_scope(data.get("workspace_id")):
+        return orch_db.create_workflow(data)
+
+
+def get_workflow(workflow_id: str) -> dict | None:
+    wf = orch_db.get_workflow(workflow_id)
+    if wf is not None:
+        wf["nodes"] = orch_db.list_nodes(workflow_id)
+    return wf
+
+
+def list_workflows(status: str | None = None, q: str | None = None,
+                   limit: int = 100, offset: int = 0) -> list[dict]:
+    workflows = orch_db.list_workflows(status, q=q, limit=limit, offset=offset)
+    counts = orch_db.count_instances_by_ref("workflow", [w["workflow_id"] for w in workflows])
+    for workflow in workflows:
+        workflow["instance_count"] = counts.get(workflow["workflow_id"], 0)
+    return workflows
+
+
+def count_workflows(status: str | None = None, q: str | None = None) -> int:
+    return orch_db.count_workflows(status, q=q)
+
+
+def update_workflow(workflow_id: str, data: dict) -> dict | None:
+    with _workspace_scope(data.get("workspace_id")):
+        return orch_db.update_workflow(workflow_id, data)
+
+
+def delete_workflow(workflow_id: str) -> bool:
+    return orch_db.delete_workflow(workflow_id)
+
+
+def set_workflow_status(workflow_id: str, status: str, enabled: int | None = None) -> dict | None:
+    return orch_db.set_workflow_status(workflow_id, status, enabled=enabled)
+
+
+def enable_workflow(workflow_id: str) -> dict:
+    """§5.1：enable 仅允许 published workflow；draft 返回 409。"""
+    wf = orch_db.get_workflow(workflow_id)
+    if not wf:
+        return {"error": "not_found", "status_code": 404}
+    if wf.get("status") != "published":
+        return {"error": "not_published", "status_code": 409,
+                "current_status": wf.get("status")}
+    return orch_db.set_workflow_status(workflow_id, "published", enabled=1)
+
+
+def disable_workflow(workflow_id: str) -> dict:
+    """§5.1：disable 保持 status=published，翻 enabled=0。"""
+    wf = orch_db.get_workflow(workflow_id)
+    if not wf:
+        return {"error": "not_found", "status_code": 404}
+    if wf.get("status") != "published":
+        return {"error": "not_published", "status_code": 409,
+                "current_status": wf.get("status")}
+    return orch_db.set_workflow_status(workflow_id, "published", enabled=0)
+
+
+def replace_nodes(workflow_id: str, nodes: list[dict]) -> list[dict]:
+    return orch_db.replace_nodes(workflow_id, nodes)
+
+
+def add_node(workflow_id: str, node: dict) -> dict:
+    return orch_db.add_node(workflow_id, node)
+
+
+# ==========================================================================
+# instances
+# ==========================================================================
+def list_instances(*, ref_type: str | None = None, ref_id: str | None = None,
+                   trigger_type: str | None = None,
+                   limit: int = 20, offset: int = 0, q: str | None = None) -> list[dict]:
+    return orch_db.list_instances(
+        ref_type=ref_type, ref_id=ref_id, trigger_type=trigger_type,
+        limit=limit, offset=offset, q=q)
+
+
+def count_instances(*, ref_type: str | None = None, ref_id: str | None = None,
+                    trigger_type: str | None = None, q: str | None = None) -> int:
+    """全量计数（分页 total 用，与旧 API 行为一致）。"""
+    return orch_db.count_instances(
+        ref_type=ref_type, ref_id=ref_id, trigger_type=trigger_type, q=q)
+
+
+def count_instances_by_status(*, ref_type: str | None = None, ref_id: str | None = None,
+                              trigger_type: str | None = None, q: str | None = None) -> dict[str, int]:
+    return orch_db.count_instances_by_status(
+        ref_type=ref_type, ref_id=ref_id, trigger_type=trigger_type, q=q)
+
+
+def preview_lineage(code: str, datasource_ref: str | None = None) -> list[dict]:
+    """解析 SQL 预览血缘（不落库，供建任务时实时看产出）。与旧 API 同语义。"""
+    parsed = lineage_parser.parse_sql(code, default_db=_db_name_from_ref(datasource_ref))
+    return parsed.to_dicts()
+
+
+def get_instance(instance_id: str) -> dict | None:
+    inst = orch_db.get_instance(instance_id)
+    if inst is not None:
+        from jiuwenswarm.channels.web.orchestration import artifact
+        inst["manifest"] = artifact.read_manifest(instance_id)
+        inst["task_runs"] = orch_db.list_task_runs(instance_id)
+    return inst
+
+
+def list_task_runs(instance_id: str) -> list[dict]:
+    return orch_db.list_task_runs(instance_id)
+
+
+def get_task_run_log(run_id: str, stream: str = "stdout") -> dict:
+    run = orch_db.get_task_run(run_id)
+    if not run:
+        return {"error": "not_found"}
+    stream = "stdout" if stream not in ("stdout", "stderr") else stream
+    path_field = f"{stream}_path"
+    log = ""
+    p = run.get(path_field)
+    if p:
+        from pathlib import Path
+        txt = Path(p).read_text(encoding="utf-8", errors="replace") if Path(p).is_file() else ""
+        log = txt
+    return {"log": log, "stream": stream, "run_id": run_id}
+
+
+# ==========================================================================
+# 实例控制
+# ==========================================================================
+def approve_node(instance_id: str) -> dict | None:
+    return workflow_engine.approve_node(instance_id)
+
+
+def resume_workflow(instance_id: str) -> dict | None:
+    """resume 仅允许 paused（§5.3：cancelled 不支持 resume）。"""
+    inst = orch_db.get_instance(instance_id)
+    if not inst:
+        return None
+    if inst.get("status") == "cancelled":
+        return {"error": "cannot_resume_cancelled", "status_code": 409}
+    return workflow_engine.resume_workflow(instance_id)
+
+
+def cancel_instance(instance_id: str) -> dict | None:
+    """cancel 实例（方案 §5.3）。
+
+    终态实例幂等返回当前状态；非终态调 workflow_engine.cancel_instance
+    （后者负责边界检查扩展 + CAS 防覆盖 + 子进程终止）。
+    """
+    inst = orch_db.get_instance(instance_id)
+    if not inst:
+        return None
+    if inst.get("status") in _TERMINAL_STATUSES:
+        return inst  # 幂等：终态直接返回
+    return workflow_engine.cancel_instance(instance_id)
