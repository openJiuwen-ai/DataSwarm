@@ -0,0 +1,118 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Loader2, Search } from 'lucide-react';
+import { useDataSourceStore } from '../store/dataSourceStore';
+import { SourceBrand } from './SourceBrand';
+import { SourceDrawerFrame } from './SourceDrawerFrame';
+
+export function SourceTypeDialog({
+  initialType,
+  onClose,
+  onSelect,
+}: {
+  initialType: string;
+  onClose: () => void;
+  onSelect: (type: string) => Promise<boolean>;
+}) {
+  const { t } = useTranslation();
+  const { sourceTypes, typesLoading, typesError } = useDataSourceStore();
+  const [keyword, setKeyword] = useState('');
+  const [selected, setSelected] = useState(initialType);
+  const [selecting, setSelecting] = useState(false);
+  const groups = useMemo(() => {
+    const result = new Map<string, typeof sourceTypes>();
+    const query = keyword.trim().toLowerCase();
+    sourceTypes.forEach((entry) => {
+      if (`${entry.label} ${entry.type_id}`.toLowerCase().includes(query)) {
+        const key = entry.category ?? 'other';
+        result.set(key, [...(result.get(key) ?? []), entry]);
+      }
+    });
+    const order = ['relational', 'nosql', 'file', 'api', 'message', 'other'];
+    return [...result.entries()].sort(([a], [b]) => order.indexOf(a) - order.indexOf(b));
+  }, [keyword, sourceTypes]);
+  const canSelect =
+    !typesLoading &&
+    !typesError &&
+    sourceTypes.some((entry) => entry.type_id === selected && entry.available === true && entry.fields.length > 0);
+  return (
+    <SourceDrawerFrame
+      title={t('dataSource.form.createTitle')}
+      step={1}
+      onClose={onClose}
+      footer={
+        <>
+          <button className="ds-button" onClick={onClose}>
+            {t('common.cancel')}
+          </button>
+          <button
+            className="ds-button ds-button-primary"
+            disabled={!canSelect || selecting}
+            onClick={async () => {
+              setSelecting(true);
+              try {
+                if (!(await onSelect(selected))) setSelected(initialType);
+              } finally {
+                setSelecting(false);
+              }
+            }}
+          >
+            {t('dataSource.typeDialog.next')}
+          </button>
+        </>
+      }
+    >
+      <div className="ds-type-search">
+        <label className="ds-search">
+          <Search size={16} />
+          <input
+            value={keyword}
+            onChange={(event) => setKeyword(event.target.value)}
+            aria-label={t('dataSource.typeDialog.searchPlaceholder')}
+            placeholder={t('dataSource.typeDialog.searchPlaceholder')}
+          />
+        </label>
+      </div>
+      {typesError && (
+        <p role="alert" className="ds-error">
+          {t('dataSource.typeDialog.loadFailed')} {typesError}
+        </p>
+      )}
+      {typesLoading && sourceTypes.length === 0 && (
+        <div className="ds-empty" role="status" aria-label={t('common.loading')}>
+          <Loader2 className="animate-spin" size={20} />
+        </div>
+      )}
+      {!typesLoading && !typesError && groups.length === 0 && (
+        <div className="ds-empty">{t('dataSource.typeDialog.empty')}</div>
+      )}
+      {groups.map(([category, entries]) => (
+        <section className="ds-type-group" key={category}>
+          <h3>{t(`dataSource.typeDialog.categories.${category}`, { defaultValue: category })}</h3>
+          <div className="ds-type-grid">
+            {entries.map((entry) => {
+              const available = entry.available === true && entry.fields.length > 0;
+              return (
+                <button
+                  key={entry.type_id}
+                  type="button"
+                  disabled={!available}
+                  aria-pressed={selected === entry.type_id}
+                  className={`datasource-type-card ${selected === entry.type_id ? 'is-selected' : ''}`}
+                  onClick={() => setSelected(entry.type_id)}
+                >
+                  <SourceBrand type={entry.type_id} />
+                  <span className="ds-type-copy">
+                    <span className="ds-type-label">{entry.label}</span>
+                    {!available && <span className="ds-coming-soon">{t('dataSource.typeDialog.comingSoon')}</span>}
+                  </span>
+                </button>
+              );
+            })}
+          </div>
+        </section>
+      ))}
+    </SourceDrawerFrame>
+  );
+}
