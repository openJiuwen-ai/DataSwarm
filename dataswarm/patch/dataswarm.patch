+    """抗稀释：整句被维度词摊到 0.59，短语向量顶回 1.0，且胜出索引可归因。"""
+    doc = embedding.VectorEntry(key="k1", doc_hash="h", vector=_axis_vector("客单价 aov"))
+    index = embedding.VectorIndex(scope_id="s", model="fake-emb", dims=len(_AXIS_ORDER),
+                                  entries=(doc,))
+    whole = _axis_vector("各地区的客单价")   # {地区,客单价} → cos 0.707 → 0.59
+    phrase = _axis_vector("客单价")          # {客单价}     → cos 1.0   → 1.0
+    single = embedding.rank(index, [whole])
+    multi = embedding.rank(index, [whole, phrase])
+    assert single[0][1] == pytest.approx(0.5917, abs=0.01), "只给整句时仍被稀释"
+    assert multi[0][1] == 1.0
+    assert multi[0][2] == 1, "胜出向量索引必须可归因到短语"
+
+
+def test_recall_carries_query_vectors_and_attribution(e2e, emb_on):
+    """查询向量组形态：整句首位 + 短语扩充（召回明细/UI 归因的数据源）。"""
+    _publish(e2e)
+
+    question = "卖了多少钱"
+    outcome = embedding.query_vectors(question)
+    assert outcome.ok, "向量组生成必须成功"
+    assert outcome.texts[0] == question, "首向量必须是整句原文"
+    assert len(outcome.texts) > 1, "应含短语向量"
+    # 逐命中归因（emb_via 指向查询向量组）在 R3/S→M 用例经 schema_recall 断言
+
+
+def test_phrase_vectors_use_higher_floor():
+    """同一余弦 0.59：整句向量给分、短语向量归零（实测噪声事故的对治）。
+
+    多向量模式下「怎么申请年假」的短语向量把无关文档顶到余弦 0.597；
+    若短语沿用整句 floor 0.50，噪声会以 0.28 漏进召回。
+    """
+    _whole, _ceil, phrase_floor = embedding._sim_bounds()
+    ch = _AXIS_ORDER.index("渠道")
+    other = _AXIS_ORDER.index("金额")
+    noisy = [0.0] * len(_AXIS_ORDER)
+    noisy[ch], noisy[other] = 0.59, 0.807  # 与渠道轴文档的余弦 ≈0.59
+    doc = _axis_vector("channel 渠道")
+
+    score_whole, idx_whole, raw = embedding.score_against([noisy], doc)
+    assert raw == pytest.approx(0.59, abs=0.01)
+    assert score_whole > 0, "整句向量在整句 floor 上应给分"
+    assert idx_whole == 0
+
+    zero = [0.0] * len(_AXIS_ORDER)
+    score_phrase, _idx, _raw = embedding.score_against([zero, noisy], doc)
+    assert score_phrase == 0.0, "同一余弦作为短语向量（2 号位）必须被更高 floor 归零"
+    assert phrase_floor > embedding.EMB_SIM_FLOOR
+
+
+def test_search_terms_drops_date_fragments_before_cap():
+    """带日期问句的前 N 个 2-gram 全是日期残片，真词不得被 cap 挤掉。
+
+    实测事故：「2026年8月各地区支付客单价」旧截断取前 8 个词 =
+    20/02/26/6年/年8/8月/月各/各地，「支付/客单/单价」全被挤掉 →
+    图通道恒零（召回表「图」列全横杠）。
+    """
+    terms = semantic_link.search_terms("2026年8月各地区支付客单价")
+    assert "支付" in terms and "客单" in terms and "单价" in terms
+    assert not any(t.isdigit() for t in terms)
+    assert not any(len(t) == 2 and any(c.isdigit() for c in t) for t in terms)
+    assert len(terms) <= 12
+
+
+def test_vector_floor_effective_value_parity(monkeypatch):
+    """E6b：VECTOR_FLOOR（knowledge.roads，召回门槛）与 metrics 侧实际生效
+    下限的**有效值口径**一致。
+
+    不做常量对常量断言（EMB_SIM_FLOOR 有 env 覆盖通道而 VECTOR_FLOOR 没有，
+    只断言常量相等会在 env 设置时给出「已锁死」的假绿——R-15）；改为 unset
+    env 后断言 ``_sim_bounds()`` 的实际生效 floor 与 VECTOR_FLOOR 相等。
+    env 覆盖造成的两侧分叉是已登记缺陷，收敛方向（给 analysis 同款通道或
+    metrics 统一下发）另行立项。
+    """
+    from jiuwenswarm.channels.web.dataagent.knowledge.roads import VECTOR_FLOOR
+
+    monkeypatch.delenv(embedding.EMB_FLOOR_ENV, raising=False)
+    assert embedding._sim_bounds()[0] == VECTOR_FLOOR
