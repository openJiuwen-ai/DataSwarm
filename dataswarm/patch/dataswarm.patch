+def test_load_llm_config_resolves_env_placeholders(tmp_path, monkeypatch):
+    """发布模板形态（exe 首装）：config 存 ${VAR} 占位符、真值在 config/.env。
+
+    对话侧经 resolve_env_vars 展开后正常；本链路若不展开会拿字面量请求网关
