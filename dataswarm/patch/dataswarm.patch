+    def test_no_ref_keeps_legacy_behavior(self, lineage_db):
+        """business_ref=None（未传）不过滤，兼容旧调用方。"""
+        _insert(lineage_db, [_row("l1", None), _row("l2", "doris://x:9030/olist")])
+        rows = lineage_db.list_table_lineage("olist")
+        assert len(rows) == 2
+
+    def test_save_writes_business_ref(self, lineage_db):
+        edges = [{"plan_id": "p1", "source_db": "olist", "source_table": "dwd_a",
+                  "target_db": "olist", "target_table": "dws_b",
+                  "business_ref": "sqlite:///abs/x.db"}]
