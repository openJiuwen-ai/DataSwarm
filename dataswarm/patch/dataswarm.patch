+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""schema/ensure.py 的方言完整性测试（阶段 0：mysql 方言启用）。
+
+关键约定：
+- **sqlite 是基线方言**（首装必有）；切 mysql 元库时缺基线表必须大声失败，
+  绝不静默建半套 schema。
+- 仓库真相源 ``deploy/schema/ddl/`` 里 mysql 表集合必须覆盖 sqlite 基线——
+  这条测试会拦住「新加表只写了部分方言」的回归。
+- **doris 元库已弃用**：2026-10-24 doris 方言 DDL 全部删除，加载 doris 方言
+  大声失败是**目标行为**。
+"""
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.schema import ensure
+
+# ensure._load_statements 期望的是 schema 根目录（内部自己拼 ddl 子目录）
+REPO_SCHEMA = Path(__file__).resolve().parents[3] / "deploy" / "schema"
+REPO_DDL = REPO_SCHEMA / "ddl"
+
+# 2026-10-09 收口口径：21 存量 + 6 指标 + verified_sql + schema_snapshots；
+# 之后加表须同步更新此数
+# 2026-10-10：退役 dw_bi_metrics / dw_bi_metric_bindings / dw_metric_queries 三张旧表后 29 → 26
+# 2026-10-12：语义层深集成补齐——同事 6 张表（dw_semantic_runs/snapshots/
+# profile/change_events/alerts + dw_ontology_terms）补 mysql 方言后 26 → 32；
+# 同日退役 dw_metric_schema_snapshots（schema 锚点改 release manifest 的
+# semantic_refs，真相源在 dw_semantic_snapshots）→ 31
+BASELINE_TABLE_COUNT = 36  # 2026-10-26 对齐现实(36 张 sqlite 基线表); 表数变化时更新此哨兵
+
+
+def _copy_dialect(dst: Path, *patterns: str) -> None:
+    """把真相源里匹配 pattern 的 DDL 拷进 dst/ddl/（ensure 的目录约定）。"""
+    ddl_dir = dst / "ddl"
+    ddl_dir.mkdir(parents=True, exist_ok=True)
+    for pattern in patterns:
+        for f in REPO_DDL.glob(pattern):
+            shutil.copy(f, ddl_dir / f.name)
+
+
+def test_repo_mysql_ddl_covers_sqlite_baseline():
+    """真相源里 mysql 表集合不得比 sqlite 基线缺表。"""
+    sqlite_tables = ensure._table_names(ensure._load_statements(REPO_SCHEMA, "sqlite"))
+    mysql_tables = ensure._table_names(ensure._load_statements(REPO_SCHEMA, "mysql"))
+    assert len(sqlite_tables) == BASELINE_TABLE_COUNT
+    assert not (sqlite_tables - mysql_tables), \
+        f"mysql DDL 缺基线表: {sorted(sqlite_tables - mysql_tables)}"
+
+
+def test_table_names_excludes_indexes():
+    """索引语句不算表——sqlite 索引单独成文件，混入会让 mysql 侧永远误报缺表。"""
+    sqlite_tables = ensure._table_names(ensure._load_statements(REPO_SCHEMA, "sqlite"))
+    assert "idx_bi_metric_owner" not in sqlite_tables
+    assert "idx_metric_qlog_ws" not in sqlite_tables
+    assert "dw_datasources" in sqlite_tables
+
+
+def test_doris_metadata_is_deprecated_by_design():
+    """doris 元库被拒绝是目标行为：2026-10-24 doris 方言 DDL 已全部删除，
+    加载即大声失败（不会静默建出空 schema）。"""
+    assert not list(REPO_DDL.glob("*.ddl.doris.sql")), "若 doris 已回填方言，请同步更新本测试与弃用策略"
+    with pytest.raises(RuntimeError) as excinfo:
+        ensure._load_statements(REPO_SCHEMA, "doris")
+    assert "doris" in str(excinfo.value)
+
+
+def test_mysql_suffix_registered():
+    """mysql 必须已注册进方言后缀表。"""
+    assert ensure._DIALECT_SUFFIX.get("mysql") == ".mysql."
+
+
+def test_completeness_guard_raises_with_missing_table(tmp_path):
+    """mysql 元库缺基线表 → 大声失败并列出缺失表名，不建半套 schema。"""
+    _copy_dialect(tmp_path, "*.ddl.sqlite.sql", "*.ddl.mysql.sql")
+    (tmp_path / "ddl" / "dw_datasources.ddl.mysql.sql").unlink()  # 抽掉一张
+
+    statements = ensure._load_statements(tmp_path, "mysql")
+    with pytest.raises(RuntimeError) as excinfo:
+        ensure._check_dialect_completeness(tmp_path, "mysql", statements)
+    assert "dw_datasources" in str(excinfo.value)
+    assert "不完整" in str(excinfo.value)
+
+
+def test_completeness_guard_passes_when_aligned(tmp_path):
+    """方言对齐时守卫静默通过；sqlite 自身永远跳过。"""
+    _copy_dialect(tmp_path, "*.ddl.sqlite.sql", "*.ddl.mysql.sql")
+    ensure._check_dialect_completeness(
+        tmp_path, "mysql", ensure._load_statements(tmp_path, "mysql"))  # 不抛即通过
+    ensure._check_dialect_completeness(
+        tmp_path, "sqlite", ensure._load_statements(tmp_path, "sqlite"))
+
+
+def test_sentinel_accepts_sqlite_only_dir(tmp_path, monkeypatch):
+    """目录哨兵只认 sqlite 基线——只有 sqlite 文件的目录也能解析。"""
+    _copy_dialect(tmp_path, "*.ddl.sqlite.sql")
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(tmp_path))
+    assert ensure.resolve_schema_dir() == tmp_path.resolve()
+
+
+def test_unknown_dialect_rejected(tmp_path, monkeypatch):
+    """未知元库类型显式报错（duckdb/pg 等不在支持列表）。"""
+    _copy_dialect(tmp_path, "*.ddl.sqlite.sql", "*.ddl.mysql.sql")
+    monkeypatch_ref = "duckdb://localhost/x"
+    original = ensure.db_connector.parse_db_ref
+    monkeypatch.setattr(
+        ensure.db_connector, "parse_db_ref",
+        lambda ref: {"type": "duckdb"} if ref == monkeypatch_ref else original(ref))
+    with pytest.raises(RuntimeError) as excinfo:
+        ensure.ensure_system_schema(monkeypatch_ref, schema_dir=tmp_path)
+    assert "duckdb" in str(excinfo.value)
+
+
+def test_ensure_sqlite_end_to_end_unchanged(tmp_path):
+    """sqlite 路径零回归：真实 ensure 全流程在临时 sqlite 建出全部基线表。"""
+    import sqlite3
+
+    db_file = tmp_path / "meta.db"
+    result = ensure.ensure_system_schema(
+        f"sqlite://{db_file}".replace("\\", "/"), schema_dir=REPO_SCHEMA)
+    assert result["dialect"] == "sqlite"
+    # ensured 含索引语句（27 表 + 11 索引）；按表名集合断言更稳
+    baseline = ensure._table_names(ensure._load_statements(REPO_SCHEMA, "sqlite"))
+    assert baseline <= set(result["ensured_tables"]), \
+        f"缺表: {sorted(baseline - set(result['ensured_tables']))}"
+    with sqlite3.connect(db_file) as conn:
+        tables = {r[0] for r in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
+    assert {"dw_datasources", "dw_metric_defs", "table_lineage"} <= tables
+
+
+def test_package_fallback_serves_wheel_installations(tmp_path, monkeypatch):
+    """whl 安装形态：无 env / 无 runtime / 无仓根时落到包内 resources 兜底。
+
+    whl 目标机没有仓库检出（_REPO 落空），runtime 目录 deploy-schema 只由
+    scripts/dw-ops/sync_schema.py 写入且脚本不随包分发（_RUNTIME 落空）——
+    包内 jiuwenswarm/resources/deploy-schema（构建时注入）是唯一可用候选。
+    """
+    pkg_schema = tmp_path / "pkg-schema"
+    (pkg_schema / "ddl").mkdir(parents=True)
+    (pkg_schema / "ddl" / "dw_datasources.ddl.sqlite.sql").write_text(
+        "-- stub\n", encoding="utf-8")
+    monkeypatch.delenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", raising=False)
+    monkeypatch.setattr(
+        ensure, "get_user_workspace_dir", lambda: tmp_path / "no-runtime")
+    monkeypatch.setattr(ensure, "_REPO_DEPLOY_SCHEMA", tmp_path / "no-repo")
+    monkeypatch.setattr(ensure, "_PACKAGE_DEPLOY_SCHEMA", pkg_schema)
+    assert ensure.resolve_schema_dir() == pkg_schema.resolve()
+
+
+def test_package_fallback_skipped_when_absent(tmp_path, monkeypatch):
+    """包内候选不存在时行为不变：dev/源码检出仍按原链解析（仓根命中）。"""
+    _copy_dialect(tmp_path / "repo-schema", "*.ddl.sqlite.sql")
+    monkeypatch.delenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", raising=False)
+    monkeypatch.setattr(
+        ensure, "get_user_workspace_dir", lambda: tmp_path / "no-runtime")
+    monkeypatch.setattr(ensure, "_REPO_DEPLOY_SCHEMA", tmp_path / "repo-schema")
+    monkeypatch.setattr(ensure, "_PACKAGE_DEPLOY_SCHEMA", tmp_path / "no-package")
+    assert ensure.resolve_schema_dir() == (tmp_path / "repo-schema").resolve()
diff --git a/tests/unit_tests/web/test_faiss_store_locking.py b/tests/unit_tests/web/test_faiss_store_locking.py
new file mode 100644
index 000000000..20a1d5f59
--- /dev/null
+++ b/tests/unit_tests/web/test_faiss_store_locking.py
@@ -0,0 +1,134 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""FAISS 索引操作必须持锁（第二轮重构台账 A-1）。
+
+faiss 在 C++ 层释放 GIL：采集后台线程的 add/delete/save 与请求线程的
+search 并发交错是未定义行为（轻则脏读、重则段错误带崩 Web 进程）。
+用「操作时记录锁状态」的伪 store 断言三件事：
+
+- add / delete / save / search 执行期间 store 级锁被持有；
+- embed（慢网络调用）在锁外执行，不阻塞召回；
+- semantic 与 glossary 两条链路同款纪律。
+"""
+from types import SimpleNamespace
+
+from jiuwenswarm.channels.web.dataagent.glossary import sync as glossary_sync
+from jiuwenswarm.channels.web.dataagent.semantic import vector_store
+
+
+class _RecordingStore:
+    """伪 FAISSStore：每个索引操作记录「store 锁当时是否被持有」。"""
+
+    def __init__(self, lock_of):
+        self._lock_of = lock_of
+        self.index = SimpleNamespace(metadata={})
+        self.ops: list[tuple[str, bool]] = []
+
+    def _record(self, name):
+        lock = self._lock_of()
+        self.ops.append((name, bool(lock and lock.locked())))
+
+    def add_vectors(self, vectors, ids=None, metadata=None):
+        self._record("add")
+
+    def delete_vectors(self, ids):
+        self._record("delete")
+
+    def save_index(self, path):
+        self._record("save")
+
+    def search_similar(self, vector, k=20):
+        self._record("search")
+        return []
+
+
+class _FakeEmbedding:
+    """embedding 通道替身：记录 embed 调用时锁是否被持有。"""
+
+    def __init__(self, lock_of):
+        self._lock_of = lock_of
+        self.embed_saw_lock = None
+
+    WARN_UNAVAILABLE = "emb_unavailable"
+
+    def emb_available(self):
+        return True
+
+    def embed_texts(self, texts):
+        lock = self._lock_of()
+        self.embed_saw_lock = bool(lock and lock.locked())
+        return SimpleNamespace(ok=True, dims=2, vectors=[[1.0, 0.0]] * len(texts), error="")
+
+    def query_vectors(self, question):
+        return SimpleNamespace(ok=True, vectors=[[1.0, 0.0]], texts=[question], error="")
+
+    def floors(self):
+        return (0.5, 0.5)
+
+    def calibrate(self, raw, floor=0.0):
+        return raw
+
+
+def test_semantic_sync_holds_store_lock_and_embeds_outside(monkeypatch):
+    fake = _RecordingStore(lambda: vector_store._store_lock("ws"))
+    embedding = _FakeEmbedding(lambda: vector_store._store_lock("ws"))
+    monkeypatch.setattr(vector_store, "embedding", embedding)
+    monkeypatch.setattr(vector_store, "_faiss_store", lambda ws, dims=None: fake)
+    doc = SimpleNamespace(id="d1", doc_hash="h1", metadata={"table_name": "t"}, text="x")
+    monkeypatch.setattr(vector_store, "build_docs", lambda ws, src, snap: [doc])
+
+    result = vector_store.sync_workspace_vectors("ws", "src", SimpleNamespace(tables=[]))
+
+    assert result["status"] == "ok", result
+    locked_by_op = {name: locked for name, locked in fake.ops}
+    assert locked_by_op.get("add") is True, fake.ops
+    assert locked_by_op.get("save") is True, fake.ops
+    # embed 是慢网络调用，持锁会把召回串行化——必须锁外
+    assert embedding.embed_saw_lock is False
+
+
+def test_semantic_recall_holds_store_lock(monkeypatch):
+    fake = _RecordingStore(lambda: vector_store._store_lock("ws"))
+    monkeypatch.setattr(vector_store, "embedding", _FakeEmbedding(lambda: vector_store._store_lock("ws")))
+    monkeypatch.setattr(vector_store, "_faiss_store", lambda ws, dims=None: fake)
+    # 台账非空才会走到 search（空索引走 WARN_INDEX_EMPTY 短路）
+    fake.index.metadata = {"d1": {"source_id": "src", "table_name": "t", "column_name": "c"}}
+
+    result = vector_store.recall("ws", "src", "问题")
+
+    assert result["warnings"] == []
+    locked_by_op = {name: locked for name, locked in fake.ops}
+    assert locked_by_op.get("search") is True, fake.ops
+
+
+def test_glossary_sync_holds_store_lock(monkeypatch):
+    fake = _RecordingStore(lambda: glossary_sync._store_lock("ws"))
+    monkeypatch.setattr(glossary_sync, "_embedding_configured", lambda: True)
+    monkeypatch.setattr(glossary_sync, "_embed_texts", lambda texts: [[1.0, 0.0]] * len(texts))
+    monkeypatch.setattr(glossary_sync, "_faiss_store", lambda ws, dims=None: fake)
+    monkeypatch.setattr(glossary_sync, "_workspace_id", lambda: "ws")
+    term = {"term_id": "t1", "name": "术语", "definition": "d",
+            "synonyms_list": ["别名"], "fingerprint": "f"}
+
+    result = glossary_sync._sync_vector_term(term, deleted=False)
+
+    assert result["status"] == "ok", result
+    locked_by_op = {name: locked for name, locked in fake.ops}
+    assert locked_by_op.get("add") is True, fake.ops
+    assert locked_by_op.get("save") is True, fake.ops
+
+
+def test_glossary_delete_path_holds_store_lock(monkeypatch):
+    fake = _RecordingStore(lambda: glossary_sync._store_lock("ws"))
+    monkeypatch.setattr(glossary_sync, "_embedding_configured", lambda: True)
+    monkeypatch.setattr(glossary_sync, "_embed_texts", lambda texts: [[1.0, 0.0]] * len(texts))
+    monkeypatch.setattr(glossary_sync, "_faiss_store", lambda ws, dims=None: fake)
+    monkeypatch.setattr(glossary_sync, "_workspace_id", lambda: "ws")
+    fake.index.metadata = {"t1:canonical": {"term_id": "t1", "fingerprint": "f"}}
+    term = {"term_id": "t1", "name": "术语", "definition": "d",
+            "synonyms_list": ["别名"], "fingerprint": "f2"}
+
+    result = glossary_sync._sync_vector_term(term, deleted=True)
+
+    assert result["status"] == "ok", result
+    locked_by_op = {name: locked for name, locked in fake.ops}
+    assert locked_by_op.get("delete") is True, fake.ops
