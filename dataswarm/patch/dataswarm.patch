+# ==========================================================================
+# schema 关系子图（替代旧 adapter.schema_subgraph）
+# ==========================================================================
+
+def build_exploration_subgraph(
+    snapshots: dict[str, Any], seeds: list[str], *, max_nodes: int = 15,
+) -> dict[str, Any]:
+    """以 seeds 为根组装 schema 关系子图（1 跳 join + 1 跳血缘）。
+
+    输出与旧 ``schema_subgraph`` 同构：
+    ``{"tables": [{id,type,label,logical}], "columns": [...],
+    "joins": [{left,right,kind,evidence,verified}], "lineage": [...]}``，
+    前端 ``MetricSchemaGraph`` 与 R3 探索端点直接消费。
+    """
+    node_index = _snapshot_index(snapshots)
+    collected: dict[str, dict[str, Any]] = {}
+    joins: list[dict[str, Any]] = []
+    lineage: list[dict[str, Any]] = []
+
+    def absorb(node_id: str) -> None:
+        if node_id in collected or len(collected) >= max_nodes:
+            return
+        attributes = _node_attributes(snapshots, node_id)
+        if attributes is None:
+            return
+        node_type, label, logical = attributes
+        collected[node_id] = {
+            "id": node_id, "type": "SourceTable" if node_type != "col" else "SourceColumn",
+            "label": label, "logical": logical}
+
+    def seed_tables(seed: str) -> list[str]:
+        """seed（表或列 node_id）直接关联的表名集合。"""
+        for snapshot in snapshots.values():
+            for table in snapshot.tables:
+                if table.node_id == seed:
+                    return [table.name]
+                for column in table.columns:
+                    if column.node_id == seed:
+                        return [table.name]
+        return []
+
+    frontier = list(dict.fromkeys(seeds))
+    for seed in frontier:
+        absorb(seed)
+    related = {name for seed in frontier for name in seed_tables(seed)}
+    # 表 → 全列吸收（belongsTo 等价物；列数受 max_nodes 约束）
+    for table_name in related:
+        entry = node_index.get(table_name) or {}
+        for _source_id, (table, columns) in entry.items():
+            absorb(table.node_id)
+            for column in columns.values():
+                absorb(column.node_id)
+    # join / 血缘：端点对象涉及 seed 关联表的全部收进来（1 跳等价）
+    for snapshot in snapshots.values():
+        for join in snapshot.joins:
+            if _join_touches(join, related, node_index):
+                for endpoint in (join.left_column_id, join.right_column_id,
+                                 join.left_table_id, join.right_table_id):
+                    absorb(endpoint)
+                record = {
+                    "left": join.left_column_id, "right": join.right_column_id,
+                    "kind": "foreignKey" if "fk" in join.source else "joinable",
+                    "evidence": "+".join(join.source) or "inferred",
+                    "verified": join.status == "verified",
+                }
+                if record not in joins:
+                    joins.append(record)
+        for link in snapshot.lineages:
+            if _lineage_touches(link, related, node_index):
+                for endpoint in [link.view_id, link.source_table_id,
+                                 link.source_column_id or "", link.target_column_id or ""]:
+                    if endpoint:
+                        absorb(endpoint)
+                record = {
+                    "left": link.source_table_id, "right": link.view_id,
+                    "kind": "derivedFrom", "evidence": "view_definition",
+                    "verified": link.completeness == "complete",
+                    "level": "column" if link.source_column_id else "table",
+                    "transformation": link.transformation,
+                }
+                if record not in lineage:
+                    lineage.append(record)
+    tables = [n for n in collected.values() if n["type"] == "SourceTable"]
+    columns = [n for n in collected.values() if n["type"] == "SourceColumn"]
+    return {"tables": tables, "columns": columns, "joins": joins, "lineage": lineage}
+
+
+def _join_touches(join: Any, related_tables: set[str], index: dict[str, Any]) -> bool:
+    """join 边是否涉及 seed 关联表（按列/表 ID 的表段判断）。"""
+    for endpoint in (join.left_column_id, join.right_column_id,
+                     join.left_table_id, join.right_table_id):
+        table_name = _table_name_of_endpoint(endpoint, index)
+        if table_name and table_name in related_tables:
+            return True
+    return False
+
+
+def _lineage_touches(link: Any, related_tables: set[str], index: dict[str, Any]) -> bool:
+    """血缘边是否涉及 seed 关联表。"""
+    for endpoint in (link.view_id, link.source_table_id,
+                     link.source_column_id or "", link.target_column_id or ""):
+        table_name = _table_name_of_endpoint(endpoint, index)
+        if table_name and table_name in related_tables:
+            return True
+    return False
+
+
+def _table_name_of_endpoint(endpoint: str, index: dict[str, Any]) -> str:
+    """node_id（tbl:/view:/col:）→ 表名（快照索引外的形态返回空）。"""
+    if not endpoint:
+        return ""
+    location = endpoint.rsplit(":", 1)[-1]  # {db}.{table}[.{column}]
+    parts = location.split(".")
+    if len(parts) >= 2:
+        return parts[1]
+    return ""
+
+
+def _warn(warnings: list[str], code: str) -> None:
+    """去重后追加一条警告。"""
+    if code and code not in warnings:
+        warnings.append(code)
