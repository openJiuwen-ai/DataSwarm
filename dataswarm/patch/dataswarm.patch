+
+function ComponentTimeline({ componentId, component, llmTrace }: {
+  componentId: string;
+  component: AnalysisComponent;
+  llmTrace: LlmTraceEntry[];
+}) {
+  type Event = { at?: string; label: string; body: React.ReactNode; llm?: LlmTraceEntry[] };
+  const events: Event[] = [];
+  // trace 通道带 decision 的条目与 sufficiency_trace 按下标逐条对齐（analysis_flow 同点追加）
+  const decisionEntries = traceDecisionEntries(llmTrace, componentId);
+  let traceIndex = 0;
+  for (const trace of component.sufficiency_trace ?? []) {
+    const matched = decisionEntries[traceIndex];
+    traceIndex += 1;
+    const missing = Array.isArray(trace.missing) ? trace.missing : [];
+    events.push({
+      at: String(trace.at ?? ''),
+      label: `充分性判断 → ${String(trace.decision ?? '')}`,
+      body: missing.length > 0 ? (
+        <div className="mt-0.5 space-y-0.5">
+          {missing.map((m, i) => {
+            const item = m as Record<string, unknown>;
+            return (
+              <p key={i} className="text-[11px] text-text-muted">
+                缺 <Badge tone="bg-slate-100 text-slate-600">{String(item.kind ?? 'unknown')}</Badge>{' '}
+                {String(item.what ?? JSON.stringify(item))}
+              </p>
+            );
+          })}
+        </div>
+      ) : null,
+      llm: matched ? [matched] : undefined,
+    });
+  }
+  const exploreSeen = new Map<string, number>();
+  for (const round of component.explore_rounds ?? []) {
+    const tool = String(round.tool ?? '');
+    const toolIndex = exploreSeen.get(tool) ?? 0;
+    exploreSeen.set(tool, toolIndex + 1);
+    const matched = llmEntriesForExplore(llmTrace, componentId, tool)[toolIndex];
+    const entries = Object.entries(round).filter(([k]) => !['at', 'tool'].includes(k));
+    events.push({
+      at: String(round.at ?? ''),
+      label: `探索 → ${tool}`,
+      body: <KeyValueRows entries={entries} />,
+      llm: matched ? [matched] : undefined,
+    });
+  }
+  let executeIndex = 0;
+  for (const attempt of component.attempts ?? []) {
+    // 仅 LLM 裸 SQL 路径（kind=execute）有对应条目；G1 编译通道（kind=compile）零 LLM
+    let llm: LlmTraceEntry[] | undefined;
+    if (attempt.kind === 'execute') {
+      const matched = matchLlmEntry(llmTrace, { step: 'execute', componentId, index: executeIndex });
+      executeIndex += 1;
+      if (matched) llm = [matched];
+    }
+    events.push({
+      at: attempt.at,
+      label: attemptLabel(attempt),
+      body: <AttemptBlock attempt={attempt} />,
+      llm,
+    });
+  }
+  return (
+    <div className="rounded border border-border p-3">
+      <div className="mb-2 flex items-center gap-2">
+        <span className="font-mono text-xs">{componentId}</span>
+        <Badge tone={statusColor(component.status ?? '')}>{component.status ?? 'planned'}</Badge>
+        {(component.retries ?? 0) > 0 && (
+          <span className="text-[11px] text-text-muted">重试 {component.retries} 次</span>
+        )}
+        {(component.explore_rounds?.length ?? 0) > 0 && (
+          <span className="text-[11px] text-text-muted">探索 {(component.explore_rounds?.length ?? 0)}/{explorationLimit(component)} 轮</span>
+        )}
+      </div>
+      {component.skip_reason && <p className="mb-2 text-xs text-warn">已跳过：{component.skip_reason}</p>}
+      {component.evidence_id && <p className="mb-2 text-[11px] text-text-muted">当前证据：{component.evidence_id}</p>}
+      {component.context && (
+        <details className="mb-2 rounded border border-border p-2">
+          <summary className="cursor-pointer text-xs">本组件补召回的 L1/L2 知识链路</summary>
+          <RecallSection manifest={{ analysis_id: componentId, question: '', created_at: '', context: component.context }} />
+          <ExpansionSection manifest={{ analysis_id: componentId, question: '', created_at: '', context: component.context }} />
+          <p className="text-xs text-text-muted">计划前规则补齐：{component.context.packs?.knowledge_rule_trace?.status ?? '未记录'} · {component.context.packs?.knowledge_rules?.length ?? 0} 条</p>
+        </details>
+      )}
+      {events.length === 0 && <p className="text-xs text-text-muted">该成分尚无执行事件</p>}
+      <ol className="space-y-2 border-l border-border pl-3">
+        {events.map((e, i) => (
+          <li key={i} className="relative">
+            <span className="absolute -left-[17px] top-1.5 h-2 w-2 rounded-full bg-accent" />
+            <div className="flex items-baseline gap-2">
+              <span className="text-xs font-medium">{e.label}</span>
+              {e.at && <span className="text-[10px] text-text-muted">{e.at.replace('T', ' ')}</span>}
