+def extract_value_dict(db_ref: str, snapshot, *, collector=None,
+                       diagnostics: dict[str, Any] | None = None) -> list[dict[str, Any]]:
+    """Collect non-sensitive text values with explicit population scope.
+
+    Args:
+        db_ref: Runtime business connection reference; never persisted here.
+        snapshot: Metadata snapshot whose table/column IDs own the values.
+        collector: Current metadata adapter, reusing its connector and bounded sample.
+        diagnostics: Optional output for status, population scope and per-column failures.
+
+    Returns:
+        Normalized value rows. Sampled sources contain observed values only;
+        metadata-only sources return no rows and an explicit skipped reason.
+    """
+    from .adapters.connector import is_scalar_type
+
+    status = diagnostics if diagnostics is not None else {}
+    scope = getattr(snapshot, "scope", {})
+    engine = str(getattr(collector, "engine", "") or scope.get("engine") or "")
+    sampled = engine == "sampled"
+    status.update(status="partial" if sampled else "ok", rows=0,
+                  population_scope="bounded_sample" if sampled else
+                  ("staged_files" if engine == "staged" else "source"),
+                  failures=[])
+    if engine == "schema_only":
+        status.update(status="skipped", reason="metadata_only", population_scope="metadata_only")
+        return []
+    if not db_ref and collector is None:
+        status.update(status="skipped", reason="connection_not_configured")
+        return []
+    try:
+        max_distinct = int(os.environ.get("DATASWARM_VALUE_DICT_MAX_DISTINCT", "").strip()
+                           or VALUE_DICT_DEFAULT_MAX_DISTINCT)
+    except ValueError:
+        max_distinct = VALUE_DICT_DEFAULT_MAX_DISTINCT
+    if max_distinct <= 0:
+        status.update(status="skipped", reason="value_dictionary_disabled")
+        return []
+    # Connector query results are capped at 10,000 rows; reserve one overflow row.
+    max_distinct = min(max_distinct, 9999, repository.VALUE_DICT_ROW_HARD_CAP)
+    source_type = str(getattr(collector, "sql_source_type", "")
+                      or getattr(getattr(snapshot, "source", None), "source_type", "")
+                      or db_ref.partition(":")[0].split("+", 1)[0])
+    rows: list[dict[str, Any]] = []
+    for table in snapshot.tables:
+        if table.table_type.upper() == "VIEW":
+            continue
+        for column in table.columns:
+            col_name = column.name.lower()
+            if (column.is_sensitive or not col_name or col_name.endswith("_id") or col_name == "id"
+                    or any(token in col_name for token in VALUE_DICT_EXCLUDE_COLUMN_TOKENS)):
+                continue
+            if not is_scalar_type(source_type, column.data_type) or logical_type(source_type, column.data_type) != TEXT:
+                continue
+            try:
+                values = _column_dictionary_values(db_ref, table, column, max_distinct, collector)
+            except Exception as exc:
+                status["failures"].append({"column_id": column.node_id, "error": type(exc).__name__})
+                status["status"] = "partial"
+                continue
+            if any(not isinstance(value, str) for value in values):
+                status["failures"].append({"column_id": column.node_id, "reason": "non_text_value",
+                                           "error": "UnsupportedValueType"})
+                status["status"] = "partial"
+                continue
+            for raw_value in values:
+                if len(rows) >= repository.VALUE_DICT_ROW_HARD_CAP:
+                    status.update(status="partial", reason="row_limit", rows=len(rows))
+                    return rows
+                text = raw_value
+                rows.append({"column_id": column.node_id, "table_id": table.node_id,
+                             "value_text": text,
+                             "value_norm": unicodedata.normalize("NFKC", text).strip().lower()})
+    status["rows"] = len(rows)
+    if sampled:
+        status["reason"] = "observed_values_only"
+    return rows
+
+
+def _column_dictionary_values(db_ref: str, table, column, max_distinct: int, collector) -> list[Any]:
+    """Use one materialized sample or a bounded distinct result, never a fabricated schema."""
+    if getattr(collector, "engine", "") == "sampled":
+        sample = collector.sample_table(table)
+        columns = sample.get("columns") or []
+        if column.name not in columns:
+            return []
+        position = columns.index(column.name)
+        observed = [row[position] for row in sample["rows"] if row[position] is not None]
+        if any(not isinstance(value, str) for value in observed):
+            return observed  # The shared output boundary records a column failure.
+        values = list(dict.fromkeys(observed))
+        return values if len(values) <= max_distinct else []
+    if collector is not None and hasattr(collector, "qualified_table"):
+        quoted = collector.quote_identifier(column.name)
+        target = collector.qualified_table(table)
+        alias = collector.quote_identifier("v")
+        source_type = str(getattr(collector, "sql_source_type", "") or getattr(table, "source_type", ""))
+        statement = f"SELECT DISTINCT {quoted} AS {alias} FROM {target} WHERE {quoted} IS NOT NULL"
+        if source_type == "doris":
+            # Doris aggregation queries must not acquire a LIMIT. Confirm a
+            # bounded cardinality before fetching values; the snapshot already
+            # records that these separate reads are not transactional.
+            cardinality_result = collector.query(
+                f"SELECT COUNT(DISTINCT {quoted}) AS {collector.quote_identifier('n')} FROM {target}",
+                limit=1,
+            )
+            if cardinality_result.get("ok") is False:
+                raise ValueError("value dictionary cardinality query failed")
+            count_rows = cardinality_result.get("rows") or []
+            distinct = int(count_rows[0][0] or 0) if count_rows and count_rows[0] else 0
+            if not distinct or distinct > max_distinct:
+                return []
+        else:
+            import sqlglot
+            from jiuwenswarm.common.dialect_registry import sqlglot_dialect
+
+            dialect = sqlglot_dialect(source_type)
+            query_expression = sqlglot.parse_one(statement, read=dialect)
+            if not isinstance(query_expression, sqlglot.exp.Select):
+                raise ValueError("value dictionary query must be a SELECT")
+            statement = query_expression.limit(max_distinct + 1).sql(dialect=dialect)
+        result = collector.query(
+            statement,
+            limit=max_distinct + 1,
+        )
+        if result.get("ok") is False:
+            raise ValueError("value dictionary query failed")
+        values = [row[0] for row in result.get("rows") or [] if row and row[0] is not None]
+        return [] if result.get("truncated") or len(values) > max_distinct else values
+
+    source_type = getattr(table, "source_type", "") or db_ref.partition(":")[0].split("+", 1)[0]
+
+    def quote(name: str) -> str:
+        return quote_ident(source_type, name)
+    target = ".".join(quote(part) for part in (table.database, table.name) if part)
+    quoted = quote(column.name)
+    # Preserve MySQL's bounded execution hint and legacy aggregation behavior.
+    hint = "/*+ MAX_EXECUTION_TIME(30000) */ " if source_type == "mysql" else ""
+    counted = db_connector.query_dict(
+        db_ref, f"SELECT {hint}COUNT(DISTINCT {quoted}) AS {quote('n')} FROM {target}", limit=None)
+    distinct = int(counted[0].get("n") or 0) if counted else 0
+    if not distinct or distinct > max_distinct:
+        return []
+    statement = f"SELECT {hint}{quoted} AS {quote('v')} FROM {target} WHERE {quoted} IS NOT NULL GROUP BY {quoted}"
+    if source_type == "mysql":
+        statement += f" LIMIT {max_distinct}"
+    value_rows = db_connector.query_dict(db_ref, statement, limit=None)
+    return [item["v"] for item in value_rows if item.get("v") is not None]
+
+
+def _validate_collection_size(previous, current) -> None:
+    """Block incomplete catalogs; record large sampled visibility changes."""
+    if not previous:
+        return
+    previous_count = len(previous.tables) + sum(len(table.columns) for table in previous.tables)
+    current_count = len(current.tables) + sum(len(table.columns) for table in current.tables)
+    if previous_count >= 20 and current_count < previous_count * 0.5:
+        if (current.scope.get("engine") == "sampled"
+                or current.scope.get("population_scope") == "bounded_sample"
+                or current.scope.get("metadata_scope") == "sampled_schema"):
+            # Variable document samples cannot prove object deletion. The diff
+            # records absence as an observation and suppresses destructive
+            # changes, so this guard must not block that observation first.
+            current.scope["collection_size_check"] = {
+                "status": "observed", "reason": "sampled_visibility_drop",
+                "previous_objects": previous_count, "current_objects": current_count,
+            }
+            return
+        raise RuntimeError(
+            f"collection object count dropped from {previous_count} to {current_count}; publish blocked"
+        )
