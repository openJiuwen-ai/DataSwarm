+def d_dialect_is_duckdb_not_mysql():
+    """用反引号拒绝和双引号 AST 语义区分 DuckDB/MySQL 方言。
+
+    sqlglot 可接受多个方言的相似语法，单靠正向解析不能证明方言选择正确。
+    """
+    for tid in ("parquet", "json", "s3", "oss", "csv", "excel"):
+        assert dr.sqlglot_dialect(tid) == "duckdb", (tid, dr.sqlglot_dialect(tid))
+
+    backtick = "SELECT `col` FROM t"
+    validate_read_only_sql(backtick, source_type="mysql")
+    validate_read_only_sql(backtick, source_type="doris")
+    expect_raises(lambda: validate_read_only_sql(backtick, source_type="parquet"),
+                  QueryValidationError, "反引号在 duckdb 方言下")
+    expect_raises(lambda: validate_read_only_sql(backtick, source_type="oss"),
+                  QueryValidationError, "反引号在 oss(duckdb) 方言下")
+
+    kinds = {}
+    for tid in ("parquet", "mysql", "postgresql"):
+        node = sqlglot.parse_one('SELECT "abc" FROM t',
+                                 read=dr.sqlglot_dialect(tid)).selects[0]
+        kinds[tid] = type(node).__name__
+    assert kinds["parquet"] == "Column", kinds
+    assert kinds["mysql"] == "Literal", kinds
+    assert kinds["postgresql"] == "Column", kinds
+    return (f"6 种文件源方言均为 duckdb；反引号 SQL 在 mysql/doris 通过而在 "
+            f"duckdb 被拒；双引号语义 {kinds}")
+
+
