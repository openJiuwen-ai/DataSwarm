@@ -0,0 +1,69 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""knowledge update_candidate 的乐观锁必须校验 rowcount（第二轮重构台账 A-6）。
+
+`transition()` 的 CAS 带 rowcount 校验（并发冲突回滚并抛错），
+`update_candidate()` 此前 UPDATE 匹配 0 行不报错、事件照记、调用方拿回
+他人版本——并发评审静默丢稿。两侧必须同纪律。
+"""
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.knowledge import store
+
+
+class _Cursor:
+    def __init__(self, rowcount: int):
+        self.rowcount = rowcount
+
+
+class _Conn:
+    def __init__(self):
+        self.rolled_back = False
+        self.committed = False
+
+    def rollback(self):
+        self.rolled_back = True
+
+    def commit(self):
+        self.committed = True
+
+    def close(self):
+        pass
+
+
+def _asset(revision: int = 1) -> dict:
+    return {"asset_id": "a1", "asset_type": "term", "title": "旧标题", "content": "c",
+            "status": "candidate", "revision": revision, "scope": {}, "source": {}}
+
+
+@pytest.fixture
+def env(monkeypatch):
+    conn = _Conn()
+    events: list[tuple] = []
+    monkeypatch.setattr(store, "_ensure", lambda: None)
+    monkeypatch.setattr(store, "_connect", lambda: conn)
+    monkeypatch.setattr(store, "_exec", lambda c, sql, params=None: _Cursor(1))
+    monkeypatch.setattr(store, "_event",
+                        lambda c, aid, action, actor, payload: events.append((aid, action)))
+    monkeypatch.setattr(store, "_workspace", lambda: "ws")
+    monkeypatch.setattr(store, "get_asset", lambda *a, **kw: _asset())
+    return conn, events, monkeypatch
+
+
+def test_update_candidate_success_commits(env):
+    conn, events, _ = env
+    result = store.update_candidate("a1", {"title": "新标题"})
+    assert result is not None
+    assert conn.committed is True
+    assert conn.rolled_back is False
+    assert events == [("a1", "update")]
+
+
+def test_update_candidate_concurrent_loss_rolls_back_and_raises(env):
+    """并发者已推进 revision：UPDATE 匹配 0 行必须回滚 + 抛错 + 不记事件。"""
+    conn, events, monkeypatch = env
+    monkeypatch.setattr(store, "_exec", lambda c, sql, params=None: _Cursor(0))
+    with pytest.raises(ValueError, match="concurrent"):
+        store.update_candidate("a1", {"title": "新标题"})
+    assert conn.rolled_back is True
+    assert conn.committed is False
+    assert events == []
