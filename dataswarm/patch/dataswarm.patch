+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+
+from jiuwenswarm.common import db_connector, workspace_context
+from jiuwenswarm.common import workspace_store
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+logger = logging.getLogger(__name__)
+
+# 系统默认工作空间：完全空态（无 YAML、无 UI 注册）时自动创建（不绑定业务源），
+# 让首次打开 EXE/网页的用户默认选中一个工作空间，会话有归属。固定 id 保证幂等；
+# 'default' 是 YAML legacy 空间的保留 id，不能占用。
+DEFAULT_WORKSPACE_ID = "default-ws"
+DEFAULT_WORKSPACE_NAME = "默认工作空间"
+DEFAULT_WORKSPACE_DESCRIPTION = "系统自动创建的默认工作空间"
+
+
+def _ensure_default_workspace() -> None:
+    """空态时创建系统默认工作空间（空绑定，后续建源自动绑定）。
+
+    并发首开由 workspace_store 的 id 查重兜底：对手已建好时抛
+    ValueError(already exists)，吞掉即可（重拉列表能拿到对手建的行）。
+    """
+    try:
+        create_workspace({
+            "name": DEFAULT_WORKSPACE_NAME,
+            "business_db_ref": "",
+            "workspace_id": DEFAULT_WORKSPACE_ID,
+            "description": DEFAULT_WORKSPACE_DESCRIPTION,
+        })
+    except ValueError as exc:
+        logger.info("[workspace] 默认工作空间已存在，跳过创建：%s", exc)
+
+
+def _summary(db_ref: str, source_type: str | None = None, config: dict | None = None) -> dict | None:
+    source_type = str(source_type or "").strip().lower()
+    config = config or {}
+    if not db_ref:
+        return None
+    if source_type in {"csv", "excel", "parquet", "json", "s3"}:
+        location = str(config.get("path") or config.get("location") or db_ref)
+        return {"type": source_type, "database": Path(location).name}
+
+    spec = db_connector.parse_db_ref(db_ref)
+    if source_type:
+        spec["type"] = source_type
+    if spec.get("type") == "sqlite":
+        return {"type": "sqlite", "database": Path(spec.get("path", "")).name}
+    return {"type": spec.get("type"), "database": spec.get("database", "")}
+
+
+def list_workspaces() -> dict:
+    try:
+        contexts = workspace_context.list_workspaces()
+    except workspace_context.WorkspaceNotConfigured:
+        # 全新环境（无 yaml、无 UI 注册）：自动创建系统默认工作空间后重拉，
+        # 前端单空间自动选中即达成「首次进入默认选中」；创建失败按原空态
+        # 返回（页面可用，仅无可选空间），其余配置错误照常上抛
+        try:
+            _ensure_default_workspace()
+            contexts = workspace_context.list_workspaces()
+        except workspace_context.WorkspaceNotConfigured:
+            contexts = []
+        except Exception:
+            logger.exception("[workspace] 默认工作空间创建失败，按空态返回")
+            contexts = []
+    return {
+        "workspaces": [
+            {
+                "workspace_id": ctx.workspace_id,
+                "name": ctx.name,
+                "origin": "yaml" if workspace_context.is_yaml_workspace(ctx.workspace_id) else "ui",
+                "business": _summary(ctx.business_db_ref),
+                "metadata": _summary(ctx.metadata_db_ref),
+                "description": ctx.description,
+            }
+            for ctx in contexts
+        ]
+    }
+
+
+def list_business_sources() -> dict:
+    sources: list[dict] = []
+    seen: set[str] = set()
+    try:
+        contexts = workspace_context.list_workspaces()
+    except workspace_context.WorkspaceContextError:
+        contexts = []
+    for context in contexts:
+        ref = context.business_db_ref
+        if not ref:
+            continue
+        key = workspace_context.normalize_db_ref(ref)
+        if key in seen:
+            continue
+        seen.add(key)
+        summary = _summary(ref)
+        sources.append({
+            "source_id": f"yaml:{context.workspace_id}:business",
+            "name": context.name,
+            "ref": ref,
+            "type": summary["type"],
+            "database": summary["database"],
+            "config_source": "yaml",
+        })
+    for source in _registered_sources():
+        ref = str(source.get("db_ref") or "").strip()
+        if not ref:
+            continue
+        key = workspace_context.normalize_db_ref(ref)
+        if key in seen:
+            continue
+        seen.add(key)
+        summary = _summary(
+            ref,
+            source_type=str(source.get("source_type") or ""),
+            config=dict(source.get("config") or {}),
+        )
+        sources.append({
+            "source_id": str(source.get("source_id") or ""),
+            "name": str(source.get("name") or source.get("source_id") or ref),
+            "ref": ref,
+            "type": summary["type"],
+            "database": summary["database"],
+            "config_source": "managed",
+        })
+    return {"sources": sources}
+
+
+def create_workspace(payload: dict) -> dict:
+    business_db_ref = str(payload.get("business_db_ref") or "").strip()
+    workspace_id = str(payload.get("workspace_id") or "").strip() or None
+    name = str(payload.get("name") or "").strip()
+    description = str(payload.get("description") or "").strip()
+    if len(description) > 500:
+        raise ValueError("workspace description must be at most 500 characters")
+    if workspace_id == "default":
+        raise ValueError("workspace_id 'default' is reserved")
+    try:
+        configured_contexts = workspace_context.list_workspaces()
+    except workspace_context.WorkspaceContextError:
+        configured_contexts = []
+    allowed_refs = {
+        workspace_context.normalize_db_ref(ctx.business_db_ref)
+        for ctx in configured_contexts
+        if ctx.business_db_ref
+    }
+    allowed_refs.update(
+        workspace_context.normalize_db_ref(str(source.get("db_ref") or ""))
+        for source in _registered_sources()
+        if source.get("db_ref")
+    )
+    if workspace_id and any(ctx.workspace_id == workspace_id for ctx in configured_contexts):
+        raise ValueError(f"workspace_id already exists: {workspace_id}")
+    if business_db_ref:
+        normalized_ref = workspace_context.normalize_db_ref(business_db_ref)
+        if normalized_ref not in allowed_refs:
+            raise ValueError("business database must be selected from a configured data source")
+    record = workspace_store.create_workspace(name, business_db_ref, workspace_id,
+                                              description=description)
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+    try:
+        ensure_system_schema(record["metadata_db_ref"])
+    except Exception:
+        connection = workspace_store._connect()
+        try:
+            connection.execute(
+                "DELETE FROM dw_workspaces WHERE workspace_id = ?",
+                (record["workspace_id"],),
+            )
+            connection.commit()
+        finally:
+            connection.close()
+        metadata_path = Path(db_connector.parse_db_ref(record["metadata_db_ref"])["path"])
+        if metadata_path.is_file():
+            metadata_path.unlink()
+        raise
+    created = workspace_context.resolve(record["workspace_id"])
+    return {
+        "workspace": {
+            "workspace_id": created.workspace_id,
+            "name": created.name,
+            "business": _summary(created.business_db_ref),
+            "metadata": _summary(created.metadata_db_ref),
+            "description": created.description,
+        }
+    }
+
+
+def update_workspace(workspace_id: str, payload: dict) -> dict:
+    """修改 UI 工作空间的 name/description（双 ref 与 id 不可改）。"""
+    clean_id = str(workspace_id or "").strip()
+    if not clean_id:
+        raise ValueError("workspace_id is required")
+    if clean_id == "default":
+        raise ValueError("the default workspace cannot be renamed")
+    if workspace_context.is_yaml_workspace(clean_id):
+        raise ValueError("YAML workspaces are read-only; edit them in datasource.yaml")
+    if "name" not in payload and "description" not in payload:
+        raise ValueError("name or description is required")
+    workspace_store.update_workspace(
+        clean_id,
+        name=payload.get("name"),
+        description=payload.get("description"),
+    )
+    updated = workspace_context.resolve(clean_id)
+    return {
+        "workspace": {
+            "workspace_id": updated.workspace_id,
+            "name": updated.name,
+            "business": _summary(updated.business_db_ref),
+            "metadata": _summary(updated.metadata_db_ref),
+            "description": updated.description,
+        }
+    }
+
+
+def delete_workspace(workspace_id: str) -> dict:
+    """删除 UI 工作空间：级联解绑 → 删注册行 → 释放引擎 → 删元库文件。
+
+    物理删除（含空间内注册的数据源与凭据）。default / YAML 只读空间 / 最后一个
+    空间不可删。文件删除失败不回滚（行已删，只留无害孤儿文件，warning 报告）。
+    """
+    from ..datasource import store as ds_store
+
+    clean_id = str(workspace_id or "").strip()
+    if not clean_id:
+        return {"ok": False, "error_code": "BAD_REQUEST", "error": "workspace_id is required"}
+    if clean_id == "default":
+        return {
+            "ok": False,
+            "error_code": "DEFAULT_WORKSPACE_PROTECTED",
+            "error": "the default workspace cannot be deleted",
+        }
+    if workspace_context.is_yaml_workspace(clean_id):
+        return {
+            "ok": False,
+            "error_code": "YAML_WORKSPACE_READ_ONLY",
+            "error": "YAML workspaces are read-only; remove them from datasource.yaml",
+        }
+    rows = workspace_store.list_workspaces()
+    if not any(r["workspace_id"] == clean_id for r in rows):
+        return {"ok": False, "error_code": "WORKSPACE_NOT_FOUND",
+                "error": f"workspace not found: {clean_id}"}
+    try:
+        contexts = workspace_context.list_workspaces()
+    except workspace_context.WorkspaceContextError:
+        contexts = []  # YAML 配置坏 → fail closed，拒绝删除
+    if len(contexts) <= 1:
+        return {"ok": False, "error_code": "LAST_WORKSPACE",
+                "error": "at least one workspace must remain"}
+
+    # ① 级联解绑：绑定源仅注册在本空间（随元库物理消失）→ 清空绑定；
+    #    同物理库在其他 UI 空间仍有注册、或为 YAML 声明 ref → 绑定仍可解析，不解绑
+    def _norm(ref: str) -> str:
+        try:
+            return workspace_context.normalize_db_ref(ref)
+        except Exception:
+            return str(ref or "").strip()
+
+    def _registered_keys(ws_id: str) -> set[str]:
+        try:
+            source_rows = ds_store.list_sources(workspace_id=ws_id)
+        except Exception:
+            return set()
+        return {_norm(str(s.get("db_ref") or "")) for s in source_rows
+                if str(s.get("db_ref") or "")}
+
+    vanishing = _registered_keys(clean_id)
+    unbound: list[str] = []
+    if vanishing:
+        surviving: set[str] = set()
+        for context in contexts:
+            if (context.workspace_id != clean_id and context.business_db_ref
+                    and workspace_context.is_yaml_workspace(context.workspace_id)):
+                surviving.add(_norm(context.business_db_ref))
+        for row in rows:
+            if row["workspace_id"] != clean_id:
+                surviving |= _registered_keys(row["workspace_id"])
+        for row in rows:
+            if row["workspace_id"] == clean_id or not row.get("business_db_ref"):
+                continue
+            key = _norm(str(row["business_db_ref"]))
+            if key in vanishing and key not in surviving:
+                workspace_store.update_business_ref(row["workspace_id"], "")
+                unbound.append(row["workspace_id"])
+
+    # Keep the business ref for schema-baseline cleanup after deleting the row.
+    deleted_business_ref = next(
+        (str(r.get("business_db_ref") or "").strip()
+         for r in rows if r["workspace_id"] == clean_id),
+        "",
+    )
+
+    # ② 删注册行（先删行再删文件：行删失败空间完好可回退）
+    record = workspace_store.delete_workspace(clean_id)
+
+    # ③ 释放引擎池连接（Windows 下池内句柄会锁住文件导致 unlink 失败）
+    meta_ref = record["metadata_db_ref"]
+    db_connector._invalidate(meta_ref, read_only=True)
+    db_connector._invalidate(meta_ref, read_only=False)
+    db_connector.invalidate_source_credentials_cache()
+
+    # ④ 删元库物理文件（失败不回滚——行已删，只留孤儿文件并在 warning 里报告）
+    warning = ""
+    if meta_ref.startswith("sqlite://"):
+        metadata_path = Path(db_connector.parse_db_ref(meta_ref)["path"])
+        for candidate in (metadata_path,
+                          metadata_path.with_name(metadata_path.name + "-wal"),
+                          metadata_path.with_name(metadata_path.name + "-shm")):
+            try:
+                if candidate.is_file():
+                    candidate.unlink()
+            except OSError as exc:
+                warning = f"metadata file could not be removed: {exc}"
+
+    # Baselines are keyed by business database (a stable naming rule shared
+    # with historical inspection artifacts), not by run id. Keep one while a
+    # surviving workspace still references the shared database.
+    if deleted_business_ref:
+        try:
+            deleted_key = _norm(deleted_business_ref)
+            still_referenced = any(
+                r.get("business_db_ref")
+                and _norm(str(r.get("business_db_ref") or "")) == deleted_key
+                for r in workspace_store.list_workspaces()
+            )
+            if not still_referenced:
+                db_meta = db_connector.parse_db_ref(deleted_business_ref)
+                db_label = db_meta.get("database") or db_meta.get("path") or deleted_business_ref
+                if db_meta.get("type") == "sqlite":
+                    stem = Path(str(db_label)).stem
+                else:
+                    import re
+                    stem = re.sub(r"[^A-Za-z0-9_-]+", "_", str(db_label)).strip("_") or "db"
+                baseline = (Path(get_user_workspace_dir()) / "artifact" / "inspection"
+                            / "baselines" / f"{stem}.json")
+                if baseline.is_file():
+                    baseline.unlink()
+        except OSError as exc:
+            warning = (f"{warning}; " if warning else "") + \
+                f"schema baseline could not be removed: {exc}"
+        except Exception as exc:  # noqa: BLE001 -- cleanup must not undo row deletion
+            warning = (f"{warning}; " if warning else "") + \
+                f"schema baseline cleanup skipped: {exc}"
+    return {"ok": True, "workspace_id": clean_id,
+            "unbound_workspaces": unbound, **({"warning": warning} if warning else {})}
+
+
+def _registered_sources() -> list[dict]:
+    """遍历全部工作空间元库收集 UI 注册源（新建空间元库表由 ensure 兜底）。"""
+    try:
+        contexts = workspace_context.list_workspaces()
+    except workspace_context.WorkspaceContextError:
+        return []
+    from ..datasource import store
+
+    sources: list[dict] = []
+    seen_refs: set[str] = set()
+    seen_ids: set[str] = set()
+    for context in contexts:
+        try:
+            rows = store.list_sources(workspace_id=context.workspace_id)
+        except Exception as exc:  # noqa: BLE001 —— 新空间元库表未建时由 ensure 兜底
+            logger.debug("[workspace] 读取工作空间源列表失败 workspace_id=%s: %s",
+                         context.workspace_id, exc)
+            continue
+        for row in rows:
+            ref = str(row.get("db_ref") or "")
+            source_id = str(row.get("source_id") or "")
+            ref_key = workspace_context.normalize_db_ref(ref) if ref else ""
+            if (ref_key and ref_key in seen_refs) or (source_id and source_id in seen_ids):
+                continue
+            if ref_key:
+                seen_refs.add(ref_key)
+            if source_id:
+                seen_ids.add(source_id)
+            sources.append(row)
+    return sources
+
+
+def probe(workspace_id: str) -> dict:
+    ctx = workspace_context.resolve(workspace_id)
+    result = {"workspace_id": ctx.workspace_id}
+    for role, ref in (("business", ctx.business_db_ref), ("metadata", ctx.metadata_db_ref)):
+        if not ref:
+            result[role] = {"ok": False, "error_code": "not_bound",
+                            "error": "no business database bound"}
+            continue
+        try:
+            ping = db_connector.ping(ref)
+            result[role] = {"ok": bool(ping.get("ok")), **_summary(ref)}
+            if not ping.get("ok"):
+                result[role]["error"] = "connection failed"
+        except Exception as exc:
+            result[role] = {"ok": False, **_summary(ref), "error": str(exc)}
+    return result
