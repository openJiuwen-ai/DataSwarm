+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""系统元数据 schema 层：deploy/schema 唯一真相源的加载与幂等 ensure。
+
+公开入口只有 ensure_system_schema(db_ref)——web 启动、巡检子进程、fixer
+三处调用同一函数；解析顺序见 ensure.resolve_schema_dir。
+"""
diff --git a/jiuwenswarm/channels/web/schema/ensure.py b/jiuwenswarm/channels/web/schema/ensure.py
