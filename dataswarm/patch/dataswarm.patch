+# ======================================================================
+print("\n########## 门 A：接入 ##########")
+
+
+def a_real_connection():
+    ok = connector_for().test_connection()
+    assert ok.get("ok") is True, f"真实 HBase Thrift 应连通: {ok}"
+    bad = connector_for({**CONFIG, "port": 9099}).test_connection()
+    assert bad.get("ok") is False, f"错端口应失败: {bad}"
+    return f"真实 Thrift 连通（{ok['message']}）；错端口失败"
+
+
+def a_validate():
+    adapter = R.get_source_type("hbase")
+    expect_raises(lambda: adapter.validate({"port": PORT}), ValueError, "缺 host")
+    expect_raises(lambda: adapter.validate({**CONFIG, "port": "70000"}),
+                  ValueError, "端口越界")
+    expect_raises(lambda: adapter.validate({**CONFIG, "sample_size": 0}),
+                  ValueError, "sample_size=0")
+    expect_raises(lambda: adapter.validate({**CONFIG, "materialize_limit": -1}),
+                  ValueError, "materialize_limit 负数")
+    adapter.validate(CONFIG)
+    return "host 必填；端口/采样/物化上限边界均被拒"
+
+
+def a_catalog_lists_real_table():
+    cat = connector_for().catalog()
+    names = [d["name"] for d in cat["datasets"]]
