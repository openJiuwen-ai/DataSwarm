+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan_to_tasks CSV 导入代码生成的凭据解析单测。
+
+背景：MySQL 版导入任务曾把 datasource.yaml mysql: 段的凭据在生成时烤进
+任务 code（password="" → 1045 Access denied），而 DDL 任务走 datasource_ref
+由服务端 db_connector.parse_db_ref 补齐 UI 源凭据——两条链路不对称。
+修复后导入代码必须运行时经 db_connector 解析 db-ref，凭据不出现在 code 里。
+
+跑法：python -m pytest tests/unit_tests/dw_warehouse_build/test_plan_to_tasks_credentials.py -v
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+_SCRIPT = (_REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+           / "skills" / "dw-warehouse-build" / "scripts" / "plan_to_tasks.py")
+
+
+def _load_plan_to_tasks():
+    """按路径加载 plan_to_tasks 模块（skill 脚本，非包内模块）。"""
+    spec = importlib.util.spec_from_file_location("_plan_to_tasks_cred_test", _SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault("_plan_to_tasks_cred_test", mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+_DDL = "CREATE TABLE IF NOT EXISTS `ods_t1` (\n  `id` BIGINT,\n  `name` VARCHAR(50)\n)"
+
+
+@pytest.fixture()
+def ptt(monkeypatch):
+    """加载模块并隔离 workspace 上下文（凭据链路不触真实 config）。"""
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    mod = _load_plan_to_tasks()
+    monkeypatch.setattr(mod, "WORKSPACE_ID", [""])
+    return mod
+
+
+def test_mysql_import_code_resolves_credentials_at_runtime(ptt, monkeypatch):
+    """MySQL 版生成代码：运行时 db_connector 解析 ref，凭据不烤进 code。"""
+    ref = "mysql://127.0.0.1:3306/somedb"
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": ref)
+    code = ptt._build_mysql_csv_import_code(
+        "D:/csv/t1.csv", "ods_t1", _DDL, "t1.csv", "btest",
+    )
+    assert 'REF = "mysql://127.0.0.1:3306/somedb"' in code
+    assert "db_connector.connect(REF" in code
+    assert "conn.select_db(DB)" in code
+    # 凭据不出现：无 CFG 字典、无 pymysql.connect 直连、无 password 字面量
+    assert "CFG" not in code
+    assert "pymysql.connect" not in code
+    assert '"password"' not in code
+
+
+def test_doris_import_code_resolves_credentials_at_runtime(ptt, monkeypatch):
+    """Doris Stream Load 版生成代码：FE 连接走 db_connector，BE 地址运行时读。"""
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": "doris://")
+    code = ptt._build_csv_import_code(
+        "D:/csv", "t1.csv", "ods_t1", _DDL, "btest",
+    )
+    assert 'REF = "doris://"' in code
+    assert "db_connector.connect(REF" in code
+    assert "db_connector._read_config_section" in code
+    assert "CFG" not in code
+    assert "pymysql.connect" not in code
+    assert '"password"' not in code
+
+
+def test_doris_import_code_placeholders_all_replaced(ptt, monkeypatch):
+    """占位符全部替换（防手滑漏替换把 __XXX__ 带进任务 code）。"""
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": "doris://")
+    code = ptt._build_csv_import_code(
+        "D:/csv", "t1.csv", "ods_t1", _DDL, "btest", delimiter=";", encoding="gbk",
+    )
+    # dunder（__name__/__main__）合法，只拦占位符形态 __XXX__
+    import re as _re
+    leftovers = [m for m in _re.findall(r"__[A-Z][A-Z_]*__", code)]
+    assert not leftovers
+    assert "D:/csv/t1.csv" in code
+    assert json.dumps(";") in code
+    assert json.dumps("gbk") in code
+
+
+def test_generated_mysql_code_is_valid_python(ptt, monkeypatch):
+    """生成代码可被 compile（语法级冒烟，不执行）。"""
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": "mysql://127.0.0.1:3306/somedb")
+    code = ptt._build_mysql_csv_import_code(
+        "D:/csv/t1.csv", "ods_t1", _DDL, "t1.csv", "btest",
+    )
+    compile(code, "<generated>", "exec")
+    # DDL has its own commit; DELETE plus every insert batch share the one
+    # following transaction and are rolled back together on failure.
+    assert code.count("conn.commit()") == 2
+    assert "conn.rollback()" in code
+
+
+def test_generated_code_uses_python_literals_for_untrusted_names(ptt, monkeypatch):
+    """Paths/names containing quotes or Python source cannot escape assignments."""
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": "mysql://127.0.0.1:3306/somedb")
+    hostile = 'x"; __import__("os").system("owned") #'
+    code = ptt._build_mysql_csv_import_code(
+        f"D:/csv/{hostile}.csv", hostile, _DDL, f"{hostile}.csv", hostile,
+    )
+    compile(code, "<generated-hostile>", "exec")
+    assert f"DB = {json.dumps(hostile, ensure_ascii=False)}" in code
+    assert f"TABLE = {json.dumps(hostile, ensure_ascii=False)}" in code
+
+
+def test_generated_doris_and_duckdb_code_compile_with_hostile_values(ptt, monkeypatch):
+    hostile = 'x"; __import__("os").system("owned") #'
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": "doris://")
+    doris_code = ptt._build_csv_import_code(
+        f'D:/csv/{hostile}', f'{hostile}.csv', hostile, _DDL, hostile,
+    )
+    compile(doris_code, "<generated-doris-hostile>", "exec")
+    assert f"TABLE = {json.dumps(hostile, ensure_ascii=False)}" in doris_code
+
+    duck_code = ptt._build_duckdb_csv_import_code(
+        f'D:/csv/{hostile}.csv', hostile, _DDL, f'{hostile}.csv',
+    )
+    compile(duck_code, "<generated-duckdb-hostile>", "exec")
+    assert f"TABLE = {json.dumps(hostile, ensure_ascii=False)}" in duck_code
+
+
+def test_sqlite_generated_import_rolls_back_delete_and_partial_batches(ptt, tmp_path, monkeypatch):
+    """A later insert failure must preserve the pre-import table contents."""
+    db_path = tmp_path / "warehouse.db"
+    csv_path = tmp_path / "rows.csv"
+    with sqlite3.connect(db_path) as conn:
+        conn.execute('CREATE TABLE "ods_t1" ("id" INTEGER PRIMARY KEY, "name" TEXT)')
+        conn.execute('INSERT INTO "ods_t1" VALUES (99, "old")')
+    csv_path.write_text("id,name\n1,new\n1,duplicate\n", encoding="utf-8")
+    monkeypatch.setattr(ptt, "_sqlite_db_path", lambda: db_path)
+    code = ptt._build_sqlite_csv_import_code(str(csv_path), "ods_t1", _DDL, "rows.csv")
+    namespace = {"__name__": "generated_test"}
+    exec(compile(code, "<generated-sqlite>", "exec"), namespace)
+    with pytest.raises(sqlite3.IntegrityError):
+        namespace["main"]()
+    with sqlite3.connect(db_path) as conn:
+        assert conn.execute('SELECT id, name FROM "ods_t1"').fetchall() == [(99, "old")]
+
+
+def test_duckdb_reader_pins_quote_char(ptt):
+    """duckdb read_csv 固定 quote='"'：sniffer 采样外的引号字段会因 quote
+    检测为空把引号内逗号当分隔符（strict_mode 报列数不匹配）。"""
+    sql = ptt._build_duckdb_ctas_sql("D:/csv", "t1.csv", "ods_t1")
+    assert "quote='\"'" in sql
