-            if persisted is not None:
-                new_items.append(persisted)
-                continue
-            # 上传失败：保留原 base64（若仍超帧限制，由下游链路返回可重试错误）
-            new_items.append(item)
-            continue
-        remaining -= len(data)
-        new_items.append(item)
-    params["documents"] = new_items
-    return params
