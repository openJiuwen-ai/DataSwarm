+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Prepare the dedicated SQL Server LocalDB acceptance instance (Windows only).
+
+Usage: .venv/Scripts/python.exe tests/acceptance/datasource/batch13/setup_localdb.py
+       [fixture_dir]
+
+Requires an existing SQL Server LocalDB installation, ODBC Driver 17, and pyodbc.
+Installs no system software. Only creates/starts DataSwarmAcceptance and resets
+three fixture tables inside the ownership-marked dataswarm_batch13 database.
+An existing database without our marker is rejected before any fixture writes.
+"""
+from __future__ import annotations
+
+import csv
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+INSTANCE = "DataSwarmAcceptance"
+DATABASE = "dataswarm_batch13"
+DRIVER = "ODBC Driver 17 for SQL Server"
+ROOT = Path(__file__).resolve().parents[4]
+DEFAULT_FIXTURE = ROOT / "artifact" / "datasource-validation" / "fixture"
+MARKER = "DataSwarmAcceptanceBatch"
+
+
+def connection_string(database: str = DATABASE) -> str:
+    if database not in {DATABASE, "master"}:
+        raise ValueError("Only the acceptance database and master are allowed")
+    return (f"DRIVER={{{DRIVER}}};SERVER=(localdb)\\{INSTANCE};"
+            f"DATABASE={database};Trusted_Connection=yes;")
+
+
+def prepare(fixture: Path) -> dict:
+    import pyodbc
+
+    executable = shutil.which("sqllocaldb")
+    if not executable:
+        raise RuntimeError("SQL Server LocalDB is not installed or is not on PATH")
+    if DRIVER not in pyodbc.drivers():
+        raise RuntimeError(f"Missing system ODBC driver: {DRIVER}")
+    listed = subprocess.run([executable, "info"], capture_output=True, text=True,
+                            errors="replace", check=True, timeout=15).stdout
+    if INSTANCE not in [line.strip() for line in listed.splitlines()]:
+        subprocess.run([executable, "create", INSTANCE], check=True, timeout=30)
+    subprocess.run([executable, "start", INSTANCE], check=True, timeout=30)
+
+    path = fixture / "fact_orders.csv"
+    if not path.is_file():
+        subprocess.run([sys.executable, "-I", str(ROOT / "tests" / "acceptance" /
+                        "datasource" / "batch1" / "make_fixture.py"), str(fixture)],
+                       check=True, timeout=60)
+    with path.open(encoding="utf-8", newline="") as stream:
+        rows = [(int(r["order_id"]), date.fromisoformat(r["order_date"]),
+                 int(r["region_id"]), int(r["category_id"]),
+                 Decimal(r["order_amt"]) if r["order_amt"] else None,
+                 int(r["order_qty"]), r["channel_name"])
+                for r in csv.DictReader(stream)]
+    expected = (50000, 3571, 299)
+    actual = (len(rows), sum(r[4] is None for r in rows), sum(r[2] == 9 for r in rows))
+    if actual != expected:
+        raise RuntimeError(f"Unexpected fixture counts: {actual}, expected {expected}")
+
+    master = pyodbc.connect(connection_string("master"), autocommit=True, timeout=15)
+    try:
+        version = master.execute("SELECT SERVERPROPERTY('ProductVersion'), "
+                                 "SERVERPROPERTY('Edition'), CAST(SERVERPROPERTY('IsLocalDB') AS int)").fetchone()
+        if version[2] != 1:
+            raise RuntimeError("Refusing to prepare a non-LocalDB server")
+        exists = master.execute("SELECT DB_ID(?)", DATABASE).fetchone()[0] is not None
+        if not exists:
+            master.execute(f"CREATE DATABASE [{DATABASE}]")
+    finally:
+        master.close()
+
+    conn = pyodbc.connect(connection_string(), timeout=15)
+    try:
+        marker = conn.execute("SELECT CAST(value AS nvarchar(50)) FROM sys.extended_properties "
+                              "WHERE class=0 AND name=?", MARKER).fetchone()
+        if exists and (not marker or marker[0] != "13"):
+            raise RuntimeError("Existing database is not marked as our acceptance fixture; refusing writes")
+        if not marker:
+            conn.execute("EXEC sys.sp_addextendedproperty @name=?, @value=N'13'", MARKER)
+            # Preserve ownership even if a later fixture load fails, so retrying
+            # can recover this dedicated database without weakening the guard.
+            conn.commit()
+        conn.execute("IF SCHEMA_ID('sales') IS NULL EXEC('CREATE SCHEMA sales')")
+        for table in ("dbo.fact_orders", "sales.fact_orders", "dbo.metadata_edge_case"):
+            conn.execute(f"DROP TABLE IF EXISTS {table}")
+        conn.execute("""CREATE TABLE dbo.fact_orders (
+            order_id BIGINT NOT NULL PRIMARY KEY, order_date DATE NULL,
+            region_id INT NULL, category_id INT NULL, order_amt DECIMAL(18,2) NULL,
+            order_qty INT NULL, channel_name NVARCHAR(16) NULL)""")
+        conn.execute("EXEC sys.sp_addextendedproperty @name=N'MS_Description', @value=?, "
+                     "@level0type=N'SCHEMA', @level0name=N'dbo', @level1type=N'TABLE', "
+                     "@level1name=N'fact_orders', @level2type=N'COLUMN', @level2name=N'channel_name'",
+                     "下单渠道")
+        cursor = conn.cursor()
+        cursor.fast_executemany = True
+        cursor.executemany("INSERT INTO dbo.fact_orders VALUES (?,?,?,?,?,?,?)", rows)
+        conn.execute("CREATE TABLE sales.fact_orders (shadow_id INT NOT NULL PRIMARY KEY, "
+                     "shadow_note NVARCHAR(32) NULL)")
+        conn.execute("INSERT INTO sales.fact_orders VALUES (1,N'schema collision sentinel')")
+        conn.execute("""CREATE TABLE dbo.metadata_edge_case (
+            key_a INT NOT NULL, obsolete INT NULL, key_b INT NOT NULL,
+            label NVARCHAR(42) NULL, amount DECIMAL(18,4) NULL,
+            CONSTRAINT PK_metadata_edge_case PRIMARY KEY (key_a, key_b))""")
+        conn.execute("ALTER TABLE dbo.metadata_edge_case DROP COLUMN obsolete")
+        conn.execute("EXEC sys.sp_addextendedproperty @name=N'MS_Description', @value=?, "
+                     "@level0type=N'SCHEMA', @level0name=N'dbo', @level1type=N'TABLE', "
+                     "@level1name=N'metadata_edge_case', @level2type=N'COLUMN', @level2name=N'label'",
+                     "删除中间列后的注释")
+        conn.execute("INSERT INTO dbo.metadata_edge_case VALUES (1,2,N'edge',12.3456)")
+        conn.commit()
+        stats = tuple(conn.execute("SELECT COUNT(*), SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END), "
+                                   "SUM(CASE WHEN region_id=9 THEN 1 ELSE 0 END) FROM dbo.fact_orders").fetchone())
+        if stats != expected:
+            raise RuntimeError(f"Loaded row counts differ: {stats}")
+        return {"instance": INSTANCE, "database": DATABASE, "version": version[0],
+                "edition": version[1], "rows": stats[0], "nulls": stats[1], "sentinels": stats[2]}
+    finally:
+        conn.close()
+
+
+if __name__ == "__main__":
+    import json
+    print(json.dumps(prepare(Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else DEFAULT_FIXTURE),
+                     ensure_ascii=False, indent=2))
diff --git a/tests/acceptance/datasource/batch13/verify_gates.py b/tests/acceptance/datasource/batch13/verify_gates.py
