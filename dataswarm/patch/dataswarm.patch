@@ -0,0 +1,108 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""统一的只读 SQL 校验与写入语句白名单校验。
+
+只读护栏（validate_read_only_sql）按数据源 source_type 查
+dialect_registry 选 sqlglot 方言解析——duckdb 文件源 / MySQL 协议族 /
+pg / sqlite 各按其语法判定，MySQL 协议族的反引号标识符不再被
+duckdb 方言误拒（方言收敛批次 2-G9）。
+"""
+
+from __future__ import annotations
+
+import re
+
+import sqlglot
+from sqlglot import exp
+from sqlglot.errors import ParseError
+
+from jiuwenswarm.common.dialect_registry import sqlglot_dialect as _sqlglot_dialect
+
+from .errors import QueryValidationError
+
+
+_LEADING_COMMENT_RE = re.compile(r"^(?:\s|--[^\n]*(?:\n|$)|/\*.*?\*/)*", re.S)
+_READ_ONLY = {"SELECT", "WITH", "SHOW", "DESCRIBE", "DESC", "EXPLAIN", "PRAGMA"}
+
+
+def _dialect_read(source_type: str) -> str:
+    """source_type → sqlglot read 方言。
+
+    duckdb 引擎固定 duckdb；sqlalchemy 引擎按 source_type 查 registry
+    （csv/parquet 等文件源不会走到这——manager.py 已按 engine 分流）。
+    """
+    if source_type == "duckdb":
+        return "duckdb"
+    return _sqlglot_dialect(source_type)
+
+
+def validate_read_only_sql(
+    sql: str, max_length: int = 100_000, source_type: str = "duckdb"
+) -> str:
+    if not isinstance(sql, str) or not sql.strip():
+        raise QueryValidationError("sql is required")
+    if len(sql) > max_length:
+        raise QueryValidationError("sql is too long")
+    normalized = _LEADING_COMMENT_RE.sub("", sql).strip()
+    try:
+        statements = [
+            s for s in sqlglot.parse(normalized, read=_dialect_read(source_type))
+            if s is not None
+        ]
+    except ParseError as exc:
+        raise QueryValidationError(f"SQL parse error: {exc}") from exc
+    if len(statements) != 1:
+        raise QueryValidationError("multiple SQL statements are not allowed")
+    stmt = statements[0]
+    first_word = normalized.split(None, 1)[0].upper() if normalized else ""
+    if first_word not in _READ_ONLY:
+        raise QueryValidationError("only read-only SQL is allowed")
+    write_nodes = (
+        exp.Alter, exp.Copy, exp.Create, exp.Delete, exp.Drop, exp.Insert,
+        exp.LoadData, exp.Merge, exp.TruncateTable, exp.Update, exp.Into,
+    )
+    if any(isinstance(node, write_nodes) for node in stmt.walk()):
+        raise QueryValidationError("write operations are not allowed")
+    return normalized[:-1].rstrip() if normalized.endswith(";") else normalized
+
+
+def parse_write_sql(sql: str, max_length: int = 100_000) -> "exp.Expression":
+    """校验 DuckDB 写入语句并返回解析树（ETL 物化路径专用）。
+
+    白名单：CREATE TABLE（含 OR REPLACE / AS SELECT）/ INSERT / DROP TABLE /
+    ALTER TABLE / TRUNCATE / COPY ... TO。其余（DELETE/UPDATE/CREATE VIEW/
+    ATTACH 等）一律拒绝。单语句限制与 validate_read_only_sql 同口径。
+
+    Returns:
+        sqlglot Expression（duckdb 方言）。
+
+    Raises:
+        QueryValidationError: 空语句、超长、多语句、方言解析失败或语句类型不在白名单。
+    """
+    if not isinstance(sql, str) or not sql.strip():
+        raise QueryValidationError("sql is required")
+    if len(sql) > max_length:
+        raise QueryValidationError("sql is too long")
+    normalized = _LEADING_COMMENT_RE.sub("", sql).strip()
+    if normalized.endswith(";"):
+        normalized = normalized[:-1].rstrip()
+    try:
+        statements = [s for s in sqlglot.parse(normalized, read="duckdb") if s is not None]
+    except ParseError as exc:
+        raise QueryValidationError(f"SQL parse error: {exc}") from exc
+    if len(statements) != 1:
+        raise QueryValidationError("multiple SQL statements are not allowed")
+    stmt = statements[0]
+    if isinstance(stmt, exp.Create) and stmt.args.get("kind") == "TABLE":
+        return stmt
+    if isinstance(stmt, (exp.Insert, exp.Alter)):
+        return stmt
+    if isinstance(stmt, exp.Drop) and stmt.args.get("kind") == "TABLE":
+        return stmt
+    if isinstance(stmt, exp.TruncateTable):
+        return stmt
+    if isinstance(stmt, exp.Copy) and stmt.args.get("kind") is False:
+        return stmt
+    raise QueryValidationError(
+        "unsupported write statement: allowed are CREATE TABLE / INSERT / "
+        "DROP TABLE / ALTER TABLE / TRUNCATE / COPY ... TO"
+    )
diff --git a/jiuwenswarm/channels/web/dataagent/connectors/sqlalchemy_connector.py b/jiuwenswarm/channels/web/dataagent/connectors/sqlalchemy_connector.py
