+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Unit tests for the adapter-side KB workspace binding (_resolve_kb_workspace_dir).
+
+Verifies datasource-workspace isolation: each session resolves its KB root
+from the session metadata ``workspace_id`` (WorkspaceSelector selection);
+missing/unknown ids fall back to ``default``.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.server.runtime.agent_adapter.interface_deep import JiuWenSwarmDeepAdapter
+
+
+@pytest.fixture
+def isolated_agent_ws(tmp_path, monkeypatch):
+    """Point the agent workspace at a tmp dir."""
+    import jiuwenswarm.common.utils as utils
+
+    monkeypatch.setattr(utils, "get_agent_workspace_dir", lambda: tmp_path)
+    return tmp_path
+
+
+def _patch_metadata(monkeypatch, meta):
+    import jiuwenswarm.server.runtime.session.session_metadata as session_metadata
+
+    monkeypatch.setattr(
+        session_metadata,
+        "get_session_metadata",
+        lambda sid, cache_bust=False, **kw: meta,
+    )
+
+
+def test_workspace_id_from_session_metadata(isolated_agent_ws, monkeypatch):
+    """会话 metadata 的 workspace_id 决定 KB 根。"""
+    _patch_metadata(monkeypatch, {"workspace_id": "bank"})
+    import jiuwenswarm.common.workspace_context as ws_ctx
+
+    class _W:
+        workspace_id = "bank"
+
+    # 桩注册表：bank 须为已知工作空间（不读开发者机器的真实 ~/.jiuwenswarm/）
+    monkeypatch.setattr(ws_ctx, "list_workspaces", lambda: [_W()])
+
+    result = JiuWenSwarmDeepAdapter._resolve_kb_workspace_dir(None, "sess_x")
+    assert result is not None
+    assert result.replace("\\", "/").endswith(".kb_workspaces/bank")
+
+
+def test_missing_workspace_id_falls_back_to_default(isolated_agent_ws, monkeypatch):
+    """无 workspace_id 的会话回退 default 工作空间。"""
+    _patch_metadata(monkeypatch, {"workspace_id": ""})
+
+    result = JiuWenSwarmDeepAdapter._resolve_kb_workspace_dir(None, "sess_x")
+    assert result is not None
+    assert result.replace("\\", "/").endswith(".kb_workspaces/default")
+
+
+def test_no_session_falls_back_to_default(isolated_agent_ws):
+    result = JiuWenSwarmDeepAdapter._resolve_kb_workspace_dir(None, None)
+    assert result is not None
+    assert result.replace("\\", "/").endswith(".kb_workspaces/default")
+
+
+def test_unknown_workspace_id_fails_closed(isolated_agent_ws, monkeypatch):
+    """未知 workspace_id 不得静默跨到 default。"""
+    _patch_metadata(monkeypatch, {"workspace_id": "no_such_ws"})
+    import jiuwenswarm.common.workspace_context as ws_ctx
+
+    real = ws_ctx.list_workspaces
+
+    def _fake_list():
+        class _W:
+            workspace_id = "bank"
+
+        return [_W()]
+
+    monkeypatch.setattr(ws_ctx, "list_workspaces", _fake_list)
+    # interface_deep 内部是延迟 import，patch 模块属性即可
+    _ = real
+    result = JiuWenSwarmDeepAdapter._resolve_kb_workspace_dir(None, "sess_x")
+    assert result is None
+
+
+def test_malformed_workspace_id_is_rejected(isolated_agent_ws, monkeypatch):
+    _patch_metadata(monkeypatch, {"workspace_id": "../evil"})
+
+    result = JiuWenSwarmDeepAdapter._resolve_kb_workspace_dir(None, "sess_x")
+    assert result is None
