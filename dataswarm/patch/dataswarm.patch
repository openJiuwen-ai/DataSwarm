+def test_ensure_table_reentry_does_not_deadlock(monkeypatch):
+    """重入环不死锁（2026-10-10 MySQL 元库 e2e 抓到的 blocker）。
+
+    环：``_ensure_table → ensure_system_schema → parse_db_ref →
+    _lookup_source_credentials → find_credentials → _ensure_table``（同一
+    meta_ref、同线程）。完整形态 mysql/doris ref 作元库时必踩：_init_lock
+    被本线程持有，重入死等。修复 = 重入哨兵直接让位。测试用假
+    ensure_system_schema 模拟环；死锁复现表现为线程永不结束。
+    """
+    import threading
+
+    ref = "mysql://127.0.0.1:33099/reentry_probe"
+    monkeypatch.setattr(ds_store, "_initialized_refs", set())
+    events: list[str] = []
+
+    def fake_ensure(meta_ref):
+        events.append(f"ensure:{meta_ref}")
+        # 模拟 ensure_system_schema 内部 parse→find_credentials→_ensure_table 的重入
+        ds_store._ensure_table(meta_ref)
+
+    def fake_desc(meta_ref):
+        events.append(f"desc:{meta_ref}")
+
+    class _FakeConn:
+        def close(self):
+            pass
+
+    def fake_connect(r):
+        events.append(f"connect:{r}")
+        return _FakeConn()
+
+    def fake_fetch_dicts(conn, sql, params=()):
+        # 探测 SELECT description ... 直接命中（表视为已存在）
+        events.append("probe")
+        return [{"description": ""}]
+
+    import jiuwenswarm.channels.web.schema.ensure as schema_ensure
+    monkeypatch.setattr(schema_ensure, "ensure_system_schema", fake_ensure)
+    monkeypatch.setattr(ds_store, "_ensure_description_column", fake_desc)
+    monkeypatch.setattr(ds_store, "_connect", fake_connect)
+    monkeypatch.setattr(ds_store, "_fetch_dicts", fake_fetch_dicts)
+
+    result: dict[str, object] = {}
+
+    def run():
+        try:
+            ds_store._ensure_table(ref)
+            result["ok"] = True
+        except BaseException as exc:  # noqa: BLE001 —— 记录线程内任何异常
+            result["err"] = exc
+
+    try:
+        t = threading.Thread(target=run)
+        t.start()
+        t.join(timeout=10)
+        assert not t.is_alive(), "死锁复现：重入 _ensure_table 未让位（10s 未返回）"
+        assert result.get("ok") is True, f"_ensure_table 异常退出: {result.get('err')}"
+        # 外层 ensure 只跑一次；重入那次让位后不再进 ensure/probe
+        assert events.count(f"ensure:{ref}") == 1
+        assert events.count("probe") == 1
+    finally:
+        ds_store._initialized_refs.discard(ref)
