+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 新建看板弹窗（简化版，直接在 DashboardListPage 内联了，此文件作为备选独立弹窗）。 */
+
+import { useState } from 'react';
+import { useDashboardStore } from '../store/dashboardStore';
+import { Button, Field, inputClass } from '../../_shared/ui';
+import { X } from 'lucide-react';
+
+interface DashboardCreateModalProps {
+  onClose: () => void;
+  onCreated: () => void;
+}
+
+export function DashboardCreateModal({ onClose, onCreated }: DashboardCreateModalProps) {
+  const store = useDashboardStore();
+  const [name, setName] = useState('');
+  const [description, setDescription] = useState('');
+
+  const handleCreate = async () => {
+    if (!name.trim()) return;
+    await store.createDashboard({ name: name.trim(), description: description || undefined });
+    onCreated();
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50" onClick={onClose}>
+      <div className="relative mx-4 w-full max-w-md rounded-xl border border-border bg-card p-6 shadow-xl" onClick={(e) => e.stopPropagation()}>
+        <button className="absolute right-3 top-3 rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}>
+          <X size={18} />
+        </button>
+        <h3 className="mb-4 text-lg font-semibold text-text-strong">新建看板</h3>
+        <div className="space-y-3">
+          <Field label="看板名称">
+            <input className={inputClass} value={name} onChange={(e) => setName(e.target.value)} placeholder="如：Olist运营看板" autoFocus />
+          </Field>
+          <Field label="描述">
+            <textarea className={`${inputClass} h-16`} value={description} onChange={(e) => setDescription(e.target.value)} placeholder="看板说明" />
+          </Field>
+        </div>
+        <div className="mt-4 flex justify-end gap-2">
+          <Button variant="ghost" onClick={onClose}>取消</Button>
+          <Button variant="primary" onClick={() => void handleCreate()}>创建</Button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/DashboardFilterBar.tsx b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/DashboardFilterBar.tsx
new file mode 100644
index 000000000..a306bada9
--- /dev/null
