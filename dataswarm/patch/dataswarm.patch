+
+def test_read_table_lineage_builds_nodes_with_layer_and_rowcount(patch_store, patch_db_connector, single_workspace):
+    rows = [
+        {"source_db": "olist", "source_table": "dwd_orders", "target_db": "olist",
+         "target_table": "dws_orders_daily", "join_key": "order_id", "task_id": "t1"},
+        {"source_db": "other_db", "source_table": "ods_users", "target_db": "olist",
+         "target_table": "dwd_users", "join_key": "user_id", "task_id": "t2"},
+    ]
+    patch_store(_FakeStore(table_rows=rows))
+    # Doris 分支：db_ref 不是 sqlite，走 INFORMATION_SCHEMA 查行数（query_dict → list[dict]）
+    patch_db_connector.query_dict_result = [
+        {"TABLE_NAME": "dwd_orders", "TABLE_ROWS": 100},
+        {"TABLE_NAME": "dws_orders_daily", "TABLE_ROWS": 50},
+        {"TABLE_NAME": "dwd_users", "TABLE_ROWS": 30},
