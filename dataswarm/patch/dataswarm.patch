diff --git a/jiuwenswarm/channels/web/frontend/src/features/settings/modules/models/EmbeddingSettings.tsx b/jiuwenswarm/channels/web/frontend/src/features/settings/modules/models/EmbeddingSettings.tsx
new file mode 100644
index 000000000..d27105ea8
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/settings/modules/models/EmbeddingSettings.tsx
@@ -0,0 +1,185 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Check, Sparkles } from 'lucide-react';
+import { Button } from '../../../../components/ui';
+import { settingsActionIcons } from '../../../../assets/settings';
+import { SettingsConfirmDialog, SettingsSection } from '../../components';
+import type { SettingsCustomItemProps } from '../../registry/types';
+import { useSettingsServices } from '../../services/SettingsServicesProvider';
+import { useSettingsSource } from '../../services/SettingsSourceProvider';
+import { AgentConfigDialog } from '../agent/AgentSettings';
+
+/** Embedding 配置三件套：写入 .env 的 EMBED_API_BASE / EMBED_API_KEY / EMBED_MODEL，
+ *  供数据分析语义召回（dataagent/metrics/embedding.py）读取 */
+const EMBED_FIELDS = ['embed_api_base', 'embed_api_key', 'embed_model'] as const;
+
+type SaveConfig = (updates: Record<string, string>, operation: string) => Promise<unknown>;
+
+type ValidationToast = { success: boolean; message: string };
+
+/** 设置→模型：Embedding 模型配置卡（语义召回通道），形态对齐对话模型列表 */
+export function EmbeddingSettings({ disabled }: SettingsCustomItemProps) {
+  const { t } = useTranslation();
+  const { isConnected, request } = useSettingsServices();
+  const { values, save } = useSettingsSource();
+  const [dialogOpen, setDialogOpen] = useState(false);
+  const [clearing, setClearing] = useState(false);
+  const [clearBusy, setClearBusy] = useState(false);
+  const [clearError, setClearError] = useState('');
+  const [testing, setTesting] = useState(false);
+  const [validationToast, setValidationToast] = useState<ValidationToast | null>(null);
+  const toastTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const saveConfig: SaveConfig = (updates, operation) => save(updates, operation);
+
+  const fieldValue = (name: string) => String(values[name] ?? '').trim();
+  const anyValue = EMBED_FIELDS.some((name) => fieldValue(name));
+  const configured = EMBED_FIELDS.every((name) => fieldValue(name));
+  // 未配置时占位名与对话模型卡保持一致的观感
+  const displayName = fieldValue('embed_model') || 'your-model-name';
+  const metadata = configured
+    ? fieldValue('embed_api_base')
+    : anyValue
+      ? t('settingsPanel.models.embeddingPartial')
+      : t('settingsPanel.common.notConfigured');
+
+  const showValidationToast = useCallback((toast: ValidationToast) => {
+    if (toastTimer.current) clearTimeout(toastTimer.current);
+    setValidationToast(toast);
+    toastTimer.current = setTimeout(() => {
+      setValidationToast(null);
+      toastTimer.current = null;
+    }, 3000);
+  }, []);
+
+  useEffect(
+    () => () => {
+      if (toastTimer.current) clearTimeout(toastTimer.current);
+    },
+    [],
+  );
+
+  /** 测试连接：把当前三项配置发给后端 config.validate_embedding 实调一次嵌入 */
+  const testEmbedding = async () => {
+    setTesting(true);
+    try {
+      await request(
+        'config.validate_embedding',
+        {
+          api_base: fieldValue('embed_api_base'),
+          api_key: fieldValue('embed_api_key'),
+          model: fieldValue('embed_model'),
+        },
+        { timeoutMs: 60_000 },
+      );
+      showValidationToast({ success: true, message: t('settingsPanel.models.validationOk') });
+    } catch (error) {
+      const detail = error instanceof Error ? error.message.trim() : '';
+      showValidationToast({
+        success: false,
+        message: detail
+          ? t('settingsPanel.models.validationFailedWithDetail', { detail })
+          : t('settingsPanel.models.validationFailed'),
+      });
+    } finally {
+      setTesting(false);
+    }
+  };
+
+  const confirmClear = async () => {
+    setClearBusy(true);
+    setClearError('');
+    try {
+      await saveConfig(
+        Object.fromEntries(EMBED_FIELDS.map((name) => [name, ''])),
+        'settingsPanel.models.embeddingTitle',
+      );
+      setClearing(false);
+    } catch (error) {
+      setClearError(error instanceof Error ? error.message : t('settingsPanel.feedback.saveFailed'));
+    } finally {
+      setClearBusy(false);
+    }
+  };
+
+  return (
+    <SettingsSection
+      testId="embedding-model-section"
+      title={t('settingsPanel.models.embeddingTitle')}
+      description={t('settingsPanel.models.embeddingDescription')}
+      separatedRows
+      action={
+        <Button variant="primary" disabled={disabled || !isConnected} onClick={() => setDialogOpen(true)}>
+          {t('settingsPanel.common.configure')}
+        </Button>
+      }
+    >
+      <article className="settings-model-card">
+        <span className="settings-model-card__logo settings-model-card__logo--icon" aria-hidden>
+          <Sparkles size={22} />
+        </span>
+        <div className="settings-model-card__copy">
+          <div className="settings-model-card__title-row">
+            <h3 title={displayName}>{displayName}</h3>
+          </div>
+          <p title={metadata}>{metadata}</p>
+        </div>
+        <div className="settings-model-card__actions">
+          {anyValue ? (
+            <>
+              <Button
+                icon={<settingsActionIcons.test aria-hidden />}
+                aria-label={t('settingsPanel.models.testConnection')}
+                title={t('settingsPanel.models.testConnection')}
+                loading={testing}
+                disabled={disabled || !isConnected || !configured}
+                onClick={() => void testEmbedding()}
+              />
+              <Button
+                variant="quiet"
+                icon={<settingsActionIcons.delete aria-hidden />}
+                aria-label={t('common.delete')}
+                title={t('common.delete')}
+                disabled={disabled || !isConnected}
+                onClick={() => {
+                  setClearError('');
+                  setClearing(true);
+                }}
+              />
+            </>
+          ) : null}
+        </div>
+      </article>
+      {dialogOpen ? (
+        <AgentConfigDialog
+          titleKey="settingsPanel.models.embeddingConfigTitle"
+          fields={EMBED_FIELDS}
+          config={values}
+          save={saveConfig}
+          onClose={() => setDialogOpen(false)}
+        />
+      ) : null}
+      <SettingsConfirmDialog
+        open={clearing}
+        title={t('settingsPanel.dialog.clearTitle', { name: t('settingsPanel.models.embeddingTitle') })}
+        message={t('settingsPanel.dialog.clearConfirm', { name: t('settingsPanel.models.embeddingTitle') })}
+        confirming={clearBusy}
+        error={clearError || undefined}
+        confirmLabel={t('common.delete')}
+        confirmVariant="danger"
+        onConfirm={() => void confirmClear()}
+        onCancel={() => {
+          if (!clearBusy) setClearing(false);
+        }}
+      />
+      {validationToast ? (
+        <div
+          className={`settings-models__toast settings-models__toast--${validationToast.success ? 'success' : 'error'}`}
+          role={validationToast.success ? 'status' : 'alert'}
+        >
+          {validationToast.success ? <Check aria-hidden /> : null}
+          <span>{validationToast.message}</span>
+        </div>
+      ) : null}
+    </SettingsSection>
+  );
+}
