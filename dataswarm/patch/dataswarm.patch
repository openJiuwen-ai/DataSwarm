+  failed: { color: 'var(--color-feedback-danger)', subtle: 'var(--color-feedback-danger-subtle)' },
+  waiting_review: { color: REVIEW_COLOR, subtle: 'var(--color-feedback-waiting-review-subtle)' },
+  timeout: { color: 'var(--color-feedback-danger)', subtle: 'var(--color-feedback-danger-subtle)' },
+  cancelled: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)' },
+  skipped: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)' },
+  paused: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)' },
+  pending: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)' },
+  unknown: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)' },
+};
+
+/** 画布节点数据 payload */
+interface WfNodeData {
+  width: number;
+  label: string;
+  taskName: string;
+  group?: string;
+  executor?: string;
+  actions?: ReactNode;
+  durationS?: number | null;
+  failureRole?: 'source' | 'blocked';
+  waitReview: boolean;
+  runStatus?: string;
+  statusIcon?: ReactNode;
