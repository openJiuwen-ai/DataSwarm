+def test_recall_all_parallel_propagates_workspace_context(monkeypatch):
+    """③并行化后 worker 线程必须看到主线程工作空间（ContextVar 快照注入）。
+
+    glossary resolve 等内部回源靠 ``workspace_context.current_workspace()``，
+    线程池不自动传播 ContextVar——漏注入则 worker 里拿到缺省工作空间，
+    术语路会在错误空间上检索。resolve 打桩绕开真实注册表（本测试只关心
+    值的传播，不关心工作空间解析）。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    class _Ws:
+        workspace_id = "parallel-ws"
+
+    monkeypatch.setattr(workspace_context, "resolve", lambda wid=None: _Ws())
+    seen: dict[str, str] = {}
+
+    def _probe(road: str):
+        def _job(*args, **kwargs):
+            seen[road] = workspace_context.current_workspace().workspace_id
+            return _term_road([])
+        return _job
+
+    monkeypatch.setattr(analysis_recall, "_recall_terms", _probe("terms"))
+    monkeypatch.setattr(analysis_recall, "_recall_metrics", _probe("metrics"))
+    monkeypatch.setattr(analysis_recall, "_recall_schema", _probe("schema"))
+    monkeypatch.setattr(analysis_recall, "_recall_values", _probe("values"))
+
+    token = workspace_context.set_current("parallel-ws")
+    try:
+        analysis_recall.recall_all("问题", "ws")
+    finally:
+        workspace_context.reset(token)
+    assert seen == {"terms": "parallel-ws", "metrics": "parallel-ws",
+                    "schema": "parallel-ws", "values": "parallel-ws"}
+
