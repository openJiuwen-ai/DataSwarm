+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/db.py —— 编排元数据层（系统元数据库）。
+
+系统元数据只有一套，放在 config 的 metadata_db 指向的库（Doris bigdata；
+后续前移 sqlite 时改 config 一行）。编排后端 CRUD（dw_tasks/dw_task_runs/
+dw_task_instances/dw_workflows/dw_workflow_nodes）全部走公共连接器
+dw-db-connector 的 SQLAlchemy Engine 池读写该库——与巡检 skill 读同一套元数据，
+后端新建的任务/实例巡检立即可见。
+
+设计要点：
+    - 连接层走 db_connector._acquire（SQLAlchemy QueuePool + pool_pre_ping），不自建连接。
+    - 占位符跨库：SQLite ? / Doris %s（_format_sql 适配）。
+    - Doris 表结构由迁移脚本 migrate_metadata_to_bigdata.py 建（DISTRIBUTED BY HASH）；
+      init_db 不再对 Doris 跑 executescript 建表，只做幂等的孤儿回扫。
+    - Doris 无需应用层写锁（自身并发控制）；sqlite 开发路径保留 WAL + threading.Lock。
+    - 重启回扫：running 的 instance/task_run 标 failed（抄 inspection 孤儿处理）。
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import threading
+import time
+import uuid
+from pathlib import Path
+from typing import Any
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+# 公共连接器：唯一连接层（SQLAlchemy Engine 池）。后端 CRUD 走它读写系统元数据库。
+# db_connector 已上收至 jiuwenswarm.common（方案 docs/skill-cli-web-api-plan.md §7.1）
+from jiuwenswarm.common import db_connector  # type: ignore  # noqa: E402
+from jiuwenswarm.common import workspace_context
+
+logger = logging.getLogger(__name__)
+
+# --------------------------------------------------------------------------
+# 系统元数据库引用
+# --------------------------------------------------------------------------
+# 优先级：环境变量 JIUWENSWARM_ORCH_DB（本地 sqlite 开发覆盖）> config metadata_db
+# （Doris bigdata，doris://meta）。env 兼容老脚本的本地开发：指向 training_warehouse.db
+# 时整个后端走 sqlite（占位符/锁语义走 sqlite 路径）。
+
+
+def _resolve_metadata_db_ref() -> str:
+    """解析编排后端要连的系统元数据库 db-ref。
+
+    优先级：env JIUWENSWARM_ORCH_DB > config metadata_db > 本地 SQLite 回退。
+    无 Doris 时自动回退到 ~/.jiuwenswarm/metadata.db，方便本地调试。
+    """
+    env = os.environ.get("JIUWENSWARM_ORCH_DB", "").strip()
+    if env:
+        return env if "://" in env else f"sqlite://{env}"
+    configured = db_connector.metadata_db_ref()
+    if configured:
+        return configured
+    # 无 Doris 配置 → 回退到本地 SQLite，方便无 Doris 环境调试
+    fallback = Path(get_user_workspace_dir()) / "metadata.db"
+    fallback.parent.mkdir(parents=True, exist_ok=True)
+    return f"sqlite://{fallback}"
+
+
+# 模块级元数据库引用（供 web 后端 bootstrap 用）。env 覆盖时为 sqlite 路径，
+# 否则为 config metadata_db（doris://meta → bigdata）。
+META_DB_REF = _resolve_metadata_db_ref()
+_is_sqlite = META_DB_REF.startswith("sqlite://")
+
+# 向后兼容：WAREHOUSE_DB/BASELINE_DB 旧引用（仅 sqlite 路径下有意义的 Path，
+# Doris 路径下为 None，旧代码引用需判空）。
+WAREHOUSE_DB = Path(META_DB_REF.replace("sqlite://", "")) if _is_sqlite else None
+BASELINE_DB = (WAREHOUSE_DB.with_name(WAREHOUSE_DB.stem + "_baseline.db")
+               if _is_sqlite and WAREHOUSE_DB else None)
+
+
+def resolve_warehouse_db(path: str | Path | None = None) -> Path | None:
+    """解析编排库路径（向后兼容旧引用）。
+
+    sqlite 路径：CLI --db > 环境变量 > 默认 config metadata_db。
+    Doris 路径（metadata_db=doris://meta）：返回 None（元数据在 Doris 库，非本地文件）。
+    """
+    if path:
+        return Path(path).expanduser().resolve()
+    env = os.environ.get("JIUWENSWARM_ORCH_DB", "").strip()
+    if env:
+        return Path(env).expanduser().resolve() if "://" not in env else None
+    if _is_sqlite:
+        return WAREHOUSE_DB
+    return None  # Doris bigdata 路径无本地文件
+
+# 编排实例日志产物根：~/.jiuwenswarm/artifact/orchestration/runs/<instance_id>/
+ARTIFACT_ROOT = Path(
+    os.environ.get(
+        "JIUWENSWARM_ORCHESTRATION_ARTIFACT_DIR",
+        Path(get_user_workspace_dir()) / "artifact" / "orchestration",
+    )
+).expanduser().resolve()
+
+_write_lock = threading.Lock()
+
+
+def _now() -> str:
+    return timeutil.now_iso()
+
+
+def new_instance_id() -> str:
+    """run_id 风格：YYYYmmdd_HHMMSS_<uuid8>，与 inspection 对齐。"""
+    return time.strftime("%Y%m%d_%H%M%S") + "_" + uuid.uuid4().hex[:8]
+
+
+def new_id(prefix: str) -> str:
+    return f"{prefix}_{uuid.uuid4().hex[:12]}"
+
+
+# --------------------------------------------------------------------------
+# 建表
+# --------------------------------------------------------------------------
+# 系统表 DDL 已迁入 deploy/schema/ddl/（唯一真相源），由 web.schema.ensure 应用；本文件不再内嵌建表 SQL。
+
+# Doris 建表 DDL（UNIQUE KEY + DISTRIBUTED BY HASH，与 migrate_metadata_to_bigdata.py 对齐）
+# 列序/类型与 SCHEMA_SQL 一致，但用 Doris 语法（ENGINE=OLAP UNIQUE KEY）
+DORIS_DDL = """
+CREATE TABLE IF NOT EXISTS dw_tasks (
+    task_id           VARCHAR(100),
+    name              VARCHAR(200),
+    description       VARCHAR(2000),
+    executor_type     VARCHAR(20),
+    code              VARCHAR(10000),
+    params_json       VARCHAR(2000),
+    datasource_ref    VARCHAR(500),
+    timeout_s         INT,
+    sla_minutes       INT,
+    retry_count       INT,
+    retry_interval_s  INT,
+    status            VARCHAR(20),
+    schedule_type     VARCHAR(20),
+    schedule_cron     VARCHAR(100),
+    schedule_once_at  VARCHAR(50),
+    layer             VARCHAR(20),
+    upstream_tasks    VARCHAR(500),
+    output_table      VARCHAR(200),
+    owner             VARCHAR(50),
+    created_at        VARCHAR(30),
+    updated_at        VARCHAR(30)
+) ENGINE=OLAP
+UNIQUE KEY(task_id)
+DISTRIBUTED BY HASH(task_id) BUCKETS 1
+PROPERTIES("replication_num"="1");
+
+CREATE TABLE IF NOT EXISTS dw_workflows (
+    workflow_id       VARCHAR(100),
+    name              VARCHAR(200),
+    description       VARCHAR(2000),
+    status            VARCHAR(20),
+    enabled           INT,
+    schedule_type     VARCHAR(20),
+    schedule_cron     VARCHAR(100),
+    schedule_once_at  VARCHAR(50),
+    owner             VARCHAR(50),
+    created_at        VARCHAR(30),
+    updated_at        VARCHAR(30)
+) ENGINE=OLAP
+UNIQUE KEY(workflow_id)
+DISTRIBUTED BY HASH(workflow_id) BUCKETS 1
+PROPERTIES("replication_num"="1");
+
+CREATE TABLE IF NOT EXISTS dw_workflow_nodes (
+    node_id           VARCHAR(100),
+    workflow_id       VARCHAR(100),
+    task_id           VARCHAR(100),
+    group_name        VARCHAR(100),
+    node_name         VARCHAR(200),
+    upstream_nodes    VARCHAR(500),
+    wait_review       INT,
+    order_index       INT,
+    created_at        VARCHAR(30)
+) ENGINE=OLAP
+UNIQUE KEY(node_id)
+DISTRIBUTED BY HASH(node_id) BUCKETS 1
+PROPERTIES("replication_num"="1");
+
+CREATE TABLE IF NOT EXISTS dw_task_instances (
+    instance_id       VARCHAR(100),
+    ref_type          VARCHAR(20),
+    ref_id            VARCHAR(100),
+    trigger_type      VARCHAR(20),
+    status            VARCHAR(20),
+    started_at        VARCHAR(30),
+    finished_at       VARCHAR(30),
+    artifact_dir      VARCHAR(500),
+    error_message     VARCHAR(2000),
+    created_at        VARCHAR(30)
+) ENGINE=OLAP
+UNIQUE KEY(instance_id)
+DISTRIBUTED BY HASH(instance_id) BUCKETS 1
+PROPERTIES("replication_num"="1");
+
+CREATE TABLE IF NOT EXISTS dw_task_runs (
+    run_id            VARCHAR(100),
+    instance_id       VARCHAR(100),
+    task_id           VARCHAR(100),
+    node_id           VARCHAR(100),
+    node_name         VARCHAR(200),
+    status            VARCHAR(20),
+    started_at        VARCHAR(30),
+    finished_at       VARCHAR(30),
+    sla_time          VARCHAR(30),
+    duration_s        DOUBLE,
+    exit_code         INT,
+    output_rows       INT,
+    retry_count       INT,
+    stdout_path       VARCHAR(500),
+    stderr_path       VARCHAR(500),
+    error_message     VARCHAR(2000),
+    result_summary    VARCHAR(2000),
+    start_ts          VARCHAR(30),
+    end_ts            VARCHAR(30)
+) ENGINE=OLAP
+UNIQUE KEY(run_id)
+DISTRIBUTED BY HASH(run_id) BUCKETS 1
+PROPERTIES("replication_num"="1");
+"""
+
+
+def _migrate_legacy_tables(conn) -> None:
+    """迁移旧的假样本表 / orch_* 表到新 dw_* 结构（仅 sqlite 路径）。
+
+    Doris 路径下表结构由迁移脚本 migrate_metadata_to_bigdata.py 建，无遗留 → no-op。
+    """
+    if not _is_sqlite:
+        return
+    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+    # 旧假样本 dw_tasks：检测无 executor_type 列 → DROP（让 CREATE IF NOT EXISTS 重建）
+    if "dw_tasks" in tables:
+        cols = {r[1] for r in conn.execute("PRAGMA table_info(dw_tasks)")}
+        if "executor_type" not in cols:
+            conn.execute("DROP TABLE dw_tasks")
+            tables.discard("dw_tasks")
+    # 旧假样本 dw_task_runs：检测无 instance_id 列 → DROP
+    if "dw_task_runs" in tables:
+        cols = {r[1] for r in conn.execute("PRAGMA table_info(dw_task_runs)")}
+        if "instance_id" not in cols:
+            conn.execute("DROP TABLE dw_task_runs")
+            tables.discard("dw_task_runs")
+    # 旧 orch_* 表（上一版编排模块）：直接 DROP
+    for legacy in ("orch_task", "orch_workflow", "orch_workflow_node", "orch_instance", "orch_task_run"):
+        if legacy in tables:
+            conn.execute(f"DROP TABLE {legacy}")
+
+
+def _connect(db_path: Path | str | None = None):
+    """可写连接（走 db_connector 的 SQLAlchemy Engine 池）。
+
+    db_path=None 时连系统元数据库（META_DB_REF：Doris bigdata 或 env sqlite）。
+    传 db_path（sqlite 路径，向后兼容 task-define 等 CLI）→ 连指定 sqlite 库。
+    返回的连接暴露 DBAPI 接口（.execute/.commit/.rollback/.close/.fetchall）。
+    """
+    if db_path is None:
+        # Resolve per-call so a workspace-scoped request never reuses the
+        # process-global metadata ref.  ``current_workspace`` preserves the
+        # legacy single-workspace fallback and fails loudly for an unset
+        # multi-workspace context.
+        meta_ref = workspace_context.current_workspace().metadata_db_ref
+        conn, meta = db_connector._acquire(meta_ref, read_only=False)
+        return conn
+    # 显式 sqlite 路径（CLI 传 --db）
+    ref = str(db_path) if "://" in str(db_path) else f"sqlite://{db_path}"
+    conn, _meta = db_connector._acquire(ref, read_only=False)
+    return conn
+
+
+def _is_sqlite_conn(conn) -> bool:
+    """探测连接是否 sqlite（fairy 代理底层，取 dbapi_connection 判 module）。"""
+    underlying = getattr(conn, "dbapi_connection", conn)
+    return "sqlite" in type(underlying).__module__.lower()
+
+
+def _exec(conn, sql: str, params: tuple = ()):
+    """跨库执行帮手：占位符 ?→%s 适配（sqlite 留 ?，Doris/pymysql 用 %s）。
+
+    conn 可能是 sqlite3.Connection 或 pymysql/_ConnectionFairy（DBAPI）。
+    sqlite 的 conn.execute 直接吃 ?；pymysql 的 cursor.execute 吃 %s。
+    按连接实际类型探测，不依赖模块级 _is_sqlite（支持显式传 sqlite 路径）。
+    """
+    if _is_sqlite_conn(conn):
+        return conn.execute(sql, params) if params else conn.execute(sql)
+    # Doris/pymysql：? → %s
+    sql_t = sql.replace("?", "%s")
+    cur = conn.cursor()
+    cur.execute(sql_t, list(params)) if params else cur.execute(sql_t)
+    return cur
+
+
+def _executescript(conn, script: str) -> None:
+    """执行多语句脚本。sqlite 有 executescript；Doris/pymysql 无 → 按分号拆逐条 execute。
+
+    仅用于建表（SCHEMA_SQL）；Doris 表结构实际由迁移脚本建，init_db 不对 Doris 跑这个。
+    """
+    if _is_sqlite and hasattr(conn, "executescript"):
+        conn.executescript(script)
+        return
+    # 拆逐条（去掉空语句/注释行）
+    for stmt in script.split(";"):
+        s = stmt.strip()
+        if s and not s.startswith("--"):
+            cur = conn.cursor()
+            cur.execute(s)
+
+
+def _recover_orphans_for(conn) -> None:
+    """重启孤儿回扫：running 的 instance/task_run 标 failed（跨库幂等 UPDATE）。"""
+    now = _now()
+    # 孤儿回扫：表不存在时静默跳过（首次启动表刚建好为空，不影响）
+    try:
+        _exec(
+            conn,
+            "UPDATE dw_task_instances SET status='failed', finished_at=?, "
+            "error_message=COALESCE(error_message||' | ','')||'orphaned: process not tracked' "
+            "WHERE status IN ('queued','running','paused','waiting_review')",
+            (now,),
+        )
+    except Exception as exc:  # noqa: BLE001 —— 表不存在等场景跳过（首次启动空库）
+        logger.warning("[orch-db] 孤儿回扫 dw_task_instances 失败，running 实例将保持原状态: %s", exc)
+        pass
+    try:
+        _exec(
+            conn,
+            "UPDATE dw_task_runs SET status='failed', finished_at=? "
+            "WHERE status IN ('queued','running','waiting_review')",
+            (now,),
+        )
+    except Exception as exc:  # noqa: BLE001 —— 表不存在等场景跳过（首次启动空库）
+        logger.warning("[orch-db] 孤儿回扫 dw_task_runs 失败，running 任务将保持原状态: %s", exc)
+        pass
+
+
+def _init_db_for(conn) -> None:
+    """sqlite 遗留迁移 + 孤儿回扫。建表职责已移交 web.schema.ensure。"""
+    _migrate_legacy_tables(conn)
+    _recover_orphans_for(conn)
+
+
+def init_db(warehouse_db: Path | None = None, baseline_db: Path | None = None) -> None:
+    """幂等初始化系统元数据。内部顺序固定（修掉空库先回扫导致启动失败的时序问题）：
+
+        1. sqlite 遗留清理（必须先于 CREATE IF NOT EXISTS —— 坏表要让路才能重建）
+        2. web.schema.ensure 幂等建表（deploy/schema 唯一真相源，双方言）
+        3. 孤儿回扫
+        4. sqlite 基线库同构（无孤儿）
+
+    调用方（bootstrap / seed_* / plan_to_tasks）签名与行为兼容。
+    多工作空间（决策五）：目标元库取当前工作空间上下文（bootstrap 逐库 set_current）；
+    未设上下文时回退模块级 META_DB_REF（legacy 单库语义不变）。
+    """
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+    # 目标元库：优先当前工作空间上下文（多库化）；无上下文（cli 直调等 legacy 场景）
+    # 回退模块级常量。env JIUWENSWARM_ORCH_DB 在 current_workspace() 内优先级最高。
+    try:
+        meta_ref = workspace_context.current_workspace().metadata_db_ref
+        workspace_scoped = True
+    except Exception:  # noqa: BLE001 —— 无配置/解析失败时维持 legacy 行为
+        meta_ref = META_DB_REF
+        workspace_scoped = False
+    is_sqlite = meta_ref.startswith("sqlite://")
+
+    # 目标库优先级：显式 --db（CLI 兼容）> 工作空间上下文元库 > 模块级 legacy 常量。
+    # 工作空间 sqlite 元库禁止回退 WAREHOUSE_DB——那是顶层默认元库路径，回退会把
+    # ensure_system_schema 打到默认库，新工作空间的元表永远建不出来（决策五事故点）。
+    wh = warehouse_db or (WAREHOUSE_DB if is_sqlite and not workspace_scoped else None)
+    bl = baseline_db or (BASELINE_DB if baseline_db is None and _is_sqlite else None)
+    with _write_lock:
+        target_ref = f"sqlite://{wh}" if (is_sqlite and wh) else meta_ref
+        # 1) 遗留清理（仅 sqlite；Doris 无历史遗留表形态）
+        if is_sqlite:
+            conn = _connect(wh or target_ref)
+            try:
+                _migrate_legacy_tables(conn)
+                conn.commit()
+            finally:
+                conn.close()
+        # 2) 幂等建表（唯一真相源）
+        result = ensure_system_schema(target_ref)
+        logger.info("[orch-db] schema ensured dialect=%s tables=%d",
+                    result["dialect"], len(result["ensured_tables"]))
+        # 3) 孤儿回扫
+        conn = _connect(target_ref)
+        try:
+            _recover_orphans_for(conn)
+            conn.commit()
+        finally:
+            conn.close()
+        # 4) sqlite 基线库同构（只保证表存在，不回扫）
+        if is_sqlite and bl and Path(bl).is_file():
+            bconn = _connect(bl)
+            try:
+                _migrate_legacy_tables(bconn)
+                bconn.commit()
+            finally:
+                bconn.close()
+            ensure_system_schema(f"sqlite://{bl}")
+    return result
+
+
+# --------------------------------------------------------------------------
+# 通用行转 dict（跨库：sqlite3.Row / pymysql tuple）
+# --------------------------------------------------------------------------
+def _row_to_dict(row) -> dict | None:
+    if row is None:
+        return None
+    if hasattr(row, "keys"):  # sqlite3.Row
+        return dict(row)
+    # pymysql tuple：无列名，需 caller 用 _exec 返回的 cursor.description 构造
+    # 这里兜底转 tuple；规范路径用 _fetch_dicts
+    return dict(row) if hasattr(row, "keys") else {"_row": list(row)}
+
+
+def _rows_to_dicts(rows) -> list[dict]:
+    return [dict(r) for r in rows] if rows and hasattr(rows[0], "keys") else [
+        {"_row": list(r)} for r in (rows or [])
+    ]
+
+
+def _fetch_dicts(conn, sql: str, params: tuple = ()) -> list[dict]:
+    """执行查询并返回 list[dict]（列名→值），跨库通用。
+
+    sqlite3.Row 有 keys() → dict(row)；pymysql tuple → 用 cursor.description zip。
+    """
+    cur = _exec(conn, sql, params)
+    rows = cur.fetchall()
+    if not rows:
+        return []
+    if hasattr(rows[0], "keys"):  # sqlite3.Row
+        return [dict(r) for r in rows]
+    cols = [d[0] for d in cur.description] if cur.description else []
+    return [dict(zip(cols, r)) for r in rows]
+
+
+def _fetch_one_dict(conn, sql: str, params: tuple = ()) -> dict | None:
+    cur = _exec(conn, sql, params)
+    row = cur.fetchone()
+    if row is None:
+        return None
+    if hasattr(row, "keys"):
+        return dict(row)
+    cols = [d[0] for d in cur.description] if cur.description else []
+    return dict(zip(cols, row))
+
+
+def _parse_json_field(d: dict, field: str) -> dict:
+    raw = d.get(field)
+    if not raw:
+        return {}
+    try:
+        return json.loads(raw) if isinstance(raw, str) else raw
+    except (json.JSONDecodeError, TypeError):
+        return {}
+
+
+# ==========================================================================
+# 任务 CRUD
+# ==========================================================================
+def create_task(data: dict) -> dict:
+    task_id = data.get("task_id") or new_id("task")
+    now = _now()
+    with _write_lock:
+        conn = _connect()
+        try:
