+    monkeypatch.setattr(kb_tools, "_global_agent_id", "test")
+    # 同进程前序用例可能遗留 openjiuwen 当前会话 / shell 会话注册，
+    # 会让无 session 的 legacy sticky 路径误按遗留 sid 查表而取到 None
