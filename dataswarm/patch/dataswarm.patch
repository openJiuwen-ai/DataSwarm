+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/artifact.py —— 实例产物目录与 manifest。
+
+约定（对齐 inspection 的 runs/<run_id>/ 结构）：
+    ~/.jiuwenswarm/artifact/orchestration/runs/<instance_id>/
+        manifest.json      状态机（status/started_at/finished_at/error）
+        stdout.log         实例级 stdout（工作流级聚合）
+        stderr.log         实例级 stderr
+        node_<n>.py        Python 源
+        node_<n>.params.json
+        node_<n>.stdout.log
+        node_<n>.stderr.log
+        result.json        实例级结果汇总
+"""
+from __future__ import annotations
+
+import json
+import logging
+from pathlib import Path
+from typing import Any
+
+from jiuwenswarm.channels.web import timeutil
+
+from . import db as orch_db
+
+logger = logging.getLogger(__name__)
+
+
+def instance_dir(instance_id: str) -> Path:
+    d = orch_db.ARTIFACT_ROOT / "runs" / instance_id
+    d.mkdir(parents=True, exist_ok=True)
+    return d
+
+
+def _atomic_write_json(path: Path, payload: Any) -> None:
+    """同目录临时文件 + replace，抄 run_pipeline.atomic_write_json。"""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temp = path.with_suffix(path.suffix + ".tmp")
+    temp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+    temp.replace(path)
+
+
+def now_ts() -> str:
+    return timeutil.now_iso()
+
+
+def write_manifest(instance_id: str, manifest: dict) -> None:
+    d = instance_dir(instance_id)
+    manifest.setdefault("instance_id", instance_id)
+    # 审计留痕（决策八-3/4）：workspace_id + 解析后双 ref 脱敏摘要。
+    # 单点注入覆盖全部 manifest 调用点；取不到上下文时省略（legacy 场景）。
+    try:
+        from jiuwenswarm.common import workspace_context
+
+        manifest.setdefault("workspace", workspace_context.audit_summary())
+    except Exception as exc:  # noqa: BLE001 —— legacy 场景无上下文时省略审计字段
+        logger.debug("[artifact] workspace 审计摘要注入失败 instance_id=%s: %s", instance_id, exc)
+        pass
+    _atomic_write_json(d / "manifest.json", manifest)
+
+
+def read_manifest(instance_id: str) -> dict | None:
+    p = instance_dir(instance_id) / "manifest.json"
+    if not p.is_file():
+        return None
+    try:
+        return json.loads(p.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+
+
+def append_instance_log(instance_id: str, stream: str, line: str) -> None:
+    """追加写实例级 stdout.log/stderr.log。"""
+    d = instance_dir(instance_id)
+    p = d / f"{stream}.log"
+    with p.open("a", encoding="utf-8") as f:
+        f.write(line if line.endswith("\n") else line + "\n")
+
+
+def read_log_file(instance_id: str, stream: str, node_prefix: str | None = None) -> str | None:
+    """读日志。stream=stdout|stderr；node_prefix 给定则读节点级日志。"""
+    d = instance_dir(instance_id)
+    if node_prefix:
+        p = d / f"{node_prefix}.{stream}.log"
+    else:
+        p = d / f"{stream}.log"
+    if not p.is_file():
+        return None
+    try:
+        return p.read_text(encoding="utf-8")
+    except OSError:
+        return None
