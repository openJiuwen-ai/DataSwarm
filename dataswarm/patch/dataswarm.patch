+def d_redis_refuses_full_keyspace_at_runtime():
+    """运行期应在调用客户端前拒绝全键扫描；有效扫描受键数上限约束。"""
+    from jiuwenswarm.channels.web.dataagent.connectors.sampled_connector import (
+        RedisStore,
+    )
+
+    class ControlledClient:
+        def __init__(self):
+            self.calls = []
+            self.allow_scan = False
+
+        def scan_iter(self, **kwargs):
+            self.calls.append(kwargs)
+            if not self.allow_scan:
+                raise AssertionError("拒绝非法逻辑表之前触发了客户端扫描")
+            return iter(("order:1", "order:2", "order:3", "order:4"))
+
+        def __getattr__(self, name):
+            raise AssertionError(f"不应调用客户端接口 {name}")
+
+    # 跳过真实客户端构造，任何非预期客户端访问都会使检查失败。
+    store = object.__new__(RedisStore)
+    store._client = client = ControlledClient()
+    store._max_keys = 2
+    store._datasets = []
+    expect_raises(store.list_datasets, ConnectorError, "未声明逻辑表")
+    store._datasets = ["hash:*"]
+    expect_raises(store.list_datasets, ConnectorError, "目录中的全键扫描")
+    expect_raises(lambda: store.sample("hash:*", 10),
+                  ConnectorError, "采样中的全键扫描")
+    expect_raises(lambda: store.scan("hash:**", None, None, 10),
+                  ConnectorError, "运行期全键扫描")
+    assert client.calls == [], client.calls
+
+    store._datasets = ["hash:order:*"]
+    assert store.list_datasets() == ["hash:order:*"]
+    assert client.calls == [], client.calls
+    client.allow_scan = True
+    assert store._scan_keys("order:*", 10) == ["order:1", "order:2"]
+    assert client.calls == [{"match": "order:*", "count": 500}], client.calls
+    return "目录/采样/扫描在客户端调用前拒绝全键扫描；有效 SCAN 遵守 max_keys"
+
