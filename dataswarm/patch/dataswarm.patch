--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/governance/components/shared/flowLanes.tsx
@@ -0,0 +1,153 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 治理模块共用：分层泳道布局 + React Flow 画布外壳。
+//
+// LineagePage（血缘）与 TaskPage（任务 DAG）共用：
+//   - laneLayout   —— 按 laneKey 分泳道、层内每行 N 个折行（防整体被等比缩放压扁）
+//   - LaneLabel    —— 泳道左侧 gutter 的层名标签节点
+//   - FlowShell    —— ReactFlow 画布（可读 / 完整两种自动适配策略 + 状态托管）
+// 节点卡片由各页面自定义（表卡片 / 任务状态卡），通过 nodeTypes 注入。
+//
+// 表血缘 / 工作流使用 0.7 可读下限；字段血缘使用 0.08 完整视图，保证纵向链路首屏完整。
+
+import { useEffect, useRef } from 'react';
+import { useTranslation } from 'react-i18next';
+import { ReactFlow, ReactFlowProvider, Background, BackgroundVariant, Controls, MiniMap, useNodesState, useEdgesState, useReactFlow } from '@xyflow/react';
+import type { Node, Edge, NodeProps } from '@xyflow/react';
+import '@xyflow/react/dist/style.css';
+import { getFlowAutoFitMinZoom } from './flowModel';
+import type { FlowAutoFitStrategy } from './flowModel';
+
+// laneLayout / LANE_ORDER / LaneLayoutOptions / LaneMeta 已抽到 laneLayoutCore.ts
+// （纯 TS，供 node --test 与数据管理模块表血缘图复用，不把 xyflow 拉进单测 bundle），
+// 此处 re-export 保持既有 import 路径与行为不变。
+import type { LaneMeta } from './laneLayoutCore';
+export { LANE_ORDER, laneLayout } from './laneLayoutCore';
+export type { LaneLayoutOptions, LaneMeta } from './laneLayoutCore';
+
+// ---- 泳道层名标签节点 ----
+
+export interface LaneNodeData {
+  label: string;
+  count: number;
+  color: string;
+  [key: string]: unknown;
+}
+
+export function LaneLabel({ data }: NodeProps) {
+  const d = data as LaneNodeData;
+  return (
+    <div className="gov-lane-label" style={{ borderLeftColor: d.color }}>
+      <span>{d.label}</span>
+      <span className="gov-lane-count">{d.count}</span>
+    </div>
+  );
+}
+
+/** 泳道标签节点的便捷构造（x 固定在左侧 gutter） */
+export function laneLabelNode(lane: LaneMeta, color: string): Node {
+  return {
+    id: `lane:${lane.key}`,
+    type: 'lane',
+    position: { x: 8, y: lane.y + 12 },
+    draggable: false,
+    selectable: false,
+    deletable: false,
+    data: { label: lane.key, count: lane.count, color } satisfies LaneNodeData,
+  };
+}
+
+// ---- 画布外壳 ----
+
+export interface FlowShellProps {
+  nodes: Node[];
+  edges: Edge[];
+  nodeTypes: Record<string, React.ComponentType<NodeProps>>;
+  fitKey: string;
+  /** 数据 / 模式变化后的自动适配策略；表血缘与任务默认保持可读，字段血缘显示完整链路。 */
+  autoFitStrategy?: FlowAutoFitStrategy;
+  /** 节点点击（血缘页选表高亮）；不传则无点击交互 */
+  onNodeClick?: (_: unknown, node: Node) => void;
+  /** 画布点击清空选择 */
+  onPaneClick?: () => void;
+  /** 小地图节点着色；传入即在画布渲染 MiniMap（数据管理表血缘用） */
+  minimapColor?: (node: Node) => string;
+}
+
+export function FlowShell(props: FlowShellProps) {
+  return (
+    <ReactFlowProvider>
+      <FlowShellInner {...props} />
+    </ReactFlowProvider>
+  );
+}
+
+function FlowShellInner({ nodes: nextNodes, edges: nextEdges, nodeTypes, onNodeClick, onPaneClick, fitKey, autoFitStrategy = 'readable', minimapColor }: FlowShellProps) {
+  const { t } = useTranslation();
+  // xyflow 内部 store 托管拖拽位置；数据变化时合入并保留已拖位置
+  const [flowNodes, setFlowNodes, onNodesChange] = useNodesState<Node>(nextNodes);
+  const [flowEdges, setFlowEdges, onEdgesChange] = useEdgesState<Edge>(nextEdges);
+  useEffect(() => {
+    setFlowNodes(prev => {
+      const old = new Map(prev.map(n => [n.id, n]));
+      return nextNodes.map(n => ({ ...old.get(n.id), ...n, position: old.get(n.id)?.position ?? n.position }));
+    });
+    setFlowEdges(nextEdges);
+  }, [nextNodes, nextEdges, setFlowNodes, setFlowEdges]);
+
+  const { fitView } = useReactFlow();
+  const autoFitMinZoom = getFlowAutoFitMinZoom(autoFitStrategy);
+  // fitKey 或策略变化（数据/模式切换）后，等节点写入 store 再适配视野。
+  const prevFitKey = useRef('');
+  useEffect(() => {
+    const nextFitKey = `${fitKey}:${autoFitStrategy}`;
+    if (prevFitKey.current === nextFitKey) return;
+    prevFitKey.current = nextFitKey;
+    const t = window.setTimeout(() => {
+      void fitView({ padding: 0.12, maxZoom: 1.15, minZoom: autoFitMinZoom, duration: 250 });
+    }, 80);
+    return () => window.clearTimeout(t);
+  }, [autoFitMinZoom, autoFitStrategy, fitKey, fitView]);
+
+  return (
+    <div className="gov-flow-canvas">
+      <ReactFlow
+        nodes={flowNodes}
+        edges={flowEdges}
+        nodeTypes={nodeTypes}
+        onNodesChange={onNodesChange}
+        onEdgesChange={onEdgesChange}
+        onNodeClick={onNodeClick}
+        onPaneClick={onPaneClick}
+        panOnDrag
+        zoomOnScroll
+        zoomOnDoubleClick={false}
+        zoomOnPinch
+        nodesDraggable={false}
+        nodesConnectable={false}
+        edgesReconnectable={false}
+        deleteKeyCode={null}
+        minZoom={0.08}
+        maxZoom={2.5}
+        fitView
+        fitViewOptions={{ padding: 0.12, maxZoom: 1.15, minZoom: autoFitMinZoom }}
+        ariaLabelConfig={{
+          'controls.ariaLabel': t('governance.dashboard.flow.controls'),
+          'controls.zoomIn.ariaLabel': t('governance.dashboard.flow.zoomIn'),
+          'controls.zoomOut.ariaLabel': t('governance.dashboard.flow.zoomOut'),
+          'controls.fitView.ariaLabel': t('governance.dashboard.flow.fitView'),
+        }}
+        proOptions={{ hideAttribution: true }}
+      >
+        <Background variant={BackgroundVariant.Dots} gap={22} size={1} color="#c9d2da" />
+        {minimapColor ? <MiniMap pannable zoomable nodeColor={minimapColor} /> : null}
+      </ReactFlow>
+      <Controls
+        className="gov-flow-controls"
+        position="bottom-right"
+        orientation="vertical"
+        showInteractive={false}
+        fitViewOptions={{ padding: 0.12, maxZoom: 1.15, minZoom: 0.08, duration: 250 }}
+      />
+    </div>
+  );
+}
