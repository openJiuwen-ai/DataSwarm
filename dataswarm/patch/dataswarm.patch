+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""llm_client 单测（配置多级 fallback + 降级契约）。
+
+覆盖（方案 docs/archive/delivered/inspection-llm-integration-plan.md §2.8）：
+  - load_llm_config 三级段优先级: ai_analysis > react.model_client_config > models.defaults[0]
+  - 缺段/坏 yaml/文件不存在 → 默认值（api_key 空串，调用方判空降级）
+  - call_llm_sync：LLM 异常/超时 → 空串不抛异常
+"""
+from __future__ import annotations
+
+import asyncio
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO_ROOT = Path(__file__).resolve().parents[3]
+_DW_COMMON = _REPO_ROOT / "jiuwenswarm/resources/agent/workspace/skills/_dw_common/scripts"
+sys.path.insert(0, str(_DW_COMMON))
+
+import llm_client  # noqa: E402
+
+
+def _write_cfg(tmp_path: Path, content: str) -> str:
+    p = tmp_path / "config.yaml"
+    p.write_text(content, encoding="utf-8")
+    return str(p)
+
+
+# --------------------------------------------------------------------------
+# load_llm_config 段优先级
+# --------------------------------------------------------------------------
+def test_config_priority_ai_analysis(tmp_path):
+    cfg = _write_cfg(tmp_path, """
+ai_analysis:
+  model_name: m-ai
+  api_base: http://ai
+  api_key: sk-ai
+react:
+  model_name: m-react
+  model_client_config:
+    api_base: http://react
+    api_key: sk-react
+models:
+  defaults:
+    - model_client_config:
+        api_base: http://defaults
+        api_key: sk-def
+        model_name: m-def
+""")
+    out = llm_client.load_llm_config(cfg)
+    assert out["model_name"] == "m-ai"
+    assert out["api_base"] == "http://ai"
+    assert out["api_key"] == "sk-ai"
+
+
+def test_config_priority_react_over_defaults(tmp_path):
+    cfg = _write_cfg(tmp_path, """
+react:
+  model_name: m-react
+  model_client_config:
+    api_base: http://react
+    api_key: sk-react
+models:
+  defaults:
+    - model_client_config:
+        api_base: http://defaults
+        api_key: sk-def
+        model_name: m-def
+""")
+    out = llm_client.load_llm_config(cfg)
+    assert out["model_name"] == "m-react"
+    assert out["api_base"] == "http://react"
+
+
+def test_config_react_without_client_config_falls_to_defaults(tmp_path):
+    """react 段只有 model_name（env 占位符）无 model_client_config → 落到 models.defaults。
+
+    当前真实 config 形态：react.model_name=${MODEL_NAME} 未展开且无连接配置，
+    直接进 react 分支会拿到空配置错过真实凭据。
+    """
+    cfg = _write_cfg(tmp_path, """
+react:
+  model_name: ${MODEL_NAME}
+models:
+  defaults:
+    - model_client_config:
+        api_base: http://real
+        api_key: sk-real
+        model_name: m-real
+""")
+    out = llm_client.load_llm_config(cfg)
+    assert out["model_name"] == "m-real"
+    assert out["api_key"] == "sk-real"
+
+
+def test_config_fallback_to_models_defaults(tmp_path):
+    """当前真实配置形态（config.yaml models.defaults）——方案 §2.2 的关键差异点。"""
+    cfg = _write_cfg(tmp_path, """
+models:
+  defaults:
+    - model_client_config:
+        api_base: http://113.x:8080/v1
+        api_key: sk-real
+        model_name: DeepSeek-Flash
+        client_provider: OpenAI
+        verify_ssl: true
+      is_default: true
+""")
+    out = llm_client.load_llm_config(cfg)
+    assert out["model_name"] == "DeepSeek-Flash"
+    assert out["api_base"] == "http://113.x:8080/v1"
+    assert out["api_key"] == "sk-real"
+    assert out["verify_ssl"] is True
+
+
+def test_config_missing_file_returns_defaults(tmp_path):
+    out = llm_client.load_llm_config(str(tmp_path / "nope.yaml"))
+    assert out["api_key"] == ""
+    assert out["model_name"] == "glm-4.7"
+
+
+def test_config_empty_yaml_returns_defaults(tmp_path):
+    cfg = _write_cfg(tmp_path, "")
+    out = llm_client.load_llm_config(cfg)
+    assert out["api_key"] == ""
+
+
+def test_config_resolves_env_placeholders(tmp_path, monkeypatch):
+    """发布模板形态：config 存 ${VAR} 占位符，真值在 config/.env（os.environ）。"""
+    monkeypatch.setenv("DW_TEST_MODEL_NAME", "m-env")
+    monkeypatch.setenv("DW_TEST_API_BASE", "http://env/")
+    monkeypatch.setenv("DW_TEST_API_KEY", "sk-env")
+    cfg = _write_cfg(tmp_path, """
+models:
+  defaults:
+    - model_client_config:
+        model_name: ${DW_TEST_MODEL_NAME}
+        api_base: ${DW_TEST_API_BASE}
+        api_key: ${DW_TEST_API_KEY}
+""")
+    out = llm_client.load_llm_config(cfg)
+    assert out["model_name"] == "m-env"
+    assert out["api_base"] == "http://env/"
+    assert out["api_key"] == "sk-env"
+
+
+def test_config_defaults_prefers_is_default_entry(tmp_path):
+    """对话主模型 = is_default=True 条目，不一定是列表首位。"""
+    cfg = _write_cfg(tmp_path, """
+models:
+  defaults:
+    - model_client_config:
+        model_name: m-first
+        api_base: http://first
+        api_key: sk-first
+    - model_client_config:
+        model_name: m-default
+        api_base: http://default
+        api_key: sk-default
+      is_default: true
+""")
+    out = llm_client.load_llm_config(cfg)
+    assert out["model_name"] == "m-default"
+    assert out["api_key"] == "sk-default"
+
+
+# --------------------------------------------------------------------------
+# call_llm 降级契约
+# --------------------------------------------------------------------------
+def test_call_llm_sync_returns_empty_on_exception(monkeypatch):
+    """LLM 调用抛异常 → 空串，不向上抛（调用方判空降级）。"""
+    class _Boom:
+        async def call(self, *a, **kw):
+            raise RuntimeError("api unreachable")
+
+        def __init__(self, config_path=None):
+            pass
+
+    monkeypatch.setattr(llm_client, "_LLMClient", _Boom)
+    monkeypatch.setattr(llm_client, "_CLIENT", None)
+    monkeypatch.setattr(llm_client, "LLM_AVAILABLE", True)
+    out = llm_client.call_llm_sync("sys", "user", timeout_s=2)
+    assert out == ""
+
+
+def test_call_llm_sync_timeout(monkeypatch):
+    """超过 timeout_s → 空串（wait_for 取消）。"""
+
+    class _Slow:
+        def __init__(self, config_path=None):
+            pass
+
+        async def call(self, *a, **kw):
+            await asyncio.sleep(10)
+            return "never"
+
+    monkeypatch.setattr(llm_client, "_LLMClient", _Slow)
+    monkeypatch.setattr(llm_client, "_CLIENT", None)
+    monkeypatch.setattr(llm_client, "LLM_AVAILABLE", True)
+    out = llm_client.call_llm_sync("sys", "user", timeout_s=1)
+    assert out == ""
+
+
+def test_client_uses_private_http_pool(monkeypatch):
+    """ModelClientConfig 须显式 use_shared_llm_http_client=False。
+
+    openjiuwen 默认共享 httpx 池绑定首个事件循环；同进程 finding_review 的
+    asyncio.run（并发 gather）关闭 loop 后共享池失效，本模块后续在新 loop
+    上的调用报 Connection error（run_pipeline 真实端到端实测复现）。
+    """
+
+    class _FakeModel:
+        def __init__(self, model_client_config=None, model_config=None):
+            # 捕获真实 ModelClientConfig 实例供断言
+            test_client_uses_private_http_pool.captured = model_client_config
+
+    if not llm_client.LLM_AVAILABLE:
+        pytest.skip("openjiuwen 未安装")
+    monkeypatch.setattr(llm_client, "Model", _FakeModel)
+    monkeypatch.setattr(llm_client, "LLM_AVAILABLE", True)
+    client = llm_client._LLMClient.__new__(llm_client._LLMClient)
+    client.config = {"model_name": "m", "api_base": "http://x",
+                     "api_key": "sk", "verify_ssl": True}
+    client._model = None
+    client._get_model()
+    captured = test_client_uses_private_http_pool.captured
+    assert captured is not None
+    assert captured.use_shared_llm_http_client is False
+    assert captured.api_base == "http://x"
