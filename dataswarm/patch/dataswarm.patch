+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/api.py —— 指标语义层 HTTP API handler（纯 V2）。
+
+路由前缀: /api/dataagent/metrics（经 dataagent/api.py 委托）。
+旧 v1 路由（dw_bi_* 表口径）已随旧指标体系退役（2026-10-10），
+全部业务路径在 /metrics/v2/ 子命名空间（api_v2）；
+落在前缀内但不属于 V2 的路径一律 404 并提示迁移。
+"""
+from __future__ import annotations
+
+from . import api_v2
+
+_PREFIX = "/api/dataagent/metrics"
+
+_RETIRE_DETAIL = "v1 指标路由已退役，请使用 /api/dataagent/metrics/v2/"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def handle_get(handler, parsed) -> None:
+    if api_v2.is_v2(parsed.path):
+        api_v2.handle_get(handler, parsed)
+        return
+    handler._write_json(404, {"error": "not_found", "detail": _RETIRE_DETAIL})
+
+
+def handle_post(handler, parsed) -> None:
+    if api_v2.is_v2(parsed.path):
+        api_v2.handle_post(handler, parsed)
+        return
+    handler._write_json(404, {"error": "not_found", "detail": _RETIRE_DETAIL})
