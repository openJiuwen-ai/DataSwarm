@@ -0,0 +1,89 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  bfs,
+  buildDownstreamMap,
+  buildUpstreamMap,
+  computeLineageLayout,
+} from '../node_modules/.cache/shared-lineage/lineageLayout.mjs';
+
+test('warehouse layers run left to right and tables in one layer occupy separate rows', () => {
+  const { positions } = computeLineageLayout(
+    [
+      { table: 'daily_report', layer: 'ADS' },
+      { table: 'orders', layer: 'ODS' },
+      { table: 'items', layer: 'ODS' },
+      { table: 'order_detail', layer: 'DWD' },
+      { table: 'daily_sales', layer: 'DWS' },
+    ],
+    [],
+  );
+  const layers = ['orders', 'order_detail', 'daily_sales', 'daily_report'];
+  for (let index = 1; index < layers.length; index++) {
+    assert.ok(positions.get(layers[index]).x - positions.get(layers[index - 1]).x >= 380);
+  }
+  assert.equal(positions.get('orders').x, positions.get('items').x);
+  assert.ok(Math.abs(positions.get('orders').y - positions.get('items').y) > 100);
+});
+
+test('governance source and additional layers each receive a distinct column', () => {
+  const { positions } = computeLineageLayout(
+    [
+      { table: 'source', layer: 'SOURCE' },
+      { table: 'orders', layer: 'ODS' },
+      { table: 'registry', layer: 'META' },
+      { table: 'unclassified' },
+      { table: '__proto__', layer: 'CUSTOM' },
+    ],
+    [],
+  );
+  assert.ok(positions.get('source').x < positions.get('orders').x);
+  assert.equal(new Set([...positions.values()].map(({ x }) => x)).size, 5);
+});
+
+test('trace terminates on cycles, excludes unrelated tables and accepts arbitrary table identifiers', () => {
+  const edges = [
+    { from: '__proto__', to: 'orders' },
+    { from: 'orders', to: 'daily_sales' },
+    { from: 'daily_sales', to: 'orders' },
+    { from: 'daily_sales', to: 'daily_sales' },
+    { from: 'unrelated', to: 'separate_report' },
+  ];
+  assert.deepEqual(bfs('orders', buildDownstreamMap(edges)), new Set(['orders', 'daily_sales']));
+  assert.deepEqual(bfs('orders', buildUpstreamMap(edges)), new Set(['orders', '__proto__', 'daily_sales']));
+});
+
+test('barycenter ordering uncrosses edges between adjacent layers', () => {
+  // 输入顺序刻意交叉：a(上)→y、b(下)→x，期望重排后 y 在 x 上方，连线不交叉
+  const { positions } = computeLineageLayout(
+    [
+      { table: 'a', layer: 'ODS' },
+      { table: 'b', layer: 'ODS' },
+      { table: 'x', layer: 'DWD' },
+      { table: 'y', layer: 'DWD' },
+    ],
+    [
+      { from: 'a', to: 'y' },
+      { from: 'b', to: 'x' },
+    ],
+  );
+  assert.ok(positions.get('y').y < positions.get('x').y);
+});
+
+test('layout returns positions only; edge shapes are left to ReactFlow bezier', () => {
+  const { positions } = computeLineageLayout(
+    [
+      { table: 'src', layer: 'ODS' },
+      { table: 'mid', layer: 'DWD' },
+      { table: 'ad', layer: 'ADS' },
+    ],
+    [
+      { from: 'src', to: 'mid' },
+      { from: 'src', to: 'ad' },
+    ],
+  );
+  assert.equal(positions.size, 3);
+  for (const p of positions.values()) {
+    assert.ok(Number.isFinite(p.x) && Number.isFinite(p.y));
+  }
+});
