+        "已验的是 oss 适配器在 S3 兼容服务上的完整路径。**未验阿里云 OSS 本身**："
+        "其 S3 兼容端点的签名细节、分片上传、Bucket 策略。需真 OSS 账号复验。")
+
+# ======================================================================
+print("\n########## hologres —— 指向真实 PostgreSQL（PG 线协议族复用）##########")
+
+
+def holo_real_connection_over_pg_wire():
+    adapter = R.get_source_type("hologres")
+    adapter.validate(HOLO_CONFIG)
+    ok = adapter.test_connection(HOLO_CONFIG)
+    assert ok.get("ok") is True, f"hologres 类型应能连通 PG 线协议: {ok}"
+    bad = adapter.test_connection({**HOLO_CONFIG, "database": "no_such_db"})
+    assert bad.get("ok") is False, bad
+    return f"hologres 类型经 PG 线协议真实连通（{ok.get('message','')[:40]}）"
+
+
+def holo_catalog_schema():
+    conn = connector_for("hologres", HOLO_CONFIG, source_id="holo")
+    datasets = dataset_names(conn.catalog())
+    assert "fact_orders" in datasets, datasets
+    sch = conn.schema("fact_orders")
+    by = {c["name"]: c for c in sch["columns"]}
+    assert len(by) == 7, list(by)
+    assert sch["primary_key"] == ["order_id"], sch["primary_key"]
+    assert by["channel_name"]["comment"] == "下单渠道", by["channel_name"]
+    # 复用 PostgreSQL 协议时仍须过滤系统 schema。
+    schema_names = {s["name"] for s in conn.catalog()["schemas"]}
+    assert not (schema_names & {"information_schema", "pg_catalog"}), schema_names
+    return "7 列、主键与注释均正确；系统 schema 未混入"
+
+
+def holo_gate_c():
+    conn = connector_for("hologres", HOLO_CONFIG, source_id="holo-c")
+    answers = run_five(conn, "fact_orders", QUESTIONS_PG)
+    assert_baseline(answers, "hologres")
+    return "5 道题经 hologres 类型在真实 PG 上执行，与基准逐值一致"
+
+
+def holo_family_and_guards():
+    assert dr.sqlglot_dialect("hologres") == "postgres"
+    assert R.get_source_type("hologres").default_port == 80
+    ref = R.get_source_type("hologres").build_ref({**HOLO_CONFIG, "port": 80})
+    spec = dbc.parse_db_ref(ref)
+    assert spec["type"] == "hologres" and spec["port"] == 80, spec
+    conn = connector_for("hologres", HOLO_CONFIG, source_id="holo-g")
+    for sql in ('INSERT INTO "fact_orders" VALUES (1)', 'DROP TABLE "fact_orders"'):
+        expect_query_rejected(conn, sql, sql[:22])
+    expect_query_rejected(conn, 'SELECT `c` FROM "fact_orders"', "反引号在 PG 方言下")
+    return "方言=postgres、默认端口 80、ref 往返无损；写操作与反引号被拒"
+
+
+check("H-A", "经 PG 线协议真实连通", holo_real_connection_over_pg_wire)
+check("H-B", "catalog / schema", holo_catalog_schema)
+check("H-C", "门 C：5 道分析题", holo_gate_c)
+check("H-D", "族内复用与护栏", holo_family_and_guards)
+
+blocked("H-E", "Hologres 专有行为",
+        "已验的是 hologres 类型走 PG 线协议的完整链路——这恰好是该类型的全部实现"
+        "（它只声明端口与文案）。**未验 Hologres 专有部分**：AccessKey 认证、"
+        "其列存目录差异、实例规格相关行为。需真 Hologres 实例复验。")
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细（各自的真连边界，不是代码缺陷）：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\ns3 / oss / hologres 均已真连并过门 C（边界见上方阻断项）")
