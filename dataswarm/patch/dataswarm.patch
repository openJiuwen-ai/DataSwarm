+# @file workspace-id 解析链（env > argparse 嵌套 default 陷阱回归）
+# --------------------------------------------------------------------------
+class TestWorkspaceIdChain:
+    """全局 --workspace-id 从 env JIUWENSWARM_WORKSPACE_ID 取 default；
+    子命令级同名参数必须用 SUPPRESS，否则 default=None 会覆盖全局解析值
+    （bash 注入的 env 永远到不了 _emit._workspace_id）。"""
+
+    def _parse(self, argv, monkeypatch, env_value="default"):
+        if env_value is None:
+            monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+        else:
+            monkeypatch.setenv("JIUWENSWARM_WORKSPACE_ID", env_value)
+        return dwcli._build_parser().parse_args(argv)
+
+    def test_env_reaches_noarg_invocation(self, monkeypatch):
+        args = self._parse(["datasource", "current"], monkeypatch)
+        assert args.workspace_id == "default"
+
+    def test_env_absent_yields_empty(self, monkeypatch):
+        args = self._parse(["datasource", "current"], monkeypatch, env_value=None)
+        assert args.workspace_id == ""
+
+    def test_action_level_arg_overrides_env(self, monkeypatch):
+        args = self._parse(["datasource", "current", "--workspace-id", "bank"], monkeypatch)
+        assert args.workspace_id == "bank"
+
+    def test_group_level_arg_overrides_env(self, monkeypatch):
+        args = self._parse(["datasource", "--workspace-id", "bank", "current"], monkeypatch)
+        assert args.workspace_id == "bank"
+
+    def test_global_arg_overrides_env(self, monkeypatch):
+        args = self._parse(["--workspace-id", "bank", "datasource", "current"], monkeypatch)
+        assert args.workspace_id == "bank"
