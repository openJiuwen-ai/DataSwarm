+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Remote size/mtime cannot identify bytes across credentials or workspaces."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors import staged_connector as sc
+from jiuwenswarm.channels.web.dataagent.connectors.base import SourceDefinition
+from jiuwenswarm.common import db_connector as dbc, workspace_context as wc
+
+
+BASE = {"protocol": "sftp", "host": "same-host", "port": 22, "user": "a",
+        "password": "private-a", "path": "/*.csv", "format": "csv", "table_name": "orders"}
+
+
+@pytest.fixture
+def remote(monkeypatch, tmp_path):
+    monkeypatch.setenv("JIUWENSWARM_STAGED_CACHE", str(tmp_path / "cache"))
+    monkeypatch.delenv("JIUWENSWARM_DATASOURCE_DB", raising=False)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    token = wc._current_workspace_id.set(None)
+    state = {"content": b"v\n1\n", "downloads": 0}
+
+    class Fetcher(sc.RemoteFetcher):
+        def __init__(self, config):
+            pass
+
+        def list_files(self, pattern):
+            return [("/orders.csv", 4, 1700000000.0)]
+
+        def download(self, name, target):
+            state["downloads"] += 1
+            target.write_bytes(state["content"])
+
+    monkeypatch.setitem(sc._FETCHERS, "sftp", Fetcher)
+    yield state
+    wc.reset(token)
+
+
+def total(config, *, governance=False):
+    if governance:
+        conn = dbc._duckdb_connector({
+            "type": "duckdb", "source_type": "ftp", "location": "sftp://same-host:22/*.csv",
+            "table_name": "orders", "_source_config": config,
+        })
+    else:
+        conn = sc.StagedFileConnector(SourceDefinition("same-source", "ftp", "orders", "staged", config))
+    try:
+        result = conn.query("SELECT SUM(v) FROM orders")
+        return result["rows"], conn.stage()
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize("change", [
+    {"user": "b"}, {"password": "private-b"}, {"host": "other-host"}, {"port": 2222},
+    {"host_key_sha256": "different-trusted-pin"}, {"known_hosts": "different-trust-file"},
+])
+@pytest.mark.parametrize("governance", [False, True])
+def test_changed_connection_identity_cannot_reuse_same_remote_fingerprint(remote, change, governance):
+    first, first_report = total(dict(BASE), governance=governance)
+    remote["content"] = b"v\n9\n"
+    second, second_report = total({**BASE, **change}, governance=governance)
+    assert first == [[1]]
+    assert second == [[9]]
+    assert first_report["cache_dir"] != second_report["cache_dir"]
+    assert remote["downloads"] == 2
+    assert "private-" not in str(second_report)
+
+
+def test_identical_config_order_reuses_cache(remote):
+    first, first_report = total(dict(BASE))
+    second, second_report = total(dict(reversed(list(BASE.items()))))
+    assert first == second == [[1]]
+    assert first_report["cache_dir"] == second_report["cache_dir"]
+    assert remote["downloads"] == 1
+    assert second_report["skipped"] == 1
+
+
+@pytest.mark.parametrize("variable", ["JIUWENSWARM_WORKSPACE_ID", "JIUWENSWARM_DATASOURCE_DB", "JIUWENSWARM_ORCH_DB"])
+def test_same_source_and_config_cannot_cross_explicit_scope(remote, monkeypatch, variable):
+    monkeypatch.setattr(wc, "metadata_db_ref", lambda _: "sqlite://shared-metadata")
+    monkeypatch.setenv(variable, "scope-a")
+    first, first_report = total(dict(BASE), governance=True)
+    remote["content"] = b"v\n9\n"
+    monkeypatch.setenv(variable, "scope-b")
+    second, second_report = total(dict(BASE), governance=True)
+    assert first == [[1]] and second == [[9]]
+    assert first_report["cache_dir"] != second_report["cache_dir"]
+
+
+def test_replaced_known_hosts_contents_invalidate_same_path(remote, tmp_path):
+    hosts = tmp_path / "known_hosts"
+    hosts.write_text("old trusted host key")
+    config = {**BASE, "known_hosts": str(hosts)}
+    first, first_report = total(config)
+    hosts.write_text("new trusted host key")
+    remote["content"] = b"v\n9\n"
+    second, second_report = total(config)
+    assert first == [[1]] and second == [[9]]
+    assert first_report["cache_dir"] != second_report["cache_dir"]
+    assert all(Path(p).parent.name.isalnum() for p in second_report["files"])
+
+
+def test_environment_credentials_are_part_of_governance_cache_identity(remote, monkeypatch):
+    spec = {"type": "duckdb", "source_type": "ftp", "location": "sftp://same-host:22/*.csv", "table_name": "orders"}
+    rows = []
+    for user, content in [("a", b"v\n1\n"), ("b", b"v\n9\n")]:
+        monkeypatch.setenv("SFTP_USER", user)
+        monkeypatch.setenv("SFTP_PASSWORD", "private-" + user)
+        remote["content"] = content
+        conn = dbc._duckdb_connector(spec)
+        try:
+            rows.append(conn.query("SELECT SUM(v) FROM orders")["rows"])
+        finally:
+            conn.close()
+    assert rows == [[[1]], [[9]]]
+    assert remote["downloads"] == 2
