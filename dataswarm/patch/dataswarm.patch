+def list_documents() -> list[dict]:
+    """文档列表行 + 摘要字段（证据片段数/抽取状态），供前端文档管理表格直接消费。"""
+    store._ensure()
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT version_id,document_id,source_id,name,sha256,"
+                            "status,created_at,updated_at,payload_json "
+                            "FROM dw_knowledge_documents WHERE workspace_id=? ORDER BY created_at DESC",
+                            (store._workspace(),))
+    finally:
+        conn.close()
+    out = []
+    for row in rows:
+        try:
+            payload = json.loads(row.pop("payload_json") or "{}")
+        except (TypeError, ValueError):
+            payload = {}
+        quality = payload.get("quality") or {}
+        extraction = payload.get("extraction") or {}
+        row["path"] = str((payload.get("source") or {}).get("path") or "")
+        row["chunk_count"] = quality.get("chunk_count")
+        row["character_count"] = quality.get("character_count")
