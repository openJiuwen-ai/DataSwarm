@@ -0,0 +1,61 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Unit tests for jiuwenswarm-start stream encoding fallback (GBK pipes).
+
+Windows 管道/重定向下 stdout 编码取 locale（中文系统 cp936），启动 banner 的
+✓(U+2713) 等字符无法编码，logging 吞成 ``--- Logging error ---`` 后端口信息
+整行丢失。CLI 入口须对流加 ``errors=backslashreplace`` 兜底（不改 encoding，
+GBK 场景中文照常、无法编码字符退化为 ``\\uXXXX`` 转义）。
+"""
+
+from __future__ import annotations
+
+import io
+
+import pytest
+
+from jiuwenswarm.start_services import _apply_stream_encoding_fallback
+
+
+def _gbk_stream() -> io.TextIOWrapper:
+    """模拟 Windows 中文系统管道下的 stdout：GBK 编码、默认 strict 错误处理。"""
+    return io.TextIOWrapper(io.BytesIO(), encoding="gbk")
+
+
+def test_fallback_reconfigures_gbk_stream(monkeypatch: pytest.MonkeyPatch):
+    """GBK 流经兜底后，banner 的 ✓ 不再抛 UnicodeEncodeError（修复前必抛）。"""
+    stream = _gbk_stream()
+    monkeypatch.setattr("sys.stdout", stream)
+    monkeypatch.setattr("sys.stderr", _gbk_stream())
+
+    _apply_stream_encoding_fallback()
+
+    assert stream.errors == "backslashreplace"
+    stream.write("✓ Web UI  http://localhost:5173\n")
+    stream.flush()
+    out = stream.buffer.getvalue().decode("gbk")
+    assert "\\u2713 Web UI  http://localhost:5173" in out
+
+
+def test_fallback_keeps_utf8_stream_encoding(monkeypatch: pytest.MonkeyPatch):
+    """UTF-8 流只加错误兜底，encoding 不被动（终端/UTF-8 模式行为不变）。"""
+    stream = io.TextIOWrapper(io.BytesIO(), encoding="utf-8")
+    monkeypatch.setattr("sys.stdout", stream)
+    monkeypatch.setattr("sys.stderr", io.TextIOWrapper(io.BytesIO(), encoding="utf-8"))
+
+    _apply_stream_encoding_fallback()
+
+    assert stream.encoding == "utf-8"
+    assert stream.errors == "backslashreplace"
+
+
+def test_fallback_skips_streams_without_reconfigure(monkeypatch: pytest.MonkeyPatch):
+    """非 TextIOWrapper 的流（pytest capture / 嵌入式 stdout）静默跳过。"""
+
+    class _PlainStream:
+        pass
+
+    monkeypatch.setattr("sys.stdout", _PlainStream())
+    monkeypatch.setattr("sys.stderr", _PlainStream())
+
+    _apply_stream_encoding_fallback()  # 不应抛 AttributeError
