+def _authorized_source(source_id: str, workspace_id: str) -> dict | None:
+    """Allow local sources, or a remote registration explicitly bound as business.
+
+    Cross-workspace lookup is useful after binding, but knowledge of a source
+    ID alone must not grant access to its saved credentials and business data.
+    Lookup/validation failures intentionally disclose neither refs nor secrets.
+    """
+    try:
+        source = datasource_store.find_local_source(source_id, workspace_id=workspace_id or None)
+        if source:
+            return source
+        source = datasource_store.find_source(source_id, workspace_id=workspace_id or None)
+        if not source:
+            return None
+        context = workspace_context.resolve(workspace_id or None)
+        ref = str(source.get("db_ref") or "")
+        if not ref or not context.business_db_ref:
+            return None
+        allowed_ref = workspace_context.validate_ref_in_workspace(context.workspace_id, "business", ref)
+        # validate_ref_in_workspace also accepts the metadata database. Semantic
+        # collection of a remotely registered source requires the business bind.
+        if not workspace_context.same_physical_ref(allowed_ref, context.business_db_ref):
+            return None
+        return source
+    except Exception:
+        return None
