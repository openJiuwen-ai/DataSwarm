+def _instance_filter(ref_type: str | None, ref_id: str | None, trigger_type: str | None,
+                     q: str | None) -> tuple[str, list[str]]:
+    clauses = ["1=1"]
+    params = []
+    for column, value in (("ref_type", ref_type), ("ref_id", ref_id), ("trigger_type", trigger_type)):
+        if value:
+            clauses.append(f"i.{column}=?")
+            params.append(value)
+    if q:
+        pattern = _search_pattern(q)
+        clauses.append("""(LOWER(i.instance_id) LIKE LOWER(?) ESCAPE '!'
+            OR (i.ref_type='task' AND i.ref_id IN (SELECT task_id FROM dw_tasks
+                WHERE LOWER(name) LIKE LOWER(?) ESCAPE '!'))
+            OR (i.ref_type='workflow' AND i.ref_id IN (SELECT workflow_id FROM dw_workflows
+                WHERE LOWER(name) LIKE LOWER(?) ESCAPE '!')))""")
+        params.extend([pattern] * 3)
+    return " AND ".join(clauses), params
+
+
+def list_instances(ref_type: str | None = None, ref_id: str | None = None, trigger_type: str | None = None,
+                   limit: int = 100, offset: int = 0, *, q: str | None = None) -> list[dict]:
+    where, params = _instance_filter(ref_type, ref_id, trigger_type, q)
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, f"""SELECT i.*,
+            CASE WHEN i.ref_type='task' THEN t.name ELSE w.name END AS ref_name
+            FROM dw_task_instances i
+            LEFT JOIN dw_tasks t ON i.ref_type='task' AND t.task_id=i.ref_id
+            LEFT JOIN dw_workflows w ON i.ref_type='workflow' AND w.workflow_id=i.ref_id
+            WHERE {where}
+            ORDER BY i.created_at DESC, i.instance_id DESC LIMIT ? OFFSET ?""", tuple(params + [limit, offset]))
+    finally:
+        conn.close()
+
+
+def count_instances(ref_type: str | None = None, ref_id: str | None = None, trigger_type: str | None = None,
+                    *, q: str | None = None) -> int:
