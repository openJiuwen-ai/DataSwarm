+def b_build_ref_roundtrip():
+    for tid, cfg in (("parquet", FACT), ("json", FACT_JSON)):
+        ref = R.get_source_type(tid).build_ref(cfg)
+        assert ref.startswith("duckdb://"), f"{tid} build_ref 不是 duckdb ref: {ref}"
+        spec = dbc.parse_db_ref(ref)
+        assert spec["type"] == "duckdb", spec
+        assert spec["source_type"] == tid, spec
+    for tid, loc in (("s3", "s3://bkt/p/*.parquet"), ("oss", "oss://bkt/p/*.parquet")):
+        ref = R.get_source_type(tid).build_ref({"location": loc, "table_name": "t"})
+        spec = dbc.parse_db_ref(ref)
+        assert spec["source_type"] == tid, spec
+        assert spec["location"] == loc, f"{tid} location 往返失真: {spec['location']}"
+    return "4 种类型 build_ref -> parse_db_ref 往返无损"
