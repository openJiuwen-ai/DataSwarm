+        if own:
+            c.close()
+
+
+def delete_concept_maps_for_revision(revision_id: str, *, conn: Any = None) -> int:
+    """删除某修订的全部业务映射，返回删除行数（指标删除级联用）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_concept_map WHERE revision_id = ?", (revision_id,))
+            deleted = int(getattr(cursor, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
+# ==========================================================================
+# dw_metric_query_log —— 查询追溯
+# ==========================================================================
+def log_query(record: dict[str, Any], *, conn: Any = None) -> str:
+    """写一条查询追溯记录。成功与失败都要写。
+
+    Args:
+        record: 列名 → 值。缺 ``query_id`` / ``created_at`` 时自动补。
+        conn: 可选的既有连接。
+
+    Returns:
+        query_id。
+    """
+    query_id = record.get("query_id") or new_id("mq")
+    created_at = record.get("created_at") or _now()
+    columns = (
+        "query_id, workspace_id, session_id, question, query_spec_json, path, authoritative,"
+        " release_id, revision_ids_json, generated_sql, sql_params_json, dialect,"
+        " validation_json, executed, row_count, elapsed_ms, model_name, context_digest,"
+        " schema_snapshot_id, degraded_reason, feedback, error_code, error_message, created_at"
+    )
+    values = (
+        query_id, record.get("workspace_id") or "", record.get("session_id"),
+        record.get("question"), record.get("query_spec_json"), record.get("path"),
+        1 if record.get("authoritative", True) else 0, record.get("release_id"),
+        record.get("revision_ids_json"), record.get("generated_sql"),
+        record.get("sql_params_json"), record.get("dialect"), record.get("validation_json"),
+        1 if record.get("executed") else 0, record.get("row_count"), record.get("elapsed_ms"),
+        record.get("model_name"), record.get("context_digest"), record.get("schema_snapshot_id"),
+        record.get("degraded_reason"), record.get("feedback") or "none",
+        record.get("error_code"), record.get("error_message"), created_at,
+    )
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                f"INSERT INTO dw_metric_query_log ({columns})"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                values,
+            )
+            _commit_if_own(c, own)
+        return query_id
+    finally:
+        if own:
+            c.close()
+
+
+def list_queries(workspace_id: str, *, limit: int = 50, conn: Any = None) -> list[dict]:
+    """列出最近的查询追溯记录。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_query_log WHERE workspace_id = ?"
+            " ORDER BY created_at DESC LIMIT ?",
+            (workspace_id, int(limit)),
+        )
+    finally:
+        if own:
+            c.close()
+
+
+# ==========================================================================
+# 词法召回（指标身份 + 当前发布修订的关键词匹配）
+# ==========================================================================
+def search_defs(
+    workspace_id: str, query: str, *, limit: int = 20, conn: Any = None
+) -> list[tuple[MetricDef, float, str]]:
+    """按关键词召回指标，返回 (指标, 分数, 命中字段)。
+
+    打分权重：name > metric_key > 同义词 > 描述（沿旧 ``search_metrics``
+    的口径，作用于新表）。分值归一到 0~1。
+
+    Args:
+        workspace_id: 工作空间。
+        query: 自然语言问题或关键词。
+        limit: 返回上限。
+        conn: 可选的既有连接。
+
+    Returns:
+        ``(MetricDef, score, matched_on)`` 列表，按分数降序。
+    """
+    text = (query or "").strip()
+    if not text:
+        return []
+    terms = [t for t in _tokenize(text) if len(t) >= 2] or [text]
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c,
+            "SELECT d.*, r.display_name AS rev_display, r.synonyms AS rev_synonyms"
+            " FROM dw_metric_defs d"
+            " LEFT JOIN dw_metric_revisions r ON r.revision_id = d.current_revision_id"
+            " WHERE d.workspace_id = ?",
+            (workspace_id,),
+        )
+    finally:
+        if own:
+            c.close()
+    scored: list[tuple[MetricDef, float, str]] = []
+    for row in rows:
+        name = (row.get("rev_display") or row.get("name") or "").strip()
+        key = (row.get("metric_key") or "").strip()
+        synonyms = as_list(row.get("rev_synonyms"))
+        score = 0.0
+        matched = ""
+        for term in terms:
+            tl = term.lower()
+            if tl and tl in name.lower():
+                if score < 0.9:
+                    score, matched = 0.9, "name"
+            elif tl and tl in key.lower():
+                if score < 0.8:
+                    score, matched = 0.8, "metric_key"
+            elif any(tl in str(s).lower() for s in synonyms):
+                if score < 0.7:
+                    score, matched = 0.7, "synonym"
+        if score > 0:
+            row.pop("rev_display", None)
+            row.pop("rev_synonyms", None)
+            scored.append((_row_to_def(row), score, matched))
+    scored.sort(key=lambda item: (-item[1], item[0].metric_key))
+    return scored[:limit]
+
+
+def _tokenize(text: str) -> list[str]:
+    """粗分词：按空白与常见标点切，英文整词保留，中文按 2-gram。"""
+    import re
+
+    out: list[str] = []
+    for chunk in re.split(r"[\s,，。;；?？!！、/|]+", text):
+        if not chunk:
+            continue
+        if re.fullmatch(r"[A-Za-z0-9_.\-]+", chunk):
+            out.append(chunk)
+        else:
+            out.extend(chunk[i:i + 2] for i in range(len(chunk) - 1))
+    return out
+
+
+# ==========================================================================
+# dw_metric_verified_sql —— 经确认 SQL 的受限复用池
+# ==========================================================================
+def create_verified_sql(record: dict[str, Any], *, conn: Any = None) -> str:
+    """写入一条经确认的 SQL。
+
+    Args:
+        record: 列名 → 值。缺 ``verified_id`` / ``created_at`` 时自动补。
+
+    Returns:
+        verified_id。
+    """
+    verified_id = record.get("verified_id") or new_id("vsql")
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_verified_sql (verified_id, workspace_id,"
+                " revision_ids_json, query_spec_digest, sql_text, dialect, scope_json,"
+                " schema_snapshot_id, release_id, confirmed_by, confirmed_at, hit_count,"
+                " created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (verified_id, record.get("workspace_id") or "", record.get("revision_ids_json"),
+                 record.get("query_spec_digest"), record.get("sql_text"),
+                 record.get("dialect"), record.get("scope_json"),
+                 record.get("schema_snapshot_id"), record.get("release_id"),
+                 record.get("confirmed_by"), record.get("confirmed_at") or _now(),
+                 int(record.get("hit_count") or 0), record.get("created_at") or _now()),
+            )
+            _commit_if_own(c, own)
+        return verified_id
+    finally:
+        if own:
+            c.close()
+
+
+def find_verified_sql(
+    workspace_id: str, query_spec_digest: str, *, conn: Any = None
+) -> dict | None:
+    """按规格摘要找可复用的已确认 SQL。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_one_dict(
+            c,
+            "SELECT * FROM dw_metric_verified_sql WHERE workspace_id = ?"
+            " AND query_spec_digest = ? ORDER BY hit_count DESC",
+            (workspace_id, query_spec_digest),
+        )
+    finally:
+        if own:
+            c.close()
+
+
+def bump_verified_sql_hit(verified_id: str, *, conn: Any = None) -> None:
+    """复用命中计数 +1。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_verified_sql SET hit_count = hit_count + 1"
+                " WHERE verified_id = ?",
+                (verified_id,),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def list_verified_sql(workspace_id: str, *, limit: int = 20, conn: Any = None) -> list[dict]:
+    """列出已确认 SQL 池（few-shot 用，按命中数降序）。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_verified_sql WHERE workspace_id = ?"
+            " ORDER BY hit_count DESC, created_at DESC LIMIT ?",
+            (workspace_id, int(limit)),
+        )
+    finally:
+        if own:
+            c.close()
+
+
+def update_query_feedback(query_id: str, feedback: str, *, conn: Any = None) -> None:
+    """更新查询追溯行的反馈标记（none/verified/rejected）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_query_log SET feedback = ? WHERE query_id = ?",
+                (feedback, query_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def get_query(query_id: str, *, conn: Any = None) -> dict | None:
+    """按主键取查询追溯行。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_one_dict(
+            c, "SELECT * FROM dw_metric_query_log WHERE query_id = ?", (query_id,))
+    finally:
+        if own:
+            c.close()
+
+
+def has_verified_sql_for(
+    workspace_id: str, metric_keys: list[str], *, conn: Any = None
+) -> bool:
+    """该 workspace 是否有覆盖这些 metric_key 的已确认 SQL（候选打分的第三路）。"""
+    if not metric_keys:
+        return False
+    c, own = _conn_or(conn)
+    try:
+        for key in metric_keys:
+            # 按 scope_json 里的 metric_keys 查：池行钉的是 revision_ids，
+            # 对 revision_ids_json LIKE key 永远不命中（verified 通道曾因此静默死掉）
+            row = _fetch_one_dict(
+                c,
+                "SELECT verified_id FROM dw_metric_verified_sql WHERE workspace_id = ?"
+                " AND scope_json LIKE ? LIMIT 1",
+                (workspace_id, f"%{key}%"),
+            )
+            if row is not None:
+                return True
+        return False
+    finally:
+        if own:
+            c.close()
+
+
+# （dw_metric_schema_snapshots 注册表已随探查链路退役：深集成后 schema 锚点
+#  是 release manifest 的 semantic_refs（source_id + snapshot_id），真相源在
+#  dw_semantic_snapshots——不再有指标侧的 snapshot 注册行。）
