+# --------------------------------------------------------------------------
+# 工作空间与数据源解耦：未绑定业务库的工作空间（business_db_ref 可空）
+# --------------------------------------------------------------------------
+
+def _patch_store(monkeypatch, tmp_path, rows):
+    """把 workspace_store 的注册库指到 tmp_path，写入 rows。
+
+    手工建旧 5 列表（无 description）：list_workspaces 触发 _connect 幂等
+    ALTER 迁移，顺带覆盖存量库加列路径。
+    """
+    import sqlite3
+
+    from jiuwenswarm.common import workspace_store
+
+    registry = tmp_path / "workspaces.db"
+    connection = sqlite3.connect(registry)
+    connection.execute(
+        "CREATE TABLE dw_workspaces ("
+        "workspace_id TEXT PRIMARY KEY, name TEXT NOT NULL, "
+        "business_db_ref TEXT NOT NULL, metadata_db_ref TEXT NOT NULL, "
+        "created_at TEXT NOT NULL)"
+    )
+    for row in rows:
+        connection.execute(
+            "INSERT INTO dw_workspaces "
+            "(workspace_id, name, business_db_ref, metadata_db_ref, created_at) "
+            "VALUES (?, ?, ?, ?, ?)",
+            row,
+        )
+    connection.commit()
+    connection.close()
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: registry)
+    return workspace_store
