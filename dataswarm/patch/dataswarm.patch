+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** dashboard/types/dashboard.ts —— BI看板 TypeScript 类型。
+
+ * 旧指标域类型（MetricDef/MetricBinding 等 dw_bi_metrics 口径）已随旧指标体系
+ * 退役（2026-10-10）；指标定义/口径的类型在 features/metricsV2/api.ts。
+ * CardDef.metric_id 是卡片行的历史标签字段，仅展示用途，不再关联指标管理。
+ */
+
+export interface DimensionDef {
+  dimension_id: string;
+  name: string;
+  label: string | null;
+  description: string | null;
+  dim_type: 'time' | 'region' | 'category';
+  value_source: 'sql' | 'manual';
+  value_sql: string | null;
+  value_list: string[] | null;
+  datasource_ref: string | null;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface DashboardDef {
+  dashboard_id: string;
+  name: string;
+  description: string | null;
+  owner: string;
+  layout_json: Record<string, unknown>;
+  filter_defaults: DashboardFilters | null;
+  status: 'active' | 'archived';
+  source_type: 'manual' | 'dw-report' | 'ai-agent' | null;
+  source_ref: string | null;
+  cards?: CardDef[];
+  cards_count?: number;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface CardDef {
+  card_id: string;
+  dashboard_id: string;
+  metric_id: string | null;
+  title: string;
+  card_type: 'metric' | 'chart' | 'kpi';
+  chart_spec: ChartSpec | null;
+  echarts_option: Record<string, unknown> | null;
+  sql_query: string | null;
+  datasource_ref: string | null;
+  sparkline_sql: string | null;
+  grid_pos: GridPos;
+  display_format: string | null;
+  trend_direction: 'up' | 'down' | 'flat' | null;
+  order_index: number;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface ChartSpec {
+  type: 'line' | 'bar' | 'pie' | 'scatter' | 'heatmap';
+  x: string;
+  y: string | string[];
+  color?: string;
+}
+
+export interface GridPos {
+  row: number;
+  col: number;
+  w: number;
+  h: number;
+}
+
+export interface DashboardFilters {
+  time_range?: { start: string; end: string };
+  dimensions?: Record<string, string>;
+}
+
+export interface RenderedCard {
+  card_id: string;
+  title: string;
+  card_type: string;
+  metric_id: string | null;
+  grid_pos: GridPos;
+  echarts_option: Record<string, unknown> | null;
+  current_value?: number | null;
+  error?: string;
+}
+
+export interface RenderedDashboard {
+  dashboard_id: string;
+  name: string;
+  description: string | null;
+  layout_json: Record<string, unknown>;
+  filter_defaults: DashboardFilters | null;
+  cards: RenderedCard[];
+}
+
+export type DimensionInput = Partial<Omit<DimensionDef, 'dimension_id' | 'created_at' | 'updated_at'>>;
+export type DashboardInput = Partial<Omit<DashboardDef, 'dashboard_id' | 'created_at' | 'updated_at' | 'cards' | 'cards_count'>>;
+export type CardInput = Partial<Omit<CardDef, 'card_id' | 'dashboard_id' | 'created_at' | 'updated_at'>>;
+
+/** 业务术语（dw_ontology_terms，glossary P0：术语 CRUD + 双投影同步） */
+export interface TermDef {
+  term_id: string;
+  name: string;
+  definition: string;
+  /** 别名 JSON 数组字符串（后端兼容逗号分隔输入） */
+  synonyms: string;
+  /** 解析后的别名列表（列表/详情响应附带） */
+  synonyms_list?: string[];
+  status: 'active' | 'deprecated';
+  owner: string;
+  source: string;
+  tags: string;
+  fingerprint: string;
+  created_at: string;
+  updated_at: string;
+  /** 详情接口附带：向量投影条数（0 且未配置 embedding 时属正常） */
+  vector_count?: number;
+}
+
+export type TermInput = Partial<Pick<TermDef, 'name' | 'definition' | 'owner' | 'tags'>> & {
+  /** 逗号分隔字符串或数组，后端 parse_synonyms 归一 */
+  synonyms?: string | string[];
+};
