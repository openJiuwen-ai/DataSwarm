+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""judge 键归一化与 pairs 匹配的回归测试（F-055：olist-34 周键格式假失配）。"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+EVAL_SCRIPTS = Path(__file__).resolve().parents[3] / ".claude/skills/dw-analysis-eval/scripts"
+if str(EVAL_SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(EVAL_SCRIPTS))
+
+from judge import Verdict, _check_pairs, _norm_key  # noqa: E402
+
+
+def test_norm_key_week_formats_align_with_yearweek():
+    """周键统一为 YEARWEEK 形态：模型 DATE_FORMAT %x-%v 与真值 YEARWEEK 互异不再失配。"""
+    assert _norm_key("2017-31") == "201731"
+    assert _norm_key("2017-W31") == "201731"
+    assert _norm_key("2017-w05") == "201705"
+    assert _norm_key("2017-53") == "201753"
+    # 边界：1-12 段的 YYYY-NN 是月键形态，保留原样（歧义无解，双侧同格式生成）
+    assert _norm_key("2017-08") == "2017-08"
+    assert _norm_key("2017-12") == "2017-12"
+    # 纯数字周键（YEARWEEK 真值侧）保持
+    assert _norm_key("201731") == "201731"
+
+
+def test_check_pairs_matches_across_week_key_format():
+    """CSV 产出 ISO 周键（2017-31）与真值 YEARWEEK 键（201731）应全量对上（olist-34 形态）。"""
+    tables = [[["time_bucket", "olist_gmv"],
+               ["2017-31", "122194.48"], ["2017-32", "147384.17"], ["2017-33", "146093.54"]]]
+    truth = {"201731": "122194.48", "201732": "147384.17", "201733": "146093.54"}
+    verdict = Verdict()
+    best = _check_pairs(verdict, tables, truth, tolerance="exact",
+                        hints=[], ordered=False, top1=False, key_join="|")
+    assert not verdict.failures, verdict.failures
+    assert best["overlap"] == 3
+
+
+def test_check_pairs_normalizes_truth_side_keys_too():
+    """真值侧周键带连字符、模型产出纯数字时同样对上（对称归一）。"""
+    tables = [[["wk", "v"], ["201731", "10.5"], ["201732", "20.25"]]]
+    truth = {"2017-31": "10.5", "2017-32": "20.25"}
+    verdict = Verdict()
+    _check_pairs(verdict, tables, truth, tolerance="exact",
+                 hints=[], ordered=False, top1=False, key_join="|")
+    assert not verdict.failures, verdict.failures
+
+
+def test_check_pairs_month_keys_unaffected():
+    """月键（2017-08）归一化不得误伤：键值原样比对（olist-06 c1 形态）。"""
+    tables = [[["customer_state", "time_bucket", "olist_gmv"],
+               ["MG", "2017-08", "69672.58"]]]
+    truth = {"MG": "69672.58"}
+    verdict = Verdict()
+    best = _check_pairs(verdict, tables, truth, tolerance="exact",
+                        hints=[], ordered=False, top1=False, key_join="|")
+    assert not verdict.failures, verdict.failures
+    assert best["overlap"] == 1
+
+
+def test_check_pairs_week_start_dates_match_isoyearweek_truth():
+    """模型输出周起始日期（2017-07-31）、真值 ISO 周号（201731）应全量对上
+    （F-062：run-20261022-1138 olist-36-payment-caliber 键形假失配）。"""
+    tables = [[["week_start", "payment_total"],
+               ["2017-07-31", "122194.48"], ["2017-08-07", "147384.17"],
+               ["2017-08-14", "146093.54"]]]
+    truth = {"201731": "122194.48", "201732": "147384.17", "201733": "146093.54"}
+    verdict = Verdict()
+    best = _check_pairs(verdict, tables, truth, tolerance="exact",
+                        hints=[], ordered=False, top1=False, key_join="|")
+    assert not verdict.failures, verdict.failures
+    assert best["overlap"] == 0  # 原生键零交集，走日期→ISO 周兜底放行
+
+
+def test_check_pairs_daily_keys_not_forced_to_weeks_when_truth_is_dates():
+    """日粒度键 + 日粒度真值：正常原样匹配，日期→周兜底不得介入。"""
+    tables = [[["dt", "orders"], ["2017-08-01", "100"], ["2017-08-02", "120"]]]
+    truth = {"2017-08-01": "100", "2017-08-02": "120"}
+    verdict = Verdict()
+    best = _check_pairs(verdict, tables, truth, tolerance="exact",
+                        hints=[], ordered=False, top1=False, key_join="|")
+    assert not verdict.failures, verdict.failures
+    assert best["overlap"] == 2
+
+
+def test_check_pairs_week_date_fallback_requires_full_value_match():
+    """日期→周兜底不放松数值：任一键值不符仍判失败。"""
+    tables = [[["week_start", "payment_total"],
+               ["2017-07-31", "122194.48"], ["2017-08-07", "999.99"]]]
+    truth = {"201731": "122194.48", "201732": "147384.17"}
+    verdict = Verdict()
+    _check_pairs(verdict, tables, truth, tolerance="exact",
+                 hints=[], ordered=False, top1=False, key_join="|")
+    assert verdict.failures, "值不符时兜底不得放行"
