+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis_flow 探索轮上限单测（optional ≤1 / required ≤3）。
+
+run-20261020-2131 实证：SKILL.md「required 探索 ≤3 轮、optional 探索 ≤1 轮」
+与服务端 budget cap（max_explore_rounds_optional: 1）早已定契，但运行时只有
+flat MAX_EXPLORE_ROUNDS=3——nw-19 c3/c5、olist-35 c3/c4 的 optional 侧面探索
+2 轮从未被拦。修复引入 _explore_round_limit 按成分 required 取上限。
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+_FLOW = (Path(__file__).resolve().parents[3]
+         / "jiuwenswarm/resources/agent/workspace/skills/dw-analysis/scripts/analysis_flow.py")
+sys.path.insert(0, str(_FLOW.parent))
+import flow.budget as analysis_flow  # noqa: E402
+
+
+def test_open_optional_component_limit_one():
+    manifest = {"mode": "open"}
+    component = {"required": False, "explore_rounds": []}
+    assert analysis_flow._explore_round_limit(manifest, component) == 1
+
+
+def test_open_required_component_limit_three():
+    manifest = {"mode": "open"}
+    component = {"required": True, "explore_rounds": []}
+    assert analysis_flow._explore_round_limit(manifest, component) == 3
+
+
+def test_closed_mode_keeps_three():
+    manifest = {"mode": "closed"}
+    component = {"required": False, "explore_rounds": []}
+    assert analysis_flow._explore_round_limit(manifest, component) == 3
+
+
+def test_missing_required_defaults_to_three():
+    """运行时成分缺 required 键（closed 模式老账本）→ 默认按 required 处理。"""
+    manifest = {"mode": "open"}
+    component = {"explore_rounds": []}
+    assert analysis_flow._explore_round_limit(manifest, component) == 3
