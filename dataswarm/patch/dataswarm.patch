+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""schema_candidates —— 零 LLM schema 候选派生的测试。"""
+from __future__ import annotations
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.knowledge import store
+from jiuwenswarm.channels.web.dataagent.knowledge.publication import validate_publication
+from jiuwenswarm.channels.web.dataagent.knowledge.schema_candidates import derive_candidates
+
+
+def _prepare(monkeypatch, tmp_path):
+    db_path = tmp_path / "schema-candidates.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    # 指针形态 mysql://biz 需要 host 补全才能解析出库名（sanitize_ref 依赖 parse_db_ref）
+    monkeypatch.setenv("MYSQL_HOST", "secret-host")
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(f"sqlite://{db_path}")
+    monkeypatch.setattr(store, "_workspace", lambda: "ws-test")
+
+
+_TABLES = {
+    "orders": [
+        {"name": "order_id", "type": "BIGINT", "null": False, "pk": True},
+        {"name": "order_status", "type": "VARCHAR(32)", "null": True, "pk": False},
+        {"name": "customer_count", "type": "BIGINT", "null": True, "pk": False},
+        {"name": "refund_rate", "type": "DECIMAL(10,2)", "null": True, "pk": False},
+        {"name": "order_dt", "type": "VARCHAR(16)", "null": True, "pk": False},
+        {"name": "freight_value", "type": "DOUBLE", "null": True, "pk": False},
+        {"name": "product_id", "type": "VARCHAR(32)", "null": True, "pk": False},
+    ],
+}
+
+
+def _fake_db_connector(monkeypatch):
+    fake = SimpleNamespace(
+        tables=lambda _ref: {"tables": list(_TABLES)},
+        schema=lambda _ref, table: {"table": table, "columns": _TABLES.get(table, [])},
+    )
+    from jiuwenswarm.channels.web.dataagent import db as dataagent_db
+    monkeypatch.setattr(dataagent_db, "db_connector", fake)
+    return fake
+
+
+def test_schema_derivation_rules(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    _fake_db_connector(monkeypatch)
+    result = derive_candidates("mysql://biz", source_id="src-1")
+    assert result["ok"] and result["created_count"] == 2
+    by_title = {c["title"]: c for c in result["created"]}
+    # 文本列（非主键/技术列）→ 业务维度术语
+    assert by_title["order_status"]["asset_type"] == "term"
+    assert by_title["order_status"]["source"]["schema"]["rule"] == "dimension"
+    # 指标候选派生已关闭（2026-11-02）：数值列（比率/数量词）不再产出候选，
+    # 指标建模统一走指标系统
+    assert "customer_count" not in by_title and "refund_rate" not in by_title
+    # 时间词列 → 时间维度术语
+    assert by_title["order_dt"]["asset_type"] == "term"
+    assert by_title["order_dt"]["source"]["schema"]["rule"] == "time"
+    # 主键/技术列/无指标词的数值列（freight_value）一律不派生
+    assert "order_id" not in by_title and "product_id" not in by_title
+    assert "freight_value" not in by_title
+    # 溯源字段齐备且 db_ref 已脱敏：保留库名，绝不泄露 host/凭据
+    assert by_title["order_status"]["source"]["origin"] == "schema_auto"
+    sanitized = by_title["order_status"]["source"]["schema"]["db_ref"]
+    assert sanitized == "mysql:biz" and "secret-host" not in sanitized
+    assert by_title["order_status"]["scope"]["source_ids"] == ["src-1"]
+    assert by_title["order_status"]["scope"]["table_ids"] == ["orders"]
+
+
+def test_derivation_is_idempotent(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    _fake_db_connector(monkeypatch)
+    first = derive_candidates("mysql://biz")
+    second = derive_candidates("mysql://biz")
+    assert first["created_count"] == 2 and second["created_count"] == 0
+    assert second["skipped_existing"] == 2
+
+
+def test_schema_auto_publication_bypasses_document_evidence(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    _fake_db_connector(monkeypatch)
+    result = derive_candidates("mysql://biz")
+    term = next(c for c in result["created"] if c["asset_type"] == "term")
+    # 补上权威对齐后，schema_auto + schema 元数据齐全 → 无文档证据也能通过发布校验
+    # （若文档证据检查仍生效，这里会先抛 "evidence quote" 错误）
+    store.update_candidate(term["asset_id"], {"source": {**term["source"],
+                                                        "alignment_ref": "term:t1"}})
+    validate_publication(store.get_asset(term["asset_id"]))
+
+
+def test_schema_auto_without_schema_meta_is_rejected(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    broken = store.create_candidate({"asset_type": "term", "title": "ghost",
+                                     "content": "c", "scope": {},
+                                     "source": {"origin": "schema_auto", "schema": {}}})
+    with pytest.raises(ValueError, match="source table and column"):
+        validate_publication(broken)
+
+
+def test_document_evidence_still_required_without_schema_auto(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    plain = store.create_candidate({"asset_type": "rule", "title": "r", "content": "c",
+                                    "scope": {"metric_keys": ["m"]}, "source": {}})
+    with pytest.raises(ValueError, match="evidence quote"):
+        validate_publication(plain)
+
+
+def test_schema_auto_candidate_walks_review_flow(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    _fake_db_connector(monkeypatch)
+    result = derive_candidates("mysql://biz")
+    term = next(c for c in result["created"] if c["asset_type"] == "term")
+    # 挡掉权威投影的外部依赖（glossary/Semantica），只验证状态机与豁免链路
+    from jiuwenswarm.channels.web.dataagent.knowledge import publication
+    monkeypatch.setattr(publication, "publish_authority_asset",
+                        lambda asset: {"status": "aligned", "authority_ref": "term:t1"})
+    store.transition(term["asset_id"], "approve")
+    # term 发布仍需权威对齐（治理不变量不受 schema_auto 证据豁免影响）
+    with pytest.raises(ValueError, match="authority link"):
+        store.transition(term["asset_id"], "publish")
+    # update_candidate 会把 approved 退回 candidate（编辑需重新评审）→ 重新 approve
+    store.update_candidate(term["asset_id"], {"source": {**term["source"],
+                                                        "alignment_ref": "term:t1"}})
+    store.transition(term["asset_id"], "approve")
+    published = store.transition(term["asset_id"], "publish")
+    assert published["status"] == "published"
+
+
+def test_binding_trigger_glue(monkeypatch):
+    """service 绑定钩子：空 ref 不触发；正常 ref 提交知识派生任务且不因派生异常失败。"""
+    from jiuwenswarm.channels.web.dataagent.datasource import service as ds_service
+
+    assert ds_service._trigger_schema_derivation("", "src-1", "ws-1") == {"status": "not_applicable"}
+
+    def _boom(*_args, **_kwargs):
+        raise RuntimeError("derive failed")
+
+    # submit 在 knowledge 包内延迟导入：patch 模块属性即可
+    from jiuwenswarm.channels.web.dataagent.knowledge import schema_enrichment as se
+    monkeypatch.setattr(se, "submit", _boom)
+    result = ds_service._trigger_schema_derivation("mysql://biz", "src-1", "ws-1")
+    assert result["status"] == "trigger_failed"  # 派生异常不冒泡到绑定结果
+
+    calls: list[tuple] = []
+
+    def _capture(workspace_id, *, db_ref="", source_id=""):
+        calls.append((workspace_id, db_ref, source_id))
+        return {"status": "queued"}
+
+    monkeypatch.setattr(se, "submit", _capture)
+    assert ds_service._trigger_schema_derivation("mysql://biz", "src-1", "ws-1") == {"status": "queued"}
+    assert calls == [("ws-1", "mysql://biz", "src-1")]
