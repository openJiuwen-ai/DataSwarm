+    def create_task(self, data):
+        t = {"task_id": data.get("task_id", "t1"), **data, "status": "draft"}
+        self.tasks[t["task_id"]] = t
+        return t
+
+    def get_task(self, tid):
+        return self.tasks.get(tid)
