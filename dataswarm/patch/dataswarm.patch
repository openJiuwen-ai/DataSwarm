+                        "score": 0.9, "match_type": "like", "ambiguous": True}], []))
+
+    stub = _StubLLM(_spec_json(AOV))
+    monkeypatch.setattr(metrics_llm, "call_llm_sync", stub)
+    catalog = build_catalog("支付客单价", WORKSPACE)
+    result = parse_intent("支付客单价", catalog)
+
+    assert result.spec is not None
+    assert "[口径歧义] 含税销售额" in stub.calls[0]
+    assert "clarifications" in stub.calls[0]
+
+
+# ask() 双通路/兜底用例随 V2 ask 退场删除：主 Agent 直构 QuerySpec 走 query()
+# 权威通路（对齐 test_metrics_v2_api / test_metrics_v4_routing 的迁移）；
+# 受控探索由 service.explore 承接。
+
+
+# ==========================================================================
+# 反馈闭环 → verified_sql
+# ==========================================================================
+def test_feedback_verified_creates_reusable_sql(published, monkeypatch):
+    """verified 反馈把 compiler 成功 SQL 固化进复用池，且只对 compiler 通路生效。"""
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    # verified 只固化执行过的查询——直构 QuerySpec 走执行通路（ask 意图解析已退场）
+    from jiuwenswarm.channels.web.dataagent.metrics.model import QuerySpec
+    executed = service.query(QuerySpec.from_dict(json.loads(_spec_json(AOV))["spec"]), WORKSPACE)
+    query_id = executed.query_id
+
+    outcome = service.record_feedback(query_id, "verified", confirmed_by="tester")
+    assert outcome["verified_id"]
+    row = store.find_verified_sql(WORKSPACE, service._spec_digest_of(store.get_query(query_id)))
+    assert row is not None
+    assert row["sql_text"].upper().startswith("SELECT")
+
+    # verified 通道必须能按 metric_key 检索到该行（回归：池行钉 revision_ids，
+    # 旧实现 LIKE 匹配 metric_key 对着 rev_xxx 永远不命中，通道静默死掉）
+    assert store.has_verified_sql_for(WORKSPACE, [AOV]) is True
+    catalog = metrics_context.build_catalog("8月各地区支付客单价", WORKSPACE)
+    aov_entry = next(e for e in catalog.entries if e.metric_key == AOV)
+    assert dict(aov_entry.channels)["verified"] == 1.0, "verified 通道必须进打分"
+
+    # llm 通路与失败查询不得固化
+    outcome2 = service.record_feedback(query_id, "rejected")
+    assert outcome2["verified_id"] is None
+
+
+# ==========================================================================
+# 打分权重单元断言
+# ==========================================================================
+def test_weights_constant_matches_design():
+    """D9 权重 0.40/0.20/0.25/0.15 与阈值 0.60 必须与增补设计一致（改动需过评审）。"""
+    assert (metrics_context.W_LEXICAL, metrics_context.W_GRAPH,
+            metrics_context.W_SCHEMA, metrics_context.W_VERIFIED) == (0.40, 0.20, 0.25, 0.15)
+    assert metrics_context.CLARIFY_THRESHOLD == 0.60
+    assert (metrics_context.LEXICAL_LIMIT, metrics_context.GRAPH_LIMIT,
+            metrics_context.SCHEMA_LIMIT, metrics_context.ENRICH_LIMIT) == (20, 10, 10, 5)
+    assert metrics_intent._ALLOWED_FILTER_OPS <= {
+        "=", "!=", "<>", ">", ">=", "<", "<=", "IN", "NOT IN", "LIKE"}
