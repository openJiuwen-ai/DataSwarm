@@ -0,0 +1,69 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""_collect_ambiguities 维值多义判定的通道准入测试（F-053）。
+
+向量通道是跨语言联想召回（「卖得最好」↔ Sales Representative、「取消」↔
+canceled），联想值不构成「用户指定过滤值」的证据——只有词法命中（值在用户
+文本字面出现）才参与 value_polysemy 判定。否则分析性表述（「含取消订单在
+内」）会被误拦成过滤歧义，clarify gate 阻塞整条链路（无取数、无报告）。
+"""
+
+from types import SimpleNamespace
+
+from jiuwenswarm.channels.web.dataagent.analysis.model import RecallHit, RoadResult
+from jiuwenswarm.channels.web.dataagent.analysis.service import _collect_ambiguities
+
+
+def _value_hit(entity_id: str, label: str, column_id: str,
+               channel: str) -> RecallHit:
+    """构造维值召回命中。lexical 通道名带档位后缀（lexical:exact 等）。"""
+    return RecallHit(
+        kind="value", entity_id=entity_id, label=label,
+        channels=[(channel, 0.9)],
+        matched_on=["value:exact" if channel.startswith("lexical") else "value:emb"],
+        payload={"value": label, "column_id": column_id,
+                 "table_id": f"tbl:{column_id}", "snapshot_id": "snap-1"})
+
+
+def _collect(hits: tuple[RecallHit, ...]) -> list[dict]:
+    packs = SimpleNamespace(glossary=[])
+    recall_results = {"values": RoadResult("value", hits, "ok")}
+    return _collect_ambiguities(recall_results, packs)
+
+
+def test_vector_only_hits_do_not_raise_polysemy():
+    """纯向量联想命中（同值多列）不产生 value_polysemy——F-053 场景。"""
+    hits = (
+        _value_hit("v1", "canceled", "col:mysql:src:biz.olist_orders.order_status", "vector"),
+        _value_hit("v2", "canceled", "col:mysql:src:biz.orders.order_status", "vector"),
+    )
+    assert _collect(hits) == []
+
+
+def test_lexical_hits_raise_polysemy():
+    """词法命中（用户文本字面出现该值）多列 → 保留 value_polysemy 拦截。"""
+    hits = (
+        _value_hit("v1", "SP", "col:mysql:src:biz.states.code", "lexical:exact"),
+        _value_hit("v2", "SP", "col:mysql:src:biz.cities.code", "lexical:exact"),
+    )
+    ambiguities = _collect(hits)
+    assert len(ambiguities) == 1
+    assert ambiguities[0]["kind"] == "value_polysemy"
+    assert ambiguities[0]["value"] == "SP"
+
+
+def test_vector_companion_does_not_extend_lexical_polysemy():
+    """词法命中单列 + 向量联想另一列：字面证据只钉住一列，不算多义。"""
+    hits = (
+        _value_hit("v1", "SP", "col:mysql:src:biz.states.code", "lexical:exact"),
+        _value_hit("v2", "SP", "col:mysql:src:biz.cities.code", "vector"),
+    )
+    assert _collect(hits) == []
+
+
+def test_term_caliber_ambiguity_unaffected():
+    """术语同分多口径歧义不受通道准入影响。"""
+    packs = SimpleNamespace(glossary=[{"name": "营收", "ambiguous": True}])
+    recall_results = {"values": RoadResult("value", (), "no_hit")}
+    ambiguities = _collect_ambiguities(recall_results, packs)
+    assert len(ambiguities) == 1
+    assert ambiguities[0]["kind"] == "term_caliber"
