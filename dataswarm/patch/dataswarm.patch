+def test_tcp_connect_timeout_closes_client_and_uses_bounded_phases(clients, monkeypatch):
+    from paramiko.client import SSHClient
+    seen = {}
+
+    def timeout(self, **kwargs):
+        seen.update(kwargs)
+        raise TimeoutError("fixture TCP timeout")
+
