+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""执行器抽象基类。
+
+Executor 接收一段 code + params + 目标数据源 + 超时 + 产物目录，
+返回 TaskRunResult（退出码 + stdout/stderr 路径 + 结果摘要 + 错误）。
+
+产物目录由调用方（workflow_engine / scheduler）传入，为
+~/.jiuwenswarm/artifact/orchestration/runs/<instance_id>/，
+执行器把每个节点的 stdout/stderr/源码落到这里，便于前端日志查看。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+
+@dataclass
+class TaskRunResult:
+    exit_code: int
+    stdout_path: str | None = None
+    stderr_path: str | None = None
+    result_summary: dict | None = None
+    error_message: str | None = None
+    status: str = "success"  # success | failed | timeout
+
+
+class Executor:
+    """执行器协议。子类实现 run()。"""
+
+    executor_type: str = "base"
+
+    def run(
+        self,
+        code: str,
+        params: dict,
+        datasource_ref: str | None,
+        timeout_s: int,
+        artifact_dir: Path,
+        log_prefix: str = "node",
+    ) -> TaskRunResult:
+        raise NotImplementedError
+
+    @staticmethod
+    def _write_text(path: Path, text: str) -> str:
+        """写文本文件，返回 posix 路径字符串。"""
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text, encoding="utf-8")
+        return str(path)
+
+
+_REGISTRY: dict[str, type[Executor]] = {}
+
+
+def register(cls: type[Executor]) -> type[Executor]:
+    """装饰器：注册执行器。"""
+    _REGISTRY[cls.executor_type] = cls
+    return cls
+
+
+def get_executor(executor_type: str) -> Executor:
+    """按 executor_type 取执行器实例。"""
+    cls = _REGISTRY.get(executor_type)
+    if cls is None:
+        raise ValueError(f"unknown executor_type: {executor_type!r} (supported: {list(_REGISTRY)})")
+    return cls()
