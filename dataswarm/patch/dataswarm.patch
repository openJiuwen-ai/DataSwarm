@@ -0,0 +1,310 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""finding_review.py —— 数仓巡检 LLM 语义复核（全量 + 误报降级留痕）。
+
+规则引擎（schema/data/zscore/lineage/task/metric 六维度脚本）产出确定性候选 finding，
+本模块在落库前对每条 finding 做 LLM 语义复核，消解规则机械匹配的误报（典型：
+`schema_inspect` 时间列启发把含 "time" 子串的比率列如 `on_time_rate` 误判为时间列）。
+
+复核输出三态 verdict：
+  confirmed   问题真实成立，原 severity 合理，保留。
+  downgraded  部分成立/严重度被高估，severity 降一级。
+  rejected    纯误报，severity 置为最低档 info。
+
+结果经 run_pipeline 写回产物文件并落库（dw_inspection_findings 加 llm_verdict/llm_reason
+两列留痕）。**本模块永不向上抛异常**（LLM 不可用/单块失败只记 failures，severity 原样），
+保证巡检主流程不被复核阻断。
+
+纯函数 + 异步薄壳分层：纯函数（build_dimension_request/parse_batch_response/mapped_severity/apply_verdict）
+可 mock 单测；review_all 是同步入口（内部 asyncio.run 并发各维度）。
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from pathlib import Path
+
+# 三态 verdict
+VERDICTS = ("confirmed", "downgraded", "rejected")
+
+# severity 档位（永不升档）
+_SEVERITY_RANK = {"high": 3, "medium": 2, "low": 1, "info": 0}
+_RANK_SEVERITY = {3: "high", 2: "medium", 1: "low", 0: "info"}
+
+# 每批 findings 上限（一个维度分 N 批，每批一次 LLM 调用批量判 N 条；
+# 避免单次调用塞整个维度导致输出超限，也远快于逐条调用）
+REVIEW_BATCH = int(os.environ.get("JIUWENSWARM_INSPECTION_LLM_BATCH", "60") or 60)
+REVIEW_TIMEOUT = int(os.environ.get("JIUWENSWARM_INSPECTION_LLM_TIMEOUT", "300") or 300)
+
+# system prompt：要求只输出 verdict 数组（与输入同序），内置规则已知陷阱
+_BATCH_REVIEW_SYSTEM_PROMPT = (
+    "你是数仓巡检误报复核专家。对传入的 findings 数组逐条做语义复核，"
+    "只输出 JSON 数组，无其他文字，数组元素与输入同序：\n"
+    '[{"finding_uid": "<原样>", "verdict": "confirmed|downgraded|rejected", '
+    '"reason": "一句话中文理由（≤100字）"}, ...]\n\n'
+    "判定标准：\n"
+    "- confirmed：问题真实成立，原 severity 合理，保留。\n"
+    "- downgraded：问题部分成立或严重度被高估（轻微/证据不足），severity 应降一级。\n"
+    "- rejected：纯误报（规则机械匹配导致，与业务语义不符），severity 应降为最低档 info。\n\n"
+    "依据：列名/表名的业务语义、column_type、summary/detail/evidence 是否自洽。\n"
+    "已知陷阱：时间列启发规则会把含 \"time\" 子串的列误判为时间列——例如 on_time_rate 是"
+    '"准时率"比率指标（数值类型），不是时间列，应判 rejected；而 created_time 是真实时间列。'
+    "指标口径（dimension=metric）差异是事实而非缺陷，一般不判 rejected。"
+)
+
+
+def mapped_severity(original: str, verdict: str) -> str:
+    """verdict → severity（永不升档）。confirmed 保持；downgraded 降一级；rejected 置 info。"""
+    rank = _SEVERITY_RANK.get(original, 0)
+    if verdict == "confirmed":
+        return original if original in _SEVERITY_RANK else "info"
+    if verdict == "downgraded":
+        return _RANK_SEVERITY.get(max(0, rank - 1), "info")
+    return "info"
+
+
+def _build_snapshot_index(snapshot_path: str | None) -> dict[str, dict[str, str]] | None:
+    """从 schema 快照建 {table: {col: type}} 索引（schema 维度补 column_type 用）。"""
+    if not snapshot_path:
+        return None
+    try:
+        payload = json.loads(Path(snapshot_path).read_text(encoding="utf-8"))
+    except Exception:
+        return None
+    index: dict[str, dict[str, str]] = {}
+    for t in payload.get("tables") or []:
+        cols = {c.get("name"): (c.get("type") or "") for c in (t.get("columns") or [])}
+        index[t.get("name")] = cols
+    return index or None
+
+
+def build_dimension_request(findings: list[dict], *, dimension: str,
+                            snapshot_index: dict[str, dict[str, str]] | None = None) -> dict[str, str]:
+    """一个维度的 findings 打包成一个请求（一次 LLM 调用判断整批）。
+
+    相比逐条调用（findings 数 × LLM 调用，问题多时极慢），这是数量级改善：
+    151 条 → 1 次调用。user_content 含每条 finding 的紧凑字段 + schema 维度补列类型，
+    system prompt 要求返回与输入同序的 verdict 数组。
+    """
+    items = []
+    for f in findings:
+        obj = f.get("object") or {}
+        table, col = obj.get("table"), obj.get("column")
+        item: dict = {
+            "finding_uid": f.get("finding_uid") or "",
+            "rule": f.get("source_finding_id") or f.get("id") or "",
+            "category": f.get("category") or "",
+            "original_severity": f.get("severity") or "",
+            "object": {k: obj.get(k) for k in ("table", "column", "layer", "task_id") if obj.get(k)},
+        }
+        if dimension == "schema" and snapshot_index and table and col:
+            item["column_type"] = snapshot_index.get(table, {}).get(col, "")
+        for k in ("summary", "detail", "evidence"):
+            v = f.get(k)
+            if v:
+                item[k] = v
+        items.append(item)
+    return {
+        "system_prompt": _BATCH_REVIEW_SYSTEM_PROMPT,
+        "user_content": json.dumps({"dimension": dimension, "findings": items},
+                                   ensure_ascii=False),
+    }
+
+
+def parse_batch_response(content: str) -> dict[str, tuple[str | None, str]]:
+    """解析 LLM 返回的 verdict 数组 → {finding_uid: (verdict, reason)}。
+
+    坏 JSON / 非数组 / 未知 verdict 的项 → (None, "")（调用方记 failed）。
+    支持两种形态：顶层数组，或 {"verdicts": [...]}。
+    """
+    try:
+        data = json.loads(content or "{}")
+    except Exception:
+        return {}
+    items = data if isinstance(data, list) else data.get("verdicts")
+    if not isinstance(items, list):
+        return {}
+    out: dict[str, tuple[str | None, str]] = {}
+    for it in items:
+        if not isinstance(it, dict):
+            continue
+        uid = str(it.get("finding_uid") or "")
+        verdict = it.get("verdict")
+        if verdict not in VERDICTS:
+            out[uid] = (None, "")
+            continue
+        out[uid] = (verdict, str(it.get("reason") or "")[:1000])
+    return out
+
+
+def apply_verdict(finding: dict, verdict: str, reason: str) -> None:
+    """原地改写 finding：写 llm_verdict/llm_reason + 按 verdict 降 severity（留 original_severity）。"""
+    finding["llm_verdict"] = verdict
+    finding["llm_reason"] = reason
+    new_sev = mapped_severity(str(finding.get("severity") or ""), verdict)
+    if new_sev != finding.get("severity"):
+        finding["original_severity"] = finding.get("severity")
+        finding["severity"] = new_sev
+
+
+def _chunks(seq, n: int):
+    """按 n 切块（n<=0 视为单块）。"""
+    n = max(1, n)
+    for i in range(0, len(seq), n):
+        yield seq[i: i + n]
+
+
+# ==========================================================================
+# 异步核心（跨维度 + 维度内块并发，统一信号量限流）
+# ==========================================================================
+# 同时进行的 LLM 批量调用数上限（维度内块 + 跨维度共享），防打爆模型服务
+_REVIEW_CONCURRENCY = int(os.environ.get("JIUWENSWARM_INSPECTION_LLM_CONCURRENCY", "4") or 4)
+
+# 只复核语义敏感类别（LLM 判断价值大）：命名/业务键/根因/口径/异常分诊。
+# 纯规则确定性命中（structure 缺主键 / constraint 索引 / null 空值率 / freshness /
+# sla 时间比较 / dag 状态传导 / metric_ghost 反幽灵 / lineage 图 / drift 漂移）
+# 不送 LLM——模型只会 confirmed，纯浪费时间。
+# business（M2 用户规则）同样不送：规则经用户确认落表、命中即违规，
+# 语义复核推翻用户业务判断 = 越权（实测被 LLM 以「非真实业务约束」rejected）。
+_REVIEW_SEMANTIC_CATEGORIES = {
+    "naming", "uniqueness",
+    "task_health", "task_rca",
+    "metric_caliber", "metric_duplicate",
+    "lineage_inconsistency", "root_cause",
+    "timeseries",  # zscore 异常分诊（节日/ETL/事故真伪）
+}
+
+# 单维度复核上限（按 severity 最高危优先，控制复核耗时）。
+# 默认 100；zscore 时序异常量大（实测 219 条），只送最高危前 10 条分诊。
+_DEFAULT_DIM_CAP = int(os.environ.get("JIUWENSWARM_INSPECTION_LLM_DIM_CAP", "100") or 100)
+_REVIEW_DIMENSION_CAP = {
+    "zscore": 10,
+}
+
+# severity 优先级（最高危先复核）
+_SEVERITY_PRIORITY = {"high": 0, "medium": 1, "low": 2, "info": 3}
+
+
+async def _review_findings_async(client, findings: list[dict], *, dimension: str,
+                                 snapshot_index: dict | None, timeout: int,
+                                 batch: int, semaphore) -> dict:
+    """复核一批 findings（每批一次批量 LLM 调用，判断整批）。
+
+    相比逐条调用（findings 数 × LLM 调用），批量是一次调用返回整批 verdict 数组：
+    schema 151 条 / 60 ≈ 3 次调用（而非 151 次），时间从分钟级降到秒级。
+    """
+    counts = {"total": 0, "confirmed": 0, "downgraded": 0, "rejected": 0, "failed": 0}
+    failures: list[str] = []
+
+    async def _one_chunk(chunk: list[dict]) -> None:
+        request = build_dimension_request(chunk, dimension=dimension,
+                                          snapshot_index=snapshot_index)
+        async with semaphore:  # 限流：同时最多 _REVIEW_CONCURRENCY 次批量调用
+            try:
+                content = await client.complete_json_async(
+                    system_prompt=request["system_prompt"],
+                    user_content=request["user_content"],
+                    timeout=timeout, error_context=f"review:{dimension}",
+                )
+            except Exception as exc:  # noqa: BLE001 —— 块失败不阻断整批
+                counts["failed"] += len(chunk)
+                failures.append(f"{dimension}:{type(exc).__name__}: {exc}"[:200])
+                return
+        verdicts = parse_batch_response(content)
+        for f in chunk:
+            verdict, reason = verdicts.get(f.get("finding_uid"), (None, ""))
+            if verdict is None:
+                counts["failed"] += 1
+                failures.append(f"{dimension}:{f.get('finding_uid')}: 无判定")
+                continue
+            apply_verdict(f, verdict, reason)
+            counts["total"] += 1
+            counts[verdict] += 1
+
+    # 维度内多批并发（全量复核，批数 = ceil(len/batch)）
+    await asyncio.gather(*[_one_chunk(chunk) for chunk in _chunks(findings, batch)])
+    return counts, failures
+
+
+async def _review_all_async(client, artifact_map: dict[str, str],
+                            snapshot_index: dict | None, timeout: int,
+                            batch: int) -> dict:
+    """并发复核各维度产物文件的语义敏感 finding，写回（原子 replace）。永不抛异常。
+
+    只送语义敏感类别（_REVIEW_SEMANTIC_CATEGORIES）给 LLM——规则确定性命中
+    （structure/constraint/null/freshness/sla/dag/ghost/lineage/drift）不送；
+    单维度按 severity 最高危优先取 _REVIEW_DIMENSION_CAP 条。超出/非语义类别
+    保持原样不标注，计 skipped_review。
+    """
+    agg = {"total": 0, "confirmed": 0, "downgraded": 0, "rejected": 0,
+           "failed": 0, "skipped_review": 0}
+    failures: list[str] = []
+    semaphore = asyncio.Semaphore(max(1, _REVIEW_CONCURRENCY))
+
+    async def _one(dimension: str, path: str) -> None:
+        try:
+            payload = json.loads(Path(path).read_text(encoding="utf-8"))
+        except Exception as exc:  # noqa: BLE001
+            agg["failed"] += 1
+            failures.append(f"{dimension}: 读文件失败 {type(exc).__name__}: {exc}"[:200])
+            return
+        findings = payload.get("findings") or []
+        if not findings:
+            return
+        # 只送语义敏感类别；单维度按 severity 最高危优先取上限（zscore 特例 10）
+        # dimension 可能带 _findings 后缀（run_pipeline artifact_map 的 key），cap 按裸名查
+        semantic = [f for f in findings
+                    if (f.get("category") or "") in _REVIEW_SEMANTIC_CATEGORIES]
+        semantic.sort(key=lambda f: _SEVERITY_PRIORITY.get(f.get("severity"), 9))
+        dim_key = dimension[:-len("_findings")] if dimension.endswith("_findings") else dimension
+        dim_cap = _REVIEW_DIMENSION_CAP.get(dim_key, _DEFAULT_DIM_CAP)
+        reviewable = semantic[:dim_cap]
+        agg["skipped_review"] += len(findings) - len(reviewable)
+        if not reviewable:
+            return
+        counts, dim_failures = await _review_findings_async(
+            client, reviewable, dimension=dimension,
+            snapshot_index=snapshot_index, timeout=timeout, batch=batch,
+            semaphore=semaphore)
+        for k, v in counts.items():
+            agg[k] += v
+        failures.extend(dim_failures)
+        # 原子写回（复核结果随产物文件落库）
+        p = Path(path)
+        tmp = p.with_suffix(p.suffix + ".tmp")
+        tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+        tmp.replace(p)
+
+    await asyncio.gather(*[_one(dim, p) for dim, p in artifact_map.items()])
+    return {"total_reviewed": agg["total"], "confirmed": agg["confirmed"],
+            "downgraded": agg["downgraded"], "rejected": agg["rejected"],
+            "failed": agg["failed"], "skipped_review": agg["skipped_review"],
+            "failures": failures}
+
+
+# ==========================================================================
+# 同步入口（run_pipeline 调用）
+# ==========================================================================
+def review_all(artifact_map: dict[str, str], *, snapshot_path: str | None = None,
+               timeout: int | None = None, batch: int | None = None) -> dict:
+    """并行复核各维度产物文件并原子写回。永不向上抛异常（返回计数 + failures）。
+
+    Args:
+        artifact_map: {dimension: findings_json_path}（result 里各 *_findings 键）
+        snapshot_path: schema 快照路径（可选，schema 维度补 column_type）
+        timeout: 单次 LLM 调用超时秒（默认 REVIEW_TIMEOUT）
+        batch: 每块 findings 上限（默认 REVIEW_BATCH）
+
+    Returns:
+        {total_reviewed, confirmed, downgraded, rejected, failed, failures}
+    """
+    from jiuwenswarm.symphony.llm import LLMConfig, create_llm_client
+
+    config = LLMConfig.from_default_model()
+    client = create_llm_client(config)
+    timeout = timeout or REVIEW_TIMEOUT
+    batch = batch or REVIEW_BATCH
+    snapshot_index = _build_snapshot_index(snapshot_path)
+    return asyncio.run(_review_all_async(client, artifact_map, snapshot_index,
+                                         timeout, batch))
