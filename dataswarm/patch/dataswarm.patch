+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""semantic/vector_store.py —— schema 向量的 FAISS 存储、增量同步与召回。
+
+设计见 ``docs/archive/delivered/dataagent-schema-vector-design.md``。存储走 Semantica SDK 的
+``FAISSStore``（glossary 链路验证过的组件与模式：确定性 id、按条删插、
+sidecar 台账、进程内缓存加锁）；嵌入与校准复用 ``metrics/embedding.py``
+（可用性判定含 web 进程 ``.env`` 补读、批量同步桥、多向量查询、余弦校准）。
+
+度量选 ``inner_product`` + 写入/查询前显式 L2 归一化：归一化后 FAISS 的
+``distance`` 即原始余弦，metrics 的校准阈值（floor/ceil）直接可用；**不要**
+改回 glossary 的 L2——校准刻度不同。SDK ``search_similar`` 的 ``score``
+字段按 L2 设计（``1/(1+dist)``），inner_product 下不可用，一律取 ``distance``。
+
+降级红线（对齐 metrics/embedding.py 的纪律）：本模块任何失败都以返回值透出
+（``{"status": "failed", ...}`` / ``warnings``），**绝不抛异常阻断采集发布**；
+embed 未配置是 ``skipped`` 不是错误，查询侧则记 warning 由调用方降级词法。
+"""
+from __future__ import annotations
+
+import logging
+import os
+import threading
+from functools import wraps
+from pathlib import Path
+from typing import Any
+
+from .model import MetadataSnapshot
+from .vector_docs import DOC_VERSION, build_docs
+
+from ..metrics import embedding
+
+logger = logging.getLogger(__name__)
+
+_VECTOR_DIR_ENV = "DATASWARM_SEMANTIC_VECTOR_DIR"
+_DEFAULT_DIR = Path("data/semantic/vectors")
+
+# 召回参数：每查询向量取 top-k，逐文档跨查询向量取 max（与 metrics.rank 同思想）
+_RECALL_TOP_K = 20
+_DEFAULT_LIMIT = 20
+
+WARN_INDEX_EMPTY = "emb_index_empty"
+
+_vector_lock = threading.RLock()
+_faiss_cache: dict[tuple[str, str], Any] = {}
+# 写入流程串行，防止两个同步基于旧台账交错提交；召回不获取此锁。
+_workspace_locks: dict[tuple[str, str], Any] = {}
+# 索引操作单独互斥：embedding 的慢网络调用不阻塞旧索引召回。
+_store_locks: dict[tuple[str, str], threading.Lock] = {}
+
+
+def _with_workspace_lock(function):
+    """Serialize writers for one workspace/index path, without blocking recall."""
+    @wraps(function)
+    def locked(workspace_id: str, *args, **kwargs):
+        key = (workspace_id, str(_vector_path(workspace_id)))
+        with _vector_lock:
+            lock = _workspace_locks.setdefault(key, threading.RLock())
+        # Never wait for a workspace lock while holding the global cache lock.
+        with lock:
+            return function(workspace_id, *args, **kwargs)
+    return locked
+
+
+def _vector_dir() -> Path:
+    """向量目录：env 覆盖优先，默认 ``data/semantic/vectors``（随 CWD，app_web 从仓库根启动）。"""
+    override = os.environ.get(_VECTOR_DIR_ENV, "").strip()
+    return Path(override) if override else _DEFAULT_DIR
+
+
+def _vector_path(workspace_id: str) -> Path:
+    return _vector_dir() / f"{workspace_id}.faiss"
+
+
+def _warn(message: str) -> None:
+    logger.warning("[semantic.vector_store][warn] %s", message)
+
+
+def _faiss_store(workspace_id: str, dims: int | None = None) -> Any:
+    """取（或建/载）workspace 级 FAISSStore（inner_product 度量）。
+
+    文件存在则 load（损坏自愈：删文件按 dims 重建）；不存在且未给 dims 返回
+    None——调用方先 embed 拿真实维度再来。进程内按 (workspace, 目录) 缓存，
+    缓存字典由 ``_vector_lock`` 保护；加载、损坏清理与所有索引操作
+    （add/delete/save/search/台账读）使用 ``_store_lock``。调用本函数时
+    不得已持索引锁；慢磁盘操作和等待索引锁时不持全局缓存锁。
+
+    Args:
+        workspace_id: 工作空间 id。
+        dims: 新建索引时的向量维度（embed 返回的真实维度）；load 已有文件时忽略。
+
+    Returns:
+        FAISSStore 实例；首次新建且 dims 未知时为 None。
+    """
+    from semantica.vector_store.faiss_store import FAISSStore
+
+    path = _vector_path(workspace_id)
+    key = (workspace_id, str(path))
+    with _store_lock(workspace_id):
+        with _vector_lock:
+            cached = _faiss_cache.get(key)
+        if cached is not None:
+            return cached
+        if not path.exists():
+            if not dims:
+                return None
+            store = FAISSStore(dimension=dims)
+            store.create_index("flat", "inner_product")
+            with _vector_lock:
+                _faiss_cache[key] = store
+            return store
+        store = FAISSStore(dimension=dims or 1024)
+        try:
+            store.load_index(path)
+        except Exception:  # noqa: BLE001 —— 索引损坏自愈：删文件重建
+            _warn(f"索引文件损坏，重建: {path}")
+            path.unlink(missing_ok=True)
+            Path(str(path) + ".meta.json").unlink(missing_ok=True)
+            if not dims:
+                return None
+            store = FAISSStore(dimension=dims)
+            store.create_index("flat", "inner_product")
+        with _vector_lock:
+            _faiss_cache[key] = store
+        return store
+
+
+def _store_lock(workspace_id: str) -> threading.Lock:
+    """取（或建）workspace 级索引操作锁，与 ``_faiss_cache`` 同 key。"""
+    key = (workspace_id, str(_vector_path(workspace_id)))
+    with _vector_lock:
+        lock = _store_locks.get(key)
+        if lock is None:
+            lock = _store_locks[key] = threading.Lock()
+        return lock
+
+
+# ==========================================================================
+# 归一化（inner_product → cosine 的前提）
+# ==========================================================================
+def _normalize_rows(vectors: Any) -> Any:
+    """批量 L2 归一化（float32）。零向量原样保留（余弦无定义，校准归零兜底）。"""
+    import numpy as np
+
+    arr = np.asarray(vectors, dtype=np.float32)
+    if arr.ndim == 1:
+        arr = arr.reshape(1, -1)
+    norms = np.linalg.norm(arr, axis=1, keepdims=True)
+    norms[norms == 0.0] = 1.0
+    return arr / norms
+
+
+def _normalize_one(vector: Any) -> Any:
+    """单向量 L2 归一化。"""
+    import numpy as np
+
+    arr = np.asarray(vector, dtype=np.float32).reshape(1, -1)
+    norms = np.linalg.norm(arr, axis=1, keepdims=True)
+    norms[norms == 0.0] = 1.0
+    return (arr / norms)[0]
+
+
+# ==========================================================================
+# 台账与同步
+# ==========================================================================
+def _ledger(store: Any) -> dict[str, dict[str, Any]]:
+    """sidecar 台账：vector_id → metadata（增量比对与删除共用）。
+
+    直接读 ``store.index.metadata``（glossary ``_vector_ids_by_term`` 同款），
+    不走 ``scan_vectors`` 翻页。
+    """
+    index = getattr(store, "index", None)
+    metadata = getattr(index, "metadata", None) or {}
+    return {str(vid): dict(meta or {}) for vid, meta in metadata.items()}
+
+
+@_with_workspace_lock
+def sync_workspace_vectors(workspace_id: str, source_id: str,
+                           snapshot: MetadataSnapshot) -> dict:
+    """publish 后同步向量：doc_hash 增量嵌入 + 消失对象清理（设计 §4.2）。
+
+    增量比对用文档文本哈希而非采集 fingerprint：``column_fingerprint`` 不含
+    表名，而列文档文本含 ``table.column`` 前缀——表改名时对象指纹不变、文档
+    却变了，直接用对象指纹对账会漏更新。
+
+    Returns:
+        ``{"status": "ok"|"skipped"|"failed", ...}``——任何失败不抛异常，
+        采集发布照常；失败时**不删**消失对象（旧索引保持完整可用，下次自愈）。
+    """
+    if not embedding.emb_available():
+        return {"status": "skipped", "reason": "embedding_not_configured"}
+    docs = build_docs(workspace_id, source_id, snapshot)
+    # Preserve the exact snapshot identity instead of reconstructing it from a
+    # bare table name (or splitting names that may themselves contain dots).
+    table_by_node = {}
+    for table in snapshot.tables:
+        table_by_node[table.node_id] = table
+        table_by_node.update({column.node_id: table for column in table.columns})
+    for doc in docs:
+        matched_table = table_by_node.get(str(doc.metadata.get("node_id") or ""))
+        if matched_table is not None:
+            doc.metadata.update(table_id=matched_table.node_id, table_fqn=matched_table.fqn)
+    lock = _store_lock(workspace_id)
+    store = _faiss_store(workspace_id)
+    with lock:
+        ledger = _ledger(store) if store is not None else {}
+    wanted = {d.id for d in docs}
+    stale = [doc_id for doc_id, meta in ledger.items()
+             if meta.get("source_id") == source_id and doc_id not in wanted]
+    missing = [d for d in docs
+               if str(ledger.get(d.id, {}).get("doc_hash") or "") != d.doc_hash
+               or str(ledger.get(d.id, {}).get("doc_version") or "") != DOC_VERSION
+               or ledger.get(d.id, {}).get("table_id") != d.metadata.get("table_id")
+               or ledger.get(d.id, {}).get("table_fqn") != d.metadata.get("table_fqn")]
+
+    reembedded = 0
+    vectors = None
+    if missing:
+        # 仅持 writer 锁：召回仍可在索引锁下读取旧的完整索引。
+        outcome = embedding.embed_texts([d.text for d in missing])
+        if not outcome.ok:
+            return {"status": "failed", "reason": outcome.error or "emb_failed"}
+        if store is None:
+            store = _faiss_store(workspace_id, dims=outcome.dims)
+        if store is None:  # pragma: no cover —— dims 已给仍建不出，防御分支
+            return {"status": "failed", "reason": "faiss_unavailable"}
+        vectors = _normalize_rows(outcome.vectors)
+        reembedded = len(missing)
+    if store is None:
+        return {"status": "ok", "vectors": len(docs), "reembedded": 0}
+    # add/delete/save 是一次完整提交，召回只能看到提交前或提交后的索引。
+    with lock:
+        if missing:
+            missing_ids = [d.id for d in missing]
+            replacing = [doc_id for doc_id in missing_ids if doc_id in ledger]
+            try:
+                old_vectors = [store.get_vector(doc_id) for doc_id in replacing]
+            except Exception as exc:  # noqa: BLE001 —— 备份失败时索引尚未修改
+                return {"status": "failed", "reason": f"vector_backup_failed:{type(exc).__name__}"}
+            if any(vector is None for vector in old_vectors):
+                return {"status": "failed", "reason": "vector_backup_missing"}
+            try:
+                # Semantica 0.7 skips physical vectors for existing IDs while
+                # updating metadata. Remove only changed IDs before re-adding.
+                if replacing:
+                    store.delete_vectors(replacing)
+                store.add_vectors(vectors, ids=missing_ids, metadata=[d.metadata for d in missing])
+            except Exception as exc:  # noqa: BLE001 —— 部分写入回滚到原向量与台账
+                try:
+                    store.delete_vectors(missing_ids)
+                    if replacing:
+                        store.add_vectors(old_vectors, ids=replacing,
+                                          metadata=[ledger[doc_id] for doc_id in replacing])
+                    # SDK may assign metadata before a failed physical add;
+                    # deleting an ID absent from FAISS does not remove it.
+                    for doc_id in missing_ids:
+                        if doc_id in ledger:
+                            store.index.metadata[doc_id] = ledger[doc_id]
+                        else:
+                            store.index.metadata.pop(doc_id, None)
+                    store.save_index(_vector_path(workspace_id))
+                except Exception as rollback_exc:  # noqa: BLE001 —— 恢复失败必须显式透出
+                    return {"status": "failed", "reason": (
+                        f"vector_update_rollback_failed:{type(exc).__name__}:{type(rollback_exc).__name__}")}
+                return {"status": "failed", "reason": f"vector_update_failed:{type(exc).__name__}"}
+        if stale:
+            # embed 成功后才清理消失对象：失败路径保持旧索引完整可用
+            store.delete_vectors(stale)
+        try:
+            store.save_index(_vector_path(workspace_id))
+        except Exception as exc:  # noqa: BLE001 —— 落盘失败透出，内存索引下次重写
+            return {"status": "failed", "reason": f"save_index_failed:{type(exc).__name__}"}
+    return {"status": "ok", "vectors": len(docs), "reembedded": reembedded}
+
+
+# ==========================================================================
+# 召回
+# ==========================================================================
+def recall(workspace_id: str, source_id: str, question: str,
+           *, limit: int = _DEFAULT_LIMIT) -> dict:
+    """语义召回：问题多向量 → FAISS top-k → 校准合并 → 表级聚合（设计 §4.4~4.6）。
+
+    Returns:
+        ``{"tables": [...], "query_vectors": [...], "warnings": [...]}``——
+        通道不可用返回空 tables + warning，调用方据此降级词法，**不得**把
+        「通道关闭」当「没有相似表」。``emb_via`` 记录每条命中的胜出查询向量
+        原文（归因展示，与 metrics recall 明细同一诉求）。
+    """
+    if not embedding.emb_available():
+        return {"tables": [], "query_vectors": [],
+                "warnings": [embedding.WARN_UNAVAILABLE]}
+    store = _faiss_store(workspace_id)
+    lock = _store_lock(workspace_id)
+    with lock:
+        ledger = _ledger(store) if store is not None else {}
+        source_count = sum(meta.get("source_id") == source_id for meta in ledger.values())
+    if not source_count:
+        return {"tables": [], "query_vectors": [], "warnings": [WARN_INDEX_EMPTY]}
+    outcome = embedding.query_vectors(question)
+    if not outcome.ok:
+        return {"tables": [], "query_vectors": [],
+                "warnings": [outcome.error or embedding.WARN_UNAVAILABLE]}
+
+    whole_floor, phrase_floor = embedding.floors()
+    hits: dict[str, tuple[float, str, dict[str, Any]]] = {}
+    with lock:
+        # Query embedding may overlap a completed sync. Refresh the ledger and
+        # keep all expanded searches on the same index version.
+        ledger = _ledger(store)
+        source_count = sum(meta.get("source_id") == source_id for meta in ledger.values())
+        if not source_count:
+            return {"tables": [], "query_vectors": list(outcome.texts), "warnings": [WARN_INDEX_EMPTY]}
+        for idx, qvec in enumerate(outcome.vectors):
+            floor = whole_floor if idx == 0 else phrase_floor
+            try:
+                # FAISS has no source prefilter. Expand until this source has
+                # its own top-k, or all vectors have been exhausted.
+                normalized = _normalize_one(qvec)
+                k = _RECALL_TOP_K
+                while True:
+                    batch = store.search_similar(normalized, k=k) or []
+                    results = [item for item in batch
+                               if (item.get("metadata") or {}).get("source_id") == source_id]
+                    if (len(results) >= min(_RECALL_TOP_K, source_count)
+                            or k >= len(ledger) or len(batch) < k):
+                        results = results[:_RECALL_TOP_K]
+                        break
+                    k = min(len(ledger), k * 2)
+            except Exception as exc:  # noqa: BLE001 —— 单向量检索失败不拖垮整轮
+                _warn(f"检索失败: {type(exc).__name__}: {exc}")
+                continue
+            for item in results or []:
+                meta = dict(item.get("metadata") or {})
+                if meta.get("source_id") != source_id:
+                    continue  # 同 workspace 多数据源：只召回本源对象
+                raw = float(item.get("distance") or 0.0)
+                score = embedding.calibrate(raw, floor=floor)
+                if score <= 0.0:
+                    continue
+                via = outcome.texts[idx] if idx < len(outcome.texts) else ""
+                doc_id = str(item.get("id") or "")
+                prev = hits.get(doc_id)
+                if prev is None or score > prev[0]:
+                    hits[doc_id] = (score, via, meta)
+
+    tables = _aggregate_tables(hits)
+    return {"tables": tables[:limit], "query_vectors": list(outcome.texts),
+            "warnings": []}
+
+
+def _aggregate_tables(hits: dict[str, tuple[float, str, dict[str, Any]]]) -> list[dict]:
+    """列级命中 → 表级聚合：表分 = 该表命中文档 max，列按分降序（设计 §4.5）。"""
+    tables: dict[str, dict[str, Any]] = {}
+    for doc_id, (score, via, meta) in hits.items():
+        table_name = str(meta.get("table_name") or "")
+        if not table_name:
+            continue
+        table_id, table_fqn = _table_identity(meta, doc_id)
+        # Legacy indexes without an identity retain their previous grouping;
+        # all newly synced documents carry an explicit table_id, including views.
+        key = table_id or table_fqn or table_name
+        entry = tables.setdefault(key, {
+            "table_name": table_name, "table_id": table_id, "table_fqn": table_fqn,
+            "score": 0.0, "matched_on": ["emb"],
+            "columns": []})
+        if score > entry["score"]:
+            entry["score"] = score
+        column_name = str(meta.get("column_name") or "")
+        if column_name:
+            entry["columns"].append(
+                {"column_name": column_name, "score": round(score, 4),
+                 "emb_via": via})
+    out: list[dict] = []
+    for entry in tables.values():
+        entry["columns"].sort(key=lambda c: (-c["score"], c["column_name"]))
+        entry["score"] = round(entry["score"], 4)
+        out.append(entry)
+    out.sort(key=lambda t: (-t["score"], t["table_fqn"], t["table_id"], t["table_name"]))
+    return out
+
+
+def _table_identity(meta: dict[str, Any], doc_id: str) -> tuple[str, str]:
+    """Read exact identities, with a compatibility path for older sidecars."""
+    table_id = str(meta.get("table_id") or "")
+    if not table_id:
+        node_id = str(meta.get("node_id") or doc_id.rsplit(":", 1)[0])
+        if node_id.startswith(("tbl:", "view:")):
+            table_id = node_id
+        elif node_id.startswith("col:"):
+            column_name = str(meta.get("column_name") or "")
+            suffix = "." + column_name
+            if column_name and node_id.endswith(suffix):
+                table_id = "tbl:" + node_id[4:-len(suffix)]
+    table_fqn = str(meta.get("table_fqn") or "")
+    if not table_fqn and table_id:
+        parts = table_id.split(":", 3)
+        if len(parts) == 4:
+            table_fqn = parts[3]
+    return table_id, table_fqn
