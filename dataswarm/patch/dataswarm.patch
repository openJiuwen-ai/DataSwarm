diff --git a/tests/unit_tests/gateway/test_struct_change_http.py b/tests/unit_tests/gateway/test_struct_change_http.py
new file mode 100644
index 000000000..9cbdca479
--- /dev/null
+++ b/tests/unit_tests/gateway/test_struct_change_http.py
@@ -0,0 +1,165 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Gateway struct-change notify 端点单测（方案 §九）：loopback/校验/delivered 计数.
+
+request.client 的来源地址用 starlette 的 transport 直接注入（TestClient 默认
+"testclient" 过不了 loopback 校验）。
+"""
+
+from __future__ import annotations
+
+from unittest.mock import patch
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from jiuwenswarm.gateway.channel_manager.web import struct_change_http
+
+
+class _FakeWebChannel:
+    """记录 send_event_to_session 调用的假 WebChannel。"""
+
+    def __init__(self, delivered=1):
+        self.delivered = delivered
+        self.calls: list[tuple[str, str, dict]] = []
+
+    def send_event_to_session(self, session_id, event, payload):
+        self.calls.append((session_id, event, payload))
+        return self.delivered
+
+
+def _make_app(channel: _FakeWebChannel) -> FastAPI:
+    app = FastAPI()
+    struct_change_http.attach_struct_change_routes(app, channel)
+    return app
+
+
+def _post(app: FastAPI, host: str, json_body=None, content=None, token="test-token"):
+    """带指定来源 host 的 POST（绕过 TestClient 的固定 "testclient" 地址）。"""
+    import types
+
+    from jiuwenswarm.gateway.channel_manager.web import struct_change_http as mod
+
+    original = getattr(mod.Request, "client", None)
+    mod.Request.client = property(lambda _self: types.SimpleNamespace(host=host, port=12345))
+    client = TestClient(app)
+    try:
+        headers = {"X-Jiuwen-Struct-Change-Token": token} if token else {}
+        if content is not None:
+            return client.post(
+                struct_change_http.STRUCT_CHANGE_NOTIFY_PATH,
+                content=content,
+                headers={"Content-Type": "application/json", **headers},
+            )
+        return client.post(struct_change_http.STRUCT_CHANGE_NOTIFY_PATH, json=json_body, headers=headers)
+    finally:
+        if original is not None:
+            mod.Request.client = original
+        else:
+            delattr(mod.Request, "client")
+
+
+class TestStructChangeNotify:
+    def setup_method(self):
+        self._token_patch = patch(
+            "jiuwenswarm.common.internal_auth.get_struct_change_token",
+            return_value="test-token",
+        )
+        self._token_patch.start()
+        self._session_patch = patch.object(struct_change_http, "_session_exists", return_value=True)
+        self._session_patch.start()
+
+    def teardown_method(self):
+        self._session_patch.stop()
+        self._token_patch.stop()
+
+    def _payload(self, **overrides):
+        base = {
+            "schema_version": 1,
+            "event_id": "sc-1-a",
+            "session_id": "sess-1",
+            "kind": "workflow_run",
+            "workflow_run": {"instance_id": "inst_1"},
+        }
+        base.update(overrides)
+        return base
+
+    def test_ok_delivers_to_channel(self):
+        channel = _FakeWebChannel(delivered=2)
+        app = _make_app(channel)
+        payload = self._payload()
+        resp = _post(app, "127.0.0.1", json_body=payload)
+        assert resp.status_code == 200, resp.text
+        assert resp.json() == {"ok": True, "delivered": 2}
+        assert channel.calls == [("sess-1", "chat.struct_change", payload)]
+
+    def test_loopback_ipv6_ok(self):
+        channel = _FakeWebChannel(delivered=0)
+        app = _make_app(channel)
+        resp = _post(app, "::1", json_body=self._payload())
+        assert resp.status_code == 200
+        assert resp.json()["delivered"] == 0  # 无在线 ws 也是 200（事件已落历史）
+
+    def test_non_loopback_403(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        resp = _post(app, "10.0.0.5", json_body=self._payload())
+        assert resp.status_code == 403
+        assert resp.json()["error"] == "forbidden_origin"
+        assert channel.calls == []
+
+    def test_missing_or_invalid_token_401(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        assert _post(app, "127.0.0.1", json_body=self._payload(), token="").status_code == 401
+        assert _post(app, "127.0.0.1", json_body=self._payload(), token="wrong").status_code == 401
+        assert channel.calls == []
+
+    def test_unknown_session_404(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        with patch.object(struct_change_http, "_session_exists", return_value=False):
+            resp = _post(app, "127.0.0.1", json_body=self._payload())
+        assert resp.status_code == 404
+        assert resp.json()["error"] == "session_not_found"
+        assert channel.calls == []
+
+    def test_missing_session_id_400(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        resp = _post(app, "127.0.0.1", json_body={"kind": "table_change", "table_change": {}})
+        assert resp.status_code == 400
+        assert resp.json()["error"] == "session_id_required"
+        assert channel.calls == []
+
+    def test_invalid_kind_400(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        resp = _post(app, "127.0.0.1", json_body={"session_id": "s1", "kind": "unknown"})
+        assert resp.status_code == 400
+        assert resp.json()["error"] == "invalid_kind"
+        assert channel.calls == []
+
+    def test_non_dict_payload_400(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        resp = _post(app, "127.0.0.1", json_body=[1, 2, 3])
+        assert resp.status_code == 400
+        assert resp.json()["error"] == "invalid_payload"
+
+    def test_invalid_json_400(self):
+        channel = _FakeWebChannel()
+        app = _make_app(channel)
+        resp = _post(app, "127.0.0.1", content=b"not-json")
+        assert resp.status_code == 400
+        assert resp.json()["error"] == "invalid_json"
+
+    def test_send_failure_500(self):
+        class _BoomChannel(_FakeWebChannel):
+            def send_event_to_session(self, session_id, event, payload):
+                raise RuntimeError("ws down")
+
+        channel = _BoomChannel()
+        app = _make_app(channel)
+        resp = _post(app, "127.0.0.1", json_body=self._payload())
+        assert resp.status_code == 500
+        assert resp.json()["error"] == "send_failed"
