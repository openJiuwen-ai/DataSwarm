diff --git a/tests/unit_tests/test_dataswarm_boot.py b/tests/unit_tests/test_dataswarm_boot.py
new file mode 100644
index 000000000..20483ecf8
--- /dev/null
+++ b/tests/unit_tests/test_dataswarm_boot.py
@@ -0,0 +1,148 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataswarm_boot 单测：默认注入语义（setdefault，显式设置优先）与端口基准组。
+
+不调用各 ``*_main`` wrapper（会真启动服务），只测 ``_apply_defaults`` /
+``_default_data_dir`` 的契约——这是 DataSwarm 与基座同机共存的隔离基础。
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm import dataswarm_boot
+
+_ENV_KEYS = (
+    "JIUWENSWARM_DATA_DIR",
+    "JIUWENSWARM_HOME",
+    *dataswarm_boot._DEFAULT_PORT_BASES,
+)
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    """每个用例前清掉注入相关变量，避免宿主环境污染断言。
+
+    teardown 再 pop 一次：``_apply_defaults`` 的 setdefault 发生在测试体内，
+    monkeypatch 追踪不到；不清理会泄漏给同进程后续测试（CI xdist 同 worker
+    上 test_instance_manager / test_desktop_port_resolve 等的端口断言曾被
+    污染成 DataSwarm 新端口组而批量失败）。monkeypatch 的恢复晚于本 teardown，
+    宿主环境原有值不受影响。
+    """
+    for key in _ENV_KEYS:
+        monkeypatch.delenv(key, raising=False)
+    yield
+    for key in _ENV_KEYS:
+        os.environ.pop(key, None)
+
+
+def test_apply_defaults_injects_data_dir():
+    """未设置时注入 ~/.dataswarm。"""
+    dataswarm_boot._apply_defaults()
+    assert os.environ["JIUWENSWARM_DATA_DIR"] == str(Path.home() / ".dataswarm")
+
+
+def test_apply_defaults_injects_port_group():
+    """端口基准组整组 +11000（与基座 19000 组及回退扫描段不重叠）。"""
+    dataswarm_boot._apply_defaults()
+    assert os.environ["JIUWENSWARM_AGENT_SERVER_PORT"] == "29092"
+    assert os.environ["JIUWENSWARM_WEB_PORT"] == "30000"
+    assert os.environ["JIUWENSWARM_GATEWAY_PORT"] == "30001"
+    assert os.environ["JIUWENSWARM_FRONTEND_PORT"] == "16173"
+
+
+def test_apply_defaults_never_overrides_explicit(monkeypatch):
+    """setdefault 语义：用户显式设置（含多实例注入）永远优先。"""
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", "/tmp/custom-ws")
+    monkeypatch.setenv("JIUWENSWARM_GATEWAY_PORT", "12345")
+    dataswarm_boot._apply_defaults()
+    assert os.environ["JIUWENSWARM_DATA_DIR"] == "/tmp/custom-ws"
+    assert os.environ["JIUWENSWARM_GATEWAY_PORT"] == "12345"
+    # 未显式设置的键仍被注入
+    assert os.environ["JIUWENSWARM_WEB_PORT"] == "30000"
+
+
+def test_default_data_dir_respects_jiuwenswarm_home(monkeypatch):
+    """JIUWENSWARM_HOME 设定时以它为基准（与基座解析 ~/.jiuwenswarm 的基准一致）。"""
+    monkeypatch.setenv("JIUWENSWARM_HOME", "/tmp/fake-home")
+    assert dataswarm_boot._default_data_dir() == Path("/tmp/fake-home/.dataswarm")
+
+
+def test_port_group_clears_baseline_scan_range():
+    """端口组避开基座 index 0..9 扫描段且低于 Linux 临时端口段下沿 32768。"""
+    base_ports = {"agent_server": 18092, "web": 19000, "gateway": 19001, "frontend": 5173}
+    for port_type, base in base_ports.items():
+        ours = int(dataswarm_boot._DEFAULT_PORT_BASES[f"JIUWENSWARM_{port_type.upper()}_PORT"])
+        # 基线扫描段为 base..base+9000（index 0..9），我们的基准必须在其上
+        assert ours > base + 9000, port_type
+        assert ours < 32768, port_type
+
+
+def test_all_entry_wrappers_exist():
+    """11 个 dataswarm* 入口 wrapper 齐备且可调用（入口注册契约）。"""
+    expected = {
+        "main", "app_main", "agentserver_main", "gateway_main", "web_main",
+        "start_main", "stop_main", "init_main", "desktop_main",
+        "acp_main", "acp_chat_main",
+    }
+    for name in expected:
+        assert callable(getattr(dataswarm_boot, name)), name
+
+
+@pytest.mark.skipif(
+    not (Path(__file__).resolve().parents[2] / "scripts" / "jiuwenswarm_exe_entry.py").exists(),
+    reason="desktop packaging assets are absent",
+)
+def test_exe_entry_injects_defaults_when_frozen(tmp_path):
+    """frozen（桌面 exe/.app）入口在模块级引导 dataswarm_boot，不再回落 ~/.jiuwenswarm。
+
+    子进程里置 ``sys.frozen = True`` 后 exec 入口脚本（``__name__`` 非
+    ``__main__``，不触发 ``main()``），模拟 PyInstaller 双击启动：注入应发生在
+    frozen 模块级代码块中，cwd 与单实例锁都落在注入的数据目录下。
+    ``USERPROFILE``/``HOME`` 指到临时目录，避免在真机 home 落目录/文件
+    （Windows 取 USERPROFILE、POSIX 取 HOME，两个都设）。
+    """
+    entry = Path(__file__).resolve().parents[2] / "scripts" / "jiuwenswarm_exe_entry.py"
+    fake_home = tmp_path / "fake-home"
+    fake_home.mkdir()
+    smoke = (
+        "import json, os, sys\n"
+        "from pathlib import Path\n"
+        "sys.frozen = True\n"
+        "g = {'__name__': 'exe_entry_smoke'}\n"
+        f"exec(open({str(entry)!r}, encoding='utf-8').read(), g)\n"
+        "locked = g['_acquire_single_instance_lock']()\n"
+        "data_dir = os.environ['JIUWENSWARM_DATA_DIR']\n"
+        "print(json.dumps({\n"
+        "    'locked': locked,\n"
+        "    'data_dir': data_dir,\n"
+        "    'cwd_matches': os.path.realpath(os.getcwd()) == os.path.realpath(data_dir),\n"
+        "    'lock_in_data_dir': (Path(data_dir) / '.desktop.lock').is_file(),\n"
+        "    'web_port': os.environ.get('JIUWENSWARM_WEB_PORT'),\n"
+        "}))\n"
+    )
+    env = os.environ.copy()
+    for key in (*_ENV_KEYS, "DWAGENT_BASE"):
+        env.pop(key, None)
+    env["USERPROFILE"] = str(fake_home)
+    env["HOME"] = str(fake_home)
+    result = subprocess.run(
+        [sys.executable, "-c", smoke],
+        capture_output=True,
+        text=True,
+        env=env,
+        timeout=60,
+    )
+    assert result.returncode == 0, result.stderr
+    payload = json.loads(result.stdout.strip().splitlines()[-1])
+    assert payload == {
+        "locked": True,
+        "data_dir": str(fake_home / ".dataswarm"),
+        "cwd_matches": True,
+        "lock_in_data_dir": True,
+        "web_port": "30000",
+    }
