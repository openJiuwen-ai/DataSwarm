+    assert "typed extraction failed after 3 attempts" in str(excinfo.value)
+
+
+def test_openai_gateway_html_error_page_fails_loudly():
+    """new-api 503 返回 HTML 错误页，openai SDK 会静默解析成 str——必须大声失败。"""
+    class _FakeOpenAI:
+        @property
+        def chat(self):
+            return self
+
+        @property
+        def completions(self):
+            return self
+
+        def create(self, **_kwargs):
+            return "<!doctype html><html>New API error page</html>"
+
+    provider = ExtractionLLMProvider(model="m", api_key="k", api_base="http://gw/", client=_FakeOpenAI())
+    with pytest.raises(ExtractionLLMError) as excinfo:
+        provider.generate_typed("p", _Result)
+    assert "non-chat payload" in str(excinfo.value)
+
+
+def test_build_default_provider_follows_client_provider_config(monkeypatch):
+    from jiuwenswarm.channels.web.dataagent.metrics import llm as metrics_llm
+    from jiuwenswarm.channels.web.dataagent.knowledge import extraction_llm
+    monkeypatch.setattr(extraction_llm, "_config_node", lambda: {})
+    for key in ("KNOWLEDGE_EXTRACT_MODEL", "KNOWLEDGE_EXTRACT_API_KEY",
+                "KNOWLEDGE_EXTRACT_API_BASE", "KNOWLEDGE_EXTRACT_CLIENT_PROVIDER"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setattr(metrics_llm, "load_llm_config",
+                        lambda: {"model_name": "m", "api_key": "k", "api_base": "http://gw/",
+                                 "client_provider": "Anthropic"})
+    provider = build_default_provider()
+    assert provider.protocol == "anthropic"
+    monkeypatch.setattr(metrics_llm, "load_llm_config",
+                        lambda: {"model_name": "m", "api_key": "k", "api_base": "http://gw/"})
+    assert build_default_provider().protocol == "openai"  # 缺省按 OpenAI 协议
+
+
+def test_openai_base_url_appends_v1_for_origin_form():
+    """openai SDK 的 base_url 是完整前缀（拼 /chat/completions 不自动加 /v1）——
+    网关 origin 形态必须显式补 /v1，否则打到 HTML 404 页。"""
+    cases = [("http://1.2.3.4:3000/", "http://1.2.3.4:3000/v1"),
+             ("http://1.2.3.4:3000", "http://1.2.3.4:3000/v1"),
+             ("https://api.openai.com/v1", "https://api.openai.com/v1"),
+             ("http://gw:3000/openai", "http://gw:3000/openai")]
+    for raw, expected in cases:
+        provider = ExtractionLLMProvider(model="m", api_key="k", api_base=raw)
+        built = provider._make_openai_client()
+        assert str(built.base_url).rstrip("/") == expected, raw
+
+
+def test_ensure_json_keyword_appends_hint_when_missing():
+    from jiuwenswarm.channels.web.dataagent.knowledge.extraction_llm import _ensure_json_keyword
+    # 不含 "json" 的 prompt 追加后缀（DashScope/Qwen json_object 模式要求）
