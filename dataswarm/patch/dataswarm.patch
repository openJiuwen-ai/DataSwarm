+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""sql 域统一协议单测（方案 §3.1：envelope/rows bug/guard/limit<=0/explain/db_ref缺省/affected_rows）。
+
+bug 修复档 TDD：本测试表达"协议修复后"的正确期望，跑前应为红（复现 bug），
+service.py 修复后转绿。覆盖：
+  - G envelope：run_sql 返回 columns/truncated/elapsed_ms，rows 是行列表（不是整个 query dict）
+  - G2 limit<=0 → fetchall（透传 limit=None 给 db_connector）
+  - G3 execute_ddl 透传 affected_rows/elapsed_ms
+  - G5 explain 独立路径，不被 limit guard 拼坏（透传 limit=None）
+  - G19 空 db_ref → 回退 db_connector.default_db_ref()
+  - 失败仍返回 ok:false（service 层），controller 层负责 HTTP 状态码
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.sql import service as svc
+
+
+# db_connector.query 的真实返回 shape（dict，含 row_count/columns/rows/truncated/elapsed_ms/db）
+_QUERY_RESULT = {
+    "row_count": 2,
+    "truncated": False,
+    "columns": ["a", "b"],
+    "rows": [[1, "x"], [2, "y"]],
+    "elapsed_ms": 12,
+    "db": {"type": "doris"},
+}
+
+
+class _FakeConnector:
+    """模拟 db_connector：记录调用、返回可控结果。
+
+    query 返回真实 shape 的 dict（不是 list）——这是触发原 service.run_sql bug
+    （把整个 dict 塞进 rows、row_count=len(dict)）的关键。
+    """
+
+    def __init__(self):
+        self.query_result: object = dict(_QUERY_RESULT)
+        self.query_calls: list[tuple] = []
+        self.execute_result: dict = {
+            "affected_rows": 3,
+            "elapsed_ms": 5,
+            "db": {"type": "doris"},
+        }
+        self.execute_calls: list[tuple] = []
+        # dry_run 默认模拟 doris SELECT：EXPLAIN 前缀 + CHECKED
+        self.dry_run_result: object = {
+            "ok": True, "status": "CHECKED", "dialect": "doris",
+            "sql": "EXPLAIN SELECT 1",
+        }
+        self._default_db = "doris://meta"
+
+    def query(self, db_ref, sql, *a, **kw):
+        self.query_calls.append((db_ref, sql, kw.get("limit")))
+        if isinstance(self.query_result, Exception):
+            raise self.query_result
+        return self.query_result
+
+    def execute(self, db_ref, sql, *a, **kw):
+        self.execute_calls.append((db_ref, sql))
+        if isinstance(self.execute_result, Exception):
+            raise self.execute_result
+        return self.execute_result
+
+    def dry_run(self, db_ref, sql):
+        if isinstance(self.dry_run_result, Exception):
+            raise self.dry_run_result
+        return self.dry_run_result
+
+    def default_db_ref(self):
+        return self._default_db
+
+
+@pytest.fixture
+def patch_connector(monkeypatch):
+    fake = _FakeConnector()
+    monkeypatch.setattr(svc, "db_connector", fake)
+    # pin 单空间上下文：_resolve_db_ref 会 resolve workspace 并校验 ref 归属，
+    # 本机多 workspace 记录让 resolve 抛 WorkspaceContextRequired / 校验拒绝
+    # 任意 ref——G19 回退与 ref 校验均与用例主旨无关，这里固定单空间并把
+    # 业务/元库都指向测试默认 ref，validate 直接放行。
+    from jiuwenswarm.common import workspace_context as wctx
+
+    ctx = wctx.WorkspaceContext("default", "默认", "doris://h/d", "doris://meta")
+    monkeypatch.setattr(wctx, "_workspace_records", lambda: [ctx])
+    monkeypatch.setattr(wctx, "current_workspace", lambda: ctx)
+    return fake
+
+
+def test_explicit_ref_fails_closed_without_workspace(monkeypatch):
+    monkeypatch.setattr(
+        svc.workspace_context,
+        "resolve",
+        lambda workspace_id=None: (_ for _ in ()).throw(
+            svc.workspace_context.WorkspaceContextRequired(["a", "b"])
+        ),
+    )
+    with pytest.raises(svc.workspace_context.WorkspaceContextRequired):
+        svc._resolve_db_ref("sqlite://outside.db")
+
+
+# --------------------------------------------------------------------------
+# G envelope：rows 是行列表，columns/truncated/elapsed_ms 齐全
+# --------------------------------------------------------------------------
+def test_run_sql_returns_full_envelope(patch_connector):
+    """修复前：rows = 整个 query dict（bug），row_count = len(dict)=6（key 数，错）。
+    修复后：rows = [[1,'x'],[2,'y']]，row_count=2，columns/truncated/elapsed_ms 齐全。
+    """
+    out = svc.run_sql("doris://h/d", "SELECT * FROM t", limit=50)
+    assert out["ok"] is True
+    assert out["rows"] == [[1, "x"], [2, "y"]]  # 行列表，非整个 dict
+    assert out["columns"] == ["a", "b"]
+    assert out["truncated"] is False
+    assert out["elapsed_ms"] == 12
+    assert out["row_count"] == 2
+    assert out["db_ref"] == "doris://h/d"
+
+
+def test_run_sql_passes_limit_to_connector(patch_connector):
+    """limit 透传给 db_connector.query。"""
+    svc.run_sql("doris://h/d", "SELECT 1", limit=200)
+    assert patch_connector.query_calls[0][2] == 200
+
+
+# --------------------------------------------------------------------------
+# G2 limit<=0 → MAX_QUERY_ROWS 截断（§3.1 G2：不执行真正的无限 fetchall）
+# 透传给 db_connector（<=0 在 db_connector 内走 MAX_QUERY_ROWS fetch 截断路径）
+# --------------------------------------------------------------------------
+def test_run_sql_limit_zero_means_capped(patch_connector):
+    """limit<=0 不拼 LIMIT 0，透传给 db_connector 走 MAX_QUERY_ROWS 截断。"""
+    svc.run_sql("doris://h/d", "SELECT 1", limit=0)
+    assert patch_connector.query_calls[0][2] == 0
+
+
+def test_run_sql_limit_negative_means_capped(patch_connector):
+    svc.run_sql("doris://h/d", "SELECT 1", limit=-1)
+    assert patch_connector.query_calls[0][2] == -1
+
+
+# --------------------------------------------------------------------------
+# G3 execute_ddl 透传 affected_rows/elapsed_ms
+# --------------------------------------------------------------------------
+def test_execute_ddl_returns_affected_rows(patch_connector):
+    """修复前：execute_ddl 只回 {ok}，丢弃 affected_rows（G3）。
+    修复后：透传 affected_rows/elapsed_ms（anomaly-fixer 对账依赖）。
+    """
+    out = svc.execute_ddl("doris://h/d", "CREATE TABLE t(id int)")
+    assert out["ok"] is True
+    assert out["affected_rows"] == 3
+    assert out["elapsed_ms"] == 5
+    assert out["db_ref"] == "doris://h/d"
+
+
+def test_execute_ddl_error_envelope(patch_connector):
+    patch_connector.execute_result = RuntimeError("perm denied")
+    out = svc.execute_ddl("doris://h/d", "DROP TABLE t")
+    assert out["ok"] is False
+    assert "perm denied" in out["error"]
+    assert out["db_ref"] == "doris://h/d"
+
+
+# --------------------------------------------------------------------------
+# G5 explain 独立路径（不被 limit guard 拼坏）
+# --------------------------------------------------------------------------
+def test_explain_sql_no_limit_guard(patch_connector):
+    """修复前：explain_sql 走普通 query，会被 add_limit_guard 追加 LIMIT（Doris EXPLAIN 不接受）。
+    修复后：explain 走 limit=None 专用路径，不拼 guard。
+    """
+    out = svc.explain_sql("doris://h/d", "SELECT 1")
+    assert out["ok"] is True
+    assert out["explain"] == _QUERY_RESULT["rows"]  # 返回 explain 行列表
+    # 关键：透传给 db_connector.query 的 limit 必须是 None（不拼 guard）
+    assert patch_connector.query_calls[0][2] is None
+
+
+def test_explain_sql_prepends_explain(patch_connector):
+    """EXPLAIN 前缀仍要拼接。"""
+    svc.explain_sql("doris://h/d", "SELECT 1")
+    assert patch_connector.query_calls[0][1] == "EXPLAIN SELECT 1"
+
+
+# --------------------------------------------------------------------------
+# G19 空/None db_ref → 回退当前工作空间 business_db_ref（不再真传空 ref）
+# --------------------------------------------------------------------------
+def test_run_sql_empty_db_ref_falls_back_to_default(patch_connector):
+    """修复前：空 db_ref 直接传给 db_connector.query，parse_db_ref("") 报错。
+    修复后：空 db_ref → 工作空间业务库 ref 回退（pin 的 default 空间 → doris://h/d）。
+    """
+    out = svc.run_sql("", "SELECT 1")
+    assert out["ok"] is True
+    assert patch_connector.query_calls[0][0] == "doris://h/d"  # 回退到空间业务库
+
+
+def test_run_sql_none_db_ref_falls_back_to_default(patch_connector):
+    out = svc.run_sql(None, "SELECT 1", limit=10)  # type: ignore[arg-type]
+    assert out["ok"] is True
+    assert patch_connector.query_calls[0][0] == "doris://h/d"
+
+
+# --------------------------------------------------------------------------
+# 失败 envelope（service 层仍返回 ok:false，HTTP 状态码由 controller 定）
+# --------------------------------------------------------------------------
+def test_run_sql_error_envelope(patch_connector):
+    patch_connector.query_result = RuntimeError("boom")
+    out = svc.run_sql("doris://h/d", "SELECT 1")
+    assert out["ok"] is False
+    assert "boom" in out["error"]
+    assert out["db_ref"] == "doris://h/d"
+
+
+def test_explain_sql_error_envelope(patch_connector):
+    patch_connector.query_result = RuntimeError("boom")
+    out = svc.explain_sql("doris://h/d", "SELECT 1")
+    assert out["ok"] is False
+    assert "boom" in out["error"]
+
+
+# --------------------------------------------------------------------------
+# 批次 1a：explain 切 dry_run（DML 方言感知 + SKIPPED/FAILED 归因透出）
+# --------------------------------------------------------------------------
+def test_explain_sql_skipped_returns_ok_with_status(patch_connector):
+    """无安全预检手段的语句（如 DROP）→ ok:true + status:SKIPPED 明示（不静默）。
+
+    方言矩阵（谁会 SKIPPED）由 db_connector.dry_run 单测覆盖；此处只验证
+    service 层对 SKIPPED 状态的透传（fixture pin 的是 doris 空间 ref）。
+    """
+    patch_connector.dry_run_result = {
+        "ok": True, "status": "SKIPPED", "dialect": "duckdb"}
+    out = svc.explain_sql("doris://h/d", 'DROP TABLE "t"')
+    assert out["ok"] is True
+    assert out["status"] == "SKIPPED"
+    assert out["dialect"] == "duckdb"
+    assert out["explain"] == []
+
+
+def test_explain_sql_dml_uses_dry_run_wrapped_sql(patch_connector):
+    """DML 预检走 dry_run 返回的校验 SQL（duckdb INSERT 提取源 SELECT）。"""
+    patch_connector.dry_run_result = {
+        "ok": True, "status": "CHECKED", "dialect": "duckdb",
+        "sql": 'EXPLAIN SELECT a FROM "ods_s"'}
+    out = svc.explain_sql("doris://h/d", 'INSERT INTO "dwd" SELECT a FROM "ods_s"')
+    assert out["ok"] is True
+    assert out["status"] == "CHECKED"
+    assert patch_connector.query_calls[0][1] == 'EXPLAIN SELECT a FROM "ods_s"'
+
+
+def test_explain_sql_dry_run_failed_carries_dialect(patch_connector):
+    """dry_run FAILED → ok:false + error 归因（生成期拦截，非执行期）。"""
+    patch_connector.dry_run_result = RuntimeError("(1146, table doesn't exist)")
+    out = svc.explain_sql("doris://h/d", "SELECT * FROM missing")
+    assert out["ok"] is False
+    assert "doesn't exist" in out["error"]
+
+
+# --------------------------------------------------------------------------
+# controller 层：失败返回 HTTP 4xx/5xx（而非 200）
+# --------------------------------------------------------------------------
