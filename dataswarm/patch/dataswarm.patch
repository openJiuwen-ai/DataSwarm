+    fake = _FakeConnector()
+    monkeypatch.setattr(svc, "db_connector", fake)
+    # 强制走 Doris 分支（_db_ref_for_name 走 doris:// 构造，不走 sqlite 本地文件）
+    monkeypatch.setattr(svc, "_is_sqlite", False)
