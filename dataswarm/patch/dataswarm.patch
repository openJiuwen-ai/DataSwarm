diff --git a/tests/fixtures/ossie/olist-order-metrics.ossie.yaml b/tests/fixtures/ossie/olist-order-metrics.ossie.yaml
new file mode 100644
index 000000000..417158e94
--- /dev/null
+++ b/tests/fixtures/ossie/olist-order-metrics.ossie.yaml
@@ -0,0 +1,186 @@
+version: 0.2.0.dev0
+name: olist_order_metrics
+description: 订单成交指标（Olist 巴西电商演示数仓）。数据集 dwd_order_detail 每行一个订单商品项，
+  金额单位 BRL，item_total = price + freight_value（含运费）；GMV 按下单时间统计、
+  NMV/支付订单数按支付通过时间统计；取消(canceled)与失效(unavailable)订单不计入任何指标。
+  数据时间范围 2016-09-04 ~ 2018-09-03。
+datasets:
+- name: orders
+  source: mysql.olist.dwd_order_detail
+  primary_key:
+  - order_id
+  - order_item_id
+  description: 订单商品项宽表（DWD 层，331213 行）：每个订单的每个商品项一行，
+    含客户地理、品类与订单状态；purchase_ts 为下单时间，approved_ts 为支付通过时间（裸本地时间）。
+  fields:
+  - name: order_id
+    datatype: String
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: order_id
+  - name: order_item_id
+    datatype: Integer
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: order_item_id
+  - name: order_status
+    datatype: String
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: order_status
+    ai_context:
+      synonyms:
+      - 订单状态
+      description: 取值范围：delivered / shipped / invoiced / processing / approved / canceled / unavailable
+  - name: purchase_ts
+    datatype: DateTime
+    dimension:
+      is_time: true
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: purchase_ts
+    ai_context:
+      synonyms:
+      - 下单时间
+  - name: approved_ts
+    datatype: DateTime
+    dimension:
+      is_time: true
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: approved_ts
+    ai_context:
+      synonyms:
+      - 支付时间
+      - 付款时间
+  - name: customer_state
+    datatype: String
+    dimension:
+      is_time: false
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: customer_state
+    ai_context:
+      synonyms:
+      - 客户州
+      - 州
+      - 省份
+  - name: customer_city
+    datatype: String
+    dimension:
+      is_time: false
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: customer_city
+    ai_context:
+      synonyms:
+      - 客户城市
+      - 城市
+  - name: product_category_name_english
+    datatype: String
+    dimension:
+      is_time: false
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: product_category_name_english
+    ai_context:
+      synonyms:
+      - 品类
+      - 商品类目
+      - 类目
+  - name: item_total
+    datatype: Decimal
+    expression:
+      dialects:
+      - dialect: ANSI_SQL
+        expression: item_total
+    ai_context:
+      synonyms:
+      - 商品行总额
+      - 行总金额
+    description: 单个订单商品项总金额 = price + freight_value（含运费），单位 BRL。
+  custom_extensions:
+  - vendor_name: DATASWARM
+    data: '{"profile_version":"1.0","datasource_alias":"mysql_olist","row_grain":["order_id","order_item_id"],"subject_iri":"https://dataswarm.example/ontology/olist/OrderItem"}'
+metrics:
+- name: gmv
+  datatype: Decimal
+  description: 商品交易总额：有效订单（未取消、未失效）的全部商品项金额，含运费，
+    按下单时间归属周期；退款不冲减。
+  expression:
+    dialects:
+    - dialect: ANSI_SQL
+      expression: SUM(CASE WHEN orders.order_status NOT IN ('canceled', 'unavailable')
+        THEN orders.item_total ELSE 0 END)
+  ai_context:
+    synonyms:
+    - GMV
+    - 商品交易总额
+    - 平台成交总额
+    - 流水额
+    - 拍下总金额
+    - Gross Merchandise Volume
+  custom_extensions:
+  - vendor_name: DATASWARM
+    data: '{"profile_version":"1.0","default_time_dimension":"orders.purchase_ts","allowed_dimensions":["orders.customer_state","orders.customer_city","orders.product_category_name_english"],"time_grains":["day","week","month"],"timezone":"Asia/Shanghai","calendar":"iso_week_monday","subject_iri":"https://dataswarm.example/ontology/olist/OrderItem","metric_key":"olist.gmv","display_name":"商品交易总额","metric_type":"atomic","unit":"BRL","additivity":{"time":"additive","dimensions":"additive"}}'
+- name: nmv
+  datatype: Decimal
+  description: 净交易总额：成功完成支付（approved_ts 非空）且未取消/未失效订单的商品项金额，
+    含运费，按支付通过时间归属周期。
+  expression:
+    dialects:
+    - dialect: ANSI_SQL
+      expression: SUM(CASE WHEN orders.order_status NOT IN ('canceled', 'unavailable')
+        AND orders.approved_ts IS NOT NULL THEN orders.item_total ELSE 0 END)
+  ai_context:
+    synonyms:
+    - NMV
+    - 净交易总额
+    - 净成交额
+  custom_extensions:
+  - vendor_name: DATASWARM
+    data: '{"profile_version":"1.0","default_time_dimension":"orders.approved_ts","allowed_dimensions":["orders.customer_state","orders.customer_city","orders.product_category_name_english"],"time_grains":["day","week","month"],"timezone":"Asia/Shanghai","calendar":"iso_week_monday","subject_iri":"https://dataswarm.example/ontology/olist/OrderItem","metric_key":"olist.nmv","display_name":"净交易总额","metric_type":"atomic","unit":"BRL","additivity":{"time":"additive","dimensions":"additive"}}'
+- name: paid_order_count
+  datatype: Integer
+  description: 支付订单数：成功完成支付且未取消/未失效的订单数，按订单ID去重。
+  expression:
+    dialects:
+    - dialect: ANSI_SQL
+      expression: COUNT(DISTINCT CASE WHEN orders.order_status NOT IN ('canceled', 'unavailable')
+        AND orders.approved_ts IS NOT NULL THEN orders.order_id END)
+  ai_context:
+    synonyms:
+    - 支付订单数
+    - 成交订单数
+  custom_extensions:
+  - vendor_name: DATASWARM
+    data: '{"profile_version":"1.0","default_time_dimension":"orders.approved_ts","allowed_dimensions":["orders.customer_state","orders.customer_city","orders.product_category_name_english"],"time_grains":["day","week","month"],"timezone":"Asia/Shanghai","calendar":"iso_week_monday","subject_iri":"https://dataswarm.example/ontology/olist/OrderItem","metric_key":"olist.paid_order_count","display_name":"支付订单数","metric_type":"atomic","unit":"order","additivity":{"time":"non_additive","dimensions":"non_additive"}}'
+- name: aov
+  datatype: Decimal
+  description: 支付客单价：同一时间和维度范围下的净交易总额除以支付订单数；分母为0返回NULL。
+  expression:
+    dialects:
+    - dialect: ANSI_SQL
+      expression: SUM(CASE WHEN orders.order_status NOT IN ('canceled', 'unavailable')
+        AND orders.approved_ts IS NOT NULL THEN orders.item_total ELSE 0 END) / NULLIF(COUNT(DISTINCT
+        CASE WHEN orders.order_status NOT IN ('canceled', 'unavailable') AND orders.approved_ts
+        IS NOT NULL THEN orders.order_id END), 0)
+  ai_context:
+    synonyms:
+    - 支付客单价
+    - 客单价
+    - 平均订单价值
+  custom_extensions:
+  - vendor_name: DATASWARM
+    data: '{"profile_version":"1.0","default_time_dimension":"orders.approved_ts","allowed_dimensions":["orders.customer_state","orders.customer_city","orders.product_category_name_english"],"time_grains":["day","week","month"],"timezone":"Asia/Shanghai","calendar":"iso_week_monday","subject_iri":"https://dataswarm.example/ontology/olist/OrderItem","metric_key":"olist.aov","display_name":"支付客单价","metric_type":"ratio","unit":"BRL/order","dependencies":["olist.nmv","olist.paid_order_count"],"zero_denominator":"null","additivity":{"time":"non_additive","dimensions":"non_additive"}}'
+custom_extensions:
+- vendor_name: DATASWARM
+  data: '{"profile_version":"1.0","namespace":"olist","model_key":"olist.order_metrics","owner":"olist_analytics","ontology_binding_version":"olist-v1"}'
