+
+test('applyEvent: 同 eventId 幂等（实时先到 + 历史回放后到只展示一次）', () => {
+  const store = useStructChangeStore.getState();
+  store.applyEvent('s1', normalizeStructChangeEvent(workflowPayload('sc-dup')));
+  store.applyEvent('s1', normalizeStructChangeEvent(workflowPayload('sc-dup')));
+  const events = useStructChangeStore.getState().runtimes['s1'].events;
+  assert.equal(events.length, 1);
+  assert.equal(events[0].eventId, 'sc-dup');
+});
+
+test('applyEvent: 新事件在前（倒序存储），清单直接顺序渲染', () => {
+  const store = useStructChangeStore.getState();
+  store.applyEvent('s2', normalizeStructChangeEvent(workflowPayload('sc-a')));
+  store.applyEvent('s2', normalizeStructChangeEvent(tablePayload('sc-b')));
+  const events = useStructChangeStore.getState().runtimes['s2'].events;
+  assert.deepEqual(events.map(e => e.eventId), ['sc-b', 'sc-a']);
+});
+
+test('applyEvent: 乱序到达（历史回放分页补页）仍按 ts 倒序', () => {
+  const store = useStructChangeStore.getState();
+  // page1（较新）先回放，page2（更早）后到：旧实现无条件前插，会把更早的顶到最前
+  const older = { ...tablePayload('sc-old'), ts: '2026-09-14T09:00:00+08:00' };
+  store.applyEvent('s6', normalizeStructChangeEvent(workflowPayload('sc-new')));
+  store.applyEvent('s6', normalizeStructChangeEvent(older));
+  const events = useStructChangeStore.getState().runtimes['s6'].events;
+  assert.deepEqual(events.map(e => e.eventId), ['sc-new', 'sc-old']);
+});
+
+test('applyEvent: ts 缺失的事件排在末尾，不影响已有顺序', () => {
+  const store = useStructChangeStore.getState();
+  const noTs = { ...tablePayload('sc-no-ts'), ts: '' };
+  store.applyEvent('s7', normalizeStructChangeEvent(noTs));
+  store.applyEvent('s7', normalizeStructChangeEvent(workflowPayload('sc-with-ts')));
+  const events = useStructChangeStore.getState().runtimes['s7'].events;
+  assert.deepEqual(events.map(e => e.eventId), ['sc-with-ts', 'sc-no-ts']);
+});
+
+test('applyEvent: 超上限丢最旧', async () => {
+  const { MAX_EVENTS } = await import('../node_modules/.cache/struct-change-store/structChangeStore.mjs');
+  const store = useStructChangeStore.getState();
+  for (let i = 0; i < MAX_EVENTS + 5; i++) {
+    store.applyEvent('s3', normalizeStructChangeEvent(workflowPayload(`sc-${i}`)));
+  }
+  const events = useStructChangeStore.getState().runtimes['s3'].events;
+  assert.equal(events.length, MAX_EVENTS);
+  // 最新的在最前，最早的（sc-0..sc-4）被丢
+  assert.equal(events[0].eventId, `sc-${MAX_EVENTS + 4}`);
+  assert.equal(events.some(e => e.eventId === 'sc-4'), false);
+});
+
+test('跨 session 隔离：s1 的事件不影响 s4', () => {
+  const store = useStructChangeStore.getState();
+  store.applyEvent('s1', normalizeStructChangeEvent(workflowPayload()));
+  assert.equal(useStructChangeStore.getState().runtimes['s4'], undefined);
+});
+
+test('clearSession 清空但保留 runtime 结构', () => {
+  const store = useStructChangeStore.getState();
+  store.applyEvent('s5', normalizeStructChangeEvent(workflowPayload()));
+  useStructChangeStore.getState().clearSession('s5');
+  assert.deepEqual(useStructChangeStore.getState().runtimes['s5'].events, []);
+});
+
+test('normalizeStructChangeEvent: workflow_run 契约解析', () => {
+  const event = normalizeStructChangeEvent(workflowPayload());
+  assert.equal(event.kind, 'workflow_run');
+  assert.equal(event.workflowRun.instanceId, 'inst_1');
+  assert.equal(event.workflowRun.name, 'GMV 日汇总');
+});
+
+test('normalizeStructChangeEvent: workflow_change 契约解析', () => {
+  const event = normalizeStructChangeEvent(workflowChangePayload());
+  assert.equal(event.kind, 'workflow_change');
+  assert.equal(event.workflowChange.workflowId, 'wf_1');
+  assert.equal(event.workflowChange.operation, 'ADD_NODE');
+  assert.equal(event.workflowChange.nodeCount, 5);
+});
+
+test('normalizeStructChangeEvent: workflow_change 缺 workflow_id 返回 null', () => {
+  const payload = workflowChangePayload();
+  payload.workflow_change.workflow_id = '';
+  assert.equal(normalizeStructChangeEvent(payload), null);
+});
+
+test('normalizeStructChangeEvent: 带库名表取裸表名不在此层处理（tables 原样保留）', () => {
+  const payload = tablePayload();
+  payload.table_change.tables = ['olist_dw.dws_gmv_daily'];
+  const event = normalizeStructChangeEvent(payload);
+  assert.deepEqual(event.tableChange.tables, ['olist_dw.dws_gmv_daily']);
+});
+
+test('normalizeStructChangeEvent: 非法 payload 返回 null', () => {
+  assert.equal(normalizeStructChangeEvent({}), null);
+  assert.equal(normalizeStructChangeEvent({ event_id: 'x', kind: 'unknown' }), null);
+  // workflow_run 缺 instance_id
+  const broken = workflowPayload();
+  delete broken.workflow_run.instance_id;
+  assert.equal(normalizeStructChangeEvent(broken), null);
+  // table_change 空 tables
+  const brokenTable = tablePayload();
+  brokenTable.table_change.tables = [];
+  assert.equal(normalizeStructChangeEvent(brokenTable), null);
+  // 缺 event_id
+  const noId = workflowPayload();
+  delete noId.event_id;
+  assert.equal(normalizeStructChangeEvent(noId), null);
+});
