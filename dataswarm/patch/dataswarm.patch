+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Scale gate before any embedding call; small authorized catalogs are read whole."""
+from __future__ import annotations
+
+import json
+import os
+from dataclasses import asdict
+
+from ..glossary import db as glossary_db
+from ..metrics import store, semantic_link
+from .model import ContextPacks, SchemaTablePack
+
+
+def catalog(workspace_id: str, snapshots: dict, source_ids: list[str] | None) -> tuple[ContextPacks | None, dict]:
+    """Return a complete catalog only if BOTH the character and token gates pass.
+
+    UTF-8 bytes are a conservative token upper bound when the deployed tokenizer
+    is unavailable. Gate errors fall back to existing recall, never partial full-read.
+    """
+    # token 门取 32768（单请求 LLM token 预算，env 可覆盖 + 代码默认值形态）；
+    # chars 门放宽为防极端的辅助栏——bytes ≥ chars 恒成立，主判定永远在 token 门
+    # （2026-10-23 A/B 实测：知识资产 ~24.5K bytes 的空间在旧 10000 门下永远走
+    # 混合召回，全量直读面（knowledge_assets/schema_tables/glossary）信息更全且省 EMB）
+    max_chars = int(os.environ.get("FULL_CONTEXT_MAX_CHARS", "40000"))
+    max_tokens = int(os.environ.get("FULL_CONTEXT_MAX_TOKENS", "32768"))
+    packs = ContextPacks()
+    packs.glossary = [{"term_id": t["term_id"], "name": t["name"], "definition": t["definition"],
+                       "synonyms": t.get("synonyms_list") or [], "ambiguous": False,
+                       "matched_on": ["full_context"]} for t in glossary_db.list_terms(status="active")]
+    release = store.get_active_release(workspace_id)
+    source_map = semantic_link.resolve_source_map(workspace_id)
+    revision_ids = set(release.revision_ids) if release else set()
+    for metric, revision in store.list_effective_published(workspace_id):
+        if revision.revision_id not in revision_ids:
+            continue
+        bindings = store.list_bindings(revision.revision_id)
+        if source_ids and not any(source_map.get(b.datasource_ref, "") in source_ids for b in bindings):
+            continue
+        packs.metrics_candidates.append({"metric_key": metric.metric_key,
+                                         "display_name": revision.display_name or metric.name,
+                                         "revision_id": revision.revision_id, "description": metric.description,
+                                         "definition": revision.definition_payload(), "matched_on": ["full_context"],
+                                         "evidence_tier": "scored"})
+    total_tables = 0
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            if table.status != "active" or source_ids and table.source_id not in source_ids:
+                continue
+            total_tables += 1
+            columns = [{"name": col.name, "type": col.data_type, "comment": col.comment, "node_id": col.node_id,
+                        "matched": False, "value_candidates": []} for col in table.columns if col.status == "active"]
+            packs.schema_tables.append(SchemaTablePack(table_id=table.node_id, table=table.name,
+                                                       source_id=table.source_id, snapshot_id=snapshot.snapshot_id,
+                                                       comment=table.comment, columns=columns))
+    # Reuse the existing snapshot join projection; a full read must retain the
+    # same relationship evidence as the retrieval branch.
+    from .graph_expand import Expansion, _add_join_edge
+    from .context_pack import _join_touches_table
+    join_expansion = Expansion()
+    visible_tables = {table.table_id for table in packs.schema_tables}
+    for snapshot in snapshots.values():
+        for join in snapshot.joins:
+            if join.left_table_id in visible_tables and join.right_table_id in visible_tables:
+                _add_join_edge(join_expansion, join)
+    for table in packs.schema_tables:
+        table.joins = [join for join in join_expansion.joins if _join_touches_table(join, table.table_id)]
+    for item in packs.metrics_candidates:
+        item["bindings"] = []
+        for binding in store.list_bindings(item["revision_id"]):
+            source_id = source_map.get(binding.datasource_ref, "")
+            if source_ids and source_id not in source_ids:
+                continue
+            item["bindings"].append({"source_id": source_id, "source_table": binding.source_table,
+                                      "column_map": binding.column_map})
+    packs.semantic_versions = {"release_id": release.release_id if release else None,
+                               "snapshots": [{"source_id": sid, "snapshot_id": snapshot.snapshot_id}
+                                             for sid, snapshot in snapshots.items()
+                                             if not source_ids or sid in source_ids],
+                               "graph_status": "not_required"}
+    from ..knowledge.selection import visible_assets, asset_view, target_refs
+    assets = visible_assets(source_ids=source_ids, versions=packs.semantic_versions)
+    packs.knowledge_assets = [asset_view(asset) for asset in assets if asset["asset_type"] != "rule"]
+    # Full-read rules are counted before the budget gate; no hidden post-gate payload.
+    # Unbound rules load whole only with an explicit workspace_wide mark — a missing
+    # binding is governance debt, surfaced below as unbound_rule_count.
+    bound_or_global = [asset for asset in assets if asset["asset_type"] == "rule"
+                       and (target_refs(asset["scope"]) or asset["scope"].get("workspace_wide") is True)]
+    packs.knowledge_rules = [asset_view(asset) for asset in bound_or_global]
+    packs.knowledge_rule_trace = {"stage": "pre_plan", "rule_policy": "all_applicable",
+                                  "status": "ok", "rules_selected": len(packs.knowledge_rules),
+                                  "strategy": "full_context_candidates",
+                                  "unbound_rule_count": sum(1 for asset in assets
+                                                            if asset["asset_type"] == "rule") - len(bound_or_global)}
+    payload = json.dumps(asdict(packs), ensure_ascii=False, default=str)
+    trace = {"strategy": "hybrid_recall", "chars": len(payload), "token_upper_bound": len(payload.encode("utf-8")),
+             "token_measure": "utf8_byte_upper_bound", "max_chars": max_chars, "max_tokens": max_tokens,
+             "scope_source_ids": list(source_ids or snapshots.keys()), "embedding_called": True,
+             "knowledge_asset_count": len(packs.knowledge_assets), "rule_count": len(packs.knowledge_rules)}
+    if total_tables > int(os.environ.get("FULL_CONTEXT_MAX_TABLES", "100")):
+        trace["reason"] = "catalog_table_count_exceeded"
+        return None, trace
+    if max_chars > 0 and max_tokens > 0 and len(payload) <= max_chars and len(payload.encode("utf-8")) <= max_tokens:
+        trace.update(strategy="full_context", embedding_called=False)
+        return packs, trace
+    return None, trace
