+def apply_permission_trusted_dirs(
+    rail: Any,
+    *,
+    trusted_dirs: Any = None,
+    project_dir: str | None = None,
+) -> None:
+    """把会话上下文的可信目录写入 PermissionInterruptRail.
+
+    上游 0.2.6 的 ``permission_rail_spec`` 引用了本函数但未随提交带上实现
+    （ceff079c1 漏提交 interrupt_helpers），这里按调用方语义补齐：
+    ``trusted_dirs`` 是目录列表，``project_dir`` 是当前项目目录（同样视为可信），
+    两者合并去重后经 ``set_trusted_dirs`` 下发。
+
+    Args:
+        rail: PermissionInterruptRail 实例（或其他提供 ``set_trusted_dirs`` 的对象）
+        trusted_dirs: 可信目录可迭代对象；None 或空则忽略
+        project_dir: 当前项目目录；存在时并入可信列表
+
+    Raises:
+        AttributeError: rail 未提供 ``set_trusted_dirs`` 方法时
+    """
+    dirs: list[str] = []
+    if isinstance(trusted_dirs, (list, tuple, set)):
+        dirs.extend(str(d) for d in trusted_dirs if str(d).strip())
+    if isinstance(project_dir, str) and project_dir.strip():
+        dirs.append(project_dir.strip())
+    if not dirs:
+        return
+    # 去重保序
+    seen: set[str] = set()
+    unique_dirs = [d for d in dirs if not (d in seen or seen.add(d))]
+    rail.set_trusted_dirs(unique_dirs)
+
+
 def has_interrupt_resume_payload(params: Any) -> bool:
     if not isinstance(params, dict):
         return False
