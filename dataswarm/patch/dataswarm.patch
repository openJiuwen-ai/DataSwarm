+def list_tasks(status: str | None = None, q: str | None = None,
+               limit: int = 100, offset: int = 0) -> list[dict]:
+    """列出任务，支持 status 过滤 + name 模糊查 + 分页。
+
+    Args:
+        status: 按 status 过滤（draft/published），None 不限
+        q: name LIKE 模糊匹配（绑参 f"%{q}%"，不拼进 SQL 文本），None 不限
+        limit: 返回上限，默认 100（对齐 list_instances）
+        offset: 偏移量，默认 0
+    """
+    conn = _connect()
+    try:
+        sql = "SELECT * FROM dw_tasks WHERE 1=1"
+        params: list[Any] = []
+        if status:
+            sql += " AND status=?"
+            params.append(status)
+        if q:
+            sql += " AND LOWER(name) LIKE LOWER(?) ESCAPE '!'"
+            params.append(_search_pattern(q))
+        sql += " ORDER BY updated_at DESC, task_id DESC LIMIT ? OFFSET ?"
+        params.append(limit)
+        params.append(offset)
+        return _fetch_dicts(conn, sql, tuple(params))
+    finally:
+        conn.close()
