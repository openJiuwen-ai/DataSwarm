+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""CTE 名不应被判为 scope 外部对象。
+
+事故背景（dacomp-zh-001）：正常 SQL 用 ``WITH rev AS … / cost AS …``，
+scope_membership 把 CTE 名当物理表报「表 rev、表 cost 不在 scope」，
+组件因此被标终态无法重跑，报告缺整个成分。
+"""
+import sqlglot
+
+from jiuwenswarm.channels.web.dataagent.analysis.checks import _check_scope, cte_names
+from jiuwenswarm.channels.web.dataagent.analysis.model import CHECK_FAIL
+
+
+class TestCteScope:
+    def test_cte_names_extracted(self):
+        parsed = sqlglot.parse_one(
+            "WITH rev AS (SELECT 1 AS x), cost AS (SELECT 2 AS y) "
+            "SELECT rev.x, cost.y FROM rev JOIN cost ON 1=1", read="mysql")
+        assert cte_names(parsed) == {"rev", "cost"}
+
+    def test_cte_not_treated_as_external_table(self):
+        sql = ("WITH rev AS (SELECT 企业代号, SUM(价税合计) AS amt FROM 销项 GROUP BY 企业代号) "
+               "SELECT a.企业代号, rev.amt FROM 企业信息 a LEFT JOIN rev ON rev.企业代号 = a.企业代号")
+        parsed = sqlglot.parse_one(sql, read="mysql")
+        result = _check_scope(parsed, allowed_tables={"企业信息", "销项"}, allowed_columns=set())
+        assert result.status != CHECK_FAIL, result.detail
+
+    def test_real_out_of_scope_table_still_fails(self):
+        parsed = sqlglot.parse_one("SELECT * FROM 越界表", read="mysql")
+        result = _check_scope(parsed, allowed_tables={"企业信息"}, allowed_columns=set())
+        assert result.status == CHECK_FAIL
+        assert "越界表" in result.detail
