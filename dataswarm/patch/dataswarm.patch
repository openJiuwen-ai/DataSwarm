+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 分层泳道布局的纯逻辑（从 flowLanes.tsx 抽出，供 node --test 单测与跨模块复用）。
+//
+// 约束同 flowLanes：层内每行 perRow 个、行内居中、末行补位居中；泳道高度随行数生长。
+// 纯 TS，无 React 依赖 —— 数据管理模块的表血缘图 import 这里而不是 flowLanes.tsx，
+// 避免把 @xyflow/react 运行时拉进 node --test 的 bundle。
+
+/** 数仓分层泳道顺序；不在表里的 laneKey（如字段血缘 L0/L1、OTHER）按首次出现顺序排。 */
+export const LANE_ORDER: Record<string, number> = { SOURCE: 0, ODS: 1, DWD: 2, DWS: 3, ADS: 4 };
+
+export interface LaneLayoutOptions {
+  perRow: number;
+  gapX: number;
+  nodeH?: number;
+  subRowGapY?: number;
+  laneGapY?: number;
+  baseX?: number;
+  baseY?: number;
+  /** 层内按 id 排序（字段血缘要确定性布局；表血缘保持产物顺序） */
+  sortInLane?: boolean;
+}
+
+export interface LaneMeta { key: string; y: number; rows: number; count: number }
+
+/**
+ * 泳道折行布局：层内每行 perRow 个、行内居中、末行补位居中；泳道高度随行数生长。
+ * 关键约束：层内折行把整图长宽比限制在画布量级，fitView 后节点不会缩成蚂蚁。
+ */
+export function laneLayout(
+  items: Array<{ id: string; laneKey: string }>,
+  opts: LaneLayoutOptions,
+): { pos: Record<string, { x: number; y: number }>; lanes: LaneMeta[] } {
+  const nodeH = opts.nodeH ?? 50;
+  const subRowGapY = opts.subRowGapY ?? 96;
+  const laneGapY = opts.laneGapY ?? 112;
+  const baseX = opts.baseX ?? 150;
+  const baseY = opts.baseY ?? 40;
+  const buckets: Record<string, string[]> = {};
+  for (const it of items) (buckets[it.laneKey] ??= []).push(it.id);
+  const laneKeys = Object.keys(buckets).sort(
+    (a, b) => (LANE_ORDER[a] ?? 99) - (LANE_ORDER[b] ?? 99),
+  );
+  const pos: Record<string, { x: number; y: number }> = {};
+  const lanes: LaneMeta[] = [];
+  let yCursor = baseY;
+  for (const key of laneKeys) {
+    const list = opts.sortInLane ? [...buckets[key]].sort() : buckets[key];
+    const rows = Math.ceil(list.length / opts.perRow);
+    const perRow = Math.ceil(list.length / rows);
+    lanes.push({ key, y: yCursor, rows, count: list.length });
+    list.forEach((id, i) => {
+      const row = Math.floor(i / perRow);
+      const col = i % perRow;
+      const rowCount = Math.min(perRow, list.length - row * perRow);
+      pos[id] = {
+        x: baseX + col * opts.gapX + ((perRow - rowCount) * opts.gapX) / 2,
+        y: yCursor + row * subRowGapY,
+      };
+    });
+    yCursor += (rows - 1) * subRowGapY + nodeH + laneGapY;
+  }
+  return { pos, lanes };
+}
