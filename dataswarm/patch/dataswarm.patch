+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""web 层指标模块（新语义通路）单测共享 fixture。
+
+不连真实库、不读真实 config：数据源解析与图存储都用注入或临时目录。
+样例取自随包分发的 ``jiuwenswarm/resources/ossie/commerce-metrics.example.yaml``，
+即方案 ``examples/commerce-metrics.ossie.yaml``（GMV / 支付订单数 / 支付客单价）。
+"""
+from __future__ import annotations
+
+import dataclasses
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, NamedTuple
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import ossie
+from jiuwenswarm.channels.web.dataagent.metrics.model import (
+    MAP_CONFIRMED,
+    MetricDef,
+    Release,
+)
+
+WORKSPACE = "demo"
+RELEASE_ID = "release-001"
+OSSIE_EXAMPLE = (
+    Path(__file__).resolve().parents[3]
+    / "jiuwenswarm" / "resources" / "ossie" / "commerce-metrics.example.yaml"
+)
+
+
+class DemoProjection(NamedTuple):
+    """一份完整的演示投影所需的全部领域对象。"""
+
+    model: ossie.OssieModel
+    metric_keys: list[str]
+    defs: dict[str, MetricDef]
+    revisions: list[Any]
+    revisions_by_key: dict[str, Any]
+    bindings: list[Any]
+    bindings_by_revision: dict[str, list[Any]]
+    candidate_maps: list[Any]
+    confirmed_maps: list[Any]
+    release: Release
+
+    def revision_of(self, metric_key: str) -> Any:
+        """按 metric_key 取修订。"""
+        return self.revisions_by_key[metric_key]
+
+
+def build_demo_projection(*, confirm_maps: bool = True) -> DemoProjection:
+    """从 Ossie 样例构造一份完整领域对象集（纯函数，不打库、不碰磁盘）。"""
+    model = ossie.parse_ossie(OSSIE_EXAMPLE.read_text(encoding="utf-8"))
+    keys = [model.metric_key_of(m) for m in model.metrics]
+
+    def resolver(key: str) -> str:
+        return f"id_{key}"
+
+    defs = {
+        resolver(k): MetricDef(
+            metric_id=resolver(k), workspace_id=WORKSPACE, metric_key=k,
+            name=k.split(".")[-1], description="演示指标",
+        )
+        for k in keys
+    }
+    revisions = ossie.to_revisions(model, WORKSPACE, target_db_type="sqlite",
+                                   metric_id_resolver=resolver)
+    revisions_by_key = dict(zip(keys, revisions))
+    bindings = ossie.resolve_bindings(model, WORKSPACE, revisions_by_key,
+                                      datasource_resolver=lambda alias: "sqlite:///demo.db")
+    bindings_by_revision: dict[str, list[Any]] = {}
+    for binding in bindings:
+        bindings_by_revision.setdefault(binding.revision_id, []).append(binding)
+    candidates = ossie.candidate_mappings(model, WORKSPACE, revisions_by_key)
+    confirmed = (
+        [dataclasses.replace(m, status=MAP_CONFIRMED, confirmed_by="tester") for m in candidates]
+        if confirm_maps else []
+    )
+    release = Release(
+        release_id=RELEASE_ID, workspace_id=WORKSPACE, label="首次发布", status="published",
+        revision_ids=tuple(r.revision_id for r in revisions), checksum="chk-demo-001",
+    )
+    return DemoProjection(
+        model=model, metric_keys=keys, defs=defs, revisions=revisions,
+        revisions_by_key=revisions_by_key, bindings=bindings,
+        bindings_by_revision=bindings_by_revision, candidate_maps=candidates,
+        confirmed_maps=confirmed, release=release,
+    )
+
+
+@pytest.fixture
+def demo() -> DemoProjection:
+    """已确认全部候选映射的演示投影。"""
+    return build_demo_projection(confirm_maps=True)
+
+
+@pytest.fixture(autouse=True)
+def _emb_off_by_default(monkeypatch, tmp_path):
+    """默认关闭 EMB 通道，并把向量缓存目录钉在 tmp。
+
+    开发机 shell 里可能已导出 ``EMBED_API_KEY``/``EMBED_BASE``，不关就会让
+    召回测试真打嵌入端点（网络 + 计费 + 不确定性）。需要 EMB 的用例用
+    ``emb_on`` fixture 显式开启并注入确定性向量桩。
+    """
+    monkeypatch.setenv("DATASWARM_METRICS_EMB_ENABLED", "false")
+    monkeypatch.setenv("DATASWARM_METRICS_EMB_DIR", str(tmp_path / "emb-root"))
+
+
+@pytest.fixture
+def demo_unconfirmed() -> DemoProjection:
+    """候选映射**未确认**的演示投影：不应产生任何概念/依赖边。"""
+    return build_demo_projection(confirm_maps=False)
+
+
+# ==========================================================================
+# e2e 环境：临时 sqlite 元库 + 业务库 + workspace_context 打桩
+# ==========================================================================
+ORDERS_ROWS = [
+    ("o1", "2026-08-01 00:00:00", "east", 100, "PAID"),
+    ("o2", "2026-08-31 23:59:59", "east", 300, "PAID"),
+    ("o3", "2026-08-12 12:00:00", "west", 200, "PAID"),
+    ("o4", "2026-08-13 12:00:00", "north", 999, "PENDING"),
+    ("o5", "2026-09-01 00:00:00", "east", 500, "PAID"),  # 9 月单，应被时间范围排除
+]
+
+
+@dataclass
+class _FakeWorkspace:
+    workspace_id: str = WORKSPACE
+    name: str = "demo"
+    business_db_ref: str = ""
+    metadata_db_ref: str = ""
+
+
+@pytest.fixture
+def e2e(tmp_path, monkeypatch):
+    """搭好全部外部依赖：元库表 + 业务库数据 + workspace_context 打桩。
+
+    Returns:
+        ``{"graph_adapter", "business_ref", "meta_ref", "tmp_path"}``——
+        ``graph_adapter`` 是同事 ``InMemorySemanticaAdapter``（Neo4j 写侧
+        投影的确定性替身，绝连真实 Neo4j）。
+    """
+    import sqlite3
+
+    from jiuwenswarm.channels.web.dataagent.semantic.semantica import (
+        InMemorySemanticaAdapter,
+    )
+    from jiuwenswarm.common import workspace_context
+
+    # 1. 业务库：orders 表 + 5 行夹具
+    business_db = tmp_path / "business.db"
+    with sqlite3.connect(business_db) as conn:
+        conn.execute(
+            "CREATE TABLE orders(order_id TEXT PRIMARY KEY, paid_at TEXT, region TEXT,"
+            " amount_cny NUMERIC, pay_status TEXT)")
+        conn.executemany("INSERT INTO orders VALUES (?,?,?,?,?)", ORDERS_ROWS)
+    business_ref = f"sqlite://{business_db}".replace("\\", "/")
+
+    # 2. 元库：应用全部 dw_metric_* 表 + 索引（含 verified_sql）+ dw_datasources
+    #    （Ossie 导入的 datasource_alias 要经 dw_datasources 解析成 db_ref）
+    #    + dw_semantic_snapshots（指标 schema 供给读这张表——深集成单一通道）
+    #    + dw_ontology_*（glossary 术语通道：召回扩展/桥接测试需要术语表）
+    meta_db = tmp_path / "meta.db"
+    ddl_dir = Path(__file__).resolve().parents[3] / "deploy" / "schema" / "ddl"
+    with sqlite3.connect(meta_db) as conn:
+        for pattern in ("dw_metric_defs.*", "dw_metric_revisions.*", "dw_metric_bindings.*",
+                        "dw_metric_releases.*", "dw_metric_concept_map.*",
+                        "dw_metric_query_log.*", "dw_metric_verified_sql.*",
+                        "idx_metric_*",
+                        "dw_datasources.*", "dw_semantic_snapshots.*",
+                        "dw_ontology_*"):
+            for ddl_file in sorted(ddl_dir.glob(f"{pattern}.sqlite.sql")):
+                conn.execute(ddl_file.read_text(encoding="utf-8").strip())
+        conn.execute(
+            "INSERT INTO dw_datasources (source_id, source_type, name, description, config,"
+            " db_ref, engine, enabled, config_version, created_at, updated_at)"
+            " VALUES ('biz_sales', 'mysql', 'biz_sales', '演示数据源', '{}', ?,"
+            " 'sqlalchemy', 1, 1, '2026-10-08', '2026-10-08')",
+            (business_ref,))
+    meta_ref = f"sqlite://{meta_db}".replace("\\", "/")
+
+    # 3. workspace_context 打桩：store 连元库、guard 授权返回规范化业务库 ref
+    fake = _FakeWorkspace(business_db_ref=business_ref, metadata_db_ref=meta_ref)
+    monkeypatch.setattr(workspace_context, "current_workspace", lambda *a, **k: fake)
+    monkeypatch.setattr(workspace_context, "metadata_db_ref", lambda *a, **k: meta_ref)
+    # validate_ref_in_workspace 的返回值就是 guard 用的规范化 ref，桩必须返回业务库
+    monkeypatch.setattr(
+        workspace_context, "validate_ref_in_workspace", lambda *a, **k: business_ref)
+    monkeypatch.setattr(
+        workspace_context, "resolve_business_ref", lambda *a, **k: business_ref)
+
+    return {
+        "graph_adapter": InMemorySemanticaAdapter(),
+        "business_ref": business_ref, "meta_ref": meta_ref,
+        "tmp_path": tmp_path,
+    }
+
+
+def write_published_snapshot(e2e, source_id: str = "biz_sales") -> str:
+    """模拟一次语义采集：业务库 schema → dw_semantic_snapshots（published）。
+
+    深集成后指标 schema 供给**只**读这张表（严格单一通道），测试用它替代旧
+    「发布时直连活库探查」。幂等：同源旧 published 行先清再写。
+    返回 snapshot_id。
+    """
+    import json as _json
+    import sqlite3
+
+    from jiuwenswarm.channels.web.dataagent.semantic.model import (
+        ColumnMeta, DatabaseMeta, DataSourceMeta, MetadataSnapshot, TableMeta)
+
+    business_db = e2e["tmp_path"] / "business.db"
+    tables: list[TableMeta] = []
+    with sqlite3.connect(str(business_db)) as conn:
+        names = [row[0] for row in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")]
+        for name in names:
+            columns = [
+                ColumnMeta(
+                    source_id=source_id, source_type="mysql",
+                    database="app", table=name, name=col[1],
+                    data_type=str(col[2] or ""), column_type=str(col[2] or ""),
+                    ordinal=int(col[0]) + 1, nullable=not col[5],
+                    column_key="PRI" if col[5] else "")
+                for col in conn.execute(f"PRAGMA table_info({name})")]
+            tables.append(TableMeta(
+                source_id=source_id, source_type="mysql", database="app",
+                name=name, comment="订单宽表" if name == "orders" else "",
+                columns=columns))
+    snapshot = MetadataSnapshot(
+        snapshot_id=f"snapshot-{source_id}-001", run_id=f"run-{source_id}-001",
+        source=DataSourceMeta(source_id, "mysql", e2e["business_ref"]),
+        databases=[DatabaseMeta(source_id, "mysql", "app")],
+        tables=tables, scope={"schemas": ["app"]}, status="published")
+    with sqlite3.connect(str(e2e["tmp_path"] / "meta.db")) as conn:
+        conn.execute("DELETE FROM dw_semantic_snapshots WHERE source_id=?", (source_id,))
+        conn.execute(
+            "INSERT INTO dw_semantic_snapshots (snapshot_id, run_id, source_id, status,"
+            " scope_json, snapshot_json, object_count, relation_count, semantica_version,"
+            " published_at, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+            (snapshot.snapshot_id, snapshot.run_id, source_id, "published",
+             _json.dumps(snapshot.scope), _json.dumps(snapshot.to_dict()),
+             len(snapshot.object_map()), 0, "", "2026-10-12T00:00:00",
+             "2026-10-12T00:00:00"))
+    return snapshot.snapshot_id
