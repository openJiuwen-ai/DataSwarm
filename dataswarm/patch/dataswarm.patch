+
+def test_read_only_sql_guard():
+    assert validate_read_only_sql("  SELECT 1; ") == "SELECT 1"
+    with pytest.raises(QueryValidationError):
+        validate_read_only_sql("DROP TABLE users")
+    with pytest.raises(QueryValidationError):
+        validate_read_only_sql("SELECT 1; SELECT 2")
+
+
+# --------------------------------------------------------------------------
+# 方言收敛批次 2-G9：只读护栏按 source_type 查 registry 选解析方言
+# --------------------------------------------------------------------------
+def test_read_only_sql_guard_dialect_aware():
+    """MySQL 协议族反引号标识符此前被 duckdb 方言 ParseError 误拒。"""
+    sql = "SELECT `cnt` FROM `biz`.`tbl` LIMIT 1"
+    assert validate_read_only_sql(sql, source_type="mysql") == sql
+    assert validate_read_only_sql(sql, source_type="doris") == sql
+    assert validate_read_only_sql('SELECT "x" FROM t', source_type="postgresql") == 'SELECT "x" FROM t'
+    # 写语句跨方言仍拒绝
+    with pytest.raises(QueryValidationError):
+        validate_read_only_sql("DELETE FROM `t`", source_type="mysql")
+    # 默认（duckdb）行为不变
+    assert validate_read_only_sql("SELECT 1") == "SELECT 1"
+
+
+def test_read_only_sql_guard_allows_keywords_and_semicolon_literals():
+    assert validate_read_only_sql("SELECT 'DROP', 'a;b'") == "SELECT 'DROP', 'a;b'"
+
+
+def test_local_path_allows_absolute_paths_outside_data_roots(monkeypatch, tmp_path):
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    allowed = tmp_path / "orders.csv"
+    allowed.write_text("id\n1\n", encoding="utf-8")
+    assert resolve_local_path("orders.csv") == allowed.resolve()
+    outside = tmp_path.parent / "external-orders.csv"
+    assert resolve_local_path(str(outside), must_exist=False) == outside.resolve()
+    with pytest.raises(FileAccessError):
+        resolve_local_path("../external-orders.csv", must_exist=False)
+
+
+def test_duckdb_missing_dependency_is_explicit(tmp_path, monkeypatch):
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    (tmp_path / "events.json").write_text("[]", encoding="utf-8")
+    source = SourceDefinition(
+        source_id="events",
+        source_type="json",
+        name="events",
+        engine="duckdb",
+        config={"location": str(tmp_path / "events.json"), "table_name": "events"},
+    )
+    result = DuckDBConnector(source).test_connection()
+    if result["ok"]:
+        pytest.skip("DuckDB is installed in this environment")
+    assert "DuckDB is not installed" in result["error"]
+
+
+def _csv_dir_source(tmp_path, monkeypatch, files: dict[str, str]):
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    directory = tmp_path / "csvdir"
+    directory.mkdir()
+    for name, content in files.items():
+        (directory / name).write_text(content, encoding="utf-8")
+    return SourceDefinition(
+        source_id="csvdir",
+        source_type="csv",
+        name="csvdir",
+        engine="duckdb",
+        config={"path": str(directory)},
+    )
+
+
+def test_duckdb_csv_directory_one_view_per_file(tmp_path, monkeypatch):
+    pytest.importorskip("duckdb", reason="DuckDB is not installed")
+    source = _csv_dir_source(
+        tmp_path, monkeypatch,
+        {"orders.csv": "id,amount\n1,100\n", "customers.csv": "cid,name\n1,alice\n"},
+    )
+    connector = DuckDBConnector(source)
+
+    catalog = connector.catalog()
+    assert [d["name"] for d in catalog["datasets"]] == ["customers", "orders"]
+
+    schema = connector.schema("orders")
+    assert [c["name"] for c in schema["columns"]] == ["id", "amount"]
+
+    preview = connector.preview("customers", limit=10)
+    assert preview["rows"] == [[1, "alice"]]
+
+    batch = connector.batch_stats()
+    assert set(batch) == {"customers", "orders"}
+    assert len(batch["orders"]["columns"]) == 2
+    assert batch["orders"]["row_count"] == 1
+    assert batch["customers"]["row_count"] == 1
+
+
+def test_duckdb_csv_directory_realtime_sensing(tmp_path, monkeypatch):
+    """目录新增 csv 文件后，下一次 catalog/query 立即可见（无缓存）。"""
+    pytest.importorskip("duckdb", reason="DuckDB is not installed")
+    source = _csv_dir_source(tmp_path, monkeypatch, {"orders.csv": "id\n1\n"})
+    connector = DuckDBConnector(source)
+    assert [d["name"] for d in connector.catalog()["datasets"]] == ["orders"]
+
+    (tmp_path / "csvdir" / "payments.csv").write_text("pid\n9\n", encoding="utf-8")
+    assert [d["name"] for d in connector.catalog()["datasets"]] == ["orders", "payments"]
+    assert connector.query('SELECT COUNT(*) FROM "payments"', limit=1)["rows"] == [[1]]
+
+
+def test_duckdb_csv_directory_empty_catalog_but_query_fails(tmp_path, monkeypatch):
+    pytest.importorskip("duckdb", reason="DuckDB is not installed")
+    source = _csv_dir_source(tmp_path, monkeypatch, {})
+    connector = DuckDBConnector(source)
+
+    assert connector.catalog()["datasets"] == []
+
+    from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError
+    with pytest.raises(ConnectorError, match="no csv files"):
