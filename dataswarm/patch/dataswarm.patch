+  dim: boolean;
+  /** 是否允许通过节点端点交互创建连线 */
+  connectable: boolean;
+  [key: string]: unknown;
+}
+
+function WfNode({ data }: NodeProps) {
+  const { t } = useTranslation();
+  const d = data as WfNodeData;
+  const status = d.runStatus ? (WORKFLOW_STATUS_STYLE[d.runStatus] ?? WORKFLOW_STATUS_STYLE.unknown) : null;
+  const Executor = d.executor === 'python' ? PythonIcon : d.executor === 'sql' ? SqlIcon : TaskIcon;
+  return (
+    <div
+      className="wf-node-card"
+      data-selected={d.isSelected || undefined}
+      data-review={d.waitReview || undefined}
+      data-failure={d.failureRole}
+      style={{ width: d.width, opacity: d.dim ? 0.3 : 1 }}
+    >
+      {status && (
+        <div className="wf-node-status" style={{ color: status.color, background: status.subtle }}>
+          {d.statusIcon}
+          <span>{t(`workflowGraph.status.${d.runStatus}`, { defaultValue: d.runStatus })}</span>
+          {d.durationS != null ? (
+            <span className="wf-node-duration">{t('workflowGraph.duration', { value: d.durationS })}</span>
+          ) : d.runStatus === 'skipped' ? (
+            <span className="wf-node-duration">{t('workflowGraph.notExecuted')}</span>
+          ) : null}
+          {d.failureRole && (
+            <span className="wf-node-failure" title={t(`workflowGraph.failure.${d.failureRole}`)}>
+              {t(`workflowGraph.failure.${d.failureRole}`)}
+            </span>
+          )}
+        </div>
+      )}
+      <Handle
+        id="target"
+        type="target"
+        position={Position.Top}
+        isConnectable={d.connectable}
+        title={d.connectable ? t('workflowGraph.connectTarget') : undefined}
+        style={{ opacity: d.connectable ? 1 : 0 }}
+      />
+      <div className="wf-node-title">
+        <Executor width={24} height={24} />
+        <strong title={d.label}>{d.label}</strong>
+        {d.actions && <div className="nodrag nopan">{d.actions}</div>}
+      </div>
+      <div className="wf-node-info">
+        <div>
+          <TaskIcon width={16} height={16} />
+          <span title={d.taskName}>{d.taskName}</span>
+        </div>
+        {(d.group || d.waitReview) && (
+          <div>
+            <Database size={16} />
+            <span title={d.group}>{d.group}</span>
+            {d.waitReview && <span className="wf-node-review">{t('workflowGraph.reviewNode')}</span>}
+          </div>
+        )}
+      </div>
+      <Handle
+        id="source"
+        type="source"
+        position={Position.Bottom}
+        isConnectable={d.connectable}
+        title={d.connectable ? t('workflowGraph.connectSource') : undefined}
+        style={{ opacity: d.connectable ? 1 : 0 }}
+      />
+    </div>
+  );
+}
+
+const nodeTypes = { wfNode: WfNode };
+
+/** Smooth vertical connections follow the actual dragged node positions. */
+function ChannelEdge({ id, sourceX, sourceY, targetX, targetY, selected, animated, style, markerEnd }: EdgeProps) {
+  const [path] = getBezierPath({
+    sourceX,
+    sourceY,
+    targetX,
+    targetY,
+    sourcePosition: Position.Bottom,
+    targetPosition: Position.Top,
+  });
+  return (
+    <>
+      <BaseEdge id={id} path={path} interactionWidth={24} style={style} markerEnd={markerEnd} />
+      {animated && (
+        <circle r={3} fill="currentColor" style={{ color: style?.stroke }}>
+          <animateMotion dur="1.2s" repeatCount="indefinite" path={path} />
+        </circle>
+      )}
+      {selected && (
+        <path
+          d={path}
+          fill="none"
+          stroke="currentColor"
+          style={{ color: 'var(--color-border-focus)' }}
+          strokeWidth={1}
+          opacity={0.35}
+        />
+      )}
+    </>
+  );
+}
+
+const edgeTypes = { channel: ChannelEdge };
+
+/** Provider 外壳：useReactFlow（fitView）要求上下文在 ReactFlow 之上 */
+export function WorkflowGraph(props: WorkflowGraphProps) {
+  return (
+    <ReactFlowProvider>
+      <WorkflowGraphInner {...props} />
+    </ReactFlowProvider>
+  );
+}
+
+function WorkflowGraphInner({
+  nodes: graphNodes,
+  selectedNodeId,
+  onSelectNode,
+  onNodeDoubleClick: onNodeDblClick,
+  renderNodeActions,
+  onInvalidConnection,
+  readOnly,
+  nodesConnectable = true,
+  onChange,
+  canvasHeight,
+  canvasMinHeight = 420,
+  fitViewOnResize = false,
+  fitViewMaxZoom = 1,
+  canvasOverlay,
+  canvasTools,
+  emptyContent,
+  backgroundGap = 20,
+  highlightSelection = true,
+  renderStatusIcon,
+  focusSelectedNode = false,
+  viewportInsets,
+  zoomOnScroll = true,
+  density = 'comfortable',
+  initialView = 'fit',
+  defaultZoom = 1,
+}: WorkflowGraphProps) {
+  const { t } = useTranslation();
+  const canConnect = !readOnly && nodesConnectable;
+  // 起点固定首行，其余节点按最长上游依赖深度分行，行内由 Dagre 优化顺序。
+  // layoutVersion 由「整理布局」按钮递增，触发 setNodes 忽略已拖拽位置、按最新布局坐标重排。
+  const [layoutVersion, setLayoutVersion] = useState(0);
+  const layerPositions = useMemo(
+    () => layoutWorkflowGraph(graphNodes, density),
+    [graphNodes, density, layoutVersion], // eslint-disable-line react-hooks/exhaustive-deps -- layoutVersion 仅作为重排信号
+  );
+  const metrics = WORKFLOW_GRAPH_METRICS[density];
+  // React Flow centers the measured graph bounds; fixed zoom keeps the requested scale.
+  const readableFitOptions = useMemo<FitViewOptions>(
+    () => ({ minZoom: defaultZoom, maxZoom: defaultZoom, padding: 0 }),
+    [defaultZoom],
+  );
+
+  const { downstream, upstream } = useMemo(() => buildGraphAdj(graphNodes), [graphNodes]);
+  const { fitView, zoomIn, zoomOut, setCenter, getViewport, setViewport, viewportInitialized } = useReactFlow();
+  const zoom = useStore((state) => state.transform[2]);
+  const canvasWidth = useStore((state) => state.width);
+  const canvasActualHeight = useStore((state) => state.height);
+  const nodesInitialized = useNodesInitialized();
+  const focusedNode = useStore((state) => (selectedNodeId ? state.nodeLookup.get(selectedNodeId) : undefined));
+  const focusedX = focusedNode?.internals.positionAbsolute.x;
+  const focusedY = focusedNode?.internals.positionAbsolute.y;
+  const focusedWidth = focusedNode?.measured.width;
+  const focusedHeight = focusedNode?.measured.height;
+  const insetTop = viewportInsets?.top ?? 0;
+  const insetRight = viewportInsets?.right ?? 0;
+  const insetBottom = viewportInsets?.bottom ?? 0;
+  const insetLeft = viewportInsets?.left ?? 0;
+  const hasInsets = !!viewportInsets;
+  const insetsMatchCanvas =
+    viewportInsets?.canvasWidth === canvasWidth && viewportInsets.canvasHeight === canvasActualHeight;
+  const fitViewOptions = useMemo<FitViewOptions>(
+    () => ({
+      padding: hasInsets
+        ? {
+            top: `${insetTop + 24}px`,
+            right: `${insetRight + 24}px`,
+            bottom: `${insetBottom + 24}px`,
+            left: `${insetLeft + 24}px`,
+          }
+        : 0.15,
+      maxZoom: fitViewMaxZoom,
+    }),
+    [hasInsets, insetTop, insetRight, insetBottom, insetLeft, fitViewMaxZoom],
+  );
+
+  // fitViewOnResize：尺寸变化即 fit，另加一次 ~200ms 防抖兜底——iframe 初始挂载时
+  // 容器可能短暂报告一个错误尺寸（0 或布局中途值），fitView 跑在上面就"没铺满"；
+  // 尺寸稳定后补一枪保证最终视图按真实容器计算。
+  const stableFitTimer = useRef<number | undefined>(undefined);
+  useEffect(() => {
+    if (initialView !== 'fit' || !fitViewOnResize || !nodesInitialized || canvasWidth <= 0 || canvasActualHeight <= 0) {
+      return;
+    }
+    void fitView(fitViewOptions);
+    window.clearTimeout(stableFitTimer.current);
+    stableFitTimer.current = window.setTimeout(() => void fitView(fitViewOptions), 200);
+    return () => window.clearTimeout(stableFitTimer.current);
+  }, [initialView, fitViewOnResize, nodesInitialized, canvasWidth, canvasActualHeight, fitView, fitViewOptions]);
+
+  const lastFocusedId = useRef<string | null>(null);
+  useEffect(() => {
+    if (!focusSelectedNode || !selectedNodeId) {
+      lastFocusedId.current = null;
+      return;
+    }
+    if (
+      !hasInsets ||
+      !insetsMatchCanvas ||
+      !nodesInitialized ||
+      !viewportInitialized ||
+      focusedX === undefined ||
+      focusedY === undefined ||
+      !focusedWidth ||
+      !focusedHeight
+    )
+      return;
+    const width = canvasWidth - insetLeft - insetRight - 48;
+    const height = canvasActualHeight - insetTop - insetBottom - 48;
+    if (width <= 0 || height <= 0) return;
+
+    // 优先保留当前比例；只有节点放不进可见区域时，才按实测边界缩小。
+    const viewport = getViewportForBounds(
+      { x: focusedX, y: focusedY, width: focusedWidth, height: focusedHeight },
+      width,
+      height,
+      0.05,
+      getViewport().zoom,
+      0,
+    );
+    // 剩余垂直空白按上 1、下 2 分配，让选中节点偏上，给下游节点留出空间。
+    const verticalOffset = Math.max(0, height - focusedHeight * viewport.zoom) / 6;
+    const animate =
+      lastFocusedId.current !== selectedNodeId && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    lastFocusedId.current = selectedNodeId;
+    void setViewport(
+      {
+        x: viewport.x + insetLeft + 24,
+        y: viewport.y + insetTop + 24 - verticalOffset,
+        zoom: viewport.zoom,
+      },
+      { duration: animate ? 200 : 0, interpolate: 'linear' },
+    );
+  }, [
+    focusSelectedNode,
+    selectedNodeId,
+    hasInsets,
+    insetsMatchCanvas,
+    nodesInitialized,
+    viewportInitialized,
+    focusedX,
+    focusedY,
+    focusedWidth,
+    focusedHeight,
+    canvasWidth,
+    canvasActualHeight,
+    insetTop,
+    insetRight,
+    insetBottom,
+    insetLeft,
+    getViewport,
+    setViewport,
+  ]);
+
+  const selected = selectedNodeId ?? null;
+  const highlightSet = useMemo(() => {
+    if (!selected || !highlightSelection) return new Set<string>();
+    return new Set<string>([...reachable(selected, downstream), ...reachable(selected, upstream)]);
+  }, [selected, downstream, upstream, highlightSelection]);
+
+  const buildNodeData = useCallback(
+    (node: WorkflowGraphNode, hasSel: boolean): WfNodeData => ({
+      width: metrics.width,
+      label: node.label,
+      taskName: node.taskLabel,
+      group: node.group,
+      executor: node.executor,
+      actions: renderNodeActions?.(node.id),
+      waitReview: !!node.waitReview,
+      runStatus: node.status,
+      statusIcon: node.status ? renderStatusIcon?.(node.status) : undefined,
+      durationS: node.durationS,
+      failureRole: node.failureRole,
+      isSelected: selected === node.id,
+      dim: hasSel && !highlightSet.has(node.id),
+      connectable: canConnect,
+    }),
+    [metrics.width, renderNodeActions, renderStatusIcon, selected, highlightSet, canConnect],
+  );
+
+  // 首次挂载节点（初始拓扑位置）
+  const initialNodes = useMemo<Node[]>(() => {
+    const hasSel = highlightSet.size > 0;
+    return graphNodes.map((n) => ({
+      id: n.id,
+      type: 'wfNode',
+      draggable: !readOnly,
+      position: layerPositions[n.id],
+      data: buildNodeData(n, hasSel),
+    }));
+  }, [graphNodes, layerPositions, readOnly, buildNodeData, highlightSet]);
+
+  // 首次挂载边
+  const initialEdges = useMemo<Edge[]>(() => buildEdges(graphNodes, highlightSet), [graphNodes, highlightSet]);
+
+  // 画布节点/边状态（位置、选中由 xyflow 内部 store 管理，拖动不重建全量）
+  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
+  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);
+
+  // 节点或依赖改变时整图重排，不能混用旧坐标和新布局；仅展示数据变化时保留拖拽位置。
+  const layoutKey = JSON.stringify([density, layoutVersion, graphNodes.map((node) => [node.id, node.parents])]);
+  const appliedLayoutKeyRef = useRef(layoutKey);
+  useEffect(() => {
+    const force = appliedLayoutKeyRef.current !== layoutKey;
+    appliedLayoutKeyRef.current = layoutKey;
+    setNodes((prev) => {
+      const existing = new Map(prev.map((n) => [n.id, n]));
+      const hasSel = highlightSet.size > 0;
+      return graphNodes.map((n) => {
+        const id = n.id;
+        const old = existing.get(id);
+        return {
+          ...old,
+          id,
+          type: 'wfNode',
+          draggable: !readOnly,
+          position: force || !old ? layerPositions[id] : old.position,
+          data: buildNodeData(n, hasSel),
+        };
+      });
+    });
+    setEdges((prev) => {
+      const sel = new Set(prev.filter((e) => e.selected).map((e) => e.id));
+      return buildEdges(graphNodes, highlightSet).map((e) => ({ ...e, selected: sel.has(e.id) }));
+    });
+  }, [graphNodes, layerPositions, layoutKey, readOnly, buildNodeData, highlightSet, setNodes, setEdges]);
+
+  // 「整理布局」：按最新依赖深度重排所有节点，并 fitView 全图
+  const onAutoLayout = useCallback(() => {
+    setLayoutVersion((v) => v + 1);
+    if (initialView === 'readable') {
+      void fitView(readableFitOptions);
+      return;
+    }
+    window.setTimeout(() => {
+      void fitView({ ...fitViewOptions, duration: 300 });
+    }, 80);
+  }, [initialView, readableFitOptions, fitView, fitViewOptions]);
+
+  // 连线：建边 → 乐观立即加边（xyflow 受控模式要求 onConnect 里同步 edges，
+  // 否则拖动连接会被判定无效而回滚）+ 回传依赖变化
+  const onConnect = useCallback(
+    (connection: Connection) => {
+      if (!canConnect || !onChange) return;
+      const { source, target } = connection;
+      if (!source || !target) return;
+      // 成环检测：若 target 已有路径可达 source，则加 source→target 会成环，拒绝
+      if (reachable(target, downstream).has(source)) {
+        onInvalidConnection?.('cycle');
+        return;
+      }
+      setEdges((prev) => {
+        const id = graphEdgeId(source, target);
+        if (prev.some((e) => e.id === id)) return prev;
+        return [...prev, buildEdge(source, target, false)];
+      });
+      const next = graphNodes.map((n) => {
+        if (n.id !== target) return n;
+        const ups = n.parents;
+        if (ups.includes(source)) return n;
+        return { ...n, parents: [...ups, source] };
+      });
+      onChange(next);
+    },
+    [canConnect, onChange, graphNodes, downstream, setEdges, onInvalidConnection],
+  );
+
+  const onDelete = useCallback(
+    ({ nodes: deletedNodes, edges: deletedEdges }: { nodes: Node[]; edges: Edge[] }) => {
+      if (readOnly || !onChange) return;
+      onChange(removeGraphElements(graphNodes, new Set(deletedNodes.map((node) => node.id)), deletedEdges));
+    },
+    [readOnly, onChange, graphNodes],
+  );
+
+  const onNodeClick = useCallback(
+    (_: unknown, node: Node) => {
+      if (!onSelectNode) return;
+      const next = selected === node.id ? null : node.id;
+      onSelectNode(next);
+    },
+    [onSelectNode, selected],
+  );
+
+  // 双击节点 → 打开节点信息（由调用方决定呈现方式）；单击仅做上下游高亮，互不干扰
+  const handleNodeDoubleClick = useCallback(
+    (_: unknown, node: Node) => {
+      onNodeDblClick?.(node.id);
+    },
+    [onNodeDblClick],
+  );
+
+  const onPaneClick = useCallback(() => {
+    if (onSelectNode && selected) onSelectNode(null);
+  }, [onSelectNode, selected]);
+
+  // 增删节点时的镜头策略：
+  //   加 1 个节点 → 聚焦到新节点（大图 fitView 后缩得极小，新节点落在远处等于"没显示"）
+  //   删节点/其他变化 → 回全图 fitView
+  const prevIdsRef = useRef<Set<string> | null>(null);
+  useEffect(() => {
+    const curIds = graphNodes.map((n) => n.id);
+    const prev = prevIdsRef.current;
+    prevIdsRef.current = new Set(curIds);
+    if (!prev) return; // 首次挂载不动作（fitView prop 已负责初始视野）
+    const added = curIds.filter((id) => !prev.has(id));
+    const removed = [...prev].filter((id) => !curIds.includes(id));
+    if (initialView === 'readable') {
+      if (added.length || removed.length) void fitView(readableFitOptions);
+      return;
+    }
+    let timer: number | undefined;
+    if (added.length === 1) {
+      const pos = layerPositions[added[0]];
+      timer = window.setTimeout(() => {
+        void setCenter(pos.x + metrics.width / 2, pos.y + metrics.height / 2, { zoom: 0.9, duration: 300 });
+      }, 80);
+    } else if (added.length > 0 || removed.length > 0) {
+      timer = window.setTimeout(() => {
+        void fitView({ ...fitViewOptions, duration: 200 });
+      }, 80);
+    }
+    return () => window.clearTimeout(timer);
+  }, [graphNodes, layerPositions, metrics, initialView, readableFitOptions, setCenter, fitView, fitViewOptions]);
+
+  return (
+    <div className="wf-dag-root" data-density={density}>
+      <div
+        style={{ height: canvasHeight ?? 'min(620px, calc(100vh - 280px))', minHeight: canvasMinHeight }}
+        className="wf-dag-canvas rounded-lg border border-border"
+      >
+        <ReactFlow
+          nodes={nodes}
+          edges={edges}
+          nodeTypes={nodeTypes}
+          edgeTypes={edgeTypes}
+          onNodesChange={onNodesChange}
+          onEdgesChange={onEdgesChange}
+          onConnect={onConnect}
+          onDelete={onDelete}
+          onNodeClick={onNodeClick}
+          onNodeDoubleClick={handleNodeDoubleClick}
+          onPaneClick={onPaneClick}
+          // Loose 模式：从节点本体任意位置拖动即可建边，不必精确命中 Handle 圆点
+          connectionMode={ConnectionMode.Loose}
+          nodesConnectable={canConnect}
+          edgesFocusable={!readOnly}
+          deleteKeyCode={readOnly ? null : ['Backspace', 'Delete']}
+          // 左键直接拖动画布（节点多时不再"拖不动"）；Shift+左键框选（xyflow 默认 selectionKeyCode）
+          panOnDrag
+          zoomOnScroll={zoomOnScroll}
+          // xyflow 默认 minZoom=0.5：节点多时缩不下去、看不了全图，放开到 0.05
+          minZoom={0.05}
+          maxZoom={2}
+          fitView
+          fitViewOptions={initialView === 'readable' ? readableFitOptions : fitViewOptions}
+          proOptions={{ hideAttribution: true }}
+          ariaLabelConfig={{
+            'controls.ariaLabel': t('workflowGraph.controls'),
+            'controls.zoomIn.ariaLabel': t('workflowGraph.zoomIn'),
+            'controls.zoomOut.ariaLabel': t('workflowGraph.zoomOut'),
+            'controls.fitView.ariaLabel': t('workflowGraph.fitView'),
+            'controls.interactive.ariaLabel': t('workflowGraph.toggleInteractivity'),
+          }}
+        >
+          <Background variant={BackgroundVariant.Dots} gap={backgroundGap} size={1} />
+          <Panel position="bottom-left">
+            <div className="wf-canvas-toolbar" role="group" aria-label={t('workflowGraph.controls')}>
+              <button
+                type="button"
+                aria-label={t('workflowGraph.resetLayout')}
+                title={t('workflowGraph.resetLayout')}
+                onClick={onAutoLayout}
+              >
+                <RelayoutIcon width={16} height={16} aria-hidden="true" />
+              </button>
+              <span className="wf-toolbar-divider" aria-hidden="true" />
+              <button
+                type="button"
+                aria-label={t('workflowGraph.zoomOut')}
+                title={t('workflowGraph.zoomOut')}
+                onClick={() => {
+                  void zoomOut();
+                }}
+              >
+                <Minus size={16} />
+              </button>
+              {initialView === 'readable' ? (
+                <button
+                  type="button"
+                  className="wf-zoom"
+                  aria-label={t('workflowGraph.resetView', { percent: Math.round(defaultZoom * 100) })}
+                  title={t('workflowGraph.resetView', { percent: Math.round(defaultZoom * 100) })}
+                  onClick={() => {
+                    void fitView(readableFitOptions);
+                  }}
+                >
+                  {Math.round(zoom * 100)}%
+                </button>
+              ) : (
+                <span className="wf-zoom">{Math.round(zoom * 100)}%</span>
+              )}
+              <button
+                type="button"
+                aria-label={t('workflowGraph.zoomIn')}
+                title={t('workflowGraph.zoomIn')}
+                onClick={() => {
+                  void zoomIn();
+                }}
+              >
+                <Plus size={16} />
+              </button>
+              {canvasTools ? <span className="wf-toolbar-divider" aria-hidden="true" /> : null}
+              {canvasTools}
+            </div>
+          </Panel>
+          {!graphNodes.length && (
+            <div className="wf-empty">
+              {emptyContent ?? t(readOnly ? 'workflowGraph.emptyReadOnly' : 'workflowGraph.empty')}
+            </div>
+          )}
+        </ReactFlow>
+        {canvasOverlay}
+      </div>
+    </div>
+  );
+}
+
+/** Used by optimistic connections and by full graph synchronization. */
+function buildEdge(source: string, target: string, onPath: boolean, failure = false): Edge {
+  const color = failure
+    ? 'var(--color-feedback-danger)'
+    : onPath
+      ? 'var(--color-border-focus)'
+      : 'var(--color-text-placeholder)';
+  return {
+    id: graphEdgeId(source, target),
+    source,
+    target,
+    type: 'channel',
+    animated: failure || onPath,
+    interactionWidth: 24,
+    zIndex: failure ? 5 : 0,
+    style: { stroke: color, strokeWidth: failure || onPath ? 2 : 1.5, strokeDasharray: failure ? '6 4' : undefined },
+    markerEnd: { type: MarkerType.ArrowClosed, color },
+  };
+}
+
+function buildEdges(nodes: WorkflowGraphNode[], highlightSet: Set<string>): Edge[] {
+  const hasSel = highlightSet.size > 0;
+  const byId = new Map(nodes.map((node) => [node.id, node]));
+  return nodes.flatMap((node) =>
+    node.parents.map((parent) => {
+      const onPath = hasSel && highlightSet.has(parent) && highlightSet.has(node.id);
+      const failure = node.failureRole === 'blocked' && !!byId.get(parent)?.failureRole;
+      const edge = buildEdge(parent, node.id, onPath, failure);
+      return { ...edge, style: { ...edge.style, opacity: hasSel && !onPath ? 0.15 : 1 } };
+    }),
+  );
+}
