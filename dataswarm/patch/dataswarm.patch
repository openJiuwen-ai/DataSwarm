+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""生成跨数据源分析验收共用的 5 万行 fixture。
+
+用法：make_fixture.py <output_dir>。同一事实表输出 CSV、JSON 和 Parquet，
+另含地区、品类维表。日期、空值和汇总哨兵行用于校验五道分析题的固定答案。
+"""
+import sys
+from pathlib import Path
+
+import duckdb
+
+OUT = Path(sys.argv[1]).resolve()
+OUT.mkdir(parents=True, exist_ok=True)
+
+con = duckdb.connect(database=":memory:")
+
+# ---- 维表 1：地区（4 个真实地区 + 1 个哨兵汇总行）----
+con.execute("""
+CREATE TABLE dim_region AS
+SELECT * FROM (VALUES
+    (1, '华东'), (2, '华南'), (3, '华北'), (4, '西南'), (9, '全部')
+) AS t(region_id, region_name)
+""")
+
+# ---- 维表 2：品类 ----
+con.execute("""
+CREATE TABLE dim_category AS
+SELECT * FROM (VALUES
+    (1, '家电'), (2, '服饰'), (3, '食品'), (4, '图书')
+) AS t(category_id, category_name)
+""")
+
+# ---- 事实表：5 万行，跨 2025-01-01 ~ 2026-12-31 ----
+# 金额空值用于验证空值比例；region_id=9 标记待过滤的汇总哨兵行。
+con.execute("""
+CREATE TABLE fact_orders AS
+WITH base AS (
+    SELECT
+        i AS order_id,
+        DATE '2025-01-01' + CAST((i * 13) % 730 AS INTEGER) AS order_date,
+        CASE WHEN i % 167 = 0 THEN 9 ELSE 1 + (i % 4) END AS region_id,
+        1 + (i % 4) AS category_id,
+        CASE WHEN i % 14 = 0 THEN NULL
+             ELSE ROUND(((i * 37) % 9000) / 100.0 + 5, 2) END AS order_amt,
+        1 + (i % 3) AS order_qty,
+        CASE (i % 3) WHEN 0 THEN 'APP' WHEN 1 THEN 'WEB' ELSE 'MINI' END AS channel_name
+    FROM range(1, 50001) AS r(i)
+)
+SELECT * FROM base
+""")
+
+for name in ("fact_orders", "dim_region", "dim_category"):
+    for fmt in ("parquet", "json", "csv"):
+        target = OUT / f"{name}.{fmt}"
+        if fmt == "parquet":
+            con.execute(f"COPY {name} TO '{target.as_posix()}' (FORMAT PARQUET)")
+        elif fmt == "json":
+            con.execute(f"COPY {name} TO '{target.as_posix()}' (FORMAT JSON, ARRAY false)")
+        else:
+            con.execute(f"COPY {name} TO '{target.as_posix()}' (FORMAT CSV, HEADER)")
+
+rows = con.execute("SELECT count(*) FROM fact_orders").fetchone()[0]
+nulls = con.execute("SELECT count(*) FROM fact_orders WHERE order_amt IS NULL").fetchone()[0]
+sentinel = con.execute("SELECT count(*) FROM fact_orders WHERE region_id = 9").fetchone()[0]
+print(f"fact_orders rows={rows} amount_nulls={nulls} sentinel_rows={sentinel}")
+print(f"written to {OUT}")
+for p in sorted(OUT.iterdir()):
+    print(f"  {p.name:28s} {p.stat().st_size:>10,} bytes")
