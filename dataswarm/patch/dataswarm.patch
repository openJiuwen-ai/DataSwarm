+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan/service.py — 方案 CRUD + 文件路径辅助。
+
+DAO 编排：全部委托 meta_data（元数据存储）；plan 文件读取用本地 IO。
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+from ..meta_data import get_store as _get_store
+
+
+# --------------------------------------------------------------------------
+# Plan 文件路径辅助
+# --------------------------------------------------------------------------
+def _get_plans_dir() -> Path:
+    plans_dir = Path(get_user_workspace_dir()) / "plans"
+    plans_dir.mkdir(parents=True, exist_ok=True)
+    return plans_dir
+
+
+def _get_plan_file_path(plan_id: str) -> Path:
+    return _get_plans_dir() / f"{plan_id}.json"
+
+
+# --------------------------------------------------------------------------
+# 方案 CRUD — 委托 meta_data
+# --------------------------------------------------------------------------
+def save_plan(name: str, business: str = "", purpose: str = "",
+              content_json: str = "", plan_id: str = "",
+              plan_data: dict | None = None) -> dict:
+    return _get_store().save_plan(plan_id, name, business, purpose,
+                                   content_json=content_json,
+                                   plan_data=plan_data)
+
+
+def get_plan(plan_id: str) -> dict | None:
+    return _get_store().get_plan(plan_id)
+
+
+def list_plans(business: str = "") -> list[dict]:
+    return _get_store().list_plans(business)
+
+
+def update_plan(plan_id: str, **fields) -> dict | None:
+    return _get_store().update_plan(plan_id, **fields)
+
+
+def get_plan_tables(plan_id: str) -> list[dict]:
+    return _get_store().get_plan_tables(plan_id)
+
+
+def save_plan_tables(plan_id: str, tables: list[dict]) -> dict:
+    """经元数据存储批量 upsert 方案表索引。"""
+    normalized = []
+    for table in tables:
+        row = dict(table)
+        source_tables = row.get("source_tables")
+        if isinstance(source_tables, list):
+            row["source_tables"] = json.dumps(source_tables, ensure_ascii=False)
+        normalized.append(row)
+    return _get_store().save_plan_tables(plan_id, normalized)
+
+
+def get_plan_file_path(plan_id: str) -> str | None:
+    """返回 plan 文件路径（从 DB 索引行）。"""
+    return _get_store().get_plan_file_path(plan_id)
+
+
+def read_plan_file(plan_id: str) -> dict | None:
+    """直接读 plan JSON 文件，返回完整 plan dict（含 tables）。
+    不存在时 fallback 到 meta_data.get_plan。"""
+    plan_file = _get_plan_file_path(plan_id)
+    if plan_file.is_file():
+        with open(plan_file, "r", encoding="utf-8") as f:
+            return json.load(f)
+    return _get_store().get_plan(plan_id)
