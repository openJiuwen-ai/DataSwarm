+        </div>
+      )}
+      {(collection.duplicateUids.length > 0 || collection.rows.some(row => row.selectionIssue === 'missing_uid')) && (
+        <div className="gov-inline-notice">
+          <AlertTriangle size={15} aria-hidden="true" />
+          {t('governance.anomalies.selection.invalidIdentity')}
+        </div>
+      )}
+
+      <Table
+        className="gov-anomaly-table-wrap"
+        headers={[
+          <input
+            key="check"
+            ref={setPageCheckboxRef}
+            type="checkbox"
+            checked={allPageSelected}
+            onChange={toggleCurrentPage}
+            disabled={selectablePageRows.length === 0}
+            aria-label={t('governance.anomalies.selection.currentPage')}
+          />,
+          t('governance.anomalies.table.id'),
+          t('governance.anomalies.table.severity'),
+          t('governance.anomalies.table.dimension'),
+          t('governance.anomalies.table.category'),
+          t('governance.anomalies.table.description'),
+          t('governance.anomalies.table.detail'),
+          t('governance.anomalies.table.suggestion'),
+        ]}
+      >
+        {pageRows.map(row => {
+          const { finding } = row;
+          const isChecked = row.uid !== null && selectedSet.has(row.uid);
+          return (
+            <tr key={`${row.artifactKey}:${row.sourceIndex}`} data-selected={isChecked || undefined}>
+              <td className="gov-anomaly-check">
+                <input
+                  type="checkbox"
+                  checked={isChecked}
+                  disabled={!row.selectable || row.uid === null}
+                  onChange={() => row.uid && toggleFindingSelection(row.uid)}
+                  aria-label={t('governance.anomalies.selection.row', { summary: finding.summary })}
+                  title={row.selectionIssue ? t(`governance.anomalies.selection.${row.selectionIssue}`) : undefined}
+                />
+              </td>
+              <td>
+                <span className="gov-anomaly-id" title={row.uid ?? undefined}>
+                  {shortFindingId(finding)}
+                </span>
+              </td>
+              <td>
+                <span className="gov-tag" data-sev={finding.severity}>
+                  {t(`governance.severity.${finding.severity}`)}
+                </span>
+              </td>
+              <td>
+                <span className="gov-dimension-label">{t(`governance.dimensions.${row.dimension}`)}</span>
+              </td>
+              <td>
+                <span>{t(`governance.categories.${finding.category}`, { defaultValue: finding.category })}</span>
+              </td>
+              <td className="gov-anomaly-description">
+                <strong title={[findingSubject(finding) !== '—' ? findingSubject(finding) : '', finding.summary].filter(Boolean).join(' ')}>
+                  {findingSubject(finding) !== '—' && <span className="gov-anomaly-subject">{findingSubject(finding)}</span>}
+                  {finding.summary}
+                </strong>
+              </td>
+              <td className="gov-anomaly-detail" title={finding.detail}>
+                {finding.detail || '—'}
+              </td>
+              <td className="gov-anomaly-suggestion">
+                {finding.fix_hint?.strategy ? t(`governance.strategies.${finding.fix_hint.strategy}`, { defaultValue: finding.fix_hint.strategy }) : '—'}
+              </td>
+            </tr>
+          );
+        })}
+        {pageRows.length === 0 && (
+          <tr>
+            <td colSpan={8} className="gov-anomaly-empty">
+              {t('governance.anomalies.noMatches')}
+            </td>
+          </tr>
+        )}
+      </Table>
+
+      <Pagination
+        total={filteredRows.length}
+        page={visiblePage}
+        pageSize={pageSize}
+        pageSizeOptions={[20, 50, 100]}
+        onPageChange={setPage}
+        onPageSizeChange={size => {
+          setPageSize(size);
+          setPage(1);
+        }}
+        labels={{
+          total: t('common.pagination.total', { count: filteredRows.length }),
+          pageSize: t('common.pagination.pageSize'),
+          previous: t('common.pagination.previous'),
+          next: t('common.pagination.next'),
+          page: item => t('common.pagination.page', { page: item }),
+          navLabel: t('common.pagination.navLabel'),
+        }}
+      />
+    </div>
+  );
+}
