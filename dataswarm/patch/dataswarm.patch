+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/meta_data/sqlite_store.py — SQLite 元数据存储实现。
+
+全部 SQL 使用 ? 占位符，TEXT/INTEGER 类型。
+连接复用 orchestration.db 的 _connect() / _exec()。
+建表委托 orchestration.db.init_db() 走 deploy/schema/ddl/ 唯一真相源。
+
+Plan 存储策略：plan JSON 写到 <workspace>/plans/<plan_id>.json，
+DB 只存轻量索引行（plan_id, plan_name, status, plan_file_path 等）。
+读取时优先从文件读完整 plan，fallback 到 DB（向后兼容旧方案）。
+"""
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime
+from pathlib import Path
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    new_id,
+)
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+from .base import MetadataStore, register
+
+
+def _now_dt() -> str:
+    return timeutil.now_db_datetime()
+
+
+def _dumps_json(value: object) -> str | None:
+    """JSON 序列化落库到 TEXT 列（dict/list → 字符串，None 原样）。"""
+    if value is None:
+        return None
+    return json.dumps(value, ensure_ascii=False)
+
+
+
+def _get_plans_dir() -> Path:
+    plans_dir = Path(get_user_workspace_dir()) / "plans"
+    plans_dir.mkdir(parents=True, exist_ok=True)
+    return plans_dir
+
+
+def _get_plan_file_path(plan_id: str) -> Path:
+    return _get_plans_dir() / f"{plan_id}.json"
+
+
+def _write_plan_file(plan_id: str, plan_data: dict) -> str:
+    """原子写 plan JSON 文件，返回文件路径字符串。"""
+    target = _get_plan_file_path(plan_id)
+    tmp = target.with_suffix(".json.tmp")
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(plan_data, f, ensure_ascii=False, indent=2)
+    os.replace(str(tmp), str(target))
+    return str(target)
+
+
+def _read_plan_file(plan_id: str) -> dict | None:
+    """读 plan JSON 文件，不存在返回 None。"""
+    path = _get_plan_file_path(plan_id)
+    if not path.is_file():
+        return None
+    with open(path, "r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+@register
+class SqliteMetadataStore(MetadataStore):
+    store_type = "sqlite"
+
+    # ---- Plan CRUD ----
+
+    def save_plan(self, plan_id: str, name: str, business: str,
+                  purpose: str, content_json: str = "",
+                  plan_data: dict | None = None) -> dict:
+        now = _now_dt()
+        if not plan_id:
+            plan_id = new_id("plan")
+
+        # 解析 plan_data：优先使用传入的 dict，否则从 content_json 解析
+        if plan_data is None and content_json:
+            try:
+                plan_data = json.loads(content_json)
+            except (json.JSONDecodeError, TypeError):
+                plan_data = None
+
+        # 从 plan_data 提取落库字段（DB 行自包含，供 orch_db 直读路径如 plan_to_tasks 使用）
+        pd = plan_data or {}
+        status = pd.get("status") or "designing"
+        source_type = pd.get("source_type") or "csv"
+        source_config_json = _dumps_json(pd.get("source_config"))
+        layer_config_json = _dumps_json(pd.get("layer_config"))
+
+        # 写 plan 文件
+        plan_file_path = ""
+        if plan_data:
+            plan_data.setdefault("plan_id", plan_id)
+            plan_data.setdefault("name", name)
+            plan_data.setdefault("business", business)
+            plan_data.setdefault("purpose", purpose)
+            plan_file_path = _write_plan_file(plan_id, plan_data)
+
+        conn = _connect()
+        try:
+            existing = _fetch_one_dict(
+                conn, "SELECT plan_id FROM plan WHERE plan_id = ?", (plan_id,))
+            if existing:
+                fields: dict = {"updated_at": now}
+                if name:
+                    fields["plan_name"] = name
+                if business:
+                    fields["biz_domain"] = business
+                    fields["biz_database"] = business
+                if purpose:
+                    fields["purpose"] = purpose
+                if plan_file_path:
+                    fields["plan_file_path"] = plan_file_path
+                if "status" in pd:
+                    fields["status"] = pd["status"]
+                if "source_type" in pd:
+                    fields["source_type"] = pd["source_type"]
+                if source_config_json is not None:
+                    fields["source_config"] = source_config_json
+                if layer_config_json is not None:
+                    fields["layer_config"] = layer_config_json
+                sets = [f"{k} = ?" for k in fields]
+                vals = list(fields.values()) + [plan_id]
+                _exec(conn, f"UPDATE plan SET {', '.join(sets)} WHERE plan_id = ?",
+                      tuple(vals))
+            else:
+                _exec(
+                    conn,
+                    "INSERT INTO plan (plan_id, plan_name, biz_database, biz_domain, "
+                    "status, source_type, source_config, layer_config, purpose, plan_file_path, "
+                    "created_at, updated_at, created_by) "
+                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                    (plan_id, name, business, business, status, source_type,
+                     source_config_json, layer_config_json, purpose, plan_file_path,
+                     now, now, "system"),
+                )
+
+            conn.commit()
+            result = self.get_plan(plan_id) or {"plan_id": plan_id, "plan_name": name}
+            return result
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    def get_plan(self, plan_id: str) -> dict | None:
+        conn = _connect()
+        try:
+            row = _fetch_one_dict(
+                conn, "SELECT * FROM plan WHERE plan_id = ?", (plan_id,))
+            if not row:
+                return None
+            _normalize_plan_row(row)
+
+            # 优先从 plan 文件读取完整数据
+            file_path = row.get("plan_file_path")
+            if file_path and Path(file_path).is_file():
+                plan_data = _read_plan_file(plan_id)
+                if plan_data:
+                    # 用文件数据丰富 DB 索引行
+                    for k in ("source_type", "source_config", "layer_config"):
+                        if k in plan_data:
+                            row[k] = plan_data[k]
+                    row["tables"] = plan_data.get("tables", [])
+                    return row
+
+            # Fallback：旧方案从 DB 读 content_json + plan_table
+            if row.get("content_json"):
+                try:
+                    cj = json.loads(row["content_json"])
+                    if isinstance(cj, dict):
+                        for k in ("source_type", "source_config", "layer_config"):
+                            if k in cj:
+                                row[k] = cj[k]
+                except (json.JSONDecodeError, TypeError):
+                    pass
+            row["tables"] = self.get_plan_tables(plan_id)
+            return row
+        finally:
+            conn.close()
+
+    def list_plans(self, business: str = "") -> list[dict]:
+        conn = _connect()
+        try:
+            if business:
+                rows = _fetch_dicts(
+                    conn,
+                    "SELECT * FROM plan WHERE biz_domain = ? ORDER BY created_at DESC",
+                    (business,))
+            else:
+                rows = _fetch_dicts(conn, "SELECT * FROM plan ORDER BY created_at DESC")
+            for r in rows:
+                _normalize_plan_row(r)
+            return rows
+        finally:
+            conn.close()
+
+    def get_plan_file_path(self, plan_id: str) -> str | None:
+        conn = _connect()
+        try:
+            row = _fetch_one_dict(
+                conn, "SELECT plan_file_path FROM plan WHERE plan_id = ?", (plan_id,))
+            return row.get("plan_file_path") if row and row.get("plan_file_path") else None
+        finally:
+            conn.close()
+
+    def update_plan(self, plan_id: str, **fields) -> dict | None:
+        if not fields:
+            return self.get_plan(plan_id)
+        mapped: dict = {}
+        for k, v in fields.items():
+            if k == "name":
+                mapped["plan_name"] = v
+            elif k == "business":
+                mapped["biz_domain"] = v
+                mapped["biz_database"] = v
+            else:
+                mapped[k] = v
+        sets = []
+        vals = []
+        for k, v in mapped.items():
+            sets.append(f"{k} = ?")
+            vals.append(v)
+        vals.append(_now_dt())
+        sets.append("updated_at = ?")
+        vals.append(plan_id)
+        conn = _connect()
+        try:
+            _exec(conn, f"UPDATE plan SET {', '.join(sets)} WHERE plan_id = ?",
+                  tuple(vals))
+            conn.commit()
+            return self.get_plan(plan_id)
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    def get_plan_tables(self, plan_id: str) -> list[dict]:
+        # 优先从 plan 文件读取 tables
+        plan_data = _read_plan_file(plan_id)
+        if plan_data and "tables" in plan_data:
+            tables = plan_data["tables"]
+            # 按 layer 排序
+            layer_order = {"ODS": 0, "DWD": 1, "DWS": 2, "ADS": 3}
+            return sorted(tables, key=lambda t: (layer_order.get(t.get("layer", ""), 4), t.get("table_name", "")))
+        # Fallback：DB plan_table
+        conn = _connect()
+        try:
+            return _fetch_dicts(
+                conn,
+                "SELECT * FROM plan_table WHERE plan_id = ? ORDER BY "
+                "CASE layer WHEN 'ODS' THEN 0 WHEN 'DWD' THEN 1 "
+                "WHEN 'DWS' THEN 2 WHEN 'ADS' THEN 3 ELSE 4 END, table_name",
+                (plan_id,),
+            )
+        finally:
+            conn.close()
+
+    # ---- Plan 查重 ----
+
+    def find_recent_plan(self, biz_database: str, source_type: str = "csv") -> dict | None:
+        conn = _connect()
+        try:
+            row = _fetch_one_dict(
+                conn,
+                "SELECT plan_id FROM plan WHERE biz_database = ? AND source_type = ? "
+                "ORDER BY created_at DESC LIMIT 1",
+                (biz_database, source_type),
+            )
+            if not row:
+                return None
+            return self.get_plan(row["plan_id"])
+        finally:
+            conn.close()
+
+    # ---- PlanTable（DB-only 读写，供脚本状态机）----
+
+    def list_plan_tables(self, plan_id: str, layer: str | None = None,
+                         status: str | None = None) -> list[dict]:
+        conn = _connect()
+        try:
+            conds = ["plan_id = ?"]
+            params: list = [plan_id]
+            if layer:
+                conds.append("layer = ?")
+                params.append(layer)
+            if status:
+                conds.append("status = ?")
+                params.append(status)
+            sql = (
+                "SELECT * FROM plan_table WHERE " + " AND ".join(conds) +
+                " ORDER BY CASE layer WHEN 'ODS' THEN 0 WHEN 'DWD' THEN 1 "
+                "WHEN 'DWS' THEN 2 WHEN 'ADS' THEN 3 ELSE 4 END, table_name"
+            )
+            return _fetch_dicts(conn, sql, tuple(params))
+        finally:
+            conn.close()
+
+    def save_plan_tables(self, plan_id: str, tables: list[dict]) -> dict:
+        now = _now_dt()
+        conn = _connect()
+        inserted = 0
+        updated = 0
+        try:
+            for t in tables:
+                table_name = t["table_name"]
+                exists = _fetch_one_dict(
+                    conn,
+                    "SELECT 1 AS x FROM plan_table WHERE plan_id = ? AND table_name = ?",
+                    (plan_id, table_name),
+                )
+                if exists:
+                    _exec(
+                        conn,
+                        "UPDATE plan_table SET layer = ?, ddl_sql = ?, etl_sql = ?, "
+                        "source_tables = ?, status = ?, reuse_of_plan_id = ?, updated_at = ? "
+                        "WHERE plan_id = ? AND table_name = ?",
+                        (t.get("layer"), t.get("ddl_sql"), t.get("etl_sql"),
+                         t.get("source_tables"), t.get("status", "designed"),
+                         t.get("reuse_of_plan_id"), now, plan_id, table_name),
+                    )
+                    updated += 1
+                else:
+                    _exec(
+                        conn,
+                        "INSERT INTO plan_table (plan_id, table_name, layer, ddl_sql, etl_sql, "
+                        "source_tables, status, reuse_of_plan_id, created_at, updated_at) "
+                        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                        (plan_id, table_name, t.get("layer"), t.get("ddl_sql"),
+                         t.get("etl_sql"), t.get("source_tables"), t.get("status", "designed"),
+                         t.get("reuse_of_plan_id"), now, now),
+                    )
+                    inserted += 1
+            conn.commit()
+            return {"inserted": inserted, "updated": updated}
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    # ---- Table Lineage CRUD ----
+
+    def list_table_lineage(self, db_name: str, plan_id: str | None = None,
+                           business_ref: str | None = None) -> list[dict]:
+        conn = _connect()
+        try:
+            sql = (
+                "SELECT lineage_id, plan_id, source_db, source_table, "
+                "target_db, target_table, join_key, lineage_type, "
+                "transformation, task_id, business_ref, created_at "
+                "FROM table_lineage "
+                "WHERE (source_db = ? OR target_db = ?)"
+            )
+            params: list = [db_name, db_name]
+            if business_ref is not None:
+                sql += " AND business_ref = ?"
+                params.append(business_ref)
+            if plan_id:
+                sql += " AND plan_id = ?"
+                params.append(plan_id)
+            return _fetch_dicts(conn, sql, tuple(params))
+        finally:
+            conn.close()
+
+    def save_table_lineage(self, edges: list[dict]) -> int:
+        now = _now_dt()
+        conn = _connect()
+        count = 0
+        try:
+            for e in edges:
+                lid = e.get("lineage_id") or new_id("lin")
+                _exec(
+                    conn,
+                    "INSERT INTO table_lineage "
+                    "(lineage_id, plan_id, source_db, source_table, "
+                    "target_db, target_table, join_key, lineage_type, "
+                    "transformation, task_id, business_ref, created_at) "
+                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                    (lid, e.get("plan_id", ""), e.get("source_db", ""),
+                     e.get("source_table", ""), e.get("target_db", ""),
+                     e.get("target_table", ""), e.get("join_key"),
+                     e.get("lineage_type", "etl"), e.get("transformation"),
+                     e.get("task_id"), e.get("business_ref"), now),
+                )
+                count += 1
+            conn.commit()
+            return count
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    def delete_table_lineage(self, plan_id: str, task_id: str | None = None) -> int:
+        """按 plan_id（+ 可选 task_id）删除。task_id=None 时按 plan_id 单条件删（§5.4 G6）。"""
+        conn = _connect()
+        try:
+            if task_id is None:
+                cur = _exec(conn, "DELETE FROM table_lineage WHERE plan_id = ?", (plan_id,))
+            else:
+                cur = _exec(
+                    conn,
+                    "DELETE FROM table_lineage WHERE plan_id = ? AND task_id = ?",
+                    (plan_id, task_id),
+                )
+            conn.commit()
+            return cur.rowcount if hasattr(cur, "rowcount") else 0
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    # ---- Column Lineage CRUD ----
+
+    def list_column_lineage(self, db_name: str, table_name: str = "",
+                            business_ref: str | None = None) -> list[dict]:
+        conn = _connect()
+        try:
+            sql = (
+                "SELECT column_lineage_id, plan_id, source_db, source_table, "
+                "source_column, target_db, target_table, target_column, "
+                "transformation, task_id, business_ref, created_at "
+                "FROM column_lineage WHERE "
+            )
+            params: list = []
+            if table_name:
+                sql += "(target_db = ? AND target_table = ?) "
+                sql += "OR (source_db = ? AND source_table = ?)"
+                params.extend((db_name, table_name, db_name, table_name))
+            else:
+                sql += "source_db = ? OR target_db = ?"
+                params.extend((db_name, db_name))
+            if business_ref is not None:
+                sql += " AND business_ref = ?"
+                params.append(business_ref)
+            return _fetch_dicts(conn, sql, tuple(params))
+        finally:
+            conn.close()
+
+    def save_column_lineage(self, edges: list[dict]) -> int:
+        now = _now_dt()
+        conn = _connect()
+        count = 0
+        try:
+            for e in edges:
+                cid = e.get("column_lineage_id") or new_id("clin")
+                _exec(
+                    conn,
+                    "INSERT INTO column_lineage "
+                    "(column_lineage_id, plan_id, source_db, source_table, "
+                    "source_column, target_db, target_table, target_column, "
+                    "transformation, task_id, business_ref, created_at) "
+                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                    (cid, e.get("plan_id", ""), e.get("source_db", ""),
+                     e.get("source_table", ""), e.get("source_column", ""),
+                     e.get("target_db", ""), e.get("target_table", ""),
+                     e.get("target_column", ""), e.get("transformation"),
+                     e.get("task_id"), e.get("business_ref"), now),
+                )
+                count += 1
+            conn.commit()
+            return count
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    def delete_column_lineage(self, plan_id: str, task_id: str | None = None) -> int:
+        """按 plan_id（+ 可选 task_id）删除。task_id=None 时按 plan_id 单条件删（§5.4 G6）。"""
+        conn = _connect()
+        try:
+            if task_id is None:
+                cur = _exec(conn, "DELETE FROM column_lineage WHERE plan_id = ?", (plan_id,))
+            else:
+                cur = _exec(
+                    conn,
+                    "DELETE FROM column_lineage WHERE plan_id = ? AND task_id = ?",
+                    (plan_id, task_id),
+                )
+            conn.commit()
+            return cur.rowcount if hasattr(cur, "rowcount") else 0
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    # ---- Database listing 已迁移至 dataagent/business_data/ ----
+
+
+def _normalize_plan_row(row: dict) -> None:
+    if "plan_name" in row and "name" not in row:
+        row["name"] = row["plan_name"]
+    if "biz_domain" in row and "business" not in row:
+        row["business"] = row["biz_domain"]
