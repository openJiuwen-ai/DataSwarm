+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/workflowPreview/workflowPreviewUrl.ts b/jiuwenswarm/channels/web/frontend/src/features/workflowPreview/workflowPreviewUrl.ts
