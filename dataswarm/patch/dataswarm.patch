+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""外部依赖的运行时 monkey patch（显式、幂等、git 追踪）。
+
+定位：外部依赖（openjiuwen 等 pip 包）的问题不走「直改依赖文件」（不可追踪、
+重装即丢、掩盖问题），两条正路：上游仓库修复（根治）或本模块的运行时补丁
+（随本仓交付，上游修复落地后按补丁头的标记删除）。
+
+纪律：每个补丁必须绑定一个实测失败（编号/现象）写进 docstring；函数幂等
+（重复应用无副作用）；能检测上游已修时自动跳过（no-op），避免上游修复后
+补丁与修复版冲突。
+"""
+from __future__ import annotations
+
+import inspect
+import logging
+
+logger = logging.getLogger(__name__)
+
+_patched: set[str] = set()
+
+
+def patch_openjiuwen_rwlock_release() -> None:
+    """openjiuwen fs 读写锁跨 task 释放修复。
+
+    实测失败（2026-11-02 dev42 whl 评测，smoke-whl 与 ck-27/ck-20）：agent 的
+    read_file / write_file / skill_tool 报
+    ``Cannot release a lock ... that is not held by this task through this
+    wrapper``，单例 4/56 次工具调用失败、agent 降级 bash 绕过白烧 3-6 轮对话。
+
+    根因：``HybridAsyncReadWriteLock._release_file`` 用 ``asyncio.create_task``
+    把 ``release`` 转发到新 task，而 filelock 的 ``AsyncFileLock`` 按「当前
+    asyncio task」校验持锁——正常路径必报错。
+    上游修复标记：openJiuwen/agent-core 的
+    ``core/sys_operation/local/_async_read_write_lock.py`` 的
+    ``_release_file`` 改为直接 ``await self._file.release()`` 后，本补丁
+    自动跳过（检测实现特征），随后应删除本补丁与调用点。
+    """
+    key = "openjiuwen.rwlock_release"
+    if key in _patched:
+        return
+    try:
+        from openjiuwen.core.sys_operation.local import _async_read_write_lock as mod
+
+        cls = mod.HybridAsyncReadWriteLock
+        source = inspect.getsource(cls._release_file)
+        if "create_task" not in source:
+            _patched.add(key)  # 上游已修，本补丁 no-op
+            logger.info("[upstream-patches] rwlock_release: 上游已修复，跳过")
+            return
+
+        async def _release_file(self: object) -> None:
+            # 在当前 task 释放：持锁与释放同 task 才能过 filelock 的校验。
+            # 原实现的 shield 取消保护随之去除（原实现正常路径即报错，
+            # 不存在行为回退；取消场景的释放语义上游修复时统一处理）。
+            await self._file.release()  # type: ignore[attr-defined]
+
+        cls._release_file = _release_file  # type: ignore[method-assign]
+        _patched.add(key)
+        logger.info("[upstream-patches] rwlock_release: 已应用（_release_file 当前 task 释放）")
+    except Exception:  # noqa: BLE001 —— 补丁失败不阻断主路，问题照常暴露
+        logger.warning("[upstream-patches] rwlock_release 应用失败（保持原实现，问题如实暴露）",
+                       exc_info=True)
