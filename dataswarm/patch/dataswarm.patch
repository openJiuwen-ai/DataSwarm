+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useMemo, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useTranslation } from 'react-i18next';
+import {
+  AlertTriangle,
+  CheckCircle2,
+  Copy,
+  Loader2,
+  RefreshCw,
+  Search,
+} from 'lucide-react';
+import { Empty } from '../../_shared/ui/Ui';
+import { Pagination } from '../../../components/ui/Pagination/Pagination';
+import { confirmDialog, toast } from '../../_shared/ui/Feedback';
+import { dataSourceApi } from '../api/dataSourceApi';
+import { navigateToKnowledgeReview } from '../../dashboard/components/knowledgeNav';
+import { useKnowledgeDerivationNotice } from '../../../stores/knowledgeDerivationNoticeStore';
+import { useDataSourceStore } from '../store/dataSourceStore';
+import { useDatasourceWorkspaceStore } from '../../../stores/datasourceWorkspaceStore';
+import { SourceBrand } from './SourceBrand';
+import { SourceFormDrawer, type SourceSubmitResult } from './SourceFormDrawer';
+import type { DataSourceEntry, KnowledgeDerivationStatus, SourceFormParams, SourceMutationResult } from '../types/dataSource';
+import { writeClipboard } from '../../trajectory/primitives/clipboard';
+
+function lines(source: DataSourceEntry) {
+  return (['host', 'port', 'database', 'user', 'path', 'location'] as const)
+    .filter((key) => source[key] !== undefined && source[key] !== '')
+    .map((key) => ({ key, value: String(source[key]) }));
+}
+function stamp(value?: string) {
+  return value ? value.replace('T', ' ').slice(0, 16) : '-';
+}
+
+/** 绑定源的知识派生状态：运行中显示进度（可取消），失败/超时/取消给重试，常态显示候选计数。 */
+function DeriveStatusCell({ status, busy, onRetry, onCancel }: {
+  status?: KnowledgeDerivationStatus;
+  busy: boolean;
+  onRetry: () => void;
+  onCancel: () => void;
+}) {
+  const { t } = useTranslation();
+  if (!status) {
+    return (
+      <span className="ds-derive-status" role="cell">
+        {t('dataSource.list.deriveNotBound')}
+      </span>
+    );
+  }
+  if (status.status === 'queued' || status.status === 'running') {
+    const cancelling = status.cancel_requested === true;
+    return (
+      <span className="ds-derive-status is-running" role="cell" title={status.error || ''}>
+        <Loader2 size={12} className="animate-spin" />
+        {cancelling
+          ? t('dataSource.list.deriveCancelling', { done: status.tables_done ?? 0, total: status.tables_total ?? 0 })
+          : t('dataSource.list.deriveRunning', { done: status.tables_done ?? 0, total: status.tables_total ?? 0 })}
+        <button className="ds-action-link" disabled={busy || cancelling} onClick={onCancel}>
+          {t('dataSource.list.deriveCancel')}
+        </button>
+      </span>
+    );
+  }
+  if (status.status === 'failed' || status.status === 'timeout' || status.status === 'cancelled') {
+    return (
+      <span className="ds-derive-status is-error" role="cell" title={status.error || ''}>
+        <AlertTriangle size={12} />
+        {t(status.status === 'timeout'
+          ? 'dataSource.list.deriveTimeout'
+          : status.status === 'cancelled'
+            ? 'dataSource.list.deriveCancelled'
+            : 'dataSource.list.deriveFailed')}
+        <button className="ds-action-link" disabled={busy} onClick={onRetry}>
+          {t('dataSource.list.deriveRetry')}
+        </button>
+      </span>
+    );
+  }
+  const candidates = status.candidates ?? 0;
+  return (
+    <span className="ds-derive-status" role="cell"
+      title={t('dataSource.list.deriveCountTooltip', { candidates, enriched: status.enriched ?? 0 })}>
+      {candidates > 0 ? (
+        <button className="ds-action-link" onClick={navigateToKnowledgeReview}
+          title={t('dataSource.list.deriveGoReview')}>
+          {status.enriched
+            ? t('dataSource.list.deriveComplete', { n: candidates, m: status.enriched })
+            : t('dataSource.list.deriveCandidates', { n: candidates })}
+        </button>
+      ) : t('dataSource.list.deriveIdle')}
+    </span>
+  );
+}
+
+export function DataSourceListPage() {
+  const { t } = useTranslation();
+  const store = useDataSourceStore();
+  const workspaceId = useDatasourceWorkspaceStore((state) => state.currentWorkspaceId);
+  const workspaces = useDatasourceWorkspaceStore((state) => state.workspaces);
+  const loadWorkspaces = useDatasourceWorkspaceStore((state) => state.loadWorkspaces);
+  const [formOpen, setFormOpen] = useState(false);
+  const [editing, setEditing] = useState<DataSourceEntry | null>(null);
+  const [type, setType] = useState('');
+  const [keyword, setKeyword] = useState('');
+  const [filter, setFilter] = useState('all');
+  const [page, setPage] = useState(1);
+  const [pageSize, setPageSize] = useState(5);
+  const [menu, setMenu] = useState<string | null>(null);
+  const [menuAnchor, setMenuAnchor] = useState<DOMRect | null>(null);
+  const [busy, setBusy] = useState<string | null>(null);
+  // 语义采集中（轮询最新 run 直到 published/failed 终态），key 为 source_id
+  const [collecting, setCollecting] = useState<Set<string>>(new Set());
+  useEffect(() => {
+    if (!menu) return;
+    const close = (event: MouseEvent) => {
+      if (!(event.target as Element).closest('.ds-actions, .ds-menu')) setMenu(null);
+    };
+    const escape = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') setMenu(null);
+    };
+    document.addEventListener('click', close);
+    document.addEventListener('keydown', escape);
+    const dismiss = () => setMenu(null);
+    window.addEventListener('resize', dismiss);
+    document.addEventListener('scroll', dismiss, true);
+    return () => {
+      document.removeEventListener('click', close);
+      document.removeEventListener('keydown', escape);
+      window.removeEventListener('resize', dismiss);
+      document.removeEventListener('scroll', dismiss, true);
+    };
+  }, [menu]);
+  useEffect(() => {
+    setFormOpen(false);
+    setEditing(null);
+    setMenu(null);
+    setKeyword('');
+    setFilter('all');
+    setPage(1);
+    void store.loadDatasources(workspaceId);
+  }, [workspaceId, store.loadDatasources]);
+  useEffect(() => {
+    void store.loadSourceTypes();
+    void loadWorkspaces();
+  }, [store.loadSourceTypes, loadWorkspaces]);
+  const available = store.sourceTypes.filter((entry) => entry.available === true && entry.fields.length > 0);
+  const currentWorkspace = workspaces.find((item) => item.workspace_id === workspaceId);
+  const boundSourceNames = store.datasources
+    .filter((source) => source.bound)
+    .map((source) => source.source_id)
+    .join(', ');
+  const unboundWorkspace = !!currentWorkspace && currentWorkspace.origin !== 'yaml' && !currentWorkspace.business;
+  const filtered = useMemo(
+    () =>
+      store.datasources.filter(
+        (source) =>
+          (filter === 'all' || source.type === filter) &&
+          [source.source_id, source.workspace_name, source.type, source.ref, ...lines(source).map((line) => line.value)]
+            .join(' ')
+            .toLowerCase()
+            .includes(keyword.trim().toLowerCase()),
+      ),
+    [filter, keyword, store.datasources],
+  );
+  const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
+  const rows = filtered.slice((page - 1) * pageSize, page * pageSize);
+  useEffect(() => {
+    if (page > pageCount) setPage(pageCount);
+  }, [page, pageCount]);
+  // 知识派生任务运行中：轮询列表直到任务结束（状态由服务端写回每个绑定源行）
+  const derivationActive = store.datasources.some((source) => {
+    const status = source.knowledge_derivation?.status;
+    return status === 'queued' || status === 'running';
+  });
+  useEffect(() => {
+    if (!derivationActive) return;
+    const timer = window.setInterval(() => { void store.loadDatasources(workspaceId); }, 3000);
+    return () => window.clearInterval(timer);
+  }, [derivationActive, workspaceId, store.loadDatasources]);
+  const retryDerivation = async () => {
+    if (!workspaceId) return;
+    try {
+      const result = await dataSourceApi.runKnowledgeDerivation(workspaceId);
+      toast.success(result.status === 'already_running'
+        ? t('dataSource.list.deriveAlreadyRunning')
+        : t('dataSource.list.deriveSubmitted'));
+      if (result.status !== 'already_running') useKnowledgeDerivationNotice.getState().open(workspaceId);
+      void store.loadDatasources(workspaceId);
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : t('dataSource.list.deriveRetryFailed'));
+    }
+  };
+  const cancelDerivation = async () => {
+    if (!workspaceId) return;
+    try {
+      const result = await dataSourceApi.cancelKnowledgeDerivation(workspaceId);
+      toast.success(result.status === 'not_running'
+        ? t('dataSource.list.deriveCancelNotRunning')
+        : t('dataSource.list.deriveCancelSubmitted'));
+      void store.loadDatasources(workspaceId);
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : t('dataSource.list.deriveCancelFailed'));
+    }
+  };
+  // 手动语义采集：触发后轮询该源最新 run，到终态给出成功/失败提示（失败信息取 error_json.message）
+  const startSemanticCollect = async (source: DataSourceEntry) => {
+    const sourceId = source.source_id;
+    if (!sourceId || collecting.has(sourceId)) return;
+    try {
+      await dataSourceApi.startSemanticRun(sourceId, workspaceId || undefined);
+      setCollecting((prev) => new Set(prev).add(sourceId));
+      toast.success(t('dataSource.list.semanticSubmitted'));
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : t('dataSource.list.semanticFailed', { id: sourceId }));
+    }
+  };
+  useEffect(() => {
+    if (collecting.size === 0) return;
+    const timer = window.setInterval(() => {
+      void (async () => {
+        for (const sourceId of collecting) {
+          try {
+            const { runs } = await dataSourceApi.listSemanticRuns(sourceId, workspaceId || undefined);
+            const latest = runs[0];
+            if (!latest || ['queued', 'running', 'staged'].includes(latest.status)) continue;
+            setCollecting((prev) => {
+              const next = new Set(prev);
+              next.delete(sourceId);
+              return next;
+            });
+            if (latest.status === 'published') {
+              toast.success(t('dataSource.list.semanticDone', { id: sourceId }));
+            } else {
+              let message = '';
+              if (latest.error_json) {
+                try {
+                  message = String(JSON.parse(latest.error_json).message ?? latest.error_json);
+                } catch {
+                  message = latest.error_json;
+                }
+              }
+              toast.error(`${t('dataSource.list.semanticFailed', { id: sourceId })}${message ? `: ${message}` : ''}`);
+            }
+          } catch {
+            // 轮询失败（网络抖动等）静默，下一轮再查
+          }
+        }
+      })();
+    }, 3000);
+    return () => window.clearInterval(timer);
+  }, [collecting, workspaceId, t]);
+  const mutationError = (result: SourceMutationResult) =>
+    result.error_code === 'SOURCE_ALREADY_BOUND'
+      ? t('dataSource.form.sourceAlreadyBound')
+      : result.error_code === 'DB_NOT_FOUND'
+        ? t('dataSource.form.databaseNotFound')
+        : result.error_code === 'TEST_FAILED'
+          ? `${t('dataSource.form.testFailedOnSave')}: ${result.error ?? ''}`
+          : result.error || t('dataSource.form.createFailed');
+  const submit = async (params: SourceFormParams): Promise<SourceSubmitResult> => {
+    if (editing) {
+      const result = await store.updateSource(params);
+      if (result.ok) toast.success(t('dataSource.form.saved'));
+      return result.ok
+        ? { status: 'saved' }
+        : { status: 'error', message: mutationError(result), error_code: result.error_code };
+    }
+    // 沿用创建即自动绑定（未绑定空间静默绑上）；已绑定其他源时让用户选「换绑 / 不换绑仅添加」
+    let result = await store.createSource({ ...params, workspace_id: workspaceId || undefined });
+    if (!result.ok && result.error_code === 'WORKSPACE_ALREADY_BOUND') {
+      const workspace = workspaces.find((item) => item.workspace_id === workspaceId);
+      const replace = await confirmDialog({
+        title: t('dataSource.form.replacePromptTitle'),
+        message: t('dataSource.form.replacePromptMessage', {
+          source: String(params.source_id ?? ''),
