+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Real-file regressions for SQLite business DAO binding and legacy discovery."""
+from __future__ import annotations
+
+import sqlite3
+from contextlib import closing
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.business_data import get_dao
+from jiuwenswarm.channels.web.dataagent.business_data import sqlite_impl
+from jiuwenswarm.channels.web.dataagent.databases import service
