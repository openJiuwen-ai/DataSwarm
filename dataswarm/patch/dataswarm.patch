+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Button, Switch } from '../../../../components/ui';
+import { Form, FormDialog, useForm } from '../../../../components/form';
+import { SettingRow, SettingsConfirmDialog } from '../../components';
+import type { SettingsCustomItemProps } from '../../registry/types';
+import { parseConfigBoolean } from '../../services/settingsContract';
+import { useSettingsFormDialogClose } from '../../services/useSettingsFormDialogClose';
+import { useSettingsServices } from '../../services/SettingsServicesProvider';
+import { useSettingsSource } from '../../services/SettingsSourceProvider';
+
+/** 知识图库（Semantica / Neo4j）连接字段：持久化到仓库根 .env（SEMANTICA_*），保存后需重启服务生效。 */
+const FIELDS = ['semantic_uri', 'semantic_username', 'semantic_password', 'semantic_database'] as const;
+
+type SaveConfig = (updates: Record<string, string>, operation: string) => Promise<unknown>;
+
+function KnowledgeGraphConfigDialog({
+  config,
+  save,
+  onClose,
+}: {
+  config: Record<string, unknown>;
+  save: SaveConfig;
+  onClose: () => void;
+}) {
+  const { t } = useTranslation();
+  const { isConnected } = useSettingsServices();
+  const form = useForm({
+    initialValues: Object.fromEntries(FIELDS.map((name) => [name, String(config[name] ?? '')])),
+  });
+  const [submitting, setSubmitting] = useState(false);
+  const [saveError, setSaveError] = useState('');
+  const closeBlocked = submitting;
+  const { discardConfirmationOpen, requestClose, cancelDiscard, confirmDiscard } = useSettingsFormDialogClose({
+    id: 'knowledge-graph-config-dialog',
+    form,
+    closeBlocked,
+    onClose,
+  });
+  const items = useMemo(
+    () =>
+      FIELDS.map((name) => {
+        const isPassword = name === 'semantic_password';
+        return {
+          name,
+          label: t(`settingsPanel.fields.${name}.title`),
+          component: 'input' as const,
+          type: isPassword ? ('password' as const) : ('text' as const),
+          required: true,
+          passwordVisibilityLabels: isPassword
+            ? { show: t('settingsPanel.common.showValue'), hide: t('settingsPanel.common.hideValue') }
+            : undefined,
+          placeholder: t('config.enterValue'),
+        };
+      }),
+    [t],
+  );
+  const rules = useMemo(
+    () =>
+      Object.fromEntries(
+        FIELDS.map((name) => [
+          name,
+          [
+            {
+              trigger: 'blur' as const,
+              validator: (value: unknown) =>
+                typeof value === 'string' && value.trim().length > 0
+                  ? undefined
+                  : t('settingsPanel.validation.required'),
+            },
+          ],
+        ]),
+      ),
+    [t],
+  );
+  const confirm = async () => {
+    const result = form.validate();
+    if (!result.valid) return;
+    setSubmitting(true);
+    setSaveError('');
+    try {
+      await save(
+        Object.fromEntries(FIELDS.map((name) => [name, String(result.values[name] ?? '').trim()])),
+        'settingsPanel.knowledgeGraph.dialogTitle',
+      );
+      onClose();
+    } catch (error) {
+      setSaveError(error instanceof Error ? error.message : t('settingsPanel.feedback.saveFailed'));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+  return (
+    <>
+      <FormDialog
+        open
+        title={t('settingsPanel.knowledgeGraph.dialogTitle')}
+        submitting={closeBlocked}
+        confirmDisabled={!isConnected}
+        confirmLabel={t('common.confirm')}
+        cancelLabel={t('common.cancel')}
+        onConfirm={() => void confirm()}
+        onCancel={requestClose}
+      >
+        <Form form={form} items={items} rules={rules} optionalText={t('common.optional')} />
+        <p className="text-xs text-text-muted">{t('settingsPanel.knowledgeGraph.restartHint')}</p>
+        {saveError ? (
+          <div className="settings-page__error" role="alert">
+            {saveError}
+          </div>
+        ) : null}
+      </FormDialog>
+      <SettingsConfirmDialog
+        open={discardConfirmationOpen}
+        title={t('settingsPanel.dialog.discardTitle')}
+        message={t('settingsPanel.dialog.discardConfirm')}
+        onConfirm={confirmDiscard}
+        onCancel={cancelDiscard}
+      />
+    </>
+  );
+}
+
+export function KnowledgeGraphSettings({ disabled }: SettingsCustomItemProps) {
+  const { t } = useTranslation();
+  const { isConnected } = useSettingsServices();
+  const { values, save, savingKeys } = useSettingsSource();
+  const [editing, setEditing] = useState(false);
+  const configured = FIELDS.every((field) => Boolean(values[field]));
+  const graphEnabled = parseConfigBoolean(values.semantic_graph_enabled);
+
+  async function updateGraphEnabled(next: boolean): Promise<void> {
+    await save({ semantic_graph_enabled: next }, 'settingsPanel.knowledgeGraph.switchTitle');
+  }
+
+  return (
+    <>
+      <SettingRow
+        title={t('settingsPanel.knowledgeGraph.switchTitle')}
+        description={t('settingsPanel.knowledgeGraph.switchDescription')}
+      >
+        <Switch
+          aria-label={t('settingsPanel.knowledgeGraph.switchTitle')}
+          checked={graphEnabled}
+          disabled={disabled || !isConnected || savingKeys.has('semantic_graph_enabled')}
+          onChange={(next) => void updateGraphEnabled(next).catch(() => undefined)}
+        />
+      </SettingRow>
+      <SettingRow
+        title={t('settingsPanel.knowledgeGraph.sectionTitle')}
+        description={
+          configured
+            ? t('settingsPanel.common.configured')
+            : t('settingsPanel.knowledgeGraph.sectionDescription')
+        }
+      >
+        <Button disabled={disabled || !isConnected} onClick={() => setEditing(true)}>
+          {t('settingsPanel.common.configure')}
+        </Button>
+      </SettingRow>
+      {editing ? (
+        <KnowledgeGraphConfigDialog config={values} save={save} onClose={() => setEditing(false)} />
+      ) : null}
+    </>
+  );
+}
