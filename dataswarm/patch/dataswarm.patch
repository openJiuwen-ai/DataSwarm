+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan 模块分层单测。"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.plan import controller as ctrl
+from jiuwenswarm.channels.web.dataagent.plan import service as svc
+from tests.unit.channel._dataagent_test_helpers import make_handler
+
+
+# --------------------------------------------------------------------------
+# service 层
+# --------------------------------------------------------------------------
+class _FakeStore:
+    def __init__(self):
+        self.plans = []
+        self.plan_by_id = {}
+        self.plan_tables_by_id = {}
+        self.plan_file_path = None
+        self.saved = None
+
+    def list_plans(self, business=""):
+        return [p for p in self.plans if not business or p.get("business") == business]
+
+    def get_plan(self, plan_id):
+        return self.plan_by_id.get(plan_id)
+
+    def get_plan_tables(self, plan_id):
+        return self.plan_tables_by_id.get(plan_id, [])
+
+    def save_plan(self, plan_id, name, business, purpose,
+                  content_json="", plan_data=None):
+        self.saved = {
+            "plan_id": plan_id, "name": name, "business": business,
+            "purpose": purpose, "content_json": content_json,
+            "plan_data": plan_data,
+        }
+        return {"plan_id": plan_id or "new_id", "name": name, "business": business}
+
+    def save_plan_tables(self, plan_id, tables):
+        self.plan_tables_by_id[plan_id] = tables
+        return {"inserted": len(tables), "updated": 0}
+
+    def get_plan_file_path(self, plan_id):
+        return self.plan_file_path
+
+
+@pytest.fixture
+def patch_store(monkeypatch):
+    store = _FakeStore()
+    monkeypatch.setattr(svc, "_get_store", lambda: store)
+    return store
+
+
+def test_list_plans_filters_business(patch_store):
+    patch_store.plans = [
+        {"plan_id": "1", "business": "olist"},
+        {"plan_id": "2", "business": "other"},
+    ]
+    out = svc.list_plans("olist")
+    assert [p["plan_id"] for p in out] == ["1"]
+
+
+def test_list_plans_no_filter(patch_store):
+    patch_store.plans = [
+        {"plan_id": "1", "business": "olist"},
+        {"plan_id": "2", "business": "other"},
+    ]
+    out = svc.list_plans("")
+    assert len(out) == 2
+
+
+def test_get_plan_found(patch_store):
+    patch_store.plan_by_id = {"p1": {"plan_id": "p1", "name": "n"}}
+    assert svc.get_plan("p1") == {"plan_id": "p1", "name": "n"}
+
+
+def test_get_plan_not_found(patch_store):
+    assert svc.get_plan("nope") is None
+
+
+def test_get_plan_tables(patch_store):
+    patch_store.plan_tables_by_id = {"p1": [{"table_name": "t"}]}
+    assert svc.get_plan_tables("p1") == [{"table_name": "t"}]
+
+
+def test_save_plan_passes_plan_data(patch_store):
+    out = svc.save_plan(name="n", business="b", purpose="p",
+                        plan_id="p1", plan_data={"tables": []})
+    assert out["plan_id"] == "p1"
+    assert patch_store.saved["plan_data"] == {"tables": []}
+
+
+def test_save_plan_tables_serializes_source_tables(patch_store):
+    out = svc.save_plan_tables("p1", [{"table_name": "t", "source_tables": ["a", "b"]}])
+    assert out == {"inserted": 1, "updated": 0}
+    assert patch_store.plan_tables_by_id["p1"][0]["source_tables"] == '["a", "b"]'
+
+
+def test_read_plan_file_fallback_to_store(patch_store, tmp_path, monkeypatch):
+    # 文件不存在时 fallback 到 store.get_plan
+    patch_store.plan_by_id = {"p1": {"plan_id": "p1", "from": "store"}}
+    monkeypatch.setattr(svc, "_get_plans_dir", lambda: tmp_path)
+    out = svc.read_plan_file("p1")
+    assert out == {"plan_id": "p1", "from": "store"}
+
+
+def test_read_plan_file_reads_disk(tmp_path, monkeypatch):
+    # 文件存在时直接读
+    f = tmp_path / "p1.json"
+    f.write_text('{"plan_id":"p1","tables":[{"x":1}]}', encoding="utf-8")
+    monkeypatch.setattr(svc, "_get_plan_file_path", lambda pid: f)
+    out = svc.read_plan_file("p1")
+    assert out == {"plan_id": "p1", "tables": [{"x": 1}]}
+
+
+# --------------------------------------------------------------------------
+# controller 层
+# --------------------------------------------------------------------------
+class _SvcSpy:
+    def __init__(self):
+        self.calls = []
+        self.list_result = [{"plan_id": "1"}]
+        self.get_result = {"plan_id": "p1"}
+        self.tables_result = [{"table_name": "t"}]
+        self.save_result = {"plan_id": "p1"}
+
+    def list_plans(self, business):
+        self.calls.append(("list", business))
+        return self.list_result
+
+    def get_plan(self, plan_id):
+        self.calls.append(("get", plan_id))
+        return self.get_result
+
+    def get_plan_tables(self, plan_id):
+        self.calls.append(("tables", plan_id))
+        return self.tables_result
+
+    def save_plan(self, **kw):
+        self.calls.append(("save", kw))
+        return self.save_result
+
+    def save_plan_tables(self, plan_id, tables):
+        self.calls.append(("tables-save", plan_id, tables))
+        return {"inserted": len(tables), "updated": 0}
+
+
+@pytest.fixture
+def patch_svc(monkeypatch):
+    spy = _SvcSpy()
+    monkeypatch.setattr(ctrl, "svc", spy)
+    return spy
+
+
+def test_ctrl_get_list(patch_svc):
+    h, resp = make_handler("/api/dataagent/plan?business=olist")
+    ctrl.handle_get(h, h.parsed)
+    assert patch_svc.calls == [("list", "olist")]
+    assert resp.status == 200
+    assert resp.payload == {"plans": [{"plan_id": "1"}]}
+
+
+def test_ctrl_get_plan_found(patch_svc):
+    h, resp = make_handler("/api/dataagent/plan/get?plan_id=p1")
+    ctrl.handle_get(h, h.parsed)
+    assert patch_svc.calls == [("get", "p1")]
+    assert resp.status == 200
+
+
+def test_ctrl_get_plan_not_found(patch_svc):
+    patch_svc.get_result = None
+    h, resp = make_handler("/api/dataagent/plan/get?plan_id=nope")
+    ctrl.handle_get(h, h.parsed)
+    assert resp.status == 404
+    assert resp.payload == {"error": "not_found"}
+
+
+def test_ctrl_get_tables(patch_svc):
+    h, resp = make_handler("/api/dataagent/plan/tables?plan_id=p1")
+    ctrl.handle_get(h, h.parsed)
+    assert patch_svc.calls == [("tables", "p1")]
+    assert resp.payload == {"tables": [{"table_name": "t"}]}
+
+
+def test_ctrl_post_save(patch_svc):
+    body = {"plan_id": "p1", "name": "n", "business": "b", "purpose": "p",
+            "plan_data": {"tables": []}}
+    h, resp = make_handler("/api/dataagent/plan/save", body)
+    ctrl.handle_post(h, h.parsed)
+    assert patch_svc.calls[0][0] == "save"
+    assert patch_svc.calls[0][1]["plan_id"] == "p1"
+    assert patch_svc.calls[0][1]["plan_data"] == {"tables": []}
+    assert resp.status == 201
+
+
+def test_ctrl_post_save_tables(patch_svc):
+    tables = [{"table_name": "b.dwd_t", "source_tables": ["b.ods_t"]}]
+    h, resp = make_handler(
+        "/api/dataagent/plan/tables/save",
+        {"plan_id": "p1", "tables": tables},
+    )
+    ctrl.handle_post(h, h.parsed)
+    assert patch_svc.calls == [("tables-save", "p1", tables)]
+    assert resp.status == 200
+
+
+def test_ctrl_post_save_tables_validates_payload(patch_svc):
+    h, resp = make_handler("/api/dataagent/plan/tables/save", {"plan_id": "p1", "tables": "bad"})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 400
