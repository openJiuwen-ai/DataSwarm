+def test_render_card_card_without_placeholder_uses_cache(tmp_path, monkeypatch):
+    """无占位符卡片：第二次 render 走缓存（不重查）。
+
+    证伪方法：第一次 render 后把该卡片 DB 里的 echarts_option 列直接
+    UPDATE 成 sentinel 值。若缓存分支生效，第二次 render 会返回 sentinel
+    （因为走 cached 分支）；若缓存分支被删，render 会重新执行 SQL 并把
+    echarts_option 覆盖回真实查询结果（非 sentinel），断言失败。
+    """
+    m, db_ref = _bootstrap_sqlite_db(tmp_path, monkeypatch)
+    m.create_card("d_test", {
+        "card_id": "c_noplc",
+        "title": "no placeholder",
+        "card_type": "chart",
+        "chart_spec": {"type": "bar", "x": "dt", "y": "pv"},
+        "sql_query": "SELECT '2026-08-15' AS dt, 100 AS pv",
+        "datasource_ref": db_ref,
+    })
+    r1 = m.render_card("c_noplc", time_range=("2026-08-01", "2026-08-29"))
+    assert r1 is not None
+
+    # 直接改 DB 行的 echarts_option 为 sentinel
+    sentinel = {"sentinel": "stale_cache"}
+    import json as _json
+    with m._write_lock:
+        conn = m._connect()
+        try:
+            m._exec(conn,
+                    "UPDATE dw_bi_dashboard_cards SET echarts_option=?, updated_at=? WHERE card_id=?",
+                    (_json.dumps(sentinel, ensure_ascii=False), m._now(), "c_noplc"))
+            conn.commit()
+        finally:
+            conn.close()
+
+    # force_refresh=False → 走缓存，应返回 sentinel
+    r2 = m.render_card("c_noplc", time_range=("2026-07-01", "2026-07-15"),
+                       force_refresh=False)
+    assert r2 is not None
+    # 缓存命中：返回的 echarts_option 应是 sentinel（DB 里被改的值），
+    # 而非重新查询得到的真实图表 option
+    assert r2.get("echarts_option") == sentinel, (
+        f"expected cached sentinel {sentinel!r}, got {r2.get('echarts_option')!r}"
+    )
+
+    # 反向验证：force_refresh=True 时应绕过缓存、重查覆盖 sentinel
+    r3 = m.render_card("c_noplc", time_range=("2026-08-01", "2026-08-29"),
+                       force_refresh=True)
+    assert r3 is not None
+    assert r3.get("echarts_option") != sentinel, (
+        "force_refresh=True should bypass cache and overwrite sentinel"
+    )
+
