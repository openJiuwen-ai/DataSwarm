+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""semantic/vector_store.py 单测：增量台账同步、多向量召回合并、降级矩阵。
+
+faiss 纪律：本机 Windows 上 faiss 链接的 OpenBLAS 多线程预分配会 hard crash，
+全部用例注入 FakeStore 使用面替身，不 import faiss
+（test_glossary_sync.py 同纪律；生产入口 app_web.py 已设
+OPENBLAS_NUM_THREADS=1）。embed 桩照 test_metrics_embedding.py 的
+EmbedOutcome 契约（texts 必须回带——多向量归因靠它）。
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import embedding
+from jiuwenswarm.channels.web.dataagent.semantic import service, vector_docs, vector_store
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    DatabaseMeta,
+    DataSourceMeta,
+    MetadataSnapshot,
+    TableMeta,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.semantica import InMemorySemanticaAdapter
+from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+
+# ==========================================================================
+# 桩
+# ==========================================================================
+class FakeStore:
+    """FAISSStore 使用面替身：add/delete/save/index.metadata + 预置检索返回。
+
+    search_batches 逐次弹出（第 1 次=整句向量、第 2 次=短语向量），耗尽后回
+    search_results——这样能构造「整句弱命中、短语强命中」的多向量场景。
+    """
+
+    def __init__(self):
+        self.index = SimpleNamespace(metadata={})
+        self.vectors: dict[str, np.ndarray] = {}
+        self.added: list[tuple[list, object]] = []
+        self.deleted: list[list] = []
+        self.saved = 0
+        self.search_results: list[dict] = []
+        self.search_batches: list[list[dict]] = []
+
+    def add_vectors(self, vectors, ids=None, metadata=None):
+        self.added.append((list(ids), vectors))
+        for vector_id, meta, vector in zip(ids, metadata, vectors):
+            self.index.metadata[vector_id] = dict(meta)
+            # Semantica 0.7 updates metadata but skips existing physical IDs.
+            self.vectors.setdefault(vector_id, np.asarray(vector, dtype=np.float32).copy())
+
+    def delete_vectors(self, ids):
+        self.deleted.append(list(ids))
+        for vector_id in ids:
+            self.index.metadata.pop(vector_id, None)
+            self.vectors.pop(vector_id, None)
+
+    def get_vector(self, vector_id):
+        vector = self.vectors.get(vector_id)
+        return None if vector is None else vector.copy()
+
+    def save_index(self, path):
+        self.saved += 1
+
+    def search_similar(self, query_vector, k=10):
+        if self.search_batches:
+            return self.search_batches.pop(0)
+        return self.search_results
+
+
+class FakeEmbed:
+    """确定性嵌入桩（固定 4 维），记录调用文本以便断言增量复用。"""
+
+    def __init__(self):
+        self.error = ""
+        self.texts: list[str] = []
+
+    def __call__(self, texts, *, timeout_s: int = 20):
+        batch = list(texts)
+        self.texts.extend(batch)
+        if self.error:
+            return embedding.EmbedOutcome(error=self.error)
+        return embedding.EmbedOutcome(
+            vectors=tuple((1.0, 0.0, 0.0, 0.0) for _ in batch),
+            model="fake-emb", dims=4, texts=tuple(batch))
+
+
+def _snapshot(*, phone_comment: str = "客户手机号", include_amount: bool = True,
+              empty: bool = False) -> MetadataSnapshot:
+    if empty:
+        tables = []
+    else:
+        columns = [
+            ColumnMeta("orders", "mysql", "shop", "orders", "order_id",
+                       data_type="bigint", ordinal=1, column_key="PRI", comment="订单号"),
+            ColumnMeta("orders", "mysql", "shop", "orders", "phone",
+                       data_type="varchar", ordinal=2, comment=phone_comment),
+        ]
+        if include_amount:
+            columns.append(ColumnMeta("orders", "mysql", "shop", "orders", "amount",
+                                      data_type="decimal", ordinal=3))
+        tables = [TableMeta("orders", "mysql", "shop", "orders", comment="订单表",
+                            columns=columns)]
+    return MetadataSnapshot(
+        "snapshot:orders:run-1", "run-1",
+        DataSourceMeta("orders", "mysql", "mysql://db:3306/shop"),
+        [DatabaseMeta("orders", "mysql", "shop")],
+        tables,
+    )
+
+
+def _fake_query_vectors(vectors, texts):
+    def _q(question, *, timeout_s: int = 20):
+        return embedding.EmbedOutcome(
+            vectors=tuple(vectors), texts=tuple(texts),
+            model="fake-emb", dims=len(vectors[0]))
+    return _q
+
+
+def _prime_ledger(store):
+    """给 FakeStore 塞一条占位台账——recall 侧「索引为空」判断用 metadata
+    非空表达，召回用例不先 sync，需预置才能走到检索分支。"""
+    store.index.metadata["ledger:placeholder"] = {"source_id": "orders"}
+
+
+@pytest.fixture()
+def vector_env(monkeypatch, tmp_path):
+    """向量层桩环境：目录钉 tmp + FakeStore + FakeEmbed，不碰真实 faiss/embed。"""
+    monkeypatch.setenv("DATASWARM_SEMANTIC_VECTOR_DIR", str(tmp_path / "vectors"))
+    vector_store._faiss_cache.clear()
+    store = FakeStore()
+    fake_embed = FakeEmbed()
+    monkeypatch.setattr(vector_store, "_faiss_store", lambda ws, dims=None: store)
+    monkeypatch.setattr(embedding, "emb_available", lambda: True)
+    monkeypatch.setattr(embedding, "embed_texts", fake_embed)
+    yield SimpleNamespace(store=store, embed=fake_embed)
+    vector_store._faiss_cache.clear()
+
+
+@pytest.fixture()
+def semantic_db(monkeypatch, tmp_path):
+    db_path = tmp_path / "semantic.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    ensure_system_schema(f"sqlite://{db_path}")
+    return db_path
+
+
+# ==========================================================================
+# 同步：doc_hash 增量台账
+# ==========================================================================
+def test_sync_first_time_embeds_all_then_creates_index(monkeypatch, tmp_path):
+    """首次无索引文件：必须先 embed 拿真实维度，再带 dims 建索引。"""
+    monkeypatch.setenv("DATASWARM_SEMANTIC_VECTOR_DIR", str(tmp_path / "vectors"))
+    vector_store._faiss_cache.clear()
+    created = FakeStore()
+    calls: list[int | None] = []
+
+    def factory(ws, dims=None):
+        calls.append(dims)
+        return None if dims is None else created
+
+    monkeypatch.setattr(vector_store, "_faiss_store", factory)
+    fake_embed = FakeEmbed()
+    monkeypatch.setattr(embedding, "emb_available", lambda: True)
+    monkeypatch.setattr(embedding, "embed_texts", fake_embed)
+
+    result = vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    assert result["status"] == "ok"
+    assert result["reembedded"] == result["vectors"] == 9  # 表2 + 有注释列3×2 + amount 无注释1
+    assert calls[0] is None and calls[1] == 4  # 先无 dims 探测，embed 后带维度建索引
+    assert len(created.added) == 1 and len(created.added[0][0]) == 9
+    assert created.saved == 1
+    vector_store._faiss_cache.clear()
+
+
+def test_sync_second_time_embeds_nothing(vector_env):
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    calls_before = len(vector_env.embed.texts)
+    result = vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    assert result == {"status": "ok", "vectors": 9, "reembedded": 0}
+    assert len(vector_env.embed.texts) == calls_before  # 台账全命中，不发 embed
+
+
+def test_sync_comment_change_reembeds_only_affected_slots(vector_env):
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    # 改 phone 注释：comment 槽 + ctx 槽（表注释×列注释拼接）两条文本变化
+    result = vector_store.sync_workspace_vectors(
+        "ws", "orders", _snapshot(phone_comment="收货人电话"))
+    assert result["reembedded"] == 2
+    assert vector_env.embed.texts[-2:] == ["收货人电话", "订单表 收货人电话"]
+
+
+def test_sync_replaces_changed_vectors_without_touching_other_documents(vector_env, monkeypatch):
+    """Same-ID additions skip vectors in the real SDK, so replacement must be explicit."""
+    other = _snapshot()
+    other.source.source_id = "other"
+    for table in other.tables:
+        table.source_id = "other"
+        for column in table.columns:
+            column.source_id = "other"
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot())
+    vector_store.sync_workspace_vectors("ws", "other", other)
+    before = {doc_id: vector.copy() for doc_id, vector in vector_env.store.vectors.items()}
+    metadata_before = {doc_id: dict(meta) for doc_id, meta in vector_env.store.index.metadata.items()}
+
+    def changed_embedding(texts, *, timeout_s=20):
+        return embedding.EmbedOutcome(
+            vectors=tuple((0., 1., 0., 0.) for _ in texts),
+            model="fake-emb", dims=4, texts=tuple(texts))
+
+    monkeypatch.setattr(embedding, "embed_texts", changed_embedding)
+    changed_snapshot = _snapshot(phone_comment="收货人电话")
+    result = vector_store.sync_workspace_vectors("ws", "orders", changed_snapshot)
+    changed_ids = {"col:mysql:orders:shop.orders.phone:comment", "col:mysql:orders:shop.orders.phone:ctx"}
+    assert result["reembedded"] == 2
+    assert set(vector_env.store.vectors) == set(before)
+    for doc_id in changed_ids:
+        assert np.array_equal(vector_env.store.vectors[doc_id], [0., 1., 0., 0.])
+    for doc_id in set(before) - changed_ids:
+        assert np.array_equal(vector_env.store.vectors[doc_id], before[doc_id])
+        assert vector_env.store.index.metadata[doc_id] == metadata_before[doc_id]
+    assert {doc_id for batch in vector_env.store.deleted for doc_id in batch} == changed_ids
+    assert vector_store.sync_workspace_vectors("ws", "orders", changed_snapshot)["reembedded"] == 0
+
