+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""databases search_tables 占位符绑参单测（方案 §3.1 G15）。
+
+bug 修复档 TDD：_search_tables_sql 生成带 ? 占位符的 SQL，但 search_tables
+调 db_connector.query 时没传 params——sqlite/pymysql 会因未绑定占位符报错。
+本测试用模拟 query 记录 params 透传，跑前应为红（params 未传），修复后转绿。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.databases import service as svc
+
+
+class _ParamsSpy:
+    """记录 db_connector.query 的 (db_ref, sql, params, limit) 调用。"""
+
+    def __init__(self):
+        self.calls: list[tuple] = []
+        self.query_result = {"row_count": 0, "truncated": False,
+                             "columns": [], "rows": [], "elapsed_ms": 0}
+
+    def query(self, db_ref, sql, params=None, limit=None):
+        self.calls.append((db_ref, sql, params, limit))
+        return self.query_result
+
+    def tables(self, db_ref):
+        return {"tables": []}
+
+
+@pytest.fixture
+def patch_connector(monkeypatch):
+    spy = _ParamsSpy()
+    monkeypatch.setattr(svc, "db_connector", spy)
+    return spy
+
+
+def test_search_tables_doris_binds_params(patch_connector):
+    """Doris 路径：query 必须收到 params=(%xxx%, top_k)，而非裸 SQL。"""
+    out = svc.search_tables("doris://h/d", "ods", top_k=5)
+    assert out["ok"] is True
+    db_ref, sql, params, limit = patch_connector.calls[0]
+    assert "INFORMATION_SCHEMA" in sql
+    assert params == ("%ods%", 5)  # 占位符与 top_k 都要绑参
+
+
+def test_search_tables_sqlite_binds_params(patch_connector):
+    """sqlite 路径同理。"""
+    out = svc.search_tables("sqlite:///test.db", "ods", top_k=3)
+    assert out["ok"] is True
+    db_ref, sql, params, limit = patch_connector.calls[0]
+    assert "sqlite_master" in sql
+    assert params == ("%ods%", 3)
+
+
+def test_search_tables_no_sql_injection_via_params(patch_connector):
+    """参数化查询天然防注入——用户输入包进 %...% 作为 LIKE 值传 params，不拼进 SQL 文本。"""
+    svc.search_tables("doris://h/d", "'; DROP TABLE--", top_k=10)
+    db_ref, sql, params, limit = patch_connector.calls[0]
+    # SQL 文本里只有占位符 ?，没有用户输入（DROP 不在 SQL 里）
+    assert "DROP" not in sql
+    # 用户输入被包进 %...% 作为 LIKE 值（参数化，不进 SQL 文本）
+    assert params == ("%'; DROP TABLE--%", 10)
