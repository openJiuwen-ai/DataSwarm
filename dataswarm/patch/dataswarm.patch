+            "# Auto-generated by DataSwarm desktop; forwards the literal `python`",
+            "# convention (SKILL.md) to the frozen exe. Do not edit; regenerated",
+            "# at every desktop startup (the exe path changes on upgrade).",
+            f"exec {shlex.quote(exe)} \"$@\"",
+            "",
+        )
+    )
+
+
