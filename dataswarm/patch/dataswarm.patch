index 000000000..3c355a420
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/TaskEditDrawer.tsx
@@ -0,0 +1,249 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useDrawer } from '../hooks/useDrawer';
+// 任务编辑抽屉。新建/编辑任务表单。照 CronTaskDrawer 的 backdrop+panel 模式。
+
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { orchestrationApi } from '../api/orchestrationApi';
+import { TaskCodeEditor } from './TaskCodeEditor';
+import type { TaskDefinition } from '../types/orchestration';
+import { Button, Field, inputClass } from './shared/Ui';
+import { LineagePreviewSection } from './LineagePreviewSection';
+import type { TaskInput } from '../api/orchestrationApi';
+
+interface Props {
+  open: boolean;
+  task: TaskDefinition | null;
+  onClose: () => void;
+}
+
+export function TaskEditDrawer({ open, task, onClose }: Props) {
+  const { t } = useTranslation();
+  const published = task?.status === 'published';
+  const [form, setForm] = useState<TaskInput>({
+    name: '',
+    description: '',
+    executor_type: 'sql',
+    code: '',
+    datasource_ref: '',
+    timeout_s: 300,
+    schedule_type: 'none',
+    schedule_cron: '',
+    schedule_once_at: '',
+  });
+  const [saving, setSaving] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (task) {
+      setForm({
+        name: task.name,
+        description: task.description ?? '',
+        executor_type: task.executor_type,
+        code: task.code,
+        datasource_ref: task.datasource_ref ?? '',
+        timeout_s: task.timeout_s,
+        schedule_type: task.schedule_type,
+        schedule_cron: task.schedule_cron ?? '',
+        schedule_once_at: task.schedule_once_at ?? '',
+      });
+    } else {
+      setForm({
+        name: '',
+        description: '',
+        executor_type: 'sql',
+        code: '',
+        datasource_ref: '',
+        timeout_s: 300,
+        schedule_type: 'none',
+        schedule_cron: '',
+        schedule_once_at: '',
+      });
+    }
+    setErr(null);
+  }, [task, open]);
+
+  const drawerRef = useDrawer(open, () => {
+    if (!saving) onClose();
+  });
+
+  if (!open) return null;
+
+  const save = async () => {
+    if (saving) return;
+    setErr(null);
+    if (
+      !form.name?.trim() ||
+      !form.code?.trim() ||
+      !Number.isInteger(form.timeout_s) ||
+      Number(form.timeout_s) <= 0 ||
+      (form.schedule_type === 'cron' && !form.schedule_cron?.trim()) ||
+      (form.schedule_type === 'once' && !form.schedule_once_at?.trim())
+    ) {
+      setErr(t('dataAsset.taskForm.invalid'));
+      return;
+    }
+    setSaving(true);
+    try {
+      const input = { ...form, name: form.name.trim() };
+      if (published) {
+        delete input.code;
+        delete input.executor_type;
+      }
+      if (task) await orchestrationApi.updateTask(task.task_id, input);
+      else await orchestrationApi.createTask(input);
+      onClose();
+    } catch (e) {
+      setErr(e instanceof Error ? e.message : String(e));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-50 flex justify-end bg-black/40"
+      onClick={() => {
+        if (!saving) onClose();
+      }}
+    >
+      <div
+        ref={drawerRef}
+        role="dialog"
+        aria-modal="true"
+        aria-label={t(task ? 'dataAsset.taskForm.edit' : 'dataAsset.taskForm.create')}
+        className="flex h-full w-[600px] max-w-[95vw] flex-col border-l border-border bg-card shadow-2xl"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-center justify-between border-b border-border px-5 py-3">
+          <h3 className="text-base font-semibold text-text-strong">
+            {t(task ? 'dataAsset.taskForm.edit' : 'dataAsset.taskForm.create')}
+          </h3>
+          <Button
+            variant="ghost"
+            size="xs"
+            onClick={() => {
+              if (!saving) onClose();
+            }}
+          >
+            ×
+          </Button>
+        </div>
+        <div className="flex-1 space-y-4 overflow-y-auto p-5">
+          <Field label={t('dataAsset.taskForm.name')}>
+            <input
+              className={inputClass}
+              value={form.name ?? ''}
+              onChange={(e) => setForm({ ...form, name: e.target.value })}
+              placeholder={t('dataAsset.taskForm.namePlaceholder')}
+            />
+          </Field>
+          <Field label={t('dataAsset.taskForm.description')}>
+            <textarea
+              className={inputClass}
+              value={form.description ?? ''}
+              onChange={(e) => setForm({ ...form, description: e.target.value })}
+            />
+          </Field>
+          <Field label={t('dataAsset.taskForm.executor')}>
+            <div className="da-segmented" role="group" aria-label={t('dataAsset.taskForm.executor')}>
+              {(['sql', 'python'] as const).map((type) => (
+                <button
+                  key={type}
+                  type="button"
+                  aria-label={type === 'sql' ? 'SQL' : 'Python'}
+                  disabled={published}
+                  aria-pressed={form.executor_type === type}
+                  onClick={() => setForm({ ...form, executor_type: type })}
+                >
+                  {type === 'sql' ? 'SQL' : 'Python'}
+                </button>
+              ))}
+            </div>
+            {published && <p className="mt-2 text-xs text-text-muted">{t('dataAsset.taskForm.publishedHint')}</p>}
+          </Field>
+          <div className="block" role="group" aria-label={t('dataAsset.taskForm.code')}>
+            <span className="mb-1 block text-xs text-text-muted">{t('dataAsset.taskForm.code')}</span>
+            <TaskCodeEditor
+              value={form.code ?? ''}
+              language={form.executor_type ?? 'sql'}
+              readOnly={published}
+              onChange={(code) => setForm((current) => ({ ...current, code }))}
+            />
+          </div>
+          <LineagePreviewSection
+            code={form.code ?? ''}
+            executorType={form.executor_type ?? 'sql'}
+            datasourceRef={form.datasource_ref}
+          />
+          <Field label={t('dataAsset.taskForm.datasource')}>
+            <input
+              className={inputClass}
+              value={form.datasource_ref ?? ''}
+              onChange={(e) => setForm({ ...form, datasource_ref: e.target.value })}
+              placeholder={t('dataAsset.taskForm.datasourcePlaceholder')}
+            />
+          </Field>
+          <Field label={t('dataAsset.taskForm.timeout')}>
+            <input
+              type="number"
+              min="1"
+              step="1"
+              className={inputClass}
+              value={form.timeout_s ?? 300}
+              onChange={(e) => setForm({ ...form, timeout_s: Number(e.target.value) })}
+            />
+          </Field>
+          <Field label={t('dataAsset.taskForm.schedule')}>
+            <select
+              className={inputClass}
+              value={form.schedule_type}
+              onChange={(e) => setForm({ ...form, schedule_type: e.target.value as 'none' | 'once' | 'cron' })}
+            >
+              <option value="none">{t('dataAsset.wfForm.scheduleNone')}</option>
+              <option value="once">{t('dataAsset.wfForm.scheduleOnce')}</option>
+              <option value="cron">{t('dataAsset.wfForm.scheduleCron')}</option>
+            </select>
+          </Field>
+          {form.schedule_type === 'cron' && (
+            <Field label={t('dataAsset.taskForm.cron')} hint={t('dataAsset.wfForm.cronHint')}>
+              <input
+                className={inputClass}
+                value={form.schedule_cron ?? ''}
+                onChange={(e) => setForm({ ...form, schedule_cron: e.target.value })}
+                placeholder="0 9 * * *"
+              />
+            </Field>
+          )}
+          {form.schedule_type === 'once' && (
+            <Field label={t('dataAsset.taskForm.onceAt')} hint={t('dataAsset.wfForm.timezoneHint')}>
+              <input
+                className={inputClass}
+                value={form.schedule_once_at ?? ''}
+                onChange={(e) => setForm({ ...form, schedule_once_at: e.target.value })}
+              />
+            </Field>
+          )}
+        </div>
+        <div className="flex items-center justify-end gap-2 border-t border-border px-5 py-3">
+          {err && (
+            <span role="alert" className="mr-auto text-xs text-danger">
+              {err}
+            </span>
+          )}
+          <Button
+            variant="ghost"
+            onClick={() => {
+              if (!saving) onClose();
+            }}
+          >
+            {t('common.cancel')}
+          </Button>
+          <Button variant="primary" disabled={saving || !form.name || !form.code} onClick={save}>
+            {t(saving ? 'common.saving' : 'common.save')}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
