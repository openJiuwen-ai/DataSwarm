+
+def test_drift_detected(sandbox):
+    assert run_tool(sandbox, "archive_delta.py", "--push").returncode == 0
+    # 绕过归档直接改 MR 分支
+    git(["checkout", "-q", "MR"], sandbox)
+    (sandbox / "dataswarm" / "skills" / "dw-demo" / "SKILL.md").write_text("hacked\n", encoding="utf-8")
+    git(["add", "-A"], sandbox)
+    commit(sandbox, "hack")
+    git(["checkout", "-q", "develop_oss"], sandbox)
+    git(["push", "-q", "mr-fork", "MR"], sandbox)
+
+    proc = run_tool(sandbox, "archive_delta.py")
+    assert proc.returncode != 0
+    assert "外部手改" in proc.stderr or "外部手改" in proc.stdout
+
+    # 手改 commit 覆盖了归档 trailer（Baseline-Tag 等缺失）→ verify 无法确定还原口径，
+    # 报错退出（元信息即防线；重归档会全量覆盖手改）
+    ver = run_tool(sandbox, "verify_equivalence.py", "--archive-ref", "mr-fork/MR")
+    assert ver.returncode != 0
