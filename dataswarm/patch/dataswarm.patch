+/* 首次使用引导（dw-onboarding-guide）：结构与 model-setup-guide 同模式，类名独立便于演化 */
+
+.dw-onboarding-guide {
+  position: fixed;
+  z-index: 2000;
+  inset: 0;
+  pointer-events: none;
+}
+
+.dw-onboarding-guide__mask {
+  position: fixed;
+  background: var(--color-backdrop-strong);
+  pointer-events: auto;
+}
+
+.dw-onboarding-guide__spotlight {
+  position: fixed;
+  border: 1px solid var(--color-action-primary);
+  border-radius: 12px;
+  box-shadow: var(--effect-shadow-lg);
+  pointer-events: none;
+}
+
+.dw-onboarding-guide__callout {
+  position: fixed;
+  padding: 20px;
+  border: 1px solid var(--color-border-default);
+  border-radius: 16px;
+  background: var(--color-surface-popover);
+  box-shadow: var(--effect-shadow-lg);
+  color: var(--color-text-primary);
+  pointer-events: auto;
+  animation: dwOnboardingGuideEnter 200ms cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.dw-onboarding-guide__pill-skip {
+  appearance: none;
+  position: absolute;
+  top: 20px;
+  right: 16px;
+  min-width: 44px;
+  height: 24px;
+  padding: 0 10px;
+  border: 0;
+  border-radius: 999px;
+  outline: none;
+  background: var(--color-action-secondary);
+  color: var(--color-text-secondary);
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 24px;
+  text-align: center;
+  cursor: pointer;
+  transition:
+    background-color 120ms ease,
+    color 120ms ease;
+}
+
+.dw-onboarding-guide__pill-skip:hover,
+.dw-onboarding-guide__pill-skip:focus-visible {
+  background: var(--color-sidebar-nav-hover);
+  color: var(--color-text-primary);
