+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/api_v2.py —— 指标语义层 V2 HTTP API（``/api/dataagent/metrics/v2/*``）。
+
+V2 = 新语义通路（Ossie 导入 → 发布投影 → 双通路查询）。与旧 ``api.py``
+（``dw_bi_*`` 表）**同前缀不同子命名空间**，旧端点一个字节不动。
+
+错误体统一 ``{error, detail, request_id, retryable}``（方案 §阶段 5b）；
+``request_id`` 暂取查询追溯的 query_id，非查询类请求为 None。
+"""
+from __future__ import annotations
+
+import json
+
+from jiuwenswarm.common import workspace_context
+from jiuwenswarm.common import db_connector
+
+from . import service, store, versioning
+from .errors import ErrorCode, MetricError
+from .model import QuerySpec
+from .semantic_link import context_digest
+
+_PREFIX = "/api/dataagent/metrics/v2"
+
+# 503 类错误码（服务暂不可用，建议重试）
+_SERVICE_CODES = {
+    ErrorCode.SEMANTICA_DISABLED, ErrorCode.SEMANTICA_UNAVAILABLE,
+    ErrorCode.LLM_UNAVAILABLE, ErrorCode.TRANSIENT, ErrorCode.PROJECTION_CONFLICT,
+}
+
+
+def is_v2(path: str) -> bool:
+    """是否为 V2 路由。"""
+    return path.startswith(_PREFIX)
+
+
+def _workspace_id() -> str:
+    """取当前工作空间 ID（由 dataagent/api.py 的 _with_workspace 装好上下文）。"""
+    return workspace_context.current_workspace().workspace_id
+
+
+def _write_error(handler, exc: MetricError) -> None:
+    """按错误码选状态码并输出统一错误体。"""
+    status = 503 if exc.code in _SERVICE_CODES else 400
+    handler._write_json(status, exc.to_envelope())
+
+
+def _split(path: str) -> list[str]:
+    """剥掉 V2 前缀后 split。"""
+    rel = path[len(_PREFIX):].rstrip("/")
+    return rel.split("/")
+
+
+def _read_body(handler) -> dict | None:
+    """读 JSON body；空 body 返回 {}，非法 JSON 返回 None。"""
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except (TypeError, ValueError):
+        return None
+    if not length:
+        return {}
+    raw = handler.rfile.read(length)
+    try:
+        parsed = json.loads(raw)
+    except (json.JSONDecodeError, TypeError):
+        return None
+    return parsed if isinstance(parsed, dict) else None
+
+
+def _int_query_arg(
+    handler, parsed, name: str, *, default: int,
+    minimum: int = 0, maximum: int = 1_000_000,
+) -> int:
+    """读取整数 query 参数并按区间收敛；缺失/非法返回默认值。"""
+    raw = handler._query_arg(parsed, name)
+    if raw in (None, ""):
+        return default
+    try:
+        value = int(raw)
+    except (TypeError, ValueError):
+        return default
+    return max(minimum, min(maximum, value))
+
+
+def _business_db_type() -> str:
+    """当前工作空间业务库类型（导入时决定 Ossie 表达式方言偏好）。"""
+    ref = workspace_context.current_workspace().business_db_ref
+    return str(db_connector.parse_db_ref(ref).get("type") or "sqlite")
+
+
+# ==========================================================================
+# GET
+# ==========================================================================
+def handle_get(handler, parsed) -> None:
+    """V2 GET 路由。"""
+    parts = _split(parsed.path)
+    try:
+        # ['', 'health'] —— 严格两段：宽松匹配会吞掉深层路由
+        if len(parts) == 2 and parts[1] == "health":
+            from . import semantic_link
+
+            refs = semantic_link.workspace_semantic_refs()
+            release = store.get_active_release(_workspace_id())
+            handler._write_json(200, {
+                "enabled": True,
+                "semantic": {
+                    "available": bool(refs),
+                    "mode": "semantic-data-plane",
+                    "detail": f"{len(refs)} 个数据源已采集语义快照"
+                    if refs else "没有已发布语义快照——绑定数据源后自动触发采集",
+                    "error_code": None,
+                },
+                "capabilities": {
+                    "named_graphs": True, "sparql": False, "rdf_import": False,
+                    "shacl": False, "provenance": False, "multi_instance": True,
+                },
+                "semantic_refs": [
+                    {"source_id": r.source_id, "snapshot_id": r.snapshot_id}
+                    for r in refs],
+                "projection_status": release.projection_status if release else None,
+            })
+            return
+        # ['', 'metrics', '{key}'] 与 ['', 'metrics', '{key}', 'context']
+        # —— 必须先于列表分支判断（否则 /metrics/{key} 被列表吞掉）
+        if len(parts) >= 3 and parts[1] == "metrics":
+            metric = store.get_def_by_key(_workspace_id(), parts[2])
+            if metric is None:
+                handler._write_json(404, {"error": "not_found",
+                                          "detail": f"指标 {parts[2]} 不存在"})
+                return
+            if len(parts) == 3:
+                handler._write_json(200, _def_detail(metric))
+                return
+            # ['', 'metrics', '{key}', 'terms']  已绑定的业务术语
+            if len(parts) == 4 and parts[3] == "terms":
+                handler._write_json(200, versioning.list_terms_of(_workspace_id(), parts[2]))
+                return
+            if len(parts) == 4 and parts[3] == "context":
+                release = store.get_active_release(_workspace_id())
+                if release is None:
+                    handler._write_json(400, {"error": "PROJECTION_REQUIRED",
+                                              "detail": "没有已发布批次，先 publish",
+                                              "request_id": None, "retryable": False})
+                    return
+                from . import semantic_link
+
+                ctx = semantic_link.build_semantic_context(
+                    _workspace_id(), parts[2], release)
+                handler._write_json(200, {
+                    "context": _context_payload(ctx), "release_id": release.release_id,
+                    "context_digest": context_digest(ctx)})
+                return
+        # ['', 'metrics']  管理页列表：筛选/分页下推 SQL；不带 page 时保持全量
+        # （dwcli 等旧调用方兼容——分页是 opt-in）
+        if len(parts) == 2 and parts[1] == "metrics":
+            keyword = handler._query_arg(parsed, "keyword") or ""
+            status = (handler._query_arg(parsed, "status") or "").strip()
+            sort = (handler._query_arg(parsed, "sort") or "metric_key").strip()
+            order = (handler._query_arg(parsed, "order") or "asc").strip()
+            page = _int_query_arg(handler, parsed, "page", default=0, minimum=0)
+            page_size = _int_query_arg(handler, parsed, "page_size", default=0,
+                                       minimum=0, maximum=100)
+            result = store.list_defs_page(
+                _workspace_id(), keyword=keyword, status=status or None,
+                sort=sort, order=order, page=page, page_size=page_size)
+            handler._write_json(200, {
+                "metrics": [_def_summary(row["def"]) for row in result["rows"]],
+                "total": result["total"],
+                "page": result["page"],
+                "page_size": result["page_size"],
+                "status_counts": result["status_counts"],
+            })
+            return
+        # ['', 'releases']
+        if len(parts) == 2 and parts[1] == "releases":
+            releases = store.list_releases(_workspace_id())
+            handler._write_json(200, {"releases": [r.__dict__ for r in releases]})
+            return
+        # ['', 'query-log']
+        if len(parts) == 2 and parts[1] == "query-log":
+            limit_raw = handler._query_arg(parsed, "limit") or "50"
+            try:
+                limit = max(1, min(500, int(limit_raw)))
+            except (TypeError, ValueError):
+                limit = 50
+            rows = store.list_queries(_workspace_id(), limit=limit)
+            handler._write_json(200, {"queries": rows})
+            return
+    except MetricError as exc:
+        _write_error(handler, exc)
+        return
+    except Exception as exc:  # noqa: BLE001 —— 兜底 500，detail 透传便于排查
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+# ==========================================================================
+# POST
+# ==========================================================================
+def handle_post(handler, parsed) -> None:
+    """V2 POST 路由。"""
+    parts = _split(parsed.path)
+    try:
+        body = _read_body(handler)
+        if body is None:
+            handler._write_json(400, {"error": "bad_request", "detail": "invalid JSON body"})
+            return
+        # ['', 'ossie', 'import']
+        if parts[1:3] == ["ossie", "import"]:
+            content = str(body.get("content") or "")
+            if not content.strip():
+                handler._write_json(400, {"error": "bad_request",
+                                          "detail": "content（Ossie YAML 原文）必填"})
+                return
+            imported = versioning.import_ossie(
+                content, _workspace_id(),
+                fmt=str(body.get("fmt") or "yaml"),
+                target_db_type=str(body.get("target_db_type") or _business_db_type()))
+            handler._write_json(200, imported)
+            return
+        # ['', 'releases', 'publish']
+        if parts[1:3] == ["releases", "publish"]:
+            revision_ids = body.get("revision_ids") or []
+            if not revision_ids:
+                handler._write_json(400, {"error": "bad_request",
+                                          "detail": "revision_ids 必填（至少一个修订）"})
+                return
+            release = versioning.publish_release(
+                _workspace_id(), [str(r) for r in revision_ids],
+                label=str(body.get("label") or ""),
+                published_by=str(body.get("published_by") or ""))
+            handler._write_json(200, {"release": release.__dict__,
+                                      "projection": {"projection_status":
+                                                     release.projection_status}})
+            return
+        # ['', 'reprojects']  全量重投影当前生效指标（projection_status=failed
+        # 的修复入口；Neo4j 未配置时报 503）
+        if parts[1:2] == ["reprojects"]:
+            from . import graph_projection
+
+            try:
+                outcome = graph_projection.reproject_workspace(_workspace_id())
+                handler._write_json(200, outcome)
+            except Exception as exc:  # noqa: BLE001 —— 环境未配置/Neo4j 拒连 → 503
+                handler._write_json(503, {
+                    "error": "SEMANTICA_UNAVAILABLE", "detail": str(exc)[:500],
+                    "request_id": None, "retryable": True})
+            return
+        # ['', 'metrics']  手动新建指标（身份 + r1 candidate 修订 + 物理绑定）
+        if len(parts) == 2 and parts[1] == "metrics":
+            created = versioning.create_metric(
+                _workspace_id(), body, target_db_type=_business_db_type())
+            handler._write_json(200, {
+                "metric": _def_summary(created["metric"]),
+                "revision": _manual_revision_payload(
+                    created["revision"], created["binding"]),
+                "candidate_mappings": created["candidate_mappings"],
+            })
+            return
+        # ['', 'metrics', '{key}', 'update'|'revisions'|'delete']
+        # 网关不向 dataagent 分发 PUT/DELETE，写操作一律走 POST 子动作
+        # （与 glossary/api.py 同款约定）。
+        if len(parts) == 4 and parts[1] == "metrics" and parts[3] in {
+                "update", "revisions", "delete"}:
+            key = parts[2]
+            if parts[3] == "update":
+                metric = versioning.update_metric(_workspace_id(), key, body)
+                handler._write_json(200, {"metric": _def_summary(metric)})
+                return
+            if parts[3] == "revisions":
+                created = versioning.create_revision(
+                    _workspace_id(), key, body, target_db_type=_business_db_type())
+                handler._write_json(200, {
+                    "revision": _manual_revision_payload(
+                        created["revision"], created["binding"]),
+                    "carried_term_maps": created["carried_term_maps"],
+                    "candidate_mappings": created["candidate_mappings"],
+                })
+                return
+            outcome = versioning.delete_metric(
+                _workspace_id(), key,
+                force=str(body.get("force") or "").lower() in ("1", "true", "yes"))
+            handler._write_json(200, {"deleted": True, **outcome})
+            return
+        # ['', 'metrics', '{key}', 'terms']  术语绑定（action=bind|unbind）
+        # 界面链路：target_ref 存 term_id、状态直接 confirmed（人点选即确认）；
+        # Ossie 链路另走 ossie/import + concept-map/{id}/confirm。
+        if len(parts) == 4 and parts[1] == "metrics" and parts[3] == "terms":
+            term_id = str(body.get("term_id") or "").strip()
+            if not term_id:
+                handler._write_json(400, {"error": "bad_request", "detail": "term_id 必填"})
+                return
+            if str(body.get("action") or "bind") == "unbind":
+                handler._write_json(200, versioning.unbind_term(
+                    _workspace_id(), parts[2], term_id))
+                return
+            handler._write_json(200, versioning.bind_term(
+                _workspace_id(), parts[2], term_id,
+                bound_by=str(body.get("bound_by") or "")))
+            return
+        # ['', 'concept-map', '{id}', 'confirm']
+        if len(parts) == 4 and parts[1] == "concept-map" and parts[3] == "confirm":
+            action = str(body.get("action") or "confirm")
+            if action == "reject":
+                versioning.reject_mapping(parts[2])
+                handler._write_json(200, {"mapping_id": parts[2], "status": "rejected"})
+                return
+            mapping = versioning.confirm_mapping(
+                parts[2], confirmed_by=str(body.get("confirmed_by") or ""))
+            handler._write_json(200, {"mapping": mapping.__dict__})
+            return
+        # ['', 'query']  QuerySpec → 确定性编译；body 带 compile_only=true 只出 SQL
+        # （对话链路），默认服务端执行（指标管理界面测试预览——执行语义拆分后
+        # 唯一执行入口）。compile_only 走 body 而非 URL：dwcli json_body 端点
+        # 无 URL query 通道，且 QuerySpec.from_dict 忽略未知键。
+        if parts[1:2] == ["query"]:
+            spec = QuerySpec.from_dict(body)
+            compile_only = str(body.get("compile_only") or "").lower() \
+                in ("1", "true", "yes")
+            if compile_only:
+                answer = service.compile_only(spec, _workspace_id(),
+                                              session_id=str(body.get("session_id") or ""))
+                handler._write_json(200, _answer_payload(answer))
+                return
+            result = service.query(spec, _workspace_id(),
+                                   session_id=str(body.get("session_id") or ""))
+            handler._write_json(200, _result_payload(result))
+            return
+        # ['', 'explore']  R3 的受控执行端点（D7）：schema 子图范围内 LLM 生成 SQL。
+        # 供 Agent/nl2sql 显式调用。业务在 service.explore（Phase 3b 下沉）。
+        if parts[1:2] == ["explore"]:
+            question = str(body.get("question") or "")
+            if not question.strip():
+                handler._write_json(400, {"error": "bad_request", "detail": "question 必填"})
+                return
+            result = service.explore(question, _workspace_id(),
+                                     subgraph_scope=body.get("subgraph_scope"))
+            handler._write_json(200, _answer_payload(result))
+            return
+        # ['', 'query-log', '{id}', 'feedback']
+        if len(parts) == 4 and parts[1] == "query-log" and parts[3] == "feedback":
+            outcome = service.record_feedback(
+                parts[2], str(body.get("feedback") or "none"),
+                confirmed_by=str(body.get("confirmed_by") or ""))
+            handler._write_json(200, outcome)
+            return
+    except MetricError as exc:
+        _write_error(handler, exc)
+        return
+    except Exception as exc:  # noqa: BLE001
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+# ==========================================================================
+# 载荷组装
+# ==========================================================================
+def _def_summary(metric) -> dict:
+    """指标列表项：身份 + 当前修订摘要 + 管理页列（修订数/发布态/更新时间）。"""
+    revision = store.get_revision(metric.current_revision_id) \
+        if metric.current_revision_id else None
+    revisions = store.list_revisions(metric.metric_id)
+    latest = revisions[0] if revisions else None
+    return {
+        "metric_id": metric.metric_id, "metric_key": metric.metric_key,
+        "name": metric.name, "description": metric.description, "owner": metric.owner,
+        "status": metric.status,
+        "current_revision": _revision_summary(revision) if revision else None,
+        "latest_revision": _revision_summary(latest) if latest else None,
+        "revision_count": len(revisions),
+        "has_published": any(rev.status == "published" for rev in revisions),
+        "updated_at": metric.updated_at,
+    }
+
+
+def _binding_payload(binding) -> dict | None:
+    """物理绑定 → 可 JSON 化的 dict（None 表示该修订没有绑定）。"""
+    if binding is None:
+        return None
+    return {
+        "binding_id": binding.binding_id,
+        "datasource_alias": binding.datasource_alias,
+        "datasource_ref": binding.datasource_ref,
+        "source_table": binding.source_table,
+        "column_map": dict(binding.column_map),
+        "verify_status": binding.verify_status,
+        "verify_detail": binding.verify_detail,
+    }
+
+
+def _manual_revision_payload(revision, binding) -> dict:
+    """手动建修订的响应载荷：修订摘要 + 表达式解析结果 + 绑定。
+
+    解析结果（算子/字段）直接回给表单，表达式写错在保存时就暴露；
+    ``unparsed_reason`` 非空表示 sqlglot 没解析成功，发布前需人工修正。
+    """
+    parsed = revision.expression.parsed
+    return {
+        **_revision_summary(revision),
+        "expression_sql": revision.expression.expression,
+        "expression_dialect": revision.expression.resolved_dialect,
+        "parsed_operator": parsed.operator if parsed else "",
+        "parsed_fields": list(parsed.fields) if parsed else [],
+        "binding": _binding_payload(binding),
+    }
+
+
+def _def_detail(metric) -> dict:
+    """指标详情：身份 + 修订历史 + 每个修订的候选映射明细（confirm 要用 mapping_id）。
+
+    修订载荷额外带 expression SQL 与 bindings（口径核对要用，经 dwcli
+    读这份明细，不直连元库）。
+    """
+    revisions = store.list_revisions(metric.metric_id)
+    pending = 0
+    revision_payloads = []
+    for revision in revisions:
+        candidates = store.list_concept_maps(revision.revision_id, status="candidate")
+        pending += len(candidates)
+        revision_payloads.append({
+            **_revision_summary(revision),
+            "expression_sql": revision.expression.expression,
+            "expression_dialect": revision.expression.resolved_dialect,
+            "bindings": [{
+                "binding_id": b.binding_id,
+                "datasource_alias": b.datasource_alias,
+                "datasource_ref": b.datasource_ref,
+                "source_table": b.source_table,
+                "column_map": dict(b.column_map),
+                "verify_status": b.verify_status,
+            } for b in store.list_bindings(revision.revision_id)],
+            "candidate_maps": [{
+                "mapping_id": m.mapping_id,
+                "relation_type": m.relation_type,
+                "target_ref": m.target_ref,
+                "evidence": m.evidence,
+            } for m in candidates],
+        })
+    return {
+        "metric": metric.__dict__,
+        "revisions": revision_payloads,
+        "pending_concept_maps": pending,
+    }
+
+
+def _context_payload(ctx) -> dict:
+    """SemanticContext → 可 JSON 化的 dict。"""
+    return {
+        "metric_key": ctx.metric_key,
+        "revision": ctx.revision,
+        "label": ctx.label,
+        "comment": ctx.comment,
+        "unit": ctx.unit,
+        "operator": ctx.operator,
+        "formula_summary": ctx.formula_summary,
+        "synonyms": list(ctx.synonyms),
+        "concept": ctx.concept,
+        "dependencies": list(ctx.dependencies),
+        "numerator": ctx.numerator,
+        "denominator": ctx.denominator,
+        "time_field": ctx.time_field,
+        "group_by_fields": list(ctx.group_by_fields),
+        "definition_ref": ctx.definition_ref,
+        "warnings": list(ctx.warnings),
+        "schema": ctx.schema,
+        "schema_snapshot_id": ctx.schema_snapshot_id,
+        "drift": ctx.drift,
+    }
+
+
+
+def _revision_summary(revision) -> dict:
+    """修订摘要（不含 ossie_raw 原文——太长且含完整文件）。"""
+    return {
+        "revision_id": revision.revision_id, "revision_no": revision.revision_no,
+        "metric_type": revision.metric_type, "unit": revision.unit,
+        "display_name": revision.display_name, "status": revision.status,
+        "definition_ref": revision.definition_ref,
+        "definition_hash": revision.definition_hash[:16],
+        "synonyms": list(revision.synonyms),
+        "time_dimension": revision.time_dimension,
+        "allowed_dimensions": list(revision.allowed_dimensions),
+        "time_grains": list(revision.time_grains),
+        "dependencies": list(revision.dependencies),
+        "zero_denominator": revision.zero_denominator,
+        "unparsed_reason": revision.expression.unparsed_reason,
+    }
+
+
+
+def _answer_payload(answer, *, warnings: tuple[str, ...] = ()) -> dict:
+    """编译产物（AskAnswer）→ 响应载荷：权威口径 SQL 交执行层，无 rows。
+
+    ``sql_executable`` 参数已内联（执行层无 params 绑定通道）；
+    ``spec`` 供前端把同一规格回传 ``/query`` 做预览执行。
+    """
+    return {
+        "sql": answer.compiled.sql,
+        "sql_executable": answer.sql_executable,
+        "params": [str(p) for p in answer.compiled.params],
+        "metric_keys": list(answer.compiled.metric_keys),
+        "dialect": answer.compiled.dialect,
+        "release_id": answer.compiled.release_id,
+        "path": answer.path,
+        "authoritative": answer.authoritative,
+        "degraded_reason": answer.degraded_reason,
+        "spec": answer.spec,
+        "query_id": answer.query_id,
+        "warnings": list(answer.warnings) + list(warnings),
+    }
+
+
+def _result_payload(result, *, warnings: tuple[str, ...] = ()) -> dict:
+    """查询结果 → 响应载荷。"""
+    return {
+        "rows": result.rows, "columns": result.columns,
+        "row_count": result.row_count, "elapsed_ms": result.elapsed_ms,
+        "query_id": result.query_id, "path": result.path,
+        "authoritative": result.authoritative,
+        "degraded_reason": result.degraded_reason, "stale": result.stale,
+        "sql": result.compiled.sql, "dialect": result.compiled.dialect,
+        "release_id": result.compiled.release_id,
+        "metric_keys": list(result.compiled.metric_keys),
+        "warnings": list(result.warnings) + list(warnings),
+    }
