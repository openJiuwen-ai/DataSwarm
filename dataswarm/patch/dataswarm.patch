index 000000000..b9653a513
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/store/concept_maps.py
@@ -0,0 +1,212 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/concept_maps.py —— 概念映射（dw_metric_concept_map）CRUD 与确认状态（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+from ..model import (
+    ConceptMapping,
+)
+from ._db import _commit_if_own, _conn_or, _write_lock
+
+
+# ==========================================================================
+# dw_metric_concept_map —— 业务映射（candidate/confirmed 分离）
+# ==========================================================================
+def create_concept_map(mapping: ConceptMapping, *, conn: Any = None) -> ConceptMapping:
+    """写入一条业务映射，默认 ``candidate``。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_concept_map (mapping_id, workspace_id, revision_id,"
+                " relation_type, target_ref, status, evidence, confirmed_by, confirmed_at,"
+                " created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (mapping.mapping_id, mapping.workspace_id, mapping.revision_id,
+                 mapping.relation_type, mapping.target_ref, mapping.status, mapping.evidence,
+                 mapping.confirmed_by, mapping.confirmed_at, mapping.created_at),
+            )
+            _commit_if_own(c, own)
+        return mapping
+    finally:
+        if own:
+            c.close()
+
+
+def _row_to_mapping(row: dict) -> ConceptMapping:
+    return ConceptMapping(
+        mapping_id=row["mapping_id"],
+        workspace_id=row["workspace_id"],
+        revision_id=row["revision_id"],
+        relation_type=row["relation_type"],
+        target_ref=row["target_ref"],
+        status=row.get("status") or "candidate",
+        evidence=row.get("evidence") or "",
+        confirmed_by=row.get("confirmed_by") or "",
+        confirmed_at=row.get("confirmed_at") or "",
+        created_at=row.get("created_at") or "",
+    )
+
+
+def list_concept_maps(
+    revision_id: str, *, status: str | None = None, conn: Any = None
+) -> list[ConceptMapping]:
+    """列出某修订的映射，可按状态过滤。"""
+    c, own = _conn_or(conn)
+    try:
+        if status:
+            rows = _fetch_dicts(
+                c,
+                "SELECT * FROM dw_metric_concept_map WHERE revision_id = ? AND status = ?",
+                (revision_id, status),
+            )
+        else:
+            rows = _fetch_dicts(
+                c, "SELECT * FROM dw_metric_concept_map WHERE revision_id = ?", (revision_id,))
+        return [_row_to_mapping(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+def list_confirmed_maps(
+    revision_ids: list[str], *, conn: Any = None
+) -> list[ConceptMapping]:
+    """批量取多个修订的已确认映射。空集合直接返回空列表。"""
+    if not revision_ids:
+        return []
+    c, own = _conn_or(conn)
+    try:
+        placeholders = ", ".join("?" for _ in revision_ids)
+        rows = _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_concept_map WHERE status = 'confirmed'"
+            f" AND revision_id IN ({placeholders})",
+            tuple(revision_ids),
+        )
+        return [_row_to_mapping(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+def find_concept_map(
+    revision_id: str, relation_type: str, target_ref: str, *, conn: Any = None
+) -> ConceptMapping | None:
+    """按 (修订, 关系, 目标) 查映射——绑定幂等的依据（同组重复视为更新）。"""
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_concept_map WHERE revision_id = ?"
+            " AND relation_type = ? AND target_ref = ?",
+            (revision_id, relation_type, target_ref),
+        )
+        return _row_to_mapping(rows[0]) if rows else None
+    finally:
+        if own:
+            c.close()
+
+
+def list_concept_maps_by_target(
+    workspace_id: str, relation_type: str, target_ref: str, *,
+    status: str | None = None, conn: Any = None
+) -> list[ConceptMapping]:
+    """按目标反查映射（术语 → 哪些指标绑了它）。
+
+    绑定接口据此提示「该术语已被别的指标绑定」——一个术语链到多个指标时
+    分析入口无法直达（短路判定的链分叉条件）。
+    """
+    c, own = _conn_or(conn)
+    try:
+        sql = ("SELECT * FROM dw_metric_concept_map WHERE workspace_id = ?"
+               " AND relation_type = ? AND target_ref = ?")
+        params: tuple[Any, ...] = (workspace_id, relation_type, target_ref)
+        if status:
+            sql += " AND status = ?"
+            params = (*params, status)
+        return [_row_to_mapping(r) for r in _fetch_dicts(c, sql, params)]
+    finally:
+        if own:
+            c.close()
+
+
+def delete_concept_map(mapping_id: str, *, conn: Any = None) -> bool:
+    """删除一条映射（解绑）。返回是否确有删除。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_concept_map WHERE mapping_id = ?", (mapping_id,))
+            deleted = bool(getattr(cursor, "rowcount", 0))
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
+def get_concept_map(mapping_id: str, *, conn: Any = None) -> ConceptMapping | None:
+    """按主键取映射。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c, "SELECT * FROM dw_metric_concept_map WHERE mapping_id = ?", (mapping_id,))
+        return _row_to_mapping(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def set_concept_map_status(
+    mapping_id: str,
+    status: str,
+    *,
+    confirmed_by: str = "",
+    conn: Any = None,
+) -> None:
+    """改映射状态；``confirmed`` 时记录确认人与时间。"""
+    c, own = _conn_or(conn)
+    confirmed_at = _now() if status == "confirmed" else None
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_concept_map SET status = ?, confirmed_by = ?,"
+                " confirmed_at = ? WHERE mapping_id = ?",
+                (status, confirmed_by, confirmed_at, mapping_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def delete_concept_maps_for_revision(revision_id: str, *, conn: Any = None) -> int:
+    """删除某修订的全部业务映射，返回删除行数（指标删除级联用）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_concept_map WHERE revision_id = ?", (revision_id,))
+            deleted = int(getattr(cursor, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
diff --git a/jiuwenswarm/channels/web/dataagent/metrics/store/defs.py b/jiuwenswarm/channels/web/dataagent/metrics/store/defs.py
new file mode 100644
index 000000000..86153648e
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/store/defs.py
@@ -0,0 +1,441 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/defs.py —— 指标定义（dw_metric_defs）CRUD 与词法检索（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+from ..model import (
+    MetricDef,
+    as_list,
+)
+from ._db import _commit_if_own, _conn_or, _write_lock, new_id
+
+
+# ==========================================================================
+# dw_metric_defs —— 指标身份
+# ==========================================================================
+def create_def(
+    *,
+    workspace_id: str,
+    metric_key: str,
+    name: str,
+    description: str = "",
+    owner: str = "",
+    conn: Any = None,
+) -> MetricDef:
+    """新建指标身份。同一 workspace 下 ``metric_key`` 已存在时返回既有记录。
+
+    Args:
+        workspace_id: 工作空间 ID。
+        metric_key: 指标业务键，如 ``commerce.gmv``。
+        name: 展示名。
+        description: 业务说明。
+        owner: 负责人。
+        conn: 可选的既有连接。
+
+    Returns:
+        新建或既有的 :class:`~.model.MetricDef`。
+    """
+    c, own = _conn_or(conn)
+    try:
+        existing = get_def_by_key(workspace_id, metric_key, conn=c)
+        if existing is not None:
+            return existing
+        now = _now()
+        metric = MetricDef(
+            metric_id=new_id("met"),
+            workspace_id=workspace_id,
+            metric_key=metric_key,
+            name=name,
+            description=description,
+            owner=owner,
+            status="draft",
+            created_at=now,
+            updated_at=now,
+        )
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_defs (metric_id, workspace_id, metric_key, name,"
+                " description, owner, status, current_revision_id, created_at, updated_at)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (metric.metric_id, metric.workspace_id, metric.metric_key, metric.name,
+                 metric.description, metric.owner, metric.status, metric.current_revision_id,
+                 metric.created_at, metric.updated_at),
+            )
+            _commit_if_own(c, own)
+        return metric
+    finally:
+        if own:
+            c.close()
+
+
+def _row_to_def(row: dict) -> MetricDef:
+    return MetricDef(
+        metric_id=row["metric_id"],
+        workspace_id=row["workspace_id"],
+        metric_key=row["metric_key"],
+        name=row["name"],
+        description=row.get("description") or "",
+        owner=row.get("owner") or "",
+        status=row.get("status") or "draft",
+        current_revision_id=row.get("current_revision_id"),
+        created_at=row.get("created_at") or "",
+        updated_at=row.get("updated_at") or "",
+    )
+
+
+def get_def(metric_id: str, *, conn: Any = None) -> MetricDef | None:
+    """按主键取指标身份。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(c, "SELECT * FROM dw_metric_defs WHERE metric_id = ?", (metric_id,))
+        return _row_to_def(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def get_def_by_key(workspace_id: str, metric_key: str, *, conn: Any = None) -> MetricDef | None:
+    """按 (workspace, metric_key) 取指标身份。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c,
+            "SELECT * FROM dw_metric_defs WHERE workspace_id = ? AND metric_key = ?",
+            (workspace_id, metric_key),
+        )
+        return _row_to_def(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def list_defs(
+    workspace_id: str, *, keyword: str | None = None, conn: Any = None
+) -> list[MetricDef]:
+    """列出工作空间下的指标身份，可按关键词过滤。
+
+    Args:
+        workspace_id: 工作空间。
+        keyword: 非空时对 ``metric_key`` / ``name`` / ``description`` 做包含匹配
+            （参数化 LIKE，供管理页搜索；空白关键词等价于不过滤）。
+        conn: 可选的既有连接。
+    """
+    c, own = _conn_or(conn)
+    try:
+        text = (keyword or "").strip()
+        if text:
+            pattern = f"%{text}%"
+            rows = _fetch_dicts(
+                c,
+                "SELECT * FROM dw_metric_defs WHERE workspace_id = ?"
+                " AND (metric_key LIKE ? OR name LIKE ? OR description LIKE ?)"
+                " ORDER BY metric_key",
+                (workspace_id, pattern, pattern, pattern),
+            )
+        else:
+            rows = _fetch_dicts(
+                c,
+                "SELECT * FROM dw_metric_defs WHERE workspace_id = ? ORDER BY metric_key",
+                (workspace_id,),
+            )
+        return [_row_to_def(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+_DEF_SORT_COLUMNS = {
+    "metric_key": "d.metric_key",
+    "name": "d.name",
+    "updated_at": "d.updated_at",
+    "revision_count": "revision_count",
+}
+
+
+def list_defs_page(
+    workspace_id: str,
+    *,
+    keyword: str | None = None,
+    status: str | None = None,
+    sort: str = "metric_key",
+    order: str = "asc",
+    page: int = 0,
+    page_size: int = 0,
+    conn: Any = None,
+) -> dict:
+    """指标管理页的分页查询：筛选/排序/分页下推 SQL。
+
+    Args:
+        workspace_id: 工作空间。
+        keyword: 对 ``metric_key`` / ``name`` / ``description`` 的包含匹配。
+        status: ``published`` = 存在已发布修订；``draft`` = 没有；其他值不过滤。
+        sort: 白名单列（metric_key / name / updated_at / revision_count）。
+        order: ``asc`` / ``desc``；非法值按 asc。
+        page: 从 1 开始；``<=0`` 表示不分页（兼容 dwcli 等全量调用方）。
+        page_size: 每页条数；``<=0`` 表示不分页。
+        conn: 可选的既有连接。
+
+    Returns:
+        ``{"rows": [{"def", "revision_count", "has_published"}], "total",
+        "page", "page_size", "status_counts"}``——``status_counts`` 是全空间
+        计数（不受筛选影响，供 KPI/筛选徽章）。
+    """
+    c, own = _conn_or(conn)
+    try:
+        where = ["d.workspace_id = ?"]
+        params: list[Any] = [workspace_id]
+        text = (keyword or "").strip()
+        if text:
+            pattern = f"%{text}%"
+            where.append("(d.metric_key LIKE ? OR d.name LIKE ? OR d.description LIKE ?)")
+            params.extend([pattern, pattern, pattern])
+        if status == "published":
+            where.append(
+                "EXISTS (SELECT 1 FROM dw_metric_revisions r"
+                " WHERE r.metric_id = d.metric_id AND r.status = 'published')")
+        elif status == "draft":
+            where.append(
+                "NOT EXISTS (SELECT 1 FROM dw_metric_revisions r"
+                " WHERE r.metric_id = d.metric_id AND r.status = 'published')")
+        clause = " WHERE " + " AND ".join(where)
+        limit_clause = ""
+        query_params: list[Any] = list(params)
+        if page > 0 and page_size > 0:
+            limit_clause = " LIMIT ? OFFSET ?"
+            query_params += [int(page_size), (int(page) - 1) * int(page_size)]
+        sort_expr = _DEF_SORT_COLUMNS.get(sort, _DEF_SORT_COLUMNS["metric_key"])
+        direction = "DESC" if str(order).lower() == "desc" else "ASC"
+        rows = _fetch_dicts(
+            c,
+            "SELECT d.*,"
+            " (SELECT COUNT(*) FROM dw_metric_revisions r WHERE r.metric_id = d.metric_id)"
+            " AS revision_count,"
+            " (SELECT COUNT(*) FROM dw_metric_revisions r WHERE r.metric_id = d.metric_id"
+            " AND r.status = 'published') AS published_count"
+            " FROM dw_metric_defs d" + clause
+            + f" ORDER BY {sort_expr} {direction}, d.metric_key ASC" + limit_clause,
+            tuple(query_params),
+        )
+        total = int(_fetch_one_dict(
+            c,
+            "SELECT COUNT(*) AS n FROM dw_metric_defs d" + clause,
+            tuple(params),
+        )["n"])
+        counts_row = _fetch_one_dict(
+            c,
+            "SELECT"
+            " SUM(CASE WHEN COALESCE(p.n, 0) > 0 THEN 1 ELSE 0 END) AS published,"
+            " SUM(CASE WHEN COALESCE(p.n, 0) = 0 THEN 1 ELSE 0 END) AS draft"
+            " FROM dw_metric_defs d"
+            " LEFT JOIN (SELECT metric_id, COUNT(*) AS n FROM dw_metric_revisions"
+            " WHERE status = 'published' GROUP BY metric_id) p"
+            " ON p.metric_id = d.metric_id"
+            " WHERE d.workspace_id = ?",
+            (workspace_id,),
+        ) or {}
+        return {
+            "rows": [{
+                "def": _row_to_def(row),
+                "revision_count": int(row.get("revision_count") or 0),
+                "has_published": int(row.get("published_count") or 0) > 0,
+            } for row in rows],
+            "total": total,
+            "page": int(page),
+            "page_size": int(page_size),
+            "status_counts": {
+                "published": int(counts_row.get("published") or 0),
+                "draft": int(counts_row.get("draft") or 0),
+            },
+        }
+    finally:
+        if own:
+            c.close()
+
+
+def update_def(
+    metric_id: str,
+    *,
+    name: str | None = None,
+    description: str | None = None,
+    owner: str | None = None,
+    conn: Any = None,
+) -> MetricDef | None:
+    """更新指标身份的可变字段（口径在修订里，不在此处）。
+
+    Args:
+        metric_id: 指标主键。
+        name: 新展示名；None 表示不改。
+        description: 新业务说明；None 表示不改。
+        owner: 新负责人；None 表示不改。
+
+    Returns:
+        更新后的指标身份；指标不存在时为 None。
+    """
+    updates: dict[str, Any] = {}
+    if name is not None:
+        updates["name"] = name
+    if description is not None:
+        updates["description"] = description
+    if owner is not None:
+        updates["owner"] = owner
+    if updates:
+        updates["updated_at"] = _now()
+    c, own = _conn_or(conn)
+    try:
+        if updates:
+            assignments = ", ".join(f"{key} = ?" for key in updates)
+            with _write_lock:
+                _exec(
+                    c,
+                    f"UPDATE dw_metric_defs SET {assignments} WHERE metric_id = ?",
+                    (*updates.values(), metric_id),
+                )
+                _commit_if_own(c, own)
+        return get_def(metric_id, conn=c)
+    finally:
+        if own:
+            c.close()
+
+
+def delete_def(metric_id: str, *, conn: Any = None) -> int:
+    """删除指标身份行，返回删除行数（级联由调用方按修订逐层清理）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_defs WHERE metric_id = ?", (metric_id,))
+            deleted = int(getattr(cursor, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
+def touch_def(metric_id: str, *, conn: Any = None) -> None:
+    """只刷新 ``updated_at``（新建修订等身份未变但内容变化的场景）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_defs SET updated_at = ? WHERE metric_id = ?",
+                (_now(), metric_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def set_current_revision(
+    metric_id: str, revision_id: str, *, status: str = "active", conn: Any = None
+) -> None:
+    """把指标身份的当前修订指向 ``revision_id``。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_defs SET current_revision_id = ?, status = ?, updated_at = ?"
+                " WHERE metric_id = ?",
+                (revision_id, status, _now(), metric_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+# ==========================================================================
+# 词法召回（指标身份 + 当前发布修订的关键词匹配）
+# ==========================================================================
+def search_defs(
+    workspace_id: str, query: str, *, limit: int = 20, conn: Any = None
+) -> list[tuple[MetricDef, float, str]]:
+    """按关键词召回指标，返回 (指标, 分数, 命中字段)。
+
+    打分权重：name > metric_key > 同义词 > 描述（沿旧 ``search_metrics``
+    的口径，作用于新表）。分值归一到 0~1。
+
+    Args:
+        workspace_id: 工作空间。
+        query: 自然语言问题或关键词。
+        limit: 返回上限。
+        conn: 可选的既有连接。
+
+    Returns:
+        ``(MetricDef, score, matched_on)`` 列表，按分数降序。
+    """
+    text = (query or "").strip()
+    if not text:
+        return []
+    terms = [t for t in _tokenize(text) if len(t) >= 2] or [text]
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c,
+            "SELECT d.*, r.display_name AS rev_display, r.synonyms AS rev_synonyms"
+            " FROM dw_metric_defs d"
+            " LEFT JOIN dw_metric_revisions r ON r.revision_id = d.current_revision_id"
+            " WHERE d.workspace_id = ?",
+            (workspace_id,),
+        )
+    finally:
+        if own:
+            c.close()
+    scored: list[tuple[MetricDef, float, str]] = []
+    for row in rows:
+        name = (row.get("rev_display") or row.get("name") or "").strip()
+        key = (row.get("metric_key") or "").strip()
+        synonyms = as_list(row.get("rev_synonyms"))
+        score = 0.0
+        matched = ""
+        for term in terms:
+            tl = term.lower()
+            if tl and tl in name.lower():
+                if score < 0.9:
+                    score, matched = 0.9, "name"
+            elif tl and tl in key.lower():
+                if score < 0.8:
+                    score, matched = 0.8, "metric_key"
+            elif any(tl in str(s).lower() for s in synonyms):
+                if score < 0.7:
+                    score, matched = 0.7, "synonym"
+        if score > 0:
+            row.pop("rev_display", None)
+            row.pop("rev_synonyms", None)
+            scored.append((_row_to_def(row), score, matched))
+    scored.sort(key=lambda item: (-item[1], item[0].metric_key))
+    return scored[:limit]
+
+
+def _tokenize(text: str) -> list[str]:
+    """粗分词：按空白与常见标点切，英文整词保留，中文按 2-gram。"""
+    import re
+
+    out: list[str] = []
+    for chunk in re.split(r"[\s,，。;；?？!！、/|]+", text):
+        if not chunk:
+            continue
+        if re.fullmatch(r"[A-Za-z0-9_.\-]+", chunk):
+            out.append(chunk)
+        else:
+            out.extend(chunk[i:i + 2] for i in range(len(chunk) - 1))
+    return out
+
+
