+
+    removed = _snapshot("run-3", "snapshot-3", include_amount=False)
+    events = diff_snapshots(previous, removed)
+    event = next(item for item in events if item.object_id.endswith(".amount"))
+    assert event.change_type == "removed"
+    assert event.severity == "highest"
