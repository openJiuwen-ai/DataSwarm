index 000000000..e9127501e
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/analysis/checks.py
@@ -0,0 +1,444 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/checks.py —— L3 程序化检查：scope 归属 + 口径一致性 + G 等级推导。
+
+职责边界（方案 v0.4）：程序只守边界——授权、只读、scope 归属、口径一致性；
+充分性与生成质量由模型负责。检查**逐项独立三态**（pass/fail/unknown）：
+检查不了的项记 ``unknown``，绝不硬猜 pass（sqlglot 语义判定的边缘多：
+别名/CTE/内联 CASE WHEN/嵌套聚合——宁可放过给 G 等级降档，不可误杀）。
+
+回源纪律：允许集（绑定列/维度白名单/快照列集）**每次请求重建**，客户端
+回传的 scope 仅作展示提示——防篡改扩权。
+"""
+from __future__ import annotations
+
+from typing import AbstractSet, Any
+
+import sqlglot
+from sqlglot import exp
+
+from jiuwenswarm.common import workspace_context
+
+from ..metrics import semantic_link, store
+from ..metrics.guard import allowed_objects, out_of_scope_columns, out_of_scope_tables
+from .model import (
+    CHECK_FAIL,
+    CHECK_PASS,
+    CHECK_UNKNOWN,
+    CheckResult,
+    GROUNDING_G1,
+    GROUNDING_G2,
+    GROUNDING_G3,
+    NON_AUTHORITY_NO_PROVIDER,
+)
+
+
+def temp_scope_tables_of(temp_scope: dict[str, Any] | None) -> dict[str, list[str]]:
+    """请求 temp_scope 的规范化表列形态（str 键值；execute 侧共用）。"""
+    return {
+        str(table): [str(column) for column in columns]
+        for table, columns in ((temp_scope or {}).get("tables") or {}).items()
+    }
+
+
+def uses_temp_scope(parsed: sqlglot.Expr, temp_tables: dict[str, list[str]],
+                    *, column_exempt: AbstractSet[str] = frozenset()) -> bool:
+    """SQL 是否引用了临时 scope 内的表或列（G3 判定原子；execute 侧共用）。"""
+    referenced_tables = {table.name for table in parsed.find_all(exp.Table) if table.name}
+    referenced_columns = ({column.name for column in parsed.find_all(exp.Column) if column.name}
+                          - column_exempt)
+    temp_columns = {column for cols in temp_tables.values() for column in cols}
+    return bool((referenced_tables & set(temp_tables))
+                or (referenced_columns & temp_columns))
+
+
+def check_request(body: dict[str, Any]) -> dict[str, Any]:
+    """scope 归属 + 口径一致性 + G 等级推导（check 端点入口）。
+
+    Args:
+        body: ``{"sql", "selected"?[{metric_key, revision_id}],
+        "scope"?（提示）, "temp_scope"?{tables: {tbl: [cols]}}, "time"?}``。
+
+    Returns:
+        ``{"checks": [CheckResult...], "grounding_level", "definition_grounded",
+        "non_authoritative_reasons", "retry_hint"?}``。
+
+    Raises:
+        ValueError: sql 为空或不可解析。
+    """
+    sql = str(body.get("sql") or "").strip()
+    if not sql:
+        raise ValueError("sql 不能为空")
+    selected = [
+        {"metric_key": str(item.get("metric_key") or "")}
+        for item in body.get("selected") or () if isinstance(item, dict)
+    ]
+    temp_scope_tables = temp_scope_tables_of(body.get("temp_scope"))
+    plan_time = body.get("time") if isinstance(body.get("time"), dict) else None
+
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    parsed = sqlglot.parse_one(sql, read="mysql")
+    # SELECT 输出别名在 ORDER BY/GROUP BY/HAVING 里的引用是合法 SQL——sqlglot
+    # 会把它们解析成 Column 节点，须先收集豁免，否则误判为幽灵列
+    select_aliases = _select_aliases(parsed)
+
+    # ---- 回源重建允许集 ----
+    revisions: list[Any] = []
+    bindings_by_revision: dict[str, list[Any]] = {}
+    contexts: list[Any] = []
+    for item in selected:
+        metric_key = item["metric_key"]
+        if not metric_key:
+            continue
+        revision = store.published_revision_of(workspace_id, metric_key)
+        if revision is None:
+            continue  # 非_published：G1 资格丧失，由等级推导反映
+        revisions.append(revision)
+        bindings = store.list_bindings(revision.revision_id)
+        bindings_by_revision[revision.revision_id] = bindings
+        try:
+            contexts.append(semantic_link.build_semantic_context(workspace_id, metric_key, None))
+        except Exception:  # noqa: BLE001 —— 语义上下文缺失：相关检查降 unknown
+            contexts.append(None)
+
+    snapshot_tables = _snapshot_scope_tables()
+    checks: list[CheckResult] = []
+
+    # ---- ① scope 归属检查（越界回喂）----
+    allowed_tables, allowed_columns = allowed_objects(revisions, bindings_by_revision)
+    snapshot_all_columns = {col for cols in snapshot_tables.values() for col in cols}
+    temp_all_columns = {col for cols in temp_scope_tables.values() for col in cols}
+    union_tables = allowed_tables | set(snapshot_tables) | set(temp_scope_tables)
+    union_columns = allowed_columns | snapshot_all_columns | temp_all_columns
+    checks.append(_check_scope(parsed, union_tables, union_columns, select_aliases))
+
+    # ---- ② 口径一致性检查（有选定指标必跑）----
+    if revisions:
+        checks.extend(_check_caliber_consistency(
+            parsed, revisions, bindings_by_revision, contexts, plan_time,
+            select_aliases))
+    else:
+        checks.append(CheckResult(
+            "metric_caliber", CHECK_UNKNOWN,
+            "无选定指标——口径一致性检查不适用（G 等级不可能是 G1）"))
+
+    # ---- ③ G 等级推导（事后按 SQL 实际引用对象）----
+    grounding, reasons = _derive_grounding(
+        parsed, revisions, checks, allowed_tables, allowed_columns,
+        snapshot_tables, temp_scope_tables, select_aliases)
+    response: dict[str, Any] = {
+        "checks": [c.to_dict() for c in checks],
+        "grounding_level": grounding,
+        "definition_grounded": grounding == GROUNDING_G1,
+        "query_semantics_verified": False,
+        "authoritative": False,
+        "non_authoritative_reasons": [NON_AUTHORITY_NO_PROVIDER, *reasons],
+    }
+    scope_fail = next((c for c in checks if c.name == "scope_membership" and c.status == CHECK_FAIL), None)
+    if scope_fail is not None:
+        response["retry_hint"] = (
+            f"SQL 引用了上下文与临时 scope 之外的对象：{scope_fail.detail}——"
+            "请改写 SQL 只用已给对象，或先经探索工具（recall_more/list_tables/"
+            "describe_table/probe_values/check_join）把对象补进临时 scope")
+    else:
+        caliber_fails = [c for c in checks
+                         if c.status == CHECK_FAIL and c.name != "scope_membership"]
+        if caliber_fails:
+            # 口径类失败也要给修正指引：编排层纪律是「fail 只看 retry_hint」，
+            # 只给 checks 明细会让模型原地重试同一条 SQL（实测连续两轮同样失败）
+            response["retry_hint"] = "；".join(
+                f"{_CALIBER_HINTS.get(c.name, c.name)}（{c.detail}）" for c in caliber_fails)
+    return response
+
+
+# 口径失败项 → 一句修正方向（给编排层的 retry_hint 用）
+_CALIBER_HINTS = {
+    "tables_columns_subset_binding": "改用指标绑定内的表列（越界的表列不属于该指标口径）",
+    "groupby_subset_whitelist": "GROUP BY 只能用指标允许的业务维度或它声明的时间字段",
+    "fixed_filters_present": "补上指标定义的固定过滤条件（缺了就不是这个口径）",
+    "time_boundary_shape": "时间边界改成左闭右开（>= AND <），不要用 BETWEEN",
+    "aggregate_type_consistency": "聚合函数换成指标定义声明的那个算子",
+    "ratio_components": "比率指标的分子分母都要出现在 SQL；若是报告层派生则移到 derived_metrics",
+}
+
+
+# ==========================================================================
+# scope 归属
+# ==========================================================================
+
+def _check_scope(parsed: sqlglot.Expr, allowed_tables: set[str],
+                 allowed_columns: set[str],
+                 select_aliases: set[str] | None = None) -> CheckResult:
+    """SQL 引用的表列必须都在允许集内（上下文包 ∪ 临时 scope ∪ SELECT 别名）。"""
+    violations = [*(f"表 {name}" for name in out_of_scope_tables(parsed, allowed_tables)),
+                  *(f"列 {name}" for name in out_of_scope_columns(
+                      parsed, allowed_columns, column_exempt=select_aliases or set()))]
+    if violations:
+        return CheckResult("scope_membership", CHECK_FAIL, "、".join(violations))
+    if not allowed_columns and not allowed_tables:
+        return CheckResult("scope_membership", CHECK_UNKNOWN, "允许集为空（无快照无绑定无临时 scope）")
+    return CheckResult("scope_membership", CHECK_PASS, "")
+
+
+# ==========================================================================
+# 口径一致性（六项）
+# ==========================================================================
+
+def _check_caliber_consistency(
+    parsed: sqlglot.Expr,
+    revisions: list[Any],
+    bindings_by_revision: dict[str, list[Any]],
+    contexts: list[Any],
+    plan_time: dict[str, Any] | None,
+    select_aliases: set[str] | None = None,
+) -> list[CheckResult]:
+    """六项口径检查（方案 L3③；逐项独立三态，检查不了记 unknown）。"""
+    aliases = select_aliases or set()
+    results: list[CheckResult] = []
+
+    # 1. 引用表列 ⊆ 绑定
+    allowed_tables, allowed_columns = allowed_objects(revisions, bindings_by_revision)
+    out_of_binding = [*(f"表 {name}" for name in out_of_scope_tables(parsed, allowed_tables)),
+                      *(f"列 {name}" for name in out_of_scope_columns(
+                          parsed, allowed_columns, column_exempt=aliases))]
+    if out_of_binding:
+        results.append(CheckResult("tables_columns_subset_binding", CHECK_FAIL,
+                                   "、".join(out_of_binding)))
+    else:
+        results.append(CheckResult("tables_columns_subset_binding", CHECK_PASS, ""))
+
+    # 2. GROUP BY ⊆ 维度白名单
+    groupby_columns = {column.name for group in parsed.find_all(exp.Group)
+                       for column in group.find_all(exp.Column)}
+    whitelist = _dimension_whitelist(contexts)
+    if whitelist is None:
+        results.append(CheckResult("groupby_subset_whitelist", CHECK_UNKNOWN,
+                                   "维度白名单不可得（语义上下文缺失）"))
+    elif groupby_columns - whitelist:
+        results.append(CheckResult("groupby_subset_whitelist", CHECK_FAIL,
+                                   "越界维度: " + "、".join(sorted(groupby_columns - whitelist))))
+    else:
+        results.append(CheckResult("groupby_subset_whitelist", CHECK_PASS, ""))
+
+    # 3. 固定过滤全部出现（内联 CASE WHEN 也算引用——guard 同口径）
+    referenced = {column.name for column in parsed.find_all(exp.Column) if column.name}
+    missing_filters = []
+    for rev in revisions:
+        for flt in rev.fixed_filters or ():
+            field = str(flt.get("field") or "")
+            column_name = field.split(".")[-1]
+            if column_name and column_name not in referenced:
+                missing_filters.append(field)
+    if missing_filters:
+        results.append(CheckResult("fixed_filters_present", CHECK_FAIL,
+                                   "固定过滤缺失: " + "、".join(missing_filters)))
+    else:
+        results.append(CheckResult("fixed_filters_present", CHECK_PASS,
+                                   "" if referenced else "SQL 无列引用，无法核验"))
+
+    # 4. 时间边界形态：BETWEEN 双闭 = fail；>= AND < = pass；找不到 = unknown
+    results.append(_check_time_boundary(parsed, plan_time))
+
+    # 5. 聚合函数类型与定义一致（SUM/COUNT/AVG/DISTINCT vs expression.operator）
+    results.append(_check_aggregate_type(parsed, revisions))
+
+    # 6. ratio 分子分母均出现且各自聚合
+    results.append(_check_ratio_components(parsed, contexts))
+
+    return results
+
+
+def _check_time_boundary(parsed: sqlglot.Expr, plan_time: dict[str, Any] | None) -> CheckResult:
+    """时间条件与计划一致：左闭右开不得变成 BETWEEN。"""
+    between_nodes = list(parsed.find_all(exp.Between))
+    if between_nodes:
+        return CheckResult("time_boundary_shape", CHECK_FAIL,
+                           "时间条件使用了 BETWEEN（双闭区间）——必须保持左闭右开（>= AND <）")
+    # 只认时间性比较（>=/>/</<=）——EQ 过滤（如 pay_status='paid'）不算时间条件
+    time_comparisons = [
+        node for node in parsed.find_all(exp.Binary)
+        if isinstance(node, (exp.GTE, exp.GT, exp.LT, exp.LTE))
+    ]
+    has_half_open = any(isinstance(node, (exp.GTE, exp.LT)) for node in time_comparisons)
+    if not time_comparisons:
+        if not plan_time:
+            return CheckResult("time_boundary_shape", CHECK_UNKNOWN,
+                               "计划未声明时间窗——SQL 无时间条件为合法（全量口径）")
+        return CheckResult("time_boundary_shape", CHECK_UNKNOWN,
+                           "计划声明了时间窗但 SQL 无时间条件——请核对是否漏了过滤")
+    if has_half_open:
+        return CheckResult("time_boundary_shape", CHECK_PASS, "")
+    # 有时间性比较但无 >=/< 形态（如 > <=）——保守 unknown
+    return CheckResult("time_boundary_shape", CHECK_UNKNOWN,
+                       "时间条件未构成左闭右开形态（应为 >= AND <）")
+
+
+def _check_aggregate_type(parsed: sqlglot.Expr, revisions: list[Any]) -> CheckResult:
+    """聚合函数类型与指标定义一致（expression.parsed.operator vs SQL 聚集）。"""
+    sql_aggregates = {
+        type(node).__name__.upper() for node in parsed.find_all(
+            exp.AggFunc)
+    }
+    if not sql_aggregates:
+        return CheckResult("aggregate_type_consistency", CHECK_UNKNOWN, "SQL 无聚合函数")
+    declared: set[str] = set()
+    unparsed = False
+    for rev in revisions:
+        if rev.expression is not None and rev.expression.parsed is not None:
+            operator = str(getattr(rev.expression.parsed, "operator", "") or "").upper()
+            if operator:
+                declared.add(operator)
+        elif rev.expression is not None and rev.expression.unparsed_reason:
+            unparsed = True
+    if not declared:
+        return CheckResult("aggregate_type_consistency", CHECK_UNKNOWN,
+                           "指标表达式未解析" if unparsed else "无声明算子")
+    # 声明算子与 SQL 聚集做交集判定（SUM↔Sum、COUNT↔Count、AVG↔Avg）
+    normalized_sql = {name.upper() for name in sql_aggregates}
+    if declared & normalized_sql:
+        return CheckResult("aggregate_type_consistency", CHECK_PASS, "")
+    return CheckResult("aggregate_type_consistency", CHECK_FAIL,
+                       f"SQL 聚集 {sorted(normalized_sql)} 与定义算子 {sorted(declared)} 不一致")
+
+
+def _check_ratio_components(parsed: sqlglot.Expr, contexts: list[Any]) -> CheckResult:
+    """ratio 指标：分子分母均出现且各自聚合（有 confirmed 分子/分母时）。"""
+    ratios = [ctx for ctx in contexts
+              if ctx is not None and getattr(ctx, "numerator", None)
+              and getattr(ctx, "denominator", None)]
+    if not ratios:
+        return CheckResult("ratio_components", CHECK_UNKNOWN, "非 ratio 指标或分子分母未确认")
+    referenced = {column.name for column in parsed.find_all(exp.Column) if column.name}
+    missing: list[str] = []
+    for ctx in ratios:
+        for role in ("numerator", "denominator"):
+            expression = str(getattr(ctx, role) or "")
+            role_columns = _columns_of_expression(expression)
+            if role_columns and not (role_columns & referenced):
+                missing.append(f"{getattr(ctx, 'label', '')}.{role}")
+    if missing:
+        return CheckResult("ratio_components", CHECK_FAIL,
+                           "缺失: " + "、".join(missing)
+                           + "——若该指标是报告层派生（取数不直接产出），请把它从 "
+                           "selected 移到 derived_metrics")
+    return CheckResult("ratio_components", CHECK_PASS, "")
+
+
+def _columns_of_expression(expression: str) -> set[str]:
+    """表达式文本里出现的标识符（列名近似提取——保守集合）。"""
+    import re
+
+    return {token for token in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", expression or "")
+            if token.upper() not in {"SUM", "COUNT", "AVG", "MIN", "MAX", "DISTINCT",
+                                     "CASE", "WHEN", "THEN", "ELSE", "END", "NULLIF"}}
+
+
+# ==========================================================================
+# G 等级推导（事后按 SQL 实际引用对象，取最低）
+# ==========================================================================
+
+def _derive_grounding(
+    parsed: sqlglot.Expr,
+    revisions: list[Any],
+    checks: list[CheckResult],
+    allowed_tables: set[str],
+    allowed_columns: set[str],
+    snapshot_tables: dict[str, list[str]],
+    temp_scope_tables: dict[str, list[str]],
+    select_aliases: set[str] | None = None,
+) -> tuple[str, list[str]]:
+    """G1/G2/G3 事后推导 + 非权威叠加原因。"""
+    aliases = select_aliases or set()
+    reasons: list[str] = []
+    referenced_tables = {table.name for table in parsed.find_all(exp.Table) if table.name}
+    referenced_columns = {column.name for column in parsed.find_all(exp.Column)
+                          if column.name} - aliases
+    if uses_temp_scope(parsed, temp_scope_tables, column_exempt=aliases):
+        reasons.append("temporary_scope")
+
+    # join 证据等级在 scope 层即可见（推断级 join 产物标 inferred_join）——
+    # 由 execute 阶段按 scope.joins 判定，这里先不加。
+
+    caliber_failed = any(
+        c.status == CHECK_FAIL for c in checks
+        if c.name != "scope_membership")
+    scope_failed = any(
+        c.name == "scope_membership" and c.status == CHECK_FAIL for c in checks)
+
+    has_published_selected = bool(revisions)
+    within_binding = (
+        not scope_failed
+        and (not referenced_tables or referenced_tables <= allowed_tables)
+        and (not referenced_columns or referenced_columns <= allowed_columns))
+
+    if has_published_selected and within_binding and not caliber_failed:
+        return GROUNDING_G1, reasons
+    snapshot_all = set(snapshot_tables)
+    snapshot_cols = {col for cols in snapshot_tables.values() for col in cols}
+    within_snapshot = (
+        (not referenced_tables or referenced_tables <= snapshot_all)
+        and (not referenced_columns or referenced_columns <= snapshot_cols))
+    if within_snapshot and not scope_failed:
+        return GROUNDING_G2, reasons
+    return GROUNDING_G3, reasons
+
+
+# ==========================================================================
+# 允许集构造
+# ==========================================================================
+
+def _select_aliases(parsed: sqlglot.Expr) -> set[str]:
+    """SELECT 输出别名集合（含窗口函数别名）。
+
+    ``ORDER BY gmv_cny``（引用 ``SUM(x) AS gmv_cny``）是合法 SQL，但 sqlglot
+    解析为 Column 节点——scope/绑定/口径检查须豁免，否则误判幽灵列。
+    """
+    aliases: set[str] = set()
+    for select in parsed.find_all(exp.Select):
+        for output in select.expressions:
+            if isinstance(output, exp.Alias):
+                alias = output.alias
+                if alias:
+                    aliases.add(alias)
+    return aliases
+
+
+def _dimension_whitelist(contexts: list[Any]) -> set[str] | None:
+    """维度白名单：``group_by_fields`` ∪ ``time_field``（物理形态取列名）。
+
+    **时间字段必须并入**：指标定义把「用哪一列算时间」（``time_field``）与
+    「允许按哪些业务维度拆」（``group_by_fields``，地区/品类这类）分开存，但
+    「按月看趋势」必然把时间列写进 GROUP BY（``DATE_FORMAT(purchase_ts,
+    '%Y-%m')``）——不并入就会把**所有趋势类分析**判成越界维度，逼模型反复
+    重试、最后绕开指标口径降级走探索口径（实测事故：按月看 GMV 趋势连续
+    两轮 fail，产物从 G1 掉到 G2）。
+
+    用**别的**时间列分组仍然会被拦——它不在白名单内，与现在的判定一致。
+
+    Returns:
+        白名单列名集合；任一上下文缺失返回 None（调用方记 unknown）。
+    """
+    whitelist: set[str] = set()
+    for ctx in contexts:
+        if ctx is None:
+            return None
+        for field in getattr(ctx, "group_by_fields", ()) or ():
+            whitelist.add(str(field).split(".")[-1])
+        time_field = getattr(ctx, "time_field", None)
+        if time_field:
+            whitelist.add(str(time_field).split(".")[-1])
+    return whitelist
+
+
+def _snapshot_scope_tables() -> dict[str, list[str]]:
+    """当前 published 快照的表列集（G2 面；快照缺席返回空）。"""
+    warnings: list[str] = []
+    _refs, snapshots = semantic_link.current_snapshots(warnings)
+    tables: dict[str, list[str]] = {}
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            columns = [column.name for column in table.columns if column.status == "active"]
+            existing = tables.setdefault(table.name, [])
+            for column in columns:
+                if column not in existing:
+                    existing.append(column)
+    return tables
