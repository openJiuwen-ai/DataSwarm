+                             ? t('biMetrics.form.noDatasources')
+                             : undefined}>
+                    <select className={inputClass} value={bindingAlias}
+                            onChange={(e) => {
+                              setBindingAlias(e.target.value);
+                              // 换数据源后旧表/列映射不再适用
+                              setBindingTable('');
+                              setColumnMapJson('');
+                            }}>
+                      <option value="">{t('biMetrics.form.pickDatasource')}</option>
