@@ -0,0 +1,28 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""为 FTP 验收提供仅监听 loopback 的只读 pyftpdlib 服务。
+
+用法：ftp_server.py <serve_dir> <port>。pyftpdlib 仅是验收依赖；
+产品客户端使用 ftplib，允许列目录和下载，不授予远端写权限。
+"""
+import sys
+from pathlib import Path
+
+from pyftpdlib.authorizers import DummyAuthorizer
+from pyftpdlib.handlers import FTPHandler
+from pyftpdlib.servers import FTPServer
+
+SERVE_DIR = Path(sys.argv[1]).resolve()
+PORT = int(sys.argv[2])
+USER, PASSWORD = "dsuser", "dspass"
+
+authorizer = DummyAuthorizer()
+# elr 仅允许切换目录、列目录和下载，服务端不授予写权限。
+authorizer.add_user(USER, PASSWORD, str(SERVE_DIR), perm="elr")
+
+handler = FTPHandler
+handler.authorizer = authorizer
+handler.passive_ports = range(60000, 60020)
+
+server = FTPServer(("127.0.0.1", PORT), handler)
+print(f"FTP_SERVER_READY port={PORT} dir={SERVE_DIR} user={USER}", flush=True)
+server.serve_forever()
