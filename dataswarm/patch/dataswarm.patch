+@register_ref_codec
+class DuckDBRefCodec(RefCodec):
+    """文件 / 对象存储源：不走 Engine 池，由 DuckDBConnector 桥接自管 I/O。"""
+
+    scheme = "duckdb"
+    dialect = "duckdb"
+    uses_pool = False
+    default_schema = "main"
+
+    def decode(self, rest: str, db_ref: str) -> dict:
+        # 同 SqliteRefCodec：type 以 self.scheme 为准，便于子类复用本族逻辑。
+        return {**_parse_duckdb_ref(rest), "type": self.scheme}
+
+    def list_tables(self, spec: dict) -> dict:
+        connector = _duckdb_connector(spec)
+        try:
+            catalog = connector.catalog()
+        finally:
+            connector.close()
+        if spec["source_type"] == "duckdb":
+            # 原生库可有多个 schema 和同名表；完整引用避免治理、预览串表。
+            from jiuwenswarm.common.dialect_registry import quote_ident as _quote
+
+            names = [
+                ".".join(_quote("duckdb", part) for part in (d["schema"], d["name"]))
+                for d in catalog.get("datasets", [])
+            ]
+        else:
+            names = [d["name"] for d in catalog.get("datasets", [])]
+        return {"tables": names, "table_count": len(names), "db": _duckdb_meta(spec)}
+
+    def describe(self, spec: dict, table: str) -> dict:
+        connector = _duckdb_connector(spec)
+        try:
+            result = connector.schema(table)
+        finally:
+            connector.close()
+        metadata = {
+            key: result[key] for key in ("comment", "ddl", "indexes", "foreign_keys")
+            if key in result
+        }
+        return {
+            **metadata,
+            "table": table,
+            "columns": [
+                {
+                    "name": c["name"],
+                    "type": c["type"],
+                    "null": c.get("nullable", True),
+                    # 与 SqliteRefCodec / MySQL 族对齐：下游按 pk 排除技术列。
+                    "pk": bool(c.get("pk")),
+                    "comment": c.get("comment") or "",
+                    "default": c.get("default"),
+                }
+                for c in result["columns"]
+            ],
+            "db": _duckdb_meta(spec),
+        }
+
+    def meta(self, spec: dict) -> dict:
+        return _duckdb_meta(spec)
+
+    def query(self, spec: dict, sql: str, params=None, limit: int = 100) -> dict:
+        connector = _duckdb_connector(spec)
+        try:
+            return connector.query(sql, params=params, limit=limit)
+        finally:
+            connector.close()
+
+
+@register_ref_codec
+class DdlRefCodec(_DelegatingRefCodec):
+    """DDL references recover their source text from the owning workspace."""
+
+    scheme = "ddl"
+    dialect = "duckdb"  # No SQL execution; DDL parsing uses its saved dialect.
+    target_engine = "schema_only"
+
+    def decode(self, rest: str, db_ref: str) -> dict:
+        if not re.fullmatch(r"[0-9a-f]{16}", rest):
+            raise ValueError("invalid ddl source fingerprint")
+        return {"type": self.scheme, "fingerprint": rest}
+
+    def _config_from_spec(self, spec: dict) -> dict:
+        config = spec.get("_source_config")
+        if not config or not config.get("ddl_text"):
+            raise ValueError("DDL source configuration not found in current workspace")
+        return dict(config)
+
+    def query(self, spec: dict, sql: str, params=None, limit: int = 100) -> dict:
+        return RefCodec.query(self, spec, sql, params=params, limit=limit)
+
+
+def parse_db_ref(db_ref: str) -> dict:
+    """解析 db-ref 成统一结构 {type, host, port, user, password, database, path}。
+
+    - sqlite://path/to/x.db  或 裸路径 → sqlite
+    - doris://host:port/db   或 doris://（环境变量补全）→ doris
+    - doris://dbname         指针自带库名（无 / 无 :）→ 库名取自指针，凭据仍走 config 段
+    - doris://meta 特殊标记：用 config 的 metadata_database 而非 database
+    - duckdb://<location>?source_type=csv&table_name=x → 文件/对象存储源（DuckDB 引擎）
+
+    scheme 的具体解析逻辑由各自的 :class:`RefCodec` 提供，本函数负责分发。
+    """
+    if not db_ref:
+        raise ValueError("db_ref 为空")
+    # 裸路径（无 scheme）默认 sqlite
+    if "://" not in db_ref:
+        return {"type": "sqlite", "path": db_ref}
+    scheme, rest = db_ref.split("://", 1)
+    codec = codec_for(scheme)
+    return codec.decode(rest, db_ref)
+
+
+def _saved_source_spec(db_ref: str, spec: dict | None = None) -> dict:
+    """Enrich only an I/O operation, leaving standalone ref decoding pure."""
+    from jiuwenswarm.channels.web.dataagent.datasource import store as source_store
+
+    spec = dict(spec if spec is not None else parse_db_ref(db_ref))
+    saved = source_store.find_config_by_ref(db_ref, spec.get("source_type") or spec["type"])
+    if saved is not None:
+        spec["_source_config"] = saved
+    return spec
+
+
+def lineage_db_name(db_ref: str | None) -> str:
+    """Return the logical database name used by lineage edges."""
+    if not db_ref:
+        return ""
+    try:
+        spec = parse_db_ref(db_ref)
+    except (TypeError, ValueError):
+        return ""
+    if spec.get("type") == "duckdb":
+        return str(spec.get("table_name") or spec.get("database") or "")
+    if spec.get("type") == "sqlite":
+        return ""
+    return str(spec.get("database") or "")
+
+
+def quote_ident(db_ref: str, name: str) -> str:
+    """按注册方言引用标识符，支持双引号、反引号和成对方括号。"""
+    from jiuwenswarm.common.dialect_registry import quote_ident as _quote
+
+    db_type = parse_db_ref(db_ref).get("type", "sqlite")
+    return _quote(db_type, name)
+
+
+# ==========================================================================
+# 连接
+# ==========================================================================
+def _connect_direct(db_ref: str, read_only: bool = True):
+    """直连（不经池）。迁移脚本/一次性探活用；_acquire 不走这里。
+
+    返回 (conn, meta)。conn 是原生 sqlite3.Connection / pymysql.Connection，
+    暴露完整 DBAPI 接口（execute/cursor/commit/rollback/close）。
+    """
+    spec = parse_db_ref(db_ref)
+    return codec_for(spec["type"]).connect_direct(spec, read_only)
+
+
+def connect(db_ref: str, read_only: bool = True):
+    """连接数据库，返回 (conn, meta)。
+
+    迁移脚本/一次性探活调本函数（直连，用完自己 close）；
+    query/tables/schema/execute 等巡检函数走 _acquire（SQLAlchemy Engine 池复用）。
+    两者返回的 conn 都暴露 DBAPI 接口（.execute/.cursor/.commit/.close/.fetchall）。
+    """
+    return _connect_direct(db_ref, read_only=read_only)
+
+
+# ==========================================================================
+# 进程级连接池：SQLAlchemy Engine（QueuePool + pool_pre_ping）
+# ==========================================================================
+# 不再手写探活/ping/重建/close_atexit——池化交给 SQLAlchemy。
+# db-ref 是运行时字符串（连不同库），按 db-ref 缓存 Engine：Engine 内部的
+# QueuePool 才是真正的池（连接复用、pool_pre_ping 自动探活、pool_recycle 防空闲踢）。
+# Doris 公网单次建连 ~0.12s，40 表 × 4 函数复用一条连接后 schema 仅 ~1.5s。
+_ENGINES: dict[str, "Engine"] = {}  # pool_key -> Engine（Engine 内自带 QueuePool）
+# 首次创建锁：_engine_for 是 check-then-act，多线程同时首用会各自 create_engine
+# （重复对象 + 多余物理连接）。double-checked 锁保证每 key 只建一次（线程化巡检规约）。
+_ENGINE_LOCK = threading.Lock()
+
+
+def _pool_engine_kwargs() -> dict:
+    """Engine 构造参数。池容量可用环境变量收紧，支撑 E3 连接预算（默认沿用 SQLAlchemy）。"""
+    kwargs: dict = {"pool_pre_ping": True, "pool_recycle": 1800}
+    ps = os.environ.get("JIUWENSWARM_DB_POOL_SIZE", "").strip()
+    mo = os.environ.get("JIUWENSWARM_DB_MAX_OVERFLOW", "").strip()
+    if ps.isdigit():
+        kwargs["pool_size"] = int(ps)
+    if mo.isdigit():
+        kwargs["max_overflow"] = int(mo)
+    return kwargs
+
+
+def _pool_key(db_ref: str, read_only: bool) -> str:
+    """Engine 缓存 key：db-ref 规范化 + 读写模式。只读与读写隔离（sqlite ro 用 uri）。
+
+    doris:// 与 doris://olist 都映射到同一个 doris 库（database 在 meta 里），
+    但 db-ref 不同就分开缓存，尊重调用方意图。
+    """
+    return f"{db_ref}|{'ro' if read_only else 'rw'}"
+
+
+def _engine_url(spec: dict, read_only: bool) -> str:
+    """通过 RefCodec 将连接 spec 转为 SQLAlchemy URL。"""
+    return codec_for(spec["type"]).engine_url(spec, read_only)
+
+
+def _engine_for(db_ref: str, read_only: bool):
+    """取（或首次建）Engine。double-checked：并发首用只建一次（E1 并行前置条件）。"""
+    key = _pool_key(db_ref, read_only)
+    eng = _ENGINES.get(key)
+    if eng is not None:
+        return eng
+    with _ENGINE_LOCK:
+        eng = _ENGINES.get(key)
+        if eng is not None:
+            return eng
+        spec = parse_db_ref(db_ref)
+        url = _engine_url(spec, read_only)
+        # pool_pre_ping：借出前自动探活，踢掉服务端已断的连接（取代手写 ping）。
+        # pool_recycle：防 Doris 空闲超时踢连（比服务端 idle timeout 短，主动 recycle）。
+        kwargs = _pool_engine_kwargs()
+        if spec["type"] == "sqlite":
+            # 并发写：busy_timeout 等待锁（默认 5s 太短，工作流并行节点会撞锁）。
+            kwargs["connect_args"] = {"timeout": 60, "check_same_thread": False}
+        if create_engine is None:
+            raise ImportError("SQLAlchemy 未安装，请 uv pip install sqlalchemy")
+        eng = create_engine(url, **kwargs)
+        if spec["type"] == "sqlite" and not read_only:
+            from sqlalchemy import event
+
+            @event.listens_for(eng, "connect")
+            def _sqlite_pragmas(dbapi_conn, _record):  # noqa: ANN001
+                cur = dbapi_conn.cursor()
+                try:
+                    cur.execute("PRAGMA journal_mode=WAL")
+                    cur.fetchone()
+                    cur.execute("PRAGMA busy_timeout=60000")
+                finally:
+                    cur.close()
+
+        _ENGINES[key] = eng
+        return eng
+
+
+def _meta_for(spec: dict, read_only: bool) -> dict:
+    """从 spec 构造 meta（与 connect 的 meta 结构一致，供调用方判断库类型）。"""
+    if spec["type"] == "sqlite":
+        return {"type": "sqlite", "path": spec["path"], "read_only": read_only}
+    return {
+        "type": spec["type"],
+        "host": spec.get("host"),
+        "port": spec.get("port"),
+        "user": spec.get("user"),
+        "database": spec.get("database"),
+        "is_metadata": spec.get("is_metadata", False),
+        "read_only": read_only,
+    }
+
+
+def _acquire(db_ref: str, read_only: bool = True):
+    """从 Engine 池借一条连接。返回 (conn, meta)。调用方用完 .close() 归还池（非真关）。
+
+    conn 是 SQLAlchemy _ConnectionFairy，代理底层 DBAPI 连接，暴露完整 DBAPI 接口
+    （.execute/.cursor/.commit/.rollback/.close/.fetchall/.row_factory）——与直连一致，
+    调用方零改动。出错时 dispose 该 Engine（下次重建）。
+    """
+    spec = parse_db_ref(db_ref)
+    if create_engine is None:
+        # SQLAlchemy 不可用：退化为直连（不池化，每次建连）
+        return _connect_direct(db_ref, read_only=read_only)
+    eng = _engine_for(db_ref, read_only)
+    try:
+        conn = eng.raw_connection()
+    except Exception:
+        _invalidate(db_ref, read_only)
+        raise
+    meta = _meta_for(spec, read_only)
+    # 驱动级初始化交给 codec，例如 SQLite 的 row_factory。
+    codec_for(spec["type"]).post_connect(conn, read_only)
+    return conn, meta
+
+
+def _invalidate(db_ref: str, read_only: bool = True):
+    """查询出错时 dispose 该 Engine，下次 _acquire 重建。避免复用坏连接。"""
+    key = _pool_key(db_ref, read_only)
+    eng = _ENGINES.pop(key, None)
+    if eng is not None:
+        try:
+            eng.dispose()
+        except Exception:
+            pass
+
+
+def close_all():
+    """显式收尾：dispose 全部 Engine（归真关闭池中连接）。长驻进程需要时手动调。"""
+    for eng in list(_ENGINES.values()):
+        try:
+            eng.dispose()
+        except Exception:
+            pass
+    _ENGINES.clear()
+
+
+def _resolve_mysql_env(spec: dict, default_prefix: str) -> dict:
+    """补全 doris/mysql 的 host/user/password 等缺失项。
+
+    优先级：spec（db-ref 里给的）> config 的 doris:/mysql: 段 > 环境变量。
+    """
+    section = spec["type"]  # doris / mysql
+    cfg = _read_config_section(section)
+
+    def pick(key: str, env_prefix: str = default_prefix):
+        v = spec.get(key)
+        if v:
+            return v
+        v = cfg.get(key)
+        if v:
+            return v
+        return os.environ.get(f"{env_prefix}_{key.upper()}", "")
+
+    host = pick("host")
+    port = (
+        spec.get("port")
+        or cfg.get("port")
+        or int(os.environ.get(f"{default_prefix}_PORT", "0") or 0)
+        or (9030 if spec["type"] == "doris" else 3306)
+    )
+    user = pick("user")
+    password = pick("password")
+    database = pick("database")
+    return {
+        "host": host,
+        "port": int(port) if port else (9030 if spec["type"] == "doris" else 3306),
+        "user": user,
+        "password": password,
+        "database": database,
+        "connect_timeout": 10,
+        "read_timeout": 30,
+        "write_timeout": 30,
+        "charset": "utf8mb4",
+    }
+
+
+# ==========================================================================
+# 只读护栏（跨库通用）
+# ==========================================================================
+def assert_readonly(sql: str) -> None:
+    """MVP 护栏：只拦 DELETE（删数据），其余 SQL 不做只读校验。
+
+    原首关键字白名单 + 关键字黑名单在 MVP 阶段过严——SHOW CREATE TABLE 等
+    元数据内省语句正文含 create 会被误杀。写操作仍建议走 execute 通道（--confirm）。
+    """
+    s = sql.strip().rstrip(";").strip()
+    s = re.sub(r"--.*?$", "", s, flags=re.M)
+    s = re.sub(r"/\*.*?\*/", "", s, flags=re.S)
+    s = s.strip()
+    if not s:
+        raise ValueError("SQL 为空")
+    if re.search(r"\bdelete\b", s.lower()):
+        raise ValueError("只读动作，拒绝 DELETE（删数据操作请走 execute 通道并确认）")
+
+
+def _is_select_like(sql: str) -> bool:
+    """判定 SQL 是否为可安全追加 LIMIT 的结果集查询（方案 §3.1 G1）。
+
+    只对 SELECT / WITH 生效——SHOW CREATE TABLE / DESCRIBE / PRAGMA / SHOW INDEX 等
+    元数据内省语句不接受 LIMIT，一律追加会拼坏（errCode 1105 / syntax error）。
+    """
+    s = sql.strip().rstrip(";").strip()
+    s = re.sub(r"--.*?$", "", s, flags=re.M)
+    s = re.sub(r"/\*.*?\*/", "", s, flags=re.S)
+    s = s.strip()
+    if not s:
+        return False
+    first = re.split(r"[\s(]+", s, 1)[0].lower()
+    return first in ("select", "with")
+
+
+def add_limit_guard(sql: str, limit: int = DEFAULT_LIMIT) -> str:
+    """对结果集查询追加 LIMIT 防护；非结果集语句原样返回（方案 §3.1 G1）。
+
+    旧行为：无 LIMIT 一律追加 → 拼坏 SHOW CREATE TABLE / DESCRIBE / SHOW INDEX / PRAGMA。
+    新行为：只对 SELECT/WITH 追加；其余元数据内省语句原样返回。
+    """
+    s = sql.strip().rstrip(";").strip()
+    if not _is_select_like(s):
+        return sql
+    if re.search(r"\blimit\s+\d+", s, flags=re.I):
+        return sql
+    return f"{s} LIMIT {limit}"
+
+
+# ==========================================================================
+# 操作函数（模块 import 用）
+# ==========================================================================
+def _sql_chunks(sql: str, db_type: str):
+    """Yield code and protected literals/comments without rewriting their text.
+
+    Only executable question marks are bind placeholders. PostgreSQL dollar
+    strings may contain ordinary quote characters.
+    """
+    start = index = 0
+    length = len(sql)
+    while index < length:
+        end = None
+        kind = "protected"
+        if sql.startswith("--", index):
+            newline = sql.find("\n", index + 2)
+            end = length if newline < 0 else newline + 1
+        elif sql.startswith("/*", index):
+            depth, pos = 1, index + 2
+            while pos < length and depth:
+                if sql.startswith("/*", pos):
+                    depth += 1
+                    pos += 2
+                elif sql.startswith("*/", pos):
+                    depth -= 1
+                    pos += 2
+                else:
+                    pos += 1
+            end = pos
+        elif db_type in {"mysql", "doris", "mariadb", "starrocks"} and sql[index] == "#":
+            newline = sql.find("\n", index + 1)
+            end = length if newline < 0 else newline + 1
+        elif db_type in {"postgres", "postgresql", "hologres"} and sql[index] == "$":
+            match = re.match(r"\$(?:[A-Za-z_]\w*)?\$", sql[index:])
+            if match:
+                tag = match.group(0)
+                found = sql.find(tag, index + len(tag))
+                end = length if found < 0 else found + len(tag)
+        if end is None and (sql[index] in "'\"`" or (db_type == "sqlserver" and sql[index] == "[")):
+            opening = sql[index]
+            closing = "]" if opening == "[" else opening
+            kind = "double_quote" if opening == '"' else "protected"
+            pos = index + 1
+            while pos < length:
+                if sql[pos] == closing:
+                    if pos + 1 < length and sql[pos + 1] == closing:
+                        pos += 2
+                        continue
+                    pos += 1
+                    break
+                escapes = db_type in {"mysql", "doris", "mariadb", "starrocks"} or (
+                    db_type in {"postgres", "postgresql", "hologres"}
+                    and opening == "'" and index > 0 and sql[index - 1].lower() == "e"
+                    and (index == 1 or not (sql[index - 2].isalnum() or sql[index - 2] == "_"))
+                )
+                if sql[pos] == "\\" and escapes:
+                    pos += 2
+                else:
+                    pos += 1
+            end = min(pos, length)
+        if end is None:
+            index += 1
+            continue
+        if start < index:
+            yield "code", sql[start:index]
+        yield kind, sql[index:end]
+        start = index = end
+    if start < length:
+        yield "code", sql[start:]
+
+
+def _translate_sql(sql: str, db_type: str) -> str:
+    """跨库 SQL 翻译：Doris/MySQL 时把双引号标识符换成反引号。
+
+    SQL 里单引号是字符串字面量（'value'），双引号是标识符（"table"）。
+    Doris/MySQL 标识符用反引号，字符串也用单引号——所以双引号→反引号是安全的。
+    SQLite 保持不变（SQLite 双引号也是标识符）。
+
+    例外：Doris 的属性子句 PROPERTIES(...) / ALTER TABLE ... SET(...) 里，
+    双引号是**属性键/字符串值**（"dynamic_partition.enable" = "true"），不是标识符。
+    整体转反引号会被 Doris 解析器拒绝（errCode 1105，Encountered: IDENTIFIER）。
+    因此先保护这些子句，再对剩余双引号做标识符转换。
+    """
+    if db_type not in {"mysql", "doris", "mariadb", "starrocks"}:
+        return sql
+    # 保护属性子句（支持一层嵌套括号），再转换其余双引号
+    protected: list[str] = []
+
+    def _protect(m: "re.Match") -> str:
+        protected.append(m.group(0))
+        return f"\x00{len(protected) - 1}\x00"
+
+    sql = re.sub(
+        r"\b(?:PROPERTIES|SET)\s*\([^()]*(?:\([^()]*\)[^()]*)*\)",
+        _protect,
+        sql,
+        flags=re.IGNORECASE,
+    )
+    sql = "".join(chunk.replace('"', "`") if kind == "double_quote" else chunk
+                  for kind, chunk in _sql_chunks(sql, db_type))
+    for i, original in enumerate(protected):
+        sql = sql.replace(f"\x00{i}\x00", original)
+    return sql
+
+
+def _format_sql(sql: str, params, db_type: str):
+    """跨库占位符适配 + SQL 翻译。返回 (sql, params) 适配后给 cursor.execute。
+
+    SQLite/ODBC 保留 ?，pymysql/psycopg 转为 %s。
+    字符串、标识符与注释中的问号不参与转换；无参数时仅翻译标识符。
+    """
+    sql_t = _translate_sql(sql, db_type)
+    if not params:
+        return sql_t, params
+    if db_type in ("sqlite", "duckdb", "sqlserver"):
+        return sql_t, params
+    chunks = list(_sql_chunks(sql_t, db_type))
+    # pymysql/psycopg interpolate with %, including inside literals/comments.
+    # Preserve native %s / %(name)s binds, while escaping literal percentages.
+
+    def percent_bind(match):
+        token = match.group(0)
+        return "%s" if token == "?" else "%%" if token == "%" else token
+    formatted = "".join(
+        re.sub(r"%\([A-Za-z_]\w*\)s|%s|%|\?", percent_bind, chunk)
+        if kind == "code" else chunk.replace("%", "%%")
+        for kind, chunk in chunks
+    )
+    return formatted, params if isinstance(params, dict) else list(params)
+
+
+def _validate_query_sql(db_ref: str, sql: str) -> str:
+    """Apply the new SQL-family guard before acquiring any database connection."""
+    from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+    db_type = db_type_of_ref(_resolve_db_ref(db_ref))
+    if db_type == "sqlserver":
+        from jiuwenswarm.channels.web.dataagent.connectors.sql_guard import validate_read_only_sql
+
+        return validate_read_only_sql(sql, source_type=db_type)
+    # Keep the established legacy policy for pre-existing callers.
+    assert_readonly(sql)
+    return sql
+
+
+# ==========================================================================
+# duckdb:// 桥接：转发到 dataagent/connectors 的 DuckDBConnector
+# ==========================================================================
+def _duckdb_connector(spec: dict):
+    """按 source_type 声明的引擎，将文件 ref 转为连接器。
+
+    延迟导入避免 common 模块在加载时依赖 Web 层。注册本地文件源不扩大路径权限，
+    文件仍须位于 JIUWENSWARM_DATA_ROOTS 中；staged 源由其引擎处理远端缓存。
+    """
+    from jiuwenswarm.channels.web.dataagent.connectors.base import (
+        SourceDefinition,
+        get_engine,
+    )
+
+    source_type = spec["source_type"]
+    engine = _declared_engine_for(source_type)
+    if engine == "staged":
+        config = _staged_config_from_location(spec)
+    else:
+        config = {
+            "location": spec["location"],
+            "path": spec["location"],
+            "table_name": spec["table_name"],
+            "sandbox": True,
+        }
+    if spec.get("_source_config") is not None:
+        config = dict(spec["_source_config"])
+        if engine != "staged":
+            config.update(location=spec["location"], path=spec["location"],
+                          table_name=spec["table_name"], sandbox=True)
+    source = SourceDefinition(
+        source_id=f"ref:{spec['location']}",
+        source_type=source_type,
+        name=spec.get("table_name") or "data",
+        engine=engine,
+        config=config,
+    )
+    return get_engine(engine)(source)
+
+
+def _declared_engine_for(source_type: str) -> str:
+    """从数据源类型注册表读取执行引擎。"""
+    try:
+        from jiuwenswarm.channels.web.dataagent.datasource.registry import (
+            get_source_type,
+        )
+
+        return str(get_source_type(source_type).engine or "duckdb")
+    except ValueError:
+        return "duckdb"
+
+
+def _staged_default_port(protocol: str) -> int:
+    """从 staged_connector.DEFAULT_PORTS 读取协议默认端口。
+
+        未显式配置端口的 ref 必须与适配器使用同一默认值，尤其不能将 WebHDFS
+        按 FTP 端口处理。
+    """
+    try:
+        from jiuwenswarm.channels.web.dataagent.connectors.staged_connector import (
+            DEFAULT_PORTS,
+        )
+    except Exception:  # noqa: BLE001  —— 连接器层不可用时不能把治理通路带崩
+        return 22 if protocol == "sftp" else 21
+    return int(DEFAULT_PORTS.get(protocol, 21))
+
+
+def _staged_config_from_location(spec: dict) -> dict:
+    """``ftp://host:port/remote/path`` → StagedFileConnector 的 config。
+
+    凭据不在 ref 里（与 MySQL/PG 族同纪律：完整 ref 凭据为空），按
+    ``<PROTOCOL>_USER`` / ``<PROTOCOL>_PASSWORD`` 环境变量或 config 的同名段补齐。
+    """
+    location = str(spec.get("location") or "")
+    protocol, _, rest = location.partition("://")
+    protocol = protocol.strip().lower() or "sftp"
+    host_port, _, remote_path = rest.partition("/")
+    host, _, port = host_port.partition(":")
+    cfg = _read_config_section(protocol)
+    prefix = protocol.upper()
+    default_port = _staged_default_port(protocol)
+    return {
+        "protocol": protocol,
+        "host": host,
+        "port": int(port) if port else (cfg.get("port") or default_port),
+        "user": cfg.get("user") or os.environ.get(f"{prefix}_USER", ""),
+        "password": cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", ""),
+        "known_hosts": cfg.get("known_hosts") or os.environ.get(f"{prefix}_KNOWN_HOSTS", ""),
+        "host_key_sha256": cfg.get("host_key_sha256") or os.environ.get(f"{prefix}_HOST_KEY_SHA256", ""),
+        "path": f"/{remote_path}" if remote_path else "/",
+        "format": spec.get("format") or _format_from_remote(remote_path),
+        "table_name": spec.get("table_name") or "data",
+    }
+
+
+def _format_from_remote(remote_path: str) -> str:
+    """从远端 glob 的扩展名推格式（``/data/*.parquet`` → parquet）。"""
+    suffix = Path(str(remote_path)).suffix.lstrip(".").lower()
+    return suffix if suffix in ("csv", "parquet", "json") else "csv"
+
+
+def _duckdb_meta(spec: dict, read_only: bool = True) -> dict:
+    return {
+        "type": "duckdb",
+        "location": spec["location"],
+        "source_type": spec["source_type"],
+        "table_name": spec["table_name"],
+        "read_only": read_only,
+    }
+
+
+def _is_duckdb(db_ref: str) -> bool:
+    """判断 ref 对应的 codec 是否自管 I/O，而不经过 Engine 池。
+
+    历史函数名保留供现有调用方和测试使用；判断依据为 uses_pool。
+    """
+    if not isinstance(db_ref, str):
+        return False
+    if "://" not in db_ref:
+        return False  # 裸路径 = sqlite，走池
+    scheme = db_ref.split("://", 1)[0].strip().lower()
+    if not ref_codec_is_registered(scheme):
+        return False
+    return not codec_for(scheme).uses_pool
+
+
+def _query_duckdb(db_ref: str, sql: str, params=None, limit: int | None = DEFAULT_LIMIT) -> dict:
+    """duckdb ref 的只读查询：桥接 DuckDBConnector，映射回 query 协议。
+
+    limit 语义对齐 query()：None → 不截断（fetchall 上限交给 connector 的
+    10000 硬顶）；<=0 → MAX_QUERY_ROWS；正数 → 精确 limit。
+    DuckDBConnector.query 内部有自己的 limit guard（fetchmany limit+1），
+    这里把 limit 传下去即可，无需 add_limit_guard。
+    """
+    spec = _saved_source_spec(db_ref)
+    codec = codec_for(spec["type"])
+    if limit is None:
+        effective_limit = MAX_QUERY_ROWS
+    elif limit <= 0:
+        effective_limit = MAX_QUERY_ROWS
+    else:
+        effective_limit = limit
+    result = codec.query(spec, sql, params=params, limit=effective_limit)
+    return {
+        **result,  # Preserve metering IDs/bytes and sampling completeness flags.
+        "row_count": result["row_count"],
+        "truncated": result["truncated"],
+        "columns": result["columns"],
+        "rows": result["rows"],
+        "elapsed_ms": result["elapsed_ms"],
+        "db": codec.meta(spec),
+    }
+
+
+def query(
+    db_ref: str, sql: str, params=None, limit: int | None = DEFAULT_LIMIT
+) -> dict:
+    """只读查询。返回 {row_count, columns, rows, elapsed_ms}。连接复用（Engine 池）。
+
+    params 支持跨库占位符：sqlite ? / doris %s（内部 _format_sql 适配）。
+    limit=None 表示不加 LIMIT 并 fetchall —— 供聚合批量查询使用
+    （Doris 聚合查询 + LIMIT 会报 parse 错误，已实测；此时 truncated 恒 False）。
+    limit<=0 用服务端 MAX_QUERY_ROWS 硬上限 fetch + 截断（方案 §3.1 G2）：
+    不拼 LIMIT 进 SQL（避免聚合 parse 错），但在 fetch 阶段截断防 OOM，
+    truncated 反映是否超限。需要真正全量聚合结果用 limit=None。
+    """
+    sql = _validate_query_sql(db_ref, sql)
+    if _is_duckdb(db_ref):
+        return _query_duckdb(db_ref, sql, params, limit)
+    # limit<=0 → 用 MAX_QUERY_ROWS 截断（不等于 limit=None 的 fetchall）
+    capped = False
+    if limit is not None and limit <= 0:
+        limit = MAX_QUERY_ROWS
+        capped = True
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        sql_f, params_f = _format_sql(sql, params, meta["type"])
+        # capped 时不拼 LIMIT 进 SQL（避免 Doris 聚合报错），靠 fetch 截断
+        guarded = (
+            sql_f
+            if limit is None or meta["type"] == "sqlserver"
+            else (sql_f if capped else add_limit_guard(sql_f, limit))
+        )
+        cur = _cursor(conn)
+        t0 = time.time()
+        cur.execute(guarded, params_f) if params_f is not None else cur.execute(guarded)
+        if limit is None:
+            rows = cur.fetchall()
+            truncated = False
+        else:
+            # fetch limit+1 行判断是否截断（capped 时也走此分支）
+            rows = cur.fetchmany(limit + 1)
+            truncated = len(rows) > limit
+            rows = rows[:limit]
+        columns = _columns(cur)
+        return {
+            "row_count": len(rows),
+            "truncated": truncated,
+            "columns": columns,
+            "rows": [_row_to_list(r) for r in rows],
+            "elapsed_ms": int((time.time() - t0) * 1000),
+            "db": meta,
+        }
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+    finally:
+        _release(conn)
+
+
+def query_dict(
+    db_ref: str, sql: str, params=None, limit: int | None = DEFAULT_LIMIT
+) -> list[dict]:
+    """只读查询，返回 list[dict]（列名: 值）。供巡检脚本消费。连接复用（Engine 池）。
+
+    params 支持跨库占位符：sqlite ? / doris %s（内部 _format_sql 适配）。
+    limit=None 不加 LIMIT 且 fetchall（聚合查询场景，见 query 注释）。
+    limit<=0 用 MAX_QUERY_ROWS 截断（§3.1 G2，防 OOM，不拼 LIMIT 进 SQL）。
+    """
+    sql = _validate_query_sql(db_ref, sql)
+    if _is_duckdb(db_ref):
+        result = _query_duckdb(db_ref, sql, params, limit)
+        columns = result["columns"]
+        return [dict(zip(columns, row)) for row in result["rows"]]
+    capped = False
+    if limit is not None and limit <= 0:
+        limit = MAX_QUERY_ROWS
+        capped = True
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        sql_f, params_f = _format_sql(sql, params, meta["type"])
+        guarded = (
+            sql_f
+            if limit is None or meta["type"] == "sqlserver"
+            else (sql_f if capped else add_limit_guard(sql_f, limit))
+        )
+        cur = _cursor(conn)
+        cur.execute(guarded, params_f) if params_f is not None else cur.execute(guarded)
+        rows = cur.fetchall() if limit is None else cur.fetchmany(limit)
+        columns = _columns(cur)
+        return [dict(zip(columns, _row_to_list(r))) for r in rows]
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+    finally:
+        _release(conn)
+
+
+# dry-run 预检（方案 docs/archive/delivered/dialect-convergence-plan.md 批次 1a）
+_DRY_RUN_EXPLAIN_PREFIX = "EXPLAIN "
+_DRY_RUN_SKIP_STATEMENTS = ("DROP", "TRUNCATE", "ALTER", "DELETE", "UPDATE")
+
+
+def _dry_run_wrapped_sql(sql: str, db_type: str) -> tuple[str, str]:
+    """按方言构造 dry-run 校验语句。返回 (校验 SQL, 状态)。
+
+    状态：CHECKED（真实预检）/ SKIPPED（无安全预检手段，明示跳过）。
+
+    - doris/mysql：EXPLAIN <sql>（Doris EXPLAIN INSERT INTO ... SELECT 可用）
+    - sqlite：EXPLAIN QUERY PLAN <sql>
+    - duckdb：SELECT/WITH 用 EXPLAIN；DML（INSERT/CTAS）提取源 SELECT 部分
+      预检（DuckDB EXPLAIN 不支持 DML）；DROP/TRUNCATE/ALTER 无源可验则跳过
+    """
+    s = sql.strip().rstrip(";").strip()
+    first = re.split(r"[\s(]+", s, 1)[0].upper() if s else ""
+    if db_type in ("doris", "mysql"):
+        return f"{_DRY_RUN_EXPLAIN_PREFIX}{s}", "CHECKED"
+    if db_type == "sqlite":
+        return f"EXPLAIN QUERY PLAN {s}", "CHECKED"
+    # duckdb
+    if first in ("SELECT", "WITH", "SHOW", "DESCRIBE", "DESC"):
+        return f"{_DRY_RUN_EXPLAIN_PREFIX}{s}", "CHECKED"
+    if first in ("INSERT", "CREATE", "COPY"):
+        source = _extract_read_side_select(s)
+        if source:
+            return f"{_DRY_RUN_EXPLAIN_PREFIX}{source}", "CHECKED"
+        return s, "SKIPPED"
+    return s, "SKIPPED"
+
+
+def _extract_read_side_select(sql: str) -> str:
+    """从 INSERT INTO ... SELECT / CREATE TABLE ... AS SELECT 提取源 SELECT。
+
+    提取失败（嵌套怪形/无 SELECT 部分）返回空串，调用方按 SKIPPED 处理。
+    预检目的是拦截「表/列不存在、方言函数不存在」，源 SELECT 通过即可覆盖
+    绝大多数失败模式；目标表存在性由写路径自身报错兜底。
+    """
+    m = re.search(r"\b(SELECT|WITH)\b", sql, flags=re.IGNORECASE)
+    if not m:
+        return ""
+    return sql[m.start():].strip()
+
+
+def _file_capability_spec(db_ref: str, operation: str, *, staged: bool = False) -> dict:
+    """Reject unsupported self-managed capabilities before config lookup or I/O."""
+    from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+    kind = db_type_of_ref(db_ref)
+    if kind != "duckdb":
+        raise ValueError(f"{kind} source does not support {operation}")
+    spec = parse_db_ref(db_ref)
+    engine = _declared_engine_for(spec["source_type"])
+    if engine != "duckdb" and not (staged and engine == "staged"):
+        raise ValueError(f"{spec['source_type']} source does not support {operation}")
+    return spec
+
+
+def dry_run(db_ref: str, sql: str) -> dict:
+    """执行前轻量预检（方言感知）。
+
+    在目标库上验证 SQL 可解析、表/列存在、函数可用——拦截「生成期方言错误」，
+    避免落到任务执行才发现。只读通道执行校验语句，不产生业务数据变更。
+
+    Returns:
+        dict: {ok, status: CHECKED|SKIPPED|FAILED, dialect, sql?, error?}
+        - CHECKED：预检通过（校验语句已真实执行）
+        - SKIPPED：该方言对此语句类型无安全预检手段（如 DuckDB DROP），
+          明示跳过而非静默通过；调用方据此决定是否放行
+        - FAILED：预检执行报错，error 携带底层异常文本（含表/列/函数诊断）
+
+    Raises:
+        ValueError: SQL 为空。
+    """
+    s = sql.strip()
+    if not s:
+        raise ValueError("SQL 为空")
+    if _is_duckdb(db_ref):
+        try:
+            _file_capability_spec(db_ref, "dry_run", staged=True)
+        except ValueError as exc:
+            from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+            return {"ok": False, "status": "FAILED", "dialect": db_type_of_ref(db_ref),
+                    "error": str(exc), "code": "unsupported_capability"}
+        dialect = "duckdb"
+        check_sql, status = _dry_run_wrapped_sql(s, "duckdb")
+    else:
+        meta_type = _meta_type_of(db_ref)
+        dialect = meta_type
+        check_sql, status = _dry_run_wrapped_sql(s, meta_type)
+    if status == "SKIPPED":
+        return {"ok": True, "status": "SKIPPED", "dialect": dialect}
+    try:
+        query(db_ref, check_sql, limit=None)
+    except Exception as exc:
+        return {"ok": False, "status": "FAILED", "dialect": dialect,
+                "sql": check_sql, "error": str(exc)}
+    return {"ok": True, "status": "CHECKED", "dialect": dialect, "sql": check_sql}
+
+
+def _meta_type_of(db_ref: str) -> str:
+    """从连接元数据取库类型（dry_run 用；不动池，仅解析 spec）。"""
+    spec = parse_db_ref(db_ref)
+    return str(spec.get("type") or "sqlite")
+
+
+def tables(db_ref: str) -> dict:
+    """列表。连接复用（Engine 池）。duckdb ref 走 catalog：csv 目录每文件
+    一个视图（实时 glob，新增文件自动出现），其余场景单个注册 VIEW。"""
+    spec = parse_db_ref(db_ref)
+    codec = codec_for(spec["type"])
+    if not codec.uses_pool:
+        # 自管 I/O 的类型（duckdb 文件源）：csv 目录每文件一个视图（实时 glob，
+        # 新增文件自动出现），其余场景单个注册 VIEW。
+        return codec.list_tables(_saved_source_spec(db_ref, spec))
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        cur = _cursor(conn)
+        cur.execute(codec.tables_sql())
+        t = codec.map_tables(cur.fetchall())
+        return {"tables": t, "table_count": len(t), "db": meta}
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+    finally:
+        _release(conn)
+
+
+def schema(db_ref: str, table: str) -> dict:
+    """表结构。返回 {table, columns: [{name, type, null, pk?}]}。连接复用（Engine 池）。
+
+    sqlite 的 columns 含 pk 字段（PRAGMA table_info 第 6 列）；doris/mysql 用 key 字段。
+    duckdb ref 走桥接 DESCRIBE VIEW（null 恒 True，VIEW 无约束语义）。
+    """
+    spec = parse_db_ref(db_ref)
+    codec = codec_for(spec["type"])
+    if not codec.uses_pool:
+        return codec.describe(_saved_source_spec(db_ref, spec), table)
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        cur = _cursor(conn)
+        cur.execute(codec.describe_sql(table))
+        return {
+            "table": table,
+            "columns": codec.map_columns(cur.fetchall()),
+            "db": meta,
+        }
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+    finally:
+        _release(conn)
+
+
+def batch_stats(db_ref: str) -> dict[str, dict]:
+    """批量表统计（duckdb 文件源专用）：单连接建全部视图后逐个 DESCRIBE + COUNT。
+
+    返回 {table: {"columns": [{name, type, null}], "row_count": int}}。
+    csv 目录源表多，逐表调 schema() 会 N 次桥接、每次重建全部视图
+    （O(N²)），此入口一次建齐。
+    """
+    if not _is_duckdb(db_ref):
+        raise ValueError("batch_stats is only supported for duckdb:// refs")
+    spec = _file_capability_spec(db_ref, "batch_stats")
+    spec = _saved_source_spec(db_ref, spec)
+    connector = _duckdb_connector(spec)
+    try:
+        raw = connector.batch_stats()
+    finally:
+        connector.close()
+    return {
+        table: {
+            "columns": [
+                {"name": c["name"], "type": c["type"], "null": c.get("nullable", True)}
+                for c in stats["columns"]
+            ],
+            "row_count": stats["row_count"],
+        }
+        for table, stats in raw.items()
+    }
+
+
+def list_indexes(db_ref: str, table: str) -> dict:
+    """表的索引列表。返回 {indexes: [{name, columns, unique}]}。连接复用（Engine 池）。
+
+    SQLite: PRAGMA index_list + index_info
+    Doris/MySQL: SHOW INDEX FROM
+    duckdb ref：文件源是 VIEW，无索引语义，返回空列表。
+    """
+    spec = parse_db_ref(db_ref)
+    codec = codec_for(spec["type"])
+    if not codec.uses_pool:
+        if spec.get("source_type") == "duckdb":
+            raise ValueError("native DuckDB source does not support list_indexes")
+        if spec["type"] != "duckdb" and type(codec).indexes is RefCodec.indexes:
+            raise ValueError(f"{spec['type']} source does not support list_indexes")
+        return {"table": table, "indexes": codec.indexes(spec), "db": codec.meta(spec)}
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        cur = _cursor(conn)
+        return {"table": table, "indexes": codec.read_indexes(cur, table), "db": meta}
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+    finally:
+        _release(conn)
+
+
+def show_create_table(db_ref: str, table: str) -> dict:
+    """表的 CREATE 语句。返回 {create_sql}。连接复用（Engine 池）。
+
+    SQLite: SELECT sql FROM sqlite_master
+    Doris/MySQL: SHOW CREATE TABLE
+    duckdb ref：VIEW 由运行时注册，无持久 DDL，返回空串。
+    """
+    spec = parse_db_ref(db_ref)
+    codec = codec_for(spec["type"])
+    if not codec.uses_pool:
+        if spec.get("source_type") == "duckdb":
+            metadata = codec.describe(_saved_source_spec(db_ref, spec), table)
+            return {"table": table, "create_sql": metadata["ddl"], "db": codec.meta(spec)}
+        if spec["type"] != "duckdb" and type(codec).create_sql is RefCodec.create_sql:
+            raise ValueError(f"{spec['type']} source does not support show_create_table")
+        return {
+            "table": table,
+            "create_sql": codec.create_sql(spec),
+            "db": codec.meta(spec),
+        }
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        cur = _cursor(conn)
+        return {
+            "table": table,
+            "create_sql": codec.read_create_sql(cur, table),
+            "db": meta,
+        }
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+    finally:
+        _release(conn)
+
+
+def execute(db_ref: str, sql: str, params=None, commit: bool = True) -> dict:
+    """DDL/DML（写操作）。返回 {affected_rows, elapsed_ms}。连接复用（读写 Engine 池）。
+
+    params 支持跨库占位符：sqlite ? / doris %s（内部 _format_sql 适配）。
+
+    Doris 写路径会话级关闭 enable_insert_strict（用户决策 B：ETL INSERT 的类型
+    截断/越界不整批失败，坏数据变形落表由巡检兜底）——每次执行幂等 SET，覆盖
+    池化连接残留的会话变量；SET 失败（老版本无此变量）保持默认严格。
+    """
+    if _is_duckdb(db_ref):
+        # Local CSV/Excel warehouse writes retain their connector whitelist.
+        # Remote, sampled and metadata-only sources must never reach it.
+        spec = _file_capability_spec(db_ref, "execute")
+        if spec["source_type"] not in ("csv", "excel") or "://" in spec["location"]:
+            raise ValueError(f"{spec['source_type']} source does not support execute writes")
+        if params is not None and not (isinstance(params, (dict, list, tuple)) and not params):
+            raise ValueError("file warehouse execute does not support parameter binding")
+        spec = _saved_source_spec(db_ref, spec)
+        if (spec.get("_source_config") or {}).get("format"):
+            raise ValueError("formatted file source does not support execute writes")
+        connector = _duckdb_connector(spec)
+        try:
+            result = connector.execute_write(sql)
+        finally:
+            connector.close()
+        return {
+            "affected_rows": result.get("affected_rows"),
+            "elapsed_ms": result.get("elapsed_ms"),
+            "db": _duckdb_meta(spec, read_only=False),
+        }
+    conn, meta = _acquire(db_ref, read_only=False)
+    try:
+        cur = _cursor(conn)
+        # 会话参数由 codec 初始化，例如 Doris 的插入严格模式。
+        try:
+            codec_for(meta["type"]).session_setup(cur, read_only=False)
+        except Exception:  # noqa: BLE001 —— 无此变量的版本保持默认严格
+            pass
+        t0 = time.time()
+        sql_f, params_f = _format_sql(sql, params, meta["type"])
+        cur.execute(sql_f, params_f) if params_f is not None else cur.execute(sql_f)
+        affected = cur.rowcount
+        if commit:
+            conn.commit()
+        return {
+            "affected_rows": affected,
+            "elapsed_ms": int((time.time() - t0) * 1000),
+            "db": meta,
+        }
+    except Exception:
+        if meta["type"] != "sqlite":
+            try:
+                conn.rollback()
+            except Exception:
+                pass
+        _invalidate(db_ref, read_only=False)
+        raise
+    finally:
+        _release(conn)
+
+
+# ==========================================================================
+# 批量写
+# ==========================================================================
+def executemany(db_ref: str, sql: str, rows: list[tuple], commit: bool = True) -> dict:
+    """批量写：单语句多行（游标 executemany）。落库批量 upsert 的底层入口。
+
+    占位符适配同 execute：SQL 写 ? （sqlite）或 %s（doris/mysql），调用方任选，
+    这里按 db 类型统一翻译；rows 是 tuple/list 序列。
+
+    返回 {submitted_rows, affected_rows, elapsed_ms, db}。
+      submitted_rows 提交行数（恒为 len(rows)）
+      affected_rows  驱动报告的受影响行数（pymysql 批量 INSERT 通常=行数；
+                     个别驱动返回 -1，消费方以 submitted_rows 为准做幂等对账）
+
+    原子性说明（勿违背）：Doris 无跨语句事务——本函数是"批提交 + 失败抛出"，
+    不宣称整批回滚。需要部分成功语义时由上层 inspection_persist 按行收集失败重试。
+    """
+    if _is_duckdb(db_ref):
+        from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+        kind = db_type_of_ref(db_ref)
+        if kind != "duckdb":
+            raise ValueError(f"{kind} source does not support executemany")
+        if rows:
+            raise ValueError(
+                "duckdb:// 文件数据源不支持 executemany 批量写入"
+                "（csv/excel 物化写入请用 execute 单语句）"
+            )
+    if not rows:
+        return {
+            "submitted_rows": 0,
+            "affected_rows": 0,
+            "elapsed_ms": 0,
+            "db": {"type": None},
+        }
+    conn, meta = _acquire(db_ref, read_only=False)
+    try:
+        cur = _cursor(conn)
+        t0 = time.time()
+        sql_f, _ = _format_sql(sql, None, meta["type"])
+        if meta["type"] != "sqlite":
+            sql_f = sql_f.replace("?", "%s")
+        cur.executemany(sql_f, [tuple(r) for r in rows])
+        affected = cur.rowcount if getattr(cur, "rowcount", -1) is not None else -1
+        if commit:
+            conn.commit()
+        return {
+            "submitted_rows": len(rows),
+            "affected_rows": int(affected),
+            "elapsed_ms": int((time.time() - t0) * 1000),
+            "db": meta,
+        }
+    except Exception:
+        if meta["type"] != "sqlite":
+            try:
+                conn.rollback()
+            except Exception:
+                pass
+        _invalidate(db_ref, read_only=False)
+        raise
+    finally:
+        _release(conn)
+
+
+# ==========================================================================
+# 跨库 cursor/columns/row 适配
+# ==========================================================================
+def _cursor(conn):
+    """sqlite 的 conn 可直接 execute，但统一用 cursor 更一致。
+
+    SQLAlchemy _ConnectionFairy 有 .cursor()（代理底层 DBAPI）；sqlite3/pymysql 原生连接也有。
+    """
+    if hasattr(conn, "cursor"):
+        return conn.cursor()
+    return conn  # sqlite Connection 也支持 execute
+
+
+def _release(conn):
+    """归还借出的连接到 Engine 池（fairy.close() 是归还非真关；直连则真关）。
+
+    每个操作函数 finally 必须调它，否则 SQLAlchemy 池的连接不归还、fairy 泄漏。
+    """
+    try:
+        conn.close()
+    except Exception:
+        pass
+
+
+def ping(db_ref: str) -> dict:
+    """探活：能建连/执行 SELECT 1 即 ok（workspace probe / datasource probe 用）。
+
+    sqlite/doris/mysql 走 _acquire + close；duckdb 走桥接 test_connection。
+    """
+    if _is_duckdb(db_ref):
+        spec = parse_db_ref(db_ref)
+        codec = codec_for(spec["type"])
+        factory = _duckdb_connector if spec["type"] == "duckdb" else getattr(codec, "_connector", None)
+        if not callable(factory):
+            raise ValueError(f"{spec['type']} source does not support ping")
+        spec = _saved_source_spec(db_ref, spec)
+        connector = factory(spec)
+        try:
+            result = connector.test_connection()
+            return {"ok": bool(result.get("ok")), "meta": codec.meta(spec)}
+        finally:
+            connector.close()
+    conn, meta = _acquire(db_ref, read_only=True)
+    try:
+        conn.close()
+        return {"ok": True, "meta": meta}
+    except Exception:
+        _invalidate(db_ref, read_only=True)
+        raise
+
+
+def _columns(cur) -> list[str]:
+    if cur.description:
+        return [d[0] for d in cur.description]
+    return []
+
+
+def _row_to_list(row) -> list:
+    """sqlite Row / pymysql tuple / fairy cursor tuple → list。"""
+    if hasattr(row, "values"):
+        return list(row.values())  # sqlite3.Row
+    return list(row)
+
+
+# ==========================================================================
+# CLI（subprocess 调用形态）
+# ==========================================================================
+def _emit(payload: dict) -> None:
+    print(json.dumps(payload, ensure_ascii=True, indent=2))
+
+
+def _md_table(columns: list[str], rows: list) -> str:
+    if not columns:
+        return "(no result set)"
+    header = "| " + " | ".join(columns) + " |"
+    sep = "| " + " | ".join("---" for _ in columns) + " |"
+    body = ["| " + " | ".join(str(c) for c in r) + " |" for r in rows]
+    return "\n".join([header, sep, *body])
+
+
+def action_probe(args):
+    conn, meta = _acquire(args.db_ref, read_only=True)
+    try:
+        if meta["type"] == "sqlite":
+            tables_list = tables(args.db_ref)["tables"]
+            ver = sqlite3.sqlite_version
+        else:
+            # Doris/mysql：fairy 代理底层 pymysql 连接，get_server_info 透传
+            ver = conn.get_server_info()
+            tables_list = "（用 --action tables 列表）"
+        _emit(
+            {
+                "status": "ok",
+                "db": meta,
+                "server_version": ver,
+                "tables": tables_list if isinstance(tables_list, list) else None,
+            }
+        )
+    finally:
+        _release(conn)
+
+
+def action_tables(args):
+    _emit(tables(args.db_ref))
+
+
+def action_schema(args):
+    if not args.table:
+        _emit({"error": "schema 需要 --table"})
+        return
+    _emit(schema(args.db_ref, args.table))
+
+
+def action_query(args):
+    if not args.sql:
+        _emit({"error": "query 需要 --sql"})
+        return
+    try:
+        r = query(args.db_ref, args.sql)
+        r["md_table"] = _md_table(r["columns"], r["rows"])
+        _emit(r)
+    except Exception as exc:
+        _emit({"error": f"{type(exc).__name__}: {exc}"})
+
+
+def action_execute(args):
+    if not args.sql:
+        _emit({"error": "execute 需要 --sql"})
+        return
+    if not args.confirm:
+        _emit({"error": "execute 是写操作，需 --confirm", "sql": args.sql})
+        return
+    try:
+        _emit(execute(args.db_ref, args.sql))
+    except Exception as exc:
+        _emit({"error": f"{type(exc).__name__}: {exc}"})
+
+
+def action_list_indexes(args):
+    if not args.table:
+        _emit({"error": "list-indexes 需要 --table"})
+        return
+    try:
+        _emit(list_indexes(args.db_ref, args.table))
+    except Exception as exc:
+        _emit({"error": f"{type(exc).__name__}: {exc}"})
+
+
+def action_show_create(args):
+    if not args.table:
+        _emit({"error": "show-create 需要 --table"})
+        return
+    try:
+        _emit(show_create_table(args.db_ref, args.table))
+    except Exception as exc:
+        _emit({"error": f"{type(exc).__name__}: {exc}"})
+
+
+def build_parser():
+    p = argparse.ArgumentParser(
+        description="公共数据库连接器（jiuwenswarm.common.db_connector）"
+    )
+    p.add_argument(
+        "--action",
+        required=True,
+        choices=[
+            "probe",
+            "tables",
+            "schema",
+            "query",
+            "execute",
+            "list-indexes",
+            "show-create",
+        ],
+    )
+    p.add_argument(
+        "--db-ref",
+        help="库引用：sqlite://path 或 doris://host:port/db 或 mysql://... 不传读 config 默认",
+    )
+    p.add_argument("--sql")
+    p.add_argument("--table")
+    p.add_argument("--confirm", action="store_true")
+    return p
+
+
+def _prompt_no_db() -> None:
+    """无 db-ref 且无 config 默认时，提示用户先配置库地址。"""
+    _emit(
+        {
+            "error": "未指定数据库",
+            "hint": "请先配置默认数据库，或调用时传 --db-ref",
+            "how_to": {
+                "config_file": str(_DATASOURCE_CONFIG),
+                "example": "echo 'default_db: doris://' > ~/.jiuwenswarm/config/datasource.yaml",
+                "db_ref_formats": [
+                    "sqlite://path/to/db.sqlite",
+                    "doris://host:9030/database",
+                    "doris://  (用 DORIS_* 环境变量补全)",
+                    "mysql://host:3306/database",
+                ],
+            },
+        }
+    )
+
+
+def main():
+    args = build_parser().parse_args()
+    # db_ref 为空时查 config 默认；都没有 → 提示用户先配置
+    if not args.db_ref:
+        configured = default_db_ref()
+        if configured:
+            args.db_ref = configured
+        else:
+            _prompt_no_db()
+            return 1
+    {
+        "probe": action_probe,
+        "tables": action_tables,
+        "schema": action_schema,
+        "query": action_query,
+        "execute": action_execute,
+        "list-indexes": action_list_indexes,
+        "show-create": action_show_create,
+    }[args.action](args)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
