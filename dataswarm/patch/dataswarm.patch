+def test_process_memo_skips_cache_file_parsing(e2e, emb_on, monkeypatch):
+    """文档集与模型都没变 → 走进程内 memo，不再解析缓存文件。
+
+    缓存是 JSON 浮点（实测 ≈23KB/节点·1024 维），800 列的库约 18MB；
