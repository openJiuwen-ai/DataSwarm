@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createRequire } from 'node:module';
+
+import {
+  PROMPT_SUGGESTIONS,
+  PROMPT_CATEGORIES,
+  pickPromptSuggestions,
+} from '../node_modules/.cache/prompt-suggestions/promptSuggestions.mjs';
+
+const require = createRequire(import.meta.url);
+
+/** 确定性 random：返回 0..n-1 的循环序列，洗牌结果可复现 */
+function seededRandom() {
+  let counter = 0;
+  return () => {
+    counter += 1;
+    return (counter % 100) / 100;
+  };
+}
+
+test('集合本身：id 唯一且 category 合法', () => {
+  const ids = PROMPT_SUGGESTIONS.map((s) => s.id);
+  assert.equal(new Set(ids).size, ids.length, 'id 必须唯一');
+  for (const suggestion of PROMPT_SUGGESTIONS) {
+    assert.ok(
+      PROMPT_CATEGORIES.includes(suggestion.category),
+      `未知 category: ${suggestion.category}`,
+    );
+  }
+});
+
+test('三个大类都有条目，与 categories 展示顺序一致', () => {
+  for (const category of PROMPT_CATEGORIES) {
+    const count = PROMPT_SUGGESTIONS.filter((s) => s.category === category).length;
+    assert.ok(count >= 1, `分类 ${category} 至少要有一条示例`);
+  }
+});
+
+test('按类抽取：默认 4 条、无重复、全部属于该类', () => {
+  for (const category of PROMPT_CATEGORIES) {
+    for (let i = 0; i < 20; i += 1) {
+      const picked = pickPromptSuggestions(category, 4, seededRandom());
+      assert.ok(picked.length <= 4, `第 ${i} 轮 ${category} 超出 count`);
+      assert.equal(new Set(picked.map((s) => s.id)).size, picked.length, '不允许重复');
+      for (const suggestion of picked) {
+        assert.equal(suggestion.category, category, `${category} 内不能混入其他类`);
+      }
+    }
+  }
+});
+
+test('类内条目不足 count 时全量返回', () => {
+  for (const category of PROMPT_CATEGORIES) {
+    const inCategory = PROMPT_SUGGESTIONS.filter((s) => s.category === category).length;
+    const picked = pickPromptSuggestions(category, inCategory + 10, seededRandom());
+    assert.equal(picked.length, inCategory, `${category} 不足时应全量返回`);
+  }
+});
+
+test('注入相同 random 时结果可复现', () => {
+  const first = pickPromptSuggestions('guide', 4, seededRandom());
+  const second = pickPromptSuggestions('guide', 4, seededRandom());
+  assert.deepEqual(first.map((s) => s.id), second.map((s) => s.id));
+});
+
+test('每个提示 id 在 zh/en 都有 title 与 prompt，分类名齐全，且无多余文案条目', () => {
+  const ids = PROMPT_SUGGESTIONS.map((s) => s.id);
+  for (const locale of ['zh', 'en']) {
+    const messages = require(`../src/i18n/locales/${locale}.json`);
+    const group = messages.chat?.promptSuggestions;
+    assert.ok(group, `${locale} 缺少 chat.promptSuggestions`);
+    for (const id of ids) {
+      assert.ok(group[id]?.title?.trim(), `${locale}.${id} 缺 title`);
+      assert.ok(group[id]?.prompt?.trim(), `${locale}.${id} 缺 prompt`);
+    }
+    for (const category of PROMPT_CATEGORIES) {
+      assert.ok(group.categories?.[category]?.trim(), `${locale}.categories.${category} 缺分类名`);
+    }
+    const extraIds = Object.keys(group).filter(
+      (key) => key !== 'refresh' && key !== 'categories' && !ids.includes(key),
+    );
+    assert.deepEqual(extraIds, [], `${locale} 存在集合外的多余条目: ${extraIds.join(', ')}`);
+  }
+});
