+    write(repo, "docs/guide.md", "doc+delta\n")
+    write(repo, "scripts/dataswarm/fork/fork_config.yaml",
+          "dev_hub:\n  repo: git@example.invalid/DataIntell/DataSwarm.git\n"
+          "  branch: develop_oss\n"
+          "mr_hub:\n  repo: git@example.invalid/openJiuwen/DataSwarm.git\n"
+          "  branch: develop\n"
+          "archive:\n  branch: MR\n"
+          "baseline:\n  repo: git@example.invalid/openJiuwen/jiuwenswarm.git\n  ref: base0.1\n"
+          "skill_test_dirs:\n  - dw_analysis_eval\n")
+    write(repo, "scripts/dataswarm/sync_manifest.yaml",
+          "sync:\n  scripts: scripts\n  docs: docs\n  README.md: README.md\n")
+    git(["add", "-A"], repo)
+    commit(repo, "delta 2")
+
+    git(["remote", "add", "mr-fork", str(mrfork_bare)], repo)
+    git(["remote", "add", "mr-hub", str(mrhub_bare)], repo)
+    return repo
+
+
+def run_tool(repo, name, *extra):
+    env = {**os.environ, "DATASWARM_FORK_REPO": str(repo)}
+    return run([sys.executable, str(FORK_DIR / name), *extra], repo, check=False, env=env)
+
+
+def test_pure_helpers():
+    import _fork_lib as lib
+
+    cfg = lib.parse_yaml_subset(
+        "# c\nbaseline:\n  repo: https://x/y.git\n  ref: v1\n"
+        "skill_test_dirs:\n  - dw_analysis_eval\n  # 注释\n  - dw_other\n")
