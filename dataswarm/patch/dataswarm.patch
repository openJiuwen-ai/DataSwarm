+    def resume_workflow(self, iid):
+        self.calls.append(("resume_workflow", iid))
+        return self.instance
+
+    def cancel_instance(self, iid):
+        self.calls.append(("cancel_instance", iid))
+        return {**self.instance, "status": "cancelled"}
