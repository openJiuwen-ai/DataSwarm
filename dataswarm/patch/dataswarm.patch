+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""migrate_legacy —— 旧 dw_bi_* 指标表一次性迁移到 dw_metric_* 新体系。
+
+背景（2026-10-10 旧指标体系退役）：指标定义/口径的真相源是 V2 的
+``dw_metric_defs/revisions/bindings``；旧 ``dw_bi_metrics`` /
+``dw_bi_metric_bindings`` / ``dw_metric_queries`` 三表不再被代码读写，
+新部署不再建表（DDL 已删）。存量库里的旧指标数据用本脚本搬进新体系。
+
+映射规则：
+
+- 每个旧指标行 → 1 个 MetricDef + 1 个 MetricRevision（``revision_no=1``、
+  ``status=candidate``、``source_type=legacy``）。**candidate 不是可发布口径**：
+  旧体系无修订/依赖/维度语义，迁移后需人工补口径并确认绑定才发布。
+- ``metric_key``：name 可 slug 化（ASCII）则 ``legacy.<slug>``；含中文等
+  非 ASCII 字符时用 ``legacy.m<metric_id 末 8 位>``，原文保留在 name。
+- ``calc_sql`` 原文进 ``expression.dialects[<db_type>]``（键 = 业务库方言名），
+  **不做 AST 解析**（``unparsed_reason`` 说明原因）——旧 SQL 是按业务库手写的，
+  是否可解析、引用哪些列，由人工确认或后续 Ossie 重导解决。
+- 旧绑定（source_table + source_columns JSON 数组）→ ``dw_metric_bindings``，
+  ``column_map`` 为物理列自映射（旧体系无逻辑/物理分层）。
+- 旧 ``verified_sql_json``（问答对）**不迁**：新体系 verified SQL 是
+  查询级 ``dw_metric_verified_sql``（scope 绑 metric_key），形态不同，
+  硬搬会产生错误归属。脚本记 warning 提示人工处置。
+- 幂等：按 ``definition_hash`` 跳过已迁移指标；``--drop-legacy`` 在迁移
+  成功后 DROP 三张旧表（默认保留，人工核对后再删）。
+
+用法::
+
+    python -m jiuwenswarm.channels.web.dataagent.metrics.migrate_legacy \\
+        --workspace <workspace_id> [--db-type sqlite] [--drop-legacy]
+
+    python -m jiuwenswarm.channels.web.dataagent.metrics.migrate_legacy --dry-run \\
+        --workspace <ws>          # 只打印将迁移的内容，不写库
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from typing import Any
+
+from . import store
+from .model import (
+    BINDING_UNBOUND,
+    METRIC_TYPE_ATOMIC,
+    REVISION_CANDIDATE,
+    Binding,
+    ExpressionSpec,
+    MetricRevision,
+)
+
+_LEGACY_TABLES = ("dw_bi_metrics", "dw_bi_metric_bindings", "dw_metric_queries")
+
+_ASCII_KEY_RE = re.compile(r"[^A-Za-z0-9_.-]")
+
+
+def _slug_key(name: str, metric_id: str) -> str:
+    """旧指标名 → metric_key（legacy. 前缀）。非 ASCII 名回退 id 后缀。"""
+    slug = _ASCII_KEY_RE.sub("-", (name or "").strip().lower()).strip("-")
+    slug = re.sub(r"-{2,}", "-", slug)[:60]
+    if not slug:
+        slug = f"m{metric_id[-8:]}"
+    return f"legacy.{slug}"
+
+
+def _fetch_legacy_rows() -> tuple[list[dict], list[dict]]:
+    """读旧表（表已不存在 → 空列表，视为无迁移数据）。"""
+    from jiuwenswarm.channels.web.orchestration.db import _connect, _fetch_dicts
+
+    def _safe_query(sql: str) -> list[dict]:
+        try:
+            conn = _connect()
+            try:
+                return _fetch_dicts(conn, sql)
+            finally:
+                conn.close()
+        except Exception:
+            return []
+
+    metrics = _safe_query("SELECT * FROM dw_bi_metrics")
+    bindings = _safe_query("SELECT * FROM dw_bi_metric_bindings")
+    return metrics, bindings
+
+
+def _build_revision(metric: dict, workspace_id: str, db_type: str,
+                    metric_id: str) -> MetricRevision:
+    calc_sql = str(metric.get("calc_sql") or "")
+    synonyms = tuple(
+        s.strip() for s in str(metric.get("synonyms") or "").split(",") if s.strip())
+    return MetricRevision(
+        revision_id=store.new_id("rev"),
+        metric_id=metric_id,
+        workspace_id=workspace_id,
+        revision_no=1,
+        metric_type=str(metric.get("metric_type") or METRIC_TYPE_ATOMIC),
+        unit=str(metric.get("unit") or ""),
+        display_name=str(metric.get("name") or ""),
+        synonyms=synonyms,
+        expression=ExpressionSpec(
+            resolved_dialect=db_type,
+            dialects={db_type: calc_sql} if calc_sql else {},
+            parsed=None,
+            unparsed_reason=("legacy 直迁：calc_sql 原文保留，未做 AST 解析"
+                             if calc_sql else "旧指标无 calc_sql"),
+        ),
+        time_grains=tuple(
+            g.strip() for g in str(metric.get("time_grain") or "").split(",") if g.strip()),
+        status=REVISION_CANDIDATE,
+        source_type="legacy",
+    )
+
+
+def migrate(workspace_id: str, *, db_type: str = "sqlite",
+            dry_run: bool = False, drop_legacy: bool = False) -> dict[str, Any]:
+    """执行迁移，返回统计与 warning。"""
+    warnings: list[str] = []
+    metrics, bindings = _fetch_legacy_rows()
+    if not metrics:
+        return {"migrated": 0, "skipped": 0, "bindings": 0, "warnings": [
+            "旧表 dw_bi_metrics 无数据（或表已不存在），无需迁移"]}
+
+    bindings_by_metric: dict[str, list[dict]] = {}
+    for b in bindings:
+        bindings_by_metric.setdefault(str(b.get("metric_id")), []).append(b)
+
+    migrated = skipped = binding_count = 0
+    for metric in metrics:
+        old_id = str(metric.get("metric_id") or "")
+        name = str(metric.get("name") or old_id)
+        metric_key = _slug_key(name, old_id)
+        if store.get_def_by_key(workspace_id, metric_key):
+            skipped += 1
+            continue
+
+        new_metric_id = store.new_id("metric")
+        revision = _build_revision(metric, workspace_id, db_type, new_metric_id)
+        if dry_run:
+            print(f"[dry-run] {old_id} -> {metric_key}"
+                  f"（{len(bindings_by_metric.get(old_id, []))} 绑定，"
+                  f"calc_sql {'有' if metric.get('calc_sql') else '无'}）")
+            continue
+
+        definition = store.create_def(
+            workspace_id=workspace_id, metric_key=metric_key, name=name,
+            description=str(metric.get("description") or ""),
+            owner=str(metric.get("owner") or ""),
+        )
+        revision = _replace_metric_id(revision, definition.metric_id)
+        store.create_revision(revision)
+        store.set_current_revision(new_metric_id, revision.revision_id)
+        migrated += 1
+
+        for legacy_binding in bindings_by_metric.get(old_id, []):
+            columns = _parse_columns(legacy_binding.get("source_columns"))
+            if not columns:
+                continue
+            binding = Binding(
+                binding_id=store.new_id("bind"),
+                revision_id=revision.revision_id,
+                workspace_id=workspace_id,
+                datasource_ref=str(legacy_binding.get("datasource_ref")
+                                   or metric.get("datasource_ref") or ""),
+                source_table=str(legacy_binding.get("source_table") or ""),
+                column_map={c: c for c in columns},
+                verify_status=BINDING_UNBOUND,
+                verify_detail="legacy 直迁：绑定未经真实 schema 校验",
+            )
+            store.create_binding(binding)
+            binding_count += 1
+
+        if metric.get("verified_sql_json"):
+            warnings.append(
+                f"{metric_key}（旧 {old_id}）带 verified_sql_json 问答对，"
+                "新体系 verified SQL 是查询级（scope 绑 metric_key），未自动迁移——"
+                "请在问答验证后经 /v2/feedback 重新固化")
+
+    if drop_legacy and not dry_run and migrated >= 0:
+        _drop_legacy_tables()
+        warnings.append("已 DROP 三张旧表（dw_bi_metrics / dw_bi_metric_bindings / dw_metric_queries）")
+
+    return {"migrated": migrated, "skipped": skipped,
+            "bindings": binding_count, "warnings": warnings}
+
+
+def _replace_metric_id(revision: MetricRevision, metric_id: str) -> MetricRevision:
+    """dataclasses.replace 的薄封装（frozen 修订改挂新建的 metric_id）。"""
+    import dataclasses
+
+    return dataclasses.replace(revision, metric_id=metric_id)
+
+
+def _parse_columns(raw: Any) -> list[str]:
+    if isinstance(raw, str):
+        try:
+            raw = json.loads(raw)
+        except (json.JSONDecodeError, TypeError):
+            return []
+    if isinstance(raw, list):
+        return [str(c) for c in raw if c]
+    return []
+
+
+def _drop_legacy_tables() -> None:
+    from jiuwenswarm.channels.web.orchestration.db import _connect, _exec
+
+    conn = _connect()
+    try:
+        for table in _LEGACY_TABLES:
+            _exec(conn, f"DROP TABLE IF EXISTS {table}")
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--workspace", required=True, help="目标工作空间 ID")
+    parser.add_argument("--db-type", default="sqlite",
+                        help="业务库方言（calc_sql 的方言键，默认 sqlite）")
+    parser.add_argument("--dry-run", action="store_true", help="只打印不写库")
+    parser.add_argument("--drop-legacy", action="store_true",
+                        help="迁移后 DROP 三张旧表（默认保留待人工核对）")
+    args = parser.parse_args()
+
+    from jiuwenswarm.common import workspace_context
+    token = workspace_context.set_current(
+        workspace_context.resolve(args.workspace).workspace_id)
+    try:
+        result = migrate(args.workspace, db_type=args.db_type,
+                         dry_run=args.dry_run, drop_legacy=args.drop_legacy)
+    finally:
+        workspace_context.reset(token)
+
+    if not args.dry_run:
+        print(f"迁移完成：{result['migrated']} 指标 / {result['skipped']} 已存在跳过 / "
+              f"{result['bindings']} 绑定")
+    for w in result["warnings"]:
+        print(f"[warning] {w}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
