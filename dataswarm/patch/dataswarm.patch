+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/compiler.py —— QuerySpec → SQL 的确定性编译（主通路，无 LLM）。
+
+输入是结构化 :class:`~.model.QuerySpec`，输出是可执行的
+:class:`~.model.CompiledQuery`。**LLM 永不接触 SQL 文本**——主通路的 SQL
+只从这里产出，因此可以完全离线单测（方案 §阶段 4）。
+
+三条编译纪律：
+
+1. **时间粒度必须走 ``dialect_registry.grain_fn``**（strftime/DATE_FORMAT），
+   **禁止**依赖 sqlglot 转译 ``DATE_TRUNC``——sqlglot 转 SQLite 会输出
+   ``DATE_TRUNC('MONTH', col)``，而 SQLite 没有这个函数，执行直接
+   ``OperationalError``（本机实测复现）。
+2. **占位符一律 ``?``**，由 ``db_connector._format_sql`` 按目标库翻译成
+   ``%s``（doris/mysql）。**字面量拼接一律禁止**。
+3. **LIMIT 不拼进 SQL**——Doris 聚合查询禁止追加 LIMIT，行数上限在
+   ``db_connector`` 的 fetch 截断层与服务层截断处理。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+import sqlglot
+
+from jiuwenswarm.common.dialect_registry import profile_for
+
+from .errors import DefinitionError, QueryPlanError
+from .model import (
+    Binding,
+    CompiledQuery,
+    METRIC_TYPE_RATIO,
+    MetricRevision,
+    QueryFilter,
+    QuerySpec,
+    resolve_dimension,
+)
+
+# 粒度函数族 → 粒度 → 格式串（与既有 semantic.py::_GRAIN_FORMATS 同源）
+_GRAIN_FORMATS: dict[str, dict[str, str]] = {
+    "strftime": {  # sqlite / duckdb
+        "day": "%Y-%m-%d", "week": "%Y-%W", "month": "%Y-%m", "year": "%Y",
+    },
+    "DATE_FORMAT": {  # mysql / doris（MySQL 协议族格式符）
+        "day": "%Y-%m-%d", "week": "%x-%v", "month": "%Y-%m", "year": "%Y",
+    },
+}
+
+# 过滤操作符白名单（防注入：不进 sqlglot 的算子直接拒）
+_FILTER_OPS = frozenset({"=", "!=", "<>", ">", ">=", "<", "<=", "IN", "NOT IN", "LIKE"})
+
+# 表别名兜底：绑定表无前缀信息时用物理表名当别名
+
+
+def compile_spec(
+    spec: QuerySpec,
+    revisions: list[MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+    *,
+    db_type: str,
+    datasource_ref: str,
+    release_id: str,
+    roles: dict[str, dict[str, str]] | None = None,
+) -> CompiledQuery:
+    """把 QuerySpec 确定性编译成 SQL。
+
+    Args:
+        spec: 已通过 ``validate()`` 的查询规格。
+        revisions: 参与查询的全部修订（含依赖目标）。
+        bindings_by_revision: ``revision_id -> 绑定列表``。
+        db_type: 业务库类型（``parse_db_ref`` 的 ``type`` 口径）。
+        datasource_ref: 业务库连接指针（已脱敏前的执行用原文）。
+        release_id: 口径版本批次。
+        roles: ``metric_key -> {"numerator": dep_key, "denominator": dep_key}``，
+            来自**已确认**的概念映射；无内联表达式的 ratio 指标必须提供。
+
+    Returns:
+        :class:`~.model.CompiledQuery`。
+
+    Raises:
+        QueryPlanError: 维度/粒度/过滤越界，或指标间数据源冲突。
+        DefinitionError: 修订缺表达式或依赖角色未确认。
+    """
+    by_key = {_metric_key_of(r): r for r in revisions}
+    missing = [k for k in spec.metrics if k not in by_key]
+    if missing:
+        raise QueryPlanError(
+            f"指标 {', '.join(missing)} 不在本批次修订内（可用: {', '.join(sorted(by_key))}）")
+
+    selected = [by_key[k] for k in spec.metrics]
+    _check_common_source(selected, bindings_by_revision)
+
+    # 口径校验：维度与粒度必须在修订声明范围内
+    # 维度先归一化再比对——指标以限定名声明（orders.customer_state），召回面对外
+    # 给裸列名（customer_state），字面比对会误拒合法维度并逼调用方多跑一轮自愈。
+    resolved_group_by: list[str] = []
+    for dim in spec.group_by:
+        canonical: str | None = None
+        for rev in selected:
+            hit = resolve_dimension(dim, rev.allowed_dimensions)
+            if hit is None:
+                raise QueryPlanError(
+                    f"维度 {dim} 不在指标 {_metric_key_of(rev)} 的允许维度内"
+                    f"（允许: {', '.join(rev.allowed_dimensions) or '无'}）")
+            if canonical is None:
+                canonical = hit
+        resolved_group_by.append(canonical or dim)
+    for rev in selected:
+        if spec.time and spec.time.grain and spec.time.grain not in rev.time_grains:
+            raise QueryPlanError(
+                f"时间粒度 {spec.time.grain} 不被指标 {_metric_key_of(rev)} 支持"
+                f"（支持: {', '.join(rev.time_grains) or '无'}）")
+
+    profile = profile_for(db_type)
+    alias = _logical_table_of(selected)
+    params: list[Any] = []
+    select_parts: list[str] = []
+    group_parts: list[str] = []
+
+    # 维度列（用归一化后的规范形态，保证与白名单声明一致）
+    for dim in resolved_group_by:
+        select_parts.append(f"{dim}")
+        group_parts.append(f"{dim}")
+
+    # 时间粒度桶
+    time_col = spec.time.dimension if spec.time else ""
+    if spec.time and spec.time.grain:
+        grain_expr = _grain_expr(spec.time.grain, time_col, profile.grain_fn)
+        select_parts.append(f"{grain_expr} AS time_bucket")
+        group_parts.append(grain_expr)
+
+    # 指标聚合片段
+    for rev in selected:
+        fragment = _aggregate_fragment(
+            rev, by_key, bindings_by_revision, roles=roles or {})
+        select_parts.append(f"({fragment}) AS {_alias_of(_metric_key_of(rev))}")
+
+    # WHERE（同字段 = / IN 先归并为单条 IN——F-020：AND 连接恒空）
+    where_parts: list[str] = []
+    for flt in _merge_same_field_filters(spec.filters):
+        field = next((hit for rev in selected
+                      for hit in (resolve_dimension(flt.field, rev.allowed_dimensions),)
+                      if hit is not None), None)
+        if field is None:
+            raise QueryPlanError(
+                f"过滤字段 {flt.field} 不在任何查询指标的允许维度内")
+        if flt.op.upper() not in _FILTER_OPS:
+            raise QueryPlanError(
+                f"过滤操作符 {flt.op!r} 不在白名单内（{_FILTER_OPS}）")
+        if flt.op.upper() in ("IN", "NOT IN") and isinstance(flt.value, (list, tuple)):
+            if not flt.value:
+                raise QueryPlanError(f"过滤字段 {flt.field} 的 IN 值列表为空")
+            placeholders = ", ".join("?" for _ in flt.value)
+            where_parts.append(f"{field} {flt.op.upper()} ({placeholders})")
+            params.extend(flt.value)
+        else:
+            where_parts.append(f"{field} {flt.op.upper()} ?")
+            params.append(flt.value)
+    if spec.time:
+        # 修订声明的固定口径必须出现在 WHERE——这里先放时间范围；
+        # fixed_filters 由 guard 做存在性校验（AST 级），编译器不重复拼。
+        where_parts.append(f"{time_col} >= ?")
+        where_parts.append(f"{time_col} < ?")
+        params.append(spec.time.start)
+        params.append(spec.time.end_exclusive)
+
+    source_table = _source_table_of(selected[0], bindings_by_revision)
+    from_clause = f"{source_table} AS {alias}" if alias and alias != source_table else source_table
+
+    sql = f"SELECT {', '.join(select_parts)} FROM {from_clause}"
+    if where_parts:
+        sql += " WHERE " + " AND ".join(f"({part})" for part in where_parts)
+    if group_parts:
+        sql += " GROUP BY " + ", ".join(group_parts)
+    if group_parts:
+        sql += " ORDER BY " + ", ".join(group_parts)
+
+    # 回读校验：组装产物必须能被目标方言重新解析
+    try:
+        parsed = sqlglot.parse_one(sql, read=profile.sqlglot_dialect)
+    except sqlglot.errors.ParseError as exc:
+        raise DefinitionError(f"编译产物无法按 {profile.sqlglot_dialect} 方言解析: {exc}") from exc
+    # 输出统一走 sqlglot 生成（标识符引用、空白规范化）
+    sql = parsed.sql(dialect=profile.sqlglot_dialect)
+
+    return CompiledQuery(
+        sql=sql,
+        params=tuple(params),
+        dialect=profile.sqlglot_dialect,
+        db_type=db_type,
+        datasource_ref=datasource_ref,
+        revision_ids=tuple(rev.revision_id for rev in selected),
+        release_id=release_id,
+        metric_keys=tuple(spec.metrics),
+        group_by=tuple(resolved_group_by),
+        grain=spec.time.grain if spec.time else "",
+        time_column=time_col,
+        limit=spec.limit,
+    )
+
+
+# ==========================================================================
+# 聚合片段
+# ==========================================================================
+def _merge_same_field_filters(filters: tuple[QueryFilter, ...]) -> tuple[QueryFilter, ...]:
+    """同字段 ``=`` / ``IN`` 过滤器归并为单条 ``IN``。
+
+    intent 对「A 和 B 对比」类问题会拆出同字段多个 ``=`` 过滤器（如
+    ``country='USA'`` + ``country='Canada'``），AND 连接逻辑恒空（F-020）。
+    单值字段保持原形态（``= ?``），不改变既有编译产物。
+    """
+    values_by_field: dict[str, list] = {}
+    for flt in filters:
+        if str(flt.op).upper() in ("=", "IN"):
+            values = flt.value if isinstance(flt.value, (list, tuple)) else [flt.value]
+            values_by_field.setdefault(flt.field, []).extend(values)
+    merged: list[QueryFilter] = []
+    emitted_multi: set[str] = set()
+    for flt in filters:
+        if str(flt.op).upper() in ("=", "IN") and len(values_by_field.get(flt.field) or []) > 1:
+            if flt.field not in emitted_multi:
+                emitted_multi.add(flt.field)
+                merged.append(QueryFilter(field=flt.field, op="IN",
+                                          value=values_by_field[flt.field]))
+            continue  # 后续同字段条目已并入上面的 IN
+        merged.append(flt)
+    return tuple(merged)
+
+
+def _aggregate_fragment(
+    rev: MetricRevision,
+    by_key: dict[str, MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+    *,
+    roles: dict[str, dict[str, str]],
+    _visiting: frozenset[str] = frozenset(),
+) -> str:
+    """单指标的聚合表达式片段。
+
+    优先用修订自己的内联表达式（Ossie 携带的完整 SQL 表达式）；无内联表达式的
+    ratio 指标按**已确认**的分子/分母角色组合，``zero_denominator=null`` 时分母
+    包 ``NULLIF``。递归展开带环引用检测。
+    """
+    key = _metric_key_of(rev)
+    if key in _visiting:
+        raise DefinitionError(f"指标循环引用: {' -> '.join([*_visiting, key])}")
+
+    expression = rev.expression.expression
+    if expression:
+        return expression
+
+    if rev.metric_type == METRIC_TYPE_RATIO:
+        role_map = roles.get(key) or {}
+        numerator_key = role_map.get("numerator")
+        denominator_key = role_map.get("denominator")
+        if not (numerator_key and denominator_key):
+            raise DefinitionError(
+                f"ratio 指标 {key} 无内联表达式，且分子/分母角色未确认"
+                "（需先在概念映射里 confirm numerator/denominator）")
+        numerator = by_key.get(numerator_key)
+        denominator = by_key.get(denominator_key)
+        if numerator is None or denominator is None:
+            missing = [k for k in (numerator_key, denominator_key) if k not in by_key]
+            raise DefinitionError(f"ratio 指标 {key} 的依赖 {', '.join(missing)} 不在修订集合内")
+        num_sql = _aggregate_fragment(
+            numerator, by_key, bindings_by_revision, roles=roles,
+            _visiting=_visiting | {key})
+        den_sql = _aggregate_fragment(
+            denominator, by_key, bindings_by_revision, roles=roles,
+            _visiting=_visiting | {key})
+        if rev.zero_denominator == "null":
+            return f"{num_sql} / NULLIF({den_sql}, 0)"
+        return f"{num_sql} / {den_sql}"
+
+    raise DefinitionError(
+        f"指标 {key}（{rev.metric_type}）没有可编译的内联表达式，也没有可组合的依赖")
+
+
+# ==========================================================================
+# 表、别名与工具
+# ==========================================================================
+def _metric_key_of(rev: MetricRevision) -> str:
+    """从 definition_ref 还原 metric_key（``dataswarm:metric:<ws>:<key>@r<n>``）。"""
+    ref = rev.definition_ref or ""
+    if "@" in ref:
+        head = ref.split("@", 1)[0]
+        parts = head.split(":")
+        if len(parts) >= 4:
+            return ":".join(parts[3:])
+    return ref
+
+
+def _alias_of(metric_key: str) -> str:
+    """metric_key → 输出列别名（SQL 安全标识符）。"""
+    return metric_key.replace(".", "_").replace("-", "_")
+
+
+def _logical_table_of(revisions: list[MetricRevision]) -> str:
+    """从修订声明里推断逻辑数据集名（列前缀）。
+
+    时间维度优先，其次表达式引用字段；都没有则返回空串（无别名，裸表）。
+    """
+    for rev in revisions:
+        if rev.time_dimension and "." in rev.time_dimension:
+            return rev.time_dimension.split(".", 1)[0]
+    for rev in revisions:
+        if rev.expression.parsed:
+            for ref in rev.expression.parsed.fields:
+                if "." in ref:
+                    return ref.split(".", 1)[0]
+    return ""
+
+
+def _source_table_of(rev: MetricRevision, bindings_by_revision: dict[str, list[Binding]]) -> str:
+    """取修订绑定表的物理表名。"""
+    bindings = bindings_by_revision.get(rev.revision_id) or []
+    for binding in bindings:
+        if binding.source_table:
+            return binding.source_table
+    raise DefinitionError(f"指标 {_metric_key_of(rev)} 未绑定物理表（缺 bindings）")
+
+
+def _check_common_source(
+    revisions: list[MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+) -> None:
+    """多指标查询必须在同一张绑定表上（跨表 JOIN 本期不支持，用衍生指标表达）。"""
+    tables = {_source_table_of(rev, bindings_by_revision) for rev in revisions}
+    if len(tables) > 1:
+        raise QueryPlanError(
+            f"多指标查询必须共用同一绑定表，实际引用了 {len(tables)} 张: "
+            f"{', '.join(sorted(tables))}（跨表口径请用衍生指标表达）")
+
+
+def _grain_expr(grain: str, time_col: str, grain_fn: str) -> str:
+    """时间粒度 → 按方言函数族的截断表达式。
+
+    **只接受 ``grain_fn`` 族名**（strftime / DATE_FORMAT），绝不走 sqlglot 的
+    ``DATE_TRUNC`` 转译——那条路在 SQLite 上会生成不存在的函数直接执行失败。
+    """
+    formats = _GRAIN_FORMATS.get(grain_fn)
+    if formats is None:
+        raise DefinitionError(
+            f"未知粒度函数族 {grain_fn!r}（支持: {', '.join(sorted(_GRAIN_FORMATS))}）")
+    fmt = formats.get(grain)
+    if fmt is None:
+        raise DefinitionError(
+            f"粒度 {grain!r} 不受 {grain_fn} 函数族支持"
+            f"（支持 {', '.join(sorted(formats))}）")
+    if grain_fn == "strftime":
+        return f"strftime('{fmt}', {time_col})"
+    return f"DATE_FORMAT({time_col}, '{fmt}')"
