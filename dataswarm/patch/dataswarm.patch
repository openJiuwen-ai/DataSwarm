+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""sql/service.py — SQL 执行业务逻辑。
+
+DAO 编排：委托 db_connector 访问业务数据库。
+协议（方案 §3.1）：成功返回 {ok, rows, columns, truncated, row_count, elapsed_ms, db_ref}；
+失败返回 {ok:false, error, db_ref}。rows 是行列表（不是整个 query dict）。
+"""
+
+from __future__ import annotations
+
+from jiuwenswarm.common import workspace_context
+
+from .. import db as _da_db
+
+db_connector = _da_db.db_connector
+
+
+def _resolve_db_ref(db_ref: str | None, workspace_id: str | None = None, role: str = "business") -> str:
+    """db_ref 为空时回退 db_connector.default_db_ref()（方案 §3.1 G19）。
+
+    与 db_connector._resolve_db_ref 的区别：service 层不抛错（让 run_sql 的
+    try/except 捕获后返回 ok:false envelope），由调用方/controller 决定 HTTP 语义。
+    """
+    context = workspace_context.resolve(workspace_id)
+    ref = db_ref or (context.business_db_ref if role == "business" else context.metadata_db_ref)
+    return workspace_context.validate_ref_in_workspace(context.workspace_id, role, ref)
+
+
+def run_sql(
+    db_ref: str | None,
+    sql: str,
+    limit: int = 100,
+    workspace_id: str | None = None,
+    role: str = "business",
+    source_id: str | None = None,
+) -> dict:
+    """只读查询。返回完整 envelope（方案 §3.1）。
+
+    limit<=0 用服务端 MAX_QUERY_ROWS 上限 + 截断（§3.1 G2）：透传给 db_connector
+    走 fetch 截断路径，不拼 LIMIT 进 SQL（避免 Doris 聚合 parse 错）。
+    """
+    if source_id:
+        from ..datasource.service import query_source
+
+        try:
+            result = query_source(source_id, sql, limit=limit)
+            response = {
+                "ok": result.get("ok", False),
+                "rows": result.get("rows", []),
+                "columns": result.get("columns", []),
+                "truncated": result.get("truncated", False),
+                "row_count": result.get("row_count", 0),
+                "elapsed_ms": result.get("elapsed_ms"),
+                "source_id": source_id,
+                "db_ref": db_ref or "",
+            }
+            if not result.get("ok", False) and result.get("error"):
+                response["error"] = result["error"]
+            return response
+        except Exception as exc:
+            return {"ok": False, "error": str(exc), "source_id": source_id, "db_ref": db_ref or ""}
+
+    ref = _resolve_db_ref(db_ref, workspace_id, role)
+    try:
+        # limit<=0 透传给 db_connector 走 MAX_QUERY_ROWS 截断（G2）
+        result = db_connector.query(ref, sql, limit=limit)
+        # db_connector.query 返回 {row_count, truncated, columns, rows, elapsed_ms, db}
+        # 修复 G envelope：rows 是行列表，columns/truncated/elapsed_ms 透传
+        return {
+            "ok": True,
+            "rows": result.get("rows", []),
+            "columns": result.get("columns", []),
+            "truncated": result.get("truncated", False),
+            "row_count": result.get("row_count", 0),
+            "elapsed_ms": result.get("elapsed_ms"),
+            "db_ref": ref,
+        }
+    except Exception as exc:
+        return {"ok": False, "error": str(exc), "db_ref": ref}
+
+
+def explain_sql(db_ref: str | None, sql: str, workspace_id: str | None = None, role: str = "business") -> dict:
+    """EXPLAIN / dry-run 预检（方案 §3.1 G5 独立路径 + dialect-convergence 批次 1a）。
+
+    SELECT/WITH 走 db_connector.query(EXPLAIN <sql>, limit=None)——不拼
+    add_limit_guard，避免 Doris EXPLAIN 被追加 LIMIT 报语法错。
+    DML（INSERT/CTAS）经 db_connector.dry_run 方言感知预检：DuckDB EXPLAIN
+    不支持 DML，提取源 SELECT 验证；无安全预检手段的语句类型（DROP 等）
+    返回 status=SKIPPED 明示。
+
+    返回 {ok, explain:[...], status, dialect, db_ref}（explain 是行列表；
+    SKIPPED 时 explain 为空列表）。
+    """
+    ref = _resolve_db_ref(db_ref, workspace_id, role)
+    try:
+        dry = db_connector.dry_run(ref, sql)
+        if dry.get("status") != "CHECKED":
+            return {
+                "ok": True,
+                "explain": [],
+                "status": dry.get("status", "SKIPPED"),
+                "dialect": dry.get("dialect", ""),
+                "db_ref": ref,
+            }
+        result = db_connector.query(ref, dry.get("sql") or f"EXPLAIN {sql}", limit=None)
+        return {
+            "ok": True,
+            "explain": result.get("rows", []),
+            "status": "CHECKED",
+            "dialect": dry.get("dialect", ""),
+            "db_ref": ref,
+        }
+    except Exception as exc:
+        return {"ok": False, "error": str(exc), "db_ref": ref}
+
+
+def execute_ddl(db_ref: str | None, sql: str, workspace_id: str | None = None, role: str = "business",
+                session_id: str = "") -> dict:
+    """DDL/DML 写操作（方案 §3.1 G3 透传 affected_rows）。
+
+    db_connector.execute 返回 {affected_rows, elapsed_ms, db}，透传给调用方
+    （anomaly-fixer 的 rows_affected 对账依赖）。
+
+    session_id 非空且 DDL 成功时发 chat.struct_change 事件（对话侧血缘面板用）；
+    事件发射（解析+推送+落历史）任何异常只记日志，不影响本函数返回。
+    """
+    ref = _resolve_db_ref(db_ref, workspace_id, role)
+    try:
+        result = db_connector.execute(ref, sql)
+        if result.get("affected_rows") is not None or _is_ddl_sql(sql):
+            _emit_struct_change(session_id, sql, ref)
+        return {
+            "ok": True,
+            "affected_rows": result.get("affected_rows"),
+            "elapsed_ms": result.get("elapsed_ms"),
+            "db_ref": ref,
+        }
+    except Exception as exc:
+        return {"ok": False, "error": str(exc), "db_ref": ref}
+
+
+def _is_ddl_sql(sql: str) -> bool:
+    """DDL 无 affected_rows（多数驱动返回 -1/None），按语句类型判断是否发事件。"""
+    from ..struct_notify import classify_ddl
+
+    return bool(classify_ddl(sql))
+
+
+def _emit_struct_change(session_id: str, sql: str, ref: str) -> None:
+    if not session_id.strip():
+        return
+    from .. import struct_notify
+
+    struct_notify.emit_table_change(
+        session_id=session_id,
+        sql=sql,
+        db_name=struct_notify.db_name_from_ref(ref),
+    )
