+++ b/tests/unit_tests/common/test_self_managed_capability_routes.py
@@ -0,0 +1,213 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Self-managed capabilities reject before I/O; file warehouse behavior survives.
+
+Remote engines are capture fakes. Only temporary CSV/SQLite fixtures are real.
+"""
+from __future__ import annotations
+
+import socket
+from unittest.mock import Mock
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors import base
+from jiuwenswarm.channels.web.dataagent.datasource import store
+from jiuwenswarm.common import db_connector as dbc, ref_codec
+
+
+REFS = [
+    ("mongodb://host:27017/data", "sampled"),
+    ("redis://host:6379/0", "sampled"),
+    ("hbase://host:9090", "sampled"),
+    ("ddl://0123456789abcdef", "schema_only"),
+       ]
+
+
+@pytest.fixture(autouse=True)
+def isolated(monkeypatch, tmp_path):
+    monkeypatch.setattr(socket.socket, "connect", lambda *args: pytest.fail("network access forbidden"))
+    monkeypatch.setattr(dbc, "_read_config_section", lambda _: {})
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    monkeypatch.setattr(store, "find_config_by_ref", lambda *args: None)
+
+
+def forbid_construction_and_lookup(monkeypatch):
+    guard = Mock(side_effect=AssertionError("unsupported operation reached construction or I/O"))
+    monkeypatch.setattr(dbc, "_saved_source_spec", guard)
+    monkeypatch.setattr(dbc, "_duckdb_connector", guard)
+    monkeypatch.setattr(dbc, "_acquire", guard)
+    monkeypatch.setattr(base, "get_engine", guard)
+    return guard
+
+
+@pytest.mark.parametrize("ref,engine", REFS)
+@pytest.mark.parametrize("operation", ["execute", "executemany", "batch_stats", "list_indexes", "show_create_table"])
+def test_unsupported_routes_reject_before_construction_or_lookup(monkeypatch, ref, engine, operation):
+    guard = forbid_construction_and_lookup(monkeypatch)
+    arguments = {
+        "execute": ("CREATE TABLE t AS SELECT 1",),
+        "executemany": ("INSERT INTO t VALUES(?)", [(1,)]),
+        "batch_stats": (), "list_indexes": ("t",), "show_create_table": ("t",),
+    }
+    with pytest.raises(ValueError, match=f"does not support {operation}"):
+        getattr(dbc, operation)(ref, *arguments[operation])
+    guard.assert_not_called()
+
+
+@pytest.mark.parametrize("ref,engine", REFS)
+@pytest.mark.parametrize("sql", ["SELECT * FROM orders", "DROP TABLE orders"])
+def test_unsupported_dry_run_cannot_claim_checked_or_skipped(monkeypatch, ref, engine, sql):
+    guard = forbid_construction_and_lookup(monkeypatch)
+    monkeypatch.setattr(dbc, "query", guard)
+    report = dbc.dry_run(ref, sql)
+    assert report["ok"] is False and report["status"] == "FAILED"
+    assert report["code"] == "unsupported_capability"
+    assert report["dialect"] == ref.split("://", 1)[0]
+    guard.assert_not_called()
+
+
+@pytest.mark.parametrize("ref,engine", REFS)
+def test_empty_batch_is_not_reported_as_supported_for_non_file_sources(monkeypatch, ref, engine):
+    guard = forbid_construction_and_lookup(monkeypatch)
+    with pytest.raises(ValueError, match="does not support executemany"):
+        dbc.executemany(ref, "INSERT INTO t VALUES(?)", [])
+    guard.assert_not_called()
+
+
+@pytest.mark.parametrize("kind,location", [
+    ("ftp", "sftp://host:22/orders.csv"),
+    ("hdfs", "webhdfs://host:9870/orders.csv"),
+])
+@pytest.mark.parametrize("operation", ["execute", "batch_stats"])
+def test_staged_files_do_not_inherit_unsupported_local_operations(monkeypatch, kind, location, operation):
+    ref = dbc.build_file_source_ref(kind, location)
+    guard = forbid_construction_and_lookup(monkeypatch)
+    args = ("CREATE TABLE t AS SELECT 1",) if operation == "execute" else ()
+    with pytest.raises(ValueError, match=f"does not support {operation}"):
+        getattr(dbc, operation)(ref, *args)
+    guard.assert_not_called()
+
+
+@pytest.mark.parametrize("kind,location", [
+    ("s3", "s3://bucket/orders.csv"), ("oss", "oss://bucket/orders.csv"),
+    ("parquet", "orders.parquet"), ("json", "orders.json"),
+    ("csv", "https://example.invalid/orders.csv"),
+])
+def test_nonwarehouse_file_write_rejected_before_construction(monkeypatch, kind, location):
+    guard = forbid_construction_and_lookup(monkeypatch)
+    with pytest.raises(ValueError, match="does not support execute"):
+        dbc.execute(dbc.build_file_source_ref(kind, location), "CREATE TABLE t AS SELECT 1")
+    guard.assert_not_called()
+
+
+@pytest.mark.parametrize("ref,engine", REFS + [
+    (dbc.build_file_source_ref("ftp", "sftp://host:22/orders.csv"), "staged"),
+])
+@pytest.mark.parametrize("fails", [False, True])
+def test_ping_uses_declared_engine_saved_config_and_always_closes(monkeypatch, ref, engine, fails):
+    config = {"saved_marker": "kept", "ddl_text": "CREATE TABLE t(id INT)"}
+    monkeypatch.setattr(store, "find_config_by_ref", lambda *args: dict(config))
+    captured = []
+    instance = Mock()
+    instance.test_connection.side_effect = RuntimeError("probe failed") if fails else None
+    instance.test_connection.return_value = {"ok": True}
+
+    def factory(source):
+        captured.append(source)
+        return instance
+
+    def get_engine(name):
+        assert name == engine
+        return factory
+
+    monkeypatch.setattr(base, "get_engine", get_engine)
+    if fails:
+        with pytest.raises(RuntimeError, match="probe failed"):
+            dbc.ping(ref)
+    else:
+        assert dbc.ping(ref)["ok"] is True
+    assert captured[0].config["saved_marker"] == "kept"
+    instance.test_connection.assert_called_once_with()
+    instance.close.assert_called_once_with()
+
+
+def test_unknown_self_managed_ping_rejects_before_configuration(monkeypatch):
+    class MetadataCodec(ref_codec.RefCodec):
+        scheme = "metadata_probe"
+        uses_pool = False
+
+        def decode(self, rest, ref):
+            return {"type": self.scheme}
+
+    monkeypatch.setitem(ref_codec._CODECS, "metadata_probe", MetadataCodec())
+    guard = forbid_construction_and_lookup(monkeypatch)
+    with pytest.raises(ValueError, match="does not support ping"):
+        dbc.ping("metadata_probe://test")
+    guard.assert_not_called()
+
+
+def test_explicit_nonfile_metadata_hooks_remain_callable(monkeypatch):
+    class MetadataCodec(ref_codec.RefCodec):
+        scheme = "metadata_probe"
+        uses_pool = False
+
+        def decode(self, rest, ref):
+            return {"type": self.scheme}
+
+        def indexes(self, spec):
+            return [{"name": "declared", "columns": ["id"], "unique": True}]
+
+        def create_sql(self, spec):
+            return "CREATE TABLE t(id INT)"
+
+        def meta(self, spec):
+            return {"type": self.scheme}
+
+    monkeypatch.setitem(ref_codec._CODECS, "metadata_probe", MetadataCodec())
+    assert dbc.list_indexes("metadata_probe://test", "t")["indexes"][0]["name"] == "declared"
+    assert dbc.show_create_table("metadata_probe://test", "t")["create_sql"] == "CREATE TABLE t(id INT)"
+
+
+def test_real_csv_directory_write_stats_dry_run_and_metadata_survive(tmp_path):
+    folder = tmp_path / "warehouse"
+    folder.mkdir()
+    (folder / "orders.csv").write_text("id,amount\n1,12\n2,31\n", encoding="utf-8")
+    ref = dbc.build_file_source_ref("csv", str(folder))
+    assert dbc.ping(ref)["ok"] is True
+    report = dbc.dry_run(ref, "CREATE TABLE totals AS SELECT SUM(amount) AS amount FROM orders")
+    assert report["status"] == "CHECKED"
+    result = dbc.execute(ref, "CREATE TABLE totals AS SELECT SUM(amount) AS amount FROM orders")
+    assert result["db"]["read_only"] is False
+    assert (folder / "totals.csv").is_file()
+    assert dbc.query(ref, "SELECT amount FROM totals")["rows"] == [[43]]
+    assert dbc.batch_stats(ref)["orders"]["row_count"] == 2
+    assert dbc.list_indexes(ref, "orders")["indexes"] == []
+    assert dbc.show_create_table(ref, "orders")["create_sql"] == ""
+    assert dbc.dry_run(ref, "DROP TABLE totals")["status"] == "SKIPPED"
+    assert dbc.executemany(ref, "INSERT INTO orders VALUES(?,?)", [])["submitted_rows"] == 0
+    dbc.execute(ref, "DROP TABLE totals")
+    assert not (folder / "totals.csv").exists()
+
+
+@pytest.mark.parametrize("kind", ["csv", "excel"])
+@pytest.mark.parametrize("fails", [False, True])
+def test_warehouse_execute_retains_csv_excel_and_closes(monkeypatch, tmp_path, kind, fails):
+    instance = Mock()
+    instance.execute_write.side_effect = RuntimeError("write failed") if fails else None
+    instance.execute_write.return_value = {"affected_rows": 3, "elapsed_ms": 2}
+    monkeypatch.setattr(dbc, "_duckdb_connector", lambda spec: instance)
+    ref = dbc.build_file_source_ref(kind, str(tmp_path / f"orders.{kind}"))
+    if fails:
+        with pytest.raises(RuntimeError, match="write failed"):
+            dbc.execute(ref, "CREATE TABLE t AS SELECT 1")
+    else:
+        assert dbc.execute(ref, "CREATE TABLE t AS SELECT 1")["affected_rows"] == 3
+    instance.close.assert_called_once_with()
+
+
+def test_warehouse_parameters_are_not_silently_dropped(monkeypatch, tmp_path):
+    guard = forbid_construction_and_lookup(monkeypatch)
+    ref = dbc.build_file_source_ref("csv", str(tmp_path / "orders.csv"))
+    with pytest.raises(ValueError, match="parameter binding"):
+        dbc.execute(ref, "INSERT INTO target VALUES(?)", params=[7])
+    guard.assert_not_called()
