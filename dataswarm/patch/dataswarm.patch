+def test_archive_commit_title():
+    """标题即交付摘要：merge 不计、Conventional 前缀不嵌套、无有效提交回落锚点。"""
+    import _fork_lib as lib
+
+    cfg = {"baseline": {"repo": "https://x/y.git", "ref": "base0.1"}}
+    counts = {"total": {"A": 1, "M": 0, "D": 0}, "skills": {"dw-demo": 1}, "sync": 0}
+    anchor = "a" * 40
+
+    def title(commits):
+        return lib.archive_commit_message(anchor, cfg, counts, commits).splitlines()[0]
+
+    merge = "71685a945 !116 merge develop_oss into develop_oss"
+    # 单条有效提交：去前缀、去 merge、不显示条数
+    assert title(["9c0ca52a8 docs(rules): 增加归档纪律", merge]) == "chore(archive): 增加归档纪律"
+    # 两条：分号连接
+    assert title(["1111111a fix(orchestration): 修复定时任务从不触发",
+                  "2222222b feat(web): 新增血缘导出"]) == \
+        "chore(archive): 修复定时任务从不触发；新增血缘导出"
+    # 多条：前两条 + 「等 N 项」
+    assert title(["1111111a fix: a", "2222222b feat: b", "3333333c test: c", "4444444d docs: d"]) == \
+        "chore(archive): a；b 等 4 项"
+    # 全是 merge / 无提交：回落锚点说明
+    assert title([merge]) == f"chore(archive): 归档 develop_oss@{anchor[:12]}"
+    assert title([]) == f"chore(archive): 归档 develop_oss@{anchor[:12]}"
+    assert title(None) == f"chore(archive): 归档 develop_oss@{anchor[:12]}"
+    # 超长截断（总长不超过上限）
+    long_title = title(["1 fix: " + "测" * 200])
+    assert len(long_title) <= lib.ARCHIVE_TITLE_MAX and long_title.endswith("…")
+    # 正文只列有效提交并注明略过 merge
+    body = lib.archive_commit_message(anchor, cfg, counts, ["9c0ca52a8 docs: x", merge])
+    assert "已略过 merge 1 个" in body and "!116 merge" not in body
+
+
+def test_archive_end_to_end(sandbox):
+    report_path = sandbox / "report.json"
+    proc = run_tool(sandbox, "archive_delta.py", "--push", "--report-json", str(report_path))
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+
+    report = json.loads(report_path.read_text(encoding="utf-8"))
+    files = {item["path"] for item in report["files"]}
+    # V4：展示层（skills / skill 测试 / sync）+ 生成物；前后端测试不进展示层
+    assert "dataswarm/patch/dataswarm.patch" in files
+    assert "dataswarm/skills/dw-demo/SKILL.md" in files
+    assert not any(p.startswith("dataswarm/tests/") for p in files)
+    assert "docs/guide.md" in files                                  # sync 文件展示（M）
+    assert "README.md" in files                                      # 清单条目与基线相同也放置（全量口径）
+    assert "scripts/run.sh" in files                                 # 基线原样的清单文件也放置
+    assert "scripts/dataswarm/sync_manifest.yaml" in files           # 清单自举（我新增文件）
+    # 无 manifest 目录/附属清单（还原元信息在 commit trailer）；无 tests 展示目录
+    assert not any(p.startswith("manifest/") or p.startswith("dataswarm/tests/") for p in files)
+    # 非清单路径的基线原样文件不进展示层
+    assert "jiuwenswarm/a.py" not in files and "tests/t_base.py" not in files
+    assert report["counts"]["total"] == {"A": 7, "M": 2, "D": 1}
+
+    # patch 内容（V4 全量零排除）：代码 + 前后端测试 + skill + sync 路径全部进 patch
+    patch = git(["show", "MR:dataswarm/patch/dataswarm.patch"], sandbox).stdout
+    assert "diff --git a/jiuwenswarm/a.py" in patch and "+base+delta" in patch
+    assert "diff --git a/drop.txt" in patch
+    assert "diff --git a/tests/test_new.py" in patch                  # 后端测试在 patch
+    assert "diff --git a/jiuwenswarm/channels/web/frontend/tests/ui.test.mjs" in patch
+    assert "diff --git a/docs/guide.md" in patch                      # sync 路径的差异也在 patch
+    assert "dw-demo/SKILL.md" in patch                                # skill 新增也在 patch
+
+    # sync 展示层为 develop_oss 版本（清单全量放置）
+    assert git(["show", "MR:docs/guide.md"], sandbox).stdout == "doc+delta\n"
+
+    # 还原元信息：归档 commit trailer（无 manifest 文件）
+    msg = git(["log", "--format=%B", "-1", "MR"], sandbox).stdout
+    anchor = git(["rev-parse", "develop_oss"], sandbox).stdout.strip()
+    assert f"Archive-from: {anchor}" in msg
+    assert "Baseline-Tag: base0.1" in msg
+    assert "Baseline-Repo: " in msg
+
+    # 真实回放门禁（V4 单通道）：基线 + apply patch == develop_oss 全树
+    assert run_tool(sandbox, "verify_equivalence.py", "--archive-ref", "MR").returncode == 0
+
+    # 幂等：同锚点重跑 up to date
+    again = run_tool(sandbox, "archive_delta.py", "--dry-run")
+    assert again.returncode == 0 and "up to date" in again.stdout, again.stdout + again.stderr
+
+    # message 参与幂等：标题口径变化（归档器升级）后重跑不再 up to date，会刷新 message
+    stale_msg = msg.replace("chore(archive):", "chore(archive-old):", 1)
+    parent_sha = git(["rev-parse", "--verify", "--quiet", "MR^"], sandbox, check=False).stdout.strip()
+    stale = git(["commit-tree", git(["rev-parse", "MR^{tree}"], sandbox).stdout.strip(),
+                 *(["-p", parent_sha] if parent_sha else []), "-m", stale_msg],
+                sandbox).stdout.strip()
+    git(["update-ref", "refs/heads/MR", stale], sandbox)
+    git(["push", "-q", "-f", "mr-fork", "MR"], sandbox)
+    refreshed = run_tool(sandbox, "archive_delta.py", "--dry-run")
+    assert refreshed.returncode == 0 and "up to date" not in refreshed.stdout, refreshed.stdout
+
+
+def test_sync_manifest_validation(sandbox):
