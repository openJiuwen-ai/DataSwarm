@@ -0,0 +1,144 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""R1–R4 路由端到端测试（增补设计 §5）。
+
+验证「问题 → 双入口召回 → link 传导 → 路由」的真实链路：
+- R2：问题只含 schema 词汇（列名），经 propagate_to_metrics 传导到指标
+  → compiler 权威通路
+- R3：schema 强命中但无指标定义在该列 → 子图观测面（explore 端点入口
+  信号，不在指标层执行）
+召回/传导走真实链路；观测面挂 semantic_link 活函数（V2 ask 的
+build_catalog 聚合器已随 D3 退场）。
+"""
+from __future__ import annotations
+
+import json
+import sqlite3
+
+
+from jiuwenswarm.channels.web.dataagent.metrics import service, versioning
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, WORKSPACE, write_published_snapshot
+
+GMV = "commerce.gmv"
+
+
+def _spec_dict(metric: str) -> dict:
+    """直构 QuerySpec dict（主 Agent 链路形态；ask 意图解析已退场）。"""
+    return json.loads(_spec_json(metric))["spec"]
+
+
+def _spec_json(metric: str) -> str:
+    return json.dumps({
+        "spec": {"metrics": [metric], "group_by": ["orders.region"],
+                 "time": {"dimension": "orders.paid_at", "start": "2026-08-01",
+                          "end_exclusive": "2026-09-01"}},
+        "clarifications": []})
+
+
+def _publish_with_extra_column(e2e, extra_column: str | None = None):
+    """导入+确认+发布+模拟语义采集；可选在发布前往业务库加一列（schema 对象）。"""
+    if extra_column:
+        with sqlite3.connect(str(e2e["tmp_path"] / "business.db")) as conn:
+            conn.execute(f"ALTER TABLE orders ADD COLUMN {extra_column} TEXT")
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="routing-test")
+    write_published_snapshot(e2e)
+    versioning.publish_release(WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+                               label="routing", published_by="t")
+    return e2e
+
+
+# ==========================================================================
+# R2：schema 词汇 → 传导 → 指标 → compiler
+# ==========================================================================
+def test_r2_schema_vocab_propagates_to_metric(e2e):
+    """问题只提列名（amount_cny），指标名零词汇——必须经 schema 召回传导到 GMV。
+
+    传导链 = schema_recall（列命中）→ propagate_to_metrics（绑定反查）；
+    对照断言证明指标词汇直查为零（传导是唯一信号源）。
+    执行走直构 spec 的 query 权威通路（同主 Agent 链路）。
+    """
+    _publish_with_extra_column(e2e)
+    from jiuwenswarm.channels.web.dataagent.metrics import semantic_link, store
+    question = "orders 表 amount_cny 按 region 汇总一下"
+    release = store.get_active_release(WORKSPACE)
+    warnings: list[str] = []
+    _refs, snapshots = semantic_link.current_snapshots(warnings)
+    # 前提：指标名零词汇，图打分不含 GMV
+    assert GMV not in semantic_link.metric_table_scores(
+        WORKSPACE, question, release=release)
+    schema_hits, _confidence = semantic_link.schema_recall(
+        WORKSPACE, question, snapshots, warnings=warnings)
+    assert any(h.logical == "orders.amount_cny" for h in schema_hits), \
+        "列名词汇必须命中 schema"
+    propagated = semantic_link.propagate_to_metrics(
+        WORKSPACE, release, snapshots, schema_hits)
+    assert GMV in propagated, "schema 命中必须经绑定反查传导到指标"
+    from jiuwenswarm.channels.web.dataagent.metrics.model import QuerySpec
+    result = service.query(QuerySpec.from_dict(_spec_dict(GMV)), WORKSPACE)
+    by_region = {row["region"]: row for row in result.rows}
+    assert float(by_region["east"]["commerce_gmv"]) == 400.0
+
+
+# ==========================================================================
+# R3：schema 强命中但无指标 → 子图信号（explore 入口，不执行）
+# ==========================================================================
+def test_r3_schema_hit_without_metric_returns_subgraph(e2e):
+    """channel 列无任何指标绑定 → schema 强命中 + 指标侧零候选（R3 信号：
+    交 nl2sql//v2/explore 受控探索，不在指标层执行）。"""
+    _publish_with_extra_column(e2e, extra_column="channel")
+    from jiuwenswarm.channels.web.dataagent.metrics import semantic_link, store
+    question = "分析一下 channel 这个渠道列的取值分布"
+    warnings: list[str] = []
+    refs, snapshots = semantic_link.current_snapshots(warnings)
+    schema_hits, confidence = semantic_link.schema_recall(
+        WORKSPACE, question, snapshots, warnings=warnings)
+    assert schema_hits, "schema 强命中必须在（explore 端点的入口信号）"
+    assert [h.logical for h in schema_hits] == ["orders.channel"]
+    assert confidence > 0.0
+    assert refs, "入口信号应带语义快照上下文"
+    release = store.get_active_release(WORKSPACE)
+    propagated = semantic_link.propagate_to_metrics(
+        WORKSPACE, release, snapshots, schema_hits)
+    assert propagated == {}, "无指标绑定的列不得传导出指标候选（R3 不自动执行）"
+
+
+# ==========================================================================
+# R1 回归：指标词汇直命中仍走 compiler
+# ==========================================================================
+def test_r1_metric_vocab_still_compiler(e2e):
+    """指标词汇直命中：metric_table_scores 强候选 → query 确定性编译出可执行 SQL。"""
+    _publish_with_extra_column(e2e)
+    from jiuwenswarm.channels.web.dataagent.metrics import semantic_link, store
+    question = "2026年8月各地区支付成交额"
+    release = store.get_active_release(WORKSPACE)
+    scores = semantic_link.metric_table_scores(WORKSPACE, question, release=release)
+    assert GMV in scores, "指标词汇必须直命中图打分"
+    from jiuwenswarm.channels.web.dataagent.metrics.model import QuerySpec
+    result = service.query(QuerySpec.from_dict(_spec_dict(GMV)), WORKSPACE)
+    assert result.compiled.sql and result.authoritative and result.path == "compiler"
+
+
+# ==========================================================================
+# 上下文带 schema 子图（R1/R2 的解释面）
+# ==========================================================================
+def test_context_carries_schema_subgraph(e2e):
+    """build_semantic_context 的 schema 段含绑定列与表结构。"""
+    _publish_with_extra_column(e2e)
+    from jiuwenswarm.channels.web.dataagent.metrics import semantic_link, store
+
+    release = store.get_active_release(WORKSPACE)
+    assert release is not None
+    ctx = semantic_link.build_semantic_context(WORKSPACE, GMV, release)
+    assert ctx.schema_snapshot_id, "语义上下文应钉定语义快照"
+    assert ctx.schema is not None
+    logicals = {c["logical"] for c in ctx.schema["columns"]}
+    assert "orders.amount_cny" in logicals
+    assert ctx.time_field == "orders.paid_at"
