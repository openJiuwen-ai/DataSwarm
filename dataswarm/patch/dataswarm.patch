+html.workflow-run-document {
+  min-width: 0;
+  overflow-y: auto;
+}
+.workflow-run-page {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-height: 0;
+  background: var(--color-surface-card);
+  color: var(--color-text-primary);
+}
+.workflow-run-header {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 64px;
+  padding: 12px 24px;
+  border-bottom: 1px solid var(--color-border-default);
+  flex-shrink: 0;
+}
+.workflow-run-header h1 {
+  margin: 0;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 16px;
+  font-weight: 600;
+}
+.workflow-run-page > .dd-workspace {
+  flex: 1;
+  min-height: 0;
+}
+.workflow-run-page .wf-dag-canvas {
+  border: 0;
+  border-radius: 0;
+}
+.workflow-run-page > .dd-error {
+  margin: 20px;
+}
+
+@media (max-width: 760px) {
+  /* A portrait run page must grow with the node details instead of clipping them at the viewport bottom. */
+  .workflow-run-page {
+    height: auto;
+    min-height: 100vh;
+    overflow: visible;
+  }
+  .workflow-run-page > .dd-workspace {
+    height: auto;
+    min-height: calc(100vh - 64px);
+    overflow: visible;
+  }
+  .workflow-run-page .dd-canvas-area {
+    flex: 0 0 min(55vh, 480px);
+    height: min(55vh, 480px);
+  }
+  .workflow-run-page .dd-side-panel {
+    height: auto;
+    max-height: none;
+  }
+  .workflow-run-page .dd-panel-body {
+    flex: 0 0 auto;
+    overflow: visible;
+  }
+}
+
+/* ---- embed 模式（对话侧变更事件面板 iframe）----
+   零内边距铺满 + 高度链补齐 + 去画布自带边框（外层 StructChangePanel 详情区已有边框）。
+   高度链逐级强制拉伸（html→body→#root→page→workspace→canvas-area→wf-dag-root→canvas）：
+   任一环百分比高度失效，ReactFlow 就按内容高渲染——表现为"竖向没铺满、拖宽后才好"
+   （宽度变化触发 Resize 重 fit 掩盖了高度缺失）。 */
+html.workflow-run-document {
+  height: 100%;
+}
+body:has(.workflow-run-page--embed) {
+  height: 100%;
+  margin: 0;
+  overflow: hidden;
+}
+#root:has(.workflow-run-page--embed) {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+}
+.workflow-run-page--embed {
+  flex: 1;
+  gap: 0;
+  padding: 0;
+  overflow: hidden;
+}
+.workflow-run-page--embed > .dd-workspace {
+  flex: 1;
+}
+.workflow-run-page--embed .dd-canvas-area {
+  display: flex;
+  flex-direction: column;
+}
+.workflow-run-page--embed .dd-canvas-area .wf-dag-root {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+}
+.workflow-run-page--embed .wf-dag-canvas {
+  flex: 1;
+  height: auto;
+  border: 0;
+  border-radius: 0;
+}
+.workflow-run-page--embed .wf-dag-canvas .react-flow {
+  height: 100%;
+  width: 100%;
+}
