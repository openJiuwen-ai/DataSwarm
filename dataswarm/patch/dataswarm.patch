+                </button>
+                {showAdvanced && (
+                  <Field label={t('biMetrics.form.columnMapJson')} hint={t('biMetrics.form.columnMapHint')}>
+                    <textarea className={`${inputClass} h-32 font-mono text-xs`} value={columnMapJson}
+                              onChange={(e) => setColumnMapJson(e.target.value)} />
+                  </Field>
+                )}
+              </section>
+
+              <section className="space-y-3">
+                <h4 className="text-xs font-semibold uppercase tracking-wide text-text-muted">
+                  {t('biMetrics.form.sectionCaliber')}
+                </h4>
+                <Field label={t('biMetrics.form.type')}
+                       hint={metricTypeMeta ? t(metricTypeMeta.hintKey) : undefined}>
+                  <select className={inputClass} value={metricType}
+                          onChange={(e) => setMetricType(e.target.value)}>
