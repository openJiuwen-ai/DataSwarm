diff --git a/jiuwenswarm/channels/web/frontend/src/stores/structChangeStore.ts b/jiuwenswarm/channels/web/frontend/src/stores/structChangeStore.ts
new file mode 100644
index 000000000..e8519fff0
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/stores/structChangeStore.ts
@@ -0,0 +1,221 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 结构变更事件状态管理（多 session 隔离）。
+ *
+ * 数据源两条（docs/archive/delivered/chat-struct-change-push-plan.md）：
+ *  - 实时：WS chat.struct_change（对话中 debug 工作流 / DDL 建表时 app_web → Gateway 推送）；
+ *  - 恢复：historyRestore 的 onStructChangeReplay（事件随会话历史落盘，重进会话回看）。
+ * 两条链路按 eventId 幂等合并（实时先到、历史回放后到时只展示一次）。
+ *
+ * 事件模型刻意保持窄（面板渲染所需的最小集）：完整 payload 结构见方案 §3.1。
+ */
+
+import { create } from 'zustand';
+
+export interface StructChangeWorkflowRun {
+  instanceId: string;
+  refType: string;
+  refId: string;
+  status: string;
+  name: string;
+}
+
+export interface StructChangeTableChange {
+  operation: string;
+  db: string;
+  tables: string[];
+  sqlDigest: string;
+  source: string;
+}
+
+export interface StructChangeWorkflowChange {
+  operation: string;
+  workflowId: string;
+  name: string;
+  nodeCount: number;
+  source: string;
+}
+
+export interface StructChangeEvent {
+  eventId: string;
+  ts: string;
+  kind: 'workflow_run' | 'workflow_change' | 'table_change';
+  workflowRun?: StructChangeWorkflowRun;
+  workflowChange?: StructChangeWorkflowChange;
+  tableChange?: StructChangeTableChange;
+}
+
+/** 展示上限：超出丢最旧（对话内的近期事件面板，不是审计日志） */
+export const MAX_EVENTS = 50;
+
+interface StructChangeRuntime {
+  events: StructChangeEvent[];
+}
+
+interface StructChangeState {
+  runtimes: Record<string, StructChangeRuntime>;
+
+  ensureRuntime: (sessionId: string) => StructChangeRuntime;
+  getRuntime: (sessionId: string | null) => StructChangeRuntime | undefined;
+  removeRuntime: (sessionId: string) => void;
+
+  /** 按 eventId 幂等写入；返回是否首条事件（首事件用于面板自动展开） */
+  applyEvent: (sessionId: string, event: StructChangeEvent) => boolean;
+  /** 历史恢复批量写入（同样幂等），用于重进会话时回看 */
+  applyEvents: (sessionId: string, events: StructChangeEvent[]) => boolean;
+  clearSession: (sessionId: string) => void;
+}
+
+function createEmptyRuntime(): StructChangeRuntime {
+  return { events: [] };
+}
+
+/**
+ * 按 ts 倒序插入（新的在前）。清单顺序必须由 ts 决定，不能依赖到达顺序：
+ * 实时 WS 是时间序，但历史回放按页到达（page2 比 page1 更早却后回放），
+ * 无条件前插会把更早的事件顶到清单最前面，看起来就是「没按时间排序」。
+ * 同 ts（同毫秒连发）时后到者在前；ts 缺失/不可解析者排末尾（新事件插在它们之前）。
+ *
+ * @param events 当前已有序（倒序）的事件数组
+ * @param event 待插入事件
+ * @returns 插入后的新数组（不改原数组）
+ */
+function insertByTsDesc(events: StructChangeEvent[], event: StructChangeEvent): StructChangeEvent[] {
+  const ts = Date.parse(event.ts);
+  if (!Number.isFinite(ts)) return [...events, event];
+  const at = events.findIndex((e) => {
+    const ms = Date.parse(e.ts);
+    // 无效 ts 视为最旧：新事件插在它之前；同 ts（<=）后到者在前
+    return !Number.isFinite(ms) || ms <= ts;
+  });
+  if (at < 0) return [...events, event];
+  const next = events.slice();
+  next.splice(at, 0, event);
+  return next;
+}
+
+export const useStructChangeStore = create<StructChangeState>((set, get) => ({
+  runtimes: {},
+
+  ensureRuntime: (sessionId) => {
+    const existing = get().runtimes[sessionId];
+    if (existing) return existing;
+    const runtime = createEmptyRuntime();
+    set((state) => ({ runtimes: { ...state.runtimes, [sessionId]: runtime } }));
+    return runtime;
+  },
+
+  getRuntime: (sessionId) => {
+    if (!sessionId) return undefined;
+    return get().runtimes[sessionId];
+  },
+
+  removeRuntime: (sessionId) => {
+    set((state) => {
+      const next = { ...state.runtimes };
+      delete next[sessionId];
+      return { runtimes: next };
+    });
+  },
+
+  applyEvent: (sessionId, event) => {
+    if (!event.eventId) return false;
+    let isFirst = false;
+    set((state) => {
+      const runtime = state.runtimes[sessionId] ?? createEmptyRuntime();
+      if (runtime.events.some((e) => e.eventId === event.eventId)) return state;
+      isFirst = runtime.events.length === 0;
+      // 按 ts 倒序存储（新的在前），事件清单直接顺序渲染
+      const events = insertByTsDesc(runtime.events, event).slice(0, MAX_EVENTS);
+      return { runtimes: { ...state.runtimes, [sessionId]: { events } } };
+    });
+    return isFirst;
+  },
+
+  applyEvents: (sessionId, events) => {
+    let anyFirst = false;
+    for (const event of events) {
+      if (get().applyEvent(sessionId, event)) anyFirst = true;
+    }
+    return anyFirst;
+  },
+
+  clearSession: (sessionId) => {
+    set((state) => {
+      const runtime = state.runtimes[sessionId];
+      if (!runtime) return state;
+      return { runtimes: { ...state.runtimes, [sessionId]: createEmptyRuntime() } };
+    });
+  },
+}));
+
+/**
+ * WS payload（snake_case 契约，方案 §3.1）→ 前端事件模型（camelCase）。
+ * 结构不合法返回 null（调用方丢弃），不抛出。
+ */
+export function normalizeStructChangeEvent(payload: Record<string, unknown>): StructChangeEvent | null {
+  const eventId = typeof payload.event_id === 'string' ? payload.event_id.trim() : '';
+  const kind = payload.kind;
+  if (!eventId || (kind !== 'workflow_run' && kind !== 'workflow_change' && kind !== 'table_change')) return null;
+  const ts = typeof payload.ts === 'string' ? payload.ts : '';
+
+  if (kind === 'workflow_change') {
+    const raw = payload.workflow_change;
+    if (!raw || typeof raw !== 'object') return null;
+    const wc = raw as Record<string, unknown>;
+    const workflowId = typeof wc.workflow_id === 'string' ? wc.workflow_id : '';
+    if (!workflowId) return null;
+    return {
+      eventId,
+      ts,
+      kind,
+      workflowChange: {
+        operation: typeof wc.operation === 'string' ? wc.operation : '',
+        workflowId,
+        name: typeof wc.name === 'string' ? wc.name : '',
+        nodeCount: typeof wc.node_count === 'number' && Number.isFinite(wc.node_count) ? wc.node_count : 0,
+        source: typeof wc.source === 'string' ? wc.source : '',
+      },
+    };
+  }
+
+  if (kind === 'workflow_run') {
+    const raw = payload.workflow_run;
+    if (!raw || typeof raw !== 'object') return null;
+    const wr = raw as Record<string, unknown>;
+    const instanceId = typeof wr.instance_id === 'string' ? wr.instance_id : '';
+    if (!instanceId) return null;
+    return {
+      eventId,
+      ts,
+      kind,
+      workflowRun: {
+        instanceId,
+        refType: typeof wr.ref_type === 'string' ? wr.ref_type : '',
+        refId: typeof wr.ref_id === 'string' ? wr.ref_id : '',
+        status: typeof wr.status === 'string' ? wr.status : '',
+        name: typeof wr.name === 'string' ? wr.name : '',
+      },
+    };
+  }
+
+  const raw = payload.table_change;
+  if (!raw || typeof raw !== 'object') return null;
+  const tc = raw as Record<string, unknown>;
+  const tables = Array.isArray(tc.tables)
+    ? tc.tables.filter((t): t is string => typeof t === 'string' && t.trim().length > 0)
+    : [];
+  if (!tables.length) return null;
+  return {
+    eventId,
+    ts,
+    kind,
+    tableChange: {
+      operation: typeof tc.operation === 'string' ? tc.operation : '',
+      db: typeof tc.db === 'string' ? tc.db : '',
+      tables,
+      sqlDigest: typeof tc.sql_digest === 'string' ? tc.sql_digest : '',
+      source: typeof tc.source === 'string' ? tc.source : '',
+    },
+  };
+}
