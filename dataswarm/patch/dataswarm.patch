+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/service.py —— L1+L2 服务编排（context 构建）与计划校验入口。
+
+无跨请求状态：check/execute/plan 每次回源重建允许集（防客户端篡改扩权），
+上下文包经响应体交给编排层（主 Agent），manifest 由 skill 侧脚本累积。
+
+context 构建是**三级串行漏斗**（设计 docs/archive/delivered/data-analysis-flow-shortcut-design.md）：
+第〇级 scale gate（小授权目录全量直读）；第一级只跑术语路 + 定向图补全 →
+够格直接出短路包（跳过指标候选甄别）；不够格补跑其余三路走完整召回
+（术语路结果复用，不重跑）；完整召回指标候选仍为空时标
+``no_metric_candidate``，由编排层落第三级 schema 探索。
+
+结构约束（测试 patch 锚点，重排时不可破坏）：``workspace_context`` /
+``semantic_link`` / ``store`` / ``get_open_analysis_enabled`` / ``build_context``
+以模块全局被单测 patch——所有回源调用必须留在本模块函数体内；纯序列化
+视图在 views.py（无回源可外移）。
+"""
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from typing import Any
+
+from jiuwenswarm.common import workspace_context
+from jiuwenswarm.common.config import get_open_analysis_enabled
+
+from ..glossary import db as glossary_db
+from ..metrics import semantic_link, store
+from . import graph_expand, plan as plan_module, recall, shortcut
+from .context_pack import build_packs, build_shortcut_packs, scope_of
+from .model import CHANNEL_OK, CHANNEL_SKIPPED, LEXICAL_FLOOR, RecallHit, RoadResult
+from .views import expansion_view, material_views, packs_view, plan_view, road_view
+
+logger = logging.getLogger(__name__)
+
+MODE_INITIAL = "initial"
+MODE_RECALL_MORE = "recall_more"
+
+
+def _open_analysis_enabled() -> bool:
+    """开放分析开关（config.yaml 顶层 ``open_analysis_enabled``，默认开启）。
+
+    与 skill 侧（analysis_flow）共用 jiuwenswarm.common.config 的 getter，
+    键位与解析语义零漂移；保留本函数是因为 context 响应的
+    ``open_analysis.enabled`` 字段与服务端测试 patch 点都引用此名。
+    """
+    return get_open_analysis_enabled()
+
+
+def build_context(
+    question: str,
+    *,
+    mode: str = MODE_INITIAL,
+    source_ids: list[str] | None = None,
+) -> dict[str, Any]:
+    """上下文构建对外入口：在 ``_build_context`` 结果上附 open_analysis 开关信号。
+
+    Args:
+        question: 问题原句（initial）或 component 文本（recall_more）。
+        mode: ``initial`` | ``recall_more``。
+        source_ids: 限定数据源；None 全部源。
+
+    Returns:
+        ``_build_context`` 响应 + ``open_analysis`` 字段。
+    """
+    result = _build_context(question, mode=mode, source_ids=source_ids)
+    result["open_analysis"] = {"enabled": _open_analysis_enabled()}
+    return result
+
+
+def _build_context(
+    question: str,
+    *,
+    mode: str = MODE_INITIAL,
+    source_ids: list[str] | None = None,
+) -> dict[str, Any]:
+    """L1 召回 + L2①–③（图补全/去重精排/上下文组装），按三级漏斗编排。
+
+    Args:
+        question: 问题原句（initial）或 component 文本（recall_more）。
+        mode: ``initial``（走短路判定）| ``recall_more``（补召回，**永远
+            四路全跑**——它的目的就是补全信息，短路会适得其反）。
+        source_ids: 限定数据源；None 全部源。
+
+    Returns:
+        ``{"route", "route_reasons", "shortcut"?, "recall", "expansion",
+        "packs", "scope", "ambiguities", "gap_terms", "semantic_versions",
+        "warnings"}``。``route`` ∈ ``term_shortcut`` | ``full_recall``；
+        短路路径下未跑的召回路以 ``channel_status=skipped`` 原样列出。
+    """
+    question = str(question or "").strip()
+    if not question:
+        raise ValueError("question 不能为空")
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+
+    warnings: list[str] = []
+    refs, snapshots = semantic_link.current_snapshots(warnings)
+    if source_ids:
+        snapshots = {sid: snapshot for sid, snapshot in snapshots.items() if sid in source_ids}
+        refs = [ref for ref in refs if ref.source_id in source_ids]
+
+    # ---- 第〇级：scale gate——小授权目录全量直读，跳过一切召回 ----
+    # Only authorized, published workspace assets enter the full read; both
+    # limits must pass. 门未过/目录不可用时带回 hybrid_recall trace 走漏斗。
+    scale_trace: dict[str, Any] = {"strategy": "hybrid_recall", "reason": MODE_RECALL_MORE}
+    if mode != MODE_RECALL_MORE:
+        full_response, scale_trace = _full_context_gate(
+            question, mode, workspace_id, snapshots, source_ids, warnings)
+        if full_response is not None:
+            return full_response
+
+    # ---- Knowledge discovery runs before either shortcut or full L2 expansion. ----
+    retrieved, knowledge_roads, versions = _knowledge_roads(
+        question, workspace_id, snapshots, source_ids, warnings)
+
+    # ---- 第一级：术语和知识共同作为图入口，不能短路丢掉新知识关联 ----
+    term_road: RoadResult | None = None
+    verdict: shortcut.ShortcutVerdict | None = None
+    if mode != MODE_RECALL_MORE:
+        term_road = recall.recall_all(question, workspace_id, roads=("terms",))["terms"]
+        term_expansion = graph_expand.expand({"terms": term_road, **knowledge_roads}, workspace_id, snapshots,
+                                             knowledge_versions=versions, source_ids=source_ids)
+        _merge(warnings, term_road.warnings, term_expansion.warnings)
+        verdict = shortcut.term_shortcut_verdict(term_road, term_expansion)
+        extra_metrics = {hit.entity_id for hit in term_expansion.metrics}
+        expanded_term_ids = {str(term.get("term_id")) for term in term_expansion.terms}
+        knowledge_safe = (retrieved["channel_status"] != "unavailable"
+                          and term_expansion.knowledge_trace.get("path") != "unavailable"
+                          and (not verdict.term or expanded_term_ids <= {str(verdict.term.get("term_id"))})
+                          and (not verdict.metric_hit or extra_metrics <= {verdict.metric_hit.entity_id}))
+        if verdict.eligible and knowledge_safe and verdict.metric_hit is not None and verdict.term is not None:
+            return _shortcut_context(ShortcutInput(
+                question=question, mode=mode, term=verdict.term, metric_hit=verdict.metric_hit,
+                reasons=list(verdict.reasons), term_road=term_road, workspace_id=workspace_id,
+                snapshots=snapshots, refs=refs, source_ids=source_ids, warnings=warnings,
+                scale_trace=scale_trace, retrieved=retrieved, knowledge_roads=knowledge_roads,
+                versions=versions))
+
+    # ---- 第二级：完整四路（第一级已跑的术语路复用，不重跑）----
+    if term_road is None:
+        # 补召回轮不做短路判定，但术语路仍先跑——扩展词要注入 schema 路
+        term_road = recall.recall_all(question, workspace_id, roads=("terms",))["terms"]
+        _merge(warnings, term_road.warnings)
+    recall_results = {
+        "terms": term_road,
+        **knowledge_roads,
+        **recall.recall_all(question, workspace_id, source_ids=source_ids,
+                            roads=("metrics", "schema", "values"),
+                            glossary_terms=recall.glossary_words(term_road)),
+    }
+    for road in recall_results.values():
+        _merge(warnings, road.warnings)
+
+    expansion = graph_expand.expand(recall_results, workspace_id, snapshots,
+                                    knowledge_versions=versions, source_ids=source_ids)
+    _merge(warnings, expansion.warnings)
+
+    packs = build_packs(recall_results, expansion, workspace_id, snapshots, refs)
+    _complete_knowledge(packs, expansion, source_ids, warnings)
+    scope = scope_of(packs, source_id=(source_ids or [""])[0])
+    ambiguities = _collect_ambiguities(recall_results, packs)
+
+    route_reasons = list(verdict.reasons) if verdict is not None else [shortcut.REASON_RECALL_MORE]
+    if verdict is not None and verdict.eligible:
+        route_reasons.append("knowledge_requires_full_recall")
+    if not packs.metrics_candidates:
+        # 指标零候选 → 编排层落第三级 schema 探索（出口分流的程序化落点）
+        route_reasons.append(shortcut.REASON_NO_METRIC_CANDIDATE)
+
+    return _assemble_context(
+        mode=mode, question=question, route=shortcut.ROUTE_FULL_RECALL,
+        route_tier=shortcut.route_tier(verdict), route_reasons=route_reasons,
+        scale_gate=scale_trace,
+        recall_payload={
+            "terms": road_view(recall_results["terms"]),
+            "metrics": road_view(recall_results["metrics"]),
+            "schema": road_view(recall_results["schema"]),
+            "values": road_view(recall_results["values"]),
+            **{name: road_view(road) for name, road in knowledge_roads.items()},
+        },
+        expansion=expansion_view(expansion),
+        packs=packs_view(packs),
+        knowledge_retrieval=retrieved,
+        scope=scope,
+        ambiguities=ambiguities,
+        gap_terms=shortcut.gap_terms(recall_results["terms"], expansion),
+        semantic_versions=packs.semantic_versions,
+        warnings=warnings,
+    )
+
+
+def _full_context_gate(
+    question: str,
+    mode: str,
+    workspace_id: str,
+    snapshots: dict[str, Any],
+    source_ids: list[str] | None,
+    warnings: list[str],
+) -> tuple[dict[str, Any] | None, dict[str, Any]]:
+    """Scale gate：目录在字符/token 双预算内 → 全量直读响应；否则 None 走混合召回。
+
+    Returns:
+        (全量直读响应 | None, scale trace)。trace 两种走法都要用：
+        直读成功记录门通过，未过/不可用记录回落原因。
+    """
+    from .full_context import catalog as full_catalog
+    try:
+        full_packs, scale_trace = full_catalog(workspace_id, snapshots, source_ids)
+    except Exception as exc:  # noqa: BLE001 — unavailable catalog falls back to existing recall
+        return None, {"strategy": "hybrid_recall", "reason": f"catalog_unavailable:{type(exc).__name__}"}
+    if full_packs is None:
+        return None, scale_trace
+    from .graph_expand import Expansion
+    expansion = Expansion(graph_status="ok", graph_path="full_context")
+    scope = scope_of(full_packs, source_id=(source_ids or [""])[0])
+    skipped = road_view(RoadResult("", (), CHANNEL_SKIPPED))
+    response = _assemble_context(
+        mode=mode, question=question, route="full_context", route_tier="full_context",
+        route_reasons=["catalog_within_both_budgets"], scale_gate=scale_trace,
+        recall_payload=dict.fromkeys(
+            ("terms", "metrics", "schema", "values", "mappings", "rules"), skipped),
+        expansion=expansion_view(expansion),
+        packs=packs_view(full_packs),
+        knowledge_retrieval={"strategy": "full_context", "stage": "scope_gate",
+                             "channel_status": ("ok" if full_packs.knowledge_assets
+                                                or full_packs.knowledge_rules else "no_hit"),
+                             "hits": full_packs.knowledge_assets + full_packs.knowledge_rules,
+                             "warnings": [], "embedding_called": False},
+        scope=scope,
+        ambiguities=[],
+        gap_terms=[],
+        semantic_versions=full_packs.semantic_versions,
+        warnings=warnings,
+    )
+    return response, scale_trace
+
+
+def _knowledge_roads(
+    question: str,
+    workspace_id: str,
+    snapshots: dict[str, Any],
+    source_ids: list[str] | None,
+    warnings: list[str],
+) -> tuple[dict[str, Any], dict[str, RoadResult], dict[str, Any]]:
+    """知识发现（漏斗之前）：检索 + 转召回路；失败整路降级为 unavailable。"""
+    from ..knowledge.retrieval import retrieve, as_roads
+    active_release = store.get_active_release(workspace_id)
+    versions = {"release_id": active_release.release_id if active_release else None,
+                "snapshots": [{"source_id": sid, "snapshot_id": snapshot.snapshot_id}
+                              for sid, snapshot in snapshots.items()]}
+    try:
+        retrieved = retrieve(question, workspace_id, source_ids=source_ids, versions=versions)
+    except Exception as exc:  # noqa: BLE001 — explicit discovery degradation; final rule verification fails closed
+        retrieved = {"strategy": "lexical+embedding", "stage": "L1", "channel_status": "unavailable",
+                     "hits": [], "warnings": [f"knowledge_retrieval_failed:{type(exc).__name__}"]}
+    knowledge_roads = as_roads(retrieved)
+    _merge(warnings, retrieved["warnings"])
+    return retrieved, knowledge_roads, versions
+
+
+def _assemble_context(
+    *,
+    mode: str,
+    question: str,
+    route: str,
+    route_tier: str,
+    route_reasons: list[str],
+    scale_gate: dict[str, Any],
+    recall_payload: dict[str, Any],
+    expansion: dict[str, Any],
+    packs: dict[str, Any],
+    knowledge_retrieval: dict[str, Any],
+    scope: dict[str, Any],
+    ambiguities: list[dict[str, Any]],
+    gap_terms: list[dict[str, Any]],
+    semantic_versions: dict[str, Any],
+    warnings: list[str],
+    shortcut_payload: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    """context 响应统一信封：三条路径（直读/短路/完整召回）共用同一份字段清单。
+
+    ``open_analysis`` 开关信号由外层 ``build_context`` 统一注入（唯一注入点）；
+    ``materials`` 由 packs 投影（三条路径口径一致）。
+    """
+    payload: dict[str, Any] = {
+        "mode": mode,
+        "question": question,
+        "route": route,
+        "route_tier": route_tier,
+        "route_reasons": route_reasons,
+        "scale_gate": scale_gate,
+        "recall": recall_payload,
+        "expansion": expansion,
+        "packs": packs,
+        "materials": material_views(packs),
+        "knowledge_retrieval": knowledge_retrieval,
+        "scope": scope,
+        "ambiguities": ambiguities,
+        "gap_terms": gap_terms,
+        "semantic_versions": semantic_versions,
+        "warnings": warnings,
+    }
+    if shortcut_payload is not None:
+        payload["shortcut"] = shortcut_payload
+    return payload
+
+
+def _metric_gate(
+    plan_payload: dict[str, Any],
+    workspace_id: str,
+    context: dict[str, Any],
+) -> tuple[list[dict[str, str]], set[str]]:
+    """开放分析指标门禁（F-028）：指标可用时 required core 成分必须走权威编译。
+
+    指标是可选配置——三档判定，无指标空间走 G3 手写仍是合法降级路径：
+    1. 候选池（context materials）含 metric 素材 → required core 成分必须
+       ``selected_metrics`` 非空或 ``material_refs`` 引用 ``metric:`` 素材
+       （堵「素材给了不用」）；
+    2. 候选池无 metric → 用成分自身文本（output/text/dimensions，不拼问题——
+       防兄弟成分误伤）兜底检索已发布指标——不依赖首路召回的措辞运气
+       （「经营分析报告」不含指标词时首路必空）；命中且未选定 → 报错指路；
+    3. 兜底也无命中（空间未发布指标/语义无关）→ 放行。
+
+    思考链实证（open-analysis-smoke-fix2）：模型 recall_more 拿到指标素材后
+    引用 ``metric:<key>`` 被「素材不在候选池」拒——校验池用 question 瞬时
+    重算，recall_more 的成果进不了池，模型被逼凑初始池无关列。因此兜底
+    命中的指标 key 会随错误一起返回，调用方须扩进候选池与候选榜，否则
+    「指路后又堵门」死循环。
+
+    Args:
+        plan_payload: 客户端提交的原始 plan。
+        workspace_id: 当前工作空间（兜底检索范围）。
+        context: ``build_context`` 结果（候选池来源）。
+
+    Returns:
+        (error dict 列表, 兜底检索命中的 published 指标 key 集)。
+    """
+    errors: list[dict[str, str]] = []
+    fallback_keys: set[str] = set()
+    pool_keys = sorted({str(m.get("metric_key")) for m in context["materials"]
+                        if m.get("kind") == "metric" and m.get("metric_key")})
+    for component in plan_payload.get("components") or []:
+        if not isinstance(component, dict):
+            continue
+        # role/required 是 open 计划的显式字段；closed 计划（≤5 全核心）不写它们——
+        # 缺省按 core+required 处理，否则 gate 对 closed 计划整体漏网（olist-05 实证：
+        # 组件无 role 字段 → 循环全 continue → 手写 G3 无指标指路）。
+        role = str(component.get("role") or "core")
+        required = component.get("required")
+        if required is None:
+            required = True
+        if role != "core" or not required:
+            continue
+        if component.get("selected_metrics"):
+            continue
+        refs = component.get("material_refs") or []
+        metric_refs = [r[len("metric:"):] for r in refs
+                       if isinstance(r, str) and r.startswith("metric:")]
+        if metric_refs:
+            # 已按指路引用 metric: 素材 → 视为选定，不再报「必须选定」。
+            # 引用有效性不在门禁判：validate_plan 的引用复验段对全部成分与
+            # facet 的 metric: 引用回源复验并扩池（core/required 之外同样
+            # 需要复验——f028-fix-verify 实证 facets.material_refs 引用被
+            # 「不在候选池」全拒，门禁这里只看得见 core/required 成分）。
+            continue
+        cid = str(component.get("component_id") or "")
+        if pool_keys:
+            errors.append({
+                "component_id": cid, "field": "selected_metrics",
+                "message": f"候选池已有指标素材（{'、'.join(pool_keys[:3])}），core 成分必须选定指标"
+                           f"走权威编译（G1）——把指标写进 selected_metrics 并在 material_refs 引用 metric:<key>"})
+            continue
+        probe = " ".join(filter(None, [str(component.get("output") or ""),
+                                       str(component.get("text") or ""),
+                                       " ".join(str(d) for d in component.get("dimensions") or [])]))
+        if not probe.strip():
+            continue
+        matched = None
+        for metric, score, _via in store.search_defs(workspace_id, probe, limit=5):
+            if score < LEXICAL_FLOOR or store.published_revision(metric) is None:
+                continue
+            matched = metric
+            break
+        if matched is None:
+            # 长口径公式文本（「净营收 = 支付成交额 GMV − 退款金额」）会稀释词法
+            # 分（F-028 措辞依赖）——EMB 语义兜底后同样指路；通道不可用时保持
+            # 词法结论，不因 EMB 故障误放行或误拦截。
+            try:
+                from .recall import _metric_vector_hits
+                for hit in _metric_vector_hits(probe, workspace_id, []):
+                    metric_def = store.get_def_by_key(workspace_id, str(hit.entity_id))
+                    if metric_def is None or store.published_revision(metric_def) is None:
+                        continue
+                    matched = metric_def
+                    break
+            except Exception as exc:  # noqa: BLE001 — EMB 兜底失败不改变词法判定
+                logger.debug("EMB 语义兜底检索失败，保持词法判定: %s", type(exc).__name__)
+        if matched is not None:
+            fallback_keys.add(str(matched.metric_key))
+            errors.append({
+                "component_id": cid, "field": "selected_metrics",
+                "message": f"检测到已发布指标 {matched.metric_key} 与成分输出相关——选定它"
+                           f"（selected_metrics + material_refs 引用 metric:{matched.metric_key}，G1）；"
+                           f"确不适用须在 uncovered 声明理由"})
+    return errors, fallback_keys
+
+
+@dataclass(frozen=True)
+class ShortcutInput:
+    """术语短路响应的组装输入（`_shortcut_context` 的具名收拢）。
+
+    term / metric_hit 由调用点判定非 None 后传入；warnings / scale_trace
+    等收集器随组装过程就地更新。
+    """
+
+    question: str
+    mode: str
+    term: dict[str, Any]
+    metric_hit: RecallHit
+    reasons: list[str]
+    term_road: RoadResult
+    workspace_id: str
+    snapshots: dict[str, Any]
+    refs: list[Any]
+    source_ids: list[str] | None
+    warnings: list[str]
+    scale_trace: dict[str, Any]
+    retrieved: dict[str, Any]
+    knowledge_roads: dict[str, RoadResult]
+    versions: dict[str, Any]
+
+
+def _shortcut_context(inp: ShortcutInput) -> dict[str, Any]:
+    """短路响应：以链指标为入口补全 scope（绑定表列 + join），组装窄包。
+
+    链指标的绑定表列要第二跳才拿得到（第一跳是术语 → 指标）；
+    ``seed_bound_columns=True`` 让绑定列参与横向扩展，否则短路包没有
+    join 边，多表口径写不出 SQL。
+    """
+    metric_road = RoadResult("metric", (inp.metric_hit,), CHANNEL_OK)
+    expansion = graph_expand.expand(
+        {"metrics": metric_road, **inp.knowledge_roads}, inp.workspace_id, inp.snapshots, seed_bound_columns=True,
+        knowledge_versions=inp.versions, source_ids=inp.source_ids)
+    _merge(inp.warnings, expansion.warnings)
+
+    packs = build_shortcut_packs(
+        inp.term, inp.metric_hit.entity_id, expansion, inp.workspace_id, inp.snapshots, inp.refs)
+    _complete_knowledge(packs, expansion, inp.source_ids, inp.warnings)
+    scope = scope_of(packs, source_id=(inp.source_ids or [""])[0])
+    skipped = road_view(RoadResult("", (), CHANNEL_SKIPPED))
+    # 短路前置条件含「无歧义」——歧义恒空（有歧义不会走到这里）
+    return _assemble_context(
+        mode=inp.mode, question=inp.question, route=shortcut.ROUTE_TERM_SHORTCUT,
+        route_tier=shortcut.TIER_A_SHORTCUT, route_reasons=inp.reasons, scale_gate=inp.scale_trace,
+        recall_payload={
+            "terms": road_view(inp.term_road),
+            "metrics": skipped,
+            "schema": skipped,
+            "values": skipped,
+            **{name: road_view(road) for name, road in inp.knowledge_roads.items()},
+        },
+        expansion=expansion_view(expansion),
+        packs=packs_view(packs),
+        knowledge_retrieval=inp.retrieved,
+        scope=scope,
+        ambiguities=[],
+        gap_terms=[],
+        semantic_versions=packs.semantic_versions,
+        warnings=inp.warnings,
+        shortcut_payload={
+            "term_id": inp.term.get("term_id"),
+            "term_name": inp.term.get("name"),
+            "metric_key": inp.metric_hit.entity_id,
+            "via": list(inp.metric_hit.matched_on),
+        },
+    )
+
+
+def _merge(warnings: list[str], *groups) -> None:
+    """告警去重合并（多路/多阶段同类告警只留一条）。"""
+    for group in groups:
+        for warning in group:
+            if warning not in warnings:
+                warnings.append(warning)
+
+
+def _complete_knowledge(packs, expansion, source_ids, warnings) -> None:
+    """L2 rule closure before QueryPlan, including rules with no lexical match."""
+    from ..knowledge.selection import rules_for_context, asset_view
+    packs.knowledge_assets = [asset_view(asset) for asset in expansion.knowledge_assets]
+    refs = {item["asset_id"] for item in packs.knowledge_assets}
+    refs.update(str(term["term_id"]) for term in packs.glossary)
+    refs.update(str(metric["metric_key"]) for metric in packs.metrics_candidates + packs.metrics_selected)
+    for table in packs.schema_tables:
+        refs.add(table.table_id)
+        refs.update(column["node_id"] for column in table.columns)
+    try:
+        result = rules_for_context(refs, source_ids=source_ids, versions=packs.semantic_versions)
+        packs.knowledge_rules = result["rules"]
+        packs.knowledge_rule_trace = result["trace"]
+    except Exception as exc:  # noqa: BLE001 — visible partial state; validate_plan must reverify
+        packs.knowledge_rule_trace = {"stage": "pre_plan", "rule_policy": "all_applicable",
+                                      "status": "unavailable", "reason": type(exc).__name__}
+        _merge(warnings, [f"knowledge_rules_unavailable:{type(exc).__name__}"])
+
+
+def _open_mode_gate(plan_payload: dict[str, Any]) -> dict[str, Any] | None:
+    """开放分析开关闸门：关闭时 mode=open 直接拒绝并指路 closed。
+
+    放在候选复验与素材池重算之前，最短路失败不花召回开销。与 skill 侧
+    cmd_plan 闸门同读 config 顶层 open_analysis_enabled（common.config getter）。
+    """
+    if str(plan_payload.get("mode") or "closed").lower() == "open" and not get_open_analysis_enabled():
+        return {
+            "validation": {"ok": False, "errors": [{
+                "component_id": "", "field": "mode",
+                "message": "开放分析未启用（open_analysis_enabled=false）：mode=open "
+                           "计划被拒绝。请改用 mode=closed（≤5 个成分）重新提交；"
+                           "如需开放分析，请在 config.yaml 顶层设置 "
+                           "open_analysis_enabled: true",
+            }]},
+            "plan": None,
+        }
+    return None
+
+
+def _scope_tables_of(snapshots: dict[str, Any]) -> dict[str, list[str]]:
+    """scope 回源重建：当前 published 快照的表列集。"""
+    scope_tables: dict[str, list[str]] = {}
+    for snapshot in snapshots.values():
+        for table in snapshot.tables:
+            columns = [column.name for column in table.columns if column.status == "active"]
+            if columns:
+                scope_tables.setdefault(table.name, []).extend(
+                    col for col in columns if col not in scope_tables.get(table.name, []))
+    return scope_tables
+
+
+def _open_material_pool(
+    plan_payload: dict[str, Any],
+    workspace_id: str,
+    snapshots: dict[str, Any],
+) -> tuple[set[str], list[dict[str, str]], set[str]]:
+    """开放计划素材池重建：按原问题重建候选池 + 客户端引用回源复验扩池。
+
+    不信任客户端提供的素材 ID；按原问题和 source 重建候选池，拒绝池外
+    侧面（开关闸门已在 validate_plan 开头统一拦截）。
+
+    Returns:
+        (material_ids, material_errors, verified)。verified 在开放模式下由
+        候选榜重算 + 兜底/复验扩池得出（替换候选复验结果——开放计划只信
+        重建池，不信请求带来的候选清单）。
+    """
+    source_id = str(plan_payload.get("source_id") or "")
+    context = build_context(str(plan_payload.get("question") or ""), source_ids=[source_id] if source_id else None)
+    material_ids = {item["material_id"] for item in context["materials"]}
+    recalled = {item["metric_key"] for item in context["packs"]["metrics_candidates"]}
+    verified = recalled
+    # F-068：scope 不用重建 context 的召回子集——报告类问句（无术语词）
+    # 首路召回窄，真实列会被「不在 schema 子包列集内」死锁（nw-19 实证
+    # scope 只剩 inventory_transactions）。closed 模式与 L3 执行检查
+    # （_snapshot_scope_tables）都是快照全列集口径，open 保持一致；
+    # 防编造由「列须真实存在于 published 快照」保证，列级口径仍由
+    # check 阶段 groupby_subset_whitelist 把守。
+    # 快照活跃列 node_id 集——素材回源复验与维度引用兜底共用。
+    snapshot_column_nodes: set[str] = {
+        column.node_id
+        for snapshot in snapshots.values()
+        for table in snapshot.tables
+        for column in table.columns if column.status == "active"}
+    columns = [m for m in context["materials"] if m["kind"] == "column"]
+    material_errors: list[dict[str, str]] = []
+    for component in plan_payload.get("components") or []:
+        if not isinstance(component, dict) or not isinstance(component.get("dimensions", []), list):
+            continue
+        for dimension in component.get("dimensions") or []:
+            matching = [m for m in columns if dimension in {m["name"], f"{m['table']}.{m['name']}"}]
+            refs = component.get("material_refs") or []
+            # F-068 兜底：召回 materials 未带出该列时，接受经快照回源
+            # 验证的 dimension:<node_id> 引用——与 metric 引用扩池同思路
+            # （_metric_gate 兜底存在，唯独维度检查此前无兜底）。
+            snapshot_verified = isinstance(refs, list) and any(
+                isinstance(ref, str) and ref.startswith("dimension:")
+                and ref[len("dimension:"):] in snapshot_column_nodes
+                and ref.endswith("." + dimension)
+                for ref in refs)
+            if not snapshot_verified and (not isinstance(refs, list) or not any(
+                    m["material_id"] in refs or f"dimension:{m['material_id']}" in refs for m in matching
+            )):
+                material_errors.append({"component_id": str(component.get("component_id") or ""),
+                                        "field": "material_refs",
+                                        "message": f"维度 {dimension} 缺少对应列的稳定素材引用"})
+    gate_errors, fallback_metric_keys = _metric_gate(plan_payload, workspace_id, context)
+    material_errors.extend(gate_errors)
+    # 兜底命中的指标扩进候选池与候选榜——recall_more 成果进不了瞬时重算的
+    # 校验池（思考链实证：模型引用 metric:<key> 被「素材不在候选池」拒，
+    # 被逼凑初始池无关列）；扩容后按指路选定才能真正走通 G1 编译。
+    if fallback_metric_keys:
+        material_ids |= {f"metric:{key}" for key in fallback_metric_keys}
+        verified |= fallback_metric_keys
+    # 客户端引用的 term/col/dimension/metric 素材全部回源复验后扩进校验池。
+    # F-028 二型实证：按指路加回引用的提交是新调用、池重新重建，兜底扩池
+    # 不跨调用——无补偿则恒拒。复验而非信任清单：metric 查指标库 published
+    # 状态，term 查 glossary 现役，col/dimension 查当前 published 快照的
+    # 活跃表列，与候选榜回源同口径。
+    referenced: set[str] = set()
+    for group in (plan_payload.get("components") or [], plan_payload.get("facets") or []):
+        for item in group:
+            if isinstance(item, dict):
+                referenced.update(
+                    r for r in (item.get("material_refs") or []) if isinstance(r, str))
+    if referenced - material_ids:
+        snapshot_nodes = snapshot_column_nodes
+        for ref in referenced:
+            if ref in material_ids:
+                continue
+            if ref.startswith("metric:"):
+                # 指标引用回源复验（F-038 二型根治位）：门禁 _metric_gate 只
+                # 看得见 core/required 成分，facet 与普通成分的 metric: 引用
+                # 在此全量复验——published 则同时扩进候选池与候选榜
+                # （selected_metrics 校验同用 verified），否则模型按指路
+                # 引用的提交在新调用里仍被「素材不在候选池」全拒。
+                key = ref[len("metric:"):]
+                if store.published_revision_of(workspace_id, key) is not None:
+                    material_ids.add(ref)
+                    verified.add(key)
+            elif ref.startswith("term:"):
+                term = glossary_db.get_term(ref[len("term:"):])
+                if term and term.get("status") != "deprecated":
+                    material_ids.add(ref)
+            elif ref.startswith(("col:", "dimension:")):
+                node_id = ref[len("dimension:"):] if ref.startswith("dimension:") else ref
+                if node_id in snapshot_nodes:
+                    material_ids.add(ref)
+    return material_ids, material_errors, verified
+
+
+def validate_plan(
+    plan_payload: dict[str, Any],
+    *,
+    candidate_keys: list[str] | None = None,
+) -> dict[str, Any]:
+    """QueryPlan 程序校验（候选集与 scope 均回源重建，不信客户端回传）。
+
+    Args:
+        plan_payload: ``{analysis_id?, question, components, uncovered, ...}``。
+        candidate_keys: context 响应给出的候选指标（提示）；服务端逐个回源
+            复验（存在且 published），复验通过的才是合法候选。
+
+    Returns:
+        ``{"validation": {"ok", "errors"}, "plan": 规范化回显 | None}``。
+    """
+    workspace_id = workspace_context.current_workspace().workspace_id or "default"
+    gate = _open_mode_gate(plan_payload)
+    if gate is not None:
+        return gate
+    # 候选回源复验：请求带来的候选只作提示，published 才算数
+    verified: set[str] = set()
+    for key in candidate_keys or ():
+        if store.published_revision_of(workspace_id, str(key)) is not None:
+            verified.add(str(key))
+    warnings: list[str] = []
+    _refs, snapshots = semantic_link.current_snapshots(warnings)
+    scope_tables = _scope_tables_of(snapshots)
+
+    material_ids: set[str] | None = None
+    material_errors: list[dict[str, str]] = []
+    if str(plan_payload.get("mode") or "closed").lower() == "open":
+        material_ids, material_errors, verified = _open_material_pool(
+            plan_payload, workspace_id, snapshots)
+
+    parsed, errors = plan_module.parse_and_validate(
+        plan_payload, verified, scope_tables, material_ids=material_ids)
+    if material_errors:
+        parsed = None
+        errors.extend(material_errors)
+
+    knowledge = {"rules": [], "examples": [], "trace": {"rule_policy": "all_applicable", "rules_selected": 0,
+                                                        "examples_selected": 0, "examples_rejected": [],
+                                                        "g1_uses_examples": False}}
+    selected_packs = None
+    try:
+        from ..knowledge.selection import resolve_for_plan, bind_plan_refs
+        if parsed is not None:
+            from .model import ContextPacks
+            from .context_pack import fill_selected_metrics
+            selected_packs = ContextPacks()
+            fill_selected_metrics(selected_packs, workspace_id,
+                                  sorted({key for c in parsed.components for key in c.selected_metrics}))
+            trusted_plan = plan_view(parsed)
+            trusted_plan["metrics_selected"] = selected_packs.metrics_selected
+            trusted_plan["semantic_versions"] = {
+                "snapshots": [{"source_id": sid, "snapshot_id": snapshot.snapshot_id}
+                              for sid, snapshot in snapshots.items()]}
+            active_release = store.get_active_release(workspace_id)
+            if active_release:
+                trusted_plan["release_id"] = active_release.release_id
+            trusted_plan["source_ids"] = ([trusted_plan["source_id"]] if trusted_plan.get("source_id")
+                                          else list(snapshots))
+            if trusted_plan.get("source_id"):
+                from ..datasource import store as datasource_store
+                from jiuwenswarm.common.dialect_registry import dialect_of_ref
+                source = datasource_store.get_source(trusted_plan["source_id"], workspace_id)
+                if not source or not source.get("enabled", True):
+                    raise ValueError("selected source is not enabled in current workspace")
+                trusted_plan["dialect"] = dialect_of_ref(source.get("db_ref") or "")
+            bind_plan_refs(trusted_plan, workspace_id, snapshots)
+            knowledge = resolve_for_plan(trusted_plan)
+    except Exception as exc:  # noqa: BLE001 — unavailable mandatory rules cannot silently disappear
+        knowledge["trace"]["warning"] = f"knowledge_unavailable:{type(exc).__name__}"
+        parsed = None
+        errors.append({"field": "knowledge", "message": "知识依赖无法复验，请恢复知识服务后重试"})
+    return {
+        "validation": {"ok": parsed is not None, "errors": errors},
+        "plan": plan_view(parsed) if parsed else None,
+        "knowledge": knowledge,
+        "metrics_selected": selected_packs.metrics_selected if selected_packs is not None else [],
+    }
+
+
+def _collect_ambiguities(recall_results: dict[str, RoadResult], packs) -> list[dict[str, Any]]:
+    """歧义候选收集：同分多口径术语 + 维值多义（同值命中多列）。"""
+    ambiguities: list[dict[str, Any]] = []
+    for term in packs.glossary:
+        if term.get("ambiguous"):
+            ambiguities.append({
+                "kind": "term_caliber",
+                "name": term.get("name"),
+                "detail": "问题表述同分命中多个术语口径，请指明口径",
+            })
+    # 维值多义：同值命中不同列（「SP」是州还是城市）。
+    # 只认词法命中——值在用户文本中字面出现才构成「指定过滤值」的证据；
+    # 向量通道是跨语言联想（「卖得最好」↔ Sales Representative、「取消」↔
+    # canceled），联想值参与判定会把分析性表述（「含取消订单在内」）误拦成
+    # 过滤歧义，clarify gate 阻塞整条链路（F-053）。
+    by_value: dict[str, list[str]] = {}
+    for hit in recall_results.get("values", RoadResult("value", (), "unavailable")).hits:
+        if not any(name.startswith("lexical") for name, _ in hit.channels):
+            continue
+        column_id = str(hit.payload.get("column_id") or "")
+        if column_id:
+            by_value.setdefault(hit.label, []).append(column_id)
+    for value, column_ids in by_value.items():
+        if len(set(column_ids)) > 1:
+            ambiguities.append({
+                "kind": "value_polysemy",
+                "value": value,
+                "columns": sorted(set(column_ids)),
+                "detail": f"取值 {value!r} 命中多列，请指明过滤目标",
+            })
+    return ambiguities
