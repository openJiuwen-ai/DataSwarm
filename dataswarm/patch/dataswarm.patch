+    result = checks.check_request(_body(sql))
+    # note 在快照内（scope pass）但不在绑定内 → binding fail → G2
+    assert _check_of(result, "scope_membership")["status"] == "pass"
+    assert _check_of(result, "tables_columns_subset_binding")["status"] == "fail"
+    assert result["grounding_level"] == "G2"
