+        # 自带库名 ｜ meta 标记取 metadata_database。
+        scheme = self.scheme
+        meta_flag = rest.strip() == "meta"
+        body = "" if meta_flag else rest
+        if not body or "/" not in body:
+            cfg = _read_config_section(self.section)
+            prefix = self.env_prefix
+            host = cfg.get("host") or os.environ.get(f"{prefix}_HOST", "")
+            port = (
+                cfg.get("port")
+                or int(os.environ.get(f"{prefix}_PORT", "0") or 0)
+                or self.default_port
+            )
+            user = cfg.get("user") or os.environ.get(f"{prefix}_USER", "")
+            password = cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", "")
+            if meta_flag:
+                database = cfg.get("metadata_database") or os.environ.get(
+                    f"{prefix}_METADATA_DATABASE", ""
+                )
+                if not database:
+                    raise ValueError(
+                        f"{scheme}://meta 需 config {self.section}.metadata_database "
+                        f"配置元数据库 schema"
+                    )
+            elif body:
+                database = body
+            else:
+                database = cfg.get("database") or os.environ.get(f"{prefix}_DATABASE", "")
+            if not host:
+                raise ValueError(
+                    f"{scheme}:// 需 config {self.section}: 段 或环境变量 "
+                    f"{prefix}_HOST，或完整 db-ref"
+                )
+            spec = {
+                "type": scheme,
+                "host": host,
+                "port": int(port) if port else self.default_port,
+                "user": user,
+                "password": password,
+                "database": database,
+                "is_metadata": meta_flag,
+            }
+            if cfg.get("schema"):
+                spec["schema"] = cfg["schema"]
+            return spec
+        host_port, _, db = body.partition("/")
+        host, _, port = host_port.partition(":")
+        resolved_port = int(port) if port else self.default_port
+        spec = {
+            "type": scheme,
+            "host": host,
+            "port": resolved_port,
+            "user": "",
+            "password": "",
+            "database": db,
+        }
+        creds = _lookup_source_credentials(scheme, host, resolved_port, db)
+        if creds:
+            spec.update(creds)
+        return spec
+
+    def engine_url(self, spec: dict, read_only: bool) -> str:
+        from urllib.parse import quote_plus
+
+        user = spec.get("user") or ""
+        pwd = spec.get("password") or ""
+        if not user:
+            cfg = _read_config_section(self.section)
+            prefix = self.env_prefix
+            user = cfg.get("user") or os.environ.get(f"{prefix}_USER", "")
+            pwd = cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", "")
+        auth = f"{quote_plus(user, safe='')}:{quote_plus(pwd, safe='')}@" if user else ""
+        host = spec.get("host", "")
+        port = spec.get("port") or self.default_port
+        db = spec.get("database") or ""
+        return f"postgresql+psycopg://{auth}{host}:{port}/{db}"
+
+    def connect_direct(self, spec: dict, read_only: bool):
+        try:
+            import psycopg
+        except ImportError as exc:
+            raise ImportError(
+                "psycopg 未安装，请 pip install 'jiuwenswarm[ds-postgres]'"
+            ) from exc
+        user = spec.get("user") or ""
+        pwd = spec.get("password") or ""
+        if not user:
+            # 与 engine_url 同源兜底：spec 未带凭据时从 config 段 + env 补齐。
+            # 否则 user 为空，libpq 回退当前系统用户名，可能报 role 不存在。
+            # does not exist（2026-10-22 实测）。MySQL 族早有这个护栏，PG 族
+            # 当初漏了同一条。
+            cfg = _read_config_section(self.section)
+            prefix = self.env_prefix
+            user = cfg.get("user") or os.environ.get(f"{prefix}_USER", "")
+            pwd = cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", "")
+        kwargs = {
+            "host": spec.get("host") or "",
+            "port": int(spec.get("port") or self.default_port),
+            "user": user,
+            "password": pwd,
+            "dbname": spec.get("database") or "",
+            "connect_timeout": 10,
+        }
+        if read_only:
+            # 服务端只读事务：比依赖 SQL 护栏多一层兜底（护栏在应用层，这条在库层）
+            kwargs["options"] = "-c default_transaction_read_only=on"
+        conn = psycopg.connect(**kwargs)
+        return conn, {"type": spec["type"], **{k: v for k, v in kwargs.items()
+                                               if k != "password"}}
+
+    def session_setup(self, cur, read_only: bool) -> None:
+        # 保留公共会话初始化钩子；当前不覆盖服务器 search_path。
+        return None
+
+    def tables_sql(self) -> str:
+        # 仅当前 search_path 下的用户表；排除系统 schema。
+        return (
+            "SELECT table_name FROM information_schema.tables "
+            "WHERE table_schema NOT IN ('pg_catalog', 'information_schema') "
+            "AND table_type = 'BASE TABLE' ORDER BY table_name"
+        )
+
+    def describe_sql(self, table: str) -> str:
+        # 列、类型、可空、注释、是否主键一次取齐（主键与注释是 0 批尾项补的字段）。
+        safe = str(table).replace("'", "''")
+        return (
+            "SELECT c.column_name, c.data_type, c.is_nullable, c.column_default, "
+            "       COALESCE(d.description, ''), "
+            "       COALESCE(k.is_pk, false) "
+            "FROM information_schema.columns c "
+            "JOIN pg_class t ON t.relname = c.table_name "
+            "JOIN pg_namespace n ON n.oid = t.relnamespace "
+            "     AND n.nspname = c.table_schema "
+            "LEFT JOIN pg_description d ON d.objoid = t.oid "
+            "     AND d.objsubid = c.ordinal_position "
+            "LEFT JOIN ( "
+            "  SELECT a.attname, true AS is_pk "
+            "  FROM pg_index i "
+            "  JOIN pg_attribute a ON a.attrelid = i.indrelid "
+            "       AND a.attnum = ANY(i.indkey) "
+            f"  WHERE i.indrelid = '{safe}'::regclass AND i.indisprimary "
+            ") k ON k.attname = c.column_name "
+            f"WHERE c.table_name = '{safe}' "
+            "ORDER BY c.ordinal_position"
+        )
+
+    def map_columns(self, rows) -> list[dict]:
+        return [
+            {
+                "name": r[0],
+                "type": r[1],
+                "null": str(r[2]).upper() == "YES",
+                "default": r[3],
+                "comment": r[4] or "",
+                "pk": bool(r[5]),
+            }
+            for r in rows
+        ]
+
+    def read_indexes(self, cur, table: str) -> list[dict]:
+        safe = str(table).replace("'", "''")
+        cur.execute(
+            "SELECT i.relname, ix.indisunique, a.attname "
+            "FROM pg_index ix "
+            "JOIN pg_class i ON i.oid = ix.indexrelid "
+            "JOIN pg_attribute a ON a.attrelid = ix.indrelid "
+            "     AND a.attnum = ANY(ix.indkey) "
+            f"WHERE ix.indrelid = '{safe}'::regclass "
+            "ORDER BY i.relname, a.attnum"
+        )
+        seen: dict[str, dict] = {}
+        for name, unique, col in cur.fetchall():
+            entry = seen.setdefault(
+                name, {"name": name, "columns": [], "unique": bool(unique)}
+            )
+            entry["columns"].append(col)
+        return list(seen.values())
+
+    def read_create_sql(self, cur, table: str) -> str:
+        # PG 没有 SHOW CREATE TABLE；按列定义合成——有 DDL 才能喂给建模/NL2SQL。
+        cur.execute(self.describe_sql(table))
+        cols = self.map_columns(cur.fetchall())
+        if not cols:
+            return ""
+        lines = [f'CREATE TABLE "{table}" (']
+        for i, c in enumerate(cols):
+            tail = "," if i < len(cols) - 1 else ""
+            nn = "" if c["null"] else " NOT NULL"
+            pk = " PRIMARY KEY" if c["pk"] else ""
+            lines.append(f'  "{c["name"]}" {c["type"]}{nn}{pk}{tail}')
+        lines.append(");")
+        return "\n".join(lines)
+
+
