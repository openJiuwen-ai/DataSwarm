+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/recall.py + model.rrf_fuse 单测（阶段 E：L1 四路召回）。
+
+- rrf_fuse：双路印证压制单路（数学性质）、排名写回、channels 跨通道归并
+- 术语路：glossary resolve 打桩 → 词法(alias/like 档位门槛) + 向量 RRF、
+  deprecated 术语剔除、unavailable 降级
+- 指标路：词法 search_defs + 向量 embedding 打桩、published 限定、门槛过滤
+- schema 路：semantic_link 助手打桩、快照缺席 unavailable
+- 维值路：repository.recall_value_dict 打桩、多源合并
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.analysis import recall as analysis_recall
+from jiuwenswarm.channels.web.dataagent.analysis.model import RecallHit, rrf_fuse
+
+
+# ==========================================================================
+# RRF 融合（打分契约核心）
+# ==========================================================================
+
+def test_rrf_double_channel_beats_single():
+    """双路印证的候选结构性压制单路（零调参）——方案 L1 核心设计。"""
+    hit_a_lex = RecallHit("term", "A", "A", channels=[("lexical", 0.9)], matched_on=["alias"])
+    hit_a_vec = RecallHit("term", "A", "A", channels=[("vector", 0.71)], matched_on=["emb"])
+    hit_b_vec = RecallHit("term", "B", "B", channels=[("vector", 0.68)], matched_on=["emb"])
+    # A 在词法第 1 + 向量第 1（双路印证）；B 仅向量第 2
+    ranked = rrf_fuse({"lexical": [hit_a_lex], "vector": [hit_a_vec, hit_b_vec]})
+    assert ranked[0].entity_id == "A"
+    # A = 1/61 + 1/61 ≈ 0.0328；B = 1/62 ≈ 0.0161 —— 领先翻倍
+    assert ranked[0].rrf_score == pytest.approx(2 / 61, rel=1e-6)
+    assert ranked[1].rrf_score == pytest.approx(1 / 62, rel=1e-6)
+    assert [h.rank for h in ranked] == [1, 2]
+    # 跨通道 channels 归并（原始分保留）
+    assert dict(ranked[0].channels) == {"lexical": 0.9, "vector": 0.71}
+
+
+def test_rrf_empty_and_unknown_floor():
+    assert rrf_fuse({}) == []
+    hit = RecallHit("term", "X", "X", channels=[("lexical", 1.0)], matched_on=["alias"])
+    ranked = rrf_fuse({"lexical": [hit]})
+    assert ranked[0].rrf_score == pytest.approx(1 / 61, rel=1e-6)
+
+
+# ==========================================================================
+# 术语路
+# ==========================================================================
+
+def _term(term_id: str, name: str, *, status: str = "active") -> dict:
+    return {"term_id": term_id, "name": name, "definition": f"{name}的定义",
+            "synonyms_list": [], "status": status, "updated_at": "2026-10-01"}
+
+
+def test_terms_road_lexical_and_vector_rrf(monkeypatch):
+    from jiuwenswarm.channels.web.dataagent.glossary import recall as glossary_recall
+
+    monkeypatch.setattr(glossary_recall, "resolve", lambda q, limit=10: {
+        "query": q, "degraded": False, "query_vectors": [],
+        "matches": [
+            {"term": _term("t1", "商品交易总额"), "score": 1.0, "match_type": "alias",
+             "scores": {"alias": 1.0, "vector": 0.71, "like": 0.9}},
+            {"term": _term("t2", "退款金额"), "score": 0.68, "match_type": "vector",
+             "scores": {"alias": 0.0, "vector": 0.68, "like": 0.0}},
+            # definition 档 0.25 —— 低于词法门槛 0.7，不参与融合
+            {"term": _term("t3", "长尾术语"), "score": 0.25, "match_type": "like",
+             "scores": {"alias": 0.0, "vector": 0.0, "like": 0.25}},
+            # deprecated 不入范围
+            {"term": _term("t4", "已废弃"), "score": 1.0, "match_type": "alias",
+             "scores": {"alias": 1.0, "vector": 0.0, "like": 0.0}, "term_status": "deprecated"},
+        ],
+        "warnings": [],
+    })
+    # t4 的 status 在 term dict 里——resolve 桩直接给出（status=deprecated 由 term dict 表达）
+    road = analysis_recall._recall_terms("流水")
+    ids = [hit.entity_id for hit in road.hits]
+    assert "t1" in ids and "t2" in ids
+    assert "t3" not in ids          # definition 档被门槛拦下
+    assert road.hits[0].entity_id == "t1"
+    assert road.channel_status == "ok"
+
+
