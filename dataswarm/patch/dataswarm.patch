+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""开放分析计划、证据账本和报告门禁的纯函数。
+
+该模块不执行 SQL，也不调用模型。它只把开放分析的产品契约落成可测试的
+结构化边界，供 ``plan.py``、``analysis_flow.py`` 和 dw-report 复用。
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+from typing import Any
+
+OPEN_MAX_COMPONENTS = 8
+OPEN_MAX_FACETS = 4
+OPEN_MIN_CORE_COMPONENTS = 2
+# closed 计划成分上限（open 用 OPEN_MAX_COMPONENTS）——plan.py 与
+# analysis_flow.py 从此单源引用，不得另抄数字
+CLOSED_MAX_COMPONENTS = 5
+
+# budget 上限（plan 校验口径）。skill 侧 analysis_flow 的运行时兜底值
+# （MAX_SQL_COUNT / MAX_TOOL_CALLS / MAX_EXPLORE_ROUNDS*）与此同值，
+# 防漂移测试锁定；deadline_ms 与脚本 deadline 兜底同值。
+BUDGET_CAPS = {
+    "max_components": OPEN_MAX_COMPONENTS,
+    "max_sql": 15,
+    "max_explore_rounds_required": 3,
+    "max_explore_rounds_optional": 1,
+    "max_tool_calls": 30,
+    "parallelism": 2,
+    "deadline_ms": 90000,
+}
+
+
+def _is_strict_int(value: Any) -> bool:
+    """严格整数判定（G.TYP.08 isinstance 口径；bool 是 int 子类，显式排除）。"""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def normalize_open_plan(payload: dict[str, Any]) -> dict[str, Any]:
+    """补全开放分析计划默认值，并返回不修改输入的新字典。"""
+    plan = dict(payload)
+    mode = str(plan.get("mode") or "closed").lower()
+    plan["mode"] = mode
+    components: list[dict[str, Any]] = []
+    for raw in plan.get("components") or []:
+        if not isinstance(raw, dict):
+            continue
+        item = dict(raw)
+        role = str(item.get("role") or ("facet" if item.get("facet_id") else "core"))
+        item["role"] = role
+        item["required"] = bool(item.get("required", role == "core"))
+        try:
+            item["priority"] = int(item.get("priority", 100 if role == "core" else 50))
+        except (TypeError, ValueError):
+            item["priority"] = 50
+        item["facet_id"] = str(item.get("facet_id") or "")
+        item["evidence_requirement"] = str(
+            item.get("evidence_requirement") or "authoritative_or_qualified")
+        item["material_refs"] = [str(ref) for ref in item.get("material_refs") or ()]
+        components.append(item)
+    plan["components"] = components
+    facets: list[dict[str, Any]] = []
+    for raw in plan.get("facets") or []:
+        if not isinstance(raw, dict):
+            continue
+        facet = dict(raw)
+        facet["facet_id"] = str(facet.get("facet_id") or "")
+        facet["label"] = str(facet.get("label") or facet["facet_id"])
+        facet["priority"] = int(facet.get("priority", 50))
+        facet["required"] = bool(facet.get("required", False))
+        facet["component_ids"] = [str(x) for x in facet.get("component_ids") or ()]
+        facet["material_refs"] = [str(x) for x in facet.get("material_refs") or ()]
+        facet["evidence_requirement"] = str(
+            facet.get("evidence_requirement") or "one_result_plus_quality_checks")
+        facets.append(facet)
+    plan["facets"] = facets
+    plan.setdefault("coverage", {})
+    plan.setdefault("budget", {})
+    return plan
+
+
+def validate_open_plan(
+    payload: dict[str, Any],
+    *,
+    material_ids: set[str] | None = None,
+) -> list[dict[str, str]]:
+    """校验开放分析特有门禁；普通 QueryPlan 规则仍由 ``plan.py`` 负责。"""
+    shape_errors: list[dict[str, str]] = []
+    for field in ("components", "facets"):
+        raw_items = payload.get(field, [])
+        if not isinstance(raw_items, list) or any(not isinstance(item, dict) for item in raw_items):
+            shape_errors.append({"field": field, "message": f"{field} 必须是对象数组"})
+            continue
+        for raw in raw_items:
+            for list_field in ("material_refs", "component_ids", "selected_metrics", "derived_metrics",
+                               "dimensions", "depends_on"):
+                if list_field in raw and (not isinstance(raw[list_field], list)
+                                          or any(not isinstance(x, str) for x in raw[list_field])):
+                    shape_errors.append({"field": f"{field}.{list_field}", "message": "必须是字符串数组"})
+            if field == "components" and "filters" in raw and (
+                    not isinstance(raw["filters"], list)
+                    or any(not isinstance(x, dict) for x in raw["filters"])):
+                shape_errors.append({"field": "filters", "message": "filters 必须是对象数组"})
+            if "required" in raw and not isinstance(raw["required"], bool):
+                shape_errors.append({"field": f"{field}.required", "message": "required 必须是布尔值"})
+            if "priority" in raw and (not _is_strict_int(raw["priority"]) or not 0 <= raw["priority"] <= 100):
+                shape_errors.append({"field": f"{field}.priority", "message": "priority 必须是 0–100 的整数"})
+    for field in ("coverage", "budget"):
+        if field in payload and not isinstance(payload[field], dict):
+            shape_errors.append({"field": field, "message": f"{field} 必须是对象"})
+    if shape_errors:
+        return shape_errors
+    plan = normalize_open_plan(payload)
+    mode = plan["mode"]
+    errors: list[dict[str, str]] = []
+    if mode not in {"closed", "open"}:
+        errors.append({"field": "mode", "message": "mode 只能是 closed 或 open"})
+        return errors
+    components = plan["components"]
+    max_components = OPEN_MAX_COMPONENTS if mode == "open" else CLOSED_MAX_COMPONENTS
+    if len(components) > max_components:
+        errors.append({"field": "components", "message": f"{mode} 模式 component 数超上限 {max_components}"})
+    ids = {str(item.get("component_id") or "") for item in components}
+    for item in components:
+        cid = str(item.get("component_id") or "")
+        if not re.fullmatch(r"[A-Za-z0-9_-]+", cid):
+            errors.append({"component_id": cid, "field": "component_id",
+                           "message": "component_id 只能包含字母、数字、下划线、短横线"})
+        role = item["role"]
+        if role not in {"core", "facet"}:
+            errors.append({"component_id": cid, "field": "role", "message": "role 只能是 core 或 facet"})
+        if role == "facet" and not item["facet_id"]:
+            errors.append({"component_id": cid, "field": "facet_id", "message": "facet 成分必须关联 facet_id"})
+        if role == "core" and item["facet_id"]:
+            errors.append({"component_id": cid, "field": "facet_id", "message": "core 成分不能挂到侧面下"})
+        if mode == "open":
+            if role == "core" and not item["required"]:
+                errors.append({"component_id": cid, "field": "required", "message": "core 成分必须 required=true"})
+            if not item["material_refs"]:
+                errors.append({"component_id": cid, "field": "material_refs",
+                               "message": "开放分析成分必须引用候选素材"})
+            if not str(item.get("output") or "").strip():
+                errors.append({"component_id": cid, "field": "output", "message": "必须声明输出粒度与单位"})
+            for key in [*(item.get("selected_metrics") or []), *(item.get("derived_metrics") or [])]:
+                if f"metric:{key}" not in item["material_refs"]:
+                    errors.append({"component_id": cid, "field": "material_refs",
+                                   "message": f"缺少指标素材引用 metric:{key}"})
+        for ref in item["material_refs"]:
+            if material_ids is not None and ref not in material_ids:
+                errors.append({"component_id": cid, "field": "material_refs", "message": f"素材 {ref} 不在候选池"})
+    if mode == "open":
+        core = [item for item in components if item["role"] == "core" and item["required"]]
+        if len(core) < OPEN_MIN_CORE_COMPONENTS:
+            errors.append({"field": "components", "message": "开放分析至少需要 2 个 required core 成分"})
+        if len(components) < 3 and not payload.get("uncovered"):
+            errors.append({"field": "components", "message": "开放分析至少 3 个成分；素材不足须通过 uncovered 声明"})
+        if sum(item["required"] for item in components) > 4:
+            errors.append({"field": "required", "message": "required 成分最多 4 个"})
+        if len(plan["facets"]) > OPEN_MAX_FACETS:
+            errors.append({"field": "facets", "message": f"optional facet 数不能超过 {OPEN_MAX_FACETS}"})
+    facet_ids = {facet["facet_id"] for facet in plan["facets"]}
+    if len(facet_ids) != len(plan["facets"]):
+        errors.append({"field": "facets.facet_id", "message": "facet_id 重复"})
+    for facet in plan["facets"]:
+        fid = facet["facet_id"]
+        if not fid:
+            errors.append({"field": "facets.facet_id", "message": "facet_id 不能为空"})
+        if not facet["component_ids"] or not facet["material_refs"] or not 1 <= len(facet["label"]) <= 60:
+            errors.append({"field": "facets", "message": "facet 必须有 1–60 字标签、成分引用和素材引用"})
+        for cid in facet["component_ids"]:
+            if cid not in ids:
+                errors.append({"field": "facets.component_ids", "message": f"facet {fid} 引用了不存在的成分 {cid}"})
+            else:
+                component = next(c for c in components if c.get("component_id") == cid)
+                if component["facet_id"] != fid or component["required"] != facet["required"]:
+                    errors.append({"field": "facets.component_ids",
+                                   "message": f"facet {fid} 与成分 {cid} 的归属/required 不一致"})
+        for ref in facet["material_refs"]:
+            if material_ids is not None and ref not in material_ids:
+                errors.append({"field": "facets.material_refs", "message": f"素材 {ref} 不在候选池"})
+    for item in components:
+        if item["facet_id"] and item["facet_id"] not in facet_ids:
+            errors.append({"component_id": str(item.get("component_id") or ""),
+                           "field": "facet_id", "message": f"facet {item['facet_id']} 未定义"})
+        if item["facet_id"] in facet_ids:
+            facet = next(f for f in plan["facets"] if f["facet_id"] == item["facet_id"])
+            if item.get("component_id") not in facet["component_ids"]:
+                errors.append({"field": "facets.component_ids", "message": "成分与 facet 必须双向关联"})
+        if item["required"]:
+            optional_ids = {c.get("component_id") for c in components if not c["required"]}
+            if optional_ids.intersection(item.get("depends_on") or []):
+                errors.append({"field": "depends_on", "message": "required 成分不能依赖 optional 成分"})
+    for key, value in plan["budget"].items():
+        if key not in BUDGET_CAPS or not _is_strict_int(value) or not 1 <= value <= BUDGET_CAPS[key]:
+            errors.append({"field": f"budget.{key}", "message": "预算项无效或超过系统上限"})
+    requested_cap = plan["budget"].get("max_components", max_components)
+    if _is_strict_int(requested_cap) and len(components) > requested_cap:
+        errors.append({"field": "budget.max_components", "message": "成分数超过请求预算"})
+    return errors
+
+
+def evidence_record(
+    *,
+    evidence_id: str,
+    component_id: str,
+    attempt: dict[str, Any],
+    semantic_versions: dict[str, Any] | None = None,
+    checks: list[dict[str, Any]] | None = None,
+) -> dict[str, Any]:
+    """从一次执行 attempt 生成可被报告引用的 EvidenceRecord。"""
+    checks = list(checks or attempt.get("result_checks") or ())
+    quality = "unknown" if not checks else "pass"
+    if any(c.get("status") == "fail" for c in checks) or attempt.get("truncated"):
+        quality = "fail"
+    elif any(c.get("status") != "pass" for c in checks):
+        quality = "qualified"
+    return {
+        "evidence_id": evidence_id,
+        "component_id": component_id,
+        "kind": "result",
+        "artifact": attempt.get("csv_path") or "",
+        "sql_hash": attempt.get("sql_hash") or "",
+        "sql": attempt.get("sql") or "",
+        "artifact_hash": attempt.get("artifact_hash") or "",
+        "source_id": attempt.get("source_id") or "",
+        "metric_refs": list(attempt.get("metric_refs") or []),
+        "time": attempt.get("time"),
+        "dimensions": list(attempt.get("dimensions") or []),
+        "release_id": attempt.get("release_id") or (semantic_versions or {}).get("release_id", ""),
+        "schema_snapshot_ids": list((semantic_versions or {}).get("snapshots") or ()),
+        "row_count": attempt.get("row_count"),
+        "truncated": bool(attempt.get("truncated")),
+        "grounding_level": attempt.get("grounding_level") or "G3",
+        "authoritative": bool(attempt.get("authoritative", False)),
+        "query_semantics_verified": bool(attempt.get("query_semantics_verified", False)),
+        "non_authoritative_reasons": list(attempt.get("non_authoritative_reasons") or ()),
+        "checks": checks,
+        "quality": {"status": quality,
+                    "unknown_checks": [c.get("name") for c in checks if c.get("status") == "unknown"]},
+        "limitations": ["结果被截断"] if attempt.get("truncated") else [],
+    }
+
+
+def is_usable_evidence(
+    item: dict[str, Any], *, planned_ids: set[str], states: dict[str, Any]
+) -> bool:
+    """「证据当前可用」的唯一判定口径——报告门禁与追踪页摘要（trace_summary）共用。
+
+    六条件：质量 pass/qualified、成分在计划内、无 fail 检查、成分状态 done、
+    组件 evidence_id 指针指向该证据、未截断。两处消费一旦分叉，列表页
+    摘要与报告门禁会互相矛盾。
+    """
+    component_id = str(item.get("component_id") or "")
+    state = states.get(component_id, {})
+    return bool(
+        item.get("quality", {}).get("status") in {"pass", "qualified"}
+        and component_id in planned_ids
+        and not any(c.get("status") == "fail" for c in item.get("checks") or [])
+        and state.get("status") == "done"
+        and state.get("evidence_id") == item.get("evidence_id")
+        and not item.get("truncated")
+    )
+
+
+def report_gate(spec: dict[str, Any], manifest: dict[str, Any]) -> dict[str, Any]:
+    """校验报告引用、结果质量与核心覆盖；不将引用验证冒充因果/内容证明。"""
+    errors: list[str] = []
+    plan = manifest.get("plan") or {}
+    if plan.get("mode") != "open" or spec.get("analysis_id") != manifest.get("analysis_id"):
+        errors.append("报告必须关联同一个开放分析 manifest")
+    evidence = {item["evidence_id"]: item for item in manifest.get("evidence") or []}
+    states = manifest.get("components") or {}
+    planned_ids = {c["component_id"] for c in plan.get("components") or []}
+    usable = {eid: item for eid, item in evidence.items()
+              if is_usable_evidence(item, planned_ids=planned_ids, states=states)}
+    refs_used: set[str] = set()
+    for field in ("sections", "kpis", "summary", "insights", "actions"):
+        if not isinstance(spec.get(field, []), list):
+            errors.append(f"{field} 必须是数组")
+            continue
+        for index, item in enumerate(spec.get(field) or []):
+            if not isinstance(item, dict):
+                errors.append(f"{field}[{index}] 必须是含 evidence_refs 的对象")
+                continue
+            refs = item.get("evidence_refs")
+            if not isinstance(refs, list) or not refs or any(not isinstance(ref, str) for ref in refs):
+                errors.append(f"{field}[{index}] 缺少合法 evidence_refs")
+                continue
+            refs_used.update(refs)
+            # F-031：重编译会刷新组件的 evidence_id 指针，spec 引用旧 eid 时
+            # 附上当前值——否则模型只能盲猜「不可用」的原因直到超时
+            # （open-analysis-full-fix ck-27 思考链：模型怀疑图表校验/证据
+            # 本身做二分诊断，方向全错）。
+            for ref in refs:
+                if ref in usable:
+                    continue
+                hit = evidence.get(ref)
+                if hit is None:
+                    # 形态笔误（连字符/下划线互串）按归一化找回：LLM 逐字引用
+                    # 会重建 ID（ck-25：ev-c-total-1 vs ev-c_total-1 七连败，
+                    # 模型反复改 spec 别处从未核对 ID 本身）
+                    norm = ref.replace("-", "_")
+                    fuzzy = next((eid for eid in evidence if eid.replace("-", "_") == norm), None)
+                    if fuzzy is not None:
+                        errors.append(f"{field}[{index}] 引用的证据不可用: {ref}"
+                                      f"（疑似形态笔误，实际 evidence_id 为 {fuzzy}，逐字复制后重过门禁）")
+                        continue
+                comp = str((hit or {}).get("component_id") or "?")
+                current = str(states.get(comp, {}).get("evidence_id") or "")
+                hint = f"（该成分当前证据为 {current}，更新 spec 引用后重过门禁）" if current and current != ref else ""
+                errors.append(f"{field}[{index}] 引用的证据不可用: {ref}{hint}")
+            if field in {"summary", "insights", "actions"} and not str(item.get("text") or "").strip():
+                errors.append(f"{field}[{index}] 缺少 text")
+            if item.get("causal_language") == "causal":
+                errors.append(f"{field}[{index}] 当前描述分析不支持因果证明，只能提出驱动假设")
+            if item.get("causal_language") == "driver_hypothesis" and not item.get("alternative_checked"):
+                errors.append(f"{field}[{index}] 驱动解释必须给出已检验的替代解释")
+    if not spec.get("sections"):
+        errors.append("开放分析报告不能没有 sections")
+    covered = {usable[ref]["component_id"] for ref in refs_used if ref in usable}
+    required = {c["component_id"] for c in plan.get("components") or [] if c.get("required", True)}
+    missing = sorted(required - covered)
+    unfinished = [cid for cid in planned_ids if states.get(cid, {}).get("status") != "done"]
+    status = "partial" if missing or unfinished or manifest.get("uncovered") or plan.get("uncovered") else "completed"
+    if missing and spec.get("status") != "partial":
+        errors.append("核心证据不完整，必须显式 status=partial")
+    if not refs_used:
+        errors.append("报告没有可引用证据")
+    return {"ok": not errors, "errors": errors, "evidence_count": len(refs_used),
+            "status": status, "missing_required": missing,
+            "coverage": {"required": len(required), "covered": len(required & covered)},
+            "facets": [{"facet_id": f["facet_id"], "label": f["label"],
+                        "completed": all(states.get(cid, {}).get("status") == "done" for cid in f["component_ids"])}
+                       for f in plan.get("facets") or []]}
+
+
+def file_hash(path: Path) -> str:
+    """计算结果快照内容摘要，供报告阶段防止读取被覆盖的结果文件。"""
+    return hashlib.sha256(path.read_bytes()).hexdigest()
