+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/bindings.py —— 绑定（dw_metric_bindings）CRUD 与数据源重绑（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _exec,
+    _fetch_dicts,
+    _now,
+)
+
+from ..model import (
+    Binding,
+    canonical_json,
+)
+from ._db import _commit_if_own, _conn_or, _parse_json_dict, _write_lock
+
+
+# ==========================================================================
+# dw_metric_bindings —— 物理绑定
+# ==========================================================================
+def create_binding(binding: Binding, *, conn: Any = None) -> Binding:
+    """写入一条绑定。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_bindings (binding_id, revision_id, workspace_id,"
+                " datasource_alias, datasource_ref, source_table, column_map_json,"
+                " verify_status, verify_detail, verified_at, created_at)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (binding.binding_id, binding.revision_id, binding.workspace_id,
+                 binding.datasource_alias, binding.datasource_ref, binding.source_table,
+                 canonical_json(dict(binding.column_map)), binding.verify_status,
+                 binding.verify_detail, binding.verified_at, binding.created_at),
+            )
+            _commit_if_own(c, own)
+        return binding
+    finally:
+        if own:
+            c.close()
+
+
+def _row_to_binding(row: dict) -> Binding:
+    column_map = _parse_json_dict(row.get("column_map_json"))
+    return Binding(
+        binding_id=row["binding_id"],
+        revision_id=row["revision_id"],
+        workspace_id=row["workspace_id"],
+        datasource_alias=row.get("datasource_alias") or "",
+        datasource_ref=row.get("datasource_ref") or "",
+        source_table=row.get("source_table") or "",
+        column_map={str(k): str(v) for k, v in column_map.items()},
+        verify_status=row.get("verify_status") or "unbound",
+        verify_detail=row.get("verify_detail") or "",
+        verified_at=row.get("verified_at") or "",
+        created_at=row.get("created_at") or "",
+    )
+
+
+def list_bindings(revision_id: str, *, conn: Any = None) -> list[Binding]:
+    """列出某修订的绑定。"""
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c, "SELECT * FROM dw_metric_bindings WHERE revision_id = ?", (revision_id,))
+        return [_row_to_binding(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+def update_binding_status(
+    binding_id: str, verify_status: str, *, verify_detail: str = "", conn: Any = None
+) -> None:
+    """更新绑定校验状态；``verified`` 时打时间戳。"""
+    c, own = _conn_or(conn)
+    verified_at = _now() if verify_status == "verified" else None
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_bindings SET verify_status = ?, verify_detail = ?,"
+                " verified_at = ? WHERE binding_id = ?",
+                (verify_status, verify_detail, verified_at, binding_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def rebind_datasource_refs(
+    workspace_id: str, old_ref: str, new_ref: str, *, conn: Any = None
+) -> int:
+    """数据源换绑后级联改写绑定引用：与 ``old_ref`` 物理等价的行统一指向 ``new_ref``。
+
+    数据源编辑换 ref（如 MySQL 迁移 IP）时 workspace 的 business_db_ref 会
+    级联换绑，但历史指标绑定若仍指向旧 ref，metric query 按绑定 ref 做
+    权限校验会以「db_ref is not allowed」被拒——绑定必须跟着源走。
+
+    Args:
+        workspace_id: 工作空间 ID（限定改写范围）。
+        old_ref: 换绑前的数据源 ref。
+        new_ref: 换绑后的数据源 ref。
+        conn: 可选的既有连接。
+
+    Returns:
+        实际改写的绑定行数。
+    """
+    from jiuwenswarm.common.workspace_context import same_physical_ref
+
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c, "SELECT DISTINCT datasource_ref FROM dw_metric_bindings WHERE workspace_id = ?",
+            (workspace_id,))
+        updated = 0
+        with _write_lock:
+            for row in rows:
+                ref = str(row.get("datasource_ref") or "")
+                if not ref or not same_physical_ref(ref, old_ref):
+                    continue
+                cur = _exec(
+                    c,
+                    "UPDATE dw_metric_bindings SET datasource_ref = ?"
+                    " WHERE workspace_id = ? AND datasource_ref = ?",
+                    (new_ref, workspace_id, ref))
+                updated += int(getattr(cur, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return updated
+    finally:
+        if own:
+            c.close()
+
+
+def delete_bindings_for_revision(revision_id: str, *, conn: Any = None) -> int:
+    """删除某修订的全部物理绑定，返回删除行数（指标删除级联用）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_bindings WHERE revision_id = ?", (revision_id,))
+            deleted = int(getattr(cursor, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
