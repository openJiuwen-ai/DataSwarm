+/* 共享滚动表格（数据资产预览/字段、治理异常清单统一视觉）：
+   表头固定在数据滚动区外，表头 40px 灰底、数据行最小 40px、hover 浅灰。 */
+.ui-scroll-table {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  overflow: hidden;
+  border: 1px solid var(--color-border-default);
+  border-radius: 8px;
+  background: var(--color-surface-card);
+}
+
+.ui-scroll-table-head {
+  flex: 0 0 auto;
+  background: var(--color-surface-muted);
+}
+
+.ui-scroll-table-head-viewport {
+  overflow: hidden;
+}
+
+.ui-scroll-table-body {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow: auto;
+  /* 不设 overscroll-behavior:contain —— 在无内部滚动的整页列表里会拦截
+     滚轮的滚动链，导致悬停表格时页面无法滚动；确需阻断时在使用处局部覆盖 */
+}
+
+/* 仅用于列宽测量：保持几何宽度，但对用户不可见、不参与焦点序列 */
+.ui-scroll-table-sizing-head {
+  visibility: hidden;
+}
+
+.ui-scroll-table .ui-scroll-table-sizing-head th {
+  height: 0;
+  padding-top: 0;
+  padding-bottom: 0;
+  border: 0;
+}
+
+.ui-scroll-table-sizing-head th > div {
+  height: 0;
+  overflow: hidden;
+}
+
+.ui-table {
+  width: 100%;
+  /* separate 而非 collapse：双表结构下边框归属明确，不会因滚动丢失 */
+  border-collapse: separate;
+  border-spacing: 0;
+  color: var(--color-text-primary);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.ui-table th,
+.ui-table td {
+  border-bottom: 1px solid var(--color-border-default);
+  text-align: left;
+  vertical-align: middle;
+}
+
+.ui-table th {
+  height: 40px;
+  padding: 0 12px;
+  background: var(--color-surface-muted);
+  color: var(--color-text-secondary);
+  font-weight: 500;
+  white-space: nowrap;
+}
+
+.ui-table td {
+  height: 40px;
+  padding: 6px 12px;
+}
+
+.ui-table tbody tr:last-child td {
+  border-bottom: 0;
+}
+
+.ui-table tbody tr:not(.ui-table-empty-row):hover {
+  background: var(--color-surface-hover);
+}
