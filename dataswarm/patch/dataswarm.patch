@@ -0,0 +1,103 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { ChevronDown, ChevronLeft, ChevronRight } from 'lucide-react';
+import './Pagination.css';
+
+const DEFAULT_PAGE_SIZE_OPTIONS = [10, 20, 50, 100];
+
+/** 页码按钮序列（与高保真一致）：
+ *  总页数 ≤ 8 全显；靠近首页显示 1–6 … 末页；靠近末页对称；中间显示 1 … 当前±1 … 末页 */
+function pageItems(current: number, total: number): Array<number | 'ellipsis-left' | 'ellipsis-right'> {
+  if (total <= 8) return Array.from({ length: total }, (_, i) => i + 1);
+  if (current <= 4) return [...Array.from({ length: 6 }, (_, i) => i + 1), 'ellipsis-right', total];
+  if (current >= total - 3) return [1, 'ellipsis-left', ...Array.from({ length: 6 }, (_, i) => total - 5 + i)];
+  return [1, 'ellipsis-left', current - 1, current, current + 1, 'ellipsis-right', total];
+}
+
+export type PaginationLabels = {
+  /** 总条数文案（调用方完成插值，如「总条数：112」） */
+  total: string;
+  /** 每页条数下拉的无障碍标签 */
+  pageSize: string;
+  previous: string;
+  next: string;
+  /** 生成每个页码按钮的无障碍标签 */
+  page: (page: number) => string;
+  /** 分页导航 landmark 的无障碍标签 */
+  navLabel: string;
+};
+
+export type PaginationProps = {
+  total: number;
+  /** 当前页码（从 1 开始）；超出范围时内部收敛到最近合法页 */
+  page: number;
+  pageSize: number;
+  onPageChange: (page: number) => void;
+  onPageSizeChange: (pageSize: number) => void;
+  labels: PaginationLabels;
+  pageSizeOptions?: readonly number[];
+  loading?: boolean;
+};
+
+/** 统一分页栏：左侧总条数，右侧每页条数下拉 + 页码序列（与高保真一致）。 */
+export function Pagination({
+  total,
+  page,
+  pageSize,
+  onPageChange,
+  onPageSizeChange,
+  labels,
+  pageSizeOptions = DEFAULT_PAGE_SIZE_OPTIONS,
+  loading = false,
+}: PaginationProps) {
+  const pageCount = Math.max(1, Math.ceil(total / pageSize));
+  const current = Math.min(Math.max(1, page), pageCount);
+
+  const goTo = (next: number) => {
+    const target = Math.max(1, Math.min(next, pageCount));
+    if (target === current || loading) return;
+    onPageChange(target);
+  };
+
+  return (
+    <div className="ui-pagination">
+      <span>{labels.total}</span>
+      <nav className="ui-pagination-pager" aria-label={labels.navLabel}>
+        <div className="ui-page-size">
+          <select value={pageSize} onChange={event => onPageSizeChange(Number(event.target.value))} disabled={loading} aria-label={labels.pageSize}>
+            {pageSizeOptions.map(option => (
+              <option key={option} value={option}>
+                {option}
+              </option>
+            ))}
+          </select>
+          <ChevronDown size={14} aria-hidden="true" />
+        </div>
+        <button type="button" className="ui-page-btn" onClick={() => goTo(current - 1)} disabled={current <= 1 || loading} aria-label={labels.previous}>
+          <ChevronLeft size={14} aria-hidden="true" />
+        </button>
+        {pageItems(current, pageCount).map(item =>
+          typeof item === 'number' ? (
+            <button
+              key={item}
+              type="button"
+              className={item === current ? 'ui-page-btn ui-page-btn-current' : 'ui-page-btn'}
+              onClick={() => goTo(item)}
+              disabled={loading}
+              aria-current={item === current ? 'page' : undefined}
+              aria-label={labels.page(item)}
+            >
+              {item}
+            </button>
+          ) : (
+            <span key={item} className="ui-page-ellipsis" aria-hidden="true">
+              …
+            </span>
+          ),
+        )}
+        <button type="button" className="ui-page-btn" onClick={() => goTo(current + 1)} disabled={current >= pageCount || loading} aria-label={labels.next}>
+          <ChevronRight size={14} aria-hidden="true" />
+        </button>
+      </nav>
+    </div>
+  );
+}
