diff --git a/tests/unit_tests/channel/test_web_channel_session_observer_fanout.py b/tests/unit_tests/channel/test_web_channel_session_observer_fanout.py
new file mode 100644
index 000000000..a384a0f68
--- /dev/null
+++ b/tests/unit_tests/channel/test_web_channel_session_observer_fanout.py
@@ -0,0 +1,126 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2025-2026. All rights reserved.
+"""F-074 回归：会话事件除物理寻址的发起方外，须随路投递给观察者连接。
+
+观察者 = 通过携带 session_id 的请求（session.get_metadata 等）完成 re-register
+的连接（_clients_by_key 按 RoutingKey.session_id 入桶）。修复前 send() 的 V2
+分支 delivery.ws_id 命中即只发发起方并 return，旁观运行中会话的客户端收不到
+任何实时事件、会话结束也无补拉触发——视图永久停在打开时刻的快照。
+"""
+
+import asyncio
+import json
+
+from jiuwenswarm.common.schema.message import EventType, Message
+from jiuwenswarm.gateway.channel_manager.base import RobotMessageRouter
+from jiuwenswarm.gateway.channel_manager.web.web_connect import WebChannel, WebChannelConfig
+from jiuwenswarm.gateway.routing.keys import RoutingKey, WebDeliveryTarget
+from jiuwenswarm.gateway.routing.session_sharing import RoutingTarget
+
+
+class _FakeClient:
+    def __init__(self):
+        self.frames = []
+        self.closed = False
+        self.remote_address = ("127.0.0.1", 12345)
+
+    async def send(self, data):
+        self.frames.append(json.loads(data))
+
+
+def _chat_final_msg(session_id: str) -> Message:
+    return Message(
+        id="req-obs-1",
+        type="event",
+        channel_id="web",
+        session_id=session_id,
+        params={},
+        timestamp=0.0,
+        ok=True,
+        payload={
+            "content": "final answer",
+            "session_id": session_id,
+        },
+        event_type=EventType.CHAT_FINAL,
+    )
+
+
+async def _flush_frames(*clients: _FakeClient, rounds: int = 40) -> None:
+    """writer 协程异步送帧，轮询等待所有客户端至少收到内容或超限。"""
+    for _ in range(rounds):
+        if all(client.frames for client in clients):
+            return
+        await asyncio.sleep(0.005)
+
+
+async def _make_channel_with_clients(session_id: str):
+    channel = WebChannel(WebChannelConfig(enabled=True), RobotMessageRouter())
+    driver = _FakeClient()
+    observer = _FakeClient()
+    outsider = _FakeClient()
+
+    rk_driver = RoutingKey(
+        channel_id="web", app_id="default", user_id="u1",
+        session_id=session_id, agent_ref=None,
+    )
+    rk_observer = RoutingKey(
+        channel_id="web", app_id="default", user_id="u1",
+        session_id=session_id, agent_ref=None,
+    )
+    rk_outsider = RoutingKey(
+        channel_id="web", app_id="default", user_id="u1",
+        session_id="sess-other", agent_ref=None,
+    )
+    await channel.register_ws(driver, rk_driver)
+    await channel.register_ws(observer, rk_observer)
+    await channel.register_ws(outsider, rk_outsider)
+    return channel, driver, observer, outsider
+
+
+async def test_chat_event_delivered_to_session_observer_beside_driver():
+    """delivery.ws_id 命中发起方时，同会话观察者也必须收到（F-074 主断言）。"""
+    channel, driver, observer, outsider = await _make_channel_with_clients("sess-obs")
+    try:
+        routing_target = RoutingTarget(
+            intent="godview",
+            routing_keys=[RoutingKey(
+                channel_id="web", app_id="default", user_id="u1",
+                session_id="sess-obs", agent_ref=None,
+            )],
+            member_names=(),
+            delivery=WebDeliveryTarget(channel_id="web", ws_id=driver._jiuwen_ws_id),
+        )
+        await channel.send(_chat_final_msg("sess-obs"), routing_target=routing_target)
+
+        await _flush_frames(driver, observer)
+        assert len(driver.frames) == 1, "发起方应恰好收到一帧（不因会话桶双收）"
+        assert len(observer.frames) == 1, "同会话观察者应随路收到事件（F-074）"
+        assert outsider.frames == [], "异会话连接不得收到"
+        assert driver.frames[0]["event"] == "chat.final"
+        assert observer.frames[0] == driver.frames[0], "观察者与发起方收到同一帧"
+    finally:
+        await channel.unregister_ws(driver)
+        await channel.unregister_ws(observer)
+        await channel.unregister_ws(outsider)
+
+
+async def test_chat_event_reaches_observer_when_driver_ws_gone():
+    """发起方连接已断（delivery 落空）时，观察者仍按会话键收到事件。"""
+    channel, driver, observer, outsider = await _make_channel_with_clients("sess-obs")
+    try:
+        driver.closed = True
+        routing_target = RoutingTarget(
+            intent="godview",
+            routing_keys=[],
+            member_names=(),
+            delivery=WebDeliveryTarget(channel_id="web", ws_id=driver._jiuwen_ws_id),
+        )
+        await channel.send(_chat_final_msg("sess-obs"), routing_target=routing_target)
+
+        await _flush_frames(observer)
+        assert len(observer.frames) == 1, "发起方断连后，观察者经会话键兜底收到事件"
+        assert observer.frames[0]["event"] == "chat.final"
+        assert outsider.frames == [], "异会话连接不得收到"
+    finally:
+        await channel.unregister_ws(driver)
+        await channel.unregister_ws(observer)
+        await channel.unregister_ws(outsider)
diff --git a/tests/unit_tests/channels/web/test_http11_protocol.py b/tests/unit_tests/channels/web/test_http11_protocol.py
new file mode 100644
index 000000000..e211f6efe
--- /dev/null
+++ b/tests/unit_tests/channels/web/test_http11_protocol.py
@@ -0,0 +1,177 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""HTTP/1.1 协议切换的端到端行为测试。
+
+起真实 ``_WebServer`` + ``_SpaStaticHandler``，用 ``http.client`` 原生连接验证：
+- 响应行是 HTTP/1.1；
+- keep-alive：同一连接连续多次请求正常复用；
+- 每个响应都带准确 Content-Length（keep-alive 定界前提）；
+- POST 分支未消费 body 的路径（405 等）不会把残留 body 走私成下一请求。
+"""
+from __future__ import annotations
+
+import http.client
+import json
+import socket
+import threading
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web import app_web
+
+
+@pytest.fixture()
+def http11_server(tmp_path: Path):
+    """起一个最小配置的 Web 静态服务器（随机端口）。"""
+    dist = tmp_path / "dist"
+    dist.mkdir()
+    (dist / "index.html").write_text("<html>spa</html>", encoding="utf-8")
+    (dist / "app.js").write_text("console.log(1)", encoding="utf-8")
+
+    host, port = "127.0.0.1", 0
+
+    class _Handler(app_web._SpaStaticHandler):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, directory=str(dist), **kwargs)
+
+        def log_message(self, format, *args):  # noqa: A002
+            pass
+
+        def log_error(self, format, *args):  # noqa: A002
+            pass
+
+    server = app_web._WebServer((host, port), _Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield server
+    finally:
+        server.shutdown()
+        server.server_close()
+
+
+def _connect(server) -> http.client.HTTPConnection:
+    return http.client.HTTPConnection(server.server_address[0], server.server_address[1], timeout=10)
+
+
+def test_response_is_http_1_1(http11_server):
+    conn = _connect(http11_server)
+    try:
+        conn.request("GET", "/")
+        resp = conn.getresponse()
+        assert resp.version == 11  # http.client 内部 11 = HTTP/1.1
+        assert resp.status == 200
+        assert int(resp.getheader("Content-Length")) == len(resp.read())
+    finally:
+        conn.close()
+
+
+def test_keep_alive_reuses_connection(http11_server):
+    conn = _connect(http11_server)
+    try:
+        for _ in range(3):
+            conn.request("GET", "/app.js")
+            resp = conn.getresponse()
+            assert resp.status == 200
+            body = resp.read()
+            assert int(resp.getheader("Content-Length")) == len(body)
+        # 同一连接上再请求 /api/web-config（本地 JSON 端点）
+        conn.request("GET", "/api/web-config")
+        resp = conn.getresponse()
+        assert resp.status == 200
+        payload = json.loads(resp.read())
+        assert "remote" in payload
+    finally:
+        conn.close()
+
+
+def test_spa_fallback_has_content_length(http11_server):
+    conn = _connect(http11_server)
+    try:
+        conn.request("GET", "/data-governance/anything")
+        resp = conn.getresponse()
+        assert resp.status == 200
+        assert int(resp.getheader("Content-Length")) == len(resp.read())
+    finally:
+        conn.close()
+
+
+def test_404_error_response_closes_cleanly(http11_server):
+    # send_error 自带 Connection: close，验证错误路径不会挂死
+    conn = _connect(http11_server)
+    try:
+        conn.request("GET", "/api/inspection/runs/not-exist")
+        resp = conn.getresponse()
+        resp.read()
+        # 无论 200/404，只要能完整读完 body 且连接可正常收尾即可
+        assert resp.version == 11
+    finally:
+        conn.close()
+
+
+def test_unconsumed_post_body_does_not_smuggle(http11_server):
+    # POST 到无本地分支的路径 → 405；带 body 但分支不读 body。
+    # keep-alive 下若未预读 body，残留 body 会被下一请求解析吞掉。
+    conn = _connect(http11_server)
+    try:
+        conn.request("POST", "/no-such-local-route", body=b"x" * 32,
+                     headers={"Content-Type": "application/json"})
+        resp = conn.getresponse()
+        assert resp.status == 405
+        resp.read()
+        # 服务器标记 close_connection（405 send_error 自带 close），新请求换连接
+        conn.request("GET", "/")
+        resp = conn.getresponse()
+        assert resp.status == 200
+        assert int(resp.getheader("Content-Length")) == len(resp.read())
+    finally:
+        conn.close()
+
+
+def test_post_json_then_reuse_connection(http11_server):
+    # 正常 POST（预读 body）后连接应可复用
+    conn = _connect(http11_server)
+    try:
+        body = json.dumps({"workspace_id": "default"}).encode("utf-8")
+        conn.request("POST", "/api/dataagent/workspaces", body=body,
+                     headers={"Content-Type": "application/json",
+                              "Content-Length": str(len(body))})
+        resp = conn.getresponse()
+        resp.read()
+        # workspaces 路由真实存在（create_workspace），此处只验证响应定界完整
+        assert resp.version == 11
+        assert resp.getheader("Content-Length") is not None
+        # 复用同一连接再发 GET
+        conn.request("GET", "/app.js")
+        resp = conn.getresponse()
+        assert resp.status == 200
+        resp.read()
+    finally:
+        conn.close()
+
+
+def test_directory_redirect_has_content_length(http11_server):
+    # SimpleHTTPRequestHandler 目录重定向（301）在 1.1 下由 stdlib 自带 CL: 0
+    conn = _connect(http11_server)
+    try:
+        conn.request("GET", "")
+        resp = conn.getresponse()
+        # 根路径空 request-target 会被拒；用子目录场景验证重定向定界
+        assert resp.version == 11
+        resp.read()
+    except http.client.HTTPException:
+        pytest.skip("空 request-target 行为与协议版本无关")
+    finally:
+        conn.close()
+
+
+def test_idle_keepalive_connection_times_out(http11_server):
+    # timeout=75 太长不好测，直接验证 socket 有超时属性（线程可回收）
+    sock = socket.create_connection(http11_server.server_address, timeout=2)
+    try:
+        sock.sendall(b"GET / HTTP/1.1\r\nHost: x\r\n\r\n")
+        data = sock.recv(65536)
+        assert b"HTTP/1.1 200" in data
+        assert b"Content-Length:" in data
+    finally:
+        sock.close()
