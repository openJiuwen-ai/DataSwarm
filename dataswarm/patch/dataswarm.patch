+class _PreloadedBodyStream:
+    """先吐预读的请求 body，再透传底层连接流。
+
+    keep-alive 防走私预读 body 后替换 handler.rfile 用：对当前请求，
+    read() 先返回预读字节；对连接上的后续请求，readline() 落到底层
+    socket 流（不能换成纯内存 BytesIO——那会让下一请求读到 EOF 直接
+    断连接）。
+    """
+
+    def __init__(self, preloaded: bytes, tail) -> None:
+        self._preloaded = io.BytesIO(preloaded)
+        self._tail = tail
+
+    def read(self, size: int = -1) -> bytes:
+        if size is None or size < 0:
+            head = self._preloaded.read()
+            return head + self._tail.read()
+        head = self._preloaded.read(size)
+        if len(head) < size:
+            head += self._tail.read(size - len(head))
+        return head
+
+    def readline(self, size: int = -1) -> bytes:
+        # 当前请求的 body 不会用 readline；预读缓冲清空后透传给下一请求
+        if self._preloaded.tell() < len(self._preloaded.getvalue()):
+            return self._preloaded.readline(size)
+        return self._tail.readline(size)
+
+    def readinto(self, b) -> int:  # BufferedReader 兼容
+        data = self.read(len(b))
+        b[: len(data)] = data
+        return len(data)
+
+    def readable(self) -> bool:
+        return True
+
+    def close(self) -> None:
+        try:
+            self._preloaded.close()
+        finally:
+            self._tail.close()
+
