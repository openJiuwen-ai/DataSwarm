+    assert ok.get("ok") is True, f"真实 WebHDFS 应连通: {ok}"
+    bad_port = connector_for({**HDFS_CONFIG, "port": 9899}).test_connection()
+    assert bad_port.get("ok") is False, f"错端口应失败: {bad_port}"
+    bad_path = connector_for({**HDFS_CONFIG, "path": "/nope/*.csv"}).test_connection()
