@@ -0,0 +1,124 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Acceptance failures must not send destructive probes to a real fixture."""
+from __future__ import annotations
+
+import ast
+import importlib.util
+from pathlib import Path
+import socket
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors import duckdb_connector as duck
+from jiuwenswarm.channels.web.dataagent.connectors import sqlalchemy_connector as sa
+from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+from jiuwenswarm.common import db_connector as dbc
+
+
+ACCEPTANCE = Path(__file__).resolve().parents[2] / "acceptance" / "datasource"
+SPEC = importlib.util.spec_from_file_location("acceptance_guard_checks", ACCEPTANCE / "guard_checks.py")
+guards = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(guards)
+
+BOUNDARIES = (
+    (sa.SQLAlchemyConnector, "_engine"),
+    (duck.DuckDBConnector, "_connection"),
+    (duck.DuckDBConnector, "_warehouse"),
+    (dbc, "_acquire"),
+    (dbc, "_engine_for"),
+    (dbc, "connect"),
+)
+GATES = (
+    ("batch2", "d_write_rejected", sa),
+    ("batch2", "d_multi_statement_rejected", sa),
+    ("batch8", "s3_guards", duck),
+    ("batch8", "holo_family_and_guards", sa),
+)
+
+
+@pytest.fixture(autouse=True)
+def offline_boundaries(monkeypatch):
+    """Even a broken harness cannot reach a driver or socket during this test."""
+    raw_calls = []
+    for target, attribute in BOUNDARIES:
+        original = Mock(side_effect=AssertionError("Unprotected original I/O boundary"))
+        monkeypatch.setattr(target, attribute, original)
+        raw_calls.append((target, attribute, original))
+    no_socket = Mock(side_effect=AssertionError("Offline test attempted network access"))
+    monkeypatch.setattr(socket.socket, "connect", no_socket)
+    yield raw_calls
+    no_socket.assert_not_called()
+    for target, attribute, original in raw_calls:
+        original.assert_not_called()
+        assert getattr(target, attribute) is original, "A guard patch leaked into later real-service gates"
+
+
+def load_gate_definitions(monkeypatch, batch):
+    """Legacy scripts run real gates at top level; compile definitions only.
+
+    This executes their actual negative-gate bodies without running a service,
+    importing CLI arguments, or invoking any of the independent positive gates.
+    """
+    script = ACCEPTANCE / batch / "verify_gates.py"
+    tree = ast.parse(script.read_text(encoding="utf-8"), filename=str(script))
+    tree.body = [node for node in tree.body if isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef))]
+    monkeypatch.syspath_prepend(str(ACCEPTANCE))
+    namespace = {"__file__": str(script)}
+    exec(compile(tree, str(script), "exec"), namespace)
+    pg = {"host": "fixture.invalid", "port": 55432, "database": "fixture", "user": "u", "password": "p"}
+    namespace.update(PG_CONFIG=pg, HOLO_CONFIG=pg, S3_CONFIG={
+        "location": "s3://acceptance-only/orders.parquet", "format": "parquet", "table_name": "fact_orders",
+    })
+    # Ref round-tripping is an independent metadata assertion, not the subject
+    # of this negative-SQL safety regression. Never load workstation credentials.
+    monkeypatch.setattr(dbc, "parse_db_ref", lambda ref: {"type": "hologres", "port": 80})
+    return namespace
+
+
+@pytest.mark.parametrize("batch,gate,module", GATES, ids=[item[1] for item in GATES])
+def test_real_negative_gate_passes_only_preconnection_validation(monkeypatch, batch, gate, module):
+    namespace = load_gate_definitions(monkeypatch, batch)
+    namespace[gate]()
+
+
+@pytest.mark.parametrize("batch,gate,module", GATES, ids=[item[1] for item in GATES])
+def test_validator_regression_is_a_failed_gate_without_io(monkeypatch, batch, gate, module):
+    namespace = load_gate_definitions(monkeypatch, batch)
+    monkeypatch.setattr(module, "validate_read_only_sql", lambda sql, **kwargs: sql)
+    with pytest.raises(AssertionError, match="Negative SQL reached an I/O boundary"):
+        namespace[gate]()
+
+
+@pytest.mark.parametrize("target,attribute", BOUNDARIES, ids=[item[1] for item in BOUNDARIES])
+def test_all_engine_and_governance_routes_are_fenced(target, attribute):
+    # Exercise each route independently: an already cached engine/warehouse or
+    # a governance ref must be as safe as a newly constructed SQLAlchemy engine.
+    connector = SimpleNamespace(query=lambda sql: getattr(target, attribute)(None))
+    with pytest.raises(AssertionError, match="Negative SQL reached an I/O boundary"):
+        guards.expect_query_rejected(connector, "DROP TABLE fixture", "write")
+
+
+def test_wrapping_the_sentinel_as_validation_error_cannot_pass():
+    def query(sql):
+        try:
+            dbc._acquire("postgresql://fixture.invalid/db")
+        except Exception as exc:
+            raise QueryValidationError("wrapped failure") from exc
+
+    with pytest.raises(AssertionError, match="after an I/O attempt"):
+        guards.expect_query_rejected(SimpleNamespace(query=query), "DROP TABLE fixture", "write")
+
+
+def test_unexpected_driver_error_is_not_a_guard_success():
+    def query(sql):
+        raise RuntimeError("driver failure")
+
+    with pytest.raises(RuntimeError, match="driver failure"):
+        guards.expect_query_rejected(SimpleNamespace(query=query), "DROP TABLE fixture", "write")
+
+
+def test_silent_acceptance_is_not_a_guard_success():
+    with pytest.raises(AssertionError, match="但通过了"):
+        guards.expect_query_rejected(SimpleNamespace(query=lambda sql: {"ok": True}), "DROP TABLE fixture", "write")
