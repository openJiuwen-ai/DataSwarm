+class _ServerCredentialRefCodec(RefCodec):
+    """服务器 ref 解码和凭据解析，供 SQL Server codec 使用。
+
+    统一处理配置与环境补全、meta 标记及完整连接四元组的凭据查找。
+    MySQL/PostgreSQL 保留各自 codec 的解码实现。
+    """
+
+    default_port = 0
+    env_prefix = ""
+    config_section = ""
+
+    @property
+    def section(self) -> str:
+        return self.config_section or self.scheme
+
+    def _extra_spec(self, cfg: dict) -> dict:
+        """子类补充的 spec 字段，例如驱动和认证模式。"""
+        return {}
+
+    def decode(self, rest: str, db_ref: str) -> dict:
+        scheme = self.scheme
+        meta_flag = rest.strip() == "meta"
+        body = "" if meta_flag else rest
+        if not body or "/" not in body:
+            cfg = _read_config_section(self.section)
+            prefix = self.env_prefix
+            host = cfg.get("host") or os.environ.get(f"{prefix}_HOST", "")
+            port = (
+                cfg.get("port")
+                or int(os.environ.get(f"{prefix}_PORT", "0") or 0)
+                or self.default_port
+            )
+            user = cfg.get("user") or os.environ.get(f"{prefix}_USER", "")
+            password = cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", "")
+            if meta_flag:
+                database = cfg.get("metadata_database") or os.environ.get(
+                    f"{prefix}_METADATA_DATABASE", ""
+                )
+                if not database:
+                    raise ValueError(
+                        f"{scheme}://meta 需 config {self.section}.metadata_database "
+                        f"配置元数据库 schema"
+                    )
+            elif body:
+                database = body
+            else:
+                database = cfg.get("database") or os.environ.get(f"{prefix}_DATABASE", "")
+            if not host:
+                raise ValueError(
+                    f"{scheme}:// 需 config {self.section}: 段 或环境变量 "
+                    f"{prefix}_HOST，或完整 db-ref"
+                )
+            return {
+                "type": scheme,
+                "host": host,
+                "port": int(port) if port else self.default_port,
+                "user": user,
+                "password": password,
+                "database": database,
+                "is_metadata": meta_flag,
+                **self._extra_spec(cfg),
+            }
+        host_port, _, db = body.partition("/")
+        host, _, port = host_port.partition(":")
+        resolved_port = int(port) if port else self.default_port
+        spec = {
+            "type": scheme,
+            "host": host,
+            "port": resolved_port,
+            "user": "",
+            "password": "",
+            "database": db,
+            **self._extra_spec(_read_config_section(self.section)),
+        }
+        creds = _lookup_source_credentials(scheme, host, resolved_port, db)
+        if creds:
+            spec.update(creds)
+        return spec
+
+    def _credentials(self, spec: dict) -> tuple[str, str]:
+        """为池化 URL 和直接连接提供一致的凭据补全结果。
+
+        两条连接路径必须使用同一来源，避免直连缺失用户时回退到系统身份。
+        """
+        user = spec.get("user") or ""
+        pwd = spec.get("password") or ""
+        if not user:
+            cfg = _read_config_section(self.section)
+            prefix = self.env_prefix
+            user = cfg.get("user") or os.environ.get(f"{prefix}_USER", "")
+            pwd = cfg.get("password") or os.environ.get(f"{prefix}_PASSWORD", "")
+        return user, pwd
+
+
+@register_ref_codec
+class SqlServerRefCodec(_ServerCredentialRefCodec):
+    """SQL Server 连接与 sys 目录元数据实现。
+
+    pyodbc 依赖系统 ODBC Driver 17/18；标识符使用方括号，注释读取
+    sys.extended_properties，分页使用 OFFSET/FETCH。现有验收覆盖 LocalDB/ODBC 17，
+    未覆盖远端 TCP、SQL 认证或 ODBC 18 TLS。
+    """
+
+    scheme = "sqlserver"
+    dialect = "tsql"
+    default_port = 1433
+    env_prefix = "MSSQL"
+
+    #: ODBC 驱动名；容器镜像里装的是哪个版本就改这里（也可由 config 覆盖）。
+    default_odbc_driver = "ODBC Driver 18 for SQL Server"
+
+    def _extra_spec(self, cfg: dict) -> dict:
+        driver = cfg.get("driver") or os.environ.get("MSSQL_ODBC_DRIVER", "")
+        return {
+            "driver": driver,
+            "trusted_connection": cfg.get("trusted_connection", os.environ.get("MSSQL_TRUSTED_CONNECTION", "")),
+        }
+
+    def engine_url(self, spec: dict, read_only: bool) -> str:
+        from sqlalchemy.engine import URL
+
+        trusted = str(spec.get("trusted_connection", "")).strip().lower() in {"true", "1", "yes"}
+        user, pwd = (None, None) if trusted else self._credentials(spec)
+        host = spec.get("host", "")
+        port = None if "\\" in host else int(spec.get("port") or self.default_port)
+        db = spec.get("database") or ""
+        driver = spec.get("driver") or self.default_odbc_driver
+        url_query = {"driver": driver}
+        if trusted:
+            url_query["Trusted_Connection"] = "yes"
+        if read_only:
+            url_query["ApplicationIntent"] = "ReadOnly"
+        return URL.create(
+            "mssql+pyodbc", username=user, password=pwd, host=host,
+            port=port, database=db, query=url_query,
+        ).render_as_string(hide_password=False)
+
+    def connect_direct(self, spec: dict, read_only: bool):
+        try:
+            import pyodbc
+        except ImportError as exc:
+            raise ImportError(
+                "pyodbc 未安装，请 pip install 'jiuwenswarm[ds-sqlserver]'；"
+                "另需系统安装 Microsoft ODBC Driver 18"
+            ) from exc
+        trusted = str(spec.get("trusted_connection", "")).strip().lower() in {"true", "1", "yes"}
+        user, pwd = ("", "") if trusted else self._credentials(spec)
+        driver = spec.get("driver") or self.default_odbc_driver
+        host = spec.get("host", "")
+        server = host if "\\" in host else f"{host},{int(spec.get('port') or self.default_port)}"
+
+        def odbc_value(value):
+            return "{" + str(value).replace("}", "}}") + "}"
+
+        conn_str = (
+            f"DRIVER={odbc_value(driver)};"
+            f"SERVER={odbc_value(server)};"
+            f"DATABASE={odbc_value(spec.get('database') or '')};"
+        )
+        conn_str += "Trusted_Connection=yes;" if trusted else f"UID={odbc_value(user)};PWD={odbc_value(pwd)};"
+        if read_only:
+            conn_str += "ApplicationIntent=ReadOnly;"
+        conn = pyodbc.connect(conn_str, timeout=10)
+        return conn, {"type": spec["type"], "host": spec.get("host", ""),
+                      "port": int(spec.get("port") or self.default_port),
+                      "user": user, "database": spec.get("database") or "",
+                      "driver": driver}
+
+    def tables_sql(self) -> str:
+        return (
+            "SELECT QUOTENAME(s.name) + '.' + QUOTENAME(t.name) "
+            "FROM sys.tables t JOIN sys.schemas s ON s.schema_id = t.schema_id "
+            "WHERE t.is_ms_shipped = 0 ORDER BY s.name, t.name"
+        )
+
+    def describe_sql(self, table: str) -> str:
+        safe = quoted_table_identifier(table, self.dialect).replace("'", "''")
+        # 注释取 sys.extended_properties 的 MS_Description（T-SQL 无列内 COMMENT）。
+        return (
+            "SELECT c.name, ty.name, c.is_nullable, d.definition, "
+            "COALESCE(CONVERT(nvarchar(max), ep.value), '') AS col_comment, "
+            "CASE WHEN EXISTS (SELECT 1 FROM sys.indexes i "
+            "  JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id "
+            "  WHERE i.object_id = c.object_id AND i.is_primary_key = 1 AND ic.column_id = c.column_id) "
+            "THEN 1 ELSE 0 END AS is_pk, c.max_length, c.precision, c.scale "
+            "FROM sys.columns c JOIN sys.types ty ON ty.user_type_id = c.user_type_id "
+            "LEFT JOIN sys.default_constraints d ON d.object_id = c.default_object_id "
+            "LEFT JOIN sys.extended_properties ep "
+            "  ON ep.class = 1 AND ep.major_id = c.object_id AND ep.minor_id = c.column_id "
+            "  AND ep.name = 'MS_Description' "
+            f"WHERE c.object_id = OBJECT_ID(N'{safe}') "
+            "ORDER BY c.column_id"
+        )
+
+    def map_columns(self, rows) -> list[dict]:
+        return [
+            {
+                "name": r[0],
+                "type": self._column_type(r),
+                "null": r[2] is True or r[2] == 1 or str(r[2]).upper() == "YES",
+                "default": r[3],
+                "comment": (r[4] or "").strip(),
+                "pk": bool(r[5]),
+            }
+            for r in rows
+        ]
+
+    @staticmethod
+    def _column_type(row) -> str:
+        data_type = str(row[1])
+        if len(row) < 9:
+            return data_type
+        max_length, precision, scale = row[6:9]
+        if data_type.lower() in {"varchar", "char", "varbinary", "binary", "nvarchar", "nchar"}:
+            if max_length == -1:
+                length = "max"
+            elif data_type.lower() in {"nvarchar", "nchar"}:
+                length = max_length // 2
+            else:
+                length = max_length
+            return f"{data_type}({length})"
+        if data_type.lower() in {"decimal", "numeric"}:
+            return f"{data_type}({precision},{scale})"
+        if data_type.lower() in {"time", "datetime2", "datetimeoffset"}:
+            return f"{data_type}({scale})"
+        return data_type
+
+    def read_indexes(self, cur, table: str) -> list[dict]:
+        safe = quoted_table_identifier(table, self.dialect).replace("'", "''")
+        cur.execute(
+            "SELECT i.name, i.is_unique, c.name "
+            "FROM sys.indexes i "
+            "JOIN sys.index_columns ic "
+            "  ON ic.object_id = i.object_id AND ic.index_id = i.index_id "
+            "JOIN sys.columns c "
+            "  ON c.object_id = ic.object_id AND c.column_id = ic.column_id "
+            f"WHERE i.object_id = OBJECT_ID(N'{safe}') AND i.name IS NOT NULL "
+            "AND ic.is_included_column = 0 AND ic.key_ordinal > 0 "
+            "ORDER BY i.name, ic.key_ordinal"
+        )
+        seen: dict[str, dict] = {}
+        for name, unique, col in cur.fetchall():
+            entry = seen.setdefault(
+                name, {"name": name, "columns": [], "unique": bool(unique)}
+            )
+            entry["columns"].append(col)
+        return list(seen.values())
+
+    def read_create_sql(self, cur, table: str) -> str:
+        # T-SQL 没有 SHOW CREATE TABLE，按列定义合成。
+        cur.execute(self.describe_sql(table))
+        cols = self.map_columns(cur.fetchall())
+        if not cols:
+            return ""
+        from jiuwenswarm.common.dialect_registry import quote_ident as _quote
+
+        lines = []
+        for c in cols:
+            nn = "" if c["null"] else " NOT NULL"
+            lines.append(f'  {_quote(self.dialect, c["name"])} {c["type"]}{nn}')
+        primary_key = [_quote(self.dialect, c["name"]) for c in cols if c["pk"]]
+        if primary_key:
+            lines.append(f"  PRIMARY KEY ({', '.join(primary_key)})")
+        return f"CREATE TABLE {quoted_table_identifier(table, self.dialect)} (\n" + ",\n".join(lines) + "\n);"
+
+
+@register_ref_codec
+class MongoDbRefCodec(RefCodec):
+    """MongoDB 自管 I/O codec，将集合和采样结构适配为 tables/schema。
+
+    schema 保留 presence 和类型漂移信息，列集可能因采样而不完整。
+    凭据不进入 ref，由保存的配置、mongodb 配置段或环境变量补齐。
+    """
+
+    scheme = "mongodb"
+    dialect = "duckdb"  # 查询跑在物化后的 DuckDB 表上
+    uses_pool = False
+    default_port = 27017
+
+    def decode(self, rest: str, db_ref: str) -> dict:
+        host_port, _, database = rest.partition("/")
+        host, _, port = host_port.partition(":")
+        cfg = _read_config_section(self.scheme)
+        if not database:
+            database = cfg.get("database") or os.environ.get("MONGODB_DATABASE", "")
+        if not database:
+            raise ValueError(
+                "mongodb:// ref 缺少库名，且 config mongodb: 段与 "
+                "MONGODB_DATABASE 均未配置"
+            )
+        return {
+            "type": self.scheme,
+            "host": host or cfg.get("host") or "127.0.0.1",
+            "port": int(port) if port else (cfg.get("port") or self.default_port),
+            "database": database,
+            "user": cfg.get("user") or os.environ.get("MONGODB_USER", ""),
+            "password": cfg.get("password") or os.environ.get("MONGODB_PASSWORD", ""),
+        }
+
+    def _connector(self, spec: dict):
+        from jiuwenswarm.channels.web.dataagent.connectors.base import (
+            SourceDefinition,
+            get_engine,
+        )
+
+        source = SourceDefinition(
+            source_id=f"ref:mongodb://{spec.get('host')}/{spec.get('database')}",
+            source_type=self.scheme,
+            name=spec.get("database") or "mongodb",
+            engine="sampled",
+            config=spec.get("_source_config") if spec.get("_source_config") is not None else {
+                "host": spec.get("host"),
+                "port": spec.get("port"),
+                "database": spec.get("database"),
+                "user": spec.get("user") or "",
+                "password": spec.get("password") or "",
+            },
+        )
+        return get_engine("sampled")(source)
+
+    def query(self, spec: dict, sql: str, params=None, limit: int = 100) -> dict:
+        connector = self._connector(spec)
+        try:
+            return connector.query(sql, params=params, limit=limit)
+        finally:
+            connector.close()
+
+    def meta(self, spec: dict) -> dict:
+        return {
+            "type": self.scheme,
+            "host": spec.get("host"),
+            "port": spec.get("port"),
+            "database": spec.get("database"),
+        }
+
+    def list_tables(self, spec: dict) -> dict:
+        connector = self._connector(spec)
+        try:
+            names = [d["name"] for d in connector.catalog()["datasets"]]
+            return {"tables": names, "table_count": len(names), "db": self.meta(spec)}
+        finally:
+            connector.close()
+
+    def describe(self, spec: dict, table: str) -> dict:
+        connector = self._connector(spec)
+        try:
+            result = connector.schema(table)
+            return {
+                "table": table,
+                "columns": [
+                    {
+                        "name": c["name"],
+                        "type": c["type"],
+                        "null": c.get("nullable", True),
+                        "pk": bool(c.get("pk")),
+                        "comment": c.get("comment") or "",
+                    }
+                    for c in result["columns"]
+                ],
+                "db": self.meta(spec),
+            }
+        finally:
+            connector.close()
+
+
+class _DelegatingRefCodec(RefCodec):
+    """将治理端口委托给指定执行引擎的自管 I/O codec。
+
+    子类声明 scheme、dialect、目标引擎和默认端口，并实现 decode。
+    """
+
+    uses_pool = False
+    #: 委托给哪个执行引擎（base.register_engine 注册的名字）。
+    target_engine = ""
+    default_port = 0
+
+    def _config_from_spec(self, spec: dict) -> dict:
+        """spec → 执行引擎的 config。子类按各自字段覆写。"""
+        if spec.get("_source_config") is not None:
+            return dict(spec["_source_config"])
+        return {k: v for k, v in spec.items() if k != "type" and not k.startswith("_")}
+
+    def _connector(self, spec: dict):
+        from jiuwenswarm.channels.web.dataagent.connectors.base import (
+            SourceDefinition,
+            get_engine,
+        )
+
+        source = SourceDefinition(
+            source_id=f"ref:{self.scheme}:{spec.get('database') or spec.get('host') or ''}",
+            source_type=self.scheme,
+            name=self.scheme,
+            engine=self.target_engine,
+            config=self._config_from_spec(spec),
+        )
+        return get_engine(self.target_engine)(source)
+
+    def meta(self, spec: dict) -> dict:
+        values = {**spec, **(spec.get("_source_config") or {})}
+        safe_keys = ("host", "port", "db", "database", "location", "fingerprint")
+        return {"type": spec["type"], **{k: values[k] for k in safe_keys if k in values}}
+
+    def query(self, spec: dict, sql: str, params=None, limit: int = 100) -> dict:
+        connector = self._connector(spec)
+        try:
+            return connector.query(sql, params=params, limit=limit)
+        finally:
+            connector.close()
+
+    def list_tables(self, spec: dict) -> dict:
+        connector = self._connector(spec)
+        try:
+            names = [d["name"] for d in connector.catalog()["datasets"]]
+            return {"tables": names, "table_count": len(names), "db": self.meta(spec)}
+        finally:
+            connector.close()
+
+    def describe(self, spec: dict, table: str) -> dict:
+        connector = self._connector(spec)
+        try:
+            result = connector.schema(table)
+            return {
+                "table": table,
+                "columns": [
+                    {
+                        "name": c["name"],
+                        "type": c["type"],
+                        "null": c.get("nullable", True),
+                        "pk": bool(c.get("pk")),
+                        "comment": c.get("comment") or "",
+                    }
+                    for c in result["columns"]
+                ],
+                "db": self.meta(spec),
+            }
+        finally:
+            connector.close()
+
