+/* ---- 全局数据源工作空间上下文栏（多工作空间 P2-5）---- */
+.ws-context-bar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 6px 16px;
+  border-bottom: 1px solid var(--gov-line, rgba(148, 163, 184, 0.2));
+  color: var(--color-text-secondary, #64748b);
+  font-size: 12px;
+  flex-shrink: 0;
+}
+
+.ws-context-bar__label {
+  color: var(--color-text-tertiary, #94a3b8);
+}
+
+.ws-context-bar__trigger {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 3px 10px;
+  border: 1px solid var(--gov-line, rgba(148, 163, 184, 0.25));
+  border-radius: 8px;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+  font-size: 12px;
+  max-width: 480px;
+}
+
+.ws-context-bar__trigger:hover,
+.ws-context-bar__trigger.is-open {
+  background: rgba(37, 99, 235, 0.06);
+}
+
+.ws-context-bar__name {
+  font-weight: 600;
+  color: var(--color-text-primary, #1e293b);
+  white-space: nowrap;
+}
+
+.ws-context-bar__summary {
+  color: var(--color-text-tertiary, #94a3b8);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ws-context-bar__menu {
+  min-width: 240px;
+  max-width: 320px;
+  padding: 4px;
+  max-height: 320px;
+  overflow-y: auto;
+}
 input[type="password"]::-ms-reveal {
   display: none;
-}
\ No newline at end of file
+}
+
+/* 知识派生全局公告框（绑定/换库触发后台任务，跨页展示进度） */
+.kd-banner {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 0 0 12px;
+  padding: 8px 12px;
+  border: 1px solid var(--color-border);
+  border-radius: 8px;
+  background: var(--color-panel);
+  font-size: 12px;
+  color: var(--color-text);
+}
+.kd-banner[data-status='running'] { border-color: var(--color-primary-border, var(--color-border)); }
+.kd-banner[data-status='complete'] { border-color: var(--color-feedback-success); }
+.kd-banner[data-status='failed'],
+.kd-banner[data-status='timeout'] { border-color: var(--color-feedback-danger); }
+.kd-banner[data-status='cancelled'] { border-color: var(--color-feedback-warning, var(--color-border)); }
+.kd-banner-text { flex: 1; min-width: 0; line-height: 1.5; }
+.kd-banner-link {
+  border: none;
+  background: none;
+  padding: 0;
+  color: var(--color-text-link);
+  font-size: 12px;
+  cursor: pointer;
+  text-decoration: underline;
+  white-space: nowrap;
+}
+.kd-banner-link:disabled { color: var(--color-text-muted); cursor: default; text-decoration: none; }
+.kd-banner-close {
+  border: none;
+  background: none;
+  padding: 2px;
+  color: var(--color-text-muted);
+  cursor: pointer;
+  border-radius: 4px;
+  display: inline-flex;
+}
+.kd-banner-close:hover { color: var(--color-text); background: var(--color-hover, rgba(127, 127, 127, 0.12)); }
