+    assert [n["node_id"] for n in saved] == ["a", saved[1]["node_id"]]
+    assert saved[1]["node_id"].startswith("node_")
+    assert saved[1]["upstream_nodes"] == "a"  # 空白/空项归一
+    assert saved[1]["node_name"] == "n2"
+    # 再次整体替换：旧节点被清掉，node_id 稳定保留
+    saved2 = orch_db.replace_nodes(wf["workflow_id"], [
