+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dwcli 方言判定单测：duckdb/doris/mysql/sqlite 四判定 + biz_database 推导。
+
+覆盖 _local_datasource_current 的方言链（duckdb:// 前缀 → dialect=duckdb，
+biz_database 取 location stem 而非 rsplit query 串）。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from unittest.mock import patch
+
+import jiuwenswarm.cli.dwcli as dwcli
+from jiuwenswarm.common import workspace_context
+
+
+@dataclass
+class _FakeCtx:
+    workspace_id: str = "ws-test"
+    business_db_ref: str = ""
+    metadata_db_ref: str = "sqlite://meta.db"
+
+
+def _current(ref: str) -> dict:
+    with patch.object(workspace_context, "resolve", return_value=_FakeCtx(business_db_ref=ref)), \
+         patch.object(workspace_context, "normalize_db_ref", side_effect=lambda r: r):
+        return dwcli._local_datasource_current("ws-test")
+
+
+def test_duckdb_single_file_dialect_and_biz_database():
+    ref = "duckdb://D:/bank/bank-full.csv?source_type=csv&table_name=bank_full"
+    result = _current(ref)
+    assert result["dialect"] == "duckdb"
+    assert result["biz_database"] == "bank-full"
+
+
+def test_duckdb_directory_source():
+    ref = "duckdb://D:/data/sales%20dir?source_type=csv&table_name=x"
+    result = _current(ref)
+    assert result["dialect"] == "duckdb"
+    # location 是 URL 解码后的本地路径，stem 取目录名
+    assert result["biz_database"] in ("sales dir", "sales%20dir")
+
+
+def test_duckdb_excel_source_dialect():
+    ref = "duckdb://D:/bank_1?source_type=excel&table_name=bank_1"
+    result = _current(ref)
+    assert result["dialect"] == "duckdb"
+    assert result["biz_database"] == "bank_1"
+
+
+def test_doris_dialect_unchanged():
+    result = _current("doris://business")
+    assert result["dialect"] == "doris"
+    assert result["biz_database"] == "business"
+
+
+def test_mysql_dialect_unchanged():
+    result = _current("mysql://host:3306/olist")
+    assert result["dialect"] == "mysql"
+    assert result["biz_database"] == "olist"
+
+
+def test_sqlite_dialect_unchanged():
+    result = _current("sqlite://C:/tmp/meta.db")
+    assert result["dialect"] == "sqlite"
+    assert result["is_sqlite"] is True
+    assert result["biz_database"] == "meta.db"
+
+
+def test_unknown_scheme_falls_back_to_doris():
+    result = _current("excel://D:/bank_1")
+    assert result["dialect"] == "doris"
