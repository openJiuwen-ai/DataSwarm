+    monkeypatch.setattr(scheduler.orch_db, "create_instance", fake_create)
+    monkeypatch.setattr(scheduler, "_execute_instance", lambda *_a, **_k: None)
+    monkeypatch.setattr(scheduler.threading, "Thread", _FakeThread)
