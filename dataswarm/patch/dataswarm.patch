+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""HTTP API for business knowledge candidates, approvals and published assets."""
+from __future__ import annotations
+
+import json
+from urllib.parse import unquote
+
+from . import store
+
+_PREFIX = "/api/dataagent/knowledge"
+
+
+def _body(handler) -> dict | None:
+    try:
+        size = int(handler.headers.get("Content-Length", "0") or "0")
+        if size > 42 * 1024 * 1024:
+            return None
+        value = json.loads(handler.rfile.read(size).decode("utf-8")) if size else {}
+        return value if isinstance(value, dict) else None
+    except ValueError:
+        return None
+
+
+def handle_get(handler, parsed) -> None:
+    parts = parsed.path.rstrip("/").removeprefix(_PREFIX).strip("/").split("/")
+    try:
+        if parts == ["retired", "sources"]:
+            handler._write_json(200, {"sources": store.retired_sources()})
+            return
+        if parts == [""] or parts == ["assets"]:
+            from .retention import maybe_sweep
+            maybe_sweep()  # 保留期清理的惰性触发点（内部按工作空间节流）
+
+            def _int_arg(name: str) -> int:
+                raw = handler._query_arg(parsed, name) or ""
+                try:
+                    return int(raw)
+                except (TypeError, ValueError):
+                    return 0
+            result = store.list_assets_page(status=handler._query_arg(parsed, "status") or None,
+                                            asset_type=handler._query_arg(parsed, "type") or None,
+                                            page=_int_arg("page"), page_size=_int_arg("page_size"))
+            for row in result["assets"]:
+                row["conflicts"] = store.conflicts(row)
+            handler._write_json(200, result)
+            return
+        if len(parts) == 2 and parts[0] == "assets":
+            # Same /assets/{id} shape as the POST operations; the legacy
+            # /knowledge/{id} form below stays for existing callers.
+            asset = store.get_asset(unquote(parts[1]))
+            if asset:
+                asset["conflicts"] = store.conflicts(asset)
+                asset["events"] = store.events(asset["asset_id"])
+            handler._write_json(200 if asset else 404, asset or {"error": "not_found"})
+            return
+        if parts == ["documents"]:
+            from .documents import list_documents_page
+            try:
+                page = int(handler._query_arg(parsed, "page") or "")
+                page_size = int(handler._query_arg(parsed, "page_size") or "")
+            except (TypeError, ValueError):
+                page, page_size = 0, 0
+            handler._write_json(200, list_documents_page(page=page, page_size=page_size))
+            return
+        if len(parts) == 3 and parts[0] == "documents" and parts[2] == "candidates":
+            from .documents import get_document
+            document = get_document(unquote(parts[1]))
+            handler._write_json(200 if document else 404, document or {"error": "not_found"})
+            return
+        if len(parts) == 1:
+            asset = store.get_asset(unquote(parts[0]))
+            if asset:
+                asset["conflicts"] = store.conflicts(asset)
+                asset["events"] = store.events(asset["asset_id"])
+            handler._write_json(200 if asset else 404, asset or {"error": "not_found"})
+            return
+    except Exception as exc:  # noqa: BLE001
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_delete(handler, parsed) -> None:
+    path = parsed.path.rstrip("/").removeprefix(_PREFIX).strip("/")
+    parts = path.split("/")
+    try:
+        if len(parts) == 2 and parts[0] == "documents" and parts[1]:
+            from .documents import delete_document
+            handler._write_json(200, delete_document(unquote(parts[1])))
+            return
+    except ValueError as exc:
+        if "not found" in str(exc):
+            handler._write_json(404, {"error": "not_found"})
+        else:
+            handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:  # noqa: BLE001
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    path = parsed.path.rstrip("/").removeprefix(_PREFIX)
+    body = _body(handler)
+    if body is None:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        if path == "/assets":
+            handler._write_json(201, {"asset": store.create_candidate(body)})
+            return
+        if path == "/documents/parse":
+            from .documents import parse
+            handler._write_json(201, parse(str(body.get("path") or ""),
+                                           source_id=str(body.get("source_id") or "")))
+            return
+        if path == "/documents/upload":
+            from .documents import upload_and_parse
+            handler._write_json(201, upload_and_parse(str(body.get("file_name") or ""),
+                                                     str(body.get("content_base64") or ""),
+                                                     source_id=str(body.get("source_id") or "")))
+            return
+        if path == "/documents/extract":
+            from .extraction_jobs import submit_extraction
+            version_ids = body.get("version_ids")
+            if not isinstance(version_ids, list):
+                handler._write_json(400, {"error": "version_ids_required"})
+                return
+            handler._write_json(202, submit_extraction([str(v) for v in version_ids]))
+            return
+        if path.endswith("/candidates/extract"):
+            version_id = path.split("/")[-3]
+            from .documents import extract_candidates
+            handler._write_json(200, extract_candidates(version_id))
+            return
+        if path.endswith("/transition"):
+            asset_id = unquote(path.split("/")[-2])
+            asset = store.transition(asset_id, str(body.get("action") or ""),
+                                     actor=str(body.get("actor") or ""), resolution=str(body.get("resolution") or ""))
+            handler._write_json(200 if asset else 404, {"asset": asset} if asset else {"error": "not_found"})
+            return
+        if path.endswith("/update"):
+            asset_id = unquote(path.split("/")[-2])
+            asset = store.update_candidate(asset_id, body)
+            handler._write_json(200 if asset else 404, {"asset": asset} if asset else {"error": "not_found"})
+            return
+        if path == "/retired/purge":
+            raw_days = body.get("older_than_days")
+            handler._write_json(200, store.purge_retired(
+                older_than_days=int(raw_days) if raw_days is not None else None,
+                document_version_id=str(body.get("document_version_id") or ""),
+                purge_all=body.get("all") is True))
+            return
+        if path == "/schema-enrichment/run":
+            # 重试/手动触发知识派生任务（L1 正则 + L2 LLM 深化）；工作空间取请求上下文
+            from .schema_enrichment import derivation_status, submit
+            from jiuwenswarm.common.workspace_context import current_workspace
+            workspace_id = current_workspace().workspace_id or "default"
+            submitted = submit(workspace_id)
+            handler._write_json(202, {**submitted, "knowledge_derivation": derivation_status(workspace_id)})
+            return
+        if path == "/schema-enrichment/cancel":
+            # 取消运行中的知识派生任务（cooperative：当前表完成后停止）；工作空间取请求上下文
+            from .schema_enrichment import cancel, derivation_status
+            from jiuwenswarm.common.workspace_context import current_workspace
+            workspace_id = current_workspace().workspace_id or "default"
+            cancelled = cancel(workspace_id)
+            handler._write_json(202, {**cancelled, "knowledge_derivation": derivation_status(workspace_id)})
+            return
+        if path == "/schema-candidates/derive":
+            from .schema_candidates import derive_candidates
+            from jiuwenswarm.common.workspace_context import business_db_ref
+            db_ref = str(body.get("db_ref") or "") or business_db_ref()
+            tables = body.get("tables")
+            handler._write_json(200, derive_candidates(
+                db_ref,
+                tables=[str(t) for t in tables] if isinstance(tables, list) else None,
+                source_id=str(body.get("source_id") or "")))
+            return
+        if path == "/resolve":
+            plan = body.get("plan")
+            if not isinstance(plan, dict):
+                handler._write_json(400, {"error": "plan_required"})
+                return
+            handler._write_json(200, store.resolve_for_plan(plan))
+            return
+    except ValueError as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:  # noqa: BLE001
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
