+    monkeypatch.setattr(service.datasource_store, "list_sources",
+                        lambda workspace_id=None: sources)
+
+    captured: dict = {}
+
+    def _capture(workspace_id, source_id, question, *, limit=20):
+        captured.update({"workspace_id": workspace_id, "source_id": source_id,
+                         "question": question, "limit": limit})
+        return {"tables": [], "query_vectors": [], "warnings": []}
+
+    monkeypatch.setattr(service.vector_store, "recall", _capture)
+    return captured
+
+
+# ==========================================================================
+# db_ref 反查 → source_id
+# ==========================================================================
+
+def test_db_ref_resolves_enabled_source(recall_env):
+    """db_ref 命中 enabled 注册源 → 反查 source_id 传给向量层。"""
+    result = service.vector_recall("", "各品类成交额", 10, db_ref="mysql://db:3306/shop")
+
+    assert recall_env["source_id"] == "src-orders"
+    assert recall_env["workspace_id"] == "ws-1"
+    assert recall_env["question"] == "各品类成交额"
+    assert recall_env["limit"] == 10
+    assert result["tables"] == []
+
+
+def test_explicit_source_id_wins(recall_env):
+    """source_id 显式传入时优先，不做 db_ref 反查。"""
+    service.vector_recall("src-explicit", "问题", 5, db_ref="mysql://db:3306/shop")
+
+    assert recall_env["source_id"] == "src-explicit"
+
+
+def test_unknown_db_ref_degrades_not_raises(recall_env):
+    """db_ref 无匹配注册源 → source_not_bound 空结果（降级契约，不抛）。"""
+    result = service.vector_recall("", "问题", 10, db_ref="mysql://ghost:3306/none")
+
+    assert result == {"tables": [], "query_vectors": [], "warnings": ["source_not_bound"]}
+    assert recall_env == {}  # 向量层未被调用
+
+
+def test_disabled_source_not_matched(recall_env):
+    """disabled 源不参与反查（停用即语义采集下线）。"""
+    result = service.vector_recall("", "问题", 10, db_ref="mysql://legacy:3306/old")
+
+    assert result["warnings"] == ["source_not_bound"]
+
+
+def test_list_sources_failure_degrades(recall_env, monkeypatch):
+    """注册源查询异常 → 按未绑定降级，绝不阻断召回主链路。"""
+    def _boom(workspace_id=None):
+        raise RuntimeError("meta db down")
+
+    monkeypatch.setattr(service.datasource_store, "list_sources", _boom)
+
+    result = service.vector_recall("", "问题", 10, db_ref="mysql://db:3306/shop")
+
+    assert result["warnings"] == ["source_not_bound"]
+
+
+# ==========================================================================
+# 入参校验（回归：db_ref 未传时原有 ValueError 语义不变）
+# ==========================================================================
+
+def test_both_ids_absent_raises(recall_env):
