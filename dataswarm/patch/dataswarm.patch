@@ -0,0 +1,199 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""SQL 执行器（只读）——通过公共连接器 dw-db-connector 连库。
+
+不再自己 import sqlite3 / pymysql，统一调 dw-db-connector 的 query()。
+datasource_ref 是 db-ref 格式：sqlite://path / doris:// / mysql:// / 裸路径（默认 sqlite）。
+空则用编排模块默认库 orch_db.WAREHOUSE_DB（转成 sqlite:// 格式）。
+
+只读护栏、行数保护、Markdown+JSON 双发输出 均由公共连接器 + 本执行器的格式化层负责。
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import sys
+import time
+from pathlib import Path
+
+# db_connector 已上收至 jiuwenswarm.common（方案 docs/skill-cli-web-api-plan.md §7.1）
+from jiuwenswarm.common import db_connector  # type: ignore  # noqa: E402
+
+from .. import db as orch_db
+from .base import Executor, TaskRunResult, register
+
+DEFAULT_LIMIT = 1000
+
+# 默认数据源配置文件：没指定 datasource_ref 时读它。
+# 复用 db_connector 的路径解析（config/ 优先，兼容 ~/.jiuwenswarm/ 根历史位置）。
+_DATASOURCE_CONFIG = db_connector._datasource_config_path()
+
+
+def _read_default_datasource() -> str | None:
+    """读 ~/.jiuwenswarm/config/datasource.yaml 的 default_db 字段。
+
+    返回 db-ref（sqlite:// / doris:// / mysql://）或 None（配置缺失）。
+    用 yaml 无依赖解析（简单 key: value，不引 PyYAML）。
+    """
+    if not _DATASOURCE_CONFIG.is_file():
+        return None
+    try:
+        for line in _DATASOURCE_CONFIG.read_text(encoding="utf-8").splitlines():
+            line = line.split("#", 1)[0].rstrip()
+            m = re.match(r"^default_db\s*:\s*(.+)$", line.strip())
+            if m:
+                return m.group(1).strip().strip('"').strip("'")
+    except OSError:
+        pass
+    return None
+
+
+def _resolve_db_ref(datasource_ref: str | None) -> str:
+    """datasource_ref → db-ref（决策七：任务执行以记录为准，兜底当前工作空间业务库）。
+
+    优先级：datasource_ref 参数 > 当前工作空间业务库（contextvar，调度/HTTP 入口
+    已显式 set）> ~/.jiuwenswarm/config/datasource.yaml 的 default_db（legacy）。
+    都没有时抛 ValueError（提示用户先配置库地址，不静默 fallback）。
+    """
+    if datasource_ref:
+        if "://" in datasource_ref:
+            return datasource_ref
+        return f"sqlite://{datasource_ref}"
+    # 当前工作空间业务库（多工作空间上下文缺失时 current_workspace 大声失败，
+    # 单工作空间/legacy 静默默认 —— 不再无条件回退全局 default_db）
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        context = workspace_context.current_workspace()
+    except workspace_context.WorkspaceBusinessNotBound as exc:
+        # UI 工作空间未绑定业务库：大声失败，禁止回退全局 default_db（防串库）
+        raise ValueError(
+            f"当前工作空间 {exc.workspace_id!r} 未绑定业务数据源，"
+            "请先在该工作空间下创建/绑定数据源后再执行任务"
+        ) from exc
+    except Exception:  # noqa: BLE001 —— 无 workspace 配置时走 legacy 配置兜底
+        context = None
+    if context is not None and context.workspace_id:
+        if context.business_db_ref:
+            return context.business_db_ref
+        # 上下文已明确落在某工作空间但未绑定业务库：大声失败（防串库）
+        raise ValueError(
+            f"当前工作空间 {context.workspace_id!r} 未绑定业务数据源，"
+            "请先在该工作空间下创建/绑定数据源后再执行任务"
+        )
+    # 读配置文件的默认数据源
+    configured = _read_default_datasource()
+    if configured:
+        if "://" in configured:
+            return configured
+        return f"sqlite://{configured}"
+    # 无指定无配置：提示用户先配置
+    raise ValueError(
+        "未指定数据库（datasource_ref 为空且工作空间/配置均未指定业务库）。"
+        "请在任务里指定 datasource_ref，或配置默认数据库："
+        "echo 'default_db: doris://' > ~/.jiuwenswarm/config/datasource.yaml"
+    )
+
+
+@register
+class SqlExecutor(Executor):
+    executor_type = "sql"
+
+    def run(self, code, params, datasource_ref, timeout_s, artifact_dir, log_prefix="node"):
+        stdout_path = artifact_dir / f"{log_prefix}.stdout.log"
+        stderr_path = artifact_dir / f"{log_prefix}.stderr.log"
+        artifact_dir.mkdir(parents=True, exist_ok=True)
+        result_summary: dict = {}
+        try:
+            db_ref = _resolve_db_ref(datasource_ref)
+            if _is_write_sql(code):
+                # 写入类 SQL（INSERT/CREATE/UPDATE/DELETE/CTAS）：走 execute（可写），
+                # 不走只读护栏。ETL 任务产出表 + 写血缘依赖此路径。
+                r = db_connector.execute(db_ref, code, commit=True)
+                result_summary = {
+                    "affected_rows": r.get("affected_rows"),
+                    "elapsed_ms": r.get("elapsed_ms"),
+                    "datasource": db_ref,
+                    "write": True,
+                }
+                text = (f"[sql_executor] write SQL executed: "
+                        f"affected_rows={r.get('affected_rows')}, "
+                        f"elapsed_ms={r.get('elapsed_ms')}\n")
+                self._write_text(stdout_path, text)
+                return TaskRunResult(
+                    exit_code=0,
+                    stdout_path=str(stdout_path),
+                    stderr_path=str(stderr_path),
+                    result_summary=result_summary,
+                    status="success",
+                )
+            # 只读查询：调公共连接器（只读护栏 + limit guard 在 db_connector 内部）
+            r = db_connector.query(db_ref, code, limit=DEFAULT_LIMIT)
+            columns = r["columns"]
+            rows = r["rows"]
+            result_summary = {
+                "row_count": r["row_count"],
+                "truncated": r["truncated"],
+                "columns": columns,
+                "elapsed_ms": r["elapsed_ms"],
+                "datasource": db_ref,
+            }
+            md = _md_table(columns, rows)
+            payload = {"summary": result_summary, "rows": rows}
+            text = md + "\n\n```json\n" + json.dumps(payload, ensure_ascii=False, indent=2) + "\n```\n"
+            self._write_text(stdout_path, text)
+            return TaskRunResult(
+                exit_code=0,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                result_summary=result_summary,
+                status="success",
+            )
+        except Exception as exc:  # noqa: BLE001
+            self._write_text(stderr_path, f"[sql_executor] {exc}")
+            return TaskRunResult(
+                exit_code=1,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                result_summary=result_summary,
+                error_message=str(exc),
+                status="failed",
+            )
+
+
+# 写入类 SQL 关键字（不区分大小写）。
+# SELECT-only 视为只读查询；INSERT/CREATE/UPDATE/DELETE/REPLACE/MERGE 视为写入。
+# COPY 也在内（duckdb 文件源的 COPY ... TO 导出走 execute 写路径）。
+_WRITE_SQL_RE = re.compile(
+    r"^\s*(INSERT|CREATE|UPDATE|DELETE|REPLACE|MERGE|DROP|ALTER|TRUNCATE|COPY)\b",
+    re.IGNORECASE,
+)
+
+
+def _is_write_sql(code: str) -> bool:
+    """判断 SQL 是否写入类（需可写连接，不走只读护栏）。
+
+    ETL 任务的 INSERT INTO ... SELECT / CREATE TABLE AS SELECT 走此分支。
+    纯 SELECT 查询任务走只读分支（保护业务库）。
+    WITH...INSERT 形态（CTE + INSERT）也视为写入（含 INSERT 即写）。
+    """
+    if not code:
+        return False
+    stripped = code.strip()
+    # 首关键字是写入类
+    if _WRITE_SQL_RE.match(stripped):
+        return True
+    # WITH...INSERT / SELECT...INSERT 形态：SQL 体含 INSERT/CREATE 也视为写入
+    upper = stripped.upper()
+    if re.search(r"\bINSERT\s+INTO\b", upper) or re.search(r"\bCREATE\s+TABLE\b", upper):
+        return True
+    return False
+
+
+def _md_table(columns: list[str], rows: list) -> str:
+    if not columns:
+        return "(no result set)"
+    header = "| " + " | ".join(columns) + " |"
+    sep = "| " + " | ".join("---" for _ in columns) + " |"
+    body = ["| " + " | ".join(str(c) for c in r) + " |" for r in rows]
+    return "\n".join([header, sep, *body])
