+++ b/jiuwenswarm/channels/web/dataagent/metrics/store/releases.py
@@ -0,0 +1,168 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/releases.py —— 发布（dw_metric_releases）CRUD 与 active 管理（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+)
+
+from ..errors import ReleaseNotFound
+from ..model import (
+    Release,
+    as_list,
+    canonical_json,
+)
+from ._db import _commit_if_own, _conn_or, _parse_json_dict, _write_lock
+
+
+# ==========================================================================
+# dw_metric_releases —— 发布批次
+# ==========================================================================
+def create_release(release: Release, *, conn: Any = None) -> Release:
+    """写入一个发布批次。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_releases (release_id, workspace_id, label, status,"
+                " revision_ids_json, manifest_json, checksum, projection_graph,"
+                " projection_status, error_code, error_message, projected_at, published_at,"
+                " published_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (release.release_id, release.workspace_id, release.label, release.status,
+                 canonical_json(list(release.revision_ids)), canonical_json(dict(release.manifest)),
+                 release.checksum, release.projection_graph, release.projection_status,
+                 release.error_code, release.error_message, release.projected_at,
+                 release.published_at, release.published_by, release.created_at),
+            )
+            _commit_if_own(c, own)
+        return release
+    finally:
+        if own:
+            c.close()
+
+
+def _row_to_release(row: dict) -> Release:
+    manifest = _parse_json_dict(row.get("manifest_json"))
+    return Release(
+        release_id=row["release_id"],
+        workspace_id=row["workspace_id"],
+        label=row.get("label") or "",
+        status=row.get("status") or "draft",
+        revision_ids=tuple(as_list(row.get("revision_ids_json"))),
+        manifest=manifest,
+        checksum=row.get("checksum") or "",
+        projection_graph=row.get("projection_graph") or "",
+        projection_status=row.get("projection_status") or "pending",
+        error_code=row.get("error_code") or "",
+        error_message=row.get("error_message") or "",
+        projected_at=row.get("projected_at") or "",
+        published_at=row.get("published_at") or "",
+        published_by=row.get("published_by") or "",
+        created_at=row.get("created_at") or "",
+    )
+
+
+def get_release(release_id: str, *, conn: Any = None) -> Release | None:
+    """按主键取发布批次。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c, "SELECT * FROM dw_metric_releases WHERE release_id = ?", (release_id,))
+        return _row_to_release(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def get_release_or_raise(release_id: str, *, conn: Any = None) -> Release:
+    """按主键取发布批次，不存在抛 :class:`~.errors.ReleaseNotFound`。"""
+    release = get_release(release_id, conn=conn)
+    if release is None:
+        raise ReleaseNotFound(f"发布批次 {release_id} 不存在")
+    return release
+
+
+def get_active_release(workspace_id: str, *, conn: Any = None) -> Release | None:
+    """取当前生效的发布批次（``status=published`` 里最新的一个）。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c,
+            "SELECT * FROM dw_metric_releases WHERE workspace_id = ? AND status = 'published'"
+            " ORDER BY created_at DESC",
+            (workspace_id,),
+        )
+        return _row_to_release(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def list_releases(workspace_id: str, *, conn: Any = None) -> list[Release]:
+    """列出工作空间下的发布批次，按创建时间倒序。"""
+    c, own = _conn_or(conn)
+    try:
+        rows = _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_releases WHERE workspace_id = ? ORDER BY created_at DESC",
+            (workspace_id,),
+        )
+        return [_row_to_release(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+def update_release(release_id: str, **fields: Any) -> None:
+    """按列名更新发布批次。列名取自白名单，杜绝 SQL 注入。"""
+    allowed = {
+        "label", "status", "revision_ids_json", "manifest_json", "checksum",
+        "projection_graph", "projection_status", "error_code", "error_message",
+        "projected_at", "published_at", "published_by",
+    }
+    updates = {k: v for k, v in fields.items() if k in allowed}
+    if not updates:
+        return
+    assignments = ", ".join(f"{k} = ?" for k in updates)
+    conn = _connect()
+    try:
+        with _write_lock:
+            _exec(
+                conn,
+                f"UPDATE dw_metric_releases SET {assignments} WHERE release_id = ?",
+                (*updates.values(), release_id),
+            )
+            conn.commit()
+    finally:
+        conn.close()
+
+
+def revoke_other_releases(workspace_id: str, keep_release_id: str, *, conn: Any = None) -> int:
+    """把除 ``keep_release_id`` 外的已发布批次标记为 revoked。返回受影响行数。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cur = _exec(
+                c,
+                "UPDATE dw_metric_releases SET status = 'revoked' WHERE workspace_id = ?"
+                " AND status = 'published' AND release_id <> ?",
+                (workspace_id, keep_release_id),
+            )
+            _commit_if_own(c, own)
+            return cur.rowcount if cur.rowcount is not None and cur.rowcount >= 0 else 0
+    finally:
+        if own:
+            c.close()
+
+
