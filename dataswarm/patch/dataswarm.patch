--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/shared/RowMenu.tsx
@@ -0,0 +1,164 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 行内「更多▾」菜单：收拢低频/危险操作（运行记录/编辑/删除…），点击外部自动关闭。
+// 高保真规格：触发器 = 蓝字 + 下箭头；菜单 = 白底 r=6 + 阴影，36px 行、14px 文本。
+// 菜单项动作仍走列表页的 confirmDialog + toast + loading 链路。
+// 菜单面板 createPortal 到 document.body 并 fixed 定位：共享 Table 的数据区
+// （.ui-scroll-table-body）是 overflow 滚动容器，绝对定位的面板会被它裁剪、
+// 并撑大其滚动区域（表现为「撑开表格」）。
+
+import { useEffect, useId, useRef, useState, type KeyboardEvent, type ReactNode } from 'react';
+import { createPortal } from 'react-dom';
+import { ChevronDown } from 'lucide-react';
+
+export interface MenuItem {
+  label: string;
+  /** 选项左侧的类型图标（如 SQL/Python 执行器图标） */
+  icon?: ReactNode;
+  onClick: () => void;
+  /** 危险操作：红色文字 */
+  danger?: boolean;
+  /** 进行中的动作：转圈禁用（key 与列表页 useAction 的 busy key 对应） */
+  loading?: boolean;
+  disabled?: boolean;
+}
+
+/** 与 dataAsset.css 中 .da-row-menu-item / .da-row-menu-panel 的规格保持一致 */
+const ITEM_HEIGHT = 36;
+const PANEL_V_PADDING = 8;
+/** 面板与触发器的间距（原 top: calc(100% + 6px) 的 6px） */
+const TRIGGER_GAP = 6;
+
+function getNextMenuItemIndex(key: string, current: number, itemCount: number): number {
+  if (key === 'Home') return 0;
+  if (key === 'End') return itemCount - 1;
+  const offset = key === 'ArrowDown' ? 1 : -1;
+  return (current + offset + itemCount) % itemCount;
+}
+
+export function RowMenu({ items, text, icon }: { items: MenuItem[]; text: string; icon?: ReactNode }) {
+  const [open, setOpen] = useState(false);
+  const [anchor, setAnchor] = useState<DOMRect | null>(null);
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const panelRef = useRef<HTMLDivElement>(null);
+  const menuId = useId();
+
+  useEffect(() => {
+    if (!open) return;
+    panelRef.current?.querySelector<HTMLButtonElement>('button:not(:disabled)')?.focus();
+    const onDown = (e: MouseEvent) => {
+      // 面板是 portal 到 body 的，不在触发器 DOM 子树里，两个 ref 都要判断
+      const target = e.target as globalThis.Node;
+      if (!triggerRef.current?.contains(target) && !panelRef.current?.contains(target)) {
+        setOpen(false);
+      }
+    };
+    // 任意祖先（含表格横向滚动容器）滚动或窗口缩放时重新对位，让面板跟随触发器
+    const syncAnchor = () => {
+      if (triggerRef.current) setAnchor(triggerRef.current.getBoundingClientRect());
+    };
+    // 画布拖拽会阻止事件冒泡，在捕获阶段识别外部点击。
+    document.addEventListener('mousedown', onDown, true);
+    window.addEventListener('scroll', syncAnchor, true);
+    window.addEventListener('resize', syncAnchor);
+    return () => {
+      document.removeEventListener('mousedown', onDown, true);
+      window.removeEventListener('scroll', syncAnchor, true);
+      window.removeEventListener('resize', syncAnchor);
+    };
+  }, [open]);
+
+  const onKey = (e: KeyboardEvent<HTMLDivElement>) => {
+    if (e.key === 'Escape' || e.key === 'Tab') {
+      e.stopPropagation();
+      if (e.key === 'Escape') e.preventDefault();
+      setOpen(false);
+      triggerRef.current?.focus();
+      return;
+    }
+    if (!panelRef.current?.contains(e.target as globalThis.Node)) return;
+    const buttons = Array.from(panelRef.current.querySelectorAll<HTMLButtonElement>('button:not(:disabled)'));
+    if (!buttons.length || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
+    e.preventDefault();
+    e.stopPropagation();
+    const current = buttons.indexOf(document.activeElement as HTMLButtonElement);
+    const next = getNextMenuItemIndex(e.key, current, buttons.length);
+    buttons[next].focus();
+  };
+
+  const toggle = () => {
+    if (!open && triggerRef.current) setAnchor(triggerRef.current.getBoundingClientRect());
+    setOpen((v) => !v);
+  };
+
+  // 视口底部空间不足且上方放得下时向上展开，避免面板超出视口
+  const menuHeight = items.length * ITEM_HEIGHT + PANEL_V_PADDING;
+  const openUp =
+    !!anchor && window.innerHeight - anchor.bottom < menuHeight + TRIGGER_GAP && anchor.top > menuHeight + TRIGGER_GAP;
+
+  return (
+    <div className="da-row-menu" data-open={open}>
+      <button
+        ref={triggerRef}
+        type="button"
+        className="da-row-menu-trigger"
+        aria-label={text}
+        aria-expanded={open}
+        aria-haspopup="menu"
+        aria-controls={open ? menuId : undefined}
+        onClick={(event) => {
+          event.stopPropagation();
+          toggle();
+        }}
+      >
+        {icon ?? (
+          <>
+            {text}
+            <ChevronDown className="da-row-menu-chevron" size={12} aria-hidden="true" />
+          </>
+        )}
+      </button>
+      {open &&
+        anchor &&
+        createPortal(
+          <div
+            ref={panelRef}
+            id={menuId}
+            className="da-row-menu-panel"
+            role="menu"
+            aria-label={text}
+            onClick={(event) => event.stopPropagation()}
+            onKeyDown={onKey}
+            style={{
+              right: window.innerWidth - anchor.right,
+              ...(openUp
+                ? { bottom: window.innerHeight - anchor.top + TRIGGER_GAP }
+                : { top: anchor.bottom + TRIGGER_GAP }),
+            }}
+          >
+            {items.map((item) => (
+              <button
+                key={item.label}
+                type="button"
+                role="menuitem"
+                className="da-row-menu-item"
+                data-danger={item.danger || undefined}
+                disabled={item.disabled || item.loading}
+                onClick={() => {
+                  setOpen(false);
+                  triggerRef.current?.focus();
+                  item.onClick();
+                }}
+              >
+                <span className="da-row-menu-item-main">
+                  {item.icon}
+                  {item.label}
+                </span>
+                {item.loading && <span className="da-link-spinner" aria-hidden="true" />}
+              </button>
+            ))}
+          </div>,
+          document.body,
+        )}
+    </div>
+  );
+}
