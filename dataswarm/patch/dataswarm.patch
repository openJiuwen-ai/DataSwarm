--- /dev/null
+++ b/jiuwenswarm/channels/web/schema/ensure.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""ensure.py —— deploy/schema DDL 幂等应用（MVP：无版本化迁移状态机）。
+
+真相源 = 仓库根 deploy/schema/（每表、双方言各一个文件，单条 CREATE TABLE IF NOT EXISTS）。
+运行时解析顺序：
+    1. env JIUWENSWARM_DEPLOY_SCHEMA_DIR
+    2. <数据根>/deploy-schema/                （scripts/dw-ops/sync_schema.py 刷新的副本；数据根
+                                               经 get_user_workspace_dir 解析，JIUWENSWARM_DATA_DIR 优先）
+    3. <repo>/deploy/schema/                  （沿本文件 __file__ 上溯，开发模式零配置）
+
+语义约束：
+    - 只执行「建缺失表」，不是迁移机制（结构演进规则见 deploy/schema/README.md A3）。
+    - 目录不存在或方言不匹配 → 明确报错，绝不静默 fallback 到硬编码 DDL。
+    - 本模块允许被 web / 子进程并发调用：CREATE TABLE IF NOT EXISTS 天然幂等；
+      Doris 下同名并发建表由引擎自身串行化（极端竞态时后到者报已存在并被吞）。
+"""
+from __future__ import annotations
+
+import logging
+import os
+import sys
+from pathlib import Path
+
+# 连接层复用 db_connector（已上收至 jiuwenswarm.common，方案 docs/skill-cli-web-api-plan.md §7.1）
+from jiuwenswarm.common import db_connector  # type: ignore  # noqa: E402
+from jiuwenswarm.common.utils import get_user_workspace_dir  # noqa: E402
+
+logger = logging.getLogger(__name__)
+
+for _s in (sys.stdout, sys.stderr):
+    try:
+        _s.reconfigure(encoding="utf-8")
+    except Exception as reconf_exc:  # noqa: BLE001 —— 不支持 reconfigure 的流保持原样
+        logger.debug("[ensure] 流 reconfigure(utf-8) 失败: %s", reconf_exc)
+        pass
+
+_REPO_DEPLOY_SCHEMA = Path(__file__).resolve().parents[4] / "deploy" / "schema"
+
+
+def _runtime_deploy_schema_dir() -> Path:
+    """运行时 schema 副本目录：跟随数据根（JIUWENSWARM_DATA_DIR 优先，无 env 回退 ~/.jiuwenswarm）。
+
+    与 scripts/dw-ops/sync_schema.py 的 DEFAULT_DST 同一推导——脚本刷新的副本正是
+    本候选，两边目录不一致时改 schema 永远不生效。此前硬编码 ``~/.jiuwenswarm``
+    会让隔离形态（dataswarm_boot / 桌面 / 多实例）解析到基座目录的旧副本。
+    惰性求值（非模块级常量）：跟随 env 的注入时机与测试可 monkeypatch。
+    """
+    return get_user_workspace_dir() / "deploy-schema"
+# 包内兜底（whl 安装形态）：构建时 build_dataswarm_dist.py 把真相源 deploy/schema
+# 注入 jiuwenswarm/resources/deploy-schema —— whl 目标机无仓根、runtime 目录也无
+# （sync_schema.py 不随包分发），缺此候选 ensure_system_schema 必抛「schema 目录未找到」
+_PACKAGE_DEPLOY_SCHEMA = Path(__file__).resolve().parents[3] / "resources" / "deploy-schema"
+
+# 支持的方言 → 文件后缀。元数据库 Doris 已弃用（2026-10-08）：新表写
+# sqlite + mysql 双方言；doris 文件保留服务存量部署，过渡期一表最多三份。
+_DIALECT_SUFFIX = {"sqlite": ".sqlite.", "doris": ".doris.", "mysql": ".mysql."}
+
+# 哨兵基线：目录有效性只认 sqlite（首装必有）；doris/mysql 方言是否齐备由
+# ensure_system_schema 的完整性守卫按需检查——否则新增方言会让所有旧目录解析失败。
+_SENTINEL_DIALECT = "sqlite"
+
+
+def resolve_schema_dir() -> Path:
+    """按优先级定位 schema 目录；全部缺失抛 RuntimeError 提示同步命令。"""
+    candidates = []
+    env_dir = os.environ.get("JIUWENSWARM_DEPLOY_SCHEMA_DIR", "").strip()
+    if env_dir:
+        p = Path(env_dir).expanduser().resolve()
+        if not p.is_dir():
+            raise RuntimeError(
+                f"JIUWENSWARM_DEPLOY_SCHEMA_DIR 指向的目录不存在: {p}")
+        return p
+    candidates.append(_runtime_deploy_schema_dir())
+    candidates.append(_REPO_DEPLOY_SCHEMA)
+    candidates.append(_PACKAGE_DEPLOY_SCHEMA)  # whl 安装机兜底（dev/源码检出恒落空）
+    for p in candidates:
+        if (p / "ddl").is_dir() and (
+            p / "ddl" / f"dw_datasources.ddl.{_SENTINEL_DIALECT}.sql"
+        ).is_file():
+            return p
+    raise RuntimeError(
+        "系统 schema 目录未找到：请执行 `python scripts/dw-ops/sync_schema.py` 同步到 "
+        f"{_runtime_deploy_schema_dir()}，或在仓库根目录下运行（查找过 "
+        + ", ".join(str(c) for c in candidates) + "）")
+
+
+def _load_statements(schema_dir: Path, dialect: str) -> list[tuple[str, str]]:
+    """读 dialect 对应的全部 ddl 文件，返回 [(table_name, sql)]，文件名排序保证确定性。"""
+    suffix = _DIALECT_SUFFIX[dialect]
+    out: list[tuple[str, str]] = []
+    for f in sorted((schema_dir / "ddl").glob(f"*{suffix}sql")):
+        name = f.name.split(".")[0]
+        sql = "\n".join(
+            ln for ln in f.read_text(encoding="utf-8").splitlines()
+            if ln.strip() and not ln.strip().startswith("--")
+        ).strip()
+        if sql:
+            out.append((name, sql))
+    if not out:
+        raise RuntimeError(f"schema 目录无 {dialect} 方言 DDL 文件: {schema_dir/'ddl'}")
+    return out
+
+
+def _table_names(statements: list[tuple[str, str]]) -> set[str]:
+    """从语句清单里取**建表**名集合（剔除 CREATE INDEX——sqlite 索引单独成文件，
+    mysql/doris 无对应文件，混入比对会让守卫永远误报缺「表」）。"""
+    return {
+        name for name, sql in statements
+        if sql.lstrip().upper().startswith("CREATE TABLE")
+    }
+
+
+def _check_dialect_completeness(
+    schema_dir: Path, db_type: str, statements: list[tuple[str, str]]
+) -> None:
+    """启动期完整性守卫：目标方言的表集合不得比 sqlite 基线缺表。
+
+    sqlite 是首装必有的基线方言。切到 doris/mysql 元库时，若该方言缺了基线里
+    的表，ensure 只会建出半套 schema 而其余模块随即炸在缺表上——与其晚炸不如
+    **大声失败并列出缺失表名**，绝不静默建半套。
+
+    注：doris 元库对 2026-10-08 后新增的表（sqlite+mysql 双方言策略）会命中本
+    守卫而拒绝启动——这正是「元数据库 Doris 已弃用」的目标行为。
+    """
+    if db_type == "sqlite":
+        return
+    baseline = _table_names(_load_statements(schema_dir, "sqlite"))
+    current = _table_names(statements)
+    missing = sorted(baseline - current)
+    if missing:
+        raise RuntimeError(
+            f"元数据库方言 {db_type!r} 的 DDL 不完整：基线（sqlite）有而 {db_type} 缺 "
+            f"{len(missing)} 张表: {', '.join(missing)}。请补齐对应 "
+            f"*.ddl.{db_type}.sql 后重试（真相源 deploy/schema/ddl/，改完跑 "
+            "scripts/dw-ops/sync_schema.py）")
+
+
+def ensure_system_schema(db_ref: str, *, conn=None,
+                         schema_dir: Path | None = None) -> dict:
+    """对目标库幂等应用全部 DDL。返回 {dialect, schema_dir, ensured_tables, elapsed_ms}。
+
+    重复调用安全；任一语句失败立即抛出（带文件名上下文），不做半套降级。
+    """
+    sdir = schema_dir or resolve_schema_dir()
+    spec = db_connector.parse_db_ref(db_ref)
+    db_type = spec.get("type", "sqlite")
+    if db_type not in _DIALECT_SUFFIX:
+        raise RuntimeError(
+            f"元数据库类型 {db_type!r} 暂不支持（仅 {'/'.join(sorted(_DIALECT_SUFFIX))}）")
+    statements = _load_statements(sdir, db_type)
+    _check_dialect_completeness(sdir, db_type, statements)
+
+    own_conn = conn is None
+    import time as _t
+    t0 = _t.time()
+    c, meta = (conn, None) if conn else db_connector._acquire(db_ref, read_only=False)
+    try:
+        # 快路径：一次 SHOW TABLES/PRAGMA 取现有集合，稳态零 DDL 执行
+        # （CREATE IF NOT EXISTS 幂等但每条都是一次公网往返；先过滤可把启动开销降回 ~1 RTT）
+        existing = set()
+        try:
+            rows = db_connector.tables(db_ref).get("tables", []) if not conn else \
+                [r[0] for r in db_connector._cursor(c).execute(
+                    "SELECT name FROM sqlite_master WHERE type='table'").fetchall()]
+            existing = {str(x) for x in rows}
+        except Exception as exc:  # noqa: BLE001 —— 探测失败退回全量执行
+            logger.warning("[ensure][warn] preflight 失败，退回全量 DDL: %s", exc)
+        pending = [(n, s) for n, s in statements if n not in existing]
+        ensured, skipped_existing = [], len(statements) - len(pending)
+        cur = db_connector._cursor(c)
+        for name, sql in pending:
+            try:
+                cur.execute(sql)
+                if db_type == "sqlite":
+                    c.commit()
+                ensured.append(name)
+            except Exception as exc:  # noqa: BLE001 —— 失败即停，带上下文抛出
+                if db_type != "sqlite":
+                    try:
+                        c.rollback()
+                    except Exception as rb_exc:  # noqa: BLE001 —— 回滚失败不遮蔽原始 DDL 错误
+                        logger.debug("[ensure] 失败后回滚未成（%s 方言）: %s", db_type, rb_exc)
+                        pass
+                raise RuntimeError(f"ensure DDL 失败: {name}.ddl.{db_type}.sql → {exc}") from exc
+        if db_type != "sqlite" and ensured:
+            c.commit()
+    finally:
+        if own_conn:
+            db_connector._release(c)
+    return {"dialect": db_type, "schema_dir": str(sdir), "db": meta,
+            "ensured_tables": ensured, "already_present": skipped_existing,
+            "elapsed_ms": int((_t.time() - t0) * 1000)}
