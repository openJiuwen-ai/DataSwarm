@@ -0,0 +1,113 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.knowledge import retention, store
+from jiuwenswarm.channels.web.orchestration.db import _connect, _exec
+
+
+def _prepare(monkeypatch, tmp_path: Path) -> None:
+    db_path = tmp_path / "knowledge.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR",
+                       str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(f"sqlite://{db_path}")
+    monkeypatch.setattr(store, "_workspace", lambda: "ws-test")
+
+
+def _retired(title: str, source: dict, *, updated_at: str = "") -> dict:
+    asset = store.create_candidate({"asset_type": "rule", "title": title, "content": "content",
+                                    "scope": {"workspace_wide": True}, "source": source})
+    conn = _connect()
+    try:
+        _exec(conn, "UPDATE dw_business_knowledge SET status='retired',updated_at=? WHERE asset_id=?",
+              (updated_at or "2026-01-01T00:00:00+0800", asset["asset_id"]))
+        _exec(conn, "INSERT INTO dw_knowledge_events "
+              "(event_id,workspace_id,asset_id,action,actor,payload_json,created_at) VALUES (?,?,?,?,?,?,?)",
+              (f"ke_test_{asset['asset_id']}", "ws-test", asset["asset_id"], "retire", "tester", "{}",
+               "2026-01-01T00:00:00+0800"))
+        conn.commit()
+    finally:
+        conn.close()
+    return asset
+
+
+def test_purge_requires_explicit_scope(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    with pytest.raises(ValueError):
+        store.purge_retired()
+
+
+def test_purge_by_document_version_keeps_other_retired_and_events(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    target = _retired("目标规则", {"document_version_id": "dv-a", "name": "a.md"})
+    other = _retired("其他规则", {"document_version_id": "dv-b", "name": "b.md"})
+    live = store.create_candidate({"asset_type": "rule", "title": "在用规则", "content": "content",
+                                   "scope": {"workspace_wide": True}, "source": {"origin": "manual"}})
+    result = store.purge_retired(document_version_id="dv-a")
+    assert result["deleted"] == 1 and result["asset_ids"] == [target["asset_id"]]
+    assert store.get_asset(target["asset_id"]) is None
+    assert store.get_asset(other["asset_id"])["status"] == "retired"
+    assert store.get_asset(live["asset_id"])["status"] == "candidate"
+    # 审计事件保留：仍能查到谁在何时退役了该 asset
+    assert "retire" in [event["action"] for event in store.events(target["asset_id"])]
+
+
+def test_purge_older_than_days_only_removes_expired(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    expired = _retired("过期规则", {"document_version_id": "dv-a"}, updated_at="2000-01-01T00:00:00+0800")
+    fresh = _retired("新退役规则", {"document_version_id": "dv-b"}, updated_at="2099-01-01T00:00:00+0800")
+    result = store.purge_retired(older_than_days=90)
+    assert result["deleted"] == 1 and result["asset_ids"] == [expired["asset_id"]]
+    assert store.get_asset(fresh["asset_id"])["status"] == "retired"
+
+
+def test_purge_older_than_days_mixed_legacy_formats(monkeypatch, tmp_path):
+    """F1(+0800)/naive/F2(+08:00) 混存：字符串前缀 19 字符同构，cutoff 归一不影响过期判定。"""
+    _prepare(monkeypatch, tmp_path)
+    expired_f1 = _retired("旧格式过期", {"document_version_id": "dv-a"}, updated_at="2000-01-01T00:00:00+0800")
+    expired_naive = _retired("naive 过期", {"document_version_id": "dv-b"}, updated_at="2000-06-01T00:00:00")
+    fresh_f2 = _retired("新格式新退役", {"document_version_id": "dv-c"}, updated_at="2099-01-01T00:00:00+08:00")
+    result = store.purge_retired(older_than_days=90)
+    assert sorted(result["asset_ids"]) == sorted([expired_f1["asset_id"], expired_naive["asset_id"]])
+    assert store.get_asset(fresh_f2["asset_id"])["status"] == "retired"
+
+
+def test_purge_all_keeps_event_rows(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    first = _retired("规则一", {"document_version_id": "dv-a"})
+    _retired("规则二", {"origin": "manual"})
+    result = store.purge_retired(purge_all=True)
+    assert result["deleted"] == 2
+    assert store.list_assets() == []
+    assert store.events(first["asset_id"])
+
+
+def test_retired_sources_groups_known_documents_only(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    _retired("规则一", {"document_version_id": "dv-a", "name": "a.md"})
+    _retired("规则二", {"document_version_id": "dv-a", "name": "a.md"})
+    _retired("规则三", {"document_version_id": "dv-b", "name": "b.md"})
+    _retired("人工规则", {"origin": "manual"})
+    assert store.retired_sources() == [
+        {"document_version_id": "dv-a", "name": "a.md", "count": 2},
+        {"document_version_id": "dv-b", "name": "b.md", "count": 1},
+    ]
+
+
+def test_sweep_uses_retention_days(monkeypatch, tmp_path):
+    _prepare(monkeypatch, tmp_path)
+    calls: list[int | None] = []
+    monkeypatch.setattr(store, "purge_retired", lambda **kwargs: calls.append(kwargs.get("older_than_days")))
+    monkeypatch.setattr(retention.workspace_context, "set_current", lambda workspace: None)
+    monkeypatch.setattr(retention.workspace_context, "reset", lambda token: None)
+    retention._sweep("ws-test", 90)
+    assert calls == [90]
+    monkeypatch.setenv("KNOWLEDGE_RETIRED_RETENTION_DAYS", "30")
+    assert retention.retention_days() == 30
+    monkeypatch.setenv("KNOWLEDGE_RETIRED_RETENTION_DAYS", "off")
+    assert retention.retention_days() == 90
