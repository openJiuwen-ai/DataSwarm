@@ -0,0 +1,63 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** schema 关系子图展示（详情抽屉与问答探索路由共用）。
+ *
+ * 颜色走主题 token（见 ui.ts 头注释），不硬编码灰/蓝系。
+ */
+
+import { useTranslation } from 'react-i18next';
+import type { V2SchemaSubgraph } from './api';
+import { badge } from './ui';
+
+export function SchemaSubgraphView({ sub, snapshotId }: {
+  sub: V2SchemaSubgraph; snapshotId?: string | null;
+}) {
+  const { t } = useTranslation();
+  return (
+    <div className="rounded-lg border border-border p-3 space-y-2 text-xs">
+      <div className="flex items-center gap-2">
+        <span className="font-medium text-sm text-text-strong">{t('biMetrics.graph.subgraphTitle')}</span>
+        {snapshotId && <span className={badge('gray')} title={snapshotId}>snapshot {snapshotId.slice(0, 8)}</span>}
+      </div>
+      <div>
+        <span className="text-text-muted">{t('biMetrics.graph.tablesLabel')}</span>
+        {sub.tables.map((tbl) => (
+          <span key={tbl.id} className="mr-2 mb-1 inline-block rounded bg-accent-subtle px-1.5 py-0.5 text-accent">
+            {tbl.label || tbl.logical}
+          </span>))}
+      </div>
+      <div>
+        <span className="text-text-muted">{t('biMetrics.graph.columnsLabel')}</span>
+        {sub.columns.map((c) => (
+          <span key={c.id} className="mr-2 mb-1 inline-block rounded bg-bg-muted px-1.5 py-0.5 text-text"
+            title={c.logical}>
+            {c.label || c.logical}
+          </span>))}
+      </div>
+      {!!sub.joins.length && (
+        <div>
+          <span className="text-text-muted">{t('biMetrics.graph.joinsLabel')}</span>
+          <ul className="mt-1 space-y-0.5">
+            {sub.joins.map((j, i) => (
+              <li key={i}>
+                <code>{j.left.split(':').pop()}</code> —{j.kind}
+                {j.verified ? '✓' : '(candidate)'}→ <code>{j.right.split(':').pop()}</code>
+                <span className="text-text-weak"> [{j.evidence}]</span>
+              </li>))}
+          </ul>
+        </div>
+      )}
+      {!!sub.lineage.length && (
+        <div>
+          <span className="text-text-muted">{t('biMetrics.graph.lineageLabel')}</span>
+          <ul className="mt-1 space-y-0.5">
+            {sub.lineage.map((l, i) => (
+              <li key={i}>
+                <code>{l.right.split(':').pop()}</code> ←derivedFrom— <code>{l.left.split(':').pop()}</code>
+                {l.transformation ? <span className="text-text-weak"> ({l.transformation})</span> : null}
+              </li>))}
+          </ul>
+        </div>
+      )}
+    </div>
+  );
+}
