+    setName(metric?.name ?? '');
+    setDescription(metric?.description ?? '');
+    setOwner(metric?.owner ?? '');
+    setMetricType(revision?.metric_type ?? 'atomic');
+    setExpression(revision?.expression_sql ?? '');
+    setUnit(revision?.unit ?? '');
+    setSynonyms(joinList(revision?.synonyms));
+    setTimeDimension(revision?.time_dimension ?? '');
+    setAllowedDimensions(revision?.allowed_dimensions ?? []);
+    setTimeGrains(revision?.time_grains ?? []);
+    setDependencies(revision?.dependencies ?? []);
+    setZeroDenominator(revision?.zero_denominator ?? '');
+    setBindingAlias(revisionBinding?.datasource_alias || revisionBinding?.datasource_ref || '');
+    setBindingTable(revisionBinding?.source_table ?? '');
+    setColumnMapJson(revisionBinding?.column_map
+      ? JSON.stringify(revisionBinding.column_map, null, 2) : '');
