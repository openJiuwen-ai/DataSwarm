diff --git a/jiuwenswarm/channels/web/frontend/tests/analysisTraceModel.test.mjs b/jiuwenswarm/channels/web/frontend/tests/analysisTraceModel.test.mjs
new file mode 100644
index 000000000..048998ac7
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/analysisTraceModel.test.mjs
@@ -0,0 +1,128 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  exploreToolToStep,
+  llmEntriesForExplore,
+  llmHeaderLabel,
+  llmTraceStats,
+  matchLlmEntry,
+  prettyJsonText,
+  traceDecisionEntries,
+} from '../node_modules/.cache/analysis-trace/traceModel.mjs';
+
+const entry = (overrides = {}) => ({
+  step: 'plan',
+  llm_role: 'generation',
+  at: '2026-10-20T12:00:00',
+  ai_output: '{"components":[]}',
+  ...overrides,
+});
+
+// ---------------------------------------------------------------------------
+// llmTraceStats / llmHeaderLabel
+// ---------------------------------------------------------------------------
+
+test('llmTraceStats counts the three roles and tolerates unknown ones', () => {
+  const stats = llmTraceStats([
+    entry({ step: 'init', llm_role: 'deterministic' }),
+    entry({ step: 'plan', llm_role: 'generation' }),
+    entry({ step: 'trace', llm_role: 'decision' }),
+    entry({ step: 'legacy', llm_role: 'unknown_role' }),
+  ]);
+  assert.equal(stats.total, 4);
+  assert.equal(stats.decision, 1);
+  assert.equal(stats.generation, 1);
+  assert.equal(stats.deterministic, 2); // 未知角色归入确定性侧
+});
+
+test('llmTraceStats on empty input is all zeros', () => {
+  assert.deepEqual(llmTraceStats([]), { decision: 0, generation: 0, deterministic: 0, total: 0 });
+});
+
+test('llmHeaderLabel summarizes participation and falls back when uncollected', () => {
+  const manifest = { analysis_id: 'a', question: 'q', created_at: '' };
+  assert.equal(llmHeaderLabel(manifest), 'LLM 未采集');
+  const collected = {
+    ...manifest,
+    llm_trace: [
+      entry({ step: 'init', llm_role: 'deterministic' }),
+      entry({ step: 'plan' }),
+      entry({ step: 'execute', llm_role: 'generation' }),
+      entry({ step: 'trace', llm_role: 'decision' }),
+    ],
+  };
+  assert.equal(
+    llmHeaderLabel(collected),
+    'LLM 参与 4 步（决策 1 · 生成 2；其余步骤确定性执行）',
+  );
+});
+
+// ---------------------------------------------------------------------------
+// exploreToolToStep / llmEntriesForExplore
+// ---------------------------------------------------------------------------
+
+test('exploreToolToStep maps known tools to their command steps', () => {
+  assert.equal(exploreToolToStep('recall_more'), 'context');
+  assert.equal(exploreToolToStep('probe_values'), 'probe');
+  assert.equal(exploreToolToStep('check_join'), 'join');
+  assert.equal(exploreToolToStep('list_tables'), 'list-tables');
+  assert.equal(exploreToolToStep('describe_table'), 'describe');
+  assert.equal(exploreToolToStep('custom_tool'), 'trace'); // trace --tool 的任意值走 trace 通道
+});
+
+test('llmEntriesForExplore matches by step+component and by ai_output.tool for trace channel', () => {
+  const entries = [
+    entry({ step: 'context', llm_role: 'decision', component_id: 'c1', ai_output: '按渠道细分' }),
+    entry({ step: 'trace', llm_role: 'decision', component_id: 'c1', ai_output: '{"tool":"custom_tool","summary":"s"}' }),
+    entry({ step: 'trace', llm_role: 'decision', component_id: 'c2', ai_output: '{"tool":"custom_tool","summary":"别的成分"}' }),
+    entry({ step: 'trace', llm_role: 'decision', component_id: 'c1', ai_output: '{"decision":"sufficient"}' }),
+  ];
+  const recall = llmEntriesForExplore(entries, 'c1', 'recall_more');
+  assert.equal(recall.length, 1);
+  assert.equal(recall[0].ai_output, '按渠道细分');
+  const custom = llmEntriesForExplore(entries, 'c1', 'custom_tool');
+  assert.equal(custom.length, 1); // c2 的同 tool 条目与无 tool 的 decision 条目都被排除
+  assert.equal(custom[0].component_id, 'c1');
+  assert.deepEqual(llmEntriesForExplore(entries, 'c1', 'describe_table'), []); // 无匹配不报错
+});
+
+// ---------------------------------------------------------------------------
+// traceDecisionEntries / matchLlmEntry（与 sufficiency_trace / attempts 的对齐契约）
+// ---------------------------------------------------------------------------
+
+test('traceDecisionEntries keeps only trace entries carrying a decision for the component', () => {
+  const entries = [
+    entry({ step: 'trace', llm_role: 'decision', component_id: 'c1', ai_output: '{"decision":"sufficient"}' }),
+    entry({ step: 'trace', llm_role: 'deterministic', component_id: 'c1', ai_output: '{"decision":"compile_uncovered"}' }),
+    entry({ step: 'trace', llm_role: 'decision', component_id: 'c1', ai_output: '{"tool":"list_tables"}' }),
+    entry({ step: 'trace', llm_role: 'decision', component_id: 'c2', ai_output: '{"decision":"explore"}' }),
+  ];
+  const decisions = traceDecisionEntries(entries, 'c1');
+  assert.deepEqual(
+    decisions.map((e) => JSON.parse(e.ai_output).decision),
+    ['sufficient', 'compile_uncovered'], // compile_uncovered 也在 sufficiency_trace 里，须参与对齐
+  );
+});
+
+test('prettyJsonText indents parseable JSON and passes raw text through otherwise', () => {
+  assert.equal(prettyJsonText('{"a":1}'), '{\n  "a": 1\n}');
+  const truncated = '{"a": 1, "b": [1, 2';   // 截断片段：原样展示，不抛错
+  assert.equal(prettyJsonText(truncated), truncated);
+  assert.equal(prettyJsonText('SELECT 1'), 'SELECT 1');
+});
+
+test('matchLlmEntry filters by step/component and returns undefined beyond the last index', () => {
+  const entries = [
+    entry({ step: 'execute', component_id: 'c1', ai_output: 'SELECT 1' }),
+    entry({ step: 'execute', component_id: 'c1', ai_output: 'SELECT 2' }),
+    entry({ step: 'execute', component_id: 'c2', ai_output: 'SELECT 3' }),
+    entry({ step: 'plan' }),
+  ];
+  assert.equal(matchLlmEntry(entries, { step: 'execute', componentId: 'c1', index: 1 })?.ai_output, 'SELECT 2');
+  assert.equal(matchLlmEntry(entries, { step: 'execute', componentId: 'c1', index: 2 }), undefined);
+  assert.equal(matchLlmEntry(entries, { step: 'execute', componentId: 'c9', index: 0 }), undefined);
+  // 不带 componentId 只匹配无归属条目（plan/init/report-gate）
+  assert.equal(matchLlmEntry(entries, { step: 'plan' })?.step, 'plan');
+  assert.equal(matchLlmEntry(entries, { step: 'execute' }), undefined);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/assetLineage.test.mjs b/jiuwenswarm/channels/web/frontend/tests/assetLineage.test.mjs
new file mode 100644
index 000000000..07e896844
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/assetLineage.test.mjs
@@ -0,0 +1,285 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { JSDOM } from 'jsdom';
+import i18next from 'i18next';
+import { I18nextProvider } from 'react-i18next';
+import {
+  LineageView,
+  ColumnLineageTable,
+  metadataApi,
+  useDataManagementStore,
+} from '../node_modules/.cache/asset-lineage/runtime.mjs';
+
+const resources = Object.fromEntries(
+  ['zh', 'en'].map((language) => [
+    language,
+    {
+      translation: JSON.parse(readFileSync(new URL(`../src/i18n/locales/${language}.json`, import.meta.url), 'utf8')),
+    },
+  ]),
+);
+
+function graphFor(db, table, count = 1) {
+  return {
+    nodes: [],
+    edges: Array.from({ length: count }, (_, index) => ({
+      from: `${db}.source.field_${index}`,
+      to: `${db}.${table}.field_${index}`,
+      transformation: `SUM(field_${index})`,
+    })),
+  };
+}
+
+async function mount(language, run) {
+  const dom = new JSDOM('<div id="root"></div>', { url: 'http://unit.test', pretendToBeVisual: true });
+  const globals = {
+    window: dom.window,
+    document: dom.window.document,
+    HTMLElement: dom.window.HTMLElement,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    ResizeObserver: class {
+      observe() {}
+      disconnect() {}
+    },
+    fetch: () => {
+      throw new Error('Unit tests must not access the network');
+    },
+  };
+  const descriptors = new Map(
+    Object.keys(globals).map((key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)]),
+  );
+  for (const [key, value] of Object.entries(globals))
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  const i18n = i18next.createInstance();
+  await i18n.init({ lng: language, resources, initImmediate: false, showSupportNotice: false });
+  const requests = [];
+  const lineageRequests = [];
+  metadataApi.getTable = async () => ({ ddl: 'CREATE TABLE example (id INT)' });
+  metadataApi.getLineage = (db) =>
+    new Promise((resolve, reject) => lineageRequests.push({ db, resolve, reject }));
+  metadataApi.getColumnLineage = (db, table, signal) =>
+    new Promise((resolve, reject) => requests.push({ db, table, signal, resolve, reject }));
+  useDataManagementStore.setState({
+    selectedDb: 'warehouse',
+    selectedTable: 'orders',
+    lineage: {
+      graph: { nodes: [{ table: 'orders' }, { table: 'report' }], edges: [{ from: 'orders', to: 'report' }] },
+    },
+  });
+  const root = createRoot(document.getElementById('root'));
+  const render = async (element) => act(async () => root.render(createElement(I18nextProvider, { i18n }, element)));
+  const click = async (element) => act(async () => element.click());
+  const switchMode = async (mode) =>
+    click(document.querySelectorAll('.dm-lineage-mode button')[mode === 'column' ? 1 : 0]);
+  try {
+    await run({ dom, requests, lineageRequests, render, click, switchMode, i18n });  } finally {
+    await act(async () => root.unmount());
+    for (const [key, descriptor] of descriptors) {
+      if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+      else delete globalThis[key];
+    }
+    dom.window.close();
+  }
+}
+
+for (const language of ['zh', 'en']) {
+  test(`${language}: transformation appears immediately on hover or focus without expanding the table`, async () => {
+    await mount(language, async ({ render, dom, i18n }) => {
+      const transformation = "SUM(payment_value)\nFILTER (WHERE payment_type = 'credit_card')";
+      const graph = graphFor('warehouse', 'report');
+      graph.edges[0].transformation = transformation;
+      await render(createElement(ColumnLineageTable, { graph, table: 'warehouse.report' }));
+      const trigger = document.querySelector('button.column-lineage-expression');
+      const tableBody = document.querySelector('tbody');
+      const tableText = tableBody.textContent;
+      assert.equal(trigger.hasAttribute('title'), false);
+      assert.equal(document.querySelector('details'), null);
+      assert.equal(document.querySelector('[role="tooltip"]'), null);
+
+      await act(async () => trigger.dispatchEvent(new dom.window.MouseEvent('mouseover', { bubbles: true })));
+      const tooltip = document.querySelector('[role="tooltip"]');
+      assert.ok(tooltip, 'hover must show the expression without a click or a timer');
+      assert.equal(tooltip.style.visibility, 'visible');
+      assert.equal(tooltip.querySelector('span').textContent, i18n.t('columnLineageTable.transformation'));
+      assert.equal(tooltip.querySelector('pre').textContent, transformation);
+      assert.equal(tooltip.parentElement, document.body, 'popup must escape the scrollable table');
+      assert.equal(trigger.getAttribute('aria-describedby'), tooltip.id);
+      assert.equal(tableBody.textContent, tableText, 'the expression must not be inserted into the table row');
+
+      await act(async () =>
+        trigger.dispatchEvent(new dom.window.MouseEvent('mouseout', { bubbles: true, relatedTarget: document.body })),
+      );
+      assert.equal(document.querySelector('[role="tooltip"]'), null);
+      await act(async () => trigger.focus());
+      assert.ok(document.querySelector('[role="tooltip"]'), 'keyboard focus must show the expression');
+      await act(async () =>
+        trigger.dispatchEvent(new dom.window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true })),
+      );
+      assert.equal(document.querySelector('[role="tooltip"]'), null);
+      await act(async () => trigger.blur());
+      await act(async () => trigger.focus());
+      assert.ok(document.querySelector('[role="tooltip"]'));
+      await act(async () => trigger.blur());
+      assert.equal(document.querySelector('[role="tooltip"]'), null);
+    });
+  });
+
+  test(`${language}: asset field mode follows the focused table and retains more than 20 fields`, async () => {
+    await mount(language, async ({ render, requests, click, switchMode, i18n }) => {
+      await render(createElement(LineageView));
+      assert.equal(requests.length, 0, 'table graph must not preload unused field relations');
+      assert.equal(document.querySelector('.dm-col-edge'), null);
+      await click(
+        [...document.querySelectorAll('[data-testid="graph"] button')].find(
+          (button) => button.textContent === 'report',
+        ),
+      );
+      await switchMode('column');
+      assert.equal(document.querySelector('.dm-canvas'), null);
+      assert.deepEqual([requests[0].db, requests[0].table], ['warehouse', 'report']);
+      assert.ok(document.querySelector('[aria-busy="true"]'));
+      await act(async () => requests[0].resolve({ graph: graphFor('warehouse', 'report', 25) }));
+      assert.equal(document.querySelectorAll('tbody tr').length, 25);
+      assert.equal(
+        document.querySelector('select'),
+        null,
+        'asset data belongs to the current table, not an arbitrary neighbor',
+      );
+      assert.equal(document.querySelector('.column-lineage-context-table').textContent, 'warehouse.report');
+      assert.equal(
+        document.querySelector('.column-lineage-count').textContent,
+        language === 'zh' ? '共 25 个血缘字段' : '25 lineage fields',
+      );
+      assert.equal(
+        document.querySelector('button.column-lineage-expression').getAttribute('aria-label'),
+        i18n.t('columnLineageTable.showTransformation', { field: 'warehouse.source.field_0' }),
+      );
+      await switchMode('table');
+      assert.ok(document.querySelector('.dm-canvas'));
+      assert.equal(document.querySelector('.dm-node-card h3').textContent, 'report');
+    });
+  });
+}
+
+test('changing database and table preserves field mode, cancels old requests, and cannot display stale relations', async () => {
+  await mount('zh', async ({ render, requests, switchMode }) => {
+    await render(createElement(LineageView));
+    await switchMode('column');
+    await act(async () => useDataManagementStore.setState({ selectedTable: 'report' }));
+    assert.equal(requests[0].signal.aborted, true);
+    assert.equal(requests[1].table, 'report');
+    await act(async () => requests[1].resolve({ graph: graphFor('warehouse', 'report') }));
+    await act(async () => requests[0].resolve({ graph: graphFor('warehouse', 'orders', 3) }));
+    assert.equal(document.querySelector('.column-lineage-context-table').textContent, 'warehouse.report');
+    assert.equal(document.querySelectorAll('tbody tr').length, 1);
+    await act(async () => useDataManagementStore.setState({ selectedDb: 'other_warehouse' }));
+    assert.ok(document.querySelector('[aria-busy="true"]'));
+    assert.equal(document.querySelector('.column-lineage-view'), null);
+    assert.equal(requests[2].db, 'other_warehouse');
+    await act(async () => requests[2].resolve({ graph: graphFor('other_warehouse', 'report', 2) }));
+    assert.equal(document.querySelector('.column-lineage-context-table').textContent, 'other_warehouse.report');
+    assert.equal(document.querySelectorAll('tbody tr').length, 2);
+  });
+});
+
+test('load failure is distinct from an empty graph and a retry can recover', async () => {
+  await mount('en', async ({ render, requests, switchMode, click, i18n }) => {
+    await render(createElement(LineageView));
+    await switchMode('column');
+    await act(async () => requests[0].reject(new Error('failed')));
+    assert.equal(
+      document.querySelector('[role="alert"]').textContent,
+      i18n.t('dataManagement.lineage.columnLoadFailed'),
+    );
+    assert.equal(document.querySelector('.column-lineage-empty'), null);
+    await click(document.querySelector('.dm-column-lineage-state button'));
+    assert.equal(requests.length, 2);
+    await act(async () => requests[1].resolve({ graph: { nodes: [], edges: [] } }));
+    assert.equal(document.querySelector('.column-lineage-empty').textContent, i18n.t('columnLineageTable.empty'));
+    assert.equal(document.querySelector('.column-lineage-context-table').textContent, 'warehouse.orders');
+  });
+});
+
+test('shared table keeps dashboard filtering available and scopes asset rows by the full database name', async () => {
+  await mount('zh', async ({ render, dom }) => {
+    const graph = {
+      nodes: [],
+      edges: [...graphFor('warehouse', 'report').edges, ...graphFor('other', 'report', 2).edges],
+    };
+    await render(createElement(ColumnLineageTable, { graph }));
+    assert.equal(document.querySelectorAll('tbody tr').length, 6);
+    const select = document.querySelector('select');
+    await act(async () => {
+      select.value = 'other.report';
+      select.dispatchEvent(new dom.window.Event('change', { bubbles: true }));
+    });
+    assert.equal(document.querySelectorAll('tbody tr').length, 2);
+    await render(createElement(ColumnLineageTable, { graph, table: 'warehouse.report' }));
+    assert.equal(document.querySelectorAll('tbody tr').length, 1);
+    assert.ok(document.querySelector('tbody').textContent.includes('warehouse.source.field_0'));
+    assert.equal(document.querySelector('tbody').textContent.includes('other.'), false);
+  });
+});
+
+test('selecting a table in the tree focuses it in the graph and clears focus for tables without lineage', async () => {
+  await mount('zh', async ({ render, lineageRequests }) => {
+    await render(createElement(LineageView));
+    assert.equal(lineageRequests.length, 1, 'mounting the lineage tab must fetch lineage');
+    await act(async () => lineageRequests[0].resolve(useDataManagementStore.getState().lineage));
+    const graph = document.querySelector('[data-testid="graph"]');
+    assert.equal(graph.dataset.selected, 'orders', 'the tree-selected table must be highlighted');
+
+    // 图内手动切换聚焦到别的节点
+    await act(async () =>
+      [...graph.querySelectorAll('button')].find((b) => b.textContent === 'report').click());
+    assert.equal(graph.dataset.selected, 'report');
+
+    // 树里点选一个无血缘的表：聚焦清空，全图恢复正常亮度
+    await act(async () => useDataManagementStore.setState({ selectedTable: 'orphan' }));
+    await render(createElement(LineageView));
+    await act(async () => lineageRequests[1].resolve({
+      graph: { nodes: [{ table: 'orders' }, { table: 'report' }], edges: [] },
+    }));
+    const refreshed = document.querySelector('[data-testid="graph"]');
+    assert.equal(refreshed.dataset.selected, '', 'a table without lineage must not keep a stale focus');
+  });
+});
+
+test('remounting the lineage tab refetches lineage and a slow stale response cannot overwrite the newer graph', async () => {
+  await mount('en', async ({ render, lineageRequests, switchMode }) => {
+    await render(createElement(LineageView));
+    await act(async () => lineageRequests[0].resolve({
+      graph: { nodes: [{ table: 'orders' }], edges: [] },
+    }));
+
+    // 换表 remount：必须重新拉取，而不是沿用旧的 lineage
+    await act(async () => useDataManagementStore.setState({ selectedTable: 'report' }));
+    await render(createElement(LineageView));
+    assert.equal(lineageRequests.length, 2, 'each remount must refetch so new edges show up without a page reload');
+    await act(async () => lineageRequests[1].resolve({
+      graph: { nodes: [{ table: 'orders' }, { table: 'report' }], edges: [{ from: 'orders', to: 'report' }] },
+    }));
+    assert.deepEqual(
+      [...document.querySelectorAll('[data-testid="graph"] button')].map((b) => b.textContent),
+      ['orders', 'report'],
+    );
+
+    // 换库后旧库慢响应到达：不允许覆盖新库数据
+    await act(async () => useDataManagementStore.setState({ selectedDb: 'other_warehouse', lineage: null }));
+    await render(createElement(LineageView));
+    assert.equal(lineageRequests.length, 3);
+    await act(async () => lineageRequests[2].resolve({
+      graph: { nodes: [{ table: 'other_table' }], edges: [] },
+    }));
+    useDataManagementStore.setState({ selectedDb: 'warehouse' });
+    await render(createElement(LineageView));
+    assert.equal(lineageRequests.length, 4);
+    await act(async () => lineageRequests[3].reject(new Error('slow stale response')));
+    // 拒绝的是新请求本身，不产生覆盖；再让旧库慢响应（请求 2 已消费，用新请求验证守卫方向）
+    const state = useDataManagementStore.getState();
+    assert.ok(state.lineage, 'a rejected fresh fetch must not wipe the current graph');
+  });
+});
