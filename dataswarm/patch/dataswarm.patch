+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { ArrowUpRight, RefreshCw } from 'lucide-react';
+import { orchestrationApi } from '../api/orchestrationApi';
+import type { Instance, RefType, TaskRun, TaskDefinition } from '../types/orchestration';
+import { useListControls, useListQuery } from '../hooks/useListQuery';
+import { toast } from './shared/Ui';
+import { HifiTag, IconButton, LinkAction, SearchBox } from './shared/Hifi';
+import { Table } from '../../../components/ui/Table/Table';
+import { Pagination } from '../../../components/ui/Pagination/Pagination';
+import { workflowRunPath } from '../../../multi-session/routing/route';
+import { LogDrawer } from './LogDrawer';
+import { TaskEditDrawer } from './TaskEditDrawer';
+import { instanceDuration, formatDateTime, isActiveInstance } from './shared/instanceUtils';
+
+interface Props {
+  refType: RefType;
+  /** 按工作流或任务定义筛选；管理页「运行记录」跳转使用同一 ref_id。 */
+  filterRefId?: string | null;
+  /** 下拉筛选；null = 全部工作流或任务。 */
+  onFilterRefChange?: (refId: string | null) => void;
+  /** 工作流名称点击 → 打开对应定义的编辑 */
+  onOpenDefinition?: (refId: string) => void;
+}
+
+export function InstanceListPage({ refType, filterRefId, onFilterRefChange, onOpenDefinition }: Props) {
+  const { t } = useTranslation();
+  const { search, setSearch, setComposing, debouncedQ, page, setPage, pageSize, setPageSize } = useListControls();
+  const loadDefinitions = useCallback(async () => {
+    const definitions =
+      refType === 'workflow'
+        ? (await orchestrationApi.allWorkflows()).map((workflow) => ({ id: workflow.workflow_id, name: workflow.name }))
+        : (await orchestrationApi.allTasks()).map((task) => ({ id: task.task_id, name: task.name }));
+    return { items: definitions, total: definitions.length };
+  }, [refType]);
+  const {
+    items: definitions,
+    loading: definitionsLoading,
+    error: definitionsError,
+    visibleError: visibleDefinitionsError,
+    dismissError: dismissDefinitionsError,
+    reload: reloadDefinitions,
+  } = useListQuery(loadDefinitions);
+  const [editingTaskId, setEditingTaskId] = useState<string | null>(null);
+  const [editingTask, setEditingTask] = useState<TaskDefinition | null>(null);
+  useEffect(() => {
+    if (!editingTaskId || refType !== 'task') return;
+    let active = true;
+    void orchestrationApi.getTask(editingTaskId).then(
+      (task) => {
+        if (active) setEditingTask(task);
+      },
+      (error) => {
+        if (!active) return;
+        setEditingTaskId(null);
+        toast.error(error instanceof Error ? error.message : String(error));
+      },
+    );
+    return () => {
+      active = false;
+    };
+  }, [editingTaskId, refType]);
+  const [refreshing, setRefreshing] = useState(false);
+  const [drawerRuns, setDrawerRuns] = useState<TaskRun[] | null>(null);
+  const [logLoading, setLogLoading] = useState<string | null>(null);
+  const logRequest = useRef(0);
+  const load = useCallback(async () => {
+    const result = await orchestrationApi.listInstances({
+      ref_type: refType,
+      ref_id: filterRefId || undefined,
+      q: debouncedQ,
+      limit: pageSize,
+      offset: (page - 1) * pageSize,
+    });
+    return { items: result.instances, total: result.total };
+  }, [refType, filterRefId, debouncedQ, pageSize, page]);
+  const { items: instances, total, loading, error, visibleError, dismissError, hasLoaded, reload } = useListQuery(load);
+  const hasActive = instances.some(isActiveInstance);
+  useEffect(() => {
+    if (loading || error || !hasActive) return;
+    const timer = window.setTimeout(() => {
+      void reload();
+    }, 2000);
+    return () => window.clearTimeout(timer);
+  }, [hasActive, loading, error, reload]);
+  useEffect(() => {
+    if (!loading && !error && page > Math.max(1, Math.ceil(total / pageSize)))
+      setPage(Math.max(1, Math.ceil(total / pageSize)));
+  }, [loading, error, total, page, pageSize, setPage]);
+  useEffect(
+    () => () => {
+      logRequest.current += 1;
+    },
+    [],
+  );
+  const definitionName = (inst: Instance) => inst.ref_name || inst.ref_id;
+  const onLog = async (inst: Instance) => {
+    const request = ++logRequest.current;
+    setLogLoading(inst.instance_id);
+    try {
+      const result = await orchestrationApi.listTaskRuns(inst.instance_id);
+      if (request === logRequest.current) setDrawerRuns(result.task_runs);
+    } catch (e) {
+      if (request === logRequest.current) toast.error(e instanceof Error ? e.message : String(e));
+    } finally {
+      if (request === logRequest.current) setLogLoading(null);
+    }
+  };
+
+  const onRefresh = async () => {
+    setRefreshing(true);
+    try {
+      await Promise.all([reload(), reloadDefinitions()]);
+    } finally {
+      setRefreshing(false);
+    }
+  };
+
+  return (
+    <div>
+      {(visibleError || visibleDefinitionsError) && (
+        <div className="da-error" role="alert">
+          <span>{visibleError || visibleDefinitionsError}</span>
+          <button
+            type="button"
+            onClick={() => {
+              dismissError();
+              dismissDefinitionsError();
+            }}
+            aria-label={t('common.close')}
+          >
+            ×
+          </button>
+        </div>
+      )}
+      <header className="da-page-header">
+        <h1>
+          {refType === 'workflow' ? t('dataAsset.instanceList.titleWorkflow') : t('dataAsset.instanceList.titleTask')}
+        </h1>
+      </header>
+      <div className="da-list-head">
+        <h2>
+          {hasLoaded ? t('dataAsset.instanceList.section', { count: total }) : t('dataAsset.instanceList.sectionTitle')}
+        </h2>
+      </div>
+      <div className="da-toolbar">
+        <SearchBox
+          onCompositionChange={setComposing}
+          value={search}
+          onChange={setSearch}
+          placeholder={t('dataAsset.filters.instanceSearch')}
+        />
+        <select
+          className={`da-filter da-${refType}-filter`}
+          value={filterRefId ?? ''}
+          aria-label={t(`dataAsset.filters.${refType}`)}
+          aria-busy={definitionsLoading}
+          disabled={definitionsLoading}
+          onChange={(event) => {
+            setPage(1);
+            onFilterRefChange?.(event.target.value || null);
+          }}
+        >
+          <option value="">
+            {t(refType === 'workflow' ? 'dataAsset.filters.allWorkflows' : 'dataAsset.filters.allTasks')}
+          </option>
+          {definitionsError && (
+            <option disabled>
+              {t(
+                refType === 'workflow'
+                  ? 'dataAsset.filters.workflowsUnavailable'
+                  : 'dataAsset.filters.tasksUnavailable',
+              )}
+            </option>
+          )}
+          {filterRefId && !definitions.some((definition) => definition.id === filterRefId) && (
+            <option value={filterRefId}>
+              {instances.find((instance) => instance.ref_id === filterRefId)?.ref_name || filterRefId}
+            </option>
+          )}
+          {definitions.map((definition) => (
+            <option key={definition.id} value={definition.id} title={definition.name}>
+              {definition.name}
+            </option>
+          ))}
+        </select>
+        <IconButton
+          onClick={() => void onRefresh()}
+          loading={refreshing || loading || definitionsLoading}
+          title={t('dataAsset.instanceList.refresh')}
+        >
+          <RefreshCw size={14} aria-hidden="true" />
+        </IconButton>
+      </div>
+      {error && !instances.length ? null : loading && !instances.length ? (
+        <div className="da-empty">{t('dataAsset.instanceList.loading')}</div>
+      ) : instances.length === 0 ? (
+        <div className="da-empty">{t('dataAsset.instanceList.empty')}</div>
+      ) : (
+        <Table
+          headers={[
+            t('dataAsset.instanceList.col.instanceId'),
+            t('dataAsset.instanceList.col.trigger'),
+            t('dataAsset.instanceList.col.status'),
+            refType === 'workflow' ? t('dataAsset.instanceList.col.workflow') : t('dataAsset.instanceList.col.task'),
+            t('dataAsset.instanceList.col.createdAt'),
+            t('dataAsset.instanceList.col.finishedAt'),
+            t('dataAsset.instanceList.col.duration'),
+            t('dataAsset.instanceList.col.actions'),
+          ]}
+        >
+          {instances.map((inst) => (
+            <tr key={inst.instance_id}>
+              <td>
+                <span title={inst.instance_id}>{inst.instance_id}</span>
+              </td>
+              <td>{t(`dataAsset.trigger.${inst.trigger_type}`)}</td>
+              <td>
+                <HifiTag status={inst.status} label={t(`workflowRun.status.${inst.status}`)} />
+              </td>
+              <td>
+                {refType === 'task' || onOpenDefinition ? (
+                  <button
+                    type="button"
+                    className="da-link da-link-sm"
+                    aria-busy={refType === 'task' && editingTaskId === inst.ref_id && !editingTask}
+                    onClick={() => {
+                      if (refType === 'task') {
+                        setEditingTask(null);
+                        setEditingTaskId(inst.ref_id);
+                      } else {
+                        onOpenDefinition?.(inst.ref_id);
+                      }
+                    }}
+                    title={`${definitionName(inst)} (${inst.ref_id})`}
+                  >
+                    {definitionName(inst)}
+                    {refType === 'workflow' && <ArrowUpRight size={13} aria-hidden="true" />}
+                  </button>
+                ) : (
+                  <span className="da-cell-link-text">{definitionName(inst)}</span>
+                )}
+              </td>
+              <td>{formatDateTime(inst.created_at)}</td>
+              <td>
+                <span className={inst.finished_at ? undefined : 'da-cell-dash'}>
+                  {inst.finished_at ? formatDateTime(inst.finished_at) : '-'}
+                </span>
+              </td>
+              <td>
+                <span
+                  className={
+                    instanceDuration(inst.started_at, inst.finished_at, inst.status) ? undefined : 'da-cell-dash'
+                  }
+                >
+                  {instanceDuration(inst.started_at, inst.finished_at, inst.status) ?? '-'}
+                </span>
+              </td>
+              <td>
+                <div className="flex items-center gap-4">
+                  {refType === 'workflow' && (
+                    <a
+                      className="da-link"
+                      href={workflowRunPath(inst.instance_id)}
+                      target="_blank"
+                      rel="noopener noreferrer"
+                      title={t('workflowRun.openRun', { instanceId: inst.instance_id })}
+                    >
+                      {t('dataAsset.instanceList.viewRun')}
+                      <ArrowUpRight size={13} aria-hidden="true" />
+                    </a>
+                  )}
+                  <LinkAction loading={logLoading === inst.instance_id} onClick={() => void onLog(inst)}>
+                    {t('dataAsset.instanceList.logs')}
+                  </LinkAction>
+                </div>
+              </td>
+            </tr>
+          ))}
+        </Table>
+      )}
+      {hasLoaded && (
+        <Pagination
+          total={total}
+          page={page}
+          pageSize={pageSize}
+          onPageChange={setPage}
+          onPageSizeChange={(size) => {
+            setPageSize(size);
+            setPage(1);
+          }}
+          loading={loading}
+          labels={{
+            total: t('common.pagination.total', { count: total }),
+            pageSize: t('common.pagination.pageSize'),
+            previous: t('common.pagination.previous'),
+            next: t('common.pagination.next'),
+            page: (item) => t('common.pagination.page', { page: item }),
+            navLabel: t('common.pagination.navLabel'),
+          }}
+        />
+      )}
+      {refType === 'task' && editingTask && (
+        <TaskEditDrawer
+          open
+          task={editingTask}
+          onClose={() => {
+            setEditingTask(null);
+            setEditingTaskId(null);
+            void reloadDefinitions();
+            void reload();
+          }}
+        />
+      )}
+      {drawerRuns && <LogDrawer runs={drawerRuns} onClose={() => setDrawerRuns(null)} />}
+    </div>
+  );
+}
