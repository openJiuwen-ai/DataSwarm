+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""glossary/db.py —— 术语库元数据 CRUD（dw_ontology_terms，真相源）。
+
+表结构见 deploy/schema/ddl/dw_ontology_terms.ddl.*（双方言）。
+连接层沿用 metrics/db.py 的惯例：定义 CRUD 走系统元数据库（_connect），
+首次访问幂等 ensure 表结构。归一化别名冲突在写入口校验（方案 P0 §4.3）。
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import threading
+import unicodedata
+import uuid
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+_write_lock = threading.Lock()
+
+# 进程内每元库 ref 只 ensure 一次（对齐 metrics/db.py 的 _ensured_once 模式）
+_ensured_refs: set[str] = set()
+
+
+# ==========================================================================
+# 归一化与指纹（单一实现：写入口校验与对账共用）
+# ==========================================================================
+
+def normalize_alias(text: str) -> str:
+    """别名归一化：NFKC（全角→半角）+ lower + 压缩内部空白。
+
+    Args:
+        text: 原始别名/术语名。
+
+    Returns:
+        归一化后的字符串；空输入返回空串。
+    """
+    normalized = unicodedata.normalize("NFKC", str(text or "")).lower().strip()
+    return " ".join(normalized.split())
+
+
+def compute_fingerprint(name: str, definition: str, synonyms: list[str]) -> str:
+    """内容指纹：name + definition + 排序后 synonyms 的 sha256（启动对账判变更用）。"""
+    body = "|".join([name.strip(), definition.strip(), ",".join(sorted(synonyms))])
+    return hashlib.sha256(body.encode("utf-8")).hexdigest()
+
+
+def parse_synonyms(raw: Any) -> list[str]:
+    """synonyms 解析：list / JSON 数组字符串 / 逗号分隔字符串 → 去空去重的列表。"""
+    if raw is None:
+        return []
+    items: list[str] = []
+    if isinstance(raw, str):
+        text = raw.strip()
+        if not text:
+            return []
+        if text.startswith("["):
+            try:
+                parsed = json.loads(text)
+            except (json.JSONDecodeError, TypeError) as exc:
+                raise ValueError(f"synonyms 不是合法 JSON 数组: {text[:50]}") from exc
+            items = [str(item) for item in parsed] if isinstance(parsed, list) else []
+        else:
+            items = [part for part in text.replace("，", ",").split(",")]
+    elif isinstance(raw, list):
+        items = [str(item) for item in raw]
+    else:
+        raise ValueError("synonyms 必须是数组或字符串")
+    seen: set[str] = set()
+    out: list[str] = []
+    for item in items:
+        if not item.strip():
+            continue
+        if item in seen:
+            continue
+        seen.add(item)
+        out.append(item.strip())
+    return out
+
+
+def new_term_id() -> str:
+    return f"term_{uuid.uuid4().hex[:12]}"
+
+
+# ==========================================================================
+# 表结构 ensure（对齐 dashboard/db.py 的懒 ensure 惯例）
+# ==========================================================================
+
+def _ensure_table() -> None:
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+    ref = _resolve_meta_ref()
+    if ref in _ensured_refs:
+        return
+    ensure_system_schema(ref)
+    _ensured_refs.add(ref)
+
+
+def _resolve_meta_ref() -> str:
+    """目标元库 ref（与 _connect 无参同链：工作空间上下文 → legacy 常量）。"""
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        return workspace_context.current_workspace().metadata_db_ref
+    except Exception:  # noqa: BLE001 —— 多工作空间未设上下文等，回退模块级常量
+        from jiuwenswarm.channels.web.orchestration.db import META_DB_REF
+
+        return META_DB_REF
+
+
+# ==========================================================================
+# 查询
+# ==========================================================================
+
+def _decorate(term: dict) -> dict:
+    """JSON 字符串列解析为对象，供 API 层直接消费（对齐 metrics/db.py）。"""
+    if not term:
+        return term
+    term["synonyms_list"] = parse_synonyms(term.get("synonyms"))
+    return term
+
+
+def list_terms(keyword: str | None = None, status: str | None = None,
+               include_deprecated: bool = False) -> list[dict]:
+    """术语列表。默认只看 active；keyword 走 name/synonyms/definition LIKE。"""
+    _ensure_table()
+    conn = _connect()
+    try:
+        sql = "SELECT * FROM dw_ontology_terms"
+        conds: list[str] = []
+        params: list[Any] = []
+        if status:
+            conds.append("status=?")
+            params.append(status)
+        elif not include_deprecated:
+            conds.append("status != 'deprecated'")
+        if keyword:
+            kw = f"%{keyword}%"
+            conds.append("(name LIKE ? OR synonyms LIKE ? OR definition LIKE ?)")
+            params.extend([kw, kw, kw])
+        if conds:
+            sql += " WHERE " + " AND ".join(conds)
+        sql += " ORDER BY updated_at DESC"
+        return [_decorate(t) for t in _fetch_dicts(conn, sql, tuple(params))]
+    finally:
+        conn.close()
+
+
+def resolve_term_for_binding(term_id: str) -> tuple[dict[str, Any] | None, str]:
+    """指标术语绑定前置校验的术语解析：返回 (术语行, 失败原因)。
+
+    失败原因：``""`` 成功 / ``"missing"`` 不存在 / ``"deprecated"`` 已废弃。
+    错误文案与异常类型由调用方（指标绑定层）定义——glossary 只裁决
+    「术语是否可绑定」，不越界到指标域的异常体系。
+    """
+    term = get_term(str(term_id or "").strip())
+    if term is None:
+        return None, "missing"
+    if str(term.get("status") or "active") == "deprecated":
+        return None, "deprecated"
+    return term, ""
+
+
+def get_term(term_id: str) -> dict | None:
+    _ensure_table()
+    conn = _connect()
+    try:
+        row = _fetch_one_dict(conn, "SELECT * FROM dw_ontology_terms WHERE term_id=?", (term_id,))
+        return _decorate(row) if row else None
+    finally:
+        conn.close()
+
+
+def _alias_owner_map(exclude_term_id: str | None = None) -> dict[str, str]:
+    """全表别名空间：归一化别名 → 拥有它的 term_id（冲突校验用，术语量小走内存）。"""
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT term_id, name, synonyms FROM dw_ontology_terms")
+    finally:
+        conn.close()
+    owner: dict[str, str] = {}
+    for row in rows:
+        if exclude_term_id and row["term_id"] == exclude_term_id:
+            continue
+        owner[normalize_alias(row["name"])] = row["term_id"]
+        for synonym in parse_synonyms(row.get("synonyms")):
+            owner[normalize_alias(synonym)] = row["term_id"]
+    return owner
+
+
+# ==========================================================================
+# 写入（校验 → 落库；投影同步由 service 层在落库后调用）
+# ==========================================================================
+
+def _validate_term(name: str, definition: str, synonyms: list[str],
+                   exclude_term_id: str | None = None) -> None:
+    """写入口校验（方案 P0 §4.3）：非空、长度、术语内去重、跨术语别名冲突。"""
+    if not name or not name.strip():
+        raise ValueError("术语名（name）不能为空")
+    if len(name) > 200:
+        raise ValueError("术语名长度不能超过 200")
+    if not definition or not definition.strip():
+        raise ValueError("定义（definition）不能为空")
+    if len(definition) > 4000:
+        raise ValueError("定义长度不能超过 4000")
+    normalized_name = normalize_alias(name)
+    if not normalized_name:
+        raise ValueError("术语名不能只由空白/控制字符组成")
+    seen: set[str] = set()
+    for synonym in synonyms:
+        normalized = normalize_alias(synonym)
+        if not normalized:
+            raise ValueError(f"别名不能只由空白组成: {synonym!r}")
+        if normalized == normalized_name:
+            raise ValueError(f"别名 {synonym!r} 与术语名自身重复")
+        if normalized in seen:
+            raise ValueError(f"别名 {synonym!r} 在同一术语内重复")
+        seen.add(normalized)
+    conflicts = _check_alias_conflicts([name, *synonyms], exclude_term_id)
+    if conflicts:
+        raise ValueError("别名冲突: " + "; ".join(conflicts))
+
+
+def _check_alias_conflicts(aliases: list[str], exclude_term_id: str | None) -> list[str]:
+    """跨术语冲突：返回 "X 已是术语「Y」的别名" 列表（空 = 无冲突）。"""
+    owner = _alias_owner_map(exclude_term_id=exclude_term_id)
+    conn = _connect()
+    try:
+        names = {row["term_id"]: row["name"]
+                 for row in _fetch_dicts(conn, "SELECT term_id, name FROM dw_ontology_terms")}
+    finally:
+        conn.close()
+    conflicts: list[str] = []
+    for alias in aliases:
+        holder = owner.get(normalize_alias(alias))
+        if holder and holder != exclude_term_id:
+            conflicts.append(f"「{alias}」已是术语「{names.get(holder, holder)}」的别名")
+    return conflicts
+
+
+def create_term(data: dict) -> dict:
+    """新建术语。校验失败抛 ValueError（API 层转 400）。"""
+    name = str(data.get("name", "")).strip()
+    definition = str(data.get("definition", "")).strip()
+    synonyms = parse_synonyms(data.get("synonyms"))
+    _validate_term(name, definition, synonyms)
+    term_id = data.get("term_id") or new_term_id()
+    now = _now()
+    fingerprint = compute_fingerprint(name, definition, synonyms)
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """INSERT INTO dw_ontology_terms
+                   (term_id,name,definition,synonyms,status,owner,source,tags,fingerprint,
+                    created_at,updated_at)
+                   VALUES (?,?,?,?,?,?,?,?,?,?,?)""", (
+                term_id, name, definition,
+                json.dumps(synonyms, ensure_ascii=False),
+                "active",
+                str(data.get("owner", "") or ""),
+                str(data.get("source", "") or "manual"),
+                str(data.get("tags", "") or ""),
+                fingerprint, now, now,
+            ))
+            conn.commit()
+        finally:
+            conn.close()
+    return get_term(term_id)  # type: ignore
+
+
+def update_term(term_id: str, data: dict) -> dict | None:
+    """更新术语（name/definition/synonyms/owner/tags 任选；重算指纹）。"""
+    existing = get_term(term_id)
+    if not existing:
+        return None
+    name = str(data.get("name", existing["name"])).strip()
+    definition = str(data.get("definition", existing["definition"])).strip()
+    synonyms = (parse_synonyms(data.get("synonyms"))
+                if "synonyms" in data else existing["synonyms_list"])
+    _validate_term(name, definition, synonyms, exclude_term_id=term_id)
+    fingerprint = compute_fingerprint(name, definition, synonyms)
+    now = _now()
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """UPDATE dw_ontology_terms
+                   SET name=?, definition=?, synonyms=?, owner=?, tags=?, fingerprint=?, updated_at=?
+                   WHERE term_id=?""", (
+                name, definition,
+                json.dumps(synonyms, ensure_ascii=False),
+                str(data.get("owner", existing.get("owner", "")) or ""),
+                str(data.get("tags", existing.get("tags", "")) or ""),
+                fingerprint, now, term_id,
+            ))
+            conn.commit()
+        finally:
+            conn.close()
+    return get_term(term_id)
+
+
+def delete_term(term_id: str) -> dict | None:
+    """软删：status=deprecated（图投影置 tombstone、向量删除，由 service 层处理）。"""
+    existing = get_term(term_id)
+    if not existing:
+        return None
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, "UPDATE dw_ontology_terms SET status='deprecated', updated_at=? WHERE term_id=?",
+                  (_now(), term_id))
+            conn.commit()
+        finally:
+            conn.close()
+    return get_term(term_id)
+
+
+def import_terms(items: list[dict]) -> dict:
+    """批量导入（方案 P0 §4.4）：按归一化 name 幂等，单条失败不阻断整批。
+
+    返回 {imported, updated, failed}。
+    """
+    imported = 0
+    updated = 0
+    failed: list[dict] = []
+    for index, item in enumerate(items):
+        if not isinstance(item, dict):
+            failed.append({"index": index, "reason": "条目不是对象"})
+            continue
+        name = str(item.get("term") or item.get("name") or "").strip()
+        definition = item.get("definition")
+        if definition is None:
+            definition = item.get("defenition")  # 兼容拼写（方案 P0 §3.1）
+        if not name:
+            failed.append({"index": index, "reason": "术语名（term/name）缺失"})
+            continue
+        if definition is None or not str(definition).strip():
+            failed.append({"index": index, "name": name, "reason": "定义（definition）缺失"})
+            continue
+        payload = {
+            "name": name,
+            "definition": str(definition).strip(),
+            "synonyms": parse_synonyms(item.get("synonyms")),
+            "owner": item.get("owner", ""),
+            "tags": item.get("tags", ""),
+            "source": "import",
+        }
+        try:
+            existing = _find_by_normalized_name(name)
+            if existing:
+                result = update_term(existing["term_id"], payload)
+                if not result:  # pragma: no cover —— existing 刚查到不会消失
+                    raise ValueError("更新失败")
+                updated += 1
+            else:
+                create_term(payload)
+                imported += 1
+        except ValueError as exc:
+            failed.append({"index": index, "name": name, "reason": str(exc)})
+    return {"imported": imported, "updated": updated, "failed": failed}
+
+
+def _find_by_normalized_name(name: str) -> dict | None:
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT term_id, name FROM dw_ontology_terms WHERE status != 'deprecated'")
+    finally:
+        conn.close()
+    target = normalize_alias(name)
+    for row in rows:
+        if normalize_alias(row["name"]) == target:
+            return get_term(row["term_id"])
+    return None
