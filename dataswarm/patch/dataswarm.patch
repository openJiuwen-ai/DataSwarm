+# ==========================================================================
+# 常量（刻度与旧 SPARQL 图召回严格对齐，回归门 = test_metrics_v4_routing 断言不改）
+# ==========================================================================
+
+# 指标表打分（旧 transport._MATCH_SCORES：metricKey 1.00 / label 0.80 /
+# synonym 0.75 / comment 0.40；精确全等 +0.15 上限 1.0，同指标取最高分字段）
+METRIC_MATCH_SCORES: dict[str, float] = {
+    "metric_key": 1.00,
+    "display_name": 0.80,
+    "synonym": 0.75,
+    "description": 0.40,
+}
+# schema 侧（旧 schema 图节点：label = comment or name；谓词 label/comment）
+SCHEMA_LABEL_SCORE = 0.80
+SCHEMA_COMMENT_SCORE = 0.40
+EXACT_BONUS = 0.15
+
+# schema 命中传导给指标的衰减与门槛（自 context.py 迁入，语义不变）
+SCHEMA_PROPAGATION = 0.9
+SCHEMA_PROPAGATE_MIN = 0.30
+SCHEMA_PROPAGATE_LIMIT = 5
+
+_SCHEMA_STATUS_ACTIVE = "active"
+
