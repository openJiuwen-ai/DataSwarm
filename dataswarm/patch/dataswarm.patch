@@ -0,0 +1,136 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store/verified_sql.py —— 已验证 SQL 样例库（dw_metric_verified_sql）（自 store.py 巨石按实体拆分，纯搬运）。
+
+连接层沿用 ``metrics/db.py`` 惯例（见 ``_db.py``）：占位符统一写 ``?``，
+由 ``_exec`` 按连接类型自动适配 sqlite/MySQL；写函数接受可选 ``conn``
+供发布流程在同一连接上原子多写。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+from ._db import _commit_if_own, _conn_or, _write_lock, new_id
+
+
+# ==========================================================================
+# dw_metric_verified_sql —— 经确认 SQL 的受限复用池
+# ==========================================================================
+def create_verified_sql(record: dict[str, Any], *, conn: Any = None) -> str:
+    """写入一条经确认的 SQL。
+
+    Args:
+        record: 列名 → 值。缺 ``verified_id`` / ``created_at`` 时自动补。
+
+    Returns:
+        verified_id。
+    """
+    verified_id = record.get("verified_id") or new_id("vsql")
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_verified_sql (verified_id, workspace_id,"
+                " revision_ids_json, query_spec_digest, sql_text, dialect, scope_json,"
+                " schema_snapshot_id, release_id, confirmed_by, confirmed_at, hit_count,"
+                " created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (verified_id, record.get("workspace_id") or "", record.get("revision_ids_json"),
+                 record.get("query_spec_digest"), record.get("sql_text"),
+                 record.get("dialect"), record.get("scope_json"),
+                 record.get("schema_snapshot_id"), record.get("release_id"),
+                 record.get("confirmed_by"), record.get("confirmed_at") or _now(),
+                 int(record.get("hit_count") or 0), record.get("created_at") or _now()),
+            )
+            _commit_if_own(c, own)
+        return verified_id
+    finally:
+        if own:
+            c.close()
+
+
+def find_verified_sql(
+    workspace_id: str, query_spec_digest: str, *, conn: Any = None
+) -> dict | None:
+    """按规格摘要找可复用的已确认 SQL。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_one_dict(
+            c,
+            "SELECT * FROM dw_metric_verified_sql WHERE workspace_id = ?"
+            " AND query_spec_digest = ? ORDER BY hit_count DESC",
+            (workspace_id, query_spec_digest),
+        )
+    finally:
+        if own:
+            c.close()
+
+
+def bump_verified_sql_hit(verified_id: str, *, conn: Any = None) -> None:
+    """复用命中计数 +1。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_verified_sql SET hit_count = hit_count + 1"
+                " WHERE verified_id = ?",
+                (verified_id,),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def list_verified_sql(workspace_id: str, *, limit: int = 20, conn: Any = None) -> list[dict]:
+    """列出已确认 SQL 池（few-shot 用，按命中数降序）。"""
+    c, own = _conn_or(conn)
+    try:
+        return _fetch_dicts(
+            c,
+            "SELECT * FROM dw_metric_verified_sql WHERE workspace_id = ?"
+            " ORDER BY hit_count DESC, created_at DESC LIMIT ?",
+            (workspace_id, int(limit)),
+        )
+    finally:
+        if own:
+            c.close()
+
+
+
+
+def has_verified_sql_for(
+    workspace_id: str, metric_keys: list[str], *, conn: Any = None
+) -> bool:
+    """该 workspace 是否有覆盖这些 metric_key 的已确认 SQL（候选打分的第三路）。"""
+    if not metric_keys:
+        return False
+    c, own = _conn_or(conn)
+    try:
+        for key in metric_keys:
+            # 按 scope_json 里的 metric_keys 查：池行钉的是 revision_ids，
+            # 对 revision_ids_json LIKE key 永远不命中（verified 通道曾因此静默死掉）
+            row = _fetch_one_dict(
+                c,
+                "SELECT verified_id FROM dw_metric_verified_sql WHERE workspace_id = ?"
+                " AND scope_json LIKE ? LIMIT 1",
+                (workspace_id, f"%{key}%"),
+            )
+            if row is not None:
+                return True
+        return False
+    finally:
+        if own:
+            c.close()
+
+
+# （dw_metric_schema_snapshots 注册表已随探查链路退役：深集成后 schema 锚点
+#  是 release manifest 的 semantic_refs（source_id + snapshot_id），真相源在
+#  dw_semantic_snapshots——不再有指标侧的 snapshot 注册行。）
diff --git a/jiuwenswarm/channels/web/dataagent/metrics/versioning.py b/jiuwenswarm/channels/web/dataagent/metrics/versioning.py
new file mode 100644
index 000000000..c59aca277
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/versioning.py
@@ -0,0 +1,958 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning.py —— 修订与发布生命周期（导入 → 确认 → 发布 → 投影）。
+
+发布语义（深集成后）：
+
+- 候选映射 **confirm 之后**才进正式投影；发布时只取 ``status=confirmed``。
+- 绑定校验走语义层快照（``semantic_link.ensure_semantic_refs``，严格单一
+  通道）：源未采集/表列漂移 → 绑定回写 failed + manifest warning，**发布不
+  阻断**。
+- Neo4j 投影（``graph_projection.publish_metric_graph``）失败 → release 照常
+  ``published``，``projection_status=failed`` 可 reproject 重试——元数据库是
+  真相源，投影是可重建的衍生品（对齐 glossary「投影失败不回滚表写」）。
+- 发布成功 → 修订标 ``published``，其余 published release 标 ``revoked``。
+
+依赖 :mod:`.ossie` 做导入、:mod:`.semantic_link` 做绑定校验、
+:mod:`.graph_projection` 做 Neo4j 投影。
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import _now
+
+from . import ossie as ossie_mod
+from . import store
+from .errors import DefinitionError, MetricNotFound
+from .model import (
+    BINDING_UNBOUND,
+    BINDING_VERIFIED,
+    MAP_CONFIRMED,
+    METRIC_TYPE_ATOMIC,
+    METRIC_TYPE_RATIO,
+    METRIC_TYPES,
+    REVISION_CANDIDATE,
+    REVISION_PUBLISHED,
+    RELEASE_DRAFT,
+    RELEASE_PUBLISHED,
+    Binding,
+    ConceptMapping,
+    ExpressionSpec,
+    MetricDef,
+    MetricRevision,
+    Release,
+    canonical_json,
+    sha256_of,
+)
+
+
+# ==========================================================================
+# 导入
+# ==========================================================================
+def import_ossie(
+    text: str,
+    workspace_id: str,
+    *,
+    fmt: str = "yaml",
+    target_db_type: str = "",
+    datasource_resolver: Any = None,
+) -> dict:
+    """解析 Ossie 语义模型并落库为 candidate 修订 + 绑定 + 候选映射。
+
+    幂等：同一 ``definition_hash`` 已存在时返回既有修订，不重复建行。
+
+    Args:
+        text: Ossie YAML/JSON 原文。
+        workspace_id: 归属工作空间。
+        fmt: ``"yaml"`` 或 ``"json"``。
+        target_db_type: 目标业务库类型，决定表达式方言偏好。
+        datasource_resolver: ``alias -> db_ref`` 解析器；None 用默认（查 dw_datasources）。
+
+    Returns:
+        ``{"revisions": [...], "bindings": [...], "candidate_mappings": [...],
+        "created": bool}``。
+    """
+    model = ossie_mod.parse_ossie(text, fmt=fmt)
+    keys = [model.metric_key_of(m) for m in model.metrics]
+
+    # 指标身份（幂等：同 workspace 同 key 返回既有）
+    defs: dict[str, MetricDef] = {}
+    for metric, key in zip(model.metrics, keys):
+        defs[key] = store.create_def(
+            workspace_id=workspace_id, metric_key=key,
+            name=str(metric.extension.get("display_name") or key.split(".")[-1]),
+            description=metric.description or "",
+            owner=str(model.extension.get("owner") or ""),
+        )
+
+    revisions = ossie_mod.to_revisions(
+        model, workspace_id, target_db_type=target_db_type,
+        metric_id_resolver=lambda key: defs[key].metric_id)
+
+    # 导入幂等：按 definition_hash 查重（忽略 revision_no 差异带来的哈希扰动——
+    # definition_payload 含 metric_id/revision_no，同一定义二次导入 revision_no 会变。
+    # 因此查重键用「口径内容」：去掉 revision_no 的负载哈希。）
+    created_any = False
+    out_revisions: list[MetricRevision] = []
+    carried: list[str] = []
+    for rev, key in zip(revisions, keys):
+        content_hash = _content_hash_of(rev)
+        existing = store.find_revision_by_hash(workspace_id, content_hash)
+        if existing is not None:
+            out_revisions.append(existing)
+            continue
+        rev = replace(rev, definition_hash=content_hash)
+        rev.validate()
+        store.create_revision(rev)
+        # 口径改了是新修订，但「这个指标度量哪个业务概念」没变——已确认的
+        # 术语绑定必须继承，否则每次重导入都静默丢绑定（分析入口随之失效）
+        carried.extend(_carry_over_term_maps(workspace_id, key, rev.revision_id))
+        created_any = True
+        out_revisions.append(rev)
+    revisions = out_revisions
+    by_key = dict(zip(keys, revisions))
+
+    bindings = ossie_mod.resolve_bindings(
+        model, workspace_id, by_key,
+        datasource_resolver=datasource_resolver if datasource_resolver is not None
+        else ossie_mod.default_datasource_resolver(workspace_id))
+    for binding in bindings:
+        store.create_binding(binding)
+
+    candidates = ossie_mod.candidate_mappings(model, workspace_id, by_key)
+    unresolved: list[str] = []
+    stored_candidates: list[ConceptMapping] = []
+    for mapping in candidates:
+        if mapping.relation_type == RELATION_MEASURES_CONCEPT:
+            # 自由文本 → term_id 在**写侧**解析：下游（图投影/分析图补全）只处理
+            # term_id 一种形态；解析不到就留原文并标 unresolved——让「名字没对上」
+            # 在导入时就暴露给人，而不是等发布时在投影里静默退化成孤立概念节点
+            term = resolve_term_ref(mapping.target_ref)
+            if term is not None:
+                mapping = replace(
+                    mapping, target_ref=str(term.get("term_id") or mapping.target_ref),
+                    evidence=f"{mapping.evidence}；解析到术语「{term.get('name')}」")
+            else:
+                unresolved.append(mapping.target_ref)
+                mapping = replace(
+                    mapping,
+                    evidence=f"{mapping.evidence}；术语库未命中（unresolved，确认后也连不出图边）")
+        # 同组重复（重导入同一定义）→ 不重复建行
+        if store.find_concept_map(
+                mapping.revision_id, mapping.relation_type, mapping.target_ref) is not None:
+            continue
+        store.create_concept_map(mapping)
+        stored_candidates.append(mapping)
+
+    return {
+        "revisions": [r.definition_ref for r in revisions],
+        "bindings": [b.binding_id for b in bindings],
+        "candidate_mappings": [m.mapping_id for m in stored_candidates],
+        "carried_term_maps": carried,
+        "unresolved_concepts": unresolved,
+        "created": created_any,
+    }
+
+
+def _carry_over_term_maps(
+    workspace_id: str, metric_key: str, new_revision_id: str
+) -> list[str]:
+    """新修订继承上一修订已确认的 ``measuresConcept`` 绑定。
+
+    上一修订 = 当前生效修订，没有就取除新修订外的最新一版（覆盖「导入后
+    先绑术语、还没发布就改口径重导入」的情形）。
+
+    Args:
+        workspace_id: 工作空间。
+        metric_key: 指标 key。
+        new_revision_id: 刚建的新修订。
+
+    Returns:
+        继承产生的 mapping_id 列表（无可继承时空列表）。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        return []
+    previous_id = metric.current_revision_id or ""
+    if not previous_id or previous_id == new_revision_id:
+        previous_id = next(
+            (rev.revision_id for rev in store.list_revisions(metric.metric_id)
+             if rev.revision_id != new_revision_id), "")
+    if not previous_id:
+        return []
+    carried: list[str] = []
+    for mapping in store.list_concept_maps(previous_id, status=MAP_CONFIRMED):
+        if mapping.relation_type != RELATION_MEASURES_CONCEPT:
+            continue
+        if store.find_concept_map(
+                new_revision_id, mapping.relation_type, mapping.target_ref) is not None:
+            continue
+        copied = replace(
+            mapping, mapping_id=store.new_id("map"), revision_id=new_revision_id,
+            evidence=f"{mapping.evidence}；随新修订继承（口径变更不改变所度量的业务概念）")
+        store.create_concept_map(copied)
+        carried.append(copied.mapping_id)
+    return carried
+
+
+def _content_hash_of(rev: MetricRevision) -> str:
+    """口径内容哈希：剔除 ``revision_no`` 与时间戳，使同一口径二次导入幂等。"""
+    payload = rev.definition_payload()
+    payload.pop("revision_no", None)
+    return sha256_of(canonical_json(payload))
+
+
+# ==========================================================================
+# 确认
+# ==========================================================================
+def confirm_mapping(mapping_id: str, *, confirmed_by: str) -> ConceptMapping:
+    """确认一条候选业务映射。只有 confirmed 的映射才进正式投影。"""
+    mapping = store.get_concept_map(mapping_id)
+    if mapping is None:
+        raise MetricNotFound(f"业务映射 {mapping_id} 不存在")
+    store.set_concept_map_status(mapping_id, MAP_CONFIRMED, confirmed_by=confirmed_by)
+    return replace(mapping, status=MAP_CONFIRMED, confirmed_by=confirmed_by)
+
+
+def reject_mapping(mapping_id: str) -> None:
+    """拒绝一条候选映射（保留记录，状态标 rejected）。"""
+    store.set_concept_map_status(mapping_id, "rejected")
+
+
+# ==========================================================================
+# 术语绑定（链路一：界面/API 直接绑定——人选的，直接 confirmed）
+# ==========================================================================
+
+RELATION_MEASURES_CONCEPT = "measuresConcept"
+
+
+def _target_revision(workspace_id: str, metric_key: str) -> MetricRevision:
+    """绑定落在哪个修订上：当前生效修订，没有就取最新一版。
+
+    ``current_revision_id`` 只在发布时才写，所以「已导入未发布」的指标必须
+    回退到最新修订——否则建模流程里最常见的「先导入、先绑术语、再发布」
+    直接走不通。
+
+    Raises:
+        MetricNotFound: 指标不存在或一个修订都没有。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    if metric.current_revision_id:
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is not None:
+            return revision
+    revisions = store.list_revisions(metric.metric_id)   # revision_no 倒序
+    if not revisions:
+        raise MetricNotFound(f"指标 {metric_key} 还没有任何修订，无法绑定术语")
+    return revisions[0]
+
+
+def bind_term(
+    workspace_id: str,
+    metric_key: str,
+    term_id: str,
+    *,
+    bound_by: str = "",
+) -> dict[str, Any]:
+    """把指标绑定到术语（``measuresConcept``）。
+
+    与 Ossie 导入链路（机器从自由文本猜 → candidate → 人工确认）不同：
+    这条链路的 ``target_ref`` 直接存 **term_id**（人从术语列表点选，无需
+    名字匹配），状态直接 ``confirmed``——点选动作本身就是确认，再要一轮
+    确认是官僚。
+
+    Args:
+        workspace_id: 工作空间。
+        metric_key: 指标 key（绑定落在当前生效修订，未发布时落最新修订）。
+        term_id: 术语 ID（必须存在且未废弃）。
+        bound_by: 操作人（审计）。
+
+    Returns:
+        ``{"mapping": {...}, "created": bool, "term": {...},
+        "reproject_required": bool, "warnings": [...]}``——
+        ``reproject_required`` 为真表示该修订已发布、图上的 measuresConcept
+        边要等下次发布或 ``POST /reprojects`` 才出现（**分析链路不受影响**：
+        元数据推导路直接读本表，绑定即生效）。
+
+    Raises:
+        MetricNotFound: 指标不存在或没有修订。
+        DefinitionError: 术语不存在 / 已废弃 / 术语库不可用。
+    """
+    revision = _target_revision(workspace_id, metric_key)
+    term = _active_term(term_id)
+    warnings: list[str] = []
+
+    # 幂等：同 (修订, measuresConcept, term_id) 已存在 → 置 confirmed 复用
+    existing = store.find_concept_map(
+        revision.revision_id, RELATION_MEASURES_CONCEPT, term_id)
+    if existing is not None:
+        if existing.status != MAP_CONFIRMED:
+            store.set_concept_map_status(
+                existing.mapping_id, MAP_CONFIRMED, confirmed_by=bound_by)
+        mapping = replace(existing, status=MAP_CONFIRMED, confirmed_by=bound_by)
+        created = False
+    else:
+        mapping = ConceptMapping(
+            mapping_id=store.new_id("map"),
+            workspace_id=workspace_id,
+            revision_id=revision.revision_id,
+            relation_type=RELATION_MEASURES_CONCEPT,
+            target_ref=term_id,
+            status=MAP_CONFIRMED,
+            evidence=f"ui:人工绑定术语「{term.get('name')}」",
+            confirmed_by=bound_by,
+        )
+        store.create_concept_map(mapping)
+        created = True
+
+    # 链分叉提示：该术语已被别的指标绑定 → 分析入口无法直达（不阻断，提示）
+    others = {
+        other.revision_id
+        for other in store.list_concept_maps_by_target(
+            workspace_id, RELATION_MEASURES_CONCEPT, term_id, status=MAP_CONFIRMED)
+        if other.revision_id != revision.revision_id
+    }
+    if others:
+        warnings.append(
+            f"term_multi_metric:术语「{term.get('name')}」还绑定了其他 {len(others)} 个指标"
+            "修订——一个术语链到多个指标时，分析提问无法直达单一口径（需用户二选一）")
+
+    return {
+        "mapping": mapping.__dict__,
+        "created": created,
+        "term": {"term_id": term_id, "name": term.get("name")},
+        "reproject_required": revision.status == REVISION_PUBLISHED,
+        "warnings": warnings,
+    }
+
+
+def unbind_term(workspace_id: str, metric_key: str, term_id: str) -> dict[str, Any]:
+    """解除指标与术语的绑定。
+
+    Returns:
+        ``{"removed": bool, "reproject_required": bool}``——未绑定时
+        ``removed=False``（幂等，不报错）。
+
+    Raises:
+        MetricNotFound: 指标不存在或没有修订。
+    """
+    revision = _target_revision(workspace_id, metric_key)
+    existing = store.find_concept_map(
+        revision.revision_id, RELATION_MEASURES_CONCEPT, term_id)
+    if existing is None:
+        return {"removed": False, "reproject_required": False}
+    store.delete_concept_map(existing.mapping_id)
+    return {"removed": True,
+            "reproject_required": revision.status == REVISION_PUBLISHED}
+
+
+def list_terms_of(workspace_id: str, metric_key: str) -> dict[str, Any]:
+    """指标已绑定的术语（含未解析的历史自由文本引用）。
+
+    Returns:
+        ``{"metric_key", "revision_id", "terms": [{mapping_id, target_ref,
+        status, evidence, resolved, term_id, name, definition}]}``——
+        ``resolved=False`` 是历史 Ossie 自由文本引用且当前解析不到术语
+        （图上连不出 Term 边，确认了也没用）。
+
+    Raises:
+        MetricNotFound: 指标不存在或没有修订。
+    """
+    revision = _target_revision(workspace_id, metric_key)
+    out: list[dict[str, Any]] = []
+    for mapping in store.list_concept_maps(revision.revision_id):
+        if mapping.relation_type != RELATION_MEASURES_CONCEPT:
+            continue
+        term = resolve_term_ref(mapping.target_ref)
+        out.append({
+            "mapping_id": mapping.mapping_id,
+            "target_ref": mapping.target_ref,
+            "status": mapping.status,
+            "evidence": mapping.evidence,
+            "resolved": term is not None,
+            "term_id": (term or {}).get("term_id", ""),
+            "name": (term or {}).get("name", ""),
+            "definition": (term or {}).get("definition", ""),
+        })
+    return {"metric_key": metric_key,
+            "revision_id": revision.revision_id, "terms": out}
+
+
+def resolve_term_ref(target_ref: str) -> dict[str, Any] | None:
+    """``target_ref`` → 术语（转调 :func:`graph_projection.resolve_term`）。
+
+    匹配规则只有一份实现（先 term_id 直查、再名字/别名全等），投影侧与
+    分析侧共用——三处各写一份必然漂移。
+    """
+    from . import graph_projection
+
+    return graph_projection.resolve_term(target_ref)
+
+
+def _active_term(term_id: str) -> dict[str, Any]:
+    """校验术语存在且未废弃（绑定前置校验）。"""
+    try:
+        from ..glossary import db as glossary_db
+
+        term = glossary_db.get_term(str(term_id or "").strip())
+    except Exception as exc:  # noqa: BLE001 —— 术语库不可用：绑定不能静默成功
+        raise DefinitionError(f"术语库不可用，无法校验术语 {term_id}: {exc}") from exc
+    if term is None:
+        raise DefinitionError(f"术语 {term_id} 不存在——请先在术语库创建")
+    if str(term.get("status") or "active") == "deprecated":
+        raise DefinitionError(f"术语 {term_id} 已废弃，不能绑定")
+    return term
+
+
+# ==========================================================================
+# 手动建指标 / 改口径 / 改身份 / 删除
+# ==========================================================================
+def _text_list(raw: Any) -> tuple[str, ...]:
+    """把逗号分隔字符串或数组统一成去空白的字符串元组。"""
+    if isinstance(raw, str):
+        parts = raw.replace("，", ",").split(",")
+    elif isinstance(raw, (list, tuple)):
+        parts = [str(item) for item in raw]
+    else:
+        return ()
+    return tuple(part.strip() for part in parts if part.strip())
+
+
+def _revision_payload(payload: dict[str, Any]) -> dict[str, Any]:
+    """新建指标允许 ``{metric_key, name, revision: {...}, binding: {...}}``
+    或扁平写法；统一取口径字段所在的 dict。"""
+    nested = payload.get("revision")
+    return nested if isinstance(nested, dict) else payload
+
+
+def _build_revision(
+    workspace_id: str,
+    metric_key: str,
+    metric_id: str,
+    revision_no: int,
+    payload: dict[str, Any],
+    *,
+    target_db_type: str = "",
+    default_display_name: str = "",
+    previous: MetricRevision | None = None,
+) -> MetricRevision:
+    """由表单载荷构造 candidate 修订（表达式解析复用 Ossie 链路）。
+
+    载荷缺失的冷门字段（datatype / fixed_filters / timezone / calendar /
+    additivity / subject_iri / zero_denominator / 表达式方言）从上一修订继承：
+    表单没有这些输入，若一律取默认值，新建修订会静默丢掉 Ossie 导入时
+    携带的口径约束。
+
+    Raises:
+        DefinitionError: 必填字段缺失、ratio 依赖数不为 2、或口径自校验失败。
+    """
+    def held(key: str, carried: Any, fallback: Any) -> Any:
+        """载荷显式给了就用载荷，否则继承上一修订，再否则用默认值。"""
+        if key in payload:
+            return payload[key]
+        return carried if previous is not None else fallback
+
+    metric_type = str(payload.get("metric_type") or METRIC_TYPE_ATOMIC)
+    if metric_type not in METRIC_TYPES:
+        raise DefinitionError(
+            f"metric_type={metric_type!r} 非法（支持 {', '.join(sorted(METRIC_TYPES))}）")
+    expression_text = str(payload.get("expression") or "").strip()
+    dialect = str(
+        payload.get("expression_dialect")
+        or (previous.expression.resolved_dialect if previous else "")
+        or "ANSI_SQL")
+    resolved_dialect, raw_expression = ossie_mod.resolve_dialect(
+        {dialect: expression_text} if expression_text else {}, target_db_type)
+    if raw_expression:
+        parsed, unparsed = ossie_mod.parse_expression(raw_expression, resolved_dialect)
+    else:
+        parsed, unparsed = None, "无表达式"
+    dependencies = _text_list(payload.get("dependencies"))
+    if metric_type == METRIC_TYPE_RATIO and len(dependencies) != 2:
+        raise DefinitionError(
+            "ratio 指标必须恰好声明 2 个 dependencies（按顺序为分子、分母）")
+    zero_denominator = str(held(
+        "zero_denominator",
+        previous.zero_denominator if previous else "", "") or "").strip()
+    if metric_type == METRIC_TYPE_RATIO and zero_denominator not in ("", "null", "zero"):
+        raise DefinitionError("zero_denominator 只支持 null / zero / 空")
+    fixed_filters_raw = held(
+        "fixed_filters", previous.fixed_filters if previous else (), ())
+    additivity_raw = held("additivity", previous.additivity if previous else {}, {})
+    revision = MetricRevision(
+        revision_id=store.new_id("rev"),
+        metric_id=metric_id,
+        workspace_id=workspace_id,
+        revision_no=revision_no,
+        metric_type=metric_type,
+        datatype=str(held("datatype", previous.datatype if previous else "", "") or ""),
+        unit=str(payload.get("unit") or ""),
+        display_name=str(
+            payload.get("display_name") or payload.get("name") or default_display_name),
+        synonyms=_text_list(payload.get("synonyms")),
+        expression=ExpressionSpec(
+            resolved_dialect=resolved_dialect,
+            dialects={dialect: expression_text} if expression_text else {},
+            parsed=parsed,
+            unparsed_reason=unparsed,
+        ),
+        fixed_filters=tuple(
+            dict(item) for item in fixed_filters_raw or ()
+            if isinstance(item, dict)),
+        time_dimension=str(payload.get("time_dimension") or "").strip(),
+        allowed_dimensions=_text_list(payload.get("allowed_dimensions")),
+        time_grains=_text_list(payload.get("time_grains")),
+        timezone=str(held("timezone", previous.timezone if previous else "", "") or ""),
+        calendar=str(held("calendar", previous.calendar if previous else "", "") or ""),
+        dependencies=dependencies,
+        zero_denominator=zero_denominator,
+        additivity={
+            str(key): str(value) for key, value in additivity_raw.items()
+        } if isinstance(additivity_raw, dict) else {},
+        subject_iri=str(held(
+            "subject_iri", previous.subject_iri if previous else "", "") or ""),
+        status=REVISION_CANDIDATE,
+        source_type="manual",
+        definition_ref=f"dataswarm:metric:{workspace_id}:{metric_key}@r{revision_no}",
+    )
+    revision = replace(revision, definition_hash=revision.compute_definition_hash())
+    revision.validate()
+    return revision
+
+
+def _create_binding(
+    workspace_id: str, revision: MetricRevision, raw: Any
+) -> Binding | None:
+    """按表单载荷落一条物理绑定。
+
+    未填任何绑定字段时返回 None（允许先存口径、后补绑定）；只填了一部分
+    （选数据源但没填表，反之亦然）直接报错，不落半条绑定。
+
+    Raises:
+        DefinitionError: 绑定字段不完整。
+    """
+    if not isinstance(raw, dict) or not raw:
+        return None
+    alias = str(raw.get("datasource_alias") or "").strip()
+    source_table = str(raw.get("source_table") or "").strip()
+    column_map_raw = raw.get("column_map")
+    if not alias and not source_table and not column_map_raw:
+        return None
+    if not alias or not source_table:
+        raise DefinitionError("绑定需要同时提供 datasource_alias 与 source_table")
+    db_ref = ossie_mod.default_datasource_resolver(workspace_id)(alias)
+    column_map = {
+        str(key): str(value) for key, value in column_map_raw.items()
+    } if isinstance(column_map_raw, dict) else {}
+    if not column_map and revision.expression.parsed:
+        # 恒等映射：逻辑列名 → 同名列（与 Ossie 数据集字段绑定同构）
+        column_map = {
+            ref.split(".")[-1]: ref.split(".")[-1]
+            for ref in revision.expression.parsed.fields
+        }
+    binding = Binding(
+        binding_id=store.new_id("bnd"),
+        revision_id=revision.revision_id,
+        workspace_id=workspace_id,
+        datasource_alias=alias,
+        datasource_ref=db_ref or "",
+        source_table=source_table,
+        column_map=column_map,
+        verify_status=BINDING_VERIFIED if db_ref else BINDING_UNBOUND,
+        verify_detail="" if db_ref else f"数据源别名 {alias!r} 未解析到已注册的 datasource",
+        verified_at=_now() if db_ref else "",
+        created_at=_now(),
+    )
+    store.create_binding(binding)
+    return binding
+
+
+def _previous_revision(metric: MetricDef) -> MetricRevision | None:
+    """指标当前生效修订；未发布时回退到最新一版。"""
+    if metric.current_revision_id:
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is not None:
+            return revision
+    revisions = store.list_revisions(metric.metric_id)
+    return revisions[0] if revisions else None
+
+
+def create_metric(
+    workspace_id: str,
+    payload: dict[str, Any],
+    *,
+    target_db_type: str = "",
+) -> dict[str, Any]:
+    """手动新建指标（身份 + 第一个 candidate 修订 + 绑定 + 依赖候选映射）。
+
+    Args:
+        workspace_id: 工作空间。
+        payload: ``{metric_key, name, description?, owner?, revision: {...},
+            binding: {...}}``；也接受口径字段平铺的写法。
+        target_db_type: 目标业务库类型（决定表达式方言偏好）。
+
+    Returns:
+        ``{"metric", "revision", "binding", "candidate_mappings"}``。
+
+    Raises:
+        DefinitionError: key/名称缺失、key 已存在、口径或绑定非法。
+    """
+    metric_key = str(payload.get("metric_key") or "").strip()
+    name = str(payload.get("name") or "").strip()
+    if not metric_key:
+        raise DefinitionError("metric_key 必填")
+    if not name:
+        raise DefinitionError("name 必填")
+    if store.get_def_by_key(workspace_id, metric_key) is not None:
+        raise DefinitionError(
+            f"指标 {metric_key} 已存在——改口径请新建修订，改名称请编辑指标")
+    metric = store.create_def(
+        workspace_id=workspace_id, metric_key=metric_key, name=name,
+        description=str(payload.get("description") or ""),
+        owner=str(payload.get("owner") or ""))
+    revision_payload = _revision_payload(payload)
+    revision = _build_revision(
+        workspace_id, metric_key, metric.metric_id, 1, revision_payload,
+        target_db_type=target_db_type, default_display_name=name)
+    store.create_revision(revision)
+    binding = _create_binding(workspace_id, revision, payload.get("binding"))
+    mappings = ossie_mod.candidate_mappings_for(
+        workspace_id, revision,
+        dependencies=revision.dependencies,
+        metric_type=revision.metric_type,
+        subject_iri=revision.subject_iri)
+    for mapping in mappings:
+        store.create_concept_map(mapping)
+    return {
+        "metric": metric,
+        "revision": revision,
+        "binding": binding,
+        "candidate_mappings": [m.mapping_id for m in mappings],
+    }
+
+
+def create_revision(
+    workspace_id: str,
+    metric_key: str,
+    payload: dict[str, Any],
+    *,
+    target_db_type: str = "",
+) -> dict[str, Any]:
+    """为既有指标新建 candidate 修订（口径变更的唯一入口）。
+
+    新修订继承上一修订的物理绑定（载荷未带绑定时）与已确认术语绑定，
+    并按 dependencies 重新生成候选映射。
+
+    Returns:
+        ``{"revision", "binding", "carried_term_maps", "candidate_mappings"}``。
+
+    Raises:
+        MetricNotFound: 指标不存在。
+        DefinitionError: 口径或绑定非法。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    previous = _previous_revision(metric)
+    revision = _build_revision(
+        workspace_id, metric_key, metric.metric_id,
+        store.next_revision_no(metric.metric_id), payload,
+        target_db_type=target_db_type,
+        default_display_name=(previous.display_name if previous else "") or metric.name,
+        previous=previous)
+    store.create_revision(revision)
+    store.touch_def(metric.metric_id)
+    binding = _create_binding(workspace_id, revision, payload.get("binding"))
+    if binding is None and previous is not None:
+        # 未显式带绑定 → 继承上一修订（新修订发布后仍能取数）
+        for old in store.list_bindings(previous.revision_id):
+            copied = replace(
+                old, binding_id=store.new_id("bnd"),
+                revision_id=revision.revision_id, created_at=_now())
+            store.create_binding(copied)
+            binding = binding or copied
+    mappings = ossie_mod.candidate_mappings_for(
+        workspace_id, revision,
+        dependencies=revision.dependencies,
+        metric_type=revision.metric_type,
+        subject_iri=revision.subject_iri)
+    for mapping in mappings:
+        store.create_concept_map(mapping)
+    carried = _carry_over_term_maps(workspace_id, metric_key, revision.revision_id)
+    return {
+        "revision": revision,
+        "binding": binding,
+        "carried_term_maps": carried,
+        "candidate_mappings": [m.mapping_id for m in mappings],
+    }
+
+
+def update_metric(
+    workspace_id: str, metric_key: str, payload: dict[str, Any]
+) -> MetricDef:
+    """更新指标身份的可变字段（name / description / owner）。
+
+    Raises:
+        MetricNotFound: 指标不存在。
+        DefinitionError: name 传了空值。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    name: str | None = None
+    if "name" in payload:
+        name = str(payload.get("name") or "").strip()
+        if not name:
+            raise DefinitionError("name 不能为空")
+    updated = store.update_def(
+        metric.metric_id,
+        name=name,
+        description=str(payload.get("description") or "")
+        if "description" in payload else None,
+        owner=str(payload.get("owner") or "") if "owner" in payload else None,
+    )
+    return updated or metric
+
+
+def delete_metric(
+    workspace_id: str, metric_key: str, *, force: bool = False
+) -> dict[str, Any]:
+    """删除指标并级联清理修订 / 绑定 / 候选映射。
+
+    已发布指标删除会影响在线取数与语义图，默认拒绝；``force=True`` 时删除
+    并尽力重投影（失败只汇报，不回滚删除——元数据库是真相源）。
+
+    Raises:
+        MetricNotFound: 指标不存在。
+        DefinitionError: 指标已发布且未传 force。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        raise MetricNotFound(f"指标 {metric_key} 不存在")
+    revisions = store.list_revisions(metric.metric_id)
+    published = any(rev.status == REVISION_PUBLISHED for rev in revisions)
+    if published and not force:
+        raise DefinitionError(
+            f"指标 {metric_key} 已发布，删除会影响在线取数与语义图投影；"
+            "确认影响后以 force=true 强制删除")
+    counts = {"revisions": 0, "bindings": 0, "mappings": 0}
+    for revision in revisions:
+        counts["bindings"] += store.delete_bindings_for_revision(revision.revision_id)
+        counts["mappings"] += store.delete_concept_maps_for_revision(revision.revision_id)
+    counts["revisions"] = store.delete_revisions_for_metric(metric.metric_id)
+    store.delete_def(metric.metric_id)
+    projection = {"status": "not_required", "detail": ""}
+    if published:
+        projection = _reproject_after_delete(workspace_id)
+    return {"metric_key": metric_key, **counts, "projection": projection}
+
+
+def _reproject_after_delete(workspace_id: str) -> dict[str, str]:
+    """删除已发布指标后尽力重投影，把图上的孤儿节点清掉。"""
+    try:
+        from . import graph_projection
+
+        outcome = graph_projection.reproject_workspace(workspace_id)
+        return {
+            "status": "ok",
+            "detail": f"重投影完成：{outcome.get('node_count', 0)} 节点 /"
+                      f"{outcome.get('edge_count', 0)} 边",
+        }
+    except Exception as exc:  # noqa: BLE001 —— 投影失败不阻断删除（可手动重投影）
+        return {"status": "failed", "detail": str(exc)[:300]}
+
+
+# ==========================================================================
+# 发布
+# ==========================================================================
+def publish_release(
+    workspace_id: str,
+    revision_ids: list[str],
+    *,
+    label: str = "",
+    published_by: str = "",
+    require_binding_verified: bool = True,
+    graph_adapter: Any = None,
+) -> Release:
+    """把一批修订发布成新 release 并投影到 Neo4j 指标图。
+
+    Args:
+        workspace_id: 工作空间。
+        revision_ids: 参与发布的修订 ID。
+        label: 发布说明。
+        published_by: 发布人。
+        require_binding_verified: 是否要求绑定已 ``verified``。首装演练可关。
+        graph_adapter: Neo4j 图适配器（同事 ``SemanticaAdapter`` 协议）；
+            None 从环境构造（``SEMANTICA_*``），单测注入 InMemory 替身。
+
+    Returns:
+        发布成功后的 :class:`~.model.Release`。Neo4j 不可用时返回的 release
+        ``projection_status="failed"``（发布本身成功，可 reproject 重试）。
+
+    Raises:
+        MetricNotFound: 修订不存在。
+        DefinitionError: 修订校验失败（缺表达式/绑定未 verified 等）。
+    """
+    from . import graph_projection, semantic_link
+
+    revisions = store.list_revisions_by_ids(revision_ids)
+    found = {r.revision_id for r in revisions}
+    missing = [rid for rid in revision_ids if rid not in found]
+    if missing:
+        raise MetricNotFound(f"修订不存在: {', '.join(missing)}")
+    for rev in revisions:
+        rev.validate()
+        if rev.metric_type == METRIC_TYPE_ATOMIC and require_binding_verified:
+            bindings = store.list_bindings(rev.revision_id)
+            if not bindings or not any(b.verify_status == "verified" for b in bindings):
+                raise DefinitionError(
+                    f"修订 {rev.definition_ref} 的绑定未 verified，不能发布"
+                    "（先 resolve 绑定或确认数据源别名）")
+
+    defs_by_id = {d.metric_id: d for d in store.list_defs(workspace_id)}
+    # 发布前补继承：被发布的修订若没有术语绑定，从该指标其他修订继承已确认的。
+    # 闭掉顺序漏洞——「已发布 rev1 → 导入产生 rev2 草稿 → 此时绑定术语（落在
+    # current=rev1）→ 发布 rev2」会让 rev2 没有绑定、链在分析侧断掉，而界面
+    # 读 rev1 仍显示「已绑定」，断了也看不出来。
+    for rev in revisions:
+        metric_def = defs_by_id.get(rev.metric_id)
+        if metric_def is not None:
+            _carry_over_term_maps(workspace_id, metric_def.metric_key, rev.revision_id)
+    bindings_by_revision: dict[str, list[Binding]] = {}
+    for rev in revisions:
+        bindings_by_revision[rev.revision_id] = store.list_bindings(rev.revision_id)
+    confirmed_maps = store.list_confirmed_maps(revision_ids)
+
+    # 绑定校验走语义层快照（严格单一通道）：未采集/漂移 → warning + 绑定
+    # 回写 failed，发布不阻断（倒逼先采集）
+    schema_warnings: list[str] = []
+    semantic_refs = semantic_link.ensure_semantic_refs(
+        workspace_id, bindings_by_revision, schema_warnings)
+
+    # 先建 release 行（draft），投影失败也留痕
+    release_id = store.new_id("release")
+    release = Release(
+        release_id=release_id,
+        workspace_id=workspace_id, label=label, status=RELEASE_DRAFT,
+        revision_ids=tuple(revision_ids),
+        checksum=_release_checksum(revisions, confirmed_maps),
+        projection_graph=graph_projection.metrics_namespace(workspace_id),
+        manifest=_release_manifest(semantic_refs, schema_warnings),
+    )
+    store.create_release(release)
+
+    # Neo4j 投影：元数据库是真相源，投影失败只标 projection_status=failed
+    # （可 reproject 重试），不回滚发布
+    projection_outcome = _project_metric_graph(
+        workspace_id, release, revisions, defs_by_id, bindings_by_revision,
+        confirmed_maps, graph_adapter=graph_adapter)
+    projection_status = projection_outcome["status"]
+    error_code = projection_outcome.get("error_code", "")
+    error_message = projection_outcome.get("error_message", "")
+
+    # 成功：修订标 published、其他 release revoke、指标指向当前修订
+    now_revisions_published(revision_ids)
+    store.revoke_other_releases(workspace_id, release.release_id)
+    store.update_release(
+        release.release_id, status=RELEASE_PUBLISHED,
+        projection_status=projection_status,
+        error_code=error_code or None, error_message=error_message or None,
+        projected_at=store._now() if projection_status == "published" else None,
+        published_at=store._now(), published_by=published_by or "")
+    for rev in revisions:
+        store.set_current_revision(rev.metric_id, rev.revision_id)
+    return replace(
+        release, status=RELEASE_PUBLISHED, projection_status=projection_status,
+        published_by=published_by or "")
+
+
+def _project_metric_graph(
+    workspace_id: str,
+    release: Release,
+    revisions: list[MetricRevision],
+    defs_by_id: dict[str, MetricDef],
+    bindings_by_revision: dict[str, list[Binding]],
+    confirmed_maps: list[ConceptMapping],
+    *,
+    graph_adapter: Any,
+) -> dict:
+    """执行 Neo4j 投影并消化一切失败（返回 status/error_*，不抛）。"""
+    from . import graph_projection, semantic_link
+
+    try:
+        adapter = graph_adapter
+        if adapter is None:
+            from ..semantic.semantica import from_environment
+
+            adapter = from_environment()
+        _refs, snapshots = semantic_link.current_snapshots()
+        graph_projection.publish_metric_graph(
+            workspace_id, release, revisions, defs_by_id, bindings_by_revision,
+            confirmed_maps, _supersedes_map(workspace_id, revisions),
+            snapshots, adapter=adapter)
+        return {"status": "published"}
+    except Exception as exc:  # noqa: BLE001 —— 投影失败不阻断发布（真相源=元数据库）
+        return {"status": "failed",
+                "error_code": getattr(exc, "code", "PROJECTION_FAILED"),
+                "error_message": f"{type(exc).__name__}: {exc}"[:1000]}
+
+
+def now_revisions_published(revision_ids: list[str]) -> None:
+    """把修订状态推进到 published。"""
+    for revision_id in revision_ids:
+        store.update_revision_status(revision_id, REVISION_PUBLISHED)
+
+
+def get_release_revisions(release: Release) -> list[MetricRevision]:
+    """取 release 内的全部修订。"""
+    return store.list_revisions_by_ids(list(release.revision_ids))
+
+
+def _release_manifest(
+    semantic_refs: list[dict[str, str]], schema_warnings: list[str],
+) -> dict:
+    """release manifest：钉定语义快照 refs 与绑定校验警告（深集成结构）。"""
+    manifest: dict = {"semantic_refs": semantic_refs}
+    if schema_warnings:
+        manifest["schema_warnings"] = list(schema_warnings)
+    return manifest
+
+
+def _release_checksum(revisions: list[MetricRevision], confirmed_maps: list[ConceptMapping]) -> str:
+    """release 级校验和：修订哈希 + 确认映射的规范化摘要。"""
+    payload = {
+        "revisions": sorted(r.definition_hash for r in revisions),
+        "confirmed_maps": sorted(
+            f"{m.revision_id}|{m.relation_type}|{m.target_ref}" for m in confirmed_maps),
+    }
+    return sha256_of(canonical_json(payload))
+
+
+def _supersedes_map(workspace_id: str, revisions: list[MetricRevision]) -> dict[str, str]:
+    """为每个修订找上一个 published 修订的 definition_ref（版本链）。
+
+    单节点投影形态下版本链是节点属性 ``supersedesRef``（metric IRI 跨 release
+    稳定，supersedes 边会退化成自环）；``workspace_id`` 保留以维持调用签名。
+    """
+    out: dict[str, str] = {}
+    for rev in revisions:
+        for prev in store.list_revisions(rev.metric_id):
+            if prev.revision_id == rev.revision_id or prev.status != REVISION_PUBLISHED:
+                continue
+            if prev.revision_no < rev.revision_no:
+                out[rev.revision_id] = prev.definition_ref
+    return out
+
+
+def _key_of(rev: MetricRevision) -> str:
+    """从 definition_ref 还原 metric_key。"""
+    ref = rev.definition_ref or ""
+    if "@" in ref:
+        head = ref.split("@", 1)[0]
+        parts = head.split(":")
+        if len(parts) >= 4:
+            return ":".join(parts[3:])
+    return ref
