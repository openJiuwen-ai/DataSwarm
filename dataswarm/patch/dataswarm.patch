+def test_catalog_scores_and_threshold(published):
+    """三路合并打分：图路可用时正常命中 > 0.60；问题无关时触发澄清。"""
+    catalog = build_catalog("支付客单价", WORKSPACE)
+    assert not catalog.needs_clarification
+    assert catalog.entries[0].metric_key == AOV
+    assert catalog.entries[0].confidence >= 0.60
+    assert catalog.entries[0].score > 0
+    assert AOV in catalog.keys
+
+    unrelated = build_catalog("库存周转天数怎么算", WORKSPACE)
+    assert unrelated.needs_clarification
+    # 无关问题走空召回分支，同样必须澄清而非猜测
+    assert "没有召回" in unrelated.clarification or "置信度不足" in unrelated.clarification
