+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { Finding } from '../../types/inspection';
+import { Empty as SharedEmpty } from '../../../_shared/ui/Ui';
+
+/**
+ * 治理模块共享 UI 原语。
+ *   Panel/Empty —— 统一收敛到 _shared/ui（跨模块一致）；Panel 保留治理签名：
+ *                 顶边墨色 2px 描边（.gov-panel），气质区别于通用卡片但骨架同源。
+ *   Kpi         —— 仪表卡：tone 决定左脊色 + 大号等宽读数 + 可选严重度分布细条
+ *   FindingList —— finding 行：定宽 severity 标签 + 等宽 ID
+ */
+
+export function Panel({
+  title,
+  mark,
+  children,
+  className = '',
+}: {
+  title?: string;
+  /** 标题右侧的等宽小注（如计数、单位），只标事实不做说明性文案 */
+  mark?: string;
+  children: React.ReactNode;
+  className?: string;
+}) {
+  return (
+    <section className={`gov-panel ${className}`}>
+      {title && (
+        <h2 className="gov-panel-title">
+          {title}
+          {mark && <span className="gov-panel-mark">{mark}</span>}
+        </h2>
+      )}
+      {children}
+    </section>
+  );
+}
+
+export function Empty({ text = '暂无数据' }: { text?: string }) {
+  return <SharedEmpty text={text} />;
+}
+
+/** Kpi 仪表卡的严重度分布：high/medium/其余 三段细条。 */
+export type SeverityMeter = { high: number; medium: number; total: number };
+
+export function Kpi({
+  label,
+  labelKey,
+  icon,
+  kind,
+  value,
+  hint,
+  tone = 'neutral',
+  meter,
+}: {
+  label: string;
+  /** 眉题等宽短注（维度拉丁名 / 分层键） */
+  labelKey?: string;
+  icon?: React.ReactNode;
+  kind?: 'schema' | 'quality' | 'lineage' | 'metric' | 'task';
+  value: string | number;
+  hint?: string;
+  tone?: 'danger' | 'warn' | 'neutral' | 'info';
+  meter?: SeverityMeter;
+}) {
+  const rest = meter ? Math.max(0, meter.total - meter.high - meter.medium) : 0;
+  const tot = meter && meter.total > 0 ? meter.total : 0;
+  const w = (n: number) => (tot ? `${(n / tot) * 100}%` : '0%');
+  return (
+    <div className="gov-kpi" data-tone={tone} data-kind={kind}>
+      <div className="gov-kpi-label">
+        <span className="gov-kpi-name">
+          {icon}
+          {label}
+        </span>
+        {labelKey && <span className="gov-kpi-key">{labelKey}</span>}
+      </div>
+      <div className="gov-kpi-reading">
+        <div className="gov-kpi-value">{value}</div>
+        {hint && <div className="gov-kpi-hint">{hint}</div>}
+      </div>
+      {meter && tot > 0 && (
+        <div className="gov-kpi-meter" aria-hidden="true">
+          <i style={{ width: w(meter.high) }} />
+          <i style={{ width: w(meter.medium) }} />
+          <i style={{ width: w(rest) }} />
+        </div>
+      )}
+    </div>
+  );
+}
+
+export function FindingList({ findings, limit }: { findings: Finding[]; limit?: number }) {
+  if (!findings.length) return <Empty text="当前维度没有 findings" />;
+  const shown = limit != null ? findings.slice(0, limit) : findings;
+  return (
+    <div>
+      {shown.map(finding => (
+        <article key={`${finding.category}-${finding.id}-${finding.summary}`} className="gov-finding">
+          <div className="gov-finding-head flex-wrap">
+            <span className="gov-finding-id">{finding.id}</span>
+            <span className="gov-tag" data-sev={finding.severity}>
+              {finding.severity}
+            </span>
+            <span className="gov-cat">{finding.category}</span>
+            <span className="gov-finding-summary">{finding.summary}</span>
+            {finding.ai_summary && <span className="gov-ai-badge" title={finding.ai_summary}>AI</span>}
+          </div>
+          {finding.detail && <p className="gov-finding-detail">{finding.detail}</p>}
+          {finding.ai_summary && <p className="gov-ai-finding">{finding.ai_summary}</p>}
+        </article>
+      ))}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/governance/components/shared/flowLanes.tsx b/jiuwenswarm/channels/web/frontend/src/features/governance/components/shared/flowLanes.tsx
