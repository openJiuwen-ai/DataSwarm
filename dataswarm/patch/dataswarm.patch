+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/semantic_link/scoring.py —— 检索词构造与打分（search_terms / metric_table_scores）（自 semantic_link.py 保守拆分，纯搬运）。
+
+模块定位见包门面 docstring（semantic_link/__init__.py）。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Sequence
+
+from .. import store
+from ..model import Release
+
+
+
+SCHEMA_LABEL_SCORE = 0.80
+SCHEMA_COMMENT_SCORE = 0.40
+EXACT_BONUS = 0.15
+
+
+# ==========================================================================
+# 检索词与打分（口径自 context.py / transport 迁入，语义不变）
+# ==========================================================================
+
+def search_terms(question: str, cap: int = 12,
+                 extra_terms: Sequence[str] = ()) -> list[str]:
+    """图/schema 两路共用的检索词：分词 → 去数字与日期残片 → 去重保序 → 截断。
+
+    截断前必须先去日期残片：「2026年8月各地区支付客单价」的前 8 个 2-gram
+    全是日期碎片（20/02/26/6年/年8/8月/月各/各地），真词（支付/客单/单价）
+    被 cap 挤掉 → 召回对带日期的句子问法恒为零（实测事故，单测问句不带
+    日期所以没抓到）。
+
+    ``extra_terms`` 是术语扩展词（glossary 命中的规范名/别名）：整词进检索
+    （不切 2-gram，整词子串命中 label 更准），并保留最多 3 席不被问题
+    分词挤掉——弱扩展不如不扩展，但强术语词被 cap 截掉等于白桥接。
+    """
+    def _keep(tokens: Sequence[str]) -> list[str]:
+        out: list[str] = []
+        for token in tokens:
+            if token.isdigit():
+                continue
+            if len(token) == 2 and any(ch.isdigit() for ch in token):
+                continue  # 「6年」「8月」「20」类日期残片
+            if token not in out:
+                out.append(token)
+        return out
+
+    extras = _keep(extra_terms)[:3]
+    base = _keep(store._tokenize(question))[:max(cap - len(extras), 1)]
+    terms: list[str] = []
+    for token in (*base, *extras):
+        if token not in terms:
+            terms.append(token)
+    return terms[:cap]
+
+
+def _match_score(value: str, terms: list[str], base: float) -> float:
+    """子串匹配打分：包含命中取 base，精确全等 +EXACT_BONUS（上限 1.0）。"""
+    lowered = (value or "").strip().lower()
+    if not lowered:
+        return 0.0
+    for term in terms:
+        if term in lowered:
+            score = base
+            if lowered == term:
+                score = min(1.0, base + EXACT_BONUS)
+            return score
+    return 0.0
+
+
+def metric_table_scores(
+    workspace_id: str, question: str, *, release: Release | None,
+    extra_terms: Sequence[str] = (),
+) -> dict[str, tuple[float, list[str]]]:
+    """图通道的表实现：published 修订分词匹配 → ``metric_key -> (score, matched_on)``。
+
+    替代旧 SPARQL ``search_candidates``（Metric/MetricRevision 节点），
+    打分刻度严格对齐 ``transport._MATCH_SCORES``。release 给定只在批内
+    修订中匹配（旧图 release 作用域）；无 release 匹配全部 published 当前修订。
+    ``extra_terms`` 为术语扩展词（整词注入，见 :func:`search_terms`）。
+    """
+    from .. import semantic_link as _facade  # 互调经包门面：保 patch 锚语义（见 __init__ docstring）
+    terms = _facade.search_terms(question, extra_terms=extra_terms)
+    if not terms:
+        return {}
+    revisions = _scoped_revisions(workspace_id, release)
+    defs = {d.metric_id: d for d in store.list_defs(workspace_id)}
+    out: dict[str, tuple[float, list[str]]] = {}
+    for revision in revisions:
+        metric_def = defs.get(revision.metric_id)
+        if metric_def is None:
+            continue
+        fields: dict[str, str] = {
+            "metric_key": metric_def.metric_key,
+            "display_name": revision.display_name or metric_def.name,
+            "description": metric_def.description or "",
+        }
+        best_score = 0.0
+        matched: list[str] = []
+        for name, value in fields.items():
+            base = METRIC_MATCH_SCORES[name]
+            score = _match_score(value, terms, base)
+            if score > 0:
+                if score > best_score:
+                    best_score = score
+                if name not in matched:
+                    matched.append(name)
+        for synonym in revision.synonyms:
+            score = _match_score(synonym, terms, METRIC_MATCH_SCORES["synonym"])
+            if score > 0:
+                if score > best_score:
+                    best_score = score
+                if "synonym" not in matched:
+                    matched.append("synonym")
+        if best_score > 0:
+            out[metric_def.metric_key] = (best_score, matched)
+    return out
+
+
+def _scoped_revisions(workspace_id: str, release: Release | None) -> list[Any]:
+    """release 作用域内的 published 修订；无 release 取全部当前生效。
+
+    无 release 分支走 ``store.list_effective_published`` 单一出处（E6 收敛，
+    archived 感知——归档指标不再混入候选）；release 分支是**历史 release
+    成员视图**（该 release 携带过哪些 published 修订），不属「当前生效」
+    判定，保持按修订自身状态过滤。
+    """
+    from ..model import REVISION_PUBLISHED
+
+    if release is not None:
+        out: list[Any] = []
+        for revision_id in release.revision_ids:
+            revision = store.get_revision(revision_id)
+            if revision is not None and revision.status == REVISION_PUBLISHED:
+                out.append(revision)
+        return out
+    return [revision for _metric, revision in store.list_effective_published(workspace_id)]
+
+
+METRIC_MATCH_SCORES: dict[str, float] = {
+    "metric_key": 1.00,
+    "display_name": 0.80,
+    "synonym": 0.75,
+    "description": 0.40,
+}
+# schema 侧（旧 schema 图节点：label = comment or name；谓词 label/comment）
