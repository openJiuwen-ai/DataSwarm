+        f"/api/dataagent/databases/{quote(ref, safe='')}/tables/{quote(table, safe='')}"
+        "/preview?workspace_id=test&offset=10&limit=5"
+    )
+    seen = []
+    monkeypatch.setattr(ctrl, "_resolve_workspace", lambda workspace_id: SimpleNamespace(workspace_id=workspace_id))
+
+    def validate(*args):
+        seen.append(args)
+        return args[-1]
+    monkeypatch.setattr(ctrl, "validate_ref_in_workspace", validate)
+    monkeypatch.setattr(ctrl.svc, "preview_table", lambda *args: {"arguments": args})
+
+    class Handler:
+        _query_arg = staticmethod(lambda parsed, key: (parse_qs(parsed.query).get(key) or [""])[0])
+
+        def _write_json(self, status, body):
+            self.response = status, body
+
+    handler = Handler()
+    ctrl.handle_get(handler, urlparse(url))
+    assert seen == [("test", "business", ref)]
+    assert handler.response == (200, {"arguments": (ref, table, 5, 10)})
