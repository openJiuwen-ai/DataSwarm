diff --git a/tests/acceptance/datasource/run_validation.py b/tests/acceptance/datasource/run_validation.py
new file mode 100644
index 000000000..fc762307a
--- /dev/null
+++ b/tests/acceptance/datasource/run_validation.py
@@ -0,0 +1,276 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Run selected acceptance batches with one Python interpreter from the repo root.
+
+Usage: python tests/acceptance/datasource/run_validation.py [--batches 1,3,7,12,13]
+Supported batches: 1, 3, 4, 7, 11, 12, 13, 16, 17. Defaults are offline 1/3/7,
+owned SFTP 12 and prepared LocalDB 13; batch13 requires setup_localdb.py first.
+Batch4 needs the dedicated loopback FTP fixture; batch11 needs prepared WebHDFS.
+Batches 16/17 require --redis-server or redis-server on PATH. Missing Redis blocks
+before fixture generation or batch startup. Owned peers are stopped on exit;
+no software is installed. Reports distinguish failures, blockers and boundaries.
+"""
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timezone
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+OUTPUT = ROOT / "artifact" / "datasource-validation"
+SUPPORTED = (1, 3, 4, 7, 11, 12, 13, 16, 17)
+DEFAULT_BATCHES = (1, 3, 7, 12, 13)
+FIXTURE_FILES = ("fact_orders.csv", "fact_orders.json", "fact_orders.parquet")
+
+
+def parse_batches(value: str) -> tuple[int, ...]:
+    try:
+        batches = tuple(int(item.strip()) for item in value.split(","))
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("Use comma-separated batch numbers, e.g. 1,3,7,12,13") from exc
+    if not batches or len(set(batches)) != len(batches):
+        raise argparse.ArgumentTypeError("Choose each batch at most once")
+    unsupported = sorted(set(batches) - set(SUPPORTED))
+    if unsupported:
+        raise argparse.ArgumentTypeError(
+            f"Unsupported batches {unsupported}; supported: {SUPPORTED}; run others manually")
+    return batches
+
+
+def port_number(value: str) -> int:
+    number = int(value)
+    if not 1 <= number <= 65535:
+        raise argparse.ArgumentTypeError("Port must be between 1 and 65535")
+    return number
+
+
+def parser() -> argparse.ArgumentParser:
+    result = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    result.add_argument("--batches", type=parse_batches, default=DEFAULT_BATCHES,
+                        help="Comma-separated batches; default: 1,3,7,12,13")
+    result.add_argument("--fixture-dir", type=Path, default=OUTPUT / "fixture")
+    result.add_argument("--ftp-port", type=port_number, default=2121)
+    result.add_argument("--redis-server", type=Path, default=shutil.which("redis-server"),
+                        help="Existing Redis executable; defaults to redis-server on PATH")
+    result.add_argument("--ftp-root", type=Path, default=OUTPUT / "ftp-root",
+                        help="Local root of the already-running acceptance FTP server")
+    result.add_argument("--hdfs-port", type=port_number, default=9870)
+    result.add_argument("--hdfs-user", default=os.environ.get("USERNAME") or os.environ.get("USER") or "hdfs")
+    result.add_argument("--timeout", type=float, default=300,
+                        help="Seconds allowed per batch; default: 300")
+    return result
+
+
+def parse_counts(output: str) -> dict | None:
+    machine = re.findall(r"^GATE_TOTALS:\s*([^\r\n]*)", output, re.MULTILINE)
+    if machine:
+        try:
+            counts = json.loads(machine[-1])
+        except (TypeError, ValueError):
+            return None
+        fields = ("passed", "failed", "blocked", "boundaries")
+        if not isinstance(counts, dict) or any(type(counts.get(key)) is not int or counts[key] < 0 for key in fields):
+            return None
+        return {key: counts[key] for key in fields}
+    chinese = list(re.finditer(r"通过\s*(\d+)\s*项[，,]\s*失败\s*(\d+)\s*项[，,]\s*阻断\s*(\d+)\s*项", output))
+    if chinese:
+        passed, failed, blocked = map(int, chinese[-1].groups())
+        return {"passed": passed, "failed": failed, "blocked": blocked, "boundaries": 0}
+    english = list(re.finditer(r"Passed\s+(\d+);\s*failed\s+(\d+);\s*boundaries\s+(\d+)", output, re.IGNORECASE))
+    if english:
+        passed, failed, boundaries = map(int, english[-1].groups())
+        return {"passed": passed, "failed": failed, "blocked": 0, "boundaries": boundaries}
+    return None
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _stop_process_tree(process: subprocess.Popen, log) -> dict:
+    """Terminate only this invocation's tree, retaining diagnostics on failure."""
+    windows = os.name == "nt"
+    cleanup = {"method": "taskkill /PID /T /F" if windows else "killpg SIGKILL",
+               "target_pid": process.pid, "termination_sent": False, "parent_stopped": False,
+               "status": "failed"}
+    try:
+        if windows:
+            # Kill the tree before reaping/killing the parent: taskkill needs its
+            # live parent PID to identify children (e.g. a batch-owned Redis).
+            taskkill = Path(os.environ.get("SystemRoot", "C:/Windows")) / "System32" / "taskkill.exe"
+            stopped = subprocess.run([str(taskkill), "/PID", str(process.pid), "/T", "/F"],
+                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                     timeout=15, check=False, creationflags=subprocess.CREATE_NO_WINDOW)
+            cleanup["command_exit_code"] = stopped.returncode
+            cleanup["detail"] = stopped.stdout.decode(errors="replace").strip()
+            cleanup["termination_sent"] = stopped.returncode == 0
+        else:
+            # Popen uses start_new_session=True below; this group cannot include
+            # the runner or unrelated caller processes.
+            os.killpg(process.pid, signal.SIGKILL)
+            cleanup["termination_sent"] = True
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        cleanup["detail"] = f"{type(exc).__name__}: {exc}"
+    try:
+        process.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        # Still reap the direct child if tree cleanup failed, without falsely
+        # claiming that its descendants were terminated.
+        try:
+            process.kill()
+            process.wait(timeout=5)
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            cleanup["parent_error"] = f"{type(exc).__name__}: {exc}"
+    cleanup["parent_stopped"] = process.poll() is not None
+    if cleanup["termination_sent"] and cleanup["parent_stopped"]:
+        cleanup["status"] = "complete"
+    log.write("\n[RUNNER CLEANUP] " + json.dumps(cleanup, ensure_ascii=False) + "\n")
+    log.flush()
+    return cleanup
+
+
+def run_process(command: list[str], log_path: Path, env: dict, timeout: float) -> dict:
+    start = time.monotonic()
+    record = {"command": command, "started_at_utc": utc_now(), "log_path": str(log_path),
+              "exit_code": None, "execution_error": None, "timeout_cleanup": None}
+    with log_path.open("w", encoding="utf-8") as log:
+        try:
+            launch = {"creationflags": subprocess.CREATE_NO_WINDOW} if os.name == "nt" else {"start_new_session": True}
+            process = subprocess.Popen(command, cwd=ROOT, env=env, stdout=log,
+                                       stderr=subprocess.STDOUT, **launch)
+            record["exit_code"] = process.wait(timeout=timeout)
+        except subprocess.TimeoutExpired:
+            record["execution_error"] = f"Timed out after {timeout:g} seconds"
+            log.write(f"\n[RUNNER ERROR] {record['execution_error']}\n")
+            log.flush()
+            record["timeout_cleanup"] = _stop_process_tree(process, log)
+            record["exit_code"] = process.returncode
+            if record["timeout_cleanup"]["status"] != "complete":
+                record["execution_error"] += "; process-tree cleanup was not confirmed; inspect timeout_cleanup"
+        except OSError as exc:
+            record["execution_error"] = f"{type(exc).__name__}: {exc}"
+            log.write(f"\n[RUNNER ERROR] {record['execution_error']}\n")
+    record["finished_at_utc"] = utc_now()
+    record["duration_seconds"] = round(time.monotonic() - start, 3)
+    return record
+
+
+def batch_command(batch: int, args: argparse.Namespace) -> list[str]:
+    command = [sys.executable, str(HERE / f"batch{batch}" / "verify_gates.py")]
+    if batch in (1, 12, 13):
+        command.append(str(args.fixture_dir))
+    elif batch == 4:
+        command += [str(args.ftp_port), str(args.ftp_root)]
+    elif batch == 11:
+        command += [str(args.hdfs_port), str(args.fixture_dir), args.hdfs_user]
+    elif batch == 16:
+        command += ["--fixture", str(args.fixture_dir / "fact_orders.csv")]
+    elif batch == 17:
+        command += ["--fixture-dir", str(args.fixture_dir)]
+    if batch in (16, 17) and args.redis_server is not None:
+        command += ["--redis-server", str(args.redis_server)]
+    return command
+
+
+def write_summary(summary: dict) -> Path:
+    output = OUTPUT / "validation-summary.json"
+    output.write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding="utf-8")
+    return output
+
+
+def main(argv: list[str] | None = None) -> int:
+    argument_parser = parser()
+    args = argument_parser.parse_args(argv)
+    if args.timeout <= 0:
+        argument_parser.error("--timeout must be positive")
+    args.fixture_dir = args.fixture_dir.resolve()
+    args.ftp_root = args.ftp_root.resolve()
+    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
+    logs = OUTPUT / "logs" / run_id
+    logs.mkdir(parents=True, exist_ok=False)
+    start = time.monotonic()
+    summary = {"run_id": run_id, "started_at_utc": utc_now(), "python": sys.executable,
+               "invocation": [sys.executable, str(Path(__file__).resolve()), *(sys.argv[1:] if argv is None else argv)],
+               "selected_batches": list(args.batches), "fixture_dir": str(args.fixture_dir),
+               "fixture_generation": None, "batches": [], "successful": False,
+               "notes": ["Blocked checks and coverage boundaries are reported separately from failed checks.",
+                         "Counts describe checks, not unique datasource types; historical batches can overlap.",
+                         ("Batches 12, 16 and 17 start and stop their own temporary test peers; "
+                          "other services must already exist."),
+                         "Only batches with declared local prerequisites are supported by this runner."]}
+    env = dict(os.environ, PYTHONUTF8="1", PYTHONIOENCODING="utf-8")
+    redis_batches = [batch for batch in args.batches if batch in (16, 17)]
+    if redis_batches and (args.redis_server is None or not args.redis_server.is_file()):
+        detail = "Provide --redis-server or put an existing redis-server executable on PATH; no batches were started."
+        summary["batches"] = [
+            {"batch": batch, "counts": {"passed": 0, "failed": 0, "blocked": 1, "boundaries": 0},
+             "successful": False, "exit_code": 2, "execution_error": None, "prerequisite": detail}
+            for batch in redis_batches
+        ]
+        summary.update(finished_at_utc=utc_now(), duration_seconds=round(time.monotonic() - start, 3),
+                       execution_errors=0,
+                       totals={"passed": 0, "failed": 0, "blocked": len(redis_batches), "boundaries": 0})
+        location = write_summary(summary)
+        print(f"[BLOCKED] {detail}\nSummary: {location}")
+        return 2
+    if not all((args.fixture_dir / name).is_file() for name in FIXTURE_FILES):
+        print(f"Generating fixture: {args.fixture_dir}", flush=True)
+        command = [sys.executable, "-I", str(HERE / "batch1" / "make_fixture.py"), str(args.fixture_dir)]
+        setup = run_process(command, logs / "fixture-generation.log", env, args.timeout)
+        summary["fixture_generation"] = setup
+        if setup["exit_code"] != 0 or setup["execution_error"]:
+            summary.update(finished_at_utc=utc_now(), duration_seconds=round(time.monotonic() - start, 3),
+                           execution_errors=1, totals={"passed": 0, "failed": 0, "blocked": 0, "boundaries": 0})
+            location = write_summary(summary)
+            print(f"Fixture generation failed; see {setup['log_path']}\nSummary: {location}")
+            return 1
+    for batch in args.batches:
+        command = batch_command(batch, args)
+        batch_env = dict(env)
+        batch_env["JIUWENSWARM_STAGED_CACHE"] = str(OUTPUT / "runner-cache" / f"batch{batch}")
+        if batch == 4:
+            # Match the fixed, local-only credentials declared by batch4 itself.
+            batch_env.update(FTP_USER="dsuser", FTP_PASSWORD="dspass", DATASOURCE_ACCEPTANCE_PROTOCOL="ftp")
+        elif batch == 11:
+            batch_env["WEBHDFS_USER"] = args.hdfs_user
+        print(f"Running batch {batch} ...", flush=True)
+        record = run_process(command, logs / f"batch{batch}.log", batch_env, args.timeout)
+        record["batch"] = batch
+        content = Path(record["log_path"]).read_text(encoding="utf-8", errors="replace")
+        record["counts"] = parse_counts(content)
+        if record["counts"] is None and not record["execution_error"]:
+            record["execution_error"] = "No recognized completed gate summary; inspect the log"
+        record["successful"] = (record["exit_code"] == 0 and not record["execution_error"]
+                                and record["counts"] is not None and record["counts"]["failed"] == 0)
+        summary["batches"].append(record)
+        if record["counts"] is not None:
+            counts = record["counts"]
+            print(f"Batch {batch}: exit={record['exit_code']} passed={counts['passed']} failed={counts['failed']} "
+                  f"blocked={counts['blocked']} boundaries={counts['boundaries']} "
+                  f"({record['duration_seconds']:.2f}s)", flush=True)
+        else:
+            print(f"Batch {batch}: FAILED, exit={record['exit_code']}; {record['execution_error']}", flush=True)
+    summary["totals"] = {key: sum((r["counts"] or {}).get(key, 0) for r in summary["batches"])
+                         for key in ("passed", "failed", "blocked", "boundaries")}
+    summary["execution_errors"] = sum(bool(r["execution_error"])
+                                      or (r["exit_code"] != 0 and not (r["counts"] or {}).get("failed"))
+                                       for r in summary["batches"])
+    summary["successful"] = all(record["successful"] for record in summary["batches"])
+    summary["finished_at_utc"] = utc_now()
+    summary["duration_seconds"] = round(time.monotonic() - start, 3)
+    location = write_summary(summary)
+    print(f"Totals: {json.dumps(summary['totals'])}; execution_errors={summary['execution_errors']}")
+    print(f"Summary: {location}")
+    return 0 if summary["successful"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
