+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_layer.py —— 数仓表分层推断唯一真相源（dialect-convergence 批次 1b G4）。
+
+此前 6 处服务端副本（databases/service、business_data 三实现、meta_data 两
+store、lineage/service）各自维护同一份前缀映射；收口到 jiuwenswarm.common
+后各处 import 本函数。
+"""
+from __future__ import annotations
+
+_LAYER_PREFIXES = (
+    ("dwd_", "DWD"),
+    ("dws_", "DWS"),
+    ("ads_", "ADS"),
+    ("ods_", "ODS"),
+)
+
+
+def infer_layer(table_name: str) -> str:
+    """按表名前缀推分层（ods_/dwd_/dws_/ads_ → 大写层名，其余 OTHER）。"""
+    low = table_name.lower()
+    for prefix, layer in _LAYER_PREFIXES:
+        if low.startswith(prefix):
+            return layer
+    return "OTHER"
