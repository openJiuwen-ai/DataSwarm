+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage writer.ensure_schema 幂等加列契约单测。
+
+历史背景：task_id / business_ref 原先由 store 的 _ADD_COLUMNS 兜底（2026-08-31
+schema 收编时已删）。现存库的缺列补齐收敛到 writer.ensure_schema——本测试
+验证它对 lineage 两表的 task_id / business_ref 缺列会发 ALTER（契约测试，
+mock db_connector，不跑真 ALTER）。
+"""
+from __future__ import annotations
+
+from jiuwenswarm.channels.web.orchestration.lineage import writer
+
+
+class _FakeDbConnector:
+    """替身 db_connector：按表返回现有列，记录 ALTER 语句。"""
+
+    def __init__(self, existing: dict[str, list[str]]):
+        self._existing = existing
+        self.alter_calls: list[str] = []
+
+    def schema(self, db_ref, table):
+        return {"columns": [{"name": c} for c in self._existing.get(table, [])]}
+
+    def execute(self, db_ref, sql, *args, **kw):
+        self.alter_calls.append(sql)
+
+
+def _patch_connector(monkeypatch, existing):
+    fake = _FakeDbConnector(existing)
+    import jiuwenswarm.common.db_connector as mod
+
+    monkeypatch.setattr(mod, "schema", fake.schema)
+    monkeypatch.setattr(mod, "execute", fake.execute)
+    return fake
+
+
+def test_ensure_schema_adds_missing_columns(monkeypatch):
+    """两表缺 task_id / business_ref 时各发对应 ALTER。"""
+    fake = _patch_connector(monkeypatch, {
+        "table_lineage": ["lineage_id"],
+        "column_lineage": ["column_lineage_id"],
+    })
+    writer.ensure_schema("sqlite://meta.db")
+    added = {c for c in fake.alter_calls}
+    assert any("table_lineage" in c and "task_id" in c for c in added)
+    assert any("table_lineage" in c and "business_ref" in c for c in added)
+    assert any("column_lineage" in c and "task_id" in c for c in added)
+    assert any("column_lineage" in c and "business_ref" in c for c in added)
+
+
+def test_ensure_schema_skips_existing_columns(monkeypatch):
+    """列已存在时不发 ALTER（幂等）。"""
+    cols = ["lineage_id", "task_id", "business_ref"]
+    fake = _patch_connector(monkeypatch, {
+        "table_lineage": cols,
+        "column_lineage": cols,
+    })
+    writer.ensure_schema("sqlite://meta.db")
+    assert fake.alter_calls == []
