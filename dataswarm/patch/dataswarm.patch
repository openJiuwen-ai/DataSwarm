+def test_ddl_parses_table_level_primary_key_and_backticks():
+    """表级 PRIMARY KEY (a) 与反引号标识符都要能识别。
+
+    只认列级 ``id BIGINT PRIMARY KEY`` 会让 MySQL 风格 DDL 的主键全丢，
+    而主键是 schema_candidates 排除技术列的依据。
+    """
+    from jiuwenswarm.channels.web.dataagent.connectors.schema_only_connector import (
+        parse_ddl,
+    )
+
+    mysql_ddl = """
+CREATE TABLE `orders` (
+  `id` BIGINT NOT NULL,
+  `amt` DECIMAL(10,2),
+  PRIMARY KEY (`id`)
+);
+"""
+    tables = parse_ddl(mysql_ddl, "mysql")
+    assert len(tables) == 1 and tables[0]["name"] == "orders"
+    by = {c["name"]: c for c in tables[0]["columns"]}
+    assert by["id"]["pk"] is True and by["id"]["nullable"] is False, by["id"]
+    assert by["amt"]["pk"] is False
