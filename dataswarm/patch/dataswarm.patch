+def test_every_declared_requirement_has_an_install_path():
+    """每个 ``requires`` 的模块都要能装上：在核心依赖里，或有对应的 ds-* extra。
+
+    否则前端会提示 ``driver_missing:xxx`` 而用户无从安装——声明了依赖却没给
+    安装路径，比不声明更糟。
+    """
+    import tomllib
+
+    root = Path(__file__).resolve().parents[3]
+    data = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8"))
+    project = data["project"]
+    specs = list(project.get("dependencies") or [])
+    for name, group in (project.get("optional-dependencies") or {}).items():
+        if name.startswith("ds-"):
+            specs.extend(group)
+    blob = " ".join(specs).lower()
+
+    def candidates(module: str) -> set[str]:
+        """规范化模块路径，兼容发行包名中的点、下划线和连字符。"""
+        low = module.lower()
+        return {low, low.replace(".", "-"), low.replace(".", "_"),
+                low.replace("_", "-"), low.split(".")[0]}
+
+    required = {m for t in ALL_TYPES for m in R.get_source_type(t["type_id"]).requires}
+    assert required, "没有任何类型声明 requires，断言会空转"
+    missing = [m for m in sorted(required)
+               if not any(c in blob for c in candidates(m))]
+    assert not missing, (
+        f"这些模块被 requires 声明但核心依赖与 ds-* extra 都没有，"
+        f"用户看到 driver_missing 却装不上: {missing}"
+    )
+
