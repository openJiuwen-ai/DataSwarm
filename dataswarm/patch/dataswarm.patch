+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** BI看板 Zustand store。 */
+
+import { create } from 'zustand';
+import { dashboardApi } from '../api/dashboardApi';
+import { glossaryApi } from '../api/glossaryApi';
+import type { TermImportItem, TermImportResult } from '../api/glossaryApi';
+import type {
+  DimensionDef,
+  DashboardDef,
+  CardDef,
+  RenderedDashboard,
+  DimensionInput,
+  DashboardInput,
+  CardInput,
+  DashboardFilters,
+  TermDef,
+  TermInput,
+} from '../types/dashboard';
+
+const message = (error: unknown) => error instanceof Error ? error.message : '未知错误';
+
+interface DashboardState {
+  // 数据
+  dimensions: DimensionDef[];
+  dashboards: DashboardDef[];
+  selectedDashboardId: string;
+  currentDashboard: DashboardDef | null;
+  renderedDashboard: RenderedDashboard | null;
+  // 筛选
+  dashboardFilters: DashboardFilters;
+  setDashboardFilters: (filters: DashboardFilters) => void;
+  // UI
+  loading: boolean;
+  error: string | null;
+  // 维度操作
+  loadDimensions: () => Promise<void>;
+  createDimension: (input: DimensionInput) => Promise<DimensionDef | null>;
+  updateDimension: (id: string, input: DimensionInput) => Promise<DimensionDef | null>;
+  deleteDimension: (id: string) => Promise<boolean>;
+  // 看板操作
+  loadDashboards: () => Promise<void>;
+  selectDashboard: (id: string) => Promise<void>;
+  createDashboard: (input: DashboardInput) => Promise<DashboardDef | null>;
+  updateDashboard: (id: string, input: DashboardInput) => Promise<DashboardDef | null>;
+  deleteDashboard: (id: string) => Promise<boolean>;
+  renderDashboard: (id: string, forceRefresh?: boolean, filters?: DashboardFilters) => Promise<RenderedDashboard | null>;
+  // 卡片操作
+  createCard: (dashboardId: string, input: CardInput) => Promise<CardDef | null>;
+  updateCard: (dashboardId: string, cardId: string, input: CardInput) => Promise<CardDef | null>;
+  deleteCard: (dashboardId: string, cardId: string) => Promise<boolean>;
+  // 术语操作（glossary P0）
+  terms: TermDef[];
+  loadTerms: (keyword?: string) => Promise<void>;
+  createTerm: (input: TermInput) => Promise<TermDef | null>;
+  updateTerm: (id: string, input: TermInput) => Promise<TermDef | null>;
+  deleteTerm: (id: string) => Promise<boolean>;
+  importTerms: (items: TermImportItem[]) => Promise<TermImportResult | null>;
+  reindexTerms: () => Promise<{ graph: { status: string }; vector: { status: string } } | null>;
+  // 通用
+  clearError: () => void;
+}
+
+export const useDashboardStore = create<DashboardState>((set, get) => ({
+  dimensions: [],
+  dashboards: [],
+  selectedDashboardId: '',
+  currentDashboard: null,
+  renderedDashboard: null,
+  dashboardFilters: { time_range: { start: '', end: '' } },
+  setDashboardFilters: (filters) => set({ dashboardFilters: filters }),
+  loading: false,
+  error: null,
+  clearError: () => set({ error: null }),
+
+  // ---- 维度 ----
+  loadDimensions: async () => {
+    set({ loading: true, error: null });
+    try {
+      const { dimensions } = await dashboardApi.listDimensions();
+      set({ dimensions, loading: false });
+    } catch (error) { set({ loading: false, error: message(error) }); }
+  },
+  createDimension: async (input) => {
+    try {
+      const d = await dashboardApi.createDimension(input);
+      await get().loadDimensions();
+      return d;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  updateDimension: async (id, input) => {
+    try {
+      const d = await dashboardApi.updateDimension(id, input);
+      await get().loadDimensions();
+      return d;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  deleteDimension: async (id) => {
+    try {
+      const { ok } = await dashboardApi.deleteDimension(id);
+      await get().loadDimensions();
+      return ok;
+    } catch (error) { set({ error: message(error) }); return false; }
+  },
+
+  // ---- 看板 ----
+  loadDashboards: async () => {
+    set({ loading: true, error: null });
+    try {
+      const { dashboards } = await dashboardApi.listDashboards();
+      set({ dashboards, loading: false });
+    } catch (error) { set({ loading: false, error: message(error) }); }
+  },
+  selectDashboard: async (id) => {
+    set({ selectedDashboardId: id, loading: true, error: null });
+    try {
+      const d = await dashboardApi.getDashboard(id);
+      set({ currentDashboard: d ?? null, loading: false });
+      if (typeof window !== 'undefined' && window.location.pathname.startsWith('/dataagent/dashboard')) {
+        const url = id
+          ? `/dataagent/dashboard/dashboards?dashboard_id=${encodeURIComponent(id)}`
+          : '/dataagent/dashboard/dashboards';
+        window.history.replaceState(null, '', url);
+      }
+    } catch (error) {
+      set({ currentDashboard: null, loading: false, error: message(error) });
+    }
+  },
+  createDashboard: async (input) => {
+    try {
+      const d = await dashboardApi.createDashboard(input);
+      await get().loadDashboards();
+      return d;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  updateDashboard: async (id, input) => {
+    try {
+      const d = await dashboardApi.updateDashboard(id, input);
+      await get().loadDashboards();
+      return d;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  deleteDashboard: async (id) => {
+    try {
+      const { ok } = await dashboardApi.deleteDashboard(id);
+      if (get().selectedDashboardId === id) {
+        set({ selectedDashboardId: '', currentDashboard: null, renderedDashboard: null });
+      }
+      await get().loadDashboards();
+      return ok;
+    } catch (error) { set({ error: message(error) }); return false; }
+  },
+  renderDashboard: async (id, forceRefresh, filters) => {
+    set({ loading: true, error: null });
+    try {
+      const r = await dashboardApi.renderDashboard(id, forceRefresh, filters);
+      set({ renderedDashboard: r, loading: false });
+      return r;
+    } catch (error) { set({ renderedDashboard: null, loading: false, error: message(error) }); return null; }
+  },
+
+  // ---- 术语（glossary P0：写操作后投影同步在后端异步完成，失败不阻断） ----
+  terms: [],
+  loadTerms: async (keyword) => {
+    set({ loading: true, error: null });
+    try {
+      const { terms } = await glossaryApi.list(keyword);
+      set({ terms, loading: false });
+    } catch (error) { set({ loading: false, error: message(error) }); }
+  },
+  createTerm: async (input) => {
+    try {
+      const { term } = await glossaryApi.create({
+        name: input.name || '',
+        definition: input.definition || '',
+        synonyms: input.synonyms,
+        owner: input.owner,
+        tags: input.tags,
+      });
+      await get().loadTerms();
+      return term;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  updateTerm: async (id, input) => {
+    try {
+      const { term } = await glossaryApi.update(id, {
+        name: input.name,
+        definition: input.definition,
+        synonyms: input.synonyms,
+        owner: input.owner,
+        tags: input.tags,
+      });
+      await get().loadTerms();
+      return term;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  deleteTerm: async (id) => {
+    try {
+      await glossaryApi.remove(id);
+      await get().loadTerms();
+      return true;
+    } catch (error) { set({ error: message(error) }); return false; }
+  },
+  importTerms: async (items) => {
+    try {
+      const result = await glossaryApi.importTerms(items);
+      await get().loadTerms();
+      return result;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  reindexTerms: async () => {
+    try {
+      return await glossaryApi.reindex();
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+
+  // ---- 卡片 ----
+  createCard: async (dashboardId, input) => {
+    try {
+      const c = await dashboardApi.createCard(dashboardId, input);
+      if (get().selectedDashboardId === dashboardId) await get().selectDashboard(dashboardId);
+      return c;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  updateCard: async (dashboardId, cardId, input) => {
+    try {
+      const c = await dashboardApi.updateCard(dashboardId, cardId, input);
+      if (get().selectedDashboardId === dashboardId) await get().selectDashboard(dashboardId);
+      return c;
+    } catch (error) { set({ error: message(error) }); return null; }
+  },
+  deleteCard: async (dashboardId, cardId) => {
+    try {
+      const { ok } = await dashboardApi.deleteCard(dashboardId, cardId);
+      if (get().selectedDashboardId === dashboardId) await get().selectDashboard(dashboardId);
+      return ok;
+    } catch (error) { set({ error: message(error) }); return false; }
+  },
+}));
