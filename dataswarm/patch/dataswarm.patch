+def test_reconcile_repairs_drift_and_is_idempotent(vector_env):
+    term = _make_term()
+    first = sync.reconcile()
+    assert first["graph"]["status"] == "ok"
+    assert first["vector"] == {"status": "ok", "rebuilt": 1, "removed": 0}
+
+    # 模拟漂移：改 fingerprint + 塞一个孤儿条目（表里没有 term_ghost）
+    vector_env.index.metadata[f"{term['term_id']}:canonical"]["fingerprint"] = "stale"
+    vector_env.index.metadata["term_ghost:syn:0"] = {"term_id": "term_ghost", "fingerprint": "x"}
+    repaired = sync.reconcile()
+    assert repaired["vector"]["removed"] == 1  # 孤儿删除
+    assert repaired["vector"]["rebuilt"] == 1  # 指纹漂移重建
+    assert vector_env.index.metadata[f"{term['term_id']}:canonical"]["fingerprint"] == term["fingerprint"]
+    assert "term_ghost:syn:0" not in vector_env.index.metadata
+
+    # 再跑一次：无漂移无孤儿（幂等）
+    again = sync.reconcile()
+    assert again["vector"] == {"status": "ok", "rebuilt": 0, "removed": 0}
