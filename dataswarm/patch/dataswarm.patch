+++ b/tests/unit/channel/test_orchestration_legacy_adapter.py
@@ -0,0 +1,152 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""旧编排 API 适配层单测（方案 §5.2：单一 service + 路径改写 + Deprecation header）。
+
+新功能档 TDD：适配层把 /api/orchestration/* 转发到新 controller，行为与直接调
+新路径一致（无分叉），并附加 Deprecation/Sunset header。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import urlparse
+
+
+from jiuwenswarm.channels.web.orchestration import api as legacy_api
+from jiuwenswarm.channels.web.dataagent.orchestration import controller as new_ctrl
+
+
+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+        self.headers: dict = {}
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    def __init__(self, path: str, body: dict | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        raw = json.dumps(body).encode() if body else b""
+        self.rfile = _FakeRfile(raw)
+        self.headers = {"Content-Length": str(len(raw))}
+        self._resp = FakeResponse()
+
+    def _write_json(self, status, payload, headers: dict | None = None):
+        self._resp.capture(status, payload)
+        self._resp.headers.update(headers or {})
+
+    def _query_arg(self, parsed, name):
+        for pair in self.parsed.query.split("&"):
+            if "=" in pair:
+                k, v = pair.split("=", 1)
+                if k == name:
+                    return v
+        return None
+
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, n):
+        return self._data[:n]
+
+
+# --------------------------------------------------------------------------
+# is_route：旧前缀命中，新前缀不命中（新前缀走 dataagent 分流）
+# --------------------------------------------------------------------------
+def test_is_route_legacy_prefix():
+    assert legacy_api.is_route("/api/orchestration/tasks") is True
+
+
+def test_is_route_new_prefix_not_matched():
+    """/api/dataagent/orchestration 不走旧适配层（避免双重转发）。"""
+    assert legacy_api.is_route("/api/dataagent/orchestration/tasks") is False
+
+
+# --------------------------------------------------------------------------
+# 转发：旧路径 → 新 controller，行为一致
+# --------------------------------------------------------------------------
+def test_legacy_get_forwards_to_new_controller(monkeypatch):
+    """GET /api/orchestration/tasks → 转发为新路径，调同一 service。"""
+    calls = []
+    monkeypatch.setattr(new_ctrl, "svc", type("_S", (), {
+        "list_tasks": staticmethod(lambda **kw: calls.append(("list_tasks", kw)) or []),
+        "count_tasks": staticmethod(lambda **kw: 0),
+    })())
+    h = FakeHandler("/api/orchestration/tasks")
+    legacy_api.handle_get(h, h.parsed)
+    assert calls == [("list_tasks", {"status": None, "q": None, "limit": 100, "offset": 0})]
+    assert h._resp.status == 200
+    assert h._resp.payload["tasks"] == []
+    assert h._resp.payload["total"] == 0
+
+
+def test_legacy_post_forwards_to_new_controller(monkeypatch):
+    calls = []
+    monkeypatch.setattr(new_ctrl, "svc", type("_S", (), {
+        "create_task": staticmethod(lambda data: calls.append(("create_task", data))
+                                    or {"task_id": "t1", "status": "draft"}),
+    })())
+    h = FakeHandler("/api/orchestration/tasks", {"name": "x"})
+    legacy_api.handle_post(h, h.parsed)
+    assert calls == [("create_task", {"name": "x"})]
+    assert h._resp.status == 201
+
+
+def test_legacy_404_shape_preserved(monkeypatch):
+    """/api/orchestration/tasks/missing → 404（与新路径同形状）。"""
+    monkeypatch.setattr(new_ctrl, "svc", type("_S", (), {
+        "get_task": staticmethod(lambda tid: None),
+    })())
+    h = FakeHandler("/api/orchestration/tasks/missing")
+    legacy_api.handle_get(h, h.parsed)
+    assert h._resp.status == 404
+    assert h._resp.payload == {"error": "not_found"}
+
+
+# --------------------------------------------------------------------------
+# Deprecation / Sunset header（§5.2 弃用时间表）
+# --------------------------------------------------------------------------
+def test_legacy_response_has_deprecation_headers(monkeypatch):
+    monkeypatch.setattr(new_ctrl, "svc", type("_S", (), {
+        "list_tasks": staticmethod(lambda **kw: []),
+        "count_tasks": staticmethod(lambda **kw: 0),
+    })())
+    h = FakeHandler("/api/orchestration/tasks")
+    legacy_api.handle_get(h, h.parsed)
+    assert h._resp.headers.get("Deprecation") == "true"
+    assert "Sunset" in h._resp.headers
+    assert "successor-version" in h._resp.headers.get("Link", "")
+
+
+# --------------------------------------------------------------------------
+# enable/disable/cancel 经适配层可用（新动作对旧客户端也可达）
+# --------------------------------------------------------------------------
+def test_legacy_cancel_forwards(monkeypatch):
+    calls = []
+    monkeypatch.setattr(new_ctrl, "svc", type("_S", (), {
+        "cancel_instance": staticmethod(
+            lambda iid: calls.append(("cancel", iid)) or {"instance_id": iid, "status": "cancelled"}),
+    })())
+    h = FakeHandler("/api/orchestration/instances/i1/cancel", {})
+    legacy_api.handle_post(h, h.parsed)
+    assert calls == [("cancel", "i1")]
+    assert h._resp.payload["status"] == "cancelled"
+
+
+# --------------------------------------------------------------------------
+# query 参数保留（GET /tasks?status=published → service 收到 status）
+# --------------------------------------------------------------------------
+def test_legacy_query_params_preserved(monkeypatch):
+    calls = []
+    monkeypatch.setattr(new_ctrl, "svc", type("_S", (), {
+        "list_tasks": staticmethod(lambda **kw: calls.append(("list_tasks", kw)) or []),
+        "count_tasks": staticmethod(lambda **kw: 0),
+    })())
+    h = FakeHandler("/api/orchestration/tasks?status=published")
+    legacy_api.handle_get(h, h.parsed)
+    assert calls == [("list_tasks", {"status": "published", "q": None, "limit": 100, "offset": 0})]
