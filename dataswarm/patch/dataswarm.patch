--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/LogViewer.tsx
@@ -0,0 +1,204 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 日志查看器（可复用叶子组件）：单个 run 的单个 stream。
+// 职责：加载日志 + 逐行级别解析（如实解析，解析不到归"未分级"）+ 级别 chip 筛选（带计数）
+// + 下载当前可见内容（所见即所得）。
+// 三处复用：LogDrawer（任务/工作流实例日志）、运行情况页节点信息抽屉内嵌日志区。
+// 本组件不负责 run 切换 / stream 切换（由宿主持有状态传入）。
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { Download, RefreshCw } from 'lucide-react';
+import DownloadIcon from '../../../assets/data-development/download.svg?react';
+import RefreshIcon from '../../../assets/data-development/refresh.svg?react';
+import { useTranslation } from 'react-i18next';
+import { orchestrationApi } from '../api/orchestrationApi';
+
+import { parseLogEntries, type LogEntry, type LogLevel } from './shared/logEntries';
+
+const LEVEL_ORDER: LogLevel[] = ['error', 'warn', 'info', 'debug'];
+const LEVEL_COLOR: Record<LogLevel, string> = {
+  error: 'var(--color-feedback-danger)',
+  warn: 'var(--color-feedback-warning)',
+  info: 'var(--color-text-link)',
+  debug: 'var(--color-text-tertiary)',
+};
+
+interface Props {
+  runId: string | null;
+  stream: 'stdout' | 'stderr';
+  presentation?: 'default' | 'workflow';
+}
+
+export function LogViewer({ runId, stream, presentation = 'default' }: Props) {
+  const { t } = useTranslation();
+  const [log, setLog] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const generation = useRef(0);
+  const [loading, setLoading] = useState(false);
+  const [level, setLevel] = useState<LogLevel | null>(null);
+  const workflow = presentation === 'workflow';
+
+  const reload = useCallback(async () => {
+    const request = ++generation.current;
+    if (!runId) {
+      setLog('');
+      return;
+    }
+    setLoading(true);
+    setError(null);
+    try {
+      const result = await orchestrationApi.getLog(runId, stream);
+      if (request === generation.current) setLog(result.log);
+    } catch (e) {
+      if (request === generation.current) setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      if (request === generation.current) setLoading(false);
+    }
+  }, [runId, stream]);
+  useEffect(() => {
+    setLog('');
+    void reload();
+    return () => {
+      generation.current += 1;
+    };
+  }, [reload]);
+  // 切 run/stream 时重置级别筛选态
+  useEffect(() => {
+    setLevel(null);
+  }, [runId, stream]);
+
+  const lines = useMemo<LogEntry[]>(() => {
+    if (!log) return [];
+    return parseLogEntries(log);
+  }, [log]);
+
+  const counts = useMemo(() => {
+    const c: Record<LogLevel, number> = { debug: 0, info: 0, warn: 0, error: 0 };
+    lines.forEach((l) => {
+      if (l.level) c[l.level] += 1;
+    });
+    return c;
+  }, [lines]);
+
+  // 级别筛选语义：选中某级别时只显示该级别行（未分级行不属于任何级别，被滤掉）
+  const visible = lines.filter((line) => !level || line.level === level);
+
+  const onDownload = () => {
+    const content = visible.map((l) => l.text).join('\n');
+    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = `log-${runId ?? 'unknown'}-${stream}.log`;
+    a.click();
+    URL.revokeObjectURL(url);
+  };
+
+  const hasAnyLevel = LEVEL_ORDER.some((l) => counts[l] > 0);
+  let defaultContent = t('dataAsset.logs.empty');
+  if (loading) defaultContent = t('dataAsset.logs.loading');
+  else if (error) defaultContent = '';
+  else if (visible.length) defaultContent = visible.map((line) => line.text).join('\n');
+
+  let workflowContent = <p>{t('dataAsset.logs.empty')}</p>;
+  if (loading) workflowContent = <p role="status">{t('dataAsset.logs.loading')}</p>;
+  else if (error) workflowContent = <></>;
+  else if (visible.length) {
+    workflowContent = (
+      <>
+        {visible.map((entry, index) => (
+          <article key={index}>
+            {entry.timestamp && <p className="dd-log-timestamp">{entry.timestamp}</p>}
+            <pre>{entry.message}</pre>
+          </article>
+        ))}
+      </>
+    );
+  }
+
+  return (
+    <div className={`flex min-h-0 flex-1 flex-col ${workflow ? 'dd-log-viewer' : ''}`}>
+      <div
+        className={`flex flex-wrap items-center gap-2 border-b border-border px-4 py-2 text-xs ${workflow ? 'dd-log-toolbar' : ''}`}
+      >
+        {hasAnyLevel ? (
+          <div className="flex flex-wrap items-center gap-1" role="group" aria-label={t('dataAsset.logs.levelFilter')}>
+            <button
+              type="button"
+              className={`rounded px-1.5 py-0.5 text-[11px] ${level === null ? 'border border-accent bg-accent-subtle text-text-link' : 'border border-border bg-secondary text-text-muted hover:bg-panel'}`}
+              onClick={() => setLevel(null)}
+              aria-pressed={level === null}
+            >
+              {t('dataAsset.logs.levelAll')} {lines.length}
+            </button>
+            {LEVEL_ORDER.filter((l) => counts[l] > 0).map((l) => (
+              <button
+                key={l}
+                type="button"
+                className={`rounded px-1.5 py-0.5 font-mono text-[11px] ${level === l ? 'border border-accent bg-accent-subtle' : 'border border-border bg-secondary hover:bg-panel'}`}
+                style={workflow ? undefined : { color: LEVEL_COLOR[l] }}
+                onClick={() => setLevel((cur) => (cur === l ? null : l))}
+                aria-pressed={level === l}
+              >
+                {l.toUpperCase()} {counts[l]}
+              </button>
+            ))}
+          </div>
+        ) : (
+          <span className="text-text-muted">
+            {lines.length} {t('dataAsset.logs.lineCount')}
+          </span>
+        )}
+        <button
+          type="button"
+          className="flex items-center gap-1 rounded border border-border px-2 py-1 text-xs text-text-secondary hover:bg-secondary"
+          onClick={() => void reload()}
+          title={t('dataAsset.logs.refresh')}
+          aria-label={t('dataAsset.logs.refresh')}
+        >
+          {workflow ? (
+            <RefreshIcon width={16} height={16} className={loading ? 'animate-spin' : ''} aria-hidden="true" />
+          ) : (
+            <>
+              <RefreshCw size={11} className={loading ? 'animate-spin' : ''} />
+              {t('dataAsset.logs.refresh')}
+            </>
+          )}
+        </button>
+        <button
+          type="button"
+          className="flex items-center gap-1 rounded border border-border px-2 py-1 text-xs text-text-secondary hover:bg-secondary"
+          disabled={loading || !!error || !visible.length}
+          onClick={onDownload}
+          title={t('dataAsset.logs.download')}
+          aria-label={t('dataAsset.logs.download')}
+        >
+          {workflow ? (
+            <DownloadIcon width={16} height={16} aria-hidden="true" />
+          ) : (
+            <>
+              <Download size={11} />
+              {t('dataAsset.logs.download')}
+            </>
+          )}
+        </button>
+      </div>
+      {error && (
+        <div className="px-4 py-2 text-danger" role="alert">
+          {error}
+        </div>
+      )}
+      {workflow ? (
+        <div className="dd-log-entries" aria-label={t('dataAsset.logs.title')}>
+          {workflowContent}
+        </div>
+      ) : (
+        <pre
+          className="flex-1 overflow-auto whitespace-pre-wrap break-all p-4 font-mono text-xs text-text"
+          aria-label={t('dataAsset.logs.title')}
+        >
+          {defaultContent}
+        </pre>
+      )}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/NodeEditDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/NodeEditDrawer.tsx
