+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/db 层单测：真实 sqlite 元库上的 replace_nodes 图校验 + 实例搜索 + LIKE 转义。
+
+service 层测试用 fake orch_db，覆盖不到这些 SQL 语义与校验路径，这里用
+JIUWENSWARM_ORCH_DB 直连 tmp sqlite（current_workspace 最高优先级）打真实库。
+
+跑法：python -m pytest tests/unit_tests/orchestration/test_orchestration_db.py -v
+"""
+from __future__ import annotations
+
+import os
+import sys
+
+import pytest
+
+_REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+if _REPO not in sys.path:
+    sys.path.insert(0, _REPO)
+
+from jiuwenswarm.channels.web.orchestration import db as orch_db  # noqa: E402
+
+
+@pytest.fixture()
+def meta_db(monkeypatch, tmp_path):
+    """tmp sqlite 元库：不读机器 datasource.yaml，artifact/基线库一并隔离到 tmp。"""
+    meta = tmp_path / "meta.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{meta}")
+    monkeypatch.setattr(orch_db, "META_DB_REF", f"sqlite://{meta}")
+    monkeypatch.setattr(orch_db, "_is_sqlite", True)
+    monkeypatch.setattr(orch_db, "WAREHOUSE_DB", meta)
+    monkeypatch.setattr(orch_db, "BASELINE_DB", tmp_path / "baseline_absent.db")
+    monkeypatch.setattr(orch_db, "ARTIFACT_ROOT", tmp_path / "artifact" / "orchestration")
+    orch_db.init_db()
+    return orch_db
+
+
+def _task(name: str) -> dict:
+    return orch_db.create_task({"name": name, "executor_type": "sql", "code": "SELECT 1"})
+
+
+def _node(node_id: str, task_id: str, upstream: str = "", **extra) -> dict:
+    return {"node_id": node_id, "task_id": task_id, "upstream_nodes": upstream, **extra}
+
+
+# --------------------------------------------------------------------------
+# LIKE 转义（_search_pattern + list_tasks/count_tasks 集成）
+# --------------------------------------------------------------------------
+def test_search_pattern_escapes_like_wildcards():
+    assert orch_db._search_pattern("a!b%c_d") == "%a!!b!%c!_d%"
+
+
+def test_list_tasks_q_treats_wildcards_as_literal(meta_db):
+    """未转义时 %/_ 是通配符（旧 bug：搜 "100%done" 会命中 "100Xdone"）。"""
+    hit = _task("ratio_50")
+    _task("ratioX50")
+    pct = _task("100%done")
+    _task("100Xdone")
+
+    got = orch_db.list_tasks(q="ratio_50")
+    assert [t["task_id"] for t in got] == [hit["task_id"]]
+    got = orch_db.list_tasks(q="100%done")
+    assert [t["task_id"] for t in got] == [pct["task_id"]]
+    assert orch_db.count_tasks(q="ratio_50") == 1
+
+
+# --------------------------------------------------------------------------
+# 实例数聚合：只按传入 ref_ids 聚合（列表页当前页）
+# --------------------------------------------------------------------------
+def test_count_instances_by_ref_scopes_to_ids(meta_db):
+    t1, t2 = _task("t1"), _task("t2")
+    orch_db.create_instance("task", t1["task_id"], "debug")
+    orch_db.create_instance("task", t1["task_id"], "manual")
+    orch_db.create_instance("task", t2["task_id"], "debug")
+
+    assert orch_db.count_instances_by_ref("task", [t1["task_id"]]) == {t1["task_id"]: 2}
+    assert orch_db.count_instances_by_ref("task", [t1["task_id"], t2["task_id"]]) == \
+        {t1["task_id"]: 2, t2["task_id"]: 1}
+    assert orch_db.count_instances_by_ref("task", []) == {}
+
+
+def test_list_tasks_instance_count_across_pages(meta_db):
+    """翻页 / 改页大小 / 搜索+分页组合下，instance_count 逐行正确且各页不重不漏。
+
+    instance_count 是逐行属性（GROUP BY 按 ref_id 独立计数），与同批传入哪些
+    其他 ID 无关，因此按页取 ID 聚合与全量聚合对同一行结果必然一致。
+    """
+    from jiuwenswarm.channels.web.dataagent.orchestration import service as svc
+
+    expected: dict[str, int] = {}
+    for i in range(1, 6):
+        t = _task(f"分页任务{i}")
+        expected[t["task_id"]] = i
+        for _ in range(i):
+            orch_db.create_instance("task", t["task_id"], "debug")
+
+    # limit=2 逐页翻完：每行计数正确，5 行不重不漏
+    seen: list[str] = []
+    for offset in (0, 2, 4, 6):
+        page = svc.list_tasks(limit=2, offset=offset)
+        assert len(page) <= 2
+        for row in page:
+            assert row["instance_count"] == expected[row["task_id"]]
+            seen.append(row["task_id"])
+    assert len(seen) == len(set(seen)) == 5
+
+    # 改页大小 + 搜索过滤组合：q 命中同一批 5 行，limit=3/offset=3 取到剩余 2 行
+    for row in svc.list_tasks(q="分页任务", limit=3, offset=3):
+        assert row["instance_count"] == expected[row["task_id"]]
+    # 越过末页 → 空页（ref_ids 为空不查库也不报错）
+    assert svc.list_tasks(limit=2, offset=100) == []
+
+
+def test_list_workflows_instance_count_across_pages(meta_db):
+    from jiuwenswarm.channels.web.dataagent.orchestration import service as svc
+
+    expected: dict[str, int] = {}
+    for i in (0, 1, 3):
+        wf = orch_db.create_workflow({"name": f"分页工作流{i}"})
+        expected[wf["workflow_id"]] = i
+        for _ in range(i):
+            orch_db.create_instance("workflow", wf["workflow_id"], "debug")
+
+    for row in svc.list_workflows(limit=2, offset=0):
+        assert row["instance_count"] == expected[row["workflow_id"]]
+    for row in svc.list_workflows(limit=2, offset=2):
+        assert row["instance_count"] == expected[row["workflow_id"]]
+
+
+# --------------------------------------------------------------------------
+# 实例列表：q 搜索（instance_id / 任务名 / 工作流名）+ ref_name 回填
+# --------------------------------------------------------------------------
+def test_list_instances_q_and_ref_name(meta_db):
+    task = _task("订单同步")
+    wf = orch_db.create_workflow({"name": "日报工作流"})
+    inst_t = orch_db.create_instance("task", task["task_id"], "debug")
+    inst_w = orch_db.create_instance("workflow", wf["workflow_id"], "manual")
+
+    got = orch_db.list_instances(q="订单")
+    assert [i["instance_id"] for i in got] == [inst_t["instance_id"]]
+    assert got[0]["ref_name"] == "订单同步"
+
+    got = orch_db.list_instances(q="日报")
+    assert [i["instance_id"] for i in got] == [inst_w["instance_id"]]
+    assert got[0]["ref_name"] == "日报工作流"
+
+    # instance_id 子串命中（取 uuid 后缀避免同秒前缀撞车）
+    got = orch_db.list_instances(q=inst_w["instance_id"][-8:])
+    assert [i["instance_id"] for i in got] == [inst_w["instance_id"]]
+
+    assert orch_db.count_instances(q="订单") == 1
+    # ref_type 过滤与 q 组合：workflow 实例按工作流名匹配，不命中任务名
+    assert orch_db.list_instances(ref_type="workflow", q="订单") == []
+
+
+# --------------------------------------------------------------------------
+# 实例分页响应：全量状态统计与筛选条件一致
+# --------------------------------------------------------------------------
+def test_instance_page_status_counts_cover_all_pages_and_filters(meta_db):
+    from urllib.parse import parse_qs, urlparse
+    from jiuwenswarm.channels.web.dataagent.orchestration import controller
+
+    wf = orch_db.create_workflow({"name": "汇总_50%"})
+    other = orch_db.create_workflow({"name": "汇总X50%"})
+    states = ["success"] * 8 + ["failed"] * 2 + ["running", "cancelled", "queued", "waiting_review"]
+    instances = [orch_db.create_instance("workflow", wf["workflow_id"], "debug", state) for state in states]
+    orch_db.create_instance("workflow", other["workflow_id"], "debug", "failed")
+    orch_db.create_instance("task", wf["workflow_id"], "debug", "failed")
+    orch_db.create_instance("workflow", wf["workflow_id"], "manual", "success")
+
+    class Handler:
+        @staticmethod
+        def _query_arg(parsed, key):
+            return parse_qs(parsed.query).get(key, [None])[0]
+
+        def _write_json(self, code, payload):
+            assert code == 200
+            self.payload = payload
+
+    expected = {"success": 8, "failed": 2, "running": 1, "cancelled": 1, "queued": 1, "waiting_review": 1}
+    for limit, offset in [(10, 0), (10, 10), (3, 6), (10, 100)]:
+        handler = Handler()
+        controller.handle_get(handler, urlparse(
+            f'/api/dataagent/orchestration/instances?ref_type=workflow&ref_id={wf["workflow_id"]}'
+            f'&trigger_type=debug&limit={limit}&offset={offset}'))
+        page = handler.payload
+        assert page["status_counts"] == expected
+        assert page["total"] == sum(expected.values()) == 14
+        assert len(page["instances"]) == min(limit, max(0, 14 - offset))
+        assert (page["limit"], page["offset"]) == (limit, offset)
+
+    assert orch_db.count_instances_by_status(q="汇总_50%", trigger_type="debug") == expected
+    assert orch_db.count_instances_by_status(q=instances[0]["instance_id"][-8:]) == {"success": 1}
+    assert orch_db.count_instances_by_status(ref_id="absent") == {}
+    running = instances[10]
+    orch_db.update_instance(running["instance_id"], status="cancelled")
+    expected.pop("running")
+    expected["cancelled"] += 1
+    assert orch_db.count_instances_by_status(
+        ref_type="workflow", ref_id=wf["workflow_id"], trigger_type="debug") == expected
+
+
