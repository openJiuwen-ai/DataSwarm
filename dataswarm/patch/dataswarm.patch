+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Binding reports metadata collection outcomes for every supported source family."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import service
+from jiuwenswarm.channels.web.dataagent.semantic import service as semantic_service
+from jiuwenswarm.common import workspace_context, workspace_store
+
+
+@pytest.fixture()
+def binding_env(monkeypatch):
+    state = {"sources": {}, "bindings": {}, "lookups": []}
+
+    def find_source(source_id, workspace_id=None):
+        state["lookups"].append((source_id, workspace_id))
+        return state["sources"].get((workspace_id, source_id))
+
+    def update_ref(workspace_id, db_ref):
+        state["bindings"][workspace_id] = db_ref
+        return {"workspace_id": workspace_id}
+
+    monkeypatch.setattr(service, "_store", SimpleNamespace(find_source=find_source))
+    monkeypatch.setattr(workspace_context, "resolve", lambda ws: SimpleNamespace(
+        workspace_id=ws, business_db_ref=state["bindings"].get(ws, "")))
+    monkeypatch.setattr(workspace_context, "is_yaml_workspace", lambda ws: False)
+    monkeypatch.setattr(workspace_store, "update_business_ref", update_ref)
+    monkeypatch.setattr(service, "_trigger_schema_derivation", lambda *args: {"status": "queued"})
+    return state
+
+
+@pytest.mark.parametrize("source_type", [
+    "mysql", "postgresql", "sqlserver", "doris", "starrocks", "hologres",
+    "sqlite", "duckdb", "csv", "excel", "parquet", "json", "s3", "oss", "hdfs", "sftp",
+])
+def test_binding_delegates_all_source_types_to_capability_aware_startup(
+    monkeypatch, binding_env, source_type,
+):
+    source = {"source_id": "src", "source_type": source_type,
+              "db_ref": f"{source_type}://example", "enabled": True}
+    binding_env["sources"][("ws-a", "src")] = source
+    calls = []
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda sid, ws:
+                        calls.append((sid, ws)) or {"run_id": "run-1", "status": "running"})
+
+    result = service.bind_source_to_workspace({"source_id": "src", "workspace_id": "ws-a"})
+
+    assert result["ok"] is True
+    assert calls == [("src", "ws-a")]
+    assert result["semantic_collection"] == {
+        "status": "queued", "run_id": "run-1", "run_status": "running",
+    }
+    assert binding_env["bindings"]["ws-a"] == source["db_ref"]
+
+
+@pytest.mark.parametrize("status,reason", [
+    ("unsupported", "metadata_collection_unsupported"),
+    ("disabled", "source_disabled"),
+    ("source_not_found", "source_not_found"),
+])
+def test_binding_preserves_declined_startup_status(monkeypatch, binding_env, status, reason):
+    binding_env["sources"][("ws-a", "src")] = {
+        "source_id": "src", "source_type": "sqlite", "db_ref": "sqlite://example",
+    }
+    outcome = {"status": status, "reason": reason, "warnings": [reason]}
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda *args: outcome)
+
+    result = service.bind_source_to_workspace({"source_id": "src", "workspace_id": "ws-a"})
+
+    assert result["ok"] is True
+    assert result["semantic_collection"] == outcome
+    assert "run_id" not in result["semantic_collection"]
+    assert binding_env["bindings"]["ws-a"] == "sqlite://example"
+
+
+def test_create_and_auto_bind_file_source_triggers_collection(monkeypatch, binding_env, tmp_path):
+    calls = []
+
+    def insert_source(source_id, source_type, name, config, db_ref, workspace_id=None, **kwargs):
+        source = {"source_id": source_id, "source_type": source_type, "db_ref": db_ref,
+                  "config": config, "enabled": True}
+        binding_env["sources"][(workspace_id, source_id)] = source
+        return source
+
+    monkeypatch.setattr(service._store, "insert_source", insert_source, raising=False)
+    monkeypatch.setattr(service, "_invalidate_creds_cache", lambda: None)
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda sid, ws:
+                        calls.append((sid, ws)) or {"run_id": "file-run", "status": "queued"})
+
+    result = service.create_source({
+        "source_id": "csv-src", "type": "csv", "path": str(tmp_path), "workspace_id": "ws-a",
+    })
+
+    assert result["ok"] is True
+    assert result["bound"] is True
+    assert result["semantic_collection"]["run_id"] == "file-run"
+    assert calls == [("csv-src", "ws-a")]
+    assert binding_env["bindings"]["ws-a"] == result["db_ref"]
+
+
+def test_binding_failure_remains_bound_without_exposing_driver_credentials(monkeypatch, binding_env):
+    binding_env["sources"][("ws-a", "src")] = {
+        "source_id": "src", "source_type": "postgresql", "db_ref": "postgresql://db/shop",
+    }
+
+    def fail(*args):
+        raise RuntimeError("postgresql://user:private-password@db/shop")
+
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", fail)
+    result = service.bind_source_to_workspace({"source_id": "src", "workspace_id": "ws-a"})
+
+    assert result["ok"] is True
+    assert result["semantic_collection"] == {
+        "status": "trigger_failed", "error": "RuntimeError",
+        "reason": "semantic_collection_trigger_failed",
+        "warnings": ["semantic_collection_trigger_failed"],
+    }
+    assert "private-password" not in repr(result)
+    assert binding_env["bindings"]["ws-a"] == "postgresql://db/shop"
+
+
+def test_same_source_id_binding_preserves_target_workspace(monkeypatch, binding_env):
+    for ws in ("ws-a", "ws-b"):
+        binding_env["sources"][(ws, "same-id")] = {
+            "source_id": "same-id", "source_type": "sqlite", "db_ref": f"sqlite:///{ws}.db",
+        }
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda sid, ws: {
+        "run_id": f"{ws}-{sid}", "status": "queued",
+    })
+
+    results = [service.bind_source_to_workspace({"source_id": "same-id", "workspace_id": ws})
+               for ws in ("ws-a", "ws-b")]
+
+    assert [result["semantic_collection"]["run_id"] for result in results] == [
+        "ws-a-same-id", "ws-b-same-id",
+    ]
+    assert binding_env["lookups"] == [("same-id", "ws-a"), ("same-id", "ws-b")]
+
+
+def test_failed_run_is_not_reported_as_queued(monkeypatch):
+    outcome = {"run_id": "failed-run", "status": "failed",
+               "reason": "thread_start_failed", "warnings": ["thread_start_failed"]}
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda *args: outcome)
+
+    result = service._trigger_binding_collection("src", "ws-a")
+
+    assert result == {**outcome, "run_status": "failed"}
+
+
+def test_scheduler_flag_does_not_disable_binding_collection(monkeypatch):
+    monkeypatch.setenv("DATAAGENT_SEMANTIC_P0_ENABLED", "0")
+    monkeypatch.setattr(semantic_service, "start_run_for_binding", lambda *args: {
+        "run_id": "binding-run", "status": "queued",
+    })
+    assert service._trigger_binding_collection("src", "ws-a")["run_id"] == "binding-run"
