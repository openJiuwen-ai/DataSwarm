+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""规模门路径守卫（require_scale_gate_expected）的解析与判定。
+
+背景：full_context.py 代码默认值提到 32768 后，一旦 .env 覆盖
+缺失，三个 eval 空间（目录实测 24.5K~25.5K bytes）会全部静默切到 full_context
+全量直读——召回路径失去评测覆盖且判定基线漂移。守卫按 DW_EVAL_SCALE_GATE_EXPECT
+（hybrid 默认 / full_context / any）比对推断门值，不符 exit 2。
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+
+EVAL_SCRIPTS = Path(__file__).resolve().parents[3] / ".claude/skills/dw-analysis-eval/scripts"
+if str(EVAL_SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(EVAL_SCRIPTS))
+
+import _common  # noqa: E402
+
+
+@pytest.fixture()
+def sandbox(tmp_path, monkeypatch):
+    """REPO_ROOT 指向 tmp：进程 env / .env / 代码默认值三层均可控。"""
+    monkeypatch.delenv("FULL_CONTEXT_MAX_TOKENS", raising=False)
+    monkeypatch.delenv("DW_EVAL_SCALE_GATE_EXPECT", raising=False)
+    monkeypatch.setattr(_common, "REPO_ROOT", tmp_path)
+    src_dir = tmp_path / "jiuwenswarm" / "channels" / "web" / "dataagent" / "analysis"
+    src_dir.mkdir(parents=True)
+    return tmp_path, src_dir
+
+
+def _write_env(root: Path, value: str) -> None:
+    (root / ".env").write_text(f"FULL_CONTEXT_MAX_TOKENS={value}\n", encoding="utf-8")
+
+
+def _write_code_default(src_dir: Path, value: int) -> None:
+    (src_dir / "full_context.py").write_text(
+        f'max_tokens = int(os.environ.get("FULL_CONTEXT_MAX_TOKENS", "{value}"))\n',
+        encoding="utf-8")
+
+
+def test_env_var_beats_env_file_and_code_default(sandbox, monkeypatch):
+    """优先级：进程 env > .env > 代码默认值。"""
+    root, src_dir = sandbox
+    _write_env(root, "20000")
+    _write_code_default(src_dir, 32768)
+    monkeypatch.setenv("FULL_CONTEXT_MAX_TOKENS", "10000")
+    assert _common.resolve_scale_gate_tokens() == 10000
+
+
+def test_env_file_beats_code_default(sandbox):
+    root, src_dir = sandbox
+    _write_env(root, "10000")
+    _write_code_default(src_dir, 32768)
+    assert _common.resolve_scale_gate_tokens() == 10000
+
+
+def test_code_default_when_no_override(sandbox):
+    root, src_dir = sandbox
+    _write_code_default(src_dir, 32768)
+    assert _common.resolve_scale_gate_tokens() == 32768
+
+
+def test_hybrid_expect_rejects_large_gate(sandbox, monkeypatch):
+    """默认期望 hybrid：门值 ≥ 24000（eval 空间目录 24.5K+ 全放行）须拦。"""
+    root, src_dir = sandbox
+    _write_code_default(src_dir, 32768)
+    with pytest.raises(SystemExit) as exc:
+        _common.require_scale_gate_expected()
+    assert exc.value.code == 2
+
+
+def test_hybrid_expect_passes_small_gate(sandbox, capsys):
+    root, src_dir = sandbox
+    _write_env(root, "10000")
+    _write_code_default(src_dir, 32768)
+    _common.require_scale_gate_expected()  # 不退出即通过
+    assert "hybrid" in capsys.readouterr().err
+
+
+def test_full_context_expect_rejects_small_gate(sandbox, monkeypatch):
+    """期望 full_context：门值 < 26000（空间仍走召回）须拦。"""
+    root, src_dir = sandbox
+    _write_env(root, "10000")
+    monkeypatch.setenv("DW_EVAL_SCALE_GATE_EXPECT", "full_context")
+    with pytest.raises(SystemExit) as exc:
+        _common.require_scale_gate_expected()
+    assert exc.value.code == 2
+
+
+def test_any_expect_skips_guard(sandbox, monkeypatch):
+    root, src_dir = sandbox
+    _write_code_default(src_dir, 32768)
+    monkeypatch.setenv("DW_EVAL_SCALE_GATE_EXPECT", "any")
+    _common.require_scale_gate_expected()  # 门值 32768 也不拦
+
+
+def test_invalid_expect_value_rejected(sandbox, monkeypatch):
+    root, src_dir = sandbox
+    _write_env(root, "10000")
+    monkeypatch.setenv("DW_EVAL_SCALE_GATE_EXPECT", "wrong")
+    with pytest.raises(SystemExit) as exc:
+        _common.require_scale_gate_expected()
+    assert exc.value.code == 2
