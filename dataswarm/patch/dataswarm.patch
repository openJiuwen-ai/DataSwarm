+    # delta commit 1
+    write(repo, "jiuwenswarm/a.py", "base+delta\n")
+    write(repo, "jiuwenswarm/new.py", "new\n")
+    write(repo, "jiuwenswarm/resources/agent/workspace/skills/dw-demo/SKILL.md", "demo\n")
+    write(repo, "tests/unit_tests/dw_analysis_eval/test_demo.py", "demo\n")
+    write(repo, "tests/test_new.py", "n\n")
+    write(repo, "jiuwenswarm/channels/web/frontend/tests/ui.test.mjs", "ui\n")
