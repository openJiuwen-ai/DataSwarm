@@ -0,0 +1,265 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""glossary/recall.py —— 术语三级召回（resolve，设计 docs/dataagent/dataagent-glossary-design.md §6）。
+
+阶段1三级召回（§6.2）+ 融合，供指标上下文扩展（metrics/context）、分析召回
+（analysis/recall）与 dwcli glossary resolve（nl2sql 混合召回）消费：
+
+- 层① 精确别名：归一化（NFKC+lower）后「query 包含别名」子串命中，1.0 置顶；
+- 层② 向量：metrics 多向量查询（整句 + jieba 短语）对术语向量投影做内存余弦，
+  校准分 ×0.9（与词法分同刻度，且上限低于层①保证确定性命中恒置顶）；
+- 层③ LIKE 兜底：粗分词逐 token 包含匹配分档（name 0.9 / synonyms 0.7 /
+  definition 0.25，口径对齐 metrics/store.py search_defs 的既有档位）。
+
+三通道恒全跑——观测界面要看每路行为；生产 resolve 的「③仅②不可用时替代」
+（§6.2）由融合取 max 自然退化。阶段2图扩展（§6.3 指标绑定）不做：
+dw_ontology_term_maps 表尚不存在。
+
+为什么读向量走内存余弦而不是 FAISSStore.search_similar：glossary 索引是
+flat L2 且写入时未做 L2 归一化（sync.py），distance 不是余弦刻度；术语量级
+小（几十~几百术语 × N+1 条），逐条取向量做余弦无压力（metrics/embedding.rank
+同模式）。查询向量复用 metrics/embedding（同一平台 embed 配置源；受
+DATASWARM_METRICS_EMB_ENABLED 开关与 .env 补读约束）。换 embed 模型后
+glossary 索引不会自动重建（fingerprint 只含术语文本），维度漂移由
+emb_dims_mismatch warning 暴露，调用方可据此降级处理。
+"""
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from ..metrics import embedding
+from . import db, sync
+
+# 设计 §6.2 融合参数：层②系数 ×0.9（低于层① 1.0）；层③档位上限压 0.9 同理
+_VECTOR_FUSION_FACTOR = 0.9
+_LIKE_NAME, _LIKE_SYNONYM, _LIKE_DEFINITION = 0.9, 0.7, 0.25
+_ALIAS_MIN_LEN = 2        # 子串命中下限：单字别名会被长词误命中（如「销」⊂「销售额」）
+_SCAN_PAGE = 512          # scan_vectors 翻页大小
+_DEFAULT_LIMIT, _MIN_LIMIT, _MAX_LIMIT = 10, 1, 50
+_MATCH_RANK = {"alias": 0, "vector": 1, "like": 2}   # 同分优先级：确定性 > 语义 > 词法
+
+WARN_INDEX_EMPTY = "emb_index_empty"
+WARN_DIMS_MISMATCH = "emb_dims_mismatch"
+
+
+# ==========================================================================
+# 三级召回
+# ==========================================================================
+
+def _alias_hits(terms: list[dict], norm_query: str) -> dict[str, dict]:
+    """层① 精确别名：归一化 query 包含归一化 name/synonym（长度≥2）。
+
+    Returns:
+        ``{term_id: {"score": 1.0, "matched_text": 命中的最长别名原文,
+        "matched_token": 同上}}``——同一术语多别名命中取最长（更具体的匹配更有
+        归因价值）。``matched_token`` 与子串通道同名同义：**问句里被命中的那段
+        文本**，下游据此判断两个术语是在抢同一处提及、还是各自对应不同提及。
+    """
+    hits: dict[str, dict] = {}
+    for term in terms:
+        best = ""
+        for alias in [term["name"], *term.get("synonyms_list", [])]:
+            normalized = db.normalize_alias(alias)
+            if len(normalized) < _ALIAS_MIN_LEN or normalized not in norm_query:
+                continue
+            if len(alias) > len(best):
+                best = alias
+        if best:
+            hits[term["term_id"]] = {"score": 1.0, "matched_text": best,
+                                     "matched_token": best}
+    return hits
+
+
+def _vector_hits(terms_by_id: dict[str, dict], query: str,
+                 warnings: list[str]) -> tuple[dict[str, dict], list[str]]:
+    """层② 向量：翻页取全量投影向量 → 多向量内存余弦 → 按 term_id 取 max。
+
+    降级契约（对齐 semantic/vector_store.recall）：通道不可用记 warning 返回
+    空命中，**绝不抛异常**；「通道关闭」不是「没有相似术语」。
+
+    Returns:
+        ``({term_id: {"score", "matched_text", "emb_via"}}, 查询向量原文列表)``。
+        ``matched_text`` 按 metadata kind 用 sync 写入模板逐字重建（canonical =
+        ``"{name}：{definition}"``，synonym = ``"{别名}（{name}）"``）。
+    """
+    store = sync._faiss_store(sync._workspace_id())
+    entries = _scan_entries(store) if store is not None else []
+    if not entries:
+        warnings.append(WARN_INDEX_EMPTY)
+        return {}, []
+    outcome = embedding.query_vectors(query)
+    if not outcome.ok:
+        warnings.append(outcome.error or embedding.WARN_UNAVAILABLE)
+        return {}, []
+    # 维度漂移检测：cosine 对维度不等静默返回 0，不检测层②会无声死掉
+    if len(entries[0]["vector"]) != outcome.dims:
+        warnings.append(WARN_DIMS_MISMATCH)
+        return {}, list(outcome.texts)
+
+    hits: dict[str, dict] = {}
+    for entry in entries:
+        meta = entry.get("metadata") or {}
+        term = terms_by_id.get(str(meta.get("term_id") or ""))
+        if term is None:  # deprecated 术语（向量已删，防残留）或孤儿条目
+            continue
+        score, win_idx, _raw = embedding.score_against(outcome.vectors, entry["vector"])
+        if score <= 0.0:
+            continue
+        fused = round(score * _VECTOR_FUSION_FACTOR, 4)
+        kind = str(meta.get("kind") or "canonical")
+        if kind == "synonym":
+            text = f"{meta.get('text', '')}（{term['name']}）"
+        else:
+            text = f"{term['name']}：{term['definition']}"
+        prev = hits.get(term["term_id"])
+        if prev is None or fused > prev["score"]:
+            via = outcome.texts[win_idx] if win_idx < len(outcome.texts) else ""
+            hits[term["term_id"]] = {"score": fused, "matched_text": text, "emb_via": via}
+    return hits, list(outcome.texts)
+
+
+def _like_hits(terms: list[dict], query: str) -> dict[str, dict]:
+    """层③ LIKE 兜底：粗分词逐 token 包含匹配，取 max 不求和（命中一词与十词同分）。
+
+    Returns:
+        ``{term_id: {"score", "matched_text": 命中字段名, "matched_token": 命中的词}}``
+        ——``matched_token`` 用于下游区分「同一个词命中多个术语」（真歧义，
+        如「交易总额」同时命中商品交易总额/净交易总额）与「问句提了多个不同
+        术语」（多诉求，如「GMV 和退款金额」）；前者要澄清，后者不要。
+    """
+    tokens = [t for t in tokenize(query) if len(t) >= 2]
+    if not tokens:
+        return {}
+    hits: dict[str, dict] = {}
+    for term in terms:
+        best, matched, matched_token = 0.0, "", ""
+        lowered = {name: str(term.get(name) or "").lower()
+                   for name in ("name", "definition")}
+        synonyms = [str(s).lower() for s in term.get("synonyms_list", [])]
+        for token in tokens:
+            tl = token.lower()
+            if not tl:
+                continue
+            if tl in lowered["name"]:
+                tier, field = _LIKE_NAME, "name"
+            elif any(tl in s for s in synonyms):
+                tier, field = _LIKE_SYNONYM, "synonyms"
+            elif tl in lowered["definition"]:
+                tier, field = _LIKE_DEFINITION, "definition"
+            else:
+                continue
+            if tier > best:
+                best, matched, matched_token = tier, field, token
+        if best > 0.0:
+            hits[term["term_id"]] = {"score": round(best, 4), "matched_text": matched,
+                                     "matched_token": matched_token}
+    return hits
+
+
+def tokenize(text: str) -> list[str]:
+    """粗分词：空白标点切、英文整词、中文 2-gram；混合段先抽 ASCII 整词再 2-gram。
+
+    与 metrics/store.py _tokenize（原口径源头）的差异：混合 chunk 不再无脑滑窗
+    ——2-gram 会把英文缩写碾碎（「最近两年的GMV」→ GM+MV），碎片 token 走子串
+    匹配造成误召回（MV ⊂ NMV 命中 synonyms 档 0.7）。metrics 侧同款问题待同步。
+    """
+    out: list[str] = []
+    for chunk in re.split(r"[\s,，。;；?？!！、/|]+", text or ""):
+        if not chunk:
+            continue
+        # 捕获组保留 ASCII 段：纯英文 chunk 切出 [整词]，混合 chunk 切出 [中文段, 英文段, ...]
+        for seg in re.split(r"([A-Za-z0-9_.\-]+)", chunk):
+            if not seg:
+                continue
+            if re.fullmatch(r"[A-Za-z0-9_.\-]+", seg):
+                out.append(seg)
+            else:
+                out.extend(seg[i:i + 2] for i in range(len(seg) - 1))
+    return out
+
+
+def _scan_entries(store: Any) -> list[dict]:
+    """scan_vectors 翻页取全部 ``{id, metadata, vector}``（跳过 vector 为 None 的条）。"""
+    entries: list[dict] = []
+    offset = 0
+    while True:
+        page = store.scan_vectors(offset, _SCAN_PAGE) or []
+        if not page:
+            break
+        entries.extend(item for item in page if item.get("vector") is not None)
+        if len(page) < _SCAN_PAGE:
+            break
+        offset += len(page)
+    return entries
+
+
+# ==========================================================================
+# 融合与对外入口
+# ==========================================================================
+
+def _fuse(terms_by_id: dict[str, dict], alias: dict[str, dict], vector: dict[str, dict],
+          like: dict[str, dict], limit: int) -> list[dict]:
+    """按 term_id 合并三通道：score = max，match_type = 胜出通道（同分 alias>vector>like）。
+
+    排序：分降序 → 通道优先级 → 更新时间新鲜度降序（设计 §6.2「同分按新鲜度」）
+    → term_id 兜底保序（三趟稳定 sort 从最次要键排到最主要键）。
+    """
+    term_ids = set(alias) | set(vector) | set(like)
+    matches: list[dict] = []
+    for term_id in term_ids:
+        term = terms_by_id[term_id]
+        scores = {
+            "alias": alias.get(term_id, {}).get("score", 0.0),
+            "vector": vector.get(term_id, {}).get("score", 0.0),
+            "like": like.get(term_id, {}).get("score", 0.0),
+        }
+        match_type = min(_MATCH_RANK, key=lambda k: (-scores[k], _MATCH_RANK[k]))
+        winner = {"alias": alias, "vector": vector, "like": like}[match_type].get(term_id, {})
+        matches.append({
+            "term": {key: term.get(key) for key in
+                     ("term_id", "name", "definition", "synonyms_list", "status", "updated_at")},
+            "score": scores[match_type],
+            "match_type": match_type,
+            "matched_text": winner.get("matched_text", ""),
+            "matched_token": winner.get("matched_token", ""),
+            "emb_via": winner.get("emb_via", ""),
+            "scores": scores,
+        })
+    matches.sort(key=lambda m: m["term"]["term_id"])
+    matches.sort(key=lambda m: str(m["term"].get("updated_at") or ""), reverse=True)
+    matches.sort(key=lambda m: (-m["score"], _MATCH_RANK[m["match_type"]]))
+    return matches[:limit]
+
+
+def resolve(query: str, limit: int = _DEFAULT_LIMIT) -> dict:
+    """三级召回 + 融合，返回观测明细（设计 §6.4 结构 + 各通道分数）。
+
+    Args:
+        query: 自然语言问题（trim 后须非空）。
+        limit: 返回条数上限，clamp 到 [1, 50]，作用于融合排序后。
+
+    Returns:
+        ``{"query", "degraded", "query_vectors", "matches", "warnings"}``。
+        ``degraded`` 表示向量通道无法运行（未配置 / 索引空 / 维度漂移 /
+        embed 失败），**不是**向量通道零命中——零命中是合法召回结果。
+    Raises:
+        ValueError: query 为空或全空白。
+    """
+    text = str(query or "").strip()
+    if not text:
+        raise ValueError("query 不能为空")
+    limit = max(_MIN_LIMIT, min(_MAX_LIMIT, limit))
+
+    terms = db.list_terms()  # 默认 active-only：deprecated 不参与任何层
+    terms_by_id = {t["term_id"]: t for t in terms}
+    warnings: list[str] = []
+    alias = _alias_hits(terms, db.normalize_alias(text))
+    vector, query_vectors = _vector_hits(terms_by_id, text, warnings)
+    like = _like_hits(terms, text)
+    return {
+        "query": text,
+        "degraded": bool(warnings),  # 只有层②会记 warning：有即向量通道未跑成
+        "query_vectors": query_vectors,
+        "matches": _fuse(terms_by_id, alias, vector, like, limit),
+        "warnings": warnings,
+    }
diff --git a/jiuwenswarm/channels/web/dataagent/glossary/sync.py b/jiuwenswarm/channels/web/dataagent/glossary/sync.py
