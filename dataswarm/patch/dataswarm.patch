+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""semantic/vector_docs.py 单测：多槽位文档构建、确定性、脱敏红线。
+
+红线用例对照设计文档 §4.1：文档文本与 metadata 只放业务语义词——
+conn_ref / view_definition / top_k 数据值 / data_type 一律不进；
+敏感列的注释仍进（合法召回信号），数据值不进。
+"""
+from __future__ import annotations
+
+import json
+
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    DatabaseMeta,
+    DataSourceMeta,
+    MetadataSnapshot,
+    TableMeta,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.vector_docs import DOC_VERSION, build_docs
+
+_CONN_REF = "mysql://user:secret@host:3306/shop"
+
+
+def _snapshot(table_name: str = "orders", *, legacy: bool = False) -> MetadataSnapshot:
+    """单表快照：列覆盖 有注释/敏感列/无注释 三种形态。"""
+    columns = [
+        ColumnMeta("orders", "mysql", "shop", table_name, "order_id",
+                   data_type="bigint", column_type="bigint", ordinal=1,
+                   column_key="PRI", comment="订单号"),
+        ColumnMeta("orders", "mysql", "shop", table_name, "phone",
+                   data_type="varchar", column_type="varchar(20)", ordinal=2,
+                   comment="客户手机号", is_sensitive=True,
+                   top_k=[{"value": "13800000000", "count": 1}]),
+        ColumnMeta("orders", "mysql", "shop", table_name, "amount",
+                   data_type="decimal", column_type="decimal(10,2)", ordinal=3),
+    ]
+    if legacy:  # 非活跃列不参与召回
+        columns.append(ColumnMeta("orders", "mysql", "shop", table_name, "legacy_col",
+                                  status="deprecated"))
+    tables = [TableMeta("orders", "mysql", "shop", table_name, comment="订单表",
+                        view_definition="SELECT 1 FROM hidden", columns=columns)]
+    if legacy:
+        tables.append(TableMeta("orders", "mysql", "shop", "legacy",
+                                status="deprecated"))
+    return MetadataSnapshot(
+        "snapshot:orders:run-1", "run-1",
+        DataSourceMeta("orders", "mysql", _CONN_REF),
+        [DatabaseMeta("orders", "mysql", "shop")],
+        tables,
+    )
+
+
+def _slot(docs, *, column_name, slot):
+    return next(d for d in docs
+                if d.metadata["column_name"] == column_name
+                and d.metadata["slot"] == slot)
+
+
+def test_build_docs_slots_and_texts():
+    docs = build_docs("ws-1", "orders", _snapshot(legacy=True))
+    texts = {d.id: d.text for d in docs}
+    # 表 2 槽 + 有注释列 3 槽 ×2 + 无注释列 1 槽 = 9；deprecated 表/列 0 槽
+    assert len(docs) == 9
+    assert texts["tbl:mysql:orders:shop.orders:name"] == "shop.orders"
+    assert texts["tbl:mysql:orders:shop.orders:comment"] == "订单表"
+    assert texts["col:mysql:orders:shop.orders.order_id:name"] == "orders.order_id"
+    assert texts["col:mysql:orders:shop.orders.order_id:comment"] == "订单号"
+    # ctx 槽：表注释给列提供业务上下文
+    assert texts["col:mysql:orders:shop.orders.order_id:ctx"] == "订单表 订单号"
+    assert "col:mysql:orders:shop.orders.amount:comment" not in texts  # 无注释跳过
+    assert "tbl:mysql:orders:shop.legacy" not in " ".join(texts)
+    assert all("legacy_col" not in key for key in texts)
+
+
+def test_build_docs_deterministic():
+    snapshot = _snapshot()
+    first = build_docs("ws-1", "orders", snapshot)
+    second = build_docs("ws-1", "orders", snapshot)
+    assert [(d.id, d.doc_hash) for d in first] == [(d.id, d.doc_hash) for d in second]
+
+
+def test_docs_redact_secrets_and_noise():
+    """脱敏红线：连接串/视图定义/采样值/物理类型不进任何文本与 metadata。"""
+    docs = build_docs("ws-1", "orders", _snapshot())
+    blob = json.dumps(
+        [{"text": d.text, "meta": d.metadata} for d in docs], ensure_ascii=False)
+    assert "secret" not in blob            # conn_ref 凭据
+    assert "SELECT 1" not in blob          # view_definition 原文
+    assert "13800000000" not in blob       # top_k 数据值
+    assert "bigint" not in blob            # data_type 技术噪声
+    assert "decimal(10,2)" not in blob     # column_type
+
+
+def test_sensitive_column_comment_is_recallable():
+    """敏感列的注释是合法召回信号（业务名），仍进文档；数据值不进。"""
+    docs = build_docs("ws-1", "orders", _snapshot())
+    phone = _slot(docs, column_name="phone", slot="comment")
+    assert phone.text == "客户手机号"
+
+
+def test_metadata_carries_ledger_fields():
+    docs = build_docs("ws-1", "orders", _snapshot())
+    assert docs, "快照非空必有文档"
+    for doc in docs:
+        assert doc.metadata["doc_version"] == DOC_VERSION
+        assert doc.metadata["doc_hash"] == doc.doc_hash
+        assert doc.metadata["source_id"] == "orders"
+        assert doc.metadata["workspace_id"] == "ws-1"
+        assert doc.metadata["table_name"] == "orders"
+        assert doc.metadata["slot"] in {"name", "comment", "ctx"}
+        assert doc.metadata["kind"] in {"tbl", "col"}
+
+
+def test_table_rename_changes_column_doc_hash():
+    """fingerprint 传导缺口回归：列 name 槽文本含表名前缀，表改名后文本必变。
+
+    采集的 column_fingerprint 不含表名——若同步层直接用对象指纹对账，表改名
+    会漏更新；文档哈希口径下 doc_hash 必然变化。
+    """
+    before = build_docs("ws-1", "orders", _snapshot())
+    after = build_docs("ws-1", "orders", _snapshot(table_name="orders_v2"))
+    old_doc = _slot(before, column_name="order_id", slot="name")
+    new_doc = _slot(after, column_name="order_id", slot="name")
+    assert old_doc.doc_hash != new_doc.doc_hash
+    assert new_doc.text == "orders_v2.order_id"
