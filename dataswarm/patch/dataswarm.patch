+async def test_new_bind_overrides_stale_sticky(kb_workspace, monkeypatch):
+    """下一次请求的 bind 覆盖上一次的 sticky 值。"""
+    mgr = KnowledgeBaseManager.get(kb_workspace)
+    kb_tools.set_global_kb_manager(mgr, kb_workspace)
+
+    first = os.path.join(kb_workspace, "proj-first")
+    second = os.path.join(kb_workspace, "proj-second")
+    for p in (first, second):
+        os.makedirs(p, exist_ok=True)
+
+    token = kb_tools.bind_kb_workspace(first)
+    kb_tools.reset_kb_workspace(token)
+    token = kb_tools.bind_kb_workspace(second)
+    kb_tools.reset_kb_workspace(token)
+
+    # 此时 sticky 应是 second
+    assert kb_tools._current_binding() == second
