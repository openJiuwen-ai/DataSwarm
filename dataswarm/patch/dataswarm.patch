+def run_on(type_id, config):
+    """按 catalog 返回的表名执行分析，避免不同格式的默认视图名影响答案比较。"""
+    conn = connector_for(type_id, config)
+    assert isinstance(conn, SqlQueryable), f"{type_id} 不具备 sql 能力"
+    names = dataset_names(conn.catalog())
+    assert len(names) == 1, f"{type_id} 期望单数据集，实得 {names}"
+    table = names[0]
+    out = {}
+    for label, tpl in QUESTIONS.items():
+        res = conn.query(tpl.format(t=f'"{table}"'), limit=10)
+        out[label] = [[str(v) for v in row] for row in res["rows"]]
+    return out, table
+
+
+def c_same_question_same_answer():
+    import duckdb
+    base = {}
+    bcon = duckdb.connect(":memory:")
+    for label, tpl in QUESTIONS.items():
+        sql = tpl.format(t=f"read_parquet('{(DATA / 'fact_orders.parquet').as_posix()}')")
+        base[label] = [[str(v) for v in row] for row in bcon.execute(sql).fetchall()]
+
+    got, tables = {}, {}
+    for tid, cfg in (("parquet", FACT), ("json", FACT_JSON), ("csv", FACT_CSV)):
+        got[tid], tables[tid] = run_on(tid, cfg)
+
+    for label in QUESTIONS:
+        ref = base[label]
+        for tid, answers in got.items():
+            assert answers[label] == ref, (
+                f"{label} 在 {tid} 上与独立基准不一致:\n"
+                f"  基准={ref}\n  {tid}={answers[label]}"
+            )
+    print("            独立基准答案：")
+    for label in QUESTIONS:
+        ref = base[label]
+        print(f"              {label} = {ref[0] if len(ref) == 1 else ref}")
+    return f"parquet / json / csv 与独立 duckdb 基准逐值一致（视图名 {tables}）"
+
