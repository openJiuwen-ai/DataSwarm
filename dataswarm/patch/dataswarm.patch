+def test_row_counts_use_bound_business_ref_not_doris(patch_store, patch_db_connector, monkeypatch):
+    """P1-2 回归：mysql 业务绑定的行数查询必须走绑定 ref，不得硬连 Doris。
+
+    旧行为：_db_ref_for_name 恒拼 doris://{DORIS_*}/db —— mysql 业务源的血缘
