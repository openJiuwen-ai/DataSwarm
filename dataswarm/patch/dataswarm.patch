@@ -0,0 +1,94 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/business_data/base.py — 业务库访问 DAO 抽象基类 + 注册表 + 工厂。
+
+仿 meta_data/base.py 的 ABC + @register + get_dao 模式。
+每个具体实现封装完整方言 SQL，调用方零 if/else。
+"""
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+
+
+class BusinessDataDao(ABC):
+    """业务库访问策略协议。
+
+    子类实现全部方法，各自内嵌完整的方言 SQL。
+    调用方通过 get_dao() 获取实例，多态调用，无需关心底层数据库。
+    """
+
+    dao_type: str = "base"
+
+    @abstractmethod
+    def list_databases(self) -> list[dict]:
+        """列出可用业务数据库。
+
+        Doris: SHOW DATABASES 过滤系统库。
+        SQLite: 从 datasource.yaml 读配置 + 扫 workspace/data/*.db。
+        """
+
+    @abstractmethod
+    def list_tables(self, db_name: str) -> list[dict]:
+        """列出指定业务库的表；未知行数可为 None，不隐式扫描业务数据。"""
+
+    @abstractmethod
+    def get_table_detail(self, db_name: str, table_name: str) -> dict:
+        """表详情：DDL、列、索引、行数、表说明 comment。"""
+
+    @abstractmethod
+    def preview_table(self, db_name: str, table_name: str, limit: int = 10,
+                      offset: int = 0) -> dict:
+        """预览表数据（offset 起取 N 行）；未知 total 为 None。"""
+
+
+_REGISTRY: dict[str, type[BusinessDataDao]] = {}
+
+
+def register(cls: type[BusinessDataDao]) -> type[BusinessDataDao]:
+    """装饰器：注册 BusinessDataDao 实现。"""
+    _REGISTRY[cls.dao_type] = cls
+    return cls
+
+
+def get_dao(dao_type: str | None = None, db_ref: str | None = None) -> BusinessDataDao:
+    """工厂：返回 BusinessDataDao 实例。
+
+    dao_type 为 None 时，按业务库（default_db）类型自动选择：
+    sqlite:// → sqlite，duckdb 文件源 → duckdb，doris/mysql → doris。
+    扩展协议与暂存源走通用 codec DAO，不假设 MySQL 元数据或分页语法。
+    （MySQL 协议族共用 doris DAO，SQL 全兼容；实际连接目标由 doris_impl
+    按 db_ref 解析——完整 ref 用 ref 自带的 host/port/凭据，短形态/缺省
+    用 config doris: 段）。不看 metadata_db——元数据库与业务库是两个独立
+    数据源，元数据走 SQLite 时业务库仍可能是 Doris。
+    """
+    if dao_type is None:
+        from jiuwenswarm.common import db_connector
+        from jiuwenswarm.common.dialect_registry import db_type_of_ref
+
+        db_ref = db_ref or db_connector.default_db_ref() or None
+        if not db_ref:
+            dao_type = "doris"  # Preserve the legacy unconfigured factory.
+        else:
+            kind = db_type_of_ref(db_ref)
+            if kind == "sqlite":
+                dao_type = "sqlite"
+            elif kind in {"mysql", "doris"}:
+                dao_type = "doris"
+            elif kind == "duckdb":
+                from ..datasource.registry import get_source_type
+
+                spec = db_connector.parse_db_ref(db_ref)
+                engine = get_source_type(spec["source_type"]).engine
+                # 原生库保留 schema 标识，并沿用无隐式 COUNT 的目录浏览。
+                dao_type = "duckdb" if engine == "duckdb" and spec["source_type"] != "duckdb" else "codec"
+            else:
+                dao_type = "codec"
+    cls = _REGISTRY.get(dao_type)
+    if cls is None:
+        raise ValueError(
+            f"unknown dao_type: {dao_type!r} "
+            f"(supported: {list(_REGISTRY)})"
+        )
+    try:
+        return cls(db_ref=db_ref)
+    except TypeError:
+        return cls()
