+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""seed_orchestration_demo.py —— 灌入编排模块演示数据。
+
+建几个演示任务 + 一个工作流，验证端到端：
+    任务1（SQL）  日GMV查询       —— 查 dws_daily_gmv 近 5 天
+    任务2（SQL）  异常订单         —— 查 dwd_fact_orders 金额为负的订单
+    任务3（Python）zscore 演算     —— 算一列数的 zscore（演示 Python 执行器）
+    工作流  GMV巡检工作流
+        node1(任务1) → node2(任务2, wait_review) → node3(任务3)
+
+用法:
+    python -m jiuwenswarm.channels.web.orchestration.seed_orchestration_demo
+    python -m jiuwenswarm.channels.web.orchestration.seed_orchestration_demo --clean  # 清演示数据
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+
+from . import db as orch_db
+
+# 演示数据固定 ID（便于重跑幂等 + --clean 精准清理）
+DEMO_TASK_IDS = ["demo_task_gmv", "demo_task_anomaly", "demo_task_zscore", "demo_task_fail", "demo_task_etl"]
+DEMO_WF_ID = "demo_wf_gmv_inspect"
+
+
+def seed() -> None:
+    orch_db.init_db()
+
+    # 清旧
+    for tid in DEMO_TASK_IDS:
+        orch_db.delete_task(tid)
+    orch_db.delete_workflow(DEMO_WF_ID)
+
+    # 任务1：日GMV查询（SQL）
+    t1 = orch_db.create_task({
+        "task_id": "demo_task_gmv",
+        "name": "日GMV查询",
+        "description": "查 dws_daily_gmv 近 5 天的 GMV",
+        "executor_type": "sql",
+        "code": "SELECT order_date, gmv_product, gmv_payment FROM dws_daily_gmv ORDER BY order_date DESC LIMIT 5",
+        "sla_minutes": 1,
+        "layer": "DWS",
+        "output_table": "dws_daily_gmv",
+    })
+    # 任务2：异常订单（SQL）
+    t2 = orch_db.create_task({
+        "task_id": "demo_task_anomaly",
+        "name": "异常订单检测",
+        "description": "查金额为负或为空的异常订单",
+        "executor_type": "sql",
+        "code": ("SELECT order_id, customer_id, payment_value FROM dwd_fact_orders "
+                 "WHERE payment_value < 0 OR payment_value IS NULL LIMIT 10"),
+        "sla_minutes": 2,
+        "layer": "DWD",
+        "output_table": "dwd_fact_orders",
+    })
+    # 任务3：zscore 演算（Python）
+    t3 = orch_db.create_task({
+        "task_id": "demo_task_zscore",
+        "name": "zscore演算",
+        "description": "对一列数算 zscore，演示 Python 执行器",
+        "executor_type": "python",
+        "sla_minutes": 1,
+        "layer": "ADS",
+        "code": (
+            "import json\n"
+            "vals = [100, 105, 98, 200, 110, 95, 102]\n"
+            "mean = sum(vals) / len(vals)\n"
+            "std = (sum((x - mean) ** 2 for x in vals) / len(vals)) ** 0.5\n"
+            "z = [(x - mean) / std if std else 0 for x in vals]\n"
+            "print('values:', vals)\n"
+            "print('mean:', round(mean, 2), 'std:', round(std, 2))\n"
+            "for i, (v, zc) in enumerate(zip(vals, z)):\n"
+            "    flag = ' <== 异常' if abs(zc) > 1.5 else ''\n"
+            "    print(f'  [{i}] value={v}  z={round(zc, 3)}{flag}')\n"
+            "ORCH_RESULT = {'mean': round(mean, 2), 'std': round(std, 2), 'max_z': round(max(abs(x) for x in z), 3)}\n"
+            "print('RESULT_JSON=' + json.dumps(ORCH_RESULT))\n"
+        ),
+    })
+    # 任务4：会失败的任务（查不存在的表）—— 演示巡检出 task_health failed finding
+    t4 = orch_db.create_task({
+        "task_id": "demo_task_fail",
+        "name": "订单宽表构建",
+        "description": "故意查不存在的表，演示失败被巡检出异常",
+        "executor_type": "sql",
+        "code": "SELECT * FROM dwd_fact_order_items_not_exist LIMIT 10",
+        "sla_minutes": 1,
+        "layer": "DWD",
+        "output_table": "dwd_fact_order_items",
+    })
+    print(f"seeded tasks: {t1['task_id']}, {t2['task_id']}, {t3['task_id']}, {t4['task_id']}")
+
+    # 工作流：node1(任务1) → node2(任务2,wait_review) → node3(任务3)
+    wf = orch_db.create_workflow({
+        "workflow_id": DEMO_WF_ID,
+        "name": "GMV巡检工作流",
+        "description": "日GMV查询 → 人工审核 → zscore演算",
+    })
+    orch_db.replace_nodes(DEMO_WF_ID, [
+        {"task_id": "demo_task_gmv", "node_name": "查GMV", "group_name": "取数", "order_index": 0, "upstream_nodes": ""},
+        {"task_id": "demo_task_anomaly", "node_name": "查异常订单", "group_name": "审核", "order_index": 1,
+         "upstream_nodes": "demo_node_1", "wait_review": True},
+        {"task_id": "demo_task_zscore", "node_name": "zscore演算", "group_name": "分析", "order_index": 2,
+         "upstream_nodes": "demo_node_2"},
+    ])
+    # 给节点固定 ID 便于 upstream 引用：replace_nodes 用 uuid，这里改用 add_node 带固定 ID
+    # 简单起见：重新 replace 时用 node_id 字段
+    orch_db.replace_nodes(DEMO_WF_ID, [
+        {"node_id": "demo_node_1", "task_id": "demo_task_gmv", "node_name": "查GMV", "group_name": "取数",
+         "order_index": 0, "upstream_nodes": ""},
+        {"node_id": "demo_node_2", "task_id": "demo_task_anomaly", "node_name": "查异常订单",
+         "group_name": "审核", "order_index": 1, "upstream_nodes": "demo_node_1", "wait_review": True},
+        {"node_id": "demo_node_3", "task_id": "demo_task_zscore", "node_name": "zscore演算",
+         "group_name": "分析", "order_index": 2, "upstream_nodes": "demo_node_2"},
+    ])
+    print(f"seeded workflow: {wf['workflow_id']} (3 nodes, node2 wait_review)")
+    print("\n演示数据就绪。启动 web 后在「数据开发」左侧导航验证：")
+    print("  - 任务管理：4 个任务（日GMV查询/异常订单检测/zscore演算/订单宽表构建），点「调试」")
+    print("  - 工作流管理：GMV巡检工作流，点「调试」→ 卡在 node2 待审核")
+    print("  - 实例与日志：查 GMV巡检工作流 实例，点「审核通过」续跑")
+    print("\n巡检验证（编排↔巡检打通）：")
+    print("  - 调试「订单宽表构建」任务（会失败：查不存在的表）")
+    print("  - 数仓治理 → 巡检 → 任务维度，应看到 task_health failed finding")
+    print("  - finding 里的 task_id/task_name 是真实编排任务，不再是假样本")
+
+
+def clean() -> None:
+    for tid in DEMO_TASK_IDS:
+        if orch_db.delete_task(tid):
+            print(f"deleted task {tid}")
+    if orch_db.delete_workflow(DEMO_WF_ID):
+        print(f"deleted workflow {DEMO_WF_ID}")
+    # 清演示实例
+    orch_db.init_db()  # 触发孤儿回扫即可
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="灌入编排模块演示数据")
+    parser.add_argument("--clean", action="store_true", help="清演示数据")
+    args = parser.parse_args()
+    if args.clean:
+        clean()
+    else:
+        seed()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
