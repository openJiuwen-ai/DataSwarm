+# --------------------------------------------------------------------------
+# P1-4：凭据更新后 Engine 缓存失效
+# --------------------------------------------------------------------------
+def test_update_source_invalidates_engine_cache(monkeypatch):
+    """UI 改数据源后 connector 的 Engine 池必须重建（否则 preview 用旧凭据）。"""
