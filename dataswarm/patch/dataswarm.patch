+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""数据源类型到 SQL 方言与能力的集中映射。
+
+统一处理 db-ref 的 type 和 datasource 的 source_type；协议族别名由
+_ALIASES 声明。此模块不负责连接。
+
+未注册类型由 profile_for 抛出 UnknownDialectError，避免查询护栏使用错误
+方言。允许默认方言的兼容调用必须显式使用 profile_for_or_default。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Mapping
+
+
+# ==========================================================================
+# 逻辑类型：物理类型名 → 语义分类
+# ==========================================================================
+# knowledge/schema_candidates 的术语/指标派生按逻辑类型判定。原实现直接硬编码
+# MySQL/Doris 口味的类型名集合（TINYINT/MEDIUMTEXT/ENUM...），PG 报
+# character varying / int4 / timestamptz
+# 全都落不进去——不报错，而是静默漏派生。故把归一表并入方言档。
+NUMERIC = "numeric"
+TEXT = "text"
+TIME = "time"
+BOOL = "bool"
+JSON = "json"
+BINARY = "binary"
+OTHER = "other"
+
+#: ANSI / 多方言通用类型名（各方言档在此基础上增量覆盖）。
+_ANSI_TYPES: dict[str, str] = {
+    "INT": NUMERIC, "INTEGER": NUMERIC, "BIGINT": NUMERIC, "SMALLINT": NUMERIC,
+    "TINYINT": NUMERIC, "MEDIUMINT": NUMERIC, "FLOAT": NUMERIC, "DOUBLE": NUMERIC,
+    "DOUBLE PRECISION": NUMERIC, "DECIMAL": NUMERIC, "NUMERIC": NUMERIC, "REAL": NUMERIC,
+    "VARCHAR": TEXT, "CHAR": TEXT, "TEXT": TEXT, "STRING": TEXT,
+    "CHARACTER": TEXT, "CHARACTER VARYING": TEXT,
+    "DATE": TIME, "DATETIME": TIME, "TIMESTAMP": TIME, "TIME": TIME,
+    "BOOLEAN": BOOL, "BOOL": BOOL,
+    "JSON": JSON,
+    "BLOB": BINARY, "BINARY": BINARY, "VARBINARY": BINARY,
+}
+
+
+def _types(**overrides: str) -> dict[str, str]:
+    """ANSI 基表 + 方言增量（关键字里的下划线按空格还原：
+    ``TIMESTAMP_WITH_TIME_ZONE`` → ``TIMESTAMP WITH TIME ZONE``）。"""
+    merged = dict(_ANSI_TYPES)
+    merged.update({k.replace("_", " "): v for k, v in overrides.items()})
+    return merged
+
+
+@dataclass(frozen=True)
+class DialectProfile:
+    """单方言能力位。
+
+    Args:
+        sqlglot_dialect: sqlglot read= 方言名（sql_guard / transpile 用）。
+        ident_quote: 标识符开引号。
+        has_column_comment: DDL 列内 COMMENT 语法是否可用。
+        info_schema: information_schema 可用性（"restricted" = Doris Nereids
+            禁占位符须字面拼接；"no" = 走 DESCRIBE / sqlite_master）。
+        grain_fn: 指标时间粒度函数名（semantic 组装用：sqlite/duckdb strftime，
+            mysql/doris DATE_FORMAT，postgres to_char，tsql FORMAT）。
+        ident_quote_close: 标识符闭引号；空串表示与开引号相同（T-SQL 为 ``]``）。
+        limit_syntax: 分页语法族（limit / offset_fetch），SQL Server 使用 OFFSET/FETCH。
+        type_aliases: 物理类型名（大写、去长度修饰）→ 逻辑类型。
+        extra: 方言专属补充位。
+    """
+
+    sqlglot_dialect: str
+    ident_quote: str
+    has_column_comment: bool
+    info_schema: str
+    grain_fn: str
+    ident_quote_close: str = ""
+    limit_syntax: str = "limit"
+    type_aliases: Mapping[str, str] = field(default_factory=lambda: dict(_ANSI_TYPES))
+    #: 系统 schema 名（小写），catalog 枚举时排除，避免混入业务数据集。
+    system_schemas: tuple[str, ...] = ()
+    extra: dict = field(default_factory=dict)
+
+    @property
+    def quote_close(self) -> str:
+        """闭引号（未显式声明时与开引号相同）。"""
+        return self.ident_quote_close or self.ident_quote
+
+
+# ==========================================================================
+# 方言档
+# ==========================================================================
+_MYSQL_TYPES = _types(
+    TINYTEXT=TEXT, MEDIUMTEXT=TEXT, LONGTEXT=TEXT, ENUM=TEXT, SET=TEXT,
+    TINYBLOB=BINARY, MEDIUMBLOB=BINARY, LONGBLOB=BINARY,
+    YEAR=TIME,
+    BIT=BOOL,
+)
+
+_PG_TYPES = _types(
+    # PG 的 information_schema / psycopg 报的是这些名字
+    INT2=NUMERIC, INT4=NUMERIC, INT8=NUMERIC, FLOAT4=NUMERIC, FLOAT8=NUMERIC,
+    SERIAL=NUMERIC, BIGSERIAL=NUMERIC, SMALLSERIAL=NUMERIC, MONEY=NUMERIC,
+    BPCHAR=TEXT, NAME=TEXT, CITEXT=TEXT, UUID=TEXT,
+    TIMESTAMPTZ=TIME, TIMETZ=TIME, INTERVAL=TIME,
+    TIMESTAMP_WITH_TIME_ZONE=TIME, TIMESTAMP_WITHOUT_TIME_ZONE=TIME,
+    TIME_WITH_TIME_ZONE=TIME, TIME_WITHOUT_TIME_ZONE=TIME,
+    JSONB=JSON,
+    BYTEA=BINARY,
+)
+
+
+_TSQL_TYPES = _types(
+    MONEY=NUMERIC, SMALLMONEY=NUMERIC,
+    NVARCHAR=TEXT, NCHAR=TEXT, NTEXT=TEXT, UNIQUEIDENTIFIER=TEXT, XML=TEXT,
+    DATETIME2=TIME, SMALLDATETIME=TIME, DATETIMEOFFSET=TIME,
+    IMAGE=BINARY, ROWVERSION=BINARY,
+)
+
+#: 文件源（csv/parquet/json/excel/对象存储）统一由 DuckDB 执行，类型名按 DuckDB 报。
+_DUCKDB_TYPES = _types(
+    HUGEINT=NUMERIC, UBIGINT=NUMERIC, UINTEGER=NUMERIC, USMALLINT=NUMERIC,
+    UTINYINT=NUMERIC,
+    INT128=NUMERIC,  # SQLGlot's normalized DDL rendering of DuckDB HUGEINT.
+    UUID=TEXT,
+    TIMESTAMP_WITH_TIME_ZONE=TIME, TIMESTAMPTZ=TIME, INTERVAL=TIME,
+    STRUCT=JSON, MAP=JSON, LIST=JSON,
+)
+
+
+
+_REGISTRY: dict[str, DialectProfile] = {
+    "doris": DialectProfile(
+        sqlglot_dialect="doris",
+        ident_quote="`",
+        has_column_comment=True,
+        info_schema="restricted",
+        grain_fn="DATE_FORMAT",
+        type_aliases=_MYSQL_TYPES,
+        system_schemas=("information_schema", "mysql", "performance_schema", "sys"),
+    ),
+    "mysql": DialectProfile(
+        sqlglot_dialect="mysql",
+        ident_quote="`",
+        has_column_comment=True,
+        info_schema="yes",
+        grain_fn="DATE_FORMAT",
+        type_aliases=_MYSQL_TYPES,
+        system_schemas=("information_schema", "mysql", "performance_schema", "sys"),
+    ),
+    "starrocks": DialectProfile(
+        sqlglot_dialect="starrocks",
+        ident_quote="`",
+        has_column_comment=True,
+        info_schema="yes",
+        grain_fn="DATE_FORMAT",
+        type_aliases=_MYSQL_TYPES,
+        system_schemas=("information_schema", "mysql", "performance_schema", "sys"),
+    ),
+    "duckdb": DialectProfile(
+        sqlglot_dialect="duckdb",
+        ident_quote='"',
+        has_column_comment=False,
+        info_schema="no",
+        grain_fn="strftime",
+        type_aliases=_DUCKDB_TYPES,
+        system_schemas=("information_schema", "pg_catalog", "system", "temp"),
+    ),
+    "sqlite": DialectProfile(
+        sqlglot_dialect="sqlite",
+        ident_quote='"',
+        has_column_comment=False,
+        info_schema="no",
+        grain_fn="strftime",
+        type_aliases=_types(),
+        system_schemas=("temp",),
+    ),
+    # 关系型数据库方言
+    "postgres": DialectProfile(
+        sqlglot_dialect="postgres",
+        ident_quote='"',
+        has_column_comment=True,
+        info_schema="yes",
+        grain_fn="to_char",
+        type_aliases=_PG_TYPES,
+        system_schemas=("pg_catalog", "information_schema", "pg_toast"),
+    ),
+    "tsql": DialectProfile(
+        sqlglot_dialect="tsql",
+        ident_quote="[",
+        ident_quote_close="]",
+        # SQL Server 没有列内 COMMENT 语法，注释走 sp_addextendedproperty。
+        has_column_comment=False,
+        info_schema="yes",
+        grain_fn="FORMAT",
+        limit_syntax="offset_fetch",
+        type_aliases=_TSQL_TYPES,
+        system_schemas=(
+            "sys", "information_schema", "guest", "db_owner", "db_accessadmin", "db_securityadmin",
+            "db_ddladmin", "db_backupoperator", "db_datareader", "db_datawriter", "db_denydatareader",
+            "db_denydatawriter",
+        ),
+    ),
+}
+
+#: 别名 → 规范方言名。两套类型口径（parse_db_ref spec["type"] 与 datasource
+#: source_type）都在此归一；协议族复用也在此声明（加同族引擎 = 加一行）。
+_ALIASES: dict[str, str] = {
+    # ---- MySQL 线协议族 ----
+    "mariadb": "mysql",
+    # ---- PostgreSQL 线协议族 ----
+    "postgresql": "postgres",  # datasource source_type 用 postgresql
+    "pg": "postgres",
+    "hologres": "postgres",    # PG 线协议，默认端口 80
+    # ---- SQL Server ----
+    "sqlserver": "tsql",
+    "sql_server": "tsql",
+    "mssql": "tsql",
+    # ---- 文件 / 对象存储源：一律由 DuckDB 执行，方言归一到 duckdb ----
+    "csv": "duckdb",
+    "excel": "duckdb",
+    "parquet": "duckdb",
+    "json": "duckdb",
+    "s3": "duckdb",
+    "oss": "duckdb",
+    "hdfs": "duckdb",
+    "ftp": "duckdb",
+    # ---- 非 SQL 存储：采样取数后物化进 DuckDB，查询方言即 duckdb ----
+    "mongodb": "duckdb",
+    "redis": "duckdb",
+    "hbase": "duckdb",
+}
+
+
+def _canonical(db_type: str) -> str:
+    key = str(db_type or "").strip().lower()
+    return _ALIASES.get(key, key)
+
+
+class UnknownDialectError(ValueError):
+    """方言档缺失。派生自 ValueError，保持既有 except ValueError 调用点语义。"""
+
+    def __init__(self, db_type: str):
+        self.db_type = db_type
+        super().__init__(
+            f"未注册的方言: {db_type!r}（已注册: {sorted(_REGISTRY)}；"
+            f"别名: {sorted(_ALIASES)}）。新增数据源类型需同时注册方言档。"
+        )
+
+
+def profile_for(db_type: str) -> DialectProfile:
+    """返回数据库类型或 source_type 的方言能力。
+
+    未注册类型抛出 UnknownDialectError，避免只读护栏使用错误方言。
+    """
+    key = _canonical(db_type)
+    profile = _REGISTRY.get(key)
+    if profile is None:
+        raise UnknownDialectError(db_type)
+    return profile
+
+
+def profile_for_or_default(db_type: str, default: str = "mysql") -> DialectProfile:
+    """为明确接受默认方言的兼容调用返回能力档。
+
+    新调用优先使用 profile_for；使用本函数时需说明默认方言为何适用。
+    """
+    try:
+        return profile_for(db_type)
+    except UnknownDialectError:
+        return _REGISTRY[default]
+
+
+def is_registered(db_type: str) -> bool:
+    """方言档是否存在（一致性测试用：每个已注册数据源类型都必须为真）。"""
+    return _canonical(db_type) in _REGISTRY
+
+
+def registered_dialects() -> list[str]:
+    return sorted(_REGISTRY)
+
+
+def sqlglot_dialect(db_type: str) -> str:
+    return profile_for(db_type).sqlglot_dialect
+
+
+def ident_quote(db_type: str) -> str:
+    """标识符开引号。成对不同的方言（T-SQL ``[]``）请用 :func:`quote_ident`。"""
+    return profile_for(db_type).ident_quote
+
+
+def system_schemas(db_type: str) -> tuple[str, ...]:
+    """该方言的系统 schema 名（小写）。catalog 枚举业务数据集时必须排除。"""
+    return profile_for(db_type).system_schemas
+
+
+def is_system_schema(db_type: str, schema_name: str) -> bool:
+    name = str(schema_name or "").strip().lower()
+    if not name:
+        return False
+    sys_set = system_schemas(db_type)
+    # pg_temp_3 / pg_toast_temp_1 这类带序号的临时 schema 按前缀判。
+    return name in sys_set or name.startswith(("pg_temp", "pg_toast"))
+
+
+def quote_ident(db_type: str, name: str) -> str:
+    """按方言给单个标识符加引号（正确处理 T-SQL 的成对 ``[]`` 与引号转义）。"""
+    profile = profile_for(db_type)
+    open_q, close_q = profile.ident_quote, profile.quote_close
+    # 转义：闭引号在标识符内出现时按该方言规则加倍（T-SQL 的 ] → ]]）。
+    escaped = str(name).replace(close_q, close_q * 2)
+    return f"{open_q}{escaped}{close_q}"
+
+
+def quote_qualified(db_type: str, dotted: str) -> str:
+    """给点分多段标识符（``schema.table``）逐段加引号。"""
+    return ".".join(quote_ident(db_type, part) for part in str(dotted).split("."))
+
+
+def logical_type(db_type: str, physical_type: str) -> str:
+    """物理类型名 → 逻辑类型（numeric / text / time / bool / json / binary / other）。
+
+    去掉长度与精度修饰（``varchar(50)`` → ``VARCHAR``）、把下划线与多空格归一
+    （``timestamp without time zone``），再查方言档的 ``type_aliases``。
+    查不到返回 ``other``——分类未知不应阻断流程，但也不该冒充 numeric/text。
+    """
+    base = str(physical_type or "").split("(")[0].split("[")[0].strip().upper()
+    base = " ".join(base.replace("_", " ").split())
+    if not base:
+        return OTHER
+    aliases = profile_for(db_type).type_aliases
+    if base in aliases:
+        return aliases[base]
+    # 已归一掉修饰后仍未命中：按首词再试一次（吃掉 UNSIGNED / ZEROFILL 等后缀修饰）
+    head = base.split(" ", 1)[0]
+    return aliases.get(head, OTHER)
+
+
+def db_type_of_ref(db_ref: str) -> str:
+    """只根据 scheme 解析 db-ref 类型，不读取配置或凭据。
+
+    裸路径按 sqlite 处理，与 parse_db_ref 的类型约定一致。
+    """
+    ref = str(db_ref or "").strip()
+    if not ref or "://" not in ref:
+        return "sqlite"
+    return ref.split("://", 1)[0].strip().lower()
+
+
+def dialect_of_ref(db_ref: str, parse_fn=None) -> str:
+    """db-ref → sqlglot 方言名。
+
+    Args:
+        db_ref: 连接串（如 ``sqlite:///x.db`` / ``duckdb://...``）。
+        parse_fn: ref 解析函数（默认 db_connector.parse_db_ref；显式注入
+            便于 skill 侧 / 单测传纯函数版，避免循环 import）。
+
+    Returns:
+        sqlglot 方言名（doris / mysql / duckdb / sqlite / postgres / ...）。
+    """
+    if parse_fn is None:
+        from jiuwenswarm.common.db_connector import parse_db_ref as parse_fn
+    db_type = str(parse_fn(db_ref).get("type") or "sqlite")
+    return sqlglot_dialect(db_type)
