+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/rerank.py + context_pack.py 单测（阶段 E：L2①b/②/③）。
+
+- dedupe_and_rank：同 ID 合并（直发分保留、来源归并）、直发优先、
+  独立来源数排序
+- mark_ambiguity：头部 RRF 同分标 ambiguous；alias 同分不算
+- build_packs：三子包组装（schema 按表分组、维值候选附列、
+  join 边进对应表、scope_of 摘要）
+- fill_selected_metrics：选定指标回读（semantic_link 打桩）
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from jiuwenswarm.channels.web.dataagent.analysis import context_pack
+from jiuwenswarm.channels.web.dataagent.analysis.graph_expand import Expansion
+from jiuwenswarm.channels.web.dataagent.analysis.model import (
+    ContextPacks,
+    RecallHit,
+    RoadResult,
+    SchemaTablePack,
+)
+from jiuwenswarm.channels.web.dataagent.analysis.rerank import (
+    dedupe_and_rank,
+    mark_ambiguity,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    DatabaseMeta,
+    DataSourceMeta,
+    JoinPathMeta,
+    MetadataSnapshot,
+    TableMeta,
+)
+
+
+def _hit(entity_id: str, *, rrf: float = 0.0, matched: tuple[str, ...] = ("lexical",),
+         payload: dict | None = None, raw: float = 0.9,
+         channel: str = "lexical", token: str = "") -> RecallHit:
+    data = dict(payload or {})
+    if token:
+        data["matched_token"] = token
+    return RecallHit(kind="metric", entity_id=entity_id, label=entity_id,
+                     channels=[(channel, raw)] if rrf else [],
+                     matched_on=list(matched), rrf_score=rrf, payload=data)
+
+
+# ==========================================================================
+# rerank
+# ==========================================================================
+
+def test_dedupe_merges_direct_and_graph_sources():
+    direct = _hit("gmv", rrf=0.032, matched=("lexical",))
+    graph = _hit("gmv", matched=("graph:usesColumn:orders.amount",))
+    other = _hit("aov", rrf=0.016)
+    ranked = dedupe_and_rank(
+        RoadResult("metric", (direct, other), "ok"), [graph])
+    assert len(ranked) == 2
+    assert ranked[0].entity_id == "gmv"
+    # 来源归并 + 直发 RRF 分保留
+    assert set(ranked[0].matched_on) == {"lexical", "graph:usesColumn:orders.amount"}
+    assert ranked[0].rrf_score == 0.032
+
+
+def test_direct_beats_pure_graph_candidate():
+    pure_graph = _hit("hidden", matched=("graph:measuresConcept:GMV",))
+    weak_direct = _hit("weak", rrf=0.001)
+    ranked = dedupe_and_rank(RoadResult("metric", (weak_direct,), "ok"), [pure_graph])
+    assert ranked[0].entity_id == "weak"
+
+
+def test_source_count_breaks_ties():
+    """RRF 分缺失时（纯补全候选间）按独立来源数排序。"""
+    single = _hit("one", matched=("graph:a",))
+    double = _hit("two", matched=("graph:a", "graph:b"))
+    ranked = dedupe_and_rank(RoadResult("metric", (), "no_hit"), [single, double])
+    assert ranked[0].entity_id == "two"
+
+
+def test_mark_ambiguity_tied_top_scores():
+    """同通道同原始分 → 歧义；原始分更低的候选不算。"""
+    a = _hit("a", rrf=0.032, matched=("vector",), channel="vector", raw=0.72)
+    b = _hit("b", rrf=0.030, matched=("vector",), channel="vector", raw=0.72)
+    c = _hit("c", rrf=0.016, matched=("vector",), channel="vector", raw=0.55)
+    terms = mark_ambiguity([a, b, c])
+    assert terms[0].payload["ambiguous"] and terms[1].payload["ambiguous"]
+    assert "ambiguous" not in terms[2].payload
+
+
+def test_mark_ambiguity_detects_tie_despite_different_rrf():
+    """本次修复的核心场景：RRF 分不同（排名打破了平局）但原始分并列。
+
+    「交易总额」同时 LIKE 命中「商品交易总额」「净交易总额」——同通道
+    name 档各 0.9、命中同一个词，必须判歧义去澄清；按 RRF 分判则永远漏掉。
+    """
+    gross = _hit("t_gross", rrf=1 / 61, matched=("like",), raw=0.9, token="交易总额")
+    net = _hit("t_net", rrf=1 / 62, matched=("like",), raw=0.9, token="交易总额")
+    terms = mark_ambiguity([gross, net])
+    assert terms[0].payload["ambiguous"] and terms[1].payload["ambiguous"]
+
+
+def test_mark_ambiguity_different_tokens_is_multi_intent():
+    """「GMV 和退款金额」命中两个术语 = 两个诉求，**不是**歧义（不该反问）。"""
+    gmv = _hit("t_gmv", rrf=1 / 61, matched=("like",), raw=0.9, token="gmv")
+    refund = _hit("t_refund", rrf=1 / 62, matched=("like",), raw=0.9, token="退款")
+    terms = mark_ambiguity([gmv, refund])
+    assert "ambiguous" not in terms[0].payload
+    assert "ambiguous" not in terms[1].payload
+
+
+def test_mark_ambiguity_cross_channel_not_tied():
+    """跨通道原始分相同不算并列（RRF 存在的理由就是两者不可比）。"""
+    a = _hit("a", rrf=0.032, matched=("like",), channel="lexical", raw=0.9)
+    b = _hit("b", rrf=0.016, matched=("emb",), channel="vector", raw=0.9)
+    terms = mark_ambiguity([a, b])
+    assert "ambiguous" not in terms[0].payload
+    assert "ambiguous" not in terms[1].payload
+
+
+def test_mark_ambiguity_alias_hits_not_ambiguous():
+    """双别名同分 = 用户同时点名两个术语（明确意图，非歧义）。"""
+    a = _hit("a", rrf=0.032, matched=("alias",), token="同词")
+    b = _hit("b", rrf=0.032, matched=("alias",), token="同词")
+    terms = mark_ambiguity([a, b])
+    assert "ambiguous" not in terms[0].payload
+    assert "ambiguous" not in terms[1].payload
+
+
+# ==========================================================================
+# context_pack
+# ==========================================================================
+
+def _snapshot() -> MetadataSnapshot:
+    orders = TableMeta("src", "mysql", "shop", "orders", comment="订单表", columns=[
+        ColumnMeta("src", "mysql", "shop", "orders", "amount_cny",
+                   data_type="decimal", ordinal=1, comment="订单金额"),
+        ColumnMeta("src", "mysql", "shop", "orders", "region",
+                   data_type="varchar", ordinal=2, comment="销售区域"),
+    ])
+    joins = [JoinPathMeta(
+        source_id="src", source_type="mysql",
+        left_column_id="col:mysql:src:shop.orders.amount_cny",
+        right_column_id="col:mysql:src:shop.customers.amount_cny",
+        left_table_id="tbl:mysql:src:shop.orders",
+        right_table_id="tbl:mysql:src:shop.customers",
+        source=["naming_convention"], evidence={"level": "inferred"})]
+    return MetadataSnapshot(
+        "snapshot:src:run-1", "run-1",
+        DataSourceMeta("src", "mysql", "mysql://db:3306/shop"),
+        [DatabaseMeta("src", "mysql", "shop")], [orders], joins=joins)
+
+
+def test_build_packs_groups_by_table_with_values(monkeypatch):
+    from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+    monkeypatch.setattr(metric_store, "get_active_release",
+                        lambda ws: SimpleNamespace(release_id="rel-1"))
+    # 候选阶段回读已发布修订附维度/粒度白名单——打桩，免落真实元数据库
+    monkeypatch.setattr(metric_store, "published_revision_of", lambda ws, key: SimpleNamespace(
+        allowed_dimensions=("orders.region",), time_grains=("month",)))
+
+    recall = {
+        "terms": RoadResult("term", (RecallHit(
+            kind="term", entity_id="t-1", label="商品交易总额",
+            channels=[("lexical", 0.9)], matched_on=["alias"],
+            payload={"term_id": "t-1", "name": "商品交易总额",
+                     "definition": "已支付订单总金额", "synonyms": ["流水"]}),), "ok"),
+        "metrics": RoadResult("metric", (RecallHit(
+            kind="metric", entity_id="commerce.gmv", label="GMV",
+            channels=[("lexical", 0.9)], matched_on=["lexical:name"],
+            payload={"metric_key": "commerce.gmv", "revision_id": "rev-1",
+                     "display_name": "GMV"}),), "ok"),
+        "schema": RoadResult("column", (RecallHit(
+            kind="column", entity_id="col:mysql:src:shop.orders.amount_cny",
+            label="订单金额", channels=[("lexical", 0.8)], matched_on=["schema:label"],
+            payload={"logical": "orders.amount_cny"}),), "ok"),
+        "values": RoadResult("value", (RecallHit(
+            kind="value", entity_id="v-1", label="华东",
+            channels=[("lexical:exact", 1.0)], matched_on=["value:exact"],
+            payload={"column_id": "col:mysql:src:shop.orders.region",
+                     "table_id": "tbl:mysql:src:shop.orders",
+                     "value": "华东"}),), "ok"),
+    }
+    expansion = Expansion()
+    expansion.tables.append("tbl:mysql:src:shop.orders")
+    expansion.joins.append({
+        "left": "col:mysql:src:shop.orders.amount_cny",
+        "right": "col:mysql:src:shop.customers.amount_cny",
+        "level": "inferred", "status": "candidate",
+        "cardinality": "unknown", "confidence": 0.5})
+    refs = [SimpleNamespace(source_id="src", snapshot_id="snapshot:src:run-1")]
+
+    packs = context_pack.build_packs(recall, expansion, "ws", {"src": _snapshot()}, refs)
+
+    # 术语子包
+    assert packs.glossary[0]["name"] == "商品交易总额"
+    # 指标候选子包
+    assert packs.metrics_candidates[0]["metric_key"] == "commerce.gmv"
+    assert packs.metrics_candidates[0]["allowed_dimensions"] == ["orders.region"]
+    assert packs.metrics_candidates[0]["time_grains"] == ["month"]
+    # schema 子包：orders 表一组、维值候选附到 region 列、命中列标记
+    assert len(packs.schema_tables) == 1
+    table_pack = packs.schema_tables[0]
+    assert table_pack.table == "orders"
+    by_name = {column["name"]: column for column in table_pack.columns}
+    assert by_name["amount_cny"]["matched"] is True
+    assert by_name["amount_cny"].get("value_candidates") == []
+    assert by_name["region"]["value_candidates"] == ["华东"]
+    assert by_name["region"]["matched"] is False  # 仅维值带出（非 L1 直发命中）
+    # join 边挂到触及表
+    assert len(table_pack.joins) == 1 and table_pack.joins[0]["level"] == "inferred"
+    # 版本记录
+    assert packs.semantic_versions["release_id"] == "rel-1"
+    assert packs.semantic_versions["snapshots"][0]["snapshot_id"] == "snapshot:src:run-1"
+
+
+def test_scope_of_digest():
+    packs = ContextPacks()
