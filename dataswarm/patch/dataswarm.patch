+    monkeypatch.setattr(llm_mod, "create_llm_client", lambda config: _FakeClient())
+
+    out = fr.review_all({"schema": str(p)})
+    assert out["total_reviewed"] == 2
+    assert out["rejected"] == 2
+
+    payload = json.loads(p.read_text(encoding="utf-8"))
+    f1 = payload["findings"][0]  # on_time_rate：info+rejected → info
+    assert f1["llm_verdict"] == "rejected"
+    assert f1["severity"] == "info"
+    assert "original_severity" not in f1  # info → info 无降级
+    f2 = payload["findings"][1]  # 全空列 high：rejected → info
