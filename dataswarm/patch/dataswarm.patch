@@ -0,0 +1,373 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 指标管理页：搜索 + 状态筛选 + KPI + 分页表格 + 增删改查入口。
+ *
+ * 列表筛选与分页下推服务端（`GET /metrics?keyword=&status=&page=&page_size=`），
+ * 前端不做全量渲染；口径不可变：编辑只改身份信息，口径变更走「新建修订」。
+ */
+
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  Button,
+  EmptyState,
+  ErrorBanner,
+  SolidButton,
+  STATUS_DOT_TONE,
+  StatusDot,
+  Table,
+} from '../_shared/ui';
+import { Pagination } from '../../components/ui/Pagination/Pagination';
+import {
+  metricsV2Api,
+  type V2MetricDetail,
+  type V2MetricListItem,
+} from './api';
+import { MetricDetailDrawer } from './MetricDetailDrawer';
+import { MetricFormDrawer, type MetricFormMode } from './MetricFormDrawer';
+import { ImportModelDialog } from './ImportModelDialog';
+import { enumLabel, formatTime } from './ui';
+import { RefreshCw, Search } from 'lucide-react';
+
+/** 状态筛选胶囊：对齐数据开发 dd-count dd-status-toggle（选中 accent 边框+浅蓝底）。 */
+const filterChipClass = (active: boolean) =>
+  `inline-flex cursor-pointer items-center rounded-full border bg-transparent px-2.5 py-0.5 text-xs ${
+    active
+      ? 'border-[var(--color-border-accent)] bg-[var(--color-tag-info-surface)]'
+      : 'border-[var(--color-border-default)] hover:border-[var(--color-border-hover)]'
+  }`;
+
+type StatusFilter = 'all' | 'published' | 'draft';
+type SortKey = 'metric_key:asc' | 'updated_at:desc' | 'name:asc';
+const DEFAULT_PAGE_SIZE = 10;
+
+interface FormState {
+  mode: MetricFormMode;
+  metric?: V2MetricListItem;
+  detail?: V2MetricDetail;
+}
+
+interface Notice {
+  tone: 'ok' | 'error';
+  text: string;
+}
+
+export function MetricsTab() {
+  const { t } = useTranslation();
+  const [metrics, setMetrics] = useState<V2MetricListItem[]>([]);
+  const [total, setTotal] = useState(0);
+  const [statusCounts, setStatusCounts] = useState<Record<string, number>>({});
+  const [keyword, setKeyword] = useState('');
+  const [appliedKeyword, setAppliedKeyword] = useState('');
+  const [statusFilter, setStatusFilter] = useState<StatusFilter>('all');
+  const [sortKey, setSortKey] = useState<SortKey>('metric_key:asc');
+  const [page, setPage] = useState(1);
+  const [pageSize, setPageSize] = useState(DEFAULT_PAGE_SIZE);
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [detailKey, setDetailKey] = useState<string | null>(null);
+  // 表单抽屉常挂载：formState 决定模式/目标指标，formOpen 只控显隐——create 误触关闭后已写内容保留
+  const [formState, setFormState] = useState<FormState>({ mode: 'create' });
+  const [formOpen, setFormOpen] = useState(false);
+  const [importOpen, setImportOpen] = useState(false);
+
+  const fetchPage = useCallback(async (query: {
+    keyword: string; status: StatusFilter; sortKey: SortKey;
+    page: number; pageSize: number;
+  }) => {
+    setBusy(true);
+    try {
+      const [sort, order] = query.sortKey.split(':') as [string, 'asc' | 'desc'];
+      const payload = await metricsV2Api.listMetrics({
+        keyword: query.keyword, status: query.status, sort, order,
+        page: query.page, pageSize: query.pageSize,
+      });
+      setMetrics(payload.metrics);
+      setTotal(payload.total);
+      setStatusCounts(payload.status_counts ?? {});
+    } catch (e) {
+      setNotice({ tone: 'error', text: e instanceof Error ? e.message : String(e) });
+    } finally {
+      setBusy(false);
+    }
+  }, []);
+
+  const reload = useCallback(() => {
+    void fetchPage({
+      keyword: appliedKeyword, status: statusFilter, sortKey, page, pageSize,
+    });
+  }, [fetchPage, appliedKeyword, statusFilter, sortKey, page, pageSize]);
+
+  useEffect(() => { reload(); }, [reload]);
+
+  const search = () => {
+    const kw = keyword.trim();
+    if (kw === appliedKeyword) {
+      reload();
+      return;
+    }
+    setAppliedKeyword(kw);
+    setPage(1);
+  };
+
+  const pickStatus = (status: StatusFilter) => {
+    if (status === statusFilter) return;
+    setStatusFilter(status);
+    setPage(1);
+  };
+
+  // create 打开时不清 formState，MetricFormDrawer 内部保留上次输入作为缓存
+  const openCreateForm = () => {
+    setFormState({ mode: 'create' });
+    setFormOpen(true);
+  };
+
+  const clearFilters = () => {
+    setKeyword('');
+    setAppliedKeyword('');
+    setStatusFilter('all');
+    setPage(1);
+  };
+
+  const counts = useMemo(() => ({
+    published: statusCounts.published ?? 0,
+    draft: statusCounts.draft ?? 0,
+  }), [statusCounts]);
+
+  const remove = (metric: V2MetricListItem) => {
+    const message = metric.has_published
+      ? t('biMetrics.list.deletePublishedConfirm', { name: metric.name })
+      : t('biMetrics.list.deleteDraftConfirm', { name: metric.name, count: metric.revision_count });
+    if (!window.confirm(message)) return;
+    setBusy(true);
+    void (async () => {
+      try {
+        const result = await metricsV2Api.deleteMetric(metric.metric_key, metric.has_published);
+        const projection = result.projection.status === 'ok'
+          ? t('biMetrics.list.projectionOk', { detail: result.projection.detail })
+          : result.projection.status === 'failed'
+            ? t('biMetrics.list.projectionFailed', { detail: result.projection.detail })
+            : '';
+        setNotice({
+          tone: 'ok',
+          text: t('biMetrics.list.deletedNotice', {
+            name: metric.name, revisions: result.revisions,
+            bindings: result.bindings, mappings: result.mappings, projection,
+          }),
+        });
+        if (detailKey === metric.metric_key) setDetailKey(null);
+        // 删掉当前页最后一条时回退一页，避免停在空页
+        const lastPage = Math.max(1, Math.ceil(Math.max(0, total - 1) / pageSize));
+        if (page > lastPage) setPage(lastPage);
+        else reload();
+      } catch (e) {
+        setNotice({ tone: 'error', text: e instanceof Error ? e.message : String(e) });
+      } finally {
+        setBusy(false);
+      }
+    })();
+  };
+
+  const rows = metrics.map((metric) => {
+    const revision = metric.current_revision ?? metric.latest_revision;
+    return [
+      <button className="text-left" onClick={() => setDetailKey(metric.metric_key)}>
+        <div className="font-medium text-text-strong hover:text-text-link">{metric.name}</div>
+        <div className="font-mono text-xs text-text-muted">{metric.metric_key}</div>
+      </button>,
+      <span className="text-xs text-text">{revision ? enumLabel(t, 'type', revision.metric_type) : '—'}</span>,
+      <div className="flex flex-wrap items-center gap-3">
+        <StatusDot
+          tone={metric.has_published ? STATUS_DOT_TONE.success : STATUS_DOT_TONE.draft}
+          label={metric.has_published
+            ? t('biMetrics.enum.revisionStatus.published')
+            : metric.revision_count ? t('biMetrics.enum.revisionStatus.draft') : t('biMetrics.list.noRevisions')}
+        />
+        {metric.has_published && metric.latest_revision?.status === 'candidate' && (
+          <StatusDot tone={STATUS_DOT_TONE.warning}
+                     label={t('biMetrics.list.revisionCandidate', { no: metric.latest_revision.revision_no })} />
+        )}
+      </div>,
+      <span className="text-xs text-text-muted">{revision?.unit || '—'}</span>,
+      <span className="text-xs text-text-muted">{revision?.time_dimension || '—'}</span>,
+      <span className="text-xs text-text">{metric.revision_count}</span>,
+      <span className="text-xs text-text-muted">{formatTime(metric.updated_at)}</span>,
+      // 行内文字动作：对齐数据接入 ds-action-link（accent 蓝，删除红）
+      <div className="flex items-center gap-3">
+        <button className="cursor-pointer whitespace-nowrap border-0 bg-transparent p-0 text-sm text-[var(--color-chat-accent)] hover:opacity-80"
+                onClick={() => setDetailKey(metric.metric_key)}>
+          {t('biMetrics.list.details')}
+        </button>
+        <button className="cursor-pointer whitespace-nowrap border-0 bg-transparent p-0 text-sm text-[var(--color-chat-accent)] hover:opacity-80"
+                onClick={() => { setFormState({ mode: 'edit', metric }); setFormOpen(true); }}>
+          {t('biMetrics.list.edit')}
+        </button>
+        <button className="cursor-pointer whitespace-nowrap border-0 bg-transparent p-0 text-sm text-[var(--color-feedback-danger)] hover:opacity-80"
+                onClick={() => remove(metric)}>
+          {t('biMetrics.list.delete')}
+        </button>
+      </div>,
+    ];
+  });
+
+  return (
+    <div className="space-y-4">
+      {/* 标题行：标题+状态筛选胶囊（左） / 操作按钮（右） */}
+      <div className="flex h-8 items-center justify-between gap-3">
+        <div className="flex items-center gap-3">
+          <h2 className="text-base font-semibold leading-6 text-text-strong">
+            {t('biMetrics.list.countTitle', { count: total })}
+          </h2>
+          <button
+            type="button"
+            className={filterChipClass(statusFilter === 'draft')}
+            aria-pressed={statusFilter === 'draft'}
+            onClick={() => pickStatus('draft')}>
+            <StatusDot small tone={STATUS_DOT_TONE.draft}
+                       label={t('biMetrics.list.draftFilter', { count: counts.draft })} />
+          </button>
+          <button
+            type="button"
+            className={filterChipClass(statusFilter === 'published')}
+            aria-pressed={statusFilter === 'published'}
+            onClick={() => pickStatus('published')}>
+            <StatusDot small tone={STATUS_DOT_TONE.success}
+                       label={t('biMetrics.list.publishedFilter', { count: counts.published })} />
+          </button>
+        </div>
+        <div className="flex items-center gap-2">
+          <SolidButton onClick={() => setImportOpen(true)}>{t('biMetrics.list.ossieImport')}</SolidButton>
+          <SolidButton onClick={openCreateForm}>{t('biMetrics.list.create')}</SolidButton>
+        </div>
+      </div>
+
+      {notice && (
+        notice.tone === 'error'
+          ? <ErrorBanner message={notice.text} onDismiss={() => setNotice(null)} />
+          : (
+            <div className="flex items-start justify-between rounded-lg border border-accent/40 bg-accent-subtle px-3 py-2 text-sm text-text">
+              <span className="min-w-0 break-all">{notice.text}</span>
+              <button className="ml-2 flex-none opacity-70 hover:opacity-100"
+                      onClick={() => setNotice(null)}>×</button>
+            </div>
+          )
+      )}
+
+      {/* 工具行：搜索 + 刷新（左）/ 排序（右） */}
+      <div className="flex flex-wrap items-center gap-3">
+        <div className="relative max-w-md flex-1">
+          <Search size={14} className="absolute left-2.5 top-2.5 text-text-muted" />
+          <input
+            className="w-full rounded border border-line bg-bg py-1.5 pl-8 pr-3 text-xs text-text placeholder:text-text-muted focus:border-accent focus:outline-none"
+            value={keyword}
+            placeholder={t('biMetrics.list.searchPlaceholder')}
+            onChange={(e) => setKeyword(e.target.value)}
+            onKeyDown={(e) => { if (e.key === 'Enter') search(); }}
+          />
+        </div>
+        {/* 刷新：对齐数据接入 ds-icon-button（纯图标，紧挨搜索框） */}
+        <button
+          className="inline-flex h-8 w-8 flex-none items-center justify-center rounded-md border border-line bg-transparent text-text-muted hover:bg-secondary hover:text-text"
+          onClick={reload}
+          title={t('biMetrics.list.refresh')}
+          aria-label={t('biMetrics.list.refresh')}>
+          <RefreshCw size={16} className={busy ? 'animate-spin' : ''} />
+        </button>
+        <Button variant="default" size="sm" loading={busy} onClick={search}>{t('biMetrics.list.search')}</Button>
+        {(appliedKeyword || statusFilter !== 'all') && (
+          <Button variant="ghost" size="sm" onClick={clearFilters}>{t('biMetrics.list.clearFilters')}</Button>
+        )}
+        <label className="ml-auto flex items-center gap-1 text-xs text-text-muted">
+          {t('biMetrics.list.sort')}
+          <select className="rounded border border-line bg-bg px-2 py-1 text-xs text-text"
+                  value={sortKey}
+                  onChange={(e) => { setSortKey(e.target.value as SortKey); setPage(1); }}>
+            <option value="metric_key:asc">{t('biMetrics.list.sortKey')}</option>
+            <option value="updated_at:desc">{t('biMetrics.list.sortUpdated')}</option>
+            <option value="name:asc">{t('biMetrics.list.sortName')}</option>
+          </select>
+        </label>
+      </div>
+
+      {!busy && metrics.length === 0 ? (
+        <EmptyState
+          icon={<Search size={32} />}
+          title={appliedKeyword || statusFilter !== 'all'
+            ? t('biMetrics.list.noMatchTitle') : t('biMetrics.list.noMetricsTitle')}
+          hint={appliedKeyword || statusFilter !== 'all'
+            ? t('biMetrics.list.noMatchHint')
+            : t('biMetrics.list.noMetricsHint')}
+          actionLabel={appliedKeyword || statusFilter !== 'all' ? undefined : t('biMetrics.list.emptyActionCreate')}
+          onAction={appliedKeyword || statusFilter !== 'all'
+            ? undefined
+            : openCreateForm}
+        />
+      ) : (
+        <>
+          <Table
+            headers={[
+              t('biMetrics.list.headers.metric'),
+              t('biMetrics.list.headers.type'),
+              t('biMetrics.list.headers.status'),
+              t('biMetrics.list.headers.unit'),
+              t('biMetrics.list.headers.timeDimension'),
+              t('biMetrics.list.headers.revisionCount'),
+              t('biMetrics.list.headers.updatedAt'),
+              t('biMetrics.list.headers.actions'),
+            ]}
+            rows={rows}
+            mutedHead
+          />
+          <Pagination
+            total={total}
+            page={page}
+            pageSize={pageSize}
+            onPageChange={setPage}
+            onPageSizeChange={(size) => { setPageSize(size); setPage(1); }}
+            labels={{
+              total: t('biMetrics.pagination.totalItems', { count: total }),
+              pageSize: t('biMetrics.pagination.pageSize'),
+              previous: t('biMetrics.pagination.previous'),
+              next: t('biMetrics.pagination.next'),
+              page: (no) => t('biMetrics.pagination.page', { no }),
+              navLabel: t('biMetrics.pagination.metricsNav'),
+            }}
+            pageSizeOptions={[10, 20, 50]}
+            loading={busy}
+          />
+        </>
+      )}
+
+      {detailKey && (
+        <MetricDetailDrawer
+          metricKey={detailKey}
+          onClose={() => setDetailKey(null)}
+          onChanged={reload}
+          onCreateRevision={(detail) => {
+            const metric = metrics.find((m) => m.metric_key === detail.metric.metric_key);
+            if (metric) { setFormState({ mode: 'revision', metric, detail }); setFormOpen(true); }
+          }}
+        />
+      )}
+
+      <MetricFormDrawer
+        open={formOpen}
+        mode={formState.mode}
+        metric={formState.metric}
+        detail={formState.detail}
+        onClose={() => setFormOpen(false)}
+        onSaved={(message) => {
+          setFormOpen(false);
+          setNotice({ tone: 'ok', text: message });
+          reload();
+        }}
+      />
+
+      {importOpen && (
+        <ImportModelDialog
+          onClose={() => setImportOpen(false)}
+          onImported={reload}
+        />
+      )}
+    </div>
+  );
+}
