+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Persisted configuration must survive the credential-free governance reference.
+
+Uses a real SQLite source registry and real DuckDB/DDL paths. Remote transport
+dispatch tests use a capture connector; they do not qualify remote release gates.
+Real saved SFTP coverage is in acceptance batch12.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors import base
+from jiuwenswarm.channels.web.dataagent.datasource import registry, store
+from jiuwenswarm.common import db_connector as dbc, workspace_context as wc
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+@pytest.fixture
+def registry_db(tmp_path, monkeypatch):
+    ref = f"sqlite://{tmp_path / 'metadata.db'}"
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", ref)
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(ROOT / "deploy" / "schema"))
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    monkeypatch.setattr(dbc, "_read_config_section", lambda _: {})
+    yield ref
+    dbc._invalidate(ref, read_only=True)
+    dbc._invalidate(ref, read_only=False)
+
+
+def save(kind, config, source_id="saved"):
+    ref = registry.get_source_type(kind).build_ref(config)
+    store.insert_source(source_id, kind, source_id, config, ref)
+    return ref
+
+
+def test_ddl_saved_reference_governs_real_structure_and_rejects_query(registry_db):
+    ref = save(
+        "ddl",
+        {
+            "ddl_text": "CREATE TABLE orders (id BIGINT PRIMARY KEY, region VARCHAR(30), amount DECIMAL(12,2));",
+            "dialect": "postgres",
+        },
+    )
+    assert dbc.tables(ref)["tables"] == ["orders"]
+    columns = {c["name"]: c for c in dbc.schema(ref, "orders")["columns"]}
+    assert columns["id"]["pk"] is True
+    assert columns["id"]["null"] is False
+    assert columns["amount"]["type"] == "DECIMAL(12, 2)"
+    with pytest.raises(ValueError, match="metadata-only"):
+        dbc.query(ref, "SELECT * FROM orders")
+    store.delete_source_row("saved")
+    with pytest.raises(ValueError, match="configuration not found"):
+        dbc.tables(ref)
+
+
+def test_real_csv_reference_queries_and_keeps_sandbox(registry_db, tmp_path):
+    path = tmp_path / "orders.csv"
+    path.write_text("id,amount\n1,12\n2,31\n3,19\n", encoding="utf-8")
+    ref = save("csv", {"path": str(path), "sandbox": False})
+    assert dbc.tables(ref)["tables"] == ["orders"]
+    assert dbc.query(ref, "SELECT SUM(amount) AS total FROM orders")["rows"] == [[62]]
+    assert dbc.query_dict(ref, "SELECT id FROM orders ORDER BY id", limit=2) == [{"id": 1}, {"id": 2}]
+    result = dbc.query(ref, "SELECT * FROM orders", limit=2)
+    assert result["truncated"] is True
+    connector = dbc._duckdb_connector(dbc._saved_source_spec(ref))
+    assert connector.source.config["sandbox"] is True
+    connector.close()
+
+
+REMOTE_CONFIGS = [
+    ("mongodb", {"host": "h", "port": 27017, "database": "db", "user": "saved-user", "password": "secret-token",
+                 "sample_size": 71, "materialize_limit": 82}),
+    ("redis", {"host": "h", "port": 6379, "db": 2, "password": "secret-token", "datasets": "orders:hash:orders:*",
+               "sample_size": 71}),
+    ("hbase", {"host": "h", "port": 9090, "table_prefix": "saved_", "sample_size": 71}),
+    ("s3", {"location": "s3://bucket/orders", "format": "parquet", "table_name": "orders",
+            "endpoint": "https://example.invalid", "secret_key": "secret-token", "access_key": "id",
+            "use_ssl": True, "url_style": "path"}),
+    ("oss", {"location": "oss://bucket/orders", "format": "json", "table_name": "orders",
+             "endpoint": "https://example.invalid", "secret_key": "secret-token", "access_key": "id"}),
+    ("ftp", {"protocol": "sftp", "host": "h", "port": 22, "user": "saved-user", "password": "secret-token",
+             "path": "/no-extension", "format": "parquet", "table_name": "orders", "known_hosts": "trusted-hosts"}),
+    ("hdfs", {"protocol": "webhdfs", "host": "h", "port": 9870, "user": "saved-user", "path": "/no-extension",
+              "format": "json", "table_name": "orders"}),
+]
+
+
+@pytest.mark.parametrize("kind,config", REMOTE_CONFIGS)
+def test_saved_remote_settings_dispatch_and_result_semantics(registry_db, monkeypatch, kind, config):
+    ref = save(kind, config)
+    opened, closed = [], []
+
+    class CaptureConnector:
+        def __init__(self, source):
+            opened.append(source)
+
+        def catalog(self):
+            return {"datasets": [{"name": "orders"}]}
+
+        def schema(self, table):
+            return {"columns": [{"name": "amount", "type": "DOUBLE", "nullable": True}]}
+
+        def query(self, sql, params=None, limit=100):
+            assert params == [7] and limit == 4
+            return {"columns": ["total"], "rows": [[123]], "row_count": 1,
+                    "truncated": False, "elapsed_ms": 2,
+                    "materialize_truncated": ["orders"], "materialize_limit": 82}
+
+        def close(self):
+            closed.append(True)
+
+    monkeypatch.setattr(base, "get_engine", lambda engine: CaptureConnector)
+    assert dbc.tables(ref)["tables"] == ["orders"]
+    assert dbc.schema(ref, "orders")["columns"][0]["name"] == "amount"
+    result = dbc.query(ref, "SELECT amount FROM orders WHERE id = ?", params=[7], limit=4)
+    assert result["rows"] == [[123]]
+    assert result["materialize_truncated"] == ["orders"]
+    for source in opened:
+        for key, value in config.items():
+            assert source.config[key] == value, (kind, key)
+    assert "secret-token" not in json.dumps(result)
+    assert len(opened) == len(closed) == 3
+
+
+def test_updated_config_is_visible_and_conflicting_same_refs_fail(registry_db):
+    config = dict(REMOTE_CONFIGS[1][1])
+    ref = save("redis", config)
+    assert store.find_config_by_ref(ref, "redis") == config
+    config["password"] = "rotated"
+    store.update_source_row("saved", "redis", "saved", config, ref)
+    assert dbc._saved_source_spec(ref)["_source_config"]["password"] == "rotated"
+    save("redis", config, "identical")
+    assert store.find_config_by_ref(ref, "redis") == config
+    save("redis", {**config, "password": "conflicting"}, "different")
+    with pytest.raises(ValueError, match="ambiguous"):
+        dbc.tables(ref)
+
+
+def test_no_metadata_connection_during_decode_or_standalone_lookup(monkeypatch):
+    monkeypatch.delenv("JIUWENSWARM_DATASOURCE_DB", raising=False)
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
+    token = wc.set_current(None)
+
+    def no_workspace():
+        raise wc.WorkspaceNotConfigured("no business database configured")
+    monkeypatch.setattr(wc, "_workspace_records", no_workspace)
+    monkeypatch.setattr(store, "_connect", lambda ref: pytest.fail("unexpected metadata I/O"))
+    try:
+        for kind, config in REMOTE_CONFIGS:
+            ref = registry.get_source_type(kind).build_ref(config)
+            assert dbc.parse_db_ref(ref)["type"]
+            assert store.find_config_by_ref(ref, kind) is None
+    finally:
+        wc.reset(token)
+
+
+def test_selected_workspace_is_isolated(tmp_path, registry_db, monkeypatch):
+    config = dict(REMOTE_CONFIGS[1][1])
+    ref = save("redis", config)
+    other_ref = f"sqlite://{tmp_path / 'other.db'}"
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", other_ref)
+    save("redis", {**config, "password": "other-workspace"})
+    monkeypatch.delenv("JIUWENSWARM_DATASOURCE_DB")
+    monkeypatch.setattr(wc, "_workspace_records", lambda: [
+        wc.WorkspaceContext("a", "A", ref, registry_db),
+        wc.WorkspaceContext("b", "B", ref, other_ref),
+    ])
+    try:
+        for wid, expected in (("a", "secret-token"), ("b", "other-workspace"), ("a", "secret-token")):
+            token = wc.set_current(wid)
+            try:
+                assert dbc._saved_source_spec(ref)["_source_config"]["password"] == expected
+            finally:
+                wc.reset(token)
+    finally:
+        dbc._invalidate(other_ref, read_only=True)
+        dbc._invalidate(other_ref, read_only=False)
+
+
+def test_missing_registry_is_read_only_and_metadata_failures_propagate(registry_db, monkeypatch):
+    assert store.find_config_by_ref("redis://h:6379/2", "redis") is None
+    import sqlite3
+    path = registry_db.removeprefix("sqlite://")
+    with sqlite3.connect(path) as connection:
+        assert connection.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall() == []
+
+    def fail(ref):
+        raise ConnectionError("metadata unavailable")
+    monkeypatch.setattr(store, "_connect", fail)
+    with pytest.raises(ConnectionError, match="metadata unavailable"):
+        store.find_config_by_ref("redis://h:6379/2", "redis")
+
+
+def test_public_db_metadata_excludes_credentials():
+    meta = dbc._meta_for({"type": "sqlserver", "host": "h", "user": "u", "password": "secret-token"}, True)
+    assert "password" not in meta and "secret-token" not in str(meta)
+
+
+def test_broken_registry_schema_does_not_fall_back_to_global_credentials(registry_db, monkeypatch):
+    def fail(*args):
+        raise RuntimeError('column "config" does not exist')
+    monkeypatch.setattr(store, "_fetch_dicts", fail)
+    with pytest.raises(RuntimeError, match="column"):
+        store.find_config_by_ref("redis://h:6379/2", "redis")
