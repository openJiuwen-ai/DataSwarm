+def _env_port(*names: str) -> int:
+    """按序取第一个合法的端口 env（缺失/非数字跳过）。"""
+    for name in names:
+        try:
+            port = int(os.environ.get(name, "") or 0)
+        except (TypeError, ValueError):
+            continue
+        if 1 <= port <= 65535:
+            return port
+    return 0
+
+
+def _base_reachable(base: str) -> bool:
+    """轻量探测 Web API 是否在该 base 上（HTTPError 也算“服务在”，只是路径非 2xx）。"""
+    try:
+        req = urllib.request.Request(base + "/api/dataagent/workspaces", method="GET")
+        with urllib.request.urlopen(req, timeout=1.5):
+            return True
+    except urllib.error.HTTPError:
+        return True
+    except Exception:  # noqa: BLE001 —— 连接拒绝/超时即视为不在该 base
+        return False
+
+
+def _resolve_default_base() -> str:
+    explicit = (os.environ.get("DWAGENT_BASE") or "").strip().rstrip("/")
+    if explicit:
+        return explicit
+    port = _env_port("WEB_API_PORT", "JIUWENSWARM_WEB_API_PORT", "API_PORT", "FRONTEND_PORT")
+    if port:
+        return f"http://127.0.0.1:{port}"
+    for base in _DEFAULT_FALLBACK_BASES:
+        if _base_reachable(base):
+            return base
+    return _DEFAULT_FALLBACK_BASES[0]
+
