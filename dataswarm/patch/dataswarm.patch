+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import type { ScheduleType } from '../types/orchestration';
+import { Field, inputClass } from './shared/Ui';
+
+export function WorkflowScheduleFields({
+  scheduleType,
+  cron,
+  onceAt,
+  onScheduleTypeChange,
+  onCronChange,
+  onOnceAtChange,
+  autoFocus = false,
+}: {
+  scheduleType: ScheduleType;
+  cron: string;
+  onceAt: string;
+  onScheduleTypeChange: (value: ScheduleType) => void;
+  onCronChange: (value: string) => void;
+  onOnceAtChange: (value: string) => void;
+  autoFocus?: boolean;
+}) {
+  const { t } = useTranslation();
+  return (
+    <>
+      <Field label={t('dataAsset.wfForm.scheduleType')}>
+        <select
+          className={inputClass}
+          value={scheduleType}
+          onChange={(event) => onScheduleTypeChange(event.target.value as ScheduleType)}
+          autoFocus={autoFocus}
+        >
+          <option value="none">{t('dataAsset.wfForm.scheduleNone')}</option>
+          <option value="once">{t('dataAsset.wfForm.scheduleOnce')}</option>
+          <option value="cron">{t('dataAsset.wfForm.scheduleCron')}</option>
+        </select>
+      </Field>
+      {scheduleType === 'cron' && (
+        <Field label={t('dataAsset.wfForm.cron')} hint={t('dataAsset.wfForm.cronHint')}>
+          <input
+            className={`${inputClass} font-mono`}
+            value={cron}
+            onChange={(event) => onCronChange(event.target.value)}
+            placeholder="0 2 * * *"
+          />
+        </Field>
+      )}
+      {scheduleType === 'once' && (
+        <Field label={t('dataAsset.wfForm.onceAt')} hint={t('dataAsset.wfForm.timezoneHint')}>
+          <input
+            className={inputClass}
+            value={onceAt}
+            onChange={(event) => onOnceAtChange(event.target.value)}
+            placeholder="2026-09-12 02:00"
+          />
+        </Field>
+      )}
+    </>
+  );
+}
