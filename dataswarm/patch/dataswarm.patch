+
+    内置 codec 定义在 db_connector 里、靠 import 副作用注册。若不补这次 import，
+    只导入 ref_codec 的调用方会看到空注册表，报的是「不支持的 scheme」——
+    那是假报错，排查方向完全错（会去找「为什么 sqlite 没注册」）。
+    用子进程验证，避免本进程已 import 过 db_connector 而让断言失去意义。
+    """
+    import subprocess
+    import sys
+    import textwrap
+
+    script = textwrap.dedent(
+        """
+        import sys
+        from jiuwenswarm.common import ref_codec as rc
+        assert "jiuwenswarm.common.db_connector" not in sys.modules, "前置条件不成立"
+        schemes = rc.registered_schemes()
+        assert {"sqlite", "mysql", "doris", "duckdb", "postgresql"} <= set(schemes), schemes
+        assert rc.codec_for("sqlite").uses_pool is True
+        print("OK")
+        """
+    )
+    proc = subprocess.run(
+        [sys.executable, "-c", script],
+        capture_output=True, text=True, timeout=120,
+    )
+    assert proc.returncode == 0, f"stdout={proc.stdout}\nstderr={proc.stderr}"
+    assert "OK" in proc.stdout
