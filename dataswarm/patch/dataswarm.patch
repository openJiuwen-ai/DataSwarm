+
+    def _def_for(ws, key):
+        if key == "commerce.paid_order_count":
+            return SimpleNamespace(metric_key=key, status="active",
+                                   current_revision_id="rev-paid")
+        return real_get_def(ws, key)
+
+    class _PaidRevision:
+        revision_id = "rev-paid"
+        status = "published"
+        definition_ref = "commerce.paid_order_count"
+        fixed_filters = []
+        time_dimension = "orders.paid_at"
+        expression = SimpleNamespace(operator="COUNT", parsed=SimpleNamespace(operator="COUNT"),
+                                     unparsed_reason="")
+
+    original_revision = store.get_revision
+
+    def _revision_for(rid):
+        if rid == "rev-paid":
+            return _PaidRevision()
+        return original_revision(rid)
+
+    monkeypatch.setattr(store, "list_bindings", _bindings_for)
+    monkeypatch.setattr(store, "get_def_by_key", _def_for)
+    monkeypatch.setattr(store, "get_revision", _revision_for)
+
+    sql = ("SELECT orders.region, SUM(orders.amount_cny) AS gmv_cny, "
+           "COUNT(DISTINCT orders.order_id) AS paid_cnt, "
