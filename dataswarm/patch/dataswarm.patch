+          <InteractionSlot onSubmit={onUserAnswer} kinds={['authorization']} />
+          {isActive && onSetGoal && onPauseGoal && onResumeGoal && onClearGoal && (
+            <GoalBar
+              onSetGoal={onSetGoal}
+              onPauseGoal={onPauseGoal}
+              onResumeGoal={onResumeGoal}
+              onClearGoal={onClearGoal}
+            />
+          )}
+          <InputArea
+            key={autoFocusKey ?? activeSessionId}
+            isActive={isActive}
+            ref={inputAreaRef}
+            onSubmit={handleSendMessage}
+            onInputIntent={onInputIntent}
+            onPersistMedia={onPersistMedia}
+            onPersistDocuments={onPersistDocuments}
+            onInterrupt={onInterrupt}
+            onCancel={onCancel}
+            onSwitchMode={onSwitchMode}
+            isProcessing={isProcessing}
+            autoFocusKey={autoFocusKey}
+            onNavigateToSkills={onNavigateToSkills}
+            onNavigateToAgents={onNavigateToAgents}
+            permissionsEnabled={permissionsEnabled}
+            onSavePermission={onSavePermission}
+            onSetGoal={onSetGoal}
+            onClearGoal={onClearGoal}
+            onDrainTaskQueueIfIdle={onDrainTaskQueueIfIdle}
+          />
+        </div>
+      )}
+      <div className="chat-ai-disclaimer" data-testid="chat-panel-ai-disclaimer">
+        {t('share.aiNotice')}
+      </div>
+    </div>
+  );
+});
