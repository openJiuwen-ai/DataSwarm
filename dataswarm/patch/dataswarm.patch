+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { governanceRoutePath, parseGovernanceRoute, parseWorkflowRunRoute, workflowRunPath } from '../node_modules/.cache/governance-route/route.mjs';
+
+test('独立运行图链接精确定位实例并正确编码特殊字符', () => {
+  for (const instanceId of ['20260908_091302_408abd49', '运行 / 01?#%']) {
+    const path = workflowRunPath(instanceId);
+    assert.deepEqual(parseWorkflowRunRoute(path), { instanceId });
+    assert.deepEqual(parseWorkflowRunRoute(`${path}/?source=list`), { instanceId });
+    assert.equal(parseGovernanceRoute(path), null);
+  }
+});
+
+test('运行图路由拒绝缺失 ID、额外路径与损坏的 URL 编码', () => {
+  for (const path of [
+    '/workflow-runs',
+    '/workflow-runs/',
+    '/workflow-runs/a/extra',
+    '/workflow-runs/%E0%A4%A',
+    '/governance/overview',
+    '/data-management/tables',
+  ]) {
+    assert.equal(parseWorkflowRunRoute(path), null);
+  }
+});
+
+test('治理新路由只输出治理看板与异常清单', () => {
+  assert.deepEqual(parseGovernanceRoute('/governance/overview'), {
+    kind: 'governance',
+    page: 'overview',
+    runId: undefined,
+  });
+  assert.deepEqual(parseGovernanceRoute('/governance/anomalies?run_id=run%2F01'), {
+    kind: 'governance',
+    page: 'anomalies',
+    runId: 'run/01',
+  });
+  assert.equal(governanceRoutePath({ kind: 'governance', page: 'anomalies', runId: 'run/01' }), '/governance/anomalies?run_id=run%2F01');
+});
+
+test('旧模块路由按明确迁移关系进入新页面', () => {
+  for (const page of ['schema', 'quality', 'lineage', 'metric', 'task']) {
+    assert.equal(parseGovernanceRoute(`/governance/${page}`)?.page, 'overview');
+  }
+  assert.equal(parseGovernanceRoute('/governance/fix-plan')?.page, 'anomalies');
+});
+
+test('未知治理子路由仍返回 null', () => {
+  assert.equal(parseGovernanceRoute('/governance/unknown'), null);
+  assert.equal(parseGovernanceRoute('/governance/overview/extra'), null);
+});
