+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan_to_tasks 前缀清理回归单测。
+
+背景：重新设计会生成新 plan_id（wf_id=bld_wf_<plan_id> 随之变化），
+seed/clean 若只删当前 plan 的工作流，旧 plan 工作流会残留且节点指向
+已被删的 bld_* 任务（悬空引用）。清理必须按前缀跨 plan_id 全局生效。
+
+跑法：python -m pytest tests/unit_tests/dw_warehouse_build/test_plan_to_tasks_cleanup.py -v
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+_SCRIPT = (_REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+           / "skills" / "dw-warehouse-build" / "scripts" / "plan_to_tasks.py")
+
+
+def _load_plan_to_tasks():
+    """按路径加载 plan_to_tasks 模块（skill 脚本，非包内模块）。"""
+    spec = importlib.util.spec_from_file_location("_plan_to_tasks_test", _SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault("_plan_to_tasks_test", mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture()
+def orch_env(monkeypatch, tmp_path):
+    """内存 dwcli 替身；任务/工作流测试不得再依赖脚本直连元数据库。"""
+    biz_db = tmp_path / "biz.db"
+    biz_db.write_text("", encoding="utf-8")
+    # 先 setenv 登记还原点：变量原本不存在时 delenv 不登记，main() 写入的值会泄漏给同进程后续用例
+    monkeypatch.setenv("JIUWENSWARM_WORKSPACE_ID", "")
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID")
+
+    plans_dir = tmp_path / "plans"
+    plans_dir.mkdir()
+    csv_dir = tmp_path / "csv"
+    csv_dir.mkdir()
+    monkeypatch.setattr("jiuwenswarm.common.utils.get_user_workspace_dir",
+                        lambda: tmp_path)
+
+    ptt = _load_plan_to_tasks()
+    monkeypatch.setattr(ptt, "_biz_ref_for", lambda ws="": f"sqlite://{biz_db}")
+    monkeypatch.setattr(ptt, "_ensure_biz_db", lambda _db: None)
+    monkeypatch.setattr(ptt, "WORKSPACE_ID", [""])
+
+    state = {"tasks": {}, "workflows": {}, "calls": []}
+
+    def flags(args):
+        return {args[i][2:].replace("-", "_"): args[i + 1]
+                for i in range(0, len(args), 2) if args[i].startswith("--")}
+
+    def fake_dwcli(*args, stdin_json=None, timeout=1800):
+        del timeout
+        group, action, *rest = args
+        state["calls"].append((args, stdin_json))
+        opts = flags(rest)
+        if group == "task" and action == "list":
+            return {"tasks": list(state["tasks"].values())}
+        if group == "task" and action == "create":
+            row = {"task_id": opts["task_id"], "name": opts.get("name", ""), "status": "draft"}
+            state["tasks"][row["task_id"]] = row
+            return row
+        if group == "task" and action == "delete":
+            return {"ok": state["tasks"].pop(opts["id"], None) is not None}
+        if group == "workflow" and action == "list":
+            return {"workflows": list(state["workflows"].values())}
+        if group == "workflow" and action == "create":
+            row = {"workflow_id": opts["workflow_id"], "name": opts.get("name", ""),
+                   "status": "draft", "nodes": []}
+            state["workflows"][row["workflow_id"]] = row
+            return row
+        if group == "workflow" and action == "delete":
+            return {"ok": state["workflows"].pop(opts["id"], None) is not None}
+        if group == "workflow" and action == "nodes":
+            state["workflows"][opts["id"]]["nodes"] = stdin_json["nodes"]
+            return {"nodes": stdin_json["nodes"]}
+        if group == "lineage" and action in ("table-delete", "column-delete"):
+            return {"ok": True, "count": 0}
+        if group == "plan" and action == "tables-save":
+            return {"inserted": len(stdin_json["tables"]), "updated": 0}
+        raise AssertionError(f"unexpected dwcli call: {args}")
+
+    monkeypatch.setattr(ptt, "_dwcli", fake_dwcli)
+    ptt._test_state = state
+    return ptt
+
+
+def _write_plan(tmp_path: Path, plan_id: str) -> None:
+    """落最小 plan 文件：单张 DWD 表（无 etl_sql，避免触发血缘写库）。"""
+    plan = {
+        "plan_id": plan_id,
+        "name": f"测试方案{plan_id}",
+        "biz_database": "btest",
+        "purpose": "单测",
+        "source_config": json.dumps({"csv_dir": str(tmp_path / "csv"), "files": []}),
+        "tables": [
+            {
+                "table_name": "btest.dwd_t1",
+                "layer": "DWD",
+                "ddl_sql": "CREATE TABLE IF NOT EXISTS `dwd_t1` (\n  `id` BIGINT\n)",
+                "etl_sql": "",
+                "source_tables": [],
+            }
+        ],
+    }
+    (tmp_path / "plans" / f"{plan_id}.json").write_text(
+        json.dumps(plan, ensure_ascii=False), encoding="utf-8")
+
+
+def _wf_ids(ptt) -> set[str]:
+    return set(ptt._test_state["workflows"])
+
+
+def _task_ids(ptt) -> set[str]:
+    return set(ptt._test_state["tasks"])
+
+
+def test_seed_with_new_plan_id_removes_old_workflow(orch_env, tmp_path):
