+    assert result["rebound_workspaces"] == [workspace_id]
+
+    token = workspace_context.set_current(workspace_id)
+    try:
+        refs = {b.binding_id: b.datasource_ref for b in (
+            metric_store.list_bindings("rev_hit") + metric_store.list_bindings("rev_other"))}
+    finally:
+        workspace_context.reset(token)
+    assert refs["bnd_cascade_hit"] == new_ref
+    assert refs["bnd_cascade_other"] == other_ref
+
