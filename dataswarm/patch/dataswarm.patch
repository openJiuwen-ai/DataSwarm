+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { Bell, ChartPie, ShieldAlert, Siren } from 'lucide-react';
+import CollapseChatPanelIcon from '../../../assets/governance/collapse-chat-panel.svg?react';
+import QuoteMessageIcon from '../../../assets/governance/quote-message.svg?react';
+import TaskKpiIcon from '../../../assets/governance/task-kpi.svg?react';
+import { useTranslation } from 'react-i18next';
+import { MessageList } from '../../../components/ChatPanel/MessageList';
+import { classifyPrompt } from '../../../components/InteractionSlot/promptRouting';
+import { useChatStore } from '../../../stores';
+import { submitAskUserAnswer } from '../../../services/askUserAnswer';
+import type { UserAnswer } from '../../../types';
+import type { AskUserQuestionPayload } from '../../../types/websocket';
+import governanceAssistantAvatar from '../../../assets/governance-assistant-avatar.png';
+import { buildInspectionContext, sendGovernanceMessage } from '../chat/governanceChat';
+import { collectFindingRows } from '../findings/findingModel';
+import { formatInspectionDateTime } from '../formatInspectionDateTime';
+import { useGovernanceStore } from '../store/governanceStore';
+import { GovernanceComposer } from './GovernanceComposer';
+
+function GovQuestionCard({ sessionId, pending }: { sessionId: string; pending: AskUserQuestionPayload }) {
+  const { t } = useTranslation();
+  const [selections, setSelections] = useState<Map<number, string>>(new Map());
+  const [customInputs, setCustomInputs] = useState<Map<number, string>>(new Map());
+  const [submitted, setSubmitted] = useState(false);
+  const [error, setError] = useState('');
+
+  const requestId = pending.request_id;
+  useEffect(() => {
+    setSelections(new Map());
+    setCustomInputs(new Map());
+    setSubmitted(false);
+    setError('');
+  }, [requestId]);
+
+  const isBatch = pending.questions.length > 1;
+
+  const doSubmit = (finalSelections: Map<number, string>) => {
+    if (submitted) return;
+    const answers: UserAnswer[] = pending.questions.map((question, index) => {
+      const selected = finalSelections.get(index);
+      if (selected === '__other__') {
+        return {
+          question: question.question,
+          selected_options: [],
+          custom_input: (customInputs.get(index) || '').trim(),
+        };
+      }
+      if (selected) return { question: question.question, selected_options: [selected] };
+      const first = question.options[0];
+      return {
+        question: question.question,
+        selected_options: first ? [first.value || first.label] : [],
+      };
+    });
+    setSubmitted(true);
+    submitAskUserAnswer({ sessionId, requestId, answers, source: pending.source }).catch((caught: unknown) => {
+      setSubmitted(false);
+      setError(caught instanceof Error ? caught.message : String(caught));
+    });
+  };
+
+  const allAnswered = pending.questions.every((_, index) => selections.has(index));
+
+  return (
+    <div className="gov-agent-question">
+      <p className="gov-agent-question-title">{pending.questions[0]?.header ?? t('governance.assistant.question.title')}</p>
+      {pending.questions.map((question, questionIndex) => (
+        <div key={questionIndex} className="gov-agent-question-item">
+          <p className="gov-agent-question-text">{question.question}</p>
+          <div className="gov-agent-question-options">
+            {question.options.map(option => {
+              const value = option.value === '__other__' ? '__other__' : option.value || option.label;
+              const selected = selections.get(questionIndex) === value;
+              return (
+                <button
+                  key={option.label}
+                  type="button"
+                  className={`gov-agent-option ${selected ? 'is-selected' : ''}`}
+                  disabled={submitted}
+                  onClick={() => {
+                    const next = new Map(selections).set(questionIndex, value);
+                    setSelections(next);
+                    if (!isBatch) doSubmit(next);
+                  }}
+                >
+                  <span>{option.label}</span>
+                  {option.description && <span className="gov-agent-option-note">{option.description}</span>}
+                </button>
+              );
+            })}
+            {selections.get(questionIndex) === '__other__' && (
+              <textarea
+                className="gov-agent-textarea gov-agent-option-custom"
+                rows={2}
+                autoFocus
+                placeholder={t('governance.assistant.question.customPlaceholder')}
+                value={customInputs.get(questionIndex) || ''}
+                onChange={event => setCustomInputs(previous => new Map(previous).set(questionIndex, event.target.value))}
+              />
+            )}
+          </div>
+        </div>
+      ))}
+      {isBatch && (
+        <button type="button" className="gov-btn gov-btn-primary w-full mt-2" disabled={!allAnswered || submitted} onClick={() => doSubmit(selections)}>
+          {t('governance.assistant.question.submit', {
+            selected: selections.size,
+            total: pending.questions.length,
+          })}
+        </button>
+      )}
+      {error && <p className="gov-agent-warn">{error}</p>}
+    </div>
+  );
+}
+
+export function GovernanceChatPanel() {
+  const { t } = useTranslation();
+  const govSessionId = useGovernanceStore(state => state.govSessionId);
+  const govSessionRunId = useGovernanceStore(state => state.govSessionRunId);
+  const panelOpen = useGovernanceStore(state => state.govPanelOpen);
+  const setPanelOpen = useGovernanceStore(state => state.setGovPanelOpen);
+  const fixPrefill = useGovernanceStore(state => state.fixPrefill);
+  const selectedRunId = useGovernanceStore(state => state.selectedRunId);
+  const summary = useGovernanceStore(state => state.summary);
+  const artifacts = useGovernanceStore(state => state.artifacts);
+  const ctxSentRunIds = useGovernanceStore(state => state.ctxSentRunIds);
+
+  const activeSessionId = govSessionRunId === selectedRunId ? govSessionId : '';
+  const runtime = useChatStore(state => state.runtimes[activeSessionId]);
+  const messages = runtime?.messages;
+  const pendingQuestion = runtime?.pendingQuestion ?? null;
+  const bodyRef = useRef<HTMLDivElement>(null);
+  const launcherRef = useRef<HTMLButtonElement>(null);
+  const closeButtonRef = useRef<HTMLButtonElement>(null);
+  const wasPanelOpenRef = useRef(false);
+
+  const findingRows = useMemo(() => collectFindingRows(artifacts).rows, [artifacts]);
+  const severityCounts = useMemo(
+    () => ({
+      high: findingRows.filter(row => row.finding.severity === 'high').length,
+      medium: findingRows.filter(row => row.finding.severity === 'medium').length,
+      low: findingRows.filter(row => row.finding.severity === 'low').length,
+    }),
+    [findingRows],
+  );
+
+  const ctxPrefix = useMemo(() => {
+    if (!selectedRunId || !summary?.meta?.run_id || ctxSentRunIds.includes(selectedRunId)) return '';
+    return buildInspectionContext(selectedRunId, summary, artifacts);
+  }, [selectedRunId, summary, artifacts, ctxSentRunIds]);
+
+  const handleSend = useCallback(
+    (raw: string) => {
+      if (!activeSessionId) return;
+      void sendGovernanceMessage(activeSessionId, raw, ctxPrefix || undefined)
+        .then(() => {
+          if (ctxPrefix && selectedRunId) useGovernanceStore.getState().markContextSent(selectedRunId);
+        })
+        .catch(() => {
+          /* 发送失败会由治理对话链路写入错误消息。 */
+        });
+    },
+    [activeSessionId, ctxPrefix, selectedRunId],
+  );
+
+  useEffect(() => {
+    if (!panelOpen || !selectedRunId) return;
+    void useGovernanceStore
+      .getState()
+      .assertGovSession(selectedRunId)
+      .catch(() => {});
+  }, [panelOpen, selectedRunId]);
+
+  useEffect(() => {
+    if (fixPrefill === null || !selectedRunId) return;
+    if (!panelOpen) setPanelOpen(true);
+    if (govSessionRunId !== selectedRunId) {
+      void useGovernanceStore
+        .getState()
+        .assertGovSession(selectedRunId)
+        .catch(() => {});
+    }
+  }, [fixPrefill, panelOpen, setPanelOpen, govSessionRunId, selectedRunId]);
+
+  useEffect(() => {
+    if (!panelOpen) return;
+    const body = bodyRef.current;
+    if (body) body.scrollTop = body.scrollHeight;
+  }, [messages?.length, runtime?.isProcessing, panelOpen]);
+
+  useLayoutEffect(() => {
+    const wasPanelOpen = wasPanelOpenRef.current;
+    wasPanelOpenRef.current = panelOpen;
+
+    if (panelOpen && !wasPanelOpen && fixPrefill === null) {
+      closeButtonRef.current?.focus();
+    } else if (!panelOpen && wasPanelOpen) {
+      launcherRef.current?.focus();
+    }
+  }, [fixPrefill, panelOpen]);
+
+  const showQuestionCard = activeSessionId && pendingQuestion && classifyPrompt(pendingQuestion) !== 'none';
+  const openAssistant = () => {
+    if (!selectedRunId) return;
+    setPanelOpen(true);
+    void useGovernanceStore
+      .getState()
+      .assertGovSession(selectedRunId)
+      .catch(() => {});
+  };
+
+  return (
+    <>
+      <button
+        ref={launcherRef}
+        type="button"
+        className={`gov-agent-launcher ${panelOpen ? 'is-open' : ''}`}
+        aria-label={selectedRunId ? t('governance.assistant.open') : t('governance.assistant.noRun')}
+        aria-expanded={panelOpen}
+        aria-controls="governance-assistant"
+        disabled={!selectedRunId}
+        title={selectedRunId ? t('governance.assistant.open') : t('governance.assistant.noRun')}
+        onClick={openAssistant}
+      >
+        <img className="gov-agent-launcher-avatar" src={governanceAssistantAvatar} alt="" aria-hidden="true" />
+        <span>{t('governance.assistant.title')}</span>
+      </button>
+
+      <aside id="governance-assistant" className={`gov-agent-side ${panelOpen ? 'is-open' : ''}`} aria-label={t('governance.assistant.title')}>
+        <header className="gov-agent-header">
+          <span className="gov-agent-header-label">
+            <img className="gov-agent-avatar" src={governanceAssistantAvatar} alt="" aria-hidden="true" />
+            {t('governance.assistant.title')}
+          </span>
+          <button
+            ref={closeButtonRef}
+            type="button"
+            className="gov-agent-close"
+            title={t('governance.assistant.collapse')}
+            aria-label={t('governance.assistant.collapse')}
+            onClick={() => setPanelOpen(false)}
+          >
+            <CollapseChatPanelIcon width={20} height={20} aria-hidden="true" />
+          </button>
+        </header>
+
+        <div ref={bodyRef} className="gov-agent-body">
+          {summary && selectedRunId && (
+            <section className="gov-agent-context" aria-label={t('governance.assistant.summary.label')}>
+              <div className="gov-agent-context-title">
+                <span className="gov-agent-context-icon" aria-hidden="true">
+                  <TaskKpiIcon width={20} height={20} aria-hidden="true" />
+                </span>
+                <div>
+                  <h2>{t('governance.assistant.summary.title')}</h2>
+                  <p>
+                    {t('governance.assistant.summary.run', {
+                      runId: selectedRunId,
+                      time: summary.meta.run_at ? formatInspectionDateTime(summary.meta.run_at) : '—',
+                    })}
+                  </p>
+                </div>
+              </div>
+              <p className="gov-agent-context-section">{t('governance.assistant.summary.eyebrow')}</p>
+              <div className="gov-agent-risk-grid">
+                <span data-severity="total">
+                  <span className="gov-agent-risk-label">
+                    <ChartPie size={16} aria-hidden="true" />
+                    {t('governance.assistant.summary.total')}
+                  </span>
+                  <strong>{findingRows.length}</strong>
+                </span>
+                <span data-severity="low">
+                  <span className="gov-agent-risk-label">
+                    <ShieldAlert size={16} aria-hidden="true" />
+                    {t('governance.assistant.summary.low')}
+                  </span>
+                  <strong>{severityCounts.low}</strong>
+                </span>
+                <span data-severity="medium">
+                  <span className="gov-agent-risk-label">
+                    <Bell size={16} aria-hidden="true" />
+                    {t('governance.assistant.summary.medium')}
+                  </span>
+                  <strong>{severityCounts.medium}</strong>
+                </span>
+                <span data-severity="high">
+                  <span className="gov-agent-risk-label">
+                    <Siren size={16} aria-hidden="true" />
+                    {t('governance.assistant.summary.high')}
+                  </span>
+                  <strong>{severityCounts.high}</strong>
+                </span>
+              </div>
+              <p className="gov-agent-context-note">
+                {severityCounts.high > 0
+                  ? t('governance.assistant.summary.attention', { count: severityCounts.high })
+                  : t('governance.assistant.summary.stable')}
+              </p>
+            </section>
+          )}
+
+          {!activeSessionId && panelOpen && (
+            <div className="gov-agent-empty">
+              <p>{t('governance.assistant.connecting')}</p>
+            </div>
+          )}
+          {activeSessionId && !messages?.length && (
+            <div className="gov-agent-empty">
+              <QuoteMessageIcon width={22} height={22} aria-hidden="true" />
+              <p>{t('governance.assistant.empty')}</p>
+            </div>
+          )}
+          {activeSessionId && messages && <MessageList sessionId={activeSessionId} messages={messages} />}
+          {showQuestionCard && pendingQuestion && <GovQuestionCard sessionId={activeSessionId} pending={pendingQuestion} />}
+        </div>
+
+        <GovernanceComposer runId={selectedRunId} sessionId={activeSessionId} onSend={handleSend} />
+      </aside>
+    </>
+  );
+}
