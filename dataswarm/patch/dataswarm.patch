+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""业务库访问 DAO：保留既有实现，扩展数据源经 codec 能力分发。
+
+与 meta_data/ 区分：
+  - meta_data/ 管元数据（plan / lineage / dashboard 表）
+  - business_data/ 管业务库本身（用户的 ODS/DWD/DWS/ADS 表的清单、schema、预览）
+
+仿 meta_data/ 的 ABC + @register + get_dao 工厂模式。
+"""
+from .base import BusinessDataDao, get_dao, register
+
+# 触发 @register
+from .sqlite_impl import SqliteBusinessDao  # noqa: F401
+from .doris_impl import DorisBusinessDao    # noqa: F401
+from .duckdb_impl import DuckdbBusinessDao  # noqa: F401
+from .codec_impl import CodecBusinessDao    # noqa: F401
