@@ -0,0 +1,675 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""远端文件下载、缓存和 DuckDB 查询适配。
+
+FTP/SFTP/WebHDFS 列目录后，按 glob 将文件下载到受控缓存，再交给
+DuckDBConnector 查询；SQL 方言、只读护栏和结果上限由 DuckDB 路径负责。
+
+缓存按源、有效配置、工作空间和远端路径的哈希隔离。远端 size/mtime 用于
+增量校验；超期或超配额缓存按清理策略回收。远端路径不直接用作本地写入路径。
+
+SFTP 使用 Paramiko 并校验服务器密钥；FTP 使用 ftplib，凭据和数据明文传输。
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import hashlib
+import json
+import os
+import stat
+import time
+from pathlib import Path
+from typing import Any
+
+from .base import Connector, SourceDefinition, register_engine
+from .errors import ConnectorDependencyError, ConnectorError
+from .paths import (
+    resolve_staged_path,
+    staged_cache_quota_bytes,
+    staged_cache_root,
+    staged_cache_ttl_seconds,
+)
+
+#: 单次拉取的文件数上限——远端目录可能很大，避免一次把磁盘打满。
+_MAX_FILES = 200
+#: DuckDB 能直读的格式（与 duckdb_connector._view_sql 的三个分支一致）。
+_SUPPORTED_FORMATS = ("csv", "parquet", "json")
+
+
+# ======================================================================
+# 远端取文件
+# ======================================================================
+class RemoteFetcher:
+    """远端文件访问的最小接口：列目录 + 取单个文件。"""
+
+    def list_files(self, pattern: str) -> list[tuple[str, int, float]]:
+        """返回 [(远端路径, 大小, mtime)]，按远端路径排序。"""
+        raise NotImplementedError
+
+    def download(self, remote_path: str, target: Path) -> None:
+        raise NotImplementedError
+
+    def close(self) -> None:
+        return None
+
+
+class _FtpFetcher(RemoteFetcher):
+    """FTP —— 标准库 ftplib，无第三方依赖。
+
+    注意：FTP 是**明文协议**，凭据与数据都不加密。生产应优先 SFTP。
+    """
+
+    def __init__(self, config: dict):
+        from ftplib import FTP
+
+        self._ftp = FTP()
+        self._ftp.connect(
+            host=str(config.get("host") or ""),
+            port=int(config.get("port") or 21),
+            timeout=30,
+        )
+        self._ftp.login(
+            user=str(config.get("user") or "anonymous"),
+            passwd=str(config.get("password") or ""),
+        )
+        # 二进制模式；文本模式会在 Windows/Unix 之间改写换行，破坏 parquet。
+        self._ftp.set_pasv(True)
+
+    def list_files(self, pattern: str) -> list[tuple[str, int, float]]:
+        directory = os.path.dirname(pattern) or "."
+        name_glob = os.path.basename(pattern) or "*"
+        out: list[tuple[str, int, float]] = []
+        # MLSD 带 size/modify，比 NLST+SIZE 少一轮往返；老服务端不支持时回退。
+        try:
+            for name, facts in self._ftp.mlsd(directory):
+                if facts.get("type") not in (None, "file"):
+                    continue
+                if not fnmatch.fnmatch(name, name_glob):
+                    continue
+                size = int(facts.get("size") or 0)
+                out.append((f"{directory}/{name}".replace("//", "/"), size,
+                            _parse_mlsd_time(facts.get("modify"))))
+        except Exception:  # noqa: BLE001 —— 服务端不支持 MLSD，回退 NLST
+            for path in self._ftp.nlst(directory):
+                name = os.path.basename(path)
+                if not fnmatch.fnmatch(name, name_glob):
+                    continue
+                try:
+                    size = int(self._ftp.size(path) or 0)
+                except Exception:  # noqa: BLE001
+                    size = 0
+                out.append((path, size, 0.0))
+        return sorted(out, key=lambda item: item[0])
+
+    def download(self, remote_path: str, target: Path) -> None:
+        with target.open("wb") as handle:
+            self._ftp.retrbinary(f"RETR {remote_path}", handle.write)
+
+    def close(self) -> None:
+        try:
+            self._ftp.quit()
+        except Exception:  # noqa: BLE001 —— 连接已断时 quit 会抛，忽略
+            try:
+                self._ftp.close()
+            except Exception:  # noqa: BLE001
+                pass
+
+
+class _SftpFetcher(RemoteFetcher):
+    """SFTP with host identity verification before password authentication.
+
+    Use an explicit OpenSSH ``known_hosts`` file or a trusted
+    ``host_key_sha256`` pin, never both. With neither configured, Paramiko reads
+    the current user's standard known_hosts file. Unknown hosts are rejected;
+    no key is learned or persisted from the unverified network connection.
+    """
+
+    _TIMEOUT_SECONDS = 30
+
+    def __init__(self, config: dict):
+        try:
+            import paramiko
+        except ImportError as exc:
+            raise ConnectorDependencyError(
+                "paramiko 未安装，请 pip install 'jiuwenswarm[ds-ftp]'"
+            ) from exc
+        import hmac
+
+        known_hosts = str(config.get("known_hosts") or "").strip()
+        fingerprint = str(config.get("host_key_sha256") or "").strip()
+        if known_hosts and fingerprint:
+            raise ConnectorError("SFTP known_hosts 与 host_key_sha256 只能配置一种")
+        pin = self._fingerprint_bytes(fingerprint) if fingerprint else None
+
+        class VerifyIdentity(paramiko.MissingHostKeyPolicy):
+            def missing_host_key(self, client, hostname, key):
+                if pin is not None:
+                    actual = hashlib.sha256(key.asbytes()).digest()
+                    if hmac.compare_digest(actual, pin):
+                        return
+                    raise ConnectorError(
+                        "SFTP 服务器主机密钥与 host_key_sha256 不匹配；"
+                        "请通过可信渠道向服务器管理员核验密钥，确认后再更新指纹"
+                    )
+                raise ConnectorError(
+                    f"SFTP 服务器 {hostname} 的主机密钥不在 known_hosts 中；"
+                    "请通过可信渠道核验服务器公钥后配置 known_hosts 或 host_key_sha256；"
+                    "不会自动接受未知主机"
+                )
+
+        self._sftp = None
+        self._client = paramiko.SSHClient()
+        try:
+            # In pin mode the verified fingerprint is the trust anchor. With a
+            # file, use Paramiko's normal matching (including hashed hostnames,
+            # [host]:port names, and host-key algorithm negotiation).
+            if pin is None:
+                try:
+                    if known_hosts:
+                        self._client.load_system_host_keys(str(Path(known_hosts).expanduser()))
+                    else:
+                        self._client.load_system_host_keys()
+                except Exception as exc:
+                    raise ConnectorError(
+                        "无法读取或解析 SFTP known_hosts；请指定可读的 OpenSSH "
+                        "known_hosts 文件，并通过可信渠道核验其中的服务器公钥"
+                    ) from exc
+            self._client.set_missing_host_key_policy(VerifyIdentity())
+            try:
+                self._client.connect(
+                    hostname=str(config.get("host") or ""),
+                    port=int(config.get("port") or 22),
+                    username=str(config.get("user") or ""),
+                    password=str(config.get("password") or ""),
+                    allow_agent=False,
+                    look_for_keys=False,
+                    timeout=self._TIMEOUT_SECONDS,
+                    banner_timeout=self._TIMEOUT_SECONDS,
+                    auth_timeout=self._TIMEOUT_SECONDS,
+                    channel_timeout=self._TIMEOUT_SECONDS,
+                )
+            except paramiko.BadHostKeyException as exc:
+                raise ConnectorError(
+                    "SFTP 服务器主机密钥与 known_hosts 不匹配；请通过可信渠道向"
+                    "服务器管理员核验密钥，确认后再更新 known_hosts"
+                ) from exc
+            self._sftp = self._client.open_sftp()
+            self._sftp.get_channel().settimeout(self._TIMEOUT_SECONDS)
+        except BaseException:
+            # Failed authentication/negotiation can leave an active transport;
+            # the constructor's caller cannot close an object it never received.
+            self.close()
+            raise
+
+    @staticmethod
+    def _fingerprint_bytes(value: str) -> bytes:
+        import base64
+
+        error = "SFTP host_key_sha256 必须是 SHA256:<base64> 格式的服务器公钥指纹"
+        if not value.startswith("SHA256:"):
+            raise ConnectorError(error)
+        encoded = value.removeprefix("SHA256:")
+        try:
+            decoded = base64.b64decode(encoded + "=" * (-len(encoded) % 4), validate=True)
+        except ValueError as exc:
+            raise ConnectorError(error) from exc
+        if len(decoded) != 32:
+            raise ConnectorError(error)
+        return decoded
+
+    def list_files(self, pattern: str) -> list[tuple[str, int, float]]:
+        directory = os.path.dirname(pattern) or "."
+        name_glob = os.path.basename(pattern) or "*"
+        out: list[tuple[str, int, float]] = []
+        for attr in self._sftp.listdir_attr(directory):
+            if attr.st_mode is not None and not stat.S_ISREG(attr.st_mode):
+                continue
+            if not fnmatch.fnmatch(attr.filename, name_glob):
+                continue
+            out.append((
+                f"{directory}/{attr.filename}".replace("//", "/"),
+                int(attr.st_size or 0),
+                float(attr.st_mtime or 0.0),
+            ))
+        return sorted(out, key=lambda item: item[0])
+
+    def download(self, remote_path: str, target: Path) -> None:
+        self._sftp.get(remote_path, str(target))
+
+    def close(self) -> None:
+        for name in ("_sftp", "_client"):
+            closer = getattr(self, name, None)
+            setattr(self, name, None)
+            if closer is None:
+                continue
+            try:
+                closer.close()
+            except Exception:  # noqa: BLE001
+                pass
+
+
+def _parse_mlsd_time(value: str | None) -> float:
+    """MLSD 的 modify facts 形如 20261022T103000 / 20261022103000。"""
+    if not value:
+        return 0.0
+    cleaned = str(value).replace("T", "").split(".")[0]
+    for fmt in ("%Y%m%d%H%M%S", "%Y%m%d%H%M"):
+        try:
+            return time.mktime(time.strptime(cleaned, fmt))
+        except ValueError:
+            continue
+    return 0.0
+
+
+class _WebHdfsFetcher(RemoteFetcher):
+    """通过 WebHDFS 下载文件，再交给本地 DuckDB 查询。
+
+    支持 user.name 简单认证参数；不支持 Kerberos/SPNEGO。重定向目标仍需通过
+    地址边界检查，不能把 NameNode 返回的地址直接视为可信目标。
+    """
+
+    def __init__(self, config: dict):
+        try:
+            import requests
+        except ImportError as exc:
+            raise ConnectorDependencyError(
+                "requests 未安装（WebHDFS 走 HTTP）"
+            ) from exc
+        self._requests = requests
+        host = str(config.get("host") or "")
+        port = int(config.get("port") or 9870)
+        scheme = "https" if config.get("use_https") else "http"
+        self._base = f"{scheme}://{host}:{port}/webhdfs/v1"
+        self._params: dict[str, str] = {}
+        user = str(config.get("user") or "").strip()
+        if user:
+            # 简单认证的代理用户；Kerberos 集群会忽略它并要求 SPNEGO
+            self._params["user.name"] = user
+        self._timeout = 30
+
+        self._session = requests.Session()
+        # **默认不继承进程的代理环境变量**，这是 WebHDFS 必须单独处理的一点：
+        #
+        # OPEN 会被 NameNode 以 307 重定向到 **DataNode 的主机名**，而那个主机名
+        # 是 NameNode 按 DataNode 注册信息在运行期生成的，配置时无从预知。若进程
+        # 设了 HTTP_PROXY（企业部署常见），requests 默认 trust_env=True 就会把这个
+        # 内网地址也发给代理，代理解析不了内网名 → 502 Bad Gateway，而错误信息里
+        # 完全不提代理，极难排查。
+        #
+        # 用户也无法用 NO_PROXY 规避：重定向目标运行期才知道，没法预先列进去。
+        # 更隐蔽的是只测 LISTSTATUS 的连通性检查会通过（NameNode 地址常在 NO_PROXY
+        # 里），真正取数才失败。所以默认直连，确有「经代理访问 WebHDFS」的部署
+        # 再用 use_proxy 显式打开。
+        self._session.trust_env = bool(config.get("use_proxy"))
+
+    def _url(self, path: str) -> str:
+        return f"{self._base}{path if path.startswith('/') else '/' + path}"
+
+    def list_files(self, pattern: str) -> list[tuple[str, int, float]]:
+        directory = os.path.dirname(pattern) or "/"
+        name_glob = os.path.basename(pattern) or "*"
+        response = self._session.get(
+            self._url(directory),
+            params={**self._params, "op": "LISTSTATUS"},
+            timeout=self._timeout,
+        )
+        response.raise_for_status()
+        payload = response.json()
+        entries = payload.get("FileStatuses", {}).get("FileStatus", [])
+        out: list[tuple[str, int, float]] = []
+        for entry in entries:
+            if entry.get("type") != "FILE":
+                continue
+            name = entry.get("pathSuffix") or ""
+            if not fnmatch.fnmatch(name, name_glob):
+                continue
+            out.append((
+                f"{directory}/{name}".replace("//", "/"),
+                int(entry.get("length") or 0),
+                # WebHDFS 的 modificationTime 是毫秒
+                float(entry.get("modificationTime") or 0) / 1000.0,
+            ))
+        return sorted(out, key=lambda item: item[0])
+
+    def download(self, remote_path: str, target: Path) -> None:
+        response = self._session.get(
+            self._url(remote_path),
+            params={**self._params, "op": "OPEN"},
+            timeout=self._timeout,
+            stream=True,          # 大文件不能整个读进内存
+            allow_redirects=True, # NameNode 会 307 重定向到 DataNode
+        )
+        response.raise_for_status()
+        with target.open("wb") as handle:
+            for chunk in response.iter_content(chunk_size=1 << 20):
+                if chunk:
+                    handle.write(chunk)
+
+    def close(self) -> None:
+        try:
+            self._session.close()
+        except Exception:  # noqa: BLE001
+            pass
+
+
+_FETCHERS: dict[str, type[RemoteFetcher]] = {
+    "ftp": _FtpFetcher,
+    "sftp": _SftpFetcher,
+    "webhdfs": _WebHdfsFetcher,
+}
+
+#: 各协议的默认端口（WebHDFS 的 NameNode HTTP 端口 Hadoop 3 起是 9870）。
+DEFAULT_PORTS = {"ftp": 21, "sftp": 22, "webhdfs": 9870}
+
+
+# ======================================================================
+# 暂存缓存
+# ======================================================================
+def _cache_scope() -> dict[str, str | None]:
+    """Resolve explicit context without opening a metadata connection."""
+    from jiuwenswarm.common import workspace_context
+
+    workspace_id = workspace_context.selected_workspace_id()
+    metadata = os.environ.get("JIUWENSWARM_DATASOURCE_DB", "").strip()
+    if workspace_id and not metadata:
+        metadata = workspace_context.metadata_db_ref(workspace_id)
+    elif not metadata:
+        metadata = os.environ.get("JIUWENSWARM_ORCH_DB", "").strip()
+    return {"workspace": workspace_id, "metadata": metadata}
+
+
+def _cache_dir_for(source_id: str, remote: str, config: dict | None = None) -> Path:
+    """Isolate cached bytes by source, identity, trust settings and workspace.
+
+    用哈希而非远端路径本身拼目录——远端路径是用户可填的，直接拼会让
+    ``../..`` 变成本地写入路径。凭据仅参与摘要，不写入路径或清单。相同
+    endpoint/path 下不同账号的 chroot 可能返回同名、同大小、同 mtime 文件。
+    """
+    effective = dict(config or {})
+    trust_digest = None
+    if str(effective.get("protocol") or "sftp").strip().lower() == "sftp":
+        if not effective.get("host_key_sha256"):
+            hosts_path = Path(str(effective.get("known_hosts") or "~/.ssh/known_hosts")).expanduser()
+            try:
+                trust_digest = hashlib.sha256(hosts_path.read_bytes()).hexdigest()
+            except OSError:
+                # The fetcher handles unavailable trust stores before authentication.
+                trust_digest = None
+    identity = {"version": 2, "source": source_id, "remote": remote,
+                "config": effective, "scope": _cache_scope(), "trust": trust_digest}
+    payload = json.dumps(identity, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]
+    target = staged_cache_root() / digest
+    target.mkdir(parents=True, exist_ok=True)
+    return resolve_staged_path(str(target))
+
+
+def _evict_stale(cache_dir: Path, staged: list[Path]) -> list[str]:
+    """删掉缓存里**远端已不存在**的文件，返回被删的文件名。
+
+    为什么必须做：``_delegate()`` 把 DuckDB 指向 ``cache_dir/*.<fmt>``，
+    **glob 整个缓存目录**而不是本次 stage 的清单。所以远端删掉的文件若留在
+    缓存里，仍会被读进来算进聚合——**查询成功、数字是错的**，这是最坏的一类
+    失败。而远端按分区清理旧文件是常态，不是边缘情况。
+
+    与 ``_prune_cache()`` 分工不同：那个按 TTL/配额做全局容量管理，不知道哪些
+    文件还在远端；这个只管当前 (source_id, pattern) 对应的那个目录，依据是
+    本次远端清单。缓存目录按两者的哈希隔离，所以不会误删别的源的文件。
+    """
+    if not cache_dir.is_dir():
+        return []
+    keep = {path.name for path in staged}
+    removed: list[str] = []
+    for item in cache_dir.iterdir():
+        if not item.is_file() or item.name in keep:
+            continue
+        try:
+            item.unlink()
+        except OSError as exc:
+            # DuckDB reads the directory glob: leaving a stale file here would
+            # silently include deleted remote rows in the next result.
+            raise ConnectorError(f"cannot remove stale staged file: {item.name}") from exc
+        removed.append(item.name)
+    return sorted(removed)
+
+
+def _prune_cache(protected: list[Path] | None = None) -> dict:
+    """清理暂存目录：先删超 TTL 的，再按最旧优先压到配额内。"""
+    root = staged_cache_root()
+    ttl = staged_cache_ttl_seconds()
+    quota = staged_cache_quota_bytes()
+    now = time.time()
+    keep = set(protected or ())
+    files: list[tuple[Path, int, float]] = []
+    expired = 0
+    for path in root.rglob("*"):
+        if not path.is_file():
+            continue
+        try:
+            file_stat = path.stat()
+        except OSError:
+            continue
+        # mtime is the remote fingerprint, not cache age. Old partitions can
+        # have a years-old mtime immediately after being fetched.
+        if path not in keep and ttl and (now - file_stat.st_atime) > ttl:
+            try:
+                path.unlink()
+                expired += 1
+                continue
+            except OSError:
+                pass
+        files.append((path, file_stat.st_size, file_stat.st_atime))
+    total = sum(size for _, size, _ in files)
+    evicted = 0
+    if quota and total > quota:
+        for path, size, _ in sorted(files, key=lambda item: item[2]):
+            if total <= quota:
+                break
+            if path in keep:
+                continue
+            try:
+                path.unlink()
+                total -= size
+                evicted += 1
+            except OSError:
+                continue
+        if total > quota:
+            raise ConnectorError("staged cache quota exceeded; complete snapshot cannot be retained")
+    return {"expired": expired, "evicted": evicted, "bytes": total}
+
+
+# ======================================================================
+# 连接器
+# ======================================================================
+@register_engine("staged")
+class StagedFileConnector(Connector):
+    """远端文件源：暂存到本地后由 DuckDBConnector 代理查询。
+
+    能力探测会得到 ``{"sql"}``——``preview`` / ``query`` 以委托形式存在，
+    不是假装支持（委托目标真的能跑 SQL）。
+    """
+
+    engine = "staged"
+
+    def __init__(self, source: SourceDefinition):
+        self.source = source
+        self._inner: Connector | None = None
+        self._staged: list[Path] = []
+
+    # ------------------------------------------------------------------ #
+    # 暂存
+    # ------------------------------------------------------------------ #
+    def _protocol(self) -> str:
+        value = str(self.source.config.get("protocol") or "sftp").strip().lower()
+        if value not in _FETCHERS:
+            raise ConnectorError(
+                f"unsupported transfer protocol: {value}"
+                f"（支持 {'/'.join(sorted(_FETCHERS))}）"
+            )
+        return value
+
+    def _format(self) -> str:
+        value = str(self.source.config.get("format") or "csv").strip().lower()
+        if value not in _SUPPORTED_FORMATS:
+            raise ConnectorError(
+                f"unsupported staged file format: {value}"
+                f"（支持 {'/'.join(_SUPPORTED_FORMATS)}）"
+            )
+        return value
+
+    def _remote_pattern(self) -> str:
+        """远端 glob 的单一出口（stage 与缓存定位都经这里）。
+
+        ``..`` 的拒绝与 adapter.validate() 是同一条规则，但**必须在这里也拦
+        一次**：治理通路（db_connector 从 ref 的 location 反解出 config）不经过
+        adapter.validate()，所以「表单校验过了」不等于运行期拿到的路径是干净的。
+        带 ``..`` 的 ref 可能来自人工配置或历史数据。
+
+        本地写入本来就安全（缓存目录按哈希定位、本地文件名只取 basename），
+        这里拦的是**远端侧的越权读取**：FTP 上 ``..`` 能跳出用户 home，
+        HDFS 上会被规范化到更高层目录。
+        """
+        pattern = str(self.source.config.get("path") or "").strip()
+        if not pattern:
+            raise ConnectorError("path is required for staged file source")
+        if ".." in pattern:
+            raise ConnectorError(
+                f"remote path must not contain '..': {pattern!r}"
+            )
+        return pattern
+
+    def _fetcher(self) -> RemoteFetcher:
+        protocol = self._protocol()
+        config = dict(self.source.config)
+        config.setdefault("port", DEFAULT_PORTS[protocol])
+        return _FETCHERS[protocol](config)
+
+    def stage(self) -> dict:
+        """拉取远端文件到本地缓存，返回拉取报告。
+
+        指纹相同即跳过下载（增量拉取）；下载先落 ``.part`` 再原子改名，
+        中断不会留下半个文件被 DuckDB 读到。
+        """
+        pattern = self._remote_pattern()
+        cache_dir = _cache_dir_for(self.source.source_id, pattern, self.source.config)
+        fetcher = self._fetcher()
+        fetched, skipped, staged = 0, 0, []
+        try:
+            remote_files = fetcher.list_files(pattern)
+            if not remote_files:
+                raise ConnectorError(f"no files matched on remote: {pattern}")
+            if len(remote_files) > _MAX_FILES:
+                raise ConnectorError(
+                    f"remote matched {len(remote_files)} files, exceeds "
+                    f"limit {_MAX_FILES}；请缩小 path 的 glob 范围"
+                )
+            quota = staged_cache_quota_bytes()
+            if quota and sum(max(0, size) for _, size, _ in remote_files) > quota:
+                raise ConnectorError("remote snapshot exceeds staged cache quota")
+            for remote_path, size, mtime in remote_files:
+                local = cache_dir / Path(remote_path).name
+                if _fingerprint_matches(local, size, mtime):
+                    os.utime(local, (time.time(), local.stat().st_mtime))
+                    skipped += 1
+                    staged.append(local)
+                    continue
+                part = local.with_suffix(local.suffix + ".part")
+                fetcher.download(remote_path, part)
+                part.replace(local)
+                if mtime:
+                    os.utime(local, (time.time(), mtime))
+                fetched += 1
+                staged.append(local)
+        finally:
+            fetcher.close()
+        self._staged = staged
+        evicted = _evict_stale(cache_dir, staged)
+        prune = _prune_cache(protected=staged)
+        return {
+            "fetched": fetched,
+            "skipped": skipped,
+            "evicted": evicted,
+            "files": [str(p) for p in staged],
+            "cache_dir": str(cache_dir),
+            "cache": prune,
+        }
+
+    # ------------------------------------------------------------------ #
+    # 代理给 DuckDB
+    # ------------------------------------------------------------------ #
+    def _delegate(self) -> Connector:
+        if self._inner is not None:
+            return self._inner
+        report = self.stage()
+        cache_dir = Path(report["cache_dir"])
+        fmt = self._format()
+        from .duckdb_connector import DuckDBConnector
+
+        inner_source = SourceDefinition(
+            source_id=self.source.source_id,
+            # 以 format 作为 DuckDB 侧的 source_type：read_csv_auto /
+            # read_parquet / read_json_auto 三个 reader 由它选。
+            source_type=fmt,
+            name=self.source.name,
+            engine="duckdb",
+            config={
+                "location": str(cache_dir / f"*.{fmt}"),
+                "format": fmt,
+                "table_name": str(self.source.config.get("table_name") or "") or "data",
+                # 缓存目录是受控根目录下的绝对路径，不再过 DATA_ROOTS 沙箱。
+                "sandbox": False,
+            },
+        )
+        self._inner = DuckDBConnector(inner_source)
+        return self._inner
+
+    def test_connection(self) -> dict:
+        try:
+            report = self.stage()
+            return {
+                "ok": True,
+                "message": (f"{len(report['files'])} file(s) staged "
+                            f"(fetched={report['fetched']}, skipped={report['skipped']})"),
+                "engine": self.engine,
+            }
+        except Exception as exc:  # noqa: BLE001 —— 连接失败是预期结果
+            return {"ok": False, "error": str(exc), "engine": self.engine}
+
+    def catalog(self) -> dict:
+        return self._delegate().catalog()
+
+    def schema(self, dataset: str, schema_name: str | None = None) -> dict:
+        return self._delegate().schema(dataset, schema_name=schema_name)
+
+    def preview(self, dataset: str, limit: int = 100) -> dict:
+        return self._delegate().preview(dataset, limit=limit)
+
+    def query(self, sql: str, params: Any = None, limit: int = 100) -> dict:
+        return self._delegate().query(sql, params=params, limit=limit)
+
+    def close(self) -> None:
+        if self._inner is not None:
+            self._inner.close()
+            self._inner = None
+
+
+def _fingerprint_matches(local: Path, size: int, mtime: float) -> bool:
+    """本地缓存与远端 (size, mtime) 一致则跳过下载。
+
+    远端 mtime 为 0（服务端不报）时只比大小——比不比都下载更糟，但也要诚实：
+    这种情况下内容变了而大小没变是检测不到的。
+    """
+    if not local.is_file():
+        return False
+    try:
+        file_stat = local.stat()
+    except OSError:
+        return False
+    if size and file_stat.st_size != size:
+        return False
+    if mtime and abs(file_stat.st_mtime - mtime) > 2:
+        return False
+    return bool(size) or bool(mtime)
+
+
+__all__ = ["StagedFileConnector", "RemoteFetcher", "DEFAULT_PORTS"]
