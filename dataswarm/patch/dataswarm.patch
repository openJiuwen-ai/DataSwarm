+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""datasource 服务面闸门（第二轮重构台账 A-4 / A-5）。
+
+- A-4：registry 的 ``available=False`` 必须在服务端强制——前端目录置灰不是
+  约束（本产品 API 会被 LLM agent 驱动）；未发布与缺驱动两类均需拒绝。
+  可用性由测试显式构造，不依赖开发机驱动安装情况或类型发布进度。
+- A-5：``infer_csv_schema`` 必须走 ``resolve_local_path`` 沙箱，与同包
+  ``CsvAdapter.validate`` 同一口径（拒绝 URI 与 data roots 外的相对路径）。
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import service
+
+
+def _unreleased_params() -> dict:
+    # 用 planned 类型（released=False）：postgresql 已发布，装齐驱动后不再被闸门拦截
+    return {"source_id": "ora-x", "type": "oracle", "host": "127.0.0.1", "port": 1521,
+            "database": "demo", "user": "u", "password": "p"}
+
+
+@pytest.fixture(params=["not_released", "driver_missing:psycopg"])
+def unavailable_adapter(monkeypatch, request):
+    adapter = SimpleNamespace(type_id="oracle", available=False, unavailable_reason=request.param)
+    monkeypatch.setattr(service._registry, "get_source_type", lambda source_type: adapter)
+    return adapter
+
+
+def test_create_source_rejects_unavailable_type(unavailable_adapter):
+    result = service.create_source(_unreleased_params())
+    assert result["ok"] is False
+    assert result.get("error_code") == "SOURCE_TYPE_UNAVAILABLE"
+    assert result["unavailable_reason"] == unavailable_adapter.unavailable_reason
+
+
+def test_test_connection_rejects_unavailable_type(unavailable_adapter):
+    result = service.test_connection(_unreleased_params())
+    assert result["ok"] is False
+    assert result.get("error_code") == "SOURCE_TYPE_UNAVAILABLE"
+    assert result["unavailable_reason"] == unavailable_adapter.unavailable_reason
+
+
+def test_update_source_rejects_unavailable_type(monkeypatch, unavailable_adapter):
+    existing = {"source_id": "ora-x", "source_type": "oracle", "config": {},
+                "db_ref": "oracle://127.0.0.1:1521/demo", "description": ""}
+    monkeypatch.setattr(service, "_find_local_source", lambda *a, **kw: dict(existing))
+    result = service.update_source({**_unreleased_params(), "workspace_id": ""})
+    assert result["ok"] is False
+    assert result.get("error_code") == "SOURCE_TYPE_UNAVAILABLE"
+    assert result["unavailable_reason"] == unavailable_adapter.unavailable_reason
+
+
+def test_create_source_still_accepts_available_type(monkeypatch, tmp_path):
+    """可用类型不受新闸门影响：csv（沙箱内路径）照常走完创建链。"""
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    (tmp_path / "a.csv").write_text("a,b\n1,2\n", encoding="utf-8")
+    monkeypatch.setattr(service, "_probe_blocked", lambda adapter, config: None)
+    monkeypatch.setattr(service, "_store",
+                        SimpleNamespace(insert_source=lambda *a, **kw: {"db_ref": "duckdb://ref"}))
+    monkeypatch.setattr(service, "_invalidate_creds_cache", lambda: None)
+
+    result = service.create_source({"source_id": "csv-x", "type": "csv", "path": "a.csv"})
+
+    assert result["ok"] is True, result
+    assert result["source_id"] == "csv-x"
+
+
+def test_infer_csv_schema_rejects_path_outside_roots(monkeypatch, tmp_path):
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    result = service.infer_csv_schema("../secret.csv")
+    assert result["ok"] is False
+    assert "allowed data roots" in result["error"]
+
+
+def test_infer_csv_schema_rejects_uri(monkeypatch, tmp_path):
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    result = service.infer_csv_schema("s3://bucket/x.csv")
+    assert result["ok"] is False
+    assert "local" in result["error"]
+
+
+def test_infer_csv_schema_accepts_file_inside_roots(monkeypatch, tmp_path):
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    (tmp_path / "a.csv").write_text("a,b\n1,2\n", encoding="utf-8")
+    result = service.infer_csv_schema("a.csv")
+    assert result["ok"] is True, result
+    assert result["file"] == "a.csv"
