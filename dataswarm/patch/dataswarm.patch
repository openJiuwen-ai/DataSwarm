+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo } from 'react';
+import type { CustomSeriesRenderItem, EChartsOption } from 'echarts';
+import { useTranslation } from 'react-i18next';
+import { EChart } from './shared/EChart';
+import { FindingList, Panel } from './shared/Ui';
+import type { MetricArtifact } from '../types/inspection';
+import { CHART, CHART_SERIES, CHART_TOOLTIP, MONO_FONT } from '../govTheme';
+import { buildMetricCaliberChartModel, metricCaliberLegendName, type MetricCaliberChartItem } from './metricChartModel';
+
+/**
+ * 指标页（plan §7.3）。
+ *
+ *  - 一级横轴只展示指标，每个指标内部按接口口径顺序显式计算居中槽位；
+ *  - custom series 自己绘制柱与 null 标记，不依赖稀疏 bar series 的自动排槽；
+ *  - null 口径显示“—”，绝不作为 0 参与归一化或柱高计算。
+ */
+
+const METRIC_CALIBER_COLORS = [...CHART_SERIES, '#a45d4d', '#5c8d94', '#847545', '#5b759e', '#8e668a', '#467b72'];
+
+function escapeHtml(value: string): string {
+  return value.replace(/[&<>'"]/g, character => {
+    const entities: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' };
+    return entities[character];
+  });
+}
+
+function createRenderItem(items: MetricCaliberChartItem[], color: string): CustomSeriesRenderItem {
+  return (_params, api) => {
+    const globalItemIndex = Number(api.value(3));
+    const item = items[globalItemIndex];
+    if (!item || !api.size) return undefined;
+
+    const baseline = api.coord([item.metricIndex, 0]);
+    const categorySize = api.size([1, 0]);
+    const categoryWidth = Array.isArray(categorySize) ? Number(categorySize[0]) : Number(categorySize);
+    const gap = 4;
+    const clusterWidth = Math.min(categoryWidth * 0.7, 88);
+    const barWidth = Math.max(6, Math.min(20, (clusterWidth - gap * Math.max(0, item.slotCount - 1)) / Math.max(1, item.slotCount)));
+    const occupiedWidth = barWidth * item.slotCount + gap * Math.max(0, item.slotCount - 1);
+    const centerX = baseline[0] - occupiedWidth / 2 + item.slotIndex * (barWidth + gap) + barWidth / 2;
+
+    if (item.normalizedValue === null) {
+      return {
+        type: 'text',
+        x: centerX,
+        y: baseline[1] - 8,
+        style: {
+          text: '—',
+          fill: item.isGhost ? '#cf4436' : CHART.muted,
+          font: `600 13px ${MONO_FONT}`,
+          textAlign: 'center',
+          textVerticalAlign: 'middle',
+        },
+      };
+    }
+
+    const valuePoint = api.coord([item.metricIndex, item.normalizedValue]);
+    return {
+      type: 'rect',
+      shape: {
+        x: centerX - barWidth / 2,
+        y: valuePoint[1],
+        width: barWidth,
+        height: Math.max(1, baseline[1] - valuePoint[1]),
+        r: [2, 2, 0, 0],
+      },
+      style: { fill: color },
+      emphasis: { style: { opacity: 0.78 } },
+    };
+  };
+}
+
+export function MetricPage({ artifact, showFindings = true }: { artifact?: MetricArtifact; showFindings?: boolean }) {
+  const { t, i18n } = useTranslation();
+  const metrics = artifact?.metric_values ?? [];
+  const findings = artifact?.findings ?? [];
+
+  const chartModel = useMemo(() => buildMetricCaliberChartModel(metrics, findings), [metrics, findings]);
+
+  // 警告区只统计契约中的 metric_ghost；图内状态由 metric + caliber 精确身份决定。
+  const ghostMetricNames = useMemo(() => {
+    const names = new Set<string>();
+    for (const f of findings) {
+      if (f.category !== 'metric_ghost') continue;
+      const metric = f.object?.metric;
+      if (typeof metric === 'string') names.add(metric);
+    }
+    return [...names];
+  }, [findings]);
+
+  const option = useMemo<EChartsOption>(() => {
+    const caliberColors = new Map(chartModel.legendCalibers.map((caliber, index) => [caliber, METRIC_CALIBER_COLORS[index % METRIC_CALIBER_COLORS.length]]));
+
+    return {
+      color: METRIC_CALIBER_COLORS,
+      tooltip: {
+        ...CHART_TOOLTIP,
+        trigger: 'item',
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        formatter: (params: any) => {
+          const value = Array.isArray(params?.value) ? params.value : [];
+          const item = chartModel.items[Number(value[3])];
+          if (!item) return '';
+          const normalized = item.normalizedValue === null ? '—' : `${item.normalizedValue.toFixed(1)}%`;
+          const raw = item.rawValue === null ? '—' : new Intl.NumberFormat(i18n.language, { maximumFractionDigits: 6 }).format(item.rawValue);
+          const lines = [
+            `<strong>${escapeHtml(item.metric)}</strong>`,
+            `${params.marker ?? ''}${escapeHtml(item.caliber)}`,
+            escapeHtml(t('governance.dashboard.metric.tooltip.normalizedValue', { value: normalized })),
+            escapeHtml(t('governance.dashboard.metric.tooltip.rawValue', { value: raw })),
+            escapeHtml(t('governance.dashboard.metric.tooltip.sourceTable', { value: item.sourceTable || '—' })),
+            escapeHtml(t('governance.dashboard.metric.tooltip.note', { value: item.note || '—' })),
+          ];
+          if (item.isGhost) lines.push(escapeHtml(t('governance.dashboard.metric.tooltip.missingReference')));
+          return lines.join('<br/>');
+        },
+      },
+      legend: {
+        type: 'scroll',
+        data: chartModel.legendCalibers,
+        left: 'center',
+        right: 8,
+        bottom: 0,
+        itemWidth: 10,
+        itemHeight: 10,
+        itemGap: 14,
+        textStyle: { color: CHART.muted, fontSize: 10, width: 92, overflow: 'truncate', ellipsis: '…' },
+        formatter: metricCaliberLegendName,
+      },
+      grid: { left: 48, right: 16, top: 26, bottom: 66 },
+      xAxis: {
+        type: 'category',
+        data: chartModel.groups.map(group => group.metric),
+        tooltip: { show: true },
+        axisLabel: {
+          interval: 0,
+          rotate: 0,
+          fontSize: 11,
+          width: 82,
+          overflow: 'truncate',
+          ellipsis: '…',
+          fontFamily: MONO_FONT,
+          color: CHART.muted,
+        },
+        axisTick: { alignWithLabel: true },
+      },
+      yAxis: {
+        type: 'value',
+        max: 100,
+        name: t('governance.dashboard.metric.maxPercentAxis'),
+        nameTextStyle: { fontSize: 10 },
+        axisLabel: { formatter: '{value}%', fontFamily: MONO_FONT, color: CHART.muted },
+      },
+      series: chartModel.legendCalibers.map(caliber => ({
+        name: caliber,
+        type: 'custom',
+        coordinateSystem: 'cartesian2d',
+        clip: true,
+        itemStyle: { color: caliberColors.get(caliber) },
+        renderItem: createRenderItem(chartModel.items, caliberColors.get(caliber) ?? CHART_SERIES[0]),
+        encode: { x: 0 },
+        data: chartModel.items
+          .map((item, globalItemIndex) => ({ item, globalItemIndex }))
+          .filter(({ item }) => item.caliber === caliber)
+          .map(({ item, globalItemIndex }) => ({
+            value: [item.metricIndex, item.slotIndex, item.slotCount, globalItemIndex],
+            itemStyle: { color: caliberColors.get(caliber) },
+          })),
+      })),
+    };
+  }, [chartModel, i18n.language, t]);
+
+  return (
+    <div className="space-y-4">
+      {showFindings && ghostMetricNames.length > 0 && (
+        <div className="gov-alert" data-variant="warn">
+          <span>
+            {t('governance.dashboard.metric.ghostWarning', {
+              count: ghostMetricNames.length,
+              names: ghostMetricNames.join(t('governance.dashboard.metric.nameSeparator')),
+            })}
+          </span>
+        </div>
+      )}
+      <div className={`grid gap-4 ${showFindings ? 'xl:grid-cols-[minmax(0,1fr)_minmax(360px,1fr)]' : ''}`}>
+        <Panel title={t('governance.dashboard.metric.title')}>
+          <div
+            data-metric-group-count={chartModel.groups.length}
+            data-metric-group-slots={chartModel.groups.map(group => group.slotCount).join('/')}
+            data-metric-valid-count={chartModel.availableValueCount}
+            data-metric-null-count={chartModel.missingValueCount}
+          >
+            {chartModel.allValuesMissing ? (
+              <div className="flex h-[250px] items-center justify-center px-6 text-center text-sm text-text-muted" role="status">
+                {t('governance.dashboard.metric.allValuesMissing', {
+                  metricCount: chartModel.groups.length,
+                  caliberCount: chartModel.totalCaliberCount,
+                })}
+              </div>
+            ) : (
+              <EChart option={option} ariaLabel={t('governance.dashboard.charts.metricCaliber')} height={250} />
+            )}
+          </div>
+        </Panel>
+        {showFindings && (
+          <Panel title={t('governance.dashboard.metric.findings', { count: findings.length })}>
+            <FindingList findings={findings} />
+          </Panel>
+        )}
+      </div>
+    </div>
+  );
+}
