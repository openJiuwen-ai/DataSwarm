@@ -0,0 +1,173 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useDrawer } from '../hooks/useDrawer';
+// 工作流新建/编辑抽屉（右侧滑出）：名称/调度类型/cron/触发时间/描述。
+// 新建与编辑共用：workflow=null 为新建（提交后 onCreated 进 DAG 编辑页）。
+// 详情页的逐项编辑由 WorkflowDetails 提供，调度字段共用 WorkflowScheduleFields。
+
+import { useEffect, useState } from 'react';
+import { X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import type { ScheduleType, WorkflowDefinition } from '../types/orchestration';
+import { orchestrationApi } from '../api/orchestrationApi';
+import { Button, Field, inputClass, toast } from './shared/Ui';
+import { WorkflowScheduleFields } from './WorkflowScheduleFields';
+
+interface Props {
+  open: boolean;
+  /** 编辑时传入已有工作流；null = 新建 */
+  workflow: WorkflowDefinition | null;
+  onClose: () => void;
+  /** 新建成功回调（宿主切到 DAG 编辑页） */
+  onCreated: (wf: WorkflowDefinition) => void;
+  onUpdated?: (wf: WorkflowDefinition) => void;
+}
+
+export function WorkflowFormDrawer({ open, workflow, onClose, onCreated, onUpdated }: Props) {
+  const { t } = useTranslation();
+  const [error, setError] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [description, setDescription] = useState('');
+  const [scheduleType, setScheduleType] = useState<ScheduleType>('none');
+  const [cron, setCron] = useState('');
+  const [onceAt, setOnceAt] = useState('');
+  const [touched, setTouched] = useState(false);
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    if (!open) return;
+    setName(workflow?.name ?? '');
+    setDescription(workflow?.description ?? '');
+    setScheduleType(workflow?.schedule_type ?? 'none');
+    setCron(workflow?.schedule_cron ?? '');
+    setOnceAt(workflow?.schedule_once_at ?? '');
+    setTouched(false);
+    setError(null);
+  }, [open, workflow]);
+
+  const drawerRef = useDrawer(open, () => {
+    if (!busy) onClose();
+  });
+
+  if (!open) return null;
+
+  const nameMissing = !name.trim();
+  const showErr = touched && nameMissing;
+
+  const submit = async () => {
+    setTouched(true);
+    if (nameMissing || busy) return;
+    if ((scheduleType === 'cron' && !cron.trim()) || (scheduleType === 'once' && !onceAt.trim())) {
+      setError(t('dataAsset.taskForm.invalid'));
+      return;
+    }
+    setError(null);
+    setBusy(true);
+    try {
+      const input = {
+        name: name.trim(),
+        description: description.trim(),
+        schedule_type: scheduleType,
+        schedule_cron: scheduleType === 'cron' ? cron.trim() : '',
+        schedule_once_at: scheduleType === 'once' ? onceAt.trim() : '',
+      };
+      if (workflow) {
+        const updated = await orchestrationApi.updateWorkflow(workflow.workflow_id, input);
+        if (updated) {
+          onUpdated?.(updated);
+          toast.success(t('dataAsset.wfForm.updated', { name: input.name }));
+          onClose();
+        }
+      } else {
+        const created = await orchestrationApi.createWorkflow(input);
+        if (created) {
+          toast.success(t('dataAsset.wfForm.created', { name: input.name }));
+          onClose();
+          onCreated(created);
+        }
+      }
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end" ref={drawerRef} role="dialog" aria-modal="true">
+      <div
+        className="absolute inset-0 bg-black/40"
+        onClick={() => {
+          if (!busy) onClose();
+        }}
+      />
+      <div className="relative flex h-full w-[440px] max-w-[90vw] flex-col border-l border-border bg-card shadow-2xl">
+        <div className="flex items-center justify-between border-b border-border px-4 py-3">
+          <h3 className="text-sm font-semibold text-text-strong">
+            {workflow ? t('dataAsset.wfForm.editTitle') : t('dataAsset.wfForm.createTitle')}
+          </h3>
+          <button
+            className="rounded p-1 text-text-muted hover:bg-secondary hover:text-text"
+            onClick={() => {
+              if (!busy) onClose();
+            }}
+            aria-label={t('common.close')}
+          >
+            <X size={16} />
+          </button>
+        </div>
+
+        <div className="flex-1 space-y-4 overflow-y-auto p-4">
+          <Field label={t('dataAsset.wfForm.name')} hint={showErr ? t('dataAsset.wfForm.nameRequired') : undefined}>
+            <input
+              className={`${inputClass} ${showErr ? 'border-danger' : ''}`}
+              value={name}
+              onChange={(e) => {
+                setName(e.target.value);
+                setTouched(true);
+              }}
+              placeholder={t('dataAsset.wfForm.namePlaceholder')}
+            />
+          </Field>
+
+          <WorkflowScheduleFields
+            scheduleType={scheduleType}
+            cron={cron}
+            onceAt={onceAt}
+            onScheduleTypeChange={setScheduleType}
+            onCronChange={setCron}
+            onOnceAtChange={setOnceAt}
+          />
+
+          <Field label={t('dataAsset.wfForm.description')}>
+            <textarea
+              className={`${inputClass} min-h-[72px]`}
+              value={description}
+              onChange={(e) => setDescription(e.target.value)}
+              placeholder={t('dataAsset.wfForm.descriptionPlaceholder')}
+            />
+          </Field>
+        </div>
+
+        <div className="flex justify-end gap-2 border-t border-border px-4 py-3">
+          {error && (
+            <span role="alert" className="mr-auto text-xs text-danger">
+              {error}
+            </span>
+          )}
+          <Button
+            variant="ghost"
+            disabled={busy}
+            onClick={() => {
+              if (!busy) onClose();
+            }}
+          >
+            {t('common.cancel')}
+          </Button>
+          <Button variant="primary" loading={busy} onClick={() => void submit()}>
+            {workflow ? t('common.save') : t('dataAsset.wfForm.create')}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
