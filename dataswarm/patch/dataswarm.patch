+的 monkeypatch 在这些入口内同样生效（test_analysis_shortcut / recall 实证
+依赖该语义）。
+"""
+from .core import (
+    SCHEMA_PROPAGATION as SCHEMA_PROPAGATION,
+    SCHEMA_PROPAGATE_LIMIT as SCHEMA_PROPAGATE_LIMIT,
+    SCHEMA_PROPAGATE_MIN as SCHEMA_PROPAGATE_MIN,
