+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import (  # noqa: E402
+    QueryValidationError,
+)
+from jiuwenswarm.channels.web.dataagent.connectors import paths as cpaths  # noqa: E402
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R  # noqa: E402
+from jiuwenswarm.common import db_connector as dbc  # noqa: E402
+from jiuwenswarm.common import dialect_registry as dr  # noqa: E402
+
+PASS, FAIL, SKIP = [], [], []
+
+HDFS_CONFIG = {
+    "protocol": "webhdfs",
+    "host": "127.0.0.1",
+    "port": PORT,
+    "user": USER,
+    "password": "",
+    "path": f"{HDFS_DIR}/*.csv",
+    "format": "csv",
+    "table_name": "fact_orders",
+}
+
+BASELINE = {
+    "Q1 单指标总量": [["2318839.92"]],
+    "Q2 分组TopN排序": [["4", "620606.75"], ["2", "620448.25"], ["3", "532051.48"]],
+    "Q3 时间粒度月度": [["2026-01", "99018.5"], ["2026-02", "91174.23"],
+                        ["2026-03", "97070.7"]],
+    "Q4 过滤+聚合": [["1", "10651"], ["2", "12425"], ["3", "10650"], ["4", "12425"]],
+    "Q5 空值占比": [["7.142"]],
+}
+
+QUESTIONS = {
+    "Q1 单指标总量": "SELECT ROUND(SUM(order_amt), 2) AS v FROM {t}",
