+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/_common.py — 跨模块共享 helper。
+
+供各业务子包（lineage / catalog / sql / ...）的 controller 与 service 复用，
+避免在每个子包里重复复制 read_body / resolve_db_ref / ref_is_sqlite 等。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import parse_qs
+
+
+def read_body(handler) -> dict | None:
+    """读 POST JSON 请求体。空 body 返回 {}，解析失败返回 None。"""
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except (TypeError, ValueError):
+        return None
+    if not length:
+        return {}
+    raw = handler.rfile.read(length)
+    try:
+        return json.loads(raw)
+    except (json.JSONDecodeError, TypeError, UnicodeDecodeError):
+        return None
+
+
+def resolve_db_ref(handler, parsed, db_name: str) -> str:
+    """前端传的 db_name 即业务库名。db_ref query 参数仅作旧调用方兼容。"""
+    explicit = _query_arg(parsed, "db_ref")
+    if explicit:
+        return explicit
+    return db_name
+
+
+def _query_arg(parsed, name: str) -> str | None:
+    """从 urlparse 结果中取单个 query 参数。"""
+    qs = parse_qs(parsed.query) if hasattr(parsed, "query") else {}
+    vals = qs.get(name)
+    return vals[0] if vals else None
+
+
+def ref_is_sqlite(db_ref: str) -> bool:
+    """判定 db_ref 是否指向 SQLite。
+
+    sqlite://... 或无 :// 且后缀 .db 视为 SQLite；其他视为 Doris/MySQL。
+    """
+    return db_ref.startswith("sqlite://") or (
+        "://" not in db_ref and db_ref.lower().endswith(".db")
+    )
+
+
+def write_json(handler, status: int, payload: dict) -> None:
+    """统一 JSON 响应包装。委托 handler 自身的 _write_json。"""
+    handler._write_json(status, payload)
