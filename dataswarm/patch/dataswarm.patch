+    assert entry["engine"] == "staged", entry
+    assert entry["unavailable_reason"] == "", entry
+    assert "staged" in registered_engines(), registered_engines()
+    return f"hdfs 可用，引擎=staged（与 ftp 同引擎，未另造一套）"
+
+
