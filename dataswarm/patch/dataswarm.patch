+/* StructChangePanel — 两区布局：事件清单（上）+ 详情视图（下）。
+   视觉对齐治理模块（gov-* token 家族 + 圆角 16px + 下划线式 tab + 逐行入场动画）。 */
+
+.struct-change-panel {
+  display: flex;
+  width: 100%;
+  height: 100%;
+  min-height: 0;
+  flex-direction: column;
+  gap: 0.75rem;
+  padding: 0.75rem;
+}
+
+/* ---- 事件清单 ---- */
+/* 高度跟随内容但设硬上限（约 8 行）：超过内部滚动，不无限增高压缩详情区 */
+.struct-change-list {
+  display: flex;
+  flex: 0 1 auto;
+  max-height: min(45%, 21rem);
+  flex-direction: column;
+  border: 1px solid var(--color-border-default, #e2e8f0);
+  border-radius: 16px;
+  background: var(--color-surface-card);
+  overflow: hidden;
+}
+
+/* ---- 类型筛选条（下划线式，对齐 .gov-main-tabs）---- */
+.struct-change-list-filter {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  flex: none;
+  height: 36px;
+  padding: 0 0.75rem;
+  border-bottom: 1px solid var(--color-border-default, #e2e8f0);
+}
+
+.struct-change-filter-btn {
+  position: relative;
+  height: 29px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--color-text-secondary, #64748b);
+  cursor: pointer;
+  font-size: 0.75rem;
+  font-weight: 400;
+  line-height: 1.25rem;
+  transition: color 0.15s;
+}
+
+.struct-change-filter-btn:hover {
+  color: var(--color-text-primary, #1e293b);
+}
+
+.struct-change-filter-btn.is-active {
+  color: var(--color-text-strong, #0f172a);
+  font-weight: 600;
+}
+
+.struct-change-filter-btn.is-active::after {
+  position: absolute;
+  right: 0;
+  bottom: -1px;
+  left: 0;
+  height: 2px;
+  background: var(--color-text-primary, #1e293b);
+  content: '';
+}
+
+.struct-change-list-scroll {
+  flex: 1;
+  overflow-y: auto;
+  padding: 0.25rem 0.375rem;
+}
+
+.struct-change-row {
+  display: flex;
+  width: 100%;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.4375rem 0.5rem;
+  border-radius: 0.5rem;
+  text-align: left;
+  cursor: pointer;
+  /* 入场动画：面板首次出现时逐行淡入下滑（收起态传 index=-1 关闭） */
+  animation: struct-change-row-in 0.24s ease-out both;
+}
+
+@keyframes struct-change-row-in {
+  from {
+    opacity: 0;
+    transform: translateY(3px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.struct-change-row:hover {
+  background: var(--color-surface-muted, #f1f5f9);
+}
+
+.struct-change-row.is-selected {
+  background: var(--color-action-primary-subtle, rgba(37, 99, 235, 0.1));
+  box-shadow: inset 2px 0 0 var(--color-action-primary, #2563eb);
+}
+
+.struct-change-row-icon {
+  display: flex;
+  flex: none;
+  color: var(--color-text-secondary, #64748b);
+}
+
+.struct-change-row-body {
+  display: flex;
+  min-width: 0;
+  flex: 1;
+}
+
+.struct-change-row-title {
+  overflow: hidden;
+  font-size: 0.8125rem;
+  font-weight: 500;
+  color: var(--color-text-strong, #0f172a);
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* 右侧状态徽章：操作类（库表建/改/删、工作流定义变更）统一中性底；运行态用状态色 */
+.struct-change-row-badge {
+  flex: none;
+  padding: 0 0.375rem;
+  border-radius: 0.25rem;
+  font-size: 0.6875rem;
+  line-height: 1.25rem;
+  white-space: nowrap;
+  background: var(--color-surface-muted, #f1f5f9);
+  color: var(--color-text-secondary, #64748b);
+}
+
+.struct-change-row-badge.is-debug { background: var(--color-feedback-running-subtle, #eff6ff); color: var(--color-feedback-running, #2563eb); }
+.struct-change-row-badge.is-success { background: var(--color-feedback-success-subtle, #ecfdf5); color: var(--color-feedback-success, #059669); }
+.struct-change-row-badge.is-failed { background: var(--color-feedback-danger-subtle, #fef2f2); color: var(--color-feedback-danger, #dc2626); }
+.struct-change-row-badge.is-running { background: var(--color-feedback-running-subtle, #eff6ff); color: var(--color-feedback-running, #2563eb); }
+.struct-change-row-badge.is-queued { background: var(--color-surface-muted, #f1f5f9); color: var(--color-text-secondary, #64748b); }
+.struct-change-row-badge.is-waiting_review { background: var(--color-feedback-waiting-review-subtle, #fffbeb); color: var(--color-feedback-waiting-review, #b45309); }
+.struct-change-row-badge.is-cancelled { background: var(--color-surface-muted, #f1f5f9); color: var(--color-text-secondary, #64748b); }
+.struct-change-row-badge.is-paused { background: var(--color-surface-muted, #f1f5f9); color: var(--color-text-secondary, #64748b); }
+.struct-change-row-badge.is-skipped { background: var(--color-surface-muted, #f1f5f9); color: var(--color-text-secondary, #64748b); }
+
+.struct-change-row-time {
+  flex: none;
+  font-size: 0.6875rem;
+  color: var(--color-text-tertiary, #94a3b8);
+  font-variant-numeric: tabular-nums;
+}
+
+/* ---- 详情视图 ---- */
+.struct-change-view {
+  display: flex;
+  min-height: 0;
+  flex: 1;
+  flex-direction: column;
+}
+
+.struct-change-detail {
+  display: flex;
+  min-height: 0;
+  flex: 1;
+  flex-direction: column;
+  gap: 0.5rem;
+}
+
+.struct-change-lineage {
+  display: flex;
+  min-height: 0;
+  flex: 1;
+  border: 1px solid var(--color-border-default, #e2e8f0);
+  border-radius: 16px;
+  overflow: hidden;
+}
+
+/* WorkflowGraph 在面板容器里的宽高链：wf-dag-canvas 基础样式无 width，
+   在数据开发页靠 dd-canvas-area 的 flex 布局撑开；面板容器需要显式补齐，
+   否则画布 0 宽——节点渲染了但不可见（"空 DAG"根因）。 */
+.struct-change-lineage .wf-dag-root {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.struct-change-lineage .wf-dag-canvas {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  border-radius: 0;
+}
+
+/* WorkflowPreview iframe 填满剩余高度 */
+.struct-change-detail .workflow-preview {
+  display: flex;
+  min-height: 0;
+  flex: 1;
+}
+
+/* ---- 表结构卡（建表无血缘边时的降级视图，方案 A）---- */
+.struct-change-schema {
+  display: flex;
+  min-height: 0;
+  flex: 1;
+  flex-direction: column;
+  gap: 0.75rem;
+  border: 1px solid var(--color-border-default, #e2e8f0);
+  border-radius: 16px;
+  padding: 0.75rem;
+  overflow: hidden;
+}
+
+.struct-change-schema-stats {
+  display: flex;
+  flex: none;
+  align-items: center;
+  gap: 0.75rem;
+  font-size: 0.75rem;
+  color: var(--color-text-secondary, #64748b);
+}
+
+.struct-change-schema-layer {
+  padding: 0.0625rem 0.5rem;
+  border-radius: 0.375rem;
+  font-size: 0.6875rem;
+  font-weight: 600;
+  line-height: 1.25rem;
+  color: #fff;
+  background: var(--color-text-tertiary, #94a3b8);
+}
+
+.struct-change-schema-layer[data-layer='ODS'] { background: #0ea5e9; }
+.struct-change-schema-layer[data-layer='DWD'] { background: #2563eb; }
+.struct-change-schema-layer[data-layer='DWS'] { background: #7c3aed; }
+.struct-change-schema-layer[data-layer='ADS'] { background: #db2777; }
+
+.struct-change-schema-table {
+  min-height: 0;
+  flex: 1;
+  overflow: auto;
+  border: 1px solid var(--color-border-default, #e2e8f0);
+  border-radius: 0.5rem;
+}
+
+.struct-change-schema-table table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.75rem;
+}
+
+.struct-change-schema-table th {
+  position: sticky;
+  top: 0;
+  padding: 0.375rem 0.625rem;
+  background: var(--color-surface-muted, #f1f5f9);
+  color: var(--color-text-secondary, #64748b);
+  font-weight: 500;
+  text-align: left;
+  white-space: nowrap;
+}
+
+.struct-change-schema-table td {
+  padding: 0.3125rem 0.625rem;
+  border-top: 1px solid var(--color-border-default, #e2e8f0);
+  color: var(--color-text-strong, #0f172a);
+  white-space: nowrap;
+}
+
+.struct-change-type-badge {
+  padding: 0 0.375rem;
+  border-radius: 0.375rem;
+  background: var(--color-surface-muted, #f1f5f9);
+  font-family: var(--gov-font-mono, monospace);
+  font-size: 0.6875rem;
+  color: var(--color-text-secondary, #64748b);
+}
+
+.struct-change-schema-note {
+  flex: none;
+  margin: 0;
+  font-size: 0.6875rem;
+  color: var(--color-text-muted, #94a3b8);
+}
+
+/* ---- 占位/空态 ---- */
+.struct-change-placeholder {
+  display: flex;
+  flex: 1;
+  align-items: center;
+  justify-content: center;
+  padding: 0.75rem;
+  font-size: 0.75rem;
+  color: var(--color-text-muted, #94a3b8);
+  text-align: center;
+}
+
+/* 清单空态：不参与撑高卡片（列表高度跟随内容） */
+.struct-change-list .struct-change-placeholder {
+  flex: 0 0 auto;
+  padding: 0.875rem;
+}
+
+.struct-change-placeholder-error {
+  color: var(--color-feedback-danger, #dc2626);
+}
