+            ["sql", "run", "--db-ref", "doris://x", "--sql", "SELECT 1", "--sql-file", f.as_posix()],
+        )
+        assert cap["body"]["sql"] == "SELECT 1"
+
+    def test_structured_body_params_are_json_decoded(self, monkeypatch):
+        cap = self._run_main(
+            monkeypatch,
+            ["workflow", "debug", "--id", "wf1", "--only-nodes", '["n1","n2"]'],
+        )
+        assert cap["body"]["only_nodes"] == ["n1", "n2"]
+
+    def test_invalid_structured_body_param_exits_2(self, capsys):
+        with pytest.raises(SystemExit) as exc:
+            dwcli.main(["workflow", "debug", "--id", "wf1", "--only-nodes", "not-json"])
+        assert exc.value.code == 2
+        assert "only_nodes" in capsys.readouterr().out
+
+
+# --------------------------------------------------------------------------
+# databases 组 --db 缺省推导：从 --db-ref 指针取库名（doris://olist → olist），
+# 对齐 dw_client.tables() 的客户端推导；--db 与 --db-ref 都缺时明确报错
+# --------------------------------------------------------------------------
+class TestDbInference:
+    def _run_main(self, monkeypatch, argv):
+        captured = {}
+
+        def fake_call(method, path, query=None, body=None, base="", **kwargs):
+            captured["method"] = method
+            captured["path"] = path
+            captured["query"] = query
+            return {"tables": [], "table_count": 0}
+
+        monkeypatch.setattr(dwcli, "_call_api", fake_call)
+        with pytest.raises(SystemExit):
+            dwcli.main(argv)
+        return captured
+
+    def test_db_name_from_ref_pointer(self):
+        assert dwcli._db_name_from_ref("doris://olist_txk") == "olist_txk"
+        assert dwcli._db_name_from_ref("mysql://biz") == "biz"
+
+    def test_db_name_from_ref_host_port(self):
+        assert dwcli._db_name_from_ref("doris://host:9030/olist") == "olist"
+
+    def test_db_name_from_ref_unresolvable(self):
+        assert dwcli._db_name_from_ref("doris://") is None
+        assert dwcli._db_name_from_ref("doris://meta") is None
+        assert dwcli._db_name_from_ref(None) is None
+
+    def test_db_name_from_ref_sqlite_uses_main_placeholder(self):
+        """sqlite 单文件库无库名概念：{db} 段用 main 占位。
+
+        服务端 resolve_db_ref 优先用 query 的 db_ref，占位只为让 path var 可组装；
+        旧实现返回 None 导致 `databases tables --db-ref sqlite://…` 必报
+        「缺少路径变量 --db」并 exit 2（dacomp-zh-001 实证）。
+        """
+        assert dwcli._db_name_from_ref("sqlite://D:/eval/x.sqlite") == "main"
+        assert dwcli._db_name_from_ref("sqlite:///x/y.db") == "main"
+
+    def test_tables_db_inferred_from_db_ref(self, monkeypatch):
+        """只传 --db-ref doris://olist_txk（不传 --db）也能出表清单。"""
+        cap = self._run_main(
+            monkeypatch,
+            ["databases", "tables", "--db-ref", "doris://olist_txk"],
+        )
+        assert cap["path"] == "/databases/olist_txk/tables"
+        assert cap["query"]["db_ref"] == "doris://olist_txk"
+
+    def test_table_detail_db_inferred(self, monkeypatch):
+        cap = self._run_main(
+            monkeypatch,
+            ["databases", "table", "--db-ref", "doris://olist", "--table", "olist_orders"],
+        )
+        assert cap["path"] == "/databases/olist/tables/olist_orders"
+
+    def test_explicit_db_wins_over_ref(self, monkeypatch):
+        """显式 --db 优先，不被 --db-ref 推导覆盖。"""
+        cap = self._run_main(
+            monkeypatch,
+            ["databases", "tables", "--db", "other_db", "--db-ref", "doris://olist"],
+        )
+        assert cap["path"] == "/databases/other_db/tables"
+
+    def test_missing_db_and_unresolvable_ref_exits_2(self, monkeypatch, capsys):
+        """--db 与可推导的 --db-ref 都缺 → 明确报错退出 2（而非 argparse usage error）。"""
+        monkeypatch.setattr(dwcli, "_call_api", lambda *a, **kw: {})
+        with pytest.raises(SystemExit) as exc:
+            dwcli.main(["databases", "tables", "--db-ref", "doris://"])
+        assert exc.value.code == 2
+        out = capsys.readouterr().out
+        assert "--db" in out and "db-ref" in out
+
