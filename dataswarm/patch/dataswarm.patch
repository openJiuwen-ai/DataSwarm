+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent 单测环境隔离：默认关闭向量/嵌入通道（网络 + faiss 双红线）。
+
+对齐 ``tests/unit_tests/web/conftest.py`` 的 ``_emb_off_by_default``：开发机
+可能已配置真实嵌入端点（``config/.env`` 的 embed 段），不关会让单测真打
+端点（网络 + 计费 + 不确定性）；且 Windows 上 faiss 链接的 OpenBLAS 多线程
+预分配会 hard crash（test_glossary_sync.py 模块 docstring 的既有教训）。
+需要向量层的用例显式开启并注入确定性桩（``vector_env`` / web 侧 ``emb_on``
+模式）。
+
+三条通道逐一处理：
+
+- ``DATASWARM_METRICS_EMB_ENABLED=false``：metrics 与 semantic 的
+  ``emb_available()`` 显式关闭优先 → 采集挂载的向量同步走 ``skipped``；
+- glossary 的 ``_embedding_configured`` 是独立判定（读平台 embed 配置，
+  不吃上述 env），须单独打桩；
+- 向量目录钉 tmp：绝不写真实 ``data/``。
+"""
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def _vector_channels_off_by_default(monkeypatch, tmp_path):
