+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Parquet/JSON 接入、建模、分析与护栏验收，以及 S3/OSS 离线契约检查。
+
+用法：verify_gates.py <fixture_dir>。五道分析题使用同一 fixture 和固定答案；
+S3/OSS 的声明、ref 和端点检查不构成真实对象存储服务验收。
+"""
+import sys
+from pathlib import Path
+
+DATA = Path(sys.argv[1]).resolve()
+
+import sqlglot  # noqa: E402
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (  # noqa: E402
+    SourceDefinition, SqlQueryable, capabilities_of, get_engine,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import (  # noqa: E402
+    QueryValidationError,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.sql_guard import (  # noqa: E402
+    validate_read_only_sql,
+)
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R  # noqa: E402
+from jiuwenswarm.common import db_connector as dbc  # noqa: E402
+from jiuwenswarm.common import dialect_registry as dr  # noqa: E402
+
+PASS, FAIL, SKIP = [], [], []
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+def connector_for(type_id, config):
+    adapter = R.get_source_type(type_id)
+    source = SourceDefinition("verify", type_id, "verify", adapter.engine, dict(config))
+    return get_engine(adapter.engine)(source)
+
+
+def dataset_names(cat):
+    """读取 datasets 列表，兼容 schemas/tables 目录表示。"""
+    if cat.get("datasets") is not None:
+        return [d["name"] for d in cat["datasets"]]
+    return [tb["name"] for s in cat.get("schemas", []) for tb in s["tables"]]
+
+
+FACT = {"location": str(DATA / "fact_orders.parquet"), "table_name": "fact_orders"}
+FACT_JSON = {"location": str(DATA / "fact_orders.json"), "table_name": "fact_orders"}
+FACT_CSV = {"path": str(DATA / "fact_orders.csv")}
+
+# ======================================================================
+print("\n########## 门 A：接入 ##########")
+
+
+def a_catalog_entries():
+    types = {t["type_id"]: t for t in R.list_source_types()}
+    for tid in ("parquet", "json", "s3", "oss"):
+        entry = types[tid]
+        assert entry["available"] is True, f"{tid} 未放开"
+        assert entry["fields"], f"{tid} 无表单字段"
+        assert entry["unavailable_reason"] == ""
+    return "parquet/json/s3/oss 均可用且有表单字段"
+
+
+def a_validate_rejects_bad_input():
+    expect_raises(lambda: R.get_source_type("parquet").validate({}),
+                  ValueError, "parquet 空 location")
+    expect_raises(lambda: R.get_source_type("s3").validate(
+        {"location": "ftp://x/y", "format": "parquet"}), ValueError, "s3 非法 scheme")
+    expect_raises(lambda: R.get_source_type("s3").validate(
+        {"location": "s3://b/k", "format": "avro"}), ValueError, "s3 不支持的 format")
+    expect_raises(lambda: R.get_source_type("oss").validate(
+        {"location": "oss://b/k.parquet", "format": "parquet"}),
+        ValueError, "oss 缺 endpoint")
+    return "空值/非法 scheme/非法 format/缺 endpoint 均被拒"
+
+
+def a_ssrf_guard():
+    s3 = R.get_source_type("s3")
+    config = {"location": "s3://b/k.parquet", "format": "parquet"}
+    bad_hosts = ("169.254.169.254", "http://169.254.169.254/latest/meta-data",
+                 "10.1.2.3", "192.168.1.1", "172.20.0.5", "metadata.google.internal",
+                 "http://[fe80::1]:9000", "http://[fd00::1]:9000", "0.0.0.0", "0xa9fea9fe",
+                 "http://127.0.0.1:9000/private", "http://localhost@169.254.169.254")
+    for bad in bad_hosts:
+        expect_raises(lambda b=bad: s3.validate({**config, "endpoint": b}),
+            ValueError, f"endpoint={bad}")
+    for endpoint in ("localhost:9000", "http://127.0.0.1:9000", "http://[::1]:9000",
+                     "oss-cn-hangzhou.aliyuncs.com", "s3.us-east-1.amazonaws.com"):
+        s3.validate({**config, "endpoint": endpoint})
+    return "S3 允许回环及公网端点，拒绝私网、元数据及非端点 URL"
+
+
+def a_test_connection():
+    ok = connector_for("parquet", FACT).test_connection()
+    assert ok.get("ok") is True, f"真实文件应连通: {ok}"
+    bad = connector_for("parquet", {"location": str(DATA / "nope.parquet")}).test_connection()
+    assert bad.get("ok") is False, f"不存在的文件应失败: {bad}"
+    return "真实文件连通、缺失文件报错"
