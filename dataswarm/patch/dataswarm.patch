+                "columns": [
+                    {"name": "order_id", "dtype": "VARCHAR(64)", "nullable": False}
+                ],
+                "source_tables": ["olist.ods_olist_orders_dataset"],
+                "source_aliases": {"olist.ods_olist_orders_dataset": "o"},
+                "joins": [],
+                "column_exprs": {"order_id": "o.`order_id`"},
+                "group_by": [],
+            }
+        ],
+    }
+    spec_file = tmp_path / "_spec.json"
+    spec_file.write_text(json.dumps(spec, ensure_ascii=False), encoding="utf-8")
+
+    snapshot = {
+        "ok": True,
+        "biz_database": "olist",
+        "csv_dir": "D:/olist",
+        "csv_files": [
+            {
+                "file": "olist_orders_dataset.csv",
+                "stem": "olist_orders_dataset",
+                "row_count": 99441,
+                "columns": [
+                    {"name": "order_id", "dtype": "VARCHAR(64)", "nullable": False}
+                ],
+            }
+        ],
+        "create": [],
+        "reuse": [
+            {
+                "file": "olist_orders_dataset.csv",
+                "ods_table": "ods_olist_orders_dataset",
+                "row_count": 99441,
+                "columns": 8,
+            }
+        ],
+        "existing_tables_count": 1,
+        "greenfield": False,
+    }
+    monkeypatch.setattr(
+        plan_mod.discovery, "snapshot", lambda *args, **kwargs: snapshot
+    )
+    args = SimpleNamespace(
+        tier="L3",
+        text="",
+        plan_id="plan_reuse_l3",
+        csv_dir="D:/olist",
+        files="",
+        sample_rows=200,
+        spec_file=str(spec_file),
+        name="",
+        purpose="",
+        dry_run=True,
+        include_reuse=False,
+    )
+
+    plan_mod.action_plan(args)
+
+    result = json.loads(capsys.readouterr().out)
+    assert result["ok"] is True
+    assert result["plan"]["tables"] == [
+        table for table in result["plan"]["tables"] if table["layer"] != "ODS"
+    ]
+    assert [table["table_name"] for table in result["plan"]["tables"]] == [
+        "olist.dwd_order"
+    ]
+    assert result["reuse_skipped"] == snapshot["reuse"]
