+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** BI看板主 shell：左侧栏导航 + 右侧内容区域。 */
+
+import { useEffect } from 'react';
+import { useDashboardStore } from './store/dashboardStore';
+import { useDashboardRoute } from '../../multi-session/routing/useDashboardRoute';
+import '../_shared/ui/shell.css';
+import { DashboardListPage } from './components/DashboardListPage';
+import { DashboardViewPage } from './components/DashboardViewPage';
+import { DimensionListPage } from './components/DimensionListPage';
+import { TermListPage } from './components/TermListPage';
+
+type Page = 'dashboards' | 'dimensions' | 'terms';
+
+const nav: [Page, string][] = [
+  ['dashboards', '看板'],
+  ['dimensions', '维度定义'],
+  ['terms', '业务术语'],
+];
+
+export function DashboardApp() {
+  const { route, navigate } = useDashboardRoute();
+  const page = route.page;
+  const store = useDashboardStore();
+
+  useEffect(() => {
+    if (page === 'dashboards') void store.loadDashboards();
+  }, [page, store.loadDashboards]);
+
+  useEffect(() => {
+    if (page === 'dimensions') void store.loadDimensions();
+  }, [page, store.loadDimensions]);
+
+  useEffect(() => {
+    if (page === 'terms') void store.loadTerms();
+  }, [page, store.loadTerms]);
+
+  useEffect(() => {
+    if (page !== 'dashboards') return;
+    const urlId = route.dashboardId;
+    const curId = store.selectedDashboardId;
+    if (urlId && urlId !== curId) {
+      void store.selectDashboard(urlId);
+    }
+  }, [page, route.dashboardId, store.selectedDashboardId, store.selectDashboard]);
+
+  const renderPage = () => {
+    if (page === 'dashboards') {
+      return store.selectedDashboardId && store.currentDashboard
+        ? <DashboardViewPage />
+        : <DashboardListPage />;
+    }
+    if (page === 'dimensions') return <DimensionListPage />;
+    if (page === 'terms') return <TermListPage />;
+    return null;
+  };
+
+  return (
+    <div className="flex h-full w-full bg-bg text-text">
+      {/* 左侧栏：统一外壳骨架（.dw-side，与其他数仓模块一致） */}
+      <aside className="dw-side">
+        <div className="flex items-center gap-2.5">
+          <span className="inline-flex items-center gap-1" aria-hidden="true">
+            <i className="h-2 w-2 rounded-[2px] bg-accent" />
+            <i className="h-2 w-2 rounded-[2px] bg-accent opacity-60" />
+          </span>
+          <h1>BI看板</h1>
+        </div>
+        <nav className="dw-nav" aria-label="看板导航">
+          {nav.map(([p, label]) => (
+            <button
+              key={p}
+              className="dw-nav-item"
+              aria-current={page === p && !(p === 'dashboards' && store.selectedDashboardId) ? 'page' : undefined}
+              onClick={() => {
+                navigate(p);
+                if (p === 'dashboards' && store.selectedDashboardId) {
+                  void store.selectDashboard('');
+                }
+              }}
+            >
+              {label}
+            </button>
+          ))}
+        </nav>
+        {store.error && (
+          <div className="mt-2 rounded border border-warn bg-warn-subtle px-2 py-1 text-xs text-warn">
+            {store.error}
+            <button className="ml-1 underline" onClick={store.clearError}>关闭</button>
+          </div>
+        )}
+      </aside>
+
+      {/* 右侧内容：.dw-content 统一大屏留白/小屏最小侧距（与其他数仓模块同口径） */}
+      <main className="min-w-0 flex-1 overflow-auto">
+        <div className="dw-content">
+          {store.loading && (
+            <div className="mb-4 flex items-center gap-2 text-xs text-text-muted">
+              <span className="inline-block h-3 w-3 animate-spin rounded-full border-2 border-accent border-t-transparent" />
+              加载中…
+            </div>
+          )}
+          {renderPage()}
+        </div>
+      </main>
+    </div>
+  );
+}
