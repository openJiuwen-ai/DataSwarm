@@ -0,0 +1,46 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics LLM 客户端必须尊重配置的 client_provider（第二轮重构台账 A-2）。
+
+`load_llm_config` 把 ``client_provider`` 作为网关协议选择器（Anthropic
+/v1/messages 或 OpenAI /v1/chat/completions）读出，`_get_model` 却曾写死
+``"OpenAI"``——配 Anthropic 协议的网关下 explore 兜底必然失败且被降级
+契约吞成静默。正确实现对照 knowledge/extraction_llm.py 的协议映射。
+"""
+from jiuwenswarm.channels.web.dataagent.metrics import llm
+
+
+def _install_stubs(monkeypatch):
+    """替换 openjiuwen 构造符号，记录 ModelClientConfig 收到的参数。"""
+    recorded: dict = {}
+
+    def _client_config(**kwargs):
+        recorded.update(kwargs)
+
+    class _Model:
+        def __init__(self, model_client_config=None, model_config=None):
+            recorded["constructed"] = True
+
+    monkeypatch.setattr(llm, "LLM_AVAILABLE", True)
+    monkeypatch.setattr(llm, "load_llm_config", lambda path=None: {})
+    monkeypatch.setattr(llm, "ModelClientConfig", _client_config)
+    monkeypatch.setattr(llm, "ModelRequestConfig", lambda **kw: None)
+    monkeypatch.setattr(llm, "Model", _Model)
+    return recorded
+
+
+def test_get_model_passes_configured_provider(monkeypatch):
+    recorded = _install_stubs(monkeypatch)
+    client = llm._LLMClient()
+    client.config = {"model_name": "m", "api_base": "http://gw", "api_key": "k",
+                     "verify_ssl": True, "client_provider": "Anthropic"}
+    client._get_model()
+    assert recorded["client_provider"] == "Anthropic"
+
+
+def test_get_model_defaults_to_openai_when_unset(monkeypatch):
+    recorded = _install_stubs(monkeypatch)
+    client = llm._LLMClient()
+    client.config = {"model_name": "m", "api_base": "http://gw", "api_key": "k",
+                     "verify_ssl": True}
+    client._get_model()
+    assert recorded["client_provider"] == "OpenAI"
diff --git a/tests/unit_tests/web/test_metric_term_binding.py b/tests/unit_tests/web/test_metric_term_binding.py
