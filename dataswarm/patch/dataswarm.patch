+++ b/scripts/legacy-build/build_all.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+# ===========================================================================
+# JiuwenSwarm 全量构建脚本：下载依赖 + 编译前端 + 装后端依赖（Git Bash / WSL）
+#
+# 用法：
+#   ./build_all.sh          全量：装前端依赖 + 编译前端 + 装后端依赖
+#   ./build_all.sh deps     只装依赖（前端 npm ci + 后端 uv sync），不编译
+#   ./build_all.sh web      只编译前端（tsc + vite build）
+#   ./build_all.sh backend  只装后端依赖（uv sync）
+#
+# 前端产物：jiuwenswarm/channels/web/frontend/dist（app_web.py serve 这个）
+# 后端：Python 项目，无独立编译步骤，"编译后端"= uv sync 装依赖到 .venv
+# ===========================================================================
+set -euo pipefail
+
+# 切到项目根（脚本所在目录）
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"  # 脚本在 scripts/, 根在上一级
+cd "$SCRIPT_DIR"
+
+FRONTEND_DIR="jiuwenswarm/channels/web/frontend"
+ACTION="${1:-all}"
+
+# ---------------------------------------------------------------------------
+# 颜色
+# ---------------------------------------------------------------------------
+if [[ -t 1 ]]; then
+  C_RESET="\033[0m"; C_INFO="\033[1;34m"; C_OK="\033[1;32m"
+  C_WARN="\033[1;33m"; C_ERR="\033[1;31m"
+else
+  C_RESET=""; C_INFO=""; C_OK=""; C_WARN=""; C_ERR=""
+fi
+
+log()   { echo -e "${C_INFO}[*]${C_RESET} $1"; }
+ok()    { echo -e "${C_OK}[v]${C_RESET} $1"; }
+warn()  { echo -e "${C_WARN}[!]${C_RESET} $1"; }
+err()   { echo -e "${C_ERR}[x]${C_RESET} $1"; }
+
+# ---------------------------------------------------------------------------
+# 前置检查
+# ---------------------------------------------------------------------------
+if ! command -v uv >/dev/null 2>&1; then
+  err "未找到 uv，请先安装 uv（https://docs.astral.sh/uv/）"
+  exit 1
+fi
+if ! command -v npm >/dev/null 2>&1; then
+  err "未找到 npm，请先安装 Node.js"
+  exit 1
+fi
+
+# ---------------------------------------------------------------------------
+# 装前端依赖
+# ---------------------------------------------------------------------------
+install_frontend() {
+  if [[ ! -d "$FRONTEND_DIR" ]]; then
+    err "前端目录不存在: $FRONTEND_DIR"
+    exit 1
+  fi
+  log "装前端依赖（npm ci）..."
+  (cd "$FRONTEND_DIR" && npm ci)
+  ok "前端依赖装完"
+}
+
+# ---------------------------------------------------------------------------
+# 编译前端
+# ---------------------------------------------------------------------------
+build_frontend() {
+  log "编译前端（tsc + vite build）..."
+  # prebuild 会自动生成 agent 文件夹；build = tsc 类型检查 + vite 打包
+  if (cd "$FRONTEND_DIR" && npm run build); then
+    local size
+    size=$(du -sh "$FRONTEND_DIR/dist" 2>/dev/null | cut -f1 || echo "?")
+    ok "前端构建成功，dist 体积: $size"
+  else
+    err "前端构建失败，请检查上方报错"
+    exit 1
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# 装后端依赖
+# ---------------------------------------------------------------------------
+install_backend() {
+  log "装后端依赖（uv sync）..."
+  # uv sync 按 uv.lock 装依赖到 .venv，与 restart.sh 的 uv run 一致
+  if uv sync; then
+    ok "后端依赖装完"
+  else
+    err "后端依赖装失败"
+    exit 1
+  fi
+}
+
+# ---------------------------------------------------------------------------
+# 分发
+# ---------------------------------------------------------------------------
+case "$ACTION" in
+  all)
+    log "=== 全量构建 ==="
+    install_frontend
+    echo
+    build_frontend
+    echo
+    install_backend
+    echo
+    ok "全量构建完成"
+    log "重启服务生效: ./restart.sh restart"
+    ;;
+  deps)
+    install_frontend
+    echo
+    install_backend
+    ;;
+  web)
+    build_frontend
+    ;;
+  backend)
+    install_backend
+    ;;
+  *)
+    echo "用法: ./build_all.sh [all|deps|web|backend]"
+    echo "  all      全量（装前端依赖 + 编译前端 + 装后端依赖，默认）"
+    echo "  deps     只装依赖（前端 npm ci + 后端 uv sync）"
+    echo "  web      只编译前端（tsc + vite build）"
+    echo "  backend  只装后端依赖（uv sync）"
+    exit 1
+    ;;
+esac
