+
+
+check("D1", "写/导出操作被拒", d_write_rejected)
+check("D2", "多语句与方言", d_multi_statement_and_dialect)
+check("D3", "能力与截断", d_capability_and_truncation)
+check("D4", "远端文件数上限", d_file_count_limit)
+check("D5", "缓存配额与 TTL", d_cache_quota_and_ttl)
+check("D6", "运行期拒绝路径穿越", d_path_traversal_refused_at_runtime)
+
+blocked("D7", "Kerberos 与 HA",
+        "真连的是单 NameNode + 简单认证（user.name 代理用户）。"
+        "Kerberos/SPNEGO 已在方案中列为本期不做；HA NameNode（nameservice "
+        "逻辑名 + failover）、Hadoop 2 的 50070 端口形态、HTTPS(swebhdfs) 均未覆盖。")
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\nhdfs 四道门通过（真连 Hadoop 3.3.6 伪分布式；边界见阻断项）")
