@@ -0,0 +1,38 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useState } from 'react';
+import {
+  dataManagementRoutePath,
+  parseDataManagementRoute,
+  type DataManagementPage,
+  type DataManagementRoute,
+} from './route';
+
+export function useDataManagementRoute() {
+  const [route, setRoute] = useState<DataManagementRoute>(() =>
+    parseDataManagementRoute(`${window.location.pathname}${window.location.search}`) ??
+    { kind: 'data-management', page: 'tables' },
+  );
+  useEffect(() => {
+    const onPopState = () =>
+      setRoute(
+        parseDataManagementRoute(`${window.location.pathname}${window.location.search}`) ??
+          { kind: 'data-management', page: 'tables' },
+      );
+    window.addEventListener('popstate', onPopState);
+    return () => window.removeEventListener('popstate', onPopState);
+  }, []);
+  const navigate = useCallback(
+    (page: DataManagementPage, opts?: { db?: string; table?: string }) => {
+      const next: DataManagementRoute = {
+        kind: 'data-management',
+        page,
+        db: opts?.db ?? route.db,
+        table: opts?.table ?? route.table,
+      };
+      window.history.pushState(null, '', dataManagementRoutePath(next));
+      setRoute(next);
+    },
+    [route.db, route.table],
+  );
+  return { route, navigate };
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/multi-session/routing/useGovernanceRoute.ts b/jiuwenswarm/channels/web/frontend/src/multi-session/routing/useGovernanceRoute.ts
