+    return () => { cancelled = true; };
+  }, [catalogSourceId, bindingTable, isEdit]);
+
+  const title = mode === 'create' ? t('biMetrics.form.createTitle')
+    : mode === 'revision'
+      ? t('biMetrics.form.revisionTitle', { name: metric?.name ?? metricKey })
+      : t('biMetrics.form.editTitle');
+
+  const toggleGrain = (grain: string) => {
+    setTimeGrains((prev) => prev.includes(grain)
+      ? prev.filter((item) => item !== grain) : [...prev, grain]);
+  };
+
+  const buildBinding = (): V2BindingDraft | undefined => {
+    const alias = bindingAlias.trim();
+    const table = bindingTable.trim();
