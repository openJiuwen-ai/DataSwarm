+    hintKey: 'biMetrics.form.types.derived.hint',
+  },
+  {
+    value: 'ratio',
+    labelKey: 'biMetrics.form.types.ratio.label',
+    hintKey: 'biMetrics.form.types.ratio.hint',
+  },
+];
+
+const TIME_GRAINS = ['day', 'week', 'month', 'year'];
+const UNIT_OPTIONS = ['CNY', 'CNY/order', '元', '%', '单', '人', '次'];
+const EMPTY_VALUES: string[] = [];
+
+/** 'schema.table' → ['schema', 'table']；裸表名 → ['', name]。 */
+function splitTableRef(ref: string): [string, string] {
+  const index = ref.lastIndexOf('.');
+  return index > 0 ? [ref.slice(0, index), ref.slice(index + 1)] : ['', ref];
+}
+
+interface MetricFormDrawerProps {
+  /** 显隐开关：组件由父级常挂载，关闭不卸载——create 模式已写内容保留为缓存（防误触丢失） */
+  open: boolean;
+  mode: MetricFormMode;
+  metric?: V2MetricListItem | null;
+  /** 新建修订时用于预填当前修订口径与绑定 */
+  detail?: V2MetricDetail | null;
+  onClose: () => void;
+  onSaved: (message: string) => void;
+}
+
+/** 单值下拉：有候选时用 select（预填值不在候选里也补一条），无候选时降级为输入框。 */
+function PickSelect({ value, options, placeholder, onChange }: {
+  value: string;
+  options: string[];
+  placeholder: string;
+  onChange: (value: string) => void;
+}) {
+  const all = value && !options.includes(value) ? [value, ...options] : options;
+  if (!all.length) {
+    return (
+      <input className={inputClass} value={value} placeholder={placeholder}
+             onChange={(e) => onChange(e.target.value)} />
+    );
+  }
+  return (
+    <select className={inputClass} value={value} onChange={(e) => onChange(e.target.value)}>
+      <option value="">{placeholder}</option>
+      {all.map((option) => <option key={option} value={option}>{option}</option>)}
+    </select>
+  );
+}
+
+/** 多值选择：已选项为 chip，可从下拉添加，也可输入自定义值后回车添加。 */
+function MultiPick({ values, options, placeholder, onChange }: {
+  values: string[];
+  options: string[];
+  placeholder: string;
+  onChange: (next: string[]) => void;
+}) {
+  const { t } = useTranslation();
+  const [draft, setDraft] = useState('');
+  const add = (raw: string) => {
+    const value = raw.trim();
+    if (value && !values.includes(value)) onChange([...values, value]);
+  };
+  return (
+    <div className="space-y-1.5">
+      <div className="flex flex-wrap gap-1">
+        {values.map((value) => (
+          <span key={value}
+                className="inline-flex items-center gap-1 rounded bg-accent-subtle px-2 py-0.5 text-xs text-text-link">
+            {value}
+            <button type="button" className="opacity-60 hover:opacity-100"
+                    onClick={() => onChange(values.filter((item) => item !== value))}>
+              ×
+            </button>
+          </span>
+        ))}
+        {values.length === 0 && <span className="text-xs text-text-muted">{t('biMetrics.form.noneSelected')}</span>}
+      </div>
+      <div className="flex gap-2">
+        {options.length > 0 && (
+          <select className={inputClass} value=""
+                  onChange={(e) => add(e.target.value)}>
+            <option value="">{placeholder}</option>
+            {options.filter((option) => !values.includes(option))
+              .map((option) => <option key={option} value={option}>{option}</option>)}
+          </select>
+        )}
+        <input className={`${inputClass} ${options.length ? 'max-w-48' : ''}`}
+               value={draft}
+               placeholder={options.length ? t('biMetrics.form.customEnter') : t('biMetrics.form.inputEnter')}
+               onChange={(e) => setDraft(e.target.value)}
+               onKeyDown={(e) => {
+                 if (e.key === 'Enter') {
+                   e.preventDefault();
+                   add(draft);
+                   setDraft('');
+                 }
+               }} />
+      </div>
+    </div>
+  );
+}
+
+/** 带候选提示的单值输入（单位等允许自由填写的字段）。 */
+function SuggestInput({ value, options, listId, placeholder, onChange }: {
+  value: string;
+  options: string[];
+  listId: string;
+  placeholder: string;
+  onChange: (value: string) => void;
+}) {
+  return (
+    <>
+      <input className={inputClass} list={listId} value={value} placeholder={placeholder}
+             onChange={(e) => onChange(e.target.value)} />
+      <datalist id={listId}>
+        {options.map((option) => <option key={option} value={option} />)}
+      </datalist>
+    </>
+  );
+}
+
+export function MetricFormDrawer({ open, mode, metric, detail, onClose, onSaved }: MetricFormDrawerProps) {
+  const { t } = useTranslation();
+  const isEdit = mode === 'edit';
+  const latest = mode === 'revision' ? detail?.revisions[0] : undefined;
+  const latestBinding = latest?.bindings?.[0];
+
+  const [metricKey, setMetricKey] = useState(metric?.metric_key ?? '');
+  const [name, setName] = useState(metric?.name ?? '');
+  const [description, setDescription] = useState(metric?.description ?? '');
+  const [owner, setOwner] = useState(metric?.owner ?? '');
+
+  const [metricType, setMetricType] = useState(latest?.metric_type ?? 'atomic');
+  const [expression, setExpression] = useState(latest?.expression_sql ?? '');
+  const [unit, setUnit] = useState(latest?.unit ?? '');
+  const [synonyms, setSynonyms] = useState(joinList(latest?.synonyms));
+  const [timeDimension, setTimeDimension] = useState(latest?.time_dimension ?? '');
+  const [allowedDimensions, setAllowedDimensions] = useState<string[]>(latest?.allowed_dimensions ?? []);
+  const [timeGrains, setTimeGrains] = useState<string[]>(latest?.time_grains ?? []);
+  const [dependencies, setDependencies] = useState<string[]>(latest?.dependencies ?? []);
+  const [zeroDenominator, setZeroDenominator] = useState(latest?.zero_denominator ?? '');
+
+  const [bindingAlias, setBindingAlias] = useState(
+    latestBinding?.datasource_alias || latestBinding?.datasource_ref || '');
