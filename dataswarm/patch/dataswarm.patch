+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.knowledge.extraction_llm import (
+    ExtractionLLMError, ExtractionLLMProvider, build_default_provider,
+)
+from jiuwenswarm.channels.web.dataagent.knowledge import documents
+from pydantic import BaseModel, Field
+
+
+class _Asset(BaseModel):
+    title: str
+
+
+class _Result(BaseModel):
+    assets: list[_Asset] = Field(default_factory=list)
+
+
+class _FakeAnthropic:
+    def __init__(self, replies: list[list[SimpleNamespace]]):
+        self._replies = list(replies)
+        self.calls: list[dict] = []
+
+    @property
+    def messages(self):
+        return self
+
+    def create(self, **kwargs):
+        self.calls.append(kwargs)
+        return SimpleNamespace(content=self._replies.pop(0))
+
+
+def _text_block(text: str) -> SimpleNamespace:
+    return SimpleNamespace(type="text", text=text)
+
+
+def _thinking(text: str) -> SimpleNamespace:
+    return SimpleNamespace(type="thinking", text=text)
+
+
+def test_anthropic_protocol_filters_thinking_blocks():
+    client = _FakeAnthropic([[_thinking("reasoning..."), _text_block('{"assets": [{"title": "退款口径"}]}')]])
+    provider = ExtractionLLMProvider(model="m", api_key="k", api_base="http://gw/", protocol="anthropic", client=client)
+    result = provider.generate_typed("prompt", _Result, temperature=0, max_retries=1)
+    assert result.assets[0].title == "退款口径"
+    # Anthropic 协议必填 max_tokens：缺省回退 8192（Semantica 同款约定）
+    assert provider.max_tokens is None and client.calls[0]["max_tokens"] == 8192
+
+
+def test_reasoning_only_truncation_is_recorded_and_not_retried():
+    client = _FakeAnthropic([
+        [_thinking("long hidden reasoning")],
+        [_text_block('{"assets": [{"title": "支付日期"}]}')],
+    ])
+    # Attach the provider stop reason used by Anthropic when the completion cap
+    # is consumed before a text block is emitted.
+    original_create = client.create
+
+    def create(**kwargs):
+        response = original_create(**kwargs)
+        response.stop_reason = "max_tokens" if len(client.calls) == 1 else "end_turn"
+        return response
+    client.create = create
+    provider = ExtractionLLMProvider(model="m", api_key="k", api_base="http://gw/",
+                                     protocol="anthropic", client=client)
+    with pytest.raises(ExtractionLLMError) as excinfo:
+        provider.generate_typed("prompt", _Result, max_retries=2)
+    assert "output truncated" in str(excinfo.value)
+    assert provider.last_completion.truncated is True
+    assert len(client.calls) == 1  # 截断不进重试循环；拆批重试由 _extract_batch_with_split 承担
+
+
+def test_disable_thinking_opt_in_injects_and_falls_back_on_rejection():
+    """显式 opt-in 才注入禁思考参数；网关 400/422 拒收时剥掉参数重发一次。"""
+    client = _FakeAnthropic([[_text_block('{"assets": [{"title": "支付日期"}]}')],
+                             [_text_block('{"assets": [{"title": "回退"}]}')]])
+    original_create = client.create
+
+    def create(**kwargs):
+        response = original_create(**kwargs)
+        response.stop_reason = "end_turn"
+        return response
+    client.create = create
+    provider = ExtractionLLMProvider(model="m", api_key="k", api_base="http://gw/",
+                                     protocol="anthropic", client=client, disable_thinking=True)
+    provider._reasoning_kwargs = lambda: {"thinking": {"type": "disabled"}}
+    provider.generate_typed("p", _Result)
+    assert client.calls[0]["thinking"] == {"type": "disabled"}
+
+    class _Rejecting:
+        def __init__(self, inner):
+            self._inner, self.calls = inner, []
+
+        @property
+        def messages(self):
+            return self
+
+        def create(self, **kwargs):
+            self.calls.append(kwargs)
+            if "thinking" in kwargs:
+                class _Reject(Exception):
+                    status_code = 400
+                raise _Reject("unexpected field: thinking")
+            response = SimpleNamespace(content=[_text_block('{"assets": []}')], stop_reason="end_turn")
+            return response
+
+    rejecting = _Rejecting(client)
+    provider2 = ExtractionLLMProvider(model="m", api_key="k", api_base="http://gw/",
+                                      protocol="anthropic", client=rejecting, disable_thinking=True)
+    provider2._reasoning_kwargs = lambda: {"thinking": {"type": "disabled"}}
+    provider2.generate_typed("p", _Result)
+    assert "thinking" in rejecting.calls[0] and "thinking" not in rejecting.calls[1]
+
+
+def test_default_provider_disables_thinking(monkeypatch):
