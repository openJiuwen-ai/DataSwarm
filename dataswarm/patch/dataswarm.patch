+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Read-only, credential-safe local datasource prerequisites inventory.
+
+Run with the project's Python interpreter. Prints JSON; does not install, start,
+stop, create, or connect to a database. Only localhost TCP reachability is probed.
+Environment variable NAMES are reported, never their values or credential files.
+Availability of a runtime/SDK/port is not successful datasource acceptance.
+"""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+import importlib.util
+import json
+import os
+import platform
+import shutil
+import socket
+import subprocess
+import sys
+
+COMMANDS = ("docker", "wsl", "sqllocaldb", "sqlcmd", "redis-server")
+MODULES = ("pyodbc", "pymysql", "psycopg", "pymongo", "redis", "happybase")
+PORTS = {"sqlserver_default": 1433,
+         "postgresql_acceptance": 55432, "mongodb_acceptance": 27018,
+         "ftp_acceptance": 2121, "s3_acceptance": 8333, "redis_acceptance": 6380,
+         "hbase_thrift_acceptance": 9090, "hdfs_namenode_acceptance": 9870}
+
+
+def run_readonly(command: list[str], *, utf16: bool = False) -> dict:
+    try:
+        proc = subprocess.run(command, capture_output=True, timeout=20)
+        output = proc.stdout + proc.stderr
+        # wsl.exe outputs UTF-16LE when redirected on Windows, even without a BOM.
+        encoding = "utf-16le" if utf16 and b"\0" in output else "utf-8"
+        return {"exit_code": proc.returncode, "output": output.decode(encoding, errors="replace").strip()}
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return {"exit_code": None, "error_type": type(exc).__name__}
+
+
+def inventory() -> dict:
+    commands = {name: bool(shutil.which(name)) for name in COMMANDS}
+    modules = {}
+    for module in MODULES:
+        try:
+            modules[module] = importlib.util.find_spec(module) is not None
+        except (ImportError, ValueError):
+            modules[module] = False
+    ports = {}
+    for name, port in PORTS.items():
+        try:
+            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
+                reachable = True
+        except OSError:
+            reachable = False
+        ports[name] = {"port": port, "tcp_reachable": reachable}
+    result = {
+        "checked_at_utc": datetime.now(timezone.utc).isoformat(),
+        "platform": platform.system(), "python": platform.python_version(),
+        "commands_on_path": commands, "python_modules": modules,
+        "localhost_ports": ports,
+        "configured_environment_names": sorted(name for name in os.environ
+            if name.startswith(("MSSQL_", "SQLSERVER_", "POSTGRES_", "DSA_PG_", "REDIS_", "FTP_", "WEBHDFS_"))),
+        "notes": ["Port reachability does not identify the service or prove authentication.",
+                  "Credential files and environment values were not read.",
+                  "SQL Server LocalDB uses local named pipes; no port 1433 is expected."],
+    }
+    if platform.system() == "Windows":
+        script = r"""
+[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
+$ErrorActionPreference = 'Stop'
+$os = Get-CimInstance Win32_OperatingSystem
+$report = [ordered]@{
+    os_caption = $os.Caption
+    memory_gib = [math]::Round($os.TotalVisibleMemorySize/1MB,2)
+    free_memory_gib = [math]::Round($os.FreePhysicalMemory/1MB,2)
+    services = @(Get-CimInstance Win32_Service | Where-Object { $_.Name -match 'MSSQL|SQLBrowser|docker|Lxss|Wsl' } | Select-Object Name,State)
+    disks = @(Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | Select-Object DeviceID,@{n='free_gib';e={[math]::Round($_.FreeSpace/1GB,2)}})
+    database_odbc_drivers = @(Get-OdbcDriver | Where-Object {$_.Name -match 'SQL Server'} | Select-Object Name,Platform)
+}
+$report | ConvertTo-Json -Depth 5 -Compress
+"""
+        powershell = run_readonly(["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script])
+        if powershell["exit_code"] == 0:
+            try:
+                result["windows"] = json.loads(powershell["output"])
+            except json.JSONDecodeError:
+                result["windows"] = {"error": "unexpected_inventory_output"}
+        else:
+            result["windows"] = {"exit_code": powershell["exit_code"], "error": "inventory_command_failed"}
+        if commands["wsl"]:
+            result["wsl_list"] = run_readonly(["wsl.exe", "--list", "--quiet"], utf16=True)
+        if commands["sqllocaldb"]:
+            result["localdb_versions"] = run_readonly(["sqllocaldb", "versions"])
+            result["localdb_instances"] = run_readonly(["sqllocaldb", "info"])
+    return result
+
+
+if __name__ == "__main__":
+    sys.stdout.reconfigure(encoding="utf-8")
+    print(json.dumps(inventory(), ensure_ascii=False, indent=2))
