+    def delete_workflow(self, wid):
+        return self.workflows.pop(wid, None) is not None
+
+    def list_workflows(self, status=None, q=None, limit=100, offset=0):
+        return list(self.workflows.values())
+
+    def set_workflow_status(self, wid, status, enabled=None):
+        if wid not in self.workflows:
+            return None
+        self.workflows[wid]["status"] = status
+        if enabled is not None:
+            self.workflows[wid]["enabled"] = enabled
+        return self.workflows[wid]
+
+    def list_nodes(self, wid):
+        return self.workflows.get(wid, {}).get("nodes", [])
+
+    def replace_nodes(self, wid, nodes):
+        if wid in self.workflows:
+            self.workflows[wid]["nodes"] = nodes
+        return nodes
+
+    def add_node(self, wid, node):
+        if wid in self.workflows:
+            self.workflows.setdefault("nodes", []).append(node)
