+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""EMB 向量召回通道测试（增补设计 D3）。
+
+网络红线：全部用例注入**确定性向量桩**，不打真实嵌入端点（conftest 的
+``_emb_off_by_default`` 已默认关通道，本文件的 ``emb_on`` 显式开启并打桩）。
+
+桩不是随机向量而是**语义轴单位向量**——随机向量与任何查询的余弦都在 floor
+以下，什么都测不到。语义轴模拟真实嵌入模型的跨语种能力：词面不同
+（``channel`` vs ``渠道``）但语义相近 → 余弦高。这样才能验证「字面零命中、
+EMB 单独把候选顶过 0.60 阈值」这条 D3 的核心主张。
+"""
+from __future__ import annotations
+
+import dataclasses
+import json
+import math
+import os
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import embedding, semantic_link, versioning
+from jiuwenswarm.channels.web.dataagent.metrics.embedding import EmbedOutcome
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, WORKSPACE, write_published_snapshot
+
+GMV = "commerce.gmv"
+PAID_ORDERS = "commerce.paid_order_count"
+
+
+def _semantic_recall_fake(tables_by_question: dict[str, list[dict]]):
+    """FAISS 召回桩：问题 → 固定表级命中（深集成后 S 入口 EMB 走语义层 FAISS）。
+
+    单测不打真实 faiss（Windows OpenBLAS 红线）；桩返回 vector_store.recall
+    的输出结构，列命中经 semantic_link 的快照索引还原成稳定 node_id。
+    """
+    from jiuwenswarm.channels.web.dataagent.semantic import vector_store
+
+    def _recall(workspace_id: str, source_id: str, question: str, *, limit: int = 20):
+        tables = tables_by_question.get(question, [])
+        return {"tables": [dict(t) for t in tables], "query_vectors": [], "warnings": []}
+
+    return _recall, vector_store
+
+
+def _spec_json(metric: str) -> str:
+    """意图解析层的桩响应：按地区汇总的 QuerySpec。"""
+    return json.dumps({
+        "spec": {"metrics": [metric], "group_by": ["orders.region"],
+                 "time": {"dimension": "orders.paid_at", "start": "2026-08-01",
+                          "end_exclusive": "2026-09-01"}},
+        "clarifications": []})
+
+# 语义轴 → 别名。别名覆盖中英文两侧，模拟 bge-m3 的跨语种对齐能力。
+# 别名要**足够具体**：曾用裸 "order" 做「订单」轴别名，结果 "orders.channel"
+# 里的子串 order 让每条列文档都多吃一个轴，余弦被稀释到 0.707（校准后 0.59，
+# 差 0.01 不过阈值）——真实嵌入按概念对齐，不会这么字面。
+_AXES: dict[str, tuple[str, ...]] = {
+    "渠道": ("渠道", "channel", "通路"),
+    "金额": ("金额", "amount", "钱", "成交额", "gmv"),
+    "客单价": ("客单价", "aov", "平均每单"),
+    "地区": ("地区", "region", "区域"),
+    "时间": ("时间", "paid_at", "日期", "月份"),
+    "状态": ("状态", "pay_status"),
+    "订单": ("订单", "order_count", "单量", "笔数", "下单", "几单"),
+}
+_AXIS_ORDER = sorted(_AXES)
+
+
+def _axis_vector(text: str) -> tuple[float, ...]:
+    """文本 → 语义轴单位向量（无命中则零向量）。"""
+    low = text.lower()
+    hits = {ax for ax in _AXIS_ORDER if any(a in low for a in _AXES[ax])}
+    if not hits:
+        return tuple(0.0 for _ in _AXIS_ORDER)
+    weight = 1.0 / math.sqrt(len(hits))
+    return tuple(weight if ax in hits else 0.0 for ax in _AXIS_ORDER)
+
+
+class _FakeEmbed:
+    """确定性嵌入桩，记录调用文本以便断言缓存复用。"""
+
+    def __init__(self, error: str = "") -> None:
+        self.error = error
+        self.texts: list[str] = []
+
+    def __call__(self, texts, *, timeout_s: int = 20) -> EmbedOutcome:
+        batch = list(texts)
+        self.texts.extend(batch)
+        if self.error:
+            return EmbedOutcome(error=self.error)
+        # texts 必须回带（与真实 embed_texts 同契约）：多向量归因靠它
+        return EmbedOutcome(vectors=tuple(_axis_vector(t) for t in batch),
+                            model="fake-emb", dims=len(_AXIS_ORDER),
+                            texts=tuple(batch))
+
+    @property
+    def calls(self) -> int:
+        return len(self.texts)
+
+
+@pytest.fixture
+def emb_on(monkeypatch, tmp_path):
+    """开启 EMB 通道并注入向量桩；缓存目录钉在 tmp（绝不写真实 home）。
+
+    Returns:
+        ``_FakeEmbed`` 实例（可断言嵌入了哪些文本）。
+    """
+    fake = _FakeEmbed()
+    monkeypatch.setenv("DATASWARM_METRICS_EMB_ENABLED", "true")
+    monkeypatch.setenv("DATASWARM_METRICS_EMB_DIR", str(tmp_path / "emb-root"))
+    monkeypatch.setattr(embedding, "emb_available", lambda: True)
+    monkeypatch.setattr(embedding, "emb_model", lambda: "fake-emb")
+    monkeypatch.setattr(embedding, "embed_texts", fake)
+    # 进程内 memo 是模块级状态，且 demo 的 snapshot_id 是内容哈希（各测试相同）
+    # → 不清就会跨测试命中，让「缓存文件已写出」这类断言空过
+    embedding._INDEX_MEMO.clear()
+    # 问句向量缓存同理（F-048 ①）：不清则同问句测试吃到前一个测试的缓存
+    embedding._QUERY_VEC_CACHE.clear()
+    yield fake
+    embedding._INDEX_MEMO.clear()
+    embedding._QUERY_VEC_CACHE.clear()
+
+
+def _publish(e2e, extra_column: str | None = None):
+    """导入 + 确认候选映射 + 发布（可选先给业务库加一列无指标绑定的列）。"""
+    if extra_column:
+        import sqlite3
+
+        with sqlite3.connect(str(e2e["tmp_path"] / "business.db")) as conn:
+            conn.execute(f"ALTER TABLE orders ADD COLUMN {extra_column} TEXT")
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="emb-test")
+    write_published_snapshot(e2e)
+    versioning.publish_release(WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+                               label="emb", published_by="t")
+    return store.get_active_release(WORKSPACE).release_id
+
+
+# ==========================================================================
+# 校准：常量必须钉住实测锚点
+# ==========================================================================
+def test_calibrate_uses_measured_anchors(monkeypatch):
+    """校准映射钉住实测分布：off-topic 归零、强命中越过 0.60 阈值。
+
+    锚点来自真实 bge-m3 实测（模块 docstring 表）：裸列名语料的 off-topic
+    上界 0.478 必须归零，富语料强命中 0.712 必须 ≥0.60 才能单独触发路由。
+    """
+    monkeypatch.delenv(embedding.EMB_FLOOR_ENV, raising=False)
+    monkeypatch.delenv(embedding.EMB_CEIL_ENV, raising=False)
+    assert embedding.calibrate(0.478) == 0.0, "off-topic 上界必须归零"
+    assert embedding.calibrate(0.417) == 0.0
+    assert embedding.calibrate(0.50) == 0.0
+    assert embedding.calibrate(0.712) == pytest.approx(0.606, abs=0.01)
+    assert embedding.calibrate(0.787) == pytest.approx(0.82, abs=0.01)
+    assert embedding.calibrate(0.85) == 1.0
+    assert embedding.calibrate(0.99) == 1.0, "上界封顶"
+    # 单调不减
+    samples = [embedding.calibrate(x / 100) for x in range(30, 100)]
+    assert samples == sorted(samples)
+
+
+def test_calibrate_bounds_overridable_by_env(monkeypatch):
+    """换模型后可用 env 重设 floor/ceil，不必改代码；非法值退回默认。"""
+    monkeypatch.setenv(embedding.EMB_FLOOR_ENV, "0.30")
+    monkeypatch.setenv(embedding.EMB_CEIL_ENV, "0.70")
+    assert embedding.calibrate(0.30) == 0.0
+    assert embedding.calibrate(0.50) == pytest.approx(0.5)
+    assert embedding.calibrate(0.70) == 1.0
+
+    monkeypatch.setenv(embedding.EMB_FLOOR_ENV, "不是数字")
+    assert embedding.calibrate(0.30) == 0.0, "非法 floor 必须退回默认而不是崩"
+
+
+def test_calibrate_degenerate_bounds_return_zero(monkeypatch):
+    """floor ≥ ceil（误配）→ 一律 0 分，绝不放大成 1.0 污染召回。"""
+    monkeypatch.setenv(embedding.EMB_FLOOR_ENV, "0.9")
+    monkeypatch.setenv(embedding.EMB_CEIL_ENV, "0.5")
+    assert embedding.calibrate(0.95) == 0.0
+    assert embedding.calibrate(0.7) == 0.0
+
+
+# ==========================================================================
+# 降级：未配置 / 调用失败都只关通道，不阻断召回
+# ==========================================================================
+def test_emb_disabled_records_unavailable_and_still_recalls(e2e):
+    """通道关闭（conftest 默认）→ schema 侧记 unavailable，指标词法照常。"""
+    _publish(e2e)
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    warnings: list[str] = []
+    _refs, snapshots = semantic_link.current_snapshots(warnings)
+    _hits, _confidence = semantic_link.schema_recall(
+        WORKSPACE, "支付成交额", snapshots, warnings=warnings)
+    assert embedding.WARN_UNAVAILABLE in warnings
+    lexical = {m.metric_key for m, _s, _via
+               in store.search_defs(WORKSPACE, "支付成交额")}
+    assert lexical, "词法路必须照常工作"
+    assert GMV in lexical
+
+
+def test_emb_kill_switch_overrides_platform_config(monkeypatch):
+    """``DATASWARM_METRICS_EMB_ENABLED=false`` 优先于平台已配置。"""
+    monkeypatch.setattr(
+        "jiuwenswarm.agents.harness.common.knowledge_base.config.get_embed_config",
+        lambda: {"api_key": "k", "base_url": "https://emb.example/v1", "model": "m"})
+    monkeypatch.setenv("DATASWARM_METRICS_EMB_ENABLED", "false")
+    assert embedding.emb_available() is False
+    monkeypatch.setenv("DATASWARM_METRICS_EMB_ENABLED", "true")
+    assert embedding.emb_available() is True
+
+
+_EMB_VARS = ("EMBED_KEY", "EMBED_API_KEY", "EMBED_BASE", "EMBED_BASE_URL",
+             "EMBED_MODEL", "EMBEDDING_MODEL")
+
+
+def test_embed_settings_prefers_platform_config(monkeypatch):
+    """平台配置齐备时直接用，不去读 .env 文件。"""
+    monkeypatch.setattr(
+        "jiuwenswarm.agents.harness.common.knowledge_base.config.get_embed_config",
+        lambda: {"api_key": "k", "base_url": "https://emb.example/v1", "model": "m"})
+
+    def _boom():
+        raise AssertionError("平台配置齐备时不该读 .env 文件")
+
+    monkeypatch.setattr("jiuwenswarm.common.utils.get_env_file", _boom)
+    assert embedding.embed_settings() == {
+        "api_key": "k", "base_url": "https://emb.example/v1", "model": "m"}
+
+
+def test_embed_settings_falls_back_to_env_file_without_polluting_environ(monkeypatch, tmp_path):
+    """app_web 默认不加载 .env → 占位符解析成空；补读文件三项且不动 os.environ。
+
+    这是实测到的部署形态缺陷：同一份代码在 gateway 进程 EMB 可用、在
+    app_web 进程报 emb_unavailable（``config.yaml`` 的 ``${EMBED_API_BASE}``
+    解析为空）。补读只针对 EMBED_* 三项，绝不写全局环境。
+    """
+    env_file = tmp_path / ".env"
+    env_file.write_text(
+        "EMBED_API_KEY=k-file\nEMBED_API_BASE=https://emb.file/v1\nEMBED_MODEL=file-model\n",
+        encoding="utf-8")
+    monkeypatch.setattr(
+        "jiuwenswarm.agents.harness.common.knowledge_base.config.get_embed_config",
+        lambda: {"api_key": "", "base_url": "", "model": ""})
+    monkeypatch.setattr("jiuwenswarm.common.utils.get_env_file", lambda: env_file)
+    for var in _EMB_VARS:
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.setenv(embedding.EMB_ENABLED_ENV, "true")
+
+    settings = embedding.embed_settings()
+    assert settings == {"api_key": "k-file", "base_url": "https://emb.file/v1",
+                        "model": "file-model"}
+    assert os.environ.get("EMBED_API_KEY") is None, "补读不得写进 os.environ"
+    assert embedding.emb_available() is True
+    assert embedding.emb_model() == "file-model"
