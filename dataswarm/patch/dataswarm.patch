@@ -0,0 +1,407 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/struct_notify.py — 对话侧结构变更事件的推送与落历史.
+
+触发链路（docs/archive/delivered/chat-struct-change-push-plan.md §四）：
+    Agent 对话（bash env 注入 JIUWENSWARM_SESSION_ID）
+      → dwcli（X-Jiuwen-Session-Id header）
+      → orchestration debug 分支 / sql execute_ddl 成功分支
+      → 本模块 emit_workflow_run / emit_table_change
+          ├─ classify_ddl（sqlglot 解析目标表，仅 DDL 成功后调用）
+          ├─ append_history_record（会话历史落盘，重进会话可回看）
+          └─ notify_gateway（HTTP 回调 Gateway 推 WS，best-effort）
+
+一致性规则：
+    - 只在写操作成功提交后 emit；emit 自身任何异常只记日志，不影响业务返回；
+    - 无 session_id（cron/手工 curl）整个 emit 短路：不推送也不落盘
+      （append_history_record 无 sid 会写到 default 会话，是错误行为）；
+    - SQL 解析失败返回空列表 = 不发事件，不猜测表名。
+"""
+
+from __future__ import annotations
+
+import http.client
+import json
+import logging
+import os
+import time
+import uuid
+from typing import Any
+from urllib.parse import urlparse, unquote
+
+from jiuwenswarm.channels.web import timeutil
+
+logger = logging.getLogger(__name__)
+
+_NOTIFY_TIMEOUT_S = 2.0
+_SQL_DIGEST_LIMIT = 200
+_MAX_EVENTS_PER_SESSION = 50  # 前端 store 上限，此处只管 payload 体积
+
+_VALID_REF_TYPES = {"workflow", "task"}
+
+
+def _now_iso() -> str:
+    return timeutil.now_iso()
+
+
+def _new_event_id() -> str:
+    return f"sc-{int(time.time() * 1000)}-{uuid.uuid4().hex[:4]}"
+
+
+# --------------------------------------------------------------------------
+# payload 组装
+# --------------------------------------------------------------------------
+def build_workflow_run_payload(
+    *,
+    session_id: str,
+    instance: dict[str, Any],
+    ref_type: str,
+    name: str,
+) -> dict[str, Any]:
+    """组装 workflow_run 事件 payload（契约见方案 §3.1）。"""
+    return {
+        "schema_version": 1,
+        "event_id": _new_event_id(),
+        "session_id": session_id,
+        "ts": _now_iso(),
+        "kind": "workflow_run",
+        "workflow_run": {
+            "instance_id": str(instance.get("instance_id") or ""),
+            "ref_type": ref_type if ref_type in _VALID_REF_TYPES else "task",
+            "ref_id": str(instance.get("ref_id") or ""),
+            "status": str(instance.get("status") or "queued"),
+            "name": str(name or ""),
+        },
+    }
+
+
+def build_table_change_payload(
+    *,
+    session_id: str,
+    operation: str,
+    db: str,
+    tables: list[str],
+    sql: str,
+    source: str = "dwcli sql ddl",
+) -> dict[str, Any]:
+    """组装 table_change 事件 payload。sql 截断为摘要，不塞完整 DDL。"""
+    digest = " ".join((sql or "").split())
+    if len(digest) > _SQL_DIGEST_LIMIT:
+        digest = f"{digest[:_SQL_DIGEST_LIMIT]}..."
+    return {
+        "schema_version": 1,
+        "event_id": _new_event_id(),
+        "session_id": session_id,
+        "ts": _now_iso(),
+        "kind": "table_change",
+        "table_change": {
+            "operation": operation,
+            "db": db,
+            "tables": tables,
+            "sql_digest": digest,
+            "source": source,
+        },
+    }
+
+
+def build_workflow_change_payload(
+    *,
+    session_id: str,
+    operation: str,
+    workflow_id: str,
+    name: str,
+    node_count: int = 0,
+    source: str = "dwcli workflow",
+) -> dict[str, Any]:
+    """组装 workflow_change 事件 payload（工作流定义级变更：创建/更新/挂节点）.
+
+    node_count 是变更后的节点总数，供事件清单行展示规模；完整定义由前端
+    详情视图按 workflow_id 现拉（事件体不塞 DAG，保持 payload 轻量）。
+    """
+    return {
+        "schema_version": 1,
+        "event_id": _new_event_id(),
+        "session_id": session_id,
+        "ts": _now_iso(),
+        "kind": "workflow_change",
+        "workflow_change": {
+            "operation": str(operation or ""),
+            "workflow_id": str(workflow_id or ""),
+            "name": str(name or ""),
+            "node_count": int(node_count or 0),
+            "source": source,
+        },
+    }
+
+
+# --------------------------------------------------------------------------
+# SQL 分类（sqlglot）
+# --------------------------------------------------------------------------
+_DDL_OP_TABLES = {
+    "create": "CREATE",
+    "alter": "ALTER",
+    "drop": "DROP",
+}
+
+
+def classify_ddl(sql: str) -> list[tuple[str, str]]:
+    """解析 SQL 中的 CREATE/ALTER/DROP TABLE 目标表.
+
+    Returns:
+        [(operation, table_name), ...]，多语句逐条解析；非 DDL（SELECT/INSERT/UPDATE/
+        DELETE 数据变更）或方言解析失败返回空列表——宁缺毋滥，不猜测表名。
+
+    不用正则：注释/字符串里的建表关键词会误报（方案 §4.2）。
+    方言顺序：doris（dw 场景反引号/ENGINE=OLAP 建表，默认方言会退化成 Command）
+    → mysql（反引号超集兜底）→ 默认（无方言标识的 ANSI）。
+    """
+    if not (sql or "").strip():
+        return []
+    try:
+        import sqlglot
+        from sqlglot import expressions as exp
+    except ImportError:
+        logger.warning("[struct-notify] sqlglot 不可用，跳过 DDL 分类")
+        return []
+
+    statements: list[Any] = []
+    parse_errors = 0
+    for dialect in ("doris", "mysql", None):
+        try:
+            statements = [s for s in sqlglot.parse(sql, read=dialect) if s is not None]
+            parse_errors = 0
+            break
+        except Exception:
+            parse_errors += 1
+            continue
+    if parse_errors:
+        # 三种方言都失败：逐句再试，单句失败跳过（混合方言多语句场景）
+        statements = []
+        for single in (sql or "").split(";"):
+            if not single.strip():
+                continue
+            for dialect in ("doris", "mysql", None):
+                try:
+                    statements.extend(s for s in sqlglot.parse(single, read=dialect) if s is not None)
+                    break
+                except Exception as exc:  # noqa: BLE001 —— 方言回退循环的控制流本体
+                    logger.debug("[struct-notify] 单句方言解析失败 dialect=%s: %s", dialect, exc)
+                    continue
+
+    out: list[tuple[str, str]] = []
+    for stmt in statements:
+        op = _DDL_OP_TABLES.get(stmt.key.lower())
+        if op is None:
+            # 方言不支持时 sqlglot 会退化成 Command，key 不在表内 → 视为解析不出
+            continue
+        table = stmt.find(exp.Table)
+        if table is None or not table.name:
+            continue
+        db = table.db or ""
+        table_name = f"{unquote(db)}.{unquote(table.name)}" if db else unquote(table.name)
+        out.append((op, table_name))
+    return out
+
+
+def db_name_from_ref(ref: str) -> str:
+    """db-ref → 裸库名（lineage API 的查询键，两边键要一致）.
+
+    doris://olist_dw → olist_dw；doris://host:9030/db → db；
+    sqlite:///path/x.db → x；裸路径/空串按原样返回（查询侧自行校验）。
+    """
+    text = str(ref or "").strip()
+    if "://" in text:
+        parsed = urlparse(text)
+        path = unquote(parsed.path or "").strip("/")
+        if path:
+            name = path if "/" not in path else path.split("/")[-1]
+            return name[:-3] if name.lower().endswith(".db") else name
+        # doris://dbname（无 host:port，dbname 被解析进 netloc）
+        netloc = parsed.netloc or ""
+        if netloc and ":" not in netloc:
+            return unquote(netloc)
+        return ""
+    if text.lower().endswith(".db"):
+        return text[:-3].replace("\\", "/").split("/")[-1]
+    return text
+
+
+# --------------------------------------------------------------------------
+# 推送 + 落历史
+# --------------------------------------------------------------------------
+def notify_gateway(payload: dict[str, Any]) -> bool:
+    """HTTP 回调 Gateway notify 端点（best-effort）.
+
+    失败（拒绝/超时/Gateway 未起）只记日志不重试不抛出：纯推送链路下丢实时帧
+    可接受，事件已先落 session 历史。
+
+    Returns:
+        是否送达（HTTP 2xx）。
+    """
+    target = (
+        os.environ.get("STRUCT_CHANGE_NOTIFY_URL", "").strip()
+        or _default_notify_url()
+    )
+    parsed = urlparse(target)
+    if parsed.scheme != "http" or not parsed.hostname:
+        logger.warning("[struct-notify] notify URL 非法: %s", target)
+        return False
+    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+    from jiuwenswarm.common.internal_auth import get_struct_change_token
+
+    token = get_struct_change_token()
+    conn = http.client.HTTPConnection(
+        parsed.hostname, parsed.port or 80, timeout=_NOTIFY_TIMEOUT_S,
+    )
+    try:
+        conn.request(
+            "POST",
+            f"{parsed.path or STRUCT_CHANGE_NOTIFY_PATH_DEFAULT}"
+            + (f"?{parsed.query}" if parsed.query else ""),
+            body=body,
+            headers={
+                "Content-Type": "application/json; charset=utf-8",
+                "X-Jiuwen-Struct-Change-Token": token,
+            },
+        )
+        resp = conn.getresponse()
+        resp.read()
+        if 200 <= resp.status < 300:
+            return True
+        logger.warning(
+            "[struct-notify] gateway notify 非 2xx: status=%s session_id=%s",
+            resp.status, payload.get("session_id"),
+        )
+        return False
+    except Exception as exc:
+        logger.warning(
+            "[struct-notify] gateway notify 失败（事件已落历史，不重试）: %s session_id=%s",
+            exc, payload.get("session_id"),
+        )
+        return False
+    finally:
+        conn.close()
+
+
+STRUCT_CHANGE_NOTIFY_PATH_DEFAULT = "/internal/struct-change/notify"
+
+
+def _default_notify_url() -> str:
+    gateway_url = os.environ.get("GATEWAY_URL", "").strip() or "http://127.0.0.1:19000"
+    base = gateway_url.rstrip("/")
+    if base.endswith(STRUCT_CHANGE_NOTIFY_PATH_DEFAULT):
+        return base
+    return f"{base}{STRUCT_CHANGE_NOTIFY_PATH_DEFAULT}"
+
+
+def _append_history(payload: dict[str, Any]) -> None:
+    """事件落会话历史（event_type=chat.struct_change，重进会话可回看）。"""
+    from jiuwenswarm.server.runtime.session.session_history import append_history_record
+
+    append_history_record(
+        session_id=str(payload["session_id"]),
+        request_id=str(payload["event_id"]),
+        channel_id="web",
+        role="assistant",
+        content="",
+        timestamp=time.time(),
+        event_type="chat.struct_change",
+        extra={"struct_change": payload},
+    )
+
+
+def _emit(payload: dict[str, Any]) -> None:
+    """emit 公共收口：无 session 短路 → 落历史 → notify。
+
+    任何异常只记日志（调用方是成功 DDL/debug 的后置钩子，不能反向影响业务返回）。
+    """
+    sid = str(payload.get("session_id") or "").strip()
+    if not sid:
+        logger.debug("[struct-notify] 无 session_id，跳过事件（不推送不落盘）")
+        return
+    if not _session_exists(sid):
+        logger.warning("[struct-notify] session 不存在，拒绝事件: session_id=%s", sid)
+        return
+    try:
+        _append_history(payload)
+    except Exception as exc:
+        logger.warning("[struct-notify] 历史落盘失败: %s session_id=%s", exc, sid)
+    try:
+        notify_gateway(payload)
+    except Exception as exc:  # noqa: BLE001 —— notify_gateway 已兜底，此处防御双重保险
+        logger.warning("[struct-notify] notify 异常: %s session_id=%s", exc, sid)
+
+
+def _session_exists(session_id: str) -> bool:
+    try:
+        from jiuwenswarm.server.runtime.session.session_history import resolve_session_dir
+
+        directory, error = resolve_session_dir(session_id, create=False)
+        return error is None and directory is not None and directory.is_dir()
+    except Exception:
+        return False
+
+
+def emit_workflow_run(
+    *,
+    session_id: str,
+    instance: dict[str, Any],
+    ref_type: str,
+    name: str,
+) -> None:
+    """工作流/任务 debug 受理成功（202 返回前）发 workflow_run 事件。"""
+    try:
+        _emit(build_workflow_run_payload(
+            session_id=session_id, instance=instance, ref_type=ref_type, name=name,
+        ))
+    except Exception as exc:
+        logger.warning("[struct-notify] emit_workflow_run 失败: %s", exc)
+
+
+def emit_table_change(
+    *,
+    session_id: str,
+    sql: str,
+    db_name: str,
+    source: str = "dwcli sql ddl",
+) -> None:
+    """DDL 成功提交后发 table_change 事件（sqlglot 解析目标表，解析不出不发）。"""
+    try:
+        changes = classify_ddl(sql)
+        if not changes:
+            return
+        # 同一 SQL 多条 DDL 语句：按 operation 合并目标表，一事件承载
+        by_op: dict[str, list[str]] = {}
+        for op, table in changes:
+            by_op.setdefault(op, [])
+            if table not in by_op[op]:
+                by_op[op].append(table)
+        for op, tables in by_op.items():
+            _emit(build_table_change_payload(
+                session_id=session_id, operation=op, db=db_name,
+                tables=tables, sql=sql, source=source,
+            ))
+    except Exception as exc:
+        logger.warning("[struct-notify] emit_table_change 失败: %s", exc)
+
+
+def emit_workflow_change(
+    *,
+    session_id: str,
+    operation: str,
+    workflow_id: str,
+    name: str,
+    node_count: int = 0,
+    source: str = "dwcli workflow",
+) -> None:
+    """工作流定义级变更（创建/更新/挂节点）成功后发 workflow_change 事件.
+
+    payload 只带 workflow_id + 节点计数，定义 DAG 由前端按 id 现拉（详情视图
+    聚合展示"当前样子"，列表展示操作历史）。
+    """
+    try:
+        _emit(build_workflow_change_payload(
+            session_id=session_id, operation=operation, workflow_id=workflow_id,
+            name=name, node_count=node_count, source=source,
+        ))
+    except Exception as exc:
+        logger.warning("[struct-notify] emit_workflow_change 失败: %s", exc)
