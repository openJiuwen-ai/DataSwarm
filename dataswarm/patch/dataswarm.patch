+    out = []
+    for row in rows:
+        cells = []
+        for v in row:
+            if isinstance(v, (int,)) and not isinstance(v, bool):
+                cells.append(str(v))
+            else:
+                try:
+                    cells.append(f"{float(v):.4f}")
+                except (TypeError, ValueError):
+                    cells.append(str(v))
+        out.append(cells)
+    return out
+
+
+def run_on(type_id, config, dialect):
+    conn = connector_for(type_id, config)
+    assert isinstance(conn, SqlQueryable), f"{type_id} 不具备 sql 能力"
+    table = dataset_names(conn.catalog())[0]
+    answers = {}
+    for label, sql in questions_for(dialect, table).items():
+        answers[label] = norm(conn.query(sql, limit=10)["rows"])
+    return answers, table
+
+
+def c_cross_engine_same_answer():
+    import duckdb
+    base = {}
+    bcon = duckdb.connect(":memory:")
+    parquet = (DATA / "fact_orders.parquet").as_posix()
+    for label, sql in questions_for("duckdb", "__t__").items():
+        base[label] = norm(
+            bcon.execute(sql.replace('"__t__"', f"read_parquet('{parquet}')")).fetchall()
+        )
+
+    got, tables = {}, {}
+    plan = [
+        ("parquet", {"location": str(DATA / "fact_orders.parquet"),
+                     "table_name": "fact_orders"}, "duckdb"),
+        ("json", {"location": str(DATA / "fact_orders.json"),
+                  "table_name": "fact_orders"}, "duckdb"),
+        ("csv", {"path": str(DATA / "fact_orders.csv")}, "duckdb"),
+        ("postgresql", PG_CONFIG, "postgres"),
+    ]
+    for tid, cfg, dialect in plan:
+        got[tid], tables[tid] = run_on(tid, cfg, dialect)
+
+    for label in base:
+        for tid, answers in got.items():
+            assert answers[label] == base[label], (
+                f"{label} 在 {tid} 上与独立基准不一致:\n"
+                f"  基准={base[label]}\n  {tid}={answers[label]}"
+            )
+    print("            跨引擎一致的答案：")
+    for label, rows in base.items():
+        print(f"              {label} = {rows[0] if len(rows) == 1 else rows}")
+    return (f"parquet / json / csv / **postgresql** 四种接入与独立基准逐值一致"
+            f"（视图/表名 {tables}）")
+
+
+check("C", "5 道分析题跨引擎同题同解", c_cross_engine_same_answer)
+
+# ======================================================================
+print("\n########## 门 D：护栏 ##########")
+
+
+def d_write_rejected():
+    conn = connector_for("postgresql", PG_CONFIG)
+    statements = (
+        "INSERT INTO fact_orders VALUES (0,'2025-01-01',1,1,1.0,1,'APP')",
+        "UPDATE fact_orders SET order_amt = 0",
+        "DELETE FROM fact_orders",
+        "DROP TABLE fact_orders",
+        "CREATE TABLE evil AS SELECT 1",
+        "ALTER TABLE fact_orders ADD COLUMN x INT",
+        "TRUNCATE fact_orders",
+        "COPY fact_orders TO '/tmp/leak.csv'",
+    )
+    for sql in statements:
+        expect_query_rejected(conn, sql, sql[:30])
+    return f"{len(statements)} 类写/导出操作全部在连接前被应用层护栏拒绝"
+
+
+def d_server_side_readonly():
+    """验证直连会话的只读事务设置，独立于客户端 SQL 护栏。"""
+    conn, meta = dbc.connect(PG_REF, read_only=True)
+    try:
+        cur = conn.cursor()
+        cur.execute("SELECT current_setting('transaction_read_only')")
+        value = cur.fetchone()[0]
+        assert value == "on", f"只读直连未生效: {value}"
+        try:
+            cur.execute("CREATE TABLE should_not_exist (x int)")
+            raise AssertionError("只读事务竟然允许建表")
+        except AssertionError:
+            raise
+        except Exception:
+            pass
+    finally:
+        conn.close()
+    return "read_only 直连 transaction_read_only=on，建表被库层拒绝"
+
+
+def d_multi_statement_rejected():
+    conn = connector_for("postgresql", PG_CONFIG)
+    expect_query_rejected(conn, 'SELECT 1; DROP TABLE "fact_orders"', "多语句")
+    return "分号多语句在连接前被拒"
+
+
+def d_dialect_is_postgres_not_mysql():
+    assert dr.sqlglot_dialect("postgresql") == "postgres"
+    assert dr.sqlglot_dialect("hologres") == "postgres", "hologres 应复用 PG 方言"
+    profile = dr.profile_for("postgresql")
+    assert profile.grain_fn == "to_char", profile.grain_fn
+    assert profile.ident_quote == '"'
+
+    # 反引号：MySQL 族接受、PG 拒绝（与 duckdb 同向）
+    backtick = "SELECT `col` FROM t"
+    validate_read_only_sql(backtick, source_type="mysql")
+    expect_raises(lambda: validate_read_only_sql(backtick, source_type="postgresql"),
+                  QueryValidationError, "反引号在 PG 方言下")
+    expect_raises(lambda: validate_read_only_sql(backtick, source_type="hologres"),
+                  QueryValidationError, "反引号在 hologres 方言下")
+    # 双引号语义：PG 为标识符，MySQL 为字符串
+    kinds = {
+        tid: type(
+            sqlglot.parse_one('SELECT "abc" FROM t', read=dr.sqlglot_dialect(tid)).selects[0]
+        ).__name__
+        for tid in ("postgresql", "hologres", "mysql")
+    }
+    assert kinds["postgresql"] == "Column" and kinds["hologres"] == "Column", kinds
+    assert kinds["mysql"] == "Literal", kinds
+    return (f"方言=postgres，grain_fn=to_char；反引号在 PG/hologres 被拒；"
+            f"双引号语义 {kinds}")
+
+
+def d_truncation_flag():
+    conn = connector_for("postgresql", PG_CONFIG)
+    res = conn.query('SELECT * FROM "fact_orders"', limit=10)
+    assert len(res["rows"]) == 10, len(res["rows"])
+    assert res["truncated"] is True, res
+    small = conn.query("SELECT 1 AS v", limit=10)
+    assert small["truncated"] is False, small
+    return "超限截断置 truncated=True，未超限为 False"
+
+
+def d_capability_and_quoting():
+    conn = connector_for("postgresql", PG_CONFIG)
+    assert capabilities_of(conn) == {"sql"}, capabilities_of(conn)
+    # 标识符引用走 registry：PG 双引号，不是 MySQL 的反引号
+    assert dr.quote_qualified("postgresql", "public.fact_orders") == '"public"."fact_orders"'
+    preview = conn.preview("fact_orders", limit=3)
+    assert len(preview["rows"]) == 3, preview
+    return "能力={'sql'}；标识符按 PG 双引号；preview 正常"
+
+
+check("D1", "写/导出操作被拒", d_write_rejected)
+check("D2", "库层只读兜底", d_server_side_readonly)
+check("D3", "多语句被拒", d_multi_statement_rejected)
+check("D4", "方言正确（postgres 非 mysql）", d_dialect_is_postgres_not_mysql)
+check("D5", "大结果截断标志", d_truncation_flag)
+check("D6", "能力与标识符引用", d_capability_and_quoting)
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细（环境所限，非代码缺陷）：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\n第 2 批四道门通过")
diff --git a/tests/acceptance/datasource/batch3/verify_gates.py b/tests/acceptance/datasource/batch3/verify_gates.py
