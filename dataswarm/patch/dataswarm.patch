@@ -0,0 +1,130 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { ChevronDown, ChevronRight } from 'lucide-react';
+import type { SourceTypeCatalogEntry } from '../types/dataSource';
+import { SourceBrand } from './SourceBrand';
+
+const CATEGORY_ORDER = ['relational', 'nosql', 'file', 'api', 'message', 'other'];
+
+function canCreate(entry: SourceTypeCatalogEntry) {
+  return entry.available === true && entry.fields.length > 0;
+}
+
+export function SourceTypeCascader({
+  value,
+  sourceTypes,
+  disabled,
+  onSelect,
+}: {
+  value: string;
+  sourceTypes: SourceTypeCatalogEntry[];
+  disabled: boolean;
+  onSelect: (type: string) => Promise<boolean>;
+}) {
+  const { t } = useTranslation();
+  const root = useRef<HTMLDivElement>(null);
+  const trigger = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  const [selecting, setSelecting] = useState(false);
+  const groups = useMemo(() => {
+    const result = new Map<string, SourceTypeCatalogEntry[]>();
+    sourceTypes.forEach((entry) => {
+      const category = entry.category ?? 'other';
+      result.set(category, [...(result.get(category) ?? []), entry]);
+    });
+    return [...result.entries()].sort(([a], [b]) => {
+      const ai = CATEGORY_ORDER.indexOf(a);
+      const bi = CATEGORY_ORDER.indexOf(b);
+      return (ai < 0 ? CATEGORY_ORDER.length : ai) - (bi < 0 ? CATEGORY_ORDER.length : bi);
+    });
+  }, [sourceTypes]);
+  const entry = sourceTypes.find((item) => item.type_id === value);
+  const selectedCategory = entry?.category ?? groups[0]?.[0] ?? 'other';
+  const [activeCategory, setActiveCategory] = useState(selectedCategory);
+  const activeTypes = groups.find(([category]) => category === activeCategory)?.[1] ?? [];
+
+  useEffect(() => {
+    if (!open) return;
+    const closeOnOutsideClick = (event: PointerEvent) => {
+      if (!root.current?.contains(event.target as Node)) setOpen(false);
+    };
+    document.addEventListener('pointerdown', closeOnOutsideClick);
+    return () => document.removeEventListener('pointerdown', closeOnOutsideClick);
+  }, [open]);
+
+  return (
+    <div className="ds-type-cascader-root" ref={root}>
+      <button
+        ref={trigger}
+        type="button"
+        className="ds-selected-type"
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        disabled={disabled || selecting}
+        onClick={() => {
+          if (!open) setActiveCategory(selectedCategory);
+          setOpen((current) => !current);
+        }}
+      >
+        <SourceBrand type={value} />
+        <strong>{entry?.label ?? value}</strong>
+        <ChevronDown size={16} className={open ? 'is-open' : ''} />
+      </button>
+      {open && (
+        <div
+          className="ds-type-cascader"
+          role="dialog"
+          aria-label={t('dataSource.form.typeLabel')}
+          onKeyDown={(event) => {
+            if (event.key !== 'Escape') return;
+            event.preventDefault();
+            event.stopPropagation();
+            setOpen(false);
+            trigger.current?.focus();
+          }}
+        >
+          <div className="ds-type-cascader-categories">
+            {groups.map(([category]) => (
+              <button
+                key={category}
+                type="button"
+                className={activeCategory === category ? 'is-active' : ''}
+                onClick={() => setActiveCategory(category)}
+              >
+                <span>{t(`dataSource.typeDialog.categories.${category}`, { defaultValue: category })}</span>
+                <ChevronRight size={14} />
+              </button>
+            ))}
+          </div>
+          <div className="ds-type-cascader-options" role="listbox" aria-label={t('dataSource.form.typeLabel')}>
+            {activeTypes.map((option) => {
+              const available = canCreate(option);
+              return (
+                <button
+                  key={option.type_id}
+                  type="button"
+                  role="option"
+                  aria-selected={option.type_id === value}
+                  disabled={!available || selecting}
+                  onClick={async () => {
+                    setSelecting(true);
+                    try {
+                      if (await onSelect(option.type_id)) setOpen(false);
+                    } finally {
+                      setSelecting(false);
+                    }
+                  }}
+                >
+                  <SourceBrand type={option.type_id} />
+                  <span>{option.label}</span>
+                  {!available && <small>{t('dataSource.typeDialog.comingSoon')}</small>}
+                </button>
+              );
+            })}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
