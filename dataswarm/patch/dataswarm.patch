+def delete_document(version_id: str) -> dict:
+    """删除文档版本：其产出的候选先全部退役（保留审计事件），再删文档行。
+
+    Args:
+        version_id: 文档版本 id。
+
+    Returns:
+        {version_id, retired_candidates, retire_failed}。
+
+    Raises:
+        ValueError: 文档版本不存在。
+    """
+    if get_document(version_id) is None:
+        raise ValueError("document version not found")
+    retired: list[str] = []
+    failed: list[str] = []
+    for asset in store.list_assets():
+        if (asset.get("source") or {}).get("document_version_id") != version_id or asset["status"] == "retired":
+            continue
+        try:
+            store.transition(asset["asset_id"], "retire")
+            retired.append(asset["asset_id"])
+        except Exception:  # noqa: BLE001 — 单个候选退役失败不阻塞文档删除
+            failed.append(asset["asset_id"])
+    conn = _connect()
+    try:
+        _exec(conn, "DELETE FROM dw_knowledge_documents WHERE workspace_id=? AND version_id=?",
+              (store._workspace(), version_id))
+        conn.commit()
+    finally:
+        conn.close()
+    return {"version_id": version_id, "retired_candidates": retired, "retire_failed": failed}
+
+
+def extract_candidates(version_id: str, *, provider=None) -> dict:
+    document = get_document(version_id)
+    if not document:
+        raise ValueError("document version not found")
+    from pydantic import BaseModel, Field
+
+    class ExtractedAsset(BaseModel):
+        asset_type: str
+        title: str
+        content: str
+        scope: dict = Field(default_factory=dict)
+        evidence_index: int
+        evidence_quote: str
+        # Offsets are optional: asking the model to count characters inflates
+        # reasoning past the completion budget. The quote is the anchor; the
+        # server locates the span and rejects quotes absent from the evidence.
+        evidence_start: int = -1
+        evidence_end: int = -1
+        confidence: float = Field(ge=0, le=1)
+
+    class ExtractionResult(BaseModel):
+        assets: list[ExtractedAsset]
+
+    ExtractionResult.model_rebuild(_types_namespace={"ExtractedAsset": ExtractedAsset})
+
+    if provider is None:
+        from .extraction_llm import build_default_provider
+        provider = build_default_provider()
+    candidates, invalid = [], []
+    # Keep batches small enough that reasoning cannot consume the whole output
+    # budget before the JSON body is emitted.
+    cap = max(800, min(8000, int(os.environ.get("KNOWLEDGE_EXTRACT_BATCH_CHARS", "3500"))))
+    batches, batch, size = [], [], 0
+    for evidence in _bounded_evidence(document["evidence"], cap):
+        if batch and size + len(evidence["text"]) > cap:
+            batches.append(batch)
+            batch, size = [], 0
+        batch.append(evidence)
+        size += len(evidence["text"])
+    if batch:
+        batches.append(batch)
+    failed_batches, completed = [], 0
+    # Persist per-batch progress in the document version payload. Retrying the
+    # same version skips completed batches; candidate fingerprints also close
+    # the gap between inserting a candidate and saving its checkpoint.
+    checkpoint = document.setdefault("extraction", {}).setdefault("batches", {})
+    completion_start = len(getattr(provider, "completions", []))
+    # 语义目录只读一次（批次共享）：为无作用范围的规则/映射生成可采纳的绑定建议
+    from .scope_suggestions import load_catalog
+    scope_catalog = load_catalog(store._workspace())
+    existing = {a["source"].get("extraction_key"): a for a in store.list_assets()
+                if a["source"].get("document_version_id") == version_id}
+    prompt_head = ("Extract proposed business knowledge from the document evidence below. "
+                   "Use asset_type in [term,rule,mapping,example]. Never propose asset_type=metric: "
+                   "metric candidates are no longer extracted from documents (model them in the "
+                   "metric system instead) — drop any metric-like proposal. "
+                   "Never guess alignment or publish. "
+                   "Business entities, people segments, organizations and concept definitions go under "
+                   "asset_type=term (not a separate entity type). "
+                   "Return evidence_index and an evidence_quote copied VERBATIM from that evidence item. "
+                   "Preserve scope limitations and exceptions. Keep titles and definitions concise. "
+                   "Quote only the shortest exact supporting passage. Do not explain your reasoning; output ONLY JSON. "
+                   "scope must use ONLY standard keys: metric_keys, term_ids, entity_ids, column_ids, table_ids, "
+                   "dimensions, scenarios, workspace_wide. column_ids and table_ids hold logical names like "
+                   "'orders.customer_state' (the server pins them to schema node IDs at publication); "
+                   "workspace_wide=true only for rules that apply to the entire workspace. "
+                   "A mapping MUST name its physical target columns in column_ids. "
+                   "JSON schema:\n" + json.dumps(ExtractionResult.model_json_schema(), ensure_ascii=False))
+
+    def _absorb(result_batch, result, failure, top_key=None) -> None:
+        """主线程串行吸收一个叶子批次：checkpoint 写入 + 候选落库（线程安全边界）。
+
+        checkpoint 键恒为顶层批次键（top_key）：截断分裂只改变 LLM 调用粒度，
+        不改变批次身份——否则叶子键与重跑 pending 判断的顶层键永不匹配，
+        分裂过的批次重跑必重打 LLM 并落语义重复资产（kbi-02 幂等断言实证）。
+        """
+        nonlocal completed
+        batch_key = top_key or _batch_key(result_batch)
+        if failure:
+            failure["evidence_ids"] = [row["evidence_id"] for row in result_batch]
+            failed_batches.append(failure)
+            entry = checkpoint.setdefault(batch_key, {"status": "complete", "asset_ids": [],
+                                                      "invalid_count": 0})
+            entry["status"] = "failed"
+            entry.update({k: v for k, v in failure.items() if k != "evidence_ids"})
+            _save_extraction(document)
+        elif result is None:  # Already completed in a previous request.
+            candidates.extend(a for aid in checkpoint[batch_key].get("asset_ids", [])
+                              if (a := store.get_asset(aid)) is not None)
+            completed += 1
+        else:
+            batch_candidates, batch_invalid = _save_candidates(result, result_batch, document, existing,
+                                                               version_id, catalog=scope_catalog)
+            candidates.extend(batch_candidates)
+            invalid.extend(batch_invalid)
+            # 顶层批次可含多个叶子：asset_ids 累加，禁止整键覆盖丢前序叶子的落库
+            entry = checkpoint.setdefault(batch_key, {"status": "complete", "asset_ids": [],
+                                                      "invalid_count": 0})
+            entry["asset_ids"].extend(a["asset_id"] for a in batch_candidates)
+            entry["invalid_count"] = entry.get("invalid_count", 0) + len(batch_invalid)
+            completed += 1
+            _save_extraction(document)
+
+    # 幂等重跑：已完成批次直接吸收，其余批次并行跑 LLM（叶子无副作用，
+    # checkpoint 与落库只在主线程 _absorb 中发生，无并发写竞争）。
+    for batch in batches:
+        if checkpoint.get(_batch_key(batch), {}).get("status") == "complete":
+            _absorb(batch, None, None)
+    pending = [batch for batch in batches
+               if checkpoint.get(_batch_key(batch), {}).get("status") != "complete"]
+    workers = max(1, min(4, int(os.environ.get("KNOWLEDGE_EXTRACT_PARALLELISM", "3"))))
+    if len(pending) <= 1 or workers == 1:
+        for batch in pending:
+            for leaf in _run_batch_leaves(provider, prompt_head, ExtractionResult, batch):
+                _absorb(*leaf, top_key=_batch_key(batch))
+    else:
+        from concurrent.futures import ThreadPoolExecutor, as_completed
+        with ThreadPoolExecutor(max_workers=workers) as pool:
+            future_to_batch = {pool.submit(_run_batch_leaves, provider, prompt_head, ExtractionResult, batch): batch
+                                for batch in pending}
+            for future in as_completed(future_to_batch):
+                top_key = _batch_key(future_to_batch[future])
+                for leaf in future.result():
+                    _absorb(*leaf, top_key=top_key)
+    status = "partial" if failed_batches and completed else "failed" if failed_batches else "complete"
+    completion_meta = [asdict(info) for info in getattr(provider, "completions", [])[completion_start:][-20:]]
+    document["extraction"].update(status=status, completion_meta=completion_meta)
+    _save_extraction(document)
+    return {"version_id": version_id, "candidates": candidates, "invalid_candidates": invalid,
+            "status": status, "failed_batches": failed_batches, "extractor": "project.extraction_llm.generate_typed",
+            "candidate_count": len(candidates), "completion_meta": completion_meta,
+            "retry_hint": ("蒸馏缺省走默认 LLM（自动禁思考），失败原因见各批次 error 字段；"
+                            "需要专用通道时经 env KNOWLEDGE_EXTRACT_* 或 config knowledge_extraction "
+                            "节点整通道配置（model+api_key+api_base 三键配全才生效）；"
+                            "当前批次仍可通过再次导入继续处理" if failed_batches else "")}
+
+
+_APPLICABILITY_KEYS = ("metric_keys", "term_ids", "entity_ids", "column_ids",
+                       "table_ids", "dimensions", "scenarios")
+
+
+def _has_resolvable_target(scope: dict, catalog: dict) -> bool:
+    """scope 是否带有真正能生效的适用目标（与读侧契约对齐：解析不到 = 没绑）。
+
+    蒸馏常自填"看似已绑"的键：幻觉 metric key（目录里不存在）、裸列名
+    （无表前缀，发布钉扎匹配不上 table.column 形态）。这类键不该挡住
+    绑定建议——E2E 实测确认它们会静默短路建议生成。
+
+    - metric/term：值必须命中当前语义目录（已发布的指标 key / 术语 id）
+    - column：table.column 形态或已钉扎节点 id（col:/tbl:/view:）才算
+    - 其余键（table/entity/dimension/scenario）与 workspace_wide：非空即认
+    """
+    if scope.get("workspace_wide"):
+        return True
+    if any(scope.get(key) for key in ("entity_ids", "table_ids", "dimensions", "scenarios")):
+        return True
+    metric_keys = {str(value) for value in scope.get("metric_keys") or []}
+    if metric_keys & {key for key, _name in catalog.get("metric_names") or []}:
+        return True
+    term_ids = {str(value) for value in scope.get("term_ids") or []}
+    if term_ids & {term_id for term_id, _names in catalog.get("term_names") or []}:
+        return True
+    return any("." in str(value) or str(value).startswith(("col:", "tbl:", "view:"))
+               for value in scope.get("column_ids") or [])
+
+
+def _save_candidates(result, batch: list[dict], document: dict, existing: dict, version_id: str,
+                     *, catalog: dict | None = None) -> tuple[list, list]:
+    candidates, invalid = [], []
+    for item in result.model_dump().get("assets", []):
+        evidence_index = int(item.get("evidence_index", 0))
+        if not 0 <= evidence_index < len(batch):
+            invalid.append({"title": item.get("title"), "reason": "invalid_evidence_index"})
+            continue
+        evidence = batch[evidence_index]
+        quote = str(item["evidence_quote"])
+        start, end = int(item.get("evidence_start", -1)), int(item.get("evidence_end", -1))
+        if not (0 <= start < end <= len(evidence["text"]) and evidence["text"][start:end] == quote):
+            # Model offsets are advisory: locate the quote server-side instead
+            # of trusting (or asking for) character counting.
+            start, end = _locate_quote(evidence["text"], quote)
+        if start < 0:
+            invalid.append({"title": item.get("title"), "reason": "evidence_quote_not_found", "quote": quote})
+            continue
+        if item["asset_type"] not in store.KINDS:
+            invalid.append({"title": item.get("title"), "reason": "invalid_asset_type", "quote": quote})
+            continue
+        if item["asset_type"] == "metric":
+            # 指标候选抽取已关闭（2026-11-02）：prompt 已禁，模型仍产出时在此丢弃，
+            # 不落 invalid（路径关闭是策略而非错误，不污染批次失败计数）。
+            continue
+        # Anchor the stored quote on the original-text slice: the publication
+        # gate re-verifies text[span] == quote, and a lenient match must not
+        # leave the quote as the LLM's mark-stripped paraphrase.
+        quote = evidence["text"][start:end]
+        source = {**document["source"], "document_id": document["document_id"], "document_version_id": version_id,
+                  "extractor_version": "project-schema-v2", "evidence_id": evidence["evidence_id"],
+                  "evidence_span": {"start": start + evidence["start"], "end": end + evidence["start"]},
+                  "evidence_quote": quote, "confidence": item.get("confidence")}
+        scope = dict(item.get("scope") or {})
+        if document["source"]["source_id"]:
+            scope["source_ids"] = [document["source"]["source_id"]]
+        # 规则/映射缺少"能解析到"的生效目标时，用语义目录给出可一键采纳的绑定建议
+        if (catalog and item["asset_type"] in {"rule", "mapping"}
+                and not _has_resolvable_target(scope, catalog)):
+            from .scope_suggestions import suggest_scope
+            hints = suggest_scope(item["title"], item["content"], **catalog)
+            if hints:
+                source["suggested_scope"] = hints
+        fingerprint = hashlib.sha256(json.dumps(
+            [source["document_version_id"], item["asset_type"], item["title"], item["content"],
+             source["evidence_span"], scope], sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+        source["extraction_key"] = fingerprint
+        if fingerprint in existing:
+            candidates.append(existing[fingerprint])
+            continue
+        try:
+            candidate = store.create_candidate({**item, "scope": scope, "source": source,
+                                                "owner": "document-extractor"})
+        except ValueError as exc:
+            invalid.append({"title": item.get("title"), "reason": str(exc)})
+            continue
+        candidate["conflicts"] = store.conflicts(candidate)
+        candidates.append(candidate)
+        existing[fingerprint] = candidate
+    return candidates, invalid
+
+
+def _run_batch_leaves(provider, prompt_head, schema, batch, depth: int = 0) -> list[tuple]:
+    """Run one batch through the LLM (splitting on truncation); no side effects.
+
+    Returns a list of ``(batch, result_or_None, failure_or_None)`` leaves. The
+    caller absorbs leaves serially in the main thread — checkpoint writes and
+    candidate persistence never happen here, so batches can run in parallel.
+    """
+    prompt = (prompt_head + "\nEvidence:\n"
+              + "\n".join(f"[EVIDENCE {index}]\n{row['text']}" for index, row in enumerate(batch)))
+    try:
+        result = provider.generate_typed(prompt, schema=schema, temperature=0, max_retries=2)
+    except Exception as exc:  # noqa: BLE001 — failures are explicit leaf outcomes, never empty success
+        from .extraction_llm import ExtractionLLMError
+        code = exc.code if isinstance(exc, ExtractionLLMError) else "provider_error"
+        splittable = code in {"output_truncated", "empty_output", "invalid_output"}
+        parts = _split_batch(batch) if splittable and depth < 3 else []
+        if not parts:
+            # error message 必须随批次失败落档（API 响应 + 文档 payload checkpoint）：
+            # 只记 code/error_type 时，401/超时这类可分诊信息要本地复现才能拿到
+            return [(batch, None, {"reason": code, "error_type": type(exc).__name__,
+                                   "error": str(exc)[:300]})]
+        leaves: list[tuple] = []
+        for part in parts:
+            leaves.extend(_run_batch_leaves(provider, prompt_head, schema, part, depth=depth + 1))
+        return leaves
+    return [(batch, result, None)]
+
+
+def _split_batch(batch: list[dict]) -> list[list[dict]]:
+    if len(batch) > 1:
+        midpoint = len(batch) // 2
+        return [batch[:midpoint], batch[midpoint:]]
+    evidence = batch[0]
+    text = evidence["text"]
+    if len(text) < 600:
+        return []
+    midpoint = len(text) // 2
+    # Keep boundary context in both children; spans still refer to parsed text.
+    return [[{**evidence, "text": text[start:end], "start": evidence["start"] + start,
+              "end": evidence["start"] + end}]
+            for start, end in ((0, midpoint + 80), (midpoint - 80, len(text)))]
+
+
+def _bounded_evidence(evidence: list[dict], cap: int):
+    for row in evidence:
+        if len(row["text"]) <= cap:
+            yield row
+            continue
+        for start in range(0, len(row["text"]), cap - 80):
+            text = row["text"][start:start + cap]
+            yield {**row, "text": text, "start": row["start"] + start, "end": row["start"] + start + len(text)}
+
+
+def _batch_key(batch: list[dict]) -> str:
+    payload = [(r["evidence_id"], r["start"], r.get("end"), r["text"]) for r in batch]
+    return hashlib.sha256(json.dumps(payload, ensure_ascii=False).encode()).hexdigest()
+
+
+def _save_extraction(document: dict) -> None:
+    conn = _connect()
+    try:
+        _exec(conn, "UPDATE dw_knowledge_documents SET payload_json=?,updated_at=? "
+              "WHERE workspace_id=? AND version_id=?",
+              (json.dumps(document, ensure_ascii=False), _now(), store._workspace(), document["version_id"]))
+        conn.commit()
+    finally:
+        conn.close()
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/expansion.py b/jiuwenswarm/channels/web/dataagent/knowledge/expansion.py
new file mode 100644
index 000000000..2dd0cd546
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/expansion.py
@@ -0,0 +1,61 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Directed knowledge relations, verified against published metadata authority."""
+from __future__ import annotations
+
+from .selection import target_refs, visible_assets
+
+
+def seed_refs(recall_results: dict, workspace_id: str, versions: dict, source_ids: list[str] | None) -> dict:
+    """Resolve L1 knowledge IDs before the ordinary metric/schema expansion.
+
+    Graph edges are discovery evidence, never authority. The metadata relation
+    set is always unioned so missing projections or graph limits cannot hide
+    reviewed applicability links.
+    """
+    assets = visible_assets(source_ids=source_ids, versions=versions)
+    by_id = {asset["asset_id"]: asset for asset in assets}
+    wanted = {hit.entity_id for name in ("mappings", "rules")
+              for hit in getattr(recall_results.get(name), "hits", ())}
+    anchors = {hit.entity_id for name in ("terms", "metrics", "schema")
+               for hit in getattr(recall_results.get(name), "hits", ())}
+    wanted.update(asset["asset_id"] for asset in assets if asset["asset_type"] == "mapping"
+                  and target_refs(asset["scope"]).intersection(anchors))
+    selected, edges, dropped = {}, [], []
+    metric_keys, term_ids, columns, tables = set(), set(), set(), set()
+    queue = list(wanted)
+    while queue:
+        asset_id = queue.pop()
+        if asset_id in selected:
+            continue
+        asset = by_id.get(asset_id)
+        if asset is None:
+            dropped.append({"kind": "knowledge", "id": asset_id, "reason": "not_visible_or_published"})
+            continue
+        selected[asset_id] = asset
+        scope = asset["scope"]
+        for key, out in (("metric_keys", metric_keys), ("term_ids", term_ids),
+                         ("column_ids", columns), ("table_ids", tables)):
+            out.update(scope.get(key) or [])
+        for ref in target_refs(scope):
+            edges.append({"asset_id": asset_id, "target": ref, "type": "appliesTo", "via": "metadata"})
+        queue.extend(ref for ref in scope.get("entity_ids") or [] if ref not in selected)
+    graph_path, warnings = "not_required", []
+    if selected:
+        try:
+            from ..semantic.semantica import from_environment
+            graph = from_environment()
+            nodes = [f"knowledge:{workspace_id}:{asset_id}" for asset_id in selected]
+            records = graph.read_neighbors(nodes, edge_types=["appliesTo"], direction="out", limit=200)
+            graph_path = "graph_read+metadata"
+            for edge in edges:
+                targets = {edge["target"], f"metric:{workspace_id}:{edge['target']}",
+                           f"term:{workspace_id}:{edge['target']}", f"knowledge:{workspace_id}:{edge['target']}"}
+                if any(record.get("source") == f"knowledge:{workspace_id}:{edge['asset_id']}"
+                       and record.get("target") in targets for record in records):
+                    edge["via"] = "graph+metadata"
+        except Exception as exc:  # noqa: BLE001 — metadata retains the complete reviewed relation set
+            graph_path = "metadata_fallback"
+            warnings.append(f"knowledge_graph_fallback:{type(exc).__name__}")
+    return {"assets": list(selected.values()), "metric_keys": metric_keys, "term_ids": term_ids,
+            "column_ids": columns, "table_ids": tables, "edges": edges, "dropped": dropped,
+            "path": graph_path, "warnings": warnings}
