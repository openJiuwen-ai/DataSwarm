@@ -0,0 +1,168 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Sampled schemas are observations, not evidence of destructive DDL."""
+from copy import deepcopy
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.semantic import impact
+from jiuwenswarm.channels.web.dataagent.semantic.fingerprint import apply_fingerprints, diff_snapshots
+from jiuwenswarm.channels.web.dataagent.semantic.graph import add_deprecated_tombstones, build_projection
+from jiuwenswarm.channels.web.dataagent.semantic.model import ColumnMeta, DatabaseMeta, DataSourceMeta, MetadataSnapshot, TableMeta
+
+
+def snapshot(identifier, *, scope=None, include_optional=True, value_type="VARCHAR"):
+    columns = [ColumnMeta("source", "mongodb", "app", "events", "value", data_type=value_type, column_type=value_type)]
+    if include_optional:
+        columns.append(ColumnMeta("source", "mongodb", "app", "events", "optional", data_type="VARCHAR"))
+    return apply_fingerprints(MetadataSnapshot(
+        identifier, f"run:{identifier}", DataSourceMeta("source", "mongodb", "mongodb://source/source"),
+        databases=[DatabaseMeta("source", "mongodb", "app")],
+        tables=[TableMeta("source", "mongodb", "app", "events", columns=columns)], scope=scope or {},
+    ))
+
+
+@pytest.mark.parametrize("scope", [{"engine": "sampled"}, {"population_scope": "bounded_sample"},
+                                    {"metadata_scope": "sampled_schema"}])
+def test_sampled_absence_is_observed_without_removed_events_or_tombstones(scope):
+    previous = snapshot("before")
+    current = snapshot("after", scope=scope, include_optional=False)
+    events = diff_snapshots(previous, current)
+    assert not any(event.change_type == "removed" for event in events)
+    assert current.scope["change_observations"] == {
+        "base_snapshot_id": "before", "metadata_scope": "sampled_schema", "observed_type_changes": [],
+        "unconfirmed_removals": [{"object_id": "col:mongodb:source:app.events.optional", "object_kind": "col",
+                                   "reason": "not_observed_in_sample"}],
+    }
+    projection = add_deprecated_tombstones(build_projection(current), previous, events)
+    assert not any(node.properties.get("status") == "deprecated" for node in projection.nodes)
+    assert len(current.tables[0].columns) == 1  # Do not invent a current observation.
+
+
+def test_sampled_type_drift_is_reviewable_and_does_not_fail_metric_bindings(monkeypatch):
+    previous = snapshot("before", scope={"engine": "sampled"}, value_type="mixed")
+    current = snapshot("after", scope={"engine": "sampled"}, include_optional=False)
+    events = diff_snapshots(previous, current)
+    assert not any(event.change_type in {"removed", "type_changed"} for event in events)
+    observed = current.scope["change_observations"]["observed_type_changes"]
+    assert len(observed) == 1 and observed[0]["old_data_type"] == "mixed"
+    assert observed[0]["new_data_type"] == "VARCHAR"
+    event = next(item for item in events if item.object_id.endswith(".value"))
+    assert event.change_type == "updated" and event.severity == "low"
+    assert event.details["requires_confirmation"] is True
+    monkeypatch.setattr(impact.workspace_context, "current_workspace", lambda: SimpleNamespace(workspace_id="fixture"))
+
+    def unexpected(*args, **kwargs):
+        raise AssertionError("sampled observations must not downgrade metric bindings")
+
+    monkeypatch.setattr(impact.metric_store, "list_defs", unexpected)
+    monkeypatch.setattr(impact.metric_store, "update_binding_status", unexpected)
+    assert impact.propagate("source", events) == []
+
+
+def test_complete_catalog_still_confirms_removed_and_changed_types():
+    previous = snapshot("before", scope={"engine": "sampled"}, value_type="mixed")
+    current = snapshot("after", scope={"engine": "sqlalchemy", "population_scope": "source"}, include_optional=False)
+    events = diff_snapshots(previous, current)
+    assert any(event.change_type == "removed" and event.severity == "highest" for event in events)
+    assert any(event.change_type == "type_changed" and event.severity == "high" for event in events)
+    assert "change_observations" not in current.scope
+
+
+def test_unobserved_tables_and_databases_remain_observations_and_diff_is_idempotent():
+    previous = snapshot("before")
+    current = snapshot("after", scope={"engine": "sampled"})
+    current.tables.clear()
+    current.databases.clear()
+    events = diff_snapshots(previous, current)
+    assert events == []
+    recorded = deepcopy(current.scope)
+    assert len(recorded["change_observations"]["unconfirmed_removals"]) == 4
+    assert diff_snapshots(previous, current) == events
+    assert current.scope == recorded
+    restored = MetadataSnapshot.from_dict(current.to_dict())
+    assert restored.tables == [] and restored.scope == recorded
+
+
+def test_first_sample_additions_are_available_without_claiming_absence():
+    current = snapshot("first", scope={"engine": "sampled"})
+    events = diff_snapshots(None, current)
+    assert events and all(event.change_type == "added" for event in events)
+    assert current.scope["change_observations"]["base_snapshot_id"] is None
+    assert current.scope["change_observations"]["unconfirmed_removals"] == []
+
+
+def large_snapshot(identifier, *, scope=None):
+    result = snapshot(identifier, scope=scope)
+    result.tables[0].columns.extend(
+        ColumnMeta("source", "mongodb", "app", "events", f"optional_{index}", data_type="VARCHAR")
+        for index in range(30)
+    )
+    return apply_fingerprints(result)
+
+
+@pytest.mark.parametrize("scope", [{"engine": "sampled"}, {"population_scope": "bounded_sample"},
+                                    {"metadata_scope": "sampled_schema"}])
+def test_large_sample_visibility_drop_passes_size_guard_and_records_counts(scope):
+    from jiuwenswarm.channels.web.dataagent.semantic.service import _validate_collection_size
+
+    previous = large_snapshot("before")
+    current = snapshot("after", scope=scope, include_optional=False)
+    _validate_collection_size(previous, current)
+    assert current.scope["collection_size_check"] == {
+        "status": "observed", "reason": "sampled_visibility_drop", "previous_objects": 33, "current_objects": 2,
+    }
+
+
+def test_large_complete_catalog_drop_still_blocks_publication():
+    from jiuwenswarm.channels.web.dataagent.semantic.service import _validate_collection_size
+
+    previous = large_snapshot("before", scope={"engine": "sampled"})
+    current = snapshot("after", scope={"engine": "sqlalchemy"}, include_optional=False)
+    with pytest.raises(RuntimeError, match="publish blocked"):
+        _validate_collection_size(previous, current)
+
+
+@pytest.mark.parametrize("impact_failure", [False, True])
+def test_run_publishes_small_sample_and_post_publish_impact_failure_cannot_undo_it(monkeypatch, impact_failure):
+    from jiuwenswarm.channels.web.dataagent.semantic import service
+    from jiuwenswarm.channels.web.dataagent.semantic.adapters.base import CollectionOptions
+    from jiuwenswarm.channels.web.dataagent.semantic.semantica import InMemorySemanticaAdapter
+
+    previous = large_snapshot("before", scope={"engine": "sampled"})
+    current = snapshot("after", scope={"engine": "sampled"}, include_optional=False)
+    updates, saved, closed, recorded_events = [], [], [], []
+    collector = SimpleNamespace(engine="sampled", collect=lambda *args: current, close=lambda: closed.append(True))
+    monkeypatch.setattr(service.workspace_context, "set_current", lambda workspace_id: "token")
+    monkeypatch.setattr(service.workspace_context, "reset", lambda token: None)
+    monkeypatch.setattr(service, "metadata_adapter_for", lambda row: collector)
+    monkeypatch.setattr(service.repository, "latest_published_snapshot", lambda source_id: previous)
+    monkeypatch.setattr(service.repository, "update_run", lambda run_id, **fields: updates.append(fields))
+    monkeypatch.setattr(service.repository, "save_snapshot", lambda snapshot, status, *args: saved.append(status))
+    monkeypatch.setattr(service.repository, "save_profiles", lambda *args: None)
+    monkeypatch.setattr(service.repository, "save_change_events", lambda run_id, source_id, events: recorded_events.extend(events))
+    monkeypatch.setattr(service.repository, "purge_value_dict", lambda *args, **kwargs: None)
+    monkeypatch.setattr(service, "extract_value_dict", lambda *args, **kwargs: [])
+    monkeypatch.setattr(service, "_sync_vectors", lambda *args: {"status": "ok"})
+
+    def propagate(*args):
+        if impact_failure:
+            raise RuntimeError("private-driver-details")
+        return []
+
+    monkeypatch.setattr(service.impact, "propagate", propagate)
+    graph = InMemorySemanticaAdapter()
+    service._execute("fixture", {"source_id": "source", "source_type": "mongodb"}, "run",
+                     CollectionOptions(schemas=()), graph)
+    assert saved == ["staged", "published"]
+    assert graph.published["physical/fixture/source"] == "snapshot:source:run"
+    assert updates[-1]["status"] == "published"
+    assert not any(update.get("status") == "failed" for update in updates)
+    assert not any(event.change_type == "removed" for event in recorded_events)
+    diagnostics = json.loads(updates[-1]["error_json"])
+    assert diagnostics["collection_scope"]["collection_size_check"]["current_objects"] == 2
+    assert len(diagnostics["collection_scope"]["change_observations"]["unconfirmed_removals"]) == 31
+    assert diagnostics["impact"]["status"] == ("failed" if impact_failure else "ok")
+    assert "private-driver-details" not in updates[-1]["error_json"]
+    assert closed == [True]
