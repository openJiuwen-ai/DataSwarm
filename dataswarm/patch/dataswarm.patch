@@ -0,0 +1,222 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { EChartsOption } from 'echarts';
+import { EChart } from './shared/EChart';
+import type { EChartEventMap } from './shared/EChart';
+import { FindingList, Panel } from './shared/Ui';
+import type { Finding, FindingsArtifact, ZscoreArtifact } from '../types/inspection';
+import { anomalyColor, CHART, CHART_TOOLTIP, MONO_FONT, QUALITY_HEATMAP, ZSCORE_CHART } from '../govTheme';
+
+/**
+ * 数据质量页（plan §7.3）。
+ *
+ *  - 表×类别热力图：x 轴 = 表，y 轴 = 质量类别，格子颜色 = 该表该类别的 finding 数。
+ *  - z-score 异常时序图：用 anomalies 数组画 x=bucket、y=metric_value 的散点，
+ *    超阈值点高亮（plan §3.3 spike 时序异常的可视化）。
+ */
+
+const CATEGORIES = ['null', 'uniqueness', 'distribution', 'business', 'freshness', 'timeseries'] as const;
+
+function tableOf(obj: unknown): string {
+  if (!obj || typeof obj !== 'object') return '';
+  const o = obj as Record<string, unknown>;
+  return typeof o.table === 'string' ? (o.table as string) : '';
+}
+
+/** 热力图格子权重：时序 finding 已按「表+指标」聚合，一条代表 N 个异常点，
+ *  格子仍按异常点数计量（不因聚合而变小）；旧产物逐点 finding 无该字段，计 1。 */
+function findingWeight(finding: Finding): number {
+  if (finding.category !== 'timeseries') return 1;
+  const n = (finding.evidence as { anomaly_count?: unknown } | undefined)?.anomaly_count;
+  return typeof n === 'number' && n > 0 ? n : 1;
+}
+
+export function QualityPage({ data, zscore, showFindings = true }: { data?: FindingsArtifact; zscore?: ZscoreArtifact; showFindings?: boolean }) {
+  const { t } = useTranslation();
+  const merged = useMemo(() => [...(data?.findings ?? []), ...(zscore?.findings ?? [])], [data, zscore]);
+
+  // 表×类别热力图
+  const heatmap = useMemo(() => {
+    const tables = [...new Set(merged.map(f => tableOf(f.object)).filter(Boolean))] as string[];
+    const cells: Array<[number, number, number]> = [];
+    tables.forEach((table, xi) => {
+      CATEGORIES.forEach((cat, yi) => {
+        const count = merged
+          .filter(f => tableOf(f.object) === table && f.category === cat)
+          .reduce((sum, f) => sum + findingWeight(f), 0);
+        if (count > 0) cells.push([xi, yi, count]);
+      });
+    });
+    return { tables, cells };
+  }, [merged]);
+
+  // x 轴表名横向展示后超长被截断，hover 标签时用浮层显示全名（axisLabel triggerEvent）
+  const [labelTip, setLabelTip] = useState<{ text: string; x: number; y: number } | null>(null);
+  const heatmapEvents = useMemo<EChartEventMap>(
+    () => ({
+      mouseover: (params) => {
+        const p = params as { targetType?: string; value?: string; event?: { event?: MouseEvent } };
+        if (p.targetType !== 'axisLabel' || typeof p.value !== 'string') return;
+        const e = p.event?.event;
+        if (e) setLabelTip({ text: p.value, x: e.clientX, y: e.clientY });
+      },
+      mouseout: (params) => {
+        const p = params as { targetType?: string };
+        if (p.targetType === 'axisLabel') setLabelTip(null);
+      },
+    }),
+    [],
+  );
+
+  const heatmapOption = useMemo<EChartsOption>(
+    () => ({
+      tooltip: {
+        ...CHART_TOOLTIP,
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        formatter: (p: any) => {
+          const [xi, yi, count] = (p?.value ?? [0, 0, 0]) as number[];
+          const category = CATEGORIES[yi];
+          return `${heatmap.tables[xi] ?? ''}<br/>${t('governance.dashboard.quality.tooltip.categoryFindingCount', {
+            category: category ? t(`governance.dashboard.quality.categories.${category}`) : '',
+            count,
+          })}`;
+        },
+      },
+      grid: { left: 88, right: 64, top: 12, bottom: 48 },
+      xAxis: {
+        type: 'category',
+        data: heatmap.tables,
+        // 轴级属性（非 axisLabel 子属性）：让 axisLabel 派发 mouseover/mouseout 事件
+        triggerEvent: true,
+        axisLine: { lineStyle: { color: QUALITY_HEATMAP.axis } },
+        axisLabel: {
+          interval: 0,
+          fontSize: 11,
+          width: 76,
+          overflow: 'truncate',
+          ellipsis: '…',
+          fontFamily: MONO_FONT,
+          color: CHART.muted,
+        },
+      },
+      yAxis: {
+        type: 'category',
+        data: CATEGORIES.map(category => t(`governance.dashboard.quality.categories.${category}`)),
+        axisLine: { lineStyle: { color: QUALITY_HEATMAP.axis } },
+        axisLabel: { fontSize: 11, color: CHART.body },
+      },
+      visualMap: {
+        min: 0,
+        max: Math.max(1, ...heatmap.cells.map(c => c[2])),
+        calculable: true,
+        orient: 'vertical',
+        right: 0,
+        top: 'middle',
+        itemWidth: 8,
+        itemHeight: 88,
+        inRange: { color: [...QUALITY_HEATMAP.colors] },
+        textStyle: { color: CHART.muted, fontFamily: MONO_FONT, fontSize: 10 },
+      },
+      series: [
+        {
+          type: 'heatmap',
+          data: heatmap.cells,
+          label: { show: true, fontSize: 10, color: QUALITY_HEATMAP.label },
+          labelLayout: { hideOverlap: true },
+        },
+      ],
+    }),
+    [heatmap, t],
+  );
+
+  // z-score 时序图：按高保真仅展示等大异常散点，时间范围由异常数据决定。
+  const anomalies = zscore?.anomalies ?? [];
+  const zscoreOption = useMemo<EChartsOption>(() => {
+    const sortedAnom = [...anomalies].sort((a, b) => a.bucket.localeCompare(b.bucket));
+    return {
+      tooltip: {
+        ...CHART_TOOLTIP,
+        trigger: 'item',
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        formatter: (p: any) => {
+          const d = p?.data ?? {};
+          const deviation = d.magnitude_relative_pct != null ? t('governance.dashboard.quality.tooltip.deviation', { value: d.magnitude_relative_pct }) : '';
+          return [
+            d.bucket ?? '',
+            t('governance.dashboard.quality.tooltip.actual', { value: d.metric_value ?? '' }),
+            t('governance.dashboard.quality.tooltip.expected', { value: d.expected_mean ?? '' }),
+            `Z = ${d.anomaly_score?.toFixed?.(2) ?? d.anomaly_score}${deviation}`,
+            t('governance.dashboard.quality.tooltip.direction', { value: d.direction ?? '' }),
+          ].join('<br/>');
+        },
+      },
+      textStyle: { fontFamily: '"PingFang SC", "Microsoft YaHei", sans-serif' },
+      grid: { left: 0, right: 0, top: 33, bottom: 0, containLabel: true },
+      xAxis: {
+        type: 'time',
+        boundaryGap: ['5%', '5%'],
+        axisLine: { lineStyle: { color: ZSCORE_CHART.line } },
+        axisTick: { show: false },
+        axisLabel: { formatter: '{yyyy}-{MM}', fontSize: 12, hideOverlap: true, color: ZSCORE_CHART.text },
+        splitLine: { show: false },
+      },
+      yAxis: {
+        type: 'value',
+        name: t('governance.dashboard.quality.rowsPerDay'),
+        nameTextStyle: { fontSize: 12, color: ZSCORE_CHART.text, align: 'right' },
+        axisLine: { show: false },
+        axisTick: { show: false },
+        axisLabel: { fontSize: 12, color: ZSCORE_CHART.text },
+        splitLine: { lineStyle: { color: ZSCORE_CHART.line, type: 'dashed', width: 1 } },
+      },
+      series: [
+        {
+          name: t('governance.dashboard.quality.anomalySeries'),
+          type: 'scatter',
+          data: sortedAnom.map(a => ({
+            value: [a.bucket, a.metric_value],
+            bucket: a.bucket,
+            metric: a.metric,
+            metric_value: a.metric_value,
+            anomaly_score: a.anomaly_score,
+            direction: a.direction,
+            expected_mean: (a as { expected_mean?: number }).expected_mean,
+            magnitude_relative_pct: (a as { magnitude_relative_pct?: number }).magnitude_relative_pct,
+          })),
+          symbolSize: 8,
+          emphasis: { scale: false },
+          // eslint-disable-next-line @typescript-eslint/no-explicit-any
+          itemStyle: { color: (p: any) => anomalyColor(p?.data?.anomaly_score ?? 2), opacity: 1, borderColor: '#fff', borderWidth: 1 },
+          z: 10,
+        },
+      ],
+    };
+  }, [anomalies, t]);
+
+  return (
+    <div className="space-y-4">
+      <div className="gov-chart-grid">
+        <Panel title={t('governance.dashboard.quality.heatmapTitle', { count: heatmap.tables.length })}>
+          <EChart option={heatmapOption} ariaLabel={t('governance.dashboard.quality.heatmapTitle', { count: heatmap.tables.length })} height={250} onEvents={heatmapEvents} />
+          {labelTip && (
+            <div
+              className="pointer-events-none fixed z-50 max-w-xs rounded border border-neutral-200 bg-white px-2 py-1 font-mono text-xs shadow"
+              style={{ left: labelTip.x + 12, top: labelTip.y + 12 }}
+            >
+              {labelTip.text}
+            </div>
+          )}
+        </Panel>
+        <Panel title={t('governance.dashboard.quality.zscoreTitle', { count: anomalies.length })}>
+          <EChart option={zscoreOption} ariaLabel={t('governance.dashboard.quality.zscoreTitle', { count: anomalies.length })} height={250} />
+        </Panel>
+      </div>
+      {showFindings && (
+        <Panel title={t('governance.dashboard.quality.findings', { count: merged.length })}>
+          <FindingList findings={merged} />
+        </Panel>
+      )}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/governance/components/SchemaPage.tsx b/jiuwenswarm/channels/web/frontend/src/features/governance/components/SchemaPage.tsx
