@@ -0,0 +1,203 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/guard.py —— 编译产物的多层校验（顺序固定，方案 §阶段 4）。
+
+校验顺序与职责：
+
+1. **只读与单语句**——复用 ``connectors/sql_guard.validate_read_only_sql``。
+2. **对象范围**——sqlglot 提取表与列，逐一比对绑定的 ``source_table`` 与
+   ``column_map``，越界即拒（反幽灵的编译期一半）。
+3. **口径约束**——``fixed_filters`` 的字段必须被 SQL 引用（内联 CASE WHEN 或
+   WHERE 都算）；``time.dimension`` 必须等于修订声明的 ``time_dimension``。
+4. **授权范围**——``workspace_context.validate_ref_in_workspace`` +
+   ``resolve_business_ref``，禁止兜底到元库。
+
+失败统一抛 :mod:`.errors` 里的具体类型，``detail`` 可直接回喂 LLM 自修正。
+"""
+from __future__ import annotations
+
+from typing import AbstractSet
+
+import sqlglot
+import sqlglot.expressions as exp
+
+from jiuwenswarm.channels.web.dataagent.connectors.sql_guard import validate_read_only_sql
+
+from .errors import PermissionDenied, QueryPlanError, SchemaChanged, SqlValidationError
+from .model import Binding, CompiledQuery, MetricRevision
+
+
+def check(compiled: CompiledQuery, revisions: list[MetricRevision],
+          bindings_by_revision: dict[str, list[Binding]]) -> dict:
+    """执行全部校验，返回可落库的 ``validation_json``。
+
+    Args:
+        compiled: 编译产物。
+        revisions: 参与查询的修订。
+        bindings_by_revision: ``revision_id -> 绑定列表``。
+
+    Returns:
+        ``{"checks": [...通过项...], "warnings": [...]}``。
+
+    Raises:
+        SqlValidationError: 只读/语法/对象范围失败。
+        QueryPlanError: 口径约束失败（时间维度不一致）。
+        SchemaChanged: 绑定表列与编译产物引用不一致。
+    """
+    steps: list[dict] = []
+
+    # 1. 只读与单语句（sql_guard 复用，方言按目标库）
+    validate_read_only_sql(compiled.sql, source_type=compiled.db_type)
+    steps.append({"name": "read_only", "status": "pass", "detail": ""})
+
+    parsed = sqlglot.parse_one(compiled.sql, read=compiled.dialect)
+
+    # 2. 对象范围：表与列都必须落在绑定集内
+    allowed_tables, allowed_columns = allowed_objects(revisions, bindings_by_revision)
+    _check_tables(parsed, allowed_tables)
+    _check_columns(parsed, allowed_columns)
+    steps.append({"name": "object_scope", "status": "pass", "detail": "",
+                  "tables": sorted(allowed_tables), "columns": sorted(allowed_columns)})
+
+    # 3. 口径约束
+    warnings = _check_caliber(parsed, compiled, revisions, bindings_by_revision)
+    steps.append({"name": "caliber", "status": "pass", "detail": "",
+                  "warnings": warnings})
+
+    return {"checks": steps, "warnings": warnings}
+
+
+def check_authorization(datasource_ref: str, workspace_id: str) -> str:
+    """授权校验：数据源必须归属当前工作空间，并返回规范化的业务库 ref。
+
+    授权边界即 workspace 双库（config workspaces 段的 business/metadata ref），
+    **不在此扩权**：需要新数据源时新建工作空间绑定（multi-workspace 机制），
+    而不是在本层加旁路。
+
+    Raises:
+        PermissionDenied: 数据源不在工作空间内。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        # 签名 (workspace_id, role, db_ref)，返回归属校验后的规范化 ref
+        return workspace_context.validate_ref_in_workspace(
+            workspace_id, "business", datasource_ref)
+    except Exception as exc:  # noqa: BLE001 —— 统一转成本模块权限错误
+        raise PermissionDenied(
+            f"数据源 {datasource_ref} 不在 workspace {workspace_id} 的授权范围内: {exc}") from exc
+
+
+# ==========================================================================
+# 内部
+# ==========================================================================
+def allowed_objects(
+    revisions: list[MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+) -> tuple[set[str], set[str]]:
+    """绑定允许集：表名与列名均收（逻辑名 + 物理名尾段）双形态。
+
+    analysis/checks 共用此函数（同一允许集口径，勿就地重抄）。
+    """
+    tables: set[str] = set()
+    columns: set[str] = set()
+    for rev in revisions:
+        for binding in bindings_by_revision.get(rev.revision_id, ()):
+            if binding.source_table:
+                tables.add(binding.source_table.split(".")[-1])
+            for logical, physical in binding.column_map.items():
+                columns.add(logical)
+                # 物理名取尾段：sqlglot 的 column.name 恒为裸列名，完整限定名
+                # （orders.amount_cny）永远匹配不上——别名绑定（逻辑名≠尾段）时
+                # 合法的编译产物会被误判越界。与 analysis/checks 同口径。
+                columns.add(physical.split(".")[-1])
+    return tables, columns
+
+
+def cte_names(parsed: sqlglot.Expr) -> set[str]:
+    """SQL 内 CTE 名集合——CTE 是查询内临时表，不是物理表，不做 scope 比对。"""
+    return {cte.alias_or_name for cte in parsed.find_all(exp.CTE)}
+
+
+def out_of_scope_tables(parsed: sqlglot.Expr, allowed_tables: set[str]) -> list[str]:
+    """SQL 引用的表中越界者（按出现序）；允许集为空视为不设防（无绑定/无快照不拦）。
+
+    CTE 名不算越界（修复 2e2fe4df7：WITH t AS (...) 引用 t 曾被误判为 scope
+    越界表——CTE 是查询内临时表而非物理表）。
+    """
+    _ctes = cte_names(parsed)
+    return [
+        table.name for table in parsed.find_all(exp.Table)
+        if table.name and table.name not in _ctes
+        and allowed_tables and table.name not in allowed_tables
+    ]
+
+
+def out_of_scope_columns(
+    parsed: sqlglot.Expr, allowed_columns: set[str],
+    *, column_exempt: AbstractSet[str] = frozenset(),
+) -> list[str]:
+    """SQL 引用的列中越界者（按出现序）；column_exempt 豁免（如 SELECT 别名）。
+
+    允许集为空同样视为不设防。
+    """
+    return [
+        column.name for column in parsed.find_all(exp.Column)
+        if column.name and column.name not in column_exempt
+        and allowed_columns and column.name not in allowed_columns
+    ]
+
+
+def _check_tables(parsed: sqlglot.Expr, allowed_tables: set[str]) -> None:
+    """FROM/JOIN 里出现的表必须都在绑定表集合内。"""
+    bad_tables = out_of_scope_tables(parsed, allowed_tables)
+    if bad_tables:
+        raise SqlValidationError(
+            f"SQL 引用了未绑定的表 {bad_tables[0]}（允许: {', '.join(sorted(allowed_tables))}）")
+
+
+def _check_columns(parsed: sqlglot.Expr, allowed_columns: set[str]) -> None:
+    """引用的列必须都在绑定列集合内（列级反幽灵）。"""
+    bad_columns = out_of_scope_columns(parsed, allowed_columns)
+    if bad_columns:
+        raise SchemaChanged(
+            f"SQL 引用了绑定清单之外的列 {bad_columns[0]}"
+            f"（允许: {', '.join(sorted(allowed_columns))}）")
+
+
+def _check_caliber(
+    parsed: sqlglot.Expr,
+    compiled: CompiledQuery,
+    revisions: list[MetricRevision],
+    bindings_by_revision: dict[str, list[Binding]],
+) -> list[str]:
+    """口径约束：固定过滤字段必须被引用；时间维度必须与声明一致。
+
+    Ossie 的固定条件通常**内联**在表达式里（``CASE WHEN pay_status='PAID'``），
+    而不是出现在 WHERE——所以校验口径是「过滤字段被 SQL 引用」，
+    WHERE 出现与否不算失败，但缺失引用算。
+    """
+    warnings: list[str] = []
+    referenced = {c.name for c in parsed.find_all(exp.Column) if c.name}
+
+    for rev in revisions:
+        for flt in rev.fixed_filters:
+            field = str(flt.get("field") or "")
+            if not field:
+                continue
+            column = field.split(".")[-1]
+            if column not in referenced:
+                raise QueryPlanError(
+                    f"指标 {rev.definition_ref} 的固定过滤字段 {field} "
+                    f"未被 SQL 引用——口径约束被绕过")
+        if compiled.time_column and rev.time_dimension:
+            spec_dim = compiled.time_column.split(".")[-1]
+            declared = rev.time_dimension.split(".")[-1]
+            if spec_dim != declared:
+                raise QueryPlanError(
+                    f"查询时间维度 {compiled.time_column} 与指标 {rev.definition_ref} "
+                    f"声明的 {rev.time_dimension} 不一致")
+        if not rev.expression.parsed and rev.expression.unparsed_reason:
+            warnings.append(
+                f"{rev.definition_ref} 的表达式未解析（{rev.expression.unparsed_reason}），"
+                "口径以 DataSwarm 定义原文为准")
+    return warnings
