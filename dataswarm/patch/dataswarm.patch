+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 维度新建/编辑抽屉。 */
+
+import { useState } from 'react';
+import { useDashboardStore } from '../store/dashboardStore';
+import { Button, Field, inputClass } from '../../_shared/ui';
+import type { DimensionDef } from '../types/dashboard';
+import { X } from 'lucide-react';
+
+interface DimensionFormDrawerProps {
+  dimension: DimensionDef | null;
+  onClose: () => void;
+  onSaved: () => void;
+}
+
+export function DimensionFormDrawer({ dimension, onClose, onSaved }: DimensionFormDrawerProps) {
+  const store = useDashboardStore();
+  const isEdit = !!dimension;
+  const [name, setName] = useState(dimension?.name || '');
+  const [label, setLabel] = useState(dimension?.label || '');
+  const [description, setDescription] = useState(dimension?.description || '');
+  const [dimType, setDimType] = useState(dimension?.dim_type || 'category');
+  const [valueSource, setValueSource] = useState<'sql' | 'manual'>(dimension?.value_source || 'manual');
+  const [valueSql, setValueSql] = useState(dimension?.value_sql || '');
+  const [valueListText, setValueListText] = useState(
+    dimension?.value_list ? (Array.isArray(dimension.value_list) ? dimension.value_list.join(', ') : '') : ''
+  );
+  const [datasourceRef] = useState(dimension?.datasource_ref || '');
+
+  const handleSave = async () => {
+    const data: Record<string, unknown> = {
+      name, label, description, dim_type: dimType, value_source: valueSource, datasource_ref: datasourceRef || undefined,
+    };
+    if (valueSource === 'sql') {
+      data.value_sql = valueSql;
+    } else {
+      data.value_list = valueListText.split(',').map((s) => s.trim()).filter(Boolean);
+    }
+    if (isEdit && dimension) {
+      await store.updateDimension(dimension.dimension_id, data);
+    } else {
+      await store.createDimension(data);
+    }
+    onSaved();
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex justify-end bg-black/50" onClick={onClose}>
+      <div className="w-full max-w-md overflow-auto bg-card p-6 shadow-xl" onClick={(e) => e.stopPropagation()}>
+        <div className="mb-4 flex items-center justify-between">
+          <h3 className="text-lg font-semibold text-text-strong">{isEdit ? '编辑维度' : '新建维度'}</h3>
+          <button className="rounded p-1 text-text-muted hover:bg-secondary" onClick={onClose}><X size={18} /></button>
+        </div>
+
+        <div className="space-y-4">
+          <Field label="维度名称">
+            <input className={inputClass} value={name} onChange={(e) => setName(e.target.value)} placeholder="如：region" />
+          </Field>
+          <Field label="显示标签">
+            <input className={inputClass} value={label} onChange={(e) => setLabel(e.target.value)} placeholder="如：地区" />
+          </Field>
+          <Field label="维度类型">
+            <select className={inputClass} value={dimType} onChange={(e) => setDimType(e.target.value as any)}>
+              <option value="category">分类</option>
+              <option value="time">时间</option>
+              <option value="region">地区</option>
+            </select>
+          </Field>
+          <Field label="值来源">
+            <select className={inputClass} value={valueSource} onChange={(e) => setValueSource(e.target.value as any)}>
+              <option value="manual">手动输入</option>
+              <option value="sql">SQL查询</option>
+            </select>
+          </Field>
+          {valueSource === 'sql' ? (
+            <Field label="取值SQL">
+              <textarea className={`${inputClass} h-24 font-mono text-xs`} value={valueSql} onChange={(e) => setValueSql(e.target.value)} placeholder="SELECT DISTINCT region AS v FROM ..." />
+            </Field>
+          ) : (
+            <Field label="值列表（逗号分隔）">
+              <input className={inputClass} value={valueListText} onChange={(e) => setValueListText(e.target.value)} placeholder="如：华东, 华南, 华北" />
+            </Field>
+          )}
+          <Field label="描述">
+            <textarea className={`${inputClass} h-16`} value={description} onChange={(e) => setDescription(e.target.value)} placeholder="维度说明" />
+          </Field>
+        </div>
+
+        <div className="mt-6 flex justify-end gap-2">
+          <Button variant="ghost" onClick={onClose}>取消</Button>
+          <Button variant="primary" onClick={() => void handleSave()}>{isEdit ? '保存' : '创建'}</Button>
+        </div>
+      </div>
+    </div>
+  );
+}
