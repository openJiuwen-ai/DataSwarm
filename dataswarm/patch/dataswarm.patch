@@ -0,0 +1,319 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Semantic recall must not confuse repeated table names across namespaces."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.metrics import graph_projection, store
+from jiuwenswarm.channels.web.dataagent.metrics import semantic_link
+from jiuwenswarm.channels.web.dataagent.metrics.model import Binding, MetricDef, MetricRevision, Release
+from jiuwenswarm.channels.web.dataagent.metrics.semantic_link import core
+from jiuwenswarm.channels.web.dataagent.semantic import vector_store
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    DataSourceMeta,
+    MetadataSnapshot,
+    TableMeta,
+)
+
+
+def _snapshot(source_id="source", schemas=("sales", "archive")):
+    tables = [TableMeta(
+        source_id, "postgresql", schema, "orders",
+        columns=[ColumnMeta(source_id, "postgresql", schema, "orders", "amount")],
+    ) for schema in schemas]
+    return MetadataSnapshot("snapshot", "run", DataSourceMeta(source_id, "postgresql", ""),
+                            tables=tables)
+
+
+def _recall(monkeypatch, tables):
+    monkeypatch.setattr(vector_store, "recall", lambda *a, **k: {"tables": tables, "warnings": []})
+
+
+def test_snapshot_index_retains_exact_ids_and_rejects_ambiguous_bare_names():
+    snapshot = _snapshot()
+    index = semantic_link.snapshot_index({"source": snapshot})
+    for table in snapshot.tables:
+        assert semantic_link._resolve_table_node_id(index, "source", table.node_id) == table.node_id
+        assert semantic_link._resolve_table_node_id(index, "source", table.fqn) == table.node_id
+        assert semantic_link._resolve_column_node_id(index, "source", table.node_id, "amount") == table.columns[0].node_id
+    assert semantic_link._resolve_table_node_id(index, "source", "orders") == ""
+    assert semantic_link._resolve_column_node_id(index, "source", "orders", "amount") == ""
+    assert semantic_link.anchor_to_snapshot(index, "orders", {"amount": "orders.amount"}) == ("", {})
+
+
+def test_embedding_hits_prefer_full_identity_and_never_fallback_from_stale_id(monkeypatch):
+    snapshot = _snapshot()
+    sales, archive = snapshot.tables
+    _recall(monkeypatch, [
+        {"table_id": sales.node_id, "table_fqn": archive.fqn, "table_name": "orders", "score": .8,
+         "columns": [{"column_name": "amount", "score": .8, "emb_via": "金额"}]},
+        {"table_id": archive.node_id, "table_name": "orders", "score": .7},
+        {"table_id": "tbl:postgresql:source:removed.orders", "table_fqn": sales.fqn,
+         "table_name": "orders", "score": .99},
+    ])
+    hits, warnings = semantic_link.emb_schema_hits("ws", "问题", {"source": snapshot})
+    assert warnings == []
+    assert hits == {sales.columns[0].node_id: (.8, "金额"), archive.node_id: (.7, "")}
+
+
+def test_embedding_fqn_and_legacy_bare_name_match_only_without_ambiguity(monkeypatch):
+    snapshot = _snapshot()
+    _recall(monkeypatch, [
+        {"table_fqn": "sales.orders", "table_name": "orders", "score": .7},
+        {"table_name": "orders", "score": .99,
+         "columns": [{"column_name": "amount", "score": .99}]},
+    ])
+    hits, _ = semantic_link.emb_schema_hits("ws", "问题", {"source": snapshot})
+    assert hits == {snapshot.tables[0].node_id: (.7, "")}
