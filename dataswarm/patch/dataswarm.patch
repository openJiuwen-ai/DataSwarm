+          rememberSessionScrollTop(currentSessionId, el);
+        }
+      } else {
+        visibilityRestoredAtRef.current = Date.now();
+        if (el) {
+          restoreSessionScrollTop(currentSessionId, el);
+        }
+      }
+    };
