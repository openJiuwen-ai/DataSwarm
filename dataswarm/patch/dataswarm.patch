@@ -0,0 +1,49 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Route PowerShell-shaped commands to PowerShell in openjiuwen's auto shell detection.
+
+openjiuwen ``ShellOperation``（agent ``bash`` 工具背后的执行层）用一份很小的
+token 白名单判定 ``shell_type=auto`` 该用哪个 shell。形如
+``Copy-Item a.csv b.csv -Force; python x.py`` 的命令既不在 PowerShell 白名单
+（缺 copy-item/get-item 等常用 cmdlet）、也不在 POSIX 命令集里，于是回落到
+cmd.exe 执行，报 ``'Copy-Item' is not recognized as an internal or external
+command``。
+
+本模块用 ``command_tools`` 里的 Verb-Noun cmdlet 模式扩展其
+``_looks_like_powershell``。直接改 site-packages 会被 ``uv sync`` 还原，
+所以沿用本仓库 patch openjiuwen 的既有模式（参见 ``bash_tool_safety``）。
+"""
+
+from __future__ import annotations
+
+from jiuwenswarm.agents.harness.common.tools.command_tools import _has_cmdlet_segment
+
+_installed = False
+
+
+def install_powershell_routing_patch() -> None:
+    """Idempotently extend openjiuwen ``_looks_like_powershell`` with cmdlet detection."""
+    global _installed
+
+    import openjiuwen.core.sys_operation.local.shell_operation as shell_operation
+
+    if not getattr(
+        shell_operation._looks_like_powershell, "jiuwenswarm_cmdlet_patched", False
+    ):
+        original = shell_operation._looks_like_powershell
+
+        def looks_like_powershell(command: str) -> bool:
+            return original(command) or _has_cmdlet_segment(command)
+
+        looks_like_powershell.jiuwenswarm_cmdlet_patched = True
+        shell_operation._looks_like_powershell = looks_like_powershell
+    _installed = True
+
+
+def reset_installed_flag() -> None:
+    """Reset the installed flag so hooks can be re-applied (for testing)."""
+    global _installed
+    _installed = False
+
+
+__all__ = ["install_powershell_routing_patch", "reset_installed_flag"]
