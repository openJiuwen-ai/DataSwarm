+            {"protocol": "ftp", "host": "h", "port": 21, "user": "u",
+             "password": "p", "path": path, "format": "csv"},
+        )
+        return sc.StagedFileConnector(source)
+
+    for bad in ("/data/../../etc/*.csv", "../*.csv", "/a/../b/*.csv"):
+        with pytest.raises(ConnectorError):
+            make(bad).stage()
+    # 合法路径不会在这一步被拦（后续才去连远端，这里只取 pattern）
