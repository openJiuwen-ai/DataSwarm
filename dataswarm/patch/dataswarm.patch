+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage 模块分层单测。
+
+覆盖：
+  - service 层：图构建（nodes/edges 丰富、layer 推断、行数回填、store 异常容错）
+  - controller 层：6 个 HTTP 路由的参数解析与委托
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import urlparse
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.lineage import controller as ctrl
+from jiuwenswarm.channels.web.dataagent.lineage import service as svc
+
+
+# --------------------------------------------------------------------------
+# Fake handler —— 捕获 _write_json 调用
+# --------------------------------------------------------------------------
+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    """模拟 BaseHTTPRequestHandler 子类，仅保留 controller 用到的方法。"""
+
+    def __init__(self, path: str, body: bytes | None = b"", response: FakeResponse | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        self.rfile = _FakeRfile(body or b"")
+        self.headers = {"Content-Length": str(len(body or b""))}
+        self._resp = response or FakeResponse()
+
+    def _write_json(self, status, payload):
+        self._resp.capture(status, payload)
+
+    def _query_arg(self, parsed, name):
+        qs = self.parsed.query
+        for pair in qs.split("&"):
+            if "=" in pair:
+                k, v = pair.split("=", 1)
+                if k == name:
+                    return v
+        return None
+
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, n):
+        return self._data[:n]
+
+
+# --------------------------------------------------------------------------
+# service 层测试
+# --------------------------------------------------------------------------
+class _FakeStore:
+    """替身 store，可控返回 list/save/delete 结果。"""
+
+    def __init__(self, table_rows=None, column_rows=None,
+                 save_count=0, delete_count=0,
+                 raise_on_list=False):
+        self._table_rows = table_rows or []
+        self._column_rows = column_rows or []
+        self.save_count = save_count
+        self.delete_count = delete_count
+        self.raise_on_list = raise_on_list
+        self.last_saved_edges = None
+        self.last_deleted = None
+        self.last_plan_id = None
+        self.last_business_ref = None
+
+    def list_table_lineage(self, db_name, plan_id=None, business_ref=None):
+        if self.raise_on_list:
+            raise RuntimeError("store boom")
+        self.last_plan_id = plan_id
+        self.last_business_ref = business_ref
+        return self._table_rows
+
+    def list_column_lineage(self, db_name, table_name="", business_ref=None):
+        if self.raise_on_list:
+            raise RuntimeError("store boom")
+        self.last_business_ref = business_ref
+        return self._column_rows
+
+    def save_table_lineage(self, edges):
+        self.last_saved_edges = edges
+        return self.save_count
+
+    def save_column_lineage(self, edges):
+        self.last_saved_edges = edges
+        return self.save_count
+
+    def delete_table_lineage(self, plan_id, task_id):
+        self.last_deleted = (plan_id, task_id)
+        return self.delete_count
+
+    def delete_column_lineage(self, plan_id, task_id):
+        self.last_deleted = (plan_id, task_id)
+        return self.delete_count
+
+
+@pytest.fixture
+def patch_store(monkeypatch):
+    """返回一个 setter，用 monkeypatch 替换 service._get_store。"""
+    def _set(store):
+        monkeypatch.setattr(svc, "_get_store", lambda: store)
+        return store
+    return _set
+
+
+@pytest.fixture
+def single_workspace(monkeypatch):
+    """Pin 单空间上下文（业务库 doris://h/olist）：绕开本机多 workspace 记录。
+
+    read_table_lineage 入口 _resolve_db_name → workspace_context.resolve 无
+    workspace_id 时，多空间配置抛 WorkspaceContextRequired（被吞成空图）——
+    service 层用例测的是图构建逻辑，不测空间解析，这里固定返回单空间。
+    """
+    from jiuwenswarm.common import workspace_context
