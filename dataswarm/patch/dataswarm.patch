+class FakeFAISS:
+    """In-memory vector interface with actual dot-product retrieval, no FAISS import."""
+
+    def __init__(self):
+        self.index = SimpleNamespace(metadata={})
+        self.vectors = {}
+        self.saved = []
+
+    def add_vectors(self, vectors, ids=None, metadata=None):
+        for vector_id, vector, meta in zip(ids, vectors, metadata):
+            self.vectors[vector_id] = tuple(float(value) for value in vector)
+            self.index.metadata[vector_id] = dict(meta)
+
+    def delete_vectors(self, ids):
+        for vector_id in ids:
+            self.vectors.pop(vector_id, None)
+            self.index.metadata.pop(vector_id, None)
+
+    def save_index(self, path):
+        self.saved.append(path)
+
+    def search_similar(self, query_vector, k=10):
+        results = [{"id": vector_id, "metadata": self.index.metadata[vector_id],
+                    "distance": sum(left * float(right) for left, right in zip(vector, query_vector))}
+                   for vector_id, vector in self.vectors.items()]
+        return sorted(results, key=lambda result: -result["distance"])[:k]
+
