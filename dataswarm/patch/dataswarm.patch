@@ -0,0 +1,77 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { EChartsOption } from 'echarts';
+import { useTranslation } from 'react-i18next';
+import { EChart } from './shared/EChart';
+import { FindingList, Panel, Empty } from './shared/Ui';
+import type { FindingsArtifact } from '../types/inspection';
+import { CHART_TOOLTIP, SCHEMA_CHART } from '../govTheme';
+
+export function SchemaPage({ artifact, showFindings = true }: { artifact?: FindingsArtifact; showFindings?: boolean }) {
+  const { t } = useTranslation();
+  const tables = artifact?.meta?.inspected_tables ?? [];
+  // 分层口径须与后端 _doris_infer_layer / dw_layer_registry 一致：
+  //   ODS    = ods_ 前缀（清洗接入层）
+  //   DWD/DWS/ADS = 各自前缀
+  // 旧实现误把 ODS 判断写成 olist_ 前缀（实为 SOURCE），导致 ODS 恒为 0。
+  // 无前缀的源系统镜像表（olist_* 等）不进分层资产图：巡检/治理对象只有分层表。
+  const inferLayer = (t: string): string => {
+    const low = t.toLowerCase();
+    if (low.startsWith('dwd_')) return 'DWD';
+    if (low.startsWith('dws_')) return 'DWS';
+    if (low.startsWith('ads_')) return 'ADS';
+    if (low.startsWith('ods_')) return 'ODS';
+    return 'SOURCE';
+  };
+  const layers = ['ODS', 'DWD', 'DWS', 'ADS'];
+  const counts = layers.map(layer => tables.filter(t => inferLayer(t) === layer).length);
+  const option: EChartsOption = {
+    tooltip: { ...CHART_TOOLTIP, trigger: 'axis', axisPointer: { type: 'none' } },
+    grid: { left: 24, right: 0, top: 28, bottom: 28 },
+    xAxis: {
+      type: 'category',
+      data: layers,
+      axisLabel: { color: SCHEMA_CHART.text, fontSize: 12, margin: 14 },
+      axisLine: { lineStyle: { color: SCHEMA_CHART.line } },
+      axisTick: { show: false },
+    },
+    yAxis: {
+      type: 'value',
+      minInterval: 1,
+      name: t('governance.dashboard.schema.unit'),
+      nameLocation: 'end',
+      nameTextStyle: { color: SCHEMA_CHART.text, fontSize: 12, align: 'right' },
+      axisLabel: { color: SCHEMA_CHART.text, fontSize: 12, margin: 12 },
+      axisLine: { show: false },
+      axisTick: { show: false },
+      splitLine: { lineStyle: { color: SCHEMA_CHART.line, type: 'dashed' } },
+    },
+    series: [
+      {
+        type: 'bar',
+        name: t('governance.dashboard.schema.assetCount'),
+        barWidth: 16,
+        data: counts,
+        itemStyle: { color: SCHEMA_CHART.bar },
+        label: { show: false },
+      },
+    ],
+  };
+  return (
+    <div className={`grid gap-4 ${showFindings ? 'xl:grid-cols-[minmax(0,1fr)_minmax(360px,1fr)]' : ''}`}>
+      <Panel title={t('governance.dashboard.schema.assetCount')} className="gov-schema-chart">
+        {artifact ? (
+          <EChart option={option} ariaLabel={t('governance.dashboard.charts.layerAssets')} height={250} />
+        ) : (
+          <div className="gov-chart-empty">
+            <Empty text={t('governance.dashboard.schema.waiting')} />
+          </div>
+        )}
+      </Panel>
+      {showFindings && (
+        <Panel title={t('governance.dashboard.schema.findings', { count: artifact?.findings.length ?? 0 })}>
+          <FindingList findings={artifact?.findings ?? []} />
+        </Panel>
+      )}
+    </div>
+  );
+}
