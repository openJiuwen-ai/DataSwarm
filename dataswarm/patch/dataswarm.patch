+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""inspection 端点单测（方案 §4：findings 检索端点）。
+
+service 层契约（persist_run/persist_fixes/query_findings）由 test_inspection_service.py 覆盖。
+本文件只测 GET /api/inspection/findings 列表检索端点（经 FakeHandler 直测 controller 入口），
+POST persist/fix-persist 的路由命中 + 参数校验靠 curl 冒烟（批次末）。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import urlparse, parse_qs
+
+import pytest
+
+
+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    def __init__(self, path: str, body: dict | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        self._body = json.dumps(body).encode() if body else b""
+        self._resp = FakeResponse()
+
+    def _write_json(self, status, payload):
+        self._resp.capture(status, payload)
+
+    def _read_body_json(self) -> dict:
+        if not self._body:
+            return {}
+        return json.loads(self._body.decode())
+
+    @staticmethod
+    def _parse_query(query: str) -> dict[str, str]:
+        return {k: v[0] for k, v in parse_qs(query).items()}
+
+    @staticmethod
+    def _inspection_meta_ref(workspace_id=None):
+        """与 app_web._SpaStaticHandler._inspection_meta_ref 同签名（FakeHandler 补齐）。"""
+        from jiuwenswarm.common import db_connector as _dc
+        ref = _dc.metadata_db_ref()
+        return (ref, None) if ref else (None, "metadata_db_not_configured")
+
+    @property
+    def response(self):
+        return self._resp
+
+
+@pytest.fixture
+def patch_inspection_service(monkeypatch):
+    """替换 inspection_service.query_findings + db_connector.metadata_db_ref。"""
+    from jiuwenswarm.channels.web import inspection_service as svc
+    calls = []
+
+    def fake_query_findings(meta_db_ref, run_id, selector=None, keyword=None, limit=20):
+        calls.append(("query_findings", meta_db_ref, run_id, selector, keyword, limit))
+        return [{"finding_uid": "u1", "dimension": "schema", "summary": "x",
+                 "object": {"table": "t1"}}]
+
+    def fake_meta_db_ref():
+        return "sqlite:///meta.db"
+
+    monkeypatch.setattr(svc, "query_findings", fake_query_findings)
+    import jiuwenswarm.common.db_connector as dc
+    monkeypatch.setattr(dc, "metadata_db_ref", fake_meta_db_ref)
+    return calls
+
+
+# --------------------------------------------------------------------------
+# GET /api/inspection/findings（列表检索）
+# --------------------------------------------------------------------------
+def test_get_findings_list(patch_inspection_service):
+    """GET /api/inspection/findings?run_id=&q=&limit= → query_findings 列表。"""
+    from jiuwenswarm.channels.web.app_web import _SpaStaticHandler as H
+    h = FakeHandler("/api/inspection/findings?run_id=run-x&q=nullable&limit=5")
+    H._handle_inspection_api_get(h, h.parsed)
+    assert h.response.status == 200
+    assert "findings" in h.response.payload
+    assert len(h.response.payload["findings"]) == 1
+    _, meta_ref, run_id, selector, keyword, limit = patch_inspection_service[0]
+    assert run_id == "run-x"
+    assert keyword == "nullable"
+    assert limit == 5
