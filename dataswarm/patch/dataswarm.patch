+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import dagre from '@dagrejs/dagre';
+
+export type WorkflowGraphDensity = 'comfortable' | 'compact';
+
+export const WORKFLOW_GRAPH_METRICS = {
+  comfortable: { width: 312, height: 152, nodeGap: 64, rankGap: 100 },
+  compact: { width: 260, height: 96, nodeGap: 24, rankGap: 48 },
+} as const;
+
+export interface WorkflowTopologyNode {
+  id: string;
+  parents: readonly string[];
+}
+
+/** Presentation data only; callers own task definitions, runs and persistence. */
+export interface WorkflowGraphNode extends WorkflowTopologyNode {
+  label: string;
+  taskLabel: string;
+  group?: string;
+  executor?: string;
+  waitReview?: boolean;
+  status?: string;
+  durationS?: number | null;
+  failureRole?: 'source' | 'blocked';
+}
+
+export function buildGraphAdj(nodes: readonly WorkflowTopologyNode[]) {
+  const downstream = new Map(nodes.map((node) => [node.id, [] as string[]]));
+  const upstream = new Map(nodes.map((node) => [node.id, [] as string[]]));
+  for (const node of nodes) {
+    for (const parent of node.parents) {
+      if (!downstream.has(parent)) throw new Error(`Unknown dependency: ${parent}`);
+      downstream.get(parent)!.push(node.id);
+      upstream.get(node.id)!.push(parent);
+    }
+  }
+  return { downstream, upstream };
+}
+
+export function reachable(start: string, adj: ReadonlyMap<string, readonly string[]>): Set<string> {
+  const seen = new Set<string>();
+  const queue = [start];
+  for (let index = 0; index < queue.length; index++) {
+    const id = queue[index];
+    if (seen.has(id)) continue;
+    seen.add(id);
+    queue.push(...(adj.get(id) ?? []));
+  }
+  return seen;
+}
+
+/** Dependency depth determines rows; Dagre orders and spaces nodes within them. */
+export function layoutWorkflowGraph(
+  nodes: readonly WorkflowTopologyNode[],
+  density: WorkflowGraphDensity = 'comfortable',
+): Record<string, { x: number; y: number }> {
+  const metrics = WORKFLOW_GRAPH_METRICS[density];
+  const graph = new dagre.graphlib.Graph().setDefaultEdgeLabel(() => ({}));
+  // Reverse edges and render BT so the longest-path ranker ranks from roots.
+  graph.setGraph({
+    rankdir: 'BT',
+    ranker: 'longest-path',
+    nodesep: metrics.nodeGap,
+    ranksep: metrics.rankGap,
+    marginx: 36,
+    marginy: 36,
+  });
+  nodes.forEach((node) => graph.setNode(node.id, { width: metrics.width, height: metrics.height }));
+  nodes.forEach((node) => node.parents.forEach((parent) => graph.setEdge(node.id, parent)));
+  dagre.layout(graph);
+  return Object.fromEntries(
+    nodes.map((node) => {
+      const position = graph.node(node.id);
+      return [node.id, { x: position.x - metrics.width / 2, y: position.y - metrics.height / 2 }];
+    }),
+  );
+}
+
+export function removeGraphElements<T extends WorkflowTopologyNode>(
+  nodes: readonly T[],
+  removedNodes: ReadonlySet<string>,
+  removedEdges: readonly { source: string; target: string }[],
+): T[] {
+  return nodes
+    .filter((node) => !removedNodes.has(node.id))
+    .map((node) => ({
+      ...node,
+      parents: node.parents.filter(
+        (parent) =>
+          !removedNodes.has(parent) && !removedEdges.some((edge) => edge.source === parent && edge.target === node.id),
+      ),
+    }));
+}
+
+export const graphEdgeId = (source: string, target: string) => JSON.stringify([source, target]);
