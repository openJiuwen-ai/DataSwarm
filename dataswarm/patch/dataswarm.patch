+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""SQLite 业务库路径解析：db-ref URI / 绝对路径 / 纯库名三种形态。
+
+事故背景（dacomp 评测）：databases API 把完整 db-ref（sqlite://D:/…）传给
+SQLite DAO，旧 `_local_db_path` 固定拼 ``<workspace>/data/<db_name>.db``，
+拼出 ``data/sqlite://D:/….db`` 恒不存在 → 表清单永远为空，模型只能手工
+查 sqlite_master 绕过。
+"""
+from jiuwenswarm.channels.web.dataagent.business_data.sqlite_impl import SqliteBusinessDao
+
+
+class TestLocalDbPath:
+    def test_sqlite_uri_resolves_to_absolute_path(self):
+        path = SqliteBusinessDao._local_db_path(
+            "sqlite://D:/eval/dacomp/dacomp-zh-001.sqlite")
+        assert str(path).replace("\\", "/") == "D:/eval/dacomp/dacomp-zh-001.sqlite"
+
+    def test_bare_absolute_path(self):
+        path = SqliteBusinessDao._local_db_path("D:/eval/x.sqlite")
+        assert str(path).replace("\\", "/") == "D:/eval/x.sqlite"
+
+    def test_plain_name_uses_workspace_data_dir(self):
+        path = SqliteBusinessDao._local_db_path("olist")
+        assert path.name == "olist.db"
+        assert path.parent.name == "data"
