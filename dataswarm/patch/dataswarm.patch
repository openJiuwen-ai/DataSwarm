+class _FakeStore:
+    """内存版 store：模拟元数据库 CRUD，供 service 编排层单测。"""
+
+    def __init__(self):
+        self.rows: dict[str, dict] = {}
+
+    def list_sources(self, workspace_id=None):
+        return list(self.rows.values())
+
+    def get_source(self, source_id, workspace_id=None):
+        return self.rows.get(source_id)
+
+    def find_source(self, source_id, workspace_id=None):
+        return self.get_source(source_id)
+
+    def insert_source(self, source_id, source_type, name, config, db_ref, workspace_id=None,
+                      description=""):
+        if source_id in self.rows:
+            raise ValueError(f"source_id already exists: {source_id}")
+        self.rows[source_id] = {
+            "source_id": source_id, "source_type": source_type, "name": name,
+            "description": description,
+            "config": dict(config), "db_ref": db_ref,
+            "created_at": "2026-01-01", "updated_at": "2026-01-01",
+        }
+        return {"source_id": source_id, "db_ref": db_ref}
+
+    def update_source_row(self, source_id, source_type, name, config, db_ref, workspace_id=None,
+                          description=""):
+        if source_id not in self.rows:
+            raise ValueError(f"source not found: {source_id}")
+        row = self.rows[source_id]
+        row.update({"source_type": source_type, "description": description,
+                    "config": dict(config), "db_ref": db_ref})
+        return {"source_id": source_id, "db_ref": db_ref}
+
+    def delete_source_row(self, source_id, workspace_id=None):
+        if source_id not in self.rows:
+            raise ValueError(f"source not found: {source_id}")
+        del self.rows[source_id]
+
