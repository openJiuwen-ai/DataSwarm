@@ -0,0 +1,88 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""A staged query must see a complete snapshot, including old partitions."""
+import os
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import SourceDefinition
+from jiuwenswarm.channels.web.dataagent.connectors.errors import ConnectorError
+from jiuwenswarm.channels.web.dataagent.connectors import staged_connector as sc
+
+
+def connector(monkeypatch, tmp_path, entries):
+    monkeypatch.setenv("JIUWENSWARM_STAGED_CACHE", str(tmp_path / "cache"))
+
+    class Fetcher(sc.RemoteFetcher):
+        downloads = 0
+
+        def list_files(self, pattern):
+            return [(name, len(content), mtime) for name, content, mtime in entries]
+
+        def download(self, name, target):
+            self.downloads += 1
+            target.write_bytes(next(content for path, content, _ in entries if path == name))
+
+    fetcher = Fetcher()
+    conn = sc.StagedFileConnector(SourceDefinition(
+        "snapshot", "ftp", "snapshot", "staged",
+        {"protocol": "ftp", "path": "/*.csv", "format": "csv", "table_name": "orders"},
+    ))
+    monkeypatch.setattr(conn, "_fetcher", lambda: fetcher)
+    return conn, fetcher
+
+
+def test_old_partition_survives_stage_and_is_included_in_sum(monkeypatch, tmp_path):
+    old = time.time() - 10 * 24 * 3600
+    conn, fetcher = connector(monkeypatch, tmp_path, [
+        ("/old.csv", b"amount\n10\n", old),
+        ("/new.csv", b"amount\n20\n", time.time()),
+    ])
+    monkeypatch.setenv("JIUWENSWARM_STAGED_CACHE_TTL", "60")
+    try:
+        result = conn.query('SELECT SUM(amount) FROM orders')
+        assert result["rows"] == [[30]]
+        assert conn.stage()["skipped"] == 2
+        assert fetcher.downloads == 2
+    finally:
+        conn.close()
+
+
+def test_snapshot_larger_than_quota_is_rejected_before_download(monkeypatch, tmp_path):
+    conn, fetcher = connector(monkeypatch, tmp_path, [
+        ("/a.csv", b"amount\n10\n", time.time()),
+        ("/b.csv", b"amount\n20\n", time.time()),
+    ])
+    monkeypatch.setenv("JIUWENSWARM_STAGED_CACHE_QUOTA", "15")
+    with pytest.raises(ConnectorError, match="quota"):
+        conn.stage()
+    assert fetcher.downloads == 0
+
+
+def test_locked_stale_file_fails_instead_of_polluting_sum(monkeypatch, tmp_path):
+    conn, _ = connector(monkeypatch, tmp_path, [("/a.csv", b"amount\n10\n", time.time())])
+    directory = sc._cache_dir_for("snapshot", "/*.csv", conn.source.config)
+    stale = directory / "deleted.csv"
+    stale.write_text("amount\n999\n")
+    real_unlink = Path.unlink
+
+    def unlink(path, *args, **kwargs):
+        if path == stale:
+            raise PermissionError("locked")
+        return real_unlink(path, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "unlink", unlink)
+    with pytest.raises(ConnectorError, match="stale"):
+        conn.query("SELECT SUM(amount) FROM orders")
+
+
+def test_sftp_listing_ignores_directories_matching_glob():
+    import stat
+    fetcher = sc._SftpFetcher.__new__(sc._SftpFetcher)
+    fetcher._sftp = SimpleNamespace(listdir_attr=lambda path: [
+        SimpleNamespace(filename="partition.csv", st_mode=stat.S_IFDIR | 0o755, st_size=0, st_mtime=1),
+        SimpleNamespace(filename="orders.csv", st_mode=stat.S_IFREG | 0o644, st_size=12, st_mtime=1),
+    ])
+    assert fetcher.list_files("/*.csv") == [("/orders.csv", 12, 1.0)]
