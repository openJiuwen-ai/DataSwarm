+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Semantic source collection preserves workspace and credential boundaries."""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.semantic import service
+from jiuwenswarm.common import workspace_context
+
+
+@pytest.fixture()
+def authorization(monkeypatch):
+    state = SimpleNamespace(local=None, remote=None, executed=[], validated=[],
+                            business_ref="mysql://business:3306/app")
+
+    def context(workspace_id=None):
+        return workspace_context.WorkspaceContext("ws", "Workspace", state.business_ref,
+                                                  "mysql://metadata:3306/meta")
+
+    monkeypatch.setattr(workspace_context, "resolve", context)
+    monkeypatch.setattr(workspace_context, "current_workspace", context)
+    monkeypatch.setattr(workspace_context, "same_physical_ref", lambda left, right: left == right)
+    monkeypatch.setattr(service.datasource_store, "find_local_source", lambda *a, **k: state.local)
+    monkeypatch.setattr(service.datasource_store, "find_source", lambda *a, **k: state.remote)
+
+    def validate(workspace_id, role, ref):
+        state.validated.append((workspace_id, role, ref))
+        if ref not in {state.business_ref, "mysql://metadata:3306/meta"}:
+            raise ValueError("unauthorized db_ref: " + ref)
+        return ref
+
+    monkeypatch.setattr(workspace_context, "validate_ref_in_workspace", validate)
+    monkeypatch.setattr(service.repository, "create_run", lambda *a, **k: None)
+    monkeypatch.setattr(service.repository, "get_run", lambda run_id: {"run_id": run_id, "status": "queued"})
+    monkeypatch.setattr(service, "_execute", lambda workspace_id, source, *a:
+                        state.executed.append((workspace_id, source)))
+    service._running_sources.clear()
+    yield state
+    service._running_sources.clear()
+
+
+def _source(ref="mysql://business:3306/app"):
+    return {"source_id": "source", "source_type": "mysql", "enabled": True,
+            "db_ref": ref, "config": {"user": "reader", "password": "saved-secret"}}
+
+
+def test_local_unbound_source_can_be_collected(authorization):
+    authorization.business_ref = ""
+    authorization.local = _source("mysql://local-unbound:3306/app")
+    result = service.start_run({"source_id": "source"}, synchronous=True)
+    assert result["status"] == "queued"
+    assert authorization.executed == [("ws", authorization.local)]
+    assert authorization.validated == []
+
+
+@pytest.mark.parametrize("business_ref", ["", "mysql://unrelated:3306/app"])
+def test_unbound_cross_workspace_source_is_rejected(authorization, business_ref):
+    authorization.business_ref = business_ref
+    authorization.remote = _source()
+    with pytest.raises(ValueError, match="^source_not_available$"):
+        service.start_run({"source_id": "source"}, synchronous=True)
+    assert authorization.executed == []
+
+
+def test_remote_source_bound_as_business_can_be_collected(authorization):
+    authorization.remote = _source()
+    result = service.start_run({"source_id": "source"}, synchronous=True)
+    assert result["status"] == "queued"
+    assert authorization.executed == [("ws", authorization.remote)]
+    assert authorization.validated == [("ws", "business", authorization.business_ref)]
+
+
+def test_remote_metadata_ref_does_not_grant_business_collection(authorization):
+    authorization.remote = _source("mysql://metadata:3306/meta")
+    with pytest.raises(ValueError, match="^source_not_available$"):
+        service.start_run({"source_id": "source"}, synchronous=True)
+    assert authorization.executed == []
+
+
+@pytest.mark.parametrize("entry_name", ["start_run_for_binding", "start_run_for_query"])
+def test_automatic_collection_hides_unavailable_source_credentials(authorization, entry_name, capsys):
+    authorization.remote = _source("mysql://reader:ref-secret@other:3306/private")
+    result = getattr(service, entry_name)("source", "ws")
+    assert result == {"status": "source_not_available", "reason": "source_not_available",
+                      "warnings": ["source_not_available"]}
+    assert authorization.executed == []
+    assert "secret" not in str(result) + capsys.readouterr().err
+
+
+def test_lookup_error_discloses_no_connection_or_secret(authorization, monkeypatch, capsys):
+    def fail(*args, **kwargs):
+        raise RuntimeError("mysql://reader:lookup-secret@other/private")
+
+    monkeypatch.setattr(service.datasource_store, "find_local_source", fail)
+    with pytest.raises(ValueError, match="^source_not_available$") as failure:
+        service.start_run({"source_id": "source"}, synchronous=True)
+    assert "secret" not in str(failure.value) + capsys.readouterr().err
+
+
+def test_local_registration_takes_precedence_over_same_id_in_another_workspace(authorization):
+    authorization.local = _source("mysql://local:3306/app")
+    authorization.remote = _source("mysql://other:3306/app")
+    service.start_run({"source_id": "source"}, synchronous=True)
+    assert authorization.executed == [("ws", authorization.local)]
+    assert authorization.validated == []
