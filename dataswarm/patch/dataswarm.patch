diff --git a/jiuwenswarm/channels/web/frontend/src/features/_shared/lineage/lineageLayout.ts b/jiuwenswarm/channels/web/frontend/src/features/_shared/lineage/lineageLayout.ts
new file mode 100644
index 000000000..a0d6dced8
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/_shared/lineage/lineageLayout.ts
@@ -0,0 +1,157 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+export interface LineageNode {
+  table: string;
+  layer?: string;
+  rowcount?: number;
+}
+
+export interface LineageEdge {
+  from: string;
+  to: string;
+}
+
+/** 分层顺序即列序：ODS→DWD→DWS→ADS 自左向右分列，同层表上下排列。 */
+export const LAYER_ORDER = ['SOURCE', 'ODS', 'DWD', 'DWS', 'ADS'];
+export const LAYER_COLOR: Record<string, string> = {
+  SOURCE: '#94a3b8',
+  ODS: '#64748b',
+  DWD: '#2563eb',
+  DWS: '#ea580c',
+  ADS: '#16a34a',
+};
+const COL_GAP_X = 380;
+const ROW_GAP_Y = 110;
+const BASE_X = 60;
+const BASE_Y = 60;
+/** barycenter 重排轮数：正向/反向交替扫描。 */
+const SWEEP_ROUNDS = 4;
+
+/**
+ * 计算血缘图布局：层=列自左向右，列内用 barycenter 启发式排序减少连线交叉。
+ * 边的形状交给 ReactFlow 原生 bezier（由实时 handle 坐标计算，拖拽时自动跟随），
+ * 本函数只负责节点落位，不再预计算路由折线。
+ *
+ * Args:
+ *   nodes: 血缘节点（table + layer）。
+ *   edges: 血缘边（from → to），仅用于 barycenter 排序。
+ *
+ * Returns: positions（节点左上角坐标）。
+ */
+export function computeLineageLayout(
+  nodes: LineageNode[],
+  edges: LineageEdge[],
+): { positions: Map<string, { x: number; y: number }> } {
+  const buckets = new Map<string, LineageNode[]>();
+  for (const n of nodes) {
+    const layer = n.layer ?? 'OTHER';
+    if (!buckets.has(layer)) buckets.set(layer, []);
+    buckets.get(layer)!.push(n);
+  }
+  const orderedLayers = [
+    ...LAYER_ORDER.filter((layer) => buckets.has(layer)),
+    ...[...buckets.keys()].filter((layer) => !LAYER_ORDER.includes(layer)).sort(),
+  ];
+  const colOf = new Map<string, number>();
+  orderedLayers.forEach((layer, col) => {
+    for (const n of buckets.get(layer)!) colOf.set(n.table, col);
+  });
+
+  // 列内初始顺序 = 输入顺序；barycenter 扫描按邻居 y 均值重排，无邻居的节点沉底保持相对顺序。
+  // 扫描可能振荡，每轮后统计相邻列边交叉数，最终恢复交叉最少的排列。
+  const orders = orderedLayers.map((layer) => buckets.get(layer)!.map((n) => n.table));
+  const yOf = new Map<string, number>();
+  const applyY = () => {
+    orders.forEach((order) => order.forEach((table, i) => yOf.set(table, BASE_Y + i * ROW_GAP_Y)));
+  };
+  applyY();
+  const forwardEdges = edges.filter((e) => {
+    const sc = colOf.get(e.from);
+    const tc = colOf.get(e.to);
+    return sc != null && tc != null && sc < tc;
+  });
+  const countCrossings = (): number => {
+    const orderIn = new Map<string, number>();
+    orders.forEach((order) => order.forEach((table, i) => orderIn.set(table, i)));
+    let total = 0;
+    for (let col = 0; col + 1 < orders.length; col++) {
+      const pair = forwardEdges.filter((e) => colOf.get(e.from) === col && colOf.get(e.to) === col + 1);
+      for (let i = 0; i < pair.length; i++) {
+        for (let j = i + 1; j < pair.length; j++) {
+          const a = pair[i];
+          const b = pair[j];
+          if (
+            (orderIn.get(a.from)! - orderIn.get(b.from)!) * (orderIn.get(a.to)! - orderIn.get(b.to)!) < 0
+          ) {
+            total += 1;
+          }
+        }
+      }
+    }
+    return total;
+  };
+  let bestOrders = orders.map((order) => [...order]);
+  let bestCrossings = countCrossings();
+  for (let round = 0; round < SWEEP_ROUNDS; round++) {
+    const downward = round % 2 === 0;
+    const neighborY = (table: string): number[] =>
+      downward
+        ? forwardEdges.filter((e) => e.to === table).map((e) => yOf.get(e.from)!)
+        : forwardEdges.filter((e) => e.from === table).map((e) => yOf.get(e.to)!);
+    for (let col = downward ? 1 : orders.length - 2; downward ? col < orders.length : col >= 0; col += downward ? 1 : -1) {
+      const bary = new Map<string, number>();
+      for (const table of orders[col]) {
+        const ys = neighborY(table);
+        if (ys.length) bary.set(table, ys.reduce((a, b) => a + b, 0) / ys.length);
+      }
+      orders[col] = [
+        ...orders[col].filter((t) => bary.has(t)).sort((a, b) => bary.get(a)! - bary.get(b)!),
+        ...orders[col].filter((t) => !bary.has(t)),
+      ];
+      applyY();
+      const crossings = countCrossings();
+      if (crossings < bestCrossings) {
+        bestCrossings = crossings;
+        bestOrders = orders.map((order) => [...order]);
+      }
+    }
+  }
+  bestOrders.forEach((order, col) => {
+    orders[col] = order;
+  });
+  applyY();
+
+  const positions = new Map<string, { x: number; y: number }>();
+  for (const table of colOf.keys()) {
+    positions.set(table, { x: BASE_X + colOf.get(table)! * COL_GAP_X, y: yOf.get(table)! });
+  }
+
+  return { positions };
+}
+
+export function buildDownstreamMap(edges: LineageEdge[]): Map<string, string[]> {
+  const m = new Map<string, string[]>();
+  for (const e of edges) {
+    if (!m.has(e.from)) m.set(e.from, []);
+    m.get(e.from)!.push(e.to);
+  }
+  return m;
+}
+export function buildUpstreamMap(edges: LineageEdge[]): Map<string, string[]> {
+  const m = new Map<string, string[]>();
+  for (const e of edges) {
+    if (!m.has(e.to)) m.set(e.to, []);
+    m.get(e.to)!.push(e.from);
+  }
+  return m;
+}
+export function bfs(start: string, adj: ReadonlyMap<string, string[]>): Set<string> {
+  const seen = new Set<string>();
+  const queue = [start];
+  for (let index = 0; index < queue.length; index += 1) {
+    const cur = queue[index];
+    if (seen.has(cur)) continue;
+    seen.add(cur);
+    for (const next of adj.get(cur) ?? []) queue.push(next);
+  }
+  return seen;
+}
