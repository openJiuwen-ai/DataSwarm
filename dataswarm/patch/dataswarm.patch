+def test_stage_evicts_files_the_remote_no_longer_has(tmp_path, monkeypatch):
+    """远端删掉的文件必须从缓存里清掉，否则会被静默算进聚合。
+
+    `_delegate()` 把 DuckDB 指向 `cache_dir/*.<fmt>`，**glob 整个缓存目录**而不是
+    本次 stage 的清单。所以陈旧文件留着就会进聚合——查询成功、数字是错的。
+    远端按分区清理旧文件是常态，不是边缘情况。
+
+    批 11 真连时暴露：缓存里残留的 dim_*.csv 让 catalog 把它们当成数据集。
+    """
+    from jiuwenswarm.channels.web.dataagent.connectors import paths as cpaths
+    from jiuwenswarm.channels.web.dataagent.connectors import staged_connector as sc
+
+    monkeypatch.setattr(cpaths, "staged_cache_root", lambda: tmp_path)
+    monkeypatch.setattr(sc, "staged_cache_root", lambda: tmp_path)
+    monkeypatch.setattr(sc, "resolve_staged_path", lambda p: Path(p))
+
+    class _FakeFetcher(sc.RemoteFetcher):
+        """远端只剩 current.csv，old.csv 已被清理掉。"""
+
+        def list_files(self, pattern):
+            return [("/data/current.csv", 5, time.time())]
+
+        def download(self, remote_path, target):
+            target.write_text("a,b\n", encoding="utf-8")
+
+    source = connector_base.SourceDefinition(
+        "evict", "ftp", "t", "staged",
+        {"protocol": "ftp", "host": "h", "port": 21, "user": "u",
+         "password": "p", "path": "/data/*.csv", "format": "csv"},
+    )
+    conn = sc.StagedFileConnector(source)
+    monkeypatch.setattr(conn, "_fetcher", lambda: _FakeFetcher())
+
+    # 先造出「上一轮拉过、现在远端已删」的陈旧文件
+    cache_dir = sc._cache_dir_for("evict", "/data/*.csv", source.config)
+    stale = cache_dir / "old.csv"
+    stale.write_text("x,y\n", encoding="utf-8")
+
+    report = conn.stage()
+    assert not stale.exists(), "远端已删的文件仍留在缓存里，会被算进聚合"
+    assert report["evicted"] == ["old.csv"], report["evicted"]
+    assert [Path(p).name for p in report["files"]] == ["current.csv"]
+    # 本次拉到的文件当然要留下
+    assert (cache_dir / "current.csv").is_file()
