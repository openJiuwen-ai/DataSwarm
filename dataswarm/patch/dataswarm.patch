+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""verify_equivalence.py —— 归档等价门禁：基线 + git apply patch vs anchor 全树。
+
+V4 单通道断言：patch 恒含全部内容差异，`基线 tag + apply patch` 必须逐字节还原
+develop_oss@anchor（skills/tests/sync 仅展示层，不参与还原）。全对象层回放
+（git apply --cached，临时 index 不经文件系统，Windows 与 Linux 零差异）。
+
+退出码：0 = 等价；1 = 硬失败（树不等 / patch 无法应用 / manifest 缺失）
+
+用法:
+    python scripts/dataswarm/fork/verify_equivalence.py                # 对本地 MR 分支（归档后）
+    python scripts/dataswarm/fork/verify_equivalence.py --archive-ref mr-fork/MR
+    python scripts/dataswarm/fork/verify_equivalence.py --archive-ref mr-hub/develop   # 交付仓 CI
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from _fork_lib import (  # noqa: E402
+    PATCH_FILE,
+    apply_patch_tree,
+    archive_branch,
+    ensure_baseline_tag,
+    git,
+    load_config,
+    parse_archive_trailers,
+    rev,
+    tree_diff_paths,
+)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="归档等价门禁：基线+patch(apply) vs anchor 全树")
+    ap.add_argument("--archive-ref", default=None,
+                    help="归档分支 ref（缺省 fork_config.archive.branch 本地分支；"
+                         "远端验证用 mr-fork/MR 或 mr-hub/develop）")
+    ap.add_argument("--baseline", default=None,
+                    help="覆盖基线 tag（缺省取归档 manifest 记录的 baseline.ref）")
+    args = ap.parse_args()
+
+    cfg = load_config()
+    archive_ref = args.archive_ref or archive_branch(cfg)
+    if rev(archive_ref) is None:
+        raise SystemExit(f"归档 ref 不存在: {archive_ref}（先归档或 fetch 后再验证）")
+
+    trailers = parse_archive_trailers(archive_ref)
+    baseline_tag = args.baseline or trailers.get("baseline-tag", "")
+    if not baseline_tag:
+        raise SystemExit("无法确定基线 tag：归档 commit 缺 Baseline-Tag trailer 且未传 --baseline")
+    ensure_baseline_tag(baseline_tag)
+
+    anchor_sha = trailers.get("archive-from", "")
+    if not anchor_sha or rev(anchor_sha) is None:
+        raise SystemExit(f"Archive-from trailer 缺失或本地不可达: {anchor_sha!r}")
+
+    patch_proc = git("cat-file", "blob", f"{archive_ref}:{PATCH_FILE}", check=False)
+    if patch_proc.returncode != 0:
+        raise SystemExit(f"归档树缺少 {PATCH_FILE}: {archive_ref}")
+
+    print(f"[*] 归档 {archive_ref}（anchor {anchor_sha[:12]}）vs 基线 {baseline_tag}")
+    composed = apply_patch_tree(baseline_tag, patch_proc.stdout)
+    anchor_tree = rev(f"{anchor_sha}^{{tree}}")
+
+    if composed == anchor_tree:
+        print(f"[OK] 等价：基线 + apply patch == anchor 全树（{anchor_tree[:12]}）")
+        return 0
+
+    diffs = tree_diff_paths(composed, anchor_tree)
+    print(f"[FAIL] 组合树 {composed[:12]} != anchor 树 {anchor_tree[:12]}，差异 {len(diffs)} 项:")
+    for path in diffs[:40]:
+        print(f"  - {path}")
+    if len(diffs) > 40:
+        print(f"  … 另有 {len(diffs) - 40} 项")
+    print("[FAIL] patch 无法完整还原 anchor——勿合入（先修归档器或重新归档）")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
