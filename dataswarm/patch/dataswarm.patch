+    expect_raises(lambda: adapter.validate({}), ValueError, "空参数")
+    expect_raises(lambda: adapter.validate({**HDFS_CONFIG, "protocol": "hdfs"}),
+                  ValueError, "protocol=hdfs（应为 webhdfs）")
+    expect_raises(lambda: adapter.validate({**HDFS_CONFIG, "format": "avro"}),
+                  ValueError, "不支持的格式")
+    expect_raises(lambda: adapter.validate({**HDFS_CONFIG,
+                                            "path": "/warehouse/../../etc/*.csv"}),
+                  ValueError, "path 含 ..")
+    expect_raises(lambda: adapter.validate({**HDFS_CONFIG, "user": ""}),
+                  ValueError, "缺 user")
+    adapter.validate(HDFS_CONFIG)
+    return "协议/格式/路径穿越/必填项四类非法输入均被拒"
+
+
+def a_real_test_connection():
