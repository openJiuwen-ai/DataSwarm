+    with pytest.raises(TimeoutError, match="TCP timeout"):
+        _SftpFetcher({"host": "fixture.invalid"})
+    assert all(seen[name] == 30 for name in ("timeout", "banner_timeout", "auth_timeout", "channel_timeout"))
