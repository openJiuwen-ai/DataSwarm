@@ -0,0 +1,247 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 数据源工作空间 store（多工作空间方案 P2-1，docs/archive/delivered/multi-workspace-datasource-plan.md）。
+ *
+ * 注意与 workspaceStore.ts（项目工作区/ProjectInfo）是两个概念：
+ * 这里管的是 datasource.yaml 的 `workspaces` 段——一套业务库+元数据库的绑定，
+ * 用于聊天会话与治理页选择「当前用哪个库」。
+ *
+ * currentWorkspaceId 经 localStorage 持久化（key: dw.workspace）；
+ * 新会话默认继承上次选择（决策四）。
+ */
+import { create } from 'zustand';
+import i18n from '../i18n';
+
+export interface DatasourceWorkspaceSummary {
+  workspace_id: string;
+  name: string;
+  /** 空间用途备注（可选） */
+  description?: string;
+  /** yaml = datasource.yaml 声明（只读）；ui = 界面创建 */
+  origin?: 'yaml' | 'ui';
+  /** 未绑定业务数据源时为 null（创建空间时可暂不绑定，后续建源自动绑定） */
+  business: { type: string; database: string } | null;
+  metadata: { type: string; database: string };
+}
+
+export interface CreateDatasourceWorkspaceParams {
+  name: string;
+  description?: string;
+  business_db_ref?: string;
+  workspace_id?: string;
+}
+
+export interface UpdateDatasourceWorkspaceParams {
+  name?: string;
+  description?: string;
+}
+
+export interface DeleteWorkspaceResult {
+  ok: boolean;
+  error_code?: string;
+  error?: string;
+}
+
+export interface BusinessDatasourceOption {
+  source_id: string;
+  name: string;
+  ref: string;
+  type: string;
+  database: string;
+  config_source: string;
+}
+
+interface DatasourceWorkspaceState {
+  workspaces: DatasourceWorkspaceSummary[];
+  currentWorkspaceId: string;
+  isLoading: boolean;
+  initialized: boolean;
+  error: string | null;
+  loadWorkspaces: () => Promise<void>;
+  setCurrentWorkspace: (workspaceId: string) => void;
+  createWorkspace: (params: CreateDatasourceWorkspaceParams) => Promise<DatasourceWorkspaceSummary>;
+  /** 修改 UI 工作空间的 name/description；成功后重载列表 */
+  updateWorkspace: (workspaceId: string, params: UpdateDatasourceWorkspaceParams) => Promise<DatasourceWorkspaceSummary>;
+  /** 删除 UI 工作空间（物理删除元库文件）；成功后重载列表并自动回选 */
+  deleteWorkspace: (workspaceId: string) => Promise<DeleteWorkspaceResult>;
+}
+
+const STORAGE_KEY = 'dw.workspace';
+/**
+ * 系统默认工作空间 id（后端空态自动创建，service.DEFAULT_WORKSPACE_ID 同值对齐）。
+ * localStorage 无记忆时回退选它；'default' 是 YAML legacy 空间保留 id，语义不同。
+ */
+export const DEFAULT_WORKSPACE_ID = 'default-ws';
+/** 工作空间列表请求超时：它是治理 API 的前置请求，挂住会连累整条链路。 */
+const WORKSPACE_TIMEOUT_MS = 15_000;
+let workspaceRequest: Promise<void> | null = null;
+
+function readInitialWorkspaceId(): string {
+  if (typeof window === 'undefined') return '';
+  return window.localStorage.getItem(STORAGE_KEY) ?? '';
+}
+
+export const useDatasourceWorkspaceStore = create<DatasourceWorkspaceState>((set, get) => ({
+  workspaces: [],
+  currentWorkspaceId: readInitialWorkspaceId(),
+  isLoading: false,
+  initialized: false,
+  error: null,
+
+  loadWorkspaces: async () => {
+    if (workspaceRequest) return workspaceRequest;
+    const request = (async () => {
+      set({ isLoading: true, error: null });
+      // 超时兜底：workspace_id 是所有治理 API 的前置（inspectionApi.request 先 await
+      // ensureDatasourceWorkspaceId 才发请求），这里挂住会把整个治理链路连同 loading
+      // 一起卡死，所以必须限时。
+      const controller = new AbortController();
+      const timer = setTimeout(() => controller.abort(), WORKSPACE_TIMEOUT_MS);
+      try {
+        const response = await fetch('/api/dataagent/workspaces', {
+          signal: controller.signal,
+          headers: { Accept: 'application/json' },
+          // 后端 JSON 未带 Cache-Control，显式禁用浏览器启发式缓存，
+          // 保证打开选择器时的强制重拉拿到最新绑定状态
+          cache: 'no-store',
+        });
+        const payload = (await response.json()) as Record<string, unknown>;
+        if (!response.ok) {
+          throw new Error(typeof payload.error === 'string' ? payload.error : `${response.status}`);
+        }
+        if (
+          !Array.isArray(payload.workspaces) ||
+          payload.workspaces.some(
+            (workspace) => !workspace || typeof workspace.workspace_id !== 'string' || !workspace.workspace_id,
+          )
+        )
+          throw new Error(i18n.t('datasourceWorkspace.invalidResponse'));
+        const workspaces = payload.workspaces as DatasourceWorkspaceSummary[];
+        const current = get().currentWorkspaceId;
+        // A configured default, the system default, or the only workspace has
+        // defined selection semantics. Multiple workspaces without either
+        // require an explicit user choice.
+        const selected =
+          workspaces.find((ws) => ws.workspace_id === current) ??
+          workspaces.find((ws) => ws.workspace_id === 'default') ??
+          workspaces.find((ws) => ws.workspace_id === DEFAULT_WORKSPACE_ID) ??
+          (workspaces.length === 1 ? workspaces[0] : undefined);
+        const currentWorkspaceId = selected?.workspace_id ?? '';
+        if (currentWorkspaceId) window.localStorage.setItem(STORAGE_KEY, currentWorkspaceId);
+        else window.localStorage.removeItem(STORAGE_KEY);
+        set({ workspaces, currentWorkspaceId, initialized: true, isLoading: false });
+      } catch (error) {
+        // 超时以可读文案入 error（而非 AbortError）：调用方据此恢复正常态
+        const msg = controller.signal.aborted
+          ? i18n.t('datasourceWorkspace.loadTimeout')
+          : error instanceof Error ? error.message : String(error);
+        set({ isLoading: false, error: msg });
+      } finally {
+        clearTimeout(timer);
+      }
+    })();
+    workspaceRequest = request;
+    try {
+      await request;
+    } finally {
+      if (workspaceRequest === request) workspaceRequest = null;
+    }
+  },
+
+  setCurrentWorkspace: (workspaceId) => {
+    if (get().currentWorkspaceId === workspaceId) return;
+    window.localStorage.setItem(STORAGE_KEY, workspaceId);
+    set({ currentWorkspaceId: workspaceId });
+  },
+
+  createWorkspace: async (params) => {
+    const response = await fetch('/api/dataagent/workspaces', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(params),
+    });
+    const payload = (await response.json()) as { workspace?: DatasourceWorkspaceSummary; detail?: string; error?: string };
+    if (!response.ok || !payload.workspace) {
+      throw new Error(payload.detail || payload.error || `${response.status}`);
+    }
+    await get().loadWorkspaces();
+    get().setCurrentWorkspace(payload.workspace.workspace_id);
+    return payload.workspace;
+  },
+
+  updateWorkspace: async (workspaceId, params) => {
+    const response = await fetch(
+      `/api/dataagent/workspaces/${encodeURIComponent(workspaceId)}/update`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify(params),
+      },
+    );
+    const payload = (await response.json()) as { workspace?: DatasourceWorkspaceSummary; detail?: string; error?: string };
+    if (!response.ok || !payload.workspace) {
+      throw new Error(payload.detail || payload.error || `${response.status}`);
+    }
+    workspaceRequest = null;
+    await get().loadWorkspaces();
+    return payload.workspace;
+  },
+
+  deleteWorkspace: async (workspaceId) => {
+    const response = await fetch(
+      `/api/dataagent/workspaces/${encodeURIComponent(workspaceId)}/delete`,
+      { method: 'POST', headers: { Accept: 'application/json' } },
+    );
+    const payload = await response.json().catch(() => ({})) as Record<string, unknown>;
+    if (!response.ok) {
+      return {
+        ok: false,
+        error: (payload.detail || payload.error || `${response.status}`) as string,
+      };
+    }
+    if (payload.ok === false) {
+      return payload as unknown as DeleteWorkspaceResult;
+    }
+    // loadWorkspaces 内部自动回选 default/唯一空间并回写 localStorage；
+    // 页面挂载点 key={workspaceId} 随 currentWorkspaceId 变化自动重挂载。
+    workspaceRequest = null;
+    await get().loadWorkspaces();
+    return payload as unknown as DeleteWorkspaceResult;
+  },
+}));
+
+/** 当前已选择的 workspace_id；空字符串表示尚未确认选择。 */
+export function getCurrentDatasourceWorkspaceId(): string {
+  return useDatasourceWorkspaceStore.getState().currentWorkspaceId;
+}
+
+/** Resolve the catalogue before issuing a workspace-scoped data request. */
+export async function ensureDatasourceWorkspaceId(): Promise<string> {
+  const state = useDatasourceWorkspaceStore.getState();
+  if (!state.initialized || state.isLoading || state.error) await state.loadWorkspaces();
+  const resolved = useDatasourceWorkspaceStore.getState();
+  if (resolved.error) throw new Error(resolved.error);
+  if (!resolved.currentWorkspaceId) throw new Error(i18n.t('datasourceWorkspace.selectRequired'));
+  return resolved.currentWorkspaceId;
+}
+
+/**
+ * 会话工作空间归桶（chat-workspace-isolation-plan）：空串/缺省/'default' 归一为
+ * 'default'，其余按字面量精确匹配。与后端 project_adapter._workspace_bucket 同口径。
+ */
+export function workspaceBucket(workspaceId?: string | null): string {
+  const raw = String(workspaceId ?? '').trim();
+  return raw && raw !== 'default' ? raw : 'default';
+}
+
+/**
+ * P2-4 并发隔离（决策四 / 二轮 R5）：治理页 API 响应写入 store 前校验。
+ * 先比较发出请求时的 workspaceId；即使响应未带 workspace_id，也不能跨空间写回。
+ * 响应声明了 workspace_id 时，还需与已选择空间一致。
+ */
+export function responseBelongsToCurrentWorkspace(payload: unknown, requestedAt: string): boolean {
+  const current = getCurrentDatasourceWorkspaceId();
+  if (requestedAt !== current) return false;
+  const wsId = (payload as { workspace_id?: unknown } | null)?.workspace_id;
+  return typeof wsId !== 'string' || wsId === current;
+}
