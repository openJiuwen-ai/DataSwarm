+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/model.py —— 指标域领域模型（不可变契约）。
+
+全部用 ``@dataclass(frozen=True)``：口径、绑定、发布与查询规格一旦构造就不该被
+就地改动，改动意味着产生新修订（方案 §阶段 1）。
+
+命名与 ``deploy/schema/ddl/dw_metric_*.ddl.sqlite.sql`` 的列一一对应，
+JSON 列在这里是已解析的结构，落库前经 :mod:`.store` 序列化。
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass, field
+from typing import Any
+
+from .errors import DefinitionError, QueryPlanError
+
+# 指标类型
+METRIC_TYPE_ATOMIC = "atomic"
+METRIC_TYPE_DERIVED = "derived"
+METRIC_TYPE_RATIO = "ratio"
+METRIC_TYPES = frozenset({METRIC_TYPE_ATOMIC, METRIC_TYPE_DERIVED, METRIC_TYPE_RATIO})
+
+# 修订状态机：draft → candidate → published → retired
+REVISION_DRAFT = "draft"
+REVISION_CANDIDATE = "candidate"
+REVISION_PUBLISHED = "published"
+REVISION_RETIRED = "retired"
+
+# 绑定校验状态
+BINDING_UNBOUND = "unbound"
+BINDING_VERIFIED = "verified"
+BINDING_FAILED = "failed"
+
+# 概念映射状态：candidate 一律不投影，confirmed 才进正式投影
+MAP_CANDIDATE = "candidate"
+MAP_CONFIRMED = "confirmed"
+MAP_REJECTED = "rejected"
+
+# 发布状态
+RELEASE_DRAFT = "draft"
+RELEASE_PUBLISHED = "published"
+RELEASE_FAILED = "failed"
+RELEASE_REVOKED = "revoked"
+
+# 查询通路
+PATH_COMPILER = "compiler"
+PATH_LLM = "llm"
+PATH_EXPLORATORY = "exploratory"  # R3 受控探索（/v2/explore），schema 子图范围内
+
+# 支持的时间粒度
+SUPPORTED_GRAINS = frozenset({"day", "week", "month", "year"})
+
+# 单次查询返回行数上限（方案 §阶段 5b）
+DEFAULT_LIMIT = 500
+MAX_LIMIT = 5000
+
+
+def canonical_json(obj: Any) -> str:
+    """规范化 JSON：键排序、无多余空白、保留非 ASCII。
+
+    ``definition_hash`` 与 ``context_digest`` 都基于它，保证同义不同序的定义
+    得到同一个哈希。
+    """
+    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def sha256_of(text: str) -> str:
+    """SHA-256 十六进制摘要。"""
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def resolve_dimension(dim: str, allowed: tuple[str, ...] | list[str]) -> str | None:
+    """把维度名解析到白名单里的规范形态（消解「限定名 vs 裸列名」两面对不上）。
+
+    指标口径以限定名声明允许维度（如 ``orders.customer_state``），而 schema
+    召回/维度注册表对外给的是裸列名（``customer_state``）——同一维度两种写法，
+    字面比对会把合法维度判为越界，逼调用方多跑一轮才自愈。
+
+    解析规则：完全匹配优先；否则剥掉 ``表.`` 前缀按列名做**唯一**后缀匹配。
+    歧义（多个白名单项同列名）或多义一律返回 ``None``，由调用方照原样报
+    「不在允许维度内」，绝不猜。
+
+    Args:
+        dim: 调用方给的维度名（裸列名或限定名）。
+        allowed: 该修订声明的允许维度（限定名元组）。
+
+    Returns:
+        白名单里的规范形态；无法唯一确定时为 ``None``。
+    """
+    if not dim:
+        return None
+    if dim in allowed:
+        return dim
+    suffix = dim.split(".")[-1]
+    hits = [cand for cand in allowed if cand.split(".")[-1] == suffix]
+    return hits[0] if len(hits) == 1 else None
+
+
+@dataclass(frozen=True)
+class ParsedExpression:
+    """公式 AST 解析产物（方案 §投影策略②）。
+
+    Args:
+        operator: 聚合算子，如 ``sum`` / ``count_distinct`` / ``divide``。
+        fields: 引用到的逻辑字段，如 ``["orders.amount_cny", "orders.pay_status"]``。
+    """
+
+    operator: str = ""
+    fields: tuple[str, ...] = ()
+
+
+@dataclass(frozen=True)
+class ExpressionSpec:
+    """指标表达式：多方言原文 + 解析产物 + 未解析原因。
+
+    Args:
+        resolved_dialect: 实际选用的 Ossie 方言名，如 ``ANSI_SQL``。
+        dialects: 方言 → 表达式原文。
+        parsed: AST 解析产物；解析失败为 None。
+        unparsed_reason: 解析失败原因；成功为 None。
+    """
+
+    resolved_dialect: str = ""
+    dialects: dict[str, str] = field(default_factory=dict)
+    parsed: ParsedExpression | None = None
+    unparsed_reason: str | None = None
+
+    @property
+    def expression(self) -> str:
+        """选用方言的表达式原文。"""
+        return self.dialects.get(self.resolved_dialect, "")
+
+    @property
+    def is_parsed(self) -> bool:
+        """是否成功解析出算子与字段引用。"""
+        return self.parsed is not None
+
+    def to_json_obj(self) -> dict[str, Any]:
+        """转为可落库的 dict。"""
+        return {
+            "resolved_dialect": self.resolved_dialect,
+            "dialects": dict(self.dialects),
+            "parsed": (
+                {"operator": self.parsed.operator, "fields": list(self.parsed.fields)}
+                if self.parsed else None
+            ),
+            "unparsed_reason": self.unparsed_reason,
+        }
+
+    @classmethod
+    def from_json_obj(cls, raw: Any) -> "ExpressionSpec":
+        """从落库的 dict/JSON 串还原。"""
+        data = _as_dict(raw)
+        parsed_raw = _as_dict(data.get("parsed")) if data.get("parsed") else None
+        parsed = (
+            ParsedExpression(
+                operator=str(parsed_raw.get("operator") or ""),
+                fields=tuple(parsed_raw.get("fields") or ()),
+            )
+            if parsed_raw else None
+        )
+        return cls(
+            resolved_dialect=str(data.get("resolved_dialect") or ""),
+            dialects={str(k): str(v) for k, v in (data.get("dialects") or {}).items()},
+            parsed=parsed,
+            unparsed_reason=data.get("unparsed_reason"),
+        )
+
+
+@dataclass(frozen=True)
+class MetricDef:
+    """指标身份，跨修订稳定。"""
+
+    metric_id: str
+    workspace_id: str
+    metric_key: str
+    name: str
+    description: str = ""
+    owner: str = ""
+    status: str = "draft"
+    current_revision_id: str | None = None
+    created_at: str = ""
+    updated_at: str = ""
+
+
+@dataclass(frozen=True)
+class MetricRevision:
+    """不可变的口径版本，权威定义。"""
+
+    revision_id: str
+    metric_id: str
+    workspace_id: str
+    revision_no: int
+    metric_type: str = METRIC_TYPE_ATOMIC
+    datatype: str = ""
+    unit: str = ""
+    display_name: str = ""
+    synonyms: tuple[str, ...] = ()
+    expression: ExpressionSpec = field(default_factory=ExpressionSpec)
+    fixed_filters: tuple[dict[str, Any], ...] = ()
+    time_dimension: str = ""
+    allowed_dimensions: tuple[str, ...] = ()
+    time_grains: tuple[str, ...] = ()
+    timezone: str = ""
+    calendar: str = ""
+    dependencies: tuple[str, ...] = ()
+    zero_denominator: str = ""
+    additivity: dict[str, str] = field(default_factory=dict)
+    subject_iri: str = ""
+    status: str = REVISION_DRAFT
+    source_type: str = "manual"
+    ossie_raw: str = ""
+    definition_ref: str = ""
+    definition_hash: str = ""
+    created_at: str = ""
+
+    def definition_payload(self) -> dict[str, Any]:
+        """参与 ``definition_hash`` 的规范化字段集（方案 §阶段 3 幂等）。
+
+        **不含** ``created_at`` / 状态 / 发布信息等易变量，否则同一口径每次
+        发布都会得到不同哈希，幂等就失效了。**不含** ``revision_no``（Phase 3c
+        单一口径化：含它则同一定义二次导入哈希必变、导入幂等失效——历史上
+        versioning._content_hash_of 被迫再剔除一遍维持双口径，现已统一）。
+        """
+        return {
+            "metric_id": self.metric_id,
+            "metric_type": self.metric_type,
+            "datatype": self.datatype,
+            "unit": self.unit,
+            "display_name": self.display_name,
+            "synonyms": sorted(self.synonyms),
+            "expression": self.expression.to_json_obj(),
+            "fixed_filters": [dict(f) for f in self.fixed_filters],
+            "time_dimension": self.time_dimension,
+            "allowed_dimensions": sorted(self.allowed_dimensions),
+            "time_grains": sorted(self.time_grains),
+            "timezone": self.timezone,
+            "calendar": self.calendar,
+            "dependencies": sorted(self.dependencies),
+            "zero_denominator": self.zero_denominator,
+            "additivity": dict(self.additivity),
+        }
+
+    def compute_definition_hash(self) -> str:
+        """计算定义哈希。"""
+        return sha256_of(canonical_json(self.definition_payload()))
+
+    def validate(self) -> None:
+        """口径自校验，失败抛 :class:`~.errors.DefinitionError`。"""
+        if self.metric_type not in METRIC_TYPES:
+            raise DefinitionError(
+                f"指标 {self.metric_id} 的 metric_type={self.metric_type!r} 非法"
+                f"（支持 {', '.join(sorted(METRIC_TYPES))}）")
+        if not self.expression.expression and self.metric_type == METRIC_TYPE_ATOMIC:
+            raise DefinitionError(f"原子指标 {self.metric_id} 缺少表达式")
+        if self.metric_type != METRIC_TYPE_ATOMIC and not self.dependencies:
+            raise DefinitionError(
+                f"{self.metric_type} 指标 {self.metric_id} 必须声明 dependencies")
+        for grain in self.time_grains:
+            if grain not in SUPPORTED_GRAINS:
+                raise DefinitionError(
+                    f"指标 {self.metric_id} 的时间粒度 {grain!r} 不支持"
+                    f"（支持 {', '.join(sorted(SUPPORTED_GRAINS))}）")
+
+
+@dataclass(frozen=True)
+class Binding:
+    """修订 → 真实表列绑定。"""
+
+    binding_id: str
+    revision_id: str
+    workspace_id: str
+    datasource_alias: str = ""
+    datasource_ref: str = ""
+    source_table: str = ""
+    column_map: dict[str, str] = field(default_factory=dict)
+    verify_status: str = BINDING_UNBOUND
+    verify_detail: str = ""
+    verified_at: str = ""
+    created_at: str = ""
+
+    @property
+    def columns(self) -> frozenset[str]:
+        """绑定声明的物理列集合。"""
+        return frozenset(self.column_map.values())
+
+
+@dataclass(frozen=True)
+class ConceptMapping:
+    """业务概念/依赖角色映射。candidate 不投影，confirmed 才投影。"""
+
+    mapping_id: str
+    workspace_id: str
+    revision_id: str
+    relation_type: str
+    target_ref: str
+    status: str = MAP_CANDIDATE
+    evidence: str = ""
+    confirmed_by: str = ""
+    confirmed_at: str = ""
+    created_at: str = ""
+
+
+@dataclass(frozen=True)
+class Release:
+    """发布批次。一个 release 对应一张语义命名图。"""
+
+    release_id: str
+    workspace_id: str
+    label: str = ""
+    status: str = RELEASE_DRAFT
+    revision_ids: tuple[str, ...] = ()
+    manifest: dict[str, Any] = field(default_factory=dict)
+    checksum: str = ""
+    projection_graph: str = ""
+    projection_status: str = "pending"
+    error_code: str = ""
+    error_message: str = ""
+    projected_at: str = ""
+    published_at: str = ""
+    published_by: str = ""
+    created_at: str = ""
+
+
+@dataclass(frozen=True)
+class TimeRange:
+    """查询时间范围。``end_exclusive`` 为开区间上界。"""
+
+    dimension: str
+    start: str
+    end_exclusive: str
+    grain: str = ""
+    timezone: str = ""
+
+    def validate(self) -> None:
+        """校验时间范围合法性。"""
+        if not self.dimension:
+            raise QueryPlanError("time.dimension 不能为空")
+        if not self.start or not self.end_exclusive:
+            raise QueryPlanError("time.start 与 time.end_exclusive 都不能为空")
+        if self.start >= self.end_exclusive:
+            raise QueryPlanError(
+                f"time.start({self.start}) 必须早于 end_exclusive({self.end_exclusive})")
+        if self.grain and self.grain not in SUPPORTED_GRAINS:
+            raise QueryPlanError(
+                f"不支持的时间粒度 {self.grain!r}（支持 {', '.join(sorted(SUPPORTED_GRAINS))}）")
+
+
+@dataclass(frozen=True)
+class QueryFilter:
+    """查询过滤条件。字段必须在指标允许维度内。"""
+
+    field: str
+    op: str
+    value: Any
+
+
+@dataclass(frozen=True)
+class QuerySpec:
+    """结构化查询规格（方案 ``examples/query.json`` 的契约化版本）。
+
+    LLM 主通路只产出这个，**不产出 SQL**；SQL 由 :mod:`.compiler` 确定性生成。
+    """
+
+    metrics: tuple[str, ...]
+    group_by: tuple[str, ...] = ()
+    filters: tuple[QueryFilter, ...] = ()
+    time: TimeRange | None = None
+    release: str = "active"
+    limit: int = DEFAULT_LIMIT
+
+    def validate(self) -> None:
+        """规格级校验（不含口径校验，那部分在 :mod:`.guard`）。"""
+        if not self.metrics:
+            raise QueryPlanError("metrics 不能为空")
+        if self.limit <= 0:
+            raise QueryPlanError("limit 必须为正数")
+        if self.limit > MAX_LIMIT:
+            raise QueryPlanError(f"limit 超过上限 {MAX_LIMIT}")
+        if self.time is not None:
+            self.time.validate()
+
+    @classmethod
+    def from_dict(cls, raw: dict[str, Any]) -> "QuerySpec":
+        """从 JSON dict 构造，非法输入抛 :class:`~.errors.QueryPlanError`。"""
+        if not isinstance(raw, dict):
+            raise QueryPlanError("QuerySpec 必须是对象")
+        metrics = raw.get("metrics") or []
+        if isinstance(metrics, str):
+            metrics = [metrics]
+        time_raw = _as_dict(raw.get("time"))
+        time_range = (
+            TimeRange(
+                dimension=str(time_raw.get("dimension") or ""),
+                start=str(time_raw.get("start") or ""),
+                end_exclusive=str(time_raw.get("end_exclusive") or time_raw.get("end") or ""),
+                grain=str(time_raw.get("grain") or ""),
+                timezone=str(time_raw.get("timezone") or ""),
+            )
+            if time_raw else None
+        )
+        filters = tuple(
+            QueryFilter(
+                field=str(f.get("field") or ""),
+                op=str(f.get("op") or "="),
+                value=f.get("value"),
+            )
+            for f in (raw.get("filters") or [])
+            if isinstance(f, dict)
+        )
+        spec = cls(
+            metrics=tuple(str(m) for m in metrics),
+            group_by=tuple(str(g) for g in (raw.get("group_by") or [])),
+            filters=filters,
+            time=time_range,
+            release=str(raw.get("release") or "active"),
+            limit=int(raw.get("limit") or DEFAULT_LIMIT),
+        )
+        spec.validate()
+        return spec
+
+    def to_dict(self) -> dict[str, Any]:
+        """转为可 JSON 序列化的 dict。"""
+        return {
+            "metrics": list(self.metrics),
+            "group_by": list(self.group_by),
+            "filters": [{"field": f.field, "op": f.op, "value": f.value} for f in self.filters],
+            "time": (
+                {
+                    "dimension": self.time.dimension,
+                    "start": self.time.start,
+                    "end_exclusive": self.time.end_exclusive,
+                    "grain": self.time.grain,
+                    "timezone": self.time.timezone,
+                }
+                if self.time else None
+            ),
+            "release": self.release,
+            "limit": self.limit,
+        }
+
+    def digest(self) -> str:
+        """规格摘要，用于 verified SQL 复用与 context_digest。"""
+        return sha256_of(canonical_json(self.to_dict()))
+
+
+@dataclass(frozen=True)
+class CompiledQuery:
+    """确定性编译产物。"""
+
+    sql: str
+    params: tuple[Any, ...]
+    dialect: str
+    db_type: str
+    datasource_ref: str
+    revision_ids: tuple[str, ...]
+    release_id: str
+    metric_keys: tuple[str, ...]
+    group_by: tuple[str, ...] = ()
+    grain: str = ""
+    time_column: str = ""
+    limit: int = DEFAULT_LIMIT
+
+
+@dataclass(frozen=True)
+class QueryResult:
+    """查询结果与追溯信息。"""
+
+    rows: list[dict[str, Any]]
+    columns: list[str]
+    compiled: CompiledQuery
+    path: str = PATH_COMPILER
+    authoritative: bool = True
+    row_count: int = 0
+    elapsed_ms: int = 0
+    query_id: str = ""
+    stale: bool = False
+    degraded_reason: str = ""
+    warnings: list[str] = field(default_factory=list)
+
+
+@dataclass(frozen=True)
+class AskAnswer:
+    """ask/explore 的编译产物（执行语义拆分：服务端只编译不执行）。
+
+    指标模块 = 口径真相源 + SQL 编译器；执行交给对话链路的执行通道
+    （nl2sql execute_sql / 前端 query?preview）。``sql_executable`` 是参数
+    内联后的自包含 SQL（执行层无 params 通道，占位符版只作展示）。
+    ``spec`` 供前端把同一规格回传 ``/query`` 做预览执行。
+    """
+
+    compiled: CompiledQuery
+    spec: dict[str, Any]
+    sql_executable: str
+    authoritative: bool
+    path: str = PATH_COMPILER
+    degraded_reason: str = ""
+    query_id: str = ""
+    warnings: tuple[str, ...] = ()
+
+
+def _as_dict(raw: Any) -> dict[str, Any]:
+    """把 JSON 串或 dict 统一成 dict；无法解析时返回空 dict。"""
+    if isinstance(raw, dict):
+        return raw
+    if isinstance(raw, str) and raw.strip():
+        try:
+            parsed = json.loads(raw)
+        except json.JSONDecodeError:
+            return {}
+        return parsed if isinstance(parsed, dict) else {}
+    return {}
+
+
+def as_list(raw: Any) -> list[Any]:
+    """把 JSON 串或 list 统一成 list；无法解析时返回空 list。"""
+    if isinstance(raw, list):
+        return raw
+    if isinstance(raw, tuple):
+        return list(raw)
+    if isinstance(raw, str) and raw.strip():
+        try:
+            parsed = json.loads(raw)
+        except json.JSONDecodeError:
+            return []
+        return parsed if isinstance(parsed, list) else []
+    return []
