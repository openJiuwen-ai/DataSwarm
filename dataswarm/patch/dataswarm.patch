new file mode 100644
index 000000000..64254f83a
--- /dev/null
+++ b/jiuwenswarm/empty_final_guard.py
@@ -0,0 +1,65 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""empty_final_guard —— chat.final 空正文回落 reasoning_content（F-014 防护）。
+
+推理模型偶发把正文写进思考通道（content 为空串、reasoning_content 里有完整
+答案含结论与 SQL），用户最终收到空消息（f12-verify 与 baseline-04-r3 两次实锤，
+nw-14 因此报告未交付）。ReAct 控制器两处 final 发送消费的都是
+`_generate_plan_from_llm` / `_generate_next_plan` 返回的 AssistantMessage——
+在这两个生产者外面包一层做回落：无重试、无死循环风险。
+
+openjiuwen 在 site-packages 改不得，按既有模式（bash_tool_safety /
+powershell_routing / llm_sse_patch）挂 app_agentserver 启动。
+"""
+from __future__ import annotations
+
+import functools
+import logging
+
+logger = logging.getLogger(__name__)
+
+_GUARDED_PRODUCERS = ("_generate_plan_from_llm", "_generate_next_plan")
+
+
+def _recover_empty_content(llm_output: object) -> None:
+    """content 空且 reasoning_content 有内容时，把 reasoning 回落为正文。
+
+    回落优于空消息：F-014 实测 reasoning 里是完整答案（含 compiled SQL 结论）；
+    即便偶为思考过程，也强于用户侧零信息。
+    """
+    content = getattr(llm_output, "content", "") or ""
+    reasoning = getattr(llm_output, "reasoning_content", "") or ""
+    if str(content).strip() or not str(reasoning).strip():
+        return
+    try:
+        llm_output.content = reasoning  # type: ignore[attr-defined]
+    except (AttributeError, TypeError) as exc:  # 不可变对象等异常形态
+        logger.warning("[EmptyFinalGuard] 回落失败（对象不可写）: %s", exc)
+        return
+    logger.warning(
+        "[EmptyFinalGuard] content 为空，已回落 reasoning_content 作正文（%d 字）",
+        len(str(reasoning)))
+
+
+def install_empty_final_guard() -> None:
+    """幂等安装：包 LLMController 的两个 plan 生产者方法（均返回 (tasks, llm_output)）。"""
+    try:
+        from openjiuwen.core.application.llm_agent.llm_controller import LLMController
+    except ImportError:
+        logger.warning("[EmptyFinalGuard] openjiuwen LLMController 不可导入，跳过")
+        return
+
+    for attr in _GUARDED_PRODUCERS:
+        original = getattr(LLMController, attr, None)
+        if original is None or getattr(original, "jiuwenswarm_final_guard", False):
+            continue
+
+        @functools.wraps(original)
+        async def _guarded(self, *args, _original=original, **kwargs):  # noqa: ANN001, ANN202
+            result = await _original(self, *args, **kwargs)
+            if isinstance(result, tuple) and len(result) == 2 and result[1] is not None:
+                _recover_empty_content(result[1])
+            return result
+
+        _guarded.jiuwenswarm_final_guard = True
+        setattr(LLMController, attr, _guarded)
+    logger.info("[EmptyFinalGuard] 已安装（%s）", ", ".join(_GUARDED_PRODUCERS))
