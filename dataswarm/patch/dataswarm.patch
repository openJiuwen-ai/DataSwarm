index 000000000..3fa44b0ef
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/schema_candidates.py
@@ -0,0 +1,196 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Zero-LLM schema-driven candidate derivation.
+
+从业务库表/列结构零 LLM 派生术语候选，进入 ``dw_business_knowledge``
+候选区等待人工评审——解决知识库冷启动：没有文档可蒸馏时，schema 本身
+就是第一候选来源。
+
+指标候选派生于 2026-11-02 关闭（指标建模统一走指标系统，抽取链只产术语/
+规则/映射/示例），数值列不再生成候选。
+
+设计纪律：
+- 纯规则、零 LLM、零网络副作用（除读 schema 反射外）
+- 产出统一 ``origin='schema_auto'`` + 低置信（0.4），只进候选区，
+  发布仍走既有 approve → publish 评审流与权威对齐（glossary / OSSIE）
+- 幂等：同 (表, 列, 类型) 指纹重复派生不重建候选
+- 保守：宁缺勿滥——技术列（id/key/code/hash 等）与主键列不产生候选
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from typing import Any
+
+from . import store
+
+# ── 规则表 ────────────────────────────────────────────────────────────────────
+
+# 物理类型名 → 逻辑类型的归一表在 dialect_registry（接入扩展批次 0-B1）。
+# 原实现在本模块硬编码 MySQL/Doris 口味的类型名集合，PG 报
+# character varying / int4 / timestamptz
+# 全都落不进去——不报错，而是静默漏派生整库候选。
+
+# 时间维度词（timestamp 类刻意不收，粒度过细）
+_TIME_RE = re.compile(r"(_dt|_ds|_date|_day|_month|_year|_week)$|^(dt|ds)$|(^|_)date($|_)",
+                      re.IGNORECASE)
+# 技术列排除：主键/外键/编码/哈希/标记/链接等不产生业务术语候选
+_TECH_RE = re.compile(r"(_id|_key|_code|_hash|_uuid|_guid|_flag|_url|_token|_no)$|^(id|is_|has_)",
+                      re.IGNORECASE)
+
+_TERM_PER_TABLE_CAP = 20
+
+
+def _base_type(ctype: str) -> str:
+    return str(ctype or "").split("(")[0].strip().upper()
+
+
+def _is_pk(column: dict) -> bool:
+    return bool(column.get("pk"))
+
+
+def _metadata_dialects(db_ref: str) -> tuple[str, ...]:
+    """Resolve DDL type metadata without granting its reference SQL capability."""
+    from jiuwenswarm.common import dialect_registry as dr
+
+    db_type = dr.db_type_of_ref(db_ref)
+    if db_type != "ddl":
+        return (db_type,)
+    from ..datasource import store as source_store
+
+    config = source_store.find_config_by_ref(db_ref, "ddl")
+    if not config or not config.get("ddl_text"):
+        raise ValueError("DDL source configuration not found in current workspace")
+    dialect = str(config.get("dialect") or "").strip().lower()
+    if dialect:
+        dr.profile_for(dialect)  # Unknown metadata dialects must not silently guess.
+        return (dialect,)
+    # Auto-parsed DDL emits normalized SQLGlot types. Preserve vendor types
+    # (e.g. MONEY / CITEXT / ENUM) only when all recognizing profiles agree.
+    # This is type classification only; `ddl` remains unregistered for SQL.
+    return ("postgres", "mysql", "tsql", "duckdb", "sqlite", "doris")
+
+
+def _classify(table: str, column: dict, db_type: str | tuple[str, ...]) -> dict | None:
+    """对单列应用派生规则；返回候选描述或 None（不派生）。
+
+    类型判定走 ``dialect_registry.logical_type``（0-B1）：规则结构与阈值不变，
+    只把「物理类型名是否在某个集合里」换成「逻辑类型是什么」，这样同一套规则
+    对 PG / SQL Server 的类型名同样成立。``column_type`` 仍上报物理
+    类型名，供人工评审时看原始形态。
+    """
+    from jiuwenswarm.common import dialect_registry as _dr
+
+    name = str(column.get("name") or "").strip()
+    if not name or _is_pk(column) or _TECH_RE.search(name):
+        return None
+    base = _base_type(str(column.get("type") or ""))
+    dialects = (db_type,) if isinstance(db_type, str) else db_type
+    recognized = {_dr.logical_type(dialect, str(column.get("type") or ""))
+                  for dialect in dialects} - {_dr.OTHER}
+    logical = recognized.pop() if len(recognized) == 1 else _dr.OTHER
+    lower = name.lower()
+
+    if logical == _dr.NUMERIC:
+        # 指标候选派生已关闭（2026-11-02）：指标建模统一走指标系统，
+        # 抽取链不再从数值列推断指标——疑似指标的列由人工在指标系统建模。
+        return None
+    if _TIME_RE.search(name) and "timestamp" not in lower:
+        return {"asset_type": "term", "rule": "time", "column_type": base,
+                "content": f"疑似时间维度（schema 推断）：{name}（{base}，表 {table}）。"
+                           "时间粒度需人工确认。"}
+    if logical == _dr.TEXT:
+        return {"asset_type": "term", "rule": "dimension", "column_type": base,
+                "content": f"疑似业务维度（schema 推断）：{name} 为 {base} 列，来自表 {table}，"
+                           "非主键/技术列。业务含义与取值需人工确认。"}
+    return None
+
+
+def _fingerprint(table: str, column: str) -> str:
+    return hashlib.sha256(json.dumps(["schema_auto", table, column],
+                                     ensure_ascii=False).encode()).hexdigest()[:20]
+
+
+def derive_candidates(db_ref: str, *, tables: list[str] | None = None,
+                      source_id: str = "") -> dict[str, Any]:
+    """扫描 ``db_ref`` 的表/列结构，零 LLM 生成术语候选。
+
+    Args:
+        db_ref: 业务库 db-ref（无凭据指针形态）。
+        tables: 限定表清单；缺省扫描全表。
+        source_id: 可选数据源 id，写入 scope.source_ids 供评审过滤。
+
+    Returns:
+        {ok, db_ref, tables_scanned, created, skipped_existing, cap_reached,
+         rule_counts}；单表反射失败计入 ``failed_tables`` 不中断整体。
+    """
+    from .. import db as _da_db
+    from jiuwenswarm.common.workspace_context import sanitize_ref
+
+    db_connector = _da_db.db_connector
+    # SQL/sample sources use their registered type aliases. DDL has no SQL
+    # dialect capability: resolve only its saved metadata dialect in this scope.
+    db_type = _metadata_dialects(db_ref)
+    if tables:
+        names = [str(t) for t in tables]
+    else:
+        raw = db_connector.tables(db_ref)
+        names = [t if isinstance(t, str) else str(t.get("table_name") or t.get("name") or "")
+                 for t in (raw.get("tables", []) if isinstance(raw, dict) else list(raw or []))]
+        names = [n for n in names if n]
+
+    total_cap = max(0, int(os.environ.get("KNOWLEDGE_SCHEMA_DERIVE_MAX", "200")))
+    existing = {a["source"].get("schema_fingerprint") for a in store.list_assets()}
+    created: list[dict] = []
+    skipped, failed = 0, []
+    rule_counts: dict[str, int] = {}
+    cap_reached = False
+
+    for name in names:
+        term_count = 0
+        try:
+            columns = db_connector.schema(db_ref, name).get("columns", [])
+        except Exception:  # noqa: BLE001 — 单表失败隔离（同 schema_snapshot）
+            failed.append(name)
+            continue
+        for column in columns:
+            hit = _classify(name, column, db_type)
+            if hit is None:
+                continue
+            if term_count >= _TERM_PER_TABLE_CAP:
+                cap_reached = True
+                continue
+            col = str(column.get("name") or "")
+            fp = _fingerprint(name, col)
+            if fp in existing:
+                skipped += 1
+                continue
+            if len(created) >= total_cap:
+                cap_reached = True
+                break
+            scope: dict[str, list[str]] = {"table_ids": [name], "column_ids": [f"{name}.{col}"]}
+            if source_id:
+                scope["source_ids"] = [source_id]
+            source = {"origin": "schema_auto",
+                      "schema": {"table": name, "column": col,
+                                 "column_type": hit["column_type"], "rule": hit["rule"],
+                                 "db_ref": sanitize_ref(db_ref)},
+                      "schema_fingerprint": fp,
+                      "confidence": 0.4,
+                      "extractor_version": "schema-deriver-v1"}
+            candidate = store.create_candidate({"asset_type": hit["asset_type"], "title": col,
+                                                "content": hit["content"], "scope": scope,
+                                                "source": source, "owner": "schema-deriver"})
+            candidate["conflicts"] = store.conflicts(candidate)
+            created.append(candidate)
+            existing.add(fp)
+            term_count += 1
+            rule_counts[hit["rule"]] = rule_counts.get(hit["rule"], 0) + 1
+        if len(created) >= total_cap:
+            cap_reached = True
+            break
+
+    return {"ok": True, "db_ref": db_ref, "tables_scanned": len(names) - len(failed),
+            "created": created, "created_count": len(created), "skipped_existing": skipped,
+            "failed_tables": failed, "cap_reached": cap_reached, "rule_counts": rule_counts}
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/schema_enrichment.py b/jiuwenswarm/channels/web/dataagent/knowledge/schema_enrichment.py
new file mode 100644
index 000000000..211c1fad1
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/schema_enrichment.py
@@ -0,0 +1,307 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""知识派生后台任务：schema 正则派生（L1）+ LLM 深化（L2），带超时与状态跟踪。
+
+绑定业务库即触发；数据源列表经 ``derivation_status`` 展示进度（派生中
+x/y、N 条候选 / 已深化 M、失败或超时可重试）。
+
+治理不变量：深化只改写「未被人工碰过」的候选（status=candidate 且
+revision==1 且未深化过）。已评审 / 已编辑 / 已发布的候选绝不被覆盖。
+
+超时：``KNOWLEDGE_SCHEMA_ENRICH_TIMEOUT_S``（默认 600 秒）为任务级
+deadline，逐表检查；超时保留已完成部分——深化幂等（source.enriched
+标记），重试自动从断点续跑。
+
+取消：``cancel`` 置 cooperative 标志，逐表检查生效（正在深化的表跑完
+后停止）；语义同超时——已完成部分保留，重试从断点续跑。
+"""
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+from typing import Any
+
+from pydantic import BaseModel, Field
+
+from jiuwenswarm.channels.web import timeutil
+
+from . import store
+
+
+class EnrichedColumn(BaseModel):
+    column: str
+    definition: str = ""
+    zh_name: str = ""
+    synonyms: list[str] = Field(default_factory=list)
+    metric_hint: str = ""
+
+
+class EnrichmentResult(BaseModel):
+    columns: list[EnrichedColumn]
+
+
+_JOBS: dict[str, dict] = {}
+_LOCK = threading.Lock()
+
+
+def _now_iso() -> str:
+    return timeutil.now_iso()
+
+
+def _update(workspace_id: str, **fields: Any) -> None:
+    with _LOCK:
+        job = _JOBS.setdefault(workspace_id, {"status": "idle", "phase": "", "tables_done": 0,
+                                              "tables_total": 0, "failed_tables": [], "error": "",
+                                              "started_at": "", "finished_at": "", "cancel_requested": False})
+        job.update(fields)
+
+
+def job_status(workspace_id: str) -> dict | None:
+    """当前任务快照（无任务返回 None）。"""
+    with _LOCK:
+        job = _JOBS.get(workspace_id)
+        return dict(job) if job else None
+
+
+def derivation_status(workspace_id: str) -> dict:
+    """数据源列表用的合并视图：任务状态 + 候选/深化计数（DB 真相源，重启不丢）。
+
+    任务状态在内存（进程重启归零），计数永远从知识库读——重启后列表仍能
+    显示「N 条候选」，只是丢失"上次失败原因"，重试按钮永远可用。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    status = {"status": "idle", "phase": "", "tables_done": 0, "tables_total": 0,
+              "failed_tables": [], "error": "", "candidates": 0, "enriched": 0,
+              "started_at": "", "finished_at": "", "cancel_requested": False}
+    job = job_status(workspace_id)
+    if job:
+        status.update({key: job.get(key, status[key]) for key in
+                       ("status", "phase", "tables_done", "tables_total", "failed_tables",
+                        "error", "started_at", "finished_at", "cancel_requested")})
+    token = None
+    try:
+        token = workspace_context.set_current(workspace_id or None)
+        for asset in store.list_assets():
+            source = asset.get("source") or {}
+            if source.get("origin") != "schema_auto":
+                continue
+            status["candidates"] += 1
+            if source.get("enriched"):
+                status["enriched"] += 1
+    except Exception:  # noqa: BLE001 — 计数失败不影响列表
+        pass
+    finally:
+        if token is not None:
+            workspace_context.reset(token)
+    return status
+
+
+def timeout_seconds() -> int:
+    """任务级 deadline；非法值回退 600，<=0 视为禁用并回退 600。"""
+    try:
+        return max(1, int(os.environ.get("KNOWLEDGE_SCHEMA_ENRICH_TIMEOUT_S", "600")))
+    except (TypeError, ValueError):
+        return 600
+
+
+def submit(workspace_id: str, *, db_ref: str = "", source_id: str = "") -> dict:
+    """提交知识派生任务（derive + enrich）；同空间运行中则拒绝重复提交。
+
+    Args:
+        workspace_id: 目标工作空间。
+        db_ref: 业务库指针；缺省在工作线程内按工作空间解析。
+        source_id: 可选数据源 id，写入候选 scope.source_ids。
+
+    Returns:
+        {status: queued} 或 {status: already_running}。
+    """
+    with _LOCK:
+        job = _JOBS.get(workspace_id)
+        if job and job.get("status") in {"queued", "running"}:
+            return {"status": "already_running"}
+        _JOBS[workspace_id] = {"status": "queued", "phase": "", "tables_done": 0, "tables_total": 0,
+                               "failed_tables": [], "error": "", "started_at": "", "finished_at": "",
+                               "cancel_requested": False}
+    threading.Thread(target=_run, args=(workspace_id, db_ref, source_id),
+                     name="knowledge-derive", daemon=True).start()
+    return {"status": "queued"}
+
+
+def cancel(workspace_id: str) -> dict:
+    """请求取消运行中的知识派生任务（cooperative：当前表完成后停止）。
+
+    与超时同语义——已完成部分保留（深化幂等），重试从断点续跑。
+
+    Args:
+        workspace_id: 目标工作空间。
+
+    Returns:
+        {status: cancelling}（已标记，等当前表跑完）或 {status: not_running}。
+    """
+    with _LOCK:
+        job = _JOBS.get(workspace_id)
+        if not job or job.get("status") not in {"queued", "running"}:
+            return {"status": "not_running"}
+        job["cancel_requested"] = True
+        return {"status": "cancelling"}
+
+
+def _cancel_requested(workspace_id: str) -> bool:
+    with _LOCK:
+        return bool(_JOBS.get(workspace_id, {}).get("cancel_requested"))
+
+
+def _run(workspace_id: str, db_ref: str, source_id: str) -> None:
+    from jiuwenswarm.common import workspace_context
+
+    token = None
+    try:
+        token = workspace_context.set_current(workspace_id or None)
+        _run_inner(workspace_id, db_ref, source_id)
+    except Exception as exc:  # noqa: BLE001 — 任务级失败落状态，不冒泡到绑定
+        _update(workspace_id, status="failed", error=f"{type(exc).__name__}: {exc}",
+                finished_at=_now_iso())
+    finally:
+        if token is not None:
+            workspace_context.reset(token)
+
+
+def _run_inner(workspace_id: str, db_ref: str, source_id: str) -> None:
+    from jiuwenswarm.common import workspace_context
+
+    ref = db_ref or workspace_context.current_workspace().business_db_ref
+    _update(workspace_id, status="running", phase="derive", started_at=_now_iso(),
+            tables_done=0, tables_total=0, failed_tables=[], error="")
+    # L1：正则派生（瞬时、幂等——新表补齐，已有指纹跳过）
+    from .schema_candidates import derive_candidates
+    derive_candidates(ref, source_id=source_id)
+    # L2：LLM 深化（蒸馏通道；只碰未被人工动过的候选）
+    from .extraction_llm import build_default_provider
+    provider = build_default_provider()
+
+    groups = _pending_tables()
+    _update(workspace_id, phase="enrich", tables_total=len(groups), tables_done=0)
+    deadline = time.time() + timeout_seconds()
+    failed: list[str] = []
+    for index, (table, assets) in enumerate(groups.items()):
+        if _cancel_requested(workspace_id):
+            _update(workspace_id, status="cancelled",
+                    error=f"深化已取消（完成 {index}/{len(groups)} 张表），已完成部分保留，可重试续跑",
+                    failed_tables=failed, finished_at=_now_iso())
+            return
+        if time.time() > deadline:
+            _update(workspace_id, status="timeout",
+                    error=f"深化超过 {timeout_seconds()}s 未完成（{index}/{len(groups)} 张表），可重试续跑",
+                    failed_tables=failed, finished_at=_now_iso())
+            return
+        try:
+            _enrich_table(provider, ref, table, assets)
+        except Exception:  # noqa: BLE001 — 单表失败隔离，不中断整体
+            failed.append(table)
+        _update(workspace_id, tables_done=index + 1, failed_tables=list(failed))
+    if groups and len(failed) == len(groups):
+        _update(workspace_id, status="failed", error=f"所有表深化失败：{', '.join(failed[:3])}",
+                finished_at=_now_iso())
+    else:
+        _update(workspace_id, status="complete", error="", finished_at=_now_iso())
+
+
+def _pending_tables() -> dict[str, list[dict]]:
+    """按表分组待深化候选：schema_auto、未深化、candidate 状态且 revision==1（未被人工碰过）。"""
+    groups: dict[str, list[dict]] = {}
+    for asset in store.list_assets():
+        source = asset.get("source") or {}
+        if source.get("origin") != "schema_auto" or source.get("enriched"):
+            continue
+        if asset["status"] != "candidate" or int(asset.get("revision") or 1) != 1:
+            continue
+        table = str((source.get("schema") or {}).get("table") or "")
+        if table:
+            groups.setdefault(table, []).append(asset)
+    # list_assets 按秒级 updated_at + 随机 asset_id 排序，同秒批量派生时表序随机；
+    # 按表名排序使深化/超时续跑顺序确定
+    return dict(sorted(groups.items()))
+
+
+def _sample_rows(db_ref: str, table: str, limit: int = 5) -> dict[str, list[str]]:
+    """每列取至多 limit 个样例值（LLM 定义的证据锚，防幻觉）。"""
+    from .. import db as _da_db
+
+    result = _da_db.db_connector.query(db_ref, f"SELECT * FROM {table}", limit=limit)
+    columns = [str(name) for name in result.get("columns") or []]
+    samples: dict[str, list[str]] = {name: [] for name in columns}
+    for row in result.get("rows") or []:
+        for name, value in zip(columns, row):
+            text = "NULL" if value is None else str(value)
+            if len(text) > 40:
+                text = text[:37] + "..."
+            if len(samples[name]) < limit:
+                samples[name].append(text)
+    return samples
+
+
+def _build_prompt(table: str, columns: list[dict], samples: dict[str, list[str]]) -> str:
+    lines = []
+    for column in columns:
+        name, ctype = column["column"], column["column_type"]
+        values = samples.get(name) or []
+        anchor = f" — samples: {'; '.join(values)}" if values else ""
+        lines.append(f"- {name} {ctype}{anchor}")
+    return ("Enrich schema-derived business knowledge candidates for ONE table. "
+            "For each column decide FIRST whether it carries a real business concept. "
+            "SKIP columns that are purely technical plumbing — audit/system timestamps, "
+            "row bookkeeping, opaque flags — and omit them from the output entirely; "
+            "never force a definition for such columns. "
+            "For the remaining columns write a concise business definition grounded ONLY in the table name, "
+            "column name, column type and sample values. Never invent facts beyond these signals; "
+            "leave zh_name and synonyms empty when unclear. "
+            "Write the definition in Simplified Chinese (简体中文). "
+            "zh_name is the standard Chinese business name for the column, qualified with the table's "
+            "business entity so the same column name never collides across tables "
+            "(e.g. 客户手机号 in a customer table vs 商家联系电话 in a seller table — never a bare 手机号); "
+            "put plain unqualified words in synonyms for retrieval. "
+            "metric_hint: only for numeric columns that plausibly aggregate, "
+            "e.g. 'SUM(order_count)，按天聚合，过滤条件与口径需人工确认'; empty otherwise. "
+            "Output ONLY JSON.\n"
+            f"Table: {table}\nColumns:\n" + "\n".join(lines)
+            + "\nJSON schema:\n" + json.dumps(EnrichmentResult.model_json_schema(), ensure_ascii=False))
+
+
+def _enrich_table(provider, db_ref: str, table: str, assets: list[dict]) -> None:
+    """一表一次 LLM 调用：样例值锚定的定义 + 实体消歧中文名/同义词 + 口径提示。
+
+    LLM 判定无业务概念的列（纯技术列）会从输出省略——按已处理标记深化
+    （幂等），保留 L1 原始描述且不再重试，不硬编定义。
+    """
+    columns = [{"column": str((asset["source"].get("schema") or {}).get("column") or asset["title"]),
+                "column_type": str((asset["source"].get("schema") or {}).get("column_type") or "")}
+               for asset in assets]
+    samples = _sample_rows(db_ref, table)
+    result = provider.generate_typed(_build_prompt(table, columns, samples), EnrichmentResult,
+                                     temperature=0, max_retries=2)
+    by_column = {item.column: item for item in result.columns}
+    for asset in assets:
+        column = str((asset["source"].get("schema") or {}).get("column") or asset["title"])
+        enriched = by_column.get(column)
+        source = dict(asset["source"])
+        content = asset["content"]
+        if enriched is not None:
+            if enriched.zh_name or enriched.synonyms:
+                new_names = [name for name in [enriched.zh_name, *enriched.synonyms]
+                             if name and name not in (asset["source"].get("synonyms") or [])]
+                if new_names:
+                    source["synonyms"] = list(asset["source"].get("synonyms") or []) + new_names
+            if enriched.definition:
+                content = enriched.definition
+                if enriched.metric_hint:
+                    content = f"{content}\n口径建议：{enriched.metric_hint}"
+        # 无论 LLM 给出多少（含判定跳过的技术列）：标记已深化（幂等），
+        # 跳过列保留 L1 原始描述，重试不重复送审
+        source["enriched"] = {"model": getattr(provider, "model", ""), "at": _now_iso(),
+                              "version": "schema-enricher-v1"}
+        payload = {"source": source}
+        if content != asset["content"]:
+            payload["content"] = content
+        store.update_candidate(asset["asset_id"], payload)
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/scope_suggestions.py b/jiuwenswarm/channels/web/dataagent/knowledge/scope_suggestions.py
new file mode 100644
index 000000000..0f3b40379
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/scope_suggestions.py
@@ -0,0 +1,85 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""规则/映射候选的作用范围建议（确定性词法匹配，零 LLM）。
+
+文档蒸馏出的规则常为通用约束（未绑定具体指标/术语），发布门禁要求适用范围
+或显式全空间声明。这里用候选标题+内容对工作空间的指标名/术语名做确定性匹配，
+产出可一键采纳的建议——不引入 LLM 成本，也不会产生不存在的 key（建议均来自
+真实目录）。
+"""
+from __future__ import annotations
+
+import unicodedata
+from difflib import SequenceMatcher
+from typing import Any
+
+_MAX_SUGGESTIONS = 3
+_SUBSTRING_SCORE = 0.9
+_FUZZY_FLOOR = 0.72
+
+
+def _normal(text: str) -> str:
+    return " ".join(unicodedata.normalize("NFKC", str(text)).casefold().split())
+
+
+def _score(text_norm: str, title_norm: str, name_norm: str) -> float:
+    if len(name_norm) < 2:
+        return 0.0
+    if name_norm in text_norm:
+        return _SUBSTRING_SCORE
+    if title_norm:
+        ratio = SequenceMatcher(None, title_norm, name_norm).ratio()
+        return round(ratio, 3) if ratio >= _FUZZY_FLOOR else 0.0
+    return 0.0
+
+
+def suggest_scope(title: str, content: str, *, metric_names: list[tuple[str, str]],
+                  term_names: list[tuple[str, list[str]]]) -> list[dict[str, Any]]:
+    """为候选推荐可绑定的指标/术语。
+
+    Args:
+        title: 候选标题。
+        content: 候选内容。
+        metric_names: [(metric_key, name)]。
+        term_names: [(term_id, [name, *synonyms])]。
+
+    Returns:
+        [{kind: metric|term, key, name, score}]，按分数降序、至多 3 条。
+    """
+    text_norm, title_norm = _normal(f"{title} {content}"), _normal(title)
+    out: list[dict[str, Any]] = []
+    for key, name in metric_names:
+        score = _score(text_norm, title_norm, _normal(name))
+        if score:
+            out.append({"kind": "metric", "key": key, "name": name, "score": score})
+    for term_id, names in term_names:
+        best = max((_score(text_norm, title_norm, _normal(name)) for name in names if name), default=0.0)
+        if term_id and best:
+            out.append({"kind": "term", "key": term_id, "name": names[0], "score": best})
+    out.sort(key=lambda item: -float(item["score"]))
+    seen: set[tuple[str, str]] = set()
+    unique: list[dict[str, Any]] = []
+    for item in out:
+        sig = (str(item["kind"]), str(item["key"]))
+        if sig not in seen:
+            seen.add(sig)
+            unique.append(item)
+    return unique[:_MAX_SUGGESTIONS]
+
+
+def load_catalog(workspace_id: str) -> dict[str, Any]:
+    """读取一次指标/术语目录供整批蒸馏共享；目录不可用返回空集（不影响抽取）。"""
+    metric_names: list[tuple[str, str]] = []
+    term_names: list[tuple[str, list[str]]] = []
+    try:
+        from ..metrics import store as metrics_store
+        metric_names = [(item.metric_key, item.name) for item in metrics_store.list_defs(workspace_id)]
+    except Exception:  # noqa: BLE001 — 建议是增强项，目录失败不阻塞蒸馏
+        pass
+    try:
+        from ..glossary import db as glossary_db
+        for term in glossary_db.list_terms(status="active"):
+            names = [str(term.get("name") or "")] + [str(alias) for alias in (term.get("synonyms_list") or [])]
+            term_names.append((str(term.get("term_id") or ""), [name for name in names if name]))
+    except Exception:  # noqa: BLE001
+        pass
+    return {"metric_names": metric_names, "term_names": term_names}
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/selection.py b/jiuwenswarm/channels/web/dataagent/knowledge/selection.py
new file mode 100644
index 000000000..37ac43872
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/selection.py
@@ -0,0 +1,227 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Plan-aware selection; mandatory rules are never truncated by similarity."""
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime, timezone
+
+from . import store
+
+TARGET_KEYS = ("metric_keys", "term_ids", "entity_ids", "column_ids", "table_ids", "dimensions", "scenarios")
+
+
+def target_refs(scope: dict) -> set[str]:
+    return {str(ref) for key in TARGET_KEYS for ref in scope.get(key) or []}
+
+
+def visible_assets(*, source_ids: list[str] | None = None, versions: dict | None = None) -> list[dict]:
+    """Published authority only; used by discovery, full-read and L2 completion."""
+    context = {"source_ids": source_ids or [], "semantic_versions": versions or {},
+               "release_id": (versions or {}).get("release_id")}
+    return [asset for asset in store.list_assets(status="published")
+            if asset["asset_type"] in {"mapping", "rule"}
+            and not scope_reason(asset["scope"], context, set())]
+
+
+def rules_for_context(refs: set[str], *, source_ids: list[str] | None = None,
+                      versions: dict | None = None, assets: list[dict] | None = None) -> dict:
+    """Pre-plan applicability closure. Similarity and top-k never limit rules."""
+    visible = assets if assets is not None else visible_assets(source_ids=source_ids, versions=versions)
+    rules = [asset_view(asset) for asset in visible if asset["asset_type"] == "rule"
+             and (target_refs(asset["scope"]).intersection(refs)
+                  # An unbound rule loads globally only when the reviewer marked
+                  # it workspace-wide; a missing binding is a governance debt,
+                  # not an implicit "applies to everything".
+                  or (not target_refs(asset["scope"]) and asset["scope"].get("workspace_wide") is True))]
+    return {"rules": rules, "trace": {"stage": "pre_plan", "rule_policy": "all_applicable",
+                                       "status": "ok", "rules_selected": len(rules),
+                                       "path": "metadata_applies_to+scope", "refs": sorted(refs)}}
+
+
+def bind_plan_refs(plan: dict, workspace_id: str, snapshots: dict) -> None:
+    """Add server-derived physical refs for final rule applicability checks.
+
+    A component selecting a metric need not repeat all of its bound columns in
+    material_refs. Rules scoped to those columns must still survive rechecking.
+    """
+    from ..metrics import semantic_link, store as metric_store
+    if not any(component.get("selected_metrics") for component in plan.get("components") or []):
+        return
+    source_map = semantic_link.resolve_source_map(workspace_id)
+    selected = {item["metric_key"]: item for item in plan.get("metrics_selected") or []}
+    for component in plan.get("components") or []:
+        refs = set()
+        for key in component.get("selected_metrics") or []:
+            metric = selected.get(key) or {}
+            from ..metrics.graph_projection import resolve_term, EDGE_MEASURES_CONCEPT
+            for mapping in metric_store.list_concept_maps(metric.get("revision_id") or "", status="confirmed"):
+                if mapping.relation_type == EDGE_MEASURES_CONCEPT:
+                    term = resolve_term(mapping.target_ref)
+                    if term and term.get("status") == "active":
+                        refs.add(str(term["term_id"]))
+            for binding in metric_store.list_bindings(metric.get("revision_id") or ""):
+                sid = source_map.get(binding.datasource_ref)
+                if not sid or sid not in snapshots or plan.get("source_id") and plan["source_id"] != sid:
+                    continue
+                candidates = [table for table in snapshots[sid].tables if table.status == "active"
+                              and (table.name == binding.source_table or table.fqn == binding.source_table)]
+                if len(candidates) != 1:
+                    continue
+                table = candidates[0]
+                refs.add(table.node_id)
+                bound_columns = {physical.split(".")[-1] for physical in binding.column_map.values()}
+                refs.update(column.node_id for column in table.columns
+                            if column.status == "active" and column.name in bound_columns)
+        component["authority_refs"] = sorted(refs)
+
+
+def resolve_for_plan(plan: dict) -> dict:
+    assets = store.list_assets(status="published")
+    rules, examples, evidence, rejected, per_component = {}, {}, {}, [], {}
+    for component in plan.get("components") or []:
+        cid = str(component.get("component_id") or "")
+        metrics = set(map(str, component.get("selected_metrics") or []))
+        metrics.update(map(str, component.get("derived_metrics") or []))
+        dimensions = set(map(str, component.get("dimensions") or []))
+        refs = set(map(str, component.get("material_refs") or []))
+        refs.update(map(str, component.get("authority_refs") or []))
+        refs |= {ref.removeprefix("term:") for ref in refs if ref.startswith("term:")}
+        refs |= {ref.removeprefix("entity:") for ref in refs if ref.startswith("entity:")}
+        refs |= {ref.removeprefix("mapping:") for ref in refs if ref.startswith("mapping:")}
+        refs |= {ref.removeprefix("rule:") for ref in refs if ref.startswith("rule:")}
+        refs |= {ref.removeprefix("metric:") for ref in refs if ref.startswith("metric:")}
+        refs |= {ref.removeprefix("dimension:") for ref in refs if ref.startswith("dimension:")}
+        refs |= set(map(str, plan.get("scenario_ids") or []))
+        refs |= metrics | dimensions
+        # Follow reviewed knowledge links, independent of catalog ordering.
+        linked_assets = {asset["asset_id"]: asset for asset in assets
+                         if asset["asset_type"] in {"mapping", "rule"}}
+        queue, visited = list(refs.intersection(linked_assets)), set()
+        while queue:
+            asset_id = queue.pop()
+            if asset_id in visited:
+                continue
+            visited.add(asset_id)
+            linked = linked_assets[asset_id]
+            if scope_reason(linked["scope"], plan, metrics):
+                continue
+            targets = target_refs(linked["scope"])
+            refs.update(targets)
+            queue.extend(targets.intersection(linked_assets).difference(visited))
+        crules, cexamples = [], []
+        component_evidence = {}
+        example_full: dict[str, dict] = {}
+        for asset in assets:
+            if asset["asset_type"] not in {"rule", "example"}:
+                continue
+            reason = scope_reason(asset["scope"], plan, metrics)
+            if reason:
+                rejected.append({"component_id": cid, "asset_id": asset["asset_id"], "reason": reason})
+                continue
+            scope = asset["scope"]
+            targets = set()
+            for key in ("metric_keys", "term_ids", "entity_ids", "column_ids", "table_ids", "dimensions", "scenarios"):
+                targets.update(map(str, scope.get(key) or []))
+            if asset["asset_type"] == "rule":
+                # Applicability edges are a union. Scope dimensions such as source,
+                # version and effective time are conjunctive gates above.
+                if not targets and scope.get("workspace_wide") is not True:
+                    continue  # unbound and unmarked: governance debt, not a global rule
+                if targets and not targets.intersection(refs):
+                    continue
+                # P0-1b：每成分只挂引用（asset_id+title），正文在全局 rules 区一份
+                # ——同批规则按成分各复制一份曾把 plan 响应撑到 122K（2026-10-21
+                # 实测信噪比 3%）。模型按 asset_id 关联同响应内的全局区。
+                crules.append({"asset_id": asset["asset_id"], "title": asset["title"]})
+                rules[asset["asset_id"]] = asset_view(asset)
+            else:
+                if targets and not targets.intersection(refs):
+                    reason = "plan_incompatible"
+                elif scope.get("metric_keys") and not set(scope["metric_keys"]).issubset(metrics):
+                    reason = "metric_mismatch"
+                elif scope.get("dimensions") and not set(scope["dimensions"]).issubset(dimensions):
+                    reason = "dimension_mismatch"
+                elif (scope.get("dialects")
+                      and str(plan.get("dialect") or "").lower() not in {x.lower() for x in scope["dialects"]}):
+                    reason = "dialect_mismatch"
+                if reason:
+                    rejected.append({"component_id": cid, "asset_id": asset["asset_id"], "reason": reason})
+                    continue
+                # P0-1b：样例同规则处理——每成分引用（asset_id+title），全文在全局
+                # examples 区；预算仍按全文大小计（下方 example_full）。
+                cexamples.append({"asset_id": asset["asset_id"], "title": asset["title"]})
+                example_full[asset["asset_id"]] = asset_view(asset)
+            source = asset["source"]
+            if source.get("evidence_id"):
+                citation = {"asset_id": asset["asset_id"],
+                    "document_version_id": source.get("document_version_id"), "evidence_id": source["evidence_id"],
+                    "span": source.get("evidence_span"), "quote": source.get("evidence_quote")}
+                evidence[asset["asset_id"]] = citation
+                component_evidence[asset["asset_id"]] = citation
+        # Optional examples use their own bounded budget. Rules remain complete.
+        example_budget = max(0, int(os.environ.get("KNOWLEDGE_EXAMPLE_MAX_CHARS", "8000")))
+        used, retained = 0, []
+        for example in sorted(cexamples, key=lambda a: a["asset_id"]):
+            size = len(json.dumps(example_full.get(example["asset_id"]) or example, ensure_ascii=False))
+            if used + size > example_budget:
+                rejected.append({"component_id": cid, "asset_id": example["asset_id"], "reason": "example_budget"})
+                continue
+            used += size
+            retained.append(example)
+            examples[example["asset_id"]] = example_full[example["asset_id"]]
+        per_component[cid] = {"rules": crules, "examples": retained,
+                              # evidence 同 rules 处理：成分只挂 asset_id 引用，引用全文
+                              # 在全局 evidence 区一份（12 条 citation × N 成分的副本
+                              # 曾占 plan 响应 ~11K）
+                              "evidence": sorted(component_evidence),
+                              "example_chars": used,
+                              "g1_uses_examples": False}
+    return {"rules": list(rules.values()), "examples": list(examples.values()),
+            "evidence": list(evidence.values()), "components": per_component,
+            "trace": {"rule_policy": "all_applicable", "rules_selected": len(rules),
+                      "examples_selected": len(examples), "examples_rejected": rejected,
+                      "g1_uses_examples": False}}
+
+
+def scope_reason(scope: dict, plan: dict, metrics: set[str]) -> str:
+    now = datetime.now(timezone.utc)
+    if scope.get("valid_from") and _time(scope["valid_from"]) > now:
+        return "not_yet_valid"
+    if scope.get("valid_to") and _time(scope["valid_to"]) <= now:
+        return "expired"
+    # Scope gates are conjunctive over dimensions the plan actually declared.
+    # Single-source workspaces routinely omit source_id; an undeclared source
+    # must not reject assets scoped to the workspace's only source.
+    sources = {plan["source_id"]} if plan.get("source_id") else set(plan.get("source_ids") or [])
+    if scope.get("source_ids") and sources and not sources.intersection(scope["source_ids"]):
+        return "source_scope_mismatch"
+    if scope.get("release_ids") and plan.get("release_id") not in scope["release_ids"]:
+        return "release_mismatch"
+    snapshots = {str(s.get("snapshot_id") or "") for s in (plan.get("semantic_versions") or {}).get("snapshots", [])}
+    if scope.get("snapshot_ids") and not set(scope["snapshot_ids"]).issubset(snapshots):
+        return "snapshot_mismatch"
+    revisions = {str(m.get("metric_key")): str(m.get("revision_id") or "") for m in plan.get("metrics_selected") or []}
+    if any(key in metrics and revisions.get(key) != revision
+           for key, revision in (scope.get("metric_revisions") or {}).items()):
+        return "metric_revision_mismatch"
+    return ""
+
+
+def asset_view(asset: dict) -> dict:
+    # LLM 面视图：不带 source（path/sha256/parser/chunker 等 14 键出处约 734 字符/条，
+    # 为正文的 5 倍，模型从不消费；实测 2026-10-21 会话规则 6 次重复传输 64K 字符，
+    # 信噪比 3%）。溯源不依赖本视图：knowledge store 按 asset_id 持有全量出处，
+    # resolve_for_plan 的 evidence 区另留紧凑引用（document_version_id/span/quote）。
+    # origin 单键保留：manual/schema_auto 的证据豁免判据（评审即出处 / schema
+    # 元素即出处，见 validate_publication）需随数据流进 manifest，否则下游
+    # 断言只能看见「无锚点」而恒误报（2026-10-22 评测 17 例 knowledge 误判根因）。
+    row = {key: asset[key] for key in ("asset_id", "title", "content", "revision", "scope", "asset_type")}
+    row["origin"] = (asset.get("source") or {}).get("origin") or ""
+    return row
+
+
+def _time(value: str) -> datetime:
+    """解析时间；naive 按本地时区（与全仓 timeutil 契约一致，2026-10-27 起）。"""
+    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    return parsed if parsed.tzinfo else parsed.astimezone()
diff --git a/jiuwenswarm/channels/web/dataagent/knowledge/store.py b/jiuwenswarm/channels/web/dataagent/knowledge/store.py
new file mode 100644
index 000000000..77649d4b0
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/knowledge/store.py
@@ -0,0 +1,423 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Workspace-scoped candidate assets, immutable review events and publication.
+
+Metric/Term definitions remain in their existing stores. This table owns their
+document proposals and links, together with Rule/Example/Entity/Mapping assets.
+"""
+from __future__ import annotations
+
+import json
+import unicodedata
+import uuid
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import _connect, _exec, _fetch_dicts, _fetch_one_dict, _now
+from jiuwenswarm.common import workspace_context
+
+KINDS = {"rule", "example", "mapping", "term", "metric"}
+_SCOPE_LISTS = {"source_ids", "metric_keys", "term_ids", "entity_ids", "column_ids", "table_ids",
+                "dimensions", "scenarios", "release_ids", "snapshot_ids", "dialects"}
+
+
+def _workspace() -> str:
+    return workspace_context.current_workspace().workspace_id or "default"
+
+
+def _ensure() -> None:
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(workspace_context.current_workspace().metadata_db_ref)
+
+
+def _decode(row: dict | None) -> dict | None:
+    if row:
+        for field in ("scope_json", "source_json"):
+            if field in row:
+                row[field.removesuffix("_json")] = json.loads(row.pop(field) or "{}")
+    return row
+
+
+def normalize(text: str) -> str:
+    return " ".join(unicodedata.normalize("NFKC", str(text)).casefold().split())
+
+
+def validate_scope(scope: Any) -> dict:
+    if not isinstance(scope, dict):
+        raise ValueError("scope must be an object")
+    for key in _SCOPE_LISTS:
+        if key in scope and (not isinstance(scope[key], list)
+                             or any(not isinstance(x, str) or not x.strip() for x in scope[key])):
+            raise ValueError(f"scope.{key} must be an array of nonempty strings")
+    if "metric_revisions" in scope and (not isinstance(scope["metric_revisions"], dict)
+                                        or any(not isinstance(v, str) for v in scope["metric_revisions"].values())):
+        raise ValueError("scope.metric_revisions must map metric keys to revision ids")
+    from datetime import datetime
+    dates = {}
+    for key in ("valid_from", "valid_to"):
+        if scope.get(key):
+            try:
+                dates[key] = datetime.fromisoformat(str(scope[key]).replace("Z", "+00:00")).timestamp()
+            except (TypeError, ValueError) as exc:
+                raise ValueError(f"scope.{key} must be an ISO date/time") from exc
+    if len(dates) == 2 and dates["valid_from"] >= dates["valid_to"]:
+        raise ValueError("valid_to must follow valid_from")
+    return scope
+
+
+def _event(conn, asset_id: str, action: str, actor: str, payload: dict) -> None:
+    _exec(conn, "INSERT INTO dw_knowledge_events "
+          "(event_id,workspace_id,asset_id,action,actor,payload_json,created_at) VALUES (?,?,?,?,?,?,?)",
+          (f"ke_{uuid.uuid4().hex}", _workspace(), asset_id, action, actor,
+           json.dumps(payload, ensure_ascii=False), _now()))
+
+
+def events(asset_id: str) -> list[dict]:
+    _ensure()
+    conn = _connect()
+    try:
+        return _fetch_dicts(conn, "SELECT * FROM dw_knowledge_events WHERE workspace_id=? AND asset_id=? "
+                            "ORDER BY created_at,event_id", (_workspace(), asset_id))
+    finally:
+        conn.close()
+
+
+def create_candidate(data: dict[str, Any]) -> dict:
+    kind = str(data.get("asset_type") or "")
+    if kind not in KINDS:
+        raise ValueError(f"unsupported asset_type: {kind}")
+    title, content = str(data.get("title") or "").strip(), str(data.get("content") or "").strip()
+    if not title or len(title) > 512 or not content:
+        raise ValueError("title (1..512 characters) and content are required")
+    scope = validate_scope(data.get("scope") or {})
+    source = data.get("source") or {}
+    if not isinstance(source, dict):
+        raise ValueError("source must be an object")
+    _ensure()
+    # 可选 asset_id：可复现重建（fixture/迁移）需要稳定 ID，随机 UUID 会让
+    # 外部引用（评测断言、跨系统链接）每次重建必漂移；未传时行为不变。
+    # 幂等：同 ID 资产已存在时直接返回，不重复创建（fixture 语义）。
+    now = _now()
+    explicit_id = str(data.get("asset_id") or "").strip()
+    if explicit_id:
+        existing = get_asset(explicit_id)
+        if existing is not None:
+            return existing
+    asset_id = explicit_id or f"bk_{uuid.uuid4().hex[:20]}"
+    conn = _connect()
+    try:
+        _exec(conn, "INSERT INTO dw_business_knowledge "
+              "(asset_id,workspace_id,asset_type,title,content,scope_json,source_json,status,revision,owner,"
+              "created_at,updated_at,published_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
+              (asset_id, _workspace(), kind, title, content, json.dumps(scope, ensure_ascii=False),
+               json.dumps(source, ensure_ascii=False), "candidate", 1, str(data.get("owner") or ""), now, now, ""))
+        _event(conn, asset_id, "create", str(data.get("owner") or ""), data)
+        conn.commit()
+    finally:
+        conn.close()
+    return get_asset(asset_id) or {}
+
+
+def list_assets(*, status: str | None = None, asset_type: str | None = None) -> list[dict]:
+    _ensure()
+    where, args = ["workspace_id=?"], [_workspace()]
+    for col, val in (("status", status), ("asset_type", asset_type)):
+        if val:
+            where.append(f"{col}=?")
+            args.append(val)
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT * FROM dw_business_knowledge WHERE " + " AND ".join(where)
+                            + " ORDER BY updated_at DESC,asset_id", tuple(args))
+        return [_decode(row) for row in rows]
+    finally:
+        conn.close()
+
+
+def list_assets_page(*, status: str | None = None, asset_type: str | None = None,
+                     page: int = 0, page_size: int = 0) -> dict:
+    """分页 + 聚合计数的候选列表（筛选下推 SQL）。
+
+    Args:
+        status / asset_type: SQL WHERE 筛选（None = 不过滤）。
+        page: 从 1 开始；<=0 表示不分页（全量，兼容旧调用方）。
+        page_size: 每页条数；<=0 表示不分页。
+
+    Returns:
+        {assets, total, page, page_size, status_counts, type_counts}——
+        status_counts 为全库各状态计数（含 retired，「已退役」chip 需要）；
+        type_counts 只统计活跃条目（candidate/approved/published），供类型
+        chips 与 KPI，避免退役条目把「全部/术语/指标」的数字越堆越大。
+        ``status="active"`` 是特殊筛选值：排除 retired 的活跃视图。
+    """
+    _ensure()
+    where, args = ["workspace_id=?"], [_workspace()]
+    if status == "active":
+        where.append("status <> 'retired'")
+    elif status:
+        where.append("status=?")
+        args.append(status)
+    if asset_type:
+        where.append("asset_type=?")
+        args.append(asset_type)
+    clause = " WHERE " + " AND ".join(where)
+    limit_clause = ""
+    if page > 0 and page_size > 0:
+        limit_clause = " LIMIT ? OFFSET ?"
+        args = args + [int(page_size), (int(page) - 1) * int(page_size)]
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT * FROM dw_business_knowledge" + clause
+                            + " ORDER BY updated_at DESC,asset_id" + limit_clause, tuple(args))
+        total = int(_fetch_one_dict(conn, "SELECT COUNT(*) AS n FROM dw_business_knowledge" + clause,
+                                    tuple(args[:len(args) - 2] if limit_clause else args))["n"])
+        status_counts = {row["status"]: int(row["n"]) for row in _fetch_dicts(
+            conn, "SELECT status, COUNT(*) AS n FROM dw_business_knowledge WHERE workspace_id=? GROUP BY status",
+            (_workspace(),))}
+        type_counts = {row["asset_type"]: int(row["n"]) for row in _fetch_dicts(
+            conn, "SELECT asset_type, COUNT(*) AS n FROM dw_business_knowledge "
+                  "WHERE workspace_id=? AND status <> 'retired' GROUP BY asset_type",
+            (_workspace(),))}
+        return {"assets": [_decode(row) for row in rows], "total": total,
+                "page": int(page), "page_size": int(page_size),
+                "status_counts": status_counts, "type_counts": type_counts}
+    finally:
+        conn.close()
+
+
+def retired_sources() -> list[dict]:
+    """按来源文档聚合已退役条目，供「按文档清理」下拉。
+
+    Returns:
+        [{document_version_id, name, count}]，按条数降序；无来源（人工退役）
+        的条目不出现在这里（用按时间或全部清理）。
+    """
+    _ensure()
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT source_json FROM dw_business_knowledge "
+                            "WHERE workspace_id=? AND status='retired'", (_workspace(),))
+    finally:
+        conn.close()
+    grouped: dict[str, dict] = {}
+    for row in rows:
+        try:
+            source = json.loads(row["source_json"] or "{}")
+        except (TypeError, ValueError):
+            continue
+        version_id = str(source.get("document_version_id") or "")
+        if not version_id:
+            continue
+        item = grouped.setdefault(version_id, {"document_version_id": version_id,
+                                               "name": str(source.get("name") or "未知文档"), "count": 0})
+        item["count"] += 1
+    return sorted(grouped.values(), key=lambda item: (-item["count"], item["name"]))
+
+
+def purge_retired(*, older_than_days: int | None = None, document_version_id: str = "",
+                  purge_all: bool = False) -> dict:
+    """物理删除已退役资产行（``dw_knowledge_events`` 审计事件保留）。
+
+    Args:
+        older_than_days: 只清理 ``updated_at`` 早于 N 天的退役条目。
+        document_version_id: 只清理来源文档版本匹配的退役条目。
+        purge_all: 清理当前工作空间全部退役条目。
+
+    Returns:
+        {deleted: 删除条数, asset_ids: 被删除的 id（最多 200 个）}。
+
+    Raises:
+        ValueError: 三个条件都未指定（防误清空整个工作空间）。
+    """
+    if older_than_days is None and not document_version_id and not purge_all:
+        raise ValueError("purge requires older_than_days, document_version_id, or all=true")
+    _ensure()
+    where, args = ["workspace_id=?", "status='retired'"], [_workspace()]
+    if older_than_days is not None:
+        from datetime import datetime, timedelta
+
+        cutoff = (datetime.now().astimezone()
+                  - timedelta(days=max(0, int(older_than_days)))).isoformat(timespec="seconds")
+        where.append("updated_at < ?")
+        args.append(cutoff)
+    conn = _connect()
+    try:
+        rows = _fetch_dicts(conn, "SELECT asset_id,source_json FROM dw_business_knowledge WHERE "
+                            + " AND ".join(where), tuple(args))
+        if document_version_id:
+            rows = [row for row in rows
+                    if json.loads(row["source_json"] or "{}").get("document_version_id") == document_version_id]
+        asset_ids = [str(row["asset_id"]) for row in rows]
+        for start in range(0, len(asset_ids), 200):
+            chunk = asset_ids[start:start + 200]
+            placeholders = ",".join("?" * len(chunk))
+            _exec(conn, "DELETE FROM dw_business_knowledge WHERE workspace_id=? AND status='retired' "
+                  f"AND asset_id IN ({placeholders})", (_workspace(), *chunk))
+        conn.commit()
+    finally:
+        conn.close()
+    return {"deleted": len(asset_ids), "asset_ids": asset_ids[:200]}
+
+
+def get_asset(asset_id: str) -> dict | None:
+    _ensure()
+    conn = _connect()
+    try:
+        return _decode(_fetch_one_dict(conn, "SELECT * FROM dw_business_knowledge WHERE asset_id=? AND workspace_id=?",
+                                       (asset_id, _workspace())))
+    finally:
+        conn.close()
+
+
+def conflicts(asset: dict) -> list[dict]:
+    """Deterministic name/definition checks; unresolved proposals never publish."""
+    out = []
+    for other in list_assets():
+        if other["asset_id"] == asset["asset_id"] or other["status"] == "retired":
+            continue
+        if other["asset_type"] != asset["asset_type"] or normalize(other["title"]) != normalize(asset["title"]):
+            continue
+        left, right = asset.get("scope") or {}, other.get("scope") or {}
+        if any(left.get(k) and right.get(k) and not set(left[k]) & set(right[k])
+               for k in ("source_ids", "scenarios")):
+            continue
+        if normalize(other["content"]) != normalize(asset["content"]):
+            out.append({"asset_id": other["asset_id"], "kind": "document_definition_conflict",
+                        "title": other["title"], "content": other["content"], "status": other["status"],
+                        "evidence": (other.get("source") or {}).get("evidence_quote", ""),
+                        "name": (other.get("source") or {}).get("name", "")})
+    if asset["asset_type"] == "term":
+        from ..glossary import db
+        for term in db.list_terms(status="active"):
+            if normalize(asset["title"]) in {normalize(term["name"]), *map(normalize, term.get("synonyms_list") or [])}:
+                if normalize(asset["content"]) != normalize(term["definition"]):
+                    out.append({"asset_id": term["term_id"], "kind": "existing_term_conflict",
+                                "title": term["name"], "content": term["definition"]})
+    if asset["asset_type"] == "metric":
+        from ..metrics import store as metrics
+        for metric in metrics.list_defs(_workspace()):
+            if normalize(asset["title"]) in {normalize(metric.name), normalize(metric.metric_key)}:
+                out.append({"asset_id": metric.metric_id, "kind": "existing_metric_requires_alignment",
+                            "title": metric.name, "revision_id": metric.current_revision_id})
+    return out
+
+
+def update_candidate(asset_id: str, data: dict) -> dict | None:
+    asset = get_asset(asset_id)
+    if asset is None:
+        return None
+    if asset["status"] not in {"candidate", "approved"}:
+        raise ValueError("published assets are immutable; create a new candidate version")
+    scope = validate_scope(data.get("scope", asset["scope"]))
+    # source 合并而非整体替换：评审场景只需补 alignment_decision/synonyms 等
+    # 评审字段；蒸馏写入的证据链（document_version_id/evidence_*）不在请求体里，
+    # 整体替换会把它们静默抹掉，直到 publish 才被门禁拦下且错误不指向根因。
+    incoming_source = data.get("source")
+    if incoming_source is None:
+        source = asset["source"]
+    elif isinstance(incoming_source, dict):
+        source = {**asset["source"], **incoming_source}
+    else:
+        raise ValueError("source must be an object")
+    title, content = str(data.get("title", asset["title"])).strip(), str(data.get("content", asset["content"])).strip()
+    if not title or len(title) > 512 or not content or not isinstance(source, dict):
+        raise ValueError("invalid candidate content or source")
+    _ensure()
+    conn = _connect()
+    try:
+        cursor = _exec(conn, "UPDATE dw_business_knowledge SET title=?,content=?,scope_json=?,source_json=?,"
+                      "status='candidate',revision=revision+1,updated_at=? "
+                      "WHERE asset_id=? AND workspace_id=? AND revision=?",
+                      (title, content, json.dumps(scope, ensure_ascii=False), json.dumps(source, ensure_ascii=False),
+                       _now(), asset_id, _workspace(), asset["revision"]))
+        if cursor.rowcount != 1:
+            # 与 transition() 同纪律：并发编辑时后写者匹配 0 行，静默返回他人
+            # 版本等于丢稿——回滚 + 抛错让调用方重读
+            conn.rollback()
+            raise ValueError("candidate changed concurrently; reload before editing")
+        _event(conn, asset_id, "update", str(data.get("actor") or ""), data)
+        conn.commit()
+    finally:
+        conn.close()
+    return get_asset(asset_id)
+
+
+def transition(asset_id: str, action: str, *, actor: str = "", resolution: str = "") -> dict | None:
+    target = {"approve": "approved", "publish": "published", "retire": "retired"}.get(action)
+    if not target:
+        raise ValueError("action must be approve, publish, or retire")
+    asset = get_asset(asset_id)
+    if not asset:
+        return None
+    allowed = {"approve": {"candidate"}, "publish": {"approved"}, "retire": {"published", "approved", "candidate"}}
+    if asset["status"] == target:
+        return asset
+    if asset["status"] not in allowed[action]:
+        raise ValueError(f"cannot {action} asset in {asset['status']} status")
+    # scope 归一化只发生在 publish 分支；approve/retire 路径必须预置 False，
+    # 否则下方 UPDATE 分支引用未赋值变量（8b3cb6e79 引入的缺陷）。
+    scope_pinned = False
+    conflict_rows = conflicts(asset) if action in {"approve", "publish"} else []
+    if conflict_rows and not (resolution.strip() or any(json.loads(event["payload_json"]).get("resolution")
+                                                        for event in events(asset_id) if event["action"] == "approve")):
+        raise ValueError("unresolved knowledge conflicts: record resolution or revise the candidate")
+    if action == "publish":
+        from .publication import validate_publication, normalize_scope_refs
+        validate_publication(asset)
+        # Publication is the reviewed moment to pin logical table.column refs
+        # to snapshot node IDs; the normalized scope is what read-side
+        # expansion and graph projection consume.
+        normalized = normalize_scope_refs(asset)
+        scope_pinned = normalized["scope"] != asset["scope"]
+        asset = normalized
+    authority_result = None
+    if action == "publish" and asset["asset_type"] in {"term", "metric"}:
+        from .publication import publish_authority_asset
+        # Authority projection is idempotent (new term IDs derive from asset_id)
+        # and is prepared outside the catalog transaction. A concurrent catalog
+        # update therefore cannot leave an open SQL transaction around a graph or
+        # glossary write; a retry reconciles the same authority reference.
+        authority_result = publish_authority_asset(asset)
+    conn = _connect()
+    try:
+        if scope_pinned:
+            cursor = _exec(conn, "UPDATE dw_business_knowledge SET status=?,revision=revision+1,updated_at=?,"
+                           "published_at=?,scope_json=? WHERE asset_id=? AND workspace_id=? "
+                           "AND revision=? AND status=?",
+                           (target, _now(), _now(), json.dumps(asset["scope"], ensure_ascii=False),
+                            asset_id, _workspace(), asset["revision"], asset["status"]))
+        else:
+            cursor = _exec(conn, "UPDATE dw_business_knowledge SET status=?,revision=revision+1,"
+                           "updated_at=?,published_at=? "
+                           "WHERE asset_id=? AND workspace_id=? AND revision=? AND status=?",
+                           (target, _now(), _now() if target == "published" else asset.get("published_at", ""),
+                            asset_id, _workspace(), asset["revision"], asset["status"]))
+        if cursor.rowcount != 1:
+            conn.rollback()
+            raise ValueError("candidate changed concurrently; reload before reviewing")
+        _event(conn, asset_id, action, actor, {"resolution": resolution, "conflicts": conflict_rows,
+                                            "revision": asset["revision"] + 1,
+                                            "authority_result": authority_result})
+        conn.commit()
+    finally:
+        conn.close()
+    result = get_asset(asset_id)
+    if action in {"publish", "retire"}:
+        from .publication import project_asset
+        if result["asset_type"] in {"metric", "term"}:
+            result["projection"] = authority_result or {"status": "retired"}
+        else:
+            result["projection"] = project_asset(result)
+        conn = _connect()
+        try:
+            _event(conn, asset_id, "projection", actor, result["projection"])
+            conn.commit()
+        finally:
+            conn.close()
+    if action == "retire" and result["asset_type"] == "term":
+        from .publication import retire_authority_asset
+        result["authority_retirement"] = retire_authority_asset(asset_id, events(asset_id))
+    return result
+
+
+def resolve_for_plan(plan: dict[str, Any]) -> dict[str, Any]:
+    from .selection import resolve_for_plan as resolve
+    return resolve(plan)
