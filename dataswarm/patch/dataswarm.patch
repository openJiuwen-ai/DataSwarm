+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""datasource.yaml 路径解析必须跟随 JIUWENSWARM_DATA_DIR。
+
+多实例 / 桌面隔离 / dataswarm_boot 注入都靠该 env 隔离数据目录；
+`_datasource_config_path` 硬编码 ``~/.jiuwenswarm`` 会让 workspace 配置
+串到基座目录（冻结 exe 探针实测，2026-11-02）。
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+from jiuwenswarm.common import db_connector
+
+
+def _reset_workspace_cache(monkeypatch) -> None:
+    """清 get_user_workspace_dir 的模块级缓存，让本条测试的 env 生效。"""
+    monkeypatch.setattr(
+        "jiuwenswarm.common.utils._workspace_base_dir", None
+    )
+
+
+def test_config_path_follows_data_dir_env(monkeypatch, tmp_path):
+    _reset_workspace_cache(monkeypatch)
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(tmp_path))
+    path = db_connector._datasource_config_path()
+    assert path == tmp_path / "config" / "datasource.yaml"
+
+
+def test_config_path_env_prefers_existing_yaml(monkeypatch, tmp_path):
+    _reset_workspace_cache(monkeypatch)
+    data_dir = tmp_path / "iso"
+    (data_dir / "config").mkdir(parents=True)
+    (data_dir / "config" / "datasource.yaml").write_text(
+        "mysql:\n  database: x\n", encoding="utf-8"
+    )
+    monkeypatch.setenv("JIUWENSWARM_DATA_DIR", str(data_dir))
+    assert db_connector._datasource_config_path() == (
+        data_dir / "config" / "datasource.yaml"
+    )
+
+
+def test_config_path_without_env_falls_back_to_default_home(monkeypatch):
+    _reset_workspace_cache(monkeypatch)
+    monkeypatch.delenv("JIUWENSWARM_DATA_DIR", raising=False)
+    path = db_connector._datasource_config_path()
