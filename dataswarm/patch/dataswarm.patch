@@ -0,0 +1,83 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useLayoutEffect, useRef, useState, type ReactNode } from 'react';
+import './Table.css';
+
+/** 滚动表格：可见表头在纵向滚动区之外，数据区独立滚动，横向滚动同步。
+ *  可见表头即语义表头（支持复选框等交互内容）；数据表内的隐藏表头仅用于列宽测量，
+ *  通过 visibility:hidden 退出无障碍树与焦点序列，避免交互内容被复制出隐形焦点。 */
+export function Table({ headers, children, className }: { headers: ReactNode[]; children: ReactNode; className?: string }) {
+  const bodyRef = useRef<HTMLDivElement>(null);
+  const tableRef = useRef<HTMLTableElement>(null);
+  const headerRef = useRef<HTMLDivElement>(null);
+  const [layout, setLayout] = useState<{ widths: number[]; gutter: number }>({
+    widths: [],
+    gutter: 0,
+  });
+
+  useLayoutEffect(() => {
+    const body = bodyRef.current;
+    const table = tableRef.current;
+    if (!body || !table) return;
+    const cells = Array.from(table.tHead!.rows[0].cells);
+    const measure = () => {
+      const widths = cells.map(cell => cell.getBoundingClientRect().width);
+      const gutter = body.offsetWidth - body.clientWidth;
+      setLayout(previous =>
+        previous.gutter === gutter && previous.widths.length === widths.length && previous.widths.every((width, index) => width === widths[index])
+          ? previous
+          : { widths, gutter },
+      );
+      if (headerRef.current) headerRef.current.scrollLeft = body.scrollLeft;
+    };
+    measure();
+    const observer = new ResizeObserver(measure);
+    observer.observe(body);
+    observer.observe(table);
+    cells.forEach(cell => observer.observe(cell));
+    return () => observer.disconnect();
+  }, [headers.length]);
+
+  return (
+    <div className={className ? `${className} ui-scroll-table` : 'ui-scroll-table'}>
+      <div className="ui-scroll-table-head" style={{ paddingRight: layout.gutter }}>
+        <div ref={headerRef} className="ui-scroll-table-head-viewport">
+          <table className="ui-table" style={{ width: layout.widths.reduce((sum, width) => sum + width, 0), tableLayout: 'fixed' }}>
+            <colgroup>
+              {layout.widths.map((width, index) => (
+                <col key={index} style={{ width }} />
+              ))}
+            </colgroup>
+            <thead>
+              <tr>
+                {headers.map((header, index) => (
+                  <th key={index}>{header}</th>
+                ))}
+              </tr>
+            </thead>
+          </table>
+        </div>
+      </div>
+      <div
+        ref={bodyRef}
+        className="ui-scroll-table-body"
+        tabIndex={0}
+        onScroll={event => {
+          if (headerRef.current) headerRef.current.scrollLeft = event.currentTarget.scrollLeft;
+        }}
+      >
+        <table ref={tableRef} className="ui-table">
+          <thead className="ui-scroll-table-sizing-head" aria-hidden="true">
+            <tr>
+              {headers.map((header, index) => (
+                <th key={index}>
+                  <div>{header}</div>
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>{children}</tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
