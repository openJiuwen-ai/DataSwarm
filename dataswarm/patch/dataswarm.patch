+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""数据源表单字段标签的 i18n 契约。
+
+前端 SourceFormDrawer 按 ``dataSource.form.<field.key>Label`` 查翻译渲染字段标签；
+registry 新增字段而 locale 漏补时，表单会把 i18n key 原样显示出来
+（如 ``dataSource.form.table_nameLabel``）。这里锁定：每个已注册数据源类型的
+每个字段，en / zh 两份 locale 都必须有对应的 Label。
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import registry
+
+_REPOSITORY_ROOT = Path(__file__).resolve().parents[3]
+_LOCALES_DIR = _REPOSITORY_ROOT / "jiuwenswarm" / "channels" / "web" / "frontend" / "src" / "i18n" / "locales"
+
+
+def _source_field_keys() -> set[str]:
+    return {field["key"] for entry in registry.list_source_types() for field in entry["fields"]}
+
+
+@pytest.mark.parametrize("lang", ["en", "zh"])
+def test_every_source_field_has_form_label(lang):
+    form = json.loads((_LOCALES_DIR / f"{lang}.json").read_text(encoding="utf-8"))["dataSource"]["form"]
+    missing = sorted(key for key in _source_field_keys() if f"{key}Label" not in form)
+    assert not missing, f"{lang}.json 缺少 dataSource.form.<key>Label：{missing}"
