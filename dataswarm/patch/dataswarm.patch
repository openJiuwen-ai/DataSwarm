+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 看板列表页：卡片视图展示所有看板。 */
+
+import { useDashboardStore } from '../store/dashboardStore';
+import { EmptyState, Button, Badge } from '../../_shared/ui';
+import { dashboardTexts } from '../../_shared/texts';
+import { useState } from 'react';
+import { Plus, Trash2, LayoutDashboard } from 'lucide-react';
+
+export function DashboardListPage() {
+  const store = useDashboardStore();
+  const [showCreate, setShowCreate] = useState(false);
+  const [name, setName] = useState('');
+
+  const handleCreate = async () => {
+    if (!name.trim()) return;
+    await store.createDashboard({ name: name.trim() });
+    setName('');
+    setShowCreate(false);
+  };
+
+  return (
+    <div>
+      <div className="mb-6 flex items-center justify-between">
+        <div>
+          <h2 className="text-xl font-semibold text-text-strong">{dashboardTexts.dashboardList.title}</h2>
+          <p className="mt-1 text-xs text-text-muted">{dashboardTexts.dashboardList.subtitle}</p>
+        </div>
+        <Button variant="primary" onClick={() => setShowCreate(true)}>
+          <Plus size={14} className="mr-1 inline" /> {dashboardTexts.dashboardList.create}
+        </Button>
+      </div>
+
+      {showCreate && (
+        <div className="mb-4 flex items-center gap-2 rounded-lg border border-accent bg-accent-subtle p-3">
+          <input
+            className="flex-1 rounded border border-border bg-bg px-3 py-1.5 text-sm text-text focus:border-accent focus:outline-none"
+            placeholder={dashboardTexts.dashboardList.namePlaceholder}
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            onKeyDown={(e) => { if (e.key === 'Enter') void handleCreate(); }}
+            autoFocus
+          />
+          <Button variant="primary" onClick={() => void handleCreate()}>创建</Button>
+          <Button variant="ghost" onClick={() => setShowCreate(false)}>取消</Button>
+        </div>
+      )}
+
+      {store.dashboards.length === 0 ? (
+        <EmptyState
+          icon={<LayoutDashboard size={32} />}
+          title={dashboardTexts.dashboardList.emptyTitle}
+          hint={dashboardTexts.dashboardList.emptyHint}
+          actionLabel={`+ ${dashboardTexts.dashboardList.create}`}
+          onAction={() => setShowCreate(true)}
+        />
+      ) : (
+        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
+          {store.dashboards.map((d) => (
+            <div
+              key={d.dashboard_id}
+              className="group cursor-pointer rounded-xl border border-border bg-card p-4 shadow-sm transition hover:border-accent hover:shadow-md"
+              onClick={() => void store.selectDashboard(d.dashboard_id)}
+            >
+              <div className="flex items-start justify-between">
+                <div className="flex items-center gap-2">
+                  <LayoutDashboard size={18} className="text-text-link" />
+                  <h3 className="font-semibold text-text-strong">{d.name}</h3>
+                </div>
+                <div className="flex items-center gap-1 opacity-0 transition group-hover:opacity-100">
+                  <button
+                    className="rounded p-1 text-text-muted hover:bg-danger-subtle hover:text-danger"
+                    onClick={(e) => { e.stopPropagation(); void store.deleteDashboard(d.dashboard_id); }}
+                  >
+                    <Trash2 size={14} />
+                  </button>
+                </div>
+              </div>
+              {d.description && <p className="mt-2 text-xs text-text-muted line-clamp-2">{d.description}</p>}
+              <div className="mt-3 flex items-center justify-between text-xs text-text-muted">
+                <span>{d.cards_count ?? d.cards?.length ?? 0} 个卡片</span>
