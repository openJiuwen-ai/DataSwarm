index 000000000..e3474b77f
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/connectors/base.py
@@ -0,0 +1,259 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""统一连接器协议和数据源对象。
+
+Connector 提供连通性、目录、结构和关闭端口；SQL 查询、表扫描与仅元数据
+能力分别由 SqlQueryable、TabularScannable、MetadataOnly 声明。
+
+runtime_checkable Protocol 按方法是否存在判断能力。query/preview 不能在
+Connector 中作为占位方法，否则不支持 SQL 的子类也会通过能力检查。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Protocol, runtime_checkable
+
+
+@dataclass(frozen=True)
+class SourceDefinition:
+    source_id: str
+    source_type: str
+    name: str
+    engine: str
+    config: dict[str, Any]
+    enabled: bool = True
+    config_version: int = 1
+
+
+class Connector:
+    """通用连接器基类：只放所有数据源都成立的端口。
+
+    ``query`` / ``preview`` 不在这里——见模块 docstring，它们属于
+    :class:`SqlQueryable` 能力协议。
+    """
+
+    engine = ""
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+    def test_connection(self) -> dict:
+        raise NotImplementedError
+
+    def catalog(self) -> dict:
+        raise NotImplementedError
+
+    def schema(self, dataset: str, schema_name: str | None = None) -> dict:
+        """描述数据集的列结构。
+
+        关系库通过反射、文件源通过嗅探、文档存储通过采样、DDL 源通过解析取得结构。
+        """
+        raise NotImplementedError
+
+    def close(self) -> None:
+        return None
+
+
+# ==========================================================================
+# catalog 统一返回结构
+# ==========================================================================
+# datasets 始终提供扁平列表，schemas 提供按 schema 分组的兼容视图。
+# 各引擎共用该构造函数，调用方无需按引擎判断返回结构。
+def build_catalog(
+    *,
+    source_id: str,
+    engine: str,
+    datasets: "list[dict[str, Any]]",
+) -> dict:
+    """构造统一的 catalog 返回体。
+
+    Args:
+        source_id: 数据源 id。
+        engine: 执行引擎名。
+        datasets: 扁平数据集列表，每项至少含 ``name``；可选 ``schema`` /
+            ``type``（table / view / file）/ ``format``。
+
+    Returns:
+        ``{source_id, engine, datasets, schemas}``。``schemas`` 由 datasets 按
+        ``schema`` 字段分组派生，顺序与 datasets 内首次出现顺序一致。
+    """
+    normalized: list[dict[str, Any]] = []
+    for item in datasets:
+        entry = {
+            "name": str(item.get("name") or ""),
+            "schema": item.get("schema"),
+            "type": str(item.get("type") or "table"),
+        }
+        if item.get("format"):
+            entry["format"] = str(item["format"])
+        normalized.append(entry)
+
+    grouped: dict[Any, list[dict]] = {}
+    for entry in normalized:
+        grouped.setdefault(entry["schema"], []).append(
+            {"name": entry["name"], "type": entry["type"]}
+        )
+    return {
+        "source_id": source_id,
+        "engine": engine,
+        "datasets": normalized,
+        "schemas": [
+            {"name": schema_name or "", "tables": tables}
+            for schema_name, tables in grouped.items()
+        ],
+    }
+
+
+# ==========================================================================
+# schema 统一返回结构
+# ==========================================================================
+#: 分区列候选名。
+#: 分区列对大表查询的 WHERE 下推至关重要，原 schema() 完全不回传这个信息。
+_PARTITION_CANDIDATES = ("ds", "dt", "stat_date", "data_date")
+
+
+def detect_partition_key(column_names: "list[str]") -> "str | None":
+    """按候选名识别分区列（大小写不敏感，返回原始列名）。"""
+    by_lower = {str(c).lower(): str(c) for c in column_names}
+    for candidate in _PARTITION_CANDIDATES:
+        if candidate in by_lower:
+            return by_lower[candidate]
+    return None
+
+
+def build_schema(
+    *,
+    source_id: str,
+    dataset: str,
+    columns: "list[dict[str, Any]]",
+    schema_name: "str | None" = None,
+) -> dict:
+    """构造包含主键、注释和分区信息的统一 schema 返回体。
+
+    主键供知识候选排除技术列，注释补充业务含义，分区信息供查询下推使用。
+
+    Args:
+        columns: 每项至少含 name/type，可选 nullable/default/pk/comment。
+
+    Returns:
+        {source_id, dataset, schema, columns, primary_key, partition_key}。
+        列保留 name/type/nullable/default，并补充 pk/comment/is_partition。
+    """
+    names = [str(c.get("name") or "") for c in columns]
+    partition_key = detect_partition_key(names)
+    normalized: list[dict[str, Any]] = []
+    for column in columns:
+        name = str(column.get("name") or "")
+        normalized.append(
+            {
+                "name": name,
+                "type": str(column.get("type") or ""),
+                "nullable": bool(column.get("nullable", True)),
+                "default": column.get("default"),
+                "pk": bool(column.get("pk")),
+                "comment": str(column.get("comment") or ""),
+                "is_partition": name == partition_key,
+            }
+        )
+    return {
+        "source_id": source_id,
+        "dataset": dataset,
+        "schema": schema_name,
+        "columns": normalized,
+        "primary_key": [c["name"] for c in normalized if c["pk"]],
+        "partition_key": partition_key,
+    }
+
+
+# ==========================================================================
+# 能力协议
+# ==========================================================================
+@runtime_checkable
+class SqlQueryable(Protocol):
+    """支持只读 SQL 查询和数据预览的能力协议。"""
+
+    def preview(self, dataset: str, limit: int = 100) -> dict:
+        ...
+
+    def query(self, sql: str, params=None, limit: int = 100) -> dict:
+        ...
+
+
+@runtime_checkable
+class TabularScannable(Protocol):
+    """支持谓词与投影扫描的能力协议，适用于 MongoDB/HBase/Redis。
+
+    扫描结果由上层物化到 DuckDB，聚合与关联使用 SQL 执行。
+    """
+
+    def infer_schema(self, dataset: str, sample: int = 1000) -> dict:
+        ...
+
+    def scan(self, dataset: str, filters=None, projection=None, limit: int = 100) -> dict:
+        ...
+
+
+@runtime_checkable
+class MetadataOnly(Protocol):
+    """只提供结构、不提供数据的源（DDL 文本）。"""
+
+    def manifest(self) -> dict:
+        ...
+
+
+#: 能力名 → 协议。新增能力在此登记一行，``capabilities_of`` 自动生效。
+CAPABILITY_PROTOCOLS: dict[str, type] = {
+    "sql": SqlQueryable,
+    "scan": TabularScannable,
+    "metadata_only": MetadataOnly,
+}
+
+
+def capabilities_of(connector: Any) -> set[str]:
+    """根据连接器实现的运行时协议返回实际能力集。"""
+    return {
+        name
+        for name, protocol in CAPABILITY_PROTOCOLS.items()
+        if isinstance(connector, protocol)
+    }
+
+
+# ==========================================================================
+# 引擎注册表
+# ==========================================================================
+# ConnectorManager 按声明的引擎名查找连接器，重复注册会被拒绝。
+_ENGINE_REGISTRY: dict[str, type[Connector]] = {}
+
+
+def register_engine(name: str):
+    """装饰器：注册执行引擎。重名时后注册的报错（防静默覆盖，与
+    ``@register_source_type`` 同口径）。"""
+
+    def decorator(cls: type[Connector]) -> type[Connector]:
+        if not name:
+            raise ValueError(f"{cls.__name__} 的引擎名不能为空")
+        if name in _ENGINE_REGISTRY:
+            raise ValueError(f"connector engine already registered: {name}")
+        cls.engine = name
+        _ENGINE_REGISTRY[name] = cls
+        return cls
+
+    return decorator
+
+
+def get_engine(name: str) -> type[Connector]:
+    cls = _ENGINE_REGISTRY.get(name)
+    if cls is None:
+        raise ValueError(
+            f"unsupported connector engine: {name!r} "
+            f"(registered: {sorted(_ENGINE_REGISTRY)})"
+        )
+    return cls
+
+
+def registered_engines() -> list[str]:
+    return sorted(_ENGINE_REGISTRY)
diff --git a/jiuwenswarm/channels/web/dataagent/connectors/duckdb_connector.py b/jiuwenswarm/channels/web/dataagent/connectors/duckdb_connector.py
