+        business_db_ref = "doris://h/olist"
+
+    monkeypatch.setattr(workspace_context, "resolve", lambda wid=None: _Ctx())
+    return _Ctx
+
+
+@pytest.fixture
+def patch_db_connector(monkeypatch):
+    """替换 service 内的 db_connector（行数丰富逻辑）。"""
+    class _FakeConnector:
+        def __init__(self):
+            self.query_calls = []
+            self.query_result = []
+            self.query_dict_calls = []
+            self.query_dict_result = []
+
+        def query_dict(self, db_ref, sql, *args, **kw):
