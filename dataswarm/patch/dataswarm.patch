+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Real SQLite workspace registries exercise bound relational credentials.
+
+No business server is contacted. Binding uses the production service; only its
+asynchronous knowledge collection/derivation tasks are suppressed.
+"""
+from __future__ import annotations
+
+import sqlite3
+import threading
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import registry, service, store
+from jiuwenswarm.common import db_connector as dbc, workspace_context as wc, workspace_store
+
+
+@pytest.fixture
+def workspaces(tmp_path, monkeypatch):
+    config = tmp_path / "datasource.yaml"
+    config.write_text("{}\n", encoding="utf-8")
+    monkeypatch.setattr(workspace_store, "_config_dir", lambda: tmp_path)
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: tmp_path / "workspaces.db")
+    monkeypatch.setattr(wc, "_config_path", lambda: config)
+    monkeypatch.setattr(dbc, "_DATASOURCE_CONFIG", config)
+    monkeypatch.setattr(dbc, "_SOURCE_CREDS_CACHE", {})
+    monkeypatch.setattr(store, "_initialized_refs", set())
+    monkeypatch.setattr(service, "_trigger_binding_collection", lambda *args: None)
+    monkeypatch.setattr(service, "_trigger_schema_derivation", lambda *args: None)
+    for key in ("JIUWENSWARM_DATASOURCE_DB", "JIUWENSWARM_ORCH_DB", "JIUWENSWARM_WORKSPACE_ID"):
+        monkeypatch.delenv(key, raising=False)
+    root = Path(__file__).resolve().parents[3]
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(root / "deploy" / "schema"))
+    token = wc.set_current(None)
+    owner = workspace_store.create_workspace("Owner", workspace_id="owner")
+    consumer = workspace_store.create_workspace("Consumer", workspace_id="consumer")
+    try:
+        yield owner, consumer
+    finally:
+        dbc.close_all()
+        wc.reset(token)
+
+
+def save(kind="postgresql", extras=None, workspace_id="owner", source_id="relational"):
+    port = {"postgresql": 5432, "sqlserver": 1433, "doris": 9030}[kind]
+    config = dict(host="credentials-test.invalid", port=port, database="business",
+                  user="saved-user", password="private-saved-password", **(extras or {}))
+    ref = registry.get_source_type(kind).build_ref(config)
+    store.insert_source(source_id, kind, source_id, config, ref, workspace_id=workspace_id)
+    return ref, config
+
+
+def bind(source_id="relational"):
+    result = service.bind_source_to_workspace({"source_id": source_id, "workspace_id": "consumer"})
+    assert result["ok"] and result["bound"]
+    dbc.invalidate_source_credentials_cache()
+    return result["db_ref"]
+
+
+@pytest.mark.parametrize("kind,extras", [
+    ("postgresql", {}),
+    ("sqlserver", {"driver": "ODBC Driver 17 for SQL Server", "trusted_connection": True}),
+    ("sqlserver", {"driver": "", "trusted_connection": False}),
+    ("doris", {"be_host": "be.invalid", "be_http_port": 8041}),
+])
+def test_saved_sql_source_bind_restores_credentials_and_driver_options(workspaces, monkeypatch, kind, extras):
+    ref, config = save(kind, extras)
+    assert bind() == ref
+    assert store.get_source("relational", workspace_id="consumer") is None
+    monkeypatch.setenv("MSSQL_ODBC_DRIVER", "unrelated-global-driver")
+    monkeypatch.setenv("MSSQL_TRUSTED_CONNECTION", "true")
+    token = wc.set_current("consumer")
+    try:
+        spec = dbc.parse_db_ref(ref)
+        assert spec["user"] == config["user"]
+        assert spec["password"] == config["password"]
+        for key, value in extras.items():
+            assert spec[key] == value
+    finally:
+        wc.reset(token)
+
+
+@pytest.mark.parametrize("binding", ["", "postgresql://credentials-test.invalid:5432/other",
+                                     "postgresql://credentials-test.invalid:5432/business/"])
+def test_unbound_or_similar_reference_does_not_search_other_spaces(workspaces, monkeypatch, binding):
+    owner, consumer = workspaces
+    ref, config = save()
+    workspace_store.update_business_ref("consumer", binding)
+    original = store._connect
+
+    def connect(meta_ref):
+        assert meta_ref == consumer["metadata_db_ref"]
+        return original(meta_ref)
+    monkeypatch.setattr(store, "_connect", connect)
+    assert store.find_credentials("postgresql", config["host"], 5432, "business", "consumer") == {}
+
+
+def test_unselected_multiple_workspaces_never_search_secrets(workspaces, monkeypatch):
+    ref, config = save()
+    monkeypatch.setattr(store, "_connect", lambda *args: pytest.fail("No selected workspace"))
+    assert store.find_credentials("postgresql", config["host"], 5432, "business") == {}
+
+
+@pytest.mark.parametrize("env_key", ["JIUWENSWARM_DATASOURCE_DB", "JIUWENSWARM_ORCH_DB"])
+def test_metadata_override_never_falls_back_to_registered_workspaces(workspaces, tmp_path, monkeypatch, env_key):
+    ref, config = save()
+    bind()
+    override = f"sqlite://{tmp_path / 'override.db'}"
+    monkeypatch.setenv(env_key, override)
+    original = store._connect
+
+    def connect(meta_ref):
+        assert meta_ref == override
+        return original(meta_ref)
+    monkeypatch.setattr(store, "_connect", connect)
+    assert store.find_credentials("postgresql", config["host"], 5432, "business") == {}
+
+
+@pytest.mark.parametrize("conflicting", [False, True])
+def test_bound_source_requires_equal_configs_across_owners(workspaces, conflicting):
+    ref, config = save()
+    workspace_store.create_workspace("Other owner", workspace_id="other")
+    other = dict(config, password="private-conflicting-password") if conflicting else dict(config)
+    store.insert_source("second", "postgresql", "second", other, ref, workspace_id="other")
+    workspace_store.update_business_ref("consumer", ref)
+    if conflicting:
+        with pytest.raises(ValueError, match="ambiguous") as error:
+            store.find_credentials("postgresql", config["host"], 5432, "business", "consumer")
+        assert config["password"] not in str(error.value) and other["password"] not in str(error.value)
+    else:
+        assert (
+            store.find_credentials("postgresql", config["host"], 5432, "business", "consumer")["password"]
+            == config["password"]
+        )
+
+
+def test_local_config_takes_priority_but_local_conflicts_fail(workspaces):
+    ref, config = save()
+    bind()
+    local = dict(config, password="local-private-password")
+    store.insert_source("local", "postgresql", "local", local, ref, workspace_id="consumer")
+    assert (
+        store.find_credentials("postgresql", config["host"], 5432, "business", "consumer")["password"]
+        == local["password"]
+    )
+    store.insert_source("conflict", "postgresql", "conflict", config, ref, workspace_id="consumer")
+    with pytest.raises(ValueError, match="ambiguous") as error:
+        store.find_credentials("postgresql", config["host"], 5432, "business", "consumer")
+    assert local["password"] not in str(error.value) and config["password"] not in str(error.value)
+
+
+@pytest.mark.parametrize("raw", ['{"password":"secret-invalid-json"', '["secret-invalid-json"]',
+                                 '"secret-invalid-json"', 'null'])
+@pytest.mark.parametrize("lookup_workspace", ["owner", "consumer"])
+def test_invalid_saved_config_is_rejected_without_secret_in_error(workspaces, raw, lookup_workspace):
+    owner, consumer = workspaces
+    ref, config = save()
+    bind()
+    with sqlite3.connect(owner["metadata_db_ref"].removeprefix("sqlite://")) as connection:
+        connection.execute("UPDATE dw_datasources SET config = ?", (raw,))
+    with pytest.raises(ValueError, match="invalid saved datasource configuration") as error:
+        store.find_credentials("postgresql", config["host"], 5432, "business", lookup_workspace)
+    assert "secret-invalid-json" not in str(error.value)
+    assert error.value.__cause__ is None
+
+
+def test_metadata_own_credentials_do_not_query_its_registry(monkeypatch):
+    ref = "mysql://metadata.invalid:3306/meta"
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", ref)
+    monkeypatch.setattr(store, "_ensure_table", lambda *args: pytest.fail("Self lookup must not ensure"))
+    monkeypatch.setattr(store, "_connect", lambda *args: pytest.fail("Self lookup must not connect"))
+    assert store.find_credentials("mysql", "metadata.invalid", 3306, "meta") == {}
+
+
+def test_metadata_initialization_reentry_does_not_resolve_or_deadlock(monkeypatch):
+    ref = "mysql://metadata.invalid:3306/meta"
+    monkeypatch.setattr(store, "_resolve_db_ref", lambda *args: pytest.fail("Reentry must short circuit"))
+    completed = []
+
+    def lookup():
+        store._ensuring_ref.ref = ref
+        try:
+            with store._init_lock:
+                completed.append(store.find_credentials("mysql", "metadata.invalid", 3306, "meta"))
+        finally:
+            store._ensuring_ref.ref = None
+    thread = threading.Thread(target=lookup, daemon=True)
+    thread.start()
+    thread.join(timeout=2)
+    assert not thread.is_alive(), "Credential lookup reentered the held schema initialization lock"
+    assert completed == [{}]
