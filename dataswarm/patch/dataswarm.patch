+        ref={dialogRef}
+        className="workspace-dialog"
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="edit-workspace-title"
+        onClick={(event) => event.stopPropagation()}
+      >
+        <div className="workspace-dialog__header">
+          <div>
+            <h2 id="edit-workspace-title">{t('datasourceWorkspace.editTitle')}</h2>
+            <p>{t('datasourceWorkspace.editDescription')}</p>
+          </div>
+          <button
+            type="button"
+            className="workspace-dialog__close"
+            disabled={saving}
+            onClick={onClose}
+            aria-label={t('common.close')}
+          >
+            <X size={16} />
