+                  {s.question || s.analysis_id}
+                </td>
+                <td className="whitespace-nowrap px-3 py-2 text-xs text-text-muted">
+                  {s.created_at?.replace('T', ' ')}
+                </td>
+                <td className="px-3 py-2 text-xs">
+                  {s.has_plan ? (
+                    <span>
+                      {s.done_count}/{s.component_count} 完成
+                      {s.failed_count > 0 && <span className="text-red-600"> · {s.failed_count} 失败</span>}
+                      {s.uncovered > 0 && <span className="text-amber-700"> · {s.uncovered} 未覆盖</span>}
+                    </span>
+                  ) : (
+                    <Badge tone={statusColor('unknown')}>无计划</Badge>
+                  )}
+                </td>
+                <td className="px-3 py-2">
+                  <div className="flex gap-1">
