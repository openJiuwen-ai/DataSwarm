+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""workspace_store 单测：创建（business_db_ref 可空）与绑定/换绑/解绑。"""
+from __future__ import annotations
+
+import sqlite3
+
+import pytest
+
+from jiuwenswarm.common import workspace_store
+
+
+@pytest.fixture()
+def store_registry(monkeypatch, tmp_path):
+    registry = tmp_path / "workspaces.db"
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: registry)
+    return workspace_store
+
+
+def _row(registry_path, workspace_id: str) -> dict | None:
+    connection = sqlite3.connect(registry_path)
+    connection.row_factory = sqlite3.Row
+    row = connection.execute(
+        "SELECT * FROM dw_workspaces WHERE workspace_id = ?", (workspace_id,)
+    ).fetchone()
+    connection.close()
+    return dict(row) if row else None
+
+
+def test_create_workspace_without_business_ref(store_registry, tmp_path):
+    """创建工作空间不强制业务数据源：空串直存（NOT NULL 约束兼容）。"""
+    record = store_registry.create_workspace("空绑定空间")
+    assert record["business_db_ref"] == ""
+    assert record["workspace_id"].startswith("custom-")
+    row = _row(tmp_path / "workspaces.db", record["workspace_id"])
+    assert row is not None
+    assert row["business_db_ref"] == ""
+    assert row["metadata_db_ref"].startswith("sqlite://")
+
+
+def test_create_workspace_with_business_ref(store_registry):
+    record = store_registry.create_workspace("已绑定", "sqlite:///biz.db")
+    assert record["business_db_ref"] == "sqlite:///biz.db"
+
+
+def test_create_workspace_still_requires_name(store_registry):
+    with pytest.raises(ValueError, match="name"):
+        store_registry.create_workspace("   ")
+
+
+def test_update_business_ref_bind_rebind_unbind(store_registry, tmp_path):
+    record = store_registry.create_workspace("空间")
+    workspace_id = record["workspace_id"]
+
+    # 首绑
+    store_registry.update_business_ref(workspace_id, "sqlite:///first.db")
+    assert _row(tmp_path / "workspaces.db", workspace_id)["business_db_ref"] == "sqlite:///first.db"
+
+    # 换绑（覆盖式）
+    store_registry.update_business_ref(workspace_id, "sqlite:///second.db")
+    assert _row(tmp_path / "workspaces.db", workspace_id)["business_db_ref"] == "sqlite:///second.db"
+
+    # 解绑（空串）
+    store_registry.update_business_ref(workspace_id, "")
+    assert _row(tmp_path / "workspaces.db", workspace_id)["business_db_ref"] == ""
+
+
+def test_update_business_ref_unknown_workspace(store_registry):
+    with pytest.raises(ValueError, match="not found"):
+        store_registry.update_business_ref("no_such_ws", "sqlite:///x.db")
+
+
+def test_create_workspace_duplicate_id(store_registry):
+    store_registry.create_workspace("第一", "sqlite:///a.db", workspace_id="fixed_id")
+    with pytest.raises(ValueError, match="already exists"):
+        store_registry.create_workspace("第二", "sqlite:///b.db", workspace_id="fixed_id")
+
+
+def test_create_workspace_with_description(store_registry, tmp_path):
+    """创建时带备注：落列、返回 dict 与 list_workspaces 均可读回。"""
+    record = store_registry.create_workspace("备注空间", "sqlite:///biz.db",
+                                             description="  演示 Olist 数据  ")
+    assert record["description"] == "演示 Olist 数据"
+    row = _row(tmp_path / "workspaces.db", record["workspace_id"])
+    assert row["description"] == "演示 Olist 数据"
+    listed = [w for w in store_registry.list_workspaces() if w["workspace_id"] == record["workspace_id"]]
+    assert listed and listed[0]["description"] == "演示 Olist 数据"
+
+
+def test_create_workspace_description_too_long(store_registry):
+    with pytest.raises(ValueError, match="at most 500"):
+        store_registry.create_workspace("超长备注", description="x" * 501)
+
+
+def test_update_workspace_name_and_description(store_registry, tmp_path):
+    record = store_registry.create_workspace("旧名", "sqlite:///biz.db", description="旧备注")
+    workspace_id = record["workspace_id"]
+
+    result = store_registry.update_workspace(workspace_id, name="新名", description="新备注")
+    assert result["name"] == "新名"
+    assert result["description"] == "新备注"
+    row = _row(tmp_path / "workspaces.db", workspace_id)
+    assert row["name"] == "新名"
+    assert row["description"] == "新备注"
+
+
+def test_update_workspace_partial_fields(store_registry, tmp_path):
+    record = store_registry.create_workspace("名字", "sqlite:///biz.db", description="备注")
+    workspace_id = record["workspace_id"]
+
+    only_desc = store_registry.update_workspace(workspace_id, description="只改备注")
+    assert only_desc["name"] == "名字"
+    assert only_desc["description"] == "只改备注"
+
+    only_name = store_registry.update_workspace(workspace_id, name="只改名字")
+    assert only_name["name"] == "只改名字"
+    assert only_name["description"] == "只改备注"
+
+
+def test_update_workspace_validation(store_registry):
+    record = store_registry.create_workspace("空间")
+    with pytest.raises(ValueError, match="required"):
+        store_registry.update_workspace(record["workspace_id"])
+    with pytest.raises(ValueError, match="required"):
+        store_registry.update_workspace(record["workspace_id"], name="   ")
+    with pytest.raises(ValueError, match="at most 120"):
+        store_registry.update_workspace(record["workspace_id"], name="长" * 121)
+    with pytest.raises(ValueError, match="at most 500"):
+        store_registry.update_workspace(record["workspace_id"], description="长" * 501)
+    with pytest.raises(ValueError, match="not found"):
+        store_registry.update_workspace("no_such_ws", name="不存在")
+
+
+def test_delete_workspace_removes_row(store_registry, tmp_path):
+    record = store_registry.create_workspace("待删", "sqlite:///biz.db")
+    workspace_id = record["workspace_id"]
+
+    result = store_registry.delete_workspace(workspace_id)
+    assert result["workspace_id"] == workspace_id
+    assert result["metadata_db_ref"] == record["metadata_db_ref"]
+    assert _row(tmp_path / "workspaces.db", workspace_id) is None
+    assert all(w["workspace_id"] != workspace_id for w in store_registry.list_workspaces())
+
+    # 重复删 → not found
+    with pytest.raises(ValueError, match="not found"):
+        store_registry.delete_workspace(workspace_id)
+
+
+def test_list_workspaces_migrates_legacy_table(monkeypatch, tmp_path):
+    """存量 5 列旧表（无 description）：list_workspaces 触发幂等 ALTER 加列。"""
+    registry = tmp_path / "workspaces.db"
+    connection = sqlite3.connect(registry)
+    connection.execute(
+        "CREATE TABLE dw_workspaces ("
+        "workspace_id TEXT PRIMARY KEY, name TEXT NOT NULL, "
+        "business_db_ref TEXT NOT NULL, metadata_db_ref TEXT NOT NULL, "
+        "created_at TEXT NOT NULL)"
+    )
+    connection.execute(
+        "INSERT INTO dw_workspaces (workspace_id, name, business_db_ref, metadata_db_ref, created_at) "
+        "VALUES ('ws_old', '旧空间', '', 'sqlite:///old.db', '2026-01-01')"
+    )
+    connection.commit()
+    connection.close()
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: registry)
+
+    rows = workspace_store.list_workspaces()
+    assert len(rows) == 1
+    assert rows[0]["description"] == ""  # 旧行补默认空串
+
+    cols = [row[1] for row in sqlite3.connect(registry).execute("PRAGMA table_info(dw_workspaces)")]
+    assert "description" in cols
