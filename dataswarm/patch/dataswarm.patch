+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 指标语义层 V2 管理页外壳（指标管理 / 发布）。 */
+
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Badge, ErrorBanner } from '../_shared/ui';
+import { metricsV2Api, type V2Health } from './api';
+import { MetricsTab } from './MetricsTab';
+import { PublishTab } from './PublishTab';
+import '../_shared/ui/shell.css';
+
+type TabKey = 'metrics' | 'publish';
+
+const TABS: { key: TabKey; labelKey: string }[] = [
+  { key: 'metrics', labelKey: 'biMetrics.app.tabMetrics' },
+  { key: 'publish', labelKey: 'biMetrics.app.tabPublish' },
+];
+
+export function MetricsV2App() {
+  const { t } = useTranslation();
+  const [tab, setTab] = useState<TabKey>('metrics');
+  const [health, setHealth] = useState<V2Health | null>(null);
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  const run = useCallback(async <T,>(fn: () => Promise<T>): Promise<T | null> => {
+    setBusy(true);
+    setError('');
+    try {
+      return await fn();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+      return null;
+    } finally {
+      setBusy(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void run(async () => setHealth(await metricsV2Api.health()));
+  }, [run]);
+
+  return (
+    <div className="flex h-full w-full bg-bg text-text">
+      <main className="min-w-0 flex-1 overflow-auto">
+        <div className="dw-content">
+          <div className="dw-page-head mb-4 flex items-start justify-between gap-3">
+            <div>
+              <h2 className="dw-page-title-xl">{t('biMetrics.app.title')}</h2>
+              <p>{t('biMetrics.app.subtitle')}</p>
+            </div>
+            <div className="flex shrink-0 items-center gap-2">
+              {health && (
+                <>
+                  {/* 三态：在线（绿）/ 未采集（黄，空快照 error_code 恒为 null）/ 真故障（红） */}
+                  {health.semantic.available ? (
+                    <Badge tone="success">{t('biMetrics.app.semanticOnline')}</Badge>
+                  ) : health.semantic.error_code ? (
+                    <Badge tone="danger">{t('biMetrics.app.semanticUnavailable')}</Badge>
+                  ) : (
+                    <Badge tone="warn">{t('biMetrics.app.semanticNotCollected')}</Badge>
+                  )}
+                  {!health.semantic.available && !health.semantic.error_code && (
+                    <span className="text-xs text-text-muted">
+                      {t('biMetrics.app.collectionHint')}
+                    </span>
+                  )}
+                </>
+              )}
+              {busy && <span className="text-xs text-text-muted">{t('biMetrics.app.processing')}</span>}
+            </div>
+          </div>
+          {error && <div className="mb-3"><ErrorBanner message={error} onDismiss={() => setError('')} /></div>}
+          <div className="mb-6 flex gap-1 border-b border-border">
+            {TABS.map((item) => (
+              <button key={item.key}
+                className={tab === item.key
+                  ? '-mb-px border-b-2 border-text px-3 py-2 text-sm font-medium text-text-strong'
+                  : '-mb-px border-b-2 border-transparent px-3 py-2 text-sm text-text-muted hover:text-text'}
+                onClick={() => setTab(item.key)}>
+                {t(item.labelKey)}
+              </button>
+            ))}
+          </div>
+          {tab === 'metrics' && <MetricsTab />}
+          {tab === 'publish' && <PublishTab run={run} />}
+        </div>
+      </main>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/metricsV2/PublishTab.tsx b/jiuwenswarm/channels/web/frontend/src/features/metricsV2/PublishTab.tsx
