+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""lineage/service.py — 表/列血缘业务逻辑。
+
+职责：
+  - 图构建：把 meta_data 的行式血缘边组装成 {nodes, edges} 图结构
+  - 行数丰富：调 db_connector 查业务库表行数，填到节点
+  - 层级推断：按表名前缀推 ODS/DWD/DWS/ADS
+
+DAO 编排：
+  - 元数据 CRUD 委托 meta_data（MetadataStore）
+  - 业务库行数查询委托 db_connector（直接走业务数据源，不走元数据存储）
+"""
+from __future__ import annotations
+
+import logging
+import os
+from pathlib import Path
+
+from jiuwenswarm.common.dw_layer import infer_layer as _infer_layer
+from jiuwenswarm.common.utils import get_user_workspace_dir
+from jiuwenswarm.channels.web.orchestration.db import _is_sqlite
+
+# db_connector 由 dataagent/db.py 在模块加载时注入 sys.path，
+# 此处直接复用同一实例，避免重复注入。
+from .. import db as _da_db
+db_connector = _da_db.db_connector
+
+from ..meta_data import get_store as _get_store
+from .._common import ref_is_sqlite
+
+logger = logging.getLogger(__name__)
+
+
+def _db_ref_for_name(db_name: str, workspace_id: str | None = None) -> str | None:
+    """根据数据库名推断 db_ref（用于丰富血缘节点的行数）。
+
+    优先取当前工作空间绑定的业务 ref（mysql/duckdb 绑定时不得硬连 Doris）；
+    未绑定再回退 legacy 推断：sqlite 模式拼 workspace data 目录，否则按
+    config doris: 段构造。绑定 ref 的库名与 db_name 不一致时返回 None
+    （跨库边引用的其他库，拿绑定 ref 查 INFORMATION_SCHEMA 会查错库）。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        bound = workspace_context.resolve(workspace_id).business_db_ref
+        if bound:
+            ref = str(bound).strip()
+            spec = db_connector.parse_db_ref(ref)
+            if spec.get("database") == db_name:
+                return ref
+            return None
+    except Exception:  # noqa: BLE001 —— 无绑定/解析失败走 legacy 推断
+        pass
+    if _is_sqlite:
+        workspace = Path(get_user_workspace_dir())
+        db_path = workspace / "data" / f"{db_name}.db"
+        if db_path.exists():
+            return f"sqlite://{db_path}"
+        return None
+    _doris_yaml = db_connector._read_config_section("doris")
+    host = os.getenv("DORIS_HOST") or _doris_yaml.get("host") or ""
+    port = os.getenv("DORIS_PORT") or _doris_yaml.get("port") or "9030"
+    return f"doris://{host}:{port}/{db_name}"
+
+
+# --------------------------------------------------------------------------
+# 图构建 — 读
+# --------------------------------------------------------------------------
+def _resolve_db_name(db_name: str, workspace_id: str | None = None) -> str:
+    """校验 db_name 归属当前工作空间业务库（P1-8 / 决策八-2）。
+
+    血缘 API 的库选择器是裸库名（legacy 形态），走 validate_business_database_name
+    约束到当前工作空间的业务库，防跨工作空间读血缘。校验通过后返回**裸库名**——
+    table_lineage.source_db/target_db 存的是裸库名（不带 scheme），若把校验器返回的
+    完整 ref 拿去当查询参数会导致 SQL 匹配 0 行（血缘图空白的回归根因）。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    workspace_context.validate_business_database_name(workspace_id, db_name)
+    return db_name
+
+
+def _business_ref(workspace_id: str | None = None) -> str | None:
+    """当前工作空间绑定业务数据源的规范化 ref（血缘跨数据源隔离键）。
+
+    解析失败返回 None（调用方据此退化为不过滤，保持既有空图容错）。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        ref = str(workspace_context.resolve(workspace_id).business_db_ref or "").strip()
+        if not ref:
+            return None
+        return workspace_context.normalize_db_ref(ref)
+    except Exception:  # noqa: BLE001 —— 无绑定/解析失败不阻断读，退化为不过滤
+        return None
+
+
+def read_table_lineage(db_name: str, plan_id: str | None = None,
+                       workspace_id: str | None = None) -> dict:
+    """读取表血缘图（节点 + 边 + 行数丰富），可选按 plan_id 过滤边。"""
+    try:
+        db_name = _resolve_db_name(db_name, workspace_id)
+        rows = _get_store().list_table_lineage(
+            db_name, plan_id=plan_id or None,
+            business_ref=_business_ref(workspace_id),
+        )
+    except Exception:
+        return {"graph": {"nodes": [], "edges": []}}
+
+    node_set: set[str] = set()
+    edge_list: list[dict] = []
+    table_task: dict[str, str] = {}
+
+    for r in rows:
+        if r.get("source_db") == db_name:
+            node_set.add(r["source_table"])
+        if r.get("target_db") == db_name:
+            node_set.add(r["target_table"])
+            tid = r.get("task_id")
+            if tid and r["target_db"] == db_name:
+                table_task.setdefault(r["target_table"], tid)
+        edge_list.append({
+            "from": r["source_table"] if r.get("source_db") == db_name
+                     else f"{r.get('source_db', '')}.{r['source_table']}",
+            "to": r["target_table"] if r.get("target_db") == db_name
+                   else f"{r.get('target_db', '')}.{r['target_table']}",
+            "join_key": r.get("join_key"),
+            "task_id": r.get("task_id"),
+        })
+
+    row_counts: dict[str, int] = {}
+    db_ref = _db_ref_for_name(db_name, workspace_id)
+    if db_ref:
+        try:
+            if ref_is_sqlite(db_ref):
+                for t in node_set:
+                    try:
+                        cnt = db_connector.query_dict(
+                            db_ref, f'SELECT COUNT(*) AS cnt FROM "{t}"', limit=1
+                        )
+                        if cnt:
+                            row_counts[t] = int(cnt[0].get("cnt", 0) or 0)
+                    except Exception as exc:  # noqa: BLE001 —— 单表行数探测失败按 0 展示
+                        logger.debug("[lineage] 表行数探测失败 table=%s: %s", t, exc)
+                        pass
+            else:
+                # information_schema 查询禁占位符（Doris Nereids arity bug），
+                # 一律字面拼接；query_dict 返回 list[dict]
+                info_rows = db_connector.query_dict(
+                    db_ref,
+                    "SELECT TABLE_NAME, TABLE_ROWS FROM INFORMATION_SCHEMA.TABLES "
+                    f"WHERE TABLE_SCHEMA = '{db_name}'",
+                    limit=10000,
+                )
+                row_counts = {
+                    r["TABLE_NAME"]: int(r.get("TABLE_ROWS", 0) or 0)
+                    for r in (info_rows or [])
+                }
+        except Exception as exc:  # noqa: BLE001 —— 行数丰富失败退化为无 rowcount
+            logger.warning("[lineage] 表行数丰富失败 db_name=%s: %s", db_name, exc)
+            pass
+
+    nodes = [
+        {"table": t, "layer": _infer_layer(t), "rowcount": row_counts.get(t, 0),
+         "task_id": table_task.get(t)}
+        for t in sorted(node_set)
+    ]
+    return {"graph": {"nodes": nodes, "edges": edge_list}}
+
+
+def read_column_lineage(db_name: str, table_name: str,
+                        workspace_id: str | None = None) -> dict:
+    """读取列血缘图。"""
+    try:
+        db_name = _resolve_db_name(db_name, workspace_id)
+        rows = _get_store().list_column_lineage(
+            db_name, table_name, business_ref=_business_ref(workspace_id),
+        )
+    except Exception:
+        return {"graph": {"nodes": [], "edges": []}}
+
+    node_set: set[str] = set()
+    edge_list: list[dict] = []
+    for r in rows:
+        src_id = f"{r.get('source_db', '')}.{r['source_table']}.{r['source_column']}"
+        tgt_id = f"{r.get('target_db', '')}.{r['target_table']}.{r['target_column']}"
+        node_set.add(src_id)
+        node_set.add(tgt_id)
+        edge_list.append({
+            "from": src_id,
+            "to": tgt_id,
+            "transformation": r.get("transformation"),
+        })
+    nodes = [{"id": n} for n in sorted(node_set)]
+    return {"graph": {"nodes": nodes, "edges": edge_list}}
+
+
+# --------------------------------------------------------------------------
+# 元数据 CRUD — 委托 meta_data
+# --------------------------------------------------------------------------
+def save_table_lineage(edges: list[dict], workspace_id: str | None = None) -> int:
+    """批量写入表血缘边（写入当前工作空间元数据库，经 contextvar 路由）。"""
+    from jiuwenswarm.common import workspace_context
+
+    if workspace_id:
+        workspace_context.resolve(workspace_id)
+    biz_ref = _business_ref(workspace_id)
+    if biz_ref:
+        for e in edges:
+            e.setdefault("business_ref", biz_ref)
+    return _get_store().save_table_lineage(edges)
+
+
+def save_column_lineage(edges: list[dict], workspace_id: str | None = None) -> int:
+    """批量写入列血缘边（写入当前工作空间元数据库）。"""
+    from jiuwenswarm.common import workspace_context
+
+    if workspace_id:
+        workspace_context.resolve(workspace_id)
+    biz_ref = _business_ref(workspace_id)
+    if biz_ref:
+        for e in edges:
+            e.setdefault("business_ref", biz_ref)
+    return _get_store().save_column_lineage(edges)
+
+
+def delete_table_lineage(plan_id: str, task_id: str | None = None,
+                         workspace_id: str | None = None) -> int:
+    """删除指定 plan_id（+ 可选 task_id）的表血缘。
+
+    方案 §5.4 G6：task_id 省略时按 plan_id 单条件删（清整个 plan 的血缘）。
+    空 plan_id → 不执行删除（防误删全表）。
+    """
+    if not plan_id:
+        return 0
+    from jiuwenswarm.common import workspace_context
+
+    if workspace_id:
+        workspace_context.resolve(workspace_id)
+    return _get_store().delete_table_lineage(plan_id, task_id)
+
+
+def delete_column_lineage(plan_id: str, task_id: str | None = None,
+                          workspace_id: str | None = None) -> int:
+    """删除指定 plan_id（+ 可选 task_id）的列血缘。
+
+    方案 §5.4 G6：同 delete_table_lineage，task_id 省略时按 plan_id 删。
+    """
+    if not plan_id:
+        return 0
+    from jiuwenswarm.common import workspace_context
+
+    if workspace_id:
+        workspace_context.resolve(workspace_id)
+    return _get_store().delete_column_lineage(plan_id, task_id)
