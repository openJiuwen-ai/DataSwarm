diff --git a/jiuwenswarm/channels/web/frontend/src/components/KnowledgeDerivationBanner/index.tsx b/jiuwenswarm/channels/web/frontend/src/components/KnowledgeDerivationBanner/index.tsx
new file mode 100644
index 000000000..78d76dff5
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/components/KnowledgeDerivationBanner/index.tsx
@@ -0,0 +1,115 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 知识派生全局公告框：绑定/换库触发派生任务后跨页展示进度，
+ * 完成后提供「前往查看」直达 业务知识 → 知识管理；用户可随时关闭。
+ */
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { AlertTriangle, CheckCircle2, Loader2, X } from 'lucide-react';
+import { dataSourceApi } from '../../features/datasource/api/dataSourceApi';
+import { navigateToKnowledgeReview } from '../../features/dashboard/components/knowledgeNav';
+import { useKnowledgeDerivationNotice } from '../../stores/knowledgeDerivationNoticeStore';
+
+type JobStatus = 'running' | 'complete' | 'failed' | 'timeout' | 'cancelled';
+
+export function KnowledgeDerivationBanner() {
+  const { t } = useTranslation();
+  const visible = useKnowledgeDerivationNotice((state) => state.visible);
+  const workspaceId = useKnowledgeDerivationNotice((state) => state.workspaceId);
+  const close = useKnowledgeDerivationNotice((state) => state.close);
+  const [status, setStatus] = useState<JobStatus>('running');
+  const [counts, setCounts] = useState({ candidates: 0, enriched: 0 });
+  const [error, setError] = useState('');
+  const [cancelRequested, setCancelRequested] = useState(false);
+  const [cancelling, setCancelling] = useState(false);
+
+  const cancelJob = async () => {
+    if (!workspaceId || cancelling || cancelRequested) return;
+    setCancelling(true);
+    try {
+      await dataSourceApi.cancelKnowledgeDerivation(workspaceId);
+      setCancelRequested(true);
+    } catch {
+      // 取消失败静默：任务可能刚结束，下一轮轮询会把状态纠正为终态
+    } finally {
+      setCancelling(false);
+    }
+  };
+
+  useEffect(() => {
+    if (!visible || !workspaceId) return;
+    setStatus('running');
+    setCounts({ candidates: 0, enriched: 0 });
+    setError('');
+    setCancelRequested(false);
+    let cancelled = false;
+    let timer = 0;
+    let failures = 0;
+    const poll = async () => {
+      try {
+        const listing = await dataSourceApi.list(workspaceId);
+        failures = 0;
+        if (cancelled) return;
+        const derived = listing.datasources.find((source) => source.bound)?.knowledge_derivation;
+        if (derived) {
+          setCounts({ candidates: derived.candidates ?? 0, enriched: derived.enriched ?? 0 });
+          setCancelRequested(derived.cancel_requested === true);
+          if (derived.status === 'complete' || derived.status === 'failed'
+            || derived.status === 'timeout' || derived.status === 'cancelled') {
+            setStatus(derived.status);
+            setError(derived.error || '');
+            return; // 终态：停止轮询
+          }
+        }
+      } catch {
+        failures += 1;
+        if (failures >= 3) {
+          close();
+          return;
+        }
+      }
+      if (!cancelled) timer = window.setTimeout(() => { void poll(); }, 3000);
+    };
+    timer = window.setTimeout(() => { void poll(); }, 500);
+    return () => {
+      cancelled = true;
+      window.clearTimeout(timer);
+    };
+  }, [visible, workspaceId, close]);
+
+  if (!visible || !workspaceId) return null;
+  return (
+    <div className="kd-banner animate-rise" role="status" data-status={status}>
+      {status === 'running'
+        ? <Loader2 size={14} className="animate-spin" />
+        : status === 'complete'
+          ? <CheckCircle2 size={14} />
+          : <AlertTriangle size={14} />}
+      <span className="kd-banner-text">
+        {status === 'running' && (cancelRequested
+          ? t('knowledgeDerivation.bannerCancelling')
+          : t('knowledgeDerivation.bannerRunning'))}
+        {status === 'complete' && t('knowledgeDerivation.bannerDone', counts)}
+        {(status === 'failed' || status === 'timeout') && (
+          t('knowledgeDerivation.bannerFailed', { reason: error || t(`knowledgeDerivation.${status}`) })
+        )}
+        {status === 'cancelled' && t('knowledgeDerivation.bannerCancelled', counts)}
+      </span>
+      {status === 'running' && (
+        <button className="kd-banner-link" disabled={cancelling || cancelRequested} onClick={() => void cancelJob()}>
+          {cancelling || cancelRequested
+            ? t('knowledgeDerivation.cancellingAction')
+            : t('knowledgeDerivation.cancelAction')}
+        </button>
+      )}
+      {status === 'complete' && (
+        <button className="kd-banner-link" onClick={navigateToKnowledgeReview}>
+          {t('knowledgeDerivation.goReview')}
+        </button>
+      )}
+      <button className="kd-banner-close" onClick={close} aria-label={t('common.close')}>
+        <X size={13} />
+      </button>
+    </div>
+  );
+}
