--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/governance/components/TaskPage.tsx
@@ -0,0 +1,265 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import TaskCountIcon from '../../../assets/governance/task-count.svg?react';
+import RunCountIcon from '../../../assets/governance/run-count.svg?react';
+import SlaIcon from '../../../assets/governance/sla.svg?react';
+import FailedSkippedIcon from '../../../assets/governance/failed-skipped.svg?react';
+import type { EChartsOption } from 'echarts';
+import { EChart } from './shared/EChart';
+import { FindingList, Kpi, Panel } from './shared/Ui';
+import { WorkflowGraph, WORKFLOW_STATUS_STYLE } from '../../_shared/workflow/WorkflowGraph';
+import { toTaskGraphNodes } from './taskGraphModel';
+import type { TaskArtifact, TaskRun } from '../types/inspection';
+import { CHART, CHART_SERIES, CHART_TOOLTIP, MONO_FONT } from '../govTheme';
+
+const TASK_STATUSES = ['success', 'failed', 'skipped', 'running', 'queued'] as const;
+
+export function TaskPage({ artifact, showFindings = true }: { artifact?: TaskArtifact; showFindings?: boolean }) {
+  const { t } = useTranslation();
+  const nodes = artifact?.graph.nodes ?? [];
+  const [selectedNodeId, setSelectedNodeId] = useState<string | null>(null);
+  const graphNodes = useMemo(() => toTaskGraphNodes(artifact?.graph ?? { nodes: [], edges: [] }), [artifact?.graph]);
+  const runs = artifact?.runs ?? [];
+  const summary = artifact?.summary;
+  const findings = artifact?.findings ?? [];
+  const statusLabels = useMemo<Record<string, string>>(
+    () => ({
+      success: t('governance.dashboard.task.status.success'),
+      failed: t('governance.dashboard.task.status.failed'),
+      skipped: t('governance.dashboard.task.status.skipped'),
+      running: t('governance.dashboard.task.status.running'),
+      queued: t('governance.dashboard.task.status.queued'),
+      unknown: t('governance.dashboard.task.status.unknown'),
+    }),
+    [t],
+  );
+
+  // 时长 / 产出历史：按 task_id 分组，每个 task 一条时长线 + 一条产出线（双 y 轴）。
+  // x 轴用真实 start_ts（time 轴），各 task 的 run 按真实日期对齐——
+  // 旧实现用「run 序号 #1..#N」对齐，导致单 run 的 task 点全挤在 #1、
+  // 时间错位（t_ods 的 8/21 落 #1，t_dwd 的 8/21 却是 #7），视觉上线段缺失。
+  // 失败 run（status=failed）用红点标记，skipped（duration/output 为 null）自然断线。
+  const historyOption = useMemo<EChartsOption>(() => {
+    const byTask = new Map<string, TaskRun[]>();
+    for (const r of runs) {
+      const list = byTask.get(r.task_id) ?? [];
+      list.push(r);
+      byTask.set(r.task_id, list);
+    }
+    const taskOrder = [...byTask.keys()].sort();
+    const sortedPerTask = taskOrder.map((tid) =>
+      [...byTask.get(tid)!].sort((a, b) => String(a.start_ts).localeCompare(String(b.start_ts))),
+    );
+    const palette = [...CHART_SERIES];
+    const series: EChartsOption['series'] = [];
+    taskOrder.forEach((tid, ti) => {
+      const list = sortedPerTask[ti];
+      const color = palette[ti % palette.length];
+      const outColor = palette[(ti + 3) % palette.length];
+      const ts = (r: TaskRun) => String(r.start_ts);
+      // skipped 的 run 没有真实时长/产出，两条线都给 null 断开（不用 0，避免贴底平线
+      // 被误读为「有数据但为 0」）。success/failed 才画真实值。
+      const valOrNull = (r: TaskRun, key: 'duration_s' | 'output_rows') =>
+        r.status === 'skipped' ? null : (r[key] ?? null);
+      // 时长线：单点 task 也要可见，故 showSymbol: true（默认即 true）。
+      series.push({
+        name: t('governance.dashboard.task.durationSeries', { task: tid }),
+        type: 'line',
+        data: list.map((r) => ({
+          value: [ts(r), valOrNull(r, 'duration_s')],
+          task_id: r.task_id,
+          start_ts: r.start_ts,
+          status: r.status,
+        })),
+        itemStyle: { color },
+        lineStyle: { color },
+        showSymbol: true,
+        symbolSize: 6,
+        connectNulls: false,
+      });
+      series.push({
+        name: t('governance.dashboard.task.outputSeries', { task: tid }),
+        type: 'line',
+        yAxisIndex: 1,
+        data: list.map((r) => ({
+          value: [ts(r), valOrNull(r, 'output_rows')],
+          task_id: r.task_id,
+          start_ts: r.start_ts,
+          status: r.status,
+        })),
+        itemStyle: { color: outColor },
+        lineStyle: { color: outColor },
+        showSymbol: true,
+        symbolSize: 6,
+        connectNulls: false,
+      });
+    });
+    // 失败 run 单独一层红点叠在两条线上，避免被线条颜色淹没
+    const failedPoints = runs
+      .filter((r) => r.status === 'failed')
+      .map((r) => ({
+        value: [String(r.start_ts), r.duration_s ?? 0],
+        task_id: r.task_id,
+        start_ts: r.start_ts,
+        status: 'failed',
+      }));
+    if (failedPoints.length) {
+      series.push({
+        name: t('governance.dashboard.task.failedSeries'),
+        type: 'scatter',
+        symbolSize: 14,
+        data: failedPoints,
+        itemStyle: { color: '#dc2626', borderColor: '#fff', borderWidth: 2 },
+        z: 10,
+      });
+    }
+    // skipped run：没真实时长/产出，单独画灰色空心点（贴底），表示「那天尝试过但被跳过」，
+    // 否则全 skipped 的 task 在图上完全空白，只剩 legend 里一个名字，用户困惑。
+    const skippedPoints = runs
+      .filter((r) => r.status === 'skipped')
+      .map((r) => ({ value: [String(r.start_ts), 0], task_id: r.task_id, start_ts: r.start_ts, status: 'skipped' }));
+    if (skippedPoints.length) {
+      series.push({
+        name: t('governance.dashboard.task.skippedSeries'),
+        type: 'scatter',
+        symbolSize: 10,
+        data: skippedPoints,
+        itemStyle: { color: 'transparent', borderColor: CHART.stroke, borderWidth: 2 },
+        z: 9,
+      });
+    }
+    return {
+      tooltip: {
+        ...CHART_TOOLTIP,
+        trigger: 'item',
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        formatter: (p: any) => {
+          const d = p?.data ?? {};
+          const v = Array.isArray(p?.value) ? p.value[1] : p?.value;
+          return [
+            d.task_id ?? '',
+            t('governance.dashboard.task.tooltip.startedAt', {
+              value: (d.start_ts ?? '').slice(0, 16),
+              status: d.status ? (statusLabels[d.status] ?? d.status) : '',
+            }),
+            p.seriesName,
+            t('governance.dashboard.task.tooltip.value', { value: v ?? '—' }),
+          ].join('<br/>');
+        },
+      },
+      legend: {
+        type: 'scroll',
+        top: 0,
+        left: 0,
+        right: 0,
+        tooltip: { show: true },
+        textStyle: { color: CHART.body, fontSize: 11, width: 160, overflow: 'truncate', ellipsis: '…' },
+      },
+      grid: { left: 16, right: 16, top: 44, bottom: 44, containLabel: true },
+      xAxis: {
+        type: 'time',
+        axisLabel: { fontSize: 10, hideOverlap: true, fontFamily: MONO_FONT, color: CHART.muted },
+      },
+      yAxis: [
+        {
+          type: 'value',
+          name: t('governance.dashboard.task.durationAxis'),
+          position: 'left',
+          axisLabel: { fontFamily: MONO_FONT, color: CHART.muted },
+        },
+        {
+          type: 'value',
+          name: t('governance.dashboard.task.outputAxis'),
+          position: 'right',
+          axisLabel: { fontFamily: MONO_FONT, color: CHART.muted },
+        },
+      ],
+      series,
+    };
+  }, [runs, statusLabels, t]);
+
+  // 统计直接读 summary（latest 口径：任务当前状态），不自己 count runs（避免全量/最新口径混）
+  const hasDag = nodes.length > 0;
+  const failedCount = summary?.failed_count ?? 0;
+  const skippedCount = summary?.skipped_count ?? 0;
+  return (
+    <div className="gov-task-dashboard">
+      <div className="gov-task-kpis">
+        <Kpi
+          label={t('governance.dashboard.task.taskCount')}
+          icon={<TaskCountIcon aria-hidden="true" />}
+          kind="task"
+          value={summary?.task_count ?? '—'}
+        />
+        <Kpi
+          label={t('governance.dashboard.task.runCount')}
+          icon={<RunCountIcon aria-hidden="true" />}
+          kind="lineage"
+          value={summary?.run_count ?? '—'}
+          hint={t('governance.dashboard.task.runCountHint')}
+        />
+        <Kpi
+          label={t('governance.dashboard.task.sla')}
+          icon={<SlaIcon aria-hidden="true" />}
+          kind="quality"
+          value={summary?.sla_total != null ? `${summary.sla_met ?? 0}/${summary.sla_total}` : '—'}
+        />
+        <Kpi
+          label={t('governance.dashboard.task.failedOrSkipped')}
+          icon={<FailedSkippedIcon aria-hidden="true" />}
+          kind="metric"
+          value={failedCount + skippedCount}
+          hint={t('governance.dashboard.task.failedOrSkippedHint', { failed: failedCount, skipped: skippedCount })}
+          tone={failedCount ? 'danger' : skippedCount ? 'warn' : 'neutral'}
+        />
+      </div>
+
+      <Panel title={t('governance.dashboard.task.history')} className="gov-task-history-panel">
+        <EChart option={historyOption} ariaLabel={t('governance.dashboard.task.history')} height={250} />
+      </Panel>
+
+      <section className="gov-workflow-section" aria-labelledby="gov-workflow-heading">
+        <header className="gov-dashboard-section-head">
+          <h2 id="gov-workflow-heading">{t('governance.dashboard.sections.workflow')}</h2>
+        </header>
+        <Panel className="gov-graph-panel gov-task-flow-panel">
+          {/* 状态图例 */}
+          {hasDag && (
+            <div className="gov-flow-legend">
+              {TASK_STATUSES.map((status) => (
+                <span key={status} className="flex items-center gap-1.5">
+                  <i
+                    className="inline-block h-2.5 w-2.5 rounded-[2px]"
+                    style={{ background: WORKFLOW_STATUS_STYLE[status].color }}
+                  />
+                  <span className="gov-lane-count">{statusLabels[status]}</span>
+                </span>
+              ))}
+            </div>
+          )}
+          {hasDag ? (
+            <WorkflowGraph
+              key={JSON.stringify([artifact?.meta?.run_id, graphNodes.map((node) => [node.id, node.parents])])}
+              nodes={graphNodes}
+              readOnly
+              selectedNodeId={graphNodes.some((node) => node.id === selectedNodeId) ? selectedNodeId : null}
+              onSelectNode={setSelectedNodeId}
+              canvasHeight="100%"
+              canvasMinHeight={0}
+              density="compact"
+              fitViewOnResize
+            />
+          ) : (
+            <div className="gov-empty">{t('governance.dashboard.task.waitingGraph')}</div>
+          )}
+        </Panel>
+      </section>
+      {showFindings && (
+        <Panel title={t('governance.dashboard.task.findings', { count: findings.length })}>
+          <FindingList findings={findings} />
+        </Panel>
+      )}
+    </div>
+  );
+}
