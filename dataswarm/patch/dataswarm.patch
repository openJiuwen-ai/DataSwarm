@@ -0,0 +1,118 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""真实 DuckDB 文件上的数分工具回归；仅替换 dwcli 传输，不调用模型。"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import socket
+import sys
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.databases import service as databases
+from jiuwenswarm.common import db_connector as dbc, workspace_context
+
+
+SCRIPTS = (Path(__file__).resolve().parents[3] / "jiuwenswarm" / "resources" /
+           "agent" / "workspace" / "skills" / "nl2sql" / "scripts")
+
+
+def _load(name, monkeypatch):
+    spec = importlib.util.spec_from_file_location(name, SCRIPTS / f"{name}.py")
+    module = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, name, module)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def tools(tmp_path, monkeypatch):
+    duckdb = pytest.importorskip("duckdb")
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    metadata_ref = f"sqlite://{tmp_path / 'metadata.db'}"
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", metadata_ref)
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", metadata_ref)
+    monkeypatch.setattr(dbc, "_read_config_section", lambda _: {})
+    monkeypatch.setattr(socket.socket, "connect", lambda *args: pytest.fail("network access forbidden"))
+    path = tmp_path / "analysis.duckdb"
+    with duckdb.connect(str(path)) as connection:
+        connection.execute('CREATE SCHEMA "sales.area"')
+        connection.execute('CREATE TABLE "sales.area"."订单 \"\"明细" '
+                           '(id INTEGER PRIMARY KEY, region VARCHAR NOT NULL, revenue DECIMAL(8,2))')
+        connection.execute('INSERT INTO "sales.area"."订单 \"\"明细" '
+                           "VALUES (1, '华东', 12.50), (2, '华南', 7.25), (3, '华东', 3.00)")
+        connection.execute('COMMENT ON COLUMN "sales.area"."订单 \"\"明细".region IS \'地区\'')
+        connection.execute('CREATE TABLE main.orders (region VARCHAR, revenue INTEGER)')
+        connection.execute("INSERT INTO main.orders VALUES ('wrong schema', 999)")
+    ref = dbc.build_file_source_ref("duckdb", str(path))
+    token = workspace_context.set_current(None)
+    monkeypatch.syspath_prepend(str(SCRIPTS))
+    client = _load("_db_client", monkeypatch)
+    monkeypatch.setattr(client, "db_ref", lambda: ref)
+    calls = []
+
+    def local_transport(*args, **kwargs):
+        calls.append(args)
+        group, action, *flags = args
+        params = dict(zip(flags[::2], flags[1::2]))
+        if (group, action) == ("databases", "tables"):
+            return {"tables": databases.list_tables(params["--db-ref"])}
+        if (group, action) == ("databases", "table"):
+            return databases.get_table_detail(params["--db-ref"], params["--table"])
+        if (group, action) == ("sql", "run"):
+            return dbc.query(params["--db-ref"], params["--sql"], limit=int(params["--limit"]))
+        raise AssertionError(f"unexpected tool request: {group}/{action}")
+
+    monkeypatch.setattr(client.db_connector, "_dwcli", local_transport)
+    modules = {name: _load(name, monkeypatch)
+               for name in ("get_schema", "recall_tables", "sample_dim_values")}
+    modules.update(client=client, calls=calls, path=path)
+    try:
+        yield modules
+    finally:
+        workspace_context.reset(token)
+        dbc._invalidate(metadata_ref, read_only=True)
+        dbc._invalidate(metadata_ref, read_only=False)
+
+
+TABLE = '"sales.area"."订单 ""明细"'
+
+
+def test_native_table_recall_and_schema_preserve_qualified_names(tools):
+    found = tools["recall_tables"]._search_duckdb("订单", 10)
+    assert [item["name"] for item in found["items"]] == [TABLE]
+    metadata = tools["get_schema"].get_schema(TABLE)
+    assert metadata["table"] == TABLE
+    region = next(column for column in metadata["columns"] if column["name"] == "region")
+    assert region["comment"] == "地区" and region["nullable"] is False
+    assert all(call[:2] != ("sql", "run") for call in tools["calls"])
+
+
+def test_native_dimension_values_and_analysis_use_selected_schema(tools):
+    before = tools["path"].read_bytes()
+    values = tools["sample_dim_values"].sample_dim_values(TABLE, ["region"])
+    assert values["count"] == 1
+    assert set(values["dim_columns"][0]["values"]) == {"华东", "华南"}
+    assert values["dim_columns"][0]["comment"] == "地区"
+    client = tools["client"]
+    result = client.query(f'SELECT region, SUM(revenue) FROM {client.quote_table(TABLE)} '
+                          'GROUP BY region ORDER BY region')
+    assert [(row[0], str(row[1])) for row in result["rows"]] == [("华东", "15.50"), ("华南", "7.25")]
+    assert tools["path"].read_bytes() == before
+
+
+@pytest.mark.parametrize("name, expected", [
+    (TABLE, TABLE),
+    ("main.orders", '"main"."orders"'),
+    ('"a.b"', '"a.b"'),
+    ('orders; DROP TABLE x', '"orders; DROP TABLE x"'),
+])
+def test_native_table_identifier_quoting(tools, name, expected):
+    assert tools["client"].quote_table(name) == expected
+
+
+def test_file_view_name_with_dot_is_one_identifier(tools, monkeypatch):
+    client = tools["client"]
+    monkeypatch.setattr(client, "db_ref", lambda: dbc.build_file_source_ref("json", "orders.json"))
+    assert client.quote_table("sales.orders") == '"sales.orders"'
