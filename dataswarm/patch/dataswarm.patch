+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis_flow 跨进程 manifest 账本锁单测（F-045 回归）。
+
+背景：编排层一轮并行发起多个 analysis_flow 进程（G1 通道并行 compile
+c1/c2/c3），各进程「load → 改 → save」无互斥时后落盘者拿过期快照整体
+覆盖先落盘者的记录（lost update）——实测三成分并行后账本只剩最后落盘
+者的 evidence，被迫串行重跑补账多烧 6+ 轮 LLM。
+
+不打 web 服务；子进程内联脚本复刻「load → sleep（模拟 HTTP 编译/执行
+耗时）→ save」真实写路径。对照组（无锁）证明竞态真实可复现、测试有效。
+"""
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+_SKILL_SCRIPT = (Path(__file__).resolve().parents[3]
+                 / "jiuwenswarm" / "resources" / "agent" / "workspace" / "skills"
+                 / "dw-analysis" / "scripts" / "analysis_flow.py")
+
+# 子进程工作载荷：patch _dir/_manifest_path 落 tmp，复刻 cmd_compile 的
+# 「load → 改 → save」写路径；sleep 放大竞态窗口（模拟 HTTP 编译+执行秒级耗时）。
+_CHILD_WORK = r"""
+import sys, time
+from pathlib import Path
+
+root, analysis_id, key, use_lock, hold_before, scripts_dir = (
+    sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1", float(sys.argv[5]), sys.argv[6])
+sys.path.insert(0, scripts_dir)
+import flow.manifest as fm
+tmp = Path(root)
+fm._dir = lambda aid: tmp / aid
+fm._manifest_path = lambda aid: tmp / aid / "manifest.json"
+
+def work():
+    if hold_before:
+        time.sleep(hold_before)  # 模拟 HTTP 编译耗时（锁外可并行）
+    m = fm._load(analysis_id)
+    m[key] = key
+    time.sleep(1.0)             # 模拟 HTTP 执行耗时，放大竞态窗口
+    fm._save(m)
+
+if use_lock:
+    with fm._manifest_lock(analysis_id, timeout=60):
+        print("LOCKED", flush=True)  # 持锁信号：timeout 测试据此同步
+        work()
+else:
+    work()
+print("done", key)
+"""
+
+
+def _load_module():
+    sys.path.insert(0, str(_SKILL_SCRIPT.parent))
+    import flow.manifest as mod
+    return mod
+
+
+def _flow_manifest():
+    """flow.manifest 模块对象——_dir/_manifest_path 的家（Phase 2a 拆层后
+    _load/_save/_manifest_lock 内部经它自己的全局找路径，patch 打这里）。"""
+    import flow.manifest as fm
+    return fm
+
+
+@pytest.fixture()
+def af():
+    return _load_module()
+
+
+def _seed_manifest(root: Path, analysis_id: str = "a1") -> Path:
+    """初始账本：含 budget（_save 的 exec_ms 记账目标）。"""
+    d = root / analysis_id
+    d.mkdir(parents=True, exist_ok=True)
+    (d / "manifest.json").write_text(json.dumps({
+        "analysis_id": analysis_id, "question": "q",
+        "budget": {"sql_count": 0, "exec_ms": 0},
+    }, ensure_ascii=False), encoding="utf-8")
+    return d / "manifest.json"
+
+
+def _spawn(root: Path, key: str, use_lock: bool, hold_before: float = 0.0) -> subprocess.Popen:
+    return subprocess.Popen(
+        [sys.executable, "-c", _CHILD_WORK, str(root), "a1", key,
+         "1" if use_lock else "0", str(hold_before), str(_SKILL_SCRIPT.parent)],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+
+
+def _wait(procs: list[subprocess.Popen]) -> None:
+    for p in procs:
+        out, err = p.communicate(timeout=120)
+        assert p.returncode == 0, f"子进程失败: {err}"
+
+
+def _manifest_of(root: Path) -> dict:
+    return json.loads((root / "a1" / "manifest.json").read_text(encoding="utf-8"))
+
+
+# ==========================================================================
+# 核心回归：并行写账本不丢记录
+# ==========================================================================
+
+def test_parallel_locked_no_lost_update(tmp_path):
+    """两进程并行「load→改→save」，持锁时两个 key 都必须存活。"""
+    _seed_manifest(tmp_path)
+    _wait([_spawn(tmp_path, "p1", use_lock=True),
+           _spawn(tmp_path, "p2", use_lock=True)])
+    m = _manifest_of(tmp_path)
+    assert m.get("p1") == "p1", "先落盘进程的记录被覆盖（lost update 复发）"
+    assert m.get("p2") == "p2", "后落盘进程的记录丢失"
+
+
+def test_parallel_unlocked_lost_update_reproduced(tmp_path):
+    """对照组（不持锁）：同款并行写必须丢 key——证明上例的测试有效性，
+    防止「测试环境根本复现不了竞态」造成的假绿。"""
+    _seed_manifest(tmp_path)
+    _wait([_spawn(tmp_path, "u1", use_lock=False),
+           _spawn(tmp_path, "u2", use_lock=False)])
+    m = _manifest_of(tmp_path)
+    assert "u1" not in m or "u2" not in m, \
+        "无锁并行竟然没丢更新——竞态窗口未生效，锁定测试可能假绿（需排查）"
+
+
+# ==========================================================================
+# 锁原语行为
+# ==========================================================================
+
+def test_lock_timeout_raises(af, tmp_path, monkeypatch):
+    """他进程持锁不放时，超时抛 SystemExit 而非挂死。"""
+    _seed_manifest(tmp_path)
+    holder = _spawn(tmp_path, "holder", use_lock=True)
+    try:
+        # 等 holder 真正持锁（子进程 Python 启动+import 需秒级）再抢
+        deadline = time.monotonic() + 30
+        while time.monotonic() < deadline:
+            line = holder.stdout.readline()
+            if line.strip() == "LOCKED":
+                break
+        else:
+            pytest.fail("holder 子进程 30s 内未发出持锁信号")
+        fm = _flow_manifest()
+        monkeypatch.setattr(fm, "_dir", lambda aid: tmp_path / aid)
+        monkeypatch.setattr(fm, "_manifest_path", lambda aid: tmp_path / aid / "manifest.json")
+        with pytest.raises(SystemExit, match="锁等待超时"):
+            with af._manifest_lock("a1", timeout=0.5):
+                pass
+    finally:
+        holder.kill()
+        holder.communicate(timeout=30)
+
+
+def test_lock_released_after_with(af, tmp_path, monkeypatch):
+    """with 结束即释放：串行两次获取不超时。"""
+    _seed_manifest(tmp_path)
+    fm = _flow_manifest()
+    monkeypatch.setattr(fm, "_dir", lambda aid: tmp_path / aid)
+    monkeypatch.setattr(fm, "_manifest_path", lambda aid: tmp_path / aid / "manifest.json")
+    with af._manifest_lock("a1", timeout=5):
+        pass
+    with af._manifest_lock("a1", timeout=5):
+        pass
+
+
+def test_exec_ms_excludes_lock_wait(tmp_path):
+    """锁排队等待不计入 budget.exec_ms（防三进程排队累计误撞 deadline）。
+
+    两进程同时 spawn：先获锁者持锁干 ~1s 活；后获锁者等待 ~1s 后拿到锁
+    再干 ~1s 活——总 exec_ms 应 ≈ 两段工作时间和（~2s），不含后到者的
+    锁等待（否则 3s 起步、真实场景三进程排队累计误撞 deadline_ms 红线）。
+    """
+    _seed_manifest(tmp_path)
+    _wait([_spawn(tmp_path, "w1", use_lock=True),
+           _spawn(tmp_path, "w2", use_lock=True)])
+    m = _manifest_of(tmp_path)
+    assert m.get("w1") == "w1" and m.get("w2") == "w2"
+    assert m["budget"]["exec_ms"] < 2500, \
+        f"exec_ms={m['budget']['exec_ms']}ms 疑似含锁等待时间（deadline 误撞风险）"
