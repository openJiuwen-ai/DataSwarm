+    out = svc.persist_run(result, meta_db_ref="sqlite:///meta.db")
+    assert out["status"] == "ok"
+    assert out["runs"] == 1
+    assert out["findings"] == 1
+    # 校验 SQL：runs 表 INSERT + findings 表 executemany
+    sqls = [c[0] for c in patch_connector._conn.executed]
+    assert any("dw_inspection_runs" in s for s in sqls)
+    assert any("dw_inspection_findings" in s for s in sqls)
