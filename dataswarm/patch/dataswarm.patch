+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/bootstrap.py —— 启动接线。
+
+由 app_web.py 在服务启动时调用一次：
+    from jiuwenswarm.channels.web.orchestration.bootstrap import start as start_orchestration
+    start_orchestration()
+
+做四件事（多工作空间见 docs/archive/delivered/multi-workspace-datasource-plan.md 决策五）：
+    1. 启动校验：list_workspaces() 触发 yaml 解析 + 元数据库 ref 唯一性校验
+       （重复即抛 DuplicateMetadataRef 拒绝启动，决策二/十、MVP 约束 9.5）
+    2. 逐工作空间 init_db()：遗留清理 → deploy/schema 幂等 ensure → 孤儿回扫
+    3. 起 scheduler daemon 线程（调度循环内逐工作空间取任务）
+    4. 注册执行器（import 触发 @register）
+"""
+from __future__ import annotations
+
+import logging
+import shutil
+import threading
+from pathlib import Path
+
+from jiuwenswarm.common.utils import _default_builtin_skill_names, get_user_workspace_dir
+
+from jiuwenswarm.common import workspace_context
+
+from . import db as orch_db
+from . import scheduler
+
+logger = logging.getLogger(__name__)
+
+_started = False
+
+# dev 侧 skills 根（jiuwenswarm/resources/agent/workspace/skills）
+# 本文件位于 jiuwenswarm/channels/web/orchestration/，向上三级即 jiuwenswarm/
+_DEV_SKILLS = Path(__file__).resolve().parents[3] / "resources" / "agent" / "workspace" / "skills"
+# runtime 侧 skills（与 scripts/dw-ops/_sync_runtime.py 的目标目录一致）；
+# 经 get_user_workspace_dir 解析：桌面/多实例形态用 JIUWENSWARM_DATA_DIR 隔离数据
+# 目录，硬编码 ~/.jiuwenswarm 会把 _dw_common 等同步到错误位置，skill 脚本的
+# _dw_common 就近解析（基于自身所在目录）随之失配 → ModuleNotFoundError。
+# whl 实测（dev42，2026-11-02）同症：每次服务启动重建已废弃的旧目录并
+# 占用句柄阻止改名——两线独立发现同修，语义一致。
+_RUNTIME_SKILLS = get_user_workspace_dir() / "agent" / "workspace" / "skills"
+
+
+def _sync_dev_skills() -> None:
+    """启动时把 dev 侧 skill 覆盖同步到 runtime 目录。
+
+    家规：改 skill 后必须同步 runtime 才生效。dw 系列 skill 与 ``_dw_common``
+    共享库漏同步会导致 runtime 用回旧版逻辑，故随服务启动覆盖一次（与
+    scripts/dw-ops/_sync_runtime.py 同语义，可替代手动执行）。
+
+    清单与 ``ensure_default_builtin_skills``（jiuwenswarm/common/utils.py）共用
+    ``_default_builtin_skill_names``：固定列表 + 全部 dw- 前缀技能（动态扫描），
+    避免两处硬编码清单漂移。
+    单个 skill 失败只记日志，不阻断启动（skill 运行仍可用 runtime 已有版本兜底）。
+    """
+    for name in ("_dw_common", *_default_builtin_skill_names(_DEV_SKILLS)):
+        src, dst = _DEV_SKILLS / name, _RUNTIME_SKILLS / name
+        try:
+            if not src.is_dir():
+                logger.warning("[orchestration] skill sync skipped, dev dir missing: %s", name)
+                continue
+            shutil.copytree(src, dst, dirs_exist_ok=True)
+            for pycache in dst.rglob("__pycache__"):
+                shutil.rmtree(pycache, ignore_errors=True)
+        except Exception as exc:  # noqa: BLE001
+            logger.error("[orchestration] skill sync failed, %s keeps old version: %s", name, exc)
+    logger.info("[orchestration] dev skills synced to runtime")
+
+
+def start() -> None:
+    global _started
+    if _started:
+        return
+    _started = True   # 幂等语义：重复 start 不叠加
+    # 触发执行器注册
+    from .executors import sql_executor as _sql  # noqa: F401
+    from .executors import python_executor as _py  # noqa: F401
+
+    def _init_and_start():
+        # 1) 启动校验（决策二/十）：解析 workspaces 段，重复元数据库 ref 直接失败。
+        #    单工作空间/legacy 模式此调用等价于解析顶层两键，行为不变。
+        try:
+            workspaces = workspace_context.list_workspaces()
+        except Exception as exc:  # noqa: BLE001
+            logger.error("[orchestration] workspace config invalid (scheduler not started): %s", exc)
+            return
+        # 2) 逐工作空间 ensure + 孤儿回扫（决策五）。每轮显式 set_current，
+        #    使 init_db 内的 _connect(None)/_resolve_metadata_db_ref 落到该工作空间元库。
+        total_ensured = 0
+        for ws in workspaces:
+            try:
+                token = workspace_context.set_current(ws.workspace_id)
+                try:
+                    result = orch_db.init_db() or {}
+                finally:
+                    workspace_context.reset(token)
+            except Exception as exc:  # noqa: BLE001
+                # 失败语义：不启动 scheduler；web 首次触达相关 API 时会得到明确错误。
+                # MVP 约束 9.5：单库不可用不整体阻断，只记日志（其他工作空间继续）。
+                logger.error("[orchestration] init_db failed for workspace %r (skipped): %s",
+                             ws.workspace_id, exc)
+                continue
+            total_ensured += len(result.get("ensured_tables", []))
+            logger.info("[orchestration] workspace %r schema ensured: dialect=%s ensured=%d "
+                        "elapsed=%sms dir=%s",
+                        ws.workspace_id, result.get("dialect"),
+                        len(result.get("ensured_tables", [])),
+                        result.get("elapsed_ms"), result.get("schema_dir"))
+        if total_ensured == 0 and workspaces:
+            logger.error("[orchestration] no workspace initialized (scheduler not started)")
+            return
+        scheduler.start()
+
+    # 后台初始化：init_db 涉及 Doris 公网往返 + sqlalchemy 冷导入，
+    # 不能拖住 HTTP 监听就绪（否则前端探针超时）。顺序语义不变。
+    _sync_dev_skills()
+    threading.Thread(target=_init_and_start, name="orch-init-db", daemon=True).start()
