+    InMemorySemanticaAdapter,
+    graph_projection_enabled,
+)
+from jiuwenswarm.common import workspace_context
+
+
+ROWS = [
+    {"id": 1, "region": "east"},
+    {"id": 2, "region": "west"},
+]
+
+
+@pytest.fixture()
+def degrade(monkeypatch, tmp_path, semantic_db):
+    """对齐 test_semantic_multisource_pipeline 的隔离手法。
+
+    SEMANTICA_* 与开关默认清空（宿主机可能配过，防泄漏进降级判据）；
+    ``service.from_environment`` patch 为 fail——降级路根本不该构造生产
+    adapter，真走到说明判据失效。「开」用例在测试体内再覆盖 env 与 patch。
+    """
+    context = workspace_context.WorkspaceContext(
+        "graph-degrade-workspace", "GraphDegrade", "", f"sqlite://{semantic_db}")
+    monkeypatch.setattr(workspace_context, "resolve", lambda workspace_id=None: context)
+    token = workspace_context.set_current(context.workspace_id)
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    warehouse = tmp_path / "warehouse"
+    warehouse.mkdir()
+    monkeypatch.setattr(duckdb_connector, "_warehouse_base_dir", lambda: warehouse)
+    sources = {}
+
+    def find_local_source(source_id, workspace_id=None):
+        assert workspace_id == context.workspace_id
+        return sources.get(source_id)
+
+    monkeypatch.setattr(service.datasource_store, "find_local_source", find_local_source)
+    monkeypatch.setattr(service.datasource_store, "find_source", lambda *args, **kwargs: None)
+    monkeypatch.setattr(service.datasource_store, "list_sources", lambda *args, **kwargs: list(sources.values()))
+    monkeypatch.setattr(service, "from_environment", lambda:
+                        pytest.fail("graph_projection_enabled() must gate from_environment in service"))
+    # Default tests must never reach an embedding client, even when a developer
+    # machine has provider credentials in its platform configuration.
+    monkeypatch.setattr(embedding, "emb_available", lambda: False)
+    monkeypatch.setattr(embedding, "embed_texts", lambda *args, **kwargs:
+                        pytest.fail("unexpected real embedding channel"))
+    for name in ("SEMANTICA_URI", "SEMANTICA_USERNAME", "SEMANTICA_PASSWORD",
+                 "SEMANTICA_GRAPH_ENABLED"):
+        monkeypatch.delenv(name, raising=False)
+
+    def register_csv():
+        path = tmp_path / "orders.csv"
+        with path.open("w", encoding="utf-8", newline="") as file:
+            writer = csv.DictWriter(file, fieldnames=list(ROWS[0]))
+            writer.writeheader()
+            writer.writerows(ROWS)
+        config = {"path": str(path), "table_name": "orders"}
+        source = {"source_id": "csv-source", "source_type": "csv", "enabled": True,
+                  "config": config, "config_version": 1,
+                  "db_ref": get_source_type("csv").build_ref(config)}
+        sources[source["source_id"]] = source
