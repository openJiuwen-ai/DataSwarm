+    from jiuwenswarm.channels.web.dataagent.glossary import sync as glossary_sync
+
+    monkeypatch.setattr(glossary_sync, "_embedding_configured", lambda: False)
+
+
+@pytest.fixture()
+def semantic_db(monkeypatch, tmp_path):
+    """tmp sqlite 元库（跑真 DDL）：repository/采集线单测共用。
+
+    从 test_semantic_vector_store.py 提升而来（阶段 A 起多处复用，原文件内
+    定义保留不动）。
+    """
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+    db_path = tmp_path / "semantic.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    ensure_system_schema(f"sqlite://{db_path}")
+    return db_path
diff --git a/tests/unit_tests/dataagent/test_acceptance_negative_sql_safety.py b/tests/unit_tests/dataagent/test_acceptance_negative_sql_safety.py
