@@ -0,0 +1,73 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { orchestrationApi } from '../api/orchestrationApi';
+import type { Instance } from '../types/orchestration';
+import { ACTIVE_INSTANCE_STATUSES } from '../components/shared/instanceUtils';
+
+/** A request belongs to one workflow and instance, including polling and action responses. */
+export function useWorkflowInstance(workflowId: string, instanceId: string | null) {
+  const { t } = useTranslation();
+  const [data, setData] = useState<Instance | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [revision, setRevision] = useState(0);
+  const generation = useRef(0);
+  const reload = useCallback(() => {
+    generation.current += 1;
+    setRevision((value) => value + 1);
+  }, []);
+  useEffect(() => {
+    const request = ++generation.current;
+    let timer: number | undefined;
+    let active = true;
+    setError(null);
+    if (!instanceId) {
+      setData(null);
+      setLoading(false);
+      return;
+    }
+    const load = async () => {
+      setLoading(true);
+      try {
+        const instance = await orchestrationApi.getInstance(instanceId);
+        if (!active || request !== generation.current) return;
+        if (instance.ref_type !== 'workflow' || instance.ref_id !== workflowId || instance.instance_id !== instanceId) {
+          setData(null);
+          throw new Error(t('dataAsset.development.wrongInstance'));
+        }
+        setData(instance);
+        setError(null);
+        if (ACTIVE_INSTANCE_STATUSES.has(instance.status)) timer = window.setTimeout(() => void load(), 2000);
+      } catch (cause) {
+        if (active && request === generation.current) setError(cause instanceof Error ? cause.message : String(cause));
+      } finally {
+        if (active && request === generation.current) setLoading(false);
+      }
+    };
+    void load();
+    return () => {
+      active = false;
+      window.clearTimeout(timer);
+      generation.current += 1;
+    };
+  }, [workflowId, instanceId, revision, t]);
+  const acceptAction = (instance: Instance) => {
+    if (instance.instance_id !== instanceId || instance.ref_id !== workflowId) return;
+    generation.current += 1;
+    setData((previous) =>
+      previous?.instance_id === instanceId
+        ? { ...previous, ...instance, task_runs: instance.task_runs ?? previous.task_runs }
+        : instance,
+    );
+    setError(null);
+    setRevision((value) => value + 1);
+  };
+  return {
+    instance: data?.instance_id === instanceId && data.ref_id === workflowId ? data : null,
+    loading,
+    error,
+    reload,
+    acceptAction,
+  };
+}
