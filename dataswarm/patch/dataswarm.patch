+
+def b_family_qualified_columns():
+    """列名必须保留 <family>:<qualifier>，不能擅自改名。"""
+    conn = connector_for()
+    inferred = conn.infer_schema(TABLE, sample=2000)
+    by = {c["name"]: c for c in inferred["columns"]}
+    assert "_row" in by, list(by)                      # RowKey 作为列
+    for want in ("d:order_id", "d:order_amt", "d:channel_name"):
+        assert want in by, list(by)
+    # 列名若被改写成 order_amt，就与 HBase 侧真实列对不上，血缘会断
+    assert "order_amt" not in by, "列族前缀被擅自剥掉了"
+    # HBase 无类型：所有值都是字节串
+    types = {c["name"]: c["type"] for c in inferred["columns"]}
+    assert set(types.values()) == {"VARCHAR"}, types
+    return (f"{len(by)} 列（含 _row）；列名保留族前缀；全部 VARCHAR"
+            f"（HBase 无类型）")
+
+
+def b_absent_column_is_reported():
+    conn = connector_for()
+    by = {c["name"]: c for c in conn.infer_schema(TABLE, sample=2000)["columns"]}
+    assert by["d:order_id"]["presence"] == 1.0, by["d:order_id"]
+    assert by["d:order_amt"]["presence"] < 1.0, by["d:order_amt"]
+    return (f"d:order_amt presence={by['d:order_amt']['presence']}"
+            f"（空值=列缺席，如实报告）")
+
+
+def b_rowkey_order():
+    """RowKey 左补零后，HBase 的字节序扫描＝数值序。"""
+    conn = connector_for()
+    out = conn.scan(TABLE, limit=5)
+    idx = out["columns"].index("_row")
+    keys = [r[idx] for r in out["rows"]]
+    assert keys == sorted(keys), keys
+    assert keys[0] == "00000001", keys[0]
+    return f"前 5 个 RowKey = {keys}（字节序＝数值序）"
+
+
+def b_projection_pushdown():
+    """物理列投影可下推；合成的 _row 列必须由客户端生成。
+
+    将 _row 作为列族发送会触发 NoSuchColumnFamilyException；仅选合成列时
+    仍需读取远端行，再在本地裁列。
+    """
+    conn = connector_for()
+    cols = ["_row", "d:order_id", "d:order_amt"]
+    out = conn.scan(TABLE, projection=cols, limit=10)
+    # 列序跟随 infer_schema（三个 store 一致的既有约定），故按集合比
+    assert set(out["columns"]) == set(cols), out["columns"]
+    assert out["row_count"] == 10, out["row_count"]
+    assert all(len(r) == len(cols) for r in out["rows"]), out["rows"][0]
+    # 只选合成列：必须退化为全列扫后本地裁列，而不是传一个 HBase 不认的列族
+    only_key = conn.scan(TABLE, projection=["_row"], limit=3)
+    assert only_key["columns"] == ["_row"], only_key["columns"]
+    assert only_key["row_count"] == 3, only_key["row_count"]
+    filtered = conn.scan(TABLE, filters={"d:region_id": "9"}, limit=200)
+    vals = {r[filtered["columns"].index("d:region_id")] for r in filtered["rows"]}
+    assert vals <= {"9"}, vals
+    return (f"投影下推生效（{len(cols)} 列）；只选 RowKey 时退化全列扫；"
+            f"谓词在本地过滤但结果正确")
+
+
+def b_scan_50k_throughput():
+    conn = connector_for()
+    started = time.monotonic()
+    out = conn.scan(TABLE, limit=50000)
+    elapsed = time.monotonic() - started
+    assert out["row_count"] == 50000, out["row_count"]
+    return f"5 万行经 Thrift 取回耗时 {elapsed:.1f}s"
+
+
+def b_governance_path():
+    ref = R.get_source_type("hbase").build_ref(CONFIG)
+    assert ref == f"hbase://127.0.0.1:{PORT}", ref
+    spec = dbc.parse_db_ref(ref)
+    assert spec["type"] == "hbase" and spec["port"] == PORT, spec
+    return f"build_ref={ref}，parse_db_ref 往返无损"
+
+
+def b_capabilities():
+    conn = connector_for()
+    assert capabilities_of(conn) == {"sql", "scan"}, capabilities_of(conn)
+    assert isinstance(conn, TabularScannable) and isinstance(conn, SqlQueryable)
+    return "capabilities = {'sql','scan'}（原生 scan + 物化后 SQL）"
+
+
+check("B1", "列名保留列族前缀", b_family_qualified_columns)
+check("B2", "列缺席如实报告", b_absent_column_is_reported)
+check("B3", "RowKey 字节序＝数值序", b_rowkey_order)
+check("B4", "投影下推/谓词本地过滤", b_projection_pushdown)
+check("B5", "5 万行取数吞吐", b_scan_50k_throughput)
+check("B6", "治理通路 ref 往返", b_governance_path)
+check("B7", "能力协议可组合", b_capabilities)
+
+blocked("B8", "知识候选落库",
+        "同前几批：默认元数据库为 doris 且本仓缺知识表 DDL。分类规则本身在"
+        "批 5/7/9 已验（采样列走同一条 _classify 路径）。")
+
+# ======================================================================
+print("\n########## 门 C：数据分析跑通 ##########")
+
+# HBase 分析 SQL 的类型与标识符要求：
+#   1. 列名带族前缀 → 必须加引号
+#   2. HBase 无类型 → 聚合必须 CAST
+AMT = 'CAST("d:order_amt" AS DOUBLE)'
+QUESTIONS = {
+    "Q1 单指标总量": f"SELECT ROUND(SUM({AMT}), 2) AS v FROM {TABLE}",
+    "Q2 分组TopN排序": (
+        f'SELECT CAST("d:region_id" AS BIGINT) AS region_id, '
+        f"ROUND(SUM({AMT}),2) AS v FROM {TABLE} "
+        f"GROUP BY region_id ORDER BY v DESC, region_id LIMIT 3"
+    ),
+    "Q3 时间粒度月度": (
+        f'SELECT strftime(CAST("d:order_date" AS DATE), \'%Y-%m\') AS m, '
+        f"ROUND(SUM({AMT}),2) AS v FROM {TABLE} "
+        f'WHERE CAST("d:order_date" AS DATE) >= DATE \'2026-01-01\' '
+        f"GROUP BY m ORDER BY m LIMIT 3"
+    ),
+    "Q4 过滤+聚合": (
+        f'SELECT CAST("d:category_id" AS BIGINT) AS category_id, COUNT(*) AS c '
+        f"FROM {TABLE} "
+        f'WHERE CAST("d:region_id" AS BIGINT) <> 9 '
+        f'AND "d:order_amt" IS NOT NULL '
+        f"GROUP BY category_id ORDER BY category_id"
+    ),
+    "Q5 空值占比": (
+        f'SELECT ROUND(100.0 * SUM(CASE WHEN "d:order_amt" IS NULL THEN 1 ELSE 0 END) '
+        f"/ COUNT(*), 4) AS pct FROM {TABLE}"
+    ),
+}
+
+
+def c_analysis_matches_baseline():
+    conn = connector_for()
+    answers = {}
+    for label, sql in QUESTIONS.items():
+        res = conn.query(sql, limit=10)
+        assert "materialize_truncated" not in res, (
+            f"{label} 物化被截断，答案不可信: {res.get('materialize_truncated')}"
+        )
+        answers[label] = norm(res["rows"])
+    for label, raw in BASELINE.items():
+        expected = norm(raw)
+        assert answers[label] == expected, (
+            f"{label} 与基准不一致:\n  基准={expected}\n  hbase={answers[label]}"
+        )
+    print("            经真实 HBase 取数物化后的答案：")
+    for label, rows in BASELINE.items():
+        print(f"              {label} = {rows[0] if len(rows) == 1 else rows}")
+    return "5 道题经真实 HBase → 物化 → DuckDB，与基准逐值一致"
+
+
+def c_null_semantics_preserved():
+    """列缺席必须变成 NULL，否则空值占比会算错。"""
+    conn = connector_for()
+    res = conn.query(
+        f'SELECT COUNT(*) AS total, '
+        f'SUM(CASE WHEN "d:order_amt" IS NULL THEN 1 ELSE 0 END) AS nulls '
+        f"FROM {TABLE}",
+        limit=5,
+    )
+    total, nulls = res["rows"][0]
+    assert total == 50000, total
+    assert nulls == 3571, f"空值数不对: {nulls}（应为 3571）"
+    return f"5 万行中 {nulls} 个 NULL —— 列缺席正确转为 NULL"
+
+
+def c_sentinel_rows_excluded():
+    """region_id=9 的 299 行汇总哨兵须被 Q4 过滤。"""
+    conn = connector_for()
+    res = conn.query(
+        f'SELECT COUNT(*) AS c FROM {TABLE} '
+        f'WHERE CAST("d:region_id" AS BIGINT) = 9',
+        limit=5,
+    )
+    assert res["rows"][0][0] == 299, res["rows"]
+    return "哨兵行 299 条可被精确定位并排除"
+
+
+check("C1", "5 道分析题与基准一致", c_analysis_matches_baseline)
+check("C2", "列缺席→NULL 语义正确", c_null_semantics_preserved)
+check("C3", "哨兵行可精确排除", c_sentinel_rows_excluded)
+
+# ======================================================================
+print("\n########## 门 D：护栏 ##########")
+
+
+def d_write_rejected():
+    conn = connector_for()
+    for sql in (f"INSERT INTO {TABLE} VALUES (1)",
+                f'UPDATE {TABLE} SET "d:order_amt" = 0',
+                f"DELETE FROM {TABLE}", f"DROP TABLE {TABLE}",
+                "CREATE TABLE evil AS SELECT 1",
+                f"COPY {TABLE} TO 'leak.csv'"):
+        expect_raises(lambda s=sql: conn.query(s), QueryValidationError, sql[:26])
+    return "6 类写/导出操作被拒"
+
+
+def d_materialize_truncation_explicit():
+    conn = connector_for({**CONFIG, "materialize_limit": 100})
+    res = conn.query(f"SELECT COUNT(*) AS c FROM {TABLE}", limit=5)
+    assert res["materialize_truncated"] == [TABLE], res
+    assert res["rows"] == [[100]], res["rows"]
+    return f"物化上限 100 时显式报截断，结果 {res['rows'][0][0]} 行（不静默少算）"
+
+
+def d_dialect_and_truncation():
+    conn = connector_for()
+    expect_raises(lambda: conn.query(f"SELECT 1; DROP TABLE {TABLE}"),
+                  QueryValidationError, "多语句")
+    assert dr.sqlglot_dialect("hbase") == "duckdb", dr.sqlglot_dialect("hbase")
+    res = conn.query(f"SELECT * FROM {TABLE}", limit=10)
+    assert len(res["rows"]) == 10 and res["truncated"] is True, res.get("truncated")
+    return "多语句被拒；方言=duckdb；返回行截断置位"
+
+
+def d_unknown_table_rejected():
+    conn = connector_for()
+    expect_raises(lambda: conn.query("SELECT 1 FROM no_such_table"),
+                  Exception, "不存在的表")
+    return "引用不存在的表被拒（不静默返回空）"
+
+
+check("D1", "写/导出操作被拒", d_write_rejected)
+check("D2", "物化截断显式透出", d_materialize_truncation_explicit)
+check("D3", "多语句/方言/截断", d_dialect_and_truncation)
+check("D4", "未知表被拒", d_unknown_table_rejected)
+
+blocked("D5", "分布式/鉴权行为",
+        "真连的是 standalone 单 JVM（内置 ZooKeeper、本地 FS rootdir）。"
+        "多 RegionServer、region split/合并、HDFS rootdir、Kerberos 鉴权、"
+        "Thrift2 协议均未覆盖。")
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\nhbase 四道门通过（真连 HBase 2.5.16 standalone；边界见阻断项）")
