+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dashboard/api.py —— BI看板 HTTP API handler。
+
+作为 dataagent 子模块，由 dataagent/api.py 委托调用。
+路由前缀: /api/dataagent/dashboard/
+
+入口处统一剥掉 `/api/dataagent/dashboard` 前缀，使 parts 索引与业务路径
+一一对应（避免 off-by-one：原代码假定 parts[3] 是资源名，但实际路径多
+一层 dashboard 前缀，parts[3] 永远是 'dashboard'，导致全部 404）。
+"""
+from __future__ import annotations
+
+import json
+from urllib.parse import urlparse  # noqa: F401
+
+from . import db as dash_db
+
+
+_PREFIX = "/api/dataagent/dashboard"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    """剥掉前缀后 split，返回 ['', <resource>, ...]。"""
+    rel = path[len(_PREFIX):].rstrip("/")
+    return rel.split("/")
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    try:
+        # ---- 维度 ----
+        if parts[1] == "dimensions" and len(parts) == 2:
+            handler._write_json(200, {"dimensions": dash_db.list_dimensions()})
+            return
+        if parts[1] == "dimensions" and len(parts) == 3:
+            d = dash_db.get_dimension(parts[2])
+            handler._write_json(200 if d else 404, d if d else {"error": "not_found"})
+            return
+        if len(parts) == 4 and parts[1] == "dimensions" and parts[3] == "values":
+            vals = dash_db.get_dimension_values(parts[2])
+            handler._write_json(200, {"values": vals})
+            return
+
+        # ---- 看板 ----
+        if parts[1] == "dashboards" and len(parts) == 2:
+            handler._write_json(200, {"dashboards": dash_db.list_dashboards(
+                status=handler._query_arg(parsed, "status"),
+                owner=handler._query_arg(parsed, "owner"),
+            )})
+            return
+        if parts[1] == "dashboards" and len(parts) == 3:
+            d = dash_db.get_dashboard(parts[2])
+            handler._write_json(200 if d else 404, d if d else {"error": "not_found"})
+            return
+
+        # ---- 看板卡片 ----
+        if len(parts) == 4 and parts[1] == "dashboards" and parts[3] == "cards":
+            handler._write_json(200, {"cards": dash_db.list_cards(parts[2])})
+            return
+
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def _read_body(handler) -> dict | None:
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except (TypeError, ValueError):
+        return None
+    if not length:
+        return {}
+    raw = handler.rfile.read(length)
+    try:
+        return json.loads(raw)
+    except (json.JSONDecodeError, TypeError):
+        return None
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = _read_body(handler)
+    if body is None and len(parts) > 2:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        # ---- 维度 ----
+        if len(parts) == 2 and parts[1] == "dimensions":
+            d = dash_db.create_dimension(body or {})
+            handler._write_json(201, d)
+            return
+        if len(parts) == 4 and parts[1] == "dimensions" and parts[3] == "update":
+            d = dash_db.update_dimension(parts[2], body or {})
+            handler._write_json(200 if d else 404, d if d else {"error": "not_found"})
+            return
+        if len(parts) == 4 and parts[1] == "dimensions" and parts[3] == "delete":
+            ok = dash_db.delete_dimension(parts[2])
+            handler._write_json(200 if ok else 404, {"ok": ok} if ok else {"error": "not_found"})
+            return
+
+        # ---- 看板 ----
+        if len(parts) == 2 and parts[1] == "dashboards":
+            d = dash_db.create_dashboard(body or {})
+            handler._write_json(201, d)
+            return
+        if len(parts) == 4 and parts[1] == "dashboards" and parts[3] == "update":
+            d = dash_db.update_dashboard(parts[2], body or {})
+            handler._write_json(200 if d else 404, d if d else {"error": "not_found"})
+            return
+        if len(parts) == 4 and parts[1] == "dashboards" and parts[3] == "delete":
+            ok = dash_db.delete_dashboard(parts[2])
+            handler._write_json(200 if ok else 404, {"ok": ok} if ok else {"error": "not_found"})
+            return
+        if len(parts) == 4 and parts[1] == "dashboards" and parts[3] == "render":
+            force = (body or {}).get("force_refresh", False)
+            tr = (body or {}).get("time_range") or {}
+            time_range = None
+            if tr and tr.get("start") and tr.get("end"):
+                time_range = (tr["start"], tr["end"])
+            try:
+                r = dash_db.render_dashboard(parts[2], force_refresh=force, time_range=time_range)
+            except ValueError as ve:
+                handler._write_json(400, {"error": "bad_request", "detail": str(ve)})
+                return
+            handler._write_json(200 if r else 404, r if r else {"error": "not_found"})
+            return
+
+        # ---- 看板卡片 ----
+        if len(parts) == 4 and parts[1] == "dashboards" and parts[3] == "cards":
+            c = dash_db.create_card(parts[2], body or {})
+            handler._write_json(201, c)
+            return
+        if len(parts) == 6 and parts[1] == "dashboards" and parts[3] == "cards" and parts[5] == "update":
+            c = dash_db.update_card(parts[4], body or {})
+            handler._write_json(200 if c else 404, c if c else {"error": "not_found"})
+            return
+        if len(parts) == 6 and parts[1] == "dashboards" and parts[3] == "cards" and parts[5] == "delete":
+            ok = dash_db.delete_card(parts[4])
+            handler._write_json(200 if ok else 404, {"ok": ok} if ok else {"error": "not_found"})
+            return
+        if len(parts) == 4 and parts[1] == "dashboards" and parts[3] == "reorder":
+            dash_db.reorder_cards(parts[2], (body or {}).get("card_ids", []))
+            handler._write_json(200, {"ok": True})
+            return
+
+        # ---- 渲染单卡片 ----
+        # POST /api/dataagent/dashboard/cards/{cardId}/render
+        if len(parts) == 4 and parts[1] == "cards" and parts[3] == "render":
+            force = (body or {}).get("force_refresh", False)
+            tr = (body or {}).get("time_range") or {}
+            time_range = None
+            if tr and tr.get("start") and tr.get("end"):
+                time_range = (tr["start"], tr["end"])
+            try:
+                r = dash_db.render_card(parts[2], force_refresh=force, time_range=time_range)
+            except ValueError as ve:
+                handler._write_json(400, {"error": "bad_request", "detail": str(ve)})
+                return
+            handler._write_json(200 if r else 404, r if r else {"error": "not_found"})
+            return
+
+        # ---- 从 dw-report 导入 ----
+        # POST /api/dataagent/dashboard/import-from-report
+        if len(parts) == 2 and parts[1] == "import-from-report":
+            # workspace_id 可能在 body（dwcli json_body 路由 query 不带）：导入链
+            # 内 ensure_system_schema/_business_ref_or_default 都依赖当前工作空间
+            # 上下文，缺了会 WORKSPACE_CONTEXT_REQUIRED。
+            from jiuwenswarm.common import workspace_context
+            ws_id = ((body or {}).get("workspace_id")
+                     or handler.headers.get("X-Workspace-Id", "") or "").strip()
+            token = None
+            if ws_id:
+                token = workspace_context.set_current(
+                    workspace_context.resolve(ws_id).workspace_id)
+            try:
+                r = dash_db.import_from_report(
+                    spec_path=(body or {}).get("spec_path", ""),
+                    dashboard_name=(body or {}).get("dashboard_name"),
+                    datasource_ref=(body or {}).get("datasource_ref"),
+                )
+            finally:
+                if token is not None:
+                    workspace_context.reset(token)
+            if not r:
+                handler._write_json(400, {"error": "import_failed"})
+            elif r.get("error"):
+                handler._write_json(400, r)
+            else:
+                handler._write_json(201, r)
+            return
+
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
