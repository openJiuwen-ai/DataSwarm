+# 治理通路（db_connector）按 <PROTOCOL>_USER 补凭据，与 ftp 同纪律
+os.environ.setdefault("WEBHDFS_USER", USER)
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (  # noqa: E402
