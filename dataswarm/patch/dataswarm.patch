+    ds_service._invalidate_creds_cache()
+    assert disposed == ["src1"]
+    assert sa._ENGINE_CACHE == {}
+
+
+def test_sql_service_accepts_source_id(monkeypatch):
+    from jiuwenswarm.channels.web.dataagent.sql import service
+
+    monkeypatch.setattr(
+        "jiuwenswarm.channels.web.dataagent.datasource.service.query_source",
+        lambda source_id, sql, limit=100: {
