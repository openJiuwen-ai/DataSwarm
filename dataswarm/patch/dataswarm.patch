+测 _topo_layers 分层 + run_workflow_instance 同层并行执行 + 失败传导。
+
+跑法：python -m pytest tests/unit_tests/orchestration/test_workflow_parallel.py -v
+"""
+from __future__ import annotations
+
+import os
+import sys
+import threading
+import time
+from unittest.mock import patch, MagicMock
+
+import pytest
+
+_REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+for _p in (_REPO,):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+from jiuwenswarm.channels.web.orchestration import workflow_engine  # noqa: E402
+from jiuwenswarm.channels.web.orchestration.executors.base import TaskRunResult  # noqa: E402
+
+
+def _node(node_id: str, task_id: str, upstream: str = "", order: int = 0, wait_review: bool = False) -> dict:
+    return {
+        "node_id": node_id, "task_id": task_id, "node_name": node_id,
+        "upstream_nodes": upstream, "order_index": order,
+        "wait_review": wait_review,
+    }
+
+
+def test_topo_layers_linear_chain():
+    """A → B → C 应分 3 层。"""
+    nodes = [
+        _node("A", "t1", upstream="", order=0),
+        _node("B", "t2", upstream="A", order=1),
+        _node("C", "t3", upstream="B", order=2),
+    ]
+    layers = workflow_engine._topo_layers(nodes)
+    assert layers == [["A"], ["B"], ["C"]]
+
+
+def test_topo_layers_parallel_same_layer():
+    """A、B 无依赖同层；C 依赖 A+B 在下一层。"""
+    nodes = [
+        _node("A", "t1", upstream="", order=0),
+        _node("B", "t2", upstream="", order=1),
+        _node("C", "t3", upstream="A,B", order=2),
+    ]
+    layers = workflow_engine._topo_layers(nodes)
+    assert len(layers) == 2
+    assert set(layers[0]) == {"A", "B"}
+    assert layers[1] == ["C"]
+
+
+def test_topo_layers_cycle_detected():
+    """A → B → A 有环抛 ValueError。"""
+    nodes = [
+        _node("A", "t1", upstream="B", order=0),
+        _node("B", "t2", upstream="A", order=1),
+    ]
+    with pytest.raises(ValueError, match="cycle"):
+        workflow_engine._topo_layers(nodes)
+
+
+def test_topo_layers_empty():
+    assert workflow_engine._topo_layers([]) == []
+
+
+def test_run_workflow_parallel_layer_runs_concurrently():
+    """同层 2 节点并行执行：总耗时应 < 串行耗时的 1.5x。"""
+    nodes = [
+        _node("A", "t1", upstream="", order=0),
+        _node("B", "t2", upstream="", order=1),
+        _node("C", "t3", upstream="A,B", order=2),
+    ]
+
+    def fake_execute_task(task, artifact_dir, log_prefix="", instance_id=None):
+        time.sleep(0.3)  # 模拟 0.3s 任务
+        return TaskRunResult(status="success", exit_code=0, stdout_path="", stderr_path="",
+                             error_message=None, result_summary={"node": task["task_id"]})
+
+    def fake_compute_gov(task, run, result, started, finished):
+        return {}
+
+    def fake_write_lineage(task, instance_id, result):
+        pass
+
+    instance_state = {"instance_id": "i1", "artifact_dir": "/tmp/x", "status": "queued"}
+
+    def update_instance(instance_id, **kwargs):
+        instance_state.update(kwargs)
+        return instance_state
+
+    fake_wf = {"workflow_id": "w1"}
+
+    with patch.object(workflow_engine.orch_db, "get_workflow", return_value=fake_wf), \
+         patch.object(workflow_engine.orch_db, "list_nodes", return_value=nodes), \
+         patch.object(workflow_engine.orch_db, "get_instance", return_value=instance_state), \
+         patch.object(workflow_engine.orch_db, "update_instance", side_effect=update_instance), \
+         patch.object(workflow_engine.orch_db, "list_task_runs", return_value=[]), \
+         patch.object(workflow_engine.orch_db, "create_task_run", return_value={"run_id": "r1"}), \
+         patch.object(workflow_engine.orch_db, "update_task_run", return_value=None), \
+         patch.object(workflow_engine.orch_db, "get_task_run", return_value={"started_at": None}), \
+         patch.object(workflow_engine.orch_db, "get_task",
+                      side_effect=lambda tid: {"task_id": tid, "name": tid, "code": "",
+                                               "executor_type": "python", "params": {}}), \
+         patch.object(workflow_engine, "_execute_task", side_effect=fake_execute_task), \
+         patch.object(workflow_engine, "_compute_governance_fields", side_effect=fake_compute_gov), \
+         patch.object(workflow_engine, "_write_runtime_lineage", side_effect=fake_write_lineage):
+        t0 = time.time()
+        result = workflow_engine.run_workflow_instance("i1", "w1")
+        elapsed = time.time() - t0
+
+    # 串行 = 3 * 0.3 = 0.9s；并行（A&B 同层）= 0.3 + 0.3 = 0.6s
+    assert elapsed < 0.8, f"parallel should be faster than serial 0.9s, got {elapsed:.2f}s"
+    assert result["status"] == "success"
+
+
+def test_run_workflow_layer_failure_propagates_to_later_layers():
+    """层内任一节点 failed → 后续层全 skipped，实例 failed。"""
+    nodes = [
+        _node("A", "t1", upstream="", order=0),  # 这层 fail
+        _node("B", "t2", upstream="", order=1),  # 这层 success
+        _node("C", "t3", upstream="A,B", order=2),  # 下层应被 skipped
+    ]
+
+    def fake_execute_task(task, artifact_dir, log_prefix="", instance_id=None):
+        if task["task_id"] == "t1":
+            return TaskRunResult(status="failed", exit_code=1, stdout_path="", stderr_path="",
+                                 error_message="boom", result_summary={})
+        time.sleep(0.05)
+        return TaskRunResult(status="success", exit_code=0, stdout_path="", stderr_path="",
+                             error_message=None, result_summary={})
+
+    instance_state = {"instance_id": "i1", "artifact_dir": "/tmp/x", "status": "queued"}
+
+    def update_instance(instance_id, **kwargs):
+        instance_state.update(kwargs)
+        return instance_state
+
+    skip_runs = []
+
+    def create_run(*args, **kwargs):
+        run = {"run_id": f"r{len(skip_runs)}", **kwargs}
+        skip_runs.append(run)
+        return run
+
+    with patch.object(workflow_engine.orch_db, "get_workflow", return_value={"workflow_id": "w1"}), \
+         patch.object(workflow_engine.orch_db, "list_nodes", return_value=nodes), \
+         patch.object(workflow_engine.orch_db, "get_instance", return_value=instance_state), \
+         patch.object(workflow_engine.orch_db, "update_instance", side_effect=update_instance), \
+         patch.object(workflow_engine.orch_db, "list_task_runs", return_value=[]), \
+         patch.object(workflow_engine.orch_db, "create_task_run", side_effect=create_run), \
+         patch.object(workflow_engine.orch_db, "update_task_run", return_value=None), \
+         patch.object(workflow_engine.orch_db, "get_task_run", return_value={"started_at": None}), \
+         patch.object(workflow_engine.orch_db, "get_task",
+                      side_effect=lambda tid: {"task_id": tid, "name": tid, "code": "",
+                                               "executor_type": "python", "params": {}}), \
+         patch.object(workflow_engine, "_execute_task", side_effect=fake_execute_task), \
+         patch.object(workflow_engine, "_compute_governance_fields", return_value={}), \
+         patch.object(workflow_engine, "_write_runtime_lineage"):
+        result = workflow_engine.run_workflow_instance("i1", "w1")
+
+    assert result["status"] == "failed"
+    assert "node A" in (result.get("error_message") or "") or "t1" in (result.get("error_message") or "")
+    # C 应被 skipped（通过 create_task_run 的 status=skipped 调用）
+    skipped_calls = [c for c in skip_runs if c.get("status") == "skipped"]
+    assert len(skipped_calls) >= 1, "later layer nodes must be marked skipped"
