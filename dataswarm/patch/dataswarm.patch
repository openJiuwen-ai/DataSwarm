+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""PostgreSQL DAO/API browsing against an existing dedicated fixture.
+
+Provide --pg-root and explicit POSTGRES_USER/POSTGRES_PASSWORD or --pg-config.
+An explicitly empty password is accepted. Missing configuration blocks before
+port probes or pg_ctl. A stopped dedicated instance is started and stopped by
+this invocation; an already running instance is left running. Fixture tables
+remain unchanged, and saved source/workspace metadata uses a temporary tree.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import ExitStack
+from datetime import datetime, timezone
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import tempfile
+from unittest.mock import patch
+from urllib.parse import parse_qs, quote, urlencode, urlparse
+
+ROOT = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(ROOT))
+OUTPUT = ROOT / "artifact" / "datasource-validation" / "logs"
+
+
+class Blocked(RuntimeError):
+    pass
+
+
+def credentials(config_path=None):
+    """Read only explicitly supplied credentials; an explicit empty password is valid."""
+    if config_path is not None:
+        try:
+            config = json.loads(config_path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            raise Blocked("--pg-config must be a readable JSON object with user and password strings") from None
+        if not isinstance(config, dict):
+            raise Blocked("--pg-config must contain user and password strings")
+        user, password = config.get("user"), config.get("password")
+    else:
+        user, password = os.environ.get("POSTGRES_USER"), os.environ.get("POSTGRES_PASSWORD")
+    if not isinstance(user, str) or not user.strip() or not isinstance(password, str):
+        raise Blocked("Set POSTGRES_USER and POSTGRES_PASSWORD explicitly, "
+                      "or provide --pg-config with user and password; password may be empty")
+    return user, password
+
+
+def redacted_error(error, password):
+    text = str(error)
+    return (text.replace(password, "[REDACTED]") if password else text)[:1500]
+
+
+def listening(port):
+    try:
+        with socket.create_connection(("127.0.0.1", port), timeout=1):
+            return True
+    except OSError:
+        return False
+
+
+def normalized(rows):
+    output = []
+    for row in rows:
+        values = []
+        for value in row:
+            try:
+                values.append(f"{float(value):.4f}")
+            except (TypeError, ValueError):
+                values.append(str(value))
+        output.append(values)
+    return output
+
+
+class Handler:
+    def __init__(self, workspace):
+        self.headers = {"X-Workspace-Id": workspace}
+        self.response = None
+
+    @staticmethod
+    def _query_arg(parsed, key):
+        return (parse_qs(parsed.query).get(key) or [""])[0]
+
+    def _write_json(self, status, body):
+        self.response = (status, body)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--pg-root", type=Path,
+                        help="Required existing dedicated root containing pgsql/bin/pg_ctl.exe and pgdata")
+    parser.add_argument("--pg-config", type=Path,
+                        help="Private JSON with user/password; "
+                             "otherwise both POSTGRES_USER and POSTGRES_PASSWORD must be set")
+    parser.add_argument("--port", type=int, default=55432)
+    parser.add_argument("--output", type=Path, default=OUTPUT / "local-closeout-20261025-postgres-browsing-result.json")
+    args = parser.parse_args(argv)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    records = []
+    report = {"started_at_utc": datetime.now(timezone.utc).isoformat(), "checks": records,
+              "started_postgres": False, "owned_postgres_stopped": False,
+              "boundaries": ["Existing dedicated local PostgreSQL fixture; password rejection is not covered.",
+                             ("Real API/controller/service dispatch; "
+                              "browser and network HTTP transport are not exercised."),
+                             "The last preview page is the 10000-row browsing window, not the full 50000-row table."]}
+    password = ""
+
+    def check(name, fn):
+        try:
+            detail = fn()
+            records.append({"gate": name, "status": "passed", "detail": detail})
+            print(f"[OK] {name}: {detail}", flush=True)
+        except Exception as exc:
+            detail = redacted_error(exc, password)
+            records.append({"gate": name, "status": "failed", "error_type": type(exc).__name__, "detail": detail})
+            print(f"[FAIL] {name}: {type(exc).__name__}: {detail}", flush=True)
+
+    def control(*arguments):
+        return subprocess.run([str(pg_ctl), "-D", str(data), *arguments],
+                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=40,
+                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+
+    try:
+        if args.pg_root is None:
+            raise Blocked("Provide --pg-root for an existing dedicated PostgreSQL acceptance instance")
+        user, password = credentials(args.pg_config)
+        pg_ctl = args.pg_root / "pgsql" / "bin" / "pg_ctl.exe"
+        data = args.pg_root / "pgdata"
+        if not pg_ctl.is_file() or not (data / "PG_VERSION").is_file():
+            raise Blocked("Existing dedicated pg_ctl and initialized data directory are required")
+        if control("status").returncode != 0:
