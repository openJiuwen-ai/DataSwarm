+  node_name: string | null;
+  upstream_nodes: string;
+  wait_review: number; // 0 | 1
+  order_index: number;
+  created_at: string;
+}
+
+export type RefType = 'task' | 'workflow';
+export type TriggerType = 'debug' | 'schedule' | 'once' | 'manual';
+export type InstanceStatus =
+  'queued' | 'running' | 'success' | 'failed' | 'cancelled' | 'paused' | 'waiting_review' | 'skipped';
+export type RunStatus =
+  'queued' | 'running' | 'success' | 'failed' | 'timeout' | 'cancelled' | 'waiting_review' | 'skipped';
+
+export interface Instance {
+  instance_id: string;
+  ref_type: RefType;
+  ref_id: string;
+  ref_name?: string | null;
+  trigger_type: TriggerType;
+  status: InstanceStatus;
+  started_at: string | null;
+  finished_at: string | null;
+  artifact_dir: string | null;
+  error_message: string | null;
