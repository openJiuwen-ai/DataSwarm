+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/context.py —— 候选召回、多路合并与 LLM 输入目录（方案 §阶段 5.1）。
+
+LLM **只输出结构化 QuerySpec**；本模块负责在进 prompt 之前把候选目录收窄——
+**绝不把全量指标塞进 prompt**。
+
+召回通道与打分（增补设计 D3/D9，深集成后数据面全部换元数据库 + semantic 快照）：
+
+    score = 0.40 * lexical + 0.20 * graph + 0.25 * schema + 0.15 * verified
+
+- **词法**（``store.search_defs``）：name > metric_key > 同义词，上限 20
+- **术语同义扩展**（一期）：问题先经 glossary 三级召回识别业务术语，
+  命中术语的规范名/别名作为**扩展检索词**注入词法/图/schema 三通道——
+  「平台成交规模怎么样」经术语「商品交易总额(GMV)」桥接到指标。纯查询
+  改写，不新增打分通道，D9 权重与 0.60 阈值口径不变
+- **术语口径注入**（二期增量）：命中术语的 definition 不再止步于扩展词，
+  :func:`glossary_terms_prompt` 渲染成口径段进 intent 与兜底 generator 的
+  prompt（选指标/写 SQL 都对齐口径）；向量/LIKE **同分**命中多个术语时
+  标注口径歧义（``ambiguous``），交 intent LLM 结合语境确认而非静默任选
+  ——仍是纯上下文增强，非打分输入
+- **EMB**（:mod:`.embedding`）：平台 embed 客户端；按 scope 缓存向量，
+  **与词法取 max 后并入 lexical 通道**（§6），故 D9 权重不因 EMB 变化
+- **图**（``semantic_link.metric_table_scores``）：published 修订的确定性
+  分词打分（替代旧 SPARQL 图检索，刻度对齐 ``transport._MATCH_SCORES``）
+- **schema**（S 入口，``semantic_link.schema_recall``）：语义层快照词法 +
+  FAISS 召回合并，再经绑定反查传导给指标（纯表计算，不读图）
+- **verified**（``dw_metric_verified_sql`` 命中）：布尔
+- 合并后过滤：archived / 无 published 修订的候选剔除，**剔除原因进 warnings**
+- **confidence < 0.60 → 不猜，返回澄清请求**
+
+无语义快照（源未采集）时 schema 通道权重并入词法路并记 ``semantic_not_collected``
+——权重重分配只影响刻度不影响排序（严格单一通道：未采集即降级，不回退直查）。
+EMB 未配置时记 ``emb_unavailable`` 并只跑词法/图（D3 降级纪律）。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Sequence
+
+from . import embedding, semantic_link, store
+from .model import MetricDef, MetricRevision, REVISION_PUBLISHED
+from .semantic_link import SchemaHit
+
+# 三路召回上限（方案 §阶段 5.1：20 / 10 / 5）+ schema 入口上限（增补设计 D8）
+LEXICAL_LIMIT = 20
+GRAPH_LIMIT = 10
+SCHEMA_LIMIT = 10
+ENRICH_LIMIT = 5
+
+# 合并权重（增补设计 D9）：schema 独立成通道（它是独立数据面）
+W_LEXICAL, W_GRAPH, W_SCHEMA, W_VERIFIED = 0.40, 0.20, 0.25, 0.15
+W_LEXICAL_NO_SCHEMA = W_LEXICAL + W_SCHEMA  # 语义快照缺席时 schema 路权重并入词法路
+CLARIFY_THRESHOLD = 0.60
+
+
+@dataclass(frozen=True)
+class CatalogEntry:
+    """进 prompt 的单个候选指标。
+
+    ``score`` 是 D9 加权和（用于排序）；``confidence`` 是有信号通道的加权均值
+    （用于 0.60 澄清阈值）——两者分离的原因见 build_catalog 注释。
+    ``channels`` 是各通道**原始分**（词法/EMB/图/schema 传导/verified），
+    供召回明细展示与测试观测：score/confidence 怎么来的可完整还原。
+    """
+
+    metric_key: str
+    display_name: str
+    description: str = ""
+    unit: str = ""
+    metric_type: str = "atomic"
+    allowed_dimensions: tuple[str, ...] = ()
+    time_dimension: str = ""
+    time_grains: tuple[str, ...] = ()
+    synonyms: tuple[str, ...] = ()
+    score: float = 0.0
+    confidence: float = 0.0
+    channels: tuple[tuple[str, float], ...] = ()
+    matched_on: tuple[str, ...] = ()
+    emb_via: str = ""
+    revision_id: str = ""
+
+
+@dataclass(frozen=True)
+class Catalog:
+    """收窄后的候选目录（含 S 入口命中面，供 R2/R3 路由）。"""
+
+    entries: tuple[CatalogEntry, ...] = field(default_factory=tuple)
+    warnings: tuple[str, ...] = field(default_factory=tuple)
+    needs_clarification: bool = False
+    clarification: str = ""
+    schema_hits: tuple[SchemaHit, ...] = field(default_factory=tuple)
+    schema_confidence: float = 0.0
+    schema_snapshot_id: str | None = None
+    semantic_refs: tuple[tuple[str, str], ...] = field(default_factory=tuple)
+    query_vectors: tuple[str, ...] = field(default_factory=tuple)
+    # 问题命中的业务术语：[{term_id, name, definition, score, match_type,
+    # ambiguous?}]（同分组带 ambiguous=True）。进 glossary_terms_prompt 渲染
+    # 成 intent/兜底 prompt 的口径段，同时是召回观测面——仍是纯上下文，
+    # 非打分输入
+    glossary_terms: tuple[dict[str, Any], ...] = field(default_factory=tuple)
+
+    @property
+    def keys(self) -> frozenset[str]:
+        """目录内全部 metric_key（LLM 只能从这里选）。"""
+        return frozenset(e.metric_key for e in self.entries)
+
+
+def build_catalog(
+    question: str,
+    workspace_id: str,
+    *,
+    release_id: str | None = None,
+) -> Catalog:
+    """三路召回 + 合并打分 + 过滤，产出收窄目录。
+
+    Args:
+        question: 自然语言问题。
+        workspace_id: 工作空间。
+        release_id: 召回限定 release；None 搜该 workspace 全部 published 修订。
+
+    Returns:
+        :class:`Catalog`。``needs_clarification=True`` 时调用方应向用户澄清，
+        **不得猜测**。
+    """
+    warnings: list[str] = []
+    # 术语同义扩展先于一切召回通道（一期接线）：问题先过 glossary 三级召回，
+    # 命中术语的规范名/别名变成扩展词。纯查询改写——扩展词只进词法/图/schema
+    # 三通道的检索文本，不改权重、不加打分通道，D9 与 0.60 阈值口径不变。
+    glossary_terms, glossary_words = _glossary_expand(question, warnings)
+    lexical = {d.metric_key: (s, m) for d, s, m in
+               store.search_defs(workspace_id, question, limit=LEXICAL_LIMIT)}
+    release = store.get_release(release_id) if release_id else None
+    if glossary_words:
+        # 词法通道二次查询：扩展词拼成新查询再搜一遍，同指标取 max——
+        # 「平台成交规模」原词法不中 GMV 指标，扩展出「商品交易总额 GMV」后中
+        expanded_query = " ".join(glossary_words)
+        for metric, score, via in store.search_defs(
+                workspace_id, expanded_query, limit=LEXICAL_LIMIT):
+            prev = lexical.get(metric.metric_key)
+            if prev is None or score > prev[0]:
+                # via 前缀 glossary: 标记「这一票是术语桥接投的」
+                lexical[metric.metric_key] = (score, f"glossary:{via}" if via else "glossary_term")
+
+    # 图通道：published 修订表打分（常态可用——数据面是元数据库）
+    graph: dict[str, tuple[float, list[str]]] = {}
+    try:
+        graph = semantic_link.metric_table_scores(
+            workspace_id, question, release=release,
+            extra_terms=glossary_words)
+        graph = dict(sorted(graph.items(), key=lambda kv: (-kv[1][0], kv[0]))[:GRAPH_LIMIT])
+    except Exception as exc:  # noqa: BLE001 —— 图路失败降级，不阻断召回
+        warnings.append(f"graph_recall_failed:{type(exc).__name__}")
+
+    # schema 通道（S 入口）：语义层快照词法 + FAISS（增补设计 §6、D8）
+    schema_hits: list[SchemaHit] = []
+    schema_confidence = 0.0
+    refs, snapshots = semantic_link.current_snapshots(warnings)
+    if refs:
+        try:
+            schema_hits, schema_confidence = semantic_link.schema_recall(
+                workspace_id, question, snapshots, warnings=warnings,
+                extra_terms=glossary_words)
+        except Exception as exc:  # noqa: BLE001 —— schema 路失败不阻断
+            warnings.append(f"schema_recall_failed:{type(exc).__name__}")
+    else:
+        warnings.append("semantic_not_collected")
+
+    # EMB 通道（D3）：整句+短语一次批量嵌入；与词法取 max 并入（schema 侧
+    # EMB 已在 schema_recall 内经语义层 FAISS 完成，这里只跑 metric scope）
+    emb_metrics, query_texts = _emb_metric_scores(
+        workspace_id, question, release_id=release_id, warnings=warnings)
+
+    # S→M 传导：schema 命中经绑定反查传给指标（R2 的分数来源，纯表计算）
+    propagated: dict[str, float] = {}
+    if release is not None and schema_hits:
+        try:
+            propagated = semantic_link.propagate_to_metrics(
+                workspace_id, release, snapshots, schema_hits)
+        except Exception as exc:  # noqa: BLE001
+            warnings.append(f"schema_propagation_failed:{type(exc).__name__}")
+
+    candidate_keys = set(lexical) | set(graph) | set(propagated) | set(emb_metrics)
+    if not candidate_keys and not schema_hits:
+        # warnings 必须带出去：零召回时「哪条通道缺席/失败」正是唯一诊断线索
+        return _clarify(question, "没有召回任何候选指标或 schema 对象——"
+                                  "请确认指标已定义并发布，或换用表/列名描述",
+                        tuple(warnings), query_texts)
+
+    # 过滤：archived / 无 published 修订
+    usable: dict[str, tuple[MetricDef, MetricRevision]] = {}
+    for metric in store.list_defs(workspace_id):
+        if metric.metric_key not in candidate_keys:
+            continue
+        if metric.status == "archived":
+            warnings.append(f"dropped_archived:{metric.metric_key}")
+            continue
+        revision = _published_revision(metric)
+        if revision is None:
+            warnings.append(f"dropped_not_published:{metric.metric_key}")
+            continue
+        usable[metric.metric_key] = (metric, revision)
+
+    # R3：指标侧无可用候选但 schema 强命中 → 不澄清，把子图交给路由层
+    if not usable:
+        if schema_confidence >= CLARIFY_THRESHOLD:
+            return Catalog(warnings=tuple(warnings), schema_hits=tuple(schema_hits),
+                           schema_confidence=schema_confidence,
+                           schema_snapshot_id=refs[0].snapshot_id if refs else None,
+                           semantic_refs=tuple((r.source_id, r.snapshot_id) for r in refs),
+                           query_vectors=query_texts,
+                           glossary_terms=tuple(glossary_terms))
+        return _clarify(question, "候选指标均未发布且 schema 召回置信度不足",
+                        tuple(warnings), query_texts)
+
+    verified = _verified_flag(workspace_id, list(usable))
+    schema_available = bool(refs)
+    entries: list[CatalogEntry] = []
+    for key, (metric, revision) in usable.items():
+        lex_score, lex_matched = lexical.get(key, (0.0, ""))
+        graph_score, matched = graph.get(key, (0.0, []))
+        schema_score = propagated.get(key, 0.0)
+        emb_score, emb_via = emb_metrics.get(key, (0.0, ""))
+        verified_flag = key in verified
+        # 词法 + EMB 取 max（增补设计 §6）：EMB 不新增权重通道，只把「字面不像
+        # 但语义像」的候选顶上来，D9 权重与阈值口径因此保持不变
+        lexical_channel = max(lex_score, emb_score)
+        if schema_available:
+            channels = [(W_LEXICAL, lexical_channel), (W_GRAPH, graph_score),
+                        (W_SCHEMA, schema_score),
+                        (W_VERIFIED, 1.0 if verified_flag else 0.0)]
+        else:
+            # schema 通道缺席（无语义快照）：权重并入词法（D3 降级纪律）
+            channels = [(W_LEXICAL_NO_SCHEMA, lexical_channel),
+                        (W_GRAPH, graph_score),
+                        (W_VERIFIED, 1.0 if verified_flag else 0.0)]
+        score = sum(w * x for w, x in channels)
+        # 置信度 = 有信号通道的加权均值。D9 权重用于**排序**；阈值判定若直接用
+        # 加权和，纯指标词汇的强命中（无 schema/verified 信号）会被 0.25+0.15 的
+        # 空缺压到阈值下误澄清——归一化到「实际发声的通道」才公平。
+        active_weight = sum(w for w, x in channels if x > 0)
+        confidence = (sum(w * x for w, x in channels if x > 0) / active_weight
+                      if active_weight else 0.0)
+        matched_on = [m for m in (lex_matched, *matched) if m]
+        if schema_score:
+            matched_on.append("schema_link")
+        if emb_score:
+            matched_on.append("emb")
+        entries.append(CatalogEntry(
+            metric_key=key,
+            display_name=revision.display_name or metric.name,
+            description=metric.description or "",
+            unit=revision.unit,
+            metric_type=revision.metric_type,
+            allowed_dimensions=tuple(revision.allowed_dimensions),
+            time_dimension=revision.time_dimension,
+            time_grains=tuple(revision.time_grains),
+            synonyms=tuple(revision.synonyms),
+            score=round(score, 4),
+            confidence=round(confidence, 4),
+            channels=(("lexical", round(lex_score, 4)), ("emb", round(emb_score, 4)),
+                      ("graph", round(graph_score, 4)), ("schema", round(schema_score, 4)),
+                      ("verified", 1.0 if verified_flag else 0.0)),
+            matched_on=tuple(dict.fromkeys(matched_on)),
+            emb_via=emb_via,
+            revision_id=revision.revision_id,
+        ))
+    entries.sort(key=lambda e: (-e.score, -e.confidence, e.metric_key))
+
+    if entries[0].confidence < CLARIFY_THRESHOLD and schema_confidence < CLARIFY_THRESHOLD:
+        top = ", ".join(f"{e.metric_key}({e.confidence:.2f})" for e in entries[:3])
+        reason = (f"候选置信度不足（最高 {top}，阈值 {CLARIFY_THRESHOLD}）——"
+                  "请补充指标名称、时间范围或分析维度")
+        # 同分歧义（口径增强 C）：置信度不足又逢术语口径歧义时把候选口径点名进
+        # 澄清——这是 intent LLM 之前唯一的澄清出口，不点名用户只能看到泛泛的
+        # 置信度话术，无从回答「指的是哪个口径」
+        ambiguous = [t for t in glossary_terms if t.get("ambiguous")]
+        if ambiguous:
+            calibers = " / ".join(str(t["name"]) for t in ambiguous)
+            reason += f"；问题表述同分命中多个术语口径（{calibers}），请指明口径"
+        return _clarify(question, reason, tuple(warnings), query_texts)
+    return Catalog(entries=tuple(entries), warnings=tuple(warnings),
+                   schema_hits=tuple(schema_hits), schema_confidence=schema_confidence,
+                   schema_snapshot_id=refs[0].snapshot_id if refs else None,
+                   semantic_refs=tuple((r.source_id, r.snapshot_id) for r in refs),
+                   query_vectors=query_texts,
+                   glossary_terms=tuple(glossary_terms))
+
+
+def _clarify(question: str, reason: str, warnings: tuple[str, ...],
+             query_vectors: tuple[str, ...] = ()) -> Catalog:
+    """构造澄清请求目录。"""
+    return Catalog(warnings=warnings, needs_clarification=True,
+                   clarification=f"[{reason}] 问题: {question}",
+                   query_vectors=query_vectors)
+
+
+# 术语扩展门槛：与 CLARIFY_THRESHOLD 同刻度——弱命中的术语不扩展（LIKE 泛匹配
+# 的 definition 档只有 0.25，注入它等于往词法通道倒噪声词稀释真命中）
+GLOSSARY_EXPAND_MIN_SCORE = 0.60
+GLOSSARY_EXPAND_LIMIT = 3
+GLOSSARY_EXPAND_WORD_CAP = 5
+
+
+def _glossary_expand(
+    question: str, warnings: list[str]
+) -> tuple[list[dict[str, Any]], list[str]]:
+    """术语库识别 → 扩展检索词 + 口径上下文（一期扩展；查询改写，非打分通道）。
+
+    问题经 glossary 三级召回（精确别名/向量/LIKE）识别业务术语，命中术语的
+    规范名与别名作为扩展词返回，由调用方注入词法/图/schema 三通道的检索
+    文本。「平台成交规模怎么样」经术语「商品交易总额(GMV)」桥接到指标——
+    口语词与指标词法面从此不必逐字重合。
+
+    术语的 definition 随命中列表一并返回（口径增强 A/B 的数据源），同分
+    歧义由 :func:`_mark_tied_ambiguity` 标注（C）——检索桥接与口径注入
+    同源，LLM 拿到的口径与桥接依据不会两套账。
+
+    Args:
+        question: 自然语言问题。
+        warnings: 警告收集列表（原地 append）。
+
+    Returns:
+        ``(命中术语列表, 扩展词列表)``。术语库不可用（未建表/服务异常）
+        时返回双空并记 ``glossary_unavailable:*``——术语通道是增益不是依赖，
+        失败只降级为「无扩展」，绝不阻断主召回。
+    """
+    try:
+        from ..glossary import recall as glossary_recall
+
+        resolved = glossary_recall.resolve(question, limit=GLOSSARY_EXPAND_LIMIT)
+    except Exception as exc:  # noqa: BLE001 —— 术语通道失败降级为无扩展
+        warnings.append(f"glossary_unavailable:{type(exc).__name__}")
+        return [], []
+    terms: list[dict[str, Any]] = []
+    words: list[str] = []
+    lowered = question.lower()
+    for match in resolved.get("matches") or ():
+        score = float(match.get("score") or 0.0)
+        if score < GLOSSARY_EXPAND_MIN_SCORE:
+            continue
+        term = match.get("term") or {}
+        name = str(term.get("name") or "").strip()
+        if not name:
+            continue
+        terms.append({
+            "term_id": str(term.get("term_id") or ""),
+            "name": name,
+            "definition": str(term.get("definition") or "").strip(),
+            "score": round(score, 4),
+            "match_type": str(match.get("match_type") or ""),
+        })
+        # 扩展词 = 规范名 + 别名；已是问题子串的词不注入（重查也不会新增命中）
+        for word in (name, *(str(s) for s in term.get("synonyms_list") or ())):
+            word = word.strip()
+            if not word or word.lower() in lowered or word in words:
+                continue
+            words.append(word)
+    _mark_tied_ambiguity(terms)
+    return terms, words[:GLOSSARY_EXPAND_WORD_CAP]
+
+
+def _mark_tied_ambiguity(terms: list[dict[str, Any]]) -> None:
+    """同分歧义标注（口径增强 C）：头部同分且均非精确别名的术语标 ``ambiguous``。
+
+    设计 §6.2「≥2 同分候选返回列表让上层按语境确认口径」的接线形态：向量/
+    LIKE 同分意味着**同一句话模糊命中多个口径**（「销售额」→ 含税/不含税），
+    术语库自身无法确定性裁决。标注后由 :func:`glossary_terms_prompt` 给
+    intent LLM 口径确认指令。扩展词照常注入两侧——只桥接一侧等于白标注
+    歧义，intent LLM 必须两个口径的候选都看得到才有得选。
+
+    精确别名（``match_type=alias``）同分**不算**歧义：别名命中的前提是问题
+    原文包含该别名，双别名同分 = 用户同时点名两个术语，是明确意图而非歧义。
+    """
+    if len(terms) < 2:
+        return
+    # matches 经 recall._fuse 按分降序排好，terms 过滤后保序，terms[0] 即头部
+    top = terms[0]["score"]
+    tied = [t for t in terms if t["score"] == top]
+    if len(tied) >= 2 and all(t["match_type"] != "alias" for t in tied):
+        for term in tied:
+            term["ambiguous"] = True
+
+
+def _emb_metric_scores(
+    workspace_id: str, question: str, *, release_id: str | None,
+    warnings: list[str],
+) -> tuple[dict[str, tuple[float, str]], tuple[str, ...]]:
+    """EMB 通道（D3）：一次批量嵌入（整句 + jieba 语义短语），metric scope。
+
+    多向量查询抗稀释：整句向量被日期/维度词摊薄时（实测「客单价」0.53 →
+    长问句 0.12），短语向量在 rank 的逐文档取 max 里把分数顶回来。
+
+    Returns:
+        ``(指标分, 查询向量组)``。指标分为 ``metric_key -> (校准分, 胜出
+        查询向量原文)``（floor 以下已丢弃）；通道不可用时返回空并记
+        ``emb_unavailable``——绝不把「EMB 没跑」当成「没有相似项」。
+    """
+    if not embedding.emb_available():
+        _warn(warnings, embedding.WARN_UNAVAILABLE)
+        return {}, ()
+    outcome = embedding.query_vectors(question)
+    if not outcome.ok:
+        _warn(warnings, outcome.error or embedding.WARN_UNAVAILABLE)
+        return {}, ()
+    index = embedding.load_or_build(
+        workspace_id=workspace_id, scope_id=f"metric-{release_id or 'head'}",
+        docs=embedding.metric_docs(workspace_id), warnings=warnings)
+    if index is None:
+        return {}, tuple(outcome.texts)
+    ranked = embedding.rank(index, outcome.vectors)
+    texts = outcome.texts
+    scores = {key: (score, texts[idx] if idx < len(texts) else "")
+              for key, score, idx in ranked}
+    return scores, tuple(outcome.texts)
+
+
+def _warn(warnings: list[str], code: str) -> None:
+    """去重后追加一条警告。"""
+    if code and code not in warnings:
+        warnings.append(code)
+
+
+def _published_revision(metric: MetricDef) -> MetricRevision | None:
+    """取指标当前修订，仅当状态为 published 才算可用候选。"""
+    if not metric.current_revision_id:
+        return None
+    revision = store.get_revision(metric.current_revision_id)
+    if revision is None or revision.status != REVISION_PUBLISHED:
+        return None
+    return revision
+
+
+def _verified_flag(workspace_id: str, metric_keys: list[str]) -> set[str]:
+    """有已确认 SQL 覆盖的 metric_key 集合（第三路布尔信号）。"""
+    try:
+        return {k for k in metric_keys if store.has_verified_sql_for(workspace_id, [k])}
+    except Exception:  # noqa: BLE001 —— verified 池查询失败不阻断召回
+        return set()
+
+
+# 术语口径段的 definition 截断：db 层上限 4000 字符，prompt 里 200 字足够
+# 对齐口径（口径关键在「算什么/排除什么」，不在全文）
+GLOSSARY_DEF_PROMPT_CAP = 200
+
+
+def glossary_terms_prompt(terms: Sequence[Mapping[str, Any]],
+                          *, with_ambiguity: bool = True) -> str:
+    """命中术语 → prompt 口径段（口径增强 A/B 共用渲染；无可用术语返回空串）。
+
+    intent 用完整形态（含 ``[口径歧义]`` 标注与确认指令）；兜底 generator 用
+    ``with_ambiguity=False``——兜底时 intent 已选定 metric_key，口径歧义已被
+    裁决，残留的歧义标记只会误导 SQL 生成，只留口径参考。
+
+    Args:
+        terms: ``Catalog.glossary_terms``（或同构 dict 序列）。
+        with_ambiguity: 是否渲染歧义标注与确认指令。
+
+    Returns:
+        prompt 段落；无可用术语时空串（调用方据此跳过段落）。
+    """
+    usable = [t for t in terms if str(t.get("name") or "").strip()]
+    if not usable:
+        return ""
+    lines: list[str] = []
+    for term in usable:
+        definition = str(term.get("definition") or "").strip()
+        if len(definition) > GLOSSARY_DEF_PROMPT_CAP:
+            definition = definition[:GLOSSARY_DEF_PROMPT_CAP] + "…"
+        flag = "[口径歧义] " if with_ambiguity and term.get("ambiguous") else ""
+        lines.append(f"- {flag}{term['name']}：{definition or '（术语库未提供定义）'}")
+    section = ("问题中识别到的业务术语（口径参考，不是候选指标，"
+               "不能当作 metric_key 使用）：\n" + "\n".join(lines))
+    if with_ambiguity and any(term.get("ambiguous") for term in usable):
+        section += ("\n注意：标「口径歧义」的术语在术语库同分命中，无法确定性判断"
+                    "用户指的是哪个口径——请结合问题语境与上述定义判断指向；"
+                    "无法确定时不要猜，把候选口径写进 clarifications 向用户确认。")
+    return section
+
+
+def catalog_to_prompt_json(catalog: Catalog, *, limit: int = ENRICH_LIMIT) -> str:
+    """目录 → 进 prompt 的紧凑 JSON（只带前 ``limit`` 个，且只带 LLM 需要的字段）。"""
+    import json
+
+    payload = [
+        {
+            "metric_key": e.metric_key,
+            "name": e.display_name,
+            "description": e.description,
+            "unit": e.unit,
+            "allowed_dimensions": list(e.allowed_dimensions),
+            "time_dimension": e.time_dimension,
+            "time_grains": list(e.time_grains),
+            "synonyms": list(e.synonyms[:3]),
+        }
+        for e in catalog.entries[:limit]
+    ]
+    return json.dumps(payload, ensure_ascii=False)
+
+
+def schema_slice_of(revisions: list[MetricRevision],
+                    bindings_by_revision: dict[str, Any]) -> dict[str, Any]:
+    """给兜底生成器的真实表列切片（只含绑定声明的对象）。"""
+    tables: dict[str, list[str]] = {}
+    for rev in revisions:
+        for binding in bindings_by_revision.get(rev.revision_id, ()):
+            if binding.source_table:
+                cols = tables.setdefault(binding.source_table.split(".")[-1], [])
+                for logical, physical in binding.column_map.items():
+                    name = physical.split(".")[-1]
+                    if name not in cols:
+                        cols.append(name)
+    return {"tables": tables}
