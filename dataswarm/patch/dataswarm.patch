+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""多工作空间编排隔离单测（docs/archive/delivered/multi-workspace-datasource-plan.md P1-6）。
+
+双工作空间（各自独立 sqlite 元数据库）下：
+- 任务创建互不可见（决策一：元数据库物理隔离）
+- _connect / init_db 按 set_current 的工作空间路由
+- bootstrap 逐工作空间 ensure + 孤儿回扫
+"""
+from __future__ import annotations
+
+import textwrap
+
+import pytest
+
+from jiuwenswarm.common import workspace_context as wc
+from jiuwenswarm.common import workspace_store as _ws
+from jiuwenswarm.channels.web.orchestration import db as orch_db
+
+
+@pytest.fixture()
+def two_workspace_env(monkeypatch, tmp_path):
+    """顶层默认工作空间 + 两个具名工作空间，各自独立 sqlite 元库。
+
+    顶层 metadata_db 指向 decoy 库（不预创建）：复现「新加工作空间元库 ≠
+    顶层默认元库」的真实配置形态；JIUWENSWARM_ORCH_DB 清空防串。
+    """
+    ecom_meta = tmp_path / "meta_ecommerce.db"
+    bank_meta = tmp_path / "meta_bank.db"
+    default_meta = tmp_path / "meta_default.db"
+    ecom_biz = tmp_path / "ecommerce.db"
+    bank_biz = tmp_path / "bank.db"
+    for p in (ecom_meta, bank_meta, ecom_biz, bank_biz):
+        p.write_text("", encoding="utf-8")
+    cfg = tmp_path / "datasource.yaml"
+    cfg.write_text(textwrap.dedent(f"""
+        default_db: sqlite://{ecom_biz}
+        metadata_db: sqlite://{default_meta}
+        workspaces:
+          ecommerce:
+            name: 电商数仓
+            default_db: sqlite://{ecom_biz}
+            metadata_db: sqlite://{ecom_meta}
+          bank:
+            name: 银行数仓
+            default_db: sqlite://{bank_biz}
+            metadata_db: sqlite://{bank_meta}
+    """), encoding="utf-8")
+    monkeypatch.setattr(wc, "_config_path", lambda: cfg)
+    # custom 工作空间注册表也指向 tmp：不读开发者机器的真实 ~/.jiuwenswarm/
+    monkeypatch.setattr(_ws, "_config_dir", lambda: tmp_path)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
+    # 同进程前序用例可能遗留会话工作空间 env（会让「缺上下文」用例拿到上下文）
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+    # 模块级 legacy 常量在 import 时已按真实机器 config 定型；指向独立 decoy，
+    # 保证「顶层默认元库 ≠ 工作空间元库」在本测试内确定成立（回归前提）。
+    monkeypatch.setattr(orch_db, "META_DB_REF", f"sqlite://{default_meta}")
+    monkeypatch.setattr(orch_db, "_is_sqlite", True)
+    monkeypatch.setattr(orch_db, "WAREHOUSE_DB", default_meta)
+    monkeypatch.setattr(orch_db, "BASELINE_DB", tmp_path / "meta_default_baseline.db")
+    # artifact 根也按 tmp 隔离
+    monkeypatch.setattr(orch_db, "ARTIFACT_ROOT", tmp_path / "artifact" / "orchestration")
+    return {"ecommerce": ecom_meta, "bank": bank_meta, "default": default_meta}
+
+
+def _task_row(name: str) -> dict:
+    return {"name": name, "executor_type": "sql", "code": "SELECT 1"}
+
+
+def test_instance_status_counts_are_isolated_per_workspace(two_workspace_env):
+    for workspace, status in [("ecommerce", "success"), ("bank", "failed")]:
+        token = wc.set_current(workspace)
+        try:
+            orch_db.init_db()
+            orch_db.create_instance("workflow", "same-workflow-id", "debug", status)
+        finally:
+            wc.reset(token)
+    for workspace, status in [("ecommerce", "success"), ("bank", "failed")]:
+        token = wc.set_current(workspace)
+        try:
+            assert orch_db.count_instances_by_status(
+                ref_type="workflow", ref_id="same-workflow-id") == {status: 1}
+        finally:
+            wc.reset(token)
+
+
+def test_tasks_are_physically_isolated_per_workspace(two_workspace_env):
+    """电商建的任务在银行工作空间不可见（决策一物理隔离）。"""
+    token = wc.set_current("ecommerce")
+    try:
+        orch_db.init_db()
+        created = orch_db.create_task(_task_row("电商任务A"))
+        assert created["task_id"]
+    finally:
+        wc.reset(token)
+
+    token = wc.set_current("bank")
+    try:
+        orch_db.init_db()
+        assert orch_db.list_tasks() == []  # 银行看不到电商任务
+        bank_task = orch_db.create_task(_task_row("银行任务B"))
+        assert bank_task["task_id"]
+    finally:
+        wc.reset(token)
+
+    token = wc.set_current("ecommerce")
+    try:
+        names = {t["name"] for t in orch_db.list_tasks()}
+        assert names == {"电商任务A"}  # 切回电商：银行任务不串入
+    finally:
+        wc.reset(token)
+
+
+def test_multi_workspace_without_context_fails_loudly(two_workspace_env):
+    """多工作空间缺上下文 → WORKSPACE_CONTEXT_REQUIRED（决策八-1）。"""
+    with pytest.raises(wc.WorkspaceContextRequired):
+        orch_db._connect(None)
+
+
+def test_init_db_ensures_workspace_meta_not_default(two_workspace_env):
+    """回归：工作空间 sqlite 元库 ≠ 顶层默认元库时，ensure 必须落在工作空间自己的元库。
+
+    事故形态：init_db 在工作空间上下文下错误回退模块级 WAREHOUSE_DB（顶层默认
+    元库路径），导致新工作空间启动后 meta 表永远建不出来——表全建到默认库去了。
+    """
+    import sqlite3
+
+    token = wc.set_current("bank")
+    try:
+        orch_db.init_db()
+    finally:
+        wc.reset(token)
+
+    def _tables(path):
+        con = sqlite3.connect(path)
+        try:
+            return {r[0] for r in con.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'")}
+        finally:
+            con.close()
+
+    # 表必须建在 bank 工作空间自己的元库
+    assert "dw_tasks" in _tables(two_workspace_env["bank"])
+    # 顶层默认元库（decoy）不允许被 bank 工作空间的 init 误建/误写
+    assert not two_workspace_env["default"].exists()
+
+
+def test_duplicate_metadata_ref_blocks_bootstrap(two_workspace_env):
+    """重复 metadata_db_ref 启动校验：list_workspaces 抛 DuplicateMetadataRef（9.5）。"""
+    from jiuwenswarm.channels.web.orchestration import bootstrap
+
+    assert bootstrap.start.__doc__ is None  # start 是函数（占位断言防误改签名）
+    # 直接测配置解析层：同元库两个 workspace 必须拒绝
+    wc._config_path().write_text(textwrap.dedent("""
+        workspaces:
+          a:
+            default_db: sqlite:///a.db
+            metadata_db: sqlite:///same_meta.db
+          b:
+            default_db: sqlite:///b.db
+            metadata_db: sqlite:///same_meta.db
+    """), encoding="utf-8")
+    with pytest.raises(wc.DuplicateMetadataRef):
+        wc.list_workspaces()
+
+
+# --------------------------------------------------------------------------
+# 工作空间与数据源解耦：未绑定业务库的工作空间大声失败
+# --------------------------------------------------------------------------
+@pytest.fixture()
+def unbound_workspace_env(monkeypatch, tmp_path):
+    """default（有业务库）+ 一个未绑定业务库的 UI 工作空间（workspace_store 注册）。"""
+    import sqlite3
+
+    from jiuwenswarm.common import workspace_store
+
+    default_meta = tmp_path / "meta_default.db"
+    default_biz = tmp_path / "default_biz.db"
+    unbound_meta = tmp_path / "meta_unbound.db"
+    for p in (default_meta, default_biz, unbound_meta):
+        p.write_text("", encoding="utf-8")
+    cfg = tmp_path / "datasource.yaml"
+    cfg.write_text(textwrap.dedent(f"""
+        default_db: sqlite://{default_biz}
+        metadata_db: sqlite://{default_meta}
+    """), encoding="utf-8")
+    monkeypatch.setattr(wc, "_config_path", lambda: cfg)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
+    monkeypatch.delenv("JIUWENSWARM_WORKSPACE_ID", raising=False)
+
+    registry = tmp_path / "workspaces.db"
+    connection = sqlite3.connect(registry)
+    connection.execute(
+        "CREATE TABLE dw_workspaces ("
+        "workspace_id TEXT PRIMARY KEY, name TEXT NOT NULL, "
+        "business_db_ref TEXT NOT NULL, metadata_db_ref TEXT NOT NULL, "
+        "created_at TEXT NOT NULL)"
+    )
+    connection.execute(
+        "INSERT INTO dw_workspaces VALUES ('unbound_ws', '未绑定空间', ?, ?, '2026-09-15T00:00:00')",
+        ("", f"sqlite://{unbound_meta}"),
+    )
+    connection.commit()
+    connection.close()
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: registry)
+    return registry
+
+
+def test_unbound_workspace_create_task_fails_loudly(unbound_workspace_env):
+    """未绑定业务库的工作空间建任务：WORKSPACE_BUSINESS_NOT_BOUND，不落空 ref。"""
+    from jiuwenswarm.channels.web.dataagent.orchestration import service as orch_service
+
+    with pytest.raises(wc.WorkspaceBusinessNotBound):
+        orch_service.create_task(
+            {"name": "t", "executor_type": "sql", "code": "SELECT 1", "workspace_id": "unbound_ws"}
+        )
+
+
+def test_sql_executor_unbound_workspace_does_not_fall_back(unbound_workspace_env):
+    """sql_executor _resolve_db_ref：未绑定空间禁止回退全局 default_db（防串库）。"""
+    from jiuwenswarm.channels.web.orchestration.executors import sql_executor
+
+    token = wc.set_current("unbound_ws")
+    try:
+        with pytest.raises(ValueError, match="未绑定业务数据源"):
+            sql_executor._resolve_db_ref(None)
+    finally:
+        wc.reset(token)
+
+
+def test_sql_executor_bound_workspace_uses_business_ref(unbound_workspace_env):
+    """已绑定（default）工作空间：_resolve_db_ref 返回业务库 ref。"""
+    from jiuwenswarm.channels.web.orchestration.executors import sql_executor
+
+    token = wc.set_current("default")
+    try:
+        ref = sql_executor._resolve_db_ref(None)
+        assert ref and ref.startswith("sqlite://")
+        assert "default_biz" in ref
+    finally:
+        wc.reset(token)
