diff --git a/jiuwenswarm/channels/web/frontend/tests/chatNavigation.test.mjs b/jiuwenswarm/channels/web/frontend/tests/chatNavigation.test.mjs
new file mode 100644
index 000000000..ff9a9d519
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/chatNavigation.test.mjs
@@ -0,0 +1,159 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { JSDOM } from 'jsdom';
+
+const dom = new JSDOM('<div id="root"></div>', { url: 'http://localhost/chat/new' });
+Object.assign(globalThis, {
+  window: dom.window,
+  document: dom.window.document,
+  HTMLElement: dom.window.HTMLElement,
+  Event: dom.window.Event,
+  IS_REACT_ACT_ENVIRONMENT: true,
+});
+const { act, createElement } = await import('react');
+const { createRoot } = await import('react-dom/client');
+const { readChatRoute, useChatRoute } =
+  await import('../node_modules/.cache/chat-navigation/multi-session/routing/useChatRoute.js');
+const { isSessionNotFoundError } =
+  await import('../node_modules/.cache/chat-navigation/multi-session/state/sessionMetadataError.js');
+const { captureChatScrollPosition, restoreChatScrollPosition } =
+  await import('../node_modules/.cache/chat-navigation/components/ChatPanel/chatScrollPosition.js');
+
+const menus = [
+  '/governance/overview',
+  '/data-management/tables',
+  '/dataagent/development/workflow-mgmt',
+  '/dataagent/dashboard/dashboards',
+];
+
+async function withRoute(path, run) {
+  window.history.replaceState(null, '', path);
+  let navigation;
+  function Probe() {
+    navigation = useChatRoute();
+    return createElement('output', null, navigation.route.kind);
+  }
+  const root = createRoot(document.getElementById('root'));
+  await act(async () => root.render(createElement(Probe)));
+  try {
+    await run(() => navigation);
+  } finally {
+    await act(async () => root.unmount());
+  }
+}
+
+for (const menu of menus) {
+  test(`returning from ${menu} restores the existing session and notifies all route consumers`, async () => {
+    await withRoute('/chat/session-A', async (get) => {
+      await act(async () => {
+        window.history.pushState(null, '', menu);
+        window.dispatchEvent(new Event('jiuwen:routechange'));
+      });
+      assert.equal(get().route.kind, 'outside-chat');
+      let observedPath;
+      const observer = () => {
+        observedPath = window.location.pathname;
+      };
+      window.addEventListener('jiuwen:routechange', observer);
+      try {
+        await act(async () => get().navigate({ kind: 'chat-session', sessionId: 'session-A' }));
+        assert.deepEqual(get().route, { kind: 'chat-session', sessionId: 'session-A' });
+        assert.equal(observedPath, '/chat/session-A');
+        const historyLength = window.history.length;
+        await act(async () => get().navigate({ kind: 'chat-session', sessionId: 'session-A' }));
+        assert.equal(window.history.length, historyLength, 'repeated Work clicks must not add duplicate history');
+      } finally {
+        window.removeEventListener('jiuwen:routechange', observer);
+      }
+    });
+  });
+}
+
+test('direct business URLs stay outside chat; malformed and unknown URLs remain invalid', () => {
+  for (const menu of menus) assert.equal(readChatRoute(menu).kind, 'outside-chat');
+  assert.equal(readChatRoute('/chat/%E0%A4%A').kind, 'not-found');
+  assert.equal(readChatRoute('/unrecognized').kind, 'not-found');
+});
+
+test('popstate updates the route without writing another history entry', async () => {
+  await withRoute('/chat/session-A', async (get) => {
+    const historyLength = window.history.length;
+    await act(async () => {
+      window.history.replaceState(null, '', '/chat/session-B');
+      window.dispatchEvent(new Event('popstate'));
+    });
+    assert.deepEqual(get().route, { kind: 'chat-session', sessionId: 'session-B' });
+    assert.equal(window.history.length, historyLength);
+  });
+});
+
+test('returning to an unsent conversation uses the new route without creating a session id', async () => {
+  await withRoute('/data-management/tables', async (get) => {
+    await act(async () => get().navigate({ kind: 'chat-new' }));
+    assert.deepEqual(get().route, { kind: 'chat-new' });
+    assert.equal(window.location.pathname, '/chat/new');
+  });
+});
+
+test('only an explicit NOT_FOUND is a missing session', () => {
+  assert.equal(isSessionNotFoundError(Object.assign(new Error('missing'), { code: 'NOT_FOUND' })), true);
+  for (const code of ['REQUEST_TIMEOUT', 'WS_CLOSED', 'INTERNAL_ERROR', 'BAD_REQUEST', undefined]) {
+    assert.equal(isSessionNotFoundError(Object.assign(new Error('session not found'), { code })), false);
+  }
+  assert.equal(isSessionNotFoundError(null), false);
+});
+
+function scrollFixture() {
+  const container = document.createElement('div');
+  container.innerHTML = '<div data-testid="chat-panel-timeline"><article>old</article><article>reading</article></div>';
+  container.getBoundingClientRect = () => ({ top: 0 });
+  Object.defineProperties(container, {
+    scrollHeight: { value: 2000, configurable: true },
+    clientHeight: { value: 400 },
+  });
+  let firstHeight = 400;
+  const [first, anchor] = container.firstElementChild.children;
+  Object.defineProperties(first, { offsetTop: { value: 0 }, offsetHeight: { get: () => firstHeight } });
+  Object.defineProperties(anchor, { offsetTop: { get: () => firstHeight }, offsetHeight: { value: 600 } });
+  first.getBoundingClientRect = () => ({ top: -container.scrollTop, bottom: firstHeight - container.scrollTop });
+  anchor.getBoundingClientRect = () => ({
+    top: firstHeight - container.scrollTop,
+    bottom: firstHeight + 600 - container.scrollTop,
+  });
+  return {
+    container,
+    prepend: (height) => {
+      firstHeight += height;
+    },
+  };
+}
+
+test('a reading anchor survives hidden layout collapse and older content inserted above it', () => {
+  const { container, prepend } = scrollFixture();
+  container.scrollTop = 450;
+  const position = captureChatScrollPosition(container, false);
+  container.scrollTop = 0;
+  prepend(700);
+  restoreChatScrollPosition(container, position);
+  assert.equal(container.scrollTop, 1150);
+  assert.equal(position.anchor.getBoundingClientRect().top, -50);
+});
+
+test('a bottom-following reader returns to the new bottom after background output', () => {
+  const { container } = scrollFixture();
