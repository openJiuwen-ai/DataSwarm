-def _set_nested_config_value(target: dict[str, Any], path: tuple[str, ...], value: Any) -> None:
-    current = target
-    for segment in path[:-1]:
-        child = current.get(segment)
-        if not isinstance(child, dict):
-            child = {}
-            current[segment] = child
-        current = child
-    current[path[-1]] = value
