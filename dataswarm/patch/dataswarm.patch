+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""执行器抽象层。
+
+MVP 两个实现：
+    - SqlExecutor: 只读 SQLite SQL（connect_ro / assert_readonly / add_limit_guard 模式源自已归档的 sqlite-query skill）
+    - PythonExecutor: subprocess 跑临时 .py + 超时 kill（抄 _run_command_sync 的超时/FD 处理）
+
+后续可加 MySQLExecutor / PostgresExecutor，只需实现 Executor 协议。
+"""
+from __future__ import annotations
+
+from .base import Executor, TaskRunResult, get_executor
+from .sql_executor import SqlExecutor
+from .python_executor import PythonExecutor
+from .stream_load_executor import StreamLoadExecutor
+
+__all__ = ["Executor", "TaskRunResult", "get_executor", "SqlExecutor", "PythonExecutor", "StreamLoadExecutor"]
