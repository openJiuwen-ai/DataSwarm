+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""开放分析开关预检（require_open_analysis_enabled）。
+
+覆盖：open 断言用例 + 开关关 → die_env exit 2（fail fast 不烧 token）、
+closed 用例不受影响、开关开时放行、直读 config.yaml 兜底语义。
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+
+EVAL_SCRIPTS = Path(__file__).resolve().parents[3] / ".claude/skills/dw-analysis-eval/scripts"
+if str(EVAL_SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(EVAL_SCRIPTS))
+
+import _common  # noqa: E402
+
+
+def _case(case_id: str, mode: str | None = None) -> dict:
+    case = {"id": case_id}
+    if mode:
+        case["expect"] = {"open_analysis": {"mode": mode}}
+    return case
+
+
+def test_open_case_fails_fast_when_switch_off(monkeypatch, capsys):
+    """open 断言用例 + 开关关 → die_env exit 2，stderr 含开启指引。"""
+    monkeypatch.setattr(_common, "open_analysis_switch_on", lambda: False)
+    with pytest.raises(SystemExit) as excinfo:
+        _common.require_open_analysis_enabled([_case("nw-19-report-quarterly", "open")])
+    assert excinfo.value.code == 2
+    assert "open_analysis_enabled" in capsys.readouterr().err
+
+
+def test_mixed_cases_list_all_open_ids(monkeypatch, capsys):
+    """混合用例 → 错误消息列出全部 open 断言用例 id。"""
+    monkeypatch.setattr(_common, "open_analysis_switch_on", lambda: False)
+    cases = [_case("olist-08", None), _case("ck-27-colloquial-annual-report", "open"),
+             _case("nw-19-report-quarterly", "open")]
+    with pytest.raises(SystemExit):
+        _common.require_open_analysis_enabled(cases)
+    message = capsys.readouterr().err
+    assert "ck-27-colloquial-annual-report" in message
+    assert "nw-19-report-quarterly" in message
+    assert "olist-08" not in message
+
+
+def test_closed_cases_pass_when_switch_off(monkeypatch):
+    """closed / 无断言用例在开关关时照常放行（默认主路不受影响）。"""
+    monkeypatch.setattr(_common, "open_analysis_switch_on", lambda: False)
+    _common.require_open_analysis_enabled([_case("olist-08"), _case("ck-05", "closed")])
+
+
+def test_open_case_passes_when_switch_on(monkeypatch):
+    """open 断言用例 + 开关开 → 放行。"""
+    monkeypatch.setattr(_common, "open_analysis_switch_on", lambda: True)
+    _common.require_open_analysis_enabled([_case("nw-19-report-quarterly", "open")])
+
+
+def test_switch_reads_config_yaml_fallback(monkeypatch, tmp_path):
+    """import jiuwenswarm 失败时按同语义直读 AGENT_HOME/config/config.yaml。"""
+    real_import = __import__
+
+    def _no_jiuwenswarm(name, *args, **kwargs):
+        if name.startswith("jiuwenswarm"):
+            raise ImportError("simulated")
+        return real_import(name, *args, **kwargs)
+
+    monkeypatch.setattr("builtins.__import__", _no_jiuwenswarm)
+    config_dir = tmp_path / "config"
+    config_dir.mkdir()
+    config = config_dir / "config.yaml"
+
+    config.write_text("open_analysis_enabled: true\n", encoding="utf-8")
+    monkeypatch.setattr(_common, "AGENT_HOME", tmp_path)
+    assert _common.open_analysis_switch_on() is True
+
+    config.write_text("open_analysis_enabled: false\n", encoding="utf-8")
+    assert _common.open_analysis_switch_on() is False
+
+    config.write_text("progressive_tool_enabled: true\n", encoding="utf-8")
+    assert _common.open_analysis_switch_on() is False        # 缺 key 默认关
+
+    config.write_text("open_analysis_enabled: 'on'\n", encoding="utf-8")
+    assert _common.open_analysis_switch_on() is True         # 字符串真值集
