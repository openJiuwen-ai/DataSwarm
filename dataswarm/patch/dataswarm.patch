-echo -e "${GREEN}========================================${NC}"
-echo ""
-
-# Default values
-COVERAGE_REPORT="term"
-VERBOSE="-v"
-TEST_PATH="tests/"
-PARALLEL=false
-
-# Parse arguments
-while [[ $# -gt 0 ]]; do
-    case $1 in
-        -c|--coverage)
-            COVERAGE_REPORT="html"
-            shift
-            ;;
-        -v|--verbose)
-            VERBOSE="-vv"
-            shift
-            ;;
-        -u|--unit-only)
-            TEST_PATH="tests/unit_tests/"
-            shift
-            ;;
-        -i|--integration-only)
-            TEST_PATH="tests/integration/"
-            shift
-            ;;
-        -p|--parallel)
-            PARALLEL=true
-            shift
-            ;;
-        -h|--help)
-            echo "Usage: $0 [OPTIONS]"
