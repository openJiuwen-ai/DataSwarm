+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""builder/controller.py — /api/dataagent/builder/* 路由（方案批次 3 §5.4）。
+
+GET  /builder/plans/{id}          plan 派生状态
+POST /builder/plans/{id}/materialize  plan → 任务/工作流
+"""
+from __future__ import annotations
+
+import json
+
+from . import service as svc
+
+
+_PREFIX = "/api/dataagent/builder"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    return path[len(_PREFIX):].rstrip("/").split("/")
+
+
+def _read_body(handler) -> dict | None:
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except ValueError:
+        return None
+    if not length:
+        return {}
+    try:
+        return json.loads(handler.rfile.read(length).decode("utf-8"))
+    except ValueError:
+        return None
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    # GET /builder/plans/{id}
+    if len(parts) == 3 and parts[1] == "plans":
+        handler._write_json(200 if (out := svc.get_plan_status(parts[2])).get("ok") else 404, out)
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = _read_body(handler)
+    if body is None and len(parts) > 1:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    sv = (body or {}).get("schema_version")
+    if sv not in (None, 1):
+        handler._write_json(400, {"error": "unsupported_schema_version", "supported": [1]})
+        return
+    try:
+        # POST /builder/plans/{id}/materialize
+        if len(parts) == 4 and parts[1] == "plans" and parts[3] == "materialize":
+            if sv is None:
+                body["schema_version"] = 1
+            out = svc.materialize(
+                parts[2], mode=(body or {}).get("mode", "replace"),
+                file_paths=(body or {}).get("file_paths") or {})
+            handler._write_json(200 if out.get("ok") else 400, out)
+            return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
