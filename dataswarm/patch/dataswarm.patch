+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""datasource/service.py — 数据源管理业务层。
+
+三层职责：
+  registry  类型适配器（可扩展：新增类型 = 注册一个 Adapter，前端动态渲染表单）
+  store     元数据库 dw_datasources 表 CRUD（UI 建的源，凭据持久化在此）
+  本文件    编排：校验 → 测试 → 落库 → 脱敏；workspace 绑定源只读展示
+"""
+from __future__ import annotations
+
+import csv
+import logging
+import re
+from pathlib import Path
+
+from .. import db as _da_db
+from . import registry as _registry
+from . import store as _store
+from ..connectors import get_connector_manager
+
+logger = logging.getLogger(__name__)
+
+db_connector = _da_db.db_connector
+
+_SOURCE_ID_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$")
+
+# 编辑态密码留空时前端携带的哨兵值（列表回显脱敏为空串，无法区分"没改"）
+_SECRET_KEEP_SENTINEL = "__KEEP__"
+
+
+def _find_local_source(source_id: str, workspace_id: str | None = None) -> dict | None:
+    """Workspace-local lookup, with compatibility for injected test stores."""
+    if workspace_id is None:
+        return _store.find_source(source_id, workspace_id=None)
+    loader = getattr(_store, "find_local_source", None)
+    if loader is not None:
+        return loader(source_id, workspace_id=workspace_id)
+    return _store.find_source(source_id, workspace_id=workspace_id)
+
+
+def _trigger_binding_collection(source_id: str, workspace_id: str) -> dict:
+    """Trigger supported metadata collection without affecting binding."""
+    return trigger_semantic_collection(source_id, workspace_id, trigger_type="binding")
+
+
+def trigger_semantic_collection(
+    source_id: str, workspace_id: str, *, trigger_type: str,
+) -> dict:
+    """Return observable automatic collection status without an extra thread.
+
+    Semantic startup checks source capabilities and owns the workspace-scoped
+    run lock and collection thread. Binding and query feedback use this same
+    response contract; neither caller should expose driver errors.
+    """
+    try:
+        from ..semantic import service as semantic_service
+
+        starter = (semantic_service.start_run_for_query if trigger_type == "query_feedback"
+                   else semantic_service.start_run_for_binding)
+        run = starter(source_id, workspace_id)
+        status = str(run.get("status") or "queued")
+        # Preserve explicit declined/failed outcomes. An accepted task keeps
+        # the established binding envelope while exposing its current state.
+        result = {"status": status}
+        if run.get("run_id"):
+            result.update(run_id=run["run_id"], run_status=status)
+            if status in {"queued", "running", "staged", "published"}:
+                result["status"] = "queued"
+        for key in ("reason", "warnings", "error"):
+            if key in run:
+                result[key] = run[key]
+        return result
+    except Exception as exc:
+        return {
+            "status": "trigger_failed",
+            "error": type(exc).__name__,
+            "reason": "semantic_collection_trigger_failed",
+            "warnings": ["semantic_collection_trigger_failed"],
+        }
+
+
+def _trigger_schema_derivation(db_ref: str, source_id: str, workspace_id: str) -> dict:
+    """绑定时后台跑知识派生任务：L1 正则派生 + L2 LLM 深化（带超时/重试，见数据源列表）。"""
+    if not db_ref:
+        return {"status": "not_applicable"}
+    try:
+        from ..knowledge.schema_enrichment import submit
+
+        return submit(workspace_id, db_ref=db_ref, source_id=source_id)
+    except Exception as exc:  # noqa: BLE001 — 派生失败不回滚绑定
+        return {"status": "trigger_failed", "error": type(exc).__name__}
+
+
+# ==========================================================================
+# 类型目录（前端动态渲染表单用）
+# ==========================================================================
+def list_source_types() -> dict:
+    """已注册的数据源类型目录：type_id + label + 字段 schema。"""
+    return {"ok": True, "types": _registry.list_source_types()}
+
+
+# ==========================================================================
+# 连通性测试（保存前，表单参数直连不落盘）
+# ==========================================================================
+def _classify_test_error(error: str) -> str:
+    """连接错误 → 前端错误码。pymysql 库不存在报 (1049, "Unknown database 'x'")。"""
+    lowered = (error or "").lower()
+    if "unknown database" in lowered or "1049" in lowered or "invalidcatalogname" in lowered:
+        return "DB_NOT_FOUND"
+    return "TEST_FAILED"
+
+
+def _is_db_source(adapter) -> bool:
+    """库型源（doris/mysql 等 fields 含 database）才探测；csv/excel 等文件型跳过。"""
+    return "database" in {f.key for f in adapter.fields}
+
+
+def _probe_blocked(adapter, config: dict) -> dict | None:
+    """保存前探测；通过或文件型跳过返回 None，失败返回 {ok:False, error_code, error}。"""
+    if not _is_db_source(adapter):
+        return None
+    result = adapter.test_connection(config)
+    if result.get("ok"):
+        return None
+    error = str(result.get("error") or "connection test failed")
+    return {"ok": False, "error_code": _classify_test_error(error), "error": error}
+
+
+def _unavailable_error(adapter) -> dict | None:
+    """``available=False`` 的类型（未发布/缺驱动）统一服务端拒绝，可用时返回 None。
+
+    前端目录置灰不是约束——本产品 API 会被 LLM 驱动，不能仅依赖各类型的
+    参数校验；创建/测试/更新三入口共用本闸门，返回带结构化 error_code 与
+    unavailable_reason 供前端与调用方分诊。
+    """
+    # getattr 兜底：测试替身等非 SourceTypeAdapter 子类不带这两个属性，
+    # 「没有表态」按可用处理——闸门只拦**显式**声明不可用的类型。
+    if getattr(adapter, "available", True):
+        return None
+    reason = str(getattr(adapter, "unavailable_reason", "") or "not_released")
+    if reason.startswith("driver_missing:"):
+        missing = reason.split(":", 1)[1]
+        detail = f"缺少驱动 {missing}，请安装对应的 ds-* extra"
+    else:
+        detail = "该类型尚未通过验收（数据分析未跑通），暂不可用"
+    return {
+        "ok": False,
+        "error_code": "SOURCE_TYPE_UNAVAILABLE",
+        "error": f"source type '{adapter.type_id}' is not available yet: {detail}",
+        "unavailable_reason": reason,
+    }
+
+
+def test_connection(params: dict) -> dict:
+    """表单参数直连测试。编辑态密码留空时前端带 KEEP 哨兵，这里替换为已存密码。"""
+    source_type = str(params.get("type", "")).strip()
+    try:
+        adapter = _registry.get_source_type(source_type)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    blocked = _unavailable_error(adapter)
+    if blocked:
+        return blocked
+    params = _merge_saved_secrets(adapter, params)
+    try:
+        adapter.validate(params)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    result = adapter.test_connection(params)
+    if not result.get("ok"):
+        result["error_code"] = _classify_test_error(str(result.get("error") or ""))
+    return result
+
+
+def _merge_saved_secrets(adapter, params: dict) -> dict:
+    """编辑态测试连接：secret 字段为 KEEP 哨兵 → 用已存源的旧值补齐。
+
+    前端编辑时列表回显的密码是脱敏空串，用户不改密码直接测试会因缺凭据失败；
+    哨兵替换为按 source_id 找到的已存密码，与 update 的「留空沿用」同语义。
+    """
+    secret_keys = adapter.secret_keys()
+    if not secret_keys or not any(
+        str(params.get(k) or "").strip() == _SECRET_KEEP_SENTINEL for k in secret_keys
+    ):
+        return params
+    source_id = str(params.get("source_id") or "").strip()
+    workspace_id = str(params.get("workspace_id") or "").strip() or None
+    source = _find_local_source(source_id, workspace_id=workspace_id) if source_id else None
+    if not source:
+        return params
+    saved_config = source.get("config", {})
+    merged = dict(params)
+    for k in secret_keys:
+        if str(merged.get(k) or "").strip() == _SECRET_KEEP_SENTINEL:
+            merged[k] = str(saved_config.get(k) or "")
+    return merged
+
+
+def _connector(source_id: str):
+    return get_connector_manager().get(source_id)
+
+
+def _probe_registered_source(source_id: str | None, workspace_id: str | None = None) -> dict | None:
+    if not source_id:
+        return None
+    source = _find_local_source(source_id, workspace_id=workspace_id)
+    if not source:
+        return None
+    db_ref = str(source.get("db_ref") or "")
+    source_type = str(source.get("source_type") or "")
+    try:
+        adapter = _registry.get_source_type(source_type)
+        config = dict(source.get("config") or {})
+        adapter.validate(config)
+    except ValueError as exc:
+        return {"ok": False, "db_ref": db_ref, "error": str(exc)}
+    result = adapter.test_connection(config)
+    result.setdefault("db_ref", db_ref)
+    return result
+
+
+def _sql_connector(source_id: str):
+    """取得具备 SqlQueryable 能力的连接器，否则返回能力不支持错误。
+
+    通用 Connector 不保证存在 query/preview，调用前必须检查对应协议。
+    """
+    from ..connectors.base import SqlQueryable, capabilities_of
+    from ..connectors.errors import CapabilityUnsupportedError
+
+    connector = _connector(source_id)
+    if not isinstance(connector, SqlQueryable):
+        raise CapabilityUnsupportedError(
+            f"source {source_id!r} (engine={connector.engine}) 不支持 SQL 查询；"
+            f"该源具备的能力: {sorted(capabilities_of(connector)) or '无'}"
+        )
+    return connector
+
+
+def source_catalog(source_id: str) -> dict:
+    return _connector(source_id).catalog()
+
+
+def source_schema(source_id: str, dataset: str, schema_name: str | None = None) -> dict:
+    return _connector(source_id).schema(dataset, schema_name=schema_name)
+
+
+def source_preview(source_id: str, dataset: str, limit: int = 100) -> dict:
+    return _sql_connector(source_id).preview(dataset, limit=limit)
+
+
+def query_source(source_id: str, sql: str, params=None, limit: int = 100) -> dict:
+    return _sql_connector(source_id).query(sql, params=params, limit=limit)
+
+
+# ==========================================================================
+# UI 数据源 CRUD（元数据库）
+# ==========================================================================
+def _invalidate_creds_cache() -> None:
+    """凭据/配置变更后失效两层缓存：db_connector 凭据缓存 + connector Engine 池。
+
+    只清 db_connector 会导致 preview/catalog 等 connector 路径继续用旧凭据
+    （Engine URL 建池时已固化凭据）。
+    """
+    from ..connectors.sqlalchemy_connector import clear_engine_cache
+
+    db_connector.invalidate_source_credentials_cache()
+    clear_engine_cache()
+
+
+def _same_physical_ref(ref_a: str, ref_b: str) -> bool:
+    """两个 db_ref 是否指向同一物理库（归一化后比较；解析失败回退字面比对）。"""
+    from jiuwenswarm.common.workspace_context import same_physical_ref
+
+    return same_physical_ref(ref_a, ref_b)
+
+
+def _workspace_bound_ref(workspace_id: str | None) -> str:
+    """工作空间当前绑定的业务源 ref；无绑定 / 无 workspace_id / 解析失败返回空串。"""
+    from jiuwenswarm.common import workspace_context
+
+    if not workspace_id:
+        return ""
+    try:
+        return str(workspace_context.resolve(workspace_id).business_db_ref or "")
+    except Exception:
+        return ""
+
+
+def create_source(params: dict) -> dict:
+    """新建：ID 校验 → 类型适配器校验 → 落元数据库 → UI 工作空间自动绑定。
+
+    创建与绑定分层：数据源支持一空间注册多个（元库多行）；绑定是单数
+    （workspace.business_db_ref 单值）。绑定规则（覆盖式单绑定）：
+    workspace_id 为 UI 创建的工作空间时，未绑定 → 绑定新源；已绑不同源
+    且无 rebind → WORKSPACE_ALREADY_BOUND（前端弹「换绑 / 不换绑仅添加」：
+    不换绑则 body 不带 workspace_id 仅注册，不动现有绑定）；rebind=True →
+    换绑。YAML 工作空间 / 未传 workspace_id → 不绑定。
+    同物理 ref 拦截：新源与当前空间已绑定源指向同一物理库时拒绝（SOURCE_ALREADY_BOUND），
+    防同库多条目在列表里全部 bound=true 造成按钮全禁用。
+    """
+    from jiuwenswarm.common import workspace_store
+
+    source_id = str(params.get("source_id", "")).strip()
+    if not _SOURCE_ID_RE.match(source_id):
+        return {"ok": False, "error": "source_id must be 1-64 chars of letters/digits/_/-"}
+    source_type = str(params.get("type", "")).strip()
+    try:
+        adapter = _registry.get_source_type(source_type)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    blocked = _unavailable_error(adapter)
+    if blocked:
+        return blocked
+    try:
+        adapter.validate(params)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    workspace_id = str(params.get("workspace_id", "")).strip()
+    rebind = bool(params.get("rebind"))
+    description = str(params.get("description", "")).strip()
+    if len(description) > 500:
+        return {"ok": False, "error": "description must be at most 500 characters"}
+    config = {k: v for k, v in params.items()
+              if k not in ("source_id", "workspace_id", "type", "rebind", "description")}
+    db_ref = adapter.build_ref(config)
+
+    bound_ref = _workspace_bound_ref(workspace_id)
+    if bound_ref and _same_physical_ref(db_ref, bound_ref):
+        return {
+            "ok": False,
+            "error_code": "SOURCE_ALREADY_BOUND",
+            "error": "source points to the database already bound to this workspace",
+        }
+
+    bind_plan = _plan_workspace_binding(workspace_id, db_ref, rebind)
+    if isinstance(bind_plan, dict) and bind_plan.get("error_code"):
+        return bind_plan
+
+    blocked = _probe_blocked(adapter, config)
+    if blocked:
+        return blocked
+
+    try:
+        row = _store.insert_source(source_id, source_type, source_id, config, db_ref,
+                                   workspace_id=workspace_id or None, description=description)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    _invalidate_creds_cache()
+
+    result = {"ok": True, "source_id": source_id, "db_ref": row["db_ref"]}
+    if isinstance(bind_plan, dict) and bind_plan.get("workspace_id"):
+        workspace_store.update_business_ref(bind_plan["workspace_id"], db_ref)
+        result["bound"] = True
+        result["workspace_id"] = bind_plan["workspace_id"]
+        result["semantic_collection"] = _trigger_binding_collection(source_id, bind_plan["workspace_id"])
+        result["schema_derivation"] = _trigger_schema_derivation(db_ref, source_id, bind_plan["workspace_id"])
+    return result
+
+
+def bind_source_to_workspace(params: dict) -> dict:
+    """Bind a registered data source as the business source of a UI workspace.
+
+    绑定是单数（business_db_ref 单值，后写生效）；数据源本身可注册多个，
+    换绑其他注册源（含跨空间源）是正常操作。
+    """
+    from jiuwenswarm.common import workspace_store
+
+    source_id = str(params.get("source_id") or "").strip()
+    workspace_id = str(params.get("workspace_id") or "").strip()
+    if not source_id or not workspace_id:
+        return {"ok": False, "error_code": "BAD_REQUEST", "error": "source_id and workspace_id are required"}
+
+    source = _store.find_source(source_id, workspace_id=workspace_id or None)
+    if not source:
+        return {"ok": False, "error_code": "DATASOURCE_NOT_FOUND", "error": f"data source not found: {source_id}"}
+
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        context = workspace_context.resolve(workspace_id)
+    except workspace_context.WorkspaceContextError as exc:
+        return {"ok": False, "error_code": getattr(exc, "code", "INVALID_WORKSPACE"), "error": str(exc)}
+    if workspace_context.is_yaml_workspace(workspace_id):
+        return {
+            "ok": False,
+            "error_code": "YAML_WORKSPACE_READ_ONLY",
+            "error": "YAML workspaces do not support managed data source binding",
+        }
+
+    db_ref = str(source.get("db_ref") or "").strip()
+    try:
+        result = workspace_store.update_business_ref(workspace_id, db_ref)
+    except ValueError as exc:
+        return {"ok": False, "error_code": "WORKSPACE_NOT_FOUND", "error": str(exc)}
+    return {
+        "ok": True,
+        "source_id": source_id,
+        "db_ref": db_ref,
+        "bound": True,
+        "workspace_id": result["workspace_id"],
+        "previous_db_ref": context.business_db_ref,
+        "semantic_collection": _trigger_binding_collection(source_id, result["workspace_id"]),
+        "schema_derivation": _trigger_schema_derivation(db_ref, source_id, result["workspace_id"]),
+    }
+
+
+def _plan_workspace_binding(workspace_id: str, db_ref: str, rebind: bool = False) -> dict | None:
+    """绑定预检：返回 None（不绑定）或 {workspace_id} / {error_code, detail}。
+
+    插入数据源行之前调用，避免校验失败留下孤儿数据源。
+    """
+    from jiuwenswarm.common import workspace_context
+
+    if not workspace_id:
+        return None
+    try:
+        context = workspace_context.resolve(workspace_id)
+    except workspace_context.WorkspaceContextError:
+        return None
+    if workspace_context.is_yaml_workspace(workspace_id):
+        return None
+    current_ref = context.business_db_ref
+    if not current_ref:
+        return {"workspace_id": context.workspace_id}
+    try:
+        same = workspace_context.normalize_db_ref(current_ref) == workspace_context.normalize_db_ref(db_ref)
+    except Exception:
+        same = current_ref == db_ref
+    if same:
+        return {"workspace_id": context.workspace_id}
+    if rebind:
+        return {"workspace_id": context.workspace_id}
+    return {
+        "ok": False,
+        "error_code": "WORKSPACE_ALREADY_BOUND",
+        "error": f"workspace {context.workspace_id!r} already bound to another data source",
+        "detail": {
+            "workspace_id": context.workspace_id,
+            "current_ref": current_ref,
+            "new_ref": db_ref,
+        },
+    }
+
+
+def update_source(params: dict) -> dict:
+    """编辑：密码留空沿用旧值；type 不可改。
+
+    ref 变化时级联换绑：工作空间 business_db_ref 仍指向该源旧 ref 的，
+    同步改写为新 ref（否则列表 bound 比对失效，且空间继续读旧路径）。
+    """
+    source_id = str(params.get("source_id", "")).strip()
+    workspace_id = str(params.get("workspace_id", "")).strip() or None
+    existing = _find_local_source(source_id, workspace_id=workspace_id)
+    if not existing:
+        return {"ok": False, "error": f"source not found: {source_id}"}
+    source_type = str(params.get("type", existing["source_type"])).strip()
+    if source_type != existing["source_type"]:
+        return {"ok": False, "error": "type cannot be changed; delete and recreate"}
+    try:
+        adapter = _registry.get_source_type(source_type)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    blocked = _unavailable_error(adapter)
+    if blocked:
+        return blocked
+    # 合并：表单值优先；secret 字段空串/KEEP 哨兵 = 沿用旧值；description 未传 = 沿用旧值
+    merged = {**existing["config"]}
+    for key in (f.key for f in adapter.fields):
+        if key in params:
+            value = params[key]
+            if key in adapter.secret_keys() and str(value or "").strip() in ("", _SECRET_KEEP_SENTINEL):
+                continue
+            merged[key] = value
+    if "description" not in params:
+        params = {**params, "description": str(existing.get("description") or "")}
+    description = str(params.get("description") or "").strip()
+    if len(description) > 500:
+        return {"ok": False, "error": "description must be at most 500 characters"}
+    try:
+        adapter.validate(merged)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    db_ref = adapter.build_ref(merged)
+    bound_ref = _workspace_bound_ref(workspace_id)
+    if bound_ref and _same_physical_ref(db_ref, bound_ref) and not _same_physical_ref(
+        str(existing.get("db_ref") or ""), bound_ref
+    ):
+        return {
+            "ok": False,
+            "error_code": "SOURCE_ALREADY_BOUND",
+            "error": "source points to the database already bound to this workspace",
+        }
+    blocked = _probe_blocked(adapter, merged)
+    if blocked:
+        return blocked
+    try:
+        row = _store.update_source_row(source_id, source_type, source_id, merged, db_ref,
+                                       workspace_id=workspace_id, description=description)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    _invalidate_creds_cache()
+
+    old_ref = str(existing.get("db_ref") or "")
+    rebound_workspaces = []
+    if old_ref and old_ref != row["db_ref"]:
+        from jiuwenswarm.common import workspace_store
+
+        if workspace_id:
+            ws = next(
+                (item for item in workspace_store.list_workspaces()
+                 if item["workspace_id"] == workspace_id),
+                None,
+            )
+            if ws and ws.get("business_db_ref") and _same_physical_ref(ws["business_db_ref"], old_ref):
+                workspace_store.update_business_ref(workspace_id, row["db_ref"])
+                rebound_workspaces.append(workspace_id)
+                # 换库后的新 schema 未派生过：与首次绑定同等待遇（幂等，老库候选指纹仍在）
+                _trigger_schema_derivation(row["db_ref"], source_id, workspace_id)
+                # 历史指标绑定仍指向旧 ref 会让 metric query 权限拒绝，跟着源走
+                _cascade_metric_bindings(workspace_id, old_ref, row["db_ref"])
+    result = {"ok": True, "source_id": source_id, "db_ref": row["db_ref"]}
+    if rebound_workspaces:
+        result["rebound_workspaces"] = rebound_workspaces
+    return result
+
+
+def _cascade_metric_bindings(workspace_id: str, old_ref: str, new_ref: str) -> int:
+    """级联改写该工作空间指标绑定的 datasource_ref，返回改写行数（失败 -1）。
+
+    绑定残留旧 ref 会让 metric query 权限校验拒绝（db_ref is not allowed）。
+    失败不回滚换绑（对齐 _trigger_schema_derivation 的级联容错语义）；
+    语义快照 conn_ref 是采集时点的事实记录，不随源迁移改写——重新 bind
+    采集会生成新快照。
+    """
+    from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        token = workspace_context.set_current(workspace_id)
+        try:
+            return metric_store.rebind_datasource_refs(workspace_id, old_ref, new_ref)
+        finally:
+            workspace_context.reset(token)
+    except Exception:  # noqa: BLE001 — 级联失败不回滚换绑
+        return -1
+
+
+_DB_NAME_RE = re.compile(r"^[A-Za-z0-9_$-]+$")
+
+
+def create_database(params: dict) -> dict:
+    """CREATE DATABASE IF NOT EXISTS（不带库名连接，参照 _ensure_biz_db 先例）。
+
+    仅库型源支持；编辑场景 secret 留空沿用旧值（与 update_source 合并语义一致）。
+    """
+    source_type = str(params.get("type", "")).strip()
+    try:
+        adapter = _registry.get_source_type(source_type)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    blocked = _unavailable_error(adapter)
+    if blocked:
+        return blocked
+    if not _is_db_source(adapter):
+        return {"ok": False, "error": f"source type {source_type!r} does not support database creation"}
+
+    merged_params = _merge_saved_secrets(adapter, params)
+    config = {k: v for k, v in merged_params.items()
+              if k not in ("source_id", "workspace_id", "type", "description")}
+    source_id = str(params.get("source_id", "")).strip()
+    workspace_id = str(params.get("workspace_id", "")).strip() or None
+    if source_id:
+        existing = _find_local_source(source_id, workspace_id=workspace_id)
+        if existing:
+            # secret 留空 = 沿用旧值
+            for key in adapter.secret_keys():
+                if not str(config.get(key) or "").strip():
+                    old = (existing.get("config") or {}).get(key)
+                    if old is not None:
+                        config[key] = old
+    try:
+        adapter.validate(config)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    database = str(config.get("database") or "").strip()
+    if not _DB_NAME_RE.match(database):
+        return {"ok": False, "error": f"invalid database name: {database!r}"}
+
+    import pymysql  # type: ignore
+
+    try:
+        conn = pymysql.connect(
+            host=str(config.get("host") or ""),
+            port=int(config.get("port") or 9030),
+            user=str(config.get("user") or "root"),
+            password=str(config.get("password") or ""),
+            charset="utf8mb4",
+            connect_timeout=5,
+        )
+    except Exception as exc:  # noqa: BLE001
+        return {"ok": False, "error": f"connect failed: {exc}"}
+    try:
+        cur = conn.cursor()
+        cur.execute(f"CREATE DATABASE IF NOT EXISTS `{database}`")
+        conn.commit()
+    except Exception as exc:  # noqa: BLE001
+        return {"ok": False, "error": f"create database failed: {exc}"}
+    finally:
+        conn.close()
+    return {"ok": True, "database": database}
+
+
+def delete_source(params: dict) -> dict:
+    """删除（元数据库行）。已绑定工作空间的源需 force 确认，级联清空绑定。"""
+    from jiuwenswarm.common import workspace_store
+
+    source_id = str(params.get("source_id", "")).strip()
+    force = bool(params.get("force"))
+    workspace_id = str(params.get("workspace_id", "")).strip() or None
+    source = _find_local_source(source_id, workspace_id=workspace_id)
+    if not source:
+        return {"ok": False, "error": f"source not found: {source_id}"}
+    db_ref = str(source.get("db_ref") or "")
+    bound_workspaces = []
+    if workspace_id:
+        for row in workspace_store.list_workspaces():
+            if row["workspace_id"] == workspace_id and row.get("business_db_ref") == db_ref:
+                bound_workspaces.append(workspace_id)
+    if bound_workspaces and not force:
+        return {
+            "ok": False,
+            "error_code": "DATASOURCE_BOUND_TO_WORKSPACE",
+            "error": f"source is bound to workspace(s): {', '.join(bound_workspaces)}",
+            "detail": {"workspaces": bound_workspaces, "source_id": source_id},
+        }
+    try:
+        _store.delete_source_row(source_id, workspace_id=workspace_id)
+    except ValueError as exc:
+        return {"ok": False, "error": str(exc)}
+    for workspace_id in bound_workspaces:
+        workspace_store.update_business_ref(workspace_id, "")
+    _invalidate_creds_cache()
+    return {"ok": True, "source_id": source_id, "unbound_workspaces": bound_workspaces}
+
+
+# ==========================================================================
+# 列表：workspace 绑定源（YAML，只读） + UI 源（元数据库，脱敏）
+# ==========================================================================
+def probe_datasource(
+    db_ref: str,
+    workspace_id: str | None = None,
+    source_id: str | None = None,
+) -> dict:
+    """连接测试（P1-8：显式 ref 经 workspace+role 校验，business role）。"""
+    from jiuwenswarm.common import workspace_context
+
+    try:
+        registered_result = _probe_registered_source(source_id, workspace_id=workspace_id)
+        if registered_result is not None:
+            return registered_result
+        if db_ref:
+            workspace_context.validate_ref_in_workspace(workspace_id, "business", db_ref)
+        db_connector.ping(db_ref)
+        return {"ok": True, "db_ref": db_ref}
+    except workspace_context.WorkspaceContextError as exc:
+        return {"ok": False, "db_ref": db_ref,
+                "error_code": getattr(exc, "code", "invalid_workspace"), "error": str(exc)}
+    except Exception as exc:
+        return {"ok": False, "db_ref": db_ref, "error": str(exc)}
+
+
+def list_datasources(workspace_id: str | None = None) -> dict:
+    """List registered sources and the selected YAML workspace's business source."""
+    from jiuwenswarm.common import workspace_context
+
+    datasources: list[dict] = []
+    yaml_workspace = False
+    bound_ref = ""
+    if workspace_id:
+        try:
+            bound_ref = workspace_context.normalize_db_ref(
+                workspace_context.resolve(workspace_id).business_db_ref
+            )
+        except Exception:
+            bound_ref = ""
+    if workspace_id and workspace_context.is_yaml_workspace(workspace_id):
+        try:
+            ctx = workspace_context.resolve(workspace_id)
+        except workspace_context.WorkspaceContextError as exc:
+            return {"ok": False, "error": str(exc), "datasources": []}
+        yaml_workspace = True
+        entry: dict = {
+            "ref": ctx.business_db_ref,
+            "source_id": f"yaml:{ctx.workspace_id}:business",
+            "managed": False,
+            "read_only": True,
+            "config_source": "yaml",
+            "workspace_id": ctx.workspace_id,
+            "workspace_name": ctx.name,
+            "role": "business",
+        }
+        try:
+            spec = db_connector.parse_db_ref(ctx.business_db_ref)
+            entry["type"] = spec.get("type", "unknown")
+            if spec.get("type") == "sqlite":
+                entry["database"] = Path(spec.get("path", "")).name
+                entry["path"] = spec.get("path", "")
+            else:
+                entry["database"] = spec.get("database", "")
+                entry["host"] = spec.get("host", "")
+                entry["port"] = spec.get("port", 0)
+        except Exception as exc:
+            entry["type"] = "invalid"
+            entry["error"] = str(exc)
+        datasources.append(entry)
+
+    # UI 管理的源（当前工作空间元数据库 dw_datasources）：adapter 脱敏 secret 字段
+    try:
+        ui_sources = _store.list_sources(workspace_id=workspace_id)
+    except Exception:
+        ui_sources = []
+    for source in ui_sources:
+        source_type = source.get("source_type", "")
+        try:
+            source_ref = workspace_context.normalize_db_ref(source.get("db_ref", ""))
+        except Exception:
+            source_ref = str(source.get("db_ref") or "")
+        entry = {
+            "ref": source.get("db_ref", ""),
+            "source_id": source.get("source_id", ""),
+            "managed": True,
+            "role": "source",
+            "workspace_id": workspace_id or "",
+            "workspace_name": source.get("name", ""),
+            "type": source_type,
+            "bound": bool(bound_ref and source_ref == bound_ref),
+            "description": str(source.get("description") or ""),
+            "created_at": source.get("created_at", ""),
+            "updated_at": source.get("updated_at", ""),
+        }
+        try:
+            adapter = _registry.get_source_type(source_type)
+            public = adapter.public_config(source.get("config", {}))
+        except ValueError:
+            public = dict(source.get("config", {}))
+        for key in (
+            "host", "port", "database", "user", "path", "location", "table_name",
+            "format", "endpoint", "region", "bucket", "prefix", "be_host", "be_http_port",
+        ):
+            if key in public:
+                entry[key] = public[key]
+        if entry["bound"]:
+            # 绑定源附带知识派生状态（L1 正则 + L2 LLM 深化，数据源列表展示进度/重试）
+            try:
+                from ..knowledge.schema_enrichment import derivation_status
+
+                entry["knowledge_derivation"] = derivation_status(workspace_id or "default")
+            except Exception:  # noqa: BLE001 — 状态附加失败不影响列表
+                pass
+        datasources.append(entry)
+    return {"ok": True, "datasources": datasources, "yaml_workspace": yaml_workspace}
+
+
+def list_databases(db_ref: str, workspace_id: str | None = None) -> dict:
+    """List databases on a Doris/MySQL data source (SHOW DATABASES)."""
+    from jiuwenswarm.common import workspace_context
+
+    if db_ref:
+        workspace_context.validate_ref_in_workspace(workspace_id, "business", db_ref)
+    conn, meta = db_connector._acquire(db_ref, read_only=True)
+    try:
+        cur = db_connector._cursor(conn)
+        if meta["type"] == "sqlite":
+            databases = [meta.get("path", "")]
+        else:
+            cur.execute("SHOW DATABASES")
+            databases = [r[0] for r in cur.fetchall()]
+        return {"ok": True, "db_ref": db_ref, "type": meta["type"], "databases": databases}
+    finally:
+        db_connector._release(conn)
+
+
+# ==========================================================================
+# CSV schema 推断（本地文件读取 + 类型推断，无 DAO 依赖）
+# ==========================================================================
+def infer_csv_schema(file_path: str, sample_rows: int = 100) -> dict:
+    """CSV schema 推断。入口走 ``resolve_local_path`` 沙箱（与
+    ``CsvAdapter.validate`` 同一口径）：拒绝 URI 与 data roots 外的相对
+    路径——本端点会被 LLM 驱动，不能是任意本地文件读取原语。
+    """
+    from ..connectors.paths import resolve_local_path
+
+    try:
+        file_path = str(resolve_local_path(str(file_path), must_exist=False))
+    except Exception as exc:  # noqa: BLE001 —— 沙箱拒绝按 bad_request 透出
+        return {"ok": False, "error": str(exc)}
+    p = Path(file_path)
+    if not p.exists():
+        return {"ok": False, "error": f"file not found: {file_path}"}
+    if p.is_dir():
+        results = []
+        for f in sorted(p.glob("*.csv")):
+            r = _infer_single_csv(f, sample_rows)
+            r["file"] = f.name
+            results.append(r)
+        return {"ok": True, "files": results}
+
+    r = _infer_single_csv(p, sample_rows)
+    r["file"] = p.name
+    return {"ok": True, **r}
+
+
+def _infer_single_csv(path: Path, sample_rows: int) -> dict:
+    with open(path, encoding="utf-8-sig", errors="replace", newline="") as f:
+        reader = csv.reader(f)
+        headers = next(reader, [])
+        rows = []
+        for i, row in enumerate(reader):
+            if i >= sample_rows:
+                break
+            rows.append(row)
+
+    columns = []
+    for idx, name in enumerate(headers):
+        col_values = [r[idx] for r in rows if idx < len(r) and r[idx].strip()]
+        inferred_type = _infer_type(col_values)
+        columns.append({"name": name.strip(), "type": inferred_type})
+
+    preview = [headers] + rows[:5]
+
+    return {
+        "columns": columns,
+        "row_count": len(rows),
+        "path": str(path),
+        "preview": preview,
+    }
+
+
+# ==========================================================================
+# 存量迁移：裸路径文件源 ref → duckdb:// ref
+# ==========================================================================
+def migrate_file_source_refs() -> dict:
+    """把 csv/excel 源的裸路径 db_ref 重写为 duckdb:// 格式（幂等，启动时调）。
+
+    旧版 CsvAdapter/ExcelAdapter.build_ref 产出裸路径，下游被当 sqlite 打开。
+    此处按当前 adapter 重算 ref，并同步换绑 dw_workspaces.business_db_ref
+    中持有旧值的记录。单源失败不阻断整体（记 error 继续）。
+    """
+    from jiuwenswarm.common import workspace_store, workspace_context
+
+    migrated_sources = 0
+    migrated_workspaces = 0
+    errors: list[str] = []
+    try:
+        contexts = workspace_context.list_workspaces()
+    except workspace_context.WorkspaceContextError:
+        contexts = []
+    for context in contexts:
+        try:
+            sources = _store.list_sources(workspace_id=context.workspace_id)
+        except Exception as exc:  # noqa: BLE001 —— 单空间失败跳过不阻断迁移
+            logger.warning("[datasource] 迁移前读取源列表失败 workspace_id=%s: %s",
+                           context.workspace_id, exc)
+            continue
+        for source in sources:
+            source_type = str(source.get("source_type") or "")
+            old_ref = str(source.get("db_ref") or "")
+            if source_type not in ("csv", "excel") or not old_ref or "://" in old_ref:
+                continue
+            try:
+                adapter = _registry.get_source_type(source_type)
+                new_ref = adapter.build_ref(dict(source.get("config") or {}))
+                _store.update_source_row(
+                    source["source_id"], source_type, source["source_id"],
+                    dict(source.get("config") or {}), new_ref,
+                    workspace_id=context.workspace_id,
+                    description=str(source.get("description") or ""),
+                )
+                migrated_sources += 1
+            except Exception as exc:  # noqa: BLE001 —— 单源失败不阻断
+                errors.append(f"{source.get('source_id')}: {exc}")
+                continue
+            for row in workspace_store.list_workspaces():
+                if row.get("business_db_ref") == old_ref:
+                    workspace_store.update_business_ref(row["workspace_id"], new_ref)
+                    migrated_workspaces += 1
+    return {
+        "migrated_sources": migrated_sources,
+        "migrated_workspaces": migrated_workspaces,
+        "errors": errors,
+    }
+
+
+def _infer_type(values: list[str]) -> str:
+    if not values:
+        return "TEXT"
+    int_count = 0
+    float_count = 0
+    for v in values:
+        try:
+            int(v)
+            int_count += 1
+            continue
+        except ValueError:
+            pass
+        try:
+            float(v)
+            float_count += 1
+            continue
+        except ValueError:
+            pass
+    total = len(values)
+    if int_count == total:
+        return "INT"
+    if int_count + float_count == total:
+        return "DOUBLE"
+    return "TEXT"
