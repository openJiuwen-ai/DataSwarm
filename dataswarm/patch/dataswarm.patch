+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""finding_review 集成测试：review_all 对真实产物文件原子写回。
+
+验证 review_all 端到端行为（mock LLM 客户端）：
+  - 复核后产物文件被原子重写（severity 降级 + llm 字段 + 无 .tmp 残留）
+  - 复核后 health_scores 反映降级后的 severity
+  - run_pipeline 的降级开关（JIUWENSWARM_INSPECTION_LLM_REVIEW=0）语义
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from jiuwenswarm.common import finding_review as fr
+from jiuwenswarm.symphony import llm as llm_mod
+
+
+class _FakeClient:
+    async def complete_json_async(self, *, system_prompt, user_content,
+                                  timeout=None, error_context="LLM", **kw):
+        body = json.loads(user_content)
+        items = body.get("findings", [])
+        return json.dumps([
+            {"finding_uid": it["finding_uid"], "verdict": "rejected",
+             "reason": "比率列非时间列"}
+            for it in items
+        ])
+
+
+class _FakeConfig:
+    @classmethod
+    def from_default_model(cls):
+        return cls()
+
+
+def _write_artifact(tmp_path: Path) -> Path:
+    """构造一个含误报 finding 的 schema 产物文件（on_time_rate 时间列误判）。"""
+    p = tmp_path / "schema_findings.json"
+    p.write_text(json.dumps({
+        "findings": [
+            {"id": "NAM-001", "finding_uid": "schema:naming:t1:on_time_rate:NAM-001:abcd",
+             "source_finding_id": "NAM-001", "category": "naming", "severity": "info",
+             "object": {"table": "t1", "column": "on_time_rate", "layer": "DWD"},
+             "summary": "时间列 t1.on_time_rate 命名不规范", "evidence": {"column": "on_time_rate"}},
+            {"id": "UNI-001", "finding_uid": "schema:unique:t2:id:UNI-001:efgh",
+             "source_finding_id": "UNI-001", "category": "uniqueness", "severity": "high",
