@@ -0,0 +1,130 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dialect_registry 单测：能力位表 / 方言推导 / 未知类型显式报错 / 协议族别名。
+
+方案：docs/archive/delivered/dialect-convergence-plan.md 批次 2-G6；
+未知类型契约与别名表见接入扩展批次 0-B1。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.common import dialect_registry as dr
+
+
+def test_profile_fields_match_plan_matrix():
+    """能力位与计划文档 §三 的矩阵一致（引号 / COMMENT / info_schema / grain_fn）。"""
+    assert dr.profile_for("doris").ident_quote == "`"
+    assert dr.profile_for("mysql").ident_quote == "`"
+    assert dr.profile_for("duckdb").ident_quote == '"'
+    assert dr.profile_for("sqlite").ident_quote == '"'
+
+    assert dr.profile_for("doris").has_column_comment is True
+    assert dr.profile_for("mysql").has_column_comment is True
+    assert dr.profile_for("duckdb").has_column_comment is False
+    assert dr.profile_for("sqlite").has_column_comment is False
+
+    assert dr.profile_for("doris").info_schema == "restricted"
+    assert dr.profile_for("mysql").info_schema == "yes"
+    assert dr.profile_for("duckdb").info_schema == "no"
+
+    assert dr.profile_for("mysql").grain_fn == "DATE_FORMAT"
+    assert dr.profile_for("duckdb").grain_fn == "strftime"
+
+
+@pytest.mark.parametrize(
+    "db_type,expected",
+    [
+        ("doris", "doris"),
+        ("mysql", "mysql"),
+        ("duckdb", "duckdb"),
+        ("sqlite", "sqlite"),
+        ("starrocks", "starrocks"),
+        ("postgresql", "postgres"),
+        ("hologres", "postgres"),
+        ("mariadb", "mysql"),
+        ("sqlserver", "tsql"),
+        ("csv", "duckdb"),
+        ("excel", "duckdb"),
+        ("parquet", "duckdb"),
+        ("s3", "duckdb"),
+        ("oss", "duckdb"),
+        ("mongodb", "duckdb"),
+        ("redis", "duckdb"),
+        ("hbase", "duckdb"),
+    ],
+)
+def test_sqlglot_dialect(db_type, expected):
+    assert dr.sqlglot_dialect(db_type) == expected
+
+
+# 反面例子只用**根本不在任何批次计划里**的方言名。
+#
+# 这条已被路线图撞红四次（postgresql→批2、mongodb→批5、redis→批7），每次都是
+# 拿「当前还没实现」的类型当未注册样本，而它后来被实现了。改用计划外的库名：
+# cassandra / neo4j / elasticsearch 都不在 17 个目标也不在延后清单里。
+@pytest.mark.parametrize(
+    "db_type", ["cassandra", "neo4j", "elasticsearch", "clickhouse", ""]
+)
+def test_unknown_dialect_raises_instead_of_falling_back(db_type):
+    """未注册类型必须显式报错。
+
+    旧实现回退 mysql，会让只读护栏拿 MySQL 语法去判定别的方言的 SQL——
+    那是判错不是报错。回退口收窄到 profile_for_or_default（0-B1）。
+    """
+    with pytest.raises(dr.UnknownDialectError):
+        dr.profile_for(db_type)
+    # 既有 except ValueError 的调用点行为不变
+    assert issubclass(dr.UnknownDialectError, ValueError)
+    assert dr.profile_for_or_default(db_type).sqlglot_dialect == "mysql"
+
+
+def test_paired_identifier_quoting():
+    """T-SQL 的成对 [] 与引号转义——单字符 ident_quote 表达不了（0-B1）。"""
+    assert dr.quote_ident("mysql", "order") == "`order`"
+    assert dr.quote_ident("postgresql", "order") == '"order"'
+    assert dr.quote_ident("sqlserver", "order") == "[order]"
+    assert dr.quote_ident("sqlserver", "we]ird") == "[we]]ird]"
+    assert dr.quote_qualified("postgresql", "public.orders") == '"public"."orders"'
+    assert dr.quote_qualified("sqlserver", "dbo.orders") == "[dbo].[orders]"
+
+
+@pytest.mark.parametrize(
+    "db_type,physical,expected",
+    [
+        ("mysql", "bigint(20) unsigned", dr.NUMERIC),
+        ("mysql", "mediumtext", dr.TEXT),
+        ("mysql", "enum", dr.TEXT),
+        ("mysql", "datetime", dr.TIME),
+        ("postgresql", "character varying(50)", dr.TEXT),
+        ("postgresql", "int4", dr.NUMERIC),
+        ("postgresql", "int8", dr.NUMERIC),
+        ("postgresql", "timestamp without time zone", dr.TIME),
+        ("postgresql", "timestamptz", dr.TIME),
+        ("postgresql", "jsonb", dr.JSON),
+        ("sqlserver", "nvarchar(100)", dr.TEXT),
+        ("sqlserver", "datetime2", dr.TIME),
+        ("sqlserver", "money", dr.NUMERIC),
+        ("parquet", "HUGEINT", dr.NUMERIC),
+        ("mysql", "geometry", dr.OTHER),
+        ("mysql", "", dr.OTHER),
+    ],
+)
+def test_logical_type(db_type, physical, expected):
+    assert dr.logical_type(db_type, physical) == expected
+
+
+def test_dialect_of_ref_with_pure_parser():
+    """skill 侧 / 单测注入纯函数 parse_fn，避免拉连接层。"""
+    def fake_parse(ref: str) -> dict:
+        return {"type": ref.split("://", 1)[0]}
+
+    assert dr.dialect_of_ref("duckdb://data?source_type=csv", fake_parse) == "duckdb"
+    assert dr.dialect_of_ref("sqlite:///x.db", fake_parse) == "sqlite"
+    assert dr.dialect_of_ref("mysql://h/db", fake_parse) == "mysql"
+
+
+def test_dialect_of_ref_server_parser():
+    """默认走 db_connector.parse_db_ref（duckdb:// 带 query 串的完整解析）。"""
+    assert dr.dialect_of_ref("duckdb://D%3A%2Fdata%2Forders.csv?source_type=csv") == "duckdb"
+    assert dr.dialect_of_ref("sqlite:///tmp/a.db") == "sqlite"
+    assert dr.dialect_of_ref("doris://host:9030/biz") == "doris"
