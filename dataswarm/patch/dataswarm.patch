+    ),
+    "Q5 空值占比": (
+        "SELECT ROUND(100.0 * SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END) "
+        '/ COUNT(*), 4) AS pct FROM "{t}"'
