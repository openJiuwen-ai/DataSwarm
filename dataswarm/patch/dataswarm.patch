@@ -0,0 +1,122 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useMemo, useState } from 'react';
+import { X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import { metadataApi } from '../../api/metadataApi';
+import { useDataManagementStore } from '../../store/dataManagementStore';
+
+type NodeTableDetailState = { status: 'loading' } | { status: 'loaded'; ddl: string } | { status: 'error' };
+
+function NodeTableDetail({ db, table }: { db: string; table: string }) {
+  const { t } = useTranslation();
+  const [state, setState] = useState<NodeTableDetailState>({ status: 'loading' });
+  const [retryAttempt, setRetryAttempt] = useState(0);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setState({ status: 'loading' });
+    void metadataApi.getTable(db, table, controller.signal).then(
+      detail => {
+        if (!controller.signal.aborted) setState({ status: 'loaded', ddl: detail.ddl });
+      },
+      () => {
+        if (!controller.signal.aborted) setState({ status: 'error' });
+      },
+    );
+    return () => controller.abort();
+  }, [db, table, retryAttempt]);
+
+  return (
+    <section aria-busy={state.status === 'loading'}>
+      <h4>{t('dataManagement.nodeDetails.title')}</h4>
+      {state.status === 'loading' && (
+        <span className="dm-muted" role="status">
+          {t('dataManagement.nodeDetails.loading')}
+        </span>
+      )}
+      {state.status === 'loaded' && (state.ddl ? <pre>{state.ddl}</pre> : <span className="dm-muted">{t('dataManagement.nodeDetails.emptyDdl')}</span>)}
+      {state.status === 'error' && (
+        <div>
+          <p className="dm-muted" role="alert">
+            {t('dataManagement.nodeDetails.loadFailed')}
+          </p>
+          <button type="button" className="dm-btn" onClick={() => setRetryAttempt(attempt => attempt + 1)}>
+            {t('dataManagement.nodeDetails.retry')}
+          </button>
+        </div>
+      )}
+    </section>
+  );
+}
+
+export function NodeDetailCard({ table, onClose }: { table: string; onClose?: () => void }) {
+  const { t } = useTranslation();
+  const { lineage, selectedDb } = useDataManagementStore();
+
+  const downstream = useMemo(() => {
+    const m: Record<string, string[]> = {};
+    for (const e of lineage?.graph.edges ?? []) (m[e.from] ??= []).push(e.to);
+    return m[table] ?? [];
+  }, [lineage, table]);
+  const upstream = useMemo(() => {
+    const m: Record<string, string[]> = {};
+    for (const e of lineage?.graph.edges ?? []) (m[e.to] ??= []).push(e.from);
+    return m[table] ?? [];
+  }, [lineage, table]);
+
+  // 该表的产出任务（来自血缘节点 task_id，由任务 publish/执行时写入）
+  const taskId = useMemo(() => {
+    const node = (lineage?.graph.nodes ?? []).find((n) => n.table === table);
+    return node?.task_id ?? null;
+  }, [lineage, table]);
+
+  return (
+    <div className="dm-node-card">
+      <div className="dm-node-card-head">
+        <h3>{table}</h3>
+        {onClose && (
+          <button type="button" className="dm-node-card-close" onClick={onClose} aria-label={t('dataManagement.close')}>
+            <X size={14} aria-hidden="true" />
+          </button>
+        )}
+      </div>
+
+      <section>
+        <h4>{t('dataManagement.nodeDetails.outputTask')}</h4>
+        {taskId ? <span className="dm-node-tag">{taskId}</span> : <span className="dm-muted">{t('dataManagement.nodeDetails.noOutputTask')}</span>}
+      </section>
+
+      <section>
+        <h4>{t('dataManagement.nodeDetails.upstreamLabel')}</h4>
+        <div className="dm-node-card-tags">
+          {upstream.length ? (
+            upstream.map((tableName) => (
+              <span key={tableName} className="dm-node-tag">
+                {tableName}
+              </span>
+            ))
+          ) : (
+            <span className="dm-muted">{t('dataManagement.nodeDetails.noUpstream')}</span>
+          )}
+        </div>
+      </section>
+
+      <section>
+        <h4>{t('dataManagement.nodeDetails.downstreamLabel')}</h4>
+        <div className="dm-node-card-tags">
+          {downstream.length ? (
+            downstream.map((tableName) => (
+              <span key={tableName} className="dm-node-tag">
+                {tableName}
+              </span>
+            ))
+          ) : (
+            <span className="dm-muted">{t('dataManagement.nodeDetails.noDownstream')}</span>
+          )}
+        </div>
+      </section>
+
+      <NodeTableDetail key={JSON.stringify([selectedDb, table])} db={selectedDb} table={table} />
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/data-management/components/shared/TableColumnLineage.tsx b/jiuwenswarm/channels/web/frontend/src/features/data-management/components/shared/TableColumnLineage.tsx
