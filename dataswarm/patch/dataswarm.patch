+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import { useEffect } from 'react';
+import { useDataManagementRoute } from '../../multi-session/routing/useDataManagementRoute';
+import { useDataManagementStore } from './store/dataManagementStore';
+import { TableDetailPanel } from './components/shared/TableDetailPanel';
+import { TableTree } from './components/shared/TableTree';
+import { DbSelector } from './components/shared/DbSelector';
+import { ErrorBanner } from '../_shared/ui';
+import './dataManagement.css';
+
+export function DataManagementApp() {
+  const { t } = useTranslation();
+  const { route } = useDataManagementRoute();
+  const store = useDataManagementStore();
+
+  useEffect(() => {
+    void store.loadDatabases();
+  }, [store.loadDatabases]);
+
+  useEffect(() => {
+    if (!store.databases.length) return;
+    if (route.db && route.db !== store.selectedDb && store.databases.some((d) => d.name === route.db)) {
+      void store.selectDb(route.db);
+    } else if (!store.selectedDb) {
+      void store.selectDb(store.databases[0].name);
+    }
+  }, [route.db, store.databases, store.selectedDb, store.selectDb]);
+
+  return (
+    <div className="dm-shell">
+      <aside className="dm-side">
+        <div className="dm-brand">
+          <h1>{t('nav.data-management')}</h1>
+        </div>
+        <div className="dm-side-label">{t('dataManagement.database')}</div>
+        <div className="dm-side-block">
+          <DbSelector />
+        </div>
+        <div className="dm-side-label">{t('dataManagement.tablesHeading', { count: store.tables.length })}</div>
+        <TableTree />
+      </aside>
+
+      <main className="dm-main" data-tab={store.detailTab}>
+        <div className="dm-main-inner">
+          {store.error && <ErrorBanner message={store.error} onDismiss={store.clearError} />}
+          {store.loading && <div className="dm-loading">{t('dataManagement.loading')}</div>}
+          <TableDetailPanel />
+        </div>
+      </main>
+    </div>
+  );
+}
