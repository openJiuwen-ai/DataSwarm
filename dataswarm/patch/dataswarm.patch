+            self._write_json(200, payload)
+            return
+        # finding 明细惰性加载：GET /api/inspection/findings/<uid>?run_id=...
+        # 库优先（dw_inspection_findings），缺失时回退扫描该 run 的产物文件。
+        if dimension.startswith("findings/"):
+            uid = dimension[len("findings/"):].strip("/")
+            run_id = query.get("run_id", "")
+            if not uid or not run_id:
+                self._write_json(400, {"error": "run_id_and_uid_required"})
+                return
+            run_dir = self._inspection_run_dir(run_id)
+            if run_dir is None or not run_dir.is_dir():
+                self._write_json(404, {"error": "run_not_found", "run_id": run_id})
+                return
+            detail = self._finding_detail_service(run_id, run_dir, uid)
+            if detail is None:
+                self._write_json(404, {"error": "finding_not_found",
+                                       "run_id": run_id, "uid": uid})
+                return
+            self._write_json(200, detail)
+            return
+
+        dimension_prefixes = {
+            "schema": "schema_", "data": "data_", "zscore": "zscore_",
+            "lineage": "lineage_", "column-lineage": "column_lineage_",
+            "root-cause": "root_cause_", "metric": "metric_", "task": "task_",
+        }
+        if dimension in dimension_prefixes:
+            run_id = query.get("run_id", "")
+            if not run_id:
+                # 强制显式传 run_id，避免前端漏传时静默返回别的 run 数据（不串批次契约）。
+                self._write_json(400, {"error": "run_id_required"})
+                return
+            run_dir = self._inspection_run_dir(run_id)
+            if run_dir is None or not run_dir.is_dir():
+                self._write_json(404, {"error": "run_not_found", "run_id": run_id})
+                return
+            prefix = dimension_prefixes[dimension]
+            # 用 mtime 选最新产物，不依赖文件名字典序（防多批次/重试后缀时选错）。
+            candidates = list(run_dir.glob(f"{prefix}*.json"))
+            target = max(candidates, key=lambda p: p.stat().st_mtime) if candidates else None
+            if target is None:
+                self._write_json(404, {"error": "artifact_not_found", "dimension": dimension,
+                                       "run_id": run_id})
+                return
+            payload = self._read_inspection_json(target)
+            if payload is None:
+                self._write_json(404, {"error": "artifact_not_found", "dimension": dimension,
+                                       "run_id": run_id})
+                return
+            self._write_json(200, payload)
+            return
+        self._write_json(404, {"error": "not_found"})
+
+    @classmethod
+    def _inspection_db_allowed(cls, path: Path) -> bool:
+        if path.suffix.lower() not in {".db", ".sqlite", ".sqlite3"}:
+            return False
+        allowed_roots = [
+            cls.inspection_root.resolve(),
+            cls.workspace_root.resolve(),
+            cls.inspection_data_root.resolve(),
+        ]
+        for root in allowed_roots:
+            try:
+                if os.path.commonpath([str(root), str(path.resolve())]) == str(root):
+                    return True
+            except ValueError:
+                continue
+        return False
+
+    @classmethod
+    def _default_inspection_baseline(cls, db: Path) -> Path | None:
+        baseline_name = cls._TRAINING_BASELINE_NAMES.get(db.name.lower())
+        if not baseline_name:
+            return None
+        candidate = db.with_name(baseline_name)
+        return candidate if candidate.is_file() and cls._inspection_db_allowed(candidate) else None
+
+    @staticmethod
+    def _resolve_inspection_db(raw: str, workspace_id: str | None = None):
+        """解析巡检业务库引用：body.db（显式）> 当前工作空间业务库 > config default_db。
+
+        返回 (db_ref, None) 或 (None, error)。
+        - 本地 sqlite 裸路径：需存在且在 allowed roots 内。
+        - db-ref（doris:// / mysql://）：host 需与 config 对应段一致（防任意主机），
+          且经 validate_ref_in_workspace 做 workspace+role 双重校验（决策八-2）。
+        - 空串：当前工作空间业务库（决策七），多工作空间缺上下文时大声失败。
+          绝不回退到本地 training_warehouse.db。
+        """
+        raw = (raw or "").strip()
+        if raw:
+            if "://" in raw:
+                try:
+                    spec = db_connector.parse_db_ref(raw)
+                except Exception:
+                    return None, "invalid_db_ref"
+                if spec["type"] == "sqlite":
+                    p = Path(spec["path"]).expanduser().resolve()
+                    if not p.is_file() or not _SpaStaticHandler._inspection_db_allowed(p):
+                        return None, "db_not_allowed"
+                    return str(p), None
+                # doris/mysql：只放行与 config 同主机的引用
+                cfg = db_connector._read_config_section(spec["type"])
+                if not (spec.get("host") and spec["host"] == cfg.get("host")):
+                    return None, "db_ref_not_allowed"
+                # workspace+role 校验（决策八-2）：显式 ref 必须是当前工作空间业务库
+                try:
+                    workspace_context.validate_ref_in_workspace(workspace_id, "business", raw)
+                except workspace_context.WorkspaceContextError as exc:
+                    return None, getattr(exc, "code", "db_ref_not_allowed")
+                except Exception:
+                    return None, "db_ref_not_allowed"
+                return raw, None
+            p = Path(raw).expanduser().resolve()
+            if p.is_file() and _SpaStaticHandler._inspection_db_allowed(p):
+                return str(p), None
+            return None, "db_not_allowed"
+        try:
+            ref = workspace_context.business_db_ref(workspace_id)
+        except workspace_context.WorkspaceContextRequired as exc:
+            return None, exc.code  # 多工作空间缺上下文：大声失败，列可用工作空间
+        except workspace_context.WorkspaceBusinessNotBound as exc:
+            # UI 工作空间未绑定业务库：大声失败，不回退全局 default_db（防串库）
+            return None, exc.code
+        except Exception:
+            ref = None
+        if not ref:
+            try:
+                ref = db_connector.default_db_ref()
+            except Exception:
+                return None, "default_db_not_configured"
+        if not ref:
+            return None, "default_db_not_configured"
+        return ref, None
+
+    @staticmethod
+    def _inspection_meta_ref(workspace_id: str | None = None):
+        """解析巡检落库/查询的目标元数据库（多工作空间：当前工作空间元库）。
+
+        返回 (meta_ref, None) 或 (None, error_code)。
+        多工作空间缺上下文返回 WORKSPACE_CONTEXT_REQUIRED（决策八-1），不静默兜底。
+        """
+        try:
+            ref = workspace_context.metadata_db_ref(workspace_id)
+            if ref:
+                return ref, None
+        except workspace_context.WorkspaceContextRequired as exc:
+            return None, exc.code
+        except Exception as exc:
+            _SpaStaticHandler.logger.debug("[inspection] 工作空间元库解析失败 workspace_id=%s，回退全局元库: %s",
+                                            workspace_id, exc)
+            pass
+        try:
+            ref = db_connector.metadata_db_ref()
+        except Exception:
+            ref = None
+        return (ref, None) if ref else (None, "metadata_db_not_configured")
+
+    def _handle_inspection_api_post(self, parsed) -> None:
+        path = parsed.path.rstrip("/")
+        # 修复方案生成：调 dw-anomaly-fixer plan（只读，同步等待 <30s）。
+        # body: { run_id, db }。后端从该 run 的 summary.json 取 schema_findings/data_findings 路径。
+        if path == "/api/inspection/fix/plan":
+            self._handle_fix_plan_post(parsed)
+            return
+        if path == "/api/inspection/fix/context":
+            self._handle_fix_context_post(parsed)
+            return
+        if path == "/api/inspection/fix/execute":
+            self._handle_fix_execute_post(parsed)
+            return
+        # 巡检结果落库：POST /api/inspection/persist（方案 §4）
+        # body: {kind:"run"|"findings", schema_version, payload}
+        if path == "/api/inspection/persist":
+            self._handle_inspection_persist_post(parsed)
+            return
+        # 修复记录落库：POST /api/inspection/fix/persist（方案 §4，fix.py 的 _persist_fix_rows 上收）
+        # body: {schema_version, run_id, fixes:[tuple...]}
+        if path == "/api/inspection/fix/persist":
+            self._handle_inspection_fix_persist_post(parsed)
+            return
+        # 补绑会话：POST /api/inspection/runs/{run_id}/bind-session，body { session_id }
+        # 对话触发巡检时 env 注入不可靠，前端在治理页选中该 run 且 manifest 无 session_id 时补绑，
+        # 使修复能切回发起会话复用上下文。
+        if path.startswith("/api/inspection/runs/") and path.endswith("/bind-session"):
+            run_id = path.split("/")[4]
+            try:
+                length = int(self.headers.get("Content-Length", "0") or "0")
+                body = json.loads(self.rfile.read(length).decode("utf-8")) if length else {}
+            except ValueError:
+                self._write_json(400, {"error": "invalid_json"})
+                return
+            sid = str(body.get("session_id", "")).strip()
+            if not run_id or not self._safe_run_id(run_id):
+                self._write_json(400, {"error": "invalid_run_id"})
+                return
+            run_dir = self._inspection_run_dir(run_id)
+            manifest_path = (run_dir / "manifest.json") if run_dir else None
+            manifest = self._read_inspection_json(manifest_path) if manifest_path else None
+            if not isinstance(manifest, dict) or not sid:
+                self._write_json(400, {"error": "bad_bind_session_request"})
+                return
+            manifest["session_id"] = sid
+            self._write_inspection_json(manifest_path, manifest)
+            # 批次列表以 dw_inspection_runs 为准，DB 侧同步补绑（失败仅告警，manifest 已落）
+            try:
+                from jiuwenswarm.channels.web import inspection_service
+                meta_ref, meta_err = self._inspection_meta_ref(
+                    (self._parse_query(parsed.query).get("workspace_id") or "").strip() or None)
+                if not meta_err and meta_ref:
+                    inspection_service.bind_session(meta_ref, run_id, sid)
+            except Exception as exc:  # noqa: BLE001 —— 补绑失败不阻塞查看
+                self.logger.warning("[inspection][warn] 会话补绑落库失败 run=%s: %s", run_id, exc)
+            self._write_json(200, {"run_id": run_id, "session_id": sid})
+            return
+        if path != "/api/inspection/runs":
+            self._write_json(404, {"error": "not_found"})
+            return
+        try:
+            length = int(self.headers.get("Content-Length", "0") or "0")
+            body = json.loads(self.rfile.read(length).decode("utf-8")) if length else {}
+        except ValueError:
+            self._write_json(400, {"error": "invalid_json"})
+            return
+        db_ref, db_err = self._resolve_inspection_db(str(body.get("db", "")),
+                                                     str(body.get("workspace_id", "")).strip() or None)
+        if db_err:
+            status = 403 if db_err in ("db_not_allowed", "db_ref_not_allowed",
+                                       "DB_REF_NOT_ALLOWED") else 400
+            self._write_json(status, {"error": db_err})
+            return
+        workspace_id = str(body.get("workspace_id", "")).strip()
+        baseline_db = None
+        # 仅本地 sqlite 需要干净基线（doris/mysql 由 schema_inspect 自举基线快照）。
+        if "://" not in db_ref:
+            baseline_db_raw = str(body.get("baseline_db", "")).strip()
+            baseline_db = Path(baseline_db_raw).expanduser().resolve() if baseline_db_raw else None
+            if baseline_db and (not baseline_db.is_file() or not self._inspection_db_allowed(baseline_db)):
+                self._write_json(403, {"error": "baseline_db_not_allowed"})
+                return
+            baseline_path = self.inspection_root / "baselines" / f"{Path(db_ref).stem}.json"
+            if baseline_db is None and not baseline_path.is_file():
+                self._write_json(400, {"error": "baseline_db_required_for_first_run"})
+                return
+        session_id = str(body.get("session_id", "")).strip()  # 关联发起巡检的会话，供修复时复用上下文
+
+        self._refresh_inspection_processes()
+        # 整体进锁：active 检查 + run_id 生成 + manifest 写入 + Popen + 进程登记原子完成，
+        # 消除"两并发 POST 同时通过 active 检查、同时起进程"的 TOCTOU 竞态（§6 最多一个活动巡检）。
+        with self.inspection_lock:
+            active = [rid for rid, process in self.inspection_processes.items()
+                      if process.poll() is None]
+            if active:
+                self._write_json(409, {"error": "inspection_already_running", "run_id": active[0]})
+                return
+            run_id = time.strftime("%Y%m%d_%H%M%S") + "_" + uuid.uuid4().hex[:8]
+            run_dir = self._inspection_run_dir(run_id)
+            if run_dir is None:
+                self._write_json(400, {"error": "invalid_run_id"})
+                return
+            run_dir.mkdir(parents=True, exist_ok=False)
+            started_at = timeutil.now_iso()
+            manifest = {"run_id": run_id, "status": "queued", "db": db_ref,
+                        "workspace_id": workspace_id,
+                        "started_at": started_at,
+                        "artifact_dir": str(run_dir),
+                        "governance_url": f"/governance/overview?run_id={run_id}",
+                        "session_id": session_id,
+                        "errors": []}
+            self._write_inspection_json(run_dir / "manifest.json", manifest)
+            # 起跑登记：dw_inspection_runs 落 queued 行（列表以库为准，run_pipeline
+            # 起来后会覆盖为 running / 终态）；登记失败不阻断发起。
+            try:
+                from jiuwenswarm.channels.web import inspection_service
+                meta_ref, meta_err = self._inspection_meta_ref(workspace_id or None)
+                if meta_err or not meta_ref:
+                    raise RuntimeError(meta_err or "metadata_db_not_configured")
+                inspection_service.persist_run(
+                    {"meta": {"run_id": run_id, "db": db_ref, "run_at": started_at,
+                              "session_id": session_id, "workspace_id": workspace_id,
+                              "artifact_dir": str(run_dir)},
+                     "status": "queued"},
+                    meta_db_ref=meta_ref)
+            except Exception as exc:  # noqa: BLE001 —— 登记失败仅告警
+                self.logger.warning("[inspection][warn] 起跑登记失败 run=%s: %s", run_id, exc)
+            package_root = _get_package_dir().parent.parent
+            pipeline = package_root / "resources" / "agent" / "workspace" / "skills" / \
+                "dw-inspection-orchestrator" / "scripts" / "run_pipeline.py"
+            cmd = [sys.executable, str(pipeline), "--db", db_ref, "--run-id", run_id,
+                   "--artifact-root", str(self.inspection_root), "--zscore-no-scan-all"]
+            # LLM 解读默认开（与 run_pipeline --ai-report 默认值一致）；
+            # query 参数 ai=0/false 显式关闭
+            if self._parse_query(parsed.query).get("ai") in ("0", "false"):
+                cmd += ["--no-ai-report"]
+            if session_id:
+                cmd += ["--session-id", session_id]
+            if workspace_id:
+                cmd += ["--workspace-id", workspace_id]
+            if baseline_db:
+                cmd += ["--baseline-db", str(baseline_db)]
+            stdout_file = (run_dir / "stdout.log").open("w", encoding="utf-8")
+            stderr_file = (run_dir / "stderr.log").open("w", encoding="utf-8")
+            child_env = os.environ.copy()
+            if session_id:
+                child_env["JIUWENSWARM_SESSION_ID"] = session_id
+            if workspace_id:
+                child_env["JIUWENSWARM_WORKSPACE_ID"] = workspace_id
+            try:
+                process = subprocess.Popen(
+                    cmd, stdout=stdout_file, stderr=stderr_file, cwd=str(self.project_root),
+                    env=child_env,
+                    creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+                )
+            except Exception:
+                # Popen 失败：关 fd、改 manifest 为 failed，不留下挂起的 queued 批次
+                # （DB 侧同步收敛，否则要等超时才从 running/queued 翻面）。
+                stdout_file.close()
+                stderr_file.close()
+                manifest["status"] = "failed"
+                manifest["finished_at"] = timeutil.now_iso()
+                manifest["errors"] = [f"failed to start pipeline: {sys.exc_info()[1]}"]
+                self._write_inspection_json(run_dir / "manifest.json", manifest)
+                try:
+                    from jiuwenswarm.channels.web import inspection_service
+                    meta_ref, meta_err = self._inspection_meta_ref(workspace_id or None)
+                    if not meta_err and meta_ref:
+                        inspection_service.persist_run(
+                            {"meta": {"run_id": run_id, "db": db_ref, "run_at": started_at,
+                                      "session_id": session_id, "workspace_id": workspace_id,
+                                      "artifact_dir": str(run_dir)},
+                             "status": "failed",
+                             "finished_at": manifest["finished_at"],
+                             "errors": manifest["errors"]},
+                            meta_db_ref=meta_ref)
+                except Exception as exc:  # noqa: BLE001 —— 收敛失败仅告警
+                    self.logger.warning("[inspection][warn] 起跑失败收敛失败 run=%s: %s", run_id, exc)
+                self._write_json(500, {"error": "pipeline_start_failed",
+                                       "run_id": run_id, "detail": str(sys.exc_info()[1])})
+                return
+            finally:
+                stdout_file.close()
+                stderr_file.close()
+            self.inspection_processes[run_id] = process
+        self._write_json(202, {"run_id": run_id, "status": "queued",
+                               "session_id": session_id,
+                               "manifest": f"/api/inspection/runs/{run_id}/manifest",
+                               "governance_url": f"/governance/overview?run_id={run_id}"})
+
+    def _handle_inspection_persist_post(self, parsed) -> None:
+        """POST /api/inspection/persist —— 巡检结果落库（方案 §4）。
+
+        body: {kind:"run"|"findings", schema_version:1, payload}
+        kind=run → inspection_service.persist_run(payload, meta_db_ref=...)
+        kind=findings → 批量 findings 落库（payload 含 run_id + findings 列表）
+        """
+        try:
+            body = self._read_body_json()
+        except ValueError:
+            self._write_json(400, {"error": "invalid_json"})
+            return
+        sv = body.get("schema_version")
+        if sv != 1:
+            self._write_json(400, {"error": "unsupported_schema_version", "supported": [1]})
+            return
+        kind = body.get("kind", "")
+        payload = body.get("payload") or {}
+        try:
+            from jiuwenswarm.channels.web import inspection_service
+            meta_ref, meta_err = self._inspection_meta_ref(
+                str(body.get("workspace_id", "")).strip() or None)
+            if meta_err:
+                self._write_json(400, {"error": meta_err})
+                return
+            if kind == "run":
+                out = inspection_service.persist_run(payload, meta_db_ref=meta_ref)
+            else:
+                self._write_json(400, {"error": "unknown_kind", "kind": kind})
+                return
+            status = 200 if out.get("status") == "ok" else 500
+            self._write_json(status, out)
+        except Exception as exc:
+            self._write_json(500, {"error": "internal_error", "detail": str(exc)})
+
+    def _handle_inspection_fix_persist_post(self, parsed) -> None:
+        """POST /api/inspection/fix/persist —— 修复记录落库（方案 §4，fix.py 的 _persist_fix_rows 上收）。
+
+        body: {schema_version:1, run_id, fixes:[tuple...]}
+        """
+        try:
+            body = self._read_body_json()
+        except ValueError:
+            self._write_json(400, {"error": "invalid_json"})
+            return
+        if body.get("schema_version") != 1:
+            self._write_json(400, {"error": "unsupported_schema_version", "supported": [1]})
+            return
+        fixes = body.get("fixes") or []
+        if not isinstance(fixes, list):
+            self._write_json(400, {"error": "fixes_must_be_list"})
+            return
+        try:
+            from jiuwenswarm.channels.web import inspection_service
+            meta_ref, meta_err = self._inspection_meta_ref(
+                str(body.get("workspace_id", "")).strip() or None)
+            if meta_err:
+                self._write_json(400, {"error": meta_err})
+                return
+            out = inspection_service.persist_fixes(meta_ref, [tuple(f) for f in fixes])
+            status = 200 if out.get("status") == "ok" else 500
+            self._write_json(status, out)
+        except Exception as exc:
+            self._write_json(500, {"error": "internal_error", "detail": str(exc)})
+
+    def _handle_fix_plan_post(self, parsed) -> None:
+        """POST /api/inspection/fix/plan —— 调 dw-anomaly-fixer plan 生成修复方案。
+
+        body: { run_id, db }。从该 run 的 summary.json 取 schema_findings/data_findings 路径，
+        设 child_env 把 fix_plan 落到 runs/<run_id>/ 下（fix.py 读 JIUWENSWARM_INSPECTION_ARTIFACT_DIR）。
+        plan 是同步只读（<30s），subprocess.run 等待后直接返回 plan 结果。
+        """
+        try:
+            length = int(self.headers.get("Content-Length", "0") or "0")
+            body = json.loads(self.rfile.read(length).decode("utf-8")) if length else {}
+        except ValueError:
+            self._write_json(400, {"error": "invalid_json"})
+            return
+        run_id = str(body.get("run_id", "")).strip()
+        if not run_id or not self._safe_run_id(run_id):
+            self._write_json(400, {"error": "invalid_run_id"})
+            return
+        run_dir = self._inspection_run_dir(run_id)
+        if run_dir is None or not run_dir.is_dir():
+            self._write_json(404, {"error": "run_not_found", "run_id": run_id})
+            return
+        # 从 summary.json 取 findings 路径（run_pipeline 落盘时带 schema_findings/data_findings）
+        summary = self._read_inspection_json(run_dir / "summary.json")
+        if not isinstance(summary, dict):
+            self._write_json(404, {"error": "summary_not_found", "run_id": run_id})
+            return
+        schema_findings = summary.get("schema_findings")
+        data_findings = summary.get("data_findings")
+        if not schema_findings and not data_findings:
