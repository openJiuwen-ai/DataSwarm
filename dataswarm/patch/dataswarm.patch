+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""inspection_service.py — 巡检结果落库服务端层（方案 §4）。
+
+由 skill 目录的 `inspection_persist.py` + `fix.py` 的 `_persist_fix_rows` 上收而来
+（方案 docs/skill-cli-web-api-plan.md §4）。web 后端不再 `sys.path` 插入 skill 目录
+import 脚本，改为调本服务端模块。
+
+依赖（均已上收至 jiuwenswarm.common，方案 §7.1）：
+    - jiuwenswarm.common.db_connector（连接层 + 元数据读写）
+    - jiuwenswarm.common.digest（canonical_json）
+    - jiuwenswarm.common.finding_identity（db_identity / annotate_findings）
+
+设计约束（沿用 inspection_persist）：
+    - 只依赖 db_connector；目标库 = 系统元数据库 metadata_db。
+    - dw_inspection_runs 是巡检状态真相源：同 run_id 两次写入（起跑 running →
+      终态 success/failed），必须整行替换语义（见 _runs_insert_sql 方言分支）。
+    - 失败不抛给巡检主流程：返回 {'status': 'ok'|'failed'}，由调用方把
+      persistence_status 写进 result/manifest；文件始终先落盘可重放。
+    - 列名含关键字（table/column），SQL 一律反引号包裹。
+    - 批量请求逐行收集失败，不宣称跨方言整批事务回滚（§7.5 方言纪律）。
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.common import db_connector as dc
+from jiuwenswarm.common.digest import canonical_json
+from jiuwenswarm.common.finding_identity import db_identity
+
+logger = logging.getLogger(__name__)
+
+# ==========================================================================
+# SQL 模板
+# ==========================================================================
+# dw_inspection_runs 是巡检状态的真相源：run_pipeline 起跑写 running 行，
+# 结束时同 run_id 再写终态行 —— 两次写入必须整行替换语义。
+# sqlite 主键冲突会硬失败 → INSERT OR REPLACE；mysql 用 REPLACE；doris UNIQUE KEY
+# 裸 INSERT 即整行替换（沿用原有约定）。
+RUNS_COLUMNS = ("`run_id`,`db_ref_alias`,`db_identity`,`db_type`,`status`,`persistence_status`,"
+                "`started_at`,`finished_at`,`artifact_dir`,`session_id`,`workspace_id`,"
+                "`health_scores_json`,`summary_json`,`created_at`,`db_name`,`inspected_tables_json`,"
+                "`report_start`,`report_end`,`reported_at`")
+
+_RUNS_SQL_BODY = f"`dw_inspection_runs` ({RUNS_COLUMNS}) VALUES"
+
+# 列表查询列（供 list_runs 用；顺序即映射口径）
+_LIST_RUN_COLS = ("`run_id`,`status`,`db_ref_alias`,`db_name`,`started_at`,`finished_at`,"
+                  "`session_id`,`workspace_id`,`artifact_dir`,`summary_json`")
+
+# running/queued 超过该时长仍无终态 → 判超时失败（读时收敛，CURD 无后台任务）。
+# 对话触发的巡检受 bash 工具 1800s 上限约束，正常巡检远小于此值。
+RUN_TIMEOUT_S = int(os.environ.get("JIUWENSWARM_INSPECTION_STALE_S", "1800") or 1800)
+
+
+def _placeholder(meta_db_ref: str) -> str:
+    """写路径占位符跨方言：sqlite 用 ?，doris/mysql(pymysql) 用 %s（同 query_findings 口径）。"""
+    return "?" if _meta_db_type(meta_db_ref) == "sqlite" else "%s"
+
+
+def _values_clause(meta_db_ref: str, n_cols: int) -> str:
+    return "(" + ",".join([_placeholder(meta_db_ref)] * n_cols) + ")"
+
+
+def _insert_verb(meta_db_ref: str) -> str:
+    """整行替换语义的 INSERT 动词（重放幂等）：
+
+    sqlite 主键冲突会硬失败 / mysql 同键报错 → 显式 replace；
+    doris UNIQUE KEY 模型下裸 INSERT 即整行替换。
+    """
+    return {"sqlite": "INSERT OR REPLACE INTO", "mysql": "REPLACE INTO"}.get(
+        _meta_db_type(meta_db_ref), "INSERT INTO")
+
+
+def _runs_insert_sql(meta_db_ref: str) -> str:
+    """按元库方言取 run 行写入 SQL（起跑 running → 终态两次写入，见 RUNS_COLUMNS 注释）。"""
+    return (f"{_insert_verb(meta_db_ref)} {_RUNS_SQL_BODY}"
+            f" {_values_clause(meta_db_ref, len(RUNS_COLUMNS.split(',')))}")
+
+
+_FINDINGS_COLUMNS = ("`run_id`,`finding_uid`,`source_finding_id`,`finding_fingerprint`,`dimension`,"
+                     "`severity`,`category`,`layer`,`table`,`column`,`task_id`,`summary`,"
+                     "`fix_hint_strategy`,`fix_hint_risk`,`capability_json`,`detail_json`,"
+                     "`evidence_json`,`reported_at`,`llm_verdict`,`llm_reason`,`ai_summary`")
+
+
+def _findings_insert_sql(meta_db_ref: str) -> str:
+    """findings 批量写入 SQL（键 = run_id+finding_uid，同键整行替换 → 重放幂等）。"""
+    return (f"{_insert_verb(meta_db_ref)} `dw_inspection_findings` ({_FINDINGS_COLUMNS})"
+            f" VALUES {_values_clause(meta_db_ref, len(_FINDINGS_COLUMNS.split(',')))}")
+
+FIXES_COLS = ("`run_id`,`plan_id`,`execution_id`,`item_id`,`finding_uid`,`plan_path`,"
+              "`execution_path`,`strategy`,`risk`,`fix_sql`,`rollback_sql`,`sql_digest`,"
+              "`status`,`applied_at`,`affected_rows`,`table`,`column`,`confirmed_by`,"
+              "`requested_by`,`note`")
+
+_FINDING_COLS = ("`finding_uid`,`source_finding_id`,`finding_fingerprint`,`dimension`,"
+                 "`severity`,`category`,`layer`,`table`,`column`,`task_id`,`summary`,"
+                 "`fix_hint_strategy`,`fix_hint_risk`,`capability_json`,`detail_json`,"
+                 "`evidence_json`,`reported_at`,`llm_verdict`,`llm_reason`,`ai_summary`")
+
+# 与 run_pipeline 的 result 键严格同源（去 _findings 后缀）
+FINDING_DIMENSION_KEYS = (
+    "schema", "data", "zscore", "lineage", "column_lineage",
+    "root_cause", "metric", "task",
+)
+
+# 方案 §4 版本化请求 schema
+SCHEMA_VERSION = 1
+
+
+# ==========================================================================
+# 内部辅助
+# ==========================================================================
+def _meta_db_type(db_ref: str) -> str:
+    try:
+        return dc.parse_db_ref(db_ref).get("type") or "sqlite"
+    except Exception:
+        return "sqlite"
+
+
+def _findings_rows(result: dict) -> tuple[list[tuple], int]:
+    """从 result 的各 *_findings 产物抽行。UID 缺失的行跳过并计数（旧批次重放兼容）。"""
+    rows: list[tuple] = []
+    skipped = 0
+    run_id = result["meta"]["run_id"]
+    reported_at = str(result["meta"].get("run_at") or "")
+    for key in FINDING_DIMENSION_KEYS:
+        p = result.get(f"{key}_findings")
+        if not p:
+            continue
+        try:
+            payload = json.loads(Path(p).read_text(encoding="utf-8"))
+        except Exception as exc:  # noqa: BLE001 —— 旧批次产物缺失/损坏跳过该维度
+            logger.warning("[inspection] findings 产物解析失败，跳过 run=%s path=%s: %s", run_id, p, exc)
+            continue
+        for f in payload.get("findings", []):
+            uid = f.get("finding_uid")
+            if not uid:
+                skipped += 1
+                continue
+            obj = f.get("object") or {}
+            hint = f.get("fix_hint") or {}
+            ev = f.get("evidence")
+            det = f.get("detail")
+            cap_json = f.get("capability") or obj.get("capability")
+            rows.append((
+                run_id, str(uid), str(f.get("source_finding_id") or f.get("id") or ""),
+                str(f.get("finding_fingerprint") or ""), key,
+                str(f.get("severity") or ""), str(f.get("category") or ""),
+                str(obj.get("layer") or ""), str(obj.get("table") or ""),
+                str(obj.get("column") or ""), str(obj.get("task_id") or ""),
+                str(f.get("summary") or "")[:1000],
+                str(hint.get("strategy") or "")[:60], str(hint.get("risk") or "")[:20],
+                canonical_json(cap_json) if cap_json is not None else None,
+                canonical_json(det) if det is not None else None,
+                canonical_json(ev) if ev is not None else None,
+                reported_at,
+                str(f.get("llm_verdict") or "")[:20],
+                str(f.get("llm_reason") or "")[:1000],
+                str(f.get("ai_summary") or "")[:1000] or None,
+            ))
+    return rows, skipped
+
+
+def _parse_finding_row(r: dict) -> dict:
+    """行 → 与检查器产物同形的 finding 结构（下游 build_item 直接可吃）。"""
+    out: dict = {
+        "id": r.get("source_finding_id") or "",
+        "finding_uid": r.get("finding_uid"),
+        "source_finding_id": r.get("source_finding_id"),
+        "finding_fingerprint": r.get("finding_fingerprint"),
+        "dimension": r.get("dimension"),
+        "severity": r.get("severity"), "category": r.get("category"),
+        "object": {"table": r.get("table"), "column": r.get("column"),
+                   "task_id": r.get("task_id"), "layer": r.get("layer")},
+        "summary": r.get("summary"), "reported_at": r.get("reported_at"),
+        "fix_hint": {"strategy": r.get("fix_hint_strategy"),
+                     "risk": r.get("fix_hint_risk")},
+        "llm_verdict": r.get("llm_verdict"), "llm_reason": r.get("llm_reason"),
+        "ai_summary": r.get("ai_summary"),
+    }
+    strat = (r.get("fix_hint_strategy") or "")
+    out["fixable"] = bool(strat) and strat not in ("none", "investigate", "timeseries")
+    for src, dst in (("capability_json", "capability"),
+                     ("detail_json", "detail"), ("evidence_json", "evidence")):
+        v = r.get(src)
+        if v:
+            try:
+                out[dst] = json.loads(v)
+            except Exception:
+                out[dst] = v
+    return out
+
+
+# ==========================================================================
+# 公开 API（service 层，供 app_web 端点调用）
+# ==========================================================================
+# LLM 留痕三列（复核 verdict/reason + AI 解读 summary；双方言 DDL 已加；运行期幂等 ALTER）
+_REVIEW_COLUMNS = (("llm_verdict", "VARCHAR(20)"), ("llm_reason", "VARCHAR(1000)"),
+                   ("ai_summary", "VARCHAR(1000)"))
+# dw_inspection_runs 增量列（起跑登记 + 按工作空间过滤；加列前落库的历史行为 NULL）
+_RUNS_EXTRA_COLUMNS = (("workspace_id", "VARCHAR(100)"),)
+_runs_columns_ensured: set[str] = set()
+
+
+def _add_missing_columns(meta_db_ref: str, table: str, columns) -> bool:
+    """幂等补列：dc.schema 探测缺列 → ALTER TABLE ADD COLUMN。
+
+    对齐 lineage/writer.ensure_schema 先例；ALTER 无 ENGINE 子句保持跨方言可移植。
+    失败只告警不抛出（persist 永不向上抛的契约内），返回是否全部就绪。
+    """
+    try:
+        cols = {c.get("name") for c in dc.schema(meta_db_ref, table).get("columns", [])}
+        is_sqlite = _meta_db_type(meta_db_ref) == "sqlite"
+        for name, typ in columns:
+            if name in cols:
+                continue
+            ctype = "TEXT" if is_sqlite else typ
+            dc.execute(meta_db_ref,
+                       f"ALTER TABLE `{table}` ADD COLUMN `{name}` {ctype} NULL",
+                       commit=True)
+        return True
+    except Exception as exc:  # noqa: BLE001 —— 加列失败不阻断落库
+        logger.warning("[ensure][warn] %s 加列失败: %s", table, exc)
+        return False
+
+
+def ensure_review_columns(meta_db_ref: str) -> None:
+    """幂等加 llm_verdict/llm_reason/ai_summary 列到 dw_inspection_findings（首装库 no-op）。"""
+    _add_missing_columns(meta_db_ref, "dw_inspection_findings", _REVIEW_COLUMNS)
+
+
+def ensure_runs_columns(meta_db_ref: str) -> bool:
+    """幂等加 workspace_id 列到 dw_inspection_runs（首装库 no-op），返回是否就绪。
+
+    列表接口高频轮询，进程内缓存成功结果避免每次探测表结构；失败不缓存，下次重试。
+    """
+    key = f"{meta_db_ref}|dw_inspection_runs"
+    if key in _runs_columns_ensured:
+        return True
+    if not _add_missing_columns(meta_db_ref, "dw_inspection_runs", _RUNS_EXTRA_COLUMNS):
+        return False
+    _runs_columns_ensured.add(key)
+    return True
+
+
+def persist_run(result: dict, *, meta_db_ref: str) -> dict:
+    """把 run_pipeline 的 result 落库。永不向上抛异常（巡检主流程无关性保证）。
+
+    Args:
+        result: run_pipeline 的完整 result dict（含 meta/各维度 findings 产物路径）
+        meta_db_ref: 元数据库 db_ref（如 doris://meta 或 sqlite://path）
+    Returns:
+        {status, runs, findings, uid_missing_skipped, db} 或 {status:failed, reason}
+    """
+    meta = result.get("meta", {})
+    # skill 侧 naive 时间戳落库前补本地 offset（Phase 3.4：不改 skill，边界归一）
+    for key in ("run_at", "report_start", "report_end"):
+        if key in meta:
+            meta[key] = _normalize_ts(str(meta.get(key) or ""))
+    if result.get("finished_at"):
+        result["finished_at"] = _normalize_ts(str(result["finished_at"]))
+    run_id = str(meta.get("run_id") or "")
+    if not run_id:
+        return {"status": "failed", "reason": "result.meta.run_id 为空"}
+    db_ref_for_run = str(meta.get("db") or "")
+    db_name = ""
+    m = dc.parse_db_ref(db_ref_for_run) if "://" in db_ref_for_run else None
+    if m:
+        db_name = str(m.get("database") or "")
+    inspected = json.dumps(meta.get("inspected_tables")
+                           or result.get("data_summary", {}).get("inspected_tables") or [],
+                           ensure_ascii=False)
+    try:
+        ident_str = db_identity(db_ref_for_run) if db_ref_for_run else ""
+    except Exception:
+        ident_str = ""
+    run_row = (
+        run_id,
+        str(meta.get("db_ref_alias") or db_ref_for_run)[:200],
+        ident_str,
+        str(m.get("type")) if m else "sqlite",
+        str(result.get("status") or ""),
+        "ok",
+        str(meta.get("run_at") or ""),
+        str(result.get("finished_at") or ""),
+        str(result.get("stage_artifact_dir") or meta.get("artifact_dir") or ""),
+        str(meta.get("session_id") or ""),
+        str(meta.get("workspace_id") or ""),
+        canonical_json(result.get("health_scores") or {}),
+        canonical_json({k: v for k, v in result.items()
+                        if k.endswith("_summary") or k in ("errors", "warnings", "status")}),
+        str(meta.get("run_at") or ""),
+        db_name, inspected,
+        str(meta.get("report_start") or ""), str(meta.get("report_end") or ""),
+        str(meta.get("run_at") or ""),
+    )
+    if not ensure_runs_columns(meta_db_ref):
+        return {"status": "failed", "reason": "dw_inspection_runs 缺 workspace_id 列且补列失败"}
+    try:
+        ensure_review_columns(meta_db_ref)
+        rows, skipped = _findings_rows(result)
+        conn, meta_db = dc._acquire(meta_db_ref, read_only=False)
+        cur = dc._cursor(conn)
+        cur.execute(_runs_insert_sql(meta_db_ref), run_row)
+        n_runs = 1
+        n_findings = 0
+        if rows:
+            # 分批提交（Doris 单语句多值上限稳妥取 500）
+            CHUNK = 500
+            for i in range(0, len(rows), CHUNK):
+                cur.executemany(_findings_insert_sql(meta_db_ref), rows[i:i + CHUNK])
+            n_findings = len(rows)
+        conn.commit()
+        return {"status": "ok", "runs": n_runs, "findings": n_findings,
+                "uid_missing_skipped": skipped, "db": meta_db.get("type")}
+    except Exception as exc:
+        return {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"[:400]}
+
+
+def mark_manifest_persistence(run_dir: Path | str, status: str, reason: str = "") -> None:
+    """失败兜底：manifest.json 记 persistence_status（文件保留可重放）。"""
+    p = Path(run_dir) / "manifest.json"
+    try:
+        data = json.loads(p.read_text(encoding="utf-8"))
+        data["persistence_status"] = status
+        if reason:
+            data["persistence_reason"] = reason[:300]
+        tmp = p.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+        tmp.replace(p)
+    except Exception as exc:  # noqa: BLE001 —— 兜底标记失败不再向上抛
+        logger.warning("[inspection] persistence_status 回写 manifest 失败 path=%s: %s", p, exc)
+        pass
+
+
+def query_findings(meta_db_ref: str, run_id: str,
+                   selector: str | None = None, keyword: str | None = None,
+                   limit: int = 20) -> list[dict]:
+    """结构化检索 finding：selector 可为完整 finding_uid 或原始编号；
+    keyword 对 摘要/表/列/类别 做 LIKE。结果与产物 JSON 同形，供 fix.py/AI 直接消费。
+
+    Args:
+        meta_db_ref: 元数据库 db_ref
+        run_id: 巡检 run_id
+        selector: finding_uid 或 source_finding_id（兼容 "NUL-001·abcd" 短写）
+        keyword: 模糊检索关键词（summary/table/column/category LIKE）
+        limit: 返回上限
+    """
+    ph = "?" if _meta_db_type(meta_db_ref) == "sqlite" else "%s"
+    sql = f"SELECT {_FINDING_COLS} FROM `dw_inspection_findings` WHERE `run_id`={ph}"
+    params: list = [run_id]
+    if selector:
+        sql += (f" AND (`finding_uid`={ph} OR `source_finding_id`={ph})")
+        params += [selector, selector.split("·")[0]]
+    if keyword:
+        kw = f"%{keyword}%"
+        sql += (f" AND (`summary` LIKE {ph} OR `table` LIKE {ph} "
+                f"OR `column` LIKE {ph} OR `category` LIKE {ph})")
+        params += [kw, kw, kw, kw]
+    sql += f" ORDER BY `severity`, `source_finding_id` LIMIT {int(limit)}"
+    rows = dc.query_dict(meta_db_ref, sql, params=params, limit=limit)
+    return [_parse_finding_row(r) for r in rows]
+
+
+def get_finding_detail(meta_db_ref: str, run_id: str, finding_uid: str) -> dict | None:
+    """只读单条 finding（惰性加载明细的后端服务底层）。rows 已解析 JSON 字段。"""
+    rows = query_findings(meta_db_ref, run_id, selector=finding_uid, limit=1)
+    return rows[0] if rows else None
+
+
+def persist_fixes(meta_db_ref: str, rows: list[tuple]) -> dict:
+    """写 dw_inspection_fixes（fix.py 的 _persist_fix_rows 上收）。
+
+    Args:
+        meta_db_ref: 元数据库 db_ref
+        rows: fix 记录元组列表（20 字段，对应 FIXES_COLS 顺序）
+    Returns:
+        {status, submitted, db} 或 {status:failed, reason}
+    """
+    if not rows:
+        return {"status": "ok", "submitted": 0, "db": None}
+    try:
+        ph = ",".join([_placeholder(meta_db_ref)] * 20)
+        conn, meta_db = dc._acquire(meta_db_ref, read_only=False)
+        cur = dc._cursor(conn)
+        cur.executemany(f"INSERT INTO `dw_inspection_fixes` ({FIXES_COLS}) VALUES ({ph})",
+                        [tuple(r) for r in rows])
+        conn.commit()
+        return {"status": "ok", "submitted": len(rows), "db": meta_db.get("type")}
+    except Exception as exc:
+        return {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"[:400]}
+
+
+# ==========================================================================
+# 批次列表 / 会话补绑（dw_inspection_runs 为状态真相源）
+# ==========================================================================
+def _parse_ts(value) -> datetime | None:
+    """宽松解析 started_at（历史行混用带/不带时区）。解析失败返回 None。"""
+    return timeutil.parse_ts(str(value or "").strip() or None)
+
+
+def _normalize_ts(value: str) -> str:
+    """时间戳落库前归一为 C2 格式（naive 补本地 offset，墙钟不变）；无法解析原样返回。"""
+    dt = timeutil.parse_ts(value)
+    return dt.isoformat(timespec="seconds") if dt else value
+
+
+def _summary_errors(summary_json) -> list[str]:
+    """summary_json → errors 列表（终态行由 persist_run 写入；缺失/坏串返回空）。"""
+    try:
+        data = json.loads(summary_json or "{}")
+    except (TypeError, ValueError):
+        return []
+    errors = data.get("errors") if isinstance(data, dict) else None
+    return [str(e) for e in errors] if isinstance(errors, list) else []
+
+
+def _mark_run_timed_out(meta_db_ref: str, run_id: str, finished_at: str) -> None:
+    """超时行就地收敛为 failed（best-effort：收敛失败不影响列表返回）。"""
+    if not run_id:
+        return
+    ph = "?" if _meta_db_type(meta_db_ref) == "sqlite" else "%s"
+    try:
+        dc.execute(meta_db_ref,
+                   f"UPDATE `dw_inspection_runs` SET `status`='failed', `finished_at`={ph} "
+                   f"WHERE `run_id`={ph} AND `status` IN ('queued','running')",
+                   params=[finished_at, run_id], commit=True)
+    except Exception as exc:  # noqa: BLE001 —— 超时收敛失败仅告警
+        logger.warning("[inspection][warn] 超时收敛失败 run=%s: %s", run_id, exc)
+
+
+def _run_row_to_manifest(meta_db_ref: str, row: dict, *, now: datetime,
+                         timeout_s: int) -> dict:
+    """dw_inspection_runs 行 → 前端 InspectionManifest 同形（含超时收敛后的状态）。"""
+    run_id = str(row.get("run_id") or "")
+    status = str(row.get("status") or "")
+    finished_at = row.get("finished_at") or None
+    errors = _summary_errors(row.get("summary_json"))
+    if status in ("queued", "running"):
+        started = _parse_ts(row.get("started_at"))
+        if started is not None and (now - started).total_seconds() > max(60, int(timeout_s)):
+            status = "failed"
+            finished_at = now.isoformat(timespec="seconds")
+            errors = [*errors, f"巡检超时（{timeout_s}s 内无终态），已判定失败"]
+            _mark_run_timed_out(meta_db_ref, run_id, str(finished_at))
+    return {
+        "run_id": run_id,
+        "status": status,
+        "db": str(row.get("db_ref_alias") or row.get("db_name") or ""),
+        "started_at": str(row.get("started_at") or ""),
+        "finished_at": finished_at,
+        "session_id": str(row.get("session_id") or ""),
+        "workspace_id": str(row.get("workspace_id") or "default"),
+        "artifact_dir": str(row.get("artifact_dir") or ""),
+        "errors": errors,
+    }
+
+
+def list_runs(meta_db_ref: str, *, workspace_id: str | None = None,
+              timeout_s: int | None = None) -> list[dict]:
+    """巡检批次列表（dw_inspection_runs 为真相源；running 超时即判 failed 并就地收敛）。
+
+    不再扫描 manifest 目录判状态：对话触发的巡检进程不归 web 服务跟踪表管，
+    按「未跟踪即孤儿」改写会把在跑的批次误标失败。
+
+    Args:
+        meta_db_ref: 元数据库 db_ref
+        workspace_id: 工作空间过滤；缺省/空返回全部（加列前的历史行按 default 归口）
+        timeout_s: 超时阈值（秒）；缺省 RUN_TIMEOUT_S
+    Returns:
+        与 run manifest 同形的 dict 列表，started_at 倒序
+    """
+    ensure_runs_columns(meta_db_ref)
+    ph = "?" if _meta_db_type(meta_db_ref) == "sqlite" else "%s"
+    sql = f"SELECT {_LIST_RUN_COLS} FROM `dw_inspection_runs`"
+    params: list = []
+    if workspace_id:
+        if str(workspace_id) == "default":
+            sql += (f" WHERE (`workspace_id`={ph} OR `workspace_id` IS NULL"
+                    " OR `workspace_id`='')")
+        else:
+            sql += f" WHERE `workspace_id`={ph}"
+        params.append(str(workspace_id))
+    rows = dc.query_dict(meta_db_ref, sql, params=params, limit=None)
+    timeout = RUN_TIMEOUT_S if timeout_s is None else max(60, int(timeout_s))
+    now = datetime.now().astimezone()
+    out = [_run_row_to_manifest(meta_db_ref, row, now=now, timeout_s=timeout)
+           for row in rows]
+    # 排序键用解析后的时刻（失败者排末尾）；字符串排序仅在混 UTC 行时会错位
+    floor = datetime.min.replace(tzinfo=timezone.utc)
+    out.sort(key=lambda item: _parse_ts(item.get("started_at")) or floor, reverse=True)
+    return out
+
+
+def bind_session(meta_db_ref: str, run_id: str, session_id: str) -> dict:
+    """把 run 关联到发起巡检的会话（列表展示 + 修复切回原会话复用上下文）。
+
+    Args:
+        meta_db_ref: 元数据库 db_ref
+        run_id: 巡检 run_id
+        session_id: 发起巡检的会话 ID
+    Returns:
+        {status, run_id, session_id, affected_rows} 或 {status:failed, reason}
+    """
+    if not run_id or not session_id:
+        return {"status": "failed", "reason": "run_id/session_id 为空"}
+    ph = "?" if _meta_db_type(meta_db_ref) == "sqlite" else "%s"
+    try:
+        out = dc.execute(meta_db_ref,
+                         f"UPDATE `dw_inspection_runs` SET `session_id`={ph} "
+                         f"WHERE `run_id`={ph}",
+                         params=[session_id, run_id], commit=True)
+        return {"status": "ok", "run_id": run_id, "session_id": session_id,
+                "affected_rows": out.get("affected_rows", 0)}
+    except Exception as exc:  # noqa: BLE001
+        return {"status": "failed", "reason": f"{type(exc).__name__}: {exc}"[:400]}
