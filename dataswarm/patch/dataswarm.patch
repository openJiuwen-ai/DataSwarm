+
+def test_sqlalchemy_sqlite_query(tmp_path):
+    database = tmp_path / "events.db"
+    source = SourceDefinition(
+        source_id="events",
+        source_type="sqlite",
+        name="events",
+        engine="sqlalchemy",
+        config={"path": str(database)},
+    )
+    import sqlite3
+
+    with sqlite3.connect(database) as connection:
+        connection.execute("CREATE TABLE events (id INTEGER, payload TEXT)")
+        connection.executemany(
+            "INSERT INTO events VALUES (?, ?)",
+            [(1, json.dumps({"ok": True})), (2, json.dumps({"ok": False}))],
+        )
+    result = SQLAlchemyConnector(source).query("SELECT id, payload FROM events", limit=1)
+    assert result["columns"] == ["id", "payload"]
+    assert result["row_count"] == 1
