@@ -0,0 +1,521 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+from pathlib import Path
+
+from jiuwenswarm.channels.web.dataagent.knowledge import documents, store
+from jiuwenswarm.channels.web.dataagent.knowledge.selection import resolve_for_plan
+
+
+def _prepare(monkeypatch, tmp_path):
+    db_path = tmp_path / "knowledge.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+    ensure_system_schema(f"sqlite://{db_path}")
+    monkeypatch.setattr(store, "_workspace", lambda: "ws-test")
+    from jiuwenswarm.channels.web.dataagent.knowledge.documents import _persist_document
+    document = {"document_id": "doc-test", "version_id": "dv-test", "text": "source evidence",
+                "evidence": [{"evidence_id": "ev-test", "start": 0, "end": 15}],
+                "source": {"source_id": "source-test", "name": "fixture.md", "sha256": "hash"},
+                "metadata": {}, "quality": {}}
+    _persist_document(document)
+    return {"document_id": "doc-test", "document_version_id": "dv-test", "evidence_id": "ev-test",
+            "evidence_span": {"start": 0, "end": 15}, "evidence_quote": "source evidence"}
+
+
+def test_candidate_requires_review_before_publish(monkeypatch, tmp_path):
+    source = _prepare(monkeypatch, tmp_path)
+
+    rule = store.create_candidate({"asset_type": "rule", "title": "退款口径", "content": "剔除全额退款订单",
+                                  "scope": {"metric_keys": ["net_sales"]},
+                                  "source": source})
+    assert rule["status"] == "candidate"
+    try:
+        store.transition(rule["asset_id"], "publish")
+        assert False, "candidate must not publish without approval"
+    except ValueError:
+        pass
+    store.transition(rule["asset_id"], "approve")
+    published = store.transition(rule["asset_id"], "publish")
+    assert published["status"] == "published"
+    result = store.resolve_for_plan({"components": [{"selected_metrics": ["net_sales"]}]})
+    assert [item["asset_id"] for item in result["rules"]] == [rule["asset_id"]]
+    assert result["trace"]["rule_policy"] == "all_applicable"
+    assert result["trace"]["g1_uses_examples"] is False
+
+
+def test_example_is_filtered_after_plan_compatibility(monkeypatch, tmp_path):
+    source = _prepare(monkeypatch, tmp_path)
+    example = store.create_candidate({"asset_type": "example", "title": "净销售额样例", "content": "SELECT ...",
+                                     "scope": {"metric_keys": ["net_sales"], "dimensions": ["state"]},
+                                     "source": source})
+    store.transition(example["asset_id"], "approve")
+    store.transition(example["asset_id"], "publish")
+    picked = store.resolve_for_plan({"components": [{"selected_metrics": ["net_sales"], "dimensions": ["state"]}]})
+    skipped = store.resolve_for_plan({"components": [{"selected_metrics": ["gross_sales"], "dimensions": ["state"]}]})
