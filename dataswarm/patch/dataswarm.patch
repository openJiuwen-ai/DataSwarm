+        {checks.map((c, i) => (
+          <div key={`${c.name}-${i}`} className="flex items-baseline gap-2 text-xs">
+            <Badge tone={statusColor(c.status)}>{c.status}</Badge>
+            <span className="font-mono text-[11px] text-text">{c.name}</span>
+            {c.detail && <span className="text-[11px] text-text-muted">{c.detail}</span>}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+// ==========================================================================
+// 会话列表视图
+// ==========================================================================
+
