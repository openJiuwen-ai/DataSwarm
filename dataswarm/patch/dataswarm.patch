+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/business_data/duckdb_impl.py — 文件源（CSV/Excel）业务库访问实现。
+
+duckdb:// ref 经 db_connector 桥接 DuckDBConnector（VIEW 挂载文件），
+此处复用桥接协议实现 DAO 四方法：csv/excel 目录源每文件一个视图
+（实时 glob），单文件等场景仍为单个注册 VIEW；list_databases 返回单条
+（name = location 文件/目录名）。本地 csv 源另有 warehouse 物化表
+（dwd/dws/ads 分层），一并计入表清单，物化表 last_modified 取
+warehouse 文件 mtime。
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+from jiuwenswarm.common import db_connector
+from jiuwenswarm.common.dw_layer import infer_layer as _infer_layer
+
+from .base import BusinessDataDao, register
+
+
+def _warehouse_mtime(db_ref: str) -> str:
+    """物化表 last_modified：取 warehouse 文件 mtime（ISO 字符串，无文件返回空）。"""
+    if not db_ref.startswith("duckdb://"):
+        return ""
+    try:
+        spec = db_connector.parse_db_ref(db_ref)
+        if spec.get("source_type") not in ("csv", "excel") or "://" in spec.get("location", ""):
+            return ""
+        from ..connectors.duckdb_connector import warehouse_file_for
+
+        path = warehouse_file_for(
+            str(Path(spec["location"]).expanduser().resolve()),
+            Path(spec["location"]).stem or "csv",
+        )
+        if path.exists():
+            import datetime
+
+            return datetime.datetime.fromtimestamp(path.stat().st_mtime).isoformat(
+                sep=" ", timespec="seconds"
+            )
+    except Exception:  # noqa: BLE001 —— 元数据润色失败不阻断清单
+        pass
+    return ""
+
+
+def _view_names(db_ref: str) -> set[str]:
+    """文件视图名集合（物化表判定基准：不在集合里的即 warehouse 物化表）。
+
+    不能用 db_connector.tables()——catalog 已合并物化表；经
+    connectors.duckdb_connector.dir_view_names 重算（唯一真相源，
+    dialect-convergence 批次 1b G5 收口，与 _datasets() 同口径）。
+    """
+    if not db_ref or not db_ref.startswith("duckdb://"):
+        return set()
+    try:
+        spec = db_connector.parse_db_ref(db_ref)
+        from ..connectors.duckdb_connector import dir_view_names
+
+        return set(dir_view_names(
+            str(spec.get("source_type") or ""),
+            str(spec.get("location") or ""),
+        ))
+    except Exception:  # noqa: BLE001 —— 查询失败按无物化表处理
+        return set()
+
+
+def _is_csv_dir_ref(db_ref: str) -> bool:
+    """csv 目录源判定（conectors.duckdb_connector.is_dir_location 真相源）。"""
+    if not db_ref or not db_ref.startswith("duckdb://"):
+        return False
+    try:
+        spec = db_connector.parse_db_ref(db_ref)
+        from ..connectors.duckdb_connector import is_dir_location
+
+        return (spec.get("source_type") == "csv"
+                and is_dir_location("csv", str(spec.get("location") or "")))
+    except Exception:  # noqa: BLE001 —— 判定失败按非目录源处理
+        return False
+
+
+def _dir_csv_files(db_ref: str) -> list[Path]:
+    """csv 目录源的文件清单（与 DuckDBConnector._dir_glob 同口径）。"""
+    spec = db_connector.parse_db_ref(db_ref)
+    return sorted(Path(spec["location"]).expanduser().resolve().glob("*.csv"))
+
+
+def _csv_mtime(db_ref: str, table_name: str) -> str:
+    """目录源表 last_modified：取对应 csv 文件 mtime（ISO 字符串）。"""
+    try:
+        spec = db_connector.parse_db_ref(db_ref)
+        path = Path(spec["location"]).expanduser().resolve() / f"{table_name}.csv"
+        if path.exists():
+            import datetime
+
+            return datetime.datetime.fromtimestamp(path.stat().st_mtime).isoformat(
+                sep=" ", timespec="seconds"
+            )
+    except Exception:  # noqa: BLE001 —— 元数据润色失败不阻断清单
+        pass
+    return ""
+
+
+@register
+class DuckdbBusinessDao(BusinessDataDao):
+    dao_type = "duckdb"
+
+    def __init__(self, db_ref: str | None = None):
+        self.db_ref = db_ref or ""
+
+    def _datasets(self) -> list[str]:
+        return db_connector.tables(self.db_ref).get("tables", [])
+
+    def list_databases(self) -> list[dict]:
+        """文件源单库：name = location 文件/目录名（与 _summary/前端库名对齐）。"""
+        if not self.db_ref:
+            return []
+        spec = db_connector.parse_db_ref(self.db_ref)
+        return [
+            {
+                "name": Path(spec["location"]).name,
+                "path": spec["location"],
+                "size_bytes": self._warehouse_size(),
+                "table_count": len(self._datasets()),
+            }
+        ]
+
+    def _warehouse_size(self) -> int:
+        """csv 目录源：目录内 csv 总大小；其余本地源：warehouse 文件大小。"""
+        try:
+            if _is_csv_dir_ref(self.db_ref):
+                return sum(f.stat().st_size for f in _dir_csv_files(self.db_ref) if f.exists())
+            spec = db_connector.parse_db_ref(self.db_ref)
+            if spec.get("source_type") not in ("csv", "excel") or "://" in spec.get("location", ""):
+                return 0
+            from ..connectors.duckdb_connector import warehouse_file_for
+
+            path = warehouse_file_for(
+                str(Path(spec["location"]).expanduser().resolve()),
+                Path(spec["location"]).stem or "csv",
+            )
+            return path.stat().st_size if path.exists() else 0
+        except Exception:  # noqa: BLE001 —— 元数据润色失败不阻断清单
+            return 0
+
+    def list_tables(self, db_name: str) -> list[dict]:
+        if not self.db_ref:
+            return []
+        stats = db_connector.batch_stats(self.db_ref)
+        csv_dir = _is_csv_dir_ref(self.db_ref)
+        views = _view_names(self.db_ref)
+        materialized_mtime = _warehouse_mtime(self.db_ref) if len(stats) > len(views) else ""
+        return [
+            {
+                "name": name,
+                "row_count": info["row_count"],
+                "column_count": len(info["columns"]),
+                "layer": _infer_layer(name),
+                "last_modified": (
+                    _csv_mtime(self.db_ref, name)
+                    if csv_dir
+                    else (materialized_mtime if name not in views else "")
+                ),
+            }
+            for name, info in stats.items()
+        ]
+
+    def get_table_detail(self, db_name: str, table_name: str) -> dict:
+        if not self.db_ref:
+            raise LookupError("duckdb db_ref is not configured")
+        result = db_connector.schema(self.db_ref, table_name)
+        columns = [
+            {
+                "name": c["name"],
+                "type": c["type"],
+                "nullable": True,
+                "primary_key": False,
+                "default_value": None,
+            }
+            for c in result.get("columns", [])
+        ]
+        count_result = db_connector.query(
+            self.db_ref, f'SELECT COUNT(*) FROM "{table_name}"', limit=1
+        )
+        row_count = int(count_result["rows"][0][0]) if count_result["rows"] else 0
+        return {
+            "name": table_name,
+            "ddl": "",
+            "columns": columns,
+            "indexes": [],
+            "foreign_keys": [],
+            "row_count": row_count,
+            "comment": "",  # 文件源 VIEW 无表 comment 概念
+        }
+
+    def preview_table(self, db_name: str, table_name: str,
+                      limit: int = 10, offset: int = 0) -> dict:
+        if not self.db_ref:
+            raise LookupError("duckdb db_ref is not configured")
+        limit = max(1, min(int(limit), 1000))
+        offset = max(0, int(offset))
+        result = db_connector.query(
+            self.db_ref,
+            f'SELECT * FROM "{table_name}" LIMIT ? OFFSET ?',
+            params=(limit, offset),
+            limit=limit,
+        )
+        total_result = db_connector.query(
+            self.db_ref, f'SELECT COUNT(*) FROM "{table_name}"', limit=1
+        )
+        total = int(total_result["rows"][0][0]) if total_result["rows"] else 0
+        return {"columns": result["columns"], "rows": result["rows"], "total": total}
