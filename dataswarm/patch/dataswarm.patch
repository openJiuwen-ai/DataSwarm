+            continue
+        if key == "params":
+            value = json.dumps(value, ensure_ascii=False)
+        args.extend([f"--{key.replace('_', '-')}", str(value)])
+    if not code:
+        return _dwcli(*args, "--code", "")
+    return _with_temp_text(code, ".task-code", lambda path: _dwcli(*args, "--code-file", path))
