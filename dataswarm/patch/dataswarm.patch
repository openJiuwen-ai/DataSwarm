@@ -0,0 +1,174 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""sql/controller.py — SQL 执行 HTTP 路由分发。
+
+路由前缀: /api/dataagent/sql/
+  POST /sql/run      {db_ref, sql, limit?}
+  POST /sql/explain  {db_ref, sql}
+  POST /sql/ddl      {db_ref, sql, confirm}
+"""
+from __future__ import annotations
+
+import logging
+
+from jiuwenswarm.common.workspace_context import WorkspaceContextError
+
+from . import service as svc
+from .._common import read_body
+
+
+_logger = logging.getLogger(__name__)
+
+_PREFIX = "/api/dataagent/sql"
+
+
+def is_route(path: str) -> bool:
+    return path.startswith(_PREFIX)
+
+
+def _log_bypass_query(body: dict, result: dict) -> None:
+    """nl2sql/Agent 直连 SQL 的旁路轻量记账（重构 Phase 3b，D4 补洞）。
+
+    HTTP /sql/run 不产 manifest（分析追踪页不可见）——本记账落
+    dw_metric_query_log（path=sql_run），`dwcli metric-v2 queries` 可审计
+    「这轮还发生过旁路取数」。分析链 execute 是进程内直调 run_sql 不经
+    此处，无重复记账；记账失败不阻断执行（旁路观测从属于主业务）。
+    """
+    try:
+        from ..metrics import store as metrics_store
+
+        sql = str(body.get("sql") or "")
+        metrics_store.log_query({
+            "workspace_id": str(body.get("workspace_id") or ""),
+            "question": str(body.get("question") or ""),
+            "query_spec_json": "",
+            "path": "sql_run",
+            "authoritative": False,
+            "generated_sql": sql[:500],
+            "sql_params_json": "[]",
+            "dialect": "",
+            "executed": 1 if result.get("ok") else 0,
+            "row_count": int(result.get("row_count") or 0),
+            "elapsed_ms": int(result.get("elapsed_ms") or 0),
+            "context_digest": "",
+            "degraded_reason": str(result.get("error") or "")[:200],
+        })
+    except Exception:  # noqa: BLE001 —— 记账失败不得阻断取数
+        _logger.exception("旁路 SQL 记账失败（忽略）")
+
+
+def _split(path: str) -> list[str]:
+    rel = path[len(_PREFIX):].rstrip("/")
+    return rel.split("/")
+
+
+def _emit(handler, result: dict) -> None:
+    """根据 service 层 envelope 的 ok 字段决定 HTTP 状态码（方案 §3.1）。
+
+    ok=True → 200；ok=False → 500（执行失败，如 DB 错误/权限拒绝）。
+    参数错（invalid_json/limit 非数字/缺 confirm）仍在调用点显式返回 4xx。
+    """
+    status = 200 if result.get("ok") else 500
+    handler._write_json(status, result)
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = read_body(handler)
+    if body is None and len(parts) > 1:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        requested_workspace = (body or {}).get("workspace_id") if isinstance(body, dict) else None
+        if requested_workspace:
+            from jiuwenswarm.common.workspace_context import current_workspace
+
+            try:
+                active = current_workspace()
+                if active.workspace_id != requested_workspace and handler._query_arg(parsed, "workspace_id"):
+                    handler._write_json(400, {
+                        "error": "WORKSPACE_CONTEXT_CONFLICT",
+                        "detail": "request workspace_id conflicts with query workspace_id",
+                    })
+                    return
+            except Exception:
+                # The service resolver below emits the canonical context error.
+                pass
+        # ['', 'run']
+        if len(parts) == 2 and parts[1] == "run":
+            req = body or {}
+            if req.get("source_id") or req.get("workspace_id") or req.get("role"):
+                result = svc.run_sql(
+                    req.get("db_ref", ""),
+                    req.get("sql", ""),
+                    int(req.get("limit", 100)),
+                    workspace_id=req.get("workspace_id"),
+                    role=req.get("role", "business"),
+                    source_id=req.get("source_id"),
+                )
+            else:
+                result = svc.run_sql(
+                    req.get("db_ref", ""),
+                    req.get("sql", ""),
+                    int(req.get("limit", 100)),
+                )
+            _log_bypass_query(req, result)
+            _emit(handler, result)
+            return
+        # ['', 'explain']
+        if len(parts) == 2 and parts[1] == "explain":
+            if (body or {}).get("workspace_id") or (body or {}).get("role"):
+                _emit(handler, svc.explain_sql(
+                    (body or {}).get("db_ref", ""),
+                    (body or {}).get("sql", ""),
+                    workspace_id=(body or {}).get("workspace_id"),
+                    role=(body or {}).get("role", "business"),
+                ))
+            else:
+                _emit(handler, svc.explain_sql(
+                    (body or {}).get("db_ref", ""),
+                    (body or {}).get("sql", ""),
+                ))
+            return
+        # ['', 'ddl']
+        if len(parts) == 2 and parts[1] == "ddl":
+            if not (body or {}).get("confirm"):
+                handler._write_json(400, {"error": "confirm_required",
+                                          "detail": "DDL requires confirm=true"})
+                return
+            if (body or {}).get("workspace_id") or (body or {}).get("role"):
+                _emit(handler, svc.execute_ddl(
+                    (body or {}).get("db_ref", ""),
+                    (body or {}).get("sql", ""),
+                    workspace_id=(body or {}).get("workspace_id"),
+                    role=(body or {}).get("role", "business"),
+                    # 对话链路经 dwcli 的 X-Jiuwen-Session-Id 头带会话标识，
+                    # DDL 成功后按会话推送结构变更事件（无 header 时为空串，静默跳过）
+                    session_id=handler.headers.get("X-Jiuwen-Session-Id", "") or "",
+                ))
+            else:
+                _emit(handler, svc.execute_ddl(
+                    (body or {}).get("db_ref", ""),
+                    (body or {}).get("sql", ""),
+                    session_id=handler.headers.get("X-Jiuwen-Session-Id", "") or "",
+                ))
+            return
+    except WorkspaceContextError as exc:
+        handler._write_json(400, {
+            "error": getattr(exc, "code", "WORKSPACE_CONTEXT_ERROR"),
+            "detail": str(exc),
+        })
+        return
+    except (IndexError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        # 500 兜底必须留痕：skill 侧 dwcli 只透传 error/detail，服务端不落日志则根因丢失
+        _logger.exception("sql API internal_error: %s", exc)
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_get(handler, parsed) -> None:
+    """sql 模块无 GET 路由。"""
+    handler._write_json(404, {"error": "not_found"})
