+    "Q1 单指标总量": 'SELECT ROUND((SUM(order_amt))::numeric, 2) AS v FROM "{t}"',
+    "Q2 分组TopN排序": (
+        'SELECT region_id, ROUND((SUM(order_amt))::numeric,2) AS v FROM "{t}" '
+        "GROUP BY region_id ORDER BY v DESC, region_id LIMIT 3"
