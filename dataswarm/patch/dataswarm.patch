+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""stream_load_executor.py — CSV 导数执行器（方案批次 3 §7.4）。
+
+CSV 导数建为 stream_load 任务（executor_type="stream_load"），由服务端进程内
+执行数据面搬运——取代 skill 侧直连，生成代码不再内嵌 pymysql/requests。
+
+导入路径（对齐 csv_importer.py 的 CSV_IMPORT_METHOD 契约）：
+    默认走 FE(9030) MySQL Load：LOAD DATA LOCAL INFILE，pymysql 须 local_infile=True。
+    SelectDB 托管实例的 BE Stream Load 端口(8040)不对公网开放，直连会超时；
+    MySQL Load 由 FE 内部转 Stream Load 下发 BE，只要 FE 9030 可达即可导入。
+    设环境变量 CSV_IMPORT_METHOD=stream_load 可切回直连 BE 8040 的 HTTP PUT 路径
+    （自建集群 BE 可达时更快）。
+
+params_json 契约（v5 同机假设：skill 与服务端同机，CSV 直传本地路径）：
+    file_path    CSV 文件本地路径（服务端可读）
+    target_db    业务库名
+    target_table 目标表名
+    columns?     列清单（逗号分隔；MySQL Load 路径生成 IGNORE 1 LINES (cols)）
+    label?       幂等 label；缺省 = {task_id}_{instance_id}（每实例唯一，重试去重）
+
+幂等：同 label 重复提交被 Doris 拒绝（Label Already Exists）——本执行器捕获该
+错误映射为 failed（调用方可凭 label 查重防重复灌数）。
+"""
+
+from __future__ import annotations
+
+import csv
+import os
+import tempfile
+from pathlib import Path
+
+from .base import Executor, TaskRunResult, register
+
+try:
+    import requests
+except ImportError:  # pragma: no cover
+    requests = None  # stream_load 路径的出站请求在用到时报错
+
+# BE 地址：从 datasource.yaml 的 doris: 段读 host，BE 端口默认 8040（仅 stream_load 路径）
+_BE_PORT_DEFAULT = 8040
+
+# 规范化转义仍失败后的最末级兜底：strict_mode=false + max_filter_ratio=1 全容忍放行。
+# 效果：Doris 跳过仍无法归化的行（如极端字符），保留干净行，任务不整批失败。
+# result_summary.tolerant 标记供上层核对丢弃量；正常路径不应走到这级（规范化已覆盖
+# 引号/换行/? 三类，仅极少数漏网行会在此被跳过）。
+_MAX_FILTER_RATIO_FALLBACK = 1.0
+_STRICT_MODE_FALLBACK = False
+
+
+def _be_endpoint(datasource_ref: str | None, target_db: str) -> tuple[str, int]:
+    """BE 地址优先级：UI 源 spec（be_host/be_http_port）> config doris: 段 > 环境变量 > FE host / 8040。"""
+    from jiuwenswarm.common import db_connector
+
+    spec: dict = {}
+    try:
+        ref = _target_ref(target_db, datasource_ref)
+        if ref.split("://", 1)[0] == "doris":
+            spec = db_connector.parse_db_ref(ref)
+    except Exception:
+        spec = {}
+    try:
+        cfg = db_connector._read_config_section("doris")
+    except Exception:
+        cfg = {}
+    host = (spec.get("be_host")
+            or cfg.get("be_host")
+            or os.environ.get("DORIS_BE_HOST")
+            or spec.get("host")
+            or "127.0.0.1")
+    port = int(spec.get("be_http_port")
+               or cfg.get("be_http_port")
+               or os.environ.get("DORIS_BE_HTTP_PORT")
+               or _BE_PORT_DEFAULT)
+    return host, port
+
+
+def _is_mysql_target(datasource_ref: str | None, target_db: str) -> bool:
+    """目标是否真 MySQL（非 Doris）。
+
+    builder.materialize 透传真实业务 ref（mysql://host:port/db）；ref 缺失时
+    兜底 doris://{target_db} 指针——按指针形态判定，不误伤既有 Doris 任务。
+    """
+    ref = str(datasource_ref or "")
+    if ref.startswith("mysql://"):
+        return True
+    if ref.startswith("doris://"):
+        return False
+    return False  # 空/未知 ref 兜底 doris 指针（_target_ref 同一假设）
+
+
+def _target_ref(target_db: str, datasource_ref: str | None) -> str:
+    """任务目标库 db-ref：优先用任务的 datasource_ref，缺失/异构时按指针自带库名派生。
+
+    plan_to_tasks 建任务时 datasource_ref = doris://{biz_db}，正常直接用；
+    兜底 doris://{target_db}（parse_db_ref 的指针自带库名形态，凭据走 config doris: 段）。
+    duckdb/sqlite ref 不是 LOAD 目标（文件源只读/本地库走物化路径），
+    一律按 doris 指针兜底——建任务侧不应产生这类组合，出现了连错库不如大声失败，
+    在 _open_local_infile_conn 的 spec 校验处报。
+    """
+    if datasource_ref and datasource_ref.split("://", 1)[0] in ("doris", "mysql"):
+        return datasource_ref
+    return f"doris://{target_db}"
+
+
+def _open_local_infile_conn(target_db: str, datasource_ref: str | None, timeout_s: int):
+    """开一条 local_infile=True 的 pymysql 连接（MySQL Load 必需，pymysql 默认 False）。
+
+    走 db_connector 的统一解析（config doris: 段 + 环境变量补全），不重复凭据逻辑。
+    read_timeout 放大到任务 timeout_s——LOAD DATA 流式传输期间不能让客户端先超时。
+    duckdb/sqlite ref 在此大声失败（LOAD 目标只能是 Doris/MySQL）。
+    """
+    from jiuwenswarm.common import db_connector
+
+    ref = _target_ref(target_db, datasource_ref)
+    spec = db_connector.parse_db_ref(ref)
+    if spec["type"] not in ("doris", "mysql"):
+        raise RuntimeError(
+            f"MySQL Load 不支持 {spec['type']} 数据源（datasource_ref={datasource_ref!r}）；"
+            f"CSV 导入目标是 Doris/MySQL 业务库"
+        )
+    kwargs = db_connector._resolve_mysql_env(
+        spec, default_prefix="DORIS" if spec["type"] == "doris" else "MYSQL"
+    )
+    kwargs["local_infile"] = True
+    kwargs["read_timeout"] = max(int(timeout_s), 60)
+    if db_connector.pymysql is None:
+        raise ImportError("pymysql 未安装，请 uv pip install pymysql")
+    return db_connector.pymysql.connect(**kwargs)
+
+
+def _mysql_load_sql(src: Path, target_table: str, columns: str | None,
+                    *, terminator: str = ",", max_filter_ratio: float | None = None,
+                    strict_mode: bool | None = None, escaped_by: str | None = None) -> str:
+    """构造 LOAD DATA LOCAL INFILE 语句（对齐 csv_importer 的列清单写法）。
+
+    Windows 反斜杠路径转 /，避免在 SQL 字符串里被当成转义符；文件名是字面量，
+    手工拼接并翻倍单引号转义；首行 CSV 表头跳过（IGNORE 1 LINES）。
+
+    Args:
+        src: CSV 文件路径（规范化重试时是临时 tsv）
+        target_table: 目标表名
+        columns: 列清单（反引号包裹逗号分隔），None 则按文件列序整行导入
+        terminator: 列分隔符字面量（默认逗号）；规范化重试用 tab（Doris MySQL Load
+            不支持 CSV 引号语义，含引号包裹逗号/换行的字段须先经 _normalize_csv 改写）
+        max_filter_ratio: Doris 容忍过滤行占比（0-1），1.0 全容忍放行。规范化转义后
+            仍有个别无法归化的行时，兜底放行让 Doris 跳过而非整批取消
+        strict_mode: Doris strict 模式（类型转换失败即整批拒）；False 配合 max_filter_ratio
+            作为最末级兜底，宽松跳过坏行
+        escaped_by: MySQL 专用转义符覆盖。真 MySQL 的 LOAD DATA 默认 ESCAPED BY '\\\\'
+            会吃掉数据里的反斜杠；传 "" 显式关闭转义（规范化 tsv 无引号语义，
+            转义只会损坏数据）。Doris 路径不传（保持既有行为）
+    """
+    local_path = str(src).replace("\\", "/")
+    escaped_path = local_path.replace("'", "''")
+    sql = (
+        f"LOAD DATA LOCAL INFILE '{escaped_path}' "
+        f"INTO TABLE `{target_table}` "
+        f"COLUMNS TERMINATED BY '{terminator}' "
+    )
+    if escaped_by is not None:
+        sql += f"ESCAPED BY '{escaped_by}' "
+    sql += "LINES TERMINATED BY '\\n' IGNORE 1 LINES"
+    if columns:
+        cols = ", ".join(f"`{c.strip().strip('`')}`" for c in columns.split(",") if c.strip())
+        sql += f" ({cols})"
+    if max_filter_ratio is not None or strict_mode is not None:
+        props = []
+        if max_filter_ratio is not None:
+            props.append(f"'max_filter_ratio'='{max_filter_ratio}'")
+        if strict_mode is not None:
+            props.append(f"'strict_mode'='{str(strict_mode).lower()}'")
+        sql += " PROPERTIES (" + ", ".join(props) + ")"
+    return sql
+
+
+def _normalize_csv(src: Path, dest_dir: Path, *, double_question: bool = True) -> Path:
+    """把标准 CSV 改写为 LOAD DATA 可无歧义导入的 tab 分隔文件。
+
+    背景：MySQL Load 只认裸列分隔符，不理解 CSV 引号语义。标准 CSV 会用双引号
+    包裹含逗号/换行/引号的字段。直接 LOAD 会导致字段错位/整批失败。
+
+    本函数用 csv 模块按引号语义解析原文件，逐字段清洗后再以 tab 重写：
+      1) tab/换行/回车 → 空格（避免与列/行分隔符冲突）
+      2) 引号包裹的逗号字段已被 csv 模块还原为单字段，逗号保留在 tab 列内
+      3) 单 ? → ??（仅 Doris：Doris MySQL Load 把单 ? 当参数占位符，吞字/整批拒；
+         真 MySQL 无此语义，双写会把 ?? 字面存库损坏数据 → double_question=False 跳过）
+    返回临时文件路径（调用方负责清理）。
+
+    Args:
+        src: 源 CSV（utf-8-sig 带 BOM 兼容）
+        dest_dir: 临时文件落盘目录（artifact_dir，避免污染源 CSV 目录）
+        double_question: Doris 目标 True（? 双写转义）；真 MySQL 目标 False
+    """
+    fd, tmp_path = tempfile.mkstemp(prefix=f"{src.stem}_norm_", suffix=".tsv",
+                                    dir=str(dest_dir))
+    os.close(fd)
+    try:
+        with open(src, encoding="utf-8-sig", newline="") as f_in, \
+                open(tmp_path, "w", encoding="utf-8", newline="") as f_out:
+            for row in csv.reader(f_in):
+                # 清洗三类会破坏 MySQL Load 解析的字符：
+                #   1) tab/换行/回车 —— 列分隔与行分隔符冲突
+                #   2) 引号包裹的逗号字段已由 csv 模块正确还原，逗号保留在 tab 列内
+                #   3) 单 ? 是 Doris 参数占位符，Doris LOAD 会吞字/整批拒 → 双写 ?? 转义
+                #      （与 MySQL prepared statement 一致，LOAD 后 Doris 还原为单 ?）
+                clean = [cell.replace("\t", " ").replace("\n", " ").replace("\r", " ")
+                         for cell in row]
+                if double_question:
+                    clean = [cell.replace("?", "??") for cell in clean]
+                f_out.write("\t".join(clean) + "\n")
+    except Exception:
+        try:
+            os.unlink(tmp_path)
+        except OSError:
+            pass
+        raise
+    return Path(tmp_path)
+
+
+@register
+class StreamLoadExecutor(Executor):
+    """CSV 导数执行器（数据面搬运例外，方案 §7.4）：默认 FE MySQL Load，可切 BE Stream Load。"""
+
+    executor_type = "stream_load"
+
+    def run(
+        self,
+        code: str,
+        params: dict,
+        datasource_ref: str | None,
+        timeout_s: int,
+        artifact_dir: Path,
+        log_prefix: str = "node",
+    ) -> TaskRunResult:
+        artifact_dir.mkdir(parents=True, exist_ok=True)
+        stdout_path = artifact_dir / f"{log_prefix}_stream_load_stdout.log"
+        stderr_path = artifact_dir / f"{log_prefix}_stream_load_stderr.log"
+
+        def _fail(msg: str) -> TaskRunResult:
+            self._write_text(stderr_path, msg)
+            return TaskRunResult(
+                exit_code=1,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                status="failed",
+                error_message=msg[:800],
+            )
+
+        file_path = str(params.get("file_path") or "")
+        target_db = str(params.get("target_db") or "")
+        target_table = str(params.get("target_table") or "")
+        if not file_path or not target_db or not target_table:
+            return _fail(
+                f"stream_load 任务缺少参数：需要 file_path/target_db/target_table，"
+                f"实际 {sorted(k for k in params if params.get(k))}"
+            )
+
+        src = Path(file_path).expanduser()
+        if not src.is_file():
+            return _fail(f"CSV 文件不存在: {src}（v5 同机假设：直接传服务端可读的本地路径）")
+
+        # 幂等 label（方案 §7.4 第 3 点）：优先用显式 label，否则拼 {task_id}_{instance_id}。
+        # task_id + instance_id 双键保证同实例多表导数 label 互不冲突（Doris label 按
+        # (db,table) 维度去重，双键进一步隔离同表重跑与不同表导数）。
+        label = str(params.get("label") or "")
+        if not label:
+            tid = str(params.get("_task_id") or "")
+            iid = str(params.get("_instance_id") or "")
+            label = f"{tid}_{iid}" if tid and iid else (tid or iid)
+        if not label:
+            return _fail("缺少幂等 label（params._task_id+_instance_id 或显式 label）")
+
+        columns = params.get("columns")
+        method = str(os.environ.get("CSV_IMPORT_METHOD") or "mysql_load").lower()
+        if method == "stream_load":
+            return self._run_stream_load(
+                src, target_db, target_table, columns, label,
+                datasource_ref, timeout_s, stdout_path, stderr_path,
+            )
+        return self._run_mysql_load(
+            src, target_db, target_table, columns, label,
+            datasource_ref, timeout_s, stdout_path, stderr_path,
+        )
+
+    # ------------------------------------------------------------------
+    # 默认路径：FE(9030) MySQL Load
+    # ------------------------------------------------------------------
+    def _run_mysql_load(
+        self,
+        src: Path,
+        target_db: str,
+        target_table: str,
+        columns,
+        label: str,
+        datasource_ref: str | None,
+        timeout_s: int,
+        stdout_path: Path,
+        stderr_path: Path,
+    ) -> TaskRunResult:
+        def _fail(msg: str) -> TaskRunResult:
+            self._write_text(stderr_path, msg)
+            return TaskRunResult(
+                exit_code=1,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                status="failed",
+                error_message=msg[:800],
+                result_summary={"label": label, "target": f"{target_db}.{target_table}",
+                                "method": "mysql_load"},
+            )
+
+        def _attempt(file: Path, terminator: str, attempt_label: str,
+                     logs: list[str],
+                     max_filter_ratio: float | None = None,
+                     strict_mode: bool | None = None,
+                     escaped_by: str | None = None) -> tuple[dict | None, str]:
+            """单次 LOAD 尝试。成功返回 (summary, None)；失败返回 (None, 错误消息)。"""
+            sql = _mysql_load_sql(file, target_table, str(columns) if columns else None,
+                                  terminator=terminator,
+                                  max_filter_ratio=max_filter_ratio,
+                                  strict_mode=strict_mode,
+                                  escaped_by=escaped_by)
+            logs.append(f"[mysql_load] {attempt_label} {sql}")
+            try:
+                conn = _open_local_infile_conn(target_db, datasource_ref, timeout_s)
+            except Exception as exc:  # noqa: BLE001
+                return None, f"MySQL Load 建连失败: {exc}"
+            try:
+                with conn.cursor() as cur:
+                    cur.execute(sql)
+                    conn.commit()
+                    loaded = cur.rowcount if cur.rowcount is not None and cur.rowcount >= 0 else None
+                return {"label": attempt_label,
+                        "target": f"{target_db}.{target_table}",
+                        "method": "mysql_load",
+                        "loaded_rows": loaded}, None
+            except Exception as exc:  # noqa: BLE001
+                msg = str(exc)
+                if "Label Already Exists" in msg:
+                    msg = f"MySQL Load label 冲突（已导入过，凭 label 查重防重复灌数）: {msg}"
+                return None, msg
+            finally:
+                conn.close()
+
+        is_mysql = _is_mysql_target(datasource_ref, target_db)
+        logs = [
+            f"[mysql_load] label={label} -> {target_db}.{target_table} "
+            f"(file={src.name}, {src.stat().st_size} bytes, "
+            f"via FE 9030, target={'mysql' if is_mysql else 'doris'})"
+        ]
+
+        # 1) 规范化 CSV → tab 分隔（处理引号包裹逗号/换行字段；Doris 另做 ? 双写转义），
+        #    Doris 一次 LOAD 带 strict_mode=false + max_filter_ratio=1 全容忍放行：
+        #    跳过仍无法归化的极少数行，保留干净行，任务不整批失败。
+        #    真 MySQL 无 PROPERTIES 子句（Doris 专属）也无 ? 占位符语义：
+        #    规范化不双写 ?，LOAD 不带 PROPERTIES，ESCAPED BY '' 显式关转义
+        #    （默认 ESCAPED BY '\\' 会吃掉数据中的反斜杠）。
+        try:
+            norm = _normalize_csv(src, stdout_path.parent,
+                                  double_question=not is_mysql)
+        except Exception as exc:  # noqa: BLE001
+            return _fail(f"CSV 规范化失败: {exc}")
+        try:
+            if is_mysql:
+                summary, err = _attempt(norm, "\t", label, logs, escaped_by="")
+            else:
+                summary, err = _attempt(norm, "\t", label, logs,
+                                        max_filter_ratio=_MAX_FILTER_RATIO_FALLBACK,
+                                        strict_mode=_STRICT_MODE_FALLBACK)
+        finally:
+            try:
+                os.unlink(norm)
+            except OSError:
+                pass
+        if err is None:
+            logs.append(f"[mysql_load] loaded={summary.get('loaded_rows')}")
+            self._write_text(stdout_path, "\n".join(logs))
+            return TaskRunResult(
+                exit_code=0,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                status="success",
+                result_summary={**summary, "normalized": True,
+                                "target_engine": "mysql" if is_mysql else "doris"},
+            )
+        return _fail(f"MySQL Load 失败: {err}")
+
+    # ------------------------------------------------------------------
+    # 备用路径：直连 BE 8040 HTTP PUT（CSV_IMPORT_METHOD=stream_load 启用）
+    # ------------------------------------------------------------------
+    def _run_stream_load(
+        self,
+        src: Path,
+        target_db: str,
+        target_table: str,
+        columns,
+        label: str,
+        datasource_ref: str | None,
+        timeout_s: int,
+        stdout_path: Path,
+        stderr_path: Path,
+    ) -> TaskRunResult:
+        be_host, be_port = _be_endpoint(datasource_ref, target_db)
+
+        def _fail(msg: str) -> TaskRunResult:
+            self._write_text(stderr_path, msg)
+            return TaskRunResult(
+                exit_code=1,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                status="failed",
+                error_message=msg[:800],
+                result_summary={"label": label, "target": f"{target_db}.{target_table}",
+                                "method": "stream_load"},
+            )
+
+        headers = {
+            "label": label,
+            "format": "csv",
+            "column_separator": ",",
+            "Expect": "100-continue",
+        }
+        if columns:
+            headers["columns"] = str(columns)
+
+        url = (
+            f"http://{be_host}:{be_port}"
+            f"/api/{target_db}/{target_table}/_stream_load"
+        )
+        logs = [
+            f"[stream_load] label={label} -> {target_db}.{target_table} "
+            f"(file={src.name}, {src.stat().st_size} bytes)"
+        ]
+        try:
+            if requests is None:
+                return _fail("requests 未安装（stream_load 路径的出站请求需要）")
+            with src.open("rb") as f:
+                resp = requests.put(url, data=f, headers=headers, timeout=timeout_s)
+            body = resp.json()
+        except Exception as exc:  # noqa: BLE001
+            return _fail(f"Stream Load 请求失败: {exc}")
+
+        status = str(body.get("Status") or "")
+        loaded = body.get("NumberLoadedRows")
+        logs.append(
+            f"[stream_load] BE Status={status} loaded={loaded} "
+            f"Message={body.get('Message')!r}"
+        )
+        self._write_text(stdout_path, "\n".join(logs))
+
+        if resp.status_code != 200 or status not in ("Success", "Publish Timeout"):
+            return TaskRunResult(
+                exit_code=1,
+                stdout_path=str(stdout_path),
+                stderr_path=str(stderr_path),
+                status="failed",
+                error_message=f"Stream Load 失败: Status={status} "
+                f"Message={body.get('Message')!r} (label={label})",
+                result_summary={
+                    "label": label,
+                    "target": f"{target_db}.{target_table}",
+                    "method": "stream_load",
+                    "be_status": status,
+                },
+            )
+        return TaskRunResult(
+            exit_code=0,
+            stdout_path=str(stdout_path),
+            stderr_path=str(stderr_path),
+            status="success",
+            result_summary={
+                "label": label,
+                "target": f"{target_db}.{target_table}",
+                "method": "stream_load",
+                "loaded_rows": loaded,
+                "be_status": status,
+            },
+        )
