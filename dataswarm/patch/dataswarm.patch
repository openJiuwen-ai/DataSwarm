@@ -0,0 +1,68 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useTranslation } from 'react-i18next';
+import { useState } from 'react';
+import { ChevronDown } from 'lucide-react';
+import TableGlyph from '../../../../assets/data-management/table-glyph.svg?react';
+import { useDataManagementStore } from '../../store/dataManagementStore';
+import type { Layer, TableInfo } from '../../types/metadata';
+
+const LAYER_ORDER: Layer[] = ['ODS', 'DWD', 'DWS', 'ADS', 'OTHER'];
+
+export function TableTree() {
+  const { t } = useTranslation();
+  const { tables, selectedTable, selectTable } = useDataManagementStore();
+  const [collapsed, setCollapsed] = useState<Set<Layer>>(new Set());
+
+  const grouped: Record<Layer, TableInfo[]> = { ODS: [], DWD: [], DWS: [], ADS: [], OTHER: [] };
+  for (const t of tables) grouped[t.layer].push(t);
+
+  const toggle = (layer: Layer) =>
+    setCollapsed((cur) => {
+      const next = new Set(cur);
+      if (next.has(layer)) next.delete(layer);
+      else next.add(layer);
+      return next;
+    });
+
+  return (
+    <div className="dm-tree">
+      {LAYER_ORDER.map((layer) => {
+        const items = grouped[layer];
+        if (!items.length) return null;
+        const isCollapsed = collapsed.has(layer);
+        return (
+          <div key={layer}>
+            <button
+              type="button"
+              className="dm-tree-group-head"
+              aria-expanded={!isCollapsed}
+              onClick={() => toggle(layer)}
+            >
+              <TableGlyph width={14} height={14} />
+              <span className="dm-tree-group-name">{layer === 'OTHER' ? t('dataManagement.otherLayer') : layer}</span>
+              <span className="dm-tree-group-count">({items.length})</span>
+              <ChevronDown size={12} aria-hidden="true" />
+            </button>
+            {!isCollapsed && (
+              <ul className="dm-tree-list">
+                {items.map((t) => (
+                  <li key={t.name}>
+                    <button
+                      type="button"
+                      className="dm-tree-item"
+                      aria-current={selectedTable === t.name}
+                      onClick={() => void selectTable(t.name)}
+                      title={t.name}
+                    >
+                      {t.name}
+                    </button>
+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        );
+      })}
+    </div>
+  );
+}
