+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""timeutil.py —— 全仓唯一时间戳工具（时区策略统一，scan-waivers 待专项 #1）。
+
+策略 C2：本地时间 + 带冒号 offset（``2026-10-27T12:00:00+08:00``）。墙钟数字与
+历史 naive/``+0800`` 格式一致，字符串排序前缀 19 字符同构，前端切片零改动。
+
+例外：B 族 MySQL DATETIME 表（plan / plan_table / table_lineage / column_lineage）
+不能带 offset，用 naive 空格格式（now_db_datetime）。
+
+解析契约：naive 一律按本地时区解释（仓库主流约定；scheduler._is_due 与
+inspection_service 均此语义）。格式矩阵见 tests/unit_tests/web/test_timeutil.py。
+"""
+from __future__ import annotations
+
+from datetime import datetime
+
+
+def now_iso() -> str:
+    """当前本地时间，ISO8601 带冒号 offset、秒精度（A 族表 / API 面统一格式）。
+
+    Returns:
+        形如 ``2026-10-27T12:00:00+08:00``（25 字符）。秒精度是 VARCHAR(30) 契约，
+        勿改 timespec（微秒会 32 字符溢出）。
+    """
+    return datetime.now().astimezone().isoformat(timespec="seconds")
+
+
+def now_db_datetime() -> str:
+    """当前本地时间，naive 空格分隔（仅 B 族 MySQL DATETIME 列，不能带 offset）。
+
+    Returns:
+        形如 ``2026-10-27 12:00:00``（19 字符，MySQL DATETIME 直接可收）。
+    """
+    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")
+
+
+def parse_ts(value: str | None) -> datetime | None:
+    """解析仓库任意历史格式时间戳为 tz-aware datetime；naive 按本地时区解释。
+
+    兼容矩阵：naive ISO（``T``/空格分隔）、``+0800``、``+08:00``、``Z``、小数秒。
+
+    Args:
+        value: 时间戳字符串（DB 列 / API 字段原值）。
+
+    Returns:
+        tz-aware datetime；空串、None 或无法解析返回 None。
+    """
+    if not value:
+        return None
+    s = value.strip()
+    if not s:
+        return None
+    dt: datetime | None
+    try:
+        dt = datetime.fromisoformat(s)  # Python>=3.11 宽容：Z / 空格 / +0800 / 小数秒
+    except ValueError:
+        try:
+            dt = datetime.strptime(s, "%Y-%m-%dT%H:%M:%S%z")
+        except ValueError:
+            return None
+    if dt.tzinfo is None:
+        dt = dt.astimezone()  # naive → 本地（仓库主流约定）
+    return dt
+
+
+def parse_ts_strict(value: str | None) -> datetime:
+    """同 parse_ts，但解析失败抛 ValueError（供「坏串 = 非 due」类调用方区分）。
+
+    Args:
+        value: 时间戳字符串。
+
+    Returns:
+        tz-aware datetime。
+
+    Raises:
+        ValueError: value 为空或无法解析。
+    """
+    dt = parse_ts(value)
+    if dt is None:
+        raise ValueError(f"无法解析时间戳: {value!r}")
+    return dt
