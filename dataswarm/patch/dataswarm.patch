+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Connector metadata collection needs no live services or model calls."""
+from __future__ import annotations
+
+import json
+import sqlite3
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import build_catalog, build_schema
+from jiuwenswarm.channels.web.dataagent.semantic.adapters import metadata_adapter_for
+from jiuwenswarm.channels.web.dataagent.semantic.adapters.base import CollectionOptions
+from jiuwenswarm.channels.web.dataagent.semantic.adapters.connector import ConnectorMetadataAdapter
+from jiuwenswarm.channels.web.dataagent.semantic.adapters.mysql import MySQLMetadataAdapter
+from jiuwenswarm.channels.web.dataagent.semantic.fingerprint import diff_snapshots
+from jiuwenswarm.channels.web.dataagent.semantic.graph import build_projection
+from jiuwenswarm.channels.web.dataagent.semantic.model import MetadataSnapshot
+
+
+def source(source_type="postgresql", **config):
+    return {"source_id": "fixture", "source_type": source_type, "config": config, "config_version": 3}
+
+
+def collect(adapter, row, *, profile=True, schemas=(), sample_rows=10000):
+    return adapter.collect(row, "run", "snapshot", CollectionOptions(
+        schemas=schemas, include_profile=profile, profile_sample_rows=sample_rows))
+
+
+class FakeConnector:
+    def __init__(self, datasets=None):
+        self.datasets = datasets if datasets is not None else [{"name": "orders", "schema": "public"}]
+        self.schema_calls = []
+        self.queries = []
+        self.scans = []
+        self.closed = False
+
+    def catalog(self):
+        return build_catalog(source_id="fixture", engine="ignored_delegate_engine", datasets=self.datasets)
+
+    def schema(self, dataset, schema_name=None):
+        self.schema_calls.append((dataset, schema_name))
+        return build_schema(source_id="fixture", dataset=dataset, schema_name=schema_name, columns=[
+            {"name": "order_id", "type": "BIGINT", "pk": True, "nullable": False},
+            {"name": "status", "type": "VARCHAR", "comment": "业务状态"},
+            {"name": "phone", "type": "VARCHAR", "default": "sensitive-default"},
+        ])
+
+    def preview(self, dataset, limit=100):
+        raise AssertionError("preview must not fetch sensitive columns")
+
+    def query(self, sql, params=None, limit=100):
+        self.queries.append((sql, limit))
+        return {"ok": True, "columns": ["order_id", "status"], "rows": [[1, "open"], [2, "open"]], "truncated": False}
+
+    def scan(self, dataset, filters=None, projection=None, limit=100):
+        self.scans.append((dataset, projection, limit))
+        return {"ok": True, "columns": ["order_id", "status", "phone"],
+                "rows": [[1, "open", "must-not-persist"], [2, "open", "must-not-persist"], [3, "done", "must-not-persist"]]}
+
+    def infer_schema(self, dataset, sample=1000):
+        return {"sampled": 2, "columns": [{"name": "status", "presence": 0.5, "observed_types": ["VARCHAR", "BIGINT"]}],
+                "drift_fields": [{"name": "status", "observed_types": ["VARCHAR", "BIGINT"]}]}
+
+    def close(self):
+        self.closed = True
+
+
+def fake_adapter(monkeypatch, row, fake):
+    from jiuwenswarm.channels.web.dataagent.semantic.adapters import connector as module
+
+    def get(manager, source_id):
+        assert manager._source_loader(source_id) == row
+        assert manager._source_loader("unauthorized-other-source") is None
+        return fake
+
+    monkeypatch.setattr(module.ConnectorManager, "get", get)
+    return ConnectorMetadataAdapter()
+
+
+@pytest.mark.parametrize("source_type,engine", [
+    ("doris", "sqlalchemy"), ("postgresql", "sqlalchemy"), ("hologres", "sqlalchemy"),
+    ("sqlserver", "sqlalchemy"), ("csv", "duckdb"), ("parquet", "duckdb"),
