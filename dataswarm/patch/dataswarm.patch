+def _excel_ext_available() -> bool:
+    try:
+        import duckdb
+
+        conn = duckdb.connect(":memory:")
+        try:
+            conn.execute("LOAD excel")
+            return True
+        finally:
+            conn.close()
+    except Exception:  # noqa: BLE001 —— 扩展缺失时跳过 excel 用例
+        return False
+
