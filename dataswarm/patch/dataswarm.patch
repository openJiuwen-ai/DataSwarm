+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""datasource/service 拦截单测：同物理 ref 注册/编辑拦截（SOURCE_ALREADY_BOUND）。
+
+复现线上问题：两个 source_id 指向同一物理库时列表 bound 全 true、按钮全禁用。
+治本 = 注册/编辑入口拒绝与当前空间绑定 ref 物理等价的源。
+
+另覆盖：保存前连通性探测（库型源失败阻断，文件型跳过）、create_database、
+多源注册 + 单绑定（一空间可注册多个源；business_db_ref 单值，换绑需
+WORKSPACE_ALREADY_BOUND 确认 / rebind，bind 后写生效）。
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import service as ds_service
+from jiuwenswarm.common import workspace_store
+
+
+@pytest.mark.parametrize("source_type,endpoint,permitted", [
+    ("s3", "http://127.0.0.1:9000", True),
+    ("s3", "localhost:9000", True),
+    ("s3", "http://[::1]:9000", True),
+    ("oss", "http://127.0.0.1:9000", False),
+    ("oss", "http://[::1]:9000", False),
+    ("s3", "http://169.254.169.254", False),
+    ("s3", "http://[::ffff:169.254.169.254]", False),
+    ("s3", "http://192.168.1.1:9000", False),
+])
+def test_minio_endpoint_policy_runs_before_connection(monkeypatch, source_type, endpoint, permitted):
+    adapter = ds_service._registry.get_source_type(source_type)
+    probes = []
+
+    def probe(self, config):
+        probes.append(config["endpoint"])
+        return {"ok": True}
+
+    monkeypatch.setattr(type(adapter), "test_connection", probe)
+    result = ds_service.test_connection({"type": source_type, "location": "s3://bucket/orders.csv",
+                                         "format": "csv", "endpoint": endpoint})
+    assert result["ok"] is permitted
+    assert probes == ([endpoint] if permitted else [])
+
+
+@pytest.fixture()
+def workspace_env(monkeypatch, tmp_path):
+    """真实 workspace_store（tmp 注册表）+ 单工作空间。
+
+    业务库绑定为 duckdb 文件源 ref（与线上 D:/bank 场景一致），ref 由 csv
+    adapter 的 build_ref 生成（table_name 取路径尾段），保证与被拦截的
+    新建源构建出的 ref 归一化后等价。
+    """
+    registry = tmp_path / "workspaces.db"
+    monkeypatch.setattr(workspace_store, "_registry_path", lambda: registry)
+    monkeypatch.setattr(workspace_store, "_config_dir", lambda: tmp_path)
+    monkeypatch.setenv("JIUWENSWARM_DATA_ROOTS", str(tmp_path))
+    monkeypatch.setattr(ds_service, "_trigger_schema_derivation", lambda *args: {"status": "queued"})
+    biz_dir = tmp_path / "biz"
+    bound_ref = ds_service._registry.get_source_type("csv").build_ref({"path": str(biz_dir)})
+    record = workspace_store.create_workspace("拦截测试空间", bound_ref)
+    return record["workspace_id"], str(biz_dir)
+
+
+def _make_store(monkeypatch, sources: list[dict]):
+    """替身 dw_datasources store：记录 insert/update 调用。"""
+    calls: list[dict] = []
+
+    class FakeStore:
+        def list_sources(self, workspace_id=None):
+            return list(sources)
+
+        def find_source(self, source_id, workspace_id=None):
+            for source in sources:
+                if source["source_id"] == source_id:
+                    return source
+            return None
+
+        def insert_source(self, source_id, source_type, name, config, db_ref, workspace_id=None,
+                          description=""):
+            calls.append({"op": "insert", "source_id": source_id, "description": description,
+                          "config": dict(config)})
+            return {"source_id": source_id, "db_ref": db_ref}
+
+        def update_source_row(self, source_id, source_type, name, config, db_ref, workspace_id=None,
+                              description=""):
+            calls.append({"op": "update", "source_id": source_id, "description": description,
+                          "config": dict(config)})
+            return {"source_id": source_id, "db_ref": db_ref}
+
+    monkeypatch.setattr(ds_service, "_store", FakeStore())
+    return calls
+
+
+CSV_PARAMS = {
+    "source_id": "dup_csv",
+    "type": "csv",
+    "table_name": "t",
+}
+
+DORIS_PARAMS = {
+    "source_id": "doris_src",
+    "type": "doris",
+    "host": "127.0.0.1",
+    "port": 9030,
+    "user": "root",
+    "password": "pw",
+    "database": "demo_db",
+}
+
+MYSQL_PARAMS = {
+    "source_id": "mysql_src",
+    "type": "mysql",
+    "host": "127.0.0.1",
+    "port": 3306,
+    "user": "readonly",
+    "password": "pw",
+    "database": "orders",
+}
+
+
+def _patch_probe(monkeypatch, result: dict) -> None:
+    """把库型源的探测替换为固定结果（绕开真实网络）。"""
+    monkeypatch.setattr(
+        ds_service, "_probe_blocked",
+        lambda adapter, config: None if result.get("ok") else dict(result),
+    )
+
+
+# ==========================================================================
+# 保存前探测：库型源失败阻断，文件型跳过
+# ==========================================================================
+def test_create_source_blocked_when_db_not_found(monkeypatch, workspace_env):
+    """库型源探测报 Unknown database(1049) → DB_NOT_FOUND，不落库。"""
+    _make_store(monkeypatch, [])
+    doris = ds_service._registry.get_source_type("doris")
+    monkeypatch.setattr(
+        type(doris), "test_connection",
+        lambda self, config: {"ok": False, "error": "(1049, \"Unknown database 'demo_db'\")"},
+    )
+    result = ds_service.create_source({**DORIS_PARAMS, "path": "D:/biz"})
+    assert result["ok"] is False
+    assert result["error_code"] == "DB_NOT_FOUND"
+
+
+def test_create_source_blocked_when_probe_fails(monkeypatch, workspace_env):
+    """库型源探测失败（非库不存在）→ TEST_FAILED，不落库。"""
+    calls = _make_store(monkeypatch, [])
+    doris = ds_service._registry.get_source_type("doris")
+    monkeypatch.setattr(
+        type(doris), "test_connection",
+        lambda self, config: {"ok": False, "error": "connection refused"},
