+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 跨模块共享的交互反馈层：Toast / 确认框 / useAction。
+ * ToastHost / ConfirmHost 在 App 主区挂载一次，所有模块经 toast.* / confirmDialog() 调用。
+ * 交互约定（与 dataAsset 既有约定一致）：
+ *   - 破坏性/状态变更操作 → confirmDialog() 弹确认框，确定才执行
+ *   - 所有异步动作 → Button loading 防重复点 + toast.success/error 反馈结果
+ */
+
+import { useCallback, useEffect, useId, useRef, useState, type ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { X } from 'lucide-react';
+import { Button } from '../../../components/ui/Button/Button';
+import '../../../components/ui/Dialog/Dialog.css';
+import './Feedback.css';
+
+// ---- Toast：操作结果反馈（右上角浮层，自动消失） ----
+
+interface ToastItem {
+  id: number;
+  kind: 'success' | 'error';
+  text: string;
+}
+
+let toastListeners: Array<(t: ToastItem) => void> = [];
+let toastSeq = 0;
+
+function emitToast(kind: ToastItem['kind'], text: string) {
+  const item: ToastItem = { id: ++toastSeq, kind, text };
+  toastListeners.forEach((l) => l(item));
+}
+
+export const toast = {
+  success: (text: string) => emitToast('success', text),
+  error: (text: string) => emitToast('error', text),
+};
+
+/** Toast 浮层宿主：挂在应用根部一次即可，页面用 toast.success()/toast.error() 触发 */
+export function ToastHost() {
+  const [items, setItems] = useState<ToastItem[]>([]);
+  useEffect(() => {
+    const listener = (t: ToastItem) => {
+      setItems((cur) => [...cur, t]);
+      window.setTimeout(() => setItems((cur) => cur.filter((x) => x.id !== t.id)), t.kind === 'error' ? 4500 : 2500);
+    };
+    toastListeners.push(listener);
+    return () => {
+      toastListeners = toastListeners.filter((l) => l !== listener);
+    };
+  }, []);
+  return (
+    <div className="pointer-events-none fixed right-4 top-4 z-[100] flex flex-col items-end gap-2">
+      {items.map((t) => (
+        <div
+          key={t.id}
+          role="status"
+          className={`pointer-events-auto flex items-center gap-1.5 rounded-lg border px-3 py-2 text-sm shadow-lg ${
+            t.kind === 'success' ? 'border-ok text-text-strong' : 'border-danger text-text-strong'
+          }`}
+          style={{
+            backgroundColor:
+              t.kind === 'success' ? 'var(--color-feedback-success-toast)' : 'var(--color-feedback-danger-toast)',
+          }}
+        >
+          <span
+            style={{ color: t.kind === 'success' ? 'var(--color-feedback-success)' : 'var(--color-feedback-danger)' }}
+          >
+            {t.kind === 'success' ? '✓' : '✕'}
+          </span>
+          {t.text}
+        </div>
+      ))}
+    </div>
+  );
+}
+
+// ---- 确认框：破坏性/状态变更操作先确认再执行 ----
+
+export interface ConfirmOptions {
+  title: string;
+  message?: ReactNode;
+  confirmText?: string;
+  cancelText?: string;
+  /** 危险操作（删除等）确认按钮用 danger 色 */
+  danger?: boolean;
+  appearance?: 'default' | 'workspace-delete';
+}
+
+let confirmListener: ((opts: ConfirmOptions, resolve: (ok: boolean) => void) => void) | null = null;
+
+/** Promise 化确认框：await confirmDialog({ title, danger: true }) === 用户点了确定 */
+export function confirmDialog(opts: ConfirmOptions): Promise<boolean> {
+  return new Promise((resolve) => {
+    if (confirmListener) confirmListener(opts, resolve);
+    else resolve(window.confirm(opts.title)); // 宿主未挂载时兜底
+  });
+}
+
+/** 确认框宿主：挂在应用根部一次即可 */
+export function ConfirmHost() {
+  const { t } = useTranslation();
+  const titleId = useId();
+  const [pending, setPending] = useState<{ opts: ConfirmOptions; resolve: (ok: boolean) => void } | null>(null);
+  useEffect(() => {
+    confirmListener = (opts, resolve) => setPending({ opts, resolve });
+    return () => {
+      confirmListener = null;
+    };
+  }, []);
+  useEffect(() => {
+    if (!pending) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        pending.resolve(false);
+        setPending(null);
+      }
+    };
+    document.addEventListener('keydown', onKeyDown);
+    return () => document.removeEventListener('keydown', onKeyDown);
+  }, [pending]);
+  if (!pending) return null;
+  const close = (ok: boolean) => {
+    pending.resolve(ok);
+    setPending(null);
+  };
+  const isWorkspaceDelete = pending.opts.appearance === 'workspace-delete';
+  if (isWorkspaceDelete) {
+    return (
+      <div
+        className="feedback-confirm-backdrop feedback-confirm-backdrop--workspace-delete"
+        onClick={() => close(false)}
+      >
+        <div
+          className="feedback-confirm feedback-confirm--workspace-delete"
+          onClick={(event) => event.stopPropagation()}
+          role="alertdialog"
+          aria-modal="true"
+          aria-labelledby={titleId}
+          aria-describedby={pending.opts.message ? `${titleId}-message` : undefined}
+        >
+          <div className="feedback-confirm__header">
+            <h3 id={titleId}>{pending.opts.title}</h3>
+            <button
+              type="button"
+              className="feedback-confirm__close"
+              aria-label={t('common.close')}
+              title={t('common.close')}
+              onClick={() => close(false)}
+            >
+              <X size={16} aria-hidden="true" />
+            </button>
+          </div>
+          {pending.opts.message && (
+            <div id={`${titleId}-message`} className="feedback-confirm__message">
+              {pending.opts.message}
+            </div>
+          )}
+          <div className="feedback-confirm__actions">
+            <button type="button" className="feedback-confirm__button" onClick={() => close(false)} autoFocus>
+              {pending.opts.cancelText ?? t('common.cancel')}
+            </button>
+            <button
+              type="button"
+              className="feedback-confirm__button feedback-confirm__button--danger"
+              onClick={() => close(true)}
+            >
+              {pending.opts.confirmText ?? t('common.confirm')}
+            </button>
+          </div>
+        </div>
+      </div>
+    );
+  }
+  return (
+    <div
+      className="fixed inset-0 z-[1300] flex items-center justify-center"
+      style={{ background: 'var(--color-backdrop)' }}
+      onClick={() => close(false)}
+    >
+      <div
+        className="ui-dialog feedback-confirm--default overflow-y-auto"
+        onClick={(e) => e.stopPropagation()}
+        role="alertdialog"
+        aria-modal="true"
+        aria-labelledby={titleId}
+        aria-describedby={pending.opts.message ? `${titleId}-message` : undefined}
+      >
+        <header className="flex items-center justify-between gap-6 px-6 pb-3 pt-6">
+          <h3 id={titleId} className="m-0 text-xl font-semibold leading-7">{pending.opts.title}</h3>
+          <Button
+            variant="quiet"
+            className="shrink-0"
+            icon={<X size={20} aria-hidden="true" />}
+            aria-label={t('common.close')}
+            onClick={() => close(false)}
+          />
+        </header>
+        {pending.opts.message && (
+          <div id={`${titleId}-message`} className="px-6 pb-6 pt-3 text-sm leading-[22px] text-text-muted">
+            {pending.opts.message}
+          </div>
+        )}
+        <footer className="flex justify-end gap-2 px-6 pb-6 pt-3">
+          <Button size="sm" className="min-w-[84px]" onClick={() => close(false)} autoFocus>
+            {pending.opts.cancelText ?? t('common.cancel')}
+          </Button>
+          <Button
+            size="sm"
+            className="min-w-[84px]"
+            variant={pending.opts.danger ? 'danger' : 'primary'}
+            onClick={() => close(true)}
+          >
+            {pending.opts.confirmText ?? t('common.confirm')}
+          </Button>
+        </footer>
+      </div>
+    </div>
+  );
+}
+
+// ---- useAction：动作执行统一封装（busy 锁 + toast 反馈） ----
+
+/**
+ * 列表页动作统一走这里：按 key 加锁防重复点，成功/失败 toast 反馈。
+ * 动作抛出异常时直接显示错误信息。
+ * 返回约定：false/null = 失败（错误 toast）；undefined = 用户取消（静默，无任何 toast）；
+ * 其余（true/对象）= 成功（successText toast）。
+ */
+export function useAction() {
+  const { t } = useTranslation();
+  const [busy, setBusy] = useState<string | null>(null);
+  const busyRef = useRef<string | null>(null);
+  const run = useCallback(
+    async (key: string, successText: string | null, fn: () => Promise<boolean | object | null | undefined>) => {
+      if (busyRef.current) return;
+      busyRef.current = key;
+      setBusy(key);
+      try {
+        const result = await fn();
+        const failed = result === false || result === null;
+        if (failed) toast.error(t('common.operationFailed'));
+        else if (result !== undefined && successText) toast.success(successText);
+        return result;
+      } catch (e) {
+        toast.error(e instanceof Error ? e.message : t('common.operationFailed'));
+      } finally {
+        busyRef.current = null;
+        setBusy(null);
+      }
+    },
+    [t],
+  );
+  return { busy, run };
+}
