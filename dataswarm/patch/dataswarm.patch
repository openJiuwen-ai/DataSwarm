+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Optional snapshot metadata must not invalidate successful column reflection."""
+from pathlib import Path
+import socket
+import sqlite3
+from unittest.mock import Mock
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.connectors import base
+from jiuwenswarm.channels.web.dataagent.databases import service
+from jiuwenswarm.channels.web.dataagent.datasource import registry, store
+from jiuwenswarm.common import db_connector as dbc, ref_codec, workspace_context
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path, monkeypatch):
+    ref = f"sqlite://{tmp_path / 'metadata.db'}"
+    monkeypatch.setenv("JIUWENSWARM_DATASOURCE_DB", ref)
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", ref)
+    monkeypatch.setenv("JIUWENSWARM_DEPLOY_SCHEMA_DIR", str(Path(__file__).resolve().parents[3] / "deploy" / "schema"))
+    monkeypatch.setattr(dbc, "_read_config_section", lambda _: {})
+    monkeypatch.setattr(socket.socket, "connect", lambda *args: pytest.fail("network access forbidden"))
+    token = workspace_context.set_current(None)
+    try:
+        yield
+    finally:
+        workspace_context.reset(token)
+        dbc._invalidate(ref, read_only=True)
+        dbc._invalidate(ref, read_only=False)
+
+
+def assert_columns_without_optional_error(entry):
+    assert "error" not in entry
+    assert {col["name"] for col in entry["columns"]} == {"id", "revenue"}
+    assert entry["metadata_status"] == {"indexes": "unsupported", "create_sql": "unsupported"}
+    assert entry["indexes"] == [] and entry["create_sql"] == ""
+
+
+def test_real_saved_ddl_snapshot_keeps_structure_without_optional_calls(monkeypatch):
+    config = {"ddl_text": "CREATE TABLE orders (id BIGINT PRIMARY KEY, revenue NUMERIC(12,2));",
+              "dialect": "postgres"}
+    ref = registry.get_source_type("ddl").build_ref(config)
+    store.insert_source("ddl", "ddl", "DDL", config, ref)
+    forbidden = Mock(side_effect=AssertionError("optional metadata must not be queried"))
+    monkeypatch.setattr(dbc, "list_indexes", forbidden)
+    monkeypatch.setattr(dbc, "show_create_table", forbidden)
+    report = service.schema_snapshot(ref)
+    assert report["ok"] is True and report["table_count"] == 1
+    assert_columns_without_optional_error(report["tables"][0])
+    assert report["tables"][0]["columns"][0]["pk"] is True
+    forbidden.assert_not_called()
+
+
+@pytest.mark.parametrize("ref", [
+    "mongodb://host:27017/data",
+    "redis://host:6379/0",
+    "hbase://host:9090",
+])
+def test_remote_snapshot_uses_metadata_only_and_keeps_valid_columns(monkeypatch, ref):
+    class MetadataConnector:
+        def __init__(self, source):
+            self.source = source
+
+        def catalog(self):
+            return {"datasets": [{"name": "orders"}]}
+
+        def schema(self, table):
+            return {"columns": [{"name": "id", "type": "BIGINT", "pk": True},
+                                {"name": "revenue", "type": "DECIMAL(12,2)"}]}
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(base, "get_engine", lambda _: MetadataConnector)
+    forbidden = Mock(side_effect=AssertionError("unsupported metadata must not be queried"))
+    monkeypatch.setattr(dbc, "list_indexes", forbidden)
+    monkeypatch.setattr(dbc, "show_create_table", forbidden)
+    report = service.schema_snapshot(ref)
+    assert report["ok"] is True
+    assert_columns_without_optional_error(report["tables"][0])
+    forbidden.assert_not_called()
+
+
+def test_real_sqlite_snapshot_keeps_indexes_and_create_sql(tmp_path):
+    path = tmp_path / "business.db"
+    with sqlite3.connect(path) as connection:
+        connection.executescript("CREATE TABLE orders(id INTEGER PRIMARY KEY, revenue NUMERIC);"
+                                 "CREATE INDEX idx_revenue ON orders(revenue);")
+    ref = f"sqlite://{path}"
+    try:
+        entry = service.schema_snapshot(ref)["tables"][0]
+        assert entry["metadata_status"] == {"indexes": "available", "create_sql": "available"}
+        assert entry["indexes"][0]["name"] == "idx_revenue"
+        assert "CREATE TABLE orders" in entry["create_sql"]
+        assert "error" not in entry
+    finally:
+        dbc._invalidate(ref, read_only=True)
+
+
+@pytest.mark.parametrize("failed", [("indexes",), ("create_sql",), ("indexes", "create_sql")])
+def test_implemented_metadata_errors_are_not_mislabeled_unsupported(monkeypatch, failed):
+    monkeypatch.setattr(dbc, "schema", lambda *args: {"columns": [{"name": "id", "type": "BIGINT"}]})
+    probes = {}
+    for key, operation in (("indexes", "list_indexes"), ("create_sql", "show_create_table")):
+        probe = Mock(return_value={key: [] if key == "indexes" else "CREATE TABLE t(id INT)"})
+        if key in failed:
+            # Wording deliberately resembles the capability rejection message.
+            probe.side_effect = ValueError("database does not support requested feature or permission denied")
+        probes[key] = probe
+        monkeypatch.setattr(dbc, operation, probe)
+    entry = service.schema_snapshot("sqlite://unused.db", tables=["orders"])["tables"][0]
+    assert entry["columns"][0]["name"] == "id"
+    assert entry["error"]
+    for key, probe in probes.items():
+        probe.assert_called_once()
+        assert entry["metadata_status"][key] == ("failed" if key in failed else "available")
+    assert set(entry["metadata_errors"]) == set(failed)
+
+
+def test_primary_schema_error_still_marks_entry_and_skips_optional_calls(monkeypatch):
+    monkeypatch.setattr(dbc, "schema", Mock(side_effect=RuntimeError("schema unavailable")))
+    forbidden = Mock(side_effect=AssertionError("cannot probe a failed table"))
+    monkeypatch.setattr(dbc, "list_indexes", forbidden)
+    monkeypatch.setattr(dbc, "show_create_table", forbidden)
+    entry = service.schema_snapshot("sqlite://unused.db", tables=["orders"])["tables"][0]
+    assert entry["error"] == "RuntimeError: schema unavailable"
+    assert "columns" not in entry
+    forbidden.assert_not_called()
+
+
+def test_self_managed_override_is_capability_not_scheme_guess(monkeypatch):
+    class CustomCodec(ref_codec.RefCodec):
+        scheme = "snapshot_probe"
+        uses_pool = False
+
+        def decode(self, rest, ref):
+            return {"type": self.scheme}
+
+        def describe(self, spec, table):
+            return {"columns": [{"name": "id", "type": "INT"}]}
+
+        def indexes(self, spec):
+            return [{"name": "known", "columns": ["id"], "unique": True}]
+
+        def meta(self, spec):
+            return {"type": self.scheme}
+
+    monkeypatch.setitem(ref_codec._CODECS, "snapshot_probe", CustomCodec())
+    entry = service.schema_snapshot("snapshot_probe://x", tables=["orders"])["tables"][0]
+    assert entry["metadata_status"] == {"indexes": "available", "create_sql": "unsupported"}
+    assert entry["indexes"][0]["name"] == "known"
+    assert "error" not in entry
