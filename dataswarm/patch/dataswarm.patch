+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""setup_dev.py —— 开发环境初始化（拉代码后的第一条命令）。
+
+步骤：校验工具链（uv / npm）→ `uv sync` → 前端 `npm install` → 打印验证命令。
+幂等：uv sync 与 npm install 本身幂等；--check-only 只检查不写。
+
+用法:
+    python scripts/dataswarm/fork/setup_dev.py [--skip-frontend] [--check-only]
+"""
+from __future__ import annotations
+
+import argparse
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+FRONTEND_DIR = REPO_ROOT / "jiuwenswarm" / "channels" / "web" / "frontend"
+
+if sys.stdout.encoding and sys.stdout.encoding.lower() not in ("utf-8", "utf8"):
+    sys.stdout.reconfigure(encoding="utf-8")
+    sys.stderr.reconfigure(encoding="utf-8")
+
+
+def run(cmd: list[str], cwd: Path | None = None) -> int:
+    print(f"[*] {' '.join(cmd)}（{cwd or REPO_ROOT}）")
+    return subprocess.run(cmd, cwd=cwd or REPO_ROOT).returncode
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="开发环境初始化：uv sync + 前端依赖")
+    ap.add_argument("--skip-frontend", action="store_true", help="跳过前端 npm install")
+    ap.add_argument("--check-only", action="store_true", help="只检查工具链/分支，不安装")
+    args = ap.parse_args()
+
+    branch = subprocess.run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
+                            cwd=REPO_ROOT, capture_output=True, text=True).stdout.strip()
+    if branch != "develop_oss":
+        print(f"[WARN] 当前分支 {branch or 'detached'} 不是 develop_oss——依赖仍可安装，注意验证目标", file=sys.stderr)
+
+    uv = shutil.which("uv")
+    npm = shutil.which("npm")
+    if not uv:
+        print("[FAIL] 未找到 uv——安装见 https://docs.astral.sh/uv/", file=sys.stderr)
+        return 2
+    if not args.skip_frontend and not npm:
+        print("[FAIL] 未找到 npm（Node.js）——或加 --skip-frontend 跳过前端", file=sys.stderr)
+        return 2
+
+    if args.check_only:
+        print(f"[OK] 工具链: uv={uv}, npm={npm or '(跳过)'}")
+        return 0
+
+    rc = run([uv, "sync"])
+    if rc != 0:
+        return rc
+    if not args.skip_frontend:
+        if not FRONTEND_DIR.is_dir():
+            print(f"[FAIL] 前端目录不存在: {FRONTEND_DIR}", file=sys.stderr)
+            return 2
+        rc = run([npm, "install"], cwd=FRONTEND_DIR)
+        if rc != 0:
+            return rc
+
+    print("[OK] 环境就绪。验证：")
+    print("     uv run python -c \"import jiuwenswarm, sqlglot; print('ok')\"")
+    print("     uv run pytest tests/unit_tests/ -x -q")
+    print("     前端: cd jiuwenswarm/channels/web/frontend && npm run build")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
