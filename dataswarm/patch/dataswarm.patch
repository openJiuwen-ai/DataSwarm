+# --------------------------------------------------------------------------- #
+# sticky binding fallback (interaction supervisor runs tools outside the
+# request Task, so the ContextVar set at the chat entry never reaches tool
+# execution — cron sticky context handles the same problem)
+# --------------------------------------------------------------------------- #
+async def test_sticky_binding_survives_fresh_task_context(kb_workspace, monkeypatch):
+    """新 Task（无 ContextVar 值）里执行工具时回退 sticky 绑定。"""
+
+    stub = _StubKB()
+    monkeypatch.setattr(KnowledgeBaseManager, "_build_kb", _stub_build(stub))
+
+    mgr = KnowledgeBaseManager.get(kb_workspace)
+    kb_tools.set_global_kb_manager(mgr, kb_workspace)
+
+    project_ws = os.path.join(kb_workspace, "proj-sticky")
+    os.makedirs(project_ws, exist_ok=True)
+
+    def _run_in_request_task():
+        token = kb_tools.bind_kb_workspace(project_ws)
+        kb_tools.reset_kb_workspace(token)  # 模拟请求 Task 结束后 ContextVar 消失
+
+    _run_in_request_task()
+
+    # 模拟 interaction supervisor：在请求 Task 之外的新上下文里执行工具
+    async def _supervisor_side_call():
+        return await _raw(kb_tools.kb_create)(kb_id="sticky_kb")
+
+    result = await _supervisor_side_call()
+    assert result["success"] is True
+    # sticky 命中 → 落到项目 workspace，而非全局
+    project_mgr = KnowledgeBaseManager.get(project_ws)
+    assert any(k["kb_id"] == "sticky_kb" for k in await project_mgr.list_kbs())
+    assert all(k["kb_id"] != "sticky_kb" for k in await mgr.list_kbs())
+
