+from jiuwenswarm.channels.web.dataagent.datasource import registry as R
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common import dialect_registry as dr
+
+PORT = int(sys.argv[1])
+CONFIG = {
+    "host": "127.0.0.1", "port": PORT,
+    "sample_size": 2000, "materialize_limit": 60000,
+}
+TABLE = "fact_orders"
+
+PASS, FAIL, SKIP = [], [], []
+
+BASELINE = {
+    "Q1 单指标总量": [["2318839.92"]],
+    "Q2 分组TopN排序": [["4", "620606.75"], ["2", "620448.25"], ["3", "532051.48"]],
+    "Q3 时间粒度月度": [["2026-01", "99018.5"], ["2026-02", "91174.23"],
+                        ["2026-03", "97070.7"]],
+    "Q4 过滤+聚合": [["1", "10651"], ["2", "12425"], ["3", "10650"], ["4", "12425"]],
+    "Q5 空值占比": [["7.142"]],
+}
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+def connector_for(config=None, source_id="verify"):
+    adapter = R.get_source_type("hbase")
+    source = SourceDefinition(
+        source_id, "hbase", "verify", adapter.engine, dict(config or CONFIG)
+    )
+    return get_engine(adapter.engine)(source)
+
+
+def norm(rows):
+    out = []
+    for row in rows:
+        cells = []
+        for v in row:
+            try:
+                cells.append(f"{float(v):.4f}")
+            except (TypeError, ValueError):
+                cells.append(str(v))
+        out.append(cells)
+    return out
+
