+def test_sampled_connector_does_not_build_mql_pipelines():
+    """SQL 在采样物化后交由 DuckDB 执行，不下推为 MQL 聚合管道。
+
+    避免两套查询语义转换后产生不一致结果；查询入口仍须执行只读校验。
+    """
+    import inspect as _inspect
+
+    from jiuwenswarm.channels.web.dataagent.connectors import sampled_connector as sc
+
+    src = _inspect.getsource(sc)
+    for banned in ("$match", "$group", "$lookup", "aggregate("):
+        assert banned not in src, f"出现 MQL 聚合管道构造（{banned}）"
+    query_src = _inspect.getsource(sc.SampledStoreConnector.query)
+    assert "_materialize(" in query_src, "query 应先物化"
+    assert "validate_read_only_sql" in query_src, "query 必须过只读护栏"
