+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""分析账本只读摘要，兼容没有开放分析字段的历史会话。"""
+from __future__ import annotations
+
+from typing import Any
+
+from .open_analysis import is_usable_evidence
+
+
+def summarize_manifest(manifest: dict[str, Any]) -> dict[str, Any]:
+    """从当前计划和最新证据推导覆盖率，不把 gate 通过等同报告已交付。"""
+    plan = manifest.get("plan") or {}
+    planned = plan.get("components") or []
+    states = manifest.get("components") or {}
+    if not isinstance(states, dict):
+        states = {}
+    planned_ids = {c.get("component_id") for c in planned}
+    evidence = [e for e in manifest.get("evidence") or [] if isinstance(e, dict)]
+    usable = [e for e in evidence if is_usable_evidence(e, planned_ids=planned_ids, states=states)]
+    covered = {e.get("component_id") for e in usable}
+    required = [c for c in planned if c.get("required", True)]
+    facets = plan.get("facets") or manifest.get("facets") or []
+    facet_rows = []
+    for facet in facets:
+        ids = facet.get("component_ids") or []
+        skipped = [cid for cid in ids if states.get(cid, {}).get("status") == "skipped"]
+        facet_rows.append({**facet, "status": "done" if ids and all(cid in covered for cid in ids)
+                           else "skipped" if skipped and len(skipped) == len(ids) else "partial",
+                           "skip_reasons": [states[cid].get("skip_reason") or "原因未记录" for cid in skipped]})
+    return {
+        "mode": plan.get("mode") or manifest.get("mode") or "closed",
+        "required_count": len(required),
+        "required_covered": sum(c.get("component_id") in covered for c in required),
+        "optional_count": sum(not c.get("required", True) for c in planned),
+        "skipped_count": sum(s.get("status") == "skipped" for s in states.values()),
+        "evidence_count": len(evidence), "usable_evidence_count": len(usable),
+        "authoritative_count": sum(bool(e.get("authoritative")) for e in usable),
+        "facets": facet_rows,
+        "report_gate": manifest.get("report_gate"),
+        "knowledge": manifest.get("knowledge", {}).get("trace", {}),
+        "context_strategy": manifest.get("scale_gate") or (manifest.get("context") or {}).get("scale_gate", {}),
+        "knowledge_retrieval": manifest.get("knowledge_retrieval")
+                              or (manifest.get("context") or {}).get("knowledge_retrieval", {}),
+        "pre_plan_rules": ((manifest.get("context") or {}).get("packs") or {}).get("knowledge_rule_trace", {}),
+    }
