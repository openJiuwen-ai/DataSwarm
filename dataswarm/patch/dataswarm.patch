+++ b/jiuwenswarm/channels/web/frontend/src/features/_shared/lineage/columnLineageModel.ts
@@ -0,0 +1,89 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+export interface ColumnLineageEdgeIdentity {
+  from: string;
+  to: string;
+  transformation: string | null | undefined;
+}
+
+export interface ColumnLineageGraph {
+  nodes: readonly { id: string }[];
+  edges: readonly ColumnLineageEdgeIdentity[];
+}
+
+export interface ColumnLineageReference {
+  id: string;
+  transformation: ColumnLineageEdgeIdentity['transformation'];
+}
+
+export interface ColumnLineageRow {
+  id: string;
+  table: string;
+  column: string;
+  sources: ColumnLineageReference[];
+  targets: ColumnLineageReference[];
+}
+
+/** Only identical relations are duplicates; different expressions remain separate. */
+export function dedupeColumnLineageEdges<T extends ColumnLineageEdgeIdentity>(edges: readonly T[]): T[] {
+  const seen = new Map<string, Map<string, Set<ColumnLineageEdgeIdentity['transformation']>>>();
+  return edges.filter((edge) => {
+    let byTarget = seen.get(edge.from);
+    if (!byTarget) {
+      byTarget = new Map();
+      seen.set(edge.from, byTarget);
+    }
+    let transformations = byTarget.get(edge.to);
+    if (!transformations) {
+      transformations = new Set();
+      byTarget.set(edge.to, transformations);
+    }
+    if (transformations.has(edge.transformation)) return false;
+    transformations.add(edge.transformation);
+    return true;
+  });
+}
+
+export function buildColumnLineageRows(graph: ColumnLineageGraph): ColumnLineageRow[] {
+  const rows = new Map<string, ColumnLineageRow>();
+  const rowFor = (id: string): ColumnLineageRow => {
+    let row = rows.get(id);
+    if (!row) {
+      // API identifiers use table.column or database.table.column. Keep the full
+      // table qualifier, so same-named tables in different databases never merge.
+      const separator = id.lastIndexOf('.');
+      row = {
+        id,
+        table: separator < 0 ? '' : id.slice(0, separator),
+        column: id.slice(separator + 1),
+        sources: [],
+        targets: [],
+      };
+      rows.set(id, row);
+    }
+    return row;
+  };
+
+  for (const node of graph.nodes) rowFor(node.id);
+  for (const edge of dedupeColumnLineageEdges(graph.edges)) {
+    rowFor(edge.from).targets.push({ id: edge.to, transformation: edge.transformation });
+    rowFor(edge.to).sources.push({ id: edge.from, transformation: edge.transformation });
+  }
+  return [...rows.values()].sort((a, b) => a.id.localeCompare(b.id));
+}
+
+export function filterColumnLineageRows(
+  rows: readonly ColumnLineageRow[],
+  table: string,
+  search: string,
+): ColumnLineageRow[] {
+  const term = search.trim().toLowerCase();
+  return rows.filter(
+    (row) =>
+      (!table || row.table === table) &&
+      (!term ||
+        row.id.toLowerCase().includes(term) ||
+        [...row.sources, ...row.targets].some(
+          (ref) => ref.id.toLowerCase().includes(term) || ref.transformation?.toLowerCase().includes(term),
+        )),
+  );
+}
