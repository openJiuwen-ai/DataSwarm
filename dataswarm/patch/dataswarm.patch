+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { ColumnLineageGraph } from '../../_shared/lineage/columnLineageModel';
+
+export type Severity = 'high' | 'medium' | 'low' | 'info';
+
+export interface Finding {
+  id: string;
+  /** finding 身份 v1（run_pipeline 注入）：勾选/plan/execute/API 全链唯一键 */
+  finding_uid?: string;
+  source_finding_id?: string;
+  finding_fingerprint?: string;
+  severity: Severity;
+  category: string;
+  object?: Record<string, unknown>;
+  summary: string;
+  detail?: string;
+  evidence?: Record<string, unknown>;
+  fixable?: boolean;
+  fix_hint?: { strategy?: string; risk?: string };
+  /** AI 解读（--ai-report 时 ai_interpret 回写产物文件；旁路增强字段，缺省不展示） */
+  ai_summary?: string;
+}
+
+export interface HealthDimension {
+  high: number;
+  medium: number;
+  low: number;
+  info: number;
+  total: number;
+  score: number;
+}
+
+export interface InspectionSummary {
+  status: 'success' | 'failed';
+  meta: { run_id: string; db: string; run_at: string; artifact_dir: string };
+  errors: string[];
+  /** AI 解读降级标记（LLM 超时/失败时 true；区别于「未开启/未配置」）——面板占位用 */
+  ai_degraded?: boolean;
+  stage_durations_s?: Record<string, number>;
+  health_scores?: Record<'schema' | 'quality' | 'lineage' | 'metric' | 'task', HealthDimension>;
+  schema_summary?: { count: number; high: number };
+  data_summary?: { count: number; high: number };
+  zscore_summary?: { anomalies: number; tables: string[] };
+  lineage_summary?: { nodes: number; edges: number; findings: number };
+  column_lineage_summary?: { nodes: number; edges: number };
+  metric_summary?: { count: number; high: number; metrics: number };
+  task_summary?: { count: number; high: number };
+  // run_pipeline 落盘 summary.json 时带的 findings 文件路径（后端 fix/plan 端点用，前端一般不直接用）
+  schema_findings?: string;
+  data_findings?: string;
+  /** run 级 AI 解读（--ai-report 开启且 LLM 成功时存在；旁路增强字段） */
+  ai_summary?: string;
+  /** ai_interpret 产物文件路径（可追溯 model/prompt_version） */
+  ai_report?: string;
+}
+
+export interface InspectionManifest {
+  run_id: string;
+  status: 'queued' | 'running' | 'success' | 'failed';
+  db: string;
+  started_at: string;
+  finished_at?: string | null;
+  baseline_source_db?: string | null;
+  session_id?: string;  // 关联发起巡检的会话，修复时复用上下文
+  errors?: string[];
+}
+
+export interface FindingsArtifact {
+  meta?: { run_id?: string; inspected_tables?: string[] };
+  findings: Finding[];
+}
+
+/** M3 根因假设（AI 产物，与确定性 trace 结论区分，source 恒为 ai_hypothesis） */
+export interface RcaHypothesis {
+  hypothesis: string;
+  confidence: 'high' | 'medium' | 'low' | string;
+  supporting_evidence?: string[];
+  verify_action?: string;
+}
+
+export interface RootCauseArtifact extends FindingsArtifact {
+  trace?: { symptom_table?: string; root_node?: string; chain_depth?: number; note?: string };
+  hypotheses?: RcaHypothesis[];
+  hypotheses_meta?: { source?: string; prompt_version?: string };
+}
+
+export interface ZscoreArtifact extends FindingsArtifact {
+  anomalies?: Array<{ bucket: string; metric: string; metric_value: number; anomaly_score: number; direction: string }>;
+  /** 每个时间桶的基线统计（含真实 value、期望 mean、stddev、z），用于画基线时序线。 */
+  baselines?: Array<{ bucket: string; metric: string; value: number; mean: number; stddev: number; z: number; n: number }>;
+}
+
+export interface LineageNode { table: string; layer?: string; rowcount?: number }
+export interface LineageEdge { from: string; to: string; join_key?: string | null }
+export interface LineageArtifact extends FindingsArtifact {
+  graph: { nodes: LineageNode[]; edges: LineageEdge[] };
+}
+
+export interface ColumnLineageArtifact extends FindingsArtifact {
+  graph: ColumnLineageGraph;
+}
+
+export interface MetricArtifact extends FindingsArtifact {
+  metric_values: Array<{ metric: string; business_meaning: string; caliber_values: Array<{ caliber: string; value: number | null; note: string; source_table: string }> }>;
+}
+
+export interface TaskRun {
+  run_id: string; task_id: string; status: string; start_ts: string; end_ts?: string | null;
+  duration_s?: number | null; output_rows?: number | null; retry_count: number;
+}
+export interface TaskArtifact extends FindingsArtifact {
+  graph: { nodes: Array<{ task_id: string; task_name: string; layer: string; latest_run?: TaskRun }>; edges: Array<{ from: string; to: string }> };
+  runs: TaskRun[];
+  summary: {
+    task_count: number; run_count: number;
+    success_count?: number; failed_count?: number; skipped_count?: number;
+    waiting_review_count?: number; no_run_count?: number;
+    sla_total: number; sla_met: number;
+  };
+}
+
+export type Dimension = 'schema' | 'data' | 'zscore' | 'lineage' | 'column-lineage' | 'root-cause' | 'metric' | 'task';
+
+export interface ArtifactMap {
+  schema?: FindingsArtifact; data?: FindingsArtifact; zscore?: ZscoreArtifact;
+  lineage?: LineageArtifact; 'column-lineage'?: ColumnLineageArtifact;
+  'root-cause'?: RootCauseArtifact; metric?: MetricArtifact; task?: TaskArtifact;
+}
+
+// 修复方案（dw-anomaly-fixer plan 产物，对齐 fix.py build_fix_item）
+export interface FixItem {
+  /** v2 契约：item_id = finding_uid（旧批次为原始 id） */
+  item_id: string;
+  finding_uid?: string;
+  source_finding_id?: string;
+  strategy?: string;
+  category: string;
+  risk: 'high' | 'medium' | 'low';
+  needs_confirm: boolean;
+  summary: string;
+  object: Record<string, unknown>;
+  capability_op?: string;
+  sql_digest?: string;
+  note?: string;
+  // 兼容 v1 字段（getFixPlan 读历史 JSON）
+  finding_id?: string;
+  fix_sql: string;
+  rollback_sql: string;
+  impact?: { rows_affected?: string | number; reversible?: boolean };
+}
+
+export interface FixPlanArtifact {
+  meta: {
+    skill: string; db?: string; db_ref_alias?: string; db_type?: string;
+    run_at: string; stage: string; source_findings: string[];
+    run_id?: string; plan_id?: string; plan_digest?: string;
+    capability_snapshot?: Record<string, { ops: Record<string, string> }>;
+  };
+  items: FixItem[];
+  skipped: Array<{ finding_id?: string; item_id?: string; reason: string }>;
+}
+
+export interface FixPlanResult {
+  fix_plan_path: string;
+  fix_plan_md_path: string;
+  plan_id?: string;
+  plan_digest?: string;
+  db_identity?: string;
+  db_type?: string;
+  item_count: number;
+  skipped_count: number;
+  high_risk_count: number;
+}
+
+export interface FixContextTable { name: string; key_model?: string; ops?: Record<string, string>; }
+export interface FixContextItem {
+  finding_uid: string; source_finding_id?: string; dimension: string;
+  severity?: string; category?: string; summary?: string;
+  strategy?: string; risk?: string; subject?: { table?: string; column?: string };
+}
+export interface FixContextResponse {
+  run_id: string; db_type: string; db_identity?: string;
+  tables: FixContextTable[]; items: FixContextItem[]; missing_uids: string[];
+}
+export interface FixExecuteResult {
+  fix_execution_path: string; execution_id: string;
+  executed_count: number; rejected_count: number; failed_count: number;
+  verification_failed?: number; plan_path?: string; plan_digest?: string;
+}
