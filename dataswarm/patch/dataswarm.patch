-        }
-        // IAM 已配置, 探测登录态
-        fetch('/auth-api/v1/auth/permissions', { credentials: 'same-origin' })
-          .then((resp) => {
-            if (cancelled) return;
-            if (resp.ok) {
-              setAuthStatus('loggedIn');
-            } else {
-              setAuthStatus('loggedOut');
-            }
-          })
-          .catch(() => {
-            if (!cancelled) setAuthStatus('loggedOut');
