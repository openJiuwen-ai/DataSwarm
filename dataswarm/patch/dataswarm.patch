+            </Field>
+            <Field label={t('biMetrics.form.owner')}>
+              <input className={inputClass} value={owner}
+                     onChange={(e) => setOwner(e.target.value)} />
+            </Field>
+          </section>
+
+          {!isEdit && (
+            <>
+              {/* 依赖顺序：先定物理来源，口径字段的候选列由它决定 */}
+              <section className="space-y-3">
+                <h4 className="text-xs font-semibold uppercase tracking-wide text-text-muted">
+                  {t('biMetrics.form.sectionPhysical')}
+                  <span className="ml-2 font-normal normal-case tracking-normal text-text-muted">
+                    {t('biMetrics.form.physicalHint')}
