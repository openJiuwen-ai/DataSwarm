+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""orchestration/workflow_engine.py —— 工作流 DAG 引擎。
+
+职责：
+    - 读 orch_workflow_node + upstream_nodes 建邻接表，拓扑排序 + 环检测
+    - 按拓扑顺序跑节点：前驱全 success → 该节点 queued→running
+    - 遇 wait_review=1 → 节点 waiting_review，实例 waiting_review，停下等人审
+    - pause_workflow / resume / approve
+    - 任务实例（ref_type=task）直接派 Executor，不走 DAG
+
+工作流实例状态机：
+    queued → running → paused(可恢复) / waiting_review(待人审) → running → success/failed
+任务实例状态机（不暂停，符合需求 5b）：
+    queued → running → success/failed/skipped
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from jiuwenswarm.channels.web import timeutil
+from jiuwenswarm.common import workspace_context
+
+from . import artifact
+from . import db as orch_db
+from .db import _now
+from .executors import get_executor
+from .lineage import writer as lineage_writer
+
+
+def _parse_ts(ts: str | None) -> datetime | None:
+    """解析时间戳（全格式矩阵，naive 按本地）——委托 timeutil。"""
+    return timeutil.parse_ts(ts)
+
+
+def _compute_governance_fields(
+    task: dict,
+    run: dict | None,
+    result,
+    started_at: str | None,
+    finished_at: str | None,
+) -> dict:
+    """算治理字段：duration_s / sla_time / output_rows / start_ts / end_ts。
+
+    - duration_s: finished - started 秒
+    - sla_time: started + sla_minutes（空 sla 用 timeout_s/60 近似）
+    - output_rows: 从 result_summary 解析（SQL 的 row_count / Python 的 RESULT_JSON）
+    - start_ts/end_ts: started_at/finished_at 的别名（巡检旧字段名兼容）
+    """
+    out: dict[str, Any] = {}
+    s = _parse_ts(started_at)
+    f = _parse_ts(finished_at)
+    if s and f:
+        out["duration_s"] = round((f - s).total_seconds(), 3)
+    out["start_ts"] = started_at
+    out["end_ts"] = finished_at
+    # sla_time: started + sla
+    if s:
+        sla_min = task.get("sla_minutes")
+        if sla_min is None:
+            sla_min = (task.get("timeout_s") or 7200) / 60
+        from datetime import timedelta
+
+        out["sla_time"] = (s + timedelta(minutes=float(sla_min))).isoformat(timespec="seconds")
+    # output_rows: 从 result_summary 解析
+    summary = result.result_summary or {}
+    if isinstance(summary, dict):
+        if "row_count" in summary:
+            out["output_rows"] = int(summary["row_count"])
+    # Python 执行器的 RESULT_JSON 在 stdout，run 已落盘可读，但此处先不解析 stdout
+    # （巡检 check_health 若需 Python 产出，可后续从 result_summary 扩展）
+    return out
+
+
+def _write_runtime_lineage(task: dict, instance_id: str, result) -> None:
+    """执行时落库血缘（plan §3.3-C 运行时权威源）。
+
+    仅 SQL 任务 + 执行成功时写；plan_id=instance_id（实例级版本）。
+    解析 SQL 写 table_lineage/column_lineage；失败不阻断任务执行（catch + 静默）。
+    """
+    try:
+        if result.status != "success":
+            return
+        if (task.get("executor_type") or "").lower() != "sql":
+            return
+        code = task.get("code") or ""
+        if not code.strip():
+            return
+        # default_db：从 datasource_ref 解析库名
+        default_db = _db_name_from_ref(task.get("datasource_ref"))
+        lineage_writer.write_from_sql(
+            task_id=task["task_id"],
+            plan_id=instance_id,  # 运行时版本 = 实例级
+            sql=code,
+            default_db=default_db,
+            business_ref=task.get("datasource_ref"),
+        )
+    except Exception:
+        # 血缘落库失败不影响任务执行结果
+        pass
+
+
+def _db_name_from_ref(datasource_ref: str | None) -> str:
+    """从 datasource_ref 解析库名作 default_db（与 api._db_name_from_ref 同逻辑）。"""
+    from jiuwenswarm.common import db_connector
+
+    return db_connector.lineage_db_name(datasource_ref)
+
+
+# ==========================================================================
+# 任务实例执行（单任务，不走 DAG）
+# ==========================================================================
+def run_task_instance(instance_id: str, task_id: str) -> dict:
+    """跑一个任务实例：派 Executor，写 task_run + 日志。"""
+    task = orch_db.get_task(task_id)
+    if not task:
+        orch_db.update_instance(
+            instance_id,
+            status="failed",
+            error_message="task not found",
+            finished_at=_now(),
+        )
+        return orch_db.get_instance(instance_id)  # type: ignore
+
+    orch_db.update_instance(instance_id, status="running", started_at=_now())
+    artifact.write_manifest(
+        instance_id,
+        {
+            "status": "running",
+            "started_at": _now(),
+            "ref_type": "task",
+            "ref_id": task_id,
+        },
+    )
+    artifact_dir = Path(orch_db.get_instance(instance_id)["artifact_dir"])  # type: ignore[index]
+    artifact_dir.mkdir(parents=True, exist_ok=True)
+    run = orch_db.create_task_run(
+        instance_id, task_id, None, task["name"], status="running"
+    )
+    orch_db.update_task_run(run["run_id"], started_at=_now())  # type: ignore[index]
+
+    result = _execute_task(
+        task, artifact_dir, log_prefix="task", instance_id=instance_id
+    )
+    finished = _now()
+    # 审计留痕（决策八-3）：task_run 的 result_summary 记录 workspace 双 ref 脱敏摘要
+    try:
+        workspace_audit = workspace_context.audit_summary()
+    except Exception:
+        workspace_audit = None
+    # 重新取 run（create 时 started_at 未设，update_task_run 后才有）算治理字段
+    run_fresh = orch_db.get_task_run(run["run_id"])  # type: ignore[index]
+    gov = _compute_governance_fields(
+        task,
+        run_fresh,
+        result,
+        run_fresh.get("started_at") if run_fresh else None,
+        finished,
+    )
+    orch_db.update_task_run(
+        run["run_id"],  # type: ignore[index]
+        status=result.status,
+        exit_code=result.exit_code,
+        stdout_path=result.stdout_path,
+        stderr_path=result.stderr_path,
+        error_message=result.error_message,
+        finished_at=finished,
+        result_summary=json.dumps(
+            {**(result.result_summary or {}), **({"workspace": workspace_audit} if workspace_audit else {})},
+            ensure_ascii=False,
+        ),
+        **gov,
+    )
+    # 运行时落库血缘（plan §3.3-C，权威源，plan_id=instance_id）
+    _write_runtime_lineage(task, instance_id, result)
+    final_status = "success" if result.status == "success" else "failed"
+    # §5.3 CAS：不覆盖已 cancelled 的实例（cancel 打在并发完成间隙）
+    orch_db.update_instance_if_not_terminal(
+        instance_id,
+        status=final_status,
+        finished_at=_now(),
+        error_message=result.error_message,
+    )
+    artifact.write_manifest(
+        instance_id,
+        {
+            "status": final_status,
+            "finished_at": _now(),
+            "ref_type": "task",
+            "ref_id": task_id,
+            "error": result.error_message,
+        },
+    )
+    return orch_db.get_instance(instance_id)  # type: ignore
+
+
+def _execute_task(
+    task: dict,
+    artifact_dir: Path,
+    log_prefix: str = "node",
+    instance_id: str | None = None,
+):
+    """派发到具体 Executor 跑一个任务。复用于任务实例和工作流节点。
+
+    instance_id 经 params["_instance_id"] 注入、task_id 经 params["_task_id"] 注入
+    （stream_load 执行器的幂等 label 派生依赖，方案 §7.4 第 3 点：
+    label = {task_id}_{instance_id}，避免同实例多表导数 label 冲突）。
+    """
+    executor = get_executor(task["executor_type"])
+    params = {}
+    try:
+        if task.get("params_json"):
+            params = json.loads(task["params_json"])
+    except (json.JSONDecodeError, TypeError):
+        params = {}
+    if instance_id:
+        params["_instance_id"] = instance_id
+    if task.get("task_id"):
+        params["_task_id"] = task["task_id"]
+    return executor.run(
+        code=task["code"],
+        params=params,
+        datasource_ref=task.get("datasource_ref"),
+        timeout_s=int(task.get("timeout_s") or 7200),
+        artifact_dir=artifact_dir,
+        log_prefix=log_prefix,
+    )
+
+
+# ==========================================================================
+# 工作流 DAG 执行
+# ==========================================================================
+def run_workflow_instance(
+    instance_id: str, workflow_id: str, only_nodes: list[str] | None = None
+) -> dict:
+    """跑一个工作流实例：拓扑分层 + 层内并行 + 层间串行 + pause/review 处理。
+
+    同层（拓扑深度相同、互相无依赖）的节点用 ThreadPoolExecutor(max_workers=4) 并行跑；
+    层与层之间串行（等上一层全 success 才进下一层）。层内任一节点 failed → 后续所有层全 skipped。
+    wait_review 节点：层内遇到时整层暂停（已成功节点保留，未启动节点 queued）。
+
+    only_nodes: 增量追加时只执行指定节点及其全部前驱，其余节点标记 skipped。
+                None（默认）= 全量执行，与原有行为一致。
+    """
+    wf = orch_db.get_workflow(workflow_id)
+    if not wf:
+        orch_db.update_instance(
+            instance_id,
+            status="failed",
+            error_message="workflow not found",
+            finished_at=_now(),
+        )
+        return orch_db.get_instance(instance_id)  # type: ignore
+    nodes = orch_db.list_nodes(workflow_id)
+    if not nodes:
+        orch_db.update_instance(
+            instance_id, status="failed", error_message="no nodes", finished_at=_now()
+        )
+        return orch_db.get_instance(instance_id)  # type: ignore
+
+    # 拓扑分层 + 环检测
+    try:
+        layers = _topo_layers(nodes)
+    except ValueError as exc:
+        orch_db.update_instance(
+            instance_id,
+            status="failed",
+            error_message=f"cycle: {exc}",
+            finished_at=_now(),
+        )
+        return orch_db.get_instance(instance_id)  # type: ignore
+
+    orch_db.update_instance(instance_id, status="running", started_at=_now())
+    artifact_dir = Path(orch_db.get_instance(instance_id)["artifact_dir"])  # type: ignore[index]
+    artifact_dir.mkdir(parents=True, exist_ok=True)
+
+    # 捕获当前 workspace：ThreadPoolExecutor 不传播 contextvar（submit 不 copy_context，
+    # 实测 None），池内节点要用显式参数恢复，否则多工作空间下 get_task/_connect 抛
+    # WorkspaceContextRequired（api 日志 Thread-46/48 崩溃根因）。
+    try:
+        _bg_workspace_id = workspace_context.current_workspace().workspace_id
+    except Exception:  # noqa: BLE001 —— legacy 单库/无上下文时按空（default）
+        _bg_workspace_id = ""
+
+    # 节点状态表（node_id -> status）。resume/approve 续跑时先从 orch_task_run
+    # 读已有状态，跳过已 success 的节点，避免重跑。
+    node_status: dict[str, str] = {}
+    node_run_id: dict[str, str] = {}
+    existing_runs = orch_db.list_task_runs(instance_id)
+    for r in existing_runs:
+        nid = r.get("node_id")
+        if nid:
+            node_status[nid] = r["status"]
+            node_run_id[nid] = r["run_id"]
+
+    # only_nodes 过滤：只执行指定节点，其前驱标记 success（跳过，已在之前实例跑过）
+    needed_nodes: set[str] | None = None
+    if only_nodes:
+        needed_nodes = _closure_with_upstreams(only_nodes, nodes)
+        for layer in layers:
+            for node_id in layer:
+                if node_id not in needed_nodes:
+                    # 不在 needed 集合中的节点标 skipped
+                    node_status[node_id] = "skipped"
+                elif node_id not in set(only_nodes):
+                    # 在 needed 集合中但不是目标节点 → 是前驱，已跑过，标 success 跳过
+                    node_status[node_id] = "success"
+        layers = [[nid for nid in layer if nid in needed_nodes] for layer in layers]
+        layers = [layer for layer in layers if layer]
+
+    artifact.write_manifest(
+        instance_id,
+        {
+            "status": "running",
+            "started_at": _now(),
+            "ref_type": "workflow",
+            "ref_id": workflow_id,
+            "node_count": sum(len(layer) for layer in layers),
+            "layers": len(layers),
+        },
+    )
+
+    import threading
+    from concurrent.futures import ThreadPoolExecutor, as_completed
+
+    status_lock = threading.Lock()
+    total_nodes = sum(len(layer) for layer in layers)
+
+    for layer_idx, layer in enumerate(layers):
+        # 实例被外部 pause/approve 前先检查状态
+        cur_instance = orch_db.get_instance(instance_id)
+        if not cur_instance:
+            break
+        cur_status = cur_instance["status"]
+        if cur_status in ("paused", "cancelled"):
+            # §5.3：边界检查扩 paused|cancelled。cancelled 不写 success（防覆盖）。
+            artifact.write_manifest(
+                instance_id, {"status": cur_status, "paused_at": _now()}
+            )
+            return cur_instance
+
+        # 分离本层节点：已 success 的跳过；前驱未全 success 的标 skipped；wait_review 整层暂停；其余并行执行
+        runnable: list[dict] = []
+        for node_id in layer:
+            node = next(n for n in nodes if n["node_id"] == node_id)
+            if node_status.get(node_id) == "success":
+                continue
+            upstream = [
+                u for u in (node.get("upstream_nodes") or "").split(",") if u.strip()
+            ]
+            if upstream and not all(node_status.get(u) == "success" for u in upstream):
+                # 前驱有 failed/skipped → 本节点 skipped
+                with status_lock:
+                    node_status[node_id] = "skipped"
+                run = orch_db.create_task_run(
+                    instance_id,
+                    node["task_id"],
+                    node_id,
+                    node.get("node_name") or _task_name(node["task_id"]),
+                    status="skipped",
+                )
+                orch_db.update_task_run(
+                    run["run_id"], started_at=_now(), finished_at=_now()
+                )
+                continue
+            runnable.append(node)
+
+        if not runnable:
+            # 本层要么全 success、要么全 skipped——继续下一层
+            # 但若本层有 skipped 且后续层依赖它，下一层循环会再走 skipped 分支
+            continue
+
+        # wait_review 节点：层内遇到任一即整层暂停（保守做法）
+        review_node = next((n for n in runnable if n.get("wait_review")), None)
+        if review_node:
+            node_id = review_node["node_id"]
+            run = orch_db.create_task_run(
+                instance_id,
+                review_node["task_id"],
+                node_id,
+                review_node.get("node_name") or _task_name(review_node["task_id"]),
+                status="waiting_review",
+            )
+            orch_db.update_task_run(run["run_id"], started_at=_now())
+            with status_lock:
+                node_status[node_id] = "waiting_review"
+                node_run_id[node_id] = run["run_id"]
+            orch_db.update_instance(instance_id, status="waiting_review")
+            artifact.write_manifest(
+                instance_id,
+                {
+                    "status": "waiting_review",
+                    "waiting_node": node_id,
+                    "node_name": review_node.get("node_name"),
+                },
+            )
+            return orch_db.get_instance(instance_id)
+
+        # 并行执行本层 runnable 节点
+        def _run_one(node: dict) -> tuple[str, str, Any]:
+            # 池线程不继承 contextvar：每个节点开头显式恢复 workspace 上下文
+            _ws_token = workspace_context.set_current(_bg_workspace_id)
+            try:
+                return _run_one_inner(node)
+            finally:
+                workspace_context.reset(_ws_token)
+
+        def _run_one_inner(node: dict) -> tuple[str, str, Any]:
+            node_id = node["node_id"]
+            task = orch_db.get_task(node["task_id"])
+            if not task:
+                with status_lock:
+                    node_status[node_id] = "failed"
+                orch_db.update_instance(
+                    instance_id,
+                    status="failed",
+                    error_message=f"node {node_id}: task {node['task_id']} not found",
+                    finished_at=_now(),
+                )
+                return node_id, "failed", None
+            run = orch_db.create_task_run(
+                instance_id,
+                node["task_id"],
+                node_id,
+                node.get("node_name") or _task_name(node["task_id"]),
+                status="running",
+            )
+            orch_db.update_task_run(run["run_id"], started_at=_now())
+            log_prefix = f"node_{node_id}"
+            result = _execute_task(
+                task, artifact_dir, log_prefix=log_prefix, instance_id=instance_id
+            )
+            finished = _now()
+            run_fresh = orch_db.get_task_run(run["run_id"])
+            gov = _compute_governance_fields(
+                task,
+                run_fresh,
+                result,
+                run_fresh.get("started_at") if run_fresh else None,
+                finished,
+            )
+            orch_db.update_task_run(
+                run["run_id"],
+                status=result.status,
+                exit_code=result.exit_code,
+                stdout_path=result.stdout_path,
+                stderr_path=result.stderr_path,
+                error_message=result.error_message,
+                finished_at=finished,
+                result_summary=json.dumps(
+                    result.result_summary or {}, ensure_ascii=False
+                ),
+                **gov,
+            )
+            _write_runtime_lineage(task, instance_id, result)
+            with status_lock:
+                node_status[node_id] = (
+                    result.status if result.status == "success" else "failed"
+                )
+                node_run_id[node_id] = run["run_id"]
+            return node_id, result.status, result.error_message
+
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            futures = {pool.submit(_run_one, n): n for n in runnable}
+            layer_failed: list[tuple[str, str]] = []  # (node_id, error_msg)
+            for fut in as_completed(futures):
+                node_id, status, err = fut.result()
+                if status != "success":
+                    layer_failed.append((node_id, err or ""))
+
+        # 层内失败传导：后续所有层全 skipped
+        if layer_failed:
+            failed_ids = {nid for nid, _ in layer_failed}
+            # 本层未启动节点（不在 runnable 但也没 skipped/success 的）也标 skipped
+            for node_id in layer:
+                if node_status.get(node_id) not in (
+                    "success",
+                    "failed",
+                    "skipped",
+                    "waiting_review",
+                ):
+                    with status_lock:
+                        node_status[node_id] = "skipped"
+                    node = next(n for n in nodes if n["node_id"] == node_id)
+                    skip_run = orch_db.create_task_run(
+                        instance_id,
+                        node["task_id"],
+                        node_id,
+                        node.get("node_name") or _task_name(node["task_id"]),
+                        status="skipped",
+                    )
+                    orch_db.update_task_run(
+                        skip_run["run_id"],
+                        started_at=_now(),
+                        finished_at=_now(),
+                        error_message=f"layer {layer_idx} failed",
+                    )
+            # 后续层全 skipped
+            for later_layer in layers[layer_idx + 1:]:
+                for later_id in later_layer:
+                    if node_status.get(later_id) == "success":
+                        continue
+                    with status_lock:
+                        node_status[later_id] = "skipped"
+                    later_node = next(n for n in nodes if n["node_id"] == later_id)
+                    skip_run = orch_db.create_task_run(
+                        instance_id,
+                        later_node["task_id"],
+                        later_id,
+                        later_node.get("node_name")
+                        or _task_name(later_node["task_id"]),
+                        status="skipped",
+                    )
+                    orch_db.update_task_run(
+                        skip_run["run_id"],
+                        started_at=_now(),
+                        finished_at=_now(),
+                        error_message=f"upstream layer {layer_idx} failed",
+                    )
+            first_fail_node, first_err = layer_failed[0]
+            # §5.3 CAS：不覆盖已 cancelled 的实例
+            orch_db.update_instance_if_not_terminal(
+                instance_id,
+                status="failed",
+                error_message=f"node {first_fail_node} failed: {first_err}",
+                finished_at=_now(),
+            )
+            artifact.write_manifest(
+                instance_id,
+                {
+                    "status": "failed",
+                    "finished_at": _now(),
+                    "failed_layer": layer_idx,
+                    "failed_nodes": list(failed_ids),
+                },
+            )
+            return orch_db.get_instance(instance_id)
+
+    # 全部成功（§5.3 CAS：不覆盖已 cancelled 的实例）
+    orch_db.update_instance_if_not_terminal(
+        instance_id, status="success", finished_at=_now()
+    )
+    artifact.write_manifest(
+        instance_id,
+        {
+            "status": "success",
+            "finished_at": _now(),
+            "ref_type": "workflow",
+            "ref_id": workflow_id,
+            "node_count": total_nodes,
+            "layers": len(layers),
+        },
+    )
+    return orch_db.get_instance(instance_id)
+
+
+def _task_name(task_id: str) -> str:
+    t = orch_db.get_task(task_id)
+    return t["name"] if t else task_id
+
+
+def _closure_with_upstreams(target_node_ids: list[str], nodes: list[dict]) -> set[str]:
+    """计算 target_node_ids 及其所有前驱的闭包。
+
+    用于 only_nodes：只跑目标节点及其依赖链，其余 skipped。
+    """
+    node_map = {n["node_id"]: n for n in nodes}
+    needed: set[str] = set()
+    stack = list(target_node_ids)
+    while stack:
+        nid = stack.pop()
+        if nid in needed:
+            continue
+        needed.add(nid)
+        node = node_map.get(nid)
+        if not node:
+            continue
+        for up in (node.get("upstream_nodes") or "").split(","):
+            up = up.strip()
+            if up and up not in needed:
+                stack.append(up)
+    return needed
+
+
+def _topo_layers(nodes: list[dict]) -> list[list[str]]:
+    """Kahn 拓扑分层。每层是同 indegree 的节点集合（同层无依赖、可并行）。
+
+    返回 list[layer] = list[node_id]。有环抛 ValueError。
+    与 _topo_sort 同算法，但每轮 queue 全部出队作为一层（而非逐个出队成扁平 list）。
+    """
+    node_ids = {n["node_id"] for n in nodes}
+    adj: dict[str, list[str]] = {nid: [] for nid in node_ids}
+    indeg: dict[str, int] = {nid: 0 for nid in node_ids}
+    for n in nodes:
+        ups = [
+            u.strip() for u in (n.get("upstream_nodes") or "").split(",") if u.strip()
+        ]
+        for u in ups:
+            if u not in node_ids:
+                continue
+            adj[u].append(n["node_id"])
+            indeg[n["node_id"]] += 1
+    layers: list[list[str]] = []
+    current = sorted(
+        [nid for nid, d in indeg.items() if d == 0],
+        key=lambda nid: _order_of(nid, nodes),
+    )
+    while current:
+        layers.append(current)
+        next_layer: list[str] = []
+        for nid in current:
+            for child in adj[nid]:
+                indeg[child] -= 1
+                if indeg[child] == 0:
+                    next_layer.append(child)
+        current = sorted(next_layer, key=lambda nid: _order_of(nid, nodes))
+    total = sum(len(layer) for layer in layers)
+    if total != len(node_ids):
+        raise ValueError("cycle detected in workflow nodes")
+    return layers
+
+
+def _topo_sort(nodes: list[dict]) -> list[str]:
+    """Kahn 拓扑排序。有环抛 ValueError。"""
+    node_ids = {n["node_id"] for n in nodes}
+    adj: dict[str, list[str]] = {nid: [] for nid in node_ids}
+    indeg: dict[str, int] = {nid: 0 for nid in node_ids}
+    for n in nodes:
+        ups = [
+            u.strip() for u in (n.get("upstream_nodes") or "").split(",") if u.strip()
+        ]
+        for u in ups:
+            if u not in node_ids:
+                continue  # 忽略不存在的上游（或可视为错误）
+            adj[u].append(n["node_id"])
+            indeg[n["node_id"]] += 1
+    # 按 order_index 取队列初值
+    queue = sorted(
+        [nid for nid, d in indeg.items() if d == 0],
+        key=lambda nid: _order_of(nid, nodes),
+    )
+    order: list[str] = []
+    while queue:
+        nid = queue.pop(0)
+        order.append(nid)
+        for child in adj[nid]:
+            indeg[child] -= 1
+            if indeg[child] == 0:
+                queue.append(child)
+        queue.sort(key=lambda x: _order_of(x, nodes))
+    if len(order) != len(node_ids):
+        raise ValueError("cycle detected in workflow nodes")
+    return order
+
+
+def _order_of(node_id: str, nodes: list[dict]) -> int:
+    for n in nodes:
+        if n["node_id"] == node_id:
+            return n.get("order_index", 0)
+    return 0
+
+
+# ==========================================================================
+# 暂停 / 恢复 / 审核
+# ==========================================================================
+def pause_workflow(instance_id: str) -> dict | None:
+    inst = orch_db.get_instance(instance_id)
+    if not inst or inst["ref_type"] != "workflow":
+        return None
+    if inst["status"] not in ("running", "queued"):
+        return inst
+    return orch_db.update_instance(instance_id, status="paused")
+
+
+def cancel_instance(instance_id: str) -> dict | None:
+    """取消实例（方案 §5.3）。
+
+    终态实例（success/failed/cancelled）幂等返回当前状态。
+    非终态 → CAS 标 cancelled：update_instance 带 status=cancelled，
+    若实例已被并发改成终态（success/failed），CAS 拒绝覆盖
+    （由 db.update_instance 的 compare-and-set 保证，或此处先重读判断）。
+    """
+    inst = orch_db.get_instance(instance_id)
+    if not inst:
+        return None
+    if inst["status"] in ("success", "failed", "cancelled"):
+        return inst  # 幂等：终态直接返回
+    # CAS：标 cancelled。db.update_instance 的 CAS 语义保证不覆盖并发终态
+    return orch_db.update_instance(instance_id, status="cancelled")
+
+
+def resume_workflow(instance_id: str) -> dict | None:
+    """恢复 paused 实例：重跑后续节点。
+
+    §5.3：cancelled 不支持 resume（cancelled ≠ paused，不复活）。
+    """
+    inst = orch_db.get_instance(instance_id)
+    if not inst or inst["ref_type"] != "workflow":
+        return None
+    if inst["status"] == "cancelled":
+        return inst  # 不复活 cancelled
+    if inst["status"] != "paused":
+        return inst
+    orch_db.update_instance(instance_id, status="running")
+    # 在后台线程续跑，避免阻塞 API
+    import threading
+
+    threading.Thread(
+        target=_resume_in_thread, args=(instance_id, inst["ref_id"]), daemon=True
+    ).start()
+    return inst
+
+
+def approve_node(instance_id: str) -> dict | None:
+    """审核通过 waiting_review 节点：标该节点 success，实例 running，续跑后续。"""
+    inst = orch_db.get_instance(instance_id)
+    if not inst or inst["ref_type"] != "workflow":
+        return None
+    if inst["status"] != "waiting_review":
+        return inst
+    # 找 waiting_review 的 task_run，标 success（视为人工审核通过）
+    runs = orch_db.list_task_runs(instance_id)
+    for r in runs:
+        if r["status"] == "waiting_review":
+            orch_db.update_task_run(r["run_id"], status="success", finished_at=_now())
+    orch_db.update_instance(instance_id, status="running")
+    import threading
+
+    # 审核链所在请求线程已 set_current（api.py 入口按请求 workspace_id）；
+    # threading.Thread 新线程不继承 ContextVar，必须显式传入（决策九，同 scheduler）。
+    try:
+        ws_id = workspace_context.current_workspace().workspace_id
+    except Exception:  # noqa: BLE001 —— legacy 单库/无上下文时按 default 线程执行
+        ws_id = ""
+    threading.Thread(
+        target=_resume_in_thread, args=(instance_id, inst["ref_id"], ws_id), daemon=True
+    ).start()
+    return inst
+
+
+def _resume_in_thread(instance_id: str, workflow_id: str, workspace_id: str = "") -> None:
+    """续跑工作流：复用 run_workflow_instance（它会跳过已 success 的节点）。"""
+    token = workspace_context.set_current(workspace_id)
+    try:
+        run_workflow_instance(instance_id, workflow_id)
+    except Exception as exc:  # noqa: BLE001
+        orch_db.update_instance(
+            instance_id, status="failed", error_message=str(exc), finished_at=_now()
+        )
+    finally:
+        workspace_context.reset(token)
