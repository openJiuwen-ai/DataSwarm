+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning/mapping_confirm.py —— 候选映射确认/驳回（自 versioning.py 巨石按用例拆分，纯搬运）。
+
+发布语义见包门面 docstring（versioning/__init__.py）。
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+
+
+from .. import store
+from ..errors import MetricNotFound
+from ..model import (
+    MAP_CONFIRMED,
+    ConceptMapping,
+)
+
+
+# ==========================================================================
+# 确认
+# ==========================================================================
+def confirm_mapping(mapping_id: str, *, confirmed_by: str) -> ConceptMapping:
+    """确认一条候选业务映射。只有 confirmed 的映射才进正式投影。"""
+    mapping = store.get_concept_map(mapping_id)
+    if mapping is None:
+        raise MetricNotFound(f"业务映射 {mapping_id} 不存在")
+    store.set_concept_map_status(mapping_id, MAP_CONFIRMED, confirmed_by=confirmed_by)
+    return replace(mapping, status=MAP_CONFIRMED, confirmed_by=confirmed_by)
+
+
+def reject_mapping(mapping_id: str) -> None:
+    """拒绝一条候选映射（保留记录，状态标 rejected）。"""
+    store.set_concept_map_status(mapping_id, "rejected")
+
+
diff --git a/jiuwenswarm/channels/web/dataagent/metrics/versioning/ossie_import.py b/jiuwenswarm/channels/web/dataagent/metrics/versioning/ossie_import.py
new file mode 100644
index 000000000..0cd4c36f5
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/versioning/ossie_import.py
@@ -0,0 +1,170 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning/ossie_import.py —— Ossie 导入（import_ossie 与术语映射结转）（自 versioning.py 巨石按用例拆分，纯搬运）。
+
+发布语义见包门面 docstring（versioning/__init__.py）。
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+
+from .. import ossie as ossie_mod
+from .. import store
+from .term_binding import RELATION_MEASURES_CONCEPT, resolve_term_ref
+from ..model import (
+    MAP_CONFIRMED,
+    ConceptMapping,
+    MetricDef,
+    MetricRevision,
+)
+
+
+# ==========================================================================
+# 导入
+# ==========================================================================
+def import_ossie(
+    text: str,
+    workspace_id: str,
+    *,
+    fmt: str = "yaml",
+    target_db_type: str = "",
+    datasource_resolver: Any = None,
+) -> dict:
+    """解析 Ossie 语义模型并落库为 candidate 修订 + 绑定 + 候选映射。
+
+    幂等：同一 ``definition_hash`` 已存在时返回既有修订，不重复建行。
+
+    Args:
+        text: Ossie YAML/JSON 原文。
+        workspace_id: 归属工作空间。
+        fmt: ``"yaml"`` 或 ``"json"``。
+        target_db_type: 目标业务库类型，决定表达式方言偏好。
+        datasource_resolver: ``alias -> db_ref`` 解析器；None 用默认（查 dw_datasources）。
+
+    Returns:
+        ``{"revisions": [...], "bindings": [...], "candidate_mappings": [...],
+        "created": bool}``。
+    """
+    model = ossie_mod.parse_ossie(text, fmt=fmt)
+    keys = [model.metric_key_of(m) for m in model.metrics]
+
+    # 指标身份（幂等：同 workspace 同 key 返回既有）
+    defs: dict[str, MetricDef] = {}
+    for metric, key in zip(model.metrics, keys):
+        defs[key] = store.create_def(
+            workspace_id=workspace_id, metric_key=key,
+            name=str(metric.extension.get("display_name") or key.split(".")[-1]),
+            description=metric.description or "",
+            owner=str(model.extension.get("owner") or ""),
+        )
+
+    revisions = ossie_mod.to_revisions(
+        model, workspace_id, target_db_type=target_db_type,
+        metric_id_resolver=lambda key: defs[key].metric_id)
+
+    # 导入幂等：按 definition_hash（口径内容哈希，Phase 3c 起单一口径——
+    # definition_payload 已不含 revision_no，同一定义二次导入哈希不变）
+    created_any = False
+    out_revisions: list[MetricRevision] = []
+    carried: list[str] = []
+    for rev, key in zip(revisions, keys):
+        content_hash = rev.compute_definition_hash()
+        existing = store.find_revision_by_hash(workspace_id, content_hash)
+        if existing is not None:
+            out_revisions.append(existing)
+            continue
+        rev = replace(rev, definition_hash=content_hash)
+        rev.validate()
+        store.create_revision(rev)
+        # 口径改了是新修订，但「这个指标度量哪个业务概念」没变——已确认的
+        # 术语绑定必须继承，否则每次重导入都静默丢绑定（分析入口随之失效）
+        carried.extend(_carry_over_term_maps(workspace_id, key, rev.revision_id))
+        created_any = True
+        out_revisions.append(rev)
+    revisions = out_revisions
+    by_key = dict(zip(keys, revisions))
+
+    bindings = ossie_mod.resolve_bindings(
+        model, workspace_id, by_key,
+        datasource_resolver=datasource_resolver if datasource_resolver is not None
+        else ossie_mod.default_datasource_resolver(workspace_id))
+    for binding in bindings:
+        store.create_binding(binding)
+
+    candidates = ossie_mod.candidate_mappings(model, workspace_id, by_key)
+    unresolved: list[str] = []
+    stored_candidates: list[ConceptMapping] = []
+    for mapping in candidates:
+        if mapping.relation_type == RELATION_MEASURES_CONCEPT:
+            # 自由文本 → term_id 在**写侧**解析：下游（图投影/分析图补全）只处理
+            # term_id 一种形态；解析不到就留原文并标 unresolved——让「名字没对上」
+            # 在导入时就暴露给人，而不是等发布时在投影里静默退化成孤立概念节点
+            term = resolve_term_ref(mapping.target_ref)
+            if term is not None:
+                mapping = replace(
+                    mapping, target_ref=str(term.get("term_id") or mapping.target_ref),
+                    evidence=f"{mapping.evidence}；解析到术语「{term.get('name')}」")
+            else:
+                unresolved.append(mapping.target_ref)
+                mapping = replace(
+                    mapping,
+                    evidence=f"{mapping.evidence}；术语库未命中（unresolved，确认后也连不出图边）")
+        # 同组重复（重导入同一定义）→ 不重复建行
+        if store.find_concept_map(
+                mapping.revision_id, mapping.relation_type, mapping.target_ref) is not None:
+            continue
+        store.create_concept_map(mapping)
+        stored_candidates.append(mapping)
+
+    return {
+        "revisions": [r.definition_ref for r in revisions],
+        "bindings": [b.binding_id for b in bindings],
+        "candidate_mappings": [m.mapping_id for m in stored_candidates],
+        "carried_term_maps": carried,
+        "unresolved_concepts": unresolved,
+        "created": created_any,
+    }
+
+
+def _carry_over_term_maps(
+    workspace_id: str, metric_key: str, new_revision_id: str
+) -> list[str]:
+    """新修订继承上一修订已确认的 ``measuresConcept`` 绑定。
+
+    上一修订 = 当前生效修订，没有就取除新修订外的最新一版（覆盖「导入后
+    先绑术语、还没发布就改口径重导入」的情形）。
+
+    Args:
+        workspace_id: 工作空间。
+        metric_key: 指标 key。
+        new_revision_id: 刚建的新修订。
+
+    Returns:
+        继承产生的 mapping_id 列表（无可继承时空列表）。
+    """
+    metric = store.get_def_by_key(workspace_id, metric_key)
+    if metric is None:
+        return []
+    previous_id = metric.current_revision_id or ""
+    if not previous_id or previous_id == new_revision_id:
+        previous_id = next(
+            (rev.revision_id for rev in store.list_revisions(metric.metric_id)
+             if rev.revision_id != new_revision_id), "")
+    if not previous_id:
+        return []
+    carried: list[str] = []
+    for mapping in store.list_concept_maps(previous_id, status=MAP_CONFIRMED):
+        if mapping.relation_type != RELATION_MEASURES_CONCEPT:
+            continue
+        if store.find_concept_map(
+                new_revision_id, mapping.relation_type, mapping.target_ref) is not None:
+            continue
+        copied = replace(
+            mapping, mapping_id=store.new_id("map"), revision_id=new_revision_id,
+            evidence=f"{mapping.evidence}；随新修订继承（口径变更不改变所度量的业务概念）")
+        store.create_concept_map(copied)
+        carried.append(copied.mapping_id)
+    return carried
+
+
diff --git a/jiuwenswarm/channels/web/dataagent/metrics/versioning/publish.py b/jiuwenswarm/channels/web/dataagent/metrics/versioning/publish.py
new file mode 100644
index 000000000..030aef2e9
--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/metrics/versioning/publish.py
@@ -0,0 +1,225 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning/publish.py —— 发布状态机（publish_release 与投影、清单、校验和）（自 versioning.py 巨石按用例拆分，纯搬运）。
+
+发布语义见包门面 docstring（versioning/__init__.py）。
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+
+from .. import store
+from .ossie_import import _carry_over_term_maps
+from ..errors import DefinitionError, MetricNotFound
+from ..model import (
+    METRIC_TYPE_ATOMIC,
+    REVISION_PUBLISHED,
+    RELEASE_DRAFT,
+    RELEASE_PUBLISHED,
+    Binding,
+    ConceptMapping,
+    MetricDef,
+    MetricRevision,
+    Release,
+    canonical_json,
+    sha256_of,
+)
+
+
+# ==========================================================================
+# 发布
+# ==========================================================================
+def publish_release(
+    workspace_id: str,
+    revision_ids: list[str],
+    *,
+    label: str = "",
+    published_by: str = "",
+    require_binding_verified: bool = True,
+    graph_adapter: Any = None,
+) -> Release:
+    """把一批修订发布成新 release 并投影到 Neo4j 指标图。
+
+    Args:
+        workspace_id: 工作空间。
+        revision_ids: 参与发布的修订 ID。
+        label: 发布说明。
+        published_by: 发布人。
+        require_binding_verified: 是否要求绑定已 ``verified``。首装演练可关。
+        graph_adapter: Neo4j 图适配器（同事 ``SemanticaAdapter`` 协议）；
+            None 从环境构造（``SEMANTICA_*``），单测注入 InMemory 替身。
+
+    Returns:
+        发布成功后的 :class:`~.model.Release`。Neo4j 不可用时返回的 release
+        ``projection_status="failed"``（发布本身成功，可 reproject 重试）。
+
+    Raises:
+        MetricNotFound: 修订不存在。
+        DefinitionError: 修订校验失败（缺表达式/绑定未 verified 等）。
+    """
+    from .. import graph_projection, semantic_link
+
+    revisions = store.list_revisions_by_ids(revision_ids)
+    found = {r.revision_id for r in revisions}
+    missing = [rid for rid in revision_ids if rid not in found]
+    if missing:
+        raise MetricNotFound(f"修订不存在: {', '.join(missing)}")
+    for rev in revisions:
+        rev.validate()
+        if rev.metric_type == METRIC_TYPE_ATOMIC and require_binding_verified:
+            bindings = store.list_bindings(rev.revision_id)
+            if not bindings or not any(b.verify_status == "verified" for b in bindings):
+                raise DefinitionError(
+                    f"修订 {rev.definition_ref} 的绑定未 verified，不能发布"
+                    "（先 resolve 绑定或确认数据源别名）")
+
+    defs_by_id = {d.metric_id: d for d in store.list_defs(workspace_id)}
+    # 发布前补继承：被发布的修订若没有术语绑定，从该指标其他修订继承已确认的。
+    # 闭掉顺序漏洞——「已发布 rev1 → 导入产生 rev2 草稿 → 此时绑定术语（落在
+    # current=rev1）→ 发布 rev2」会让 rev2 没有绑定、链在分析侧断掉，而界面
+    # 读 rev1 仍显示「已绑定」，断了也看不出来。
+    for rev in revisions:
+        metric_def = defs_by_id.get(rev.metric_id)
+        if metric_def is not None:
+            _carry_over_term_maps(workspace_id, metric_def.metric_key, rev.revision_id)
+    bindings_by_revision: dict[str, list[Binding]] = {}
+    for rev in revisions:
+        bindings_by_revision[rev.revision_id] = store.list_bindings(rev.revision_id)
+    confirmed_maps = store.list_confirmed_maps(revision_ids)
+
+    # 绑定校验走语义层快照（严格单一通道）：未采集/漂移 → warning + 绑定
+    # 回写 failed，发布不阻断（倒逼先采集）
+    schema_warnings: list[str] = []
+    semantic_refs = semantic_link.ensure_semantic_refs(
+        workspace_id, bindings_by_revision, schema_warnings)
+
+    # 先建 release 行（draft），投影失败也留痕
+    release_id = store.new_id("release")
+    release = Release(
+        release_id=release_id,
+        workspace_id=workspace_id, label=label, status=RELEASE_DRAFT,
+        revision_ids=tuple(revision_ids),
+        checksum=_release_checksum(revisions, confirmed_maps),
+        projection_graph=graph_projection.metrics_namespace(workspace_id),
+        manifest=_release_manifest(semantic_refs, schema_warnings),
+    )
+    store.create_release(release)
+
+    # Neo4j 投影：元数据库是真相源，投影失败只标 projection_status=failed
+    # （可 reproject 重试），不回滚发布
+    projection_outcome = _project_metric_graph(
+        workspace_id, release, revisions, defs_by_id, bindings_by_revision,
+        confirmed_maps, graph_adapter=graph_adapter)
+    projection_status = projection_outcome["status"]
+    error_code = projection_outcome.get("error_code", "")
+    error_message = projection_outcome.get("error_message", "")
+
+    # 成功：修订标 published、其他 release revoke、指标指向当前修订
+    now_revisions_published(revision_ids)
+    store.revoke_other_releases(workspace_id, release.release_id)
+    store.update_release(
+        release.release_id, status=RELEASE_PUBLISHED,
+        projection_status=projection_status,
+        error_code=error_code or None, error_message=error_message or None,
+        projected_at=store._now() if projection_status == "published" else None,
+        published_at=store._now(), published_by=published_by or "")
+    for rev in revisions:
+        store.set_current_revision(rev.metric_id, rev.revision_id)
+    return replace(
+        release, status=RELEASE_PUBLISHED, projection_status=projection_status,
+        published_by=published_by or "")
+
+
+def _project_metric_graph(
+    workspace_id: str,
+    release: Release,
+    revisions: list[MetricRevision],
+    defs_by_id: dict[str, MetricDef],
+    bindings_by_revision: dict[str, list[Binding]],
+    confirmed_maps: list[ConceptMapping],
+    *,
+    graph_adapter: Any,
+) -> dict:
+    """执行 Neo4j 投影并消化一切失败（返回 status/error_*，不抛）。"""
+    from .. import graph_projection, semantic_link
+
+    try:
+        adapter = graph_adapter
+        if adapter is None:
+            from ...semantic.semantica import from_environment, graph_projection_enabled
+
+            if not graph_projection_enabled():
+                # 开关关：刻意未做投影（非失败）——failed + reprojects 修复入口留给
+                # 真故障；与 glossary「未配置算 skipped」同语义，监控可区分
+                # 「预期降级」与「需要修复」
+                return {"status": "skipped", "reason": "graph_projection_disabled"}
+            adapter = from_environment()
+        _refs, snapshots = semantic_link.current_snapshots()
+        graph_projection.publish_metric_graph(
+            workspace_id, release, revisions, defs_by_id, bindings_by_revision,
+            confirmed_maps, _supersedes_map(workspace_id, revisions),
+            snapshots, adapter=adapter)
+        return {"status": "published"}
+    except Exception as exc:  # noqa: BLE001 —— 投影失败不阻断发布（真相源=元数据库）
+        return {"status": "failed",
+                "error_code": getattr(exc, "code", "PROJECTION_FAILED"),
+                "error_message": f"{type(exc).__name__}: {exc}"[:1000]}
+
+
+def now_revisions_published(revision_ids: list[str]) -> None:
+    """把修订状态推进到 published。"""
+    for revision_id in revision_ids:
+        store.update_revision_status(revision_id, REVISION_PUBLISHED)
+
+
+def get_release_revisions(release: Release) -> list[MetricRevision]:
+    """取 release 内的全部修订。"""
+    return store.list_revisions_by_ids(list(release.revision_ids))
+
+
+def _release_manifest(
+    semantic_refs: list[dict[str, str]], schema_warnings: list[str],
+) -> dict:
+    """release manifest：钉定语义快照 refs 与绑定校验警告（深集成结构）。"""
+    manifest: dict = {"semantic_refs": semantic_refs}
+    if schema_warnings:
+        manifest["schema_warnings"] = list(schema_warnings)
+    return manifest
+
+
+def _release_checksum(revisions: list[MetricRevision], confirmed_maps: list[ConceptMapping]) -> str:
+    """release 级校验和：修订哈希 + 确认映射的规范化摘要。"""
+    payload = {
+        "revisions": sorted(r.definition_hash for r in revisions),
+        "confirmed_maps": sorted(
+            f"{m.revision_id}|{m.relation_type}|{m.target_ref}" for m in confirmed_maps),
+    }
+    return sha256_of(canonical_json(payload))
+
+
+def _supersedes_map(workspace_id: str, revisions: list[MetricRevision]) -> dict[str, str]:
+    """为每个修订找上一个 published 修订的 definition_ref（版本链）。
+
+    单节点投影形态下版本链是节点属性 ``supersedesRef``（metric IRI 跨 release
+    稳定，supersedes 边会退化成自环）；``workspace_id`` 保留以维持调用签名。
+    """
+    out: dict[str, str] = {}
+    for rev in revisions:
+        for prev in store.list_revisions(rev.metric_id):
+            if prev.revision_id == rev.revision_id or prev.status != REVISION_PUBLISHED:
+                continue
+            if prev.revision_no < rev.revision_no:
+                out[rev.revision_id] = prev.definition_ref
+    return out
+
+
+def _key_of(rev: MetricRevision) -> str:
+    """从 definition_ref 还原 metric_key。"""
+    ref = rev.definition_ref or ""
+    if "@" in ref:
+        head = ref.split("@", 1)[0]
+        parts = head.split(":")
+        if len(parts) >= 4:
+            return ":".join(parts[3:])
+    return ref
