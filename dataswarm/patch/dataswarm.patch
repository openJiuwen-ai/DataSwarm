+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""sql controller HTTP 状态码单测（方案 §3.1 envelope：失败返回 4xx/5xx 而非 200）。
+
+bug 修复档 TDD：controller 现在对 service 返回的 ok:false 也写 200，本测试表达
+"失败应返回 4xx/5xx"的正确期望，跑前应为红，controller 修复后转绿。
+"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.sql import controller as ctrl
+from tests.unit.channel._dataagent_test_helpers import make_handler
+
+
+class _SvcSpy:
+    def __init__(self):
+        self.run_result = {"ok": True, "rows": [], "columns": [],
+                           "truncated": False, "row_count": 0, "elapsed_ms": 0}
+        self.explain_result = {"ok": True, "explain": []}
+        self.ddl_result = {"ok": True, "affected_rows": 0, "elapsed_ms": 0}
+
+    def run_sql(self, db_ref, sql, limit):
+        return self.run_result
+
+    def explain_sql(self, db_ref, sql, workspace_id=None, role="business"):
+        return self.explain_result
+
+    def execute_ddl(self, db_ref, sql, workspace_id=None, role="business", session_id=""):
+        return self.ddl_result
+
+
+@pytest.fixture
+def patch_svc(monkeypatch):
+    spy = _SvcSpy()
+    monkeypatch.setattr(ctrl, "svc", spy)
+    return spy
+
+
+# --------------------------------------------------------------------------
+# 成功 → 200
+# --------------------------------------------------------------------------
+def test_run_success_200(patch_svc):
+    h, resp = make_handler("/api/dataagent/sql/run",
+                            {"db_ref": "doris://d", "sql": "SELECT 1", "limit": 5})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 200
+
+
+def test_explain_success_200(patch_svc):
+    h, resp = make_handler("/api/dataagent/sql/explain",
+                            {"db_ref": "d", "sql": "SELECT 1"})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 200
+
+
+def test_ddl_success_200(patch_svc):
+    h, resp = make_handler("/api/dataagent/sql/ddl",
+                            {"db_ref": "d", "sql": "CREATE TABLE t(id int)", "confirm": True})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 200
+
+
+# --------------------------------------------------------------------------
+# 失败 → 5xx（service ok:false → controller 不应再写 200）
+# --------------------------------------------------------------------------
+def test_run_failure_returns_5xx(patch_svc):
+    """修复前：service 返回 ok:false 时 controller 仍写 200（bug）。
+    修复后：ok:false → 500（执行失败）。
+    """
+    patch_svc.run_result = {"ok": False, "error": "boom", "db_ref": "doris://d"}
+    h, resp = make_handler("/api/dataagent/sql/run",
+                            {"db_ref": "doris://d", "sql": "SELECT 1"})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 500
+    assert resp.payload["ok"] is False
+    assert "boom" in resp.payload["error"]
+
+
+def test_explain_failure_returns_5xx(patch_svc):
+    patch_svc.explain_result = {"ok": False, "error": "boom", "db_ref": "d"}
+    h, resp = make_handler("/api/dataagent/sql/explain",
+                            {"db_ref": "d", "sql": "SELECT 1"})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 500
+
+
+def test_ddl_failure_returns_5xx(patch_svc):
+    patch_svc.ddl_result = {"ok": False, "error": "perm", "db_ref": "d"}
+    h, resp = make_handler("/api/dataagent/sql/ddl",
+                            {"db_ref": "d", "sql": "DROP TABLE t", "confirm": True})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 500
+    assert resp.payload["ok"] is False
+
+
+# --------------------------------------------------------------------------
+# 参数错 → 400（既有契约保持）
+# --------------------------------------------------------------------------
+def test_ddl_without_confirm_returns_400(patch_svc):
+    h, resp = make_handler("/api/dataagent/sql/ddl",
+                            {"db_ref": "d", "sql": "CREATE TABLE t(id int)"})
+    ctrl.handle_post(h, h.parsed)
+    assert resp.status == 400
+    assert resp.payload["error"] == "confirm_required"
+
+
+def test_unknown_route_returns_404(patch_svc):
+    h, resp = make_handler("/api/dataagent/sql/unknown", {})
+    ctrl.handle_post(h, h.parsed)
