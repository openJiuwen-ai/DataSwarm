+    # ------------------------------------------------------------------ #
+    async def _count_chunks(self, kb_id: str) -> int:
+        """Best-effort chunk count for a KB; 0 if the KB has not been built."""
+        if kb_id not in self._kbs:
+            return 0
+        try:
+            kb = self._kbs[kb_id]
+            index_name = f"kb_{kb_id}_chunks"
+            info = await kb.index_manager.get_index_info(index_name)
+            # get_index_info returns a dict; try common count keys.
+            if isinstance(info, dict):
+                for k in ("count", "chunk_count", "num_chunks", "total"):
+                    v = info.get(k)
+                    if isinstance(v, int):
+                        return v
