diff --git a/jiuwenswarm/channels/web/frontend/tests/workflowDocument.test.mjs b/jiuwenswarm/channels/web/frontend/tests/workflowDocument.test.mjs
new file mode 100644
index 000000000..001db077f
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/workflowDocument.test.mjs
@@ -0,0 +1,123 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  WorkflowDocument,
+  removeWorkflowNodes,
+} from '../node_modules/.cache/data-development/store/workflowDocument.js';
+import { parseLogEntries } from '../node_modules/.cache/data-development/components/shared/logEntries.js';
+const node = (id, upstream = '') => ({ node_id: id, task_id: 'task', upstream_nodes: upstream });
+const deferred = () => {
+  let resolve, reject;
+  const promise = new Promise((ok, fail) => {
+    resolve = ok;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+};
+
+test('rapid edits serialize snapshots; flush waits for the final dependency graph', async () => {
+  const first = deferred();
+  const writes = [];
+  const doc = new WorkflowDocument([], async (nodes) => {
+    writes.push(structuredClone(nodes));
+    if (writes.length === 1) await first.promise;
+  });
+  doc.change([node('a')]);
+  await Promise.resolve();
+  doc.change([node('a'), node('b', 'a')]);
+  let released = false;
+  const run = doc.flush().then(() => {
+    released = true;
+  });
+  await Promise.resolve();
+  assert.equal(released, false);
+  assert.equal(writes.length, 1);
+  first.resolve();
+  await run;
+  assert.equal(writes.length, 2);
+  assert.equal(writes[1][1].upstream_nodes, 'a');
+  assert.equal(doc.state, 'saved');
+});
+
+test('failure preserves edits and blocks execution until explicit retry succeeds', async () => {
+  const first = deferred();
+  let writes = 0;
+  const doc = new WorkflowDocument([], async () => {
+    if (++writes === 1) await first.promise;
+  });
+  doc.change([node('a')]);
+  const pending = doc.flush();
+  first.reject(new Error('offline'));
+  await assert.rejects(pending, /offline/);
+  doc.change([node('a'), node('b', 'a')]);
+  assert.equal(doc.nodes.length, 2);
+  assert.equal(writes, 1);
+  await assert.rejects(doc.flush(), /offline/);
+  await doc.retry();
+  assert.equal(doc.state, 'saved');
+  assert.equal(doc.dirty, false);
+});
+
+test('undo/redo also persist and a new edit discards the redo branch', async () => {
+  const writes = [];
+  const doc = new WorkflowDocument([], async (nodes) => {
+    writes.push(nodes);
+  });
+  doc.change([node('a')]);
+  await doc.flush();
+  doc.change([node('a'), node('b', 'a')]);
+  await doc.flush();
+  doc.undo();
+  await doc.flush();
+  assert.equal(doc.nodes.length, 1);
+  doc.redo();
+  await doc.flush();
+  assert.equal(doc.nodes.length, 2);
+  doc.undo();
+  doc.change([node('a'), node('c')]);
+  await doc.flush();
+  assert.equal(doc.canRedo, false);
+  assert.equal(writes.at(-1)[1].node_id, 'c');
+});
+
+test('retry after undo reconciles a write whose response was lost', async () => {
+  let stored = [];
+  let writes = 0;
+  const doc = new WorkflowDocument([], async (nodes) => {
+    stored = structuredClone(nodes);
+    if (++writes === 1) throw new Error('response lost');
+  });
+  doc.change([node('a')]);
+  await assert.rejects(doc.flush(), /response lost/);
+  doc.undo();
+  assert.equal(doc.dirty, true, 'a failed response leaves persistence unconfirmed');
+  await doc.retry();
+  assert.deepEqual(stored, []);
+  assert.equal(writes, 2);
+  assert.equal(doc.state, 'saved');
+  assert.equal(doc.error, null);
+  assert.equal(doc.dirty, false);
+});
+
+test('deleting a node removes downstream references; history can restore both', () => {
+  assert.deepEqual(removeWorkflowNodes([node('a'), node('b', 'a'), node('c', 'a,b')], new Set(['b'])), [
+    node('a'),
+    node('c', 'a'),
+  ]);
+});
+
+test('bracketed levels and comma timestamps preserve stack traces under filtering', () => {
+  const entries = parseLogEntries(
+    '[INFO] ready\n2026-09-12 12:01:02,123 [ERROR] failed\nTraceback (most recent call last):\n  File "task.py", line 3\nValueError: no value\n2026-09-12T12:01:03+08:00 INFO done',
+  );
+  assert.deepEqual(
+    entries.map((e) => e.level),
+    ['info', 'error', 'info'],
+  );
+  assert.match(entries.filter((e) => e.level === 'error')[0].text, /ValueError: no value/);
+  assert.equal(entries[1].timestamp, '2026-09-12 12:01:02,123');
+  assert.match(entries[1].message, /^\[ERROR\] failed\nTraceback/);
+  assert.match(entries[1].message, /ValueError: no value$/);
+  assert.equal(entries[0].timestamp, null);
+  assert.equal(parseLogEntries('[sql_executor] 1 row')[0].level, null);
+});
