+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""db_connector._format_sql 的 mysql/doris 占位符与字面 % 转义单测。
+
+回归背景（2026-10-13 指标问答实测）：带 grain 的 SQL 含
+``DATE_FORMAT(x, '%Y-%m')``，params 非空时 pymysql 会对 SQL 做 % 插值——
+未转义的字面 ``%Y`` 直接炸 ``unsupported format character 'Y'``。
+"""
+from __future__ import annotations
+
+from jiuwenswarm.common.db_connector import _format_sql
+
+
+def test_mysql_literal_percent_escaped_with_params():
+    """params 非空时：字面 % 转义成 %%，? 占位符换成 %s（顺序不可反）。"""
+    sql, params = _format_sql(
+        "SELECT DATE_FORMAT(paid_at, '%Y-%m') AS bucket, region FROM orders"
+        " WHERE paid_at >= ? AND paid_at < ? GROUP BY 1, 2",
+        ("2026-08-01", "2026-09-01"), "mysql")
+    assert sql == ("SELECT DATE_FORMAT(paid_at, '%%Y-%%m') AS bucket, region FROM orders"
+                   " WHERE paid_at >= %s AND paid_at < %s GROUP BY 1, 2")
+    assert params == ["2026-08-01", "2026-09-01"]
+
+
+def test_mysql_doris_branch_same_behavior():
+    """doris 与 mysql 同走 pymysql 分支。"""
+    sql, _ = _format_sql("SELECT a % b FROM t WHERE x = ?", ("1",), "doris")
+    assert sql == "SELECT a %% b FROM t WHERE x = %s"
+
+
+def test_no_params_keeps_literal_percent_untouched():
+    """params 为空时 pymysql 不做 % 插值——字面 % 保持原样（转义反而错）。"""
+    sql, params = _format_sql(
+        "SELECT DATE_FORMAT(paid_at, '%Y-%m') AS bucket FROM orders", None, "mysql")
+    assert sql == "SELECT DATE_FORMAT(paid_at, '%Y-%m') AS bucket FROM orders"
+    assert params is None
+
+
+def test_sqlite_unchanged():
+    """sqlite/duckdb 用 ? 占位符，无 % 转义需求。"""
+    sql, params = _format_sql(
+        "SELECT strftime('%Y-%m', paid_at) FROM orders WHERE paid_at >= ?",
+        ("2026-08-01",), "sqlite")
+    assert sql == "SELECT strftime('%Y-%m', paid_at) FROM orders WHERE paid_at >= ?"
+    assert params == ("2026-08-01",)
