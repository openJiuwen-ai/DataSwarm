+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/semantic_link/core.py —— 传导 / 绑定校验 / 语义上下文 / 探索子图（其余原地）（自 semantic_link.py 保守拆分，纯搬运）。
+
+模块定位见包门面 docstring（semantic_link/__init__.py）。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from .. import store
+from ..errors import SemanticContextEmpty
+from ..model import Release
+from ._util import _warn
+from .schema_merge import SchemaHit, node_attributes, snapshot_index
+from .snapshots import current_snapshots, load_snapshots, resolve_source_map, workspace_semantic_refs
+from ..projection import formula_summary
+
+
+SCHEMA_PROPAGATION = 0.9
+SCHEMA_PROPAGATE_MIN = 0.30
+SCHEMA_PROPAGATE_LIMIT = 5
+
+
+@dataclass(frozen=True)
+class SemanticContext:
+    """给 LLM 与编译器共用的语义上下文（自 semantica_contracts 迁入）。
+
+    由 :func:`build_semantic_context` 从 ``dw_metric_*`` 表 + semantic 快照
+    组装；``time_field``/``group_by_fields`` 为**物理形态**（``表.列``，
+    经 binding.column_map 换算），与旧跨图 link 边读回的 logicalField 同构。
+    """
+
+    workspace_id: str
+    metric_key: str
+    release_id: str | None
+    revision: str | None = None
+    label: str = ""
+    comment: str = ""
+    unit: str = ""
+    operator: str = ""
+    formula_summary: str = ""
+    synonyms: list[str] = field(default_factory=list)
+    concept: str | None = None
+    dependencies: list[dict[str, Any]] = field(default_factory=list)
+    numerator: str | None = None
+    denominator: str | None = None
+    time_field: str | None = None
+    group_by_fields: list[str] = field(default_factory=list)
+    definition_ref: str | None = None
+    warnings: list[str] = field(default_factory=list)
+    # ---- schema 关系子图（seeds → snapshot joins/lineages 1 跳）----
+    schema: dict[str, Any] | None = None
+    schema_snapshot_id: str | None = None
+    drift: bool = False
+
+    @property
+    def is_empty(self) -> bool:
+        """无任何有效语义信息时为空。"""
+        return not (self.label or self.definition_ref or self.dependencies)
+
+
+# ==========================================================================
+# S→M 传导（纯表计算，替代旧跨图 link 边反向遍历）
+# ==========================================================================
+
+def propagate_to_metrics(
+    workspace_id: str, release: Release | None, snapshots: dict[str, Any],
+    hits: list[SchemaHit],
+) -> dict[str, float]:
+    """schema 命中经绑定反查指标 → ``metric_key -> 传导分``。
+
+    release 内全部修订的 bindings 经绑定源和完整表引用解析为真实节点，
+    按表/列 node_id 建反查索引，schema 命中按对象归属传导
+    ``score * SCHEMA_PROPAGATION``；噪声级命中（低于 MIN）不传导。
+    """
+    if release is None or not hits:
+        return {}
+    source_map = resolve_source_map(workspace_id)
+    if not source_map:
+        return {}
+    source_indexes = {source_id: snapshot_index({source_id: snapshot})
+                      for source_id, snapshot in snapshots.items()}
+    index: dict[str, set[str]] = {}
+    for revision_id in release.revision_ids:
+        revision = store.get_revision(revision_id)
+        if revision is None:
+            continue
+        for binding in store.list_bindings(revision_id):
+            table_id, column_nodes = binding_to_snapshot(binding, source_map, source_indexes)
+            if not table_id:
+                continue
+            for node_id in {table_id, *column_nodes.values()}:
+                index.setdefault(node_id, set()).add(_metric_key_of(revision))
+    out: dict[str, float] = {}
+    for hit in hits[:SCHEMA_PROPAGATE_LIMIT]:
+        if hit.score < SCHEMA_PROPAGATE_MIN:
+            continue  # 噪声级命中不传导，见 SCHEMA_PROPAGATE_MIN 注释（context.py 实测事故）
+        metric_keys = index.get(hit.node_id)
+        if not metric_keys:
+            continue
+        score = hit.score * SCHEMA_PROPAGATION
+        for metric_key in metric_keys:
+            if score > out.get(metric_key, 0.0):
+                out[metric_key] = score
+    return out
+
+
+def _metric_key_of(revision: Any) -> str:
+    """修订所属指标的 metric_key（经 defs 反查，缓存表内往返）。"""
+    metric = store.get_def(revision.metric_id)
+    return metric.metric_key if metric is not None else ""
+
+
+# ==========================================================================
+# 发布链路：绑定校验与语义 refs（替代旧 _ensure_schema_snapshot 活库探查）
+# ==========================================================================
+
+def ensure_semantic_refs(
+    workspace_id: str,
+    bindings_by_revision: dict[str, list[Any]],
+    warnings: list[str],
+) -> list[dict[str, str]]:
+    """发布时逐 binding 校验语义层快照，产出 manifest 的 ``semantic_refs``。
+
+    严格单一通道（plan 决策 3）：绑定数据源未被语义层采集 → 绑定回写
+    ``failed(semantic_not_collected)`` + warning，**发布不阻断**（倒逼先
+    注册数据源触发采集）；表列在快照中缺失（结构漂移）同理。全存在则
+    绑定确认 ``verified``。
+
+    Returns:
+        ``[{"source_id": ..., "snapshot_id": ...}]``（去重保序）。
+    """
+    from ..model import BINDING_FAILED, BINDING_VERIFIED
+
+    source_map = resolve_source_map(workspace_id)
+    snapshots = load_snapshots(workspace_semantic_refs(), warnings)
+    source_indexes = {source_id: snapshot_index({source_id: snapshot})
+                      for source_id, snapshot in snapshots.items()}
+    refs: list[dict[str, str]] = []
+    seen_sources: set[str] = set()
+    for bindings in bindings_by_revision.values():
+        for binding in bindings:
+            if not binding.source_table:
+                continue
+            source_id = source_map.get(binding.datasource_ref or "")
+            if not source_id:
+                _warn(warnings, f"semantic_source_unregistered:{binding.binding_id}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail="semantic_source_unregistered: 绑定数据源未注册")
+                continue
+            snapshot = snapshots.get(source_id)
+            if snapshot is None:
+                _warn(warnings, f"semantic_not_collected:{source_id}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail=f"semantic_not_collected: 数据源 {source_id} 无已发布语义快照")
+                continue
+            table_name = binding.source_table
+            table_id, column_nodes = binding_to_snapshot(binding, source_map, source_indexes)
+            if not table_id:
+                _warn(warnings, f"binding_table_missing:{source_id}:{table_name}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail=f"表 {binding.source_table} 不在语义快照中（结构漂移）")
+                continue
+            physical_columns = set(binding.column_map.values()) or set(binding.column_map)
+            missing = sorted(physical_columns - column_nodes.keys())
+            if missing:
+                _warn(warnings, f"binding_columns_missing:{table_name}:{','.join(missing)}")
+                store.update_binding_status(
+                    binding.binding_id, BINDING_FAILED,
+                    verify_detail=f"列 {','.join(missing)} 不在表 {table_name} 的语义快照中")
+                continue
+            store.update_binding_status(
+                binding.binding_id, BINDING_VERIFIED,
+                verify_detail=f"semantic:{source_id}@{snapshot.snapshot_id}")
+            if source_id not in seen_sources:
+                seen_sources.add(source_id)
+                refs.append({"source_id": source_id, "snapshot_id": snapshot.snapshot_id})
+    return refs
+
+
+def _snapshot_table(snapshot: Any, table_name: str, binding: Any) -> Any | None:
+    """兼容入口：按完整表引用取对象，歧义裸名及缺失的限定名不回退。"""
+    index = snapshot_index({"": snapshot})
+    table_id, _columns = anchor_to_snapshot(index, binding.source_table or table_name, {})
+    return index[table_id][""][0] if table_id else None
+
+
+# ==========================================================================
+# 语义上下文（替代旧 adapter.retrieve_context）
+# ==========================================================================
+
+def build_semantic_context(
+    workspace_id: str, metric_key: str, release: Release | None,
+) -> SemanticContext:
+    """从 ``dw_metric_*`` 表 + semantic 快照组装指标语义上下文。
+
+    Raises:
+        SemanticContextEmpty: 指标在该 release 内没有 published 修订。
+    """
+    revision = _revision_for(workspace_id, metric_key, release)
+    if revision is None:
+        raise SemanticContextEmpty(
+            f"语义层检索不到 {metric_key}（workspace={workspace_id}, "
+            f"release={release.release_id if release else None}）；"
+            "请确认该指标已发布")
+    metric = store.get_def(revision.metric_id)
+    if metric is None:
+        raise SemanticContextEmpty(f"指标定义缺失: {metric_key}")
+    warnings: list[str] = []
+    refs, snapshots = current_snapshots(warnings)
+    bindings = [b for b in store.list_bindings(revision.revision_id) if b.source_table]
+    mappings = store.list_concept_maps(revision.revision_id, status="confirmed")
+    summary = formula_summary(revision)
+
+    dependencies: dict[str, dict[str, Any]] = {}
+    concept: str | None = None
+    numerator: str | None = None
+    denominator: str | None = None
+    for mapping in mappings:
+        if mapping.relation_type == "measuresConcept":
+            if concept is None:
+                concept = mapping.target_ref
+            continue
+        if mapping.relation_type not in ("dependsOn", "numerator", "denominator"):
+            continue
+        entry = dependencies.setdefault(
+            mapping.target_ref, {"metric_key": mapping.target_ref, "roles": [], "fields": []})
+        if mapping.relation_type not in entry["roles"]:
+            entry["roles"].append(mapping.relation_type)
+        if mapping.relation_type == "numerator" and numerator is None:
+            numerator = mapping.target_ref
+        if mapping.relation_type == "denominator" and denominator is None:
+            denominator = mapping.target_ref
+    for dep_key, entry in dependencies.items():
+        entry["fields"] = _dependency_fields(workspace_id, dep_key, bindings)
+
+    physical = _physical_bindings(revision, bindings, snapshots)
+    schema_sub = None
+    if snapshots and physical:
+        seeds = [pid.table_id for pid in physical if pid.table_id]
+        seeds += [cid for pid in physical for cid in pid.node_ids.values()]
+        schema_sub = build_exploration_subgraph(snapshots, seeds)
+    group_by: list[str] = []
+    time_field: str | None = None
+    for pid in physical:
+        group_by.extend(pid.group_by)
+        if time_field is None:
+            time_field = pid.time_field
+    ctx = SemanticContext(
+        workspace_id=workspace_id, metric_key=metric_key,
+        release_id=release.release_id if release else None,
+        revision=str(revision.revision_no),
+        label=revision.display_name or metric.name,
+        comment=metric.description or "",
+        unit=revision.unit,
+        operator=revision.expression.parsed.operator if revision.expression.parsed else "",
+        formula_summary=summary,
+        synonyms=list(revision.synonyms),
+        concept=concept,
+        dependencies=_sorted_dependencies(dependencies),
+        numerator=numerator, denominator=denominator,
+        time_field=time_field,
+        group_by_fields=group_by,
+        definition_ref=revision.definition_ref,
+        warnings=warnings,
+        schema=schema_sub,
+        schema_snapshot_id=refs[0].snapshot_id if refs else None,
+        drift=not refs,
+    )
+    return ctx
+
+
+def _revision_for(workspace_id: str, metric_key: str, release: Release | None) -> Any | None:
+    """指标在 release 作用域内的当前生效修订（无 release 取当前生效）。
+
+    生效判定走 ``store.published_revision_of`` 单一出处（E6 收敛，archived
+    感知——归档指标不再命中）；release 给定时要求当前修订由该 release 携带
+    （旧图 release 作用域语义保持）。
+    """
+    revision = store.published_revision_of(workspace_id, metric_key)
+    if revision is None:
+        return None
+    if release is None or revision.revision_id in release.revision_ids:
+        return revision
+    return None
+
+
+@dataclass(frozen=True)
+class _PhysicalRef:
+    """一次 binding → 快照对象的解析产物。
+
+    ``table_id``/``node_ids``：快照内真实 node_id（解析不到为空——子图
+    种子缺位只影响可视化，不影响字段语义）；``fields``：物理 ``表.列`` 串
+    （与旧 link 边 logicalField 同构）；``time_field``/``group_by`` 同理。
+    """
+
+    table_id: str
+    node_ids: dict[str, str]
+    fields: tuple[str, ...]
+    time_field: str | None
+    group_by: list[str]
+
+
+def _physical_bindings(
+    revision: Any, bindings: list[Any], snapshots: dict[str, Any] | None = None,
+) -> list[_PhysicalRef]:
+    """修订的逻辑字段（time/dimensions）经 column_map 物理化 + 快照对象锚定。
+
+    快照给了就尝试把 (表名, 物理列) 锚定到真实 node_id（同表名多库歧义时
+    列名全命中者优先，锚不定留空——绝不造悬空 ID）。
+    """
+    from .. import semantic_link as _facade
+    index = _facade.snapshot_index(snapshots) if snapshots else {}
+    out: list[_PhysicalRef] = []
+    for binding in bindings:
+        table = binding.source_table.split(".")[-1]
+        physical_fields: dict[str, str] = {}
+
+        def physicalize(logical: str) -> str:
+            column = logical.split(".", 1)[1] if "." in logical else logical
+            physical = binding.column_map.get(column, column)
+            physical_fields[physical] = f"{table}.{physical}"
+            return f"{table}.{physical}"
+
+        time_field = physicalize(revision.time_dimension) if revision.time_dimension else None
+        group_by = [physicalize(d) for d in revision.allowed_dimensions if d]
+        if not physical_fields:
+            for logical in (revision.time_dimension, *revision.allowed_dimensions):
+                if logical:
+                    physicalize(logical)
+        table_id, node_ids = anchor_to_snapshot(index, binding.source_table, physical_fields)
+        out.append(_PhysicalRef(
+            table_id=table_id, node_ids=node_ids,
+            fields=tuple(physical_fields.values()),
+            time_field=time_field, group_by=group_by))
+    return out
+
+
+def anchor_to_snapshot(
+    index: dict[str, Any], table_name: str, columns: dict[str, str],
+) -> tuple[str, dict[str, str]]:
+    """(表名, 物理列集) → (表 node_id, {物理列: 列 node_id})。
+
+    多 database 同名表歧义时按列名全命中锚定；全部锚不定返回空
+    （``("", {})``——调用方按缺位降级）。
+    """
+    entry = index.get(table_name) or {}
+    if not entry:
+        return "", {}
+    if any(item is None for item in entry.values()):
+        return "", {}
+    if len(entry) == 1:
+        table, column_index = next(iter(entry.values()))
+        return table.node_id, {
+            name: column_index[name].node_id
+            for name in columns if name in column_index}
+    # Multiple matching candidates remain ambiguous even if all contain the
+    # requested columns. Only a unique candidate may supply an object identity.
+    matches = [(table, column_index) for table, column_index in entry.values()
+               if columns and all(name in column_index for name in columns)]
+    if len(matches) == 1:
+        table, column_index = matches[0]
+        return table.node_id, {name: column_index[name].node_id for name in columns}
+    return "", {}
+
+
+def binding_to_snapshot(
+    binding: Any, source_map: dict[str, str], source_indexes: dict[str, Any],
+) -> tuple[str, dict[str, str]]:
+    """将绑定解析为其数据源内的表/列节点，缺失或歧义不跨源回退。
+
+    Args:
+        binding: 带 datasource_ref、source_table 与 column_map 的指标绑定。
+        source_map: 注册数据源的 datasource_ref → source_id 映射。
+        source_indexes: 每个 source_id 单独构建的 snapshot_index。
+
+    Returns:
+        表 node_id 与原始物理列引用 → 列 node_id；无法定位表时返回空。
+        列名优先精确匹配，仅兼容已定位表的 name/FQN 限定前缀。
+    """
+    source_id = source_map.get(binding.datasource_ref or "")
+    index = source_indexes.get(source_id) if source_id else None
+    if not index or not binding.source_table:
+        return "", {}
+    table_id, _columns = anchor_to_snapshot(index, binding.source_table, {})
+    if not table_id:
+        return "", {}
+    table, columns = index[table_id][source_id]
+    node_ids: dict[str, str] = {}
+    for reference in set(binding.column_map.values()) or set(binding.column_map):
+        column = columns.get(reference)
+        if column is not None:
+            node_ids[reference] = column.node_id
+            continue
+        # A dot may be part of the column name. Strip only this table's known
+        # prefixes, and reject competing interpretations with distinct IDs.
+        matches = {columns[reference[len(prefix) + 1:]].node_id
+                   for prefix in {table.name, table.fqn}
+                   if reference.startswith(prefix + ".") and reference[len(prefix) + 1:] in columns}
+        if len(matches) == 1:
+            node_ids[reference] = matches.pop()
+    return table_id, node_ids
+
+
+
+def _dependency_fields(workspace_id: str, dep_key: str, own_bindings: list[Any]) -> list[str]:
+    """依赖指标经其 bindings 引用的物理列（``表.列`` 形态）。
+
+    依赖指标无绑定时退回自身 bindings 的字段面（旧图读不到依赖节点时
+    fields 为空——这里至少给 LLM 一个诚实的空/近似面，不虚构）。
+    """
+    for metric in store.list_defs(workspace_id):
+        if metric.metric_key != dep_key or not metric.current_revision_id:
+            continue
+        revision = store.get_revision(metric.current_revision_id)
+        if revision is None:
+            return []
+        refs = _physical_bindings(
+            revision, [b for b in store.list_bindings(revision.revision_id) if b.source_table])
+        return [field for ref in refs for field in ref.fields]
+    return []
+
+
+def _sorted_dependencies(dependencies: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
+    """依赖按 metric_key 排序（确定性输出，快照/哈希稳定）。"""
+    return [dependencies[key] for key in sorted(dependencies)]
+
+
+def context_digest(ctx: SemanticContext) -> str:
+    """语义上下文摘要，写进查询追溯用于复查（不含业务数据）。"""
+    from ..model import canonical_json, sha256_of
+
+    payload = {
+        "metric_key": ctx.metric_key,
+        "release_id": ctx.release_id,
+        "revision": ctx.revision,
+        "definition_ref": ctx.definition_ref,
+        "operator": ctx.operator,
+        "formula_summary": ctx.formula_summary,
+        "concept": ctx.concept,
+        "dependencies": ctx.dependencies,
+        "time_field": ctx.time_field,
+        "group_by_fields": ctx.group_by_fields,
+    }
+    return sha256_of(canonical_json(payload))
+
+
+# ==========================================================================
+# schema 关系子图（替代旧 adapter.schema_subgraph）
+# ==========================================================================
+
+def build_exploration_subgraph(
+    snapshots: dict[str, Any], seeds: list[str], *, max_nodes: int = 15,
+) -> dict[str, Any]:
+    """以 seeds 为根组装 schema 关系子图（1 跳 join + 1 跳血缘）。
+
+    输出与旧 ``schema_subgraph`` 同构：
+    ``{"tables": [{id,type,label,logical}], "columns": [...],
+    "joins": [{left,right,kind,evidence,verified}], "lineage": [...]}``，
+    前端 ``MetricSchemaGraph`` 与 R3 探索端点直接消费。
+    """
+    node_index = snapshot_index(snapshots)
+    collected: dict[str, dict[str, Any]] = {}
+    joins: list[dict[str, Any]] = []
+    lineage: list[dict[str, Any]] = []
+
+    def absorb(node_id: str) -> None:
+        if node_id in collected or len(collected) >= max_nodes:
+            return
+        attributes = node_attributes(snapshots, node_id)
+        if attributes is None:
+            return
+        node_type, label, logical = attributes
+        collected[node_id] = {
+            "id": node_id, "type": "SourceTable" if node_type != "col" else "SourceColumn",
+            "label": label, "logical": logical}
+
+    def seed_tables(seed: str) -> list[str]:
+        """Exact table IDs associated with a table or column seed."""
+        for snapshot in snapshots.values():
+            for table in snapshot.tables:
+                if table.node_id == seed:
+                    return [table.node_id]
+                for column in table.columns:
+                    if column.node_id == seed:
+                        return [table.node_id]
+        return []
+
+    frontier = list(dict.fromkeys(seeds))
+    for seed in frontier:
+        absorb(seed)
+    related = {name for seed in frontier for name in seed_tables(seed)}
+    # 表 → 全列吸收（belongsTo 等价物；列数受 max_nodes 约束）
+    for table_name in related:
+        entry = node_index.get(table_name) or {}
+        for item in entry.values():
+            if item is None:
+                continue
+            table, columns = item
+            absorb(table.node_id)
+            for column in columns.values():
+                absorb(column.node_id)
+    # join / 血缘：端点对象涉及 seed 关联表的全部收进来（1 跳等价）
+    for snapshot in snapshots.values():
+        for join in snapshot.joins:
+            if _join_touches(join, related, node_index):
+                for endpoint in (join.left_column_id, join.right_column_id,
+                                 join.left_table_id, join.right_table_id):
+                    absorb(endpoint)
+                record = {
+                    "left": join.left_column_id, "right": join.right_column_id,
+                    "kind": "foreignKey" if "fk" in join.source else "joinable",
+                    "evidence": "+".join(join.source) or "inferred",
+                    "verified": join.status == "verified",
+                }
+                if record not in joins:
+                    joins.append(record)
+        for link in snapshot.lineages:
+            if _lineage_touches(link, related, node_index):
+                for endpoint in [link.view_id, link.source_table_id,
+                                 link.source_column_id or "", link.target_column_id or ""]:
+                    if endpoint:
+                        absorb(endpoint)
+                record = {
+                    "left": link.source_table_id, "right": link.view_id,
+                    "kind": "derivedFrom", "evidence": "view_definition",
+                    "verified": link.completeness == "complete",
+                    "level": "column" if link.source_column_id else "table",
+                    "transformation": link.transformation,
+                }
+                if record not in lineage:
+                    lineage.append(record)
+    tables = [n for n in collected.values() if n["type"] == "SourceTable"]
+    columns = [n for n in collected.values() if n["type"] == "SourceColumn"]
+    return {"tables": tables, "columns": columns, "joins": joins, "lineage": lineage}
+
+
+
+def _join_touches(join: Any, related_tables: set[str], index: dict[str, Any]) -> bool:
+    """join 边是否涉及 seed 关联表（按列/表 ID 的表段判断）。"""
+    for endpoint in (join.left_column_id, join.right_column_id,
+                     join.left_table_id, join.right_table_id):
+        table_name = _table_name_of_endpoint(endpoint, index)
+        if table_name and table_name in related_tables:
+            return True
+    return False
+
+
+def _lineage_touches(link: Any, related_tables: set[str], index: dict[str, Any]) -> bool:
+    """血缘边是否涉及 seed 关联表。"""
+    for endpoint in (link.view_id, link.source_table_id,
+                     link.source_column_id or "", link.target_column_id or ""):
+        table_name = _table_name_of_endpoint(endpoint, index)
+        if table_name and table_name in related_tables:
+            return True
+    return False
+
+
+def _table_name_of_endpoint(endpoint: str, index: dict[str, Any]) -> str:
+    """Resolve an endpoint to its exact table ID, without parsing dotted names."""
+    if not endpoint:
+        return ""
+    for reference, sources in index.items():
+        for item in sources.values():
+            if item is None:
+                continue
+            table, columns = item
+            if reference != table.node_id:
+                continue  # Visit each exact entry once, skipping name aliases.
+            if endpoint == table.node_id or any(column.node_id == endpoint for column in columns.values()):
+                return table.node_id
+    return ""
