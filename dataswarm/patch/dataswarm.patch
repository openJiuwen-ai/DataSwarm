+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/meta_data/base.py — MetadataStore 抽象基类 + 注册表 + 工厂。
+
+仿 orchestration/executors/base.py 的 ABC + @register + get_executor 模式。
+每个具体实现封装完整 SQL（DDL、CRUD 语句），调用方零 if/else。
+"""
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+
+
+class MetadataStore(ABC):
+    """元数据存储策略协议。
+
+    子类实现全部方法，各自内嵌完整的 SQL 语句和占位符约定。
+    调用方通过 get_store() 获取实例，多态调用，无需关心底层数据库。
+    """
+
+    store_type: str = "base"
+
+    # ---- Plan CRUD ----
+
+    @abstractmethod
+    def save_plan(self, plan_id: str, name: str, business: str,
+                  purpose: str, content_json: str = "",
+                  plan_data: dict | None = None) -> dict:
+        """插入或更新方案。
+
+        plan_data 优先：写 plan JSON 到 <workspace>/plans/<plan_id>.json，
+        DB 只存轻量索引行。content_json 为旧调用兼容，当 plan_data
+        为 None 时从 content_json 解析。
+        """
+
+    @abstractmethod
+    def get_plan(self, plan_id: str) -> dict | None:
+        """返回 plan dict（优先从 plan 文件读取，fallback 到 DB）。不存在返回 None。"""
+
+    @abstractmethod
+    def get_plan_file_path(self, plan_id: str) -> str | None:
+        """返回 plan 文件路径（从 DB 索引行），不存在返回 None。"""
+
+    @abstractmethod
+    def list_plans(self, business: str = "") -> list[dict]:
+        """列出方案，可选按 business 过滤。"""
+
+    @abstractmethod
+    def update_plan(self, plan_id: str, **fields) -> dict | None:
+        """部分更新 plan 字段。"""
+
+    @abstractmethod
+    def get_plan_tables(self, plan_id: str) -> list[dict]:
+        """返回 plan_table 行，按 layer + table_name 排序。
+
+        优先从 plan 文件的 tables 数组读取，fallback 到 DB plan_table。
+        """
+
+    # ---- Plan 查重 ----
+
+    @abstractmethod
+    def find_recent_plan(self, biz_database: str, source_type: str = "csv") -> dict | None:
+        """按 biz_database + source_type 取最近一个 plan（DB 索引行 + get_plan 文件丰富）。
+
+        无匹配返回 None。
+        """
+
+    # ---- PlanTable（DB-only 读写，供脚本状态机）----
+
+    @abstractmethod
+    def list_plan_tables(self, plan_id: str, layer: str | None = None,
+                         status: str | None = None) -> list[dict]:
+        """直接查 DB plan_table 行（不走 plan 文件），可选 layer/status 过滤。
+
+        脚本按 status 做状态机（designed/ddl_created/data_loaded/etl_done）依赖 DB 列，
+        故不走 get_plan_tables 的文件优先语义。返回 list[dict]，按 layer 顺序 + table_name 排序。
+        """
+
+    @abstractmethod
+    def save_plan_tables(self, plan_id: str, tables: list[dict]) -> dict:
+        """批量 upsert plan_table，按 (plan_id, table_name) 幂等：存在则 UPDATE，否则 INSERT。
+
+        tables 每项含 table_name/layer/ddl_sql/etl_sql/source_tables/status/reuse_of_plan_id。
+        返回 {"inserted": int, "updated": int}。
+        """
+
+    # ---- Table Lineage CRUD ----
+
+    @abstractmethod
+    def list_table_lineage(self, db_name: str, plan_id: str | None = None,
+                           business_ref: str | None = None) -> list[dict]:
+        """列出 source_db 或 target_db 匹配的 table_lineage 行。
+
+        business_ref 非 None 时按其严格过滤（跨数据源血缘隔离；NULL 存量行不返回）。
+        可选按 plan_id 过滤。
+        """
+
+    @abstractmethod
+    def save_table_lineage(self, edges: list[dict]) -> int:
+        """批量插入 table lineage 边，返回插入数。"""
+
+    @abstractmethod
+    def delete_table_lineage(self, plan_id: str, task_id: str | None = None) -> int:
+        """按 plan_id（+ 可选 task_id）删除 table lineage 边。
+
+        task_id 省略时按 plan_id 单条件删（清整个 plan 的血缘，方案 §5.4 G6）；
+        非空时加双键过滤。返回删除数。
+        """
+
+    # ---- Column Lineage CRUD ----
+
+    @abstractmethod
+    def list_column_lineage(self, db_name: str, table_name: str = "",
+                            business_ref: str | None = None) -> list[dict]:
+        """列出 column_lineage 行，可选按 table / business_ref 过滤。"""
+
+    @abstractmethod
+    def save_column_lineage(self, edges: list[dict]) -> int:
+        """批量插入 column lineage 边，返回插入数。"""
+
+    @abstractmethod
+    def delete_column_lineage(self, plan_id: str, task_id: str | None = None) -> int:
+        """按 plan_id（+ 可选 task_id）删除 column lineage 边。
+
+        task_id 省略时按 plan_id 单条件删（方案 §5.4 G6）；非空时加双键过滤。返回删除数。
+        """
+
+
+_REGISTRY: dict[str, type[MetadataStore]] = {}
+
+
+def register(cls: type[MetadataStore]) -> type[MetadataStore]:
+    """装饰器：注册 MetadataStore 实现。"""
+    _REGISTRY[cls.store_type] = cls
+    return cls
+
+
+def get_store(store_type: str | None = None) -> MetadataStore:
+    """工厂：返回 MetadataStore 实例。
+
+    store_type 为 None 时，根据 orchestration.db._is_sqlite 自动选择。
+    """
+    if store_type is None:
+        from jiuwenswarm.common.workspace_context import current_workspace
+        from jiuwenswarm.common.db_connector import parse_db_ref
+
+        store_type = "sqlite" if parse_db_ref(current_workspace().metadata_db_ref).get("type") == "sqlite" else "doris"
+    cls = _REGISTRY.get(store_type)
+    if cls is None:
+        raise ValueError(
+            f"unknown store_type: {store_type!r} "
+            f"(supported: {list(_REGISTRY)})"
+        )
+    return cls()
