+/* 治理路由独立响应视口；离开该路由后，旧页面仍沿用全局 1200px 最小宽度。 */
+html:has(.gov-shell),
+html:has(.gov-shell) body,
+html:has(.gov-shell) #root {
+  width: 100%;
+  min-width: 0;
+  max-width: 100%;
+  overflow-x: hidden;
+}
+
+/* 数仓治理：按 1920px 高保真定义 296px 批次栏、1200px 内容列与 480px 助手。 */
+.gov-shell {
+  --gov-paper: var(--color-surface-page);
+  --gov-panel: var(--color-surface-card);
+  --gov-panel-sunken: var(--color-surface-muted);
+  --gov-ink: var(--color-text-primary);
+  --gov-body: var(--color-text-primary);
+  --gov-muted: var(--color-text-secondary);
+  --gov-line: var(--color-border-default);
+  --gov-line-strong: var(--color-border-strong);
+  --gov-accent: var(--color-action-primary);
+  --gov-accent-strong: var(--color-action-primary-hover);
+  --gov-accent-subtle: var(--color-action-primary-subtle);
+  --gov-accent-edge: var(--color-border-accent);
+  --gov-success: var(--color-feedback-success);
+  --gov-success-subtle: var(--color-feedback-success-subtle);
+  --gov-warn: var(--color-feedback-warning);
+  --gov-warn-subtle: var(--color-feedback-warning-subtle);
+  --gov-danger: var(--color-feedback-danger);
+  --gov-danger-subtle: var(--color-feedback-danger-subtle);
+  --gov-info: var(--color-feedback-info);
+  --gov-info-subtle: var(--color-feedback-info-subtle);
+  --gov-font-mono: 'Cascadia Code', 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
+  position: relative;
+  display: flex;
+  flex: 1 1 auto;
+  width: 100%;
+  min-width: 0;
+  height: 100%;
+  overflow: hidden;
+  background: var(--gov-panel);
+  color: var(--gov-body);
+  font-feature-settings: 'tnum' 1;
+}
+
+.gov-shell *,
+.gov-shell *::before,
+.gov-shell *::after {
+  box-sizing: border-box;
+}
+
+.gov-shell :focus-visible {
+  outline: 2px solid var(--gov-accent);
+  outline-offset: 2px;
+  box-shadow: none;
+}
+
+.gov-shell button,
+.gov-shell input,
+.gov-shell select,
+.gov-shell textarea {
+  font-family: inherit;
+}
+
+.gov-shell button,
+.gov-shell input[type='checkbox'],
+.gov-shell select {
+  cursor: pointer;
+}
+
+.gov-shell button:disabled,
+.gov-shell input:disabled,
+.gov-shell select:disabled,
+.gov-shell textarea:disabled {
+  cursor: not-allowed;
+}
+
+/* 左侧巡检批次：1920 全宽、1366 收窄到 232px（clamp 下限），避免小屏侧栏占比过高 */
+.gov-side {
+  display: flex;
+  flex: 0 0 clamp(232px, 15.4vw, 296px);
+  flex-direction: column;
+  width: clamp(232px, 15.4vw, 296px);
+  min-width: 0;
+  height: 100%;
+  overflow: hidden;
+  border-right: 1px solid var(--gov-line);
+  background: var(--color-surface-shell);
+}
+
+.gov-brand {
+  display: flex;
+  flex: 0 0 68px;
+  align-items: center;
+  height: 68px;
+  padding: 0 24px;
+}
+
+.gov-brand h1 {
+  margin: 0;
+  color: var(--gov-ink);
+  font-size: 16px;
+  font-weight: 600;
+  line-height: 24px;
+}
+
+.gov-run-menu {
+  display: flex;
+  min-height: 0;
+  flex: 1;
+  flex-direction: column;
+  padding: 0 16px 16px;
+}
+
+.gov-run-menu-label {
