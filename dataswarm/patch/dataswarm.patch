+    monkeypatch.setattr(
+        "jiuwenswarm.server.runtime.gateway_adapter.project_adapter.collect_all_sessions_metadata",
+        lambda: [
+            {
+                "session_id": "ws-bank-pin",
+                "title": "bank pin",
+                "workspace_id": "bank",
+                "pinned": True,
+                "pin_order": 1,
+                "channel_id": "web",
+                "project_id": "",
+                "cron_id": "",
+                "last_user_message_at": 10.0,
+                "work_mode": "work",
+            },
+            {
+                "session_id": "ws-default-pin",
+                "title": "default pin",
+                # 存量无字段 → 默认桶
+                "pinned": True,
+                "pin_order": 2,
+                "channel_id": "web",
+                "project_id": "",
+                "cron_id": "",
+                "last_user_message_at": 9.0,
+                "work_mode": "work",
+            },
+            {
+                "session_id": "ws-bank-normal",
+                "title": "bank normal",
+                "workspace_id": "bank",
+                "pinned": False,
+                "channel_id": "web",
+                "project_id": "",
+                "cron_id": "",
+                "last_user_message_at": 8.0,
+                "work_mode": "work",
+            },
+            {
+                "session_id": "ws-default-normal",
+                "title": "default normal",
+                "workspace_id": "",
+                "pinned": False,
+                "channel_id": "web",
+                "project_id": "",
+                "cron_id": "",
+                "last_user_message_at": 7.0,
+                "work_mode": "work",
+            },
+        ],
+    )
+    return d
+
+
+class TestPinnedSessionsWorkspaceFilter:
+    @staticmethod
+    def test_no_param_returns_all(sessions_with_workspace):
+        payload = _load_pinned_sessions(None)
+        ids = {s["session_id"] for s in payload["sessions"]}
+        assert ids == {"ws-bank-pin", "ws-default-pin"}
+
+    @staticmethod
+    def test_default_bucket_includes_legacy(sessions_with_workspace):
+        payload = _load_pinned_sessions({"workspace_id": "default"})
+        ids = {s["session_id"] for s in payload["sessions"]}
+        assert ids == {"ws-default-pin"}
+
+    @staticmethod
+    def test_bank_bucket(sessions_with_workspace):
+        payload = _load_pinned_sessions({"workspace_id": "bank"})
+        ids = {s["session_id"] for s in payload["sessions"]}
+        assert ids == {"ws-bank-pin"}
+
+
+class TestProjectSessionsWorkspaceFilter:
+    @staticmethod
+    def test_filter_and_no_filter(sessions_with_workspace):
+        # 未带 workspace_id → 不过滤（向后兼容）
+        payload, err, _ = _load_project_sessions({"project_id": "default"}, "u1")
+        assert err is None
+        assert {s["session_id"] for s in payload["sessions"]} == {
+            "ws-bank-normal", "ws-default-normal",
+        }
+        # 带 default → 仅默认桶（含空归属存量）
+        payload, err, _ = _load_project_sessions(
+            {"project_id": "default", "workspace_id": "default"}, "u1"
+        )
+        assert err is None
+        assert {s["session_id"] for s in payload["sessions"]} == {"ws-default-normal"}
+        # 带 bank → 仅 bank
+        payload, err, _ = _load_project_sessions(
+            {"project_id": "default", "workspace_id": "bank"}, "u1"
+        )
+        assert err is None
+        assert {s["session_id"] for s in payload["sessions"]} == {"ws-bank-normal"}
