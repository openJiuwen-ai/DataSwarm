+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/graph_expand.py 单测（阶段 E：L2①a 图补全）。
+
+- 图读路：InMemory adapter（from_environment 打桩）——列→指标反查、
+  术语→指标反查、指标→列/术语带出
+- 推导路（一等回退）：图不可用 → bindings + concept_map 重建
+- 回源复验：图给出的不存在指标/列被丢弃并记 warning
+- 快照横向扩展：命中列 → 同表全列 + join 边（带 level）
+"""
+from __future__ import annotations
+
+from jiuwenswarm.channels.web.dataagent.analysis import graph_expand
+from jiuwenswarm.channels.web.dataagent.analysis.model import RecallHit, RoadResult
+from jiuwenswarm.channels.web.dataagent.metrics.graph_projection import (
+    EDGE_MEASURES_CONCEPT,
+    EDGE_USES_COLUMN,
+    metric_node_id,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.graph import (
+    GraphEdge,
+    GraphNode,
+    GraphProjection,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.model import (
+    ColumnMeta,
+    DatabaseMeta,
+    DataSourceMeta,
+    JoinPathMeta,
+    MetadataSnapshot,
+    TableMeta,
+)
+from jiuwenswarm.channels.web.dataagent.semantic.semantica import InMemorySemanticaAdapter
+
+
+def _snapshot(*, with_join: bool = False) -> MetadataSnapshot:
+    orders_columns = [
+        ColumnMeta("src", "mysql", "shop", "orders", "order_id",
+                   data_type="bigint", ordinal=1, column_key="PRI", comment="订单号"),
+        ColumnMeta("src", "mysql", "shop", "orders", "amount_cny",
+                   data_type="decimal", ordinal=2, comment="订单金额"),
+        ColumnMeta("src", "mysql", "shop", "orders", "region",
+                   data_type="varchar", ordinal=3, comment="销售区域"),
+    ]
+    customers_columns = [
+        ColumnMeta("src", "mysql", "shop", "customers", "customer_id",
+                   data_type="bigint", ordinal=1, comment="客户ID"),
+    ]
+    joins = []
+    if with_join:
+        joins.append(JoinPathMeta(
+            source_id="src", source_type="mysql",
+            left_column_id="col:mysql:src:shop.orders.order_id",
+            right_column_id="col:mysql:src:shop.customers.customer_id",
+            left_table_id="tbl:mysql:src:shop.orders",
+            right_table_id="tbl:mysql:src:shop.customers",
+            source=["naming_convention"], evidence={"level": "inferred"},
+            status="candidate"))
+    return MetadataSnapshot(
+        "snapshot:src:run-1", "run-1",
+        DataSourceMeta("src", "mysql", "mysql://db:3306/shop"),
+        [DatabaseMeta("src", "mysql", "shop")],
+        [
+            TableMeta("src", "mysql", "shop", "orders", columns=orders_columns),
+            TableMeta("src", "mysql", "shop", "customers", columns=customers_columns),
+        ],
+        joins=joins,
+    )
+
+
+def _publish(adapter: InMemorySemanticaAdapter, namespace: str, version: str,
+             nodes: list[GraphNode], edges: list[GraphEdge], *, cross: list[GraphEdge] = ()):
+    stage = adapter.stage(namespace, version, GraphProjection(nodes=nodes, edges=edges))
+    adapter.validate(stage)
+    adapter.publish(stage)
+    if cross:
+        adapter.create_cross_edges(namespace, list(cross))
+
+
+def _road(kind: str, hits: list[RecallHit]) -> RoadResult:
+    return RoadResult(kind, tuple(hits), "ok")
+
+
+def _hit(kind: str, entity_id: str, payload: dict | None = None) -> RecallHit:
+    return RecallHit(kind=kind, entity_id=entity_id, label=entity_id,
+                     channels=[("lexical", 0.9)], matched_on=["lexical"], payload=payload or {})
+
+
+# ==========================================================================
+# 图读路
+# ==========================================================================
+
+def _install_graph(monkeypatch, adapter: InMemorySemanticaAdapter):
+    monkeypatch.setattr(graph_expand, "from_environment", lambda: adapter)
+
+
+def test_graph_path_column_to_metric(monkeypatch):
+    """列命中 → usesColumn 反查 → 指标子包补全（图读路）。"""
+    gmv_node = metric_node_id("ws", "commerce.gmv")
+    adapter = InMemorySemanticaAdapter()
+    _publish(
+        adapter, "metrics/ws", "v1",
+        [GraphNode(gmv_node, "Metric", {"metricKey": "commerce.gmv"})],
+        [],
+        cross=[GraphEdge(gmv_node,
+                         "col:mysql:src:shop.orders.amount_cny", EDGE_USES_COLUMN)])
+    _install_graph(monkeypatch, adapter)
+    from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+
+    monkeypatch.setattr(metric_store, "get_def_by_key",
+                        lambda ws, key: type("M", (), {
+                            "metric_key": key, "status": "active",
+                            "current_revision_id": "rev-1", "name": key})())
+    monkeypatch.setattr(metric_store, "get_revision",
+                        lambda rid: type("R", (), {
+                            "revision_id": rid, "status": "published",
+                            "display_name": "GMV"})())
+
+    results = {
+        "terms": _road("term", []),
+        "metrics": _road("metric", []),
+        "schema": _road("column", [_hit("column", "col:mysql:src:shop.orders.amount_cny")]),
+        "values": _road("value", []),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot()})
+    assert [hit.entity_id for hit in expansion.metrics] == ["commerce.gmv"]
+    assert expansion.metrics[0].matched_on == [f"graph:{EDGE_USES_COLUMN}"]
+    assert expansion.graph_status == "ok"
+
+
+def test_graph_path_metric_to_columns_and_terms(monkeypatch):
+    """指标命中 → usesColumn 带出列、measuresConcept 带出术语（图读路）。"""
+    gmv_node = metric_node_id("ws", "commerce.gmv")
+    adapter = InMemorySemanticaAdapter()
+    _publish(
+        adapter, "metrics/ws", "v1",
+        [GraphNode(gmv_node, "Metric", {"metricKey": "commerce.gmv"})],
+        [],
+        cross=[
+            GraphEdge(gmv_node, "col:mysql:src:shop.orders.amount_cny", EDGE_USES_COLUMN),
+            GraphEdge(gmv_node, "term:ws:t-1", EDGE_MEASURES_CONCEPT),
+        ])
+    # glossary 侧：术语存在（回源复验通过）
+    from jiuwenswarm.channels.web.dataagent.glossary import db as glossary_db
+    monkeypatch.setattr(glossary_db, "list_terms", lambda: [
+        {"term_id": "t-1", "name": "商品交易总额", "definition": "已支付订单总金额",
+         "synonyms_list": ["流水"], "status": "active"}])
+    _install_graph(monkeypatch, adapter)
+
+    results = {
+        "terms": _road("term", []),
+        "metrics": _road("metric", [_hit("metric", "commerce.gmv")]),
+        "schema": _road("column", []),
+        "values": _road("value", []),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot()})
+    assert any(hit.entity_id == "col:mysql:src:shop.orders.amount_cny"
+               for hit in expansion.columns)
+    assert expansion.terms and expansion.terms[0]["term_id"] == "t-1"
+
+
+def test_graph_path_term_to_metric_carries_term_id(monkeypatch):
+    """术语入口 → measuresConcept 反查指标，via 必须带**term_id**。
+
+    回归：边是 Metric→Term，术语在对端；取错端会把 metric_key 当 term_id，
+    短路判定（找 ``graph:measuresConcept:{term_id}``）永远匹配不上——现象是
+    「Neo4j 可用时短路恒不触发，图挂掉走推导路反而正常」。
+    """
+    gmv_node = metric_node_id("ws", "commerce.gmv")
+    adapter = InMemorySemanticaAdapter()
+    _publish(
+        adapter, "metrics/ws", "v1",
+        [GraphNode(gmv_node, "Metric", {"metricKey": "commerce.gmv"})],
+        [],
+        cross=[GraphEdge(gmv_node, "term:ws:t-gmv", EDGE_MEASURES_CONCEPT)])
+    _install_graph(monkeypatch, adapter)
+    from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+
+    monkeypatch.setattr(metric_store, "get_def_by_key",
+                        lambda ws, key: type("M", (), {
+                            "metric_key": key, "status": "active",
+                            "current_revision_id": "rev-1", "name": key})())
+    monkeypatch.setattr(metric_store, "get_revision",
+                        lambda rid: type("R", (), {
+                            "revision_id": rid, "status": "published",
+                            "display_name": "GMV"})())
+
+    results = {
+        "terms": _road("term", [RecallHit(
+            kind="term", entity_id="t-gmv", label="商品交易总额",
+            channels=[("lexical", 1.0)], matched_on=["alias"],
+            payload={"term_id": "t-gmv", "name": "商品交易总额"})]),
+        "metrics": _road("metric", []),
+        "schema": _road("column", []),
+        "values": _road("value", []),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot()})
+    assert [hit.entity_id for hit in expansion.metrics] == ["commerce.gmv"]
+    assert expansion.metrics[0].matched_on == [f"graph:{EDGE_MEASURES_CONCEPT}:t-gmv"], \
+        "via 里必须是 term_id，不能是 metric_key"
+
+    # 链判定据此成立（短路条件④）
+    from jiuwenswarm.channels.web.dataagent.analysis import shortcut
+
+    assert [h.entity_id for h in shortcut.term_links(expansion, "t-gmv")] == ["commerce.gmv"]
+
+
+def test_graph_drop_unverified_metric(monkeypatch):
+    """图给出的指标回源复验失败（无 published 修订）→ 丢弃 + warning。"""
+    ghost_node = metric_node_id("ws", "ghost.metric")
+    adapter = InMemorySemanticaAdapter()
+    _publish(
+        adapter, "metrics/ws", "v1",
+        [GraphNode(ghost_node, "Metric", {"metricKey": "ghost.metric"})],
+        [],
+        cross=[GraphEdge(ghost_node, "col:mysql:src:shop.orders.amount_cny",
+                         EDGE_USES_COLUMN)])
+    _install_graph(monkeypatch, adapter)
+    from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+
+    monkeypatch.setattr(metric_store, "get_def_by_key", lambda ws, key: None)
+
+    results = {
+        "terms": _road("term", []),
+        "metrics": _road("metric", []),
+        "schema": _road("column", [_hit("column", "col:mysql:src:shop.orders.amount_cny")]),
+        "values": _road("value", []),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot()})
+    assert expansion.metrics == []
+    assert any("graph_metric_dropped" in w for w in expansion.warnings)
+
+
+# ==========================================================================
+# 推导路（一等回退）
+# ==========================================================================
+
+def test_metadata_fallback_when_graph_unavailable(monkeypatch):
+    """图不可用（Neo4j 未配置）→ bindings 推导列→指标，只记 warning 不降级为零。"""
+    def _no_graph():
+        raise ValueError("SEMANTICA_URI, SEMANTICA_USERNAME and SEMANTICA_PASSWORD are required")
+
+    monkeypatch.setattr(graph_expand, "from_environment", _no_graph)
+
+    from jiuwenswarm.channels.web.dataagent.metrics import store as metric_store
+
+    class _Binding:
+        source_table = "shop.orders"
+        column_map = {"amount": "orders.amount_cny"}
+
+    monkeypatch.setattr(metric_store, "list_defs", lambda ws: [
+        type("M", (), {"metric_key": "commerce.gmv", "status": "active",
+                       "current_revision_id": "rev-1", "name": "gmv"})()])
+    monkeypatch.setattr(metric_store, "get_def_by_key",
+                        lambda ws, key: type("M", (), {
+                            "metric_key": key, "status": "active",
+                            "current_revision_id": "rev-1", "name": key})())
+    monkeypatch.setattr(metric_store, "get_revision",
+                        lambda rid: type("R", (), {"revision_id": rid, "status": "published",
+                                                   "display_name": "GMV"})())
+    monkeypatch.setattr(metric_store, "list_bindings", lambda rid: [_Binding()])
+    monkeypatch.setattr(metric_store, "list_concept_maps",
+                        lambda rid, status=None: [])
+
+    results = {
+        "terms": _road("term", []),
+        "metrics": _road("metric", []),
+        "schema": _road("column", [_hit("column", "col:mysql:src:shop.orders.amount_cny")]),
+        "values": _road("value", []),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot()})
+    assert expansion.graph_status == "unavailable"
+    assert "graph_unavailable" in expansion.warnings
+    assert [hit.entity_id for hit in expansion.metrics] == ["commerce.gmv"]
+    assert "graph:usesColumn" in expansion.metrics[0].matched_on
+
+
+# ==========================================================================
+# 快照横向扩展
+# ==========================================================================
+
+def _no_cross_graph(monkeypatch):
+    """空图（无跨层边）——隔离快照横向扩展的测试面。"""
+    _install_graph(monkeypatch, InMemorySemanticaAdapter())
+
+
+def test_same_table_expansion_and_joins(monkeypatch):
+    """命中列 → 同表全列入包 + 触及表的 join 边（带 level）。"""
+    _no_cross_graph(monkeypatch)
+    results = {
+        "terms": _road("term", []),
+        "metrics": _road("metric", []),
+        "schema": _road("column", [_hit("column", "col:mysql:src:shop.orders.region")]),
+        "values": _road("value", []),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot(with_join=True)})
+    # 同表三列全部带出（order_id/amount_cny/region）
+    orders_columns = [hit.entity_id for hit in expansion.columns
+                      if "orders" in hit.entity_id]
+    assert len(orders_columns) == 3
+    # 推断级 join 边进白名单
+    assert len(expansion.joins) == 1
