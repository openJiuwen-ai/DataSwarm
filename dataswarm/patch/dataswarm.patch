+def a_secret_redaction():
+    oss = R.get_source_type("oss")
+    assert oss.secret_keys() == {"secret_key"}, oss.secret_keys()
+    pub = oss.public_config({"secret_key": "AKS-live-xxxx", "access_key": "id",
+                             "endpoint": "e"})
+    assert pub["secret_key"] == "", pub
+    assert pub["access_key"] == "id" and pub["endpoint"] == "e"
+    return "secret_key 回显为空，非密文字段保留"
