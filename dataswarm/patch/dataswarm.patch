+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""开放分析计划与证据门禁单测。"""
+from __future__ import annotations
+
+import copy
+import json
+import sqlite3
+import sys
+from argparse import Namespace
+from pathlib import Path
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.analysis.open_analysis import (
+    evidence_record,
+    report_gate,
+    file_hash,
+)
+from jiuwenswarm.channels.web.dataagent.analysis.plan import parse_and_validate
+
+SKILLS = Path(__file__).resolve().parents[3] / "jiuwenswarm/resources/agent/workspace/skills"
+
+
+@pytest.fixture
+def flow(monkeypatch, tmp_path):
+    """Phase 2c 拆层后的聚合视图：直调函数按对象复制（运行时解析各自模块
+    全局），patch 打真正的家——manifest 的路径族 / commands 的 _emit。"""
+    import types
+    import time as _time
+
+    sys.path.insert(0, str(SKILLS / "dw-analysis" / "scripts"))
+    import flow.budget as _budget
+    import flow.cli_registry as _registry
+    import flow.commands as _commands
+    import flow.execute_core as _core
+    import flow.manifest as _manifest
+
+    ns = types.ModuleType("open_flow")
+    for src_mod in (_manifest, _core, _budget, _commands, _registry):
+        for name in dir(src_mod):
+            if not name.startswith("__"):
+                setattr(ns, name, getattr(src_mod, name))
+    ns.time = _time
+
+    def _tmp_manifest_path(aid):
+        return tmp_path / "artifacts" / aid / "manifest.json"
+
+    # _PROC_START 在模块导入时取值；全量 UT 中模块可能早被导入，进程耗时会误撞 deadline_ms
+    monkeypatch.setattr(_manifest, "_PROC_START", _time.monotonic())
+    monkeypatch.setattr(_manifest, "ARTIFACT_ROOT", tmp_path / "artifacts")
+    monkeypatch.setattr(_manifest, "_manifest_path", _tmp_manifest_path)
+    monkeypatch.setattr(_commands, "_emit", lambda *args, **kwargs: None)
+    ns._manifest_path = _tmp_manifest_path
+    # patch 的家：setattr 打这些模块才传导（聚合 ns 只做读取视图）
+    import flow.dwcli_client as _dwcli
+    ns._manifest_mod = _manifest
+    ns._commands_mod = _commands
+    ns._dwcli_mod = _dwcli
+    return ns
+
+
+@pytest.fixture
+def report_modules(monkeypatch):
+    """加载 dw-report 的 resolver / page / markdown。"""
+    monkeypatch.syspath_prepend(str(SKILLS / "dw-report" / "scripts"))
+    import importlib
+
+    resolver = importlib.import_module("resolver")
+    page = importlib.import_module("render.page")
+    markdown = importlib.import_module("render.markdown")
+    return resolver, page, markdown
+
+
+def _manifest(flow):
+    plan = _open_plan()
+    parsed, errors = parse_and_validate(plan, {"sales"}, {"orders": ["paid_at", "region"]})
+    assert not errors
+    from jiuwenswarm.channels.web.dataagent.analysis.views import plan_view
+
+    manifest = {"analysis_id": "a-open", "question": plan["question"], "mode": "open",
+                "plan": plan_view(parsed), "plan_raw": plan, "started_at": flow._now(),
+                "semantic_versions": {"release_id": "rel"}, "result_checks": {},
+                "budget": {"sql_count": 0, "tool_calls": 0, "explore_count": 0},
+                "evidence": [], "components": {}, "uncovered": []}
+    for c in plan["components"]:
+        flow._component(manifest, c["component_id"])
+    return manifest
+
+
+def _component(component_id: str, metric: str, *, role: str = "core", required: bool = True,
+               facet_id: str = "", refs: list[str] | None = None) -> dict:
+    return {
+        "component_id": component_id,
+        "text": component_id,
+        "role": role,
+        "required": required,
+        "facet_id": facet_id,
+        "selected_metrics": [metric],
+        "material_refs": refs or [f"metric:{metric}"],
+        "dimensions": [],
+        "time": {"dimension": "paid_at", "start": "2026-01-01", "end_exclusive": "2026-07-01"},
+        "output": "单行金额（CNY）",
+    }
+
+
+def _open_plan() -> dict:
+    return {
+        "analysis_id": "a-open",
+        "question": "分析上半年销售情况",
+        "mode": "open",
+        "facets": [{
+            "facet_id": "f-region", "label": "区域结构", "priority": 30,
+            "required": False, "component_ids": ["c-region"],
+            "material_refs": ["dimension:region"],
+        }],
+        "components": [
+            _component("c-total", "sales", refs=["metric:sales"]),
+            _component("c-trend", "sales", refs=["metric:sales"]),
+            _component("c-region", "sales", role="facet", required=False,
+                       facet_id="f-region", refs=["metric:sales", "dimension:region"]),
+        ],
+    }
+
+
+def test_open_plan_accepts_core_and_optional_facet():
+    parsed, errors = parse_and_validate(
+        _open_plan(), {"sales"}, {"orders": ["paid_at", "region"]},
+        material_ids={"metric:sales", "dimension:region"})
+    assert errors == []
+    assert parsed is not None
+    assert parsed.mode == "open"
+    assert parsed.components[-1].required is False
+    assert parsed.components[-1].facet_id == "f-region"
