+class FakeStore:
+    """FAISSStore 使用面替身：add_vectors/delete_vectors/save_index/index.metadata。"""
+
+    def __init__(self):
+        self.index = SimpleNamespace(metadata={})
+        self.saved = 0
+
+    def add_vectors(self, vectors, ids=None, metadata=None):
+        for vector_id, meta in zip(ids, metadata):
+            self.index.metadata[vector_id] = dict(meta)
+
+    def delete_vectors(self, ids):
+        for vector_id in ids:
+            self.index.metadata.pop(vector_id, None)
+
+    def save_index(self, path):
+        self.saved += 1
+
+
+@pytest.fixture()
+def term_db(monkeypatch, tmp_path):
+    db_path = tmp_path / "glossary.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    ensure_system_schema(f"sqlite://{db_path}")
+    glossary_db._ensured_refs.clear()
+    sync._reset_for_tests()
+    sync._set_graph_adapter_for_tests(InMemorySemanticaAdapter())
+    return db_path
+
