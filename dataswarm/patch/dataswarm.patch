+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""MongoDB 采样建模、DuckDB 物化查询和治理接口验收。
+
+用法：verify_gates.py <mongo_host> <mongo_port> <db>，目标须预置专用 fixture。
+采样类型漂移与物化截断必须显式返回；五道分析题与共用基准逐值比较。
+采样 schema 不保证包含所有低频字段。
+"""
+import sys
+
+from jiuwenswarm.channels.web.dataagent.connectors.base import (
+    SourceDefinition, SqlQueryable, TabularScannable, capabilities_of,
+    get_engine, registered_engines,
+)
+from jiuwenswarm.channels.web.dataagent.connectors.errors import (
+    ConnectorError, QueryValidationError,
+)
+from jiuwenswarm.channels.web.dataagent.datasource import registry as R
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common import dialect_registry as dr
+
+HOST, PORT, DB = sys.argv[1], int(sys.argv[2]), sys.argv[3]
+MONGO_CONFIG = {"host": HOST, "port": PORT, "database": DB}
+
+PASS, FAIL, SKIP = [], [], []
+
+
+def check(gate, name, fn):
+    try:
+        detail = fn()
+        PASS.append((gate, name))
+        print(f"  [OK]      {gate} {name}" + (f"  -- {detail}" if detail else ""))
+    except Exception as exc:
+        FAIL.append((gate, name, f"{type(exc).__name__}: {exc}"))
+        print(f"  [FAIL]    {gate} {name}\n            {type(exc).__name__}: {exc}")
+
+
+def blocked(gate, name, reason):
+    SKIP.append((gate, name, reason))
+    print(f"  [BLOCKED] {gate} {name}\n            {reason}")
+
+
+def expect_raises(fn, exc_types, label):
+    try:
+        fn()
+    except exc_types:
+        return
+    raise AssertionError(f"{label} 应当被拒绝，但通过了")
+
+
+def connector_for(config=None, source_id="verify"):
+    adapter = R.get_source_type("mongodb")
+    source = SourceDefinition(
+        source_id, "mongodb", "verify", adapter.engine, dict(config or MONGO_CONFIG)
+    )
+    return get_engine(adapter.engine)(source)
+
+
+def dataset_names(cat):
+    return [d["name"] for d in cat["datasets"]]
+
+
+# ======================================================================
+print("\n########## 门 A：接入 ##########")
+
+
+def a_catalog_entry():
+    entry = {t["type_id"]: t for t in R.list_source_types()}["mongodb"]
+    assert entry["available"] is True, entry
+    assert entry["engine"] == "sampled", entry
+    assert entry["category"] == "nosql", entry
+    assert "sampled" in registered_engines(), registered_engines()
+    return f"mongodb 可用，引擎=sampled（已注册引擎 {registered_engines()}）"
+
+
+def a_validate_rules():
+    adapter = R.get_source_type("mongodb")
+    expect_raises(lambda: adapter.validate({}), ValueError, "空参数")
+    expect_raises(lambda: adapter.validate({"host": "h"}), ValueError, "缺 database")
+    expect_raises(lambda: adapter.validate({**MONGO_CONFIG, "sample_size": "0"}),
+                  ValueError, "sample_size 非正")
+    expect_raises(lambda: adapter.validate({**MONGO_CONFIG, "materialize_limit": "-1"}),
+                  ValueError, "materialize_limit 非正")
+    adapter.validate(MONGO_CONFIG)
+    adapter.validate({**MONGO_CONFIG, "sample_size": "500", "materialize_limit": "1000"})
+    return "必填项与两个数值参数的校验均生效"
+
+
+def a_real_test_connection():
+    ok = connector_for().test_connection()
+    assert ok.get("ok") is True, f"真实 MongoDB 应连通: {ok}"
+    bad = connector_for({**MONGO_CONFIG, "port": 59999}).test_connection()
+    assert bad.get("ok") is False, f"错端口应失败: {bad}"
+    return f"真实 MongoDB 连通（{ok['message']}）；错端口失败"
+
+
+def a_secret_redaction():
+    adapter = R.get_source_type("mongodb")
+    assert adapter.secret_keys() == {"password"}, adapter.secret_keys()
+    pub = adapter.public_config({**MONGO_CONFIG, "password": "s3cret", "user": "u"})
+    assert pub["password"] == "" and pub["user"] == "u", pub
+    return "password 回显为空"
+
+
+check("A1", "类型目录与引擎", a_catalog_entry)
+check("A2", "参数校验", a_validate_rules)
+check("A3", "真实连通性", a_real_test_connection)
+check("A4", "凭据脱敏", a_secret_redaction)
+
+# ======================================================================
+print("\n########## 门 B：建模（采样推断）##########")
+
+
+def b_build_ref_roundtrip():
+    ref = R.get_source_type("mongodb").build_ref(MONGO_CONFIG)
+    assert ref == f"mongodb://{HOST}:{PORT}/{DB}", ref
+    return f"build_ref = {ref}"
+
+
+def b_catalog_lists_collections():
+    names = dataset_names(connector_for().catalog())
+    for want in ("fact_orders", "drift_probe", "nested_probe"):
+        assert want in names, names
+    return f"集合列为逻辑表：{names}"
+
+
+def b_infer_schema_on_real_collection():
+    conn = connector_for()
+    inferred = conn.infer_schema("fact_orders", sample=500)
+    by = {c["name"]: c for c in inferred["columns"]}
+    assert inferred["sampled"] == 500, inferred["sampled"]
+    for want in ("order_id", "order_amt", "channel_name", "_id"):
+        assert want in by, list(by)
+    assert by["order_id"]["type"] == "BIGINT", by["order_id"]
+    assert by["channel_name"]["type"] == "VARCHAR", by["channel_name"]
+    # order_amt 有空值：样本里会同时见到 DOUBLE 与缺失 → nullable
+    assert by["order_amt"]["nullable"] is True, by["order_amt"]
+    # schema() 走统一结构，_id 作为事实唯一键标 pk
+    sch = conn.schema("fact_orders")
+    assert sch["primary_key"] == ["_id"], sch["primary_key"]
+    return f"采样 500 篇推断 {len(by)} 列；_id 标为 pk"
+
+
+def b_schema_drift_is_reported_not_resolved():
+    """采样发现混合类型时须报告漂移，不能擅自选择聚合所需类型。"""
+    conn = connector_for()
+    inferred = conn.infer_schema("drift_probe", sample=100)
+    by = {c["name"]: c for c in inferred["columns"]}
+    amount = by["amount"]
+    assert amount["type"] == "mixed", f"漂移字段被挑了单一类型: {amount}"
+    assert set(amount["observed_types"]) >= {"BIGINT", "DOUBLE", "VARCHAR"}, amount
+    drift_names = {d["name"] for d in inferred["drift_fields"]}
+    assert "amount" in drift_names, inferred["drift_fields"]
+    # presence 区分字段缺失与显式 null。
+    assert by["amount"]["presence"] < 1.0, amount
+    assert "类型漂移" in amount["comment"], amount["comment"]
+    return (f"amount 判为 mixed，观察到 {amount['observed_types']}，"
+            f"presence={amount['presence']}；漂移字段已登记")
+
+
+def b_nested_flattening():
+    conn = connector_for()
+    inferred = conn.infer_schema("nested_probe", sample=100)
+    names = {c["name"] for c in inferred["columns"]}
+    # 嵌套对象展平成点号路径
+    assert "buyer.name" in names, names
+    assert "buyer.addr.city" in names, names
+    # 数组整体记为 JSON，不展开成 tags.0 / tags.1（下标会让列集随数据漂移）
+    assert "tags" in names, names
+    assert not any(n.startswith("tags.") for n in names), names
+    by = {c["name"]: c for c in inferred["columns"]}
+    assert by["tags"]["type"] == "JSON", by["tags"]
+    return f"嵌套展平为点号路径（buyer.addr.city）；数组整体为 JSON"
+
+
+def b_scan_pushes_down_predicate():
+    conn = connector_for()
+    out = conn.scan("fact_orders", filters={"region_id": 1},
+                    projection=["region_id", "order_amt"], limit=50)
+    assert out["row_count"] == 50, out["row_count"]
+    assert set(out["columns"]) == {"region_id", "order_amt"}, out["columns"]
+    idx = out["columns"].index("region_id")
+    assert all(row[idx] == 1 for row in out["rows"]), "谓词未下推，取回了别的分区"
+    return f"谓词与投影下推生效（{out['row_count']} 行，仅 {out['columns']} 两列）"
+
+
+def b_capabilities_compose():
+    """采样连接器同时实现 scan 与 sql 能力协议。"""
+    conn = connector_for()
+    caps = capabilities_of(conn)
+    assert caps == {"sql", "scan"}, caps
+    assert isinstance(conn, TabularScannable)
+    assert isinstance(conn, SqlQueryable)
+    return "capabilities = {'sql', 'scan'}——两组协议同时成立"
+
+
+check("B1", "build_ref", b_build_ref_roundtrip)
+check("B2", "集合列为逻辑表", b_catalog_lists_collections)
+check("B3", "真实集合采样推断", b_infer_schema_on_real_collection)
+check("B4", "schema 漂移显式报告", b_schema_drift_is_reported_not_resolved)
+check("B5", "嵌套展平规则", b_nested_flattening)
+check("B6", "谓词与投影下推", b_scan_pushes_down_predicate)
+check("B7", "能力协议可组合", b_capabilities_compose)
+
+
+def b_governance_path():
+    """治理入口以 tables 暴露集合，以 schema 暴露采样推断结果。
+
+    presence 和类型漂移应保留；未采到的低频字段不视为确定不存在。
+    """
+    ref = R.get_source_type("mongodb").build_ref(MONGO_CONFIG)
+    spec = dbc.parse_db_ref(ref)
+    assert spec["type"] == "mongodb" and spec["database"] == DB, spec
+    names = dbc.tables(ref)["tables"]
+    assert "fact_orders" in names, names
+    cols = dbc.schema(ref, "fact_orders")["columns"]
+    by = {c["name"]: c for c in cols}
+    assert by["_id"]["pk"] is True, by["_id"]
+    assert set(by) >= {"order_amt", "channel_name", "order_date"}, list(by)
+    # 索引端口对文档库返回空列表（默认实现），不该抛
+    assert dbc.list_indexes(ref, "fact_orders")["indexes"] == []
+    return f"db_connector.tables={len(names)} 个集合，schema {len(cols)} 列"
+
+
+def b_knowledge_candidates_over_mongo():
+    from jiuwenswarm.channels.web.dataagent.knowledge import schema_candidates as sc
+
+    ref = R.get_source_type("mongodb").build_ref(MONGO_CONFIG)
+    cols = dbc.schema(ref, "fact_orders")["columns"]
+    hits = {}
+    for col in cols:
+        hit = sc._classify("fact_orders", col, "mongodb")
+        if hit:
+            hits[col["name"]] = (hit["asset_type"], hit["rule"])
+    assert hits["order_amt"] == ("metric", "quantity"), hits
+    assert hits["channel_name"] == ("term", "dimension"), hits
+    assert hits["order_date"] == ("term", "time"), hits
+    assert "_id" not in hits, "文档主键 _id 不该派生候选"
+    return f"经 MongoDB 的采样列派生 {len(hits)} 条候选，_id 已按 pk 排除"
+
+
+check("B8", "治理通路 db_connector 打通", b_governance_path)
+check("B9", "知识候选分类（经 MongoDB）", b_knowledge_candidates_over_mongo)
+
+# ======================================================================
+print("\n########## 门 C：数据分析跑通 ##########")
+
+# 共用 fixture 的固定分析答案。
+BASELINE = {
+    "Q1 单指标总量": [["2318839.92"]],
+    "Q2 分组TopN排序": [["4", "620606.75"], ["2", "620448.25"], ["3", "532051.48"]],
+    "Q3 时间粒度月度": [["2026-01", "99018.5"], ["2026-02", "91174.23"],
+                  ["2026-03", "97070.7"]],
+    "Q4 过滤+聚合": [["1", "10651"], ["2", "12425"], ["3", "10650"], ["4", "12425"]],
+    "Q5 空值占比": [["7.142"]],
+}
+
+# fixture 的 order_date 以 ISO 字符串存储，分析 SQL 显式转为 DATE。
+QUESTIONS = {
+    "Q1 单指标总量": 'SELECT ROUND(SUM(order_amt), 2) AS v FROM "fact_orders"',
+    "Q2 分组TopN排序": (
+        'SELECT region_id, ROUND(SUM(order_amt),2) AS v FROM "fact_orders" '
+        "GROUP BY region_id ORDER BY v DESC, region_id LIMIT 3"
+    ),
+    "Q3 时间粒度月度": (
+        "SELECT strftime(CAST(order_date AS DATE), '%Y-%m') AS m, "
+        'ROUND(SUM(order_amt),2) AS v FROM "fact_orders" '
+        "WHERE CAST(order_date AS DATE) >= DATE '2026-01-01' "
+        "GROUP BY m ORDER BY m LIMIT 3"
+    ),
+    "Q4 过滤+聚合": (
+        'SELECT category_id, COUNT(*) AS c FROM "fact_orders" '
+        "WHERE region_id <> 9 AND order_amt IS NOT NULL "
+        "GROUP BY category_id ORDER BY category_id"
+    ),
+    "Q5 空值占比": (
+        "SELECT ROUND(100.0 * SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END) "
+        '/ COUNT(*), 4) AS pct FROM "fact_orders"'
+    ),
+}
+
+
+def c_analysis_matches_baseline():
+    conn = connector_for({**MONGO_CONFIG, "materialize_limit": 60000})
+    answers = {}
+    for label, sql in QUESTIONS.items():
+        res = conn.query(sql, limit=10)
+        assert "materialize_truncated" not in res, (
+            f"{label} 物化被截断，答案不可信: {res.get('materialize_truncated')}"
+        )
+        answers[label] = [[str(v) for v in row] for row in res["rows"]]
+    for label, expected in BASELINE.items():
+        assert answers[label] == expected, (
+            f"{label} 与既有基准不一致:\n  基准={expected}\n  mongodb={answers[label]}"
+        )
+    print("            经 MongoDB 采样物化后的答案（与前四批基准一致）：")
+    for label, rows in BASELINE.items():
+        print(f"              {label} = {rows[0] if len(rows) == 1 else rows}")
+    return "5 道题经 MongoDB → 物化 → DuckDB 全部与基准逐值一致"
+
+
+def c_only_referenced_collections_materialized():
+    """只物化 SQL 引用的集合，避免读取无关集合。"""
+    conn = connector_for({**MONGO_CONFIG, "materialize_limit": 60000})
+    res = conn.query('SELECT COUNT(*) AS c FROM "drift_probe"', limit=5)
+    assert res["materialized"] == ["drift_probe"], res["materialized"]
+    assert res["rows"] == [[4]], res["rows"]
+    # CTE 名不是集合，不该被当成要物化的对象
+    res2 = conn.query(
+        'WITH t AS (SELECT * FROM "drift_probe") SELECT COUNT(*) AS c FROM t', limit=5)
+    assert res2["materialized"] == ["drift_probe"], res2["materialized"]
+    return "仅物化被引用的集合；CTE 别名未被误当集合"
+
+
+def c_unknown_collection_is_refused():
+    conn = connector_for()
+    expect_raises(lambda: conn.query('SELECT 1 FROM "no_such_collection"'),
+                  ConnectorError, "引用不存在的集合")
+    return "引用未知集合时明确报错并列出可用集合"
+
+
+check("C1", "5 道分析题与基准一致", c_analysis_matches_baseline)
+check("C2", "仅物化被引用集合", c_only_referenced_collections_materialized)
+check("C3", "未知集合被拒", c_unknown_collection_is_refused)
+
+# ======================================================================
+print("\n########## 门 D：护栏 ##########")
+
+
+def d_write_rejected():
+    conn = connector_for()
+    for sql in ('INSERT INTO "fact_orders" VALUES (1)',
+                'UPDATE "fact_orders" SET order_amt = 0',
+                'DELETE FROM "fact_orders"',
+                'DROP TABLE "fact_orders"',
+                "CREATE TABLE evil AS SELECT 1",
+                'COPY "fact_orders" TO \'leak.csv\''):
+        expect_raises(lambda s=sql: conn.query(s), QueryValidationError, sql[:28])
+    return "6 类写/导出操作被拒（护栏复用既有实现，未因物化而绕过）"
+
+
+def d_materialize_truncation_is_explicit():
+    """物化达到行数上限时，返回结果必须保留截断标记。"""
+    conn = connector_for({**MONGO_CONFIG, "materialize_limit": 100})
+    res = conn.query('SELECT COUNT(*) AS c FROM "fact_orders"', limit=5)
+    assert res["materialize_truncated"] == ["fact_orders"], res
+    assert res["materialize_limit"] == 100, res
+    # 聚合只覆盖物化后的 100 行，截断标记必须保留。
+    assert res["rows"] == [[100]], res["rows"]
+    return (f"物化上限 100 时显式报 materialize_truncated={res['materialize_truncated']}，"
+            f"结果 {res['rows'][0][0]} 行（若不告知就是静默少算）")
+
+
+def d_multi_statement_and_dialect():
+    conn = connector_for()
+    expect_raises(lambda: conn.query('SELECT 1; DROP TABLE "fact_orders"'),
+                  QueryValidationError, "多语句")
+    assert dr.sqlglot_dialect("mongodb") == "duckdb", dr.sqlglot_dialect("mongodb")
+    return "多语句被拒；方言为 duckdb（物化后即 DuckDB 表）"
+
+
+def d_row_truncation_flag():
+    conn = connector_for({**MONGO_CONFIG, "materialize_limit": 60000})
+    res = conn.query('SELECT * FROM "fact_orders"', limit=10)
+    assert len(res["rows"]) == 10 and res["truncated"] is True, res.get("truncated")
+    return "返回行数超限置 truncated=True"
+
+
+def d_no_sql_to_mql_translator():
+    """查询经采样物化后交给 DuckDB；不将 SQL 翻译成 MQL 执行。"""
+    import inspect as _inspect
+
+    from jiuwenswarm.channels.web.dataagent.connectors import sampled_connector as sc
+
+    src = _inspect.getsource(sc)
+    for banned in ("$match", "$group", "aggregate("):
+        assert banned not in src, f"出现了 MQL 聚合管道构造（{banned}），说明在自研翻译器"
+    # query 必须经物化后交给 duckdb
+    query_src = _inspect.getsource(sc.SampledStoreConnector.query)
+    assert "_materialize(" in query_src and "duckdb" in query_src, query_src[:200]
+    return "未出现 MQL 聚合管道；query 走物化 + DuckDB"
+
+
+check("D1", "写/导出操作被拒", d_write_rejected)
+check("D2", "物化截断显式透出", d_materialize_truncation_is_explicit)
+check("D3", "多语句与方言", d_multi_statement_and_dialect)
+check("D4", "返回行截断标志", d_row_truncation_flag)
+check("D5", "未自研 SQL→MQL 翻译器", d_no_sql_to_mql_translator)
+
+# ======================================================================
+print("\n" + "=" * 70)
+print(f"通过 {len(PASS)} 项，失败 {len(FAIL)} 项，阻断 {len(SKIP)} 项")
+if SKIP:
+    print("\n阻断明细：")
+    for skip_gate, skip_name, skip_reason in SKIP:
+        print(f"  {skip_gate} {skip_name}\n    {skip_reason}")
+if FAIL:
+    print("\n失败明细：")
+    for fail_gate, fail_name, fail_err in FAIL:
+        print(f"  {fail_gate} {fail_name}\n    {fail_err}")
+    sys.exit(1)
+print("\nmongodb 四道门通过（含门 C 对真实 MongoDB 的同题同解）")
