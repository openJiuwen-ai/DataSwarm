@@ -0,0 +1,136 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics 术语桥接与口径注入测试（活链路版）。
+
+链路：问题 → glossary 三级召回识别术语 → 扩展词注入 semantic_link 检索词
+（search_terms extra_terms / metric_table_scores extra_terms）→ 口语词
+「平台交易流水」经术语「商品交易总额(GMV)」桥接到指标词法面。对照用例
+证明同一问句在**无扩展词**时图打分零命中——桥接是唯一信号源。
+
+口径渲染契约：generator.glossary_terms_prompt（原 context.py 活函数随
+V2 ask 退场迁入 generator；context.py 整体退役见
+.agents/notes/proposed/architecture/2026-10-24-metrics-context-retirement.md）。
+
+红线（对齐 test_glossary_recall.py）：本机 Windows 上 faiss 链接的
+OpenBLAS 多线程预分配会 hard crash——本文件 monkeypatch ``sync._faiss_store``
+恒返回 None，绝不 import 真实 faiss；glossary 向量层走 WARN_INDEX_EMPTY
+降级，alias/LIKE 层照常（测试术语经 alias 层确定性命中）。
+"""
+from __future__ import annotations
+
+from jiuwenswarm.channels.web.dataagent.glossary import db as glossary_db
+from jiuwenswarm.channels.web.dataagent.glossary import recall as glossary_recall
+from jiuwenswarm.channels.web.dataagent.glossary import sync
+from jiuwenswarm.channels.web.dataagent.metrics import generator, semantic_link, versioning
+from tests.unit_tests.web.conftest import OSSIE_EXAMPLE, WORKSPACE
+
+GMV = "commerce.gmv"
+# 问句设计：tokens（平台/台交/交易/易流/流水/水走/走势）对三个演示指标的
+# name/synonyms/metric_key 均零命中；术语 synonyms 的「平台交易流水」经 alias
+# 层整词命中后，扩展词「GMV」命中 commerce.gmv 的 metric_key 档。
+QUESTION = "平台交易流水走势"
+
+
+def _glossary_env(e2e, monkeypatch):
+    """e2e 元库 + 术语通道可用（faiss 打桩 None：向量层降级，别名层确定性）。"""
+    sync._reset_for_tests()
+    glossary_db._ensured_refs.clear()
+    monkeypatch.setattr(sync, "_faiss_store", lambda ws, dims=None: None)
+    return e2e
+
+
+def _publish_metrics(e2e):
+    """导入 + 确认 + 发布（真实链路，同 test_metrics_v4_routing 的发布方式）。"""
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    versioning.import_ossie(
+        OSSIE_EXAMPLE.read_text(encoding="utf-8"), WORKSPACE, target_db_type="sqlite",
+        datasource_resolver=lambda alias: e2e["business_ref"] if alias == "biz_sales" else None)
+    revision_ids = [r.revision_id for m in store.list_defs(WORKSPACE)
+                    for r in store.list_revisions(m.metric_id)]
+    for revision_id in revision_ids:
+        for mapping in store.list_concept_maps(revision_id, status="candidate"):
+            if mapping.relation_type in ("numerator", "denominator"):
+                versioning.confirm_mapping(mapping.mapping_id, confirmed_by="glossary-test")
+    versioning.publish_release(WORKSPACE, revision_ids, graph_adapter=e2e["graph_adapter"],
+                               label="glossary", published_by="t")
+    return store.get_active_release(WORKSPACE)
+
+
+# ==========================================================================
+# 术语桥接：口语问句 → 扩展词注入 → 指标召回
+# ==========================================================================
+
+def test_colloquial_question_bridges_via_term(e2e, monkeypatch):
+    """「平台交易流水走势」原词法零命中；术语桥接后扩展词接进指标词法面。"""
+    glossary_env = _glossary_env(e2e, monkeypatch)
+    _publish_metrics(glossary_env)
+    glossary_db.create_term({
+        "name": "商品交易总额",
+        "definition": "特定周期内平台所有生成订单的总金额",
+        "synonyms": ["GMV", "平台交易流水"],
+    })
+
+    # 术语识别（glossary 三级召回内核——analysis 链术语路同款入口）
+    resolved = glossary_recall.resolve(QUESTION, limit=20)
+    matches = [m for m in resolved.get("matches") or ()
+               if str((m.get("term") or {}).get("name") or "") == "商品交易总额"]
+    assert matches, "alias 层必须确定性命中「平台交易流水」"
+    term = matches[0]["term"]
+    assert term["definition"] == "特定周期内平台所有生成订单的总金额"
+
+    # 对照：原句直查指标词法面零命中（证明桥接是唯一信号源）
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    base = {m.metric_key for m, _s, _via in store.search_defs(WORKSPACE, QUESTION)}
+    assert GMV not in base
+    # 扩展词拼成新查询再查（analysis 链术语路的桥接形态）——把口语词接进指标词法面
+    expanded = {m.metric_key for m, _s, _via
+                in store.search_defs(WORKSPACE, "商品交易总额 GMV")}
+    assert GMV in expanded
+    # 扩展词同时进 schema/图共用检索词（整词注入，不切 2-gram）
+    terms = semantic_link.search_terms(QUESTION, extra_terms=["商品交易总额", "GMV"])
+    assert "GMV" in terms and "商品交易总额" in terms
+
+
+# ==========================================================================
+# search_terms 的扩展词席位
+# ==========================================================================
+
+def test_search_terms_extra_terms_survive_cap():
+    """扩展词保留席位不被问题分词挤掉（cap=12 内问题 2-gram 就有 7 个）。"""
+    terms = semantic_link.search_terms(QUESTION, cap=8, extra_terms=["商品交易总额", "GMV"])
+    assert "GMV" in terms
+    assert "商品交易总额" in terms
+    # 日期残片过滤对扩展词同样生效（无数字词混入）
+    assert all(not t.isdigit() for t in terms)
+
+
+# ==========================================================================
+# 口径渲染契约（generator.glossary_terms_prompt）
+# ==========================================================================
+
+def test_glossary_terms_prompt_renders_caliber():
+    """definition 截断、歧义标注与确认指令、plain 模式。"""
+    terms = [
+        {"name": "商品交易总额", "definition": "平台所有生成订单的总金额",
+         "score": 1.0, "match_type": "alias"},
+        {"name": "含税销售额", "definition": "含" * 250,
+         "score": 0.9, "match_type": "like", "ambiguous": True},
+    ]
+
+    section = generator.glossary_terms_prompt(terms)
+    assert "商品交易总额：平台所有生成订单的总金额" in section
+    assert "[口径歧义] 含税销售额" in section
+    assert "含" * 200 + "…" in section       # definition 截断到 200 字
+    assert "含" * 201 not in section
+    assert "clarifications" in section        # 歧义确认指令随行
+    assert "不能当作 metric_key 使用" in section  # 防把术语名当选指标
+
+    # plain 模式（generate_sql 兜底）：调用方已选定 metric_key，不渲染标记与指令
+    plain = generator.glossary_terms_prompt(terms, with_ambiguity=False)
+    assert "[口径歧义]" not in plain
+    assert "clarifications" not in plain
+    assert "商品交易总额" in plain
+
+    assert generator.glossary_terms_prompt([]) == ""
+    assert "未提供定义" in generator.glossary_terms_prompt([{"name": "裸术语"}])
