+    assert.equal(host.querySelectorAll('.dd-log-entries article').length, 1);
+    assert.match(host.querySelector('.dd-log-entries pre').textContent, /ValueError: bad value/);
+    let downloaded;
+    const create = URL.createObjectURL;
+    const revoke = URL.revokeObjectURL;
+    const anchorClick = window.HTMLAnchorElement.prototype.click;
+    URL.createObjectURL = (blob) => {
+      downloaded = blob;
+      return 'blob:download';
+    };
+    URL.revokeObjectURL = () => {};
+    window.HTMLAnchorElement.prototype.click = () => {};
+    try {
+      await click(host.querySelector(`button[aria-label="${i18n.t('dataAsset.logs.download')}"]`));
+      assert.equal(await downloaded.text(), error);
+    } finally {
+      URL.createObjectURL = create;
+      URL.revokeObjectURL = revoke;
+      window.HTMLAnchorElement.prototype.click = anchorClick;
+    }
+    await act(async () =>
+      root.render(
+        React.createElement(runtime.LogViewer, { runId: 'node-run', stream: 'stderr', presentation: 'workflow' }),
+      ),
+    );
+    assert.equal(host.querySelectorAll('.dd-log-entries article').length, 1);
+    assert.equal(host.querySelector('.dd-log-entries pre').textContent, 'diagnostic output');
+    assert.equal(host.querySelector('.dd-log-timestamp'), null);
+  });
+}
diff --git a/jiuwenswarm/channels/web/frontend/tests/dataPreview.test.mjs b/jiuwenswarm/channels/web/frontend/tests/dataPreview.test.mjs
new file mode 100644
index 000000000..865fdf92f
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/dataPreview.test.mjs
@@ -0,0 +1,194 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { JSDOM } from 'jsdom';
+import i18next from 'i18next';
+import { I18nextProvider } from 'react-i18next';
+import {
+  DataPreview,
+  useDataManagementStore as store,
+  metadataApi,
+} from '../node_modules/.cache/data-preview/runtime.mjs';
+
+const detail = { name: 'orders', columns: [], indexes: [], foreign_keys: [], row_count: null, ddl: '' };
+const page = (value, extra = {}) => ({ columns: ['id'], rows: [[value]], total: null, ...extra });
+test.beforeEach(() => {
+  store.getState().reset();
+  store.setState({ selectedDb: 'data', previewLimit: 20 });
+  metadataApi.getTable = async () => detail;
+  metadataApi.getPreview = async () => page(1);
+});
+
+test('schema-only table selection and explicit loading never submit a preview', async () => {
+  let queries = 0;
+  metadataApi.getPreview = async () => {
+    ++queries;
+    return page(1);
+  };
+  metadataApi.getTable = async () => ({ ...detail, preview_supported: false });
+  await store.getState().selectTable('orders');
+  assert.equal(store.getState().preview, null);
+  assert.equal(store.getState().tableDetail.name, 'orders');
+  assert.equal(queries, 0);
+  assert.equal(await store.getState().loadPreview(), false);
+  assert.equal(queries, 0);
+});
+
+test('preview errors preserve usable schema and old page size', async () => {
+  metadataApi.getPreview = async () => {
+    throw new Error('preview temporarily unavailable');
+  };
+  await store.getState().selectTable('orders');
+  assert.equal(store.getState().error, null);
+  assert.equal(store.getState().tableDetail.name, 'orders');
+  assert.equal(store.getState().previewError, 'preview temporarily unavailable');
+  await store.getState().setPreviewLimit(100);
+  assert.equal(store.getState().previewLimit, 20);
+});
+
+test('out-of-order previews and reset cannot expose a stale result', async () => {
+  store.setState({ selectedTable: 'orders', tableDetail: detail });
+  const pending = [];
+  metadataApi.getPreview = () => new Promise((resolve) => pending.push(resolve));
+  const older = store.getState().loadPreview(0, 20);
+  const newer = store.getState().loadPreview(20, 20);
+  pending[1](page(21));
+  await newer;
+  pending[0](page(1));
+  await older;
+  assert.equal(store.getState().preview.rows[0][0], 21);
+  assert.equal(store.getState().previewOffset, 20);
+  const removed = store.getState().loadPreview(40, 20);
+  store.getState().reset();
+  pending[2](page(41));
+  await removed;
+  assert.equal(store.getState().preview, null);
+});
+
+test('an old same-table detail request cannot reload the first preview page', async () => {
+  const pending = [];
+  metadataApi.getTable = () => new Promise((resolve) => pending.push(resolve));
+  const offsets = [];
+  metadataApi.getPreview = async (_db, _table, offset) => {
+    offsets.push(offset);
+    return page(offset + 1);
+  };
+  const older = store.getState().selectTable('orders');
+  const newer = store.getState().selectTable('orders');
+  pending[1](detail);
+  await newer;
+  await store.getState().loadPreview(20, 20);
+  pending[0](detail);
+  await older;
+  assert.deepEqual(offsets, [0, 20]);
+  assert.equal(store.getState().previewOffset, 20);
+  assert.equal(store.getState().preview.rows[0][0], 21);
+});
+
+test('preview waits for schema capability and never runs for a pending DDL selection', async () => {
+  let finish;
+  metadataApi.getTable = () =>
+    new Promise((resolve) => {
+      finish = resolve;
+    });
+  let queries = 0;
+  metadataApi.getPreview = async () => {
+    ++queries;
+    return page(1);
+  };
+  const selecting = store.getState().selectTable('orders');
+  assert.equal(await store.getState().loadPreview(), false);
+  finish({ ...detail, preview_supported: false });
+  await selecting;
+  assert.equal(await store.getState().loadPreview(), false);
+  assert.equal(queries, 0);
+});
+
+async function mount(language, run) {
+  const dom = new JSDOM('<div id="root"></div>', { url: 'http://unit.test', pretendToBeVisual: true });
+  const globals = {
+    window: dom.window,
+    document: dom.window.document,
+    HTMLElement: dom.window.HTMLElement,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    ResizeObserver: class {
+      observe() {}
+      disconnect() {}
+    },
+  };
+  const descriptors = new Map(
+    Object.keys(globals).map((key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)]),
+  );
+  for (const [key, value] of Object.entries(globals))
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  const i18n = i18next.createInstance();
+  await i18n.init({
+    lng: language,
+    initImmediate: false,
+    showSupportNotice: false,
+    resources: {
+      [language]: {
+        translation: JSON.parse(readFileSync(new URL(`../src/i18n/locales/${language}.json`, import.meta.url), 'utf8')),
+      },
+    },
+  });
+  const root = createRoot(document.getElementById('root'));
+  try {
+    await act(async () => root.render(createElement(I18nextProvider, { i18n }, createElement(DataPreview))));
+    await run(i18n);
+  } finally {
+    await act(async () => root.unmount());
+    for (const [key, descriptor] of descriptors) {
+      if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+      else delete globalThis[key];
+    }
+    dom.window.close();
+  }
+}
+
+for (const language of ['zh', 'en']) {
+  test(`${language}: unknown totals paginate without inventing a count and display partial data`, async () => {
+    store.setState({
+      selectedTable: 'orders',
+      tableDetail: detail,
+      preview: page(1, { has_more: true, materialize_truncated: ['orders'] }),
+    });
+    const calls = [];
+    metadataApi.getPreview = async (_db, _table, offset, limit) => {
+      calls.push([offset, limit]);
+      return page(21, { has_more: false, window_truncated: true });
+    };
+    await mount(language, async (i18n) => {
+      assert.ok(
+        document.body.textContent.includes(i18n.t('dataManagement.preview.unknownTotal', { start: 1, end: 1 })),
+      );
+      assert.ok(document.body.textContent.includes(i18n.t('dataManagement.preview.partial')));
+      const next = () =>
+        [...document.querySelectorAll('button')].find((b) => b.textContent === i18n.t('common.pagination.next'));
+      await act(async () => next().click());
+      assert.deepEqual(calls, [[20, 20]]);
+      assert.equal(next().disabled, true);
+      assert.ok(document.body.textContent.includes(i18n.t('dataManagement.preview.windowLimit')));
+    });
+  });
+  test(`${language}: failed previews can retry and DDL has a clear empty state`, async () => {
+    store.setState({ selectedTable: 'orders', tableDetail: detail, previewError: 'preview temporarily unavailable' });
+    let calls = 0;
+    metadataApi.getPreview = async () => {
+      ++calls;
+      return page(1);
+    };
+    await mount(language, async (i18n) => {
+      assert.equal(calls, 0);
+      assert.equal(document.querySelector('[role="alert"]').textContent, 'preview temporarily unavailable');
+      await act(async () => document.querySelector('button').click());
+      assert.equal(calls, 1);
+      assert.equal(document.querySelector('[role="alert"]'), null);
+      await act(async () => store.setState({ tableDetail: { ...detail, preview_supported: false }, preview: null }));
+      assert.ok(document.body.textContent.includes(i18n.t('dataManagement.preview.unsupported')));
+      assert.equal(document.querySelector('button'), null);
+    });
+  });
+}
