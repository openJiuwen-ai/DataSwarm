+                  </Field>
+                )}
+                <Field label={t('biMetrics.form.aggregationExpression')}
+                       hint={columnOptions.length
+                         ? t('biMetrics.form.availableColumns', {
+                             columns: columnOptions.slice(0, 8).join(', ')
+                               + (columnOptions.length > 8
+                                 ? t('biMetrics.form.moreColumns', { count: columnOptions.length })
+                                 : ''),
+                           })
+                         : t('biMetrics.form.aggregationExpressionHint')}>
+                  <textarea className={`${inputClass} h-24 font-mono text-xs`} value={expression}
+                            onChange={(e) => setExpression(e.target.value)} />
+                </Field>
+                <div className="grid grid-cols-2 gap-3">
+                  <Field label={t('biMetrics.form.unit')}>
+                    <SuggestInput value={unit} options={UNIT_OPTIONS} listId="metric-unit-options"
+                                  placeholder={t('biMetrics.form.pickOrInput')} onChange={setUnit} />
+                  </Field>
+                  <Field label={t('biMetrics.form.synonymsLabel')} hint={t('biMetrics.form.synonymsHint')}>
+                    <input className={inputClass} value={synonyms}
+                           onChange={(e) => setSynonyms(e.target.value)} />
+                  </Field>
+                </div>
+                <div className={`grid gap-3 ${metricType === 'ratio' ? 'grid-cols-2' : 'grid-cols-1'}`}>
+                  <Field label={t('biMetrics.form.timeDimension')}
+                         hint={columnOptions.length
+                           ? t('biMetrics.form.candidatesFromColumns')
+                           : bindingAlias && bindingTable
+                             ? t('biMetrics.form.manualColumns')
+                             : t('biMetrics.form.pickSourceForCandidates')}>
+                    <PickSelect value={timeDimension} options={columnOptions}
+                                placeholder={t('biMetrics.form.pickTimeColumn')}
+                                onChange={setTimeDimension} />
+                  </Field>
+                  {metricType === 'ratio' && (
+                    <Field label={t('biMetrics.form.zeroDenominator')}
+                           hint={t('biMetrics.form.zeroDenominatorHint')}>
+                      <select className={inputClass} value={zeroDenominator}
+                              onChange={(e) => setZeroDenominator(e.target.value)}>
+                        <option value="">{t('biMetrics.form.zeroDenominatorNone')}</option>
+                        <option value="null">{t('biMetrics.form.zeroDenominatorNullif')}</option>
+                      </select>
+                    </Field>
+                  )}
+                </div>
+                <Field label={t('biMetrics.form.allowedDimensions')}
+                       hint={t('biMetrics.form.allowedDimensionsHint')}>
+                  <MultiPick values={allowedDimensions} options={columnOptions}
+                             placeholder={t('biMetrics.form.addDimension')}
+                             onChange={setAllowedDimensions} />
+                </Field>
+                <Field label={t('biMetrics.form.timeGrainLabel')}>
+                  <div className="flex flex-wrap gap-3 text-sm text-text">
+                    {TIME_GRAINS.map((grain) => (
+                      <label key={grain} className="flex items-center gap-1">
+                        <input type="checkbox" checked={timeGrains.includes(grain)}
+                               onChange={() => toggleGrain(grain)} />
+                        {grain}
+                      </label>
+                    ))}
+                  </div>
+                </Field>
+              </section>
+            </>
+          )}
+        </div>
+
+        {error && <span className="px-5 pb-1 text-xs text-danger">{error}</span>}
+
+        <div className={`flex items-center border-t border-border px-5 py-3 ${mode === 'create' ? 'justify-between' : 'justify-end'}`}>
+          {mode === 'create' && (
+            <Button variant="ghost" onClick={resetAll}>{t('biMetrics.form.clearAll')}</Button>
+          )}
+          <div className="flex items-center gap-2">
+            <Button variant="ghost" onClick={onClose}>{t('biMetrics.form.cancel')}</Button>
+            <Button variant="primary" loading={saving} onClick={save}>
+              {mode === 'create'
+                ? t('biMetrics.form.create')
+                : mode === 'revision' ? t('biMetrics.form.createRevision') : t('biMetrics.form.save')}
+            </Button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/metricsV2/MetricSchemaGraph.tsx b/jiuwenswarm/channels/web/frontend/src/features/metricsV2/MetricSchemaGraph.tsx
new file mode 100644
index 000000000..c0a046e21
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/metricsV2/MetricSchemaGraph.tsx
@@ -0,0 +1,124 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/** 指标图 + schema 关系图的最小可视化（粗糙首版：分层布局，无自动排版库）。
+
+ * 数据源：V2SemanticContext（指标语义 + schema 子图），一层组件不取数。
+ * 分层：指标 → 依赖/概念 → 表 → 列；join/血缘为列间边。
+ * 单节点形态（2026-10-10 收敛）：修订版本/单位作为指标节点徽标展示，
+ * 不再单列「修订」层——边即指标间关系（dependsOn/numerator/denominator）。
+ */
+
+import { useMemo } from 'react';
+import { ReactFlow, Background, Controls, type Edge, type Node } from '@xyflow/react';
+import '@xyflow/react/dist/style.css';
+import type { V2SemanticContext } from './api';
+
+const LAYER_X: Record<string, number> = {
+  metric: 0, dep: 240, table: 480, column: 700,
+};
+const LAYER_COLOR: Record<string, string> = {
+  metric: '#1d4ed8', dep: '#7c3aed', table: '#b45309', column: '#4b5563',
+};
+
+interface GraphNodeSeed {
+  id: string;
+  label: string;
+  layer: keyof typeof LAYER_X;
+  badge?: string;
+}
+
+function buildSeeds(ctx: V2SemanticContext['context']): { seeds: GraphNodeSeed[]; links: [string, string, string][] } {
+  const c = ctx;
+  const seeds: GraphNodeSeed[] = [];
+  const links: [string, string, string][] = [];
+  const metricId = `m:${c.metric_key}`;
+  seeds.push({
+    id: metricId, label: c.label || c.metric_key, layer: 'metric',
+    badge: `${c.metric_key} @${c.revision ?? '?'} · ${c.unit || c.operator || ''}`,
+  });
+  for (const dep of c.dependencies) {
+    const depId = `d:${dep.metric_key}`;
+    seeds.push({ id: depId, label: dep.metric_key, layer: 'dep', badge: dep.roles.join('/') });
+    links.push([metricId, depId, dep.roles.join('/') || 'dependsOn']);
+  }
+  if (c.concept) {
+    const cid = `c:${c.concept}`;
+    // 概念是 Ossie 的 subject_iri（完整 URL），显示取末段（如 …/commerce/Order → Order）
+    const shortLabel = c.concept.split('/').filter(Boolean).pop() || c.concept;
+    seeds.push({ id: cid, label: shortLabel, layer: 'dep', badge: 'concept' });
+    links.push([metricId, cid, 'measuresConcept']);
+  }
+  const schema = c.schema;
+  if (schema) {
+    for (const t of schema.tables) {
+      seeds.push({ id: t.id, label: t.label || t.logical, layer: 'table', badge: 'table' });
+    }
+    for (const col of schema.columns) {
+      seeds.push({ id: col.id, label: col.label || col.logical, layer: 'column', badge: col.logical });
+      const tableId = col.id.replace(':col:', ':tbl:').split('.').slice(0, -1).join('.');
+      const tbl = schema.tables.find((t) => col.logical.startsWith(`${t.logical.split('.').pop()}.`));
+      links.push([col.id, tbl ? tbl.id : tableId, 'belongsTo']);
+    }
+    // 指标 → 其时间/维度/依赖字段所在列（跨图 link 边）
+    const linked = [c.time_field, ...c.group_by_fields,
+      ...c.dependencies.flatMap((d) => d.fields)].filter(Boolean) as string[];
+    for (const logical of linked) {
+      const col = schema.columns.find((x) => x.logical === logical);
+      if (col) links.push([metricId, col.id, 'usesField']);
+    }
+    for (const j of schema.joins) {
+      links.push([j.left, j.right, j.verified ? j.kind : `${j.kind}?`]);
+    }
+    for (const l of schema.lineage) {
+      links.push([l.right, l.left, 'derivedFrom']);
+    }
+  }
+  const seen = new Set<string>();
+  return { seeds: seeds.filter((s) => (seen.has(s.id) ? false : (seen.add(s.id), true))), links };
+}
+
+export function MetricSchemaGraph({ ctx }: { ctx: V2SemanticContext }) {
+  const { nodes, edges } = useMemo(() => {
+    const { seeds, links } = buildSeeds(ctx.context);
+    const perLayer: Record<string, number> = {};
+    const flowNodes: Node[] = seeds.map((s) => {
+      const idx = perLayer[s.layer] ?? 0;
+      perLayer[s.layer] = idx + 1;
+      return {
+        id: s.id,
+        position: { x: LAYER_X[s.layer], y: idx * 64 },
+        data: { label: `${s.label}${s.badge ? ` [${s.badge}]` : ''}` },
+        style: {
+          border: `2px solid ${LAYER_COLOR[s.layer]}`,
+          borderRadius: 6, padding: '4px 8px', fontSize: 11,
+          // 主题 token：深浅主题/深色渲染下都跟随界面而不是白补丁
+          background: 'var(--color-surface-card, #fff)',
+          color: 'var(--color-text-primary, inherit)',
+          maxWidth: 220,
+        },
+      };
+    });
+    const ids = new Set(seeds.map((s) => s.id));
+    const flowEdges: Edge[] = links
+      .filter(([from, to]) => ids.has(from) && ids.has(to))
+      .map(([from, to, label], i) => ({
+        id: `e${i}`, source: from, target: to, label,
+        style: { fontSize: 9 },
+        markerEnd: { type: 'arrowclosed' as never, width: 12, height: 12 },
+      }));
+    return { nodes: flowNodes, edges: flowEdges };
+  }, [ctx]);
+
+  return (
+    <div style={{
+      height: 420, borderRadius: 6,
+      border: '1px solid var(--color-border-default, #e5e7eb)',
+      background: 'var(--color-surface-muted, #fafafa)',
+    }}>
+      <ReactFlow nodes={nodes} edges={edges} fitView proOptions={{ hideAttribution: true }}
+        nodesConnectable={false}>
+        <Background />
+        <Controls showInteractive={false} />
+      </ReactFlow>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/metricsV2/MetricsTab.tsx b/jiuwenswarm/channels/web/frontend/src/features/metricsV2/MetricsTab.tsx
