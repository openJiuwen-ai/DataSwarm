-  "$PROJECT_ROOT/scripts/build_config.py" --sync --emit-shell)"
-eval "$BUILD_CONFIG_SHELL"
-
-APP_NAME="$BUILD_APP_BUNDLE_NAME"
-APP_PATH="$PROJECT_ROOT/dist/$APP_NAME"
