@@ -0,0 +1,210 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/result_check.py —— 执行后结果检查（执行 → manifest 之间）。
+
+检查项（方案：列/类型、单位/粒度、分组键唯一性、join 放大、时间覆盖、
+空结果与截断）：关键检查失败返回数据问题，不产出业务归因。
+
+口径：
+- ``empty_result`` / ``truncated``：事实陈述（fail 表示空结果需人工裁决）
+- ``group_key_uniqueness``：preview 行的分组键组合唯一（GROUP BY 输出语义）
+- ``time_coverage``：有计划时间时核对结果时间边界落在计划窗内
+- ``join_amplification``：以 published 快照的表行数（``TableMeta.row_count``）
+  为基线——结果行数超过参与表最大行数 3 倍记嫌疑（FK join 合法上界约为
+  驱动表行数，3 倍余量防误报）；基线缺失记 unknown（不猜）
+"""
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from .model import CHECK_FAIL, CHECK_PASS, CHECK_UNKNOWN, CheckResult
+
+PREVIEW_ROW_CAP = 20
+JOIN_AMPLIFICATION_FACTOR = 3
+
+# 日期形：YYYY-MM / YYYY-MM-DD / 日期时间前缀（full-v7-1028 实证两类假红——
+# 'YYYY-MM' 与 'YYYY-MM-01' 字典序不可比、13 位纯数字 ID 被当时间值判越界）
+_TIME_VALUE_RE = re.compile(r"^(\d{4})-(\d{1,2})(?:-(\d{1,2}))?")
+
+
+def _normalize_time_value(value: Any) -> str | None:
+    """日期形字符串归一到 YYYY-MM-DD（缺日补 01）；非日期形返回 None。
+
+    归一后同为 YYYY-MM-DD 形态才可安全字典序比较；纯数字 ID、非日期值返回
+    None 交由调用方记 unknown（不猜、不判越界）。
+    """
+    match = _TIME_VALUE_RE.match(str(value).strip())
+    if not match:
+        return None
+    year, month, day = match.group(1), int(match.group(2)), match.group(3)
+    day_num = int(day) if day else 1
+    if not (1 <= month <= 12 and 1 <= day_num <= 31):
+        return None
+    return f"{year}-{month:02d}-{day_num:02d}"
+
+
+def run_result_checks(body: dict[str, Any],
+                      *, table_baselines: dict[str, int] | None = None) -> dict[str, Any]:
+    """结果检查（result-check 端点入口；曾名 check_request，与 checks 入口消歧）。
+
+    Args:
+        body: ``{"component_id"?, "sql", "columns"?, "row_count", "truncated",
+        "preview_rows"?≤20, "time"?{start, end_exclusive}, "unit"?}``。
+        table_baselines: ``{表名: 行数}`` 基线（published 快照 ``TableMeta.row_count``）；
+            缺省 None 时 join_amplification 记 unknown（纯函数兼容形态）。
+
+    Returns:
+        ``{"checks": [{name, status, detail}], "row_count", "truncated"}``。
+    """
+    sql = str(body.get("sql") or "")
+    row_count = int(body.get("row_count") or 0)
+    truncated = bool(body.get("truncated"))
+    preview_rows = [row for row in (body.get("preview_rows") or ())[:PREVIEW_ROW_CAP]
+                    if isinstance(row, dict)]
+    plan_time = body.get("time") if isinstance(body.get("time"), dict) else None
+
+    checks: list[CheckResult] = []
+
+    # 空结果：不是错误但是数据问题信号（上游应交澄清或部分结果，不归因）
+    if row_count == 0:
+        checks.append(CheckResult("empty_result", CHECK_FAIL,
+                                  "结果集为空——请核对过滤条件与时间窗，不要产出业务归因"))
+    else:
+        checks.append(CheckResult("empty_result", CHECK_PASS, f"{row_count} 行"))
+
+    checks.append(CheckResult(
+        "truncated", CHECK_FAIL if truncated else CHECK_PASS,
+        "结果被截断——下游统计不可作为总量口径" if truncated else ""))
+
+    # 分组键唯一性：GROUP BY 存在时 preview 的分组键组合应唯一
+    checks.append(_check_group_key_uniqueness(sql, preview_rows))
+
+    # 时间覆盖：结果时间值应落在计划窗内（能取到时间列才可验）
+    checks.append(_check_time_coverage(preview_rows, plan_time))
+
+    # join 放大：快照表行数基线（Phase 5 自恒 unknown 升级）
+    checks.append(_check_join_amplification(sql, row_count, table_baselines))
+
+    return {
+        "component_id": str(body.get("component_id") or ""),
+        "checks": [c.to_dict() for c in checks],
+        "row_count": row_count,
+        "truncated": truncated,
+    }
+
+
+def _check_join_amplification(sql: str, row_count: int,
+                              baselines: dict[str, int] | None) -> CheckResult:
+    """join 放大：结果行数对参与表行数基线的量级核对。
+
+    无 join 不适用；参与表缺行数基线记 unknown（不猜）；结果行数超参与表
+    最大行数 ``JOIN_AMPLIFICATION_FACTOR`` 倍记嫌疑（fail 是「需要人工核
+    对」的信号，不是定罪——多对多 join 可合法超界）。
+    """
+    import sqlglot
+    from sqlglot import exp
+
+    try:
+        parsed = sqlglot.parse_one(sql, read="mysql") if sql else None
+    except Exception:  # noqa: BLE001 —— 解析失败：无法定位 join 表，不猜
+        parsed = None
+    if parsed is None or not list(parsed.find_all(exp.Join)):
+        return CheckResult("join_amplification", CHECK_PASS, "无 join（不适用）")
+    joined_tables = {table.name for table in parsed.find_all(exp.Table)}
+    if not baselines:
+        return CheckResult("join_amplification", CHECK_UNKNOWN,
+                           "无表行数基线（快照未采集），join 放大检查不适用"
+                           "（结果异常时人工核对行数量级）")
+    known = {name: rows for name, rows in baselines.items()
+             if isinstance(rows, int) and rows > 0 and name in joined_tables}
+    if not known:
+        return CheckResult("join_amplification", CHECK_UNKNOWN,
+                           f"参与 join 的表缺行数基线: {sorted(joined_tables)}")
+    largest, largest_rows = max(known.items(), key=lambda kv: kv[1])
+    threshold = largest_rows * JOIN_AMPLIFICATION_FACTOR
+    if row_count > threshold:
+        return CheckResult(
+            "join_amplification", CHECK_FAIL,
+            f"join 放大嫌疑：结果 {row_count} 行 > 最大参与表 {largest}"
+            f"（{largest_rows} 行）×{JOIN_AMPLIFICATION_FACTOR}——核对 join 键"
+            "是否唯一（fanout）或口径是否应聚合")
+    return CheckResult("join_amplification", CHECK_PASS,
+                       f"{row_count} 行 ≤ 最大参与表 {largest}（{largest_rows} 行）"
+                       f"×{JOIN_AMPLIFICATION_FACTOR}")
+
+
+def _check_group_key_uniqueness(sql: str, preview_rows: list[dict[str, Any]]) -> CheckResult:
+    """GROUP BY 输出的分组键组合在 preview 内应唯一。"""
+    import sqlglot
+    from sqlglot import exp
+
+    try:
+        parsed = sqlglot.parse_one(sql, read="mysql") if sql else None
+    except Exception:  # noqa: BLE001 —— SQL 解析失败：无 SQL 时按列名近似
+        parsed = None
+    group_columns: list[str] = []
+    if parsed is not None:
+        for group in parsed.find_all(exp.Group):
+            for column in group.find_all(exp.Column):
+                group_columns.append(column.name)
+    if not group_columns:
+        return CheckResult("group_key_uniqueness", CHECK_UNKNOWN, "SQL 无 GROUP BY")
+    if any(not all(column in row for column in group_columns) for row in preview_rows):
+        return CheckResult("group_key_uniqueness", CHECK_UNKNOWN,
+                           "结果输出不包含全部 GROUP BY 原始列（可能使用表达式/别名），无法验证唯一性")
+    if len(preview_rows) < 2:
+        return CheckResult("group_key_uniqueness", CHECK_PASS, "样本不足（<2 行）跳过")
+    seen: set[tuple] = set()
+    for row in preview_rows:
+        key = tuple(str(row.get(column) or "") for column in group_columns)
+        if key in seen:
+            return CheckResult("group_key_uniqueness", CHECK_FAIL,
+                               f"分组键 {'/'.join(group_columns)} 组合重复——join 可能放大或键选取错误")
+        seen.add(key)
+    return CheckResult("group_key_uniqueness", CHECK_PASS, "")
+
+
+def _check_time_coverage(
+    preview_rows: list[dict[str, Any]], plan_time: dict[str, Any] | None,
+) -> CheckResult:
+    """结果时间值落在计划窗 [start, end_exclusive) 内（时间列可定位才验）。"""
+    if not plan_time:
+        return CheckResult("time_coverage", CHECK_UNKNOWN, "无计划时间窗")
+    start, end = str(plan_time.get("start") or ""), str(plan_time.get("end_exclusive") or "")
+    if not (start and end):
+        return CheckResult("time_coverage", CHECK_UNKNOWN, "计划时间窗不完整")
+    time_column = str(plan_time.get("dimension") or "").split(".")[-1]
+    if not time_column:
+        return CheckResult("time_coverage", CHECK_UNKNOWN, "计划未声明时间维度")
+    time_values: list[str] = []
+    for row in preview_rows:
+        for key, value in row.items():
+            if str(key).lower() == time_column.lower() and value is not None:
+                time_values.append(str(value))
+                break
+    if not time_values:
+        return CheckResult("time_coverage", CHECK_UNKNOWN,
+                           f"结果中定位不到时间列 {time_column}")
+    start_norm, end_norm = _normalize_time_value(start), _normalize_time_value(end)
+    normalized: list[str] = []
+    skipped: list[str] = []
+    for value in time_values:
+        norm = _normalize_time_value(value)
+        if norm is None:
+            skipped.append(value)
+        else:
+            normalized.append(norm)
+    if not (start_norm and end_norm):
+        return CheckResult("time_coverage", CHECK_UNKNOWN, "计划时间窗非日期形")
+    if not normalized:
+        # 全部值非日期形（如把 ID 列当时间维）：无法判定窗口，不判越界
+        return CheckResult("time_coverage", CHECK_UNKNOWN,
+                           f"时间列 {time_column} 值非日期形（如 {skipped[:2]}），无法判定窗口")
+    out_of_window = [v for v in normalized if not (start_norm <= v < end_norm)]
+    if out_of_window:
+        return CheckResult("time_coverage", CHECK_FAIL,
+                           f"时间值越出计划窗 [{start}, {end}): {out_of_window[:3]}")
+    note = f"{len(normalized)} 个时间值在窗内"
+    if skipped:
+        note += f"（{len(skipped)} 个非日期形值跳过）"
+    return CheckResult("time_coverage", CHECK_PASS, note)
