+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { createContext } from 'react';
+import { useTranslation } from 'react-i18next';
+import './WorkflowPreview.css';
+
+export const WorkflowPreviewContext = createContext<((url: string) => void) | null>(null);
+
+export function WorkflowPreview({ url }: { url: string }) {
+  const { t } = useTranslation();
+  return (
+    <div className="workflow-preview" aria-label={t('workflowRun.title')} data-testid="workflow-preview">
