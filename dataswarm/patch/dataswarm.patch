+
+
+@dataclass
+class _Step:
+    name: str
+    ms: float
+    note: str = ""
+
+
+_STEPS: list[_Step] = []
+
+
+def _step(name: str) -> float:
+    _STEPS.append(_Step(name, 0.0))
