@@ -0,0 +1,105 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useRef } from 'react';
+import * as echarts from 'echarts';
+
+/**
+ * ECharts 通用封装。
+ *
+ * 工程约束（plan §9）：
+ *   - dispose：组件卸载必须 dispose，否则内存泄漏。
+ *   - resize：ResizeObserver 监听容器尺寸变化，图表自适应。
+ *   - onEvents：支持外部绑定 chart 事件（click/dblclick 等），供 DAG 页做
+ *     「点节点高亮上下游 + 触发追溯链」交互（plan §4.2/§4.3）。
+ *
+ * 事件 key 为 ECharts 事件名（如 'click'），value 为回调，收到 echarts 透传的 params。
+ *
+ * 性能：只在挂载时 init 一次，option 变化走 setOption（notMerge=true 合并更新），
+ *   不重建 chart —— 避免 graph 图重新布局导致节点位置闪烁、roam 视图重置。
+ *   onEvents 用 ref 稳定，不进 effect 依赖，避免父组件重渲染时频繁重建。
+ */
+export type EChartEventMap = Record<string, (params: unknown) => void>;
+
+function normalizeOption(option: echarts.EChartsOption | string): echarts.EChartsOption | null {
+  if (typeof option !== 'string') return option;
+
+  try {
+    return JSON.parse(option) as echarts.EChartsOption;
+  } catch {
+    return null;
+  }
+}
+
+export function EChart({
+  option,
+  ariaLabel,
+  height = 360,
+  onEvents,
+}: {
+  option: echarts.EChartsOption | string;
+  ariaLabel: string;
+  height?: number;
+  onEvents?: EChartEventMap;
+}) {
+  const ref = useRef<HTMLDivElement>(null);
+  const chartRef = useRef<echarts.ECharts | null>(null);
+  // onEvents 放 ref，effect 不依赖它，避免每次渲染新对象触发重建。
+  const onEventsRef = useRef(onEvents);
+  onEventsRef.current = onEvents;
+
+  // 挂载时 init 一次 + resize 监听；卸载时 dispose。
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    const chart = echarts.init(el);
+    chartRef.current = chart;
+    const observer = new ResizeObserver(() => chart.resize());
+    observer.observe(el);
+    return () => {
+      observer.disconnect();
+      chart.dispose();
+      chartRef.current = null;
+    };
+  }, []);
+
+  // option 变化：只 setOption，不重建 chart。
+  useEffect(() => {
+    const chart = chartRef.current;
+    const normalizedOption = normalizeOption(option);
+    if (!chart || !normalizedOption) return;
+    const aria = normalizedOption.aria ?? {};
+    chart.setOption(
+      {
+        ...normalizedOption,
+        aria: {
+          ...aria,
+          enabled: true,
+          label: {
+            ...aria.label,
+            enabled: true,
+            description: ariaLabel,
+          },
+        },
+      },
+      true,
+    );
+  }, [ariaLabel, option]);
+
+  // onEvents 变化：重新绑定（off 旧 handler 再 on 新的）。
+  useEffect(() => {
+    const chart = chartRef.current;
+    if (!chart) return;
+    // chart 初始化时还没有 onEvents，这里统一绑定：每次 onEvents 变更先 clear 再绑。
+    // echarts 没有按 handler off 的 API，用 off(event) 清掉该事件全部再 on 新的。
+    const events = Object.keys(onEvents ?? {});
+    for (const eventName of events) {
+      chart.off(eventName);
+    }
+    const handlers = onEventsRef.current ?? {};
+    for (const eventName of events) {
+      const handler = handlers[eventName];
+      if (handler) chart.on(eventName, (params: unknown) => handler(params));
+    }
+  }, [onEvents]);
+
+  return <div ref={ref} style={{ height }} className="w-full" />;
+}
