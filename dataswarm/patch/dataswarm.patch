+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""knowledge/selection._time 的 naive 语义守门（时区策略统一 Phase 2.8）。
+
+2026-10-27 起 naive 按本地时区解释（与全仓 timeutil 契约一致）；此前按 UTC，
+与仓库主流约定相反。该语义决定 scope.valid_from / valid_to 的有效期判定边界。
+"""
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+
+from jiuwenswarm.channels.web.dataagent.knowledge.selection import _time
+
+TZ_PLUS_8 = timezone(timedelta(hours=8))
+
+
+def test_naive_interpreted_as_local():
+    assert _time("2026-10-27T12:00:00") == datetime(2026, 10, 27, 12, 0, 0).astimezone()
+
+
+def test_aware_passthrough_with_colon_and_z():
+    assert _time("2026-10-27T12:00:00+08:00") == datetime(2026, 10, 27, 12, 0, 0, tzinfo=TZ_PLUS_8)
+    assert _time("2026-10-27T04:00:00Z") == datetime(2026, 10, 27, 4, 0, 0, tzinfo=timezone.utc)
diff --git a/tests/unit_tests/dataagent/test_local_acceptance_prerequisites.py b/tests/unit_tests/dataagent/test_local_acceptance_prerequisites.py
