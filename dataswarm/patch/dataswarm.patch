+# 内置类型
+# ==========================================================================
+def _validate_db_fields(params: dict) -> None:
+    errors: list[str] = []
+    for key in ("host", "database"):
+        if not str(params.get(key, "")).strip():
+            errors.append(f"{key} is required")
+    try:
+        port = int(params.get("port") or 0)
+        if not (1 <= port <= 65535):
+            errors.append("port must be 1-65535")
+    except (TypeError, ValueError):
+        errors.append("port must be an integer")
+    if errors:
+        raise ValueError("; ".join(errors))
+
+
+def _validate_optional_port(params: dict, key: str) -> None:
+    """可选端口字段：留空合法；填了必须是 1-65535 整数（如 be_http_port）。"""
+    raw = params.get(key)
+    if raw is None or str(raw).strip() == "":
+        return
+    try:
+        port = int(raw)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{key} must be an integer") from exc
+    if not (1 <= port <= 65535):
+        raise ValueError(f"{key} must be 1-65535")
+
+
+#: 文件源 location 允许的 scheme。DuckDB httpfs 能直读 http(s)，但那是任意
+#: URL 取回——不在白名单内，避免把数据源表单变成 SSRF 入口。
+_FILE_LOCATION_SCHEMES = ("s3://", "s3a://", "oss://", "gs://")
+
+_METADATA_HOSTS = {"metadata.google.internal", "metadata", "instance-data"}
+
+
+def _validate_file_location(location: str, type_id: str) -> None:
+    """校验文件源 location：对象存储 URI 放行，本地路径走受控根目录。"""
+    lowered = location.lower()
+    if lowered.startswith(_FILE_LOCATION_SCHEMES):
+        return
+    if "://" in location:
+        raise ValueError(
+            f"{type_id} location 只支持本地路径或 "
+            f"{'/'.join(s.rstrip(':/') for s in _FILE_LOCATION_SCHEMES)} URI"
+        )
+    from ..connectors.paths import resolve_local_path
+
+    try:
+        resolve_local_path(location, must_exist=False)
+    except Exception as exc:
+        raise ValueError(str(exc)) from exc
+
+
+def _validate_object_store_endpoint(endpoint: str, *, allow_loopback: bool = False) -> None:
+    """S3 / MinIO 可显式指定回环端点。其他非公网地址和云元数据仍不可用。
+
+    此检查不解析 DNS，不能阻止公网域名解析到私网地址；部署侧仍需出网策略。
+    """
+    raw = str(endpoint or "").strip()
+    if not raw:
+        return
+    # DuckDB expects an authority, never userinfo, an arbitrary URL path or query.
+    authority = re.fullmatch(
+        r"(?:(?:http|https)://)?(?P<host>\[[0-9a-f:.]+\]|[\w.-]+)(?::(?P<port>[0-9]{1,5}))?/?",
+        raw, re.IGNORECASE | re.ASCII,
+    )
+    if not authority or (authority["port"] and not 1 <= int(authority["port"]) <= 65535):
+        raise ValueError("endpoint 必须为主机及可选端口，可使用 http:// 或 https://")
+    host = authority["host"].strip("[]").lower().rstrip(".")
+    if not host or host in _METADATA_HOSTS:
+        raise ValueError("endpoint 不能指向空主机或元数据地址")
+    if host == "localhost":
+        if not allow_loopback:
+            raise ValueError("endpoint 不能指向本机")
+        return
+    try:
+        address = ipaddress.ip_address(host)
+    except ValueError:
+        if authority["host"].startswith("["):
+            raise ValueError("endpoint IPv6 地址格式无效") from None
+        # Some clients resolve legacy numeric forms (e.g. 127.1 or 0xa9fea9fe)
+        # as IP literals. Require the canonical dotted form instead.
+        try:
+            socket.inet_aton(host)
+        except OSError:
+            return  # DNS name; DNS resolution is subject to deployment egress rules.
+        raise ValueError("endpoint IP 地址格式无效") from None
+    if allow_loopback and address.is_loopback:
+        return
+    if not address.is_global or address.is_multicast:
+        raise ValueError(f"endpoint 不能指向回环/私网/元数据地址: {host}")
+
