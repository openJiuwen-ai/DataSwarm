@@ -0,0 +1,99 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 工作流行内迷你 DAG 缩略图（签名元素）：80×36 SVG，节点=组色小方块，边=1px 灰线。
+// 挂载时懒取工作流节点 + 最近一次实例的 task_runs（模块级缓存，避免列表重渲染重复请求）；
+// 有运行数据时节点按运行态六色着色——列表即监控屏。
+
+import { useEffect, useState } from 'react';
+import { orchestrationApi } from '../../api/orchestrationApi';
+import type { NodeInput, TaskRun } from '../../types/orchestration';
+import { buildGroupColorMap, miniLayout, parseUpstream } from './dagLayout';
+
+const W = 88;
+const H = 36;
+const GAP_X = 22;
+const GAP_Y = 14;
+const NODE = 6;
+
+// 模块级缓存：workflow_id → { nodes, runs }（列表页反复进出不重复请求）
+const cache = new Map<string, { nodes: NodeInput[]; runs: TaskRun[] }>();
+
+export function MiniDag({ workflowId }: { workflowId: string }) {
+  const [data, setData] = useState<{ nodes: NodeInput[]; runs: TaskRun[] } | null>(() => cache.get(workflowId) ?? null);
+
+  useEffect(() => {
+    if (cache.has(workflowId)) {
+      setData(cache.get(workflowId)!);
+      return;
+    }
+    let alive = true;
+    (async () => {
+      try {
+        const wf = await orchestrationApi.getWorkflow(workflowId);
+        const nodes: NodeInput[] = (wf.nodes ?? []).map((n) => ({
+          node_id: n.node_id, task_id: n.task_id, group_name: n.group_name ?? '', node_name: n.node_name ?? '',
+          upstream_nodes: n.upstream_nodes, wait_review: !!n.wait_review, order_index: n.order_index,
+        }));
+        let runs: TaskRun[] = [];
+        const instPage = await orchestrationApi.listInstances({ ref_type: 'workflow', ref_id: workflowId, limit: 1, offset: 0 });
+        const last = instPage.instances[0];
+        if (last) {
+          const r = await orchestrationApi.listTaskRuns(last.instance_id);
+          runs = r.task_runs ?? [];
+        }
+        if (!alive) return;
+        cache.set(workflowId, { nodes, runs });
+        setData({ nodes, runs });
+      } catch {
+        /* 缩略图失败保持空白态，不打断列表 */
+      }
+    })();
+    return () => { alive = false; };
+  }, [workflowId]);
+
+  if (!data || data.nodes.length === 0) {
+    return <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} aria-label="工作流结构图" />;
+  }
+
+  const { nodes, runs } = data;
+  const groupColors = buildGroupColorMap(nodes);
+  const pos = miniLayout(nodes, GAP_X, GAP_Y);
+  const runByNode: Record<string, string> = {};
+  runs.forEach((r) => { if (r.node_id) runByNode[r.node_id] = r.status; });
+  const RUN_COLOR: Record<string, string> = {
+    queued: 'var(--color-feedback-queued)',
+    running: 'var(--color-feedback-running)',
+    success: 'var(--color-feedback-success)',
+    failed: 'var(--color-feedback-danger)',
+    waiting_review: 'var(--color-feedback-waiting-review)',
+    skipped: 'var(--color-text-tertiary)',
+  };
+
+  const edges = nodes.flatMap((n) =>
+    parseUpstream(n.upstream_nodes)
+      .filter((u) => pos[u] && pos[n.node_id!])
+      .map((u) => ({ x1: pos[u].x + NODE / 2, y1: pos[u].y + NODE / 2, x2: pos[n.node_id!].x + NODE / 2, y2: pos[n.node_id!].y + NODE / 2 })),
+  );
+
+  return (
+    <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`工作流结构：${nodes.length} 个节点`} className="shrink-0">
+      {edges.map((e, i) => (
+        <line key={i} x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="var(--color-border-strong)" strokeWidth={1} />
+      ))}
+      {nodes.map((n) => {
+        const p = pos[n.node_id!];
+        const runStatus = runByNode[n.node_id!];
+        return (
+          <rect
+            key={n.node_id}
+            x={p.x}
+            y={p.y}
+            width={NODE}
+            height={NODE}
+            rx={1.5}
+            fill={runStatus ? (RUN_COLOR[runStatus] ?? groupColors[n.group_name || '默认组']) : (groupColors[n.group_name || '默认组'] ?? 'var(--color-text-tertiary)')}
+          />
+        );
+      })}
+    </svg>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/shared/RowMenu.tsx b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/shared/RowMenu.tsx
