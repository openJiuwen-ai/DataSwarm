+    labels = [hit.label for hit in road.hits]
+    assert "north" in labels and "圣保罗" in labels  # 双通道并存
+    vec_hit = next(h for h in road.hits if h.label == "圣保罗")
+    assert dict(vec_hit.channels)["vector"] == 0.72
+    assert vec_hit.payload["column_id"] == "col:orders.state"
+    assert road.channel_status == "ok"
