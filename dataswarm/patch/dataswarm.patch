+        logger.error(f"kb_search failed: {e}")
+        return {"results": [], "error": str(e)}
+
+
+@tool(
+    name="kb_delete_documents",
+    description="按 doc_id 删除知识库内的文档（含其全部 chunk）。doc_id 从 kb_list_entries 或入库返回值获取。kb_id 省略时取默认知识库。",
+)
+async def kb_delete_documents(
+    doc_ids: List[str],
+    kb_id: Optional[str] = None,
+) -> Dict[str, Any]:
+    """从知识库删除文档。
+
+    Args:
+        doc_ids: 要删除的文档 ID 列表（来自 kb_list_entries 或入库结果）
+        kb_id: 知识库 ID（省略时取默认）
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    if not doc_ids:
+        return {"success": False, "error": "doc_ids must be a non-empty list"}
+    try:
+        return await manager.delete_documents(doc_ids, kb_id=kb_id)
+    except Exception as e:
+        logger.error(f"kb_delete_documents failed: {e}")
+        return {"success": False, "error": str(e)}
+
+
+@tool(
+    name="kb_delete",
+    description="删除整个知识库（注册信息 + 向量数据）。默认知识库不允许删除；只清内容请用 kb_delete_documents。需与用户确认后调用。",
+)
+async def kb_delete(kb_id: str) -> Dict[str, Any]:
+    """删除一个知识库。
+
+    Args:
+        kb_id: 要删除的知识库 ID（默认知识库不可删）
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    if not kb_id:
+        return {"success": False, "error": "kb_id is required"}
+    try:
+        return await manager.delete_kb(kb_id)
+    except Exception as e:
+        logger.error(f"kb_delete failed: {e}")
+        return {"success": False, "error": str(e)}
+
+
+def get_decorated_tools() -> List:
+    """获取使用 @tool 装饰器的知识库工具列表。"""
+    return [
