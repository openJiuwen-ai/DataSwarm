+
+def test_duckdb_csv_directory_view_name_fallback_and_conflict(tmp_path, monkeypatch):
+    pytest.importorskip("duckdb", reason="DuckDB is not installed")
+    source = _csv_dir_source(
+        tmp_path, monkeypatch,
+        {"订单.csv": "id\n1\n", "123bad.csv": "id\n2\n"},
+    )
+    # 中文 stem 与数字开头 stem 清洗后都回退 data，冲突加 _2（sorted 顺序稳定）
+    catalog = DuckDBConnector(source).catalog()
+    assert [d["name"] for d in catalog["datasets"]] == ["data", "data_2"]
