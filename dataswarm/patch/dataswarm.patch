+    async def _collect_entries(
+        self,
+        kb_id: str,
+        keyword: Optional[str] = None,
+        top: Optional[int] = None,
+    ) -> List[Dict[str, Any]]:
+        """Group chunks by doc_id using the Chroma collection's raw get()."""
+        if kb_id not in self._kbs:
+            return []
+        try:
+            kb = self._kbs[kb_id]
+            collection = kb.vector_store.collection
+            # Fetch all chunk metadata (id + metadata) without embeddings.
+            got = collection.get(include=["metadatas"])
+            ids = got.get("ids") or []
+            metas = got.get("metadatas") or []
+            # Aggregate by doc_id.
+            by_doc: Dict[str, Dict[str, Any]] = {}
+            for cid, meta in zip(ids, metas):
+                meta = meta or {}
