+def start_run(data: dict, adapter: SemanticaAdapter | None = None, synchronous: bool = False) -> dict:
+    """Create a collection run and execute it asynchronously by default."""
+    source_id = str(data.get("source_id") or "").strip()
+    if not source_id:
+        raise ValueError("source_id is required")
+    workspace_id = workspace_context.current_workspace().workspace_id
+    source = _authorized_source(source_id, workspace_id)
+    if not source or not source.get("enabled", True):
+        raise ValueError("source_not_available")
+    metadata_adapter_for(source)  # Validate declared capabilities before creating a run; no source I/O.
+    schemas = tuple(str(item).strip() for item in data.get("schemas", []) if str(item).strip())
+    if len(schemas) > 3:
+        raise ValueError("semantic collection supports at most 3 schemas per run")
+    options = CollectionOptions(
+        schemas=schemas,
+        include_profile=bool(data.get("include_profile", True)),
+        profile_max_columns_per_table=max(0, min(int(data.get("profile_max_columns_per_table", 20)), 100)),
+        profile_top_k=max(0, min(int(data.get("profile_top_k", 10)), 50)),
+        profile_sample_rows=max(100, min(int(data.get("profile_sample_rows", 10000)), 100000)),
+        core_tables=tuple(str(item) for item in data.get("core_tables", [])),
+    )
+    run_id = str(data.get("run_id") or f"semantic-run-{uuid.uuid4().hex}")
+    with _running_lock:
+        key = (workspace_id, source_id)
+        existing = _running_sources.get(key)
+        if existing:
+            return repository.get_run(existing) or {"run_id": existing, "status": "running"}
+        _running_sources[key] = run_id
+    try:
+        repository.create_run(run_id, source_id, str(data.get("trigger_type") or "manual"),
+                              {"schemas": list(schemas), "source_type": source.get("source_type")})
+        if synchronous:
+            _execute(workspace_id, source, run_id, options, adapter)
+        else:
+            thread = threading.Thread(
+                target=_execute,
+                args=(workspace_id, source, run_id, options, adapter),
+                name=f"semantic-{source_id}",
+                daemon=True,
+            )
+            thread.start()
+    except Exception:
+        with _running_lock:
+            _running_sources.pop(key, None)
+        raise
+    return get_run(run_id) or {"run_id": run_id, "status": "queued"}
