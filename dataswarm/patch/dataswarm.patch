+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Knowledge base tools for JiuWenSwarm - Using @tool decorator for openjiuwen.
+
+Mirrors ``memory_tools.py``: a global :class:`KnowledgeBaseManager` is
+initialized once per workspace; ``@tool`` functions expose list / create /
+get / update / list-entries / upload-file / attach-dir / search / delete
+operations on local ChromaDB-backed knowledge bases.
+
+每个 ``kb_*`` 工具按「当前请求绑定的 KB 工作空间」取 manager：
+
+- 项目会话在 chat 入口（``_bind_runtime_kb_context``）把项目专属工作空间
+  绑进 ContextVar（与 cron route / shell session 同款按 Task 隔离模式）；
+- 未绑定的会话回退全局 agent workspace（存量 ``biz_kb`` 行为不变）。
+- ``KnowledgeBaseManager.get`` 按 workspace_dir 做进程级单例缓存，
+  不同项目天然拿到不同 manager，各自的 registry 相互隔离。
+"""
+
+import contextvars
+import logging
+import os
+import threading
+from collections import OrderedDict
+from typing import Any, Dict, List, Optional
+
+from openjiuwen.core.foundation.tool.tool import tool
+
+from ..knowledge_base import (
+    KnowledgeBaseManager,
+    is_kb_enabled,
+)
+
+logger = logging.getLogger(__name__)
+
+# 当前请求绑定的 KB 工作空间（ContextVar，按 asyncio Task 隔离）。
+# 值为 None 表示未绑定，工具回退全局 agent workspace。
+#
+# 注意：DeepAgent 的 interaction supervisor 在请求 Task 之外执行工具，
+# 请求入口 set 的 ContextVar 传不到工具执行上下文（与 cron / model 选择
+# 同款问题）。因此 bind 同时写入 sticky 槽位，工具侧 ContextVar 取不到
+# 时回退 sticky 值——单用户串行场景下即当前请求的绑定（对齐
+# interface_deep._RuntimeCronToolContext 的处理方式）。
+_KB_WORKSPACE_DIR: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar(
+    "jiuwenswarm_kb_workspace_dir", default=None
+)
+_KB_WORKSPACE_SESSION_ID: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar(
+    "jiuwenswarm_kb_workspace_session_id", default=None
+)
+_KB_BINDING_INVALID: contextvars.ContextVar[bool] = contextvars.ContextVar(
+    "jiuwenswarm_kb_binding_invalid", default=False
+)
+
+# Globals set by init_kb_manager_async / set_global_kb_manager.
+_global_kb_manager: Optional[KnowledgeBaseManager] = None
+_global_workspace_dir: str = "."
+_global_agent_id: str = "default"
+
+
+class _StickyKBWorkspace:
+    """按 session 键控的进程级绑定，供 supervisor 工具 Task 恢复。
+
+    ContextVar 无法跨越 interaction supervisor 的任务边界到达工具执行，
+    因此工具侧按当前 session id 查询本映射；不同并发会话绝不共享一个
+    “最近请求”槽位。
+    """
+
+    # Keyed by session id; a process-wide last-request value is unsafe because
+    # supervisor tasks for concurrent sessions do not share ContextVars.
+    # Supervisor callbacks may outlive the request task, so bindings cannot be
+    # removed at request completion. Keep a bounded LRU instead to avoid an
+    # unbounded process-lifetime map while retaining recently active sessions.
+    _MAX_SESSIONS = 1024
+    _values: OrderedDict[str, Optional[str]] = OrderedDict()
+    _invalid_sessions: set[str] = set()
+    _legacy_value: Optional[str] = None
+    _bound: bool = False
+    _lock = threading.Lock()
+
+    @classmethod
+    def set(
+        cls, value: Optional[str], session_id: Optional[str] = None, *, invalid: bool = False
+    ) -> None:
+        with cls._lock:
+            if session_id:
+                cls._values[session_id] = value
+                cls._values.move_to_end(session_id)
+                if invalid:
+                    cls._invalid_sessions.add(session_id)
+                else:
+                    cls._invalid_sessions.discard(session_id)
+                while len(cls._values) > cls._MAX_SESSIONS:
+                    stale_session_id, _ = cls._values.popitem(last=False)
+                    cls._invalid_sessions.discard(stale_session_id)
+            else:
+                # Kept only for legacy callers/tests that have no session id;
+                # production adapter calls always provide one.
+                cls._legacy_value = value
+            cls._bound = True
+
+    @classmethod
+    def get(cls, session_id: Optional[str] = None) -> Optional[str]:
+        with cls._lock:
+            if session_id:
+                value = cls._values.get(session_id)
+                if session_id in cls._values:
+                    cls._values.move_to_end(session_id)
+                return value
+            return cls._legacy_value if cls._bound else None
+
+    @classmethod
+    def clear(cls) -> None:
+        with cls._lock:
+            cls._values.clear()
+            cls._invalid_sessions.clear()
+            cls._legacy_value = None
+            cls._bound = False
+
+    @classmethod
+    def is_invalid(cls, session_id: Optional[str]) -> bool:
+        with cls._lock:
+            return bool(session_id and session_id in cls._invalid_sessions)
+
+
+def set_global_kb_manager(
+    manager: Optional[KnowledgeBaseManager],
+    workspace_dir: str = ".",
+    agent_id: str = "default",
+):
+    """Set global KB manager for tool functions."""
+    global _global_kb_manager, _global_workspace_dir, _global_agent_id
+    _global_kb_manager = manager
+    _global_workspace_dir = workspace_dir
+    _global_agent_id = agent_id
+
+
+def bind_kb_workspace(
+    workspace_dir: Optional[str],
+    *,
+    session_id: Optional[str] = None,
+    invalid: bool = False,
+) -> tuple[contextvars.Token, contextvars.Token, contextvars.Token]:
+    """Bind the KB workspace for the current request (chat entry points).
+
+    Pass ``None`` (or an empty string) to fall back to the global agent
+    workspace. Returns a token for :func:`reset_kb_workspace`.
+    """
+    normalized = str(workspace_dir or "").strip() or None
+    sid = str(session_id or "").strip() or None
+    _StickyKBWorkspace.set(normalized, sid, invalid=invalid)
+    return (
+        _KB_WORKSPACE_DIR.set(normalized),
+        _KB_WORKSPACE_SESSION_ID.set(sid),
+        _KB_BINDING_INVALID.set(bool(invalid)),
+    )
+
+
+def reset_kb_workspace(token: contextvars.Token) -> None:
+    """Reset a binding created by :func:`bind_kb_workspace`.
+
+    只清 ContextVar；按 session 键控的映射保留，供 supervisor 延后执行
+    的工具恢复，不会被其他会话的 bind 覆盖。
+    """
+    dir_token, sid_token, invalid_token = token
+    _KB_WORKSPACE_DIR.reset(dir_token)
+    _KB_WORKSPACE_SESSION_ID.reset(sid_token)
+    _KB_BINDING_INVALID.reset(invalid_token)
+
+
+def _current_binding() -> Optional[str]:
+    """当前请求的 KB 绑定：ContextVar 优先，工具上下文取不到时回退 sticky。"""
+    bound = _KB_WORKSPACE_DIR.get()
+    if bound is not None:
+        return bound
+    sid = _KB_WORKSPACE_SESSION_ID.get() or _resolve_current_session_id()
+    if sid:
+        return _StickyKBWorkspace.get(sid)
+    # Legacy callers without a session id retain their old behavior. The
+    # adapter never uses this path, preventing cross-session bleed-through.
+    return _StickyKBWorkspace.get()
+
+
+def _resolve_current_session_id() -> Optional[str]:
+    """Recover the session key inside supervisor-created tool Tasks."""
+    try:
+        from openjiuwen.core.session import get_current_session
+
+        session = get_current_session()
+        if session is not None:
+            sid = str(session.get_session_id() or "").strip()
+            if sid:
+                return sid
+    except Exception:
+        pass
+    try:
+        from openjiuwen.core.sys_operation.shell_process_registry import resolve_shell_session_id
+
+        sid = str(resolve_shell_session_id() or "").strip()
+        return sid or None
+    except Exception:
+        return None
+
+
+def _resolve_manager() -> Optional[KnowledgeBaseManager]:
+    """Return the KB manager for the bound workspace (or the global one).
+
+    A bound project workspace always builds its own manager via the
+    ``KnowledgeBaseManager.get`` singleton cache; the global manager is used
+    when nothing is bound (or the binding equals the global workspace dir, in
+    which case the warmed-up instance is reused).
+    """
+    bound = _current_binding()
+    if not bound or os.path.abspath(bound) == os.path.abspath(_global_workspace_dir or "."):
+        return _global_kb_manager
+    try:
+        return KnowledgeBaseManager.get(workspace_dir=bound)
+    except Exception as e:
+        logger.error(f"Failed to initialize project KB manager for {bound}: {e}")
+        return None
+
+
+async def init_kb_manager_async(
+    workspace_dir: str = ".",
+    agent_id: str = "default",
+) -> Optional[KnowledgeBaseManager]:
+    """Initialize the global knowledge base manager.
+
+    Returns ``None`` (and leaves the tools in ``disabled`` state) when the
+    feature is off in config.yaml or the embedding config is incomplete.
+    """
+    global _global_kb_manager, _global_workspace_dir, _global_agent_id
+
+    if not is_kb_enabled():
+        logger.info("Knowledge base feature is disabled")
+        return None
+
+    if _global_kb_manager is not None and _global_workspace_dir == workspace_dir:
+        return _global_kb_manager
+
+    _global_workspace_dir = workspace_dir
+    _global_agent_id = agent_id
+
+    try:
+        _global_kb_manager = KnowledgeBaseManager.get(workspace_dir=workspace_dir)
+        logger.info(f"Knowledge base manager initialized for: {workspace_dir}")
+        return _global_kb_manager
+    except Exception as e:
+        logger.error(f"Failed to initialize knowledge base manager: {e}")
+        return None
+
+
+async def _ensure_global_manager() -> bool:
+    """Ensure the global KB manager is initialized; True if usable."""
+    global _global_kb_manager, _global_workspace_dir, _global_agent_id
+
+    if _global_kb_manager is not None:
+        return True
+    if not is_kb_enabled():
+        return False
+    try:
+        _global_kb_manager = KnowledgeBaseManager.get(
+            workspace_dir=_global_workspace_dir or ".",
+        )
+        return True
+    except Exception as e:
+        logger.error(f"Failed to initialize knowledge base manager: {e}")
+        return False
+
+
+async def _ensure_manager() -> Optional[KnowledgeBaseManager]:
+    """Ensure a usable manager for the current binding; None when disabled.
+
+    Bound project workspaces always go through the singleton cache; the
+    fallback only warms the global manager when nothing is bound.
+    """
+    sid = _KB_WORKSPACE_SESSION_ID.get() or _resolve_current_session_id()
+    if _KB_BINDING_INVALID.get() or _StickyKBWorkspace.is_invalid(sid):
+        return None
+    bound = _current_binding()
+    if bound and os.path.abspath(bound) != os.path.abspath(_global_workspace_dir or "."):
+        if not is_kb_enabled():
+            return None
+        try:
+            return KnowledgeBaseManager.get(workspace_dir=bound)
+        except Exception as e:
+            logger.error(f"Failed to initialize project KB manager for {bound}: {e}")
+            return None
+    if await _ensure_global_manager():
+        return _global_kb_manager
+    return None
+
+
+def _disabled_result(error: str = "Knowledge base not available") -> Dict[str, Any]:
+    return {"disabled": True, "error": error}
+
+
+def _validate_path_within_workspace(path: str) -> tuple[bool, str]:
+    """Validate a user-supplied path stays within the agent workspace.
+
+    Accepts absolute paths that resolve inside the workspace, or paths that
+    are already under it. Rejects traversal that escapes the workspace root.
+    """
+    if not path:
+        return (False, "empty path")
+    ws = os.path.abspath(_global_workspace_dir or ".")
+    try:
+        resolved = os.path.abspath(path)
+    except Exception as e:
+        return (False, f"invalid path: {e}")
+    # Allow if the resolved path is inside the workspace, OR if the path is
+    # absolute and points to a real file the user explicitly provided (the KB
+    # only reads it; it never writes outside the chroma root). For ingest we
+    # only need read access to the source.
+    try:
+        inside_workspace = os.path.commonpath([ws, resolved]) == ws
+    except ValueError:
+        # commonpath raises ValueError across drives/roots (e.g. C: vs D:).
+        # Treat as outside-workspace; fall through to the existence check.
+        inside_workspace = False
+    if inside_workspace:
+        return (True, resolved)
+    # Outside-workspace absolute paths are allowed only for reading existing
+    # files (so users can ingest documents from anywhere), but we block
+    # obvious traversal attempts against the workspace config dir.
+    if not os.path.exists(resolved):
+        return (False, f"path does not exist: {resolved}")
+    return (True, resolved)
+
+
+# ---------------------------------------------------------------------- #
+# Tools
+# ---------------------------------------------------------------------- #
+@tool(
+    name="kb_list",
+    description="列出所有业务知识库。当用户想知道有哪些知识库、或要切换 KB 时调用。",
+)
+async def kb_list() -> Dict[str, Any]:
+    """列出所有已注册的知识库。
+
+    Returns:
+        知识库列表字典，含 results（kb_id/name/description/tags/created）
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    try:
+        results = await manager.list_kbs()
+        return {"results": results, "count": len(results), "disabled": False}
+    except Exception as e:
+        logger.error(f"kb_list failed: {e}")
+        return _disabled_result(str(e))
+
+
+@tool(
+    name="kb_create",
+    description=(
+        "新建一个业务知识库（kb_id/name/description/tags）。"
+        "kb_id 仅限字母/数字/下划线/中划线（1-64 位），不能与已有知识库重名；"
+        "单库场景直接用默认知识库 biz_kb，无需新建。"
+    ),
+)
+async def kb_create(
+    kb_id: str,
+    name: Optional[str] = None,
+    description: Optional[str] = None,
+    tags: Optional[List[str]] = None,
+) -> Dict[str, Any]:
+    """新建一个知识库（注册元信息；向量目录在首次入库时构建）。
+
+    Args:
+        kb_id: 新知识库 ID（[A-Za-z0-9_-]{1,64}，不可与已有 KB 重名）
+        name: 展示名（省略时取 kb_id）
+        description: 描述
+        tags: 标签列表
+
+    Returns:
+        注册成功的 entry 字典，或 ``success: false`` + ``error``
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    if not kb_id or not str(kb_id).strip():
+        return {"success": False, "error": "kb_id is required"}
+    try:
+        return await manager.create_kb(
+            str(kb_id).strip(),
+            name=name or "",
+            description=description or "",
+            tags=tags,
+        )
+    except Exception as e:
+        logger.error(f"kb_create failed: {e}")
+        return {"success": False, "error": str(e)}
+
+
+@tool(
+    name="kb_get",
+    description="获取某个知识库的详情（名称/描述/标签/chunk 数）。kb_id 省略时取默认知识库。",
+)
+async def kb_get(kb_id: Optional[str] = None) -> Dict[str, Any]:
+    """获取知识库详情。
+
+    Args:
+        kb_id: 知识库 ID（省略时取默认知识库）
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    try:
+        return await manager.get_kb(kb_id)
+    except Exception as e:
+        logger.error(f"kb_get failed: {e}")
+        return _disabled_result(str(e))
+
+
+@tool(
+    name="kb_update",
+    description="更新知识库的名称、描述或标签。至少传一个要改的字段。kb_id 省略时取默认知识库。",
+)
+async def kb_update(
+    kb_id: Optional[str] = None,
+    name: Optional[str] = None,
+    description: Optional[str] = None,
+    tags: Optional[List[str]] = None,
+) -> Dict[str, Any]:
+    """更新知识库元信息（name / description / tags 任一）。
+
+    Args:
+        kb_id: 知识库 ID（省略时取默认）
+        name: 新名称
+        description: 新描述
+        tags: 新标签列表
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    if name is None and description is None and tags is None:
+        return {"success": False, "error": "at least one of name/description/tags must be provided"}
+    try:
+        return await manager.update_kb(
+            kb_id, name=name, description=description, tags=tags
+        )
+    except Exception as e:
+        logger.error(f"kb_update failed: {e}")
+        return {"success": False, "error": str(e)}
+
+
+@tool(
+    name="kb_list_entries",
+    description="列出某个知识库内已入库的文档清单（按文档聚合 chunk 数）。kb_id 省略时取默认知识库。",
+)
+async def kb_list_entries(
+    kb_id: Optional[str] = None,
+    keyword: Optional[str] = None,
+    top: Optional[int] = None,
+) -> Dict[str, Any]:
+    """列出知识库内的文档。
+
+    Args:
+        kb_id: 知识库 ID（省略时取默认）
+        keyword: 按文档名过滤的关键词
+        top: 最多返回多少条文档
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    try:
+        return await manager.list_entries(
+            kb_id, keyword=keyword, top=top
+        )
+    except Exception as e:
+        logger.error(f"kb_list_entries failed: {e}")
+        return _disabled_result(str(e))
+
+
+@tool(
+    name="kb_upload_file",
+    description="把本地业务文档（PDF/Word/Markdown/TXT/Excel/HTML/图片）入库向量化。可一次传多个文件路径。kb_id 省略时取默认知识库。",
+)
+async def kb_upload_file(
+    paths: List[str],
+    kb_id: Optional[str] = None,
+) -> Dict[str, Any]:
+    """把本地文档灌入知识库（解析→切分→向量化→索引）。
+
+    Args:
+        paths: 文件路径列表（支持多文件）
+        kb_id: 知识库 ID（省略时取默认）
+
+    Returns:
+        操作结果字典，含 success / doc_ids / docs_indexed
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    if not paths:
+        return {"success": False, "error": "paths must be a non-empty list"}
+    # Validate each path.
+    resolved: List[str] = []
+    for p in paths:
+        ok, result = _validate_path_within_workspace(p)
+        if not ok:
+            return {"success": False, "path": p, "error": result}
+        resolved.append(result)
+    try:
+        return await manager.ingest(resolved, kb_id=kb_id)
+    except Exception as e:
+        logger.error(f"kb_upload_file failed: {e}")
+        return {"success": False, "error": str(e)}
+
+
+@tool(
+    name="kb_attach_dir",
+    description="挂载本地目录：递归扫描目录下的所有支持文档并全量入库。适合批量导入一个文档目录。kb_id 省略时取默认知识库。",
+)
+async def kb_attach_dir(
+    dirPath: str,
+    kb_id: Optional[str] = None,
+) -> Dict[str, Any]:
+    """把一个本地目录下的所有支持文档全量入库。
+
+    Args:
+        dirPath: 目录路径
+        kb_id: 知识库 ID（省略时取默认）
+    """
+    if not (manager := await _ensure_manager()):
+        return _disabled_result()
+    if not dirPath:
+        return {"success": False, "error": "dirPath is required"}
+    try:
+        return await manager.attach_dir(dirPath, kb_id=kb_id)
+    except Exception as e:
+        logger.error(f"kb_attach_dir failed: {e}")
+        return {"success": False, "error": str(e)}
+
+
+@tool(
+    name="kb_search",
+    description="从业务知识库做语义检索。当用户的问题需要已导入的业务文档（产品手册/规章/FAQ 等）支撑时调用。kb_id 省略时取默认知识库。",
+)
+async def kb_search(
+    query: str,
+    kb_id: Optional[str] = None,
+    top_k: Optional[int] = None,
+    agentic: Optional[bool] = None,
+    scoreThreshold: Optional[float] = None,
+) -> Dict[str, Any]:
+    """在知识库中做语义检索。
+
+    Args:
+        query: 自然语言查询
+        kb_id: 知识库 ID（省略时取默认）
+        top_k: 返回结果数（默认 5）
+        agentic: 是否启用 Agentic 多轮改写检索（默认 False）
+        scoreThreshold: 相关性分数下限
+
+    Returns:
+        检索结果字典，含 results（text/score/doc_id/chunk_id/metadata）
