+def _latest_node(adapter: InMemorySemanticaAdapter):
+    _, _, projection = list(adapter.stages.values())[-1]
+    return projection.nodes[0]
+
+
+def _make_term(name="商品交易总额", synonyms=("GMV", "平台成交总额")):
+    return glossary_db.create_term({
+        "name": name,
+        "definition": "特定周期内平台所有生成订单的总金额",
+        "synonyms": list(synonyms),
+    })
