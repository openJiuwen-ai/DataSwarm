@@ -0,0 +1,136 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Missing local acceptance configuration must block before any service I/O."""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+
+SCRIPTS = Path(__file__).resolve().parents[2] / "acceptance" / "datasource"
+
+
+def load_script(relative):
+    spec = importlib.util.spec_from_file_location("prerequisites_" + relative.replace("/", "_"), SCRIPTS / relative)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture
+def no_service_io(monkeypatch):
+    import socket
+    import subprocess
+
+    attempts = []
+
+    def forbidden(*args, **kwargs):
+        attempts.append("service I/O attempted")
+        raise AssertionError("Missing configuration must not open sockets or launch processes")
+
+    monkeypatch.setattr(socket, "socket", forbidden)
+    monkeypatch.setattr(socket, "create_connection", forbidden)
+    monkeypatch.setattr(subprocess, "Popen", forbidden)
+    monkeypatch.setattr(subprocess, "run", forbidden)
+    yield attempts
+    assert not attempts
+
+
+@pytest.mark.parametrize("relative", ["batch16/verify_gates.py", "batch17/verify_gates.py"])
+@pytest.mark.parametrize("explicit_missing", [False, True])
+def test_missing_redis_blocks_before_fixture_and_service_io(
+    relative, explicit_missing, tmp_path, monkeypatch, no_service_io
+):
+    module = load_script(relative)
+    monkeypatch.setattr(module.shutil, "which", lambda name: None)
+    output = tmp_path / "result.json"
+    argv = ["--output", str(output)]
+    if explicit_missing:
+        argv += ["--redis-server", str(tmp_path / "missing-redis")]
+    if "batch16" in relative:
+        argv += ["--fixture", str(tmp_path / "missing.csv")]
+    else:
+        argv += ["--sources", "redis", "--fixture-dir", str(tmp_path / "missing-fixture")]
+    assert module.main(argv) == 2
+    report = json.loads(output.read_text(encoding="utf-8"))
+    assert report["totals"] == {"passed": 0, "failed": 0, "blocked": 1}
+    assert "redis" in report["checks"][0]["detail"].lower()
+
+
+def test_redis_start_helper_rejects_none_before_import_or_socket(tmp_path, no_service_io):
+    module = load_script("batch17/verify_gates.py")
+    with pytest.raises(module.Blocked, match="redis-server"):
+        module.start_redis(None, None, tmp_path, [], None, {})
+
+
+@pytest.mark.parametrize("batch", [16, 17])
+def test_runner_missing_redis_blocks_before_generating_fixtures(batch, tmp_path, monkeypatch, no_service_io):
+    runner = load_script("run_validation.py")
+    monkeypatch.setattr(runner.shutil, "which", lambda name: None)
+    monkeypatch.setattr(runner, "OUTPUT", tmp_path / "output")
+    assert runner.main(["--batches", str(batch), "--fixture-dir", str(tmp_path / "missing-fixture")]) == 2
+    report = json.loads((runner.OUTPUT / "validation-summary.json").read_text(encoding="utf-8"))
+    assert report["fixture_generation"] is None
+    assert report["totals"] == {"passed": 0, "failed": 0, "blocked": 1, "boundaries": 0}
+    assert report["successful"] is False and report["execution_errors"] == 0
+
+
+def test_runner_discovers_path_and_preserves_explicit_redis_override(tmp_path, monkeypatch, no_service_io):
+    runner = load_script("run_validation.py")
+    discovered = tmp_path / "redis-from-path"
+    explicit = tmp_path / "explicit-redis"
+    monkeypatch.setattr(runner.shutil, "which", lambda name: str(discovered))
+    args = runner.parser().parse_args([])
+    assert args.redis_server == discovered
+    args = runner.parser().parse_args(["--redis-server", str(explicit)])
+    assert args.redis_server == explicit
+    assert runner.batch_command(17, args)[-2:] == ["--redis-server", str(explicit)]
+    monkeypatch.setattr(runner.shutil, "which", lambda name: None)
+    args = runner.parser().parse_args([])
+    assert args.redis_server is None
+    assert "--redis-server" not in runner.batch_command(16, args)
+
+
+@pytest.mark.parametrize("case", ["root", "user", "password", "blank-user", "config-field", "bad-json"])
+def test_missing_postgres_settings_block_without_probe_or_control(case, tmp_path, monkeypatch, no_service_io, capsys):
+    module = load_script("batch17/verify_postgres_browsing.py")
+    monkeypatch.delenv("POSTGRES_USER", raising=False)
+    monkeypatch.delenv("POSTGRES_PASSWORD", raising=False)
+    output = tmp_path / "result.json"
+    argv = ["--output", str(output)]
+    secret = "unit-only-private-value"
+    if case != "root":
+        argv += ["--pg-root", str(tmp_path / "dedicated-pg")]
+    if case in ("root", "password"):
+        monkeypatch.setenv("POSTGRES_USER", "acceptance-user")
+    if case in ("root", "user", "blank-user"):
+        monkeypatch.setenv("POSTGRES_PASSWORD", secret)
+    if case == "blank-user":
+        monkeypatch.setenv("POSTGRES_USER", " ")
+    if case in ("config-field", "bad-json"):
+        config = tmp_path / "private.json"
+        config.write_text(json.dumps({"password": secret}) if case == "config-field" else secret, encoding="utf-8")
+        argv += ["--pg-config", str(config)]
+    assert module.main(argv) == 2
+    serialized = output.read_text(encoding="utf-8")
+    report = json.loads(serialized)
+    assert report["totals"] == {"passed": 0, "failed": 0, "blocked": 1}
+    assert report["started_postgres"] is False
+    assert secret not in serialized + capsys.readouterr().out
+
+
+@pytest.mark.parametrize("use_file", [False, True])
+def test_explicit_empty_postgres_password_is_preserved(use_file, tmp_path, monkeypatch, no_service_io):
+    module = load_script("batch17/verify_postgres_browsing.py")
+    monkeypatch.setenv("POSTGRES_USER", "acceptance-user")
+    monkeypatch.setenv("POSTGRES_PASSWORD", "")
+    config = None
+    if use_file:
+        config = tmp_path / "private.json"
+        config.write_text(json.dumps({"user": "file-user", "password": ""}), encoding="utf-8")
+        monkeypatch.setenv("POSTGRES_PASSWORD", "unused-environment-value")
+    assert module.credentials(config) == ("file-user" if use_file else "acceptance-user", "")
+    assert module.redacted_error("ordinary failure", "") == "ordinary failure"
+    assert module.redacted_error("failure: private-token", "private-token") == "failure: [REDACTED]"
