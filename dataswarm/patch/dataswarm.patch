+
+
+@pytest.fixture
+def databases(tmp_path, monkeypatch):
+    workspace = tmp_path / "workspace"
+    legacy = workspace / "data" / "orders.db"
+    bound = tmp_path / "bound # 中文" / "orders.db"
+    for path, origin in ((legacy, "legacy"), (bound, "bound")):
+        path.parent.mkdir(parents=True)
+        with closing(sqlite3.connect(str(path))) as conn:
+            conn.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY NOT NULL, "
+                         "label TEXT NOT NULL, amount REAL DEFAULT 0)")
+            conn.execute("CREATE UNIQUE INDEX orders_label ON orders(label)")
+            conn.execute(f"CREATE TABLE {origin}_only (marker TEXT)")
+            conn.executemany("INSERT INTO orders VALUES (?, ?, ?)", [
+                (1, origin + " first", 1.25), (2, origin + " second", 2.5),
+                (3, origin + " third", 3.75),
+            ])
+            conn.commit()
+    monkeypatch.setattr(sqlite_impl, "get_user_workspace_dir", lambda: str(workspace))
+    return bound, legacy
+
+
+@pytest.mark.parametrize("ref_shape", ["raw_path", "sqlite_uri", "three_slashes"])
+def test_bound_file_wins_over_workspace_file_with_identical_name(databases, ref_shape):
+    bound, legacy = databases
+    ref = str(bound) if ref_shape == "raw_path" else (
+        "sqlite://" + ("/" if ref_shape == "three_slashes" else "") + str(bound))
+    dao = get_dao(db_ref=ref)
+    assert dao.db_ref == ref
+    assert dao.list_databases() == [{"name": "orders", "path": str(bound.resolve()),
+                                    "size_bytes": bound.stat().st_size, "table_count": 2}]
+    for selector in ("orders", ref, str(bound.resolve())):
+        tables = dao.list_tables(selector)
+        assert {table["name"] for table in tables} == {"orders", "bound_only"}
+        assert next(table for table in tables if table["name"] == "orders")["column_count"] == 3
+        detail = dao.get_table_detail(selector, "orders")
+        assert detail["row_count"] == 3
+        assert "CREATE TABLE orders" in detail["ddl"]
+        assert detail["columns"][0]["primary_key"] is True
+        assert detail["columns"][1]["nullable"] is False
+        assert detail["columns"][2]["default_value"] == "0"
+        assert detail["indexes"] == [{"name": "orders_label", "columns": ["label"],
+                                       "sql": "", "unique": True}]
+        assert dao.preview_table(selector, "orders", limit=1, offset=1) == {
+            "columns": ["id", "label", "amount"],
+            "rows": [[2, "bound second", 2.5]], "total": 3,
+        }
+    assert legacy.exists()
+
+
+@pytest.mark.parametrize("operation", ["tables", "detail", "preview"])
+@pytest.mark.parametrize("selector_kind", ["wrong_name", "other_uri", "other_path", "other_scheme"])
+def test_bound_file_rejects_selectors_for_another_database(databases, operation, selector_kind):
+    bound, legacy = databases
+    dao = get_dao(db_ref="sqlite://" + str(bound))
+    selector = {"wrong_name": "another", "other_uri": "sqlite://" + str(legacy),
+                "other_path": str(legacy), "other_scheme": "mysql://localhost/orders"}[selector_kind]
+    with pytest.raises(ValueError):
+        if operation == "tables":
+            dao.list_tables(selector)
+        elif operation == "detail":
+            dao.get_table_detail(selector, "orders")
+        else:
+            dao.preview_table(selector, "orders")
+
+
+def test_missing_bound_file_is_never_created(tmp_path):
+    missing = tmp_path / "missing.db"
+    dao = get_dao(db_ref="sqlite://" + str(missing))
+    assert dao.list_databases() == []
+    assert dao.list_tables("missing") == []
+    with pytest.raises(LookupError, match="database not found"):
+        dao.get_table_detail("missing", "orders")
+    with pytest.raises(LookupError, match="database not found"):
+        dao.preview_table("missing", "orders")
+    assert not missing.exists()
+
+
+def test_disappearing_bound_file_is_not_recreated(databases, monkeypatch):
+    bound, _ = databases
+    dao = get_dao(db_ref="sqlite://" + str(bound))
+    real_connect = sqlite3.connect
+
+    def remove_before_connect(*args, **kwargs):
+        bound.unlink()
+        return real_connect(*args, **kwargs)
+
+    monkeypatch.setattr(sqlite_impl.sqlite3, "connect", remove_before_connect)
+    with pytest.raises(sqlite3.OperationalError, match="unable to open database"):
+        dao.get_table_detail("orders", "orders")
+    assert not bound.exists()
+
+
+def test_service_preserves_bound_path_for_bare_and_full_reference(databases, monkeypatch):
+    bound, _ = databases
+    ref = "sqlite://" + str(bound)
+    monkeypatch.setattr(service, "business_db_ref", lambda: ref)
+    assert service.list_databases()[0]["path"] == str(bound.resolve())
+    for selector in ("orders", ref):
+        assert {table["name"] for table in service.list_tables(selector)} == {"orders", "bound_only"}
+        assert service.get_table_detail(selector, "orders")["row_count"] == 3
+        assert service.preview_table(selector, "orders", limit=1)["rows"] == [[1, "bound first", 1.25]]
+
+
+def test_explicit_legacy_mode_still_discovers_workspace_databases(databases, monkeypatch):
+    _, legacy = databases
+    monkeypatch.setattr(dbc, "default_db_ref", lambda: pytest.fail("explicit legacy mode must not bind a default"))
+    dao = get_dao("sqlite")
+    assert dao.db_ref is None
+    assert dao.list_databases()[0]["path"] == str(legacy)
+    assert {table["name"] for table in dao.list_tables("orders")} == {"orders", "legacy_only"}
+    assert dao.preview_table("orders", "orders", limit=1)["rows"] == [[1, "legacy first", 1.25]]
+    assert dao.list_tables("missing") == []
+    assert not (legacy.parent / "missing.db").exists()
