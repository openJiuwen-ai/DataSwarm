+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import type { ReactNode } from 'react';
+import { Copy, FastForward, PauseCircle } from 'lucide-react';
+import SuccessIcon from '../../../assets/data-development/status-success.svg?react';
+import RunningIcon from '../../../assets/data-development/status-running.svg?react';
+import FailedIcon from '../../../assets/data-development/status-failed.svg?react';
+import CancelledIcon from '../../../assets/data-development/status-cancelled.svg?react';
+import QueuedIcon from '../../../assets/data-development/status-queued.svg?react';
+import ReviewIcon from '../../../assets/data-development/status-review.svg?react';
+import { useTranslation } from 'react-i18next';
+import type { Instance, InstanceStatus, RunStatus } from '../types/orchestration';
+import { toast } from './shared/Ui';
+
+const statusIcons = {
+  queued: QueuedIcon,
+  running: RunningIcon,
+  success: SuccessIcon,
+  failed: FailedIcon,
+  timeout: FailedIcon,
+  cancelled: CancelledIcon,
+  paused: PauseCircle,
+  waiting_review: ReviewIcon,
+  skipped: FastForward,
+};
+
+export function RunStatusIcon({ status }: { status: string }) {
+  const Icon = statusIcons[status as keyof typeof statusIcons];
+  return Icon ? <Icon width={16} height={16} aria-hidden="true" /> : null;
+}
+
+export function RunStatusLabel({ status, children }: { status: InstanceStatus | RunStatus; children?: ReactNode }) {
+  const { t } = useTranslation();
+  return (
+    <span className="dd-run-status" data-status={status} title={t(`workflowRun.status.${status}`)}>
+      <RunStatusIcon status={status} />
+      <span>{children ?? t(`workflowRun.status.${status}`)}</span>
+    </span>
+  );
+}
+
+export function CopyableId({ value }: { value: string }) {
+  const { t } = useTranslation();
+  return (
+    <span className="dd-copy-id">
+      <code title={value}>{value}</code>
+      <button
+        type="button"
+        className="da-icon-btn"
+        title={t('dataAsset.development.copyId')}
+        aria-label={t('dataAsset.development.copyId')}
+        onClick={() => {
+          void navigator.clipboard
+            .writeText(value)
+            .then(() => toast.success(t('dataAsset.development.copied')))
+            .catch((error: Error) => toast.error(error.message));
+        }}
+      >
+        <Copy size={14} aria-hidden="true" />
+      </button>
+    </span>
+  );
+}
+
+export function useRunTime() {
+  const { i18n } = useTranslation();
+  const language = i18n.resolvedLanguage ?? i18n.language;
+  const date = (value: string | null) =>
+    value
+      ? new Intl.DateTimeFormat(language, {
+          year: 'numeric',
+          month: '2-digit',
+          day: '2-digit',
+          hour: '2-digit',
+          minute: '2-digit',
+          second: '2-digit',
+          hour12: false,
+        }).format(new Date(value))
+      : '—';
+  const relative = (value: string) => {
+    const seconds = Math.round((new Date(value).getTime() - Date.now()) / 1000);
+    const formatter = new Intl.RelativeTimeFormat(language, { numeric: 'auto' });
+    if (Math.abs(seconds) < 60) return formatter.format(seconds, 'second');
+    if (Math.abs(seconds) < 3600) return formatter.format(Math.round(seconds / 60), 'minute');
+    if (Math.abs(seconds) < 86400) return formatter.format(Math.round(seconds / 3600), 'hour');
+    return formatter.format(Math.round(seconds / 86400), 'day');
+  };
+  const duration = (
+    instance:
+      | Pick<Instance, 'started_at' | 'finished_at' | 'status'>
+      | { started_at: string | null; finished_at: string | null; status: RunStatus },
+  ) => {
+    if (
+      !instance.started_at ||
+      (!instance.finished_at && ['success', 'failed', 'cancelled', 'skipped', 'timeout'].includes(instance.status))
+    )
+      return '—';
+    let seconds = Math.max(
+      0,
+      Math.floor(
+        ((instance.finished_at ? new Date(instance.finished_at).getTime() : Date.now()) -
+          new Date(instance.started_at).getTime()) /
+          1000,
+      ),
+    );
+    const hours = Math.floor(seconds / 3600);
+    seconds %= 3600;
+    const minutes = Math.floor(seconds / 60);
+    const format = (value: number, unit: string) =>
+      new Intl.NumberFormat(language, { style: 'unit', unit, unitDisplay: 'short' }).format(value);
+    return [
+      hours ? format(hours, 'hour') : '',
+      minutes ? format(minutes, 'minute') : '',
+      format(seconds % 60, 'second'),
+    ]
+      .filter(Boolean)
+      .join(' ');
+  };
+  return { date, relative, duration };
+}
