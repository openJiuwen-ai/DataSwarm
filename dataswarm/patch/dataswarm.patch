+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""HTTP API for the P0 semantic data plane."""
+from __future__ import annotations
+
+from urllib.parse import unquote
+
+from . import service
+
+_PREFIX = "/api/dataagent/semantic"
+
+
+def is_route(path: str) -> bool:
+    """Return whether a path belongs to semantic data-plane APIs."""
+    return path.startswith(_PREFIX)
+
+
+def _split(path: str) -> list[str]:
+    return path[len(_PREFIX):].rstrip("/").split("/")
+
+
+def handle_get(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    try:
+        if len(parts) == 2 and parts[1] == "runs":
+            source_id = handler._query_arg(parsed, "source_id") or None
+            limit = int(handler._query_arg(parsed, "limit") or 50)
+            handler._write_json(200, {"runs": service.list_runs(source_id, limit)})
+            return
+        if len(parts) == 3 and parts[1] == "runs":
+            run = service.get_run(unquote(parts[2]))
+            handler._write_json(200 if run else 404, run or {"error": "not_found"})
+            return
+        if len(parts) == 2 and parts[1] == "changes":
+            source_id = handler._query_arg(parsed, "source_id") or None
+            status = handler._query_arg(parsed, "status") or None
+            handler._write_json(200, {"changes": service.list_changes(source_id, status)})
+            return
+        if len(parts) == 2 and parts[1] == "alerts":
+            source_id = handler._query_arg(parsed, "source_id") or None
+            status = handler._query_arg(parsed, "status") or None
+            handler._write_json(200, {"alerts": service.list_alerts(source_id, status)})
+            return
+        if len(parts) == 3 and parts[1] == "graph" and parts[2] == "search":
+            source_id = handler._query_arg(parsed, "source_id") or ""
+            query = handler._query_arg(parsed, "q") or ""
+            kind = handler._query_arg(parsed, "kind") or ""
+            schema = handler._query_arg(parsed, "schema") or ""
+            role = handler._query_arg(parsed, "role") or ""
+            status = handler._query_arg(parsed, "status") or "active"
+            limit = int(handler._query_arg(parsed, "limit") or 100)
+            handler._write_json(
+                200,
+                {"objects": service.search_graph(source_id, query, kind, schema, role, status, limit)},
+            )
+            return
+        if len(parts) == 2 and parts[1] == "joins":
+            source_id = handler._query_arg(parsed, "source_id") or ""
+            status = handler._query_arg(parsed, "status") or None
+            level = handler._query_arg(parsed, "level") or None
+            handler._write_json(200, service.list_joins(source_id, status=status, level=level))
+            return
+        if len(parts) == 2 and parts[1] == "vector-recall":
+            source_id = handler._query_arg(parsed, "source_id") or ""
+            db_ref = handler._query_arg(parsed, "db_ref") or ""
+            query = handler._query_arg(parsed, "q") or ""
+            limit = int(handler._query_arg(parsed, "limit") or 20)
+            handler._write_json(
+                200, service.vector_recall(source_id, query, limit, db_ref=db_ref))
+            return
+    except (TypeError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    parts = _split(parsed.path)
+    body = _read_body(handler)
+    if body is None:
+        handler._write_json(400, {"error": "invalid_json"})
+        return
+    try:
+        if len(parts) == 2 and parts[1] == "runs":
+            result = service.start_run(body, synchronous=bool(body.get("synchronous", False)))
+            handler._write_json(200 if body.get("synchronous") else 202, result)
+            return
+        if len(parts) == 3 and parts[1] == "joins" and parts[2] == "confirm":
+            result = service.confirm_join(
+                str(body.get("join_node_id") or ""),
+                str(body.get("source_id") or ""),
+                str(body.get("status") or ""),
+                str(body.get("confirmed_by") or ""),
+                str(body.get("note") or ""),
+            )
+            handler._write_json(200, result)
+            return
+    except (TypeError, ValueError) as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def _read_body(handler) -> dict | None:
+    try:
+        length = int(handler.headers.get("Content-Length", "0") or "0")
+    except (TypeError, ValueError):
+        return None
+    if not length:
+        return {}
+    import json
+
+    try:
+        body = json.loads(handler.rfile.read(length))
+    except (json.JSONDecodeError, TypeError):
+        return None
+    return body if isinstance(body, dict) else None
