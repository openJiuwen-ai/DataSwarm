@@ -0,0 +1,355 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 跨模块共享 UI 原语（四模块统一风格基座）。
+ * 从 dataAsset/shared/Ui 上提为唯一实现；dashboard/dataAsset/governance 一律 re-export 本文件。
+ * 风格基准：全局 token（styles/themes/default/light.css + tailwind 语义色），
+ * 状态色即品牌——六态运行色贯穿列表/徽章/DAG。
+ */
+
+import { useState, type ReactNode } from 'react';
+import { Loader2, RefreshCw } from 'lucide-react';
+
+export function Panel({ title, children, className = '', actions }: { title: string; children: ReactNode; className?: string; actions?: ReactNode }) {
+  return (
+    <section className={`rounded-xl border border-border bg-card p-4 shadow-sm ${className}`}>
+      <div className="mb-4 flex items-center justify-between">
+        <h2 className="text-base font-semibold text-text-strong">{title}</h2>
+        {actions}
+      </div>
+      {children}
+    </section>
+  );
+}
+
+export function Empty({ text = '暂无数据' }: { text?: string }) {
+  return <div className="flex min-h-32 items-center justify-center text-sm text-text-muted">{text}</div>;
+}
+
+/**
+ * 带主 CTA 的空状态：图标 + 标题 + 可选说明 + 操作按钮。
+ * 旧 Empty 保留兼容；宣发动线上的空态逐步迁移到本组件（空态即转化点，必须有出路）。
+ */
+export function EmptyState({
+  icon,
+  title,
+  hint,
+  actionLabel,
+  onAction,
+  actionVariant = 'primary',
+}: {
+  icon?: ReactNode;
+  title: string;
+  hint?: string;
+  /** 主 CTA 文案；不传则只展示标题+说明 */
+  actionLabel?: string;
+  onAction?: () => void;
+  actionVariant?: 'primary' | 'default';
+}) {
+  return (
+    <div className="flex min-h-48 flex-col items-center justify-center gap-2 p-8 text-center">
+      {icon && <div className="text-text-placeholder">{icon}</div>}
+      <div className="text-sm font-medium text-text-strong">{title}</div>
+      {hint && <div className="max-w-sm text-xs text-text-muted">{hint}</div>}
+      {actionLabel && onAction && (
+        <Button variant={actionVariant} className="mt-2" onClick={onAction}>
+          {actionLabel}
+        </Button>
+      )}
+    </div>
+  );
+}
+
+/** 骨架条：shimmer 动画灰条，TableSkeleton / 区块骨架的基元。 */
+export function Skeleton({ className = '' }: { className?: string }) {
+  return (
+    <div
+      className={`animate-pulse rounded bg-secondary ${className}`}
+      style={{ animationDuration: '1.5s' }}
+      aria-hidden="true"
+    />
+  );
+}
+
+/** 表格加载骨架：模拟表头 + N 行灰条，替代「加载中…」文字。 */
+export function TableSkeleton({ rows = 5, className = '' }: { rows?: number; className?: string }) {
+  return (
+    <div className={`space-y-2 ${className}`} role="status" aria-label="加载中">
+      <Skeleton className="h-9 w-full" />
+      {Array.from({ length: rows }, (_, i) => (
+        <Skeleton key={i} className="h-10 w-full" />
+      ))}
+    </div>
+  );
+}
+
+/** 错误横幅：三模块错误提示统一收口（dataAsset 黄条 / dm-alert 红条 → 本组件）。 */
+export function ErrorBanner({
+  message,
+  onDismiss,
+  tone = 'danger',
+}: {
+  message: string;
+  onDismiss?: () => void;
+  /** danger=请求/执行失败（红）；warn=校验/兼容性提示（黄） */
+  tone?: 'danger' | 'warn';
+}) {
+  const toneClass = tone === 'warn'
+    ? 'border-warn bg-warn-subtle text-warn'
+    : 'border-danger bg-danger-subtle text-danger';
+  return (
+    <div className={`flex items-center justify-between rounded-lg border px-3 py-2 text-sm ${toneClass}`} role="alert">
+      <span className="min-w-0 break-all">{message}</span>
+      {onDismiss && (
+        <button onClick={onDismiss} aria-label="关闭" className="ml-2 flex-none text-base leading-none opacity-70 hover:opacity-100">
+          ×
+        </button>
+      )}
+    </div>
+  );
+}
+
+const toneClass: Record<string, string> = {
+  neutral: 'bg-secondary text-text-muted',
+  success: 'bg-accent-subtle text-text-link',
+  warn: 'bg-warn-subtle text-warn',
+  danger: 'bg-danger-subtle text-danger',
+  info: 'bg-accent-subtle text-text-link',
+};
+
+export function Badge({ tone = 'neutral', children }: { tone?: 'neutral' | 'success' | 'warn' | 'danger' | 'info'; children: ReactNode }) {
+  return <span className={`rounded px-2 py-0.5 text-xs ${toneClass[tone] ?? toneClass.neutral}`}>{children}</span>;
+}
+
+// 状态徽章与 DAG 运行态共用同一套六色 token（状态色即品牌，模块内处处一致）。
+// 定义态（draft/published/paused）映射到最近的语义色；机器未知状态回退中性灰。
+const STATUS_COLOR: Record<string, { color: string; subtle: string; label: string }> = {
+  draft: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)', label: '草稿' },
+  published: { color: 'var(--color-feedback-success)', subtle: 'var(--color-feedback-success-subtle)', label: '已上线' },
+  running: { color: 'var(--color-feedback-running)', subtle: 'var(--color-feedback-running-subtle)', label: '运行中' },
+  queued: { color: 'var(--color-feedback-queued)', subtle: 'var(--color-feedback-queued-subtle)', label: '排队中' },
+  success: { color: 'var(--color-feedback-success)', subtle: 'var(--color-feedback-success-subtle)', label: '成功' },
+  failed: { color: 'var(--color-feedback-danger)', subtle: 'var(--color-feedback-danger-subtle)', label: '失败' },
+  paused: { color: 'var(--color-feedback-waiting-review)', subtle: 'var(--color-feedback-waiting-review-subtle)', label: '已暂停' },
+  waiting_review: { color: 'var(--color-feedback-waiting-review)', subtle: 'var(--color-feedback-waiting-review-subtle)', label: '待审核' },
+  skipped: { color: 'var(--color-text-tertiary)', subtle: 'var(--color-surface-muted)', label: '跳过' },
+  timeout: { color: 'var(--color-feedback-danger)', subtle: 'var(--color-feedback-danger-subtle)', label: '超时' },
+};
+
+export function StatusBadge({ status, label }: { status: string; label?: string }) {
+  const s = STATUS_COLOR[status] ?? STATUS_COLOR.draft;
+  return (
+    <span
+      className="inline-flex items-center gap-1.5 rounded px-2 py-0.5 text-xs"
+      style={{ background: s.subtle, color: s.color }}
+    >
+      <span className="inline-block h-1.5 w-1.5 rounded-full" style={{ background: s.color }} />
+      {label ?? s.label}
+    </span>
+  );
+}
+
+export function Button({
+  children,
+  onClick,
+  variant = 'default',
+  size = 'sm',
+  disabled,
+  loading = false,
+  autoFocus = false,
+  className = '',
+  title,
+}: {
+  children: ReactNode;
+  onClick?: () => void;
+  variant?: 'default' | 'primary' | 'danger' | 'ghost';
+  size?: 'xs' | 'sm';
+  disabled?: boolean;
+  /** 异步执行中：转圈 + 禁用，防止重复提交 */
+  loading?: boolean;
+  autoFocus?: boolean;
+  className?: string;
+  title?: string;
+}) {
+  const base = 'rounded font-medium disabled:opacity-50 disabled:cursor-not-allowed';
+  const sizes = { xs: 'px-2 py-1 text-xs', sm: 'px-3 py-1.5 text-xs' };
+  const variants = {
+    default: 'border border-border bg-secondary text-text hover:bg-panel',
+    primary: 'border border-accent bg-accent-subtle text-text-link hover:opacity-80',
+    danger: 'border border-danger bg-danger-subtle text-danger hover:opacity-80',
+    ghost: 'text-text-muted hover:text-text',
+  };
+  return (
+    <button
+      className={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
+      onClick={onClick}
+      disabled={disabled || loading}
+      autoFocus={autoFocus || undefined}
+      aria-busy={loading || undefined}
+      title={title}
+    >
+      {loading && <span className="mr-1 inline-block h-2.5 w-2.5 animate-spin rounded-full border-2 border-current border-t-transparent align-[-1px]" />}
+      {children}
+    </button>
+  );
+}
+
+/** mutedHead：表头灰底样式，与数据接入页 .ds-table-head（#f5f5f5 + 次级文字色）同口径。
+ * colWidths：可选列宽（table-fixed + colgroup），传了则按此分配列宽并截断长内容；不传保持 auto 布局。 */
+export function Table({
+  headers,
+  rows,
+  mutedHead = false,
+  colWidths,
+}: {
+  headers: string[];
+  rows: ReactNode[][];
+  mutedHead?: boolean;
+  colWidths?: (string | number)[];
+}) {
+  return (
+    <div className="overflow-x-auto">
+      <table className={`w-full border-collapse text-sm${colWidths ? ' table-fixed' : ''}`}>
+        {colWidths && (
+          <colgroup>
+            {colWidths.map((w, i) => <col key={i} style={{ width: w }} />)}
+          </colgroup>
+        )}
+        <thead>
+          <tr
+            className={`border-b border-border text-left${mutedHead ? ' bg-[var(--color-tag-neutral-surface)] text-sm text-text-secondary' : ' text-xs text-text-muted'}`}
+          >
+            {headers.map((h, i) => (
+              <th key={i} className="whitespace-nowrap px-3 py-2 font-medium">{h}</th>
+            ))}
+          </tr>
+        </thead>
+        <tbody>
+          {rows.map((row, i) => (
+            <tr key={i} className="border-b border-border/50 hover:bg-panel/50">
+              {row.map((cell, j) => (
+                <td key={j} className="px-3 py-2 text-text">{cell}</td>
+              ))}
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
+
+export function Field({ label, children, hint }: { label: string; children: ReactNode; hint?: string }) {
+  return (
+    <label className="block">
+      <span className="mb-1 block text-xs text-text-muted">{label}</span>
+      {children}
+      {hint && <span className="mt-1 block text-xs text-text-muted">{hint}</span>}
+    </label>
+  );
+}
+
+export const inputClass = 'w-full rounded border border-border bg-card px-3 py-1.5 text-sm text-text focus:border-border-strong focus:outline-none';
+
+/**
+ * KPI 卡片: 显示指标值 + 趋势（dashboard 消费）。
+ * 传 onClick 时渲染为按钮（可点击筛选），active 高亮选中态；不传则保持原静态卡片。
+ */
+export function KpiCard({ label, value, unit, trend, onClick, active = false }: { label: string; value: string | number | null; unit?: string; trend?: 'up' | 'down' | 'flat' | null; onClick?: () => void; active?: boolean }) {
+  const trendColor = trend === 'up' ? 'text-ok' : trend === 'down' ? 'text-danger' : 'text-text-muted';
+  const trendArrow = trend === 'up' ? '↑' : trend === 'down' ? '↓' : trend === 'flat' ? '→' : '';
+  const stateClass = active ? 'border-accent bg-accent-subtle' : 'border-border bg-card';
+  const content = (
+    <>
+      <div className="text-xs text-text-muted">{label}</div>
+      <div className="mt-1 flex items-baseline gap-1">
+        <span className="text-2xl font-bold text-text-strong">{value ?? '—'}</span>
+        {unit && <span className="text-xs text-text-muted">{unit}</span>}
+        {trend && <span className={`text-sm font-medium ${trendColor}`}>{trendArrow}</span>}
+      </div>
+    </>
+  );
+  if (!onClick) {
+    return <div className={`rounded-lg border p-3 ${stateClass}`}>{content}</div>;
+  }
+  return (
+    <button type="button" onClick={onClick} className={`rounded-lg border p-3 text-left transition-colors hover:border-border-strong ${stateClass}`}>
+      {content}
+    </button>
+  );
+}
+
+/**
+ * 刷新按钮：复用 Button(primary)，与工具栏其他按钮同尺寸同配色。
+ * 交互：默认可点 → 点击后 spinner + 禁用防重复点 → 异步完成恢复。
+ */
+export function RefreshButton({ onRefresh, title = '刷新' }: { onRefresh: () => Promise<void> | void; title?: string }) {
+  const [loading, setLoading] = useState(false);
+  const handleClick = async () => {
+    if (loading) return;
+    setLoading(true);
+    try {
+      await onRefresh();
+    } finally {
+      setLoading(false);
+    }
+  };
+  return (
+    <Button variant="primary" loading={loading} onClick={handleClick} title={title}>
+      <RefreshCw size={14} className="mr-1 inline" />
+      刷新
+    </Button>
+  );
+}
+
+/**
+ * 状态圆点：对齐数据开发 HifiStatus 视觉（黑字 + 状态色圆点，无胶囊底）。
+ * tone 传 CSS 变量（如 `var(--color-feedback-success)`），与 dataAsset STATUS_TONE 同源。
+ */
+export function StatusDot({ tone, label, small = false }: { tone: string; label: string; small?: boolean }) {
+  return (
+    <span className={`inline-flex items-center text-text ${small ? 'gap-[5px] text-xs' : 'gap-1.5 text-sm'}`}>
+      <span className="h-2.5 w-2.5 flex-shrink-0 rounded-full" style={{ background: tone }} aria-hidden="true" />
+      {label}
+    </span>
+  );
+}
+
+/** 状态色圆点 tone：draft/停用 灰，发布/成功 绿，待发布/警示 黄，失败 红。 */
+export const STATUS_DOT_TONE = {
+  draft: 'var(--color-border-strong)',
+  success: 'var(--color-feedback-success)',
+  warning: 'var(--color-feedback-warning)',
+  danger: 'var(--color-feedback-danger)',
+} as const;
+
+/**
+ * 页头主操作按钮：对齐数据开发 HifiButton（da-btn-primary，黑底白字胶囊）。
+ * 跨模块不引 dataAsset.css，用等价 Tailwind + token 变量实现同款视觉。
+ */
+export function SolidButton({
+  onClick,
+  disabled,
+  loading = false,
+  title,
+  children,
+}: {
+  onClick?: () => void;
+  disabled?: boolean;
+  loading?: boolean;
+  title?: string;
+  children: ReactNode;
+}) {
+  return (
+    <button
+      type="button"
+      className="inline-flex h-8 items-center justify-center gap-1.5 whitespace-nowrap rounded-full border border-transparent px-4 text-xs hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-50"
+      style={{ background: 'var(--color-text-primary)', color: 'var(--color-text-inverse)' }}
+      onClick={onClick}
+      disabled={disabled || loading}
+      aria-busy={loading || undefined}
+      title={title}
+    >
+      {loading && <Loader2 size={14} className="animate-spin" aria-hidden="true" />}
+      {children}
+    </button>
+  );
+}
