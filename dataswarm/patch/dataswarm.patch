+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/api.py — HTTP API handler for /api/dataagent/*。
+
+被 app_web.py 调用：在 do_GET/do_POST 中 orch_api 之后加 is_route() 前缀分流。
+
+仅做前缀分流，每个子前缀委托给对应模块的 controller。
+业务逻辑全部在各子包的 service.py 中。
+
+路由前缀：
+    /api/dataagent/datasource  → datasource.controller
+    /api/dataagent/sql         → sql.controller
+    /api/dataagent/plan        → plan.controller
+    /api/dataagent/databases   → databases.controller
+    /api/dataagent/lineage     → lineage.controller
+    /api/dataagent/dashboard   → dashboard.api
+"""
+from __future__ import annotations
+
+from jiuwenswarm.common import workspace_context
+
+from .dashboard import api as dash_api
+from .metrics import api as metrics_api
+from .lineage import controller as lineage_ctrl
+from .datasource import controller as datasource_ctrl
+from .sql import controller as sql_ctrl
+from .plan import controller as plan_ctrl
+from .databases import controller as databases_ctrl
+from .orchestration import controller as orch_ctrl
+from .builder import controller as builder_ctrl
+from .workspace import controller as workspace_ctrl
+from .semantic import api as semantic_api
+from .glossary import api as glossary_api
+from .analysis import api as analysis_api
+from .knowledge import api as knowledge_api
+from ._common import _query_arg
+
+
+def is_route(path: str) -> bool:
+    """判断是否为 dataagent 路由。"""
+    return path.startswith("/api/dataagent")
+
+
+def handle_get(handler, parsed) -> None:
+    try:
+        _with_workspace(handler, parsed, _handle_get)
+    except workspace_context.WorkspaceContextError as exc:
+        handler._write_json(400, {"error": getattr(exc, "code", "WORKSPACE_CONTEXT_ERROR"), "detail": str(exc)})
+
+
+def _handle_get(handler, parsed) -> None:
+    path = parsed.path.rstrip("/")
+    if path.startswith("/api/dataagent/workspaces"):
+        workspace_ctrl.handle_get(handler, parsed)
+        return
+    # 编排子前缀（方案 §五：task/workflow/instance，业务唯一实现在 orchestration/service）
+    if path.startswith("/api/dataagent/orchestration"):
+        orch_ctrl.handle_get(handler, parsed)
+        return
+    # builder 子前缀（方案批次 3 §5.4）
+    if path.startswith("/api/dataagent/builder"):
+        builder_ctrl.handle_get(handler, parsed)
+        return
+    # dashboard 子前缀
+    if path.startswith("/api/dataagent/dashboard"):
+        dash_api.handle_get(handler, parsed)
+        return
+    # metrics 子前缀（指标语义层，方案 docs/archive/superseded/bi-metrics-module-plan.md §3.3）
+    if path.startswith("/api/dataagent/metrics"):
+        metrics_api.handle_get(handler, parsed)
+        return
+    if path.startswith("/api/dataagent/semantic"):
+        semantic_api.handle_get(handler, parsed)
+        return
+    # glossary 子前缀（业务术语库，方案 docs/archive/delivered/dataagent-glossary-p0-design.md §4.2）
+    if path.startswith("/api/dataagent/glossary"):
+        glossary_api.handle_get(handler, parsed)
+        return
+    # analysis 子前缀（数据分析四层链路，方案 docs/architecture/data-analysis-flow-target-v0.6.html）
+    if path.startswith("/api/dataagent/analysis"):
+        analysis_api.handle_get(handler, parsed)
+        return
+    if path.startswith("/api/dataagent/knowledge"):
+        knowledge_api.handle_get(handler, parsed)
+        return
+    # lineage 子前缀
+    if path.startswith("/api/dataagent/lineage"):
+        lineage_ctrl.handle_get(handler, parsed)
+        return
+    # datasource 子前缀
+    if path.startswith("/api/dataagent/datasource"):
+        datasource_ctrl.handle_get(handler, parsed)
+        return
+    # sql 子前缀（无 GET，controller 会返回 404）
+    if path.startswith("/api/dataagent/sql"):
+        sql_ctrl.handle_get(handler, parsed)
+        return
+    # plan 子前缀
+    if path.startswith("/api/dataagent/plan"):
+        plan_ctrl.handle_get(handler, parsed)
+        return
+    # databases 子前缀
+    if path.startswith("/api/dataagent/databases"):
+        databases_ctrl.handle_get(handler, parsed)
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    try:
+        _with_workspace(handler, parsed, _handle_post)
+    except workspace_context.WorkspaceContextError as exc:
+        handler._write_json(400, {"error": getattr(exc, "code", "WORKSPACE_CONTEXT_ERROR"), "detail": str(exc)})
+
+
+def _handle_post(handler, parsed) -> None:
+    path = parsed.path.rstrip("/")
+    if path.startswith("/api/dataagent/workspaces"):
+        workspace_ctrl.handle_post(handler, parsed)
+        return
+    # 编排子前缀（方案 §五）
+    if path.startswith("/api/dataagent/orchestration"):
+        orch_ctrl.handle_post(handler, parsed)
+        return
+    # builder 子前缀（方案批次 3 §5.4）
+    if path.startswith("/api/dataagent/builder"):
+        builder_ctrl.handle_post(handler, parsed)
+        return
+    # dashboard 子前缀
+    if path.startswith("/api/dataagent/dashboard"):
+        dash_api.handle_post(handler, parsed)
+        return
+    # metrics 子前缀（指标语义层）
+    if path.startswith("/api/dataagent/metrics"):
+        metrics_api.handle_post(handler, parsed)
+        return
+    if path.startswith("/api/dataagent/semantic"):
+        semantic_api.handle_post(handler, parsed)
+        return
+    # glossary 子前缀（业务术语库）
+    if path.startswith("/api/dataagent/glossary"):
+        glossary_api.handle_post(handler, parsed)
+        return
+    # analysis 子前缀（数据分析四层链路）
+    if path.startswith("/api/dataagent/analysis"):
+        analysis_api.handle_post(handler, parsed)
+        return
+    if path.startswith("/api/dataagent/knowledge"):
+        knowledge_api.handle_post(handler, parsed)
+        return
+    # lineage 子前缀
+    if path.startswith("/api/dataagent/lineage"):
+        lineage_ctrl.handle_post(handler, parsed)
+        return
+    # datasource 子前缀
+    if path.startswith("/api/dataagent/datasource"):
+        datasource_ctrl.handle_post(handler, parsed)
+        return
+    # sql 子前缀
+    if path.startswith("/api/dataagent/sql"):
+        sql_ctrl.handle_post(handler, parsed)
+        return
+    # plan 子前缀
+    if path.startswith("/api/dataagent/plan"):
+        plan_ctrl.handle_post(handler, parsed)
+        return
+    # databases 子前缀（无 POST）
+    if path.startswith("/api/dataagent/databases"):
+        databases_ctrl.handle_post(handler, parsed)
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_delete(handler, parsed) -> None:
+    try:
+        _with_workspace(handler, parsed, _handle_delete)
+    except workspace_context.WorkspaceContextError as exc:
+        handler._write_json(400, {"error": getattr(exc, "code", "WORKSPACE_CONTEXT_ERROR"), "detail": str(exc)})
+
+
+def _handle_delete(handler, parsed) -> None:
+    path = parsed.path.rstrip("/")
+    # knowledge 子前缀（文档删除：候选退役 + 文档行删除）
+    if path.startswith("/api/dataagent/knowledge"):
+        knowledge_api.handle_delete(handler, parsed)
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def _with_workspace(handler, parsed, dispatch) -> None:
+    """Resolve once at the DataAgent boundary and always reset the context."""
+    path = parsed.path.rstrip("/")
+    # Workspace discovery must remain callable before a workspace is selected.
+    if path.startswith("/api/dataagent/workspaces"):
+        dispatch(handler, parsed)
+        return
+    workspace_id = (
+        _query_arg(parsed, "workspace_id")
+        or handler.headers.get("X-Workspace-Id", "")
+        or None
+    )
+    # Some POST endpoints carry workspace_id in their JSON body and resolve
+    # it in the service layer.  Query/header context is still installed here;
+    # an absent context is rejected by the database role resolver rather than
+    # silently falling back to the global datasource.
+    if not workspace_id:
+        dispatch(handler, parsed)
+        return
+    context = workspace_context.resolve(workspace_id)
+    token = workspace_context.set_current(context.workspace_id)
+    try:
+        dispatch(handler, parsed)
+    finally:
+        workspace_context.reset(token)
