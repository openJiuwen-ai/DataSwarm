+def test_tick_default_now_is_real_aware(monkeypatch):
+    """_tick() 不传 now 时取真实 aware now（覆盖默认参数路径，确保生产不退化为 naive）。"""
+    called_with = []
+    monkeypatch.setattr(scheduler.orch_db, "list_scheduled_targets",
+                        lambda: [_make_target("none")])  # 一个目标触发 _is_due 调用
