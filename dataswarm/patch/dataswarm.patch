@@ -0,0 +1,238 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""business_data DAO 分层单测。
+
+覆盖 SqliteBusinessDao / DorisBusinessDao 的方言差异逻辑：
+- _infer_layer 前缀判定
+- SqliteBusinessDao._local_db_path / _count_sqlite_tables
+- DorisBusinessDao._doris_config 读环境变量与 yaml
+- DorisBusinessDao._conn_spec 按 db_ref 解析连接目标（mysql/doris 完整 ref、短形态、缺省）
+- _json_safe 转换
+"""
+from __future__ import annotations
+
+import sqlite3
+from datetime import datetime
+
+from jiuwenswarm.channels.web.dataagent.business_data import (
+    sqlite_impl as sqlite_impl,
+    doris_impl as doris_impl,
+)
+
+
+# --------------------------------------------------------------------------
+# _infer_layer（两份独立副本，行为应一致）
+# --------------------------------------------------------------------------
+def test_infer_layer_sqlite_impl():
+    assert sqlite_impl._infer_layer("dwd_orders") == "DWD"
+    assert sqlite_impl._infer_layer("dws_orders_daily") == "DWS"
+    assert sqlite_impl._infer_layer("ads_kpi") == "ADS"
+    assert sqlite_impl._infer_layer("ods_raw") == "ODS"
+    assert sqlite_impl._infer_layer("unknown") == "OTHER"
+
+
+def test_infer_layer_doris_impl():
+    assert doris_impl._infer_layer("DWD_Orders") == "DWD"  # 大小写不敏感
+    assert doris_impl._infer_layer("DWS_Daily") == "DWS"
+    assert doris_impl._infer_layer("unknown") == "OTHER"
+
+
+# --------------------------------------------------------------------------
+# SqliteBusinessDao helpers
+# --------------------------------------------------------------------------
+def test_sqlite_local_db_path(monkeypatch, tmp_path):
+    monkeypatch.setattr(
+        "jiuwenswarm.channels.web.dataagent.business_data.sqlite_impl.get_user_workspace_dir",
+        lambda: str(tmp_path),
+    )
+    p = sqlite_impl.SqliteBusinessDao._local_db_path("olist")
+    assert p == tmp_path / "data" / "olist.db"
+
+
+def test_count_sqlite_tables_empty(tmp_path):
+    p = tmp_path / "empty.db"
+    sqlite3.connect(str(p)).close()
+    assert sqlite_impl.SqliteBusinessDao._count_sqlite_tables(p) == 0
+
+
+def test_count_sqlite_tables_with_data(tmp_path):
+    p = tmp_path / "data.db"
+    with sqlite3.connect(str(p)) as conn:
+        conn.execute("CREATE TABLE t1 (id INT)")
+        conn.execute("CREATE TABLE t2 (id INT)")
+    # sqlite_master WHERE name NOT LIKE 'sqlite_%' 过滤系统表
+    assert sqlite_impl.SqliteBusinessDao._count_sqlite_tables(p) == 2
+
+
+def test_count_sqlite_tables_missing(tmp_path):
+    p = tmp_path / "nope.db"
+    assert sqlite_impl.SqliteBusinessDao._count_sqlite_tables(p) == 0
+
+
+def test_sqlite_get_table_detail_returns_empty_comment(monkeypatch, tmp_path):
+    # SQLite 无表 comment 概念，get_table_detail 应恒返回空串且其余字段不受影响
+    monkeypatch.setattr(
+        "jiuwenswarm.channels.web.dataagent.business_data.sqlite_impl.get_user_workspace_dir",
+        lambda: str(tmp_path),
+    )
+    (tmp_path / "data").mkdir()
+    p = tmp_path / "data" / "mydb.db"
+    with sqlite3.connect(str(p)) as conn:
+        conn.execute("CREATE TABLE t1 (id INTEGER PRIMARY KEY, name TEXT)")
+        conn.execute("INSERT INTO t1 (name) VALUES ('a')")
+    result = sqlite_impl.SqliteBusinessDao().get_table_detail("mydb", "t1")
+    assert result["comment"] == ""
+    assert result["name"] == "t1"
+    assert result["row_count"] == 1
+    assert [c["name"] for c in result["columns"]] == ["id", "name"]
+
+
+# --------------------------------------------------------------------------
+# DorisBusinessDao helpers
+# --------------------------------------------------------------------------
+def test_doris_config_env_overrides(monkeypatch):
+    monkeypatch.setenv("DORIS_HOST", "h1")
+    monkeypatch.setenv("DORIS_PORT", "9999")
+    monkeypatch.setenv("DORIS_USER", "u1")
+    monkeypatch.setenv("DORIS_PASSWORD", "pw1")
+    monkeypatch.setattr(
+        doris_impl.db_connector,
+        "_read_config_section",
+        lambda section: {"host": "yaml_h", "port": 9030, "user": "admin", "password": ""},
+    )
+    cfg = doris_impl._doris_config()
+    assert cfg == {"host": "h1", "port": 9999, "user": "u1", "password": "pw1"}
+
+
+def test_doris_config_yaml_fallback(monkeypatch):
+    for k in ("DORIS_HOST", "DORIS_PORT", "DORIS_USER", "DORIS_PASSWORD"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setattr(
+        doris_impl.db_connector,
+        "_read_config_section",
+        lambda section: {"host": "yaml_h", "port": 9030, "user": "admin", "password": ""},
+    )
+    cfg = doris_impl._doris_config()
+    assert cfg == {"host": "yaml_h", "port": 9030, "user": "admin", "password": ""}
+
+
+def test_doris_config_defaults_when_empty(monkeypatch):
+    for k in ("DORIS_HOST", "DORIS_PORT", "DORIS_USER", "DORIS_PASSWORD"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setattr(
+        doris_impl.db_connector, "_read_config_section", lambda section: {}
+    )
+    cfg = doris_impl._doris_config()
+    assert cfg == {"host": "", "port": 9030, "user": "admin", "password": ""}
+
+
+# --------------------------------------------------------------------------
+# DorisBusinessDao._conn_spec（db_ref 解析连接目标）
+# --------------------------------------------------------------------------
+def test_conn_spec_full_mysql_ref_with_credentials(monkeypatch):
+    # 完整 mysql ref：host/port 取自 ref，凭据经 _lookup_source_credentials 回填
+    monkeypatch.setattr(
+        doris_impl.db_connector,
+        "_lookup_source_credentials",
+        lambda db_type, host, port, database: {"user": "root", "password": "x"},
+    )
+    dao = doris_impl.DorisBusinessDao(db_ref="mysql://localhost:3306/olist")
+    assert dao._conn_spec() == {
+        "host": "localhost", "port": 3306, "user": "root", "password": "x",
+    }
+
+
+def test_conn_spec_full_mysql_ref_no_credentials_no_fallback(monkeypatch):
+    # 凭据回填失败：user/password 留空，不 fallback 全局 doris 段凭据
+    monkeypatch.setattr(
+        doris_impl.db_connector,
+        "_lookup_source_credentials",
+        lambda db_type, host, port, database: {},
+    )
+    dao = doris_impl.DorisBusinessDao(db_ref="mysql://localhost:3306/olist")
+    spec = dao._conn_spec()
+    assert spec["host"] == "localhost"
+    assert spec["port"] == 3306
+    assert spec["user"] == ""
+    assert spec["password"] == ""
+
+
+def test_conn_spec_short_doris_ref_uses_config_section(monkeypatch):
+    # 短形态 doris://business：parse_db_ref 自动补全为 config doris: 段
+    for k in ("DORIS_HOST", "DORIS_PORT", "DORIS_USER", "DORIS_PASSWORD"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setattr(
+        doris_impl.db_connector,
+        "_read_config_section",
+        lambda section: {"host": "yaml_h", "port": 9030, "user": "admin", "password": "pw"},
+    )
+    dao = doris_impl.DorisBusinessDao(db_ref="doris://business")
+    assert dao._conn_spec() == {
+        "host": "yaml_h", "port": 9030, "user": "admin", "password": "pw",
+    }
+
+
+def test_conn_spec_no_db_ref_falls_back_to_global(monkeypatch):
+    for k in ("DORIS_HOST", "DORIS_PORT", "DORIS_USER", "DORIS_PASSWORD"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setattr(
+        doris_impl.db_connector, "_read_config_section", lambda section: {}
+    )
+    dao = doris_impl.DorisBusinessDao()
+    assert dao._conn_spec() == doris_impl._doris_config()
+
+
+def test_conn_spec_full_doris_ref(monkeypatch):
+    # 完整 doris ref（UI 注册的异构 Doris 源）：连接目标取自 ref 而非全局段
+    monkeypatch.setattr(
+        doris_impl.db_connector,
+        "_lookup_source_credentials",
+        lambda db_type, host, port, database: {},
+    )
+    dao = doris_impl.DorisBusinessDao(db_ref="doris://h1:9030/db1")
+    assert dao._conn_spec() == {
+        "host": "h1", "port": 9030, "user": "", "password": "",
+    }
+
+
+# --------------------------------------------------------------------------
+# _json_safe
+# --------------------------------------------------------------------------
+def test_json_safe_primitives():
+    assert doris_impl._json_safe(None) is None
+    assert doris_impl._json_safe("str") == "str"
+    assert doris_impl._json_safe(42) == 42
+    assert doris_impl._json_safe(3.14) == 3.14
+    assert doris_impl._json_safe(True) is True
+
+
+def test_json_safe_datetime():
+    dt = datetime(2026, 8, 31, 12, 0, 0)
+    assert doris_impl._json_safe(dt) == dt.isoformat()
+
+
+def test_json_safe_bytes():
+    assert doris_impl._json_safe(b"hello") == "hello"
+    # 非 utf-8 字节降级到 replace
+    out = doris_impl._json_safe(b"\xff\xfe")
+    assert isinstance(out, str)
+
+
+def test_json_safe_list_and_dict():
+    assert doris_impl._json_safe([1, "a"]) == [1, "a"]
+    assert doris_impl._json_safe({"k": "v"}) == {"k": "v"}
+
+
+def test_json_safe_fallback_to_str():
+    class Custom:
+        def __str__(self):
+            return "custom-instance"
+    assert doris_impl._json_safe(Custom()) == "custom-instance"
+
+
+# --------------------------------------------------------------------------
+# 系统库过滤集
+# --------------------------------------------------------------------------
+def test_hidden_databases_set():
+    for name in ("information_schema", "mysql", "__internal_schema", "sys",
+                 "performance_schema", "__recycle_bin__", "bigdata"):
+        assert name in doris_impl._HIDDEN_DATABASES
diff --git a/tests/unit/channel/test_dashboard_import_data_loading.py b/tests/unit/channel/test_dashboard_import_data_loading.py
new file mode 100644
index 000000000..f074fdbce
--- /dev/null
+++ b/tests/unit/channel/test_dashboard_import_data_loading.py
@@ -0,0 +1,120 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""import_from_report 的 data_candidates 加载逻辑单测。
+
+覆盖 bug：当 spec 文件名为 spec.json（stem 不含 _spec 子串）时，
+data_candidates 第 1 项的 replace("_spec", "_data") 是空替换，
+退化为 spec.json 自身，导致把 spec 错当 data 加载 → charts_data 为空
+→ chart 卡片 echarts_option 全 null。
+"""
+from __future__ import annotations
+
+import json
+import importlib
+
+import pytest
+
+
+def _bootstrap_module(tmp_path, monkeypatch):
+    """把 dashboard db 指向临时 sqlite，重新加载模块并建表。"""
+    db_file = tmp_path / "meta.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_file}")
+    import jiuwenswarm.channels.web.orchestration.db as orch_db
+    importlib.reload(orch_db)
+    import jiuwenswarm.channels.web.dataagent.dashboard.db as dash_db_mod
+    importlib.reload(dash_db_mod)
+    dash_db_mod.init_db()
+    return dash_db_mod
+
+
+def _write_spec(path, with_chart_id=True):
+    """写一份 spec。with_chart_id=False 时 chart 字段为内联 dict（fast-path）。"""
+    spec = {
+        "title": "test report",
+        "shape": "dashboard",
+        "kpis": [
+            {"label": "k1", "value": "1", "unit": "x",
+             "sql": "SELECT 1 AS v"}
+        ],
+        "sections": [
+            {
+                "title": "s1",
+                "sql": "SELECT 'a' AS k, 1 AS v",
+                "chart": "c1" if with_chart_id else {"type": "bar", "x": "k", "y": "v"},
+            }
+        ],
+    }
+    path.write_text(json.dumps(spec, ensure_ascii=False), encoding="utf-8")
+
+
+def _write_data(path):
+    """写一份 data.json，charts 字段为 chart ID → ECharts option 映射。"""
+    data = {
+        "charts": {
+            "c1": {"baseOption": {"series": [{"type": "bar", "data": [{"name": "a", "value": 1}]}]}}
+        }
+    }
+    path.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
+
+
+def test_import_loads_data_json_for_spec_named_spec(tmp_path, monkeypatch):
+    """spec.json + data.json 配对时，data.json 应被正确加载。
+
+    回归 bug：旧实现下 spec.json 的 stem='spec' 不含 _spec 子串，
+    replace 后 candidate 1 退化为 spec.json 自身，把 spec 错当 data
+    读入，charts_data 为空，section.chart='c1' 找不到 option，
+    入库 echarts_option=None。
+    """
+    m = _bootstrap_module(tmp_path, monkeypatch)
+    spec_path = tmp_path / "spec.json"
+    data_path = tmp_path / "data.json"
+    _write_spec(spec_path, with_chart_id=True)
+    _write_data(data_path)
+
+    r = m.import_from_report(spec_path=str(spec_path))
+    assert r is not None
+    cards = r.get("cards", [])
+    chart_cards = [c for c in cards if c.get("card_type") == "chart"]
+    assert len(chart_cards) == 1
+    # 修复后：data.json 被加载，c1 的 option 被写入卡片
+    assert chart_cards[0].get("echarts_option") is not None, (
+        f"echarts_option should be loaded from data.json, got None. "
+        f"card: {chart_cards[0]}"
+    )
+
+
+def test_import_does_not_treat_spec_as_data_when_data_missing(tmp_path, monkeypatch):
+    """spec.json 存在但无 data.json 时，不应把 spec 自身当 data 加载。
+
+    回归 bug：旧实现下 candidate 1 退化为 spec.json 自身并被 json.loads
+    成功（spec 本身是合法 JSON），data = spec，charts_data 空但 data 非空。
+    修复后：data.json 不存在时 data 应保持 None，不会错把 spec 当 data。
+    """
+    m = _bootstrap_module(tmp_path, monkeypatch)
+    spec_path = tmp_path / "spec.json"
+    _write_spec(spec_path, with_chart_id=True)
+    # 不写 data.json
+
+    r = m.import_from_report(spec_path=str(spec_path))
+    assert r is not None
+    cards = r.get("cards", [])
+    chart_cards = [c for c in cards if c.get("card_type") == "chart"]
+    # chart 是 ID 引用、无 data → echarts_option 应为 None（不是把 spec 的字段塞进来）
+    assert chart_cards[0].get("echarts_option") is None
+
+
+def test_import_loads_data_for_named_spec_with_suffix(tmp_path, monkeypatch):
+    """report_xxx_spec.json + report_xxx_data.json 命名约定下也应正确加载。
+
+    这是 _spec/_data 命名约定的正路径，确保修复不破坏既有用法。
+    """
+    m = _bootstrap_module(tmp_path, monkeypatch)
+    spec_path = tmp_path / "report_rfm_spec.json"
+    data_path = tmp_path / "report_rfm_data.json"
+    _write_spec(spec_path, with_chart_id=True)
+    _write_data(data_path)
+
+    r = m.import_from_report(spec_path=str(spec_path))
+    assert r is not None
+    cards = r.get("cards", [])
+    chart_cards = [c for c in cards if c.get("card_type") == "chart"]
+    assert chart_cards[0].get("echarts_option") is not None
