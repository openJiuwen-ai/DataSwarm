+def test_value_read_queries_keep_empty_latest_generation_and_avoid_correlated_topn(monkeypatch, semantic_db):
+    """Exercise emitted queries, including the Doris-incompatible SQL shape.
+
+    Source A has a newly published empty dictionary; B has published values and
+    a newer staged generation; C is outside the requested sources. Joining only
+    generations with values would incorrectly resurrect A's old values.
+    """
+    import sqlglot
+    from sqlglot import exp
+    from sqlglot.optimizer.scope import traverse_scope
+
+    for source_id in ("src-a", "src-b", "src-c"):
+        snapshot_id = f"{source_id}-published"
+        _snapshot(source_id=source_id, snapshot_id=snapshot_id)
+        repository.save_value_dict(source_id, snapshot_id, [_value_row(source_id, "east")])
+    _snapshot(source_id="src-a", snapshot_id="src-a-empty")
+    _snapshot(source_id="src-b", snapshot_id="src-b-staged", status="staged")
+    repository.save_value_dict("src-b", "src-b-staged", [_value_row("src-b", "south")])
+    all_ids = _stored_value_ids(semantic_db)
+    fetched_sql = []
+    fetch = repository._fetch_dicts
+
+    def record_and_fetch(conn, sql, params=()):
+        if "dw_semantic_value_dict" in sql:
+            fetched_sql.append(sql)
+        return fetch(conn, sql, params)
+
+    monkeypatch.setattr(repository, "_fetch_dicts", record_and_fetch)
+
+    assert repository.recall_value_dict("src-a", "east") == []
+    assert repository.list_value_dict_texts("src-a") == []
+    rows = repository.get_value_dict_rows(["src-a", "src-b"], all_ids)
+    assert [(row["source_id"], row["value_text"]) for row in rows] == [("src-b", "east")]
+    assert len(fetched_sql) == 4  # exact, substring, embedding corpus, bulk hit lookup
+    for sql in fetched_sql:
+        parsed = sqlglot.parse_one(sql, read="doris")
+        # Publication visibility is evaluated within each data-read statement.
+        assert {table.name for table in parsed.find_all(exp.Table)} == {
+            "dw_semantic_value_dict", "dw_semantic_snapshots",
+        }
+        for scope in traverse_scope(parsed):
+            assert not (scope.is_correlated_subquery and scope.expression.args.get("limit")), sql
