@@ -0,0 +1,402 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { History, PanelRightClose, PanelRightOpen, RefreshCw, X } from 'lucide-react';
+import { orchestrationApi } from '../api/orchestrationApi';
+import type { Instance, NodeInput, TaskDefinition, TaskRun } from '../types/orchestration';
+import { useListQuery } from '../hooks/useListQuery';
+import { useWorkflowInstance } from '../hooks/useWorkflowInstance';
+import { Pagination } from '../../../components/ui/Pagination/Pagination';
+import { Button } from './shared/Ui';
+import { IconButton } from './shared/Hifi';
+import { ACTIVE_INSTANCE_STATUSES, CANCELLABLE_INSTANCE_STATUSES } from './shared/instanceUtils';
+import { WorkflowDag } from './WorkflowDag';
+import { LogViewer } from './LogViewer';
+import { CopyableId, RunStatusLabel, useRunTime } from './WorkflowRunUi';
+import SqlIcon from '../../../assets/data-development/sql.svg?react';
+import PythonIcon from '../../../assets/data-development/python.svg?react';
+import StopIcon from '../../../assets/data-development/stop.svg?react';
+
+interface Props {
+  workflowId: string;
+  draft: NodeInput[];
+  tasks: TaskDefinition[];
+  instanceId: string | null;
+  /** Increments when an external action creates or changes a run. */
+  refreshKey?: number;
+  /** Standalone instance links show only the graph and selected node details. */
+  showOverview?: boolean;
+  onSelectInstance: (id: string, replace?: boolean) => void;
+}
+
+function ExecutorIcon({ executor }: { executor?: TaskDefinition['executor_type'] }) {
+  if (executor === 'sql') return <SqlIcon width={24} height={24} aria-hidden="true" />;
+  if (executor === 'python') return <PythonIcon width={24} height={24} aria-hidden="true" />;
+  return null;
+}
+
+function NodeRunLogs({ run, showRunId }: { run: TaskRun; showRunId: boolean }) {
+  const { t } = useTranslation();
+  const [stream, setStream] = useState<'stdout' | 'stderr'>('stdout');
+  return (
+    <section className="dd-node-run">
+      {showRunId && <CopyableId value={run.run_id} />}
+      {run.error_message && (
+        <p role="alert" className="dd-error">
+          {run.error_message}
+        </p>
+      )}
+      <div className="dd-stream-tabs" role="group" aria-label={t('dataAsset.development.logStream')}>
+        {(['stdout', 'stderr'] as const).map((value) => (
+          <button type="button" key={value} aria-pressed={stream === value} onClick={() => setStream(value)}>
+            {value.toUpperCase()}
+          </button>
+        ))}
+      </div>
+      <LogViewer runId={run.run_id} stream={stream} presentation="workflow" />
+    </section>
+  );
+}
+
+function InstanceTimes({ instance }: { instance: Instance }) {
+  const { t } = useTranslation();
+  const time = useRunTime();
+  return (
+    <dl className="dd-time-grid dd-instance-times">
+      <div>
+        <dt>{t('dataAsset.development.createdAt')}</dt>
+        <dd>{time.date(instance.created_at)}</dd>
+      </div>
+      <div>
+        <dt>{t('dataAsset.development.finishedAt')}</dt>
+        <dd>{time.date(instance.finished_at)}</dd>
+      </div>
+      <div>
+        <dt>{t('dataAsset.development.duration')}</dt>
+        <dd>{time.duration(instance)}</dd>
+      </div>
+    </dl>
+  );
+}
+
+/** Shared by the workflow detail Tab and existing standalone/embedded run links. */
+export function WorkflowRuns({
+  workflowId,
+  draft,
+  tasks,
+  instanceId,
+  refreshKey = 0,
+  onSelectInstance,
+  showOverview = true,
+}: Props) {
+  const { t } = useTranslation();
+  const time = useRunTime();
+  const [page, setPage] = useState(1);
+  const [pageSize, setPageSize] = useState(10);
+  const [nodeId, setNodeId] = useState<string | null>(null);
+  const [overviewOpen, setOverviewOpen] = useState(true);
+  const [actionError, setActionError] = useState<string | null>(null);
+  const [action, setAction] = useState<string | null>(null);
+  const actionInFlight = useRef(false);
+  const target = useRef(instanceId);
+  target.current = instanceId;
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  // Debugging can select a newly created instance while this view remains mounted.
+  const load = useCallback(async () => {
+    const result = await orchestrationApi.listInstances({
+      ref_type: 'workflow',
+      ref_id: workflowId,
+      limit: pageSize,
+      offset: (page - 1) * pageSize,
+    });
+    return { items: result.instances, total: result.total, meta: result.status_counts };
+  }, [workflowId, pageSize, page, refreshKey]);
+  const list = useListQuery(showOverview ? load : null);
+  const statusCounts = list.meta;
+  const detail = useWorkflowInstance(workflowId, instanceId);
+  const instance = detail.instance;
+  useEffect(() => {
+    if (refreshKey > 0) setPage(1);
+  }, [refreshKey]);
+  useEffect(() => {
+    setNodeId(null);
+    setActionError(null);
+  }, [instanceId]);
+  useEffect(() => {
+    if (!instanceId && list.hasLoaded && list.items.length) onSelectInstance(list.items[0].instance_id, true);
+  }, [instanceId, list.hasLoaded, list.items, onSelectInstance]);
+  useEffect(() => {
+    if (
+      list.loading ||
+      !statusCounts ||
+      !Object.entries(statusCounts).some(([status, count]) => count > 0 && ACTIVE_INSTANCE_STATUSES.has(status))
+    )
+      return;
+    const timer = window.setTimeout(() => void list.reload(), 2000);
+    return () => window.clearTimeout(timer);
+  }, [statusCounts, list.loading, list.reload]);
+  useEffect(() => {
+    if (list.hasLoaded && !list.loading && !list.error && page > Math.max(1, Math.ceil(list.total / pageSize)))
+      setPage(Math.max(1, Math.ceil(list.total / pageSize)));
+  }, [list.hasLoaded, list.loading, list.error, list.total, pageSize, page]);
+  const refresh = () => {
+    detail.reload();
+    void list.reload();
+  };
+  const stop = async (targetInstance: Instance) => {
+    if (!CANCELLABLE_INSTANCE_STATUSES.has(targetInstance.status) || actionInFlight.current) return;
+    actionInFlight.current = true;
+    const id = targetInstance.instance_id;
+    setAction(`stop:${id}`);
+    setActionError(null);
+    try {
+      const result = await orchestrationApi.cancelInstance(id);
+      if (!mounted.current) return;
+      if (target.current === id) {
+        if (instanceId === id) detail.acceptAction(result);
+        else detail.reload();
+      }
+      await list.reload();
+    } catch (error) {
+      if (mounted.current) setActionError(error instanceof Error ? error.message : String(error));
+    } finally {
+      actionInFlight.current = false;
+      if (mounted.current) setAction(null);
+    }
+  };
+  const node = instance ? draft.find((item) => item.node_id === nodeId) : undefined;
+  const task = tasks.find((item) => item.task_id === node?.task_id);
+  const runs = instance?.task_runs?.filter((item) => item.node_id === nodeId) ?? [];
+  let emptyMessage = t('dataAsset.development.noRuns');
+  if (detail.loading || (list.loading && !list.hasLoaded)) emptyMessage = t('common.loading');
+  else if (instanceId) emptyMessage = t('dataAsset.development.instanceUnavailable');
+  return (
+    <div className="dd-workspace dd-runs">
+      <div className="dd-canvas-area">
+        {showOverview && !overviewOpen && (
+          <button
+            type="button"
+            className="dd-expand-details da-icon-btn"
+            title={t('dataAsset.development.expandRunOverview')}
+            aria-label={t('dataAsset.development.expandRunOverview')}
+            onClick={() => setOverviewOpen(true)}
+          >
+            <PanelRightOpen size={20} aria-hidden="true" />
+          </button>
+        )}
+        {(detail.error || actionError || instance?.error_message) && (
+          <div className="dd-run-errors" role="alert">
+            <span>{actionError || detail.error || instance?.error_message}</span>
+            <Button onClick={refresh}>{t('common.refresh')}</Button>
+          </div>
+        )}
+        {instance ? (
+          <WorkflowDag
+            key={instance.instance_id}
+            draft={draft}
+            tasks={tasks}
+            taskRuns={instance.task_runs}
+            readOnly
+            canvasHeight="100%"
+            canvasMinHeight={0}
+            fitViewOnResize
+            selectedNodeId={nodeId}
+            onSelectNode={(id) => {
+              setNodeId(id);
+              if (id) setOverviewOpen(true);
+            }}
+            canvasTools={
+              CANCELLABLE_INSTANCE_STATUSES.has(instance.status) ? (
+                <Button
+                  variant="primary"
+                  disabled={!!action}
+                  loading={action === `stop:${instance.instance_id}`}
+                  onClick={() => void stop(instance)}
+                >
+                  <StopIcon width={15} height={15} aria-hidden="true" />
+                  {t('dataAsset.development.stop')}
+                </Button>
+              ) : undefined
+            }
+          />
+        ) : (
+          <div className="dd-canvas-empty" role="status">
+            <History size={32} aria-hidden="true" />
+            <p>{emptyMessage}</p>
+            {detail.error && <Button onClick={detail.reload}>{t('common.retry')}</Button>}
+          </div>
+        )}
+      </div>
+      {(node || (showOverview && overviewOpen)) && (
+        <aside
+          className="dd-side-panel"
+          aria-label={t(node ? 'dataAsset.development.nodeDetails' : 'dataAsset.development.runOverview')}
+        >
+          <header className="dd-panel-header">
+            <h2 className={node ? 'dd-node-heading' : undefined}>
+              {node ? (
+                <>
+                  <ExecutorIcon executor={task?.executor_type} />
+                  <span title={node.node_name || task?.name || node.task_id}>
+                    {node.node_name || task?.name || node.task_id}
+                  </span>
+                </>
+              ) : (
+                t('dataAsset.development.runOverview')
+              )}
+            </h2>
+            {node ? (
+              <IconButton title={t('common.close')} onClick={() => setNodeId(null)}>
+                <X size={18} />
+              </IconButton>
+            ) : (
+              <div className="flex shrink-0 items-center gap-2">
+                <IconButton title={t('common.refresh')} loading={list.loading} onClick={refresh}>
+                  <RefreshCw size={16} />
+                </IconButton>
+                <IconButton
+                  title={t('dataAsset.development.collapseRunOverview')}
+                  onClick={() => setOverviewOpen(false)}
+                >
+                  <PanelRightClose size={18} aria-hidden="true" />
+                </IconButton>
+              </div>
+            )}
+          </header>
+          {node ? (
+            <div className="dd-panel-body dd-node-details">
+              <h3>{t('dataAsset.development.basicInfo')}</h3>
+              <dl className="dd-detail-fields">
+                <div>
+                  <dt>{t('dataAsset.nodeForm.task')}</dt>
+                  <dd>{task?.name || node.task_id}</dd>
+                </div>
+                <div>
+                  <dt>{t('dataAsset.nodeForm.groupName')}</dt>
+                  <dd>{node.group_name || t('dataAsset.nodeForm.defaultGroup')}</dd>
+                </div>
+              </dl>
+              <h3>{t('dataAsset.development.nodeLogs')}</h3>
+              {runs.length ? (
+                runs.map((run) => <NodeRunLogs key={run.run_id} run={run} showRunId={runs.length > 1} />)
+              ) : (
+                <p className="dd-muted">{t('dataAsset.development.nodeNotStarted')}</p>
+              )}
+            </div>
+          ) : (
+            <>
+              <div className="dd-instance-list">
+                {statusCounts && (
+                  <dl className="dd-run-summary" aria-label={t('dataAsset.development.runSummary.label')}>
+                    {(['running', 'success', 'failed', 'cancelled'] as const).map((status) => (
+                      <div key={status} data-status={status}>
+                        <dt>
+                          <RunStatusLabel status={status}>
+                            {t(`dataAsset.development.runSummary.${status}`)}
+                          </RunStatusLabel>
+                        </dt>
+                        <dd>{statusCounts[status] ?? 0}</dd>
+                      </div>
+                    ))}
+                  </dl>
+                )}
+                <div className="dd-section-label">
+                  <h3>{t('dataAsset.wfList.runHistory')}</h3>
+                </div>
+                {list.error && (
+                  <div role="alert" className="dd-error">
+                    {list.error}
+                    <Button onClick={() => void list.reload()}>{t('common.retry')}</Button>
+                  </div>
+                )}
+                {list.loading && !list.hasLoaded && (
+                  <p role="status" className="dd-muted">
+                    {t('common.loading')}
+                  </p>
+                )}
+                {list.hasLoaded && !list.items.length && (
+                  <p className="dd-muted">{t('dataAsset.development.noRuns')}</p>
+                )}
+                {list.items.map((item) => {
+                  const selected = item.instance_id === instanceId;
+                  const shown = selected && instance ? instance : item;
+                  return (
+                    <div className={`dd-instance-row${selected ? ' is-selected' : ''}`} key={item.instance_id}>
+                      <button
+                        type="button"
+                        className="dd-instance-row-main"
+                        aria-pressed={selected}
+                        onClick={() => onSelectInstance(item.instance_id)}
+                      >
+                        <span className="dd-instance-row-top">
+                          <RunStatusLabel status={shown.status}>
+                            <code title={item.instance_id}>{item.instance_id}</code>
+                            {selected && (
+                              <span className="dd-instance-state">{t(`workflowRun.status.${shown.status}`)}</span>
+                            )}
+                          </RunStatusLabel>
+                          {!selected && !CANCELLABLE_INSTANCE_STATUSES.has(shown.status) && (
+                            <time dateTime={item.created_at} title={time.date(item.created_at)}>
+                              {time.relative(item.created_at)}
+                            </time>
+                          )}
+                        </span>
+                      </button>
+                      {CANCELLABLE_INSTANCE_STATUSES.has(shown.status) && (
+                        <button
+                          type="button"
+                          className="dd-instance-stop"
+                          title={t('dataAsset.development.stop')}
+                          aria-busy={action === `stop:${item.instance_id}` || undefined}
+                          disabled={!!action}
+                          onClick={() => void stop(shown)}
+                        >
+                          {action === `stop:${item.instance_id}` ? (
+                            <RefreshCw size={16} className="da-spin" aria-hidden="true" />
+                          ) : (
+                            <StopIcon width={16} height={16} aria-hidden="true" />
+                          )}
+                          {t('dataAsset.development.stop')}
+                        </button>
+                      )}
+                      {selected && <InstanceTimes instance={shown} />}
+                    </div>
+                  );
+                })}
+              </div>
+              {list.hasLoaded && (
+                <div className="dd-instance-pagination">
+                  <Pagination
+                    total={list.total}
+                    page={page}
+                    pageSize={pageSize}
+                    onPageChange={setPage}
+                    onPageSizeChange={(size) => {
+                      setPageSize(size);
+                      setPage(1);
+                    }}
+                    loading={list.loading}
+                    labels={{
+                      total: t('common.pagination.total', { count: list.total }),
+                      pageSize: t('common.pagination.pageSize'),
+                      previous: t('common.pagination.previous'),
+                      next: t('common.pagination.next'),
+                      page: (value) => t('common.pagination.page', { page: value }),
+                      navLabel: t('common.pagination.navLabel'),
+                    }}
+                  />
+                </div>
+              )}
+            </>
+          )}
+        </aside>
+      )}
+    </div>
+  );
+}
