+def _snapshot(run_id: str, snapshot_id: str, column_type: str = "decimal",
+              include_amount: bool = True) -> MetadataSnapshot:
+    columns = [
+        ColumnMeta("orders", "mysql", "app", "orders", "id", "bigint", "bigint", 1, False, "PRI", True),
+        ColumnMeta("orders", "mysql", "app", "orders", "phone", "varchar", "varchar(20)", 2, True,
+                   is_sensitive=True, sensitivity_class="phone", top_k=[{"value": "13800000000", "count": 1}]),
+    ]
+    if include_amount:
+        columns.append(ColumnMeta("orders", "mysql", "app", "orders", "amount", column_type, column_type, 3))
+    table = TableMeta("orders", "mysql", "app", "orders", row_count=100, columns=columns)
+    snapshot = MetadataSnapshot(
+        snapshot_id,
+        run_id,
+        DataSourceMeta("orders", "mysql", "mysql://db:3306/app"),
+        [DatabaseMeta("orders", "mysql", "app")],
+        [table],
+        scope={"schemas": ["app"]},
+    )
+    return apply_fingerprints(snapshot)
