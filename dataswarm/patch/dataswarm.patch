+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  buildColumnLineageRows,
+  filterColumnLineageRows,
+} from '../node_modules/.cache/column-lineage/columnLineageModel.mjs';
+
+test('keeps same-named tables and fields in different databases distinct', () => {
+  const rows = buildColumnLineageRows({
+    nodes: [],
+    edges: [
+      { from: 'warehouse_a.orders.id', to: 'warehouse_a.detail.id', transformation: null },
+      { from: 'warehouse_b.orders.id', to: 'warehouse_b.detail.id', transformation: null },
+    ],
+  });
+  assert.equal(rows.length, 4);
+  const filtered = filterColumnLineageRows(rows, 'warehouse_b.detail', '');
+  assert.equal(filtered.length, 1);
+  assert.deepEqual(filtered[0].sources, [{ id: 'warehouse_b.orders.id', transformation: null }]);
+});
+
+test('preserves different transformations and removes only identical relations', () => {
+  const edge = { from: 'source.price', to: 'report.total', transformation: 'SUM(price)' };
+  const rows = buildColumnLineageRows({
+    nodes: [],
+    edges: [edge, { ...edge }, { ...edge, transformation: 'MAX(price)' }],
+  });
+  const target = rows.find((row) => row.id === 'report.total');
+  assert.deepEqual(
+    target.sources.map((ref) => ref.transformation),
+    ['SUM(price)', 'MAX(price)'],
+  );
+});
+
+test('shows cycles and self-relations without pruning, synthesizing or looping', () => {
+  const rows = buildColumnLineageRows({
+    nodes: [],
+    edges: [
+      { from: 'a.id', to: 'b.id', transformation: null },
+      { from: 'b.id', to: 'a.id', transformation: null },
+      { from: 'a.id', to: 'a.id', transformation: 'id + 1' },
+    ],
+  });
+  assert.equal(rows.length, 2);
+  assert.deepEqual(
+    rows[0].sources.map((ref) => ref.id),
+    ['b.id', 'a.id'],
+  );
+  assert.deepEqual(
+    rows[0].targets.map((ref) => ref.id),
+    ['b.id', 'a.id'],
+  );
+});
+
+test('retains disconnected nodes and endpoint records even when node metadata is absent', () => {
+  const rows = buildColumnLineageRows({
+    nodes: [{ id: 'isolated.field' }, { id: 'standalone' }],
+    edges: [{ from: 'source.field', to: 'target.field', transformation: null }],
+  });
+  assert.equal(rows.length, 4);
+  const isolated = rows.find((row) => row.id === 'isolated.field');
+  assert.deepEqual(isolated.sources, []);
+  assert.deepEqual(isolated.targets, []);
+  assert.equal(rows.find((row) => row.id === 'standalone').column, 'standalone');
+});
+
+test('search covers upstream, downstream and full expressions within the selected table', () => {
+  const rows = buildColumnLineageRows({
+    nodes: [],
+    edges: [
+      { from: 'orders.price', to: 'daily.total', transformation: 'SUM(price)' },
+      { from: 'orders.customer_id', to: 'daily.users', transformation: 'COUNT(DISTINCT customer_id)' },
+    ],
+  });
+  assert.deepEqual(
+    filterColumnLineageRows(rows, 'orders', 'daily.total').map((row) => row.id),
+    ['orders.price'],
+  );
+  assert.deepEqual(
+    filterColumnLineageRows(rows, 'daily', ' COUNT(DISTINCT ').map((row) => row.id),
+    ['daily.users'],
+  );
+  assert.equal(filterColumnLineageRows(rows, '', 'missing').length, 0);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/dagLayout.test.mjs b/jiuwenswarm/channels/web/frontend/tests/dagLayout.test.mjs
new file mode 100644
index 000000000..c6b2fa751
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/tests/dagLayout.test.mjs
@@ -0,0 +1,230 @@
+/**
+ * dagLayout —— 工作流 DAG 布局纯逻辑测试。
+ *
+ * 守卫 layeredLayout（拓扑分层 + 层内重心排序）：
+ *  - 分层正确：入度 0 在第 0 层，y 坐标 = 层号 × gapY
+ *  - 重心排序减少交叉：菱形/交叉场景下同层节点按邻居重心聚拢
+ *  - 确定性：同输入多次调用输出一致
+ *  - 边界：空图、单节点、成环节点（topoLayers 兜底层 0）
+ *
+ * 守卫 channelPolyline（通道式直角边布线）：
+ *  - 端点吸附：折线首尾落在源右缘/目标左缘
+ *  - 不穿框：跨层长边（源第 0 层 → 目标第 2 层，中间层有同列节点）折线不经过任何节点框内部
+ *  - 并行错开：同源扇出边出口竖线 x 逐条错开，同目标扇入边入口竖线 x 逐条错开
+ *  - 性质：多链+长跨边混合 DAG 中所有边折线都不穿过任何节点框内部
+ */
+
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { layeredLayout, channelPolyline, GAP_X, GAP_Y, NODE_W } from '../node_modules/.cache/dag-layout/dagLayout.mjs';
+
+// 节点估算高：路由横段依托层距与节点高之差，测试按渲染近似值 62 校验
+const NODE_H = 62;
+
+/** 线段 a-b 是否严格穿过矩形 rect 内部（轴对齐；仅贴边/端点相切不算） */
+function segmentHitsInterior(a, b, rect) {
+  const [x1, x2] = a.x < b.x ? [a.x, b.x] : [b.x, a.x];
+  const [y1, y2] = a.y < b.y ? [a.y, b.y] : [b.y, a.y];
+  const rx2 = rect.x + rect.w;
+  const ry2 = rect.y + rect.h;
+  if (y1 === y2) {
+    // 水平段：y 严格落在框的纵向内部，且 x 区间与框横向内部有正长度交叠
+    if (!(y1 > rect.y && y1 < ry2)) return false;
+    const lo = Math.max(x1, rect.x);
+    const hi = Math.min(x2, rx2);
+    return hi > lo;
+  }
+  // 竖直段：x 严格落在框的横向内部，且 y 区间与框纵向内部有正长度交叠
+  if (!(x1 > rect.x && x1 < rx2)) return false;
+  const lo = Math.max(y1, rect.y);
+  const hi = Math.min(y2, ry2);
+  return hi > lo;
+}
+
+/** 折线是否穿过任一节点框内部 */
+function polylineHitsAnyBox(pts, rects) {
+  for (let i = 0; i < pts.length - 1; i++) {
+    for (const r of rects) {
+      if (segmentHitsInterior(pts[i], pts[i + 1], r)) return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * 从节点列表 + 上游关系算出布局，验证每条上游边的通道折线不穿过任何节点框内部。
+ * 返回校验过的边数。
+ */
+function assertNoEdgeCrossesBox(nodes) {
+  const pos = layeredLayout(nodes, GAP_X, GAP_Y);
+  const rects = nodes.map((nd) => ({ x: pos[nd.node_id].x, y: pos[nd.node_id].y, w: NODE_W, h: NODE_H }));
+  let checked = 0;
+  nodes.forEach((nd) => {
+    const ups = String(nd.upstream_nodes ?? '').split(',').map((x) => x.trim()).filter(Boolean);
+    ups.forEach((u) => {
+      const s = pos[u];
+      const t = pos[nd.node_id];
+      assert.ok(s, `上游 ${u} 应在布局中`);
+      const pts = channelPolyline(s.x + NODE_W, s.y + NODE_H / 2, t.x, t.y + NODE_H / 2);
+      assert.equal(polylineHitsAnyBox(pts, rects), false, `边 ${u}→${nd.node_id} 折线穿过了节点框`);
+      checked += 1;
+    });
+  });
+  return checked;
+}
+
+/** 构造 NodeInput 形状的最小节点 */
+function n(id, upstream = []) {
+  return { node_id: id, task_id: `t_${id}`, upstream_nodes: upstream.join(',') };
+}
+
+/** 统计布局中交叉的边对数（同层相邻对之间，简化：按 x 区间是否重叠粗判） */
+function countCrossings(pos, edges) {
+  let crossings = 0;
+  for (let i = 0; i < edges.length; i++) {
+    for (let j = i + 1; j < edges.length; j++) {
+      const [a1, b1] = edges[i];
+      const [a2, b2] = edges[j];
+      if (a1 === a2 || b1 === b2 || a1 === b2 || a2 === b1) continue;
+      const [s1, t1] = [pos[a1].x, pos[b1].x];
+      const [s2, t2] = [pos[a2].x, pos[b2].x];
+      // 两条边端点互相错开（一个的起点在另一个起点同侧之外）即交叉
+      if ((s1 - s2) * (t1 - t2) < 0) crossings += 1;
+    }
+  }
+  return crossings;
+}
+
+test('layeredLayout: 空图返回空对象', () => {
+  assert.deepEqual(layeredLayout([], 300, 200), {});
+});
+
+test('layeredLayout: 单节点在原点', () => {
+  const pos = layeredLayout([n('a')], 300, 200);
+  assert.deepEqual(pos.a, { x: 0, y: 0 });
+});
+
+test('layeredLayout: 链式节点按层排布', () => {
+  const pos = layeredLayout([n('a'), n('b', ['a']), n('c', ['b'])], 300, 200);
+  assert.equal(pos.a.y, 0);
+  assert.equal(pos.b.y, 200);
+  assert.equal(pos.c.y, 400);
+});
+
+test('layeredLayout: 菱形场景下游聚拢在同一层', () => {
+  // a → b, a → c, b → d, c → d
+  const nodes = [n('a'), n('b', ['a']), n('c', ['a']), n('d', ['b', 'c'])];
+  const pos = layeredLayout(nodes, 300, 200);
+  assert.equal(pos.b.y, 200);
+  assert.equal(pos.c.y, 200);
+  assert.equal(pos.d.y, 400);
+});
+
+test('layeredLayout: 交叉场景重心排序减少交叉', () => {
+  // 初始序 a1,a2 → b1,b2 连线是 a1→b2, a2→b1（交叉）。
+  // 重心排序后应交换为 a2 在前，消除交叉。
+  const nodes = [n('a1'), n('a2'), n('b1', ['a2']), n('b2', ['a1'])];
+  const pos = layeredLayout(nodes, 300, 200);
+  const edges = [['a1', 'b2'], ['a2', 'b1']];
+  assert.equal(countCrossings(pos, edges), 0);
+});
+
+test('layeredLayout: 确定性——同输入两次调用输出一致', () => {
+  const nodes = [
+    n('a'), n('b'), n('c'),
+    n('d', ['a', 'b']), n('e', ['b', 'c']), n('f', ['a', 'c']),
+    n('g', ['d', 'e', 'f']),
+  ];
+  const p1 = layeredLayout(nodes, 300, 200);
+  const p2 = layeredLayout(nodes, 300, 200);
+  assert.deepEqual(p1, p2);
+});
+
+test('layeredLayout: 成环节点兜底在第 0 层不崩溃', () => {
