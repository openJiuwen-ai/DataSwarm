@@ -0,0 +1,155 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""analysis/views.py —— context/plan 响应的 dataclass → JSON dict 序列化视图。
+
+从 service.py 拆出的纯序列化层：无回源、无副作用。字段集是编排层 LLM 的
+stdout 契约——字段名或语义变更等于行为变更，须评测护航，重排只搬运。
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from .model import GRAPH_MEASURES_PREFIX, RoadResult
+
+
+def road_view(road: RoadResult) -> dict[str, Any]:
+    return {
+        "channel_status": road.channel_status,
+        "raw_count": road.raw_count,
+        "hits": [
+            {
+                "kind": hit.kind,
+                "entity_id": hit.entity_id,
+                "label": hit.label,
+                "rrf_score": round(hit.rrf_score, 6),
+                "rank": hit.rank,
+                "channels": [[name, score] for name, score in hit.channels],
+                "matched_on": list(hit.matched_on),
+                "payload": hit.payload,
+            }
+            for hit in road.hits
+        ],
+    }
+
+
+def expansion_view(expansion) -> dict[str, Any]:
+    """图补全过程明细（评审可观测：走了哪条路、带出什么、丢弃什么）。"""
+    return {
+        "graph_status": expansion.graph_status,
+        "graph_path": expansion.graph_path,
+        "metrics_added": [
+            {
+                "metric_key": hit.entity_id,
+                "display_name": hit.payload.get("display_name") or hit.label,
+                "via": hit.matched_on,
+            }
+            for hit in expansion.metrics
+        ],
+        "terms_added": [
+            {"term_id": term.get("term_id"), "name": term.get("name"),
+             "via": GRAPH_MEASURES_PREFIX}
+            for term in expansion.terms
+        ],
+        "columns_added": [
+            {"entity_id": hit.entity_id, "label": hit.label, "via": hit.matched_on}
+            for hit in expansion.columns
+        ],
+        "tables_touched": list(expansion.tables),
+        "joins": expansion.joins,
+        "dropped": expansion.dropped,
+        "warnings": expansion.warnings,
+        "knowledge": expansion.knowledge_trace,
+    }
+
+
+def packs_view(packs) -> dict[str, Any]:
+    return {
+        "knowledge_assets": packs.knowledge_assets,
+        "knowledge_rules": packs.knowledge_rules,
+        "knowledge_rule_trace": packs.knowledge_rule_trace,
+        "glossary": packs.glossary,
+        "metrics_candidates": packs.metrics_candidates,
+        "metrics_selected": packs.metrics_selected,
+        "schema_tables": [
+            {
+                "table": pack.table,
+                "table_id": pack.table_id,
+                "source_id": pack.source_id,
+                "snapshot_id": pack.snapshot_id,
+                "comment": pack.comment,
+                "columns": pack.columns,
+                "joins": pack.joins,
+            }
+            for pack in packs.schema_tables
+        ],
+    }
+
+
+def plan_view(plan) -> dict[str, Any]:
+    return {
+        "analysis_id": plan.analysis_id,
+        "question": plan.question,
+        "source_id": plan.source_id,
+        "release_id": plan.release_id,
+        "mode": plan.mode,
+        "facets": list(plan.facets),
+        "coverage": plan.coverage,
+        "budget": plan.budget,
+        "components": [
+            {
+                "component_id": c.component_id,
+                "text": c.text,
+                "selected_metrics": list(c.selected_metrics),
+                "derived_metrics": list(c.derived_metrics),
+                "dimensions": list(c.dimensions),
+                "time": c.time,
+                "filters": [
+                    {"field": f.field, "op": f.op, "value": f.value,
+                     "status": f.status, "value_source": f.value_source}
+                    for f in c.filters
+                ],
+                "depends_on": list(c.depends_on),
+                "output": c.output,
+                "status": c.status,
+                "role": c.role,
+                "facet_id": c.facet_id,
+                "required": c.required,
+                "priority": c.priority,
+                "evidence_requirement": c.evidence_requirement,
+                "material_refs": list(c.material_refs),
+            }
+            for c in plan.components
+        ],
+        "uncovered": list(plan.uncovered),
+    }
+
+
+def material_views(packs: dict[str, Any]) -> list[dict[str, Any]]:
+    """将候选子包投影为带来源和稳定 ID 的分析素材菜单。"""
+    materials: list[dict[str, Any]] = []
+    knowledge = {item["asset_id"]: item for item in
+                 [*(packs.get("knowledge_assets") or []), *(packs.get("knowledge_rules") or [])]}
+    for item in knowledge.values():
+        # 规则/映射素材只出引用形态：正文已在同包 knowledge_assets/knowledge_rules
+        # 完整出现，materials 再展开一份等于同一 stdout 双份全文（实测 11 条规则
+        # 双视图 22K 字符）。plan 校验只读 material_id 集合，不依赖此处正文。
+        materials.append({"material_id": f"{item['asset_type']}:{item['asset_id']}",
+                          "kind": item["asset_type"], "asset_id": item["asset_id"],
+                          "title": item.get("title") or ""})
+    for item in packs.get("metrics_candidates") or ():
+        materials.append({"material_id": f"metric:{item['metric_key']}", "kind": "metric", **item})
+    for item in packs.get("glossary") or ():
+        materials.append({"material_id": f"term:{item['term_id']}", "kind": "term", **item})
+    for table in packs.get("schema_tables") or ():
+        for column in table.get("columns") or ():
+            materials.append({
+                "material_id": column["node_id"], "kind": "column", "name": column["name"],
+                "table": table["table"], "source_id": table["source_id"],
+                "snapshot_id": table["snapshot_id"], "comment": column.get("comment") or "",
+            })
+            # 维度素材是列素材的引用别名（material_id 前缀区分）：validate_plan 按
+            # 「dimension:<node_id>」字符串匹配，不读本条其余字段，只留可读标识。
+            materials.append({
+                "material_id": f"dimension:{column['node_id']}", "kind": "dimension",
+                "name": column["name"], "table": table["table"],
+            })
+    return materials
