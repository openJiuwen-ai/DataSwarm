+def _snapshot_for_extract(*, include_region: bool = True):
+    from jiuwenswarm.channels.web.dataagent.semantic.model import (
+        ColumnMeta,
+        DatabaseMeta,
+        DataSourceMeta,
+        MetadataSnapshot,
+        TableMeta,
+    )
+
+    columns = [
+        ColumnMeta("src", "mysql", "shop", "orders", "order_status",
+                   data_type="varchar", ordinal=1, comment="订单状态"),
+    ]
+    if include_region:
+        columns.append(
+            ColumnMeta("src", "mysql", "shop", "orders", "region",
+                       data_type="varchar", ordinal=2, comment="销售区域"))
+    # 高基数（应被 distinct 门槛拦下）与敏感列（应被排除）与数值列（无取值语义）
+    columns.append(ColumnMeta("src", "mysql", "shop", "orders", "phone",
+                              data_type="varchar", ordinal=3, is_sensitive=True))
+    columns.append(ColumnMeta("src", "mysql", "shop", "orders", "amount",
+                              data_type="decimal", ordinal=4))
+    table = TableMeta("src", "mysql", "shop", "orders", columns=columns)
+    return MetadataSnapshot(
+        "snapshot:src:run-1", "run-1",
+        DataSourceMeta("src", "mysql", "mysql://db:3306/shop"),
+        [DatabaseMeta("src", "mysql", "shop")],
+        [table],
+    )
+
