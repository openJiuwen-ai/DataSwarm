+# ==========================================================================
+# meta：改判留痕（阶段二，docs/analysis/analysis-intent-layer-design.md §5.2）
+# ==========================================================================
+
+
+def _seed_intent(workspace, intent: str) -> None:
+    """给 a1 的 manifest 预置 intent_normalized（模拟 init --meta-file 后的账本）。"""
+    manifest = _manifest(workspace)
+    manifest["intent_normalized"] = dict(_INTENT_META, intent=intent)
+    (workspace / "a1" / "manifest.json").write_text(
+        json.dumps(manifest, ensure_ascii=False), encoding="utf-8")
+
+
+def test_meta_rewrites_intent_and_keeps_revision(af, workspace, capsys):
+    """改判覆盖 intent_normalized，旧值进 intent_revisions（初判→终判审计链不断）。"""
+    _seed_intent(workspace, "analysis")
+    revised = dict(_INTENT_META, intent="diagnosis")
+    meta_file = workspace / "revised.json"
+    meta_file.write_text(json.dumps(revised, ensure_ascii=False), encoding="utf-8")
+    code = af.cmd_meta(_args(analysis_id="a1", meta_file=str(meta_file)))
+    assert code == 0
+    out = json.loads(capsys.readouterr().out)
+    assert out["intent"] == "diagnosis"
+    assert out["revised_from"] == "analysis"
+    saved = _manifest(workspace)
+    assert saved["intent_normalized"]["intent"] == "diagnosis"
+    assert [r["intent"] for r in saved["intent_revisions"]] == ["analysis"]
+
+
+def test_meta_invalid_intent_keeps_manifest(af, workspace):
+    """intent 非六值 → SystemExit，manifest 原样（校验先于写盘，不落半个账本）。"""
+    _seed_intent(workspace, "analysis")
+    bad = dict(_INTENT_META, intent="wrong")
+    meta_file = workspace / "bad.json"
+    meta_file.write_text(json.dumps(bad, ensure_ascii=False), encoding="utf-8")
+    with pytest.raises(SystemExit) as excinfo:
+        af.cmd_meta(_args(analysis_id="a1", meta_file=str(meta_file)))
+    assert "intent" in str(excinfo.value)
+    saved = _manifest(workspace)
+    assert saved["intent_normalized"]["intent"] == "analysis"
+    assert "intent_revisions" not in saved
+
+
+def test_meta_without_initial_intent_sets_it(af, workspace, capsys):
+    """init 未带 meta 的旧会话（无 intent_normalized）→ meta 直接补设，无 revisions。"""
+    meta_file = workspace / "intent.json"
+    meta_file.write_text(json.dumps(_INTENT_META, ensure_ascii=False), encoding="utf-8")
+    code = af.cmd_meta(_args(analysis_id="a1", meta_file=str(meta_file)))
+    assert code == 0
+    out = json.loads(capsys.readouterr().out)
+    assert out["intent"] == "analysis"
+    assert "revised_from" not in out
+    saved = _manifest(workspace)
+    assert saved["intent_normalized"]["intent"] == "analysis"
+    assert "intent_revisions" not in saved
+
+
+def test_read_json_arg_tolerates_file_path_in_json_flag(af, tmp_path):
+    """回归：--*-json 收到文件路径时按文件读。模型高频把路径误传给内联参数
+    （funcverify-1029 olist-02/06 两轮、full-v7fix-1028 ck-24 同型，各烧一轮自愈）——
+    路径与内联 JSON 以首字符区分（对象/数组必以 { [ 开头），歧义面为零。"""
+    f = tmp_path / "batch.json"
+    f.write_text(json.dumps([{"component_id": "c1"}]), encoding="utf-8")
+    assert af._read_json_arg(None, str(f)) == [{"component_id": "c1"}]
+    # 内联 JSON 行为不变
+    assert af._read_json_arg(None, '[{"component_id": "c1"}]') == [{"component_id": "c1"}]
+    # 既不是内联也不是现存文件 → 原有友好报错保持
+    with pytest.raises(SystemExit):
+        af._read_json_arg(None, "not-a-file-or-inline-json")
