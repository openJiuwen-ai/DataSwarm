@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { isInternalRouteHref, linkifyBareInternalRoutes } from '../node_modules/.cache/markdown-internal-routes/components/MarkdownRenderer/internalRoutes.js';
+
+test('linkifies a bare internal route written as plain text', () => {
+  const content = '可在 WebUI「库表管理」（/data-management/tables?db=bond）查看这两张表。';
+
+  assert.equal(
+    linkifyBareInternalRoutes(content),
+    '可在 WebUI「库表管理」（[/data-management/tables?db=bond](/data-management/tables?db=bond)）查看这两张表。'
+  );
+});
+
+test('linkifies a bare route at the start of the content', () => {
+  assert.equal(
+    linkifyBareInternalRoutes('/governance/overview?run_id=42 是质检入口'),
+    '[/governance/overview?run_id=42](/governance/overview?run_id=42) 是质检入口'
+  );
+});
+
+test('keeps an existing markdown link untouched and stays idempotent', () => {
+  const content = '[📊 库表管理](/data-management/tables?db=bond)';
+
+  assert.equal(linkifyBareInternalRoutes(content), content);
+  assert.equal(linkifyBareInternalRoutes(linkifyBareInternalRoutes(content)), content);
+});
+
+test('skips code blocks and inline code', () => {
+  const content = [
+    '说明如下：',
+    '```',
+    'open /data-management/tables?db=bond',
+    '```',
+    '行内代码 `/data-management/tables?db=bond` 也不处理。',
+  ].join('\n');
+
+  assert.equal(linkifyBareInternalRoutes(content), content);
+});
+
+test('does not linkify paths inside external URLs', () => {
+  const content = '参考 https://example.com/data-management/tables?db=bond 的说明。';
+
+  assert.equal(linkifyBareInternalRoutes(content), content);
+});
+
+test('drops trailing punctuation from the generated link', () => {
+  assert.equal(
+    linkifyBareInternalRoutes('入口是 /data-management/tables?db=bond, 点击即可。'),
+    '入口是 [/data-management/tables?db=bond](/data-management/tables?db=bond), 点击即可。'
+  );
+});
+
+test('recognizes all internal route prefixes', () => {
+  assert.equal(isInternalRouteHref('/governance/overview'), true);
+  assert.equal(isInternalRouteHref('/data-management/tables?db=bond'), true);
+  assert.equal(isInternalRouteHref('/dataagent/dashboard/dashboards'), true);
+  assert.equal(isInternalRouteHref('https://example.com/data-management/tables'), false);
+  assert.equal(isInternalRouteHref(undefined), false);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/markdownRendererDom.test.mjs b/jiuwenswarm/channels/web/frontend/tests/markdownRendererDom.test.mjs
