+    connector = DuckDBConnector(source)
+    assert connector._is_warehouse_source() is True
+
+    real_execute = type(connector._connection()).execute
+
+    def _no_excel_extension(conn_self, sql, *args, **kwargs):
+        if "read_xlsx" in str(sql).lower():
+            raise RuntimeError("extension excel not found (offline)")
+        return real_execute(conn_self, sql, *args, **kwargs)
+
+    monkeypatch.setattr("duckdb.DuckDBPyConnection.execute", _no_excel_extension)
+    try:
