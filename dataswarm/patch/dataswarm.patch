@@ -0,0 +1,238 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import i18n from '../../../i18n';
+// 任务编排 REST API 层。照抄 inspectionApi 的 request 封装，端点指向 /api/dataagent/orchestration/*。
+// （方案 docs/skill-cli-web-api-plan.md §5.2：由旧 /api/orchestration/* 切换，旧路径经适配层转发并标 Deprecation。）
+
+import type {
+  Instance,
+  InstancePage,
+  InstanceQuery,
+  LineagePreview,
+  TaskDefinition,
+  TaskPage,
+  TaskRun,
+  WorkflowDefinition,
+  WorkflowNode,
+  WorkflowPage,
+  NodeInput,
+} from '../types/orchestration';
+import {
+  ensureDatasourceWorkspaceId,
+  responseBelongsToCurrentWorkspace,
+} from '../../../stores/datasourceWorkspaceStore';
+
+export class OrchestrationApiError extends Error {
+  constructor(message: string, public readonly status: number) {
+    super(message);
+    this.name = 'OrchestrationApiError';
+  }
+}
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  // 多工作空间（P2-4）：治理页 API 统一注入当前 workspace_id（后端缺省语义按配置分流）
+  const wsId = await ensureDatasourceWorkspaceId();
+  const requestAt = wsId;
+  const target = wsId ? `${url}${url.includes('?') ? '&' : '?'}workspace_id=${encodeURIComponent(wsId)}` : url;
+  const response = await fetch(target, {
+    ...init,
+    headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...init?.headers },
+  });
+  const payload = (await response.json().catch(() => ({}))) as Record<string, unknown>;
+  if (!response.ok || payload.ok === false) {
+    const detail =
+      typeof payload.detail === 'string'
+        ? payload.detail
+        : typeof payload.error === 'string'
+          ? payload.error
+          : `${response.status} ${response.statusText}`;
+    const key = `dataAsset.apiErrors.${detail}`;
+    throw new OrchestrationApiError(i18n.exists(key) ? String(i18n.t(key)) : detail, response.status);
+  }
+  // 并发隔离（决策四 / 二轮 R5）：请求期间切换了工作空间且响应体带 workspace_id → 丢弃
+  if (!responseBelongsToCurrentWorkspace(payload, requestAt)) {
+    throw new Error('workspace_changed');
+  }
+  return payload as T;
+}
+
+const enc = encodeURIComponent;
+
+export interface TaskInput {
+  name?: string;
+  description?: string;
+  executor_type?: 'sql' | 'python';
+  code?: string;
+  params?: Record<string, unknown>;
+  datasource_ref?: string;
+  timeout_s?: number;
+  retry_count?: number;
+  retry_interval_s?: number;
+  schedule_type?: 'none' | 'once' | 'cron';
+  schedule_cron?: string;
+  schedule_once_at?: string;
+}
+
+export interface WorkflowInput {
+  name?: string;
+  description?: string;
+  schedule_type?: 'none' | 'once' | 'cron';
+  schedule_cron?: string;
+  schedule_once_at?: string;
+  enabled?: boolean;
+}
+
+export const orchestrationApi = {
+  // Option pickers require the complete catalogue, not the first page.
+  allTasks: async () => {
+    const tasks: TaskDefinition[] = [];
+    let total: number;
+    do {
+      const page = await orchestrationApi.listTasks({ limit: 100, offset: tasks.length });
+      if (
+        !Array.isArray(page.tasks) ||
+        !Number.isInteger(page.total) ||
+        page.total < 0 ||
+        (!page.tasks.length && tasks.length < page.total)
+      )
+        throw new Error(i18n.t('dataAsset.apiErrors.incompleteTaskCatalogue'));
+      tasks.push(...page.tasks);
+      total = page.total;
+    } while (tasks.length < total);
+    return tasks;
+  },
+  // ---- 任务 ----
+  listTasks: (q: { q?: string; limit?: number; offset?: number } = {}) => {
+    const params = new URLSearchParams();
+    if (q.q != null) params.set('q', q.q);
+    if (q.limit != null) params.set('limit', String(q.limit));
+    if (q.offset != null) params.set('offset', String(q.offset));
+    const qs = params.toString();
+    return request<TaskPage>(`/api/dataagent/orchestration/tasks${qs ? `?${qs}` : ''}`);
+  },
+  getTask: (id: string) => request<TaskDefinition>(`/api/dataagent/orchestration/tasks/${enc(id)}`),
+  createTask: (input: TaskInput) =>
+    request<TaskDefinition>('/api/dataagent/orchestration/tasks', { method: 'POST', body: JSON.stringify(input) }),
+  updateTask: (id: string, input: TaskInput) =>
+    request<TaskDefinition>(`/api/dataagent/orchestration/tasks/${enc(id)}/update`, {
+      method: 'POST',
+      body: JSON.stringify(input),
+    }),
+  deleteTask: (id: string) =>
+    request<{ ok: boolean }>(`/api/dataagent/orchestration/tasks/${enc(id)}/delete`, { method: 'POST', body: '{}' }),
+  publishTask: (id: string) =>
+    request<TaskDefinition>(`/api/dataagent/orchestration/tasks/${enc(id)}/publish`, { method: 'POST', body: '{}' }),
+  unpublishTask: (id: string) =>
+    request<TaskDefinition>(`/api/dataagent/orchestration/tasks/${enc(id)}/unpublish`, { method: 'POST', body: '{}' }),
+  debugTask: (id: string) =>
+    request<Instance>(`/api/dataagent/orchestration/tasks/${enc(id)}/debug`, { method: 'POST', body: '{}' }),
+  // 解析 SQL 预览血缘（不落库，供建任务时实时看会产出什么血缘）
+  previewLineage: (code: string, datasourceRef?: string) =>
+    request<LineagePreview>('/api/dataagent/orchestration/tasks/preview-lineage', {
+      method: 'POST',
+      body: JSON.stringify({ code, datasource_ref: datasourceRef }),
+    }),
+
+  // ---- 工作流 ----
+  /** 下拉筛选需要完整目录，按服务端 total 读取全部分页。 */
+  allWorkflows: async () => {
+    const workflows: WorkflowDefinition[] = [];
+    let total: number;
+    do {
+      const page = await orchestrationApi.listWorkflows({ limit: 100, offset: workflows.length });
+      if (
+        !Array.isArray(page.workflows) ||
+        !Number.isInteger(page.total) ||
+        page.total < 0 ||
+        (!page.workflows.length && workflows.length < page.total)
+      )
+        throw new Error(i18n.t('dataAsset.apiErrors.incompleteWorkflowCatalogue'));
+      workflows.push(...page.workflows);
+      total = page.total;
+    } while (workflows.length < total);
+    return workflows;
+  },
+  /** 服务端搜索 + 分页（后端已支持 q/limit/offset，返回带 total） */
+  listWorkflows: (q: { q?: string; status?: 'draft' | 'published'; limit?: number; offset?: number } = {}) => {
+    const params = new URLSearchParams();
+    if (q.status) params.set('status', q.status);
+    if (q.q != null) params.set('q', q.q);
+    if (q.limit != null) params.set('limit', String(q.limit));
+    if (q.offset != null) params.set('offset', String(q.offset));
+    const qs = params.toString();
+    return request<WorkflowPage>(`/api/dataagent/orchestration/workflows${qs ? `?${qs}` : ''}`);
+  },
+  getWorkflow: (id: string) => request<WorkflowDefinition>(`/api/dataagent/orchestration/workflows/${enc(id)}`),
+  createWorkflow: (input: WorkflowInput) =>
+    request<WorkflowDefinition>('/api/dataagent/orchestration/workflows', {
+      method: 'POST',
+      body: JSON.stringify(input),
+    }),
+  updateWorkflow: (id: string, input: WorkflowInput) =>
+    request<WorkflowDefinition>(`/api/dataagent/orchestration/workflows/${enc(id)}/update`, {
+      method: 'POST',
+      body: JSON.stringify(input),
+    }),
+  deleteWorkflow: (id: string) =>
+    request<{ ok: boolean }>(`/api/dataagent/orchestration/workflows/${enc(id)}/delete`, {
+      method: 'POST',
+      body: '{}',
+    }),
+  publishWorkflow: (id: string) =>
+    request<WorkflowDefinition>(`/api/dataagent/orchestration/workflows/${enc(id)}/publish`, {
+      method: 'POST',
+      body: '{}',
+    }),
+  unpublishWorkflow: (id: string) =>
+    request<WorkflowDefinition>(`/api/dataagent/orchestration/workflows/${enc(id)}/unpublish`, {
+      method: 'POST',
+      body: '{}',
+    }),
+  // 原有工作流入口：暂停该工作流最近一个 running/queued 实例。
+  pauseWorkflow: (id: string) =>
+    request<Instance>(`/api/dataagent/orchestration/workflows/${enc(id)}/pause`, { method: 'POST', body: '{}' }),
+  debugWorkflow: (id: string) =>
+    request<Instance>(`/api/dataagent/orchestration/workflows/${enc(id)}/debug`, { method: 'POST', body: '{}' }),
+  // 调度开关（方案 §5.1：enable 仅允许 published，draft 返回 409）
+  enableWorkflow: (id: string) =>
+    request<WorkflowDefinition>(`/api/dataagent/orchestration/workflows/${enc(id)}/enable`, {
+      method: 'POST',
+      body: '{}',
+    }),
+  disableWorkflow: (id: string) =>
+    request<WorkflowDefinition>(`/api/dataagent/orchestration/workflows/${enc(id)}/disable`, {
+      method: 'POST',
+      body: '{}',
+    }),
+  saveNodes: (id: string, nodes: NodeInput[]) =>
+    request<{ nodes: WorkflowNode[] }>(`/api/dataagent/orchestration/workflows/${enc(id)}/nodes`, {
+      method: 'POST',
+      body: JSON.stringify({ nodes }),
+    }),
+
+  // ---- 实例与日志 ----
+  listInstances: (q: InstanceQuery = {}) => {
+    const params = new URLSearchParams();
+    if (q.q) params.set('q', q.q);
+    if (q.ref_type) params.set('ref_type', q.ref_type);
+    if (q.ref_id) params.set('ref_id', q.ref_id);
+    if (q.trigger_type) params.set('trigger_type', q.trigger_type);
+    if (q.limit != null) params.set('limit', String(q.limit));
+    if (q.offset != null) params.set('offset', String(q.offset));
+    const qs = params.toString();
+    return request<InstancePage>(`/api/dataagent/orchestration/instances${qs ? `?${qs}` : ''}`);
+  },
+  getInstance: (id: string) => request<Instance>(`/api/dataagent/orchestration/instances/${enc(id)}`),
+  listTaskRuns: (instanceId: string) =>
+    request<{ task_runs: TaskRun[] }>(`/api/dataagent/orchestration/instances/${enc(instanceId)}/task-runs`),
+  getLog: (runId: string, stream: 'stdout' | 'stderr') =>
+    request<{ log: string; stream: string; run_id: string }>(
+      `/api/dataagent/orchestration/task-runs/${enc(runId)}/logs?stream=${stream}`,
+    ),
+  approveInstance: (id: string) =>
+    request<Instance>(`/api/dataagent/orchestration/instances/${enc(id)}/approve`, { method: 'POST', body: '{}' }),
+  resumeInstance: (id: string) =>
+    request<Instance>(`/api/dataagent/orchestration/instances/${enc(id)}/resume`, { method: 'POST', body: '{}' }),
+  // 取消实例（方案 §5.3：终态幂等；cancelled 不支持 resume）
+  cancelInstance: (id: string) =>
+    request<Instance>(`/api/dataagent/orchestration/instances/${enc(id)}/cancel`, { method: 'POST', body: '{}' }),
+};
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/InstanceListPage.tsx b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/InstanceListPage.tsx
