+
+    original_bg = ShellOperation.execute_cmd_background
+    try:
+        bash_tool_safety.reset_installed_flag()
+        ShellOperation.execute_cmd_background = fake_bg
+        bash_tool_safety._patch_shell_operation_env()
+        asyncio.run(ShellOperation.execute_cmd_background(None, "sleep 1"))
+    finally:
+        ShellOperation.execute_cmd_background = original_bg
+        bash_tool_safety.reset_installed_flag()
+
+    assert "options" not in seen
+    assert (seen.get("environment") or {}).get("PYTHONIOENCODING") == "utf-8"
+    assert (seen.get("environment") or {}).get("PYTHONUTF8") == "1"
