@@ -0,0 +1,49 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Loading } from '../../../../components/ui/Loading/Loading';
+import { ColumnLineageTable } from '../../../_shared/lineage/ColumnLineageTable';
+import type { ColumnLineageGraph } from '../../../_shared/lineage/columnLineageModel';
+import { metadataApi } from '../../api/metadataApi';
+
+type ColumnState = { status: 'loading' } | { status: 'loaded'; graph: ColumnLineageGraph } | { status: 'error' };
+
+/** Keyed by database and table in LineageView, so a new selection starts clean. */
+export function TableColumnLineage({ db, table }: { db: string; table: string }) {
+  const { t } = useTranslation();
+  const [state, setState] = useState<ColumnState>({ status: 'loading' });
+  const [retryAttempt, setRetryAttempt] = useState(0);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setState({ status: 'loading' });
+    void metadataApi.getColumnLineage(db, table, controller.signal).then(
+      (artifact) => {
+        if (!controller.signal.aborted) setState({ status: 'loaded', graph: artifact.graph });
+      },
+      () => {
+        if (!controller.signal.aborted) setState({ status: 'error' });
+      },
+    );
+    return () => controller.abort();
+  }, [db, table, retryAttempt]);
+
+  if (state.status === 'loaded') return <ColumnLineageTable graph={state.graph} table={`${db}.${table}`} />;
+
+  return (
+    <div className="dm-column-lineage-state" aria-busy={state.status === 'loading'}>
+      {state.status === 'loading' ? (
+        <span role="status">
+          <Loading aria-label={t('dataManagement.loading')} />
+        </span>
+      ) : (
+        <>
+          <p role="alert">{t('dataManagement.lineage.columnLoadFailed')}</p>
+          <button type="button" className="dm-btn" onClick={() => setRetryAttempt((attempt) => attempt + 1)}>
+            {t('common.retry')}
+          </button>
+        </>
+      )}
+    </div>
+  );
+}
