+/**
+ * 首页欢迎区品牌图。视觉资源全部由品牌配置驱动：
+ * 品牌提供悬停动图时，悬停播放一轮动图（时长取品牌配置）；否则为纯静态图。
+ */
+function WelcomeBannerImage({
+  className,
+  altText,
+  onTrigger,
+  onHide,
+}: {
+  className: string;
+  altText: string;
+  onTrigger: () => void;
+  onHide: () => void;
+}) {
+  const [isPlaying, setIsPlaying] = useState(false);
+  const timerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const animatedImage = branding.welcomeImageAnimated;
+
+  const handleMouseEnter = useCallback(() => {
+    onTrigger();
+    if (!animatedImage) return;
+    if (timerRef.current) {
+      clearTimeout(timerRef.current);
+    }
+    setIsPlaying(true);
+    timerRef.current = setTimeout(() => {
+      setIsPlaying(false);
+      timerRef.current = null;
+    }, branding.welcomeImageAnimationMs ?? 0);
+  }, [onTrigger, animatedImage]);
+
+  useEffect(() => {
+    return () => {
+      if (timerRef.current) clearTimeout(timerRef.current);
+    };
+  }, []);
+
+  return (
+    <img
+      className={className}
+      style={branding.welcomeImageStyle}
+      src={isPlaying && animatedImage ? animatedImage : branding.welcomeImage}
+      alt={altText}
+      data-testid="chat-panel-welcome-banner"
+      onMouseEnter={handleMouseEnter}
+      onMouseLeave={onHide}
