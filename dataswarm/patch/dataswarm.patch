+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useCallback, useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+import { MoreHorizontal } from 'lucide-react';
+import { WorkflowGraph, type WorkflowGraphProps } from '../../_shared/workflow/WorkflowGraph';
+import type { WorkflowGraphNode } from '../../_shared/workflow/workflowGraphModel';
+import type { NodeInput, TaskDefinition, TaskRun } from '../types/orchestration';
+import { toWorkflowGraphNodes, applyWorkflowGraphChanges } from './shared/workflowGraphAdapter';
+import { RowMenu } from './shared/RowMenu';
+import { toast } from './shared/Ui';
+import { RunStatusIcon } from './WorkflowRunUi';
+
+const renderStatusIcon = (status: string) => <RunStatusIcon status={status} />;
+
+interface Props extends Omit<
+  WorkflowGraphProps,
+  'nodes' | 'onChange' | 'renderNodeActions' | 'onInvalidConnection' | 'nodesConnectable'
+> {
+  draft: NodeInput[];
+  tasks: TaskDefinition[];
+  taskRuns?: TaskRun[];
+  onChange?: (next: NodeInput[]) => void;
+  onDuplicateNode?: (nodeId: string) => void;
+  onDeleteNode?: (nodeId: string) => void;
+}
+
+/** Workflow editing and runtime data adapt to the same graph used by governance. */
+export function WorkflowDag({ draft, tasks, taskRuns, onChange, onDuplicateNode, onDeleteNode, ...props }: Props) {
+  const { t } = useTranslation();
+  const nodes = useMemo(
+    () => toWorkflowGraphNodes(draft, tasks, taskRuns, t('dataAsset.nodeForm.defaultGroup')),
+    [draft, tasks, taskRuns, t],
+  );
+  const handleChange = useCallback(
+    (next: WorkflowGraphNode[]) => {
+      onChange?.(applyWorkflowGraphChanges(draft, next));
+    },
+    [draft, onChange],
+  );
+  const renderNodeActions = useCallback(
+    (id: string) => {
+      if (!onDuplicateNode && !onDeleteNode) return null;
+      const node = nodes.find((item) => item.id === id)!;
+      return (
+        <RowMenu
+          text={t('dataAsset.editor.nodeActions', { name: node.label })}
+          icon={<MoreHorizontal size={16} />}
+          items={[
+            ...(onDuplicateNode
+              ? [{ label: t('dataAsset.nodeForm.duplicate'), onClick: () => onDuplicateNode(id) }]
+              : []),
+            ...(onDeleteNode ? [{ label: t('common.delete'), onClick: () => onDeleteNode(id), danger: true }] : []),
+          ]}
+        />
+      );
+    },
+    [nodes, onDuplicateNode, onDeleteNode, t],
+  );
+  return (
+    <WorkflowGraph
+      backgroundGap={10}
+      highlightSelection={false}
+      renderStatusIcon={renderStatusIcon}
+      {...props}
+      nodesConnectable={false}
+      nodes={nodes}
+      onChange={onChange ? handleChange : undefined}
+      renderNodeActions={renderNodeActions}
+      onInvalidConnection={() => toast.error(t('dataAsset.editor.cycle'))}
+    />
+  );
+}
