+
+
+# 当前工作空间（main 里从 argv/env 设置；list 包装以便全模块可变读取）
+WORKSPACE_ID = [os.environ.get("JIUWENSWARM_WORKSPACE_ID", "").strip()]
+
+# 演示数据固定 ID 前缀（避免与随机 task_id 冲突，clean 精准清理）
+TASK_PREFIX = "bld_"
+WF_PREFIX = "bld_wf_"
