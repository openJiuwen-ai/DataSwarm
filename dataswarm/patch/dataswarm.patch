diff --git a/tests/unit_tests/cli/test_dw_client.py b/tests/unit_tests/cli/test_dw_client.py
new file mode 100644
index 000000000..a1eb42cbf
--- /dev/null
+++ b/tests/unit_tests/cli/test_dw_client.py
@@ -0,0 +1,240 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_client 共享委托层单测（方案批次 2：skill 侧 db_connector → dwcli 委托）。
+
+新功能档 TDD：dw_client 保留 db_connector 的函数签名（首参 db_ref），内部经
+subprocess 调 `python -m jiuwenswarm.cli.dwcli`，skill 侧换 import 行即完成迁移。
+覆盖：query/query_dict/tables/schema/list_indexes/show_create_table/execute/
+metadata_db_ref/default_db_ref/parse_db_ref/quote_ident + 错误传播。
+"""
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+_SKILLS = Path("jiuwenswarm/resources/agent/workspace/skills")
+sys.path.insert(0, str(_SKILLS / "_dw_common" / "scripts"))
+import dw_client as dc  # noqa: E402
+
+
+class _FakeRun:
+    """记录 subprocess.run 调用，返回可控 stdout。"""
+
+    def __init__(self, payloads):
+        self.payloads = list(payloads)  # 每次调用弹一个 dict
+        self.calls: list[list[str]] = []
+
+    def __call__(self, cmd, **kw):
+        self.calls.append(cmd)
+        payload = self.payloads.pop(0) if self.payloads else {}
+        return SimpleNamespace(returncode=0, stdout=json.dumps(payload).encode("utf-8"))
+
+
+@pytest.fixture
+def fake_run(monkeypatch):
+    fr = _FakeRun([])
+    monkeypatch.setattr(subprocess, "run", fr)
+    return fr
+
+
+# --------------------------------------------------------------------------
+# query / query_dict
+# --------------------------------------------------------------------------
+def test_query_delegates_to_dwcli_sql_run(fake_run):
+    fake_run.payloads = [{"ok": True, "rows": [[1, "x"]], "columns": ["a", "b"],
+                          "truncated": False, "row_count": 1, "elapsed_ms": 5}]
+    out = dc.query("doris://h/d", "SELECT 1", limit=50)
+    cmd = fake_run.calls[0]
+    assert cmd[1:5] == ["-m", "jiuwenswarm.cli.dwcli", "sql", "run"]
+    assert "--db-ref" in cmd and "doris://h/d" in cmd
+    assert "SELECT 1" in cmd
+    # envelope → db_connector 兼容 shape
+    assert out["row_count"] == 1
+    assert out["columns"] == ["a", "b"]
+    assert out["rows"] == [[1, "x"]]
+    assert out["truncated"] is False
+    assert out["elapsed_ms"] == 5
+
+
+def test_query_error_raises(fake_run):
+    fake_run.payloads = [{"ok": False, "error": "(1142, perm denied)"}]
+    with pytest.raises(Exception, match="perm denied"):
+        dc.query("doris://h/d", "SELECT 1")
+
+
+def test_query_dict_zips_columns(fake_run):
+    fake_run.payloads = [{"ok": True, "rows": [[1, "x"]], "columns": ["a", "b"],
+                          "truncated": False, "row_count": 1, "elapsed_ms": 1}]
+    out = dc.query_dict("doris://h/d", "SELECT 1")
+    assert out == [{"a": 1, "b": "x"}]
+
+
+# --------------------------------------------------------------------------
+# tables / schema / indexes / show_create
+# --------------------------------------------------------------------------
+def test_tables(fake_run):
+    fake_run.payloads = [{"ok": True, "tables": ["t1"], "table_count": 1}]
+    out = dc.tables("doris://h/d")
+    assert out["tables"] == ["t1"]
+    cmd = fake_run.calls[0]
+    assert cmd[3:5] == ["databases", "tables"]
+    assert "doris://h/d" in cmd  # db_ref 显式传给服务端
+
+
+def test_tables_metadata_role_sqlite_uses_sqlite_master(fake_run):
+    """元库 SQLite 时走 sqlite_master——SHOW TABLES 是 MySQL/Doris 方言。"""
+    fake_run.payloads = [{"ok": True, "rows": [["dw_tasks"]], "columns": ["name"],
+                          "row_count": 1, "truncated": False}]
+    out = dc.tables("sqlite:///C:/meta.db", role="metadata")
+    cmd = fake_run.calls[0]
+    assert cmd[3:5] == ["sql", "run"]
+    assert "metadata" in cmd  # --role metadata 显式传
+    sql_arg = cmd[cmd.index("--sql") + 1]
+    assert "sqlite_master" in sql_arg
+    assert "SHOW TABLES" not in sql_arg
+    assert out["tables"] == ["dw_tasks"]
+
+
+def test_tables_metadata_role_doris_keeps_show_tables(fake_run):
+    fake_run.payloads = [{"ok": True, "rows": [["dw_tasks"]],
+                          "columns": ["Tables_in_bigdata"],
+                          "row_count": 1, "truncated": False}]
+    out = dc.tables("doris://h/bigdata", role="metadata")
+    cmd = fake_run.calls[0]
+    sql_arg = cmd[cmd.index("--sql") + 1]
+    assert sql_arg == "SHOW TABLES"
+    assert out["tables"] == ["dw_tasks"]
+
+
+def test_schema(fake_run):
+    fake_run.payloads = [{"columns": [{"name": "id", "type": "int"}], "table": "t1"}]
+    out = dc.schema("doris://h/d", "t1")
+    assert out["columns"][0]["name"] == "id"
+
+
+def test_schema_surfaces_resolved_table(fake_run):
+    """服务端目录回填的规范表名（裸表名 → "schema"."table"）要透传给调用方。"""
+    fake_run.payloads = [{"name": '"indextrade_database"."index_info"',
+                          "columns": [{"name": "ts_code", "type": "VARCHAR"}]}]
+    out = dc.schema("duckdb://D:/stockindex.duckdb?source_type=duckdb", "index_info")
+    assert out["resolved_table"] == '"indextrade_database"."index_info"'
+    assert out["table"] == "index_info"
+
+
+def test_business_error_preserves_detail(fake_run):
+    """业务错误必须带出 detail——否则技能侧只看到 "not_found" 这类光秃错误名。"""
+    fake_run.payloads = [{"status": "error", "http_code": 404, "error": "not_found",
+                          "detail": "table 'missing_tbl' not found in this datasource"}]
+    with pytest.raises(RuntimeError) as exc:
+        dc.schema("duckdb://D:/stockindex.duckdb?source_type=duckdb", "missing_tbl")
+    assert not isinstance(exc.value, dc.WorkspaceContextError)
+    assert "not_found" in str(exc.value)
+    assert "missing_tbl" in str(exc.value)
+
+
+@pytest.mark.parametrize("code", ["WORKSPACE_CONTEXT_REQUIRED", "DB_REF_NOT_ALLOWED"])
+def test_workspace_error_keeps_code(fake_run, code):
+    fake_run.payloads = [{"status": "error", "http_code": 400, "error": code,
+                          "detail": "workspace_id is required"}]
+    with pytest.raises(dc.WorkspaceContextError) as exc:
+        dc.tables("duckdb://D:/a.duckdb?source_type=duckdb")
+    assert exc.value.code == code
+    assert "workspace_id is required" in str(exc.value)
+
+
+def test_list_indexes_duckdb_returns_empty_without_query(fake_run):
+    """duckdb 文件源是运行时 VIEW，无索引语义——本地短路返回空，不发 SHOW INDEX。
+
+    回归：此前 duckdb 落 SHOW INDEX FROM 分支，DuckDB 无此语法直接报错，
+    巡检 schema 阶段必坏（服务端 db_connector 早有 duckdb 分支，skill 副本漂移）。
+    """
+    out = dc.list_indexes("duckdb://D:/data/orders.csv?source_type=csv", "orders")
+    assert out == {"table": "orders", "indexes": [],
+                   "db": {"type": "duckdb", "ref": "duckdb://D:/data/orders.csv?source_type=csv"}}
+    assert fake_run.calls == []  # 未发任何 dwcli 调用（本地短路）
+
+
+def test_show_create_table_duckdb_returns_empty_without_query(fake_run):
+    """duckdb 文件源 VIEW 由运行时注册，无持久 DDL——本地短路返回空串。"""
+    out = dc.show_create_table("duckdb://D:/data/orders.csv?source_type=csv", "orders")
+    assert out == {"table": "orders", "create_sql": "",
+                   "db": {"type": "duckdb", "ref": "duckdb://D:/data/orders.csv?source_type=csv"}}
+    assert fake_run.calls == []
+
+
+def test_list_indexes_doris_still_shows(fake_run):
+    """doris/mysql 仍走 SHOW INDEX（duckdb 短路不影响既有分支）。"""
+    fake_run.payloads = [{"ok": True, "rows": [["t", 0, "PRIMARY", 1, "id"]],
+                          "columns": ["Table", "Non_unique", "Key_name", "Seq", "Column"],
+                          "row_count": 1, "truncated": False}]
+    out = dc.list_indexes("doris://h/d", "t")
+    assert out["indexes"]
+    sql_arg = fake_run.calls[0][fake_run.calls[0].index("--sql") + 1]
+    assert "SHOW INDEX FROM" in sql_arg
+
+
+# --------------------------------------------------------------------------
+# execute（写操作 → dwcli sql ddl --confirm）
+# --------------------------------------------------------------------------
+def test_execute_with_confirm(fake_run):
+    fake_run.payloads = [{"ok": True, "affected_rows": 1, "elapsed_ms": 3}]
+    out = dc.execute("doris://h/d", "CREATE TABLE t(id int)")
+    cmd = fake_run.calls[0]
+    assert "ddl" in cmd and "--confirm" in cmd
+    assert out["affected_rows"] == 1
+
+
+def test_execute_error_raises(fake_run):
+    fake_run.payloads = [{"ok": False, "error": "perm"}]
+    with pytest.raises(Exception, match="perm"):
+        dc.execute("doris://h/d", "DROP TABLE t")
+
+
+# --------------------------------------------------------------------------
+# 本地解析（不 subprocess）：metadata_db_ref / default_db_ref / parse_db_ref / quote_ident
+# --------------------------------------------------------------------------
+def test_parse_db_ref_pure_local():
+    """parse_db_ref 走 dw_sql_utils 纯函数（不读凭据、不 subprocess）。"""
+    spec = dc.parse_db_ref("doris://host:9030/olist")
+    assert spec["type"] == "doris" and spec["database"] == "olist"
+
+
+def test_parse_db_ref_duckdb():
+    """duckdb:// 文件源 ref：location/query 解析 + database 取文件/目录名。"""
+    spec = dc.parse_db_ref(
+        "duckdb://D:/data/%E5%AE%A2%E6%88%B7%E7%9B%AE%E5%BD%95"
+        "?source_type=csv&table_name=customers"
+    )
+    assert spec["type"] == "duckdb"
+    assert spec["location"] == "D:/data/客户目录"
+    assert spec["source_type"] == "csv"
+    assert spec["table_name"] == "customers"
+    assert spec["database"] == "客户目录"
+    # 默认 table_name：单文件取 stem，目录/S3/非法标识符回退 data
+    assert dc.parse_db_ref("duckdb://D:/data/orders.csv?source_type=csv")["table_name"] == "orders"
+    assert dc.parse_db_ref("duckdb://D:/data?source_type=csv")["table_name"] == "data"
+    assert dc.parse_db_ref("duckdb://s3://bucket/prefix?source_type=csv")["table_name"] == "data"
+
+
+def test_quote_ident_duckdb():
+    """duckdb 标识符用双引号（同 sqlite），信息架构 SQL 不可用须走 DESCRIBE。"""
+    assert dc.quote_ident("duckdb://D:/data/orders.csv?source_type=csv", "t") == '"t"'
+
+
+def test_quote_ident_by_type():
+    assert dc.quote_ident("doris://h/d", "t") == "`t`"
+    assert dc.quote_ident("sqlite:///x.db", "t") == '"t"'
+
+
+def test_metadata_db_ref_reads_config(monkeypatch, tmp_path):
+    cfg = tmp_path / "datasource.yaml"
+    cfg.write_text("default_db: doris://\nmetadata_db: mysql://meta\n", encoding="utf-8")
+    monkeypatch.setattr(dc, "_datasource_config_path", lambda: cfg)
