+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""archive_delta.py —— 归档：develop_oss 稳定点 → 归档分支（脚本单点写入，永不手改）。
+
+V4 口径（patch 自足还原）：
+- patch = `git diff --no-renames --binary 基线tag..anchor` 的**全部内容差异**（零排除）——
+  `clone 基线 tag + git apply patch` 一步还原完整项目
+- skills / skill 专项测试 / sync 清单文件 = MR 分支的展示与组织层（与 patch 重复表达）
+- 还原不变量（内建自校验 + verify 双层断言）：
+  `基线 tag + git apply patch == develop_oss@anchor 全树`
+
+MR 分支单 commit 重挂：新 commit 的 parent = mr-hub 合入目标分支 tip，
+MR 永远 = 合入目标 + 1 个待评审 commit；连续多次未合入只保留最新（全量重生成，无信息损失）。
+
+用法:
+    python scripts/dataswarm/fork/archive_delta.py --dry-run           # 只构造并打印
+    python scripts/dataswarm/fork/archive_delta.py --report-json out.json
+    python scripts/dataswarm/fork/archive_delta.py --push              # 写本地 MR 分支并推 mr-fork
+    python scripts/dataswarm/fork/archive_delta.py --anchor <commit> --push   # 从稳定点归档
+    python scripts/dataswarm/fork/archive_delta.py --push --accept-anchor-reset  # 历史重写后首归档
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from _fork_lib import (  # noqa: E402
+    PATCH_FILE,
+    apply_patch_tree,
+    archive_branch,
+    archive_commit_message,
+    build_archive_set,
+    commit_message,
+    dev_hub_branch,
+    ensure_baseline_tag,
+    ForkError,
+    gen_patch_bytes,
+    git,
+    hash_blob,
+    is_ancestor,
+    last_archive_from,
+    load_config,
+    load_sync_manifest,
+    mr_hub_branch,
+    rev,
+    tree_diff_paths,
+    write_tree,
+)
+
+
+def parse_args() -> argparse.Namespace:
+    ap = argparse.ArgumentParser(description="归档 develop_oss 稳定点 → 三目录归档分支")
+    ap.add_argument("--dev-ref", default=None, help="共源开发分支（缺省 fork_config.dev_hub.branch）")
+    ap.add_argument("--anchor", default=None,
+                    help="归档锚点（稳定点 commit；缺省 dev-ref HEAD，可指向已验证的历史提交）")
+    ap.add_argument("--baseline", default=None, help="覆盖 fork_config 的基线 tag")
+    ap.add_argument("--target-remote", default="mr-fork", help="归档分支所在远端（默认 mr-fork）")
+    ap.add_argument("--target-branch", default=None, help="归档分支名（缺省 fork_config.archive.branch）")
+    ap.add_argument("--dry-run", action="store_true", help="只构造并打印，不建 commit/不推")
+    ap.add_argument("--report-json", default=None, help="输出归档报告 JSON 的路径")
+    ap.add_argument("--push", action="store_true", help="写本地归档分支并推送 target remote")
+    ap.add_argument("--no-compose-check", action="store_true",
+                    help="跳过还原自校验（基线+patch == anchor 全树，默认开启）")
+    ap.add_argument("--accept-anchor-reset", action="store_true",
+                    help="允许上次归档 anchor 在当前历史中不可达（develop_oss 历史重写后的首次归档）")
+    args = ap.parse_args()
+    if args.dry_run and args.push:
+        ap.error("--dry-run 与 --push 不能同时使用")
+    return args
+
+
+def write_report(path: str, report: dict) -> None:
+    Path(path).write_text(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+                          encoding="utf-8")
+    print(f"[*] 报告: {path}")
+
+
+def _archive_anchor(tip: str | None) -> str | None:
+    """读取归档 commit trailer 里记录的 anchor（无则 None）。"""
+    if not tip:
+        return None
+    return last_archive_from(tip)
+
+
+def main() -> int:
+    args = parse_args()
+
+    dirty = git("status", "--porcelain", "--untracked-files=no").stdout.strip()
+    if dirty:
+        raise ForkError("工作区有未提交改动——先提交再归档")
+
+    cfg = load_config()
+    baseline_tag = args.baseline or cfg["baseline"]["ref"]
+    cfg["baseline"]["ref"] = baseline_tag
+    ensure_baseline_tag(baseline_tag)
+    dev_ref = args.dev_ref or dev_hub_branch(cfg)
+    branch_mr = args.target_branch or archive_branch(cfg)
+    branch_hub = mr_hub_branch(cfg)
+
+    current = git("symbolic-ref", "--quiet", "--short", "HEAD", check=False).stdout.decode().strip()
+    if current == branch_mr:
+        raise ForkError(f"当前检出的是 {branch_mr}——归档分支不接受直接开发，请切回 {dev_ref}")
+
+    anchor_sha = rev(f"{args.anchor or dev_ref}^{{commit}}")
+    if not anchor_sha:
+        raise ForkError(f"锚点 ref 不存在: {args.anchor or dev_ref}")
+
+    # ----------------------------------------------------------- 构造归档
+    sync_manifest = load_sync_manifest(anchor_sha)
+    copy_files, counts, sync_files = build_archive_set(baseline_tag, anchor_sha, cfg, sync_manifest)
+    patch_bytes = gen_patch_bytes(baseline_tag, anchor_sha)
+
+    generated = {PATCH_FILE: patch_bytes}
+    files = dict(copy_files)
+    files.update(sync_files)
+    for path, content in generated.items():
+        files[path] = ("100644", hash_blob(content))
+
+    # ----------------------------------------------------------- 还原自校验（单通道强断言）
+    if not args.no_compose_check:
+        composed = apply_patch_tree(baseline_tag, patch_bytes)
+        diffs = tree_diff_paths(composed, f"{anchor_sha}^{{tree}}")
+        print(f"    完整性: 基线+patch(apply) vs anchor 全树差异 {len(diffs)} 项（要求 0）")
+        if diffs:
+            raise ForkError("还原自校验失败——patch 无法完整还原 anchor（归档器缺陷）:\n  "
+                            + "\n  ".join(diffs[:20]))
+
+    # ----------------------------------------------------------- MR 分支重挂：parent = 合入目标 tip
+    if git("remote", "get-url", args.target_remote, check=False).returncode != 0:
+        raise ForkError(f"远端 {args.target_remote} 不存在——先跑 onboard.py，"
+                        "或用 --target-remote 指定你的交付仓 fork remote")
+    git("fetch", "mr-hub", check=False)
+    hub_tip = rev(f"mr-hub/{branch_hub}")
+    git("fetch", args.target_remote, check=False)
+    remote_tip = rev(f"{args.target_remote}/{branch_mr}")
+
+    # 防锚点回退：已交付 anchor 必须是本次 anchor 的祖先；anchor 在当前历史不可达
+    # （历史重写）默认中止，--accept-anchor-reset 显式豁免
+    hub_anchor = _archive_anchor(hub_tip)
+    remote_anchor = _archive_anchor(remote_tip)
+    dev_head = rev(f"{dev_ref}^{{commit}}")
+    for label, prev in ((f"mr-hub/{branch_hub}", hub_anchor),
+                        (f"{args.target_remote}/{branch_mr}", remote_anchor)):
+        if not prev or prev == anchor_sha:
+            continue
+        # 旧 anchor 是否在当前 develop_oss 历史中（对象悬空但可解析 = 历史重写后的残留）
+        in_history = bool(dev_head) and rev(prev) is not None and is_ancestor(prev, dev_head)
+        if not in_history:
+            if args.accept_anchor_reset:
+                print(f"[WARN] {label} 记录的 anchor {prev[:12]} 不在当前历史中"
+                      f"（--accept-anchor-reset 豁免，按新历史首归档处理）")
+                continue
+            raise ForkError(
+                f"{label} 记录的 anchor {prev[:12]} 不在当前 develop_oss 历史中——历史被"
+                f"重写过（rebase/squash）？确认后加 --accept-anchor-reset 重新归档")
+        if not is_ancestor(prev, anchor_sha):
+            raise ForkError(
+                f"锚点回退：{label} 记录的 anchor {prev[:12]} 不是本次 anchor {anchor_sha[:12]} "
+                f"的祖先——develop_oss 侧先前进/修正后再归档")
+
+    # 外部漂移检测：MR 旧 tip 必须是归档生成物（Archive-from），或等于合入目标 tip（已全部合入）
+    if remote_tip and last_archive_from(remote_tip) is None and remote_tip != hub_tip:
+        raise ForkError(
+            f"{args.target_remote}/{branch_mr} 的 tip 既非归档提交（无 Archive-from），"
+            f"也不等于合入目标 {branch_hub}——疑似外部手改，中止（tip={remote_tip[:12]}）")
+
+    parent = hub_tip  # None = 首链（合入目标分支尚不存在，GitCode MR 合入时自动建）
+
+    # 本次交付的 develop_oss 新提交（message 里给 MR 读者看；基点 = 上次交付 anchor 较新者）
+    dev_commits: list[str] = []
+    candidates = [a for a in (hub_anchor, remote_anchor) if a and rev(a)]
+    msg_base = candidates[0] if candidates else None
+    for cand in candidates[1:]:
+        if is_ancestor(msg_base, cand):
+            msg_base = cand
+    if msg_base and msg_base != anchor_sha:
+        out = git("log", "--oneline", "--reverse", f"{msg_base}..{anchor_sha}").stdout.decode("utf-8", "replace")
+        dev_commits = [ln.strip() for ln in out.splitlines() if ln.strip()]
+
+    tree = write_tree(files)
+    message = archive_commit_message(anchor_sha, cfg, counts, dev_commits)
+    # anchor 与 message 也参与幂等判定：历史重写（rebase/squash）后树与 parent 可能不变，
+    # 但 trailer 指向的 anchor 必须更新到当前历史；归档器改标题/正文口径后重跑即刷新 message
+    up_to_date = bool(remote_tip) and rev(f"{remote_tip}^{{tree}}") == tree \
+        and rev(f"{remote_tip}^") == parent and _archive_anchor(remote_tip) == anchor_sha \
+        and commit_message(remote_tip).rstrip("\n") == message.rstrip("\n")
+
+    report = {
+        "dev_ref": dev_ref,
+        "anchor": anchor_sha,
+        "baseline_tag": baseline_tag,
+        "target": f"{args.target_remote}/{branch_mr}",
+        "remote_tip": remote_tip,
+        "hub_tip": hub_tip,
+        "parent": parent,
+        "tree": tree,
+        "up_to_date": up_to_date,
+        "counts": counts,
+        "copy_files": len(copy_files),
+        "sync_files": len(sync_files),
+        "patch_bytes": len(patch_bytes),
+        "files": [{"path": p, "mode": m, "blob": s} for p, (m, s) in sorted(files.items())],
+    }
+
+    print(f"[*] {dev_ref}@{anchor_sha[:12]} vs 基线 {baseline_tag} → "
+          f"{args.target_remote}/{branch_mr}（parent {'= ' + parent[:12] if parent else '无（首链）'}）")
+    print(f"    patch 全量差异: A={counts['total']['A']} M={counts['total']['M']} D={counts['total']['D']}"
+          f"（{len(patch_bytes)} bytes，零排除）")
+    print(f"    展示层: skills {sum(counts['skills'].values())} 项 | sync {counts['sync']} 文件"
+          f"（清单 {len(sync_manifest)} 项）")
+    print(f"    归档文件: {len(files)} 项（复制 {len(copy_files)} + 同步 {len(sync_files)} + 生成物 1）")
+    print(f"    本次 develop_oss 提交: {len(dev_commits)} 个")
+    print(f"    树: {tree}")
+
+    if args.report_json:
+        write_report(args.report_json, report)
+
+    if up_to_date:
+        print(f"[OK] up to date——归档树与 parent 均未变（tip {remote_tip[:12]}）")
+        return 0
+
+    if args.dry_run:
+        print(f"[dry-run] 未建 commit（若执行将重挂在 {'parent ' + parent[:12] if parent else '无 parent（首链）'}）")
+        return 0
+
+    commit = git("commit-tree", tree, *(["-p", parent] if parent else []), "-m", message)
+    new_commit = commit.stdout.decode().strip()
+    local_ref = f"refs/heads/{branch_mr}"
+    local_tip = rev(local_ref)
+    expected_old = local_tip or ""  # 空 = 要求 ref 不存在（CAS）
+    git("update-ref", local_ref, new_commit, expected_old)
+    print(f"[OK] 归档 commit: {new_commit[:12]}（parent {parent[:12] if parent else '无'}）")
+
+    if args.push:
+        if remote_tip is None:
+            git("push", args.target_remote, f"{branch_mr}:{branch_mr}")
+        else:
+            # 单 commit 重挂（parent 更换，旧未交付 commit 被全量覆盖丢弃）→ force-with-lease
+            git("push", "--force-with-lease", args.target_remote, f"{branch_mr}:{branch_mr}")
+        print(f"[OK] 已推送 {args.target_remote}/{branch_mr}")
+        print(f"     下一步：GitCode MR {args.target_remote}:{branch_mr} → mr-hub:{branch_hub}，"
+              f"MR 由人工合入")
+    else:
+        print(f"     推送: git push --force-with-lease {args.target_remote} {branch_mr}:{branch_mr}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
