+def test_weak_schema_hits_do_not_propagate(e2e, emb_on):
+    """噪声级 schema 命中不得传导到指标（回归：真机实测到的误澄清事故）。
+
+    真机 bge-m3 + metrics-demo 上，「各销售渠道的订单量分布」的弱 schema 命中
+    （校准后 0.05）经传导以近零值激活 W_SCHEMA 通道；置信度是「有信号通道的
+    加权均值」，于是词法 0.90 的强命中被稀释到 0.57 → 误澄清。
+    """
+    release_id = _publish(e2e)
+    _refs, snapshots = semantic_link.current_snapshots()
+    release = versioning_release(release_id)
+    column = snapshots["biz_sales"].tables[0].columns
+    amount = next(c for c in column if c.name == "amount_cny")
+    strong = semantic_link.SchemaHit(
+        node_id=amount.node_id, node_type="col",
+        label="amount_cny", logical="orders.amount_cny",
+        score=0.90, matched_on=("emb",))
+    weak = dataclasses.replace(strong, score=semantic_link.SCHEMA_PROPAGATE_MIN - 0.01)
+
+    propagated = semantic_link.propagate_to_metrics(
+        WORKSPACE, release, snapshots, [strong])
+    assert GMV in propagated, "真信号必须传导（R2 依赖它）"
+    assert propagated[GMV] == pytest.approx(0.90 * semantic_link.SCHEMA_PROPAGATION)
+
+    assert semantic_link.propagate_to_metrics(
+        WORKSPACE, release, snapshots, [weak]) == {}, "噪声级命中不得传导"
+
