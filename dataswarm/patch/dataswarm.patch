+def test_value_column_becomes_schema_entry(monkeypatch):
+    """维值命中 → 所属列进 schema 子包（纵向：值→列）。"""
+    _no_cross_graph(monkeypatch)
+    results = {
+        "terms": _road("term", []),
+        "metrics": _road("metric", []),
+        "schema": _road("column", []),
+        "values": _road("value", [RecallHit(
+            kind="value", entity_id="v-1", label="华东",
+            channels=[("lexical:exact", 1.0)], matched_on=["value:exact"],
+            payload={"column_id": "col:mysql:src:shop.orders.region",
+                     "table_id": "tbl:mysql:src:shop.orders"})]),
+    }
+    expansion = graph_expand.expand(results, "ws", {"src": _snapshot()})
+    assert any(hit.entity_id == "col:mysql:src:shop.orders.region"
+               for hit in expansion.columns)
+    assert "tbl:mysql:src:shop.orders" in expansion.tables
+
+
+def test_binding_column_ref_symmetry():
+    """E4：col:: 绑定列引用的构造/解析对称性 + 方言判别（P3-3）。
+
+    黄金样本往返一致；单冒号素材方言（col:/tbl:/view:）与裸 table.column
+    均不属绑定方言——两个约定不得混。
+    """
+    assert graph_expand.binding_column_id("orders", "customer_state") \
+        == "col::orders.customer_state"
+    assert graph_expand.binding_column_logical("col::orders.customer_state") \
+        == "orders.customer_state"
+    assert graph_expand.binding_column_logical(
+        graph_expand.binding_column_id("t", "c")) == "t.c"
+    for foreign in ("col:node_1", "tbl:orders", "view:v1",
+                    "orders.customer_state", "", "col:"):
+        assert graph_expand.binding_column_logical(foreign) is None, foreign
