+class FakeResponse:
+    def __init__(self):
+        self.status = None
+        self.payload = None
+
+    def capture(self, status, payload):
+        self.status = status
+        self.payload = payload
+
+
+class FakeHandler:
+    def __init__(self, path: str, body: dict | None = None):
+        self.parsed = urlparse(path)
+        self.path = self.parsed.path
+        self.rfile = _FakeRfile(json.dumps(body).encode() if body else b"")
+        self.headers = {"Content-Length": str(len(json.dumps(body).encode() if body else b""))}
+        self._resp = FakeResponse()
+
+    def _write_json(self, status, payload):
+        self._resp.capture(status, payload)
+
+    def _query_arg(self, parsed, name):
+        for pair in self.parsed.query.split("&"):
+            if "=" in pair:
+                k, v = pair.split("=", 1)
+                if k == name:
+                    return v
+        return None
+
+
+class _FakeRfile:
+    def __init__(self, data: bytes):
+        self._data = data
+
+    def read(self, n):
+        return self._data[:n]
+
+
+class _SvcSpy:
+    """替身 service：记录调用、返回可控结果。"""
+
+    def __init__(self):
+        self.calls: list[tuple] = []
+        self.task = {"task_id": "t1", "name": "etl1", "status": "draft"}
+        self.workflow = {"workflow_id": "w1", "name": "wf1", "status": "published", "enabled": 1}
+        self.instance = {"instance_id": "i1", "status": "running"}
+        self.not_found = None
+
+    # ---- tasks ----
+    def create_task(self, data):
+        self.calls.append(("create_task", data))
+        return self.task
+
+    def get_task(self, tid):
+        self.calls.append(("get_task", tid))
+        return self.not_found or self.task
+
+    def list_tasks(self, **kw):
+        self.calls.append(("list_tasks", kw))
+        return [self.task]
+
+    def count_tasks(self, **kw):
+        self.calls.append(("count_tasks", kw))
+        return 1
+
+    def update_task(self, tid, data):
+        self.calls.append(("update_task", tid, data))
+        return self.task
+
+    def delete_task(self, tid):
+        self.calls.append(("delete_task", tid))
+        return True
+
+    def set_task_status(self, tid, status):
+        self.calls.append(("set_task_status", tid, status))
+        self.task["status"] = status
+        return self.task
+
+    # ---- workflows ----
+    def create_workflow(self, data):
+        self.calls.append(("create_workflow", data))
+        return self.workflow
+
+    def get_workflow(self, wid):
+        self.calls.append(("get_workflow", wid))
+        return self.not_found or self.workflow
+
+    def list_workflows(self, **kw):
+        self.calls.append(("list_workflows", kw))
+        return [self.workflow]
+
+    def count_workflows(self, **kw):
+        self.calls.append(("count_workflows", kw))
+        return 1
+
+    def update_workflow(self, wid, data):
+        self.calls.append(("update_workflow", wid, data))
+        return self.workflow
+
+    def delete_workflow(self, wid):
+        self.calls.append(("delete_workflow", wid))
+        return True
+
+    def set_workflow_status(self, wid, status, enabled=None):
+        self.calls.append(("set_workflow_status", wid, status, enabled))
+        self.workflow["status"] = status
+        if enabled is not None:
+            self.workflow["enabled"] = enabled
+        return self.workflow
+
+    def enable_workflow(self, wid):
+        self.calls.append(("enable_workflow", wid))
+        return self.workflow
+
+    def disable_workflow(self, wid):
+        self.calls.append(("disable_workflow", wid))
+        return self.workflow
+
+    def replace_nodes(self, wid, nodes):
+        self.calls.append(("replace_nodes", wid, nodes))
+        return nodes
+
+    def add_node(self, wid, node):
+        self.calls.append(("add_node", wid, node))
+        return node
+
+    # ---- instances ----
+    def list_instances(self, **kw):
+        self.calls.append(("list_instances", kw))
+        return [self.instance]
+
+    def count_instances(self, **kw):
+        self.calls.append(("count_instances", kw))
+        return len(getattr(self, "_count", []) or [self.instance])
+
+    def count_instances_by_status(self, **kw):
+        # 不入 calls：list_instances 响应里的 status_counts 附带查询
+        return {"running": 1}
+
+    def preview_lineage(self, code, datasource_ref=None):
+        self.calls.append(("preview_lineage", code, datasource_ref))
+        return [{"from": "a", "to": "b"}]
+
+    def get_instance(self, iid):
+        self.calls.append(("get_instance", iid))
+        return self.not_found or self.instance
+
+    def list_task_runs(self, iid):
+        self.calls.append(("list_task_runs", iid))
+        return []
+
+    def get_task_run_log(self, rid, stream="stdout"):
+        self.calls.append(("get_task_run_log", rid, stream))
+        return {"log": "x", "stream": stream, "run_id": rid}
+
+    def approve_node(self, iid):
+        self.calls.append(("approve_node", iid))
+        return self.instance
