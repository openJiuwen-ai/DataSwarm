@@ -0,0 +1,35 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+const INTERNAL_ROUTE_PREFIXES = ['/governance/', '/data-management/', '/dataagent/'];
+
+export function isInternalRouteHref(href: string | undefined): boolean {
+  return Boolean(href && INTERNAL_ROUTE_PREFIXES.some((prefix) => href.startsWith(prefix)));
+}
+
+/**
+ * 模型常把内部路由写成裸路径（如 `/data-management/tables?db=bond`），
+ * 不是 Markdown 链接语法，渲染后不可点击。这里把裸路径补成 Markdown 链接；
+ * 代码块/行内代码跳过，已有 `[text](/path)` 链接的目标不重复处理。
+ */
+const BARE_INTERNAL_ROUTE_PATTERN =
+  /(^|[^\w`./:[\[(])((?:\/(?:governance|data-management|dataagent)\/)[^\s`<>"'()\[\]|（）【】「」『』，。；：、！？]*)/g;
+const CODE_SEGMENT_PATTERN = /(```[\s\S]*?(?:```|$)|`[^`\n]*`)/g;
+
+export function linkifyBareInternalRoutes(content: string): string {
+  if (!INTERNAL_ROUTE_PREFIXES.some((prefix) => content.includes(prefix))) {
+    return content;
+  }
+
+  return content
+    .split(CODE_SEGMENT_PATTERN)
+    .map((segment, index) => {
+      if (index % 2 === 1) {
+        return segment;
+      }
+      return segment.replace(BARE_INTERNAL_ROUTE_PATTERN, (_match, prefix: string, route: string) => {
+        const trailing = /[.,;:!?*]+$/.exec(route)?.[0] ?? '';
+        const path = trailing ? route.slice(0, route.length - trailing.length) : route;
+        return `${prefix}[${path}](${path})${trailing}`;
+      });
+    })
+    .join('');
+}
