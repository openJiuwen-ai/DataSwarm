+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { buildGraphAdj, type WorkflowGraphNode } from '../../_shared/workflow/workflowGraphModel';
+import type { TaskArtifact } from '../types/inspection';
+
+export function toTaskGraphNodes(graph: TaskArtifact['graph']): WorkflowGraphNode[] {
+  const parents = new Map(graph.nodes.map((node) => [node.task_id, [] as string[]]));
+  for (const edge of graph.edges) {
+    if (!parents.has(edge.from) || !parents.has(edge.to)) throw new Error('Task dependency endpoint is missing');
+    const list = parents.get(edge.to)!;
+    if (!list.includes(edge.from)) list.push(edge.from);
+  }
+  const nodes: WorkflowGraphNode[] = graph.nodes.map((node) => ({
+    id: node.task_id,
+    parents: parents.get(node.task_id)!,
+    label: node.task_name,
+    taskLabel: node.task_id,
+    group: node.layer,
+    status: node.latest_run?.status ?? 'unknown',
+    durationS: node.latest_run?.duration_s,
+    failureRole: node.latest_run?.status === 'failed' ? 'source' : undefined,
+  }));
+  const byId = new Map(nodes.map((node) => [node.id, node]));
+  const { downstream } = buildGraphAdj(nodes);
+  const queue = nodes.filter((node) => node.failureRole === 'source').map((node) => node.id);
+  const seen = new Set(queue);
+  // Follow failed -> skipped chains only; successful/running tasks are not blocked.
+  for (let index = 0; index < queue.length; index++) {
+    for (const id of downstream.get(queue[index])!) {
+      const node = byId.get(id)!;
+      if (seen.has(id) || node.status !== 'skipped') continue;
+      seen.add(id);
+      node.failureRole = 'blocked';
+      queue.push(id);
+    }
+  }
+  return nodes;
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/governance/findings/findingModel.ts b/jiuwenswarm/channels/web/frontend/src/features/governance/findings/findingModel.ts
