+
+@media (prefers-reduced-motion: reduce) {
+  .dw-onboarding-guide__spotlight,
+  .dw-onboarding-guide__callout,
+  .dw-onboarding-guide__welcome-card {
+    animation: none;
+    transition: none;
+  }
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dwOnboardingGuide/DwOnboardingGuide.tsx b/jiuwenswarm/channels/web/frontend/src/features/dwOnboardingGuide/DwOnboardingGuide.tsx
new file mode 100644
index 000000000..df2054317
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dwOnboardingGuide/DwOnboardingGuide.tsx
@@ -0,0 +1,231 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useLayoutEffect, useMemo, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useTranslation } from 'react-i18next';
+import './DwOnboardingGuide.css';
+
+/** 首次使用分步引导：欢迎卡 → 工作空间（切换/管理，默认空间已自动创建）→ 知识图库配置 → 数据接入 → Embedding 配置（可选）。复用 modelSetupGuide 的聚光灯模式。 */
+export type DwOnboardingGuideStep = 0 | 1 | 2 | 3 | 4;
+
+interface DwOnboardingGuideProps {
+  step: DwOnboardingGuideStep;
+  onNext: () => void;
+  onSkip: () => void;
+}
+
+interface SpotlightRect {
+  top: number;
+  right: number;
+  bottom: number;
+  left: number;
+  width: number;
+  height: number;
+}
+
+// step2 依赖 App 先通过 requestSettingsModule 打开设置页的知识图库模块，目标元素才会出现；
+// 知识图库（SEMANTICA_*）必须先于数据接入配置——绑定数据源时的自动语义采集依赖它。
+// step4（可选）同理先打开设置页的模型模块，聚光灯框住 Embedding 配置区（标题 + 卡片）
+const SPOTLIGHT_SELECTORS: Record<1 | 2 | 3 | 4, string> = {
+  1: '[data-testid="workspace-switcher-trigger"]',
+  2: '[data-settings-module="knowledgeGraph"]',
+  3: '[data-testid="session-sidebar-nav-item"][data-variant="data-source"]',
+  4: '[data-testid="embedding-model-section"]',
+};
+
+const TOTAL_SPOTLIGHT_STEPS = 4;
+
+function toSpotlightRect(target: Element): SpotlightRect {
+  const rect = target.getBoundingClientRect();
+  const padding = 6;
+  const left = Math.min(window.innerWidth, Math.max(0, rect.left - padding));
+  const top = Math.min(window.innerHeight, Math.max(0, rect.top - padding));
+  const right = Math.max(left, Math.min(window.innerWidth, rect.right + padding));
+  const bottom = Math.max(top, Math.min(window.innerHeight, rect.bottom + padding));
+  return {
+    top,
+    right,
+    bottom,
+    left,
+    width: right - left,
+    height: bottom - top,
+  };
+}
+
+function rectsEqual(left: SpotlightRect | null, right: SpotlightRect): boolean {
+  return Boolean(
+    left
+    && left.top === right.top
+    && left.right === right.right
+    && left.bottom === right.bottom
+    && left.left === right.left,
+  );
+}
+
+export function DwOnboardingGuide({ step, onNext, onSkip }: DwOnboardingGuideProps) {
+  const { t } = useTranslation();
+  const [spotlight, setSpotlight] = useState<SpotlightRect | null>(null);
+  const isWelcomeStep = step === 0;
+
+  useLayoutEffect(() => {
+    if (isWelcomeStep) return;
+    const selector = SPOTLIGHT_SELECTORS[step];
+    const updateSpotlight = () => {
+      const target = document.querySelector(selector);
+      if (!target) {
+        setSpotlight(null);
+        return;
+      }
+      // 目标在视口外（如设置页长列表深处的 Embedding 卡）时先滚到可视区
+      const rect = target.getBoundingClientRect();
+      if (rect.top < 0 || rect.bottom > window.innerHeight) {
+        target.scrollIntoView({ block: 'center' });
+      }
+      const nextRect = toSpotlightRect(target);
+      setSpotlight((current) => (rectsEqual(current, nextRect) ? current : nextRect));
+    };
+    // 目标元素可能随页面切换延迟挂载（如 step3 的设置模块），监听 DOM 变化兜底
+    const mutationObserver = new MutationObserver(updateSpotlight);
+    mutationObserver.observe(document.body, { childList: true, subtree: true });
+    window.addEventListener('resize', updateSpotlight);
+    window.addEventListener('scroll', updateSpotlight, true);
+    updateSpotlight();
+
+    return () => {
+      mutationObserver.disconnect();
+      window.removeEventListener('resize', updateSpotlight);
+      window.removeEventListener('scroll', updateSpotlight, true);
+    };
+  }, [step, isWelcomeStep]);
+
+  const calloutStyle = useMemo(() => {
+    if (!spotlight) return undefined;
+    const gap = 16;
+    const width = Math.min(344, window.innerWidth - 32);
+    const estimatedHeight = 220;
+    const roomOnRight = window.innerWidth - spotlight.right;
+    const roomBelow = window.innerHeight - spotlight.bottom;
+
+    if (roomOnRight >= width + gap) {
+      return {
+        left: spotlight.right + gap,
+        top: Math.min(Math.max(16, spotlight.top), window.innerHeight - estimatedHeight - 16),
+        width,
+      };
+    }
+    if (roomBelow >= estimatedHeight + gap) {
+      return {
+        left: Math.min(Math.max(16, spotlight.left), window.innerWidth - width - 16),
+        top: spotlight.bottom + gap,
+        width,
+      };
+    }
+    return {
+      left: Math.min(Math.max(16, spotlight.right - width), window.innerWidth - width - 16),
+      top: Math.max(16, spotlight.top - estimatedHeight - gap),
+      width,
+    };
+  }, [spotlight]);
+
+  // 欢迎步骤：居中卡片列出三步概览，无聚光灯
+  if (isWelcomeStep) {
+    return createPortal(
+      <div className="dw-onboarding-guide dw-onboarding-guide--welcome" aria-live="polite" data-testid="dw-onboarding-guide-welcome">
+        <div className="dw-onboarding-guide__mask" style={{ inset: 0 }} />
+        <section
+          className="dw-onboarding-guide__welcome-card"
+          aria-labelledby="dw-onboarding-guide-welcome-title"
+          data-testid="dw-onboarding-guide-welcome-card"
+        >
+          <h2 id="dw-onboarding-guide-welcome-title" className="dw-onboarding-guide__welcome-title">
+            {t('dwOnboardingGuide.welcome.title')}
+          </h2>
+          <p className="dw-onboarding-guide__welcome-description">{t('dwOnboardingGuide.welcome.description')}</p>
+          <ol className="dw-onboarding-guide__welcome-steps">
+            {[1, 2, 3, 4].map((n) => (
+              <li key={n}>{t(`dwOnboardingGuide.welcome.step${n}`)}</li>
+            ))}
+          </ol>
+          <div className="dw-onboarding-guide__welcome-actions">
+            <button
+              type="button"
+              className="dw-onboarding-guide__primary-button"
+              onClick={onNext}
+              data-testid="dw-onboarding-guide-start"
+            >
+              {t('dwOnboardingGuide.welcome.start')}
+            </button>
+            <button
+              type="button"
+              className="dw-onboarding-guide__text-skip"
+              onClick={onSkip}
+              data-testid="dw-onboarding-guide-skip"
+            >
+              {t('dwOnboardingGuide.skip')}
+            </button>
+          </div>
+        </section>
+      </div>,
+      document.body,
+    );
+  }
+
+  if (!spotlight || !calloutStyle) return null;
+
+  return createPortal(
+    <div className="dw-onboarding-guide" aria-live="polite" data-testid="dw-onboarding-guide">
+      <div className="dw-onboarding-guide__mask" style={{ top: 0, right: 0, height: spotlight.top, left: 0 }} />
+      <div
+        className="dw-onboarding-guide__mask"
+        style={{ top: spotlight.top, left: 0, width: spotlight.left, height: spotlight.height }}
+      />
+      <div
+        className="dw-onboarding-guide__mask"
+        style={{ top: spotlight.top, right: 0, left: spotlight.right, height: spotlight.height }}
+      />
+      <div className="dw-onboarding-guide__mask" style={{ top: spotlight.bottom, right: 0, bottom: 0, left: 0 }} />
+      <div
+        className="dw-onboarding-guide__spotlight"
+        style={{ top: spotlight.top, left: spotlight.left, width: spotlight.width, height: spotlight.height }}
+        aria-hidden
+        data-testid="dw-onboarding-guide-spotlight"
+      />
+      <section
+        key={step}
+        className="dw-onboarding-guide__callout"
+        style={calloutStyle}
+        aria-labelledby={`dw-onboarding-guide-title-${step}`}
+        data-testid="dw-onboarding-guide-callout"
+      >
+        <button
+          type="button"
+          className="dw-onboarding-guide__pill-skip"
+          onClick={onSkip}
+          aria-label={t('dwOnboardingGuide.skip')}
+          data-testid="dw-onboarding-guide-skip"
+        >
+          {t('dwOnboardingGuide.skip')}
+        </button>
+        <div className="dw-onboarding-guide__copy">
+          <h2 id={`dw-onboarding-guide-title-${step}`} className="dw-onboarding-guide__title" data-variant={step}>
+            {t(`dwOnboardingGuide.steps.${step}.title`)}
+          </h2>
+          <p className="dw-onboarding-guide__description">{t(`dwOnboardingGuide.steps.${step}.description`)}</p>
+        </div>
+        <footer className="dw-onboarding-guide__footer">
+          <button
+            type="button"
+            className="dw-onboarding-guide__primary-button"
+            onClick={onNext}
+            data-testid="dw-onboarding-guide-next"
+          >
+            {step === TOTAL_SPOTLIGHT_STEPS ? t('dwOnboardingGuide.complete') : t('dwOnboardingGuide.next')}
+          </button>
+          <span className="dw-onboarding-guide__progress">
+            {t('dwOnboardingGuide.progress', { current: step, total: TOTAL_SPOTLIGHT_STEPS })}
+          </span>
+        </footer>
+      </section>
+    </div>,
+    document.body,
+  );
+}
