+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dataagent/business_data/sqlite_impl.py — SQLite 业务库访问实现。
+
+绑定 ref 时只访问该文件；显式无 ref 的旧模式扫描 workspace/data。
+"""
+from __future__ import annotations
+
+import sqlite3
+from contextlib import closing
+from pathlib import Path
+
+from jiuwenswarm.common.dw_layer import infer_layer as _infer_layer
+from jiuwenswarm.common.utils import get_user_workspace_dir
+
+from .base import BusinessDataDao, register
+
+
+@register
+class SqliteBusinessDao(BusinessDataDao):
+    dao_type = "sqlite"
+
+    def __init__(self, db_ref: str | None = None):
+        self.db_ref = db_ref
+        self._bound_path = self._ref_path(db_ref) if db_ref else None
+
+    @staticmethod
+    def _ref_path(db_ref: str) -> Path:
+        from jiuwenswarm.common.db_connector import parse_db_ref
+
+        if "://" in db_ref and db_ref.split("://", 1)[0].lower() != "sqlite":
+            raise ValueError("SQLite business database requires a file reference")
+        spec = parse_db_ref(db_ref)
+        if spec.get("type") != "sqlite" or not spec.get("path"):
+            raise ValueError("SQLite business database requires a file reference")
+        return Path(spec["path"]).expanduser().resolve()
+
+    def _db_path(self, db_name: str) -> Path:
+        if self._bound_path is None:
+            return self._local_db_path(db_name)
+        if db_name == self._bound_path.stem or db_name == self.db_ref:
+            return self._bound_path
+        if "://" in db_name or Path(db_name).is_absolute():
+            if self._ref_path(db_name) == self._bound_path:
+                return self._bound_path
+        raise ValueError("database selector does not match the bound SQLite database")
+
+    @staticmethod
+    def _read_connection(path: Path):
+        # Read-only URI mode also prevents creation if a file disappears between
+        # the existence check and connect. Explicit closing releases Windows handles.
+        return closing(sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True))
+
+    @staticmethod
+    def _local_db_path(db_name: str) -> Path:
+        """业务 SQLite 库路径。
+
+        三种输入形态：
+        - ``sqlite://<绝对路径>``（databases API 透传完整 db-ref）→ 直接用解析路径；
+          旧实现拼成 ``<workspace>/data/sqlite://…​.db`` 恒不存在 → 表清单永远为空。
+        - 含路径分隔符或 ``.db/.sqlite`` 后缀 → 视为路径。
+        - 纯库名（列表页/旧调用）→ ``<workspace>/data/<db_name>.db``。
+        """
+        raw = str(db_name or "").strip()
+        if "://" in raw:
+            from jiuwenswarm.common import db_connector
+
+            ref_path = db_connector.parse_db_ref(raw).get("path")
+            if ref_path:
+                return Path(ref_path)
+        if "/" in raw or "\\" in raw or raw.endswith((".db", ".sqlite", ".sqlite3")):
+            return Path(raw)
+        return Path(get_user_workspace_dir()) / "data" / f"{raw}.db"
+
+    @staticmethod
+    def _count_sqlite_tables(path: Path) -> int:
+        """SELECT count(*) FROM sqlite_master WHERE type='table'。"""
+        try:
+            with SqliteBusinessDao._read_connection(path) as conn:
+                cur = conn.execute(
+                    "SELECT COUNT(*) FROM sqlite_master "
+                    "WHERE type='table' AND name NOT LIKE 'sqlite_%'"
+                )
+                return int(cur.fetchone()[0] or 0)
+        except sqlite3.Error:
+            return 0
+
+    def list_databases(self) -> list[dict]:
+        """列绑定文件；只有无 ref 的旧模式扫描 <workspace>/data/*.db。
+
+        只列 SQLite 自己的库——Doris 库由 DorisBusinessDao 负责，
+        业务库类型由 get_dao() 按 default_db 判定，这里不读 doris 配置。
+        """
+        if self._bound_path is not None:
+            paths = [self._bound_path] if self._bound_path.is_file() else []
+        else:
+            db_dir = Path(get_user_workspace_dir()) / "data"
+            paths = sorted(db_dir.glob("*.db")) if db_dir.exists() else []
+        return [{
+            "name": path.stem,
+            "path": str(path),
+            "size_bytes": path.stat().st_size,
+            "table_count": self._count_sqlite_tables(path),
+        } for path in paths]
+
+    def list_tables(self, db_name: str) -> list[dict]:
+        """SQLite: sqlite_master 列业务库的表。"""
+        path = self._db_path(db_name)
+        if not path.exists():
+            return []
+        result: list[dict] = []
+        try:
+            with self._read_connection(path) as conn:
+                conn.row_factory = sqlite3.Row
+                rows = conn.execute(
+                    "SELECT name FROM sqlite_master "
+                    "WHERE type='table' AND name NOT LIKE 'sqlite_%' "
+                    "ORDER BY name"
+                ).fetchall()
+                for r in rows:
+                    name = r["name"]
+                    col_count = 0
+                    try:
+                        col_count = len(conn.execute(
+                            f'PRAGMA table_info("{name}")'
+                        ).fetchall())
+                    except sqlite3.Error:
+                        pass
+                    result.append({
+                        "name": name,
+                        # 列表层不统计行数：SQLite 无 information_schema 估算，
+                        # COUNT(*) 是全表扫描，大表（千万级）会把列表接口拖到秒级。
+                        # None = 未统计（旧实现恒返回 0，曾被模型读成「空表」直接
+                        # 放弃分析——dacomp-zh-001 实证 39 万行表报 0 行）。
+                        # 真实行数走表详情 get_table_detail / 预览 total。
+                        "row_count": None,
+                        "column_count": col_count,
+                        "layer": _infer_layer(name),
+                        "last_modified": "",
+                    })
+        except sqlite3.Error:
+            return []
+        return result
+
+    def get_table_detail(self, db_name: str, table_name: str) -> dict:
+        """SQLite: sqlite_master.sql + PRAGMA table_info。"""
+        path = self._db_path(db_name)
+        if not path.exists():
+            raise LookupError(f"database not found: {db_name}")
+        with self._read_connection(path) as conn:
+            conn.row_factory = sqlite3.Row
+            row = conn.execute(
+                "SELECT sql FROM sqlite_master WHERE type='table' AND name=?",
+                (table_name,),
+            ).fetchone()
+            if not row:
+                raise LookupError(f"table not found: {table_name}")
+            ddl = row["sql"] or ""
+            cols = conn.execute(f'PRAGMA table_info("{table_name}")').fetchall()
+            columns = [{
+                "name": c["name"],
+                "type": c["type"],
+                "nullable": c["notnull"] == 0,
+                "primary_key": bool(c["pk"]),
+                "default_value": c["dflt_value"],
+            } for c in cols]
+            indexes: list[dict] = []
+            try:
+                for idx in conn.execute(
+                    f'PRAGMA index_list("{table_name}")'
+                ).fetchall():
+                    info = conn.execute(
+                        f'PRAGMA index_info("{idx["name"]}")'
+                    ).fetchall()
+                    indexes.append({
+                        "name": idx["name"],
+                        "columns": [c["name"] for c in info],
+                        "sql": "",
+                        "unique": bool(idx["unique"]),
+                    })
+            except sqlite3.Error:
+                pass
+            try:
+                cnt = conn.execute(
+                    f'SELECT COUNT(*) FROM "{table_name}"'
+                ).fetchone()
+                row_count = int(cnt[0] or 0)
+            except sqlite3.Error:
+                row_count = 0
+        return {
+            "name": table_name,
+            "ddl": ddl,
+            "columns": columns,
+            "indexes": indexes,
+            "foreign_keys": [],
+            "row_count": row_count,
+            "comment": "",  # SQLite 无表 comment 概念
+        }
+
+    def preview_table(self, db_name: str, table_name: str,
+                      limit: int = 10, offset: int = 0) -> dict:
+        """SQLite: SELECT * FROM "table" LIMIT N OFFSET M（附全表行数 total）。"""
+        limit = max(1, min(int(limit), 1000))
+        offset = max(0, int(offset))
+        path = self._db_path(db_name)
+        if not path.exists():
+            raise LookupError(f"database not found: {db_name}")
+        with self._read_connection(path) as conn:
+            conn.row_factory = sqlite3.Row
+            cnt = conn.execute(
+                f'SELECT COUNT(*) FROM "{table_name}"'
+            ).fetchone()
+            total = int(cnt[0] or 0) if cnt else 0
+            cur = conn.execute(
+                f'SELECT * FROM "{table_name}" LIMIT ? OFFSET ?', (limit, offset)
+            )
+            columns = [d[0] for d in cur.description]
+            rows = [list(r) for r in cur.fetchall()]
+        return {"columns": columns, "rows": rows, "total": total}
