+@pytest.mark.parametrize("partial_add", [False, True])
+def test_sync_failed_replacement_restores_previous_vectors_and_metadata(vector_env, monkeypatch, partial_add):
+    """An add failure after replacement deletion must not lose prior vectors."""
+    vector_store.sync_workspace_vectors("ws", "orders", _snapshot(include_amount=False))
+    store = vector_env.store
+    before = {doc_id: vector.copy() for doc_id, vector in store.vectors.items()}
+    metadata_before = {doc_id: dict(meta) for doc_id, meta in store.index.metadata.items()}
+    original_add = store.add_vectors
+    attempts = 0
+
+    def failing_add(vectors, ids=None, metadata=None):
+        nonlocal attempts
+        attempts += 1
+        if attempts == 1:
+            # Real SDK assigns metadata before adding physical vectors.
+            store.index.metadata.update({doc_id: dict(meta) for doc_id, meta in zip(ids, metadata)})
+            if partial_add:
+                original_add(vectors[:1], ids=ids[:1], metadata=metadata[:1])
+            raise RuntimeError("injected add failure")
+        return original_add(vectors, ids=ids, metadata=metadata)
+
+    monkeypatch.setattr(store, "add_vectors", failing_add)
+    result = vector_store.sync_workspace_vectors(
+        "ws", "orders", _snapshot(phone_comment="new phone", include_amount=True))
+    assert result == {"status": "failed", "reason": "vector_update_failed:RuntimeError"}
+    assert store.index.metadata == metadata_before
+    assert set(store.vectors) == set(before)
+    assert all(np.array_equal(store.vectors[doc_id], vector) for doc_id, vector in before.items())
+
