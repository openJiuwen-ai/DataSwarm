+# --------------------------------------------------------------------------
+# workspace 注入收敛（_call_api 层兜底）
+# 回归：多工作空间环境 instance wait 漏传 workspace → 服务端 400
+# WORKSPACE_CONTEXT_REQUIRED，Agent 调试工作流时反复重试失败（2026-09-15）。
+# wait/json_body 等特判分支不经过通用 query 组装，注入必须收敛到 _call_api。
+# --------------------------------------------------------------------------
+class TestCallApiWorkspaceInjection:
+    @pytest.fixture(autouse=True)
+    def _clean_ws_attr(self):
+        yield
+        dwcli._ACTIVE_WORKSPACE_ID = None
+
+    @staticmethod
+    def _capture_url(monkeypatch, payload='{"instance_id": "i1", "status": "success"}'):
+        captured = {}
+
+        class FakeResp:
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *a):
+                return False
+
+            def read(self):
+                return payload.encode("utf-8")
+
+        def fake_urlopen(req, timeout=30):
+            captured["url"] = req.full_url
+            return FakeResp()
+
+        monkeypatch.setattr(dwcli.urllib.request, "urlopen", fake_urlopen)
+        return captured
+
+    def test_wait_loop_sends_workspace_query(self, monkeypatch):
+        """wait 轮询的每次 GET 都必须带 workspace（原 bug：只带 interval/timeout
+        之外的什么都没有）。"""
+        captured = self._capture_url(monkeypatch)
+        monkeypatch.setattr(dwcli, "_ACTIVE_WORKSPACE_ID", "bank")
+        monkeypatch.setattr(dwcli.time, "sleep", lambda s: None)
+        out, terminal = dwcli._wait_instance("i1", timeout_s=1, interval=0, base="")
+        assert terminal is True
+        assert "workspace_id=bank" in captured["url"]
+
+    def test_explicit_query_not_overridden(self, monkeypatch):
+        """调用方显式携带的 workspace 优先，兜底不覆盖。"""
+        captured = self._capture_url(monkeypatch)
+        monkeypatch.setattr(dwcli, "_ACTIVE_WORKSPACE_ID", "bank")
+        dwcli._call_api("GET", "/orchestration/instances/i1",
+                        query_params={"workspace_id": "default"})
+        assert "workspace_id=default" in captured["url"]
+        assert "bank" not in captured["url"]
+
+    def test_no_workspace_no_injection(self, monkeypatch):
+        """单工作空间（无 workspace 解析值）不加 query，保持原行为。"""
+        captured = self._capture_url(monkeypatch)
+        monkeypatch.setattr(dwcli, "_ACTIVE_WORKSPACE_ID", None)
+        dwcli._call_api("GET", "/orchestration/instances/i1")
+        assert "workspace_id" not in captured["url"]
+
+    def test_absolute_path_not_injected(self, monkeypatch):
+        """absolute_path 路由沿用通用分支的"不注入"约定。"""
+        captured = self._capture_url(monkeypatch)
+        monkeypatch.setattr(dwcli, "_ACTIVE_WORKSPACE_ID", "bank")
+        dwcli._call_api("GET", "/api/inspection/persist", absolute_path=True)
+        assert "workspace_id" not in captured["url"]
+
+    def test_http_error_payload_echoes_sent_query(self, monkeypatch):
+        """HTTP 错误载荷回显请求实际携带的 query：stderr 横幅只反映本地 env
+        解析结果，不等于请求参数（Agent 曾据此误判参数已生效而反复重试）。"""
+        import io
+        import urllib.error
+
+        def fake_urlopen(req, timeout=30):
+            raise urllib.error.HTTPError(
+                req.full_url, 400, "Bad Request", {},
+                io.BytesIO(json.dumps(
+                    {"error": "WORKSPACE_CONTEXT_REQUIRED"}).encode("utf-8")))
+
+        monkeypatch.setattr(dwcli.urllib.request, "urlopen", fake_urlopen)
+        monkeypatch.setattr(dwcli, "_ACTIVE_WORKSPACE_ID", "bank")
+        result = dwcli._call_api("GET", "/orchestration/instances/i1")
+        assert result["sent_query"] == {"workspace_id": "bank"}
+        assert result["error"] == "WORKSPACE_CONTEXT_REQUIRED"
+
+    def test_main_wait_e2e_injects_workspace(self, monkeypatch):
+        """端到端：CLI --workspace-id 经 main → _call_api 兜底进 query。
+        复刻事故命令形态 `dwcli --workspace-id default instance wait --id ...`。"""
+        captured = self._capture_url(monkeypatch)
+        monkeypatch.setattr(dwcli.time, "sleep", lambda s: None)
+        with pytest.raises(SystemExit) as ei:
+            dwcli.main(["--workspace-id", "bank", "instance", "wait",
+                        "--id", "i1", "--timeout", "1", "--interval", "0"])
+        assert ei.value.code == 0
+        assert "workspace_id=bank" in captured["url"]
+
