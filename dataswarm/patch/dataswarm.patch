+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Unit tests for the kb-manage and kb-search skill files.
+
+Verifies SKILL.md frontmatter and that ``allowed_tools`` declarations match
+the actual tool card names exported by ``kb_tools.get_decorated_tools``.
+"""
+
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+import yaml
+
+from jiuwenswarm.agents.harness.common.tools.kb_tools import get_decorated_tools
+
+SKILLS_DIR = (
+    Path(__file__).resolve().parents[3]
+    / "jiuwenswarm"
+    / "resources"
+    / "agent"
+    / "workspace"
+    / "skills"
+)
+
+
+def _parse_skill_md(path: Path) -> dict:
+    text = path.read_text(encoding="utf-8")
+    m = re.match(r"^---\s*\n(.*?)\n---\s*\n?(.*)", text, re.DOTALL)
+    assert m, f"SKILL.md frontmatter not found in {path}"
+    meta = yaml.safe_load(m.group(1)) or {}
+    return meta
+
+
+def _tool_card_names() -> set[str]:
+    names = set()
+    for tool in get_decorated_tools():
+        card = getattr(tool, "card", None)
+        name = getattr(card, "name", None) or getattr(tool, "name", None)
+        if name:
+            names.add(name)
+    return names
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="POSIX-only assumption; fails on Windows path/permission semantics")
+
+
+def test_kb_manage_frontmatter():
+    meta = _parse_skill_md(SKILLS_DIR / "kb-manage" / "SKILL.md")
+    assert meta["name"] == "kb-manage"
+    assert "description" in meta and meta["description"]
+    assert meta["allowed_tools"] == [
+        "kb_list",
+        "kb_create",
+        "kb_get",
+        "kb_update",
+        "kb_list_entries",
+        "kb_upload_file",
+        "kb_attach_dir",
+        "kb_delete_documents",
+        "kb_delete",
+    ]
+
+
+def test_kb_search_frontmatter():
+    meta = _parse_skill_md(SKILLS_DIR / "kb-search" / "SKILL.md")
+    assert meta["name"] == "kb-search"
+    assert "description" in meta and meta["description"]
+    assert meta["allowed_tools"] == ["kb_search"]
+
+
+def test_allowed_tools_match_actual_tool_names():
+    """Every allowed_tools entry must be a real tool card name."""
+    actual = _tool_card_names()
+    for skill in ("kb-manage", "kb-search"):
+        meta = _parse_skill_md(SKILLS_DIR / skill / "SKILL.md")
+        for t in meta.get("allowed_tools", []):
+            assert t in actual, f"skill {skill} declares tool '{t}' not in kb_tools export"
+
+
+def test_references_exist():
+    """Referenced files in SKILL.md should exist on disk."""
+    for skill, refs in [
+        ("kb-manage", ["kb-concepts.md", "manage-ops.md", "upload-guide.md", "troubleshooting.md"]),
+        ("kb-search", ["search-params.md"]),
+    ]:
+        for ref in refs:
+            p = SKILLS_DIR / skill / "references" / ref
+            assert p.exists(), f"missing reference {p}"
