+                          disabled={busy}
+                          title={suggestion.key}
+                          onClick={() => void adoptSuggestion(asset, suggestion)}>
+                          {t('knowledge.list.suggestionChip', {
+                            name: suggestion.name,
+                            kind: t(suggestion.kind === 'metric' ? 'knowledge.type.metric' : 'knowledge.type.term'),
+                          })}
+                        </button>
+                      ))}
+                    </div>
+                  )}
+                  {asset.status !== 'retired' && (
+                    <div className="mt-3 flex flex-wrap items-center gap-2">
+                      {asset.status === 'candidate' && <Button size="xs" disabled={busy} onClick={() => void act(asset, 'approve')}>{t('knowledge.action.approve')}</Button>}
+                      {asset.status === 'approved' && <Button size="xs" variant="primary" disabled={busy} onClick={() => void act(asset, 'publish')}>{t('knowledge.action.publish')}</Button>}
+                      {asset.status !== 'published' && (
+                        <Button size="xs" disabled={busy} title={t('knowledge.list.editBtnHint')} onClick={() => setEditing(asset)}>
+                          <Pencil size={12} className="mr-1 inline" />{t('knowledge.list.editBtn')}
+                        </Button>
+                      )}
+                      <Button size="xs" className="ml-auto" disabled={busy} title={t('knowledge.list.retireBtnHint')}
+                        onClick={() => void act(asset, 'retire')}>
+                        <Archive size={12} className="mr-1 inline" />{t('knowledge.list.retireBtn')}
+                      </Button>
+                    </div>
+                  )}
+                </article>
+              );
+            })}</div>
+            <div className="mt-3">
+              <Pagination total={assetTotal} page={assetPage} pageSize={assetPageSize}
+                onPageChange={(next) => { setAssetPage(next); setSelected(new Set()); }}
+                onPageSizeChange={(size) => { setAssetPageSize(size); setAssetPage(1); setSelected(new Set()); }}
+                labels={paginationLabels('asset')} loading={busy} />
+            </div>
+          </>}
+      </Panel>
+
+      {(creating || editing) && (
+        <KnowledgeAssetFormDrawer
+          asset={editing}
+          catalogEmpty={catalogEmpty}
+          onClose={() => { setCreating(false); setEditing(null); }}
+          onSaved={() => {
+            setCreating(false); setEditing(null);
+            void refresh().catch((error: Error) => setNotice(error.message));
+          }}
+        />
+      )}
+      </>)}
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermDetailDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/dashboard/components/TermDetailDrawer.tsx
new file mode 100644
