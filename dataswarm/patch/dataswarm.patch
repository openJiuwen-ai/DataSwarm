@@ -0,0 +1,352 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+/**
+ * 治理页内置 Agent 对话（Copilot 式右侧栏）的自包含工具模块。
+ *
+ * 设计要点（见 docs/archive/delivered/governance-embedded-chat-plan.md）：
+ * - 不经 App 层事件桥：直接用 webClient/webRequest 单例 + zustand 命令式调用。
+ * - 会话状态按 sessionId 隔离在 useChatStore.runtimes，WS 流式事件自动写入对应
+ *   runtime，与全局 activeSessionId 无关 → 这里只需触发请求、无需自建事件监听。
+ * - 前端 addMessage 的"上下文卡"后端不可见 → 巡检上下文以 ctxPrefix 前缀拼进
+ *   真实 chat.send 的 content 下发；可视卡只用于展示标注。
+ */
+
+import { webRequest, webClient } from '../../../services/webClient';
+import { useChatStore } from '../../../stores';
+import { getCurrentDatasourceWorkspaceId } from '../../../stores/datasourceWorkspaceStore';
+import type { WebError } from '../../../types';
+import { beginHistoryRestore, HISTORY_GET_METHOD } from '../../historyRestore';
+import { normalizeToolCallPayload, normalizeToolResultPayload } from '../../tool-events/toolEventNormalizer';
+import type { Message } from '../../../types';
+import type { ArtifactMap, Finding, FindingsArtifact, HealthDimension, InspectionSummary } from '../types/inspection';
+import { appendEntry, findBoundSid, readEntries, writeEntries } from './governanceSessionStore';
+
+// 治理助手会话存储：按巡检批次 run ↔ 会话 id 的映射列表。
+// 旧版是单个 id（'jiuwen.governance.chatSessionId'）：一轮巡检一个全局 singleton，
+// 跨所有批次复用 → 不同轮次的「开始修复」全发进同一会话。现升级为列表，每批次有自己的会话。
+// 纯数据层（readEntries/writeEntries/findBoundSid/appendEntry）抽出在 governanceSessionStore.ts，
+// 便于 node 下测试「同批次复用 / 跨批次独立 / 列表封顶」等核心语义。
+export const GOV_SESSION_STORAGE_KEY = 'jiuwen.governance.chatSessionIds';
+
+/** WS 就绪后执行回调（request() 本身会等 ensureReady，这里主要给一次性初始化用）。 */
+export function whenWebReady(cb: () => void): () => void {
+  if (webClient.getState() === 'ready') {
+    cb();
+    return () => {};
+  }
+  let done = false;
+  const unsubscribe = webClient.onStateChange(state => {
+    if (!done && state === 'ready') {
+      done = true;
+      unsubscribe();
+      cb();
+    }
+  });
+  return unsubscribe;
+}
+
+// ---------------------------------------------------------------------------
+// 会话生命周期
+// ---------------------------------------------------------------------------
+
+/** 本次页面生命周期内新建的会话 id 集：新建即空会话，历史恢复可跳过（拉取只会空场）。 */
+const govSessionsCreatedThisLoad = new Set<string>();
+/** 本次页面生命周期内已验证存活（或新建）的会话 id：重复 ensure 同一 run 时跳过重复验活 RPC。 */
+const govSessionsVerifiedThisLoad = new Set<string>();
+/** 按 runId 共享在途 ensure promise：同 run 并发去重，跨 run 各自独立。 */
+const govSessionPromises = new Map<string, Promise<string>>();
+
+function verifyGovernanceSession(sid: string): Promise<boolean> {
+  // 仅把明确的 NOT_FOUND（Gateway 读盘确认会话不存在/已被清理）视为失效；
+  // 超时、WS 断连、SERVICE_UNAVAILABLE 等瞬时错误一律保留旧 sid ——
+  // 宁可复用旧会话，也不能 fork 新会话制造孤儿（验活失败 ≠ 会话失效）。
+  return webRequest('session.get_metadata', { session_id: sid })
+    .then(() => true)
+    .catch(error => {
+      const webError = error as WebError;
+      if (webError?.code === 'NOT_FOUND') return false;
+      console.warn('[governance.session-verify] 瞬时错误，保留旧会话重用:', sid, error);
+      return true;
+    });
+}
+
+/** 新建治理会话并把 {sid, runId} 写进存储列表（fail-open：持久化失败不阻塞对话）。 */
+
+// crypto.randomUUID 仅安全上下文（HTTPS/localhost）可用；HTTP+IP 访问（如远程演示机）会抛
+// TypeError 导致会话建不起来。跟随 chatStore.createReasoningSegmentId 的降级写法。
+function createSessionToken(): string {
+  if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
+    return crypto.randomUUID();
+  }
+  return `tok-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+async function createGovernanceSession(runId = ''): Promise<string> {
+  // 多工作空间（决策四）：治理会话同样落工作空间归属（缺省 'default'）
+  const wsId = getCurrentDatasourceWorkspaceId() || 'default';
+  const payload = await webRequest<{ session_id?: string }>('session.create', {
+    create_token: createSessionToken(),
+    mode: 'agent',
+    title: `数仓治理 · 巡检 ${runId}`,
+    workspace_id: wsId,
+  });
+  const sid = typeof payload?.session_id === 'string' ? payload.session_id : '';
+  if (!sid) throw new Error('session.create 未返回 session_id');
+  const entries = appendEntry(readEntries(localStorage), { sid, runId });
+  writeEntries(localStorage, entries);
+  govSessionsCreatedThisLoad.add(sid);
+  return sid;
+}
+
+/** 治理 AI 助手会话标题：标题跟随当前选中的巡检批次。
+ * 幂等：仅在目标 runId 尚未设置给该会话时调用 session.rename（本地记账防重复请求）。 */
+let govSessionTitledForRun = '';
+
+export async function updateGovernanceSessionTitle(sid: string, runId: string): Promise<void> {
+  if (!sid || !runId) return;
+  if (govSessionTitledForRun === runId) return;
+  try {
+    await webRequest('session.rename', {
+      session_id: sid,
+      title: `数仓治理 · 巡检 ${runId}`,
+    });
+    govSessionTitledForRun = runId;
+  } catch (error) {
+    // 标题更新失败不阻塞对话，下次切批次再试
+    console.warn('[governance.session-title]', error);
+  }
+}
+
+/**
+ * 确保治理专属会话存在并返回 sessionId：
+ * - runId 已绑定过会话 → 校验（仅明确 NOT_FOUND 才视为已被清理）通过则幂等复用（同一批次内
+ *   第二次「开始修复」/追问仍回本批次会话）。
+ * - 未绑定 / 会话被清理 → 新建并绑定到该 run。
+ * 并发调用按 runId 共享同一次初始化。
+ */
+export function ensureGovernanceSession(runId: string): Promise<string> {
+  if (!runId) return Promise.reject(new Error('治理会话必须绑定巡检批次'));
+  const pending = govSessionPromises.get(runId);
+  if (pending) return pending;
+  const chain = (async () => {
+    const entries = readEntries(localStorage);
+    const boundSid = findBoundSid(entries, runId);
+    const sid = boundSid
+      ? govSessionsVerifiedThisLoad.has(boundSid)
+        ? boundSid
+        : await verifyGovernanceSession(boundSid).then(ok => (ok ? boundSid : null))
+      : null;
+    if (sid) {
+      govSessionsVerifiedThisLoad.add(sid);
+      useChatStore.getState().ensureRuntime(sid);
+      return sid;
+    }
+    // 无绑定或旧会话被清理 → 新建并绑定当前批次
+    const fresh = await createGovernanceSession(runId);
+    govSessionsVerifiedThisLoad.add(fresh);
+    useChatStore.getState().ensureRuntime(fresh);
+    return fresh;
+  })();
+  govSessionPromises.set(runId, chain);
+  chain.finally(() => govSessionPromises.delete(runId)).catch(() => {});
+  return chain;
+}
+
+/** 会话是否为本次页面生命周期内新建（新建即空会话，历史恢复可跳过）。 */
+export function isGovSessionCreatedThisLoad(sid: string): boolean {
+  return govSessionsCreatedThisLoad.has(sid);
+}
+
+/** 恢复历史对话（消息 + 思考段 + 工具流回放）。新会话无历史属正常情况静默返回。 */
+export async function restoreGovernanceHistory(sid: string): Promise<void> {
+  const chatStore = useChatStore.getState();
+  chatStore.ensureRuntime(sid);
+  chatStore.setLoadingHistory(sid, true);
+
+  const handle = beginHistoryRestore({
+    sessionId: sid,
+    onReady: (messages: Message[]) => {
+      useChatStore.getState().replaceHistoryMessages(sid, messages);
+      useChatStore.getState().setLoadingHistory(sid, false);
+    },
+    onEmpty: () => {
+      useChatStore.getState().replaceHistoryMessages(sid, []);
+      useChatStore.getState().setLoadingHistory(sid, false);
+    },
+    onToolReplay: items => {
+      const store = useChatStore.getState();
+      for (const item of items) {
+        if (item.kind === 'tool_call') {
+          const n = normalizeToolCallPayload(item.payload);
+          store.addToolCall(
+            sid,
+            {
+              id: n.id,
+              name: n.name,
+              arguments: n.arguments,
+              description: n.description,
+              formatted_args: n.formatted_args,
+              display_name: n.display_name,
+              memberName: n.memberName,
+            },
+            { startedAt: item.at },
+          );
+        } else {
+          const n = normalizeToolResultPayload(item.payload);
+          store.addToolResult(
+            sid,
+            {
+              toolName: n.toolName,
+              result: n.result,
+              success: n.success,
+              toolCallId: n.toolCallId,
+              summary: n.summary,
+              skillTree: n.skillTree,
+              ...(n.timedOut ? { timedOut: true } : {}),
+              ...(n.beamSearch ? { beamSearch: n.beamSearch } : {}),
+            },
+            { updatedAt: item.at },
+          );
+        }
+      }
+      store.settleHistoricalToolExecutions(sid);
+    },
+    onReasoningReplay: items => {
+      useChatStore.getState().restoreReasoningSegments(sid, items);
+    },
+    onError: warnMessage => {
+      console.warn('[governance.history]', warnMessage);
+      useChatStore.getState().setLoadingHistory(sid, false);
+    },
+  });
+
+  try {
+    await webRequest(HISTORY_GET_METHOD, { session_id: sid, page_idx: 1 }, { timeoutMs: 20_000 });
+  } catch (error) {
+    handle.dispose();
+    useChatStore.getState().setLoadingHistory(sid, false);
+    const errorMessage = error instanceof Error ? error.message : String(error);
+    // 新会话没有历史是正常情况
+    if (!errorMessage.includes('invalid page_idx or session history not found')) {
+      throw error;
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 巡检上下文注入
+// ---------------------------------------------------------------------------
+
+function countHigh(findings?: Finding[]): number {
+  return (findings ?? []).filter(f => f.severity === 'high').length;
+}
+
+function dimensionLabel(scores: InspectionSummary['health_scores'], key: keyof NonNullable<InspectionSummary['health_scores']>): string {
+  const d: HealthDimension | undefined = scores?.[key];
+  if (!d) return `${key}: -`;
+  return `${key}:${d.score}分(高危${d.high})`;
+}
+
+/** 浓缩巡检上下文前缀（随 chat.send content 下发给模型），≤1500 字符。 */
+export function buildInspectionContext(runId: string, summary: InspectionSummary | null, artifacts: ArtifactMap = {}): string {
+  if (!summary || !runId) return '';
+  const meta = summary.meta;
+  const lines: string[] = [];
+  lines.push(`# 治理上下文（自动注入，请作为本轮回答的事实依据）`);
+  lines.push(`- run_id: ${meta.run_id}`);
+  if (meta.db) lines.push(`- 数据库: ${meta.db}`);
+  if (meta.run_at) lines.push(`- 巡检时间: ${meta.run_at}`);
+
+  const scores = summary.health_scores;
+  if (scores) {
+    lines.push(
+      `- 健康分: ${dimensionLabel(scores, 'schema')} / ${dimensionLabel(scores, 'quality')} / ${dimensionLabel(scores, 'lineage')}`,
+    );
+  }
+
+  // run 级 AI 解读优先注入（--ai-report 产物；模型直接继承解读结论，替代人肉拼高危清单）
+  if (summary.ai_summary) {
+    lines.push(`- AI 解读: ${summary.ai_summary.slice(0, 400)}`);
+  }
+
+  const dimArtifacts: Array<[string, FindingsArtifact | undefined]> = [
+    ['表结构', artifacts.schema],
+    ['数据质量', artifacts.data],
+    ['血缘', artifacts.lineage],
+  ];
+  const highLines: string[] = [];
+  for (const [label, artifact] of dimArtifacts) {
+    const findings = artifact?.findings ?? [];
+    if (!findings.length) continue;
+    highLines.push(`${label}: 高危 ${countHigh(findings)} / 共 ${findings.length}`);
+  }
+  if (highLines.length) lines.push(`- 各维度问题分布: ${highLines.join('; ')}`);
+
+  // Top-N 高危 finding（id+摘要），上限防前缀失控
+  const allFindings = Object.values(artifacts).flatMap(a => (a as FindingsArtifact | undefined)?.findings ?? []);
+  const topHigh = allFindings.filter(f => f.severity === 'high').slice(0, 10);
+  for (const f of topHigh) {
+    lines.push(`- [high][${f.id}] ${f.summary.slice(0, 80)}`);
+  }
+
+  const text = lines.join('\n');
+  return text.length > 1500 ? `${text.slice(0, 1497)}...` : text;
+}
+
+// ---------------------------------------------------------------------------
+// 发送 / 打断
+// ---------------------------------------------------------------------------
+
+/**
+ * 发送一条用户消息到治理会话：
+ * 本地先落 user 气泡并置 processing → chat.send（ctxPrefix 存在时拼接为 content 前缀）。
+ * 失败时回写 system 提示气泡并清理 processing 态（镜像 useWebSocket 主链路的失败清理）。
+ */
+export async function sendGovernanceMessage(sid: string, rawContent: string, ctxPrefix?: string): Promise<void> {
+  const trimmed = rawContent.trim();
+  if (!trimmed || !sid) return;
+  const chatStore = useChatStore.getState();
+  chatStore.ensureRuntime(sid);
+
+  const content = ctxPrefix ? `${ctxPrefix}\n\n---\n\n${trimmed}` : trimmed;
+
+  chatStore.addMessage(sid, {
+    id: `gov-user-${Date.now()}`,
+    role: 'user',
+    content: trimmed,
+    timestamp: new Date().toISOString(),
+  });
+  chatStore.setProcessing(sid, true);
+  chatStore.setThinking(sid, true);
+
+  try {
+    // workspace_id 不在此携带（方案 A，归属创建时锁定）：createGovernanceSession
+    // 的 session.create 已把归属定死，chat.send 再带全局当前选择无意义，且在旧
+    // 服务端（覆盖式语义）下会把归属迁走
+    await webRequest('chat.send', {
+      session_id: sid,
+      content,
+      mode: 'agent',
+    });
+  } catch (error) {
+    const errorMessage = error instanceof Error ? error.message : String(error);
+    const store = useChatStore.getState();
+    store.setProcessing(sid, false);
+    store.setThinking(sid, false);
+    store.addMessage(sid, {
+      id: `gov-error-${Date.now()}`,
+      role: 'system',
+      content: `消息发送失败：${errorMessage}`,
+      timestamp: new Date().toISOString(),
+    });
+    throw error;
+  }
+}
+
+/** 打断当前轮次（空闲时是无害 no-op，重连兜底也可调用）。 */
+export async function stopGovernanceTurn(sid: string): Promise<void> {
+  try {
+    await webRequest('chat.interrupt', { session_id: sid, intent: 'cancel' });
+  } catch (error) {
+    console.warn('[governance.interrupt]', error);
+  }
+}
