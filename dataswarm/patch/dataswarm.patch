+
+    不读开发者机器的真实 ~/.jiuwenswarm/（环境泄漏：机器配了多个工作空间
+    或注册表有 custom 工作空间时，未带 workspace_id 的请求按决策八-1
+    大声失败，这些 legacy 用例会全部误红）。多工作空间语义由
+    test_workspace_isolation.py 覆盖。
+    """
+    cfg = tmp_path / "datasource.yaml"
+    # sqlite 指针：doris 方言已退役，且 doris://<库名> 会读真实 config 的 doris 段（环境泄漏）
+    cfg.write_text(
+        f"default_db: sqlite://{tmp_path / 'biz.db'}\nmetadata_db: sqlite://{tmp_path / 'meta.db'}\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(_wc, "_config_path", lambda: cfg)
+    monkeypatch.setattr(_ws, "_config_dir", lambda: tmp_path)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
