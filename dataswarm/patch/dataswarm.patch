+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Runner contract tests, including a real parent/child timeout on this host."""
+from __future__ import annotations
+
+import ctypes
+import importlib.util
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[2] / "acceptance" / "datasource" / "run_validation.py"
+spec = importlib.util.spec_from_file_location("acceptance_runner_cleanup", SCRIPT)
+runner = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(runner)
+
+
+def running(pid):
+    if os.name == "nt":
+        from ctypes import wintypes
+        kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+        kernel.OpenProcess.argtypes = (wintypes.DWORD, wintypes.BOOL, wintypes.DWORD)
+        kernel.OpenProcess.restype = wintypes.HANDLE
+        kernel.WaitForSingleObject.argtypes = (wintypes.HANDLE, wintypes.DWORD)
+        kernel.WaitForSingleObject.restype = wintypes.DWORD
+        kernel.CloseHandle.argtypes = (wintypes.HANDLE,)
+        handle = kernel.OpenProcess(0x00100000, False, pid)  # SYNCHRONIZE only
+        if not handle:
+            assert ctypes.get_last_error() == 87, "Could not inspect owned process"
+            return False
+        try:
+            return kernel.WaitForSingleObject(handle, 0) == 258  # WAIT_TIMEOUT
+        finally:
+            kernel.CloseHandle(handle)
+    result = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True, check=False)
+    state = result.stdout.strip()
+    return bool(state) and not state.startswith("Z")
+
+
+def test_real_timeout_stops_owned_parent_and_child_but_not_unrelated_process(tmp_path):
+    helper = tmp_path / "sleep_tree.py"
+    pids = tmp_path / "owned-pids.json"
+    log = tmp_path / "tree.log"
+    helper.write_text(
+        "import json, os, pathlib, subprocess, sys, time\n"
+        "child = subprocess.Popen([sys.executable, '-u', '-c', "
+        "\"import time; print('child-started', flush=True); time.sleep(60)\"])\n"
+        "pathlib.Path(sys.argv[1]).write_text(json.dumps([os.getpid(), child.pid]))\n"
+        "print('parent-started', flush=True)\n"
+        "time.sleep(60)\n", encoding="utf-8")
+    launch = {"creationflags": subprocess.CREATE_NO_WINDOW} if os.name == "nt" else {"start_new_session": True}
+    unrelated = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"], **launch)
+    owned = []
+    try:
+        record = runner.run_process([sys.executable, "-u", str(helper), str(pids)], log, dict(os.environ), timeout=2)
+        assert pids.is_file(), "Parent helper did not start before timeout"
+        owned = json.loads(pids.read_text())
+        deadline = time.monotonic() + 3
+        while any(running(pid) for pid in owned) and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert all(not running(pid) for pid in owned), "An owned sleep process survived timeout cleanup"
+        assert unrelated.poll() is None, "Runner touched an unrelated process"
+        assert "Timed out" in record["execution_error"]
+        # Windows venv python.exe may be a launcher above the Python parent.
+        target_pid = record["timeout_cleanup"]["target_pid"]
+        assert target_pid > 0 and not running(target_pid)
+        assert record["timeout_cleanup"]["status"] == "complete"
+        assert record["timeout_cleanup"]["parent_stopped"] is True
+        output = log.read_text(encoding="utf-8")
+        assert "parent-started" in output and "child-started" in output and "[RUNNER CLEANUP]" in output
+    finally:
+        # Test failures must not leave the two specifically owned helpers behind.
+        if not owned and pids.is_file():
+            owned = json.loads(pids.read_text())
+        for pid in owned:
+            if running(pid):
+                os.kill(pid, signal.SIGTERM)
+        unrelated.terminate()
+        unrelated.wait(timeout=5)
+
+
+def test_successful_process_keeps_exit_code_and_output(tmp_path):
+    log = tmp_path / "normal.log"
+    record = runner.run_process([sys.executable, "-c", "print('completed')"], log, dict(os.environ), timeout=3)
+    assert record["exit_code"] == 0 and record["execution_error"] is None
+    assert record["timeout_cleanup"] is None and "completed" in log.read_text()
+
+
+def test_machine_totals_preserve_blocked_and_boundaries_over_legacy_summary():
+    output = ('GATE_TOTALS: {"passed": 0, "failed": 0, "blocked": 1, "boundaries": 2}\n'
+              'Passed 0; failed 0; boundaries 2\n')
+    assert runner.parse_counts(output) == {"passed": 0, "failed": 0, "blocked": 1, "boundaries": 2}
+
+
+@pytest.mark.parametrize("payload", ["bad-json", "[]", '{"passed":true,"failed":0,"blocked":0,"boundaries":0}',
+                                     '{"passed":1,"failed":0,"blocked":-1,"boundaries":0}'])
+def test_invalid_machine_summary_does_not_fall_back_to_stale_passing_text(payload):
+    assert runner.parse_counts("Passed 5; failed 0; boundaries 2\nGATE_TOTALS: " + payload) is None
+
+
+def test_legacy_count_formats_remain_supported():
+    assert runner.parse_counts("Passed 5; failed 0; boundaries 2") == {
+        "passed": 5, "failed": 0, "blocked": 0, "boundaries": 2
+    }
+    assert runner.parse_counts("通过 5 项，失败 0 项，阻断 1 项") == {"passed": 5, "failed": 0, "blocked": 1, "boundaries": 0}
