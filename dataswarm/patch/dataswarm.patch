+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useSyncExternalStore } from 'react';
+
+export type DevelopmentPage = 'workflow-mgmt' | 'workflow-runs' | 'task-mgmt' | 'task-runs';
+export type WorkflowTab = 'editor' | 'runs';
+const pages: DevelopmentPage[] = ['workflow-mgmt', 'workflow-runs', 'task-mgmt', 'task-runs'];
+const prefix = '/dataagent/development/';
+export function parseDevelopmentRoute(path: string) {
+  const [pathname, query] = path.split('?');
+  if (!pathname.startsWith(prefix)) return null;
+  const candidate = pathname.slice(prefix.length) as DevelopmentPage;
+  if (!pages.includes(candidate)) return null;
+  const params = new URLSearchParams(query);
+  return {
+    page: candidate,
+    workflowId: params.get('workflow') ?? (candidate === 'workflow-runs' ? params.get('ref') : null),
+    taskId: params.get('task'),
+    refId: params.get('ref'),
+    tab: (params.get('tab') === 'runs' || candidate === 'workflow-runs' ? 'runs' : 'editor') as WorkflowTab,
+    instanceId: params.get('instance'),
+  };
+}
+
+/** Detail navigation retains the homepage query independently of Tab/run history. */
+export function navigateWorkflow(workflow: string, tab: WorkflowTab = 'editor', instance?: string, replace = false) {
+  const current = window.location.pathname + window.location.search;
+  const route = parseDevelopmentRoute(current);
+  const home =
+    route?.page === 'workflow-mgmt' && !route.workflowId
+      ? current
+      : (window.history.state?.developmentHome ?? `${prefix}workflow-mgmt`);
+  const params = new URLSearchParams({ workflow, tab });
+  if (instance) params.set('instance', instance);
+  window.history[replace ? 'replaceState' : 'pushState'](
+    { ...window.history.state, developmentHome: home },
+    '',
+    `${prefix}workflow-mgmt?${params}`,
+  );
+  window.dispatchEvent(new Event('jiuwen:routechange'));
+}
+
+export function backToWorkflowHome() {
+  const home = window.history.state?.developmentHome;
+  const route = typeof home === 'string' ? parseDevelopmentRoute(home) : null;
+  window.history.pushState(
+    {},
+    '',
+    route?.page === 'workflow-mgmt' && !route.workflowId ? home : `${prefix}workflow-mgmt`,
+  );
+  window.dispatchEvent(new Event('jiuwen:routechange'));
+}
+export function navigateDevelopment(
+  page: DevelopmentPage,
+  detail: { workflow?: string; task?: string; ref?: string } = {},
+) {
+  const params = new URLSearchParams(detail);
+  window.history.pushState(
+    { developmentReturn: window.location.pathname + window.location.search },
+    '',
+    `${prefix}${page}${params.toString() ? `?${params}` : ''}`,
+  );
+  window.dispatchEvent(new Event('jiuwen:routechange'));
+}
+export function backToDevelopment(page: DevelopmentPage) {
+  const previous = window.history.state?.developmentReturn;
+  if (typeof previous === 'string' && parseDevelopmentRoute(previous)) window.history.back();
+  else navigateDevelopment(page);
+}
+
+/** Change an instance definition filter while retaining the other list controls. */
+export function setDevelopmentRefFilter(refId: string | null) {
+  const params = new URLSearchParams(window.location.search);
+  if (refId) params.set('ref', refId);
+  else params.delete('ref');
+  params.set('page', '1');
+  window.history.pushState(window.history.state, '', `${window.location.pathname}?${params}`);
+  window.dispatchEvent(new Event('jiuwen:routechange'));
+}
+const subscribe = (listener: () => void) => {
+  window.addEventListener('popstate', listener);
+  window.addEventListener('jiuwen:routechange', listener);
+  return () => {
+    window.removeEventListener('popstate', listener);
+    window.removeEventListener('jiuwen:routechange', listener);
+  };
+};
+export function useDevelopmentRoute() {
+  const path = useSyncExternalStore(subscribe, () => window.location.pathname + window.location.search);
+  return (
+    parseDevelopmentRoute(path) ?? {
+      page: 'workflow-mgmt' as const,
+      workflowId: null,
+      taskId: null,
+      refId: null,
+      tab: 'editor' as const,
+      instanceId: null,
+    }
+  );
+}
