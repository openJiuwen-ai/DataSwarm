@@ -0,0 +1,204 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Business-data browsing through the registered datasource codec contracts.
+
+Metadata browsing never counts business rows or submits an analytical query.
+Previews use a bounded prefix so engines without OFFSET support share the same
+contract. An unknown total stays unknown, including after a short sampled result.
+"""
+from __future__ import annotations
+
+from jiuwenswarm.common import db_connector as dbc
+from jiuwenswarm.common.dialect_registry import profile_for, quote_ident
+from jiuwenswarm.common.dw_layer import infer_layer
+from jiuwenswarm.common.ref_codec import codec_for, quoted_table_identifier, table_identifier_parts
+from jiuwenswarm.common.workspace_context import business_database_name
+
+from ..datasource.registry import get_source_type
+from .base import BusinessDataDao, register
+
+
+MAX_PREVIEW_WINDOW = 10_000
+MAX_PAGE_SIZE = 1_000
+
+
+@register
+class CodecBusinessDao(BusinessDataDao):
+    dao_type = "codec"
+
+    def __init__(self, db_ref: str | None = None):
+        if not db_ref:
+            raise ValueError("codec business data requires an explicit db_ref")
+        self.db_ref = db_ref
+        self._spec = dbc.parse_db_ref(db_ref)
+        self._codec = codec_for(self._spec["type"])
+        self._source_type = self._spec.get("source_type") or self._spec["type"]
+        self._adapter = get_source_type(self._source_type)
+
+    def _table_names(self) -> list[str]:
+        return list(dbc.tables(self.db_ref).get("tables", []))
+
+    def _checked_table(self, table_name: str) -> str:
+        """校验并返回目录中的规范表名。
+
+        带 schema 的目录（DuckDB 原生库 / SQL Server）暴露的是全限定名，而
+        调用方常只知裸表名（任务描述、人工输入）。裸名只按目录条目解析（单段
+        匹配末段，两段匹配全限定），不拼 SQL——未注册的名字仍然拒绝。
+        """
+        names = self._table_names()
+        if table_name in names:
+            return table_name
+        if self._qualified_catalog():
+            matches = self._catalog_matches(names, table_name)
+            if len(matches) > 1:
+                # 默认 schema 优先（DuckDB 的 main）：与裸名 SQL 的解析结果一致。
+                preferred = self._default_schema_matches(matches)
+                if len(preferred) == 1:
+                    return preferred[0]
+                candidates = ", ".join(sorted(matches))
+                raise LookupError(
+                    f"table {table_name!r} is ambiguous across schemas; "
+                    f"use a qualified name: {candidates}"
+                )
+            if matches:
+                return matches[0]
+        raise LookupError(f"table {table_name!r} not found in this datasource")
+
+    def _catalog_matches(self, names: list[str], table_name: str) -> list[str]:
+        """按目录条目匹配请求的标识符：单段比末段，两段比全限定。"""
+        try:
+            wanted = table_identifier_parts(table_name, self._codec.dialect)
+        except ValueError:
+            return []
+        matches = []
+        for name in names:
+            try:
+                parts = table_identifier_parts(name, self._codec.dialect)
+            except ValueError:
+                continue
+            if len(wanted) == 2:
+                matched = parts == wanted
+            else:
+                matched = parts[-1:] == wanted
+            if matched:
+                matches.append(name)
+        return matches
+
+    def _default_schema_matches(self, matches: list[str]) -> list[str]:
+        """挑出落在 codec 默认 schema 的条目（无该概念时返回空）。"""
+        default = self._codec.default_schema
+        if not default:
+            return []
+        preferred = []
+        for name in matches:
+            try:
+                parts = table_identifier_parts(name, self._codec.dialect)
+            except ValueError:
+                continue
+            if len(parts) == 2 and parts[0] == default:
+                preferred.append(name)
+        return preferred
+
+    def _quoted_table(self, table_name: str) -> str:
+        # These codecs return explicitly delimited schema/table identifiers.
+        # Other catalogs return raw names; a dot may be part of a collection or
+        # table name and must not silently become a namespace separator.
+        if self._qualified_catalog():
+            return quoted_table_identifier(table_name, self._codec.dialect)
+        return quote_ident(self._codec.dialect, table_name)
+
+    def _qualified_catalog(self) -> bool:
+        return self._spec["type"] == "sqlserver" or (
+            self._spec["type"] == "duckdb" and self._source_type == "duckdb"
+        )
+
+    def _layer(self, table_name: str) -> str:
+        if self._qualified_catalog():
+            table_name = table_identifier_parts(table_name, self._codec.dialect)[-1]
+        return infer_layer(table_name)
+
+    def _preview_supported(self) -> bool:
+        return {"preview", "sql_query"}.issubset(self._adapter.capabilities)
+
+    def list_databases(self) -> list[dict]:
+        # The ref identifies one bound source, not permission to enumerate or
+        # switch databases on the server.
+        name = business_database_name(self.db_ref)
+        return [{"name": name, "path": "", "type": self._source_type,
+                 "size_bytes": None, "table_count": len(self._table_names())}]
+
+    def list_tables(self, db_name: str) -> list[dict]:
+        rows = []
+        for name in self._table_names():
+            metadata = dbc.schema(self.db_ref, name)
+            rows.append({"name": name, "row_count": None,
+                         "column_count": len(metadata.get("columns", [])),
+                         "layer": self._layer(name), "last_modified": "",
+                         "comment": metadata.get("comment") or ""})
+        return rows
+
+    def get_table_detail(self, db_name: str, table_name: str) -> dict:
+        table_name = self._checked_table(table_name)
+        metadata = dbc.schema(self.db_ref, table_name)
+        columns = [
+            {**column,
+             "nullable": column.get("nullable", column.get("null", True)),
+             "primary_key": bool(column.get("primary_key", column.get("pk", False))),
+             "default_value": column.get("default_value", column.get("default")),
+             "comment": column.get("comment") or ""}
+            for column in metadata.get("columns", [])
+        ]
+        indexes_supported = metadata.get("indexes") is not None
+        foreign_keys_supported = metadata.get("foreign_keys") is not None
+        ddl = metadata.get("ddl", metadata.get("create_sql"))
+        return {
+            "name": table_name, "columns": columns, "row_count": None,
+            "comment": metadata.get("comment") or "",
+            "ddl": ddl or "", "ddl_supported": ddl is not None,
+            "indexes": metadata.get("indexes") or [], "indexes_supported": indexes_supported,
+            "foreign_keys": metadata.get("foreign_keys") or [],
+            "foreign_keys_supported": foreign_keys_supported,
+            "preview_supported": self._preview_supported(),
+        }
+
+    @staticmethod
+    def _page_bounds(limit: int, offset: int) -> tuple[int, int]:
+        values = []
+        for name, value in (("limit", limit), ("offset", offset)):
+            if isinstance(value, bool) or not str(value).strip().isdigit():
+                raise ValueError(f"preview {name} must be a non-negative integer")
+            values.append(int(value))
+        limit, offset = values
+        if not 1 <= limit <= MAX_PAGE_SIZE:
+            raise ValueError(f"preview limit must be between 1 and {MAX_PAGE_SIZE}")
+        if offset + limit > MAX_PREVIEW_WINDOW:
+            raise ValueError(f"preview offset + limit must not exceed {MAX_PREVIEW_WINDOW}")
+        return limit, offset
+
+    def preview_table(self, db_name: str, table_name: str,
+                      limit: int = 10, offset: int = 0) -> dict:
+        limit, offset = self._page_bounds(limit, offset)
+        if not self._preview_supported():
+            raise ValueError(f"{self._source_type} source is metadata-only; preview is unsupported")
+        name = self._quoted_table(self._checked_table(table_name))
+        # One extra row distinguishes a full page from a known end. At the
+        # window boundary completeness remains unknown; do not report total=0.
+        window_end = offset + limit
+        fetch_limit = min(window_end + 1, MAX_PREVIEW_WINDOW)
+        syntax = profile_for(self._codec.dialect).limit_syntax
+        if syntax == "offset_fetch":
+            sql = f"SELECT TOP ({fetch_limit}) * FROM {name}"
+        elif syntax == "limit":
+            sql = f"SELECT * FROM {name} LIMIT {fetch_limit}"
+        else:
+            raise ValueError("datasource dialect does not support bounded previews")
+        # Pagination literals are validated above. Do not run COUNT or a second query.
+        result = dbc.query(self.db_ref, sql, limit=fetch_limit)
+        source_rows = result["rows"]
+        has_more_rows = len(source_rows) > window_end or bool(result.get("truncated"))
+        window_truncated = window_end == MAX_PREVIEW_WINDOW and (
+            len(source_rows) >= MAX_PREVIEW_WINDOW or bool(result.get("truncated")))
+        rows = source_rows[offset:window_end]
+        return {**result, "rows": rows, "row_count": len(rows), "total": None,
+                "truncated": bool(result.get("truncated")) or has_more_rows or window_truncated,
+                "has_more": window_end < MAX_PREVIEW_WINDOW and has_more_rows,
+                "window_truncated": window_truncated, "limit": limit, "offset": offset}
