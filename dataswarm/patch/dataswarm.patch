@@ -0,0 +1,43 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Fail-closed checks for SQL rejection; never submit a negative test statement."""
+from contextlib import ExitStack
+from unittest.mock import patch
+
+from jiuwenswarm.channels.web.dataagent.connectors.duckdb_connector import DuckDBConnector
+from jiuwenswarm.channels.web.dataagent.connectors.errors import QueryValidationError
+from jiuwenswarm.channels.web.dataagent.connectors.sqlalchemy_connector import SQLAlchemyConnector
+from jiuwenswarm.common import db_connector as dbc
+
+
+def expect_query_rejected(connector, sql: str, label: str) -> None:
+    """Accept only a validation rejection that occurs before any connection path.
+
+    Patch the shared classes as well as governance entry points so cached engines,
+    file warehouses, and a query routed through db_connector are all fenced off.
+    Context-local patches are restored before independent real-service checks.
+    """
+    attempted_io = False
+
+    def refuse_io(*args, **kwargs):
+        nonlocal attempted_io
+        attempted_io = True
+        raise AssertionError("Negative SQL reached an I/O boundary; no statement was sent")
+
+    boundaries = (
+        (SQLAlchemyConnector, "_engine"),
+        (DuckDBConnector, "_connection"),
+        (DuckDBConnector, "_warehouse"),
+        (dbc, "_acquire"),
+        (dbc, "_engine_for"),
+        (dbc, "connect"),
+    )
+    with ExitStack() as stack:
+        for target, attribute in boundaries:
+            stack.enter_context(patch.object(target, attribute, refuse_io))
+        try:
+            connector.query(sql)
+        except QueryValidationError as exc:
+            if attempted_io:
+                raise AssertionError("SQL rejection occurred after an I/O attempt") from exc
+        else:
+            raise AssertionError(f"{label} 应当在连接前被拒绝，但通过了")
