+def create_instance(ref_type: str, ref_id: str, trigger_type: str, status: str = "queued") -> dict:
+    instance_id = new_instance_id()
+    now = _now()
+    artifact_dir = ARTIFACT_ROOT / "runs" / instance_id
+    with _write_lock:
+        conn = _connect()
+        try:
+            _exec(conn, """INSERT INTO dw_task_instances
+                   (instance_id,ref_type,ref_id,trigger_type,status,started_at,
+                    finished_at,artifact_dir,error_message,created_at)
+                   VALUES (?,?,?,?,?,?,?,?,?,?)""",
+                (instance_id, ref_type, ref_id, trigger_type, status, None, None, str(artifact_dir), None, now),
+            )
+            conn.commit()
