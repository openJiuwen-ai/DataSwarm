+def test_uncovered_passthrough():
+    parsed, _ = plan_module.parse_and_validate(
+        _plan([_component()], uncovered=["新客户占比无指标覆盖"]),
+        _CANDIDATES, _SCOPE)
+    assert parsed.uncovered == ("新客户占比无指标覆盖",)
+
+
+def test_derived_metrics_slot():
+    """derived_metrics（报告层派生）独立槽位：候选内合法、候选外拒绝。"""
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(derived_metrics=["commerce.aov"])]),
+        _CANDIDATES, _SCOPE)
+    assert parsed is not None and errors == []
+    assert parsed.components[0].derived_metrics == ("commerce.aov",)
+    assert parsed.components[0].selected_metrics == ("commerce.gmv",)
+
+    parsed, errors = plan_module.parse_and_validate(
+        _plan([_component(derived_metrics=["ghost.metric"])]),
+        _CANDIDATES, _SCOPE)
+    assert any("派生指标" in e["message"] for e in errors)
