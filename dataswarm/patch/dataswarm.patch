@@ -0,0 +1,27 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { EChart } from '../../../features/governance/components/shared/EChart';
+
+/**
+ * chat 正文内联 ECharts 图（```echarts 代码块，内容为 ECharts option JSON）。
+ *
+ * 数据流：分析答复需要内联关键图时，模型把 dw-report data.json 里的
+ * option 原样贴进 ```echarts 块——与报告图表同源同口径，不二次加工。
+ * 解析失败降级为普通代码块显示（JSON 病变不吞内容）。
+ */
+export function EchartsDiagram({ code }: { code: string }): React.JSX.Element {
+  let parseable = false;
+  try {
+    const parsed: unknown = JSON.parse(code);
+    parseable = Boolean(parsed) && typeof parsed === 'object' && !Array.isArray(parsed);
+  } catch {
+    parseable = false;
+  }
+  if (!parseable) {
+    return (
+      <pre className="m-0 overflow-auto rounded-md bg-black/5 p-3 text-xs text-text" data-testid="markdown-echarts-fallback">
+        {code}
+      </pre>
+    );
+  }
+  return <EChart option={code} ariaLabel="chart" height={320} />;
+}
