+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { create } from 'zustand';
+import i18n from '../../../i18n';
+import { metadataApi } from '../api/metadataApi';
+import type { Database, LineageArtifact, PreviewResult, TableDetail, TableInfo } from '../types/metadata';
+
+let detailRequestId = 0;
+let lineageRequestId = 0;
+let previewRequestId = 0;
+
+export type DetailTab = 'overview' | 'columns' | 'ddl' | 'lineage';
+
+interface DataManagementState {
+  databases: Database[];
+  selectedDb: string;
+  tables: TableInfo[];
+  selectedTable: string;
+  /** 当前详情 tab：提升到 store 以便 .dm-main 按 tab 切换布局（不依赖 CSS :has） */
+  detailTab: DetailTab;
+  setDetailTab: (tab: DetailTab) => void;
+  tableDetail: TableDetail | null;
+  preview: PreviewResult | null;
+  previewError: string | null;
+  /** 当前预览页的起始行（offset），与 preview 同步更新，作为分页唯一真源 */
+  previewOffset: number;
+  /** 每页数量，切换时重新拉取第 1 页 */
+  previewLimit: number;
+  lineage: LineageArtifact | null;
+  loading: boolean;
+  detailLoading: boolean;
+  error: string | null;
+  loadDatabases: () => Promise<void>;
+  selectDb: (db: string) => Promise<void>;
+  loadTables: () => Promise<void>;
+  selectTable: (table: string) => Promise<void>;
+  loadDetail: () => Promise<void>;
+  loadPreview: (offset?: number, limit?: number) => Promise<boolean>;
+  setPreviewLimit: (limit: number) => Promise<void>;
+  loadLineage: () => Promise<void>;
+  /** 换绑数据源后清残留选中态（store 是模块级单例，重挂载不重置） */
+  reset: () => void;
+  clearError: () => void;
+}
+
+const message = (error: unknown) => (error instanceof Error ? error.message : i18n.t('dataManagement.unknownError'));
+
+export const useDataManagementStore = create<DataManagementState>((set, get) => ({
+  databases: [],
+  selectedDb: '',
+  tables: [],
+  selectedTable: '',
+  detailTab: 'overview',
+  setDetailTab: (tab) => set({ detailTab: tab }),
+  tableDetail: null,
+  preview: null,
+  previewError: null,
+  previewOffset: 0,
+  previewLimit: 20,
+  lineage: null,
+  loading: false,
+  detailLoading: false,
+  error: null,
+  clearError: () => set({ error: null }),
+  reset: () => {
+    ++detailRequestId;
+    ++lineageRequestId;
+    ++previewRequestId;
+    set({
+      databases: [],
+      selectedDb: '',
+      tables: [],
+      selectedTable: '',
+      tableDetail: null,
+      preview: null,
+      previewError: null,
+      previewOffset: 0,
+      lineage: null,
+      error: null,
+      detailLoading: false,
+    });
+  },
+  loadDatabases: async () => {
+    set({ loading: true, error: null });
+    try {
+      const { databases } = await metadataApi.listDatabases();
+      // 工作空间切换残留：store 是模块级单例，DataManagementApp 重挂载（key 换空间）
+      // 后旧空间的 selectedDb/表状态仍在。旧选中库不在新空间库清单里 → 整体清空，
+      // 交给路由同步 effect 重选；否则点旧表会带新 workspace_id 请求 → 服务端 400。
+      if (get().selectedDb && !databases.some((d) => d.name === get().selectedDb)) {
+        set({
+          databases,
+          loading: false,
+          selectedDb: '',
+          tables: [],
+          selectedTable: '',
+          detailLoading: false,
+          tableDetail: null,
+          preview: null,
+          previewError: null,
+          lineage: null,
+        });
+        return;
+      }
+      // Don't auto-select — the route sync effect in DataManagementApp
+      // will call selectDb() with the correct db from the URL.
+      // Only load tables if a db is already selected (e.g. from a prior session).
+      if (get().selectedDb && databases.some((d) => d.name === get().selectedDb)) {
+        await get().loadTables();
+      }
+      set({ databases, loading: false });
+    } catch (error) {
+      set({ loading: false, error: message(error) });
+    }
+  },
+  selectDb: async (db) => {
+    ++previewRequestId;
+    set({
+      selectedDb: db,
+      tables: [],
+      selectedTable: '',
+      detailLoading: false,
+      tableDetail: null,
+      preview: null,
+      previewError: null,
+      previewOffset: 0,
+      lineage: null,
+    });
+    await get().loadTables();
+    await get().loadLineage();
+  },
+  loadTables: async () => {
+    const db = get().selectedDb;
+    if (!db) return;
+    set({ loading: true, error: null });
+    try {
+      const { tables } = await metadataApi.listTables(db);
+      set({ tables, loading: false });
+    } catch (error) {
+      set({ loading: false, error: message(error) });
+    }
+  },
+  selectTable: async (table) => {
+    // 同一表也可能被重复选择；请求序号防止较早的详情响应重新加载预览首页。
+    const selectionId = ++previewRequestId;
+    const db = get().selectedDb;
+    set({ selectedTable: table, error: null, tableDetail: null, preview: null, previewError: null, previewOffset: 0 });
+    await get().loadDetail();
+    if (selectionId !== previewRequestId || get().selectedDb !== db || get().selectedTable !== table) return;
+    const detail = get().tableDetail;
+    // 先读取能力声明，避免为仅提供结构的 DDL 源提交数据预览。
+    if (detail && detail.preview_supported !== false) {
+      await get().loadPreview();
+    }
+  },
+  loadDetail: async () => {
+    const { selectedDb, selectedTable } = get();
+    if (!selectedDb || !selectedTable) return;
+    const requestId = ++detailRequestId;
+    set({ detailLoading: true });
+    try {
+      const detail = await metadataApi.getTable(selectedDb, selectedTable);
+      if (requestId !== detailRequestId || get().selectedDb !== selectedDb || get().selectedTable !== selectedTable)
+        return;
+      set({ tableDetail: detail, detailLoading: false });
+    } catch (error) {
+      if (requestId !== detailRequestId || get().selectedDb !== selectedDb || get().selectedTable !== selectedTable)
+        return;
+      set({ error: message(error), detailLoading: false });
+    }
+  },
+  setPreviewLimit: async (limit) => {
+    await get().loadPreview(0, limit);
+  },
+  loadPreview: async (offset = 0, limit = get().previewLimit) => {
+    const { selectedDb, selectedTable, tableDetail } = get();
+    if (!selectedDb || !selectedTable || !tableDetail || tableDetail.preview_supported === false) return false;
+    const requestId = ++previewRequestId;
+    set({ previewError: null });
+    try {
+      const preview = await metadataApi.getPreview(selectedDb, selectedTable, offset, limit);
+      if (requestId !== previewRequestId || get().selectedDb !== selectedDb || get().selectedTable !== selectedTable)
+        return false;
+      set({ preview, previewOffset: offset, previewLimit: limit });
+      return true;
+    } catch (error) {
+      if (requestId !== previewRequestId || get().selectedDb !== selectedDb || get().selectedTable !== selectedTable)
+        return false;
+      set({ previewError: message(error) });
+      return false;
+    }
+  },
+  loadLineage: async () => {
+    const db = get().selectedDb;
+    if (!db) return;
+    const requestId = ++lineageRequestId;
+    try {
+      const lineage = await metadataApi.getLineage(db);
+      if (requestId !== lineageRequestId || get().selectedDb !== db) return;
+      set({ lineage });
+    } catch (error) {
+      if (requestId !== lineageRequestId || get().selectedDb !== db) return;
+      set({ error: message(error) });
+    }
+  },
+}));
