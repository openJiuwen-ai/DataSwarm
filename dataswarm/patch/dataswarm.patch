+                    className="chat-suggestion-refresh"
+                    data-testid="chat-panel-welcome-suggestions-refresh"
+                    onClick={() => { setHoveredPrompt(null); setPickedSuggestions(pickPromptSuggestions(suggestionCategory)); }}
+                  >
+                    <RefreshCw size={12} />
+                    {t('chat.promptSuggestions.refresh')}
+                  </button>
