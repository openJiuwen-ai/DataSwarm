index 000000000..725c235cb
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/dataAsset/components/NodeEditDrawer.tsx
@@ -0,0 +1,281 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// 节点编辑抽屉（右侧滑出）：新建/编辑工作流节点。
+// 必填：任务（下拉选）；选填：节点名/组名/前驱（checkbox 列表 + 搜索过滤）/等待审核。
+// 编辑已有节点时提供「删除节点」「创建副本」（confirm 由本抽屉负责，落库由宿主即时保存）。
+
+import { useEffect, useMemo, useState } from 'react';
+import { MoreHorizontal, X } from 'lucide-react';
+import SqlIcon from '../../../assets/data-development/sql.svg?react';
+import PythonIcon from '../../../assets/data-development/python.svg?react';
+import { RowMenu } from './shared/RowMenu';
+import { useTranslation } from 'react-i18next';
+import type { NodeInput, TaskDefinition } from '../types/orchestration';
+import { bfs, buildAdj } from './shared/dagLayout';
+import { Button, confirmDialog, Field, inputClass } from './shared/Ui';
+
+interface Props {
+  open: boolean;
+  /** 编辑时传入已有节点；新建时为 null */
+  node: NodeInput | null;
+  /** 当前工作流全部节点：用于前驱选择的候选列表 */
+  allNodes: NodeInput[];
+  tasks: TaskDefinition[];
+  /** 当前编辑节点的 node_id（编辑模式用于从前驱候选中排除自己） */
+  selfNodeId?: string;
+  onClose: () => void;
+  onSubmit: (node: NodeInput) => void;
+  /** 仅编辑已有节点时展示：删除该节点（confirm 在抽屉内完成） */
+  onDelete?: () => void;
+  /** 仅编辑已有节点时展示：创建该节点的副本（同任务/同前驱，名称加后缀） */
+  onDuplicate?: () => void;
+}
+
+export function NodeEditDrawer({
+  open,
+  node,
+  allNodes,
+  tasks,
+  selfNodeId,
+  onClose,
+  onSubmit,
+  onDelete,
+  onDuplicate,
+}: Props) {
+  const { t } = useTranslation();
+  const [taskId, setTaskId] = useState('');
+  const [nodeName, setNodeName] = useState('');
+  const [groupName, setGroupName] = useState('');
+  const [upstreamIds, setUpstreamIds] = useState<string[]>([]);
+  const [upstreamSearch, setUpstreamSearch] = useState('');
+  const [waitReview, setWaitReview] = useState(false);
+  const [touched, setTouched] = useState(false);
+
+  const taskName = (tid: string) => tasks.find((t) => t.task_id === tid)?.name ?? tid;
+  const nodeLabel = (n: NodeInput) => n.node_name || taskName(n.task_id);
+
+  useEffect(() => {
+    if (!open) return;
+    setTaskId(node?.task_id ?? tasks[0]?.task_id ?? '');
+    setNodeName(node?.node_name ?? '');
+    setGroupName(node?.group_name ?? '');
+    setUpstreamIds(
+      (node?.upstream_nodes ?? '')
+        .split(',')
+        .map((s) => s.trim())
+        .filter(Boolean),
+    );
+    setUpstreamSearch('');
+    setWaitReview(!!node?.wait_review);
+    setTouched(false);
+  }, [open, node, tasks, t]);
+
+  // 前驱候选：排除自己（避免自环）
+  const upstreamOptions = useMemo(() => {
+    const descendants = selfNodeId ? bfs(selfNodeId, buildAdj(allNodes).downstream) : new Set<string>();
+    return allNodes.filter((n) => n.node_id && !descendants.has(n.node_id));
+  }, [allNodes, selfNodeId]);
+  // 搜索过滤：不区分大小写匹配节点名/任务名/组名
+  const filteredUpstreams = useMemo(() => {
+    const kw = upstreamSearch.trim().toLowerCase();
+    if (!kw) return upstreamOptions;
+    return upstreamOptions.filter(
+      (n) => nodeLabel(n).toLowerCase().includes(kw) || (n.group_name ?? '').toLowerCase().includes(kw),
+    );
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- nodeLabel 依赖 tasks，搜索本身不改变候选
+  }, [upstreamOptions, upstreamSearch, tasks]);
+
+  if (!open) return null;
+
+  const taskIdMissing = !taskId;
+  const showErr = touched && taskIdMissing;
+  const executor = tasks.find((task) => task.task_id === taskId)?.executor_type;
+  const NodeIcon = executor === 'sql' ? SqlIcon : executor === 'python' ? PythonIcon : null;
+  const heading = node ? nodeLabel(node) : t('dataAsset.nodeForm.addTitle');
+
+  const toggleUpstream = (id: string) => {
+    setUpstreamIds((cur) => (cur.includes(id) ? cur.filter((x) => x !== id) : [...cur, id]));
+  };
+
+  const submit = () => {
+    setTouched(true);
+    if (taskIdMissing) return;
+    onSubmit({
+      node_id: node?.node_id,
+      task_id: taskId,
+      node_name: nodeName.trim(),
+      group_name: groupName.trim(),
+      upstream_nodes: upstreamIds.join(','),
+      wait_review: waitReview,
+      // order_index 由父组件在新建时补
+    });
+  };
+
+  const confirmDelete = () => {
+    const label = node?.node_name || (node ? taskName(node.task_id) : '');
+    void confirmDialog({
+      title: t('dataAsset.nodeForm.deleteTitle', { name: label }),
+      message: t('dataAsset.nodeForm.deleteMessage'),
+      confirmText: t('common.delete'),
+      danger: true,
+    }).then((ok) => {
+      if (ok) {
+        onDelete?.();
+        onClose();
+      }
+    });
+  };
+
+  return (
+    <div
+      className="dd-side-panel dd-node-editor"
+      role="region"
+      aria-label={t(node ? 'dataAsset.nodeForm.editTitle' : 'dataAsset.nodeForm.addTitle')}
+      onKeyDown={(event) => {
+        if (event.key === 'Escape') {
+          event.stopPropagation();
+          onClose();
+        }
+      }}
+    >
+      <div className="dd-node-editor-inner">
+        <div className="flex items-center justify-between border-b border-border px-4 py-3">
+          <h3 className="dd-node-heading text-text-strong">
+            {NodeIcon && <NodeIcon width={24} height={24} aria-hidden="true" />}
+            <span title={heading}>{heading}</span>
+          </h3>
+          <div className="dd-node-header-actions flex items-center gap-2">
+            {node && (
+              <RowMenu
+                text={t('dataAsset.editor.nodeActions', { name: node.node_name || taskName(node.task_id) })}
+                icon={<MoreHorizontal size={18} />}
+                items={[
+                  ...(onDuplicate ? [{ label: t('dataAsset.nodeForm.duplicate'), onClick: onDuplicate }] : []),
+                  ...(onDelete
+                    ? [{ label: t('dataAsset.nodeForm.deleteNode'), onClick: confirmDelete, danger: true }]
+                    : []),
+                ]}
+              />
+            )}
+            <button
+              className="rounded p-1 text-text-muted hover:bg-secondary hover:text-text"
+              onClick={onClose}
+              aria-label={t('common.close')}
+            >
+              <X size={20} />
+            </button>
+          </div>
+        </div>
+
+        <div className="dd-node-form-body flex-1 space-y-4 overflow-y-auto p-4">
+          <Field label={t('dataAsset.nodeForm.task')} hint={showErr ? t('dataAsset.nodeForm.taskRequired') : undefined}>
+            <select
+              className={`${inputClass} ${showErr ? 'border-danger' : ''}`}
+              value={taskId}
+              onChange={(e) => {
+                setTaskId(e.target.value);
+                setTouched(true);
+              }}
+            >
+              {tasks.length === 0 && <option value="">{t('dataAsset.nodeForm.noTasks')}</option>}
+              {tasks.map((t) => (
+                <option key={t.task_id} value={t.task_id}>
+                  {t.name}
+                </option>
+              ))}
+            </select>
+          </Field>
+
+          <Field label={t('dataAsset.nodeForm.nodeName')} hint={t('dataAsset.nodeForm.nodeNameHint')}>
+            <input
+              className={inputClass}
+              value={nodeName}
+              onChange={(e) => setNodeName(e.target.value)}
+              placeholder={t('dataAsset.nodeForm.nodeNamePlaceholder')}
+            />
+          </Field>
+
+          <Field label={t('dataAsset.nodeForm.groupName')} hint={t('dataAsset.nodeForm.groupNameHint')}>
+            <input
+              className={inputClass}
+              value={groupName}
+              onChange={(e) => setGroupName(e.target.value)}
+              placeholder={t('dataAsset.nodeForm.groupNamePlaceholder')}
+            />
+          </Field>
+
+          <Field label={t('dataAsset.nodeForm.upstream')} hint={t('dataAsset.nodeForm.upstreamHint')}>
+            {upstreamOptions.length === 0 ? (
+              <div className="text-xs text-text-muted">{t('dataAsset.nodeForm.noUpstream')}</div>
+            ) : (
+              <div>
+                {upstreamIds.length > 0 && (
+                  <div className="dd-selected-upstreams">
+                    <span>{t('dataAsset.nodeForm.upstreamSelectedLabel')}</span>
+                    <ul aria-label={t('dataAsset.nodeForm.upstreamSelected', { count: upstreamIds.length })}>
+                      {upstreamOptions
+                        .filter((item) => item.node_id && upstreamIds.includes(item.node_id))
+                        .map((item) => (
+                          <li key={item.node_id} title={nodeLabel(item)}>
+                            {nodeLabel(item)}
+                          </li>
+                        ))}
+                    </ul>
+                  </div>
+                )}
+                <div className="rounded border border-border bg-card">
+                  <input
+                    className="w-full border-b border-border bg-bg px-2 py-1.5 text-xs text-text placeholder:text-text-placeholder focus:outline-none"
+                    placeholder={t('dataAsset.nodeForm.upstreamSearchPlaceholder')}
+                    value={upstreamSearch}
+                    onChange={(e) => setUpstreamSearch(e.target.value)}
+                    aria-label={t('dataAsset.nodeForm.upstreamSearchPlaceholder')}
+                  />
+                  <div className="max-h-44 overflow-y-auto p-1">
+                    {filteredUpstreams.length === 0 ? (
+                      <div className="px-2 py-1.5 text-xs text-text-muted">
+                        {t('dataAsset.nodeForm.upstreamNoMatch')}
+                      </div>
+                    ) : (
+                      filteredUpstreams.map((n) => {
+                        const id = n.node_id ?? '';
+                        const on = upstreamIds.includes(id);
+                        return (
+                          <label
+                            key={id}
+                            data-selected={on || undefined}
+                            className="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-xs hover:bg-secondary"
+                            title={nodeLabel(n)}
+                          >
+                            <input type="checkbox" checked={on} onChange={() => toggleUpstream(id)} />
+                            <span className="min-w-0 flex-1 truncate text-text">{nodeLabel(n)}</span>
+                            {n.group_name && (
+                              <span className="shrink-0 text-[11px] text-text-muted">{n.group_name}</span>
+                            )}
+                          </label>
+                        );
+                      })
+                    )}
+                  </div>
+                </div>
+              </div>
+            )}
+          </Field>
+
+          <label className="flex items-center gap-2 text-sm text-text">
+            <input type="checkbox" checked={waitReview} onChange={(e) => setWaitReview(e.target.checked)} />
+            <span>{t('dataAsset.nodeForm.waitReview')}</span>
+          </label>
+        </div>
+
+        <div className="dd-node-form-actions flex items-center gap-2 px-4 py-3">
+          <div className="ml-auto flex gap-2">
+            <Button onClick={onClose}>{t('common.cancel')}</Button>
+            <Button variant="primary" onClick={submit}>
+              {node ? t('common.save') : t('dataAsset.nodeForm.add')}
+            </Button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
