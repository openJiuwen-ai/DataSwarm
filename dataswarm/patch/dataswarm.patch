+/* 数仓模块统一外壳骨架（.dw-side-*）。
+   侧栏宽 296px，与 governance .gov-side / dataAsset .da-side / data-management .dm-side 一致；
+   品牌签名元素各模块自带，颜色一律走全局 token。 */
+
+.dw-side {
+  position: sticky;
+  top: 0;
+  display: flex;
+  height: 100vh;
+  width: 296px;
+  flex-shrink: 0;
+  flex-direction: column;
+  border-right: 1px solid var(--color-border-default);
+  background: var(--color-surface-panel);
+  padding: 20px 16px 16px;
+}
+
+.dw-side h1 {
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--color-text-strong);
+}
+
+.dw-nav {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 4px;
+  margin-top: 24px;
+  overflow-y: auto;
+}
+
+.dw-nav-item {
+  display: flex;
+  width: 100%;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 8px;
+  border-radius: 6px;
+  padding: 8px 12px;
+  text-align: left;
+  font-size: 14px;
+  color: var(--color-text-secondary);
+  transition: background-color 120ms ease, color 120ms ease;
+}
+
+.dw-nav-item:hover {
+  background: var(--color-surface-highlight);
+  color: var(--color-text-strong);
+}
+
+.dw-nav-item[aria-current='page'],
+.dw-nav-item[data-active='true'] {
+  background: var(--color-action-primary-subtle);
+  color: var(--color-text-link);
+  font-weight: 600;
+}
+
+.dw-nav-key {
+  font-family: var(--font-mono);
+  font-size: 11px;
+  color: var(--color-text-placeholder);
+  white-space: nowrap;
+}
+
+.dw-nav-item[aria-current='page'] .dw-nav-key,
+.dw-nav-item[data-active='true'] .dw-nav-key {
+  color: var(--color-text-link);
+  opacity: 0.75;
+}
+
+/* 主内容容器：大屏内容最大 1200 居中留白，小屏保留最小 24px 侧距，顶部间距 64（与治理 .gov-main-inner 同口径） */
+.dw-content {
+  width: min(1200px, calc(100% - 48px));
+  min-width: 0;
+  margin: 0 auto;
+  padding: 64px 0;
+}
+
+/* 模块页头（内容区顶部）：标题 + 副说明 */
+.dw-page-head h2 {
+  font-size: 20px;
+  font-weight: 600;
+  color: var(--color-text-strong);
+}
+
+/* 大号页头标题：与数据开发页 .dd-home-header h1（24px/36px/600）同口径 */
+h2.dw-page-title-xl {
+  font-size: 24px;
+  font-weight: 600;
+  line-height: 36px;
+  color: var(--color-text-strong);
+}
+
+.dw-page-head p {
+  margin-top: 4px;
+  font-size: 12px;
+  color: var(--color-text-muted, var(--color-text-secondary));
+}
