+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = readFileSync(
+  new URL('../src/features/datasource/components/DataSourceListPage.tsx', import.meta.url),
+  'utf8',
+);
+
+test('create keeps auto-bind and offers replace-or-keep-add on binding conflict', () => {
+  // 沿用创建即自动绑定：workspace_id 随 body 下发
+  assert.match(source, /store\.createSource\(\{ \.\.\.params, workspace_id: workspaceId \|\| undefined \}\)/);
+  // 已绑定其他源（WORKSPACE_ALREADY_BOUND）时弹「换绑 / 不换绑仅添加」：
+  // 换绑走 rebind 重试
+  assert.match(source, /error_code === 'WORKSPACE_ALREADY_BOUND'/);
+  assert.match(source, /rebind: true/);
+  // 不换绑仅添加：body 不带 workspace_id（不触发绑定语义），
+  // query 参数定位当前空间元库（api._with_workspace 的请求级上下文）
+  assert.match(source, /store\.createSource\(\{ \.\.\.params \}, workspaceId \|\| undefined\)/);
+  assert.match(source, /dataSource\.form\.replacePromptTitle/);
+  assert.match(source, /dataSource\.list\.keepAddAction/);
+});
+
+test('bind action is a visible row action (disabled when already bound) and shows a bound status column', () => {
+  assert.match(
+    source,
+    /\{managed && \(\s*<button\s+className="ds-action-link"\s+disabled=\{!!busy \|\| source\.bound\}\s+onClick=\{\(\) => void bind\(source\)\}\s*>/,
+  );
+  assert.match(
+    source,
+    /\{t\(source\.bound \? 'dataSource\.list\.boundBadge' : 'dataSource\.list\.unboundBadge'\)\}/,
+  );
+});
+
+test('workspace without business source shows an unbound notice banner', () => {
+  assert.match(source, /unboundWorkspace && \(/);
+  assert.match(source, /datasourceWorkspace\.unboundNotice/);
+});
+
+test('both replacement dialogs display bound source names instead of database names or descriptions', () => {
+  assert.match(source, /const boundSourceNames = store\.datasources\s*\.filter\(\(source\) => source\.bound\)\s*\.map\(\(source\) => source\.source_id\)\s*\.join\(', '\)/);
+  assert.equal((source.match(/current: boundSourceNames/g) || []).length, 2);
+  assert.doesNotMatch(source, /current:.*(?:database|current_ref|description)/);
+});
diff --git a/jiuwenswarm/channels/web/frontend/tests/dataSourceSemanticCollection.test.mjs b/jiuwenswarm/channels/web/frontend/tests/dataSourceSemanticCollection.test.mjs
