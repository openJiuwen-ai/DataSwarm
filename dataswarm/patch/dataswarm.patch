+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/versioning/ —— 修订与发布生命周期（导入 → 确认 → 发布 → 投影）。
+
+原 ``metrics/versioning.py`` 巨石（949 行）按用例拆为五子模块；本 ``__init__``
+re-export 全部公开符号（含 ``_target_revision`` / ``_carry_over_term_maps``：
+测试与包内其它模块在用的私有符号）。
+
+发布语义（深集成后）：
+
+- 候选映射 **confirm 之后**才进正式投影；发布时只取 ``status=confirmed``。
+- 绑定校验走语义层快照（``semantic_link.ensure_semantic_refs``，严格单一
+  通道）：源未采集/表列漂移 → 绑定回写 failed + manifest warning，**发布不
+  阻断**。
+- Neo4j 投影（``graph_projection.publish_metric_graph``）失败 → release 照常
+  ``published``，``projection_status=failed`` 可 reproject 重试——元数据库是
+  真相源，投影是可重建的衍生品（对齐 glossary「投影失败不回滚表写」）。
+- 发布成功 → 修订标 ``published``，其余 published release 标 ``revoked``。
+
+依赖 :mod:`.ossie` 做导入、:mod:`.semantic_link` 做绑定校验、
+:mod:`.graph_projection` 做 Neo4j 投影。
+"""
+from .crud import (
+    create_metric,
+    create_revision,
+    delete_metric,
+    update_metric,
+)
+from .mapping_confirm import confirm_mapping, reject_mapping
+from .ossie_import import _carry_over_term_maps as _carry_over_term_maps, import_ossie
+from .publish import (
+    get_release_revisions,
+    now_revisions_published,
+    publish_release,
+)
+from .term_binding import (
+    _target_revision as _target_revision,
+    bind_term,
+    list_terms_of,
+    resolve_term_ref,
+    unbind_term,
+)
+
+__all__ = [
+    "import_ossie",
+    "confirm_mapping", "reject_mapping",
+    "bind_term", "unbind_term", "list_terms_of", "resolve_term_ref",
+    "create_metric", "create_revision", "update_metric", "delete_metric",
+    "publish_release", "now_revisions_published", "get_release_revisions",
+]
diff --git a/jiuwenswarm/channels/web/dataagent/metrics/versioning/crud.py b/jiuwenswarm/channels/web/dataagent/metrics/versioning/crud.py
