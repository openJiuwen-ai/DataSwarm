+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/store.py —— ``dw_metric_*`` 六表的 CRUD。
+
+连接层沿用 ``metrics/db.py`` 的惯例：走系统元数据库（``orchestration.db._connect``），
+占位符统一写 ``?``，由 ``_exec`` 按连接类型自动适配 sqlite/MySQL。
+
+所有写函数都接受可选 ``conn``：发布流程需要在同一连接上原子地写
+release + 改修订状态 + 记录投影结果，不传则各自开连接。
+"""
+from __future__ import annotations
+
+import json
+import threading
+import uuid
+from typing import Any
+
+from jiuwenswarm.channels.web.orchestration.db import (
+    _connect,
+    _exec,
+    _fetch_dicts,
+    _fetch_one_dict,
+    _now,
+)
+
+from .errors import MetricNotFound, ReleaseNotFound
+from .model import (
+    Binding,
+    ConceptMapping,
+    ExpressionSpec,
+    MetricDef,
+    MetricRevision,
+    Release,
+    as_list,
+    canonical_json,
+)
+
+_write_lock = threading.Lock()
+
+
+def new_id(prefix: str) -> str:
+    """生成 ``<prefix>_<uuid12>`` 形式的主键。"""
+    return f"{prefix}_{uuid.uuid4().hex[:12]}"
+
+
+def _conn_or(conn: Any) -> tuple[Any, bool]:
+    """返回 (连接, 是否本函数自建)。自建的需要调用方提交与关闭。"""
+    if conn is not None:
+        return conn, False
+    return _connect(), True
+
+
+def _commit_if_own(conn: Any, own: bool) -> None:
+    if own:
+        conn.commit()
+
+
+# ==========================================================================
+# dw_metric_defs —— 指标身份
+# ==========================================================================
+def create_def(
+    *,
+    workspace_id: str,
+    metric_key: str,
+    name: str,
+    description: str = "",
+    owner: str = "",
+    conn: Any = None,
+) -> MetricDef:
+    """新建指标身份。同一 workspace 下 ``metric_key`` 已存在时返回既有记录。
+
+    Args:
+        workspace_id: 工作空间 ID。
+        metric_key: 指标业务键，如 ``commerce.gmv``。
+        name: 展示名。
+        description: 业务说明。
+        owner: 负责人。
+        conn: 可选的既有连接。
+
+    Returns:
+        新建或既有的 :class:`~.model.MetricDef`。
+    """
+    c, own = _conn_or(conn)
+    try:
+        existing = get_def_by_key(workspace_id, metric_key, conn=c)
+        if existing is not None:
+            return existing
+        now = _now()
+        metric = MetricDef(
+            metric_id=new_id("met"),
+            workspace_id=workspace_id,
+            metric_key=metric_key,
+            name=name,
+            description=description,
+            owner=owner,
+            status="draft",
+            created_at=now,
+            updated_at=now,
+        )
+        with _write_lock:
+            _exec(
+                c,
+                "INSERT INTO dw_metric_defs (metric_id, workspace_id, metric_key, name,"
+                " description, owner, status, current_revision_id, created_at, updated_at)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (metric.metric_id, metric.workspace_id, metric.metric_key, metric.name,
+                 metric.description, metric.owner, metric.status, metric.current_revision_id,
+                 metric.created_at, metric.updated_at),
+            )
+            _commit_if_own(c, own)
+        return metric
+    finally:
+        if own:
+            c.close()
+
+
+def _row_to_def(row: dict) -> MetricDef:
+    return MetricDef(
+        metric_id=row["metric_id"],
+        workspace_id=row["workspace_id"],
+        metric_key=row["metric_key"],
+        name=row["name"],
+        description=row.get("description") or "",
+        owner=row.get("owner") or "",
+        status=row.get("status") or "draft",
+        current_revision_id=row.get("current_revision_id"),
+        created_at=row.get("created_at") or "",
+        updated_at=row.get("updated_at") or "",
+    )
+
+
+def get_def(metric_id: str, *, conn: Any = None) -> MetricDef | None:
+    """按主键取指标身份。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(c, "SELECT * FROM dw_metric_defs WHERE metric_id = ?", (metric_id,))
+        return _row_to_def(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def get_def_by_key(workspace_id: str, metric_key: str, *, conn: Any = None) -> MetricDef | None:
+    """按 (workspace, metric_key) 取指标身份。"""
+    c, own = _conn_or(conn)
+    try:
+        row = _fetch_one_dict(
+            c,
+            "SELECT * FROM dw_metric_defs WHERE workspace_id = ? AND metric_key = ?",
+            (workspace_id, metric_key),
+        )
+        return _row_to_def(row) if row else None
+    finally:
+        if own:
+            c.close()
+
+
+def list_defs(
+    workspace_id: str, *, keyword: str | None = None, conn: Any = None
+) -> list[MetricDef]:
+    """列出工作空间下的指标身份，可按关键词过滤。
+
+    Args:
+        workspace_id: 工作空间。
+        keyword: 非空时对 ``metric_key`` / ``name`` / ``description`` 做包含匹配
+            （参数化 LIKE，供管理页搜索；空白关键词等价于不过滤）。
+        conn: 可选的既有连接。
+    """
+    c, own = _conn_or(conn)
+    try:
+        text = (keyword or "").strip()
+        if text:
+            pattern = f"%{text}%"
+            rows = _fetch_dicts(
+                c,
+                "SELECT * FROM dw_metric_defs WHERE workspace_id = ?"
+                " AND (metric_key LIKE ? OR name LIKE ? OR description LIKE ?)"
+                " ORDER BY metric_key",
+                (workspace_id, pattern, pattern, pattern),
+            )
+        else:
+            rows = _fetch_dicts(
+                c,
+                "SELECT * FROM dw_metric_defs WHERE workspace_id = ? ORDER BY metric_key",
+                (workspace_id,),
+            )
+        return [_row_to_def(r) for r in rows]
+    finally:
+        if own:
+            c.close()
+
+
+_DEF_SORT_COLUMNS = {
+    "metric_key": "d.metric_key",
+    "name": "d.name",
+    "updated_at": "d.updated_at",
+    "revision_count": "revision_count",
+}
+
+
+def list_defs_page(
+    workspace_id: str,
+    *,
+    keyword: str | None = None,
+    status: str | None = None,
+    sort: str = "metric_key",
+    order: str = "asc",
+    page: int = 0,
+    page_size: int = 0,
+    conn: Any = None,
+) -> dict:
+    """指标管理页的分页查询：筛选/排序/分页下推 SQL。
+
+    Args:
+        workspace_id: 工作空间。
+        keyword: 对 ``metric_key`` / ``name`` / ``description`` 的包含匹配。
+        status: ``published`` = 存在已发布修订；``draft`` = 没有；其他值不过滤。
+        sort: 白名单列（metric_key / name / updated_at / revision_count）。
+        order: ``asc`` / ``desc``；非法值按 asc。
+        page: 从 1 开始；``<=0`` 表示不分页（兼容 dwcli 等全量调用方）。
+        page_size: 每页条数；``<=0`` 表示不分页。
+        conn: 可选的既有连接。
+
+    Returns:
+        ``{"rows": [{"def", "revision_count", "has_published"}], "total",
+        "page", "page_size", "status_counts"}``——``status_counts`` 是全空间
+        计数（不受筛选影响，供 KPI/筛选徽章）。
+    """
+    c, own = _conn_or(conn)
+    try:
+        where = ["d.workspace_id = ?"]
+        params: list[Any] = [workspace_id]
+        text = (keyword or "").strip()
+        if text:
+            pattern = f"%{text}%"
+            where.append("(d.metric_key LIKE ? OR d.name LIKE ? OR d.description LIKE ?)")
+            params.extend([pattern, pattern, pattern])
+        if status == "published":
+            where.append(
+                "EXISTS (SELECT 1 FROM dw_metric_revisions r"
+                " WHERE r.metric_id = d.metric_id AND r.status = 'published')")
+        elif status == "draft":
+            where.append(
+                "NOT EXISTS (SELECT 1 FROM dw_metric_revisions r"
+                " WHERE r.metric_id = d.metric_id AND r.status = 'published')")
+        clause = " WHERE " + " AND ".join(where)
+        limit_clause = ""
+        query_params: list[Any] = list(params)
+        if page > 0 and page_size > 0:
+            limit_clause = " LIMIT ? OFFSET ?"
+            query_params += [int(page_size), (int(page) - 1) * int(page_size)]
+        sort_expr = _DEF_SORT_COLUMNS.get(sort, _DEF_SORT_COLUMNS["metric_key"])
+        direction = "DESC" if str(order).lower() == "desc" else "ASC"
+        rows = _fetch_dicts(
+            c,
+            "SELECT d.*,"
+            " (SELECT COUNT(*) FROM dw_metric_revisions r WHERE r.metric_id = d.metric_id)"
+            " AS revision_count,"
+            " (SELECT COUNT(*) FROM dw_metric_revisions r WHERE r.metric_id = d.metric_id"
+            " AND r.status = 'published') AS published_count"
+            " FROM dw_metric_defs d" + clause
+            + f" ORDER BY {sort_expr} {direction}, d.metric_key ASC" + limit_clause,
+            tuple(query_params),
+        )
+        total = int(_fetch_one_dict(
+            c,
+            "SELECT COUNT(*) AS n FROM dw_metric_defs d" + clause,
+            tuple(params),
+        )["n"])
+        counts_row = _fetch_one_dict(
+            c,
+            "SELECT"
+            " SUM(CASE WHEN COALESCE(p.n, 0) > 0 THEN 1 ELSE 0 END) AS published,"
+            " SUM(CASE WHEN COALESCE(p.n, 0) = 0 THEN 1 ELSE 0 END) AS draft"
+            " FROM dw_metric_defs d"
+            " LEFT JOIN (SELECT metric_id, COUNT(*) AS n FROM dw_metric_revisions"
+            " WHERE status = 'published' GROUP BY metric_id) p"
+            " ON p.metric_id = d.metric_id"
+            " WHERE d.workspace_id = ?",
+            (workspace_id,),
+        ) or {}
+        return {
+            "rows": [{
+                "def": _row_to_def(row),
+                "revision_count": int(row.get("revision_count") or 0),
+                "has_published": int(row.get("published_count") or 0) > 0,
+            } for row in rows],
+            "total": total,
+            "page": int(page),
+            "page_size": int(page_size),
+            "status_counts": {
+                "published": int(counts_row.get("published") or 0),
+                "draft": int(counts_row.get("draft") or 0),
+            },
+        }
+    finally:
+        if own:
+            c.close()
+
+
+def update_def(
+    metric_id: str,
+    *,
+    name: str | None = None,
+    description: str | None = None,
+    owner: str | None = None,
+    conn: Any = None,
+) -> MetricDef | None:
+    """更新指标身份的可变字段（口径在修订里，不在此处）。
+
+    Args:
+        metric_id: 指标主键。
+        name: 新展示名；None 表示不改。
+        description: 新业务说明；None 表示不改。
+        owner: 新负责人；None 表示不改。
+
+    Returns:
+        更新后的指标身份；指标不存在时为 None。
+    """
+    updates: dict[str, Any] = {}
+    if name is not None:
+        updates["name"] = name
+    if description is not None:
+        updates["description"] = description
+    if owner is not None:
+        updates["owner"] = owner
+    if updates:
+        updates["updated_at"] = _now()
+    c, own = _conn_or(conn)
+    try:
+        if updates:
+            assignments = ", ".join(f"{key} = ?" for key in updates)
+            with _write_lock:
+                _exec(
+                    c,
+                    f"UPDATE dw_metric_defs SET {assignments} WHERE metric_id = ?",
+                    (*updates.values(), metric_id),
+                )
+                _commit_if_own(c, own)
+        return get_def(metric_id, conn=c)
+    finally:
+        if own:
+            c.close()
+
+
+def delete_def(metric_id: str, *, conn: Any = None) -> int:
+    """删除指标身份行，返回删除行数（级联由调用方按修订逐层清理）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            cursor = _exec(
+                c, "DELETE FROM dw_metric_defs WHERE metric_id = ?", (metric_id,))
+            deleted = int(getattr(cursor, "rowcount", 0) or 0)
+            _commit_if_own(c, own)
+        return deleted
+    finally:
+        if own:
+            c.close()
+
+
+def touch_def(metric_id: str, *, conn: Any = None) -> None:
+    """只刷新 ``updated_at``（新建修订等身份未变但内容变化的场景）。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_defs SET updated_at = ? WHERE metric_id = ?",
+                (_now(), metric_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+def set_current_revision(
+    metric_id: str, revision_id: str, *, status: str = "active", conn: Any = None
+) -> None:
+    """把指标身份的当前修订指向 ``revision_id``。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                "UPDATE dw_metric_defs SET current_revision_id = ?, status = ?, updated_at = ?"
+                " WHERE metric_id = ?",
+                (revision_id, status, _now(), metric_id),
+            )
+            _commit_if_own(c, own)
+    finally:
+        if own:
+            c.close()
+
+
+# ==========================================================================
+# dw_metric_revisions —— 不可变口径版本
+# ==========================================================================
+_REV_COLS = (
+    "revision_id, metric_id, workspace_id, revision_no, metric_type, datatype, unit,"
+    " display_name, synonyms, expression_json, fixed_filters_json, time_dimension,"
+    " allowed_dimensions_json, time_grains_json, timezone, calendar, dependencies_json,"
+    " zero_denominator, additivity_json, subject_iri, status, source_type, ossie_raw,"
+    " definition_ref, definition_hash, created_at"
+)
+
+
+def create_revision(rev: MetricRevision, *, conn: Any = None) -> MetricRevision:
+    """写入一条修订。调用方须已算好 ``definition_hash`` 与 ``definition_ref``。"""
+    c, own = _conn_or(conn)
+    try:
+        with _write_lock:
+            _exec(
+                c,
+                f"INSERT INTO dw_metric_revisions ({_REV_COLS})"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    rev.revision_id, rev.metric_id, rev.workspace_id, rev.revision_no,
+                    rev.metric_type, rev.datatype, rev.unit, rev.display_name,
+                    canonical_json(list(rev.synonyms)), canonical_json(rev.expression.to_json_obj()),
