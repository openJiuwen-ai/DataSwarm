+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""plan 组件字段形态前置校验。
+
+事故背景（dacomp-zh-002）：模型自创 ``{id, kind, objective, from, dimensions:[{column}]}``
+字段，服务端在维度素材回源时把 dict 当 hash key，抛 ``unhashable type: 'dict'``
+被包装成 400，模型拿不到可操作信息，连续两轮同一错误。
+"""
+from jiuwenswarm.channels.web.dataagent.analysis.service import _plan_component_shape_errors
+
+
+class TestPlanComponentShapeErrors:
+    def test_model_invented_fields_rejected_with_hint(self):
+        payload = {"mode": "open", "components": [
+            {"id": "c1", "kind": "series", "objective": "趋势", "from": {"table": "t"}},
+        ]}
+        errors = _plan_component_shape_errors(payload)
+        assert errors
+        message = errors[0]["message"]
+        assert "component_id 必填" in message
+        assert "id/kind/objective/from" in message
+        # 必须给出可照抄的最小示例
+        assert "component_id" in message and "sql_draft" in message
+
+    def test_object_dimensions_rejected_instead_of_crashing(self):
+        payload = {"components": [
+            {"component_id": "c1", "dimensions": [{"column": "大类名称"}]},
+        ]}
+        errors = _plan_component_shape_errors(payload)
+        assert len(errors) == 1
+        assert "dimensions" in errors[0]["field"]
+        assert "字符串数组" in errors[0]["message"]
+
+    def test_valid_component_passes(self):
+        payload = {"components": [
+            {"component_id": "c1", "text": "按大类汇总销售金额",
+             "dimensions": ["大类名称"], "time": {"dimension": "销售月份",
+                                                  "start": "2026-01-01",
+                                                  "end_exclusive": "2026-05-01"},
+             "output": "元/月", "sql_draft": "SELECT ..."},
+        ]}
+        assert _plan_component_shape_errors(payload) == []
+
+    def test_non_list_dimensions_rejected(self):
+        payload = {"components": [{"component_id": "c1", "dimensions": "大类名称"}]}
+        errors = _plan_component_shape_errors(payload)
+        assert errors and "字符串数组" in errors[0]["message"]
diff --git a/tests/unit_tests/dataagent/test_runner_cleanup.py b/tests/unit_tests/dataagent/test_runner_cleanup.py
