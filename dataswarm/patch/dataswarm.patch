+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""表达式列引用校验回归测试。
+
+背景：指标驱动模式下 DWS 落列名取 metric_name，ADS 表达式若引用"业务短列名"
+（如 m.`total_amount`，实际列名 board_total_amount），Doris 执行期才报
+Unknown column。设计期必须拦截：expr / where / grain_exprs 与显式表的
+column_exprs / join.on / group_by 缺省引用均须与来源表列定义一致。
+"""
+
+import importlib.util
+import sys
+from pathlib import Path
+
+from metrics import derive_tables_from_metrics
+from schema import (
+    Column,
+    Join,
+    JoinOn,
+    MetricSpec,
+    SemanticSpec,
+    TableSpec,
+    validate_table_expr_columns,
+)
+
+_SCRIPTS = (
+    Path(__file__).resolve().parents[3]
+    / "jiuwenswarm"
+    / "resources"
+    / "agent"
+    / "workspace"
+    / "skills"
+    / "dw-warehouse-design"
+    / "scripts"
+)
+
+
+def _load(name: str, script: Path):
+    """按唯一模块名加载 skill 脚本。
+
+    裸名 ``render`` 会被缓存成单文件模块，遮蔽其它 skill 的同名 ``render/`` 包
+    （如 dw-report），因此不使用 ``from render import ...`` 的顶层导入。
+    """
+    spec = importlib.util.spec_from_file_location(name, script)
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_render = _load("_dw_warehouse_design_render", _SCRIPTS / "render.py")
+render_derived_etl = _render.render_derived_etl
+
+
+def _dws_metric(**overrides):
+    params = dict(
+        metric_name="board_total_amount",
+        display_name="板块成交额",
+        value_type="DECIMAL(38,4)",
+        expr="SUM(o.`amount`)",
+        grain=["board_id", "trade_date"],
+        source_tables=["bond.ods_board_trades"],
+        source_aliases={"bond.ods_board_trades": "o"},
+        table_name="dws_board_summary",
+        caliber="板块成交额",
+    )
+    params.update(overrides)
+    return MetricSpec(**params)
+
+
+def _ads_metric(**overrides):
+    params = dict(
+        metric_name="board_gmv_growth",
+        display_name="板块成交额增长",
+        value_type="DOUBLE",
+        expr="SUM(m.`board_total_amount`)",
+        grain=["board_id"],
+        source_tables=["bond.dws_board_summary"],
+        source_aliases={"bond.dws_board_summary": "m"},
+        table_name="ads_board_analysis",
+        caliber="板块成交额增长",
+    )
+    params.update(overrides)
+    return MetricSpec(**params)
+
+
+_ODS_TYPES = {
+    "bond.ods_board_trades": {
+        "board_id": ("VARCHAR(64)", False),
+        "trade_date": ("DATE", False),
+        "amount": ("DECIMAL(18,4)", True),
+        "status": ("VARCHAR(32)", True),
+    }
+}
+
+
