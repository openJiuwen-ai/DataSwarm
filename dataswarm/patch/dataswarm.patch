+
+from jiuwenswarm.common import db_connector
+
+from ..fingerprint import apply_fingerprints
+from ..model import (
+    ColumnMeta,
+    DatabaseMeta,
+    DataSourceMeta,
+    JoinPathMeta,
+    MetadataSnapshot,
+    TableMeta,
+    ViewLineage,
+)
+from .base import CollectionOptions, MetadataSourceAdapter
+
+_IDENTIFIER_RE = re.compile(r"^[A-Za-z0-9_$-]+$")
+_SENSITIVE_RULES = {
+    "credential": ("password", "passwd", "secret", "token", "api_key", "access_key"),
+    "phone": ("phone", "mobile", "telephone", "手机号", "电话"),
+    "email": ("email", "e_mail", "邮箱"),
+    "identity": ("id_card", "identity_card", "身份证", "passport"),
+    "address": ("address", "地址"),
+}
+_TIME_TOKENS = ("time", "date", "day", "month", "year", "created_at", "updated_at")
+_NUMERIC_TYPES = ("int", "decimal", "numeric", "double", "float", "real")
+
+# 语义采集支持的源类型：sqlite 复用 mysql 通路（方言分支，用户决策 2026-10-24）。
+# 语义层把 sqlite 呈现为 mysql——source_type / node_id 前缀（col:mysql:…）/图谱属性
+# 全链路同构，下游（指纹/图谱投影/向量/semantic_link）零分叉。
+_SEMANTIC_SOURCE_TYPES = ("mysql", "sqlite")
+
+
+class MySQLMetadataAdapter(MetadataSourceAdapter):
+    """Collect MySQL information_schema metadata using read-only queries.
+
+    sqlite 源分派到 ``_collect_sqlite_rows``（sqlite_master/PRAGMA 方言），
+    产出的行与 information_schema 同构后进入共享归一化 ``_assemble_snapshot``。
+    """
+
+    def collect(
+        self,
+        source: dict,
+        run_id: str,
+        snapshot_id: str,
+        options: CollectionOptions,
+    ) -> MetadataSnapshot:
+        source_id = str(source.get("source_id") or "").strip()
+        db_ref = str(source.get("db_ref") or "").strip()
+        if not source_id or not db_ref:
+            raise ValueError("source_id and db_ref are required")
+        source_type = str(source.get("source_type") or "").lower()
+        if source_type not in _SEMANTIC_SOURCE_TYPES:
+            raise ValueError(
+                f"semantic collection only supports {_SEMANTIC_SOURCE_TYPES} sources"
+            )
+        if source_type == "sqlite":
+            # sqlite 无 schema 概念：文件 stem 充当伪 schema（与主工程
+            # 「文件 stem 当库名」约定一致），options.schemas 忽略。
+            database = _sqlite_database_name(db_ref)
+            schemas = (database,)
+            table_rows, column_rows, index_rows, view_rows, foreign_rows, partition_rows = (
+                _collect_sqlite_rows(db_ref, database)
+            )
+        else:
+            schemas = tuple(_safe_identifier(item, "schema") for item in options.schemas if item)
+            if not schemas:
+                parsed = db_connector.parse_db_ref(db_ref)
+                database = str(parsed.get("database") or "").strip()
+                schemas = (_safe_identifier(database, "database"),) if database else ()
+            if not schemas:
+                raise ValueError("at least one target schema is required")
+            table_rows = self._collect_tables(db_ref, schemas)
+            column_rows = self._collect_columns(db_ref, schemas)
+            index_rows = self._collect_indexes(db_ref, schemas)
+            view_rows = self._collect_views(db_ref, schemas)
+            foreign_rows = self._collect_foreign_keys(db_ref, schemas)
+            partition_rows = self._collect_partitions(db_ref, schemas)
+        return _assemble_snapshot(
+            source_id, db_ref, run_id, snapshot_id, schemas,
+            SchemaRows(tables=table_rows, columns=column_rows, indexes=index_rows,
+                       views=view_rows, foreign_keys=foreign_rows, partitions=partition_rows),
+            options,
+            config_version=str(source.get("config_version") or 1),
+        )
+
+    def _collect_tables(self, db_ref: str, schemas: tuple[str, ...]) -> list[dict]:
+        sql = (
+            "SELECT /*+ MAX_EXECUTION_TIME(30000) */ TABLE_SCHEMA, TABLE_NAME, TABLE_TYPE, ENGINE, "
+            "TABLE_ROWS, DATA_LENGTH, INDEX_LENGTH, "
+            "CREATE_TIME, UPDATE_TIME, TABLE_COLLATION, TABLE_COMMENT FROM information_schema.TABLES "
+            f"WHERE TABLE_SCHEMA IN ({_string_list(schemas)}) ORDER BY TABLE_SCHEMA, TABLE_NAME"
+        )
+        return db_connector.query_dict(db_ref, sql, limit=None)
+
+    def _collect_columns(self, db_ref: str, schemas: tuple[str, ...]) -> list[dict]:
+        sql = (
+            "SELECT /*+ MAX_EXECUTION_TIME(30000) */ TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME, ORDINAL_POSITION, "
+            "COLUMN_DEFAULT, IS_NULLABLE, "
+            "DATA_TYPE, COLUMN_TYPE, COLUMN_KEY, EXTRA, COLUMN_COMMENT FROM information_schema.COLUMNS "
+            f"WHERE TABLE_SCHEMA IN ({_string_list(schemas)}) ORDER BY TABLE_SCHEMA, TABLE_NAME, ORDINAL_POSITION"
+        )
+        return db_connector.query_dict(db_ref, sql, limit=None)
+
+    def _collect_views(self, db_ref: str, schemas: tuple[str, ...]) -> list[dict]:
+        sql = (
+            "SELECT /*+ MAX_EXECUTION_TIME(30000) */ TABLE_SCHEMA, TABLE_NAME, VIEW_DEFINITION, CHECK_OPTION, "
+            "DEFINER FROM information_schema.VIEWS "
+            f"WHERE TABLE_SCHEMA IN ({_string_list(schemas)}) ORDER BY TABLE_SCHEMA, TABLE_NAME"
+        )
+        return db_connector.query_dict(db_ref, sql, limit=None)
+
+    def _collect_indexes(self, db_ref: str, schemas: tuple[str, ...]) -> list[dict]:
+        sql = (
+            "SELECT /*+ MAX_EXECUTION_TIME(30000) */ TABLE_SCHEMA, TABLE_NAME, INDEX_NAME, NON_UNIQUE, "
+            "SEQ_IN_INDEX, COLUMN_NAME, "
+            "CARDINALITY, INDEX_TYPE FROM information_schema.STATISTICS "
+            f"WHERE TABLE_SCHEMA IN ({_string_list(schemas)}) "
+            "ORDER BY TABLE_SCHEMA, TABLE_NAME, INDEX_NAME, SEQ_IN_INDEX"
+        )
+        return db_connector.query_dict(db_ref, sql, limit=None)
+
+    def _collect_foreign_keys(self, db_ref: str, schemas: tuple[str, ...]) -> list[dict]:
+        sql = (
+            "SELECT /*+ MAX_EXECUTION_TIME(30000) */ CONSTRAINT_NAME, TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME, "
+            "REFERENCED_TABLE_SCHEMA, "
+            "REFERENCED_TABLE_NAME, REFERENCED_COLUMN_NAME FROM information_schema.KEY_COLUMN_USAGE "
+            f"WHERE TABLE_SCHEMA IN ({_string_list(schemas)}) AND REFERENCED_TABLE_NAME IS NOT NULL"
+        )
+        return db_connector.query_dict(db_ref, sql, limit=None)
+
+    def _collect_partitions(self, db_ref: str, schemas: tuple[str, ...]) -> list[dict]:
+        sql = (
+            "SELECT /*+ MAX_EXECUTION_TIME(30000) */ TABLE_SCHEMA, TABLE_NAME, PARTITION_NAME, "
+            "PARTITION_METHOD, PARTITION_EXPRESSION "
+            "FROM information_schema.PARTITIONS "
+            f"WHERE TABLE_SCHEMA IN ({_string_list(schemas)}) AND PARTITION_NAME IS NOT NULL"
+        )
+        return db_connector.query_dict(db_ref, sql, limit=None)
+
+    def _profile_table(self, db_ref: str, table: TableMeta, options: CollectionOptions) -> None:
+        columns = table.columns[: max(0, options.profile_max_columns_per_table)]
+        if not columns:
+            return
+        expressions = ["COUNT(*) AS `__row_count`"]
+        expressions.extend(
+            f"SUM(CASE WHEN {_quote_for(db_ref, column.name)} IS NULL THEN 1 ELSE 0 END) AS `n{index}`"
+            for index, column in enumerate(columns)
+        )
+        selected_columns = ", ".join(_quote_for(db_ref, column.name) for column in columns)
+        if table.fqn in options.core_tables:
+            profile_from = _qualified_for(db_ref, table.database, table.name)
+        else:
+            sample_rows = max(1, options.profile_sample_rows)
+            profile_from = (
+                f"(SELECT {selected_columns} FROM {_qualified_for(db_ref, table.database, table.name)} "
+                f"LIMIT {sample_rows}) AS `semantic_sample`"
+            )
+        rows = db_connector.query_dict(
+            db_ref,
+            f"SELECT /*+ MAX_EXECUTION_TIME(30000) */ {', '.join(expressions)} "
+            f"FROM {profile_from}",
+            limit=None,
+        )
+        if rows:
+            row = rows[0]
+            exact_count = int(row.get("__row_count") or 0)
+            if table.fqn in options.core_tables:
+                table.row_count = exact_count
+                table.row_count_estimated = False
+            for index, column in enumerate(columns):
+                column.null_ratio = round(int(row.get(f"n{index}") or 0) / exact_count, 6) if exact_count else 0.0
+        for column in columns:
+            if column.is_sensitive or options.profile_top_k <= 0:
+                continue
+            sample_rows = max(1, options.profile_sample_rows)
+            sampled_values = (
+                f"SELECT {_quote_for(db_ref, column.name)} FROM {_qualified_for(db_ref, table.database, table.name)} "
+                f"WHERE {_quote_for(db_ref, column.name)} IS NOT NULL LIMIT {sample_rows}"
+            )
+            sql = (
+                f"SELECT /*+ MAX_EXECUTION_TIME(30000) */ "
+                f"{_quote_for(db_ref, column.name)} AS `value`, COUNT(*) AS `count` "
+                f"FROM ({sampled_values}) AS `semantic_sample` "
+                f"GROUP BY {_quote_for(db_ref, column.name)} ORDER BY `count` DESC LIMIT {int(options.profile_top_k)}"
+            )
+            values = db_connector.query_dict(db_ref, sql, limit=None)
+            column.top_k = [
+                {"value": _json_value(item.get("value")), "count": int(item.get("count") or 0)} for item in values
+            ]
+
+    @staticmethod
+    def _excluded(table_name: str, patterns: tuple[str, ...]) -> bool:
+        return any(fnmatch.fnmatch(table_name.lower(), pattern.lower()) for pattern in patterns)
+
+
+# ==========================================================================
+# sqlite 方言分支（与 mysql 同一采集通路，用户决策 2026-10-24）
+# ==========================================================================
+def _sqlite_quote(value: str) -> str:
+    """sqlite 引号：双引号包裹、内嵌引号转义。
+
+    mysql 分支的 _quote 走 _safe_identifier（仅 ASCII 标识符），中文表/列名
+    （如 DAComp 数据集）必须走本宽松引号。sqlite 兼容反引号但统一双引号最稳。
+    """
+    text = str(value or "")
+    return '"' + text.replace('"', '""') + '"'
+
+
+def _is_sqlite_ref(db_ref: str) -> bool:
+    try:
+        spec = db_connector.parse_db_ref(db_ref)
+    except Exception:  # noqa: BLE001 —— 解析失败按非 sqlite 处理（走 mysql 引号并自然报错）
+        return False
+    return str(spec.get("type") or "").lower() == "sqlite"
+
+
+def _quote_for(db_ref: str, value: str) -> str:
+    """方言感知引号：sqlite 双引号（中文标识符合法）；mysql 反引号（ASCII 校验）。"""
+    if _is_sqlite_ref(db_ref):
+        return _sqlite_quote(value)
+    return _quote(value)
+
+
+def _qualified_for(db_ref: str, database: str, table: str) -> str:
+    """方言感知表限定。
+
+    sqlite 的库名限定只认 main/temp/attached，`` `db`.`tbl``` 形态直接语法错——
+    伪 schema 不进 SQL，直接引表名；mysql 保持 `` `db`.`tbl` ``。
+    """
+    if _is_sqlite_ref(db_ref):
+        return _sqlite_quote(table)
+    return _qualified(database, table)
+
+
+def _sqlite_database_name(db_ref: str) -> str:
+    """sqlite 伪 schema：文件 stem（与主工程「文件 stem 当库名」约定一致）。"""
+    spec = db_connector.parse_db_ref(db_ref)
+    path = str(spec.get("path") or "").strip()
+    if not path:
+        raise ValueError(f"sqlite db_ref has no file path: {db_ref!r}")
+    stem = Path(path).stem
+    if not stem:
+        raise ValueError(f"cannot derive database name from sqlite path: {path!r}")
+    return stem
+
+
+def _collect_sqlite_rows(db_ref: str, database: str) -> tuple[list[dict], ...]:
+    """sqlite_master/PRAGMA → information_schema 同构行（方言分支的数据面）。
+
+    返回 (tables, columns, indexes, views, foreign_keys, partitions)，行字段名
+    与 mysql 分支的 information_schema 查询一致，归一化层零感知。分区恒空。
+    """
+    object_rows = db_connector.query_dict(
+        db_ref,
+        "SELECT name, type, sql FROM sqlite_master "
+        "WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite_%' ORDER BY name",
+        limit=None,
+    )
+    table_rows: list[dict] = []
+    view_rows: list[dict] = []
+    column_rows: list[dict] = []
+    index_rows: list[dict] = []
+    foreign_rows: list[dict] = []
+    for row in object_rows:
+        name = str(row.get("name") or "")
+        if not name:
+            continue
+        if str(row.get("type") or "") == "view":
+            view_rows.append({
+                "TABLE_SCHEMA": database, "TABLE_NAME": name,
+                "VIEW_DEFINITION": str(row.get("sql") or ""),
+                "CHECK_OPTION": "", "DEFINER": "",
+            })
+            continue
+        table_rows.append({
+            "TABLE_SCHEMA": database, "TABLE_NAME": name,
+            "TABLE_TYPE": "BASE TABLE", "ENGINE": "sqlite",
+            "TABLE_ROWS": None, "DATA_LENGTH": None, "INDEX_LENGTH": None,
+            "CREATE_TIME": None, "UPDATE_TIME": None,
+            "TABLE_COLLATION": "", "TABLE_COMMENT": "",
+        })
+        ref = _sqlite_quote(name)
+        # 列：PRAGMA table_info（sqlite 无列注释；pk 从 PRAGMA 取）
+        for col in db_connector.query_dict(db_ref, f"PRAGMA table_info({ref})", limit=None):
+            column_rows.append({
+                "TABLE_SCHEMA": database, "TABLE_NAME": name,
+                "COLUMN_NAME": str(col.get("name") or ""),
+                "ORDINAL_POSITION": int(col.get("cid") or 0) + 1,
+                "COLUMN_DEFAULT": col.get("dflt_value"),
+                "IS_NULLABLE": "NO" if int(col.get("notnull") or 0) else "YES",
+                "DATA_TYPE": str(col.get("type") or ""),
+                "COLUMN_TYPE": str(col.get("type") or ""),
+                "COLUMN_KEY": "PRI" if int(col.get("pk") or 0) else "",
+                "EXTRA": "", "COLUMN_COMMENT": "",
+            })
+        # 索引：隐式 sqlite_autoindex_* 跳过（information_schema.STATISTICS 只含显式索引）
+        for idx in db_connector.query_dict(db_ref, f"PRAGMA index_list({ref})", limit=None):
+            index_name = str(idx.get("name") or "")
+            if not index_name or index_name.startswith("sqlite_autoindex"):
+                continue
+            for info in db_connector.query_dict(db_ref, f"PRAGMA index_info({_sqlite_quote(index_name)})", limit=None):
+                index_column = str(info.get("name") or "")
+                if not index_column:
+                    continue
+                index_rows.append({
+                    "TABLE_SCHEMA": database, "TABLE_NAME": name,
+                    "INDEX_NAME": index_name, "COLUMN_NAME": index_column,
+                })
+        # 外键：PRAGMA foreign_key_list
+        for fk in db_connector.query_dict(db_ref, f"PRAGMA foreign_key_list({ref})", limit=None):
+            column_name = str(fk.get("from") or "")
+            ref_table = str(fk.get("table") or "")
+            ref_column = str(fk.get("to") or "")
+            if not (column_name and ref_table and ref_column):
+                continue
+            foreign_rows.append({
+                "CONSTRAINT_NAME": f"sqlite_fk_{name}_{fk.get('seq', 0)}",
+                "TABLE_SCHEMA": database, "TABLE_NAME": name,
+                "COLUMN_NAME": column_name,
+                "REFERENCED_TABLE_SCHEMA": database,
+                "REFERENCED_TABLE_NAME": ref_table,
+                "REFERENCED_COLUMN_NAME": ref_column,
+            })
+    # 行数：逐表 COUNT(*) best-effort（评测库均为小型库；单表失败保持 None）
+    for row in table_rows:
+        try:
+            counted = db_connector.query_dict(
+                db_ref,
+                f"SELECT COUNT(*) AS `n` FROM {_sqlite_quote(row['TABLE_NAME'])}",
+                limit=None,
+            )
+            row["TABLE_ROWS"] = int(counted[0].get("n") or 0) if counted else None
+        except Exception:  # noqa: BLE001 —— 行数是画像输入，失败不阻断采集
+            row["TABLE_ROWS"] = None
+    return table_rows, column_rows, index_rows, view_rows, foreign_rows, []
+
+
+@dataclass(frozen=True)
+class SchemaRows:
+    """information_schema 六类同构行的采集产物（mysql/sqlite 共用归一化输入）。"""
+
+    tables: list[dict]
+    columns: list[dict]
+    indexes: list[dict]
+    views: list[dict]
+    foreign_keys: list[dict]
+    partitions: list[dict]
+
+
+def _assemble_snapshot(
+    source_id: str,
+    db_ref: str,
+    run_id: str,
+    snapshot_id: str,
+    schemas: tuple[str, ...],
+    rows: SchemaRows,
+    options: CollectionOptions,
+    config_version: Any = 1,
+) -> MetadataSnapshot:
+    """information_schema 同构行 → MetadataSnapshot（mysql/sqlite 共享归一化）。
+
+    语义层把 sqlite 呈现为 mysql（source_type/node_id 前缀/图谱属性同构），
+    下游指纹/图谱投影/向量/semantic_link 零分叉。
+    """
+    adapter = MySQLMetadataAdapter()
+    views = {(str(row["TABLE_SCHEMA"]), str(row["TABLE_NAME"])): row for row in rows.views}
+    indexed_columns = {
+        (str(row.get("TABLE_SCHEMA") or ""), str(row.get("TABLE_NAME") or ""), str(row.get("COLUMN_NAME") or ""))
+        for row in rows.indexes
+    }
+
+    columns_by_table: dict[tuple[str, str], list[ColumnMeta]] = defaultdict(list)
+    for row in rows.columns:
+        database = str(row["TABLE_SCHEMA"])
+        table_name = str(row["TABLE_NAME"])
+        if adapter._excluded(table_name, options.exclude_patterns):
+            continue
+        sensitivity = _sensitivity(str(row.get("COLUMN_NAME") or ""), str(row.get("COLUMN_COMMENT") or ""))
+        columns_by_table[(database, table_name)].append(
+            ColumnMeta(
+                source_id=source_id,
+                source_type="mysql",
+                database=database,
+                table=table_name,
+                name=str(row.get("COLUMN_NAME") or ""),
+                data_type=str(row.get("DATA_TYPE") or ""),
+                column_type=str(row.get("COLUMN_TYPE") or ""),
+                ordinal=int(row.get("ORDINAL_POSITION") or 0),
+                nullable=str(row.get("IS_NULLABLE") or "YES").upper() == "YES",
+                column_key=str(row.get("COLUMN_KEY") or ""),
+                is_indexed=(database, table_name, str(row.get("COLUMN_NAME") or "")) in indexed_columns,
+                default_value=_json_value(row.get("COLUMN_DEFAULT")),
+                extra=str(row.get("EXTRA") or ""),
+                comment=str(row.get("COLUMN_COMMENT") or ""),
+                is_sensitive=bool(sensitivity),
+                sensitivity_class=sensitivity,
+            )
+        )
+
+    partition_map = _partition_summary(rows.partitions)
+    tables: list[TableMeta] = []
+    for row in rows.tables:
+        database = str(row["TABLE_SCHEMA"])
+        table_name = str(row["TABLE_NAME"])
+        if adapter._excluded(table_name, options.exclude_patterns):
+            continue
+        table_type = "VIEW" if str(row.get("TABLE_TYPE") or "").upper() == "VIEW" else "BASE TABLE"
+        table = TableMeta(
+            source_id=source_id,
+            source_type="mysql",
+            database=database,
+            name=table_name,
+            table_type=table_type,
+            engine=str(row.get("ENGINE") or ""),
+            comment=str(row.get("TABLE_COMMENT") or ""),
+            row_count=_optional_int(row.get("TABLE_ROWS")),
+            data_length=_optional_int(row.get("DATA_LENGTH")),
+            index_length=_optional_int(row.get("INDEX_LENGTH")),
+            create_time=_time_value(row.get("CREATE_TIME")),
+            update_time=_time_value(row.get("UPDATE_TIME")),
+            view_definition=str(views.get((database, table_name), {}).get("VIEW_DEFINITION") or ""),
+            columns=sorted(columns_by_table.get((database, table_name), []), key=lambda item: item.ordinal),
+        )
+        partition = partition_map.get((database, table_name), {})
+        table.partition_count = int(partition.get("count") or 0)
+        table.partition_type = str(partition.get("type") or "")
+        table.partition_key = str(partition.get("expression") or "")
+        table.table_role, table.role_confidence, table.role_evidence = _infer_table_role(table)
+        tables.append(table)
+
+    profile_errors: list[dict[str, str]] = []
+    if options.include_profile:
+        for table in tables:
+            if table.table_type != "VIEW":
+                try:
+                    adapter._profile_table(db_ref, table, options)
+                except Exception as exc:
+                    profile_errors.append(
+                        {"stage": "profile", "table": table.fqn, "type": type(exc).__name__, "message": str(exc)}
+                    )
+
+    snapshot = MetadataSnapshot(
+        snapshot_id=snapshot_id,
+        run_id=run_id,
+        source=DataSourceMeta(source_id, "mysql", _redacted_ref(db_ref), config_version),
+        databases=[DatabaseMeta(source_id, "mysql", schema) for schema in schemas],
+        tables=tables,
+        scope={"schemas": list(schemas), "exclude_patterns": list(options.exclude_patterns)},
+        errors=profile_errors,
+    )
+    snapshot.joins.extend(_foreign_key_joins(source_id, rows.foreign_keys))
+    view_joins, lineages = _parse_views(source_id, tables)
+    snapshot.joins.extend(view_joins)
+    # 命名推断级（*_id 同名同类型 + top_k 包含率近似）与血缘级（table_lineage）
+    # join 证据——演示库这类导入库通常无外键，没有它们多表问题全部停在
+    # 「join 证据不足」。与声明级同端点的推断/血缘候选被丢弃（声明优先）。
+    snapshot.joins.extend(_inferred_joins(source_id, tables, known=snapshot.joins))
+    snapshot.joins.extend(_lineage_joins(source_id, tables, db_ref=db_ref, known=snapshot.joins))
+    snapshot.lineages.extend(lineages)
+    return apply_fingerprints(snapshot)
+
+
+def _safe_identifier(value: str, label: str) -> str:
+    value = str(value or "").strip()
+    if not value or not _IDENTIFIER_RE.fullmatch(value):
+        raise ValueError(f"invalid {label}: {value!r}")
+    return value
+
+
+def _quote(value: str) -> str:
+    return f"`{_safe_identifier(value, 'identifier')}`"
+
+
+def _qualified(database: str, table: str) -> str:
+    return f"{_quote(database)}.{_quote(table)}"
+
+
+def _string_list(values: tuple[str, ...]) -> str:
+    return ",".join("'" + value.replace("'", "''") + "'" for value in values)
+
+
+def _redacted_ref(db_ref: str) -> str:
+    spec = db_connector.parse_db_ref(db_ref)
+    if str(spec.get("type") or "").lower() == "sqlite":
+        # sqlite ref 不含凭据，路径本身即身份；保持与归一化形态一致
+        return f"sqlite://{spec.get('path')}"
+    return f"{spec.get('type')}://{spec.get('host')}:{spec.get('port')}/{spec.get('database')}"
+
+
+def _optional_int(value: Any) -> int | None:
+    try:
+        return int(value) if value is not None else None
+    except (TypeError, ValueError):
+        return None
+
+
+def _time_value(value: Any) -> str | None:
+    if value is None:
+        return None
+    return value.isoformat() if isinstance(value, (datetime, date)) else str(value)
+
+
+def _json_value(value: Any) -> Any:
+    if isinstance(value, (datetime, date)):
+        return value.isoformat()
+    if isinstance(value, Decimal):
+        return str(value)
+    if isinstance(value, bytes):
+        return value.hex()
+    return value
+
+
+def _sensitivity(name: str, comment: str) -> str:
+    haystack = f"{name} {comment}".lower()
+    for classification, tokens in _SENSITIVE_RULES.items():
+        if any(token in haystack for token in tokens):
+            return classification
+    return ""
+
+
+def _infer_table_role(table: TableMeta) -> tuple[str, float, list[str]]:
+    lowered = table.name.lower()
+    names = [column.name.lower() for column in table.columns]
+    has_time = any(any(token in name for token in _TIME_TOKENS) for name in names)
+    numeric_count = sum(any(token in column.data_type.lower() for token in _NUMERIC_TYPES) for column in table.columns)
+    key_count = sum(column.column_key in {"PRI", "UNI", "MUL"} for column in table.columns)
+    if any(token in lowered for token in ("log", "event", "trace")) and has_time:
+        return "log", 0.9, ["name_pattern", "time_column"]
+    if any(token in lowered for token in ("snapshot", "snap", "daily")) and has_time:
+        return "snapshot", 0.82, ["name_pattern", "time_column"]
+    if len(table.columns) <= 5 and key_count >= 2:
+        return "bridge", 0.8, ["few_columns", "multiple_keys"]
+    if has_time and numeric_count >= 2 and (table.row_count or 0) >= 10000:
+        return "fact", 0.84, ["time_column", "numeric_measures", "row_count"]
+    if any(column.column_key in {"PRI", "UNI"} for column in table.columns) and (table.row_count or 0) < 1000000:
+        return "dim", 0.76, ["unique_key", "bounded_row_count"]
+    return "unknown", 0.3, []
+
+
+def _partition_summary(rows: list[dict]) -> dict[tuple[str, str], dict[str, Any]]:
+    result: dict[tuple[str, str], dict[str, Any]] = {}
+    for row in rows:
+        key = (str(row.get("TABLE_SCHEMA") or ""), str(row.get("TABLE_NAME") or ""))
+        item = result.setdefault(key, {"count": 0, "type": "", "expression": ""})
+        item["count"] += 1
+        item["type"] = str(row.get("PARTITION_METHOD") or item["type"])
+        item["expression"] = str(row.get("PARTITION_EXPRESSION") or item["expression"])
+    return result
+
+
+def _foreign_key_joins(source_id: str, rows: list[dict]) -> list[JoinPathMeta]:
+    joins: list[JoinPathMeta] = []
+    for row in rows:
+        left_db = str(row.get("TABLE_SCHEMA") or "")
+        left_table = str(row.get("TABLE_NAME") or "")
+        left_column = str(row.get("COLUMN_NAME") or "")
+        right_db = str(row.get("REFERENCED_TABLE_SCHEMA") or "")
+        right_table = str(row.get("REFERENCED_TABLE_NAME") or "")
+        right_column = str(row.get("REFERENCED_COLUMN_NAME") or "")
+        if not all((left_db, left_table, left_column, right_db, right_table, right_column)):
+            continue
+        joins.append(
+            JoinPathMeta(
+                source_id=source_id,
+                source_type="mysql",
+                left_column_id=f"col:mysql:{source_id}:{left_db}.{left_table}.{left_column}",
+                right_column_id=f"col:mysql:{source_id}:{right_db}.{right_table}.{right_column}",
+                left_table_id=f"tbl:mysql:{source_id}:{left_db}.{left_table}",
+                right_table_id=f"tbl:mysql:{source_id}:{right_db}.{right_table}",
+                cardinality="N:1",
+                confidence=1.0,
+                source=["foreign_key"],
+                evidence={"constraint": str(row.get("CONSTRAINT_NAME") or ""), "level": "declared"},
+                status="verified",
+            )
+        )
+    return joins
+
+
+def _parse_views(source_id: str, tables: list[TableMeta]) -> tuple[list[JoinPathMeta], list[ViewLineage]]:
+    joins: dict[str, JoinPathMeta] = {}
+    lineages: dict[tuple[str, str], ViewLineage] = {}
+    known = {(table.database.lower(), table.name.lower()): table for table in tables}
+    for view in tables:
+        if view.table_type != "VIEW" or not view.view_definition:
+            continue
+        try:
+            parsed = sqlglot.parse_one(view.view_definition, read="mysql")
+        except sqlglot.errors.ParseError:
+            continue
+        aliases: dict[str, tuple[str, str]] = {}
+        for table_expr in parsed.find_all(exp.Table):
+            database = str(table_expr.db or view.database)
+            table_name = str(table_expr.name)
+            aliases[str(table_expr.alias_or_name)] = (database, table_name)
+            source_table = known.get((database.lower(), table_name.lower()))
+            if source_table:
+                lineage = ViewLineage(
+                    source_id,
+                    "mysql",
+                    view.node_id,
+                    source_table.node_id,
+                    completeness="partial" if parsed.find(exp.Star) else "complete",
+                )
+                lineages[(lineage.view_id, lineage.source_table_id)] = lineage
+        for equality in parsed.find_all(exp.EQ):
+            if not isinstance(equality.left, exp.Column) or not isinstance(equality.right, exp.Column):
+                continue
+            left = _resolved_column(source_id, view.database, aliases, equality.left)
+            right = _resolved_column(source_id, view.database, aliases, equality.right)
+            if not left or not right or left[1] == right[1]:
+                continue
+            join = JoinPathMeta(
+                source_id=source_id,
+                source_type="mysql",
+                left_column_id=left[0],
+                right_column_id=right[0],
+                left_table_id=left[1],
+                right_table_id=right[1],
+                cardinality="unknown",
+                confidence=0.85,
+                source=["view_definition"],
+                evidence={"view": view.fqn, "level": "declared"},
+                status="verified",
+            )
+            joins[join.node_id] = join
+    return list(joins.values()), list(lineages.values())
+
+
+def _resolved_column(
+    source_id: str,
+    default_database: str,
+    aliases: dict[str, tuple[str, str]],
+    column: exp.Column,
+) -> tuple[str, str] | None:
+    table_alias = str(column.table or "")
+    if not table_alias or table_alias not in aliases:
+        return None
+    database, table = aliases[table_alias]
+    database = database or default_database
+    return (
+        f"col:mysql:{source_id}:{database}.{table}.{column.name}",
+        f"tbl:mysql:{source_id}:{database}.{table}",
+    )
+
+
+# ==========================================================================
+# join 证据等级扩展（P0）：推断级（命名约定）与血缘级（table_lineage）
+# ==========================================================================
+
+def _type_family(data_type: str) -> str:
+    """基础类型族（int 族 / string 族 / 日期族 / 其他）——推断级类型匹配面。"""
+    lowered = str(data_type or "").lower()
+    if any(token in lowered for token in ("int", "serial")):
+        return "int"
+    if any(token in lowered for token in ("char", "text", "enum", "set")):
+        return "string"
+    if any(token in lowered for token in ("date", "time", "year")):
+        return "datetime"
+    return lowered
+
+
+def _known_endpoints(joins: list[JoinPathMeta]) -> set[frozenset[str]]:
+    """已知 join 的无序端点对集合（正反序视为同一对）。"""
+    return {
+        frozenset((join.left_column_id, join.right_column_id))
+        for join in joins
+        if join.left_column_id and join.right_column_id
+    }
+
+
+def _topk_overlap(left: ColumnMeta, right: ColumnMeta) -> float | None:
+    """top_k 采样值的交集包含率近似（|L∩R| / min(|L|,|R|)）。
+
+    两侧都非空才算得出；未 profile（任一侧 top_k 为空）返回 None——
+    「包含率未知」与「包含率为 0」必须区分，前者不能压 confidence。
+    """
+    left_values = {str(item.get("value")) for item in left.top_k if item.get("value") is not None}
+    right_values = {str(item.get("value")) for item in right.top_k if item.get("value") is not None}
+    if not left_values or not right_values:
+        return None
+    smaller = min(len(left_values), len(right_values))
+    if not smaller:
+        return None
+    return round(len(left_values & right_values) / smaller, 4)
+
+
+def _inferred_joins(
+    source_id: str,
+    tables: list[TableMeta],
+    known: list[JoinPathMeta],
+) -> list[JoinPathMeta]:
+    """命名推断级 join 证据：``*_id`` 同名同基础类型的跨表列配对。
+
+    演示库这类导入库通常不建外键，命名约定是唯一可自动获得的信号——
+    推断级只用于探索（产物标 ``inferred_join``），经人工确认（或指标绑定
+    声明）后才升级声明级。与已知端点重复的配对跳过（声明优先）。
+
+    Args:
+        source_id: 数据源 ID。
+        tables: 本次采集的表（含列与可选 top_k 画像）。
+        known: 已收集的声明级 join（外键/视图）。
+
+    Returns:
+        推断级 JoinPathMeta 列表（``status=candidate``）。
+    """
+    known_pairs = _known_endpoints(known)
+    # 候选列索引：列名(lower) → [(table, column)]，仅 *_id 后缀参与命名推断
+    by_name: dict[str, list[tuple[TableMeta, ColumnMeta]]] = {}
+    for table in tables:
+        if table.table_type == "VIEW":
+            continue
+        for column in table.columns:
+            name = column.name.lower()
+            if not name.endswith("_id"):
+                continue
+            by_name.setdefault(name, []).append((table, column))
+
+    joins: dict[str, JoinPathMeta] = {}
+    for name, entries in by_name.items():
+        if len(entries) < 2:
+            continue
+        for index, (left_table, left_column) in enumerate(entries):
+            for right_table, right_column in entries[index + 1:]:
+                if left_table.node_id == right_table.node_id:
+                    continue
+                if _type_family(left_column.data_type) != _type_family(right_column.data_type):
+                    continue
+                left_id = f"col:mysql:{source_id}:{left_table.database}.{left_table.name}.{left_column.name}"
+                right_id = f"col:mysql:{source_id}:{right_table.database}.{right_table.name}.{right_column.name}"
+                if frozenset((left_id, right_id)) in known_pairs:
+                    continue
+                overlap = _topk_overlap(left_column, right_column)
+                evidence: dict[str, Any] = {"level": "inferred", "naming": name}
+                if overlap is not None:
+                    evidence["overlap_ratio"] = overlap
+                join = JoinPathMeta(
+                    source_id=source_id,
+                    source_type="mysql",
+                    left_column_id=left_id,
+                    right_column_id=right_id,
+                    left_table_id=left_table.node_id,
+                    right_table_id=right_table.node_id,
+                    cardinality="unknown",
+                    confidence=0.5 if overlap is None else min(0.8, 0.5 + overlap / 2),
+                    source=["naming_convention"],
+                    evidence=evidence,
+                    status="candidate",
+                )
+                joins[join.node_id] = join
+    return list(joins.values())
+
+
+def _lineage_joins(
+    source_id: str,
+    tables: list[TableMeta],
+    *,
+    db_ref: str,
+    known: list[JoinPathMeta],
+) -> list[JoinPathMeta]:
+    """血缘级 join 证据：table_lineage ETL 血缘的 join_key 落到采集列。
+
+    只认 join_key 能解析成 ``表.列 = 表.列`` 且两侧表都在本次采集范围内的
+    行（best-effort：别名解析失败的行跳过，不阻断采集）。business_ref 作为
+    跨数据源隔离键（本机与远端共用元库的场景靠它分流）。
+
+    Args:
+        source_id: 数据源 ID。
+        tables: 本次采集的表。
+        db_ref: 当前源连接 ref（归一化后与 lineage.business_ref 匹配）。
+        known: 已收集的 join（含外键/视图/推断级）。
+
+    Returns:
+        血缘级 JoinPathMeta 列表（``status=candidate``）。
+    """
+    from jiuwenswarm.channels.web.orchestration.db import _connect, _fetch_dicts
+
+    business_ref = ""
+    try:
+        from jiuwenswarm.common import workspace_context
+
+        ref = str(workspace_context.current_workspace().business_db_ref or "").strip()
+        business_ref = workspace_context.normalize_db_ref(ref) if ref else ""
+    except Exception:  # noqa: BLE001 —— 工作空间解析失败按无过滤读（行级仍按表范围筛）
+        business_ref = ""
+
+    try:
+        conn = _connect()
+        try:
+            if business_ref:
+                rows = _fetch_dicts(
+                    conn,
+                    "SELECT lineage_id,source_db,source_table,target_db,target_table,join_key "
+                    "FROM table_lineage WHERE business_ref=?",
+                    (business_ref,),
+                )
+            else:
+                rows = _fetch_dicts(
+                    conn,
+                    "SELECT lineage_id,source_db,source_table,target_db,target_table,join_key FROM table_lineage",
+                )
+        finally:
+            conn.close()
+    except Exception:  # noqa: BLE001 —— 血缘表不可用（未建/锁）不阻断采集
+        return []
+
+    known_pairs = _known_endpoints(known)
+    table_index = {(table.database.lower(), table.name.lower()): table for table in tables}
+    joins: dict[str, JoinPathMeta] = {}
+    for row in rows:
+        source_db = str(row.get("source_db") or "").lower()
+        source_table = str(row.get("source_table") or "").lower()
+        target_db = str(row.get("target_db") or "").lower()
+        target_table = str(row.get("target_table") or "").lower()
+        source_meta = table_index.get((source_db, source_table))
+        target_meta = table_index.get((target_db, target_table))
+        if source_meta is None or target_meta is None:
+            continue
+        pair = _parse_join_key(str(row.get("join_key") or ""), source_meta, target_meta)
+        if pair is None:
+            continue
+        (left_col, right_col) = pair
+        left_id = f"col:mysql:{source_id}:{source_meta.database}.{source_meta.name}.{left_col}"
+        right_id = f"col:mysql:{source_id}:{target_meta.database}.{target_meta.name}.{right_col}"
+        if frozenset((left_id, right_id)) in known_pairs:
+            continue
+        join = JoinPathMeta(
+            source_id=source_id,
+            source_type="mysql",
+            left_column_id=left_id,
+            right_column_id=right_id,
+            left_table_id=source_meta.node_id,
+            right_table_id=target_meta.node_id,
+            cardinality="unknown",
+            confidence=0.7,
+            source=["table_lineage"],
+            evidence={
+                "level": "lineage",
+                "lineage_id": str(row.get("lineage_id") or ""),
+            },
+            status="candidate",
+        )
+        joins[join.node_id] = join
+    return list(joins.values())
+
+
+def _parse_join_key(
+    join_key: str, source_table: TableMeta, target_table: TableMeta
+) -> tuple[str, str] | None:
+    """``a.c1 = b.c2`` 形态的 join_key → ``(source 侧列, target 侧列)``。
+
+    join_key 的左右表序与 lineage 的 source/target 顺序无必然对应（ETL 里
+    JOIN 写法自由），两侧引用对 source/target **双向匹配**；表名/别名匹配
+    失败时退化为「列名在两表中合计只出现一次」的列归属判定，仍歧义则放弃
+    该行（best-effort，不阻断采集）。
+    """
+    match = re.search(
+        r"([\w]+)\s*\.\s*`?([\w]+)`?\s*=\s*([\w]+)\s*\.\s*`?([\w]+)`?", join_key
+    )
+    if not match:
+        return None
+    left_ref, left_col, right_ref, right_col = (part.strip("`") for part in match.groups())
+
+    def _column_of(ref: str, column: str, table: TableMeta) -> str | None:
+        lowered = ref.lower()
+        # 表名精确或后缀匹配（血缘 join_key 里常见别名 = 表名简写）
+        if (lowered == table.name.lower() or table.name.lower().endswith(f".{lowered}")
+                or lowered.endswith(table.name.lower())):
+            return column if any(col.name.lower() == column.lower() for col in table.columns) else None
+        return None
+
+    # 双向：join_key 左侧落在 source、右侧落在 target；或反序
+    left_source = _column_of(left_ref, left_col, source_table)
+    left_target = _column_of(left_ref, left_col, target_table)
+    right_source = _column_of(right_ref, right_col, source_table)
+    right_target = _column_of(right_ref, right_col, target_table)
+    if left_source and right_target:
+        return left_source, right_target
+    if left_target and right_source:
+        return right_source, left_target
+    # 别名兜底：ref 解析不出表，但列名在两表中合计唯一出现 → 按列归属定侧
+    left_hits = [
+        side for side, table in (("source", source_table), ("target", target_table))
+        if any(col.name.lower() == left_col.lower() for col in table.columns)
+    ]
+    right_hits = [
+        side for side, table in (("source", source_table), ("target", target_table))
+        if any(col.name.lower() == right_col.lower() for col in table.columns)
+    ]
+    if left_hits and right_hits and left_hits != right_hits:
+        source_col = left_col if left_hits == ["source"] else right_col
+        target_col = right_col if right_hits == ["target"] else left_col
+        return source_col, target_col
+    return None
