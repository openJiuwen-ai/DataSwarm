+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""scheduler.py 单测：覆盖 cron/once due 判定 + fire 派发 + 幂等性。
+
+这两个 bug 的回归保护：
+  1. last_instance_ts 返回 created_at(ISO) 被当 instance_id(YYYYmmdd_HHMMSS) 解析
+     → base 永远 fallback now → cron 永远 not due。
+  2. tzinfo naive/aware 混用，比较无意义。
+
+跑法：python -m pytest tests/unit_tests/orchestration/test_scheduler.py -v -p no:cacheprovider
+      或：python -m tests.unit_tests.orchestration.test_scheduler
+"""
+from __future__ import annotations
+
+import os
+import sys
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+import pytest
+
+_REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+for _p in (_REPO,):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import jiuwenswarm.channels.web.orchestration.scheduler as scheduler  # noqa: E402
+from jiuwenswarm.common import workspace_context as _wc  # noqa: E402
+from jiuwenswarm.common import workspace_store as _ws  # noqa: E402
+
+_TZ = scheduler._TZ  # "Asia/Shanghai"
+
+
+@pytest.fixture(autouse=True)
+def _single_workspace_env(monkeypatch, tmp_path):
+    """_tick 现按工作空间遍历（决策五）。本文件用例固定在单工作空间配置下跑，
+    不读开发者机器的真实 ~/.jiuwenswarm/（否则机器上配了多工作空间或注册表
+    有 custom 工作空间时，mock 的 list_scheduled_targets 不分库，同一目标
+    会在每个工作空间各触发一次）。"""
+    cfg = tmp_path / "datasource.yaml"
+    # sqlite 指针：doris 方言已退役，且 doris://<库名> 会读真实 config 的 doris 段（环境泄漏）
+    cfg.write_text(
+        f"default_db: sqlite://{tmp_path / 'biz.db'}\nmetadata_db: sqlite://{tmp_path / 'meta.db'}\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(_wc, "_config_path", lambda: cfg)
+    monkeypatch.setattr(_ws, "_config_dir", lambda: tmp_path)
+    monkeypatch.delenv("JIUWENSWARM_ORCH_DB", raising=False)
+
+
+def _aware(dt_str: str) -> datetime:
+    """ISO8601 → aware datetime（与 _parse_iso 一致，本地 tz）。"""
+    return scheduler._parse_iso(dt_str).astimezone(ZoneInfo(_TZ))
+
+
+def _make_target(st: str, *, cron=None, once_at=None, ref_id="task_x", ref_type="task") -> dict:
+    return {
+        "ref_type": ref_type,
+        "ref_id": ref_id,
+        "schedule_type": st,
+        "schedule_cron": cron,
+        "schedule_once_at": once_at,
+    }
+
+
+# --------------------------------------------------------------------------
+# cron _is_due
+# --------------------------------------------------------------------------
+def test_cron_due_when_period_elapsed_since_last_instance(monkeypatch):
+    """上次实例在本周期 cron 点之前 → 本周期已到 → due=True（修复前的 bug：返回 False）。"""
+    tz = ZoneInfo(_TZ)
+    # cron 每天 02:00；上次实例 08-28 16:49（今天 02:00 未触发）；now 08-29 09:00
+    now = datetime(2026, 8, 29, 9, 0, 0, tzinfo=tz)
+    last = "2026-08-28T16:49:35+0800"  # last_instance_ts 实际返回的 created_at 格式
+    monkeypatch.setattr(scheduler.orch_db, "last_instance_ts", lambda *_a, **_k: last)
+    t = _make_target("cron", cron="0 2 * * *")
+    assert scheduler._is_due(t, now) is True
+
+
+def test_cron_not_due_when_already_fired_this_period(monkeypatch):
+    """本周期已触发（上次实例在 cron 点之后）→ next 跳到下周期 → due=False（幂等防重复）。"""
+    tz = ZoneInfo(_TZ)
+    now = datetime(2026, 8, 29, 9, 0, 0, tzinfo=tz)
+    last = "2026-08-29T03:00:00+0800"  # 今天 02:00 之后
