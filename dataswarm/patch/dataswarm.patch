+    """Windows cmd/PowerShell 别名 shim：转发全部参数，ERRORLEVEL 原样透传。"""
+    return "\n".join(
+        (
+            "@echo off",
+            "rem Auto-generated by DataSwarm desktop; forwards the literal `python'",
+            "rem convention (SKILL.md) to the frozen exe. Do not edit.",
