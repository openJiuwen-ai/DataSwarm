--- /dev/null
+++ b/jiuwenswarm/channels/web/dataagent/connectors/duckdb_connector.py
@@ -0,0 +1,1136 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""DuckDB 文件与对象存储连接器。"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import re
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+from .base import (
+    Connector,
+    SourceDefinition,
+    build_catalog,
+    build_schema,
+    register_engine,
+)
+from .errors import ConnectorDependencyError, ConnectorError
+from .paths import resolve_local_path
+from .sql_guard import parse_write_sql, validate_read_only_sql
+
+try:
+    import duckdb
+except ImportError:  # pragma: no cover - exercised in minimal installations
+    duckdb = None
+
+
+def _require_duckdb() -> None:
+    if duckdb is None:
+        raise ConnectorDependencyError("DuckDB is not installed")
+
+
+# ---------------------------------------------------------------------------
+# warehouse：本地 csv 源的持久化 .duckdb 库（物化 dwd/dws/ads 分层表）。
+# DuckDB 单文件单写者：进程内每文件一把连接 + 一把锁，跨方法共享；
+# 跨进程冲突由部署隔离（JIUWENSWARM_DATA_DIR）。
+# ---------------------------------------------------------------------------
+
+# duckdb 模块经 try/except Import 加载（无 stubs），共享连接统一用 Any
+_WAREHOUSES: dict[str, tuple["Any", threading.Lock]] = {}
+_WAREHOUSE_MAP_LOCK = threading.Lock()
+
+
+def _warehouse_base_dir() -> Path:
+    from jiuwenswarm.common.utils import get_user_workspace_dir
+
+    base = get_user_workspace_dir() / "warehouse"
+    base.mkdir(parents=True, exist_ok=True)
+    return base
+
+
+def warehouse_file_for(location: str, source_dir_name: str) -> Path:
+    """location → warehouse 文件路径（同物理目录稳定同名）。"""
+    key = re.sub(r"[^A-Za-z0-9_]", "", source_dir_name)[:24] or "csv"
+    digest = hashlib.sha1(location.replace("\\", "/").lower().encode("utf-8")).hexdigest()[:8]
+    return _warehouse_base_dir() / f"csv__{key}__{digest}.duckdb"
+
+
+def _get_warehouse(location: str, source_dir_name: str):
+    _require_duckdb()
+    path = warehouse_file_for(location, source_dir_name)
+    with _WAREHOUSE_MAP_LOCK:
+        entry = _WAREHOUSES.get(str(path))
+        if entry is None:
+            connection = duckdb.connect(str(path))
+            connection.execute("SET threads = 4")
+            connection.execute("SET memory_limit = '2GB'")
+            entry = (connection, threading.Lock())
+            _WAREHOUSES[str(path)] = entry
+        return entry
+
+
+def close_warehouses() -> None:
+    """关闭全部共享 warehouse 连接（测试清理用；运行期不调用）。"""
+    with _WAREHOUSE_MAP_LOCK:
+        for connection, _ in _WAREHOUSES.values():
+            try:
+                connection.close()
+            except Exception:  # noqa: BLE001 —— 清理路径尽力而为
+                pass
+        _WAREHOUSES.clear()
+
+
+_ETL_MANIFEST_NAME = ".dw_etl_manifest.json"
+
+# 同层 ETL 节点经 ThreadPoolExecutor 并行执行，各自走独立的 :memory: 连接，
+# 但共享同一份目录 manifest——load-modify-save 全程必须按目录串行，
+# 否则 Windows 下并发 os.replace 报 WinError 32/5 且条目互相覆盖丢失。
+_ETL_MANIFEST_LOCKS: dict[str, threading.Lock] = {}
+_ETL_MANIFEST_LOCKS_GUARD = threading.Lock()
+
+
+def _etl_manifest_lock(directory: Path) -> threading.Lock:
+    key = str(directory)
+    with _ETL_MANIFEST_LOCKS_GUARD:
+        lock = _ETL_MANIFEST_LOCKS.get(key)
+        if lock is None:
+            lock = threading.Lock()
+            _ETL_MANIFEST_LOCKS[key] = lock
+        return lock
+
+
+def _exp_classes():
+    """延迟导入 sqlglot 表达式类型（与 parse_write_sql 白名单同集）。"""
+    from sqlglot import exp
+
+    return exp
+
+
+def _retarget_statement(stmt, new_target: str) -> None:
+    """把写入语句的目标表改写到影子表（INSERT/ALTER 共用）。"""
+    from sqlglot import exp
+
+    def _swap(table):
+        if isinstance(table, exp.Table):
+            table.args["this"] = exp.to_identifier(new_target)
+        elif isinstance(table, exp.Schema):
+            # Schema.this 是只读 property，改内层 Table 的标识符
+            inner = table.this
+            if isinstance(inner, exp.Table):
+                inner.args["this"] = exp.to_identifier(new_target)
+
+    if isinstance(stmt, exp.Insert):
+        _swap(stmt.this)
+    elif isinstance(stmt, exp.Alter):
+        _swap(stmt.this)
+
+
+def _alter_rename_to(stmt) -> str | None:
+    """ALTER ... RENAME TO 的新表名（无 RENAME 动作返回 None）。"""
+    for action in stmt.args.get("actions") or []:
+        if type(action).__name__ == "AlterRename":
+            target = action.args.get("this")
+            if target is not None:
+                return target.name
+    return None
+
+
+def _etl_manifest_path(directory: Path) -> Path:
+    return directory / _ETL_MANIFEST_NAME
+
+
+def _etl_manifest_load(directory: Path) -> dict:
+    """读 ETL 产物清单。无文件返回空清单；损坏时大声失败——静默当空会
+    把已有产物误判为源文件，反过来拒绝合法的 ETL 重跑。"""
+    path = _etl_manifest_path(directory)
+    if not path.exists():
+        return {"tables": {}}
+    import json
+
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise ConnectorError(
+            f"ETL manifest is corrupted: {path} ({exc}); fix or remove it manually"
+        ) from exc
+    tables = data.get("tables")
+    if not isinstance(tables, dict):
+        raise ConnectorError(f"ETL manifest is corrupted: {path} (missing 'tables')")
+    return {"tables": tables}
+
+
+def _etl_manifest_save(directory: Path, manifest: dict) -> None:
+    """tmp + os.replace 原子写，避免半写文件被下次 load 判损坏。
+
+    tmp 名含 pid+tid：同目录多线程并发保存时各自写各自的 tmp，
+    不再互相争抢同一文件句柄（Windows WinError 32）。调用方须持有
+    _etl_manifest_lock(directory)。
+    """
+    import json
+
+    path = _etl_manifest_path(directory)
+    tmp = directory / f"{_ETL_MANIFEST_NAME}.{os.getpid()}_{threading.get_ident()}.tmp"
+    try:
+        tmp.write_text(
+            json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8"
+        )
+        os.replace(tmp, path)
+    finally:
+        if tmp.exists():
+            tmp.unlink()
+
+
+def _etl_manifest_update(directory: Path, mutate) -> dict:
+    """按目录串行地 load → mutate(manifest) → save，返回 manifest。
+
+    ETL 并行节点共用这份清单，读-改-写必须整体持锁，否则并发覆盖丢条目。
+    """
+    with _etl_manifest_lock(directory):
+        manifest = _etl_manifest_load(directory)
+        mutate(manifest)
+        _etl_manifest_save(directory, manifest)
+        return manifest
+
+
+def _view_name_for_stem(stem: str) -> str:
+    """文件 stem → 合法视图名（与 db_connector._duckdb_table_name 清洗规则一致）。
+
+    非 ASCII（如中文文件名）清洗后为空 → 回退 data，语义损失已知。
+    """
+    name = re.sub(r"[^A-Za-z0-9_]", "", stem)
+    if not name or not name[0].isalpha():
+        return "data"
+    return name
+
+
+def _xls_cache_file(location: str) -> Path:
+    """.xls 源 → 转换产物缓存路径（键含 mtime+size，源文件变更自动失效）。"""
+    from jiuwenswarm.common.utils import get_user_workspace_dir
+
+    path = Path(location)
+    try:
+        stat = path.stat()
+        fingerprint = f"{path.resolve()}:{stat.st_mtime_ns}:{stat.st_size}"
+    except OSError:
+        fingerprint = str(path)
+    digest = hashlib.sha1(fingerprint.replace("\\", "/").encode("utf-8")).hexdigest()[:8]
+    stem = re.sub(r"[^A-Za-z0-9_]", "", path.stem)[:24] or "legacy"
+    return get_user_workspace_dir() / "cache" / "xls" / f"{stem}__{digest}.xlsx"
+
+
+def _ensure_xlsx(location: str) -> str:
+    """.xls（Excel 97-2003 BIFF）→ 转存缓存 .xlsx 后返回；其余原样返回。
+
+    DuckDB excel 扩展只认 Office Open XML（zip+XML），.xls 必须经 pandas+xlrd
+    转换；连接器每次查询重建 in-memory 连接，产物必须落盘缓存复用。
+    """
+    if not location.lower().endswith(".xls"):
+        return location
+    cached = _xls_cache_file(location)
+    if cached.exists():
+        return str(cached)
+    try:
+        import xlrd  # noqa: F401 —— 仅探测能力，实际读取由 pandas 走 xlrd 引擎
+    except ImportError as exc:
+        raise ConnectorDependencyError("xlrd is required for .xls (Excel 97-2003) workbooks") from exc
+    try:
+        import pandas as pd
+
+        frame = pd.read_excel(location)
+        cached.parent.mkdir(parents=True, exist_ok=True)
+        tmp = cached.with_suffix(".tmp")
+        frame.to_excel(tmp, index=False)
+        os.replace(tmp, cached)
+    except ConnectorDependencyError:
+        raise
+    except Exception as exc:
+        raise ConnectorError(f"failed to convert legacy .xls workbook: {location}") from exc
+    return str(cached)
+
+
+_EXCEL_SUFFIXES = (".xlsx", ".xlsm", ".xls")
+
+
+# ---------------------------------------------------------------------------
+# csv/excel 目录源的判定和视图名由目录源助手统一提供。
+# 仅接受本地目录（非 URL/glob），视图名由文件 stem 清洗并消除冲突。
+# ---------------------------------------------------------------------------
+
+def _s3_endpoint_settings(config: dict) -> dict:
+    """解析 DuckDB httpfs 的 endpoint、HTTPS 和寻址方式。
+
+    显式配置优先。endpoint 的 http/https scheme 用于推断 use_ssl，传给 DuckDB
+    时仅保留 host:port。设置 endpoint 后默认使用 path；未设置时保留 DuckDB
+    默认值。要求 virtual-host 寻址的服务（如阿里云 OSS）须显式配置 vhost。
+    """
+    raw_endpoint = str(config.get("endpoint") or "").strip()
+    out: dict = {}
+    if not raw_endpoint:
+        # AWS：沿用 DuckDB 默认（vhost + ssl），但显式配置仍然生效
+        for key, field in (("s3_use_ssl", "use_ssl"), ("s3_url_style", "url_style")):
+            value = config.get(field)
+            if value is not None and str(value).strip() != "":
+                out[key] = _as_duckdb_flag(value) if field == "use_ssl" else str(value)
+        return out
+
+    endpoint, inferred_ssl = raw_endpoint, None
+    for scheme, ssl_value in (("https://", "true"), ("http://", "false")):
+        if endpoint.lower().startswith(scheme):
+            endpoint = endpoint[len(scheme):]
+            inferred_ssl = ssl_value
+            break
+    out["s3_endpoint"] = endpoint.rstrip("/")
+
+    explicit_ssl = config.get("use_ssl")
+    if explicit_ssl is not None and str(explicit_ssl).strip() != "":
+        out["s3_use_ssl"] = _as_duckdb_flag(explicit_ssl)
+    elif inferred_ssl is not None:
+        out["s3_use_ssl"] = inferred_ssl
+
+    explicit_style = str(config.get("url_style") or "").strip()
+    out["s3_url_style"] = explicit_style or "path"
+    return out
+
+
+def _as_duckdb_flag(value) -> str:
+    """把表单里的真假值归一成 DuckDB 认的 'true'/'false'。
+
+    表单传回来的是字符串，``bool("false")`` 是 True——直接转会把「否」当成「是」。
+    """
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    text = str(value).strip().lower()
+    return "false" if text in ("false", "0", "no", "off", "") else "true"
+
+
+def is_dir_location(source_type: str, location: str) -> bool:
+    """csv/excel 目录源判定（纯函数，无 SourceDefinition 依赖）。
+
+    与 DuckDBConnector._source_dir 同口径：非本地路径（s3:// 等）与
+    显式 glob（展开后与目录同形，无法区分）不算目录源。
+    """
+    if source_type not in ("csv", "excel"):
+        return False
+    if not location or "://" in location or "*" in location:
+        return False
+    try:
+        return Path(location).expanduser().resolve().is_dir()
+    except OSError:
+        return False
+
+
+def dir_view_names(source_type: str, location: str) -> list[str]:
+    """目录源的视图名列表（与 DuckDBConnector._datasets 同口径：stem 清洗 +
+    冲突 _2 后缀，sorted 保稳定）。非目录源返回 []。"""
+    if not is_dir_location(source_type, location):
+        return []
+    directory = Path(location).expanduser().resolve()
+    if source_type == "excel":
+        files = sorted(p for p in directory.iterdir()
+                       if p.suffix.lower() in _EXCEL_SUFFIXES)
+    else:
+        files = sorted(directory.glob("*.csv"))
+    names: list[str] = []
+    taken: dict[str, int] = {}
+    for file in files:
+        name = _view_name_for_stem(file.stem)
+        count = taken.get(name, 0)
+        taken[name] = count + 1
+        names.append(name if count == 0 else f"{name}_{count + 1}")
+    return names
+
+
+@register_engine("duckdb")
+class DuckDBConnector(Connector):
+    engine = "duckdb"
+
+    def __init__(self, source: SourceDefinition):
+        self.source = source
+        # excel 扩展不可用时置位：一次回退后本实例不再尝试 LOAD（每实例新连接）
+        self._excel_fallback_used = False
+        self._excel_fallback_reason = ""
+
+    def _raw_location(self) -> str:
+        return str(self.source.config.get("location") or self.source.config.get("path") or "")
+
+    @staticmethod
+    def _object_store_settings(config: dict) -> dict:
+        """暴露给测试与排查用：这组 SET 决定能不能连上非 AWS 端点。"""
+        return _s3_endpoint_settings(config)
+
+    @staticmethod
+    def _normalize_object_store_uri(location: str) -> str:
+        """将 oss:// 和 s3a:// 归一为 httpfs 接受的 s3://。
+
+        URI 别名不改变认证方式；实际服务由 endpoint、region 和凭据配置决定。
+        """
+        for alias in ("oss://", "s3a://"):
+            if location.lower().startswith(alias):
+                return "s3://" + location[len(alias):]
+        return location
+
+    def _location(self) -> str:
+        location = self._raw_location()
+        if not location:
+            raise ConnectorError("file location is required")
+        if "://" in location:
+            return self._normalize_object_store_uri(location)
+        if self.source.config.get("sandbox", True) is False:
+            # 经 workspace 边界校验的 db-ref 桥接路径：不受 JIUWENSWARM_DATA_ROOTS
+            # 沙箱限制（用户注册的绝对路径常在 cwd/data 之外），仅做基本规整。
+            return str(Path(location).expanduser().resolve())
+        resolved = resolve_local_path(location)
+        return str(resolved)
+
+    def _source_dir(self) -> Path | None:
+        """目录场景返回目录 Path（每文件一视图）；其余返回 None。
+
+        支持 csv 与 excel 目录。判定看原始 config 路径 is_dir()——
+        _location() 展开后的 dir/*.csv 与用户显式 glob 同形，无法区分，
+        必须用原始值。
+        """
+        if self.source.config.get("format") or self.source.source_type not in ("csv", "excel"):
+            return None
+        raw = self._raw_location()
+        if not raw or "://" in raw or "*" in raw:
+            return None
+        if self.source.config.get("sandbox", True) is False:
+            path = Path(raw).expanduser().resolve()
+        else:
+            try:
+                path = Path(resolve_local_path(raw))
+            except Exception:
+                return None
+        return path if path.is_dir() else None
+
+    def _dir_glob(self, directory: Path) -> list[Path]:
+        """目录场景的文件清单：csv → *.csv；excel → *.xlsx/*.xlsm/.xls（sorted 保稳定）。"""
+        if self.source.source_type == "excel":
+            return sorted(p for p in directory.iterdir() if p.suffix.lower() in _EXCEL_SUFFIXES)
+        return sorted(directory.glob("*.csv"))
+
+    def _datasets(self) -> list[tuple[str, str]]:
+        """返回 [(view_name, file_path)]。
+
+        目录（csv/excel）：每文件一条（视图名 = stem 清洗，冲突加 _2 后缀，
+        sorted 保证增删文件后同名视图映射稳定）；空目录返回 []。
+        其余（单文件/显式 glob/S3/其他格式）：单条 (table_name, _location())。
+        """
+        directory = self._source_dir()
+        if directory is None:
+            return [(self._table_name(), self._location())]
+        views: list[tuple[str, str]] = []
+        taken: dict[str, int] = {}
+        for file in self._dir_glob(directory):
+            name = _view_name_for_stem(file.stem)
+            count = taken.get(name, 0)
+            taken[name] = count + 1
+            view = name if count == 0 else f"{name}_{count + 1}"
+            views.append((view, str(file)))
+        return views
+
+    def _table_name(self) -> str:
+        name = str(self.source.config.get("table_name") or "data")
+        if not name or not name.replace("_", "a").isalnum() or not name[0].isalpha():
+            raise ConnectorError("invalid table_name")
+        return name
+
+    def _is_warehouse_source(self) -> bool:
+        """excel 目录/单文件/glob、csv 单文件/glob → 走持久 warehouse。
+
+        csv 目录源除外：查看类入口走 :memory:（打开数据资产页不产生
+        文件锁），写入走 _execute_write_dir（产物 csv 落源目录，被
+        _datasets() 实时 glob 发现）。
+        """
+        if self.source.source_type not in ("csv", "excel") or self.source.config.get("format"):
+            return False
+        if "://" not in self._raw_location():
+            return not (self.source.source_type == "csv" and self._source_dir() is not None)
+        return False
+
+    def _is_csv_dir_source(self) -> bool:
+        """csv 目录源（新口径：读 :memory: + 写目录 csv + manifest 保护）。"""
+        return (
+            self.source.source_type == "csv"
+            and not self.source.config.get("format")
+            and "://" not in self._raw_location()
+            and self._source_dir() is not None
+        )
+
+    def _warehouse(self):
+        directory = self._source_dir()
+        name = directory.name if directory is not None else Path(self._location()).stem
+        return _get_warehouse(self._location(), name)
+
+    def _refresh_views(self, connection) -> None:
+        """按实时文件清单刷新 TEMP VIEW：删失效、建缺失（含冲突 _2 重排）。
+
+        TEMP VIEW 只活在连接内，warehouse 文件只存物化表；每次入口重刷
+        保持与 :memory: 时代相同的"实时感知"语义。
+        """
+        datasets = self._datasets()
+        if not datasets:
+            raise ConnectorError(
+                f"no {self.source.source_type} files found in directory: {self._source_dir()}"
+            )
+        current = {view for view, _ in datasets}
+        existing = {
+            row[0]
+            for row in connection.execute(
+                "SELECT table_name FROM information_schema.tables "
+                "WHERE table_catalog = 'temp' AND table_type = 'VIEW'"
+            ).fetchall()
+        }
+        for stale in existing - current:
+            connection.execute(f'DROP VIEW IF EXISTS "{stale}"')
+        for view, file_path in datasets:
+            if view in existing:
+                continue
+            # excel 走 _excel_view（read_xlsx + pandas 离线回退，与 _prepare 同链路）；
+            # csv 用 read_csv_auto
+            if Path(file_path).suffix.lower() in _EXCEL_SUFFIXES:
+                self._excel_view(connection, view, file_path)
+            else:
+                escaped = file_path.replace("'", "''")
+                reader = f"read_csv_auto('{escaped}', quote='\"')"
+                connection.execute(
+                    f'CREATE OR REPLACE TEMP VIEW "{view}" AS SELECT * FROM {reader}'
+                )
+
+    def _materialized(self, connection) -> list[str]:
+        rows = connection.execute(
+            "SELECT table_name FROM information_schema.tables "
+            "WHERE table_catalog = current_database() "
+            "AND table_schema = 'main' AND table_type = 'BASE TABLE' "
+            "ORDER BY table_name"
+        ).fetchall()
+        return [row[0] for row in rows]
+
+    def _all_datasets(self, connection) -> list[str]:
+        """目录/文件 VIEW ∪ 库内物化表（资产表清单的合并真相源）。"""
+        return [view for view, _ in self._datasets()] + self._materialized(connection)
+
+    def _connection(self):
+        _require_duckdb()
+        if self.source.source_type == "duckdb":
+            from . import duckdb_native
+
+            return duckdb_native.connect(self._location(), duckdb)
+        connection = duckdb.connect(database=":memory:")
+        connection.execute("SET threads = 4")
+        connection.execute("SET memory_limit = '2GB'")
+        self._configure_object_store(connection)
+        return connection
+
+    def _with_warehouse(self, fn):
+        """warehouse 源的执行通道：共享连接 + 锁 + 入口刷视图。
+
+        注意不能用 `with connection`——DuckDB 连接的上下文管理器会真关连接，
+        与进程内共享冲突。
+        """
+        connection, lock = self._warehouse()
+        with lock:
+            self._refresh_views(connection)
+            return fn(connection)
+
+    def _configure_object_store(self, connection) -> None:
+        # _location() 已把 oss:// / s3a:// 归一成 s3://（见 _normalize_object_store_uri），
+        # 所以此处只需判 s3://——否则 OSS 源会静默跳过 httpfs 配置而连不上。
+        location = self._location()
+        if not location.startswith("s3://"):
+            return
+        try:
+            connection.execute("INSTALL httpfs")
+            connection.execute("LOAD httpfs")
+        except Exception as exc:
+            raise ConnectorDependencyError(f"DuckDB httpfs extension is unavailable: {exc}") from exc
+        config = self.source.config
+        settings = {
+            "s3_region": config.get("region"),
+            "s3_access_key_id": config.get("access_key"),
+            "s3_secret_access_key": config.get("secret_key"),
+        }
+        settings.update(_s3_endpoint_settings(config))
+        for key, value in settings.items():
+            if value is None or value == "":
+                continue
+            escaped = str(value).replace("'", "''")
+            connection.execute(f"SET {key} = '{escaped}'")
+
+    def _view_sql(self, relation: str) -> str:
+        location = self._location().replace("'", "''")
+        source_type = self.source.config.get("format") or self.source.source_type
+        if source_type == "csv":
+            return f"read_csv_auto('{location}', quote='\"')"
+        if source_type == "parquet":
+            return f"read_parquet('{location}')"
+        if source_type == "json":
+            return f"read_json_auto('{location}')"
+        raise ConnectorError(f"unsupported DuckDB source type: {source_type}")
+
+    def _excel_view(self, connection, table_name: str, location: str) -> None:
+        """excel → TEMP VIEW read_xlsx（excel 扩展，快于 pandas ~8x）。
+
+        .xls（Excel 97-2003）先经 _ensure_xlsx 转存缓存 .xlsx，
+        read_xlsx 与 pandas 回退共用转换产物。
+        扩展不可用（离线未缓存）时整实例回退 pandas 注册 DataFrame——目录
+        多文件只回退判定一次，后续文件直接走回退，不反复试 LOAD。
+        只支持本地路径（与 pandas 回退同限制）。
+
+        TEMP VIEW 对齐 _refresh_views 的清单口径（table_catalog='temp'）。
+        历史注记：warehouse 路径曾刻意去掉 pandas 回退（大声失败），理由是
+        回退与 TEMP VIEW 清理不兼容——本函数统一 TEMP VIEW 后该冲突不复现
+        （见 test_duckdb_excel_fallback.py：离线回退下查询/重入刷新/CTAS 均过），
+        恢复回退使离线环境 excel 源可用。
+        """
+        location = _ensure_xlsx(location)
+        if not self._excel_fallback_used:
+            try:
+                connection.execute("LOAD excel")
+                escaped = location.replace("'", "''")
+                connection.execute(
+                    f'CREATE OR REPLACE TEMP VIEW "{table_name}" AS '
+                    f"SELECT * FROM read_xlsx('{escaped}')"
+                )
+                return
+            except Exception as exc:
+                self._excel_fallback_used = True
+                self._excel_fallback_reason = str(exc)
+        self._register_excel_pandas(connection, table_name, location)
+
+    def _register_excel_pandas(self, connection, table_name: str, location: str) -> None:
+        """pandas/openpyxl 离线回退：读入后注册为一次性关系。"""
+        try:
+            import pandas as pd
+        except ImportError as exc:
+            raise ConnectorDependencyError(f"pandas is required for excel source: {exc}") from exc
+        try:
+            frame = pd.read_excel(location)
+        except Exception as exc:
+            raise ConnectorError(f"failed to read excel workbook: {location}") from exc
+        connection.register(table_name, frame)
+
+    def _prepare(self, connection) -> None:
+        if self.source.source_type == "duckdb":
+            # 原生库直接读取已有对象，不为其创建文件视图或 warehouse。
+            return
+        directory = self._source_dir()
+        if directory is not None:
+            datasets = self._datasets()
+            if not datasets:
+                raise ConnectorError(f"no {self.source.source_type} files found in directory: {directory}")
+            for view, file_path in datasets:
+                if self.source.source_type == "excel":
+                    self._excel_view(connection, view, file_path)
+                else:
+                    escaped = file_path.replace("'", "''")
+                    connection.execute(
+                        f'CREATE OR REPLACE VIEW "{view}" AS '
+                        f"SELECT * FROM read_csv_auto('{escaped}', quote='\"')"
+                    )
+            return
+        source_type = self.source.config.get("format") or self.source.source_type
+        if source_type == "excel":
+            location = self._location()
+            if "*" in location or "://" in location:
+                raise ConnectorError("excel source requires a single local workbook file")
+            self._excel_view(connection, self._table_name(), location)
+            return
+        table_name = self._table_name()
+        connection.execute(
+            f'CREATE OR REPLACE VIEW "{table_name}" AS SELECT * FROM {self._view_sql(table_name)}'
+        )
+
+    def test_connection(self) -> dict:
+        try:
+            if self._is_warehouse_source():
+                self._with_warehouse(lambda conn: conn.execute("SELECT 1").fetchone())
+            else:
+                with self._connection() as connection:
+                    self._prepare(connection)
+                    connection.execute("SELECT 1")
+            return {"ok": True, "message": "file is readable", "engine": self.engine}
+        except Exception as exc:
+            return {"ok": False, "error": str(exc), "engine": self.engine}
+
+    def catalog(self) -> dict:
+        if self.source.source_type == "duckdb":
+            from . import duckdb_native
+
+            with self._connection() as connection:
+                return duckdb_native.catalog(connection, self.source.source_id)
+
+        def _datasets_on(conn):
+            if self._is_warehouse_source():
+                views = [view for view, _ in self._datasets()]
+                return views + self._materialized(conn)
+            return [view for view, _ in self._datasets()]
+
+        if self._is_warehouse_source():
+            names = self._with_warehouse(_datasets_on)
+        else:
+            names = [view for view, _ in self._datasets()]
+        # 文件源没有 schema，使用 schema=None，
+        # 由 build_catalog 派生出单组 schemas 视图供前端复用同一套渲染。
+        return build_catalog(
+            source_id=self.source.source_id,
+            engine=self.engine,
+            datasets=[
+                {
+                    "name": name,
+                    "schema": None,
+                    "type": "file",
+                    "format": self.source.source_type,
+                }
+                for name in names
+            ],
+        )
+
+    def batch_stats(self) -> dict[str, dict]:
+        """建全部视图后逐个 DESCRIBE + COUNT(*)，返回 {view/table: {columns, row_count}}。
+
+        供 DAO list_tables 批量取列数与行数——避免 N 次桥接调用、每次重建 N 个
+        视图的 O(N²)（CREATE VIEW read_csv_auto 创建时即嗅探文件）。
+        warehouse 源额外合并库内物化表（dwd/dws/ads 分层落地形态）。
+        """
+        if self.source.source_type == "duckdb":
+            from . import duckdb_native
+
+            with self._connection() as connection:
+                return duckdb_native.batch_stats(connection, self.source.source_id)
+        if self._is_warehouse_source():
+            return self._with_warehouse(self._batch_stats_on)
+        with self._connection() as connection:
+            self._prepare(connection)
+            return self._batch_stats_on(connection)
+
+    def _batch_stats_on(self, connection) -> dict[str, dict]:
+        stats: dict[str, dict] = {}
+        names = [view for view, _ in self._datasets()]
+        if self._is_warehouse_source():
+            names += self._materialized(connection)
+        for name in names:
+            columns = [
+                {"name": row[0], "type": row[1], "nullable": True, "default": None}
+                for row in connection.execute(f'DESCRIBE "{name}"').fetchall()
+            ]
+            count = connection.execute(f'SELECT COUNT(*) FROM "{name}"').fetchone()
+            stats[name] = {"columns": columns, "row_count": int(count[0] or 0)}
+        return stats
+
+    def schema(self, dataset: str, schema_name: str | None = None) -> dict:
+        if self.source.source_type == "duckdb":
+            from . import duckdb_native
+
+            with self._connection() as connection:
+                return duckdb_native.schema(connection, self.source.source_id, dataset, schema_name)
+        if self._is_warehouse_source():
+            def _describe(conn):
+                if dataset not in self._all_datasets(conn):
+                    raise ConnectorError("dataset is not registered for this source")
+                return conn.execute(f'DESCRIBE "{dataset}"').fetchall()
+
+            rows = self._with_warehouse(_describe)
+        else:
+            valid = {view for view, _ in self._datasets()}
+            if dataset not in valid:
+                raise ConnectorError("dataset is not registered for this source")
+            with self._connection() as connection:
+                self._prepare(connection)
+                rows = connection.execute(f'DESCRIBE "{dataset}"').fetchall()
+        # DuckDB DESCRIBE: column_name / column_type / null / key / default / extra。
+        # 读取实际 null/key 属性，保留 warehouse 物化表的可空和主键约束。
+        return build_schema(
+            source_id=self.source.source_id,
+            dataset=dataset,
+            columns=[
+                {
+                    "name": row[0],
+                    "type": row[1],
+                    "nullable": str(row[2]).upper() != "NO" if len(row) > 2 else True,
+                    "default": row[4] if len(row) > 4 else None,
+                    "pk": str(row[3] or "").upper() == "PRI" if len(row) > 3 else False,
+                }
+                for row in rows
+            ],
+        )
+
+    def preview(self, dataset: str, limit: int = 100) -> dict:
+        if self.source.source_type == "duckdb":
+            from . import duckdb_native
+
+            with self._connection() as connection:
+                item = duckdb_native.resolve_dataset(connection, dataset)
+            return self.query(f"SELECT * FROM {duckdb_native.quoted_dataset(item)}", limit=limit)
+
+        def _check(conn):
+            if dataset not in self._all_datasets(conn):
+                raise ConnectorError("dataset is not registered for this source")
+
+        if self._is_warehouse_source():
+            self._with_warehouse(_check)
+        else:
+            valid = {view for view, _ in self._datasets()}
+            if dataset not in valid:
+                raise ConnectorError("dataset is not registered for this source")
+        return self.query(f'SELECT * FROM "{dataset}"', limit=limit)
+
+    def query(self, sql: str, params=None, limit: int = 100) -> dict:
+        query = validate_read_only_sql(sql, source_type="duckdb")
+        safe_limit = max(1, min(int(limit), 10_000))
+        started = time.monotonic()
+        if self._is_warehouse_source():
+            return self._with_warehouse(
+                lambda conn: self._query_on(conn, query, params, safe_limit, started)
+            )
+        with self._connection() as connection:
+            self._prepare(connection)
+            return self._query_on(connection, query, params, safe_limit, started)
+
+    def _query_on(self, connection, query, params, safe_limit, started) -> dict:
+        result = connection.execute(query, params or [])
+        rows = result.fetchmany(safe_limit + 1)
+        columns = [item[0] for item in result.description]
+        truncated = len(rows) > safe_limit
+        rows = rows[:safe_limit]
+        return {
+            "ok": True,
+            "source_id": self.source.source_id,
+            "engine": self.engine,
+            "columns": columns,
+            "rows": [list(row) for row in rows],
+            "row_count": len(rows),
+            "truncated": truncated,
+            "elapsed_ms": int((time.monotonic() - started) * 1000),
+        }
+
+    def execute_write(self, sql: str) -> dict:
+        """ETL 物化写入（CTAS/INSERT/DROP/ALTER/TRUNCATE/COPY TO）。
+
+        warehouse 源（excel 目录/单文件/glob）：语句经 parse_write_sql
+        白名单校验；目标表名撞当前文件视图名时拒绝（TEMP VIEW 会遮蔽
+        同名物化表，导致"建表成功但查到的是文件"）；COPY 目标路径限制在
+        allowed_roots ∪ 源目录内并重写为绝对路径。
+
+        csv 目录源：走 _execute_write_dir——产物 csv 落源目录（被
+        _datasets() 实时 glob 发现），manifest 清单区分源文件与产物，
+        防止 ETL 误覆盖/误删源数据。
+        """
+        if self.source.source_type == "duckdb":
+            raise ConnectorError("native DuckDB database sources are read-only")
+        if self._is_csv_dir_source():
+            return self._execute_write_dir(sql)
+        if not self._is_warehouse_source():
+            raise ConnectorError(
+                "write operations require a local csv source (directory/file/glob)"
+            )
+        stmt = parse_write_sql(sql)
+        target = self._write_target_table(stmt)
+        started = time.monotonic()
+
+        def _run(conn):
+            view_names = {view for view, _ in self._datasets()}
+            if target and target in view_names:
+                raise ConnectorError(
+                    f"table name {target!r} conflicts with a source file view; "
+                    "choose another name"
+                )
+            final_sql = self._rewrite_copy_path(stmt, conn)
+            result = conn.execute(final_sql)
+            affected = None
+            if result is not None and result.description is not None:
+                row = result.fetchone()
+                if row is not None:
+                    affected = int(row[0]) if row[0] is not None else None
+            return {
+                "ok": True,
+                "affected_rows": affected,
+                "elapsed_ms": int((time.monotonic() - started) * 1000),
+            }
+
+        return self._with_warehouse(_run)
+
+    # ------------------------------------------------------------------
+    # csv 目录源写路径：:memory: 执行 + 产物 csv 落源目录 + manifest 保护
+    # ------------------------------------------------------------------
+
+    def _execute_write_dir(self, sql: str) -> dict:
+        stmt = parse_write_sql(sql)
+        directory = self._source_dir()
+        if directory is None:  # _is_csv_dir_source 已保证非 None，防御重复判定
+            raise ConnectorError("write operations require a csv directory source")
+        started = time.monotonic()
+        exp = _exp_classes()
+        is_copy = isinstance(stmt, exp.Copy)
+        is_create = isinstance(stmt, exp.Create)
+        # COPY 不动 manifest；其余语句的判定+落盘要在目录锁内做原子快照，
+        # 否则并行节点读到的 manifest 会互相覆盖丢条目
+        if is_copy:
+            with self._connection() as connection:
+                self._prepare(connection)
+                result = self._dir_write_copy(stmt, connection)
+            result["elapsed_ms"] = int((time.monotonic() - started) * 1000)
+            return result
+        with _etl_manifest_lock(directory):
+            manifest = _etl_manifest_load(directory)
+            if is_create:
+                # 上次运行 CTAS 落盘成功但 manifest 写入失败的孤儿产物：
+                # 数仓 layer 前缀的表收编回 manifest，重跑才不会把产物
+                # 误当源文件保护而拒绝重建
+                self._dir_adopt_orphans(directory, manifest)
+            with self._connection() as connection:
+                self._prepare(connection)
+                if is_create:
+                    result = self._dir_write_create(stmt, connection, directory, manifest)
+                elif isinstance(stmt, exp.Drop):
+                    result = self._dir_write_drop(stmt, directory, manifest)
+                elif isinstance(stmt, exp.TruncateTable):
+                    result = self._dir_write_truncate(stmt, connection, directory, manifest)
+                else:  # INSERT / ALTER
+                    result = self._dir_write_mutate(stmt, connection, directory, manifest)
+        result["elapsed_ms"] = int((time.monotonic() - started) * 1000)
+        return result
+
+    _DW_LAYER_PREFIXES = ("ods_", "dwd_", "dws_", "ads_", "dim_")
+
+    def _dir_adopt_orphans(self, directory: Path, manifest: dict) -> None:
+        """目录里带 layer 前缀但不在 manifest 的 csv → 收编为 ETL 产物。
+
+        只信 layer 前缀（数仓分层命名规约），无前缀的未知 csv 仍按源文件
+        保护——收编错了会放开对真实源数据的写权限，宁缺勿滥。
+        """
+        known = {entry.get("file") for entry in manifest["tables"].values()}
+        changed = False
+        for file in sorted(directory.glob("*.csv")):
+            if file.name in known:
+                continue
+            table = file.stem
+            if not table.lower().startswith(self._DW_LAYER_PREFIXES):
+                continue
+            if _view_name_for_stem(table) != table:
+                continue
+            manifest["tables"][table] = {
+                "file": file.name,
+                "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
+                "adopted": True,
+            }
+            changed = True
+        if changed:
+            _etl_manifest_save(directory, manifest)
+
+    def _dir_etl_target(self, stmt) -> str:
+        target = self._write_target_table(stmt)
+        if not target:
+            raise ConnectorError("write statement requires a target table name")
+        return target
+
+    def _dir_check_target_writable(self, target: str, manifest: dict) -> None:
+        """目标必须是新名或已有 ETL 产物；撞源文件视图一律拒绝。"""
+        if _view_name_for_stem(target) != target:
+            raise ConnectorError(
+                f"table name {target!r} cannot map to a csv file name "
+                "(ASCII letters/digits/underscore, leading letter required)"
+            )
+        if target in manifest["tables"]:
+            return
+        view_names = {view for view, _ in self._datasets()}
+        if target in view_names:
+            raise ConnectorError(
+                f"table name {target!r} conflicts with a source file view; "
+                "choose another name"
+            )
+
+    @staticmethod
+    def _dir_require_etl_table(target: str, manifest: dict) -> None:
+        """DROP/TRUNCATE/INSERT/ALTER 只允许作用于 ETL 产物（manifest 内）。"""
+        if target not in manifest["tables"]:
+            raise ConnectorError(
+                f"table {target!r} is not an ETL output (not in manifest); "
+                "source files cannot be modified"
+            )
+
+    def _dir_export_csv(self, connection, table: str, target_file: Path, *, empty: bool = False) -> int:
+        """整表导出 csv（tmp + os.replace 原子落盘），返回行数。
+
+        empty=True 只导 header（TRUNCATE 语义）。
+        """
+        directory = target_file.parent
+        tmp = directory / f".{target_file.name}.tmp"
+        escaped = str(tmp).replace("'", "''")
+        condition = " WHERE false" if empty else ""
+        try:
+            count = connection.execute(
+                f'COPY (SELECT * FROM "{table}"{condition}) TO \'{escaped}\' '
+                "(HEADER, DELIMITER ',')"
+            ).fetchone()
+            os.replace(tmp, target_file)
+        finally:
+            if tmp.exists():
+                tmp.unlink()
+        return int(count[0] or 0) if count else 0
+
+    def _dir_write_copy(self, stmt, connection) -> dict:
+        final_sql = self._rewrite_copy_path(stmt, connection)
+        result = connection.execute(final_sql)
+        affected = None
+        if result is not None and result.description is not None:
+            row = result.fetchone()
+            if row is not None:
+                affected = int(row[0]) if row[0] is not None else None
+        return {"ok": True, "affected_rows": affected}
+
+    def _dir_write_create(self, stmt, connection, directory: Path, manifest: dict) -> dict:
+        target = self._dir_etl_target(stmt)
+        self._dir_check_target_writable(target, manifest)
+        # DDL 节点先建表导出了 csv（或上次运行遗留），本连接 _prepare 会把它
+        # 挂成 TEMP VIEW——先 DROP 才能建同名表，否则 Catalog Error:
+        # Existing object is of type View, trying to replace with type Table
+        connection.execute(f'DROP VIEW IF EXISTS "{target}"')
+        connection.execute(stmt.sql(dialect="duckdb"))
+        row_count = self._dir_export_csv(connection, target, directory / f"{target}.csv")
+        manifest["tables"][target] = {
+            "file": f"{target}.csv",
+            "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
+        }
+        _etl_manifest_save(directory, manifest)
+        return {"ok": True, "affected_rows": row_count}
+
+    def _dir_write_drop(self, stmt, directory: Path, manifest: dict) -> dict:
+        target = self._dir_etl_target(stmt)
+        self._dir_require_etl_table(target, manifest)
+        (directory / f"{target}.csv").unlink(missing_ok=True)
+        del manifest["tables"][target]
+        _etl_manifest_save(directory, manifest)
+        return {"ok": True, "affected_rows": None}
+
+    def _dir_write_truncate(self, stmt, connection, directory: Path, manifest: dict) -> dict:
+        target = self._dir_etl_target(stmt)
+        self._dir_require_etl_table(target, manifest)
+        target_file = directory / f"{target}.csv"
+        self._dir_export_csv(connection, target, target_file, empty=True)
+        return {"ok": True, "affected_rows": 0}
+
+    def _dir_write_mutate(self, stmt, connection, directory: Path, manifest: dict) -> dict:
+        """INSERT/ALTER：影子表承接变更后整表重导出（csv 无增量追加形态）。
+
+        ALTER ... RENAME TO 额外处理：新名写 manifest + 文件改名，旧键删除。
+        """
+        from sqlglot import exp
+
+        target = self._dir_etl_target(stmt)
+        self._dir_require_etl_table(target, manifest)
+        shadow = f"_etl_shadow_{target}"
+        connection.execute(
+            f'CREATE OR REPLACE TEMP TABLE "{shadow}" AS SELECT * FROM "{target}"'
+        )
+        shadow_stmt = stmt.copy()
+        _retarget_statement(shadow_stmt, shadow)
+        result = connection.execute(shadow_stmt.sql(dialect="duckdb"))
+        inserted = None
+        if result is not None and result.description is not None:
+            row = result.fetchone()
+            if row is not None and row[0] is not None:
+                inserted = int(row[0])
+        new_name = target
+        if isinstance(stmt, exp.Alter):
+            rename_to = _alter_rename_to(stmt)
+            if rename_to:
+                new_name = rename_to
+                self._dir_check_target_writable(new_name, manifest)
+        # ALTER RENAME 的影子语句会把影子表改名成 new_name，导出源随之一致
+        export_source = shadow if new_name == target else new_name
+        row_count = self._dir_export_csv(connection, export_source, directory / f"{new_name}.csv")
+        if new_name != target:
+            (directory / f"{target}.csv").unlink(missing_ok=True)
+            del manifest["tables"][target]
+        manifest["tables"][new_name] = {
+            "file": f"{new_name}.csv",
+            "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
+        }
+        _etl_manifest_save(directory, manifest)
+        return {"ok": True, "affected_rows": inserted if inserted is not None else row_count}
+
+    def _write_target_table(self, stmt) -> str | None:
+        """写入语句的目标表名（COPY/无目标场景返回 None）。"""
+        from sqlglot import exp
+
+        if isinstance(stmt, exp.Copy):
+            return None
+        if isinstance(stmt, exp.TruncateTable):
+            targets = stmt.args.get("expressions") or []
+            return targets[0].name if targets else None
+        if isinstance(stmt, exp.Drop):
+            # sqlglot 各版本对 DROP 表名位置不一致：有的放 this（Identifier），
+            # 有的放 args["tables"]（多表）——两处都看
+            targets = stmt.args.get("tables") or []
+            if targets:
+                return targets[0].name
+            return stmt.this.name if stmt.this is not None else None
+        if isinstance(stmt, exp.Create):
+            if isinstance(stmt.this, exp.Schema) and stmt.this.this is not None:
+                return stmt.this.this.name
+            return stmt.this.name if stmt.this is not None else None
+        if isinstance(stmt, (exp.Insert, exp.Alter)):
+            this = stmt.this
+            if this is None:
+                return None
+            # INSERT INTO t (cols) ...：sqlglot 把目标包在 Schema(this=Table) 里
+            if isinstance(this, exp.Schema):
+                this = this.this
+            return this.name if this is not None else None
+        return None
+
+    def _rewrite_copy_path(self, stmt, connection) -> str:
+        """COPY TO 目标路径校验 + 绝对化，其余语句原样重生成。"""
+        from sqlglot import exp
+
+        if not isinstance(stmt, exp.Copy):
+            return stmt.sql(dialect="duckdb")
+        files = stmt.args.get("files") or []
+        if not files:
+            raise ConnectorError("COPY ... TO requires a target file path")
+        raw = files[0].this if isinstance(files[0], exp.Literal) else str(files[0])
+        if not raw:
+            raise ConnectorError("COPY ... TO requires a target file path")
+        allowed = self._copy_allowed_dirs()
+        candidate = Path(raw).expanduser()
+        if not candidate.is_absolute():
+            # DuckDB 按 CWD 解析相对路径——先校验再绝对化，防写到工作目录
+            for base in allowed:
+                guess = (base / candidate).resolve()
+                if self._path_in_roots(guess, allowed):
+                    candidate = guess
+                    break
+            else:
+                raise ConnectorError(
+                    f"COPY target path is outside allowed directories: {raw}"
+                )
+        if not self._path_in_roots(candidate.resolve(), allowed):
+            raise ConnectorError(f"COPY target path is outside allowed directories: {raw}")
+        stmt.args["files"] = [exp.Literal.string(str(candidate.resolve()))]
+        return stmt.sql(dialect="duckdb")
+
+    def _copy_allowed_dirs(self) -> list[Path]:
+        """COPY 目标允许的根：数据沙箱 roots ∪ 源目录（含单文件父目录）。"""
+        from .paths import allowed_roots
+
+        dirs = list(allowed_roots())
+        directory = self._source_dir()
+        if directory is None:
+            location = self._location()
+            if "://" not in location:
+                dirs.append(Path(location).expanduser().resolve().parent)
+        else:
+            dirs.append(directory)
+        return dirs
+
+    @staticmethod
+    def _path_in_roots(path: Path, roots: list[Path]) -> bool:
+        resolved = Path(path).resolve()
+        return any(
+            resolved == root or root in resolved.parents for root in roots
+        )
