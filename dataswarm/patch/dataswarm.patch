+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""metrics/embedding.py —— EMB 向量召回通道（增补设计 D3）。
+
+平台 embed 客户端（``agents/harness/common/memory/embeddings.py`` + ``embed:``
+配置段）是**唯一**向量来源；未配置时通道关闭并记 ``emb_unavailable``，剩余
+通道照常工作（D3 降级纪律）。本模块只做三件事：
+
+1. **同步桥**：``embed_texts`` 把 async provider 包成同步调用。每次调用新建
+   provider 并 ``asyncio.run`` 开新 loop——provider 内部 ``httpx.AsyncClient``
+   绑定首个 loop，跨 loop 复用会 Connection error（同 :mod:`.llm` 的陷阱）。
+2. **按 scope 的向量缓存**：schema 按 ``snapshot_id``、指标按 ``release_id``
+   （增补设计 §6「embed 一次召回多次」）。缓存是**增量**的：逐条比对文档哈希，
+   只重嵌变更项；``model``/``dims`` 变化则整份作废（向量空间不同不可比）。
+3. **余弦校准**：把余弦映射到与词法分同刻度（0~1），使 D9 的 0.60 阈值在
+   「词法 + EMB 取 max」后仍然有意义。
+
+校准常量来自真实端点实测（``BAAI/bge-m3``，1024 维，本仓库 demo 语料，
+复现脚本 ``scripts/verify_metrics_emb_calibration.py``）：
+
+===========================  =========  ==========================
+语料形态                      off-topic   真语义命中
+===========================  =========  ==========================
+富文档（comment+同义词）       ≤0.401     0.62 ~ 0.79
+列名+中文业务名                ≤0.417     0.68 ~ 0.76
+裸列名（CSV 库无注释）         ≤0.478     0.54 ~ 0.70
+===========================  =========  ==========================
+
+``EMB_SIM_FLOOR=0.50`` 取三档里 off-topic 的上界（0.478）之上，保证无关问题
+（「今天天气怎么样」）在任何语料形态下都拿不到 EMB 分；``EMB_SIM_CEIL=0.85``
+使强命中（≥0.71）映射到 ≥0.60 从而能单独越过澄清阈值。**推论（已实测）**：
+EMB 通道的收益与 catalog 注释丰富度成正比——无注释的裸列名库里，真命中只有
+0.54 左右，EMB 只能贡献排序信号，跨阈值仍要靠词法或补列注释。
+
+脱敏红线：缓存文件只存**业务语义词**（指标名/同义词/描述/单位、表列名与
+注释），绝不存表达式原文、连接串、查询结果——与语义图同一纪律。
+"""
+from __future__ import annotations
+
+import asyncio
+import dataclasses
+import json
+import logging
+import os
+import threading
+import time
+from collections import OrderedDict
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Sequence
+
+from . import store
+from .model import sha256_of
+
+logger = logging.getLogger(__name__)
+
+# --------------------------------------------------------------------------
+# 校准与限额（依据见模块 docstring）
+# --------------------------------------------------------------------------
+EMB_SIM_FLOOR = 0.50
+EMB_SIM_CEIL = 0.85
+# 短语向量的 floor 更高：文本越短相似度噪声越大。实测（多向量模式负对照）
+# 整句 floor 0.50 时，「怎么申请年假」的**短语**向量能把无关文档顶到余弦
+# 0.597（校准 0.28）；短语 floor 提到 0.60 后三个负对照全部归零，而真命中
+# （0.685~0.814）不受影响。
+EMB_PHRASE_FLOOR = 0.60
+EMB_TOP_K = 8            # 每个 scope 回传的命中上限
+EMB_BATCH = 32           # 单次 HTTP 请求的文本条数
+EMB_MAX_DOCS = 800       # 单个 scope 参与嵌入的文档上限（超出按 key 排序截断）
+EMB_TIMEOUT_S = 20       # 单次批量调用硬超时
+
+# 多向量查询（抗语义稀释）：整句 + 语义短语一起嵌入，逐文档取最大余弦。
+# 实测整句嵌入的稀释：同一指标，「客单价」EMB 0.53，「2026年8月各地区支付
+# 客单价」掉到 0.12——日期+地区+指标混进一个向量被摊薄。
+# 短语用 jieba 切（正式依赖，单路径）；**相邻 token 连缀是必须的**——jieba
+# 默认词典把「客单价」切成「客」+「单价」（实测），只取单词拼不回来。
+# 垃圾短语（「月各」「渠道的」）由校准 floor 兜底，floor 是否仍有效由
+# scripts/verify_metrics_emb_calibration.py 的负对照实测把关。
+_QUERY_PHRASE_CAP = 24
+_JIEBA_STOPWORDS = frozenset({
+    "的", "了", "吗", "呢", "啊", "有", "哪些", "有哪些", "什么", "多少",
+    "怎么", "怎样", "几", "各", "按", "在", "从", "到", "和", "与", "或",
+    "请", "帮", "我", "你", "他", "她", "它", "一下", "这个", "那个",
+    "是", "对", "给", "被", "把", "下", "上", "里", "中", "一下",
+})
+
+# 警告码（进 Catalog.warnings，与 schema_unavailable 等同级）
+WARN_UNAVAILABLE = "emb_unavailable"
+WARN_DOCS_CAPPED = "emb_docs_capped"
+WARN_INDEX_EMPTY = "emb_index_empty"
+
+EMB_ENABLED_ENV = "DATASWARM_METRICS_EMB_ENABLED"
+EMB_FLOOR_ENV = "DATASWARM_METRICS_EMB_SIM_FLOOR"
+EMB_CEIL_ENV = "DATASWARM_METRICS_EMB_SIM_CEIL"
+EMB_PHRASE_FLOOR_ENV = "DATASWARM_METRICS_EMB_PHRASE_FLOOR"
+_EMB_DIR_ENV = "DATASWARM_METRICS_EMB_DIR"
+
+
+# ==========================================================================
+# 可用性
+# ==========================================================================
+def embed_settings() -> dict[str, str]:
+    """平台 embed 三项配置（api_key/base_url/model）。
+
+    为什么不只用 ``get_embed_config()``：**web 进程默认不加载 ``config/.env``**
+    ——``channels/web/app_web.py`` 只在传 ``--dotenv``/``--name`` 时加载，于是
+    ``config.yaml`` 里 ``${EMBED_API_BASE}`` 这类占位符解析成空串，
+    ``is_embed_configured()`` 判 False，EMB 通道在标准 dev/部署形态下会静默
+    关闭（实测：同一份代码在 gateway 进程可用、在 app_web 进程不可用）。
+
+    这里按平台**同一优先级**（env > config.yaml）补读 ``.env`` 文件里的三项，
+    用 ``dotenv_values`` 只读不写——绝不改 ``os.environ``，避免影响 web 进程
+    里其他读占位符的配置。平台侧若统一了 .env 加载，本函数自动退回纯平台值。
+    """
+    cfg: dict[str, str] = {}
+    try:
+        from jiuwenswarm.agents.harness.common.knowledge_base.config import (
+            get_embed_config,
+        )
+
+        cfg = {k: str(v or "") for k, v in get_embed_config().items()}
+    except Exception:  # noqa: BLE001 —— 平台配置读不到就走文件补读
+        cfg = {"api_key": "", "base_url": "", "model": ""}
+    if cfg.get("api_key") and cfg.get("base_url") and cfg.get("model"):
+        return cfg
+
+    values: dict[str, str] = {}
+    try:
+        from dotenv import dotenv_values
+
+        from jiuwenswarm.common.utils import get_env_file
+
+        env_file = get_env_file()
+        if env_file.is_file():
+            values = {str(k): str(v or "") for k, v in dotenv_values(env_file).items()}
+    except Exception:  # noqa: BLE001 —— 补读失败即维持平台判定（通道关闭）
+        values = {}
+    return {
+        "api_key": (cfg.get("api_key") or os.getenv("EMBED_KEY")
+                    or os.getenv("EMBED_API_KEY")
+                    or values.get("EMBED_API_KEY") or values.get("EMBED_KEY") or ""),
+        "base_url": (cfg.get("base_url") or os.getenv("EMBED_BASE")
+                     or os.getenv("EMBED_BASE_URL")
+                     or values.get("EMBED_BASE") or values.get("EMBED_API_BASE")
+                     or values.get("EMBED_BASE_URL") or ""),
+        "model": (cfg.get("model") or os.getenv("EMBED_MODEL")
+                  or os.getenv("EMBEDDING_MODEL")
+                  or values.get("EMBED_MODEL") or values.get("EMBEDDING_MODEL") or ""),
+    }
+
+
+def emb_available() -> bool:
+    """EMB 通道是否可用（显式关闭 > 配置不全）。
+
+    Returns:
+        True 仅当未被 ``DATASWARM_METRICS_EMB_ENABLED=false`` 关闭，且
+        api_key/base_url/model 三项齐备。
+    """
+    if os.environ.get(EMB_ENABLED_ENV, "true").strip().lower() in ("false", "0", "no"):
+        return False
+    settings = embed_settings()
+    return bool(settings.get("api_key") and settings.get("base_url") and settings.get("model"))
+
+
+def emb_model() -> str:
+    """当前配置的 embed 模型名（缓存有效性判定用；读不到返回空串）。"""
+    return str(embed_settings().get("model") or "")
+
+
+def emb_root(workspace_id: str) -> Path:
+    """EMB 缓存目录：``<root>/<workspace_id>``（root 默认 ``data/metrics/emb``）。
+
+    深集成后脱离 pyoxigraph 图根目录（``DATASWARM_METRICS_GRAPH_ROOT`` 已随
+    验证版退役），对齐语义层向量索引的目录形态（``data/semantic/vectors``）；
+    ``DATASWARM_METRICS_EMB_DIR`` 可整体搬迁。缓存可重建（惰性重嵌）。
+    """
+    root = os.environ.get(_EMB_DIR_ENV) or str(
+        Path.cwd() / "data" / "metrics" / "emb")
+    return Path(root).expanduser() / workspace_id
+
+
+# ==========================================================================
+# 同步桥：embed 调用
+# ==========================================================================
+@dataclass(frozen=True)
+class EmbedOutcome:
+    """一次批量嵌入的结果。
+
+    ``error`` 非空即失败（``vectors`` 为空）；调用方据此记 warning 并降级，
+    **绝不**把失败当成「没有相似项」。``texts`` 与 ``vectors`` 逐位对应，
+    多向量查询的胜出索引靠它归因回原文。
+    """
+
+    vectors: tuple[tuple[float, ...], ...] = ()
+    error: str = ""
+    model: str = ""
+    dims: int = 0
+    texts: tuple[str, ...] = ()
+
+    @property
+    def ok(self) -> bool:
+        """是否成功拿到向量。"""
+        return not self.error and bool(self.vectors)
+
+
+async def _embed_async(texts: Sequence[str], timeout_s: int) -> EmbedOutcome:
+    """在**当前**（新建的）事件循环里跑一次批量嵌入。"""
+    from jiuwenswarm.agents.harness.common.memory.embeddings import (
+        OpenAICompatibleEmbeddingProvider,
+    )
+
+    # 用平台 embed 客户端，但三项配置由 embed_settings() 显式解析后传入：
+    # provider 自己的 env/config 兜底在 web 进程里读到的是空值（见 embed_settings）
+    settings = embed_settings()
+    provider = OpenAICompatibleEmbeddingProvider(
+        api_key=settings["api_key"], model=settings["model"], base_url=settings["base_url"])
+    vectors: list[list[float]] = []
+    for start in range(0, len(texts), EMB_BATCH):
+        batch = list(texts[start:start + EMB_BATCH])
+        got = await asyncio.wait_for(provider.embed_documents(batch), timeout=timeout_s)
+        if len(got) != len(batch):
+            raise RuntimeError(f"embed 返回条数不符: 期望 {len(batch)} 实得 {len(got)}")
+        vectors.extend(got)
+    dims = len(vectors[0]) if vectors and vectors[0] else 0
+    return EmbedOutcome(
+        vectors=tuple(tuple(v) for v in vectors),
+        model=str(getattr(provider, "model", "") or ""),
+        dims=dims,
+    )
+
+
+def embed_texts(texts: Sequence[str], *, timeout_s: int = EMB_TIMEOUT_S) -> EmbedOutcome:
+    """批量嵌入（同步入口）。失败返回带 ``error`` 的空结果，**不抛异常**。
+
+    Args:
+        texts: 待嵌入文本；空列表直接返回空结果（不发请求）。
+        timeout_s: 单批硬超时。
+
+    Returns:
+        :class:`EmbedOutcome`。``error`` 形如 ``emb_unavailable`` /
+        ``emb_failed:RuntimeError``。
+    """
+    if not texts:
+        return EmbedOutcome(error=WARN_INDEX_EMPTY)
+    if not emb_available():
+        return EmbedOutcome(error=WARN_UNAVAILABLE)
+    try:
+        # 每次新建 loop + 新建 provider：httpx client 绑首个 loop（见 docstring）
+        outcome = asyncio.run(_embed_async(list(texts), timeout_s))
+        return dataclasses.replace(outcome, texts=tuple(texts))
+    except Exception as exc:  # noqa: BLE001 —— 降级契约：永不抛
+        logger.warning("[metrics.embedding][warn] 嵌入失败: %s: %s", type(exc).__name__, exc)
+        return EmbedOutcome(error=f"emb_failed:{type(exc).__name__}")
+
+
+def cosine(a: Sequence[float], b: Sequence[float]) -> float:
+    """余弦相似度；维度不等或零向量返回 0.0。"""
+    if len(a) != len(b) or not a:
+        return 0.0
+    from jiuwenswarm.agents.harness.common.memory.internal import cosine_similarity
+
+    return float(cosine_similarity(list(a), list(b)))
+
+
+def calibrate(cos: float, *, floor: float | None = None) -> float:
+    """余弦 → 与词法分同刻度的 0~1 分（低于 floor 直接归零）。
+
+    为什么要校准：bge-m3 对无关文本也给 0.3~0.48 的余弦，直接当分数会让
+    D9 的 0.60 澄清阈值形同虚设。映射取实测分布（模块 docstring 表）。
+
+    Args:
+        cos: 原始余弦。
+        floor: 归零下界；None 用整句默认值。短语向量应传更高的
+            ``EMB_PHRASE_FLOOR``（短文本噪声大，见常量注释）。
+
+    floor/ceil 可用 ``DATASWARM_METRICS_EMB_SIM_FLOOR`` / ``_CEIL`` /
+    ``_PHRASE_FLOOR`` 覆盖——常量是**模型相关**的，换 embed 模型后按
+    ``scripts/verify_metrics_emb_calibration.py`` 的实测分布重设，不改代码。
+    """
+    whole_floor, ceil, phrase_floor = _sim_bounds()
+    use_floor = whole_floor if floor is None else floor
+    del phrase_floor  # 短语 floor 由 score_against 按向量位置传入
+    if cos <= use_floor:
+        return 0.0
+    span = ceil - use_floor
+    if span <= 0:
+        return 0.0
+    return max(0.0, min(1.0, (cos - use_floor) / span))
+
+
+def _sim_bounds() -> tuple[float, float, float]:
+    """读 (整句 floor, ceil, 短语 floor)（env 覆盖优先）；非法值退回默认并**大声**提示。"""
+    bounds = {"floor": EMB_SIM_FLOOR, "ceil": EMB_SIM_CEIL,
+              "phrase": EMB_PHRASE_FLOOR}
+    for name, key in ((EMB_FLOOR_ENV, "floor"), (EMB_CEIL_ENV, "ceil"),
+                      (EMB_PHRASE_FLOOR_ENV, "phrase")):
+        raw = os.environ.get(name, "").strip()
+        if not raw:
+            continue
+        try:
+            bounds[key] = float(raw)
+        except ValueError:
+            logger.warning("[metrics.embedding][warn] %s=%r 不是数字，用默认 %s", name, raw, bounds[key])
+    return bounds["floor"], bounds["ceil"], bounds["phrase"]
+
+
+def floors() -> tuple[float, float]:
+    """(整句 floor, 短语 floor)——env 覆盖优先，供逐查询向量选 floor 的调用方使用。
+
+    FAISS 召回侧（``semantic/vector_store``）逐查询向量调 :func:`calibrate`
+    时需要与 :func:`score_against` 同源的 floor 口径（含 env 覆盖），公开这个
+    只读入口；本模块内部仍走 ``_sim_bounds``。
+    """
+    whole, _ceil, phrase = _sim_bounds()
+    return whole, phrase
+
+
+def score_against(qvecs: Sequence[Sequence[float]],
+                  doc_vector: Sequence[float]) -> tuple[float, int, float]:
+    """查询向量组 vs 单文档：最大**校准分** + 胜出索引 + 胜出的原始余弦。
+
+    逐向量按位置选 floor（0 号=整句用 ``EMB_SIM_FLOOR``，其余短语用
+    ``EMB_PHRASE_FLOOR``）再取 max——多向量抗稀释与短语降噪在同一处完成。
+    """
+    whole_floor, _, phrase_floor = _sim_bounds()
+    best_score, best_idx, best_cos = 0.0, 0, 0.0
+    for idx, vector in enumerate(qvecs):
+        raw = cosine(vector, doc_vector)
+        score = calibrate(raw, floor=whole_floor if idx == 0 else phrase_floor)
+        if score > best_score:
+            best_score, best_idx, best_cos = score, idx, raw
+    return best_score, best_idx, best_cos
+
+
+# ==========================================================================
+# 按 scope 的向量索引与缓存
+# ==========================================================================
+@dataclass(frozen=True)
+class VectorEntry:
+    """一条文档向量。"""
+
+    key: str
+    doc_hash: str
+    vector: tuple[float, ...]
+
+
+@dataclass(frozen=True)
+class VectorIndex:
+    """一个 scope 的向量索引（缓存命中 + 本次新嵌入的合集）。"""
+
+    scope_id: str
+    model: str
+    dims: int
+    entries: tuple[VectorEntry, ...] = ()
+
+    def __len__(self) -> int:
+        return len(self.entries)
+
+
+def _cache_path(workspace_id: str, scope_id: str) -> Path:
+    # scope_id 含 snapshot/release id（形如 snapshot:src:run-x）——':' 在
+    # Windows 文件名非法，不替换则磁盘缓存永远写失败（warn 实证），每次
+    # 重启后全量重建字典向量（full-merge-1021 超时根因之一）。旧缓存文件
+    # 因写不进从未存在，替换无失配风险。
+    safe = scope_id.replace(":", "_")
+    return emb_root(workspace_id) / f"{safe}.json"
+
+
+# 进程内 memo：缓存文件是 JSON 浮点，实测 7 个节点 160KB（≈23KB/节点·1024 维），
+# 800 列的真实库约 18MB —— 每次召回 json.loads 一遍是秒级开销。命中条件用
+# 「scope + model + 文档集摘要」，文档或模型一变即失效，不存在读到旧向量的可能。
+_INDEX_MEMO: dict[tuple[str, str, str, str], VectorIndex] = {}
+_MEMO_MAX = 8            # memo 条目上限（超出整体清空，不做 LRU）
+# scope 粒度构建锁：慢路径（磁盘读+批量嵌入）串行化，防并发击穿——
+# 评测 10 并发同 scope 同时 miss 时曾同时全量 embed 同一批字典文本，
+# EMB 出站量 ×10 直接把 context 推过 30s（full-merge-1021 超时根因之一）。
+_SCOPE_LOCKS: dict[tuple[str, str], threading.Lock] = {}
+_SCOPE_LOCKS_GUARD = threading.Lock()
+
+
+def _scope_lock(workspace_id: str, scope_id: str) -> threading.Lock:
+    with _SCOPE_LOCKS_GUARD:
+        return _SCOPE_LOCKS.setdefault((workspace_id, scope_id), threading.Lock())
+_VECTOR_PRECISION = 6  # 落盘精度：余弦在 1e-6 上无差别，文件体积省近一半
+
+
+def _docs_digest(docs: Sequence[tuple[str, str]]) -> str:
+    """文档集摘要（键 + 各文档哈希），memo 命中判定用。"""
+    return sha256_of("|".join(f"{k}:{sha256_of(t)[:16]}" for k, t in docs))[:32]
+
+
+def _read_cache(workspace_id: str, scope_id: str, model: str) -> dict[str, VectorEntry]:
+    """读缓存；模型/维度不符或文件损坏一律当空（不作废别人，只重嵌自己）。"""
+    path = _cache_path(workspace_id, scope_id)
+    if not path.is_file():
+        return {}
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except Exception:  # noqa: BLE001 —— 缓存坏了重建，不阻断召回
+        return {}
+    if not isinstance(raw, dict) or raw.get("model") != model:
+        return {}
+    out: dict[str, VectorEntry] = {}
+    entries = raw.get("entries")
+    if not isinstance(entries, dict):
+        return {}
+    for key, item in entries.items():
+        if not isinstance(item, dict):
+            continue
+        vector = item.get("v")
+        doc_hash = str(item.get("h") or "")
+        if not isinstance(vector, list) or not vector or not doc_hash:
+            continue
+        out[str(key)] = VectorEntry(key=str(key), doc_hash=doc_hash,
+                                    vector=tuple(float(x) for x in vector))
+    return out
+
+
+def _write_cache(workspace_id: str, index: VectorIndex) -> None:
+    """原子写缓存（临时文件 + os.replace），失败只记 warning 不抛。"""
+    path = _cache_path(workspace_id, index.scope_id)
+    payload = {
+        "scope_id": index.scope_id,
+        "model": index.model,
+        "dims": index.dims,
+        "built_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
+        "entries": {e.key: {"h": e.doc_hash, "v": [round(x, _VECTOR_PRECISION) for x in e.vector]}
+                    for e in index.entries},
+    }
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = path.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
+        os.replace(tmp, path)
+    except OSError as exc:
+        logger.warning("[metrics.embedding][warn] 向量缓存写入失败: %s", exc)
+
+
+def load_or_build(
+    *, workspace_id: str, scope_id: str, docs: Sequence[tuple[str, str]],
+    warnings: list[str] | None = None,
+) -> VectorIndex | None:
+    """取（必要时构建）某 scope 的向量索引。
+
+    增量策略：缓存里 ``doc_hash`` 与当前文档一致的直接复用，只对缺失/变更的
+    文档发一次批量嵌入。构建失败（未配置/网络/余额）返回 None 并把原因写进
+    ``warnings``——调用方降级为无 EMB 通道，**不得**当成「无相似项」。
+
+    缓存的 ``model`` 键取**配置值**（:func:`emb_model`）而非 provider 回报值：
+    后者会因 env 与 config 的优先级差异抖动，抖动一次缓存就永不命中。
+
+    Args:
+        workspace_id: 工作空间。
+        scope_id: 缓存作用域（``schema-<snapshot_id>`` / ``metric-<release_id>``）。
+        docs: ``(key, text)`` 列表；key 须与图节点 ID 或 metric_key 一致。
+        warnings: 可选的警告收集列表（原地 append）。
+
+    Returns:
+        :class:`VectorIndex`；不可用/失败/无文档时为 None。
+    """
+    notes = warnings if warnings is not None else []
+    if not emb_available():
+        _note(notes, WARN_UNAVAILABLE)
+        return None
+    if not docs:
+        _note(notes, WARN_INDEX_EMPTY)
+        return None
+    if len(docs) > EMB_MAX_DOCS:
+        _note(notes, WARN_DOCS_CAPPED)
+        docs = sorted(docs, key=lambda kv: kv[0])[:EMB_MAX_DOCS]
+
+    model = emb_model()
+    digest = _docs_digest(docs)
+    memo_key = (workspace_id, scope_id, model, digest)
+    memo = _INDEX_MEMO.get(memo_key)
+    if memo is not None:
+        return memo  # 文档集与模型都没变：直接用进程内索引，不再解析缓存文件
+    # 慢路径（磁盘读 + 批量嵌入）按 scope 串行：快路径不进锁；拿到锁后
+    # double-check memo——等锁期间并发先行者可能已把索引建好。
+    with _scope_lock(workspace_id, scope_id):
+        memo = _INDEX_MEMO.get(memo_key)
+        if memo is not None:
+            return memo
+        cached = _read_cache(workspace_id, scope_id, model)
+        wanted = {k: t for k, t in docs}
+        missing: list[tuple[str, str]] = []
+        entries: list[VectorEntry] = []
+        for key, text in wanted.items():
+            doc_hash = sha256_of(text)[:32]
+            hit = cached.get(key)
+            if hit is not None and hit.doc_hash == doc_hash:
+                entries.append(hit)
+            else:
+                missing.append((key, text))
+
+        dims = next((len(e.vector) for e in entries), 0)
+        if missing:
+            outcome = embed_texts([t for _, t in missing])
+            if not outcome.ok:
+                _note(notes, outcome.error or WARN_UNAVAILABLE)
+                if not entries:
+                    return None
+                # 部分可用：只用缓存命中的部分，缺的下次再补（不写坏缓存）
+                return VectorIndex(scope_id=scope_id, model=model, dims=dims,
+                                   entries=tuple(entries))
+            dims = outcome.dims or dims
+            for (key, text), vector in zip(missing, outcome.vectors):
+                entries.append(VectorEntry(key=key, doc_hash=sha256_of(text)[:32],
+                                           vector=tuple(vector)))
+
+        index = VectorIndex(scope_id=scope_id, model=model, dims=dims,
+                            entries=tuple(sorted(entries, key=lambda e: e.key)))
+        if missing:
+            # 全命中时不重写：800 文档 ×1024 维的 JSON 每次召回重写一遍纯属浪费
+            _write_cache(workspace_id, index)
+        if len(_INDEX_MEMO) >= _MEMO_MAX:
+            _INDEX_MEMO.clear()  # 换 snapshot/release 会累积旧键，粗粒度清空即可
+        _INDEX_MEMO[memo_key] = index
+        return index
+
+
+# ==========================================================================
+# 多向量查询：整句 + 语义短语
+# ==========================================================================
+def _query_phrases(question: str) -> list[str]:
+    """问题 → 语义短语（jieba 分词 + 相邻 2/3 token 连缀）。
+
+    连缀必须作用在**原始相邻 token**上而不是过滤后的词列——jieba 把
+    「客单价」切成「客」+「单价」，先过滤单字再连缀就永远拼不回「客单价」。
+    日期片段（2026年 / 8月）与停用词整体丢弃；垃圾短语交给校准 floor。
+
+    Raises:
+        ImportError: jieba 未安装（环境破损，**大声**报而不是静默换切法）。
+    """
+    import re
+
+    import jieba  # type: ignore[import-untyped]  # jieba 无 py.typed/stub
+
+    dateish = re.compile(r"^[\d年月日时分秒./:，,\-]+$")
+
+    def _keep(phrase: str) -> bool:
+        return (len(phrase) >= 2 and phrase not in _JIEBA_STOPWORDS
+                and not phrase.isdigit() and not dateish.match(phrase))
+
+    units = [t for t in jieba.lcut(question or "") if t.strip()]
+    candidates: set[str] = set()
+    for token in units:
+        if _keep(token):
+            candidates.add(token)
+    for n in (2, 3):
+        for i in range(len(units) - n + 1):
+            joined = "".join(units[i:i + n])
+            if _keep(joined):
+                candidates.add(joined)
+    return sorted(candidates, key=lambda p: (-len(p), p))[:_QUERY_PHRASE_CAP]
+
+
+# 问句向量进程内缓存（F-048 ①）：一次 build_context 术语/指标/schema/维值
+# 四路对同一问句各调一次 query_vectors，远程嵌入 4~5s/次——同 (模型, 问句)
+# 只实算一次，后续命中直接复用。只缓存成功结果（失败不缓存，网络恢复后
+# 可重试）；超上限淘汰最旧条目。EmbedOutcome 全不可变字段，跨线程共享安全。
+_QUERY_VEC_CACHE: OrderedDict[tuple[str, str], EmbedOutcome] = OrderedDict()
+_QUERY_VEC_CACHE_LOCK = threading.Lock()
+_QUERY_VEC_CACHE_MAX = 64
+
+
+def query_vectors(question: str, *, timeout_s: int = EMB_TIMEOUT_S) -> EmbedOutcome:
+    """整句 + 语义短语 → 一批查询向量（一次批量嵌入调用，同问句进程内复用）。
+
+    首向量恒为整句原文（保底语义）；短语向量只在比整句更贴近某文档时
+    通过 rank 的逐文档取 max 发声——这正是抗稀释的机制。jieba 缺失时
+    记 ``emb_failed:ImportError`` 降级，不静默换切法。
+
+    缓存键 ``(模型, 问句)``：texts 是问句的纯函数，结果必然一致；并行
+    首算在锁外进行（不阻塞其他问句），同问句并发 miss 最多重复调用一次。
+    """
+    if not emb_available():
+        return EmbedOutcome(error=WARN_UNAVAILABLE)
+    key = (emb_model(), question)
+    with _QUERY_VEC_CACHE_LOCK:
+        cached = _QUERY_VEC_CACHE.get(key)
+        if cached is not None:
+            _QUERY_VEC_CACHE.move_to_end(key)
+            return cached
+    outcome = _query_vectors_uncached(question, timeout_s)
+    if outcome.ok:
+        with _QUERY_VEC_CACHE_LOCK:
+            _QUERY_VEC_CACHE[key] = outcome
+            while len(_QUERY_VEC_CACHE) > _QUERY_VEC_CACHE_MAX:
+                _QUERY_VEC_CACHE.popitem(last=False)
+    return outcome
+
+
+def _query_vectors_uncached(question: str, timeout_s: int) -> EmbedOutcome:
+    """query_vectors 的实算路径（整句 + jieba 短语一批嵌入）。"""
+    try:
+        phrases = _query_phrases(question)
+    except ImportError:
+        return EmbedOutcome(error="emb_failed:ImportError")
+    texts = [question] + [p for p in phrases if p != question]
+    return embed_texts(texts, timeout_s=timeout_s)
+
+
+def rank(index: VectorIndex, qvecs: Sequence[Sequence[float]], *,
+         limit: int = EMB_TOP_K) -> list[tuple[str, float, int]]:
+    """按校准分降序取 top-``limit``；floor 以下的直接丢弃。
+
+    Args:
+        index: 向量索引。
+        qvecs: 一个或多个查询向量（多向量查询：整句 + 短语）。逐文档取
+            **最大余弦**——短语向量只在比整句更贴近该文档时发声（抗稀释）。
+
+    Returns:
+        ``[(key, calibrated_score, winning_vector_index)]``：分数与词法分同刻度
+        可直接 max 合并；胜出索引用于归因（UI 展示「这个命中是哪个短语向量
+        赢的」，多向量行为才可被肉眼验证）。
+    """
+    vectors = list(qvecs)
+    if not index.entries or not vectors:
+        return []
+    scored: list[tuple[str, float, int]] = []
+    for entry in index.entries:
+        # 不过滤空向量：索引要与 outcome.texts 对齐，归因才不错位
+        score, win_idx, _raw = score_against(vectors, entry.vector)
+        if score > 0.0:
+            scored.append((entry.key, score, win_idx))
+    scored.sort(key=lambda ks: (-ks[1], ks[0]))
+    return scored[:limit]
+
+
+
+
+def _note(warnings: list[str], code: str) -> None:
+    if code and code not in warnings:
+        warnings.append(code)
+
+
+# ==========================================================================
+# 文档构建（两个 scope）
+# ==========================================================================
+def metric_docs(workspace_id: str) -> list[tuple[str, str]]:
+    """指标 scope 的文档：``metric_key -> 业务语义词``。
+
+    取每个指标当前 **published** 修订的名称/同义词/描述/单位——**不含表达式
+    原文**（脱敏红线）。archived 指标不参与。
+    """
+    docs: list[tuple[str, str]] = []
+    for metric, revision in store.list_effective_published(workspace_id):
+        parts = [
+            revision.display_name or metric.name,
+            metric.metric_key,
+            " ".join(revision.synonyms),
+            metric.description,
+            revision.unit,
+        ]
+        text = " ".join(p.strip() for p in parts if p and p.strip())
+        if text:
+            docs.append((metric.metric_key, text))
+    return docs
+
+
+# （schema scope 文档体系已随探查链路退役：深集成后 schema 侧 EMB 走语义层
+#  FAISS——semantic/vector_store.recall；本模块只服务 metric scope。）
+
+
+__all__ = [
+    "EMB_CEIL_ENV",
+    "EMB_ENABLED_ENV",
+    "EMB_FLOOR_ENV",
+    "EMB_SIM_CEIL",
+    "EMB_SIM_FLOOR",
+    "EmbedOutcome",
+    "VectorEntry",
+    "VectorIndex",
+    "WARN_DOCS_CAPPED",
+    "WARN_INDEX_EMPTY",
+    "WARN_UNAVAILABLE",
+    "calibrate",
+    "cosine",
+    "emb_available",
+    "emb_model",
+    "emb_root",
+    "embed_texts",
+    "floors",
+    "load_or_build",
+    "metric_docs",
+    "rank",
+]
