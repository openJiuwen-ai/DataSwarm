+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw-metrics skill CLI 单测（V2 契约）：参数组装/JSON 透传/path-mode/退出码。
+
+不打 web 服务——``_dwcli`` 打桩。方案：主方案 docs §阶段 6。
+"""
+from __future__ import annotations
+
+import csv
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+_SKILL_SCRIPT = (Path(__file__).resolve().parents[3]
+                 / "jiuwenswarm" / "resources" / "agent" / "workspace" / "skills"
+                 / "dw-metrics" / "scripts" / "metric_query.py")
+
+
+def _load_module():
+    spec = importlib.util.spec_from_file_location("metric_query", _SKILL_SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture(scope="module")
+def mq():
+    return _load_module()
+
+
+def _run_cmd(mq, monkeypatch, capsys, stub_response, argv: list[str]) -> tuple[int, dict]:
+    """打桩 dwcli → 跑 main → 返回 (退出码, stdout JSON)。"""
+    calls: list[tuple] = []
+
+    def fake_dwcli(args, *, json_body=None):
+        calls.append((tuple(args), json_body))
+        return stub_response(args, json_body=json_body) if callable(stub_response) \
+            else stub_response
+
+    monkeypatch.setattr(mq, "_dwcli", fake_dwcli)
+    rc = mq.main(argv)
+    out = json.loads(capsys.readouterr().out)
+    return rc, out
+
+
+# --------------------------------------------------------------------------
+# list / releases / health / queries：JSON 直出
+# --------------------------------------------------------------------------
+def test_list_compacts_to_cards(mq, monkeypatch, capsys):
+    payload = {"metrics": [
+        {"metric_key": "commerce.gmv", "name": "gmv", "status": "active",
+         "current_revision": {"display_name": "支付成交额", "unit": "CNY",
+                              "metric_type": "atomic"}},
+        {"metric_key": "commerce.x", "name": "x", "status": "draft",
+         "current_revision": None},
+    ]}
+    rc, out = _run_cmd(mq, monkeypatch, capsys, payload, ["list"])
+    assert rc == 0
+    assert out["count"] == 2
+    assert out["metrics"][0]["name"] == "支付成交额"
+    assert out["metrics"][0]["published"] is True
+    assert out["metrics"][1]["published"] is False
+
+
+def test_health_passthrough(mq, monkeypatch, capsys):
+    payload = {"enabled": True, "capabilities": {"sparql": True}}
+    rc, out = _run_cmd(mq, monkeypatch, capsys, payload, ["health"])
+    assert rc == 0 and out["enabled"] is True
+
+
+def test_queries_compacts_trace_rows(mq, monkeypatch, capsys):
+    payload = {"queries": [
+        {"query_id": "mq_1", "question": "8月客单价", "path": "compiler",
+         "authoritative": 1, "row_count": 3, "error_code": None,
+         "feedback": "none", "created_at": "2026-10-08T12:00:00"},
+    ]}
+    rc, out = _run_cmd(mq, monkeypatch, capsys, payload, ["queries", "--limit", "5"])
+    assert rc == 0
+    assert out["queries"][0]["authoritative"] is True
+    assert out["queries"][0]["error_code"] is None
+
+
+# --------------------------------------------------------------------------
+# query：结构化参数 → JSON body → path-mode CSV
+# --------------------------------------------------------------------------
+def test_query_builds_spec_body_and_writes_csv(mq, monkeypatch, capsys, tmp_path):
+    rows = [{"region": "east", "commerce_aov": 200}, {"region": "west", "commerce_aov": 200}]
+    payload = {"rows": rows, "columns": ["region", "commerce_aov"], "row_count": 2,
+               "path": "compiler", "authoritative": True, "sql": "SELECT ...",
+               "query_id": "mq_x", "release_id": "release_x"}
+
+    captured = {}
+
+    def stub(args, *, json_body=None):
+        captured["args"] = args
+        captured["body"] = json_body
+        return payload
+
+    monkeypatch.setattr(mq, "ARTIFACT_DIR", tmp_path)
+    rc, out = _run_cmd(mq, monkeypatch, capsys, stub,
+                       ["query", "--key", "commerce.aov", "--group-by", "orders.region",
+                        "--time-dimension", "orders.paid_at",
+                        "--start", "2026-08-01", "--end", "2026-09-01",
+                        "--grain", "month", "--filters", "orders.region=east"])
+    assert rc == 0
+    # body 契约：QuerySpec 结构
+    body = captured["body"]
+    assert body["metrics"] == ["commerce.aov"]
+    assert body["group_by"] == ["orders.region"]
+    assert body["time"] == {"dimension": "orders.paid_at", "start": "2026-08-01",
+                            "end_exclusive": "2026-09-01", "grain": "month"}
+    assert body["filters"] == [{"field": "orders.region", "op": "=", "value": "east"}]
+    # path-mode：CSV 落盘 + 路径返回，不内联数据
+    assert out["csv_path"].endswith(".csv")
+    assert out["row_count"] == 2
+    assert out["authoritative"] is True
+    with open(out["csv_path"], encoding="utf-8-sig") as f:
+        data = list(csv.DictReader(f))
+    assert len(data) == 2
+    assert "rows" not in out
+
+
+def test_query_server_error_exit_2(mq, monkeypatch, capsys):
