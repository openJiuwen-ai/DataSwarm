+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""send_file_to_user 路径列表解析：Windows 单反斜杠 JSON 串容错。
+
+事故背景（dacomp-zh-001）：模型把 abs_file_path_list 传成未转义的 JSON 字符串
+数组 `'["D:\\job\\a.md"]'`，json.loads 因 `\\j` 非法转义失败，旧逻辑把整串当成
+一个路径，isfile 必然 False → 误报「所有文件均不存在」，三次交付全失败。
+"""
+from jiuwenswarm.agents.harness.common.tools.send_file_to_user import (
+    _parse_path_list_string,
+)
+
+
+class TestParsePathListString:
+    def test_standard_json_array(self):
+        assert _parse_path_list_string('["D:/a/b.md", "D:/a/c.csv"]') == [
+            "D:/a/b.md", "D:/a/c.csv",
+        ]
+
+    def test_windows_single_backslash_array(self):
+        """未转义 Windows 路径（JSON 里 \\j 非法）必须原样解出。"""
+        raw = '["D:\\job\\code\\a.md","D:\\job\\code\\b.csv"]'
+        assert _parse_path_list_string(raw) == [
+            "D:\\job\\code\\a.md", "D:\\job\\code\\b.csv",
+        ]
+
+    def test_windows_escape_letters_kept_literal(self):
+        """\\new / \\temp 里的 \\n \\t 是合法 JSON 转义但语义错误，必须保持字面。"""
+        raw = '["C:\\new\\temp\\x.md"]'
+        assert _parse_path_list_string(raw) == ["C:\\new\\temp\\x.md"]
+
+    def test_double_backslash_normalized(self):
+        """已正确转义的 JSON 串（\\\\ 表示单反斜杠）解出单反斜杠路径。"""
+        raw = '["D:\\\\job\\\\a.md"]'
+        assert _parse_path_list_string(raw) == ["D:\\job\\a.md"]
+
+    def test_single_path_string(self):
+        assert _parse_path_list_string('"D:/a.md"') == "D:/a.md"
+
+    def test_unparseable_returns_none(self):
+        assert _parse_path_list_string("not a json") is None
