+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_type_map 语义类型映射单测（dialect-convergence 批次 1b G3 唯一真相源）。
+
+覆盖：
+- mysql_type：固定映射（STRING/VARCHAR(65533)→TEXT、LARGEINT→BIGINT）、
+  VARCHAR 收敛 16383、DECIMAL 收敛 (65,30)、原生兼容类型原样
+- duckdb_type：仅 LARGEINT→BIGINT，其余原样
+- dialect_type 分发 + 未知方言原样
+- quote_ident：duckdb/sqlite 双引号、doris/mysql 反引号
+- 消费路径回归：plan_to_tasks._to_mysql_ddl 走共享映射（收口前是独立正则）
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[3]
+_DW_COMMON = (_REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+              / "skills" / "_dw_common" / "scripts")
+
+
+def _load(name: str, script: Path):
+    spec = importlib.util.spec_from_file_location(name, script)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault(name, mod)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture(scope="module")
+def dtm():
+    return _load("_dw_type_map_test", _DW_COMMON / "dw_type_map.py")
+
+
+# =========================================================================
+# mysql_type
+# =========================================================================
+def test_mysql_fixed_map(dtm):
+    assert dtm.mysql_type("STRING") == "TEXT"
+    assert dtm.mysql_type("varchar(65533)") == "TEXT"
+    assert dtm.mysql_type("LARGEINT") == "BIGINT"
+
+
+def test_mysql_varchar_clamped(dtm):
+    assert dtm.mysql_type("VARCHAR(65533)") == "TEXT"
+    assert dtm.mysql_type("VARCHAR(20000)") == "VARCHAR(16383)"
+    assert dtm.mysql_type("VARCHAR(100)") == "VARCHAR(100)"
+
+
+def test_mysql_decimal_clamped(dtm):
+    assert dtm.mysql_type("DECIMAL(38,12)") == "DECIMAL(38,12)"
+    assert dtm.mysql_type("DECIMAL(70,40)") == "DECIMAL(65,30)"
+
+
+def test_mysql_native_passthrough(dtm):
+    assert dtm.mysql_type("BIGINT") == "BIGINT"
+    assert dtm.mysql_type("datetime") == "DATETIME"
+
+
+# =========================================================================
+# duckdb_type / dialect_type / quote_ident
+# =========================================================================
+def test_duckdb_only_largeint(dtm):
+    assert dtm.duckdb_type("LARGEINT") == "BIGINT"
+    assert dtm.duckdb_type("STRING") == "STRING"
+    assert dtm.duckdb_type("DECIMAL(38,12)") == "DECIMAL(38,12)"
+
+
+def test_dialect_type_dispatch(dtm):
+    assert dtm.dialect_type("STRING", "mysql") == "TEXT"
+    assert dtm.dialect_type("LARGEINT", "duckdb") == "BIGINT"
+    assert dtm.dialect_type("STRING", "doris") == "STRING"
+    assert dtm.dialect_type("STRING", "unknown") == "STRING"
+
+
+def test_quote_ident_by_dialect(dtm):
+    assert dtm.quote_ident("col", "duckdb") == '"col"'
+    assert dtm.quote_ident("col", "sqlite") == '"col"'
+    assert dtm.quote_ident("col", "doris") == "`col`"
+    assert dtm.quote_ident("col", "mysql") == "`col`"
+
+
+# =========================================================================
+# 消费路径回归：plan_to_tasks._to_mysql_ddl 走共享映射
+# =========================================================================
+@pytest.fixture(scope="module")
+def ptt():
+    return _load("_ptt_typemap_test",
+                 _REPO / "jiuwenswarm" / "resources" / "agent" / "workspace"
+                 / "skills" / "dw-warehouse-build" / "scripts" / "plan_to_tasks.py")
+
+
+_DORIS_DDL = """CREATE TABLE IF NOT EXISTS `dwd_t` (
+  `k` STRING NULL,
+  `v` LARGEINT NULL,
+  `s` VARCHAR(20000) NULL
+) ENGINE=OLAP
+DUPLICATE KEY(`k`)
+DISTRIBUTED BY HASH(`k`) BUCKETS 4
+PROPERTIES ("replication_num" = "1")"""
+
+
+def test_to_mysql_ddl_uses_shared_type_map(ptt):
+    out = ptt._to_mysql_ddl(_DORIS_DDL, "dwd_t")
+    assert "TEXT" in out and "STRING" not in out.replace("CHARSET", "")
+    assert "`v` BIGINT" in out
+    assert "VARCHAR(16383)" in out
+    assert "ENGINE=InnoDB DEFAULT CHARSET=utf8mb4" in out
+
+
+def test_to_mysql_ddl_native_mysql_passthrough(ptt):
+    """已是 MySQL DDL（无 Doris 子句）原样返回——既有 passthrough 语义回归。"""
+    ddl = "CREATE TABLE IF NOT EXISTS `t` (\n  `id` BIGINT NOT NULL\n) ENGINE=InnoDB"
+    out = ptt._to_mysql_ddl(ddl, "t")
+    assert out == ddl
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
