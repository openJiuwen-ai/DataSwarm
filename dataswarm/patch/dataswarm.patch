+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""dw_layer.infer_layer 单测（dialect-convergence 批次 1b G4 唯一真相源）。"""
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.common.dw_layer import infer_layer
+
+
+@pytest.mark.parametrize("name,expected", [
+    ("ods_olist_orders", "ODS"),
+    ("dwd_order_detail", "DWD"),
+    ("dws_monthly_sales", "DWS"),
+    ("ads_user_rfm", "ADS"),
+    ("DWD_UPPER", "DWD"),   # 大小写不敏感
+    ("dim_product", "OTHER"),
+    ("random_table", "OTHER"),
+    ("", "OTHER"),
+])
+def test_infer_layer(name, expected):
+    assert infer_layer(name) == expected
+
