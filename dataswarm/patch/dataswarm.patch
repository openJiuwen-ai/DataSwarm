+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+from __future__ import annotations
+
+from . import service
+from .._common import read_body
+
+_PREFIX = "/api/dataagent/workspaces"
+
+
+def handle_get(handler, parsed) -> None:
+    path = parsed.path.rstrip("/")
+    if path == f"{_PREFIX}/sources":
+        handler._write_json(200, service.list_business_sources())
+        return
+    if path == _PREFIX:
+        handler._write_json(200, service.list_workspaces())
+        return
+    handler._write_json(404, {"error": "not_found"})
+
+
+def handle_post(handler, parsed) -> None:
+    try:
+        parts = parsed.path.rstrip("/").split("/")
+        if len(parts) >= 6 and parts[-1] == "probe":
+            handler._write_json(200, service.probe(parts[-2]))
+            return
+        if len(parts) >= 6 and parts[-1] == "delete":
+            handler._write_json(200, service.delete_workspace(parts[-2]))
+            return
+        if len(parts) >= 6 and parts[-1] == "update":
+            body = read_body(handler)
+            if body is None:
+                handler._write_json(400, {"error": "invalid_json"})
+                return
+            handler._write_json(200, service.update_workspace(parts[-2], body))
+            return
+        if parsed.path.rstrip("/") == _PREFIX:
+            body = read_body(handler)
+            if body is None:
+                handler._write_json(400, {"error": "invalid_json"})
+                return
+            handler._write_json(201, service.create_workspace(body))
+            return
+    except ValueError as exc:
+        handler._write_json(400, {"error": "bad_request", "detail": str(exc)})
+        return
+    except Exception as exc:
+        handler._write_json(500, {"error": "internal_error", "detail": str(exc)})
+        return
+    handler._write_json(404, {"error": "not_found"})
