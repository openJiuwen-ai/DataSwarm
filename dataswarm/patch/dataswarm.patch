+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useMemo, useState } from 'react';
+import { AlertTriangle, Search, X } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import { Table, Pagination } from '../../../components/ui';
+import { collectFindingRows, filterFindingRows, type FindingRow } from '../findings/findingModel';
+import { useGovernanceStore } from '../store/governanceStore';
+import type { ArtifactMap, Finding, Severity } from '../types/inspection';
+
+const DEFAULT_PAGE_SIZE = 20;
+const MAX_GOVERNANCE_SELECTION = 15;
+const SEVERITY_ORDER: Severity[] = ['high', 'medium', 'low', 'info'];
+
+function findingSubject(finding: Finding): string {
+  const object = finding.object ?? {};
+  const stringValue = (key: string) => (typeof object[key] === 'string' ? (object[key] as string) : '');
+  const table = stringValue('table');
+  const column = stringValue('column');
+  if (table) return column ? `${table}.${column}` : table;
+
+  const task = stringValue('task') || stringValue('task_id');
+  if (task) return task;
+
+  const metric = stringValue('metric');
+  const caliber = stringValue('caliber');
+  if (metric) return caliber ? `${metric} · ${caliber}` : metric;
+
+  const symptom = stringValue('symptom_table');
+  const root = stringValue('root_node');
+  if (symptom || root) return [symptom, root].filter(Boolean).join(' → ');
+
+  return stringValue('declared_output_table') || stringValue('db') || stringValue('layer') || '—';
+}
+
+function shortFindingId(finding: Finding): string {
+  return finding.source_finding_id ?? finding.id;
+}
+
+function buildGovernancePrefill(rows: FindingRow[], runId: string, translate: (key: string, options?: Record<string, unknown>) => string): string {
+  const orderedRows = [...rows].sort((left, right) => SEVERITY_ORDER.indexOf(left.finding.severity) - SEVERITY_ORDER.indexOf(right.finding.severity));
+  const lines = orderedRows.map(({ finding }) =>
+    translate('governance.anomalies.fixPrompt.item', {
+      id: shortFindingId(finding),
+      subject: findingSubject(finding),
+      summary: finding.summary.slice(0, 80),
+      severity: finding.severity,
+    }),
+  );
+  return [translate('governance.anomalies.fixPrompt.heading', { runId }), ...lines].join('\n');
+}
+
+export function AnomalyListPage({ artifacts, runId }: { artifacts: ArtifactMap; runId: string }) {
+  const { t } = useTranslation();
+  const selectedFindingUids = useGovernanceStore(state => state.selectedFindingUids);
+  const toggleFindingSelection = useGovernanceStore(state => state.toggleFindingSelection);
+  const setFindingSelection = useGovernanceStore(state => state.setFindingSelection);
+  const clearFindingSelection = useGovernanceStore(state => state.clearFindingSelection);
+
+  const [query, setQuery] = useState('');
+  const [dimension, setDimension] = useState('');
+  const [page, setPage] = useState(1);
+  const [pageSize, setPageSize] = useState(DEFAULT_PAGE_SIZE);
+
+  const collection = useMemo(() => collectFindingRows(artifacts), [artifacts]);
+  const filteredRows = useMemo(
+    () =>
+      filterFindingRows(collection.rows, {
+        dimensions: dimension ? [dimension as FindingRow['dimension']] : undefined,
+        query,
+      }),
+    [collection.rows, dimension, query],
+  );
+
+  const pageCount = Math.max(1, Math.ceil(filteredRows.length / pageSize));
+  const visiblePage = Math.min(page, pageCount);
+  const pageRows = filteredRows.slice((visiblePage - 1) * pageSize, visiblePage * pageSize);
+  const selectedSet = useMemo(() => new Set(selectedFindingUids), [selectedFindingUids]);
+  const selectedRows = useMemo(
+    () => collection.rows.filter(row => row.selectable && row.uid !== null && selectedSet.has(row.uid)),
+    [collection.rows, selectedSet],
+  );
+  const selectablePageRows = pageRows.filter(row => row.selectable && row.uid !== null);
+  const allPageSelected = selectablePageRows.length > 0 && selectablePageRows.every(row => selectedSet.has(row.uid as string));
+  const somePageSelected = selectablePageRows.some(row => selectedSet.has(row.uid as string));
+  const selectionOverLimit = selectedRows.length > MAX_GOVERNANCE_SELECTION;
+
+  useEffect(() => {
+    setPage(1);
+  }, [query, dimension, runId]);
+
+  // 数据量减少导致页码超界时，把 state 收敛到最后一页，保持与显示一致
+  useEffect(() => {
+    if (page > pageCount) setPage(pageCount);
+  }, [page, pageCount]);
+
+  /** 表头全选框的半选态。同一表头元素会被 Table 渲染到可见表头与隐藏测量表头两处，
+   *  回调 ref 对两个实例都生效，保证可见副本拿到 indeterminate。 */
+  const setPageCheckboxRef = (el: HTMLInputElement | null) => {
+    if (el) el.indeterminate = somePageSelected && !allPageSelected;
+  };
+
+  const toggleCurrentPage = () => {
+    const pageUids = selectablePageRows.map(row => row.uid as string);
+    if (allPageSelected) {
+      setFindingSelection(selectedFindingUids.filter(uid => !pageUids.includes(uid)));
+      return;
+    }
+    setFindingSelection([...selectedFindingUids, ...pageUids]);
+  };
+
+  const startGovernance = () => {
+    if (!runId || selectedRows.length === 0 || selectionOverLimit) return;
+    useGovernanceStore.getState().requestFixPrefill(buildGovernancePrefill(selectedRows, runId, t));
+  };
+
+  if (collection.rows.length === 0) {
+    return <div className="gov-empty">{t('governance.anomalies.empty')}</div>;
+  }
+
+  return (
+    <div className="gov-anomalies">
+      <section className="gov-anomaly-heading">
+        <div className="gov-anomaly-title">
+          <h2>{t('governance.anomalies.heading', { count: collection.rows.length })}</h2>
+          {selectedRows.length > 0 && (
+            <span>{t('governance.anomalies.summary.selectedOfLimit', { count: selectedRows.length, limit: MAX_GOVERNANCE_SELECTION })}</span>
+          )}
+        </div>
+        <div className="gov-anomaly-actions">
+          {selectedRows.length > 0 && (
+            <button type="button" className="gov-anomaly-clear" onClick={clearFindingSelection}>
+              {t('governance.anomalies.selection.clear')}
+            </button>
+          )}
+          <button type="button" className="gov-btn gov-anomaly-fix" disabled={selectedRows.length === 0 || selectionOverLimit} onClick={startGovernance}>
+            {t('governance.anomalies.selection.start')}
+          </button>
+        </div>
+      </section>
