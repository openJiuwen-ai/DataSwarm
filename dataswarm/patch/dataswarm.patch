+            **TestCronJobWorkspaceId._base_kwargs(),
+            "id": "j1",
+            "workspace_id": "bank",
+        })
+        assert job.workspace_id == "bank"
+        d = job.to_dict()
+        assert d["workspace_id"] == "bank"
+        assert CronJob.from_dict(d).workspace_id == "bank"
+
+    @staticmethod
+    def test_legacy_data_defaults_empty():
+        job = CronJob.from_dict({
+            **TestCronJobWorkspaceId._base_kwargs(),
+            "id": "j2",
+        })
+        assert job.workspace_id == ""
+        assert job.to_dict()["workspace_id"] == ""
+
+    @staticmethod
+    def test_workspace_id_strips():
+        job = CronJob.from_dict({
+            **TestCronJobWorkspaceId._base_kwargs(),
+            "id": "j3",
+            "workspace_id": "  bank  ",
+        })
+        assert job.workspace_id == "bank"
