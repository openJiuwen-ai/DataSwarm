+      → POST /internal/struct-change/notify（本端点）
+      → WebChannel.send_event_to_session(session_id, "chat.struct_change", payload)
+      → 前端 useWebSocket chat.struct_change → structChangeStore
+
+设计约束：
+    - 纯推送 best-effort：无在线 ws 时返回 {"delivered": 0}（事件已落 session 历史，
+      重进会话走 historyRestore 恢复）；
+    - 仅接受 loopback 来源（开发拓扑 app_web→Gateway 恒 127.0.0.1）；
+    - 校验 session_id 非空、kind 合法后透传 payload，不重新解释业务字段。
+"""
+
+from __future__ import annotations
+
+import logging
+import hmac
+from typing import TYPE_CHECKING, Any
+
+from fastapi import FastAPI, Request
+from fastapi.responses import JSONResponse
+
+if TYPE_CHECKING:
+    from jiuwenswarm.gateway.channel_manager.web.web_connect import WebChannel
+
+logger = logging.getLogger(__name__)
+
+STRUCT_CHANGE_NOTIFY_PATH = "/internal/struct-change/notify"
+_LOOPBACK_HOSTS = {"127.0.0.1", "::1", "localhost"}
+_VALID_KINDS = {"workflow_run", "table_change", "workflow_change"}
+_MAX_BODY_BYTES = 64 * 1024
+
+
+def attach_struct_change_routes(app: FastAPI, channel: WebChannel) -> None:
+    """把 notify 端点挂到 WebChannel dual_protocol 的 FastAPI app 上.
+
+    照 trajectory_http.attach_trajectory_routes 的挂载模式（web_channel_app.py
+    register_http_routes 调用），channel 经 app.state 持有。
+    """
+    app.state.struct_change_web_channel = channel
+
+    @app.post(STRUCT_CHANGE_NOTIFY_PATH)
+    async def struct_change_notify(request: Request) -> JSONResponse:
+        client_host = request.client.host if request.client else ""
+        if client_host not in _LOOPBACK_HOSTS:
+            logger.warning(
+                "[struct-change.notify] non-loopback request rejected: host=%s", client_host
+            )
+            return _json_response(403, {"error": "forbidden_origin"})
+
+        from jiuwenswarm.common.internal_auth import get_struct_change_token
+
+        expected_token = get_struct_change_token()
+        supplied_token = request.headers.get("X-Jiuwen-Struct-Change-Token", "").strip()
+        if not expected_token or not supplied_token or not hmac.compare_digest(
+            supplied_token, expected_token
+        ):
+            logger.warning("[struct-change.notify] authentication failed: host=%s", client_host)
+            return _json_response(401, {"error": "unauthorized"})
+
+        raw = await request.body()
+        if len(raw) > _MAX_BODY_BYTES:
+            return _json_response(413, {"error": "payload_too_large"})
+        try:
+            payload: Any = await request.json()
+        except Exception:
+            return _json_response(400, {"error": "invalid_json"})
+        if not isinstance(payload, dict):
+            return _json_response(400, {"error": "invalid_payload"})
+
+        session_id = str(payload.get("session_id") or "").strip()
+        if not session_id:
+            return _json_response(400, {"error": "session_id_required"})
+        if not _session_exists(session_id):
+            return _json_response(404, {"error": "session_not_found"})
+        if payload.get("kind") not in _VALID_KINDS:
+            return _json_response(400, {"error": "invalid_kind"})
+
+        try:
+            delivered = channel.send_event_to_session(session_id, "chat.struct_change", payload)
+        except Exception:
+            logger.exception(
+                "[struct-change.notify] send failed: session_id=%s kind=%s",
+                session_id, payload.get("kind"),
+            )
+            return _json_response(500, {"error": "send_failed"})
+
+        logger.info(
+            "[struct-change.notify] session_id=%s kind=%s delivered=%d",
+            session_id, payload.get("kind"), delivered,
+        )
+        return _json_response(200, {"ok": True, "delivered": delivered})
+
+
+def _json_response(status_code: int, content: dict[str, Any]) -> JSONResponse:
+    return JSONResponse(content=content, status_code=status_code, headers={"Cache-Control": "no-store"})
+
+
+def _session_exists(session_id: str) -> bool:
+    """Require a real session directory before forwarding an internal event."""
+    try:
+        from jiuwenswarm.server.runtime.session.session_history import resolve_session_dir
+
+        directory, error = resolve_session_dir(session_id, create=False)
+        return error is None and directory is not None and directory.is_dir()
+    except Exception:
+        return False
+
+
+__all__ = ["STRUCT_CHANGE_NOTIFY_PATH", "attach_struct_change_routes"]
