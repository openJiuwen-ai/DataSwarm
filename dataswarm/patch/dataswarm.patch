+
+def connector_for(type_id, config, source_id="verify"):
+    adapter = R.get_source_type(type_id)
+    source = SourceDefinition(source_id, type_id, "verify", adapter.engine, dict(config))
+    return get_engine(adapter.engine)(source)
+
+
+def dataset_names(cat):
+    if cat.get("datasets") is not None:
+        return [d["name"] for d in cat["datasets"]]
+    return [tb["name"] for s in cat.get("schemas", []) for tb in s["tables"]]
