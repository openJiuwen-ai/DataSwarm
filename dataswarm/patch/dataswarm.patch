+#!/usr/bin/env bash
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+# ===========================================================================
+# run_fork_ci.sh —— 成员 fork 侧 CI：全树直接跑单测（不需要组装 build）
+#
+# 与交付仓 UT 流水线（scripts/ci/run_ut_ci.sh）并存：
+# 交付仓 CI 看不到成员 fork，所以交付侧走「clone 基线 tag + apply patch」还原；
+# fork 侧拿到的就是全树，直接 uv sync + pytest。
+#
+# 用法: ./scripts/dataswarm/fork/ci/run_fork_ci.sh [pytest 额外参数...]
+# ===========================================================================
+set -euo pipefail
+
+cd "$(dirname "$0")/../../../.."   # 仓库根（develop_oss checkout）
+
+echo "[fork-ci] HEAD: $(git rev-parse --short HEAD) branch: $(git rev-parse --abbrev-ref HEAD)"
+# --all-extras 与交付仓 UT 流水线（scripts/ci/run_ut_ci.sh）同口径：数据源驱动（psycopg/paramiko/happybase 等）
+# 是可选 extra，不装则 test_source_type_conformance 等用例假红
+uv sync --all-extras --group test
+uv run pytest tests/unit_tests/ -q --no-cov -p no:cacheprovider \
+  --continue-on-collection-errors -W ignore::SyntaxWarning "$@"
