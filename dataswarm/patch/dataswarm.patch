+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""归档工具测试：纯函数 + 临时 git 仓端到端归档/回放验证/漂移/防回退。
+
+运行: uv run pytest scripts/dataswarm/fork/tests -q
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+FORK_DIR = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(FORK_DIR))
+
+
+def run(cmd, cwd, check=True, env=None):
+    sub_env = {**os.environ, "PYTHONIOENCODING": "utf-8", **(env or {})}
+    proc = subprocess.run(cmd, cwd=cwd, capture_output=True, encoding="utf-8",
+                          errors="replace", env=sub_env)
+    if check and proc.returncode != 0:
+        raise AssertionError(f"{cmd}\nstdout:{proc.stdout}\nstderr:{proc.stderr}")
+    return proc
+
+
+def git(args, cwd, check=True):
+    return run(["git", *args], cwd, check=check)
+
+
+def commit(repo, msg):
+    git(["-c", "user.name=t", "-c", "user.email=t@t", "commit", "-qm", msg], repo)
+
+
+def write(repo, rel, text):
+    p = repo / rel
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(text, encoding="utf-8")
+
+
+@pytest.fixture
+def sandbox(tmp_path):
