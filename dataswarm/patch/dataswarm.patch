@@ -0,0 +1,447 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Semantica graph publishing adapters with explicit staging semantics."""
+from __future__ import annotations
+
+import os
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+
+from .graph import GraphEdge, GraphProjection
+
+
+@dataclass(frozen=True)
+class PublishResult:
+    version: str
+    node_count: int
+    edge_count: int
+
+
+class SemanticaAdapter(ABC):
+    """Minimal protocol required by the physical semantic publisher."""
+
+    @abstractmethod
+    def stage(self, namespace: str, version: str, projection: GraphProjection) -> str:
+        """Write a complete graph version without making it current."""
+
+    @abstractmethod
+    def validate(self, stage_id: str) -> None:
+        """Raise when the staged graph cannot be published."""
+
+    @abstractmethod
+    def publish(self, stage_id: str) -> PublishResult:
+        """Make a previously validated stage current."""
+
+    def delete_graph_nodes(self, namespace: str, node_ids: list[str] | None = None) -> int:
+        """Delete previously published nodes (glossary upsert 前置清理用).
+
+        Args:
+            namespace: 目标 namespace。
+            node_ids: 稳定节点 id 列表；None 表示整个 namespace。
+
+        Returns:
+            删除的节点数。
+
+        Raises:
+            NotImplementedError: adapter 不支持删除（Neo4j 写入是 CREATE 语义，
+            不清理会累积冗余——调用方需处理）。
+        """
+        raise NotImplementedError(f"{type(self).__name__} does not support delete_graph_nodes")
+
+    def create_cross_edges(self, namespace: str, edges: list[GraphEdge]) -> dict:
+        """跨 namespace 边直写（GraphBuilder payload 会静默丢跨层端点）。
+
+        Returns:
+            ``{"created": int, "missed": int}``——目标不存在不建不抛。
+
+        Raises:
+            NotImplementedError: adapter 不支持跨边直写（调用方降级：
+            跨边不产出 + warning，不阻塞发布）。
+        """
+        raise NotImplementedError(f"{type(self).__name__} does not support create_cross_edges")
+
+    def read_neighbors(
+        self,
+        node_ids: list[str],
+        edge_types: list[str] | None = None,
+        direction: str = "both",
+        limit: int = 200,
+    ) -> list[dict]:
+        """读取节点的邻边与对端节点属性（L2 图补全的读侧原语）。
+
+        图只用来**发现候选 ID**——定义/绑定/join 进入上下文前由调用方回源
+        复验（元数据库是真相源，图是可重建衍生品）。跨 namespace 边
+        （usesTable/measuresConcept 等）端点可能属于任一 namespace，按全局
+        稳定 id 匹配，不按 namespace 过滤。
+
+        Args:
+            node_ids: 入口节点稳定 id 列表（col:/tbl:/metric:/term: 前缀）。
+            edge_types: 边类型白名单（如 ``["usesColumn", "measuresConcept"]``）；
+                None 表示全部边型。
+            direction: ``out``（node_ids 为 source 端）/ ``in``（为 target 端）/
+                ``both``（任一端命中）。
+            limit: 返回边数上限。
+
+        Returns:
+            ``[{source, target, type, edge_properties, node_properties,
+            direction}]``——``node_properties`` 为**对端节点**属性（方向为
+            out 时是 target 节点，in 时是 source 节点，both 时为命中端的对端）。
+
+        Raises:
+            NotImplementedError: adapter 不支持读侧（调用方降级为无图补全）。
+        """
+        raise NotImplementedError(f"{type(self).__name__} does not support read_neighbors")
+
+
+class InMemorySemanticaAdapter(SemanticaAdapter):
+    """Deterministic adapter used by unit tests and local dry runs."""
+
+    def __init__(self) -> None:
+        self.stages: dict[str, tuple[str, str, GraphProjection]] = {}
+        self.published: dict[str, str] = {}
+        # 读侧（L2 图补全）：publish 后保留投影与跨 namespace 边，
+        # read_neighbors 在内存边上遍历（与 Neo4j 读侧同语义）
+        self.published_graphs: dict[str, GraphProjection] = {}
+        self.published_cross_edges: list[GraphEdge] = []
+        # delete_graph_nodes 调用记录：(namespace, node_ids)，供单测断言"写前先删"
+        self.delete_calls: list[tuple[str, list[str] | None]] = []
+        # create_cross_edges 调用记录：(namespace, edges)，供单测断言跨层边重建
+        self.cross_edge_calls: list[tuple[str, list[GraphEdge]]] = []
+
+    def stage(self, namespace: str, version: str, projection: GraphProjection) -> str:
+        stage_id = f"{namespace}/staging/{version}"
+        self.stages[stage_id] = (namespace, version, projection)
+        return stage_id
+
+    def validate(self, stage_id: str) -> None:
+        if stage_id not in self.stages:
+            raise ValueError(f"unknown Semantica stage: {stage_id}")
+        _validate_projection(self.stages[stage_id][2])
+
+    def publish(self, stage_id: str) -> PublishResult:
+        self.validate(stage_id)
+        namespace, version, projection = self.stages[stage_id]
+        self.published[namespace] = version
+        self.published_graphs[namespace] = projection
+        return PublishResult(version, len(projection.nodes), len(projection.edges))
+
+    def delete_graph_nodes(self, namespace: str, node_ids: list[str] | None = None) -> int:
+        self.delete_calls.append((namespace, node_ids))
+        graph = self.published_graphs.get(namespace)
+        if graph is None or node_ids is None:
+            return 0
+        return sum(1 for node in graph.nodes if node.id in node_ids)
+
+    def create_cross_edges(self, namespace: str, edges: list[GraphEdge]) -> dict:
+        # 记录调用供单测断言「跨边在 namespace 替换后重建」；同时保留边供
+        # read_neighbors 遍历（与 Neo4j 直写行为同构——目标端点存在与否在
+        # 内存替身里不可判，全部计 created，调用方按需断言边集本身）
+        self.cross_edge_calls.append((namespace, list(edges)))
+        self.published_cross_edges.extend(edges)
+        return {"created": len(edges), "missed": 0}
+
+    def read_neighbors(
+        self,
+        node_ids: list[str],
+        edge_types: list[str] | None = None,
+        direction: str = "both",
+        limit: int = 200,
+    ) -> list[dict]:
+        if direction not in ("out", "in", "both"):
+            raise ValueError(f"direction 只允许 out/in/both，收到 {direction!r}")
+        seeds = set(node_ids)
+        node_props: dict[str, dict] = {}
+        for projection in self.published_graphs.values():
+            for node in projection.nodes:
+                node_props[node.id] = dict(node.properties)
+        records: list[dict] = []
+        for edge in self._all_edges():
+            if edge_types is not None and edge.type not in edge_types:
+                continue
+            source_hit = edge.source in seeds
+            target_hit = edge.target in seeds
+            if direction == "out" and not source_hit:
+                continue
+            if direction == "in" and not target_hit:
+                continue
+            if not (source_hit or target_hit):
+                continue
+            if direction == "out" or (direction == "both" and source_hit):
+                other_props, hit_dir = node_props.get(edge.target, {}), "out"
+            else:
+                other_props, hit_dir = node_props.get(edge.source, {}), "in"
+            records.append({
+                "source": edge.source,
+                "target": edge.target,
+                "type": edge.type,
+                "edge_properties": dict(edge.properties),
+                "node_properties": other_props,
+                "direction": hit_dir,
+            })
+            if len(records) >= max(1, min(limit, 1000)):
+                break
+        return records
+
+    def _all_edges(self) -> list[GraphEdge]:
+        edges: list[GraphEdge] = []
+        for projection in self.published_graphs.values():
+            edges.extend(projection.edges)
+        edges.extend(self.published_cross_edges)
+        return edges
+
+
+class GraphBuilderSemanticaAdapter(SemanticaAdapter):
+    """Adapter for the Semantica GraphBuilder + Neo4jStore API from the source design."""
+
+    def __init__(self, uri: str, username: str, password: str, database: str = "neo4j") -> None:
+        if not uri or not username or not password:
+            raise ValueError("SEMANTICA_URI, SEMANTICA_USERNAME and SEMANTICA_PASSWORD are required")
+        try:
+            from semantica.graph_store import GraphStore
+            from semantica.kg import GraphBuilder
+        except ImportError as exc:
+            raise RuntimeError("semantica package is not installed") from exc
+        self._store = GraphStore(
+            backend="neo4j",
+            uri=uri,
+            user=username,
+            password=password,
+            database=database or "neo4j",
+        )
+        self._builder_type = GraphBuilder
+        self._stages: dict[str, tuple[str, str, GraphProjection]] = {}
+
+    def stage(self, namespace: str, version: str, projection: GraphProjection) -> str:
+        stage_id = f"{namespace}/staging/{version}"
+        self._stages[stage_id] = (namespace, version, projection)
+        return stage_id
+
+    def validate(self, stage_id: str) -> None:
+        if stage_id not in self._stages:
+            raise ValueError(f"unknown Semantica stage: {stage_id}")
+        _validate_projection(self._stages[stage_id][2])
+
+    def publish(self, stage_id: str) -> PublishResult:
+        self.validate(stage_id)
+        namespace, version, projection = self._stages[stage_id]
+        payload = {
+            "entities": [
+                {
+                    "id": node.id,
+                    "type": node.type,
+                    "properties": {
+                        "id": node.id,
+                        "namespace": namespace,
+                        "version": version,
+                        **node.properties,
+                    },
+                }
+                for node in projection.nodes
+            ],
+            "relationships": [
+                {
+                    "source": edge.source,
+                    "target": edge.target,
+                    "type": edge.type,
+                    "metadata": edge.properties,
+                }
+                for edge in projection.edges
+            ],
+        }
+        self._builder_type(merge_entities=True, graph_store=self._store).build(payload)
+        return PublishResult(version, len(projection.nodes), len(projection.edges))
+
+    def delete_graph_nodes(self, namespace: str, node_ids: list[str] | None = None) -> int:
+        """Neo4j 写入是 CREATE 语义（GraphBuilder 无 MERGE），publish 前清旧节点。
+
+        Args:
+            namespace: 目标 namespace（节点 properties 里的 namespace 字段）。
+            node_ids: 稳定节点 id 列表（单术语 upsert 用）；None = 整个 namespace。
+
+        Returns:
+            删除的节点数。
+
+        Raises:
+            RuntimeError: Cypher 执行失败。
+        """
+        if node_ids is None:
+            query = "MATCH (n {namespace: $ns}) DETACH DELETE n RETURN count(n) AS c"
+            parameters: dict[str, object] = {"ns": namespace}
+        else:
+            if not node_ids:
+                return 0
+            query = "MATCH (n {namespace: $ns}) WHERE n.id IN $ids DETACH DELETE n RETURN count(n) AS c"
+            parameters = {"ns": namespace, "ids": node_ids}
+        try:
+            outcome = self._store.execute_query(query, parameters)
+            records = outcome.get("records") or []
+            return int(records[0]["c"]) if records else 0
+        except Exception as exc:  # noqa: BLE001 - semantica ProcessingError 等，统一转 RuntimeError
+            raise RuntimeError(f"delete_graph_nodes failed for namespace {namespace!r}: {exc}") from exc
+
+    def create_cross_edges(self, namespace: str, edges: list[GraphEdge]) -> dict:
+        """跨 namespace 边直写（GraphBuilder payload 会静默丢边，只能按 id 属性建）。
+
+        GraphStore.create_relationship 靠进程内 ``_app_node_id_map`` 解析端点，
+        跨进程/跨 namespace 的端点（如 metrics 节点指向采集写入的 physical
+        节点）必然失配——边进 GraphBuilder payload 会被 ``add_edges`` 捕获
+        异常后**静默丢弃**。因此跨层边（usesTable/timeField/measuresConcept
+        等）不走 GraphBuilder，这里按 ``id`` 属性 MATCH 两端直写。
+
+        Args:
+            namespace: 源节点 namespace（边的 source 端所在，如 ``metrics/{ws}``）。
+            edges: 跨 namespace 边列表（target 是其他 namespace 的稳定 id）。
+
+        Returns:
+            ``{"created": int, "missed": int}``——目标端点不存在时不建、
+            不抛（missed 计数交调用方记 warning）。
+
+        Raises:
+            RuntimeError: Cypher 执行失败；ValueError: 边类型含非法字符
+                （关系类型无法参数化，须拼进 Cypher——白名单校验防注入）。
+        """
+        import re
+
+        created = 0
+        missed = 0
+        for edge in edges:
+            if not re.fullmatch(r"[A-Za-z0-9_]+", edge.type):
+                raise ValueError(f"illegal relationship type: {edge.type!r}")
+            query = (
+                "MATCH (a {namespace: $ns, id: $src}), (b {id: $tgt}) "
+                f"WHERE b.namespace IS NULL OR b.namespace <> $ns "
+                f"CREATE (a)-[:{edge.type}]->(b) RETURN 1 AS ok"
+            )
+            parameters: dict[str, object] = {
+                "ns": namespace, "src": edge.source, "tgt": edge.target}
+            try:
+                outcome = self._store.execute_query(query, parameters)
+                records = outcome.get("records") or []
+                if records:
+                    created += 1
+                else:
+                    missed += 1
+            except Exception as exc:  # noqa: BLE001 - semantica ProcessingError 等，统一转 RuntimeError
+                raise RuntimeError(
+                    f"create_cross_edges failed for namespace {namespace!r}: {exc}") from exc
+        return {"created": created, "missed": missed}
+
+
+    def read_neighbors(
+        self,
+        node_ids: list[str],
+        edge_types: list[str] | None = None,
+        direction: str = "both",
+        limit: int = 200,
+    ) -> list[dict]:
+        """Neo4j 读侧：MATCH 全库边（跨 namespace 端点按全局 id 命中）。
+
+        方向与边型过滤在 Python 侧完成——Cypher 只做 id 命中与 limit，
+        避免拼装方向分支与 ``[:A|B]`` 类型模式的注入面。
+
+        Raises:
+            RuntimeError: Cypher 执行失败；ValueError: direction/edge_types 非法。
+        """
+        import re as _re
+
+        if direction not in ("out", "in", "both"):
+            raise ValueError(f"direction 只允许 out/in/both，收到 {direction!r}")
+        if edge_types:
+            for edge_type in edge_types:
+                if not _re.fullmatch(r"[A-Za-z0-9_]+", edge_type):
+                    raise ValueError(f"illegal relationship type: {edge_type!r}")
+        if not node_ids:
+            return []
+        query = (
+            "MATCH (a)-[r]->(b) "
+            "WHERE a.id IN $ids OR b.id IN $ids "
+            "RETURN a.id AS source, b.id AS target, type(r) AS rel_type, "
+            "properties(r) AS edge_properties, "
+            "properties(a) AS source_properties, properties(b) AS target_properties "
+            "LIMIT $cap"
+        )
+        # 上取 limit（两倍）以补偿 Python 侧方向/边型过滤的裁剪
+        parameters: dict[str, object] = {
+            "ids": list(node_ids), "cap": max(1, min(limit, 1000)) * 2}
+        try:
+            outcome = self._store.execute_query(query, parameters)
+        except Exception as exc:  # noqa: BLE001 - semantica ProcessingError 等，统一转 RuntimeError
+            raise RuntimeError(f"read_neighbors failed: {exc}") from exc
+        seeds = set(node_ids)
+        type_filter = set(edge_types) if edge_types is not None else None
+        records: list[dict] = []
+        for row in outcome.get("records") or []:
+            rel_type = str(row.get("rel_type") or "")
+            if type_filter is not None and rel_type not in type_filter:
+                continue
+            source = str(row.get("source") or "")
+            target = str(row.get("target") or "")
+            source_hit = source in seeds
+            target_hit = target in seeds
+            if direction == "out" and not source_hit:
+                continue
+            if direction == "in" and not target_hit:
+                continue
+            if not (source_hit or target_hit):
+                continue
+            if direction == "out" or (direction == "both" and source_hit):
+                other_props = row.get("target_properties") or {}
+                hit_dir = "out"
+            else:
+                other_props = row.get("source_properties") or {}
+                hit_dir = "in"
+            records.append({
+                "source": source,
+                "target": target,
+                "type": rel_type,
+                "edge_properties": row.get("edge_properties") or {},
+                "node_properties": dict(other_props),
+                "direction": hit_dir,
+            })
+            if len(records) >= max(1, min(limit, 1000)):
+                break
+        return records
+
+
+def graph_projection_enabled() -> bool:
+    """「知识图库」图投影开关（``SEMANTICA_GRAPH_ENABLED``，UI 设置页控制，默认关）。
+
+    开关是图投影的总门：关 → 语义采集跳过整段图投影、快照照常发布，各图
+    消费方（术语/指标/知识投影、L2 图扩展）经 ``from_environment`` 的 gate
+    统一降级；开 → ``from_environment`` 照常构造，图侧失败让调用方失败
+    （配置了就该工作，失败要暴露而非静默降级）。取值与前端
+    ``parseConfigBoolean`` 同约定（true/1/yes/on/enabled，忽略大小写）。
+    """
+    return os.environ.get("SEMANTICA_GRAPH_ENABLED", "").strip().lower() in (
+        "1", "true", "yes", "on", "enabled")
+
+
+def from_environment() -> SemanticaAdapter:
+    """Create the production adapter without embedding credentials in config artifacts.
+
+    Raises:
+        ValueError: 图投影开关未开启，或 SEMANTICA_* 连接配置不齐。
+            调用方按既有降级纪律消化（glossary/metrics/knowledge/graph_expand
+            均已捕获异常转 failed/skipped/metadata_fallback 标记）。
+    """
+    if not graph_projection_enabled():
+        raise ValueError("graph projection is disabled (SEMANTICA_GRAPH_ENABLED is not true)")
+    return GraphBuilderSemanticaAdapter(
+        uri=os.environ.get("SEMANTICA_URI", "").strip(),
+        username=os.environ.get("SEMANTICA_USERNAME", "").strip(),
+        password=os.environ.get("SEMANTICA_PASSWORD", "").strip(),
+        database=os.environ.get("SEMANTICA_DATABASE", "neo4j").strip() or "neo4j",
+    )
+
+
+def _validate_projection(projection: GraphProjection) -> None:
+    ids = projection.node_ids()
+    if len(ids) != len(projection.nodes):
+        raise ValueError("duplicate graph node ids")
+    for edge in projection.edges:
+        if edge.source not in ids or edge.target not in ids:
+            raise ValueError(f"graph edge endpoint missing: {edge.source} -> {edge.target}")
+    for node in projection.nodes:
+        if node.type == "Column" and node.properties.get("isSensitive"):
+            forbidden = {"topK", "sampleValues", "minVal", "maxVal"} & node.properties.keys()
+            if forbidden:
+                raise ValueError(f"sensitive graph node contains values: {node.id}")
