@@ -0,0 +1,209 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+// DAG 拓扑布局共享 util：从 WorkflowDag 提取，供画布与列表缩略图（MiniDag）共用。
+
+import type { NodeInput } from '../../types/orchestration';
+
+/** 组 → 颜色（7 色轮换，顺序即用户认知顺序，勿调换） */
+export const GROUP_COLORS = ['#2563eb', '#16a34a', '#ea580c', '#9333ea', '#0891b2', '#db2777', '#ca8a04'];
+
+export function parseUpstream(s?: string): string[] {
+  return (s ?? '').split(',').map((x) => x.trim()).filter(Boolean);
+}
+
+export interface DagAdj {
+  ids: string[];
+  downstream: Record<string, string[]>;
+  upstream: Record<string, string[]>;
+  indeg: Record<string, number>;
+}
+
+export function buildAdj(nodes: NodeInput[]): DagAdj {
+  const ids = nodes.map((n) => n.node_id ?? '');
+  const downstream: Record<string, string[]> = {};
+  const upstream: Record<string, string[]> = {};
+  const indeg: Record<string, number> = {};
+  ids.forEach((id) => { downstream[id] = []; upstream[id] = []; indeg[id] = 0; });
+  nodes.forEach((n) => {
+    const id = n.node_id ?? '';
+    const ups = parseUpstream(n.upstream_nodes);
+    ups.forEach((u) => {
+      if (ids.includes(u)) {
+        downstream[u].push(id);
+        upstream[id].push(u);
+        indeg[id] += 1;
+      }
+    });
+  });
+  return { ids, downstream, upstream, indeg };
+}
+
+export function bfs(start: string, adj: Record<string, string[]>): Set<string> {
+  const seen = new Set<string>();
+  const queue = [start];
+  while (queue.length) {
+    const cur = queue.shift()!;
+    if (seen.has(cur)) continue;
+    seen.add(cur);
+    (adj[cur] ?? []).forEach((n) => queue.push(n));
+  }
+  return seen;
+}
+
+/** 拓扑分层：node_id → 层号（入度 0 在第 0 层） */
+export function topoLayers(nodes: NodeInput[]): Record<string, number> {
+  const { ids, downstream, indeg } = buildAdj(nodes);
+  const layer: Record<string, number> = {};
+  let cur = ids.filter((id) => indeg[id] === 0);
+  let depth = 0;
+  const remaining = { ...indeg };
+  while (cur.length) {
+    cur.forEach((id) => (layer[id] = depth));
+    const next: string[] = [];
+    cur.forEach((id) => {
+      downstream[id].forEach((c) => {
+        remaining[c] -= 1;
+        if (remaining[c] === 0) next.push(c);
+      });
+    });
+    cur = next;
+    depth += 1;
+    if (depth > 50) break;
+  }
+  ids.forEach((id) => { if (!(id in layer)) layer[id] = 0; });
+  return layer;
+}
+
+/** 组名 → 颜色映射（7 色轮换） */
+export function buildGroupColorMap(nodes: NodeInput[]): Record<string, string> {
+  const groups = Array.from(new Set(nodes.map((n) => n.group_name || '默认组')));
+  const m: Record<string, string> = {};
+  groups.forEach((g, i) => { m[g] = GROUP_COLORS[i % GROUP_COLORS.length]; });
+  return m;
+}
+
+/** 缩略图布局：node_id → {x,y}（层内等距、层间等距，原点 0,0） */
+export function miniLayout(nodes: NodeInput[], gapX: number, gapY: number): Record<string, { x: number; y: number }> {
+  const layerMap = topoLayers(nodes);
+  const buckets: Record<number, string[]> = {};
+  nodes.forEach((n) => {
+    const d = layerMap[n.node_id!] ?? 0;
+    (buckets[d] ??= []).push(n.node_id!);
+  });
+  const pos: Record<string, { x: number; y: number }> = {};
+  Object.keys(buckets).sort((a, b) => Number(a) - Number(b)).forEach((dStr) => {
+    const items = buckets[Number(dStr)];
+    items.forEach((id, i) => {
+      pos[id] = { x: i * gapX, y: Number(dStr) * gapY };
+    });
+  });
+  return pos;
+}
+
+/** 成环检测辅助：from 节点能否到达 to（BFS over downstream 邻接） */
+export function pathExists(from: string, to: string, adj: Record<string, string[]>): boolean {
+  return bfs(from, adj).has(to);
+}
+
+// ---- 通道式直角边布线的几何常量（与 WorkflowDag 的渲染布局一致，唯一出处，勿在组件里另写一份） ----
+export const GAP_X = 300; // 画布列距：layeredLayout 的 gapX
+export const GAP_Y = 200; // 画布层距：layeredLayout 的 gapY
+export const NODE_W = 190; // 节点估算宽（路由竖线依托的列网格宽度）
+/** 走廊内并行边逐条错开的间距 */
+export const LANE_STEP = 8;
+/** 单侧走廊（GAP_X - NODE_W = 110）可容纳的错开竖线条数上限 */
+export const LANE_CAP = Math.floor((GAP_X - NODE_W) / LANE_STEP) - 1;
+
+/**
+ * 通道式直角边的拐点序列。
+ *
+ * 目标：任意折线段不穿过节点框。成立前提是 layeredLayout 把每层节点左缘排在 GAP_X 的整数倍上
+ * （任一层框只占 [k*GAP_X, k*GAP_X + NODE_W]），因此满足 x mod GAP_X ∈ (NODE_W, GAP_X) 的竖线
+ * （“列间隙带”）能整条贯穿所有层而不碰任何框；横段取源层下方的层间空隙带（层距 200 大于节点高，
+ * 源中心 y + GAP_Y/2 恒落在源底与下一层顶之间）。
+ *
+ * @param outIdx 同源扇出序号（出口走廊错开），@param inIdx 同目标扇入序号（入口走廊错开）
+ */
+export function channelPolyline(
+  sourceX: number, sourceY: number, targetX: number, targetY: number,
+  outIdx = 0, inIdx = 0,
+): Array<{ x: number; y: number }> {
+  const out = Math.min(Math.max(outIdx, 0), LANE_CAP);
+  const inn = Math.min(Math.max(inIdx, 0), LANE_CAP);
+  // 出口竖线：源右缘右移进列间隙带（sourceX mod GAP_X = NODE_W，+6 落入间隙带）；
+  // 入口竖线：目标左缘左移进列间隙带（targetX mod GAP_X = 0，-6 落入间隙带）
+  const exitX = sourceX + 6 + out * LANE_STEP;
+  const enterX = targetX - 6 - inn * LANE_STEP;
+  // 水平通道：源层下方相邻两层的空隙正中
+  const laneY = sourceY + GAP_Y / 2;
+  return [
+    { x: sourceX, y: sourceY },
+    { x: exitX, y: sourceY },
+    { x: exitX, y: laneY },
+    { x: enterX, y: laneY },
+    { x: enterX, y: targetY },
+    { x: targetX, y: targetY },
+  ];
+}
+
+/**
+ * 自动整理布局：拓扑分层 + 层内重心排序（barycenter heuristic），减少边交叉。
+ *
+ * ① 用 topoLayers 得到层号（与画布纵向坐标直接挂钩）；
+ * ② 上下各扫若干轮：每轮按相邻层邻居的平均序号（重心）重排当前层，
+ *    连线的目标/来源越靠得近，线越平行、交叉越少；
+ * ③ 末行补位居中由调用方处理（这里输出等距序号坐标，间距由参数给）。
+ *
+ * 纯函数、确定性（同输入同输出），O(iterations × nodes)。
+ */
+export function layeredLayout(
+  nodes: NodeInput[],
+  gapX: number,
+  gapY: number,
+  iterations = 8,
+): Record<string, { x: number; y: number }> {
+  const { ids, downstream, upstream } = buildAdj(nodes);
+  if (ids.length === 0) return {};
+  const layer = topoLayers(nodes);
+
+  // 层分桶，保持 topoLayers 的发现顺序作为初始序
+  const buckets = new Map<number, string[]>();
+  ids.forEach((id) => {
+    const d = layer[id] ?? 0;
+    (buckets.get(d) ?? buckets.set(d, []).get(d)!).push(id);
+  });
+  const depths = [...buckets.keys()].sort((a, b) => a - b);
+
+  // 重心排序：order[id] = 该节点在其层内的序号（0 起）
+  const order: Record<string, number> = {};
+  depths.forEach((d) => buckets.get(d)!.forEach((id, i) => { order[id] = i; }));
+
+  // 交替方向扫描：一轮 = 自上而下 + 自下而上
+  const sweep = (adj: Record<string, string[]>) => {
+    depths.forEach((d) => {
+      const list = buckets.get(d)!;
+      const bary: Array<{ id: string; v: number }> = [];
+      list.forEach((id) => {
+        const nbrs = adj[id].filter((n) => layer[n] !== undefined && layer[n] !== d);
+        // 重心 = 相邻层邻居的平均序号；无邻居保持原序（用自身序号，排序稳定）
+        const v = nbrs.length ? nbrs.reduce((s, n) => s + order[n], 0) / nbrs.length : order[id];
+        bary.push({ id, v });
+      });
+      bary.sort((a, b) => a.v - b.v || a.id.localeCompare(b.id)); // 稳定：重心相同按 id，保证确定性
+      list.length = 0;
+      bary.forEach((b, i) => { list.push(b.id); order[b.id] = i; });
+    });
+  };
+  for (let i = 0; i < iterations; i++) {
+    sweep(upstream);   // 自上而下：按上游邻居重心排
+    sweep(downstream); // 自下而上：按下游邻居重心排
+  }
+
+  // 同层相邻节点若被同一对上下游共享（如菱形），重心排序后已聚拢；输出等距坐标
+  const pos: Record<string, { x: number; y: number }> = {};
+  depths.forEach((d) => {
+    buckets.get(d)!.forEach((id, i) => {
+      pos[id] = { x: i * gapX, y: d * gapY };
+    });
+  });
+  return pos;
+}
