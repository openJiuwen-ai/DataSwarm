+++ b/tests/unit_tests/common/test_db_connector_dry_run.py
@@ -0,0 +1,170 @@
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""db_connector.dry_run 方言感知预检单测（方案 docs/archive/delivered/dialect-convergence-plan.md 批次 1a）。
+
+验证矩阵（方言 × 语句类型）：
+- doris/mysql：SELECT 与 INSERT 均走 EXPLAIN <sql>（Doris EXPLAIN INSERT 可用）
+- sqlite：EXPLAIN QUERY PLAN <sql>
+- duckdb：SELECT 走 EXPLAIN；INSERT/CTAS 提取源 SELECT 预检；DROP 明示 SKIPPED
+- 预检失败返回 FAILED + error 文本（阶段归因给上层）
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from jiuwenswarm.common import db_connector
+
+
+class _FakeCursor:
+    def __init__(self, rows=None, error: Exception | None = None):
+        self._rows = rows or []
+        self._error = error
+        self.execute_calls: list[str] = []
+
+    def execute(self, sql, params=None):
+        self.execute_calls.append(sql)
+        if self._error:
+            raise self._error
+
+    def fetchmany(self, n):
+        return self._rows[:n]
+
+    def fetchall(self):
+        return self._rows
+
+    @property
+    def description(self):
+        return [(r"col",)] if self._rows else []
+
+
+class _FakeConn:
+    def __init__(self, cur: _FakeCursor):
+        self._cur = cur
+
+    def cursor(self):
+        return self._cur
+
+    def close(self):
+        pass
+
+
+def _patch_acquire(monkeypatch, cur, db_type="sqlite"):
+    meta = {"type": db_type, "ref": f"{db_type}://test"}
+    conn = _FakeConn(cur)
+
+    def _fake_acquire(db_ref, read_only=True):
+        return conn, meta
+
+    monkeypatch.setattr(db_connector, "_acquire", _fake_acquire)
+    monkeypatch.setattr(db_connector, "_release", lambda c: None)
+    monkeypatch.setattr(db_connector, "_invalidate", lambda *a, **kw: None)
+
+
+# ---- _dry_run_wrapped_sql 纯函数矩阵 ----
+
+@pytest.mark.parametrize("db_type", ["doris", "mysql"])
+def test_explain_prefix_for_mysql_protocol(db_type):
+    sql, status = db_connector._dry_run_wrapped_sql("SELECT 1", db_type)
+    assert sql == "EXPLAIN SELECT 1"
+    assert status == "CHECKED"
+
+
+def test_explain_insert_for_doris():
+    sql, status = db_connector._dry_run_wrapped_sql(
+        "INSERT INTO t(a) SELECT b FROM src", "doris")
+    assert sql.startswith("EXPLAIN INSERT")
+    assert status == "CHECKED"
+
+
+def test_explain_query_plan_for_sqlite():
+    sql, status = db_connector._dry_run_wrapped_sql("SELECT * FROM t", "sqlite")
+    assert sql == "EXPLAIN QUERY PLAN SELECT * FROM t"
+    assert status == "CHECKED"
+
+
+def test_duckdb_select_explained():
+    sql, status = db_connector._dry_run_wrapped_sql("SELECT 1", "duckdb")
+    assert sql == "EXPLAIN SELECT 1"
+    assert status == "CHECKED"
+
+
+def test_duckdb_insert_extracts_source_select():
+    sql, status = db_connector._dry_run_wrapped_sql(
+        'INSERT INTO "dwd_t" SELECT a, b FROM "ods_s"', "duckdb")
+    assert sql == 'EXPLAIN SELECT a, b FROM "ods_s"'
+    assert status == "CHECKED"
+
+
+def test_duckdb_ctas_extracts_source_select():
+    sql, status = db_connector._dry_run_wrapped_sql(
+        'CREATE TABLE "dwd_t" AS SELECT a FROM "ods_s" WHERE a > 1', "duckdb")
+    assert sql == 'EXPLAIN SELECT a FROM "ods_s" WHERE a > 1'
+    assert status == "CHECKED"
+
+
+def test_duckdb_ctas_with_select_first_raises_skip_or_checked():
+    # 列名以 SELECT 开头的怪形：宁可误 SKIPPED 也不预检错对象（宁缺毋滥）
+    sql, status = db_connector._dry_run_wrapped_sql(
+        'CREATE TABLE t AS WITH x AS (SELECT 1 a) SELECT * FROM x', "duckdb")
+    # WITH 是合法 read-side 起点
+    assert status == "CHECKED"
+    assert sql.startswith("EXPLAIN WITH")
+
+
+def test_duckdb_drop_skipped():
+    sql, status = db_connector._dry_run_wrapped_sql('DROP TABLE "t"', "duckdb")
+    assert status == "SKIPPED"
+
+
+def test_duckdb_insert_without_select_skipped():
+    sql, status = db_connector._dry_run_wrapped_sql(
+        "INSERT INTO t VALUES (1, 2)", "duckdb")
+    assert status == "SKIPPED"
+
+
+# ---- dry_run 集成（FakeCursor 走 query 通道）----
+
+def test_dry_run_checked_sqlite(monkeypatch):
+    cur = _FakeCursor(rows=[(1,)])
+    _patch_acquire(monkeypatch, cur, db_type="sqlite")
+    result = db_connector.dry_run("sqlite://test", "SELECT * FROM t")
+    assert result["ok"] is True
+    assert result["status"] == "CHECKED"
+    assert result["dialect"] == "sqlite"
+    assert cur.execute_calls == ["EXPLAIN QUERY PLAN SELECT * FROM t"]
+
+
+def test_dry_run_failed_carries_error(monkeypatch):
+    cur = _FakeCursor(error=RuntimeError("(1146, table doesn't exist)"))
+    _patch_acquire(monkeypatch, cur, db_type="doris")
+    result = db_connector.dry_run("doris://test/db", "SELECT * FROM missing")
+    assert result["ok"] is False
+    assert result["status"] == "FAILED"
+    assert result["dialect"] == "doris"
+    assert "doesn't exist" in result["error"]
+
+
+def test_dry_run_empty_sql_raises():
+    with pytest.raises(ValueError):
+        db_connector.dry_run("sqlite://test", "   ")
+
+
+def test_dry_run_duckdb_skipped_drop(monkeypatch):
+    """duckdb DROP 无源 SELECT 可验 → SKIPPED 明示（不静默通过）。"""
+    called = []
+
+    def _fake_query(db_ref, sql, params=None, limit=None):
+        called.append(sql)
+        return {"rows": [], "columns": [], "row_count": 0}
+
+    monkeypatch.setattr(db_connector, "query", _fake_query)
+    monkeypatch.setattr(db_connector, "_is_duckdb", lambda ref: True)
+    monkeypatch.setattr(db_connector, "parse_db_ref",
+                        lambda ref: {"type": "duckdb", "location": "/x", "source_type": "csv", "table_name": "t"})
+    result = db_connector.dry_run("duckdb://x", 'DROP TABLE "t"')
+    assert result["status"] == "SKIPPED"
+    assert called == [], "SKIPPED 不应执行任何校验语句"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
