+    _make_store(monkeypatch, [])
+    result = ds_service.create_database({**DORIS_PARAMS})
+    assert result["ok"] is True
+    assert result["database"] == "demo_db"
+    assert "database" not in connect_kwargs
+    assert executed == ["CREATE DATABASE IF NOT EXISTS `demo_db`"]
+
+
