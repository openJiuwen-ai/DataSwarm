+    assert lib.to_dev_path_from_archive("dataswarm/skills/dw-demo/SKILL.md") \
+        == "jiuwenswarm/resources/agent/workspace/skills/dw-demo/SKILL.md"
+    assert lib.to_dev_path_from_archive("dataswarm/patch/dataswarm.patch") == "dataswarm/patch/dataswarm.patch"
