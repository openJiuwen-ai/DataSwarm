+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""datasource 模块分层单测。"""
+from __future__ import annotations
+
+from pathlib import Path
+import os
+
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.datasource import controller as ctrl
+from jiuwenswarm.channels.web.dataagent.datasource import service as svc
+from jiuwenswarm.channels.web.dataagent.datasource import registry as _registry
+from tests.unit.channel._dataagent_test_helpers import make_handler
+
+
+# --------------------------------------------------------------------------
+# service 层
+# --------------------------------------------------------------------------
+class _FakeConnector:
+    def __init__(self):
+        self.acquire_exc = None
+        self.acquire_calls = []
+
+    def _acquire(self, db_ref, read_only=False):
+        self.acquire_calls.append((db_ref, read_only))
+        if self.acquire_exc:
+            raise self.acquire_exc
+
+        class _Conn:
+            def close(self_inner):
+                pass
+        return _Conn(), {}
+
