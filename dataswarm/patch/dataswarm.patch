+    manifest["components"]["c-total"]["status"] = "failed"
+    (artifact / "manifest.json").write_text(json.dumps(manifest), encoding="utf-8")
+    result = judge_case({"id": "synthetic", "expect": {"analysis": "required", "open_analysis": {"mode": "open"}}},
+                        root, {}, "final")
+    assert result["verdict"] == "fail"
+    assert any(f["group"] == "open_analysis" for f in result["failures"])
+    assert score_record(result, DEFAULT_THRESHOLDS)["dimensions"]["correctness"] < 1
+    html = _case_table([{**result, "case_id": "synthetic", "open_analysis": result["details"]["open_analysis"]}], {})
+    assert "开放分析" in html and "核心" in html
