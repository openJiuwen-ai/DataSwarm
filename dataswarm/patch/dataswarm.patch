+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""glossary/db.py 单元测试：归一化 / 指纹 / CRUD / 写入口校验 / 批量导入。
+
+sqlite 隔离沿用 test_semantic_physical_layer.py 模式：JIUWENSWARM_ORCH_DB
+直连 ref 优先级最高，current_workspace() 解析到 tmp 库。
+"""
+import pytest
+
+from jiuwenswarm.channels.web.dataagent.glossary import db as glossary_db
+from jiuwenswarm.channels.web.schema.ensure import ensure_system_schema
+
+
+@pytest.fixture()
+def term_db(monkeypatch, tmp_path):
+    db_path = tmp_path / "glossary.db"
+    monkeypatch.setenv("JIUWENSWARM_ORCH_DB", f"sqlite://{db_path}")
+    ensure_system_schema(f"sqlite://{db_path}")
+    glossary_db._ensured_refs.clear()  # 进程内 ref 缓存跨测试隔离
+    return db_path
+
+
+# ==========================================================================
+# 归一化与指纹（纯函数）
+# ==========================================================================
+
+def test_normalize_alias_nfkc_lower_ws():
+    assert glossary_db.normalize_alias("ＧＭＶ") == "gmv"
+    assert glossary_db.normalize_alias("  平台   成交额 ") == "平台 成交额"
+    assert glossary_db.normalize_alias("") == ""
+    assert glossary_db.normalize_alias(None) == ""
+
+
+def test_compute_fingerprint_stable_and_order_insensitive():
+    fp1 = glossary_db.compute_fingerprint("GMV", "定义", ["a", "b"])
+    fp2 = glossary_db.compute_fingerprint("GMV", "定义", ["b", "a"])
+    fp3 = glossary_db.compute_fingerprint("GMV", "定义2", ["a", "b"])
+    assert fp1 == fp2  # 别名顺序不影响指纹
+    assert fp1 != fp3
+
+
+def test_parse_synonyms_variants():
+    assert glossary_db.parse_synonyms(["GMV", "平台成交总额", "GMV"]) == ["GMV", "平台成交总额"]
+    assert glossary_db.parse_synonyms('["GMV", "成交总额"]') == ["GMV", "成交总额"]
+    assert glossary_db.parse_synonyms("GMV，平台成交总额") == ["GMV", "平台成交总额"]
+    assert glossary_db.parse_synonyms("  , ") == []
+    assert glossary_db.parse_synonyms(None) == []
+    with pytest.raises(ValueError):
+        glossary_db.parse_synonyms("[bad json")
+
+
+# ==========================================================================
+# CRUD
+# ==========================================================================
+
+def test_create_get_and_list_terms(term_db):
+    created = glossary_db.create_term({
+        "name": "商品交易总额",
+        "definition": "特定周期内平台所有生成订单的总金额",
+        "synonyms": ["GMV", "平台成交总额"],
+    })
+    assert created["term_id"].startswith("term_")
+    assert created["synonyms_list"] == ["GMV", "平台成交总额"]
+    assert created["fingerprint"]
+    assert created["status"] == "active"
+
+    fetched = glossary_db.get_term(created["term_id"])
+    assert fetched["name"] == "商品交易总额"
+
+    # keyword 命中别名
+    assert [t["term_id"] for t in glossary_db.list_terms(keyword="GMV")] == [created["term_id"]]
+    # keyword 命中定义
+    assert [t["term_id"] for t in glossary_db.list_terms(keyword="生成订单")] == [created["term_id"]]
+    assert glossary_db.list_terms(keyword="不存在词") == []
+
+
+def test_update_term_recomputes_fingerprint(term_db):
+    created = glossary_db.create_term({"name": "GMV", "definition": "v1", "synonyms": []})
+    updated = glossary_db.update_term(created["term_id"], {"definition": "v2"})
+    assert updated["definition"] == "v2"
+    assert updated["fingerprint"] != created["fingerprint"]
+    # 未传字段保持不变
+    assert updated["name"] == "GMV"
+    assert glossary_db.update_term("term_missing", {"definition": "x"}) is None
+
+
+def test_delete_term_is_soft(term_db):
+    created = glossary_db.create_term({"name": "GMV", "definition": "d", "synonyms": []})
+    deleted = glossary_db.delete_term(created["term_id"])
+    assert deleted["status"] == "deprecated"
+    # 默认列表不可见；显式 include 可见
+    assert glossary_db.list_terms() == []
+    assert glossary_db.list_terms(include_deprecated=True)
+    # 行还在（真相源只做软删）
+    assert glossary_db.get_term(created["term_id"])["status"] == "deprecated"
+    assert glossary_db.delete_term("term_missing") is None
+
+
+# ==========================================================================
+# 写入口校验
+# ==========================================================================
+
+def test_validate_rejects_bad_input(term_db):
+    with pytest.raises(ValueError, match="name"):
+        glossary_db.create_term({"name": "  ", "definition": "d"})
+    with pytest.raises(ValueError, match="200"):
+        glossary_db.create_term({"name": "x" * 201, "definition": "d"})
+    with pytest.raises(ValueError, match="definition"):
+        glossary_db.create_term({"name": "GMV", "definition": ""})
+    with pytest.raises(ValueError, match="自身重复"):
+        glossary_db.create_term({"name": "GMV", "definition": "d", "synonyms": ["gmv"]})
+    with pytest.raises(ValueError, match="同一术语内重复"):
+        # 原文不同、归一化后相同（parse_synonyms 只去重原文，归一化冲突靠校验层）
+        glossary_db.create_term({"name": "GMV", "definition": "d", "synonyms": ["成交额", "成交额 "]})
+
+
+def test_alias_conflict_across_terms(term_db):
+    glossary_db.create_term({"name": "商品交易总额", "definition": "d", "synonyms": ["GMV"]})
+    # 别名归一化后冲突（全角 + 大小写等价）
+    with pytest.raises(ValueError, match="「Ｇｍｖ」已是术语「商品交易总额」的别名"):
+        glossary_db.create_term({"name": "另一个术语", "definition": "d", "synonyms": ["Ｇｍｖ"]})
+    # 术语名撞别人的别名同样算冲突
+    with pytest.raises(ValueError, match="已是术语"):
+        glossary_db.create_term({"name": "gmv", "definition": "d"})
+    # 自己更新自己不算冲突
+    term = glossary_db.list_terms()[0]
+    updated = glossary_db.update_term(term["term_id"], {"synonyms": ["GMV", "总成交额"]})
+    assert updated["synonyms_list"] == ["GMV", "总成交额"]
+
+
+# ==========================================================================
+# 批量导入
+# ==========================================================================
+
+def test_import_terms_idempotent_and_tolerant(term_db):
+    items = [
+        {"term": "商品交易总额", "defenition": "定义 v1", "synonyms": ["GMV"]},  # 兼容拼写
+        {"name": "退款率", "definition": "退款单占比", "synonyms": []},
+    ]
+    first = glossary_db.import_terms(items)
+    assert first == {"imported": 2, "updated": 0, "failed": []}
+    assert glossary_db.list_terms(keyword="商品交易总额")[0]["definition"] == "定义 v1"
+
+    # 同批重导：同名走 update
+    items[0]["definition"] = "定义 v2"
+    second = glossary_db.import_terms(items)
+    assert second["imported"] == 0
+    assert second["updated"] == 2
+    assert glossary_db.list_terms(keyword="商品交易总额")[0]["definition"] == "定义 v2"
+
+    # 单条失败不阻断整批
+    third = glossary_db.import_terms([
+        {"name": "", "definition": "缺名"},
+        {"name": "客单价", "definition": "d"},
+        {"name": "缺定义"},
+        {"name": "退款率", "definition": "撞别名", "synonyms": ["GMV"]},  # 别名冲突
+    ])
+    assert third["imported"] == 1
+    assert len(third["failed"]) == 3
+    assert glossary_db.get_term(glossary_db.list_terms(keyword="客单价")[0]["term_id"])
