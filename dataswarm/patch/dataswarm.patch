+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""CLI datasource descriptions must not resolve database credentials."""
+from __future__ import annotations
+
+from unittest.mock import Mock
+
+from jiuwenswarm.cli import dwcli
+from jiuwenswarm.common import db_connector as dbc, workspace_context as wc
+
+
+def _isolate(monkeypatch, tmp_path):
+    forbidden = Mock(side_effect=ConnectionError("metadata database unavailable"))
+    monkeypatch.setattr(dbc, "parse_db_ref", forbidden)
+    monkeypatch.setattr(dbc, "_lookup_source_credentials", forbidden)
+    monkeypatch.setattr(wc, "normalize_db_ref", forbidden)
+    monkeypatch.setattr(wc, "sanitize_ref", forbidden)
+    config = tmp_path / "datasource.yaml"
+    monkeypatch.setattr(dwcli, "_datasource_config_path", lambda: config)
+    return forbidden, config
+
+
+def _current(monkeypatch, ref, metadata="sqlite://meta.db"):
+    ctx = wc.WorkspaceContext("local", "Local", ref, metadata)
+    monkeypatch.setattr(wc, "resolve", lambda _: ctx)
+    return dwcli._local_datasource_current("local")
+
+
+def test_dialect_and_public_name_do_not_depend_on_credential_io(monkeypatch, tmp_path):
+    forbidden, _ = _isolate(monkeypatch, tmp_path)
+    for ref, dialect, name in [
+        ("mysql://host:3306/olist", "mysql", "olist"),
+        ("postgresql://host:5432/orders", "postgres", "orders"),
+        ("redis://host:6379/2", "duckdb", "2"),
+        ("duckdb://D:/data/sales%20file.csv?source_type=csv&table_name=sales", "duckdb", "sales file"),
+                              ]:
+        result = _current(monkeypatch, ref)
+        assert result["dialect"] == dialect
+        assert result["biz_database"] == name
+        assert result["business_db_ref"] == ref
+    forbidden.assert_not_called()
+
+
+def test_local_summary_keeps_output_shape_and_omits_credentials(monkeypatch, tmp_path):
+    forbidden, _ = _isolate(monkeypatch, tmp_path)
+    result = _current(monkeypatch, "mysql://private-user:private-password@host:3306/orders",
+                      "mysql://private-user:private-password@host:3306/meta")
+    assert result["summary"] == "workspace=local business=mysql:orders metadata=mysql:meta"
+    assert "private-" not in result["summary"]
+    assert result["biz_database"] == "orders"
+    forbidden.assert_not_called()
+
+
+def test_missing_database_name_uses_only_local_yaml(monkeypatch, tmp_path):
+    forbidden, config = _isolate(monkeypatch, tmp_path)
+    config.write_text("mysql:\n  database: business\n  metadata_database: governance\n", encoding="utf-8")
+    assert _current(monkeypatch, "mysql://")["biz_database"] == "business"
+    assert _current(monkeypatch, "mysql://meta")["biz_database"] == "governance"
+    forbidden.assert_not_called()
