+def test_e2e_second_release_keeps_first_queryable(e2e):
+    """发第二个 release 后：新 release 生效，旧 release 的历史查询记录仍可回查。"""
+    from jiuwenswarm.channels.web.dataagent.metrics import store
+
+    first = _import_and_publish(e2e, confirm=True)
+    first_release_id = first["release"].release_id
+    service.query(_AOV_SPEC, WORKSPACE)  # 在 release-1 下产生历史查询
+
+    second = versioning.publish_release(
+        WORKSPACE, first["revision_ids"], graph_adapter=e2e["graph_adapter"],
+        label="重发布", published_by="tester")
+    assert second.release_id != first_release_id
+
+    # active 指向新 release；旧 release 仍在追溯里
+    result = service.query(_AOV_SPEC, WORKSPACE)
+    assert result.compiled.release_id == second.release_id
+    logs = store.list_queries(WORKSPACE)
+    assert any(log["release_id"] == first_release_id for log in logs)
+    # 投影状态走元数据库 release 行（整 namespace 替换：图上只有当前生效指标，
+    # 历史 release 不再按图并存——真相源是 dw_metric_* 表）
+    assert store.get_release(first_release_id).projection_status == "published"
+    assert store.get_release(second.release_id).projection_status == "published"
