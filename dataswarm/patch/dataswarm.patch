+def _emit(payload) -> None:
+    """输出 JSON 到 stdout（先在 stderr 打印 workspace 落点脱敏摘要，决策八-4）。
+
+    摘要形如 ``workspace=<id> business=doris:db meta=doris:meta``——只有 type+database，
+    不含 host/凭据。payload 自带 summary（datasource current/meta）时透传不重复打。
+    """
+    if isinstance(payload, dict) and not payload.get("summary"):
+        try:
+            from jiuwenswarm.common import workspace_context as wc
+
+            ctx = wc.resolve(getattr(_emit, "_workspace_id", None))
+            print(_sanitize_summary(ctx), file=sys.stderr)
+        except Exception:
+            pass
+    print(json.dumps(payload, ensure_ascii=False, indent=2))
+
+
+# --------------------------------------------------------------------------
+# IO 协议辅助（方案 §6.1：flag 为主，结构化参数走 @file / --json-file / stdin）
+# --------------------------------------------------------------------------
+def _resolve_value(val):
+    """解析参数值：`@file` 前缀 → 读文件并 JSON 解析；否则原样返回。
+
+    仿 AWS CLI 的 file:// 惯例。文件不存在 → FileNotFoundError；
+    内容非合法 JSON → ValueError。
+    """
+    if isinstance(val, str) and val.startswith("@"):
+        text = Path(val[1:]).read_text(encoding="utf-8")
+        try:
+            return json.loads(text)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f"@file 内容不是合法 JSON: {val[1:]} ({exc})") from exc
+    return val
+
+
+def _convert_ints(params: dict, int_names: set[str]) -> dict:
+    """把 int 类参数值从 str 转 int（§6.1 类型转换）。非法值抛 ValueError。"""
+    out = {}
+    for k, v in params.items():
+        if k in int_names and isinstance(v, str):
+            out[k] = int(v)  # 非数字抛 ValueError（调用方转 exit 2）
+        else:
+            out[k] = v
+    return out
+
+
+def _read_json_body(json_file: str) -> dict:
+    """读整体 JSON body：'-' = stdin，否则文件路径。非法 JSON 抛 ValueError。"""
+    if json_file == "-":
+        # stdin 必须显式 UTF-8：Windows 管道默认 gbk+surrogateescape，把调用方
+        # 写入的 UTF-8 JSON 解出 \udcXX surrogate，下游 HTTP encode 直接
+        # UnicodeEncodeError（中文 body 必炸）。JSON 通道契约即 UTF-8。
+        text = sys.stdin.buffer.read().decode("utf-8")
+    else:
+        text = Path(json_file).read_text(encoding="utf-8")
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise ValueError(f"JSON body 不合法: {json_file} ({exc})") from exc
+    if not isinstance(parsed, dict):
+        raise ValueError(f"JSON body 必须是对象: {json_file}")
+    return parsed
+
