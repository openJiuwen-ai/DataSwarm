+  }, [
+    isActive,
+    activeSessionId,
+    hasHistoryPager,
+    historyLoadedPages,
+    messages.length,
+    toolExecutionOrder.length,
+    updateHistoryLayoutSnapshot,
+  ]);
+
+  useLayoutEffect(() => {
