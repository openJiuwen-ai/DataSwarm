diff --git a/jiuwenswarm/channels/web/frontend/src/features/datasource/components/SourceDrawerFrame.tsx b/jiuwenswarm/channels/web/frontend/src/features/datasource/components/SourceDrawerFrame.tsx
new file mode 100644
index 000000000..d55f4eb58
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/datasource/components/SourceDrawerFrame.tsx
@@ -0,0 +1,100 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useRef, type ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Check, X } from 'lucide-react';
+
+export function SourceDrawerFrame({
+  title,
+  step,
+  onClose,
+  children,
+  footer,
+  busy = false,
+}: {
+  title: string;
+  step?: 1 | 2;
+  onClose: () => void;
+  children: ReactNode;
+  footer: ReactNode;
+  busy?: boolean;
+}) {
+  const { t } = useTranslation();
+  const dialog = useRef<HTMLElement>(null);
+  const close = useRef(onClose);
+  close.current = onClose;
+  useEffect(() => {
+    const previous = document.activeElement as HTMLElement | null;
+    dialog.current?.focus();
+    const handleKey = (event: KeyboardEvent) => {
+      if (document.querySelector('[role="alertdialog"]')) return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        close.current();
+      }
+      if (event.key !== 'Tab') return;
+      const nodes = Array.from(
+        dialog.current?.querySelectorAll<HTMLElement>(
+          'button:not(:disabled), input:not(:disabled), select:not(:disabled), [tabindex="0"]',
+        ) ?? [],
+      );
+      const first = nodes[0];
+      const last = nodes[nodes.length - 1];
+      if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog.current)) {
+        event.preventDefault();
+        last?.focus();
+      } else if (!event.shiftKey && document.activeElement === last) {
+        event.preventDefault();
+        first?.focus();
+      }
+    };
+    document.addEventListener('keydown', handleKey);
+    return () => {
+      document.removeEventListener('keydown', handleKey);
+      previous?.focus();
+    };
+  }, []);
+  return (
+    <div className="datasource-drawer-backdrop" onClick={busy ? undefined : onClose}>
+      <aside
+        ref={dialog}
+        tabIndex={-1}
+        role="dialog"
+        aria-modal="true"
+        aria-label={title}
+        className="datasource-drawer"
+        onClick={(event) => event.stopPropagation()}
+      >
+        <header className="datasource-drawer-header">
+          <div className="ds-drawer-title">
+            <h2>{title}</h2>
+            <button
+              className="ds-icon-button"
+              title={t('common.close')}
+              aria-label={t('common.close')}
+              disabled={busy}
+              onClick={onClose}
+            >
+              <X size={20} />
+            </button>
+          </div>
+          {step && (
+            <ol className="ds-steps">
+              {[1, 2].map((number) => (
+                <li
+                  key={number}
+                  className={step === number ? 'is-active' : ''}
+                  aria-current={step === number ? 'step' : undefined}
+                >
+                  <span className="ds-step-number">{number < step ? <Check size={16} /> : number}</span>
+                  <span>{t(number === 1 ? 'dataSource.typeDialog.stepType' : 'dataSource.typeDialog.stepConfig')}</span>
+                </li>
+              ))}
+            </ol>
+          )}
+        </header>
+        <div className="datasource-drawer-body">{children}</div>
+        <footer className="datasource-drawer-footer">{footer}</footer>
+      </aside>
+    </div>
+  );
+}
diff --git a/jiuwenswarm/channels/web/frontend/src/features/datasource/components/SourceFormDrawer.tsx b/jiuwenswarm/channels/web/frontend/src/features/datasource/components/SourceFormDrawer.tsx
new file mode 100644
index 000000000..18df49803
--- /dev/null
+++ b/jiuwenswarm/channels/web/frontend/src/features/datasource/components/SourceFormDrawer.tsx
@@ -0,0 +1,421 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+import { useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { AlertTriangle, CheckCircle2, Eye, EyeOff, Loader2 } from 'lucide-react';
+import { confirmDialog, toast } from '../../_shared/ui/Feedback';
+import { dataSourceApi } from '../api/dataSourceApi';
+import { useDataSourceStore } from '../store/dataSourceStore';
+import type { DataSourceEntry, SourceFormParams, TestConnectionResult } from '../types/dataSource';
+import { SourceDrawerFrame } from './SourceDrawerFrame';
+import { DirectoryPathInput } from './DirectoryPathInput';
+import { SourceTypeCascader } from './SourceTypeCascader';
+import { SourceTypeDialog } from './SourceTypeDialog';
+
+export type SourceSubmitResult =
+  | { status: 'saved' | 'cancelled' }
+  | { status: 'error'; message: string; error_code?: string };
+
+export function SourceFormDrawer({
+  source,
+  initialType = '',
+  onClose,
+  onSubmit,
+}: {
+  source: DataSourceEntry | null;
+  initialType?: string;
+  onClose: () => void;
+  onSubmit: (params: SourceFormParams) => Promise<SourceSubmitResult>;
+}) {
+  const { t, i18n } = useTranslation();
+  const { sourceTypes, typesLoading, typesError, loadSourceTypes } = useDataSourceStore();
+  const [type, setType] = useState(source?.type ?? initialType);
+  const [step, setStep] = useState<1 | 2>(source || initialType ? 2 : 1);
+  const [id, setId] = useState(source?.source_id ?? '');
+  const [description, setDescription] = useState(source?.description ?? '');
+  const initialValues = useRef<Record<string, string>>(
+    Object.fromEntries(
+      (sourceTypes.find((entry) => entry.type_id === source?.type)?.fields ?? []).map((field) => [
+        field.key,
+        field.secret ? '' : String(source?.[field.key as keyof DataSourceEntry] ?? ''),
+      ]),
+    ),
+  );
+  const [values, setValues] = useState(initialValues.current);
+  const initialized = useRef(Object.keys(initialValues.current).length > 0);
+  const [validated, setValidated] = useState(false);
+  const [testResult, setTestResult] = useState<TestConnectionResult | null>(null);
+  const [submitError, setSubmitError] = useState<string | null>(null);
+  const [submitErrorCode, setSubmitErrorCode] = useState<string | null>(null);
+  const [saving, setSaving] = useState(false);
+  const [testing, setTesting] = useState(false);
+  const [creatingDb, setCreatingDb] = useState(false);
+  const [show, setShow] = useState<Record<string, boolean>>({});
+  const testRequest = useRef(0);
+  const alive = useRef(true);
+  useEffect(() => {
+    alive.current = true;
+    return () => {
+      alive.current = false;
+      testRequest.current += 1;
+    };
+  }, []);
+  const entry = sourceTypes.find((item) => item.type_id === type);
+  const fields = entry?.fields ?? [];
+  const displayFields = [...fields].sort((a, b) => {
+    const order = ['host', 'port', 'database', 'schema', 'user', 'password', 'path', 'location', 'be_host', 'be_http_port'];
+    const ai = order.indexOf(a.key);
+    const bi = order.indexOf(b.key);
+    return (ai < 0 ? order.length : ai) - (bi < 0 ? order.length : bi);
+  });
+  useEffect(() => {
+    if (!source || initialized.current) return;
+    const schema = sourceTypes.find((item) => item.type_id === source.type);
+    if (!schema?.fields.length) return;
+    initialized.current = true;
+    setType(source.type);
+    setId(source.source_id ?? '');
+    setDescription(source.description ?? '');
+    const next = Object.fromEntries(
+      (sourceTypes.find((item) => item.type_id === source.type)?.fields ?? []).map((field) => [
+        field.key,
+        field.secret ? '' : String(source[field.key as keyof DataSourceEntry] ?? ''),
+      ]),
+    );
+    initialValues.current = next;
+    setValues(next);
+  }, [source, sourceTypes]);
+  const initialDescription = useRef(source?.description ?? '');
+  const dirty =
+    type !== (source?.type ?? initialType) ||
+    id !== (source?.source_id ?? '') ||
+    description !== initialDescription.current ||
+    Object.keys({ ...initialValues.current, ...values }).some(
+      (key) => (values[key] ?? '') !== (initialValues.current[key] ?? ''),
+    );
+  const validId = /^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$/.test(id.trim());
+  const fieldInvalid = (key: string, required: boolean) => {
+    const value = values[key] ?? '';
+    if (required && !value.trim()) return true;
+    if (key === 'port' || key === 'be_http_port') {
+      return value !== '' && (!/^\d+$/.test(value) || Number(value) < 1 || Number(value) > 65535);
+    }
+    return false;
+  };
+  const connectionInvalid = displayFields.some((field) => fieldInvalid(field.key, field.required));
+  const schemaReady = entry?.available === true && fields.length > 0 && !typesLoading && !typesError;
+  const invalidateTest = () => {
+    testRequest.current += 1;
+    setTesting(false);
+    setTestResult(null);
+    setSubmitError(null);
+    setSubmitErrorCode(null);
+  };
+  const params = (includeDescription = false): SourceFormParams => {
+    const result: SourceFormParams = { source_id: id.trim(), type };
+    displayFields.forEach((field) => {
+      const value = values[field.key] ?? '';
+      // 编辑态 secret 留空 → 哨兵：测试连接后端替换为已存密码；update 语义为沿用旧值
+      if (source && field.secret && !value) {
+        result[field.key] = '__KEEP__';
+        return;
+      }
+      result[field.key] = field.input_type === 'number' ? Number(value) : value;
+    });
+    // 提交时始终带（编辑可清空）；连接测试不带，保持连接参数语义干净
+    if (includeDescription) result.description = description.trim();
+    return result;
+  };
+  const close = async () => {
+    if (saving) return;
+    if (
+      dirty &&
+      !(await confirmDialog({
+        title: t('dataSource.form.discardTitle'),
+        message: t('dataSource.form.discardConfirm'),
+      }))
+    ) return;
+    onClose();
+  };
+  const selectType = async (next: string) => {
+    if (
+      type &&
+      next !== type &&
+      !(await confirmDialog({
+        title: t('dataSource.form.changeTypeTitle'),
+        message: t('dataSource.form.changeTypeMessage'),
+      }))
+    )
+      return false;
+    if (next !== type) {
+      setValues({});
+      setShow({});
+      invalidateTest();
+      setValidated(false);
+    }
+    setType(next);
+    setStep(2);
+    return true;
+  };
+  const test = async () => {
+    setValidated(true);
+    if (!schemaReady || connectionInvalid) return;
+    const request = ++testRequest.current;
+    setTesting(true);
+    setTestResult(null);
+    try {
+      // 编辑态密码留空（KEEP 哨兵）时后端按 source_id 回填已存密码，需带 workspace 定位源
+      const workspaceId = useDataSourceStore.getState().activeWorkspaceId || undefined;
+      const testParams = { ...params(), ...(workspaceId ? { workspace_id: workspaceId } : {}) };
+      const result = await dataSourceApi.testConnection(testParams);
+      if (request === testRequest.current && alive.current) setTestResult(result);
+    } catch (error) {
+      if (request === testRequest.current && alive.current)
+        setTestResult({ ok: false, error: error instanceof Error ? error.message : String(error) });
+    } finally {
+      if (request === testRequest.current && alive.current) setTesting(false);
+    }
+  };
+  const save = async () => {
+    setValidated(true);
+    if (!schemaReady || !validId || connectionInvalid || saving) return;
+    setSaving(true);
+    setSubmitError(null);
+    setSubmitErrorCode(null);
+    try {
+      const result = await onSubmit(params(true));
+      if (!alive.current) return;
+      if (result.status === 'saved') onClose();
+      else if (result.status === 'error') {
+        setSubmitError(result.message);
+        setSubmitErrorCode(result.error_code ?? null);
+      }
+    } catch (error) {
+      if (alive.current) setSubmitError(error instanceof Error ? error.message : String(error));
+    } finally {
+      if (alive.current) setSaving(false);
+    }
+  };
+  const isDbSource = fields.some((field) => field.key === 'database');
+  const createDb = async () => {
+    if (creatingDb || saving || testing || !schemaReady) return;
+    setCreatingDb(true);
+    setSubmitError(null);
+    setSubmitErrorCode(null);
+    try {
+      const workspaceId = useDataSourceStore.getState().activeWorkspaceId || undefined;
+      const createParams = { ...params(), ...(workspaceId ? { workspace_id: workspaceId } : {}) };
+      const result = await dataSourceApi.createDatabase(createParams);
+      if (!alive.current) return;
+      if (result.ok) {
+        toast.success(t('dataSource.form.databaseCreated'));
+        void test();
+      } else {
+        setSubmitError(result.error ?? t('dataSource.form.databaseCreateFailed'));
+      }
+    } catch (error) {
+      if (alive.current) setSubmitError(error instanceof Error ? error.message : String(error));
+    } finally {
+      if (alive.current) setCreatingDb(false);
+    }
+  };
+  const showCreateDbButton =
+    isDbSource &&
+    !creatingDb &&
+    (testResult?.error_code === 'DB_NOT_FOUND' || submitErrorCode === 'DB_NOT_FOUND');
+  const createDbButton = (
+    <button
+      className="ds-button ds-button-primary"
+      onClick={() => void createDb()}
+      disabled={creatingDb || saving || testing}
+    >
+      {creatingDb && <Loader2 className="animate-spin" size={14} />}
+      {t('dataSource.form.createDatabase')}
+    </button>
+  );
+  if (step === 1) return <SourceTypeDialog initialType={type} onClose={() => void close()} onSelect={selectType} />;
+  const back = () => {
+    invalidateTest();
+    setStep(1);
+  };
+  return (
+    <SourceDrawerFrame
+      title={t(source ? 'dataSource.form.editTitle' : 'dataSource.form.createTitle')}
+      step={source ? undefined : 2}
+      onClose={() => void close()}
+      busy={saving}
+      footer={
+        <>
+          <button className="ds-button" onClick={() => void close()} disabled={saving}>
+            {t('common.cancel')}
+          </button>
+          {!source && (
+            <button className="ds-button" onClick={back} disabled={saving}>
+              {t('dataSource.form.previous')}
+            </button>
+          )}
+          <button className="ds-button" onClick={() => void test()} disabled={testing || saving || !schemaReady}>
+            {testing && <Loader2 className="animate-spin" size={14} />}
+            {t('dataSource.form.test')}
+          </button>
+          <button className="ds-button ds-button-primary" disabled={saving || !schemaReady} onClick={() => void save()}>
+            {saving && <Loader2 className="animate-spin" size={14} />}
+            {t(source ? 'common.save' : 'dataSource.form.create')}
+          </button>
+        </>
+      }
+    >
+      {typesError && (
+        <div className="ds-error" role="alert">
+          {t('dataSource.typeDialog.loadFailed')}
+          <button className="ds-button" onClick={() => void loadSourceTypes()}>
+            {t('dataSource.typeDialog.refresh')}
+          </button>
+        </div>
+      )}
+      {typesLoading && (
+        <div role="status" aria-label={t('common.loading')}>
+          <Loader2 className="animate-spin" size={20} />
+        </div>
+      )}
+      <section className="ds-form-section">
+        <h3>{t('dataSource.form.basicTitle')}</h3>
+        <div className="ds-field">
+          <span>
+            {t('dataSource.form.typeLabel')} <em>*</em>
+          </span>
+          <SourceTypeCascader
+            value={type}
+            sourceTypes={sourceTypes}
+            disabled={!!source || saving}
+            onSelect={selectType}
+          />
+        </div>
+        <label className="ds-field">
+          <span>
+            {t('dataSource.form.sourceIdLabel')} <em>*</em>
+          </span>
+          <input
+            className="ds-input"
+            aria-invalid={validated && !validId}
+            disabled={!!source || saving}
+            maxLength={64}
+            value={id}
+            placeholder={t('dataSource.form.idPlaceholder')}
+            onChange={(event) => {
+              setId(event.target.value);
+              invalidateTest();
+            }}
+          />
+          {validated && !validId && <small className="ds-field-error">{t('dataSource.form.sourceIdInvalid')}</small>}
+        </label>
+        <label className="ds-field">
+          <span>{t('dataSource.form.descriptionLabel')}</span>
+          <textarea
+            className="ds-input"
+            rows={2}
+            maxLength={500}
+            disabled={saving}
+            placeholder={t('dataSource.form.descriptionPlaceholder')}
+            value={description}
+            onChange={(event) => {
+              setDescription(event.target.value);
+            }}
+          />
+        </label>
+      </section>
+      <section className="ds-form-section">
+        <h3>{t('dataSource.form.connectionTitle')}</h3>
+        {displayFields.map((field) => {
+          const bad = validated && fieldInvalid(field.key, field.required);
+          // 缺翻译时回落到后端 schema 自带的 label，避免把 i18n key 原样渲染到表单上
+          const label = t(`dataSource.form.${field.key}Label`, { defaultValue: field.label });
+          const dbMissing = field.key === 'database' && showCreateDbButton;
+          const supportsDirectoryDrop = field.key === 'path' && (type === 'csv' || type === 'excel');
+          return (
+            <div className="ds-field" key={field.key}>
+              <label htmlFor={`ds-field-${field.key}`}>
+                {label} {field.required && <em>*</em>}
+              </label>
+              <div className="ds-input-with-action">
+                {supportsDirectoryDrop ? (
+                  <DirectoryPathInput
+                    id={`ds-field-${field.key}`}
+                    value={values[field.key] ?? ''}
+                    placeholder={t('dataSource.form.pathPlaceholder')}
+                    disabled={saving}
+                    invalid={bad || dbMissing}
+                    onChange={(path) => {
+                      setValues((current) => ({ ...current, [field.key]: path }));
+                      invalidateTest();
+                    }}
+                  />
+                ) : (
+                  <input
+                    id={`ds-field-${field.key}`}
+                    className="ds-input"
+                    aria-invalid={bad || dbMissing}
+                    disabled={saving}
+                    type={
+                      field.secret && !show[field.key] ? 'password' : field.input_type === 'number' ? 'number' : 'text'
+                    }
+                    min={field.key === 'port' || field.key === 'be_http_port' ? 1 : undefined}
+                    max={field.key === 'port' || field.key === 'be_http_port' ? 65535 : undefined}
+                    autoComplete={field.secret ? 'new-password' : 'off'}
+                    value={values[field.key] ?? ''}
+                    placeholder={field.key === 'path' ? t('dataSource.form.pathPlaceholder') : field.placeholder}
+                    onChange={(event) => {
+                      setValues((current) => ({ ...current, [field.key]: event.target.value }));
+                      invalidateTest();
+                    }}
+                  />
+                )}
+                {field.secret && (
+                  <button
+                    type="button"
+                    onClick={() => setShow((current) => ({ ...current, [field.key]: !current[field.key] }))}
+                    title={t(show[field.key] ? 'dataSource.form.hidePassword' : 'dataSource.form.showPassword')}
+                    aria-label={t(show[field.key] ? 'dataSource.form.hidePassword' : 'dataSource.form.showPassword')}
+                  >
+                    {show[field.key] ? <EyeOff size={16} /> : <Eye size={16} />}
+                  </button>
+                )}
+              </div>
+              {bad && (
+                <small className="ds-field-error">
+                  {t(
+                    field.key === 'port' || field.key === 'be_http_port'
+                      ? 'dataSource.form.portInvalid'
+                      : 'dataSource.form.fieldRequired',
+                    { field: label },
+                  )}
+                </small>
+              )}
+              {dbMissing && <small className="ds-field-error">{t('dataSource.form.databaseNotFound')}</small>}
+              {dbMissing && createDbButton}
+              {field.secret && source && <small>{t('dataSource.form.passwordKeepHint')}</small>}
+              {(field.key === 'be_host' || field.key === 'be_http_port') &&
+                i18n.exists(`dataSource.form.${field.key}Hint`) && (
+                  <small>{t(`dataSource.form.${field.key}Hint`)}</small>
+                )}
+            </div>
+          );
+        })}
+      </section>
+      {testResult && (
+        <div role="status" className={`ds-test-result ${testResult.ok ? 'is-ok' : 'is-error'}`}>
+          {testResult.ok ? <CheckCircle2 size={16} /> : <AlertTriangle size={16} />}
+          <span>
+            {testResult.ok
+              ? t('dataSource.form.testOk')
+              : `${t('dataSource.form.testFailed')}: ${testResult.error ?? ''}`}
+          </span>
+        </div>
+      )}
+      {submitError && (
+        <p className="ds-error" role="alert">
+          {submitError}
+        </p>
+      )}
+    </SourceDrawerFrame>
+  );
+}
