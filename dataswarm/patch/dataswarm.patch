+            "ids": ["c1"],
+            "metadatas": [{"document_id": "d1", "file_name": "a.md"}],
+        }
+        self.index_manager = mock.AsyncMock()
+        self.index_manager.get_index_info = mock.AsyncMock(return_value={"count": 3})
