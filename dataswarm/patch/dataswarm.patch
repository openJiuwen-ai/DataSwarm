+# ---------------------------------------------------------------------------
+# finding_identity —— UID / fingerprint v1
+# ---------------------------------------------------------------------------
+
+def _mk(fid="NUL-001", table="dwd_orders", col="buyer_id", category="null",
+        sev="high", ev=None, dim="data"):
+    return {"id": fid, "category": category, "severity": sev,
+            "object": {"table": table, "column": col}, "evidence": ev or {},
+            "fix_hint": {"strategy": "fill_null"}}
+
+
+class TestFindingIdentity:
+    def test_cross_table_same_raw_id_unique_uid_regression(self):
+        """NUL-001 在两张表重复出现：UID 必须不同（检查器每表重新计数的真实形态）。"""
+        fs = [_mk(table="dwd_orders"), _mk(table="ods_orders")]
+        out = ident.annotate_findings(fs, dimension="data", db_ref="doris://probe-host:9030/db")
+        uids = {f["finding_uid"] for f in out}
+        assert len(uids) == len(fs)
+        assert out[0]["finding_uid"].startswith(
+            "data:null:dwd_orders:buyer_id:NUL-001:")
+
+    def test_source_id_preserved_and_versioned(self):
+        out = ident.annotate_findings([_mk()], dimension="data",
+                                      db_ref="doris://h:9030/db")
+        f = out[0]
+        assert f["source_finding_id"] == "NUL-001"
+        assert f["identity_version"] == ident.IDENTITY_VERSION
+
+    def test_fingerprint_excludes_severity_evidence(self):
+        fs = [
+            _mk(sev="high", ev={"null_rate": 0.9}),
+            _mk(sev="low", ev={"null_rate": 0.1}),
+        ]
+        out = ident.annotate_findings(fs, dimension="data", db_ref="doris://h:9030/db")
+        assert out[0]["finding_fingerprint"] == out[1]["finding_fingerprint"]
+
+    def test_fingerprint_differs_across_databases(self):
+        a = ident.annotate_findings([_mk()], dimension="data",
+                                    db_ref="doris://host-a:9030/db")[0]
+        b = ident.annotate_findings([_mk()], dimension="data",
+                                    db_ref="doris://host-b:9030/db")[0]
+        assert a["finding_fingerprint"] != b["finding_fingerprint"]
+
+    def test_true_duplicate_rows_resolved_without_index_salt(self):
+        # 完全相同 payload 的两条同 ID finding：靠内容摘要消解，不得静默共 UID
+        payload = _mk(ev={"n": 1})
+        out = ident.annotate_findings([payload, dict(payload)], dimension="data",
+                                      db_ref="doris://h:9030/db")
+        assert len({f["finding_uid"] for f in out}) == 2
+
+    def test_different_category_yields_different_ids(self):
+        fs = [_mk(category="null"), _mk(category="uniqueness")]
+        out = ident.annotate_findings(fs, dimension="data", db_ref="doris://h:9030/db")
+        assert out[0]["finding_uid"] != out[1]["finding_uid"]
+        assert out[0]["finding_fingerprint"] != out[1]["finding_fingerprint"]
+
+    def test_annotation_does_not_mutate_input(self):
+        src = [_mk()]
+        snap = dict(src[0])
+        ident.annotate_findings(src, dimension="data", db_ref="doris://h:9030/db")
+        assert src[0] == snap
