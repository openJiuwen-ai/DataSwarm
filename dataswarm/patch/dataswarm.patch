+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""API-dispatch acceptance for source lifecycle, browsing, queries and knowledge.
+
+Use --fixture-dir and --sources; Redis requires --redis-server or redis-server
+on PATH. Workspaces and SQLite metadata are temporary. The optional Redis peer
+is owned by this invocation. No browser, HTTP listener or LLM is exercised.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+from contextlib import ExitStack, contextmanager
+import csv
+from datetime import date, datetime, timezone
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+from functools import partial
+import io
+import json
+import os
+from pathlib import Path
+import secrets
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from unittest.mock import patch
+from urllib.parse import parse_qs, quote, urlencode, urlparse
+
+ROOT = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(ROOT))
+OUTPUT = ROOT / "artifact" / "datasource-validation"
+EXPECTED = {
+    "Q1": [["2318839.9200"]],
+    "Q2": [["4.0000", "620606.7500"], ["2.0000", "620448.2500"], ["3.0000", "532051.4800"]],
+    "Q3": [["2026-01", "99018.5000"], ["2026-02", "91174.2300"], ["2026-03", "97070.7000"]],
+    "Q4": [["1.0000", "10651.0000"], ["2.0000", "12425.0000"], ["3.0000", "10650.0000"], ["4.0000", "12425.0000"]],
+    "Q5": [["7.1420"]],
+}
+
+
+class Blocked(RuntimeError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def normalized(rows):
+    def cell(value):
+        try:
+            return format(Decimal(str(value)).quantize(Decimal("0.0001"), rounding=ROUND_HALF_UP), "f")
+        except (InvalidOperation, ValueError):
+            return str(value)
+    return [[cell(value) for value in row] for row in rows]
+
+
+def fixture_rows(path):
+    if not path.is_file():
+        raise Blocked("Existing fact_orders.csv fixture is required")
+    with path.open(encoding="utf-8", newline="") as stream:
+        rows = list(csv.DictReader(stream))
+    require(len(rows) == 50000 and {int(r["order_id"]) for r in rows} == set(range(1, 50001)),
+            "Fixture must have 50000 unique IDs")
+    regions, months, categories = defaultdict(Decimal), defaultdict(Decimal), defaultdict(int)
+    total, nulls, sentinel = Decimal(0), 0, 0
+    for row in rows:
+        region, category = int(row["region_id"]), int(row["category_id"])
+        sentinel += region == 9
+        if not row["order_amt"]:
+            nulls += 1
+            continue
+        amount = Decimal(row["order_amt"])
+        total += amount
+        regions[region] += amount
+        if date.fromisoformat(row["order_date"]) >= date(2026, 1, 1):
+            months[row["order_date"][:7]] += amount
+        if region != 9:
+            categories[category] += 1
+    answers = {"Q1": normalized([[total]]),
+               "Q2": normalized(sorted(regions.items(), key=lambda item: (-item[1], item[0]))[:3]),
+               "Q3": normalized(sorted(months.items())[:3]), "Q4": normalized(sorted(categories.items())),
+               "Q5": normalized([[Decimal(100) * nulls / len(rows)]])}
+    require((nulls, sentinel) == (3571, 299) and answers == EXPECTED, "Independent CSV/Decimal baseline mismatch")
+    return rows
+
+
+def questions(table):
+    quoted = '"' + table.replace('"', '""') + '"'
+    prefix = (f"WITH facts AS (SELECT CAST(order_date AS DATE) AS order_date, CAST(region_id AS INTEGER) AS region_id, "
+              f"CAST(category_id AS INTEGER) AS category_id, CAST(order_amt AS DECIMAL(18,2)) AS order_amt "
+              f"FROM {quoted}) ")
+    return {"Q1": prefix + "SELECT ROUND(SUM(order_amt),2) FROM facts",
+            "Q2": prefix + ("SELECT region_id,ROUND(SUM(order_amt),2) AS v FROM facts GROUP BY region_id "
+                            "ORDER BY v DESC,region_id LIMIT 3"),
+            "Q3": prefix + ("SELECT strftime(order_date,'%Y-%m') AS m,ROUND(SUM(order_amt),2) FROM facts "
+                            "WHERE order_date>=DATE '2026-01-01' GROUP BY m ORDER BY m LIMIT 3"),
+            "Q4": prefix + ("SELECT category_id,COUNT(*) FROM facts WHERE region_id<>9 AND order_amt IS NOT NULL "
+                            "GROUP BY category_id ORDER BY category_id"),
+            "Q5": prefix + ("SELECT ROUND(100.0*SUM(CASE WHEN order_amt IS NULL THEN 1 ELSE 0 END)/COUNT(*),3) "
+                            "FROM facts")}
+
+
+class Handler:
+    def __init__(self, body, workspace):
+        raw = json.dumps(body or {}).encode("utf-8")
+        self.rfile = io.BytesIO(raw)
+        self.headers = {"Content-Length": str(len(raw)), "X-Workspace-Id": workspace}
+        self.response = None
+
+    @staticmethod
+    def _query_arg(parsed, key):
+        return (parse_qs(parsed.query).get(key) or [""])[0]
+
+    def _write_json(self, status, body):
+        self.response = (status, body)
+
+
+class Harness:
+    def __init__(self, temp, fixture, records):
+        from jiuwenswarm.channels.web.dataagent import api
+        from jiuwenswarm.channels.web.dataagent.datasource import store
+        from jiuwenswarm.common import db_connector, workspace_context, workspace_store
+        self.api, self.store, self.dbc, self.wc, self.ws = api, store, db_connector, workspace_context, workspace_store
+        self.temp, self.fixture, self.records = temp, fixture, records
+        self.sources, self.secrets = {}, []
+
+    def safe(self, value):
+        text = str(value)
+        for secret in self.secrets:
+            text = text.replace(secret, "[REDACTED]")
+        return text[:1500]
+
+    def check(self, name, function):
+        try:
+            detail, status = function(), "passed"
+        except Blocked as exc:
+            detail, status = self.safe(exc), "blocked"
+        except Exception as exc:
+            detail, status = self.safe(f"{type(exc).__name__}: {exc}"), "failed"
+        self.records.append({"gate": name, "status": status, "detail": detail})
+        print(f"[{status.upper()}] {name}: {self.safe(detail)}", flush=True)
+        return status == "passed"
+
+    def request(self, method, route, workspace, body=None, expected=200):
+        handler = Handler(body, workspace)
+        getattr(self.api, "handle_" + method)(handler, urlparse("/api/dataagent/" + route))
+        require(handler.response is not None, "HTTP dispatch produced no response")
+        status, result = handler.response
+        require(status == expected, f"HTTP {status}: {self.safe(result)}")
+        serialized = json.dumps(result, default=str)
+        require(not any(secret in serialized for secret in self.secrets), "HTTP response exposed credentials")
+        if expected == 200:
+            require(result.get("ok") is not False, f"HTTP operation rejected: {self.safe(result)}")
+        return result
+
+    @contextmanager
+    def scope(self, kind):
+        token = self.wc.set_current(self.sources[kind]["consumer"])
+        try:
+            yield
+        finally:
+            self.wc.reset(token)
+
+    def lifecycle(self, kind, config=None):
+        owner, consumer, source_id = "owner-" + kind, "consumer-" + kind, "source-" + kind
+        self.ws.create_workspace(owner, workspace_id=owner)
+        self.ws.create_workspace(consumer, workspace_id=consumer)
+        if kind == "ddl":
+            initial = {"ddl_text": 'CREATE TABLE "sales/orders" (order_id BIGINT PRIMARY KEY)', "dialect": "postgres"}
+            update = {"ddl_text": ('CREATE TABLE "sales/orders" (order_id BIGINT PRIMARY KEY, '
+                                   'order_date DATE NOT NULL, region_id INTEGER NOT NULL, '
+                                   'category_id INTEGER NOT NULL, order_amt DECIMAL(18,2), order_qty INTEGER NOT NULL, '
+                                   'channel_name VARCHAR(16) NOT NULL)')}
+        elif kind in ("parquet", "json"):
+            path = self.fixture / f"fact_orders.{kind}"
+            if not path.is_file():
+                raise Blocked(f"Existing fact_orders.{kind} fixture is required")
+            initial = {"location": str(path), "table_name": "initial_orders"}
+            update = {"table_name": "fact_orders"}
+        elif kind == "csv":
+            initial_file = self.temp / "initial_orders.csv"
+            shutil.copyfile(self.fixture / "fact_orders.csv", initial_file)
+            initial, update = {"path": str(initial_file)}, {"path": str(self.fixture / "fact_orders.csv")}
+        else:
+            initial, update = dict(config), {"max_keys": 60000, "password": ""}
+        body = {"source_id": source_id, "type": kind, "workspace_id": owner, **initial}
+        created = self.request("post", "datasource/create", owner, body)
+        require(created.get("bound") is True, "Create did not bind owner workspace")
+        require(created.get("schema_derivation") == {"status": "queued"}, "Create did not schedule schema enrichment")
+        require(created.get("semantic_collection", {}).get("status") == "queued"
+                and created["semantic_collection"].get("run_id"), "Create did not return a semantic task")
+        updated = self.request("post", "datasource/update", owner,
+                               {"source_id": source_id, "workspace_id": owner, **update})
+        ref = updated["db_ref"]
+        bound = self.request("post", "datasource/bind", consumer, {"source_id": source_id, "workspace_id": consumer})
+        require(bound["db_ref"] == ref and bound["bound"] is True, "Cross-workspace bind used stale reference")
+        require(bound.get("schema_derivation") == {"status": "queued"}, "Binding did not schedule schema enrichment")
+        require(bound.get("semantic_collection", {}).get("status") == "queued"
+                and bound["semantic_collection"].get("run_id"), "Binding did not return a semantic task")
+        require(self.scheduled_semantic_runs[-2:] == [
+            {"workspace_id": workspace, "source_id": source_id, "trigger_type": "binding"}
+            for workspace in (owner, consumer)], "Semantic scheduling lost bound source arguments")
+        require(self.wc.validate_ref_in_workspace(consumer, "business", ref) == ref, "Bound ref was not authorized")
+        stored = self.store.get_source(source_id, workspace_id=owner)
+        if kind == "redis":
+            require(stored["config"]["password"] == initial["password"], "Blank update lost Redis password")
+        else:
+            require(ref != created["db_ref"], "Update did not change the source reference")
+        require(self.store.get_source(source_id, workspace_id=consumer) is None,
+                "Binding unexpectedly copied source ownership")
+        self.sources[kind] = {"ref": ref, "owner": owner, "consumer": consumer, "source_id": source_id}
+        return "In-process API create/update/cross-space bind persisted and restored the latest source settings"
+
+    def browse(self, kind):
+        entry = self.sources[kind]
+        workspace, ref = entry["consumer"], entry["ref"]
+        databases = self.request("get", "databases", workspace)["databases"]
+        require(len(databases) == 1, "Expected one bound logical database")
+        name = databases[0]["name"]
+        prefix = "databases/" + quote(name, safe="") + "/tables"
+        tables = self.request("get", prefix, workspace)["tables"]
+        require(len(tables) == 1, "Expected one fixture table")
+        table = tables[0]["name"]
+        entry["table"] = table
+        # Exercise both the logical name and a complete percent-encoded ref.
+        full = "databases/" + quote(ref, safe="") + "/tables"
+        require(self.request("get", full, workspace)["tables"][0]["name"] == table, "Encoded full ref route disagrees")
+        detail = self.request("get", prefix + "/" + quote(table, safe=""), workspace)
+        fixture_columns = {"order_id", "order_date", "region_id", "category_id", "order_amt", "order_qty",
+                           "channel_name"}
+        require(fixture_columns <= {column["name"] for column in detail["columns"]},
+                "Table detail lost fixture columns")
+        preview_route = prefix + "/" + quote(table, safe="") + "/preview?" + urlencode({"limit": 3, "offset": 1})
+        if kind == "ddl":
+            require(detail.get("preview_supported") is False, "DDL preview capability advertised incorrectly")
+            rejected = self.request("get", preview_route, workspace, expected=400)
+            require("metadata-only" in rejected.get("detail", ""), "DDL preview rejection is not explicit")
+        else:
+            preview = self.request("get", preview_route, workspace)
+            require(len(preview["rows"]) == 3 and len(preview["columns"]) >= 7, "HTTP preview shape incorrect")
+            if kind == "redis":
+                require(preview["total"] is None and preview["has_more"] is True,
+                        "Sampled preview falsely reported a complete total")
+        return {"database": name, "table": table, "columns": len(detail["columns"]),
+                "preview": "metadata-only rejection" if kind == "ddl" else "3 rows / offset 1",
+                "encoded_full_ref": True, "encoded_table_slash": "/" in table}
+
+    def analysis(self, kind):
+        entry = self.sources[kind]
+        with self.scope(kind):
+            for label, sql in questions(entry["table"]).items():
+                result = self.dbc.query(entry["ref"], sql, limit=10)
+                require(normalized(result["rows"]) == EXPECTED[label],
+                        f"{kind} {label} differs from CSV/Decimal baseline")
+                require(not result.get("materialize_truncated"),
+                        "Five-question analysis used incomplete materialization")
+                require(not any(secret in json.dumps(result, default=str) for secret in self.secrets),
+                        "Governance output exposed credentials")
+        return {"questions": 5, "baseline": "CSV/std-library Decimal", "answers": EXPECTED}
+
+    def knowledge(self, kind):
+        from jiuwenswarm.channels.web.dataagent.knowledge import schema_candidates, store as knowledge
+        entry = self.sources[kind]
+        snapshot = self.request("post", "databases/schema-snapshot", entry["consumer"], {"db_ref": entry["ref"]})
+        require(snapshot["table_count"] == 1 and len(snapshot["tables"][0].get("columns", [])) >= 7,
+                "Snapshot lost table schema")
+        optional_error = snapshot["tables"][0].get("error", "")
+        if optional_error:
+            require("does not support list_indexes" in optional_error, "Unexpected schema snapshot failure")
+        with self.scope(kind):
+            derived = schema_candidates.derive_candidates(entry["ref"], source_id=entry["source_id"])
+            require(not derived["failed_tables"] and derived["created_count"] > 0, "No schema candidates were derived")
+            assets = knowledge.list_assets()
+            require(len(assets) == derived["created_count"] and all(a["status"] == "candidate" for a in assets),
+                    "Candidates were not persisted in consumer SQLite")
+            require(all(a["scope"]["source_ids"] == [entry["source_id"]] for a in assets),
+                    "Candidate source scope incorrect")
+            repeat = schema_candidates.derive_candidates(entry["ref"], source_id=entry["source_id"])
+            require(repeat["created_count"] == 0, "Repeated derivation was not idempotent")
+        return {"snapshot_tables": 1, "persisted_candidates": len(assets), "idempotent": True,
+                "optional_metadata_boundary": optional_error or None}
+
+
+def start_redis(stack, executable, temp, rows, harness, report):
+    if executable is None or not executable.is_file():
+        raise Blocked("Provide --redis-server or put an existing redis-server executable on PATH")
+    import redis
+    password = secrets.token_urlsafe(32)
+    harness.secrets.append(password)
+    with socket.socket() as reserve:
+        reserve.bind(("127.0.0.1", 0))
+        port = reserve.getsockname()[1]
+    log = stack.enter_context((temp / "redis.log").open("w", encoding="utf-8"))
+    process = subprocess.Popen([str(executable.resolve()), "--bind", "127.0.0.1", "--port", str(port),
+                                "--save", "", "--appendonly", "no", "--requirepass", password, "--dir", str(temp)],
+                               stdout=log, stderr=subprocess.STDOUT,
+                               creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+
+    def stop():
+        if process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=5)
+        report["owned_peer_stopped"] = process.poll() is not None
+    stack.callback(stop)
+    client = redis.Redis(host="127.0.0.1", port=port, password=password, decode_responses=True,
+                         socket_timeout=3, socket_connect_timeout=1)
+    stack.callback(client.close)
+    deadline = time.monotonic() + 15
+    while True:
+        require(process.poll() is None, "Owned Redis exited before startup")
+        try:
+            if client.ping():
+                break
+        except redis.ConnectionError:
+            if time.monotonic() >= deadline:
+                raise TimeoutError("Owned Redis startup timed out")
+            time.sleep(0.1)
+    for offset in range(0, len(rows), 5000):
+        with client.pipeline(transaction=False) as pipeline:
+            for row in rows[offset:offset + 5000]:
+                pipeline.hset(f"acceptance:order:{row['order_id']}", mapping={k: v for k, v in row.items() if v != ""})
+            pipeline.execute()
+    require(client.dbsize() == 50000, "Owned Redis fixture did not contain 50000 hashes")
+    report["redis_version"] = client.info("server")["redis_version"]
+    return {"host": "127.0.0.1", "port": port, "password": password, "db": 0,
+            "datasets": "hash:acceptance:order:*", "max_keys": 61000, "materialize_limit": 60000}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sources", default="ddl,parquet,csv,json,redis")
+    parser.add_argument("--fixture-dir", type=Path, default=OUTPUT / "fixture")
